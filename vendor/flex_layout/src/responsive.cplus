// flex_layout/responsive — platform-neutral responsive layout classification.
//
// This module deliberately sits beside the flex/grid engine instead of inside
// it. The host supplies viewport numbers and application-defined names; the
// module only selects the narrowest configured max-width that contains the
// viewport. It does not inspect devices, windows, operating systems, DPI, or
// UI toolkits. Widths use whatever logical unit the host supplies (points, CSS
// pixels, etc.); thresholds and viewport values must use the same unit.
//
// Example:
//
//   var config: ResponsiveConfig = ResponsiveConfig::new("desktop");
//   config.add_breakpoint("mobile", up_to: 300.0f64);
//   config.add_breakpoint("tablet", up_to: 900.0f64);
//
//   let env: LayoutEnvironment = config.resolve(view_width, view_height);
//   if env.is("mobile") { ... build/configure a compact layout ... }
//
// A breakpoint is inclusive: `mobile <= 300`. Above every configured
// breakpoint, the fallback class is selected. Breakpoints may be registered in
// any order; resolve chooses the smallest matching maximum.

import "stdlib/vec" as vec;
import "stdlib/option" as option;
import "stdlib/text" as text;
import "stdlib/status" as status;

enum Orientation { Portrait, Landscape, Square }

struct Breakpoint {
    name: text::Text,
    max_width: f64,
}

// The result of resolving one viewport through a ResponsiveConfig. It owns its
// class name, so it remains valid if the config is later edited or dropped.
struct LayoutEnvironment {
    _width: f64,
    _height: f64,
    _class_name: text::Text,
    _breakpoint: f64,
    _matched_breakpoint: bool,
}

impl LayoutEnvironment {
    fn width(this) -> f64 { return this._width; }
    fn height(this) -> f64 { return this._height; }
    fn class_name(this) -> str { return this._class_name.view(); }
    fn is(this, name: str) -> bool { return this._class_name.equals(name); }

    // The inclusive max width of the matched breakpoint, or None when the
    // fallback class applied (fallbacks have no maximum).
    fn breakpoint_width(this) -> option::Option[f64] {
        if this._matched_breakpoint { return option::Option[f64]::Some(this._breakpoint); }
        return option::Option[f64]::None;
    }

    fn orientation(this) -> Orientation {
        if this._width < this._height { return Orientation::Portrait; }
        if this._width > this._height { return Orientation::Landscape; }
        return Orientation::Square;
    }

    // Useful to a host on resize: true means fluid flex/grid layout can simply
    // be recalculated; false means class-specific styles or structure should
    // be reapplied/rebuilt first.
    fn is_same_class(this, other: LayoutEnvironment) -> bool {
        return this._class_name.equals(other._class_name.view());
    }
}

struct ResponsiveConfig {
    _fallback: text::Text,
    _breakpoints: vec::Vec[Breakpoint],
}

impl ResponsiveConfig {
    // `fallback` is selected above all configured max-width breakpoints.
    fn new(fallback: str) -> ResponsiveConfig {
        return ResponsiveConfig {
            _fallback: text::from_str(fallback),
            _breakpoints: vec::new::[Breakpoint](),
        };
    }

    fn fallback(this) -> str { return this._fallback.view(); }

    fn set_fallback(ref this, name: str) -> status::Status {
        if #str_len(name) == (0 as usize) { return status::Status::InvalidInput; }
        this._fallback = text::from_str(name);
        return status::Status::Ok;
    }

    // Add an inclusive width class (`name <= up_to`). Reusing a name updates
    // its threshold, which makes configuration reloads idempotent. Empty
    // names, NaN, zero, and negative widths are InvalidInput.
    fn add_breakpoint(ref this, name: str, up_to: f64) -> status::Status {
        if #str_len(name) == (0 as usize) { return status::Status::InvalidInput; }
        // Written as a positive predicate so NaN is rejected under ordered
        // floating-point comparison semantics too.
        if !(up_to > 0.0f64) { return status::Status::InvalidInput; }

        let n: usize = this._breakpoints.count();
        var i: usize = 0 as usize;
        while i < n {
            match this._breakpoints.at_ptr(i) {
                option::Option[*Breakpoint]::Some(p) => {
                    if { (*p).name.equals(name) } {
                        { (*p).max_width = up_to; }
                        return status::Status::Ok;
                    }
                }
                option::Option[*Breakpoint]::None => { }
            }
            i = i +% (1 as usize);
        }

        return this._breakpoints.append(Breakpoint {
            name: text::from_str(name),
            max_width: up_to,
        });
    }

    // Remove the named class; returns the threshold it had (None if no such
    // name — the Vec::remove idiom for detach-and-return).
    fn remove_breakpoint(ref this, name: str) -> option::Option[f64] {
        let n: usize = this._breakpoints.count();
        var i: usize = 0 as usize;
        while i < n {
            match this._breakpoints.at_ptr(i) {
                option::Option[*Breakpoint]::Some(p) => {
                    if { (*p).name.equals(name) } {
                        let had: f64 = { (*p).max_width };
                        let _removed: option::Option[Breakpoint] = this._breakpoints.remove(i);
                        return option::Option[f64]::Some(had);
                    }
                }
                option::Option[*Breakpoint]::None => { }
            }
            i = i +% (1 as usize);
        }
        return option::Option[f64]::None;
    }

    fn remove_all_breakpoints(ref this) {
        this._breakpoints.remove_all();
        return;
    }

    fn breakpoint_count(this) -> usize { return this._breakpoints.count(); }

    // Resolve without ordering requirements: among every max width containing
    // `width`, choose the smallest. A NaN width cannot be classified and uses
    // the fallback. Negative dimensions are normalized to zero because window
    // systems may briefly report them during setup/teardown.
    fn resolve(this, width: f64, height: f64) -> LayoutEnvironment {
        var resolved_width: f64 = width;
        var resolved_height: f64 = height;
        if resolved_width < 0.0f64 { resolved_width = 0.0f64; }
        if resolved_height < 0.0f64 { resolved_height = 0.0f64; }

        var chosen: *Breakpoint = { 0 as *Breakpoint };
        var chosen_max: f64 = 0.0f64;
        if resolved_width == resolved_width {
            let n: usize = this._breakpoints.count();
            var i: usize = 0 as usize;
            while i < n {
                match this._breakpoints.at_ptr(i) {
                    option::Option[*Breakpoint]::Some(p) => {
                        let maximum: f64 = { (*p).max_width };
                        if resolved_width <= maximum {
                            if chosen.is_null() || maximum < chosen_max {
                                chosen = p;
                                chosen_max = maximum;
                            }
                        }
                    }
                    option::Option[*Breakpoint]::None => { }
                }
                i = i +% (1 as usize);
            }
        }

        if chosen.is_not_null() {
            return LayoutEnvironment {
                _width: resolved_width,
                _height: resolved_height,
                _class_name: { (*chosen).name.clone() },
                _breakpoint: chosen_max,
                _matched_breakpoint: true,
            };
        }

        return LayoutEnvironment {
            _width: resolved_width,
            _height: resolved_height,
            _class_name: this._fallback.clone(),
            _breakpoint: 0.0f64,
            _matched_breakpoint: false,
        };
    }
}

// ==========================================================================
// Tests
// ==========================================================================

// Collapse Option[f64] for asserts: the width, or `fallback` when None.
fn width_or(o: option::Option[f64], fallback: f64) -> f64 {
    return match o {
        option::Option[f64]::Some(w) => w,
        option::Option[f64]::None => fallback,
    };
}

fn standard_config() -> ResponsiveConfig {
    var c: ResponsiveConfig = ResponsiveConfig::new("desktop");
    c.add_breakpoint("tablet", 900.0f64); // deliberately registered out of order
    c.add_breakpoint("mobile", 300.0f64);
    return c;
}

#[test]
fn narrowest_matching_breakpoint_wins() {
    let c: ResponsiveConfig = standard_config();
    let mobile: LayoutEnvironment = c.resolve(280.0f64, 640.0f64);
    assert mobile.is("mobile");
    assert width_or(mobile.breakpoint_width(), -1.0f64) == 300.0f64;

    let tablet: LayoutEnvironment = c.resolve(700.0f64, 900.0f64);
    assert tablet.is("tablet");
    assert width_or(tablet.breakpoint_width(), -1.0f64) == 900.0f64;
}

#[test]
fn breakpoint_maximum_is_inclusive() {
    let c: ResponsiveConfig = standard_config();
    assert c.resolve(300.0f64, 600.0f64).is("mobile");
    assert c.resolve(301.0f64, 600.0f64).is("tablet");
    assert c.resolve(900.0f64, 600.0f64).is("tablet");
}

#[test]
fn fallback_applies_above_every_breakpoint() {
    let c: ResponsiveConfig = standard_config();
    let env: LayoutEnvironment = c.resolve(1200.0f64, 800.0f64);
    assert env.is("desktop");
    assert env.class_name() == "desktop";
    assert c.fallback() == "desktop";
    assert width_or(env.breakpoint_width(), -1.0f64) == -1.0f64;   // fallback: no maximum
}

#[test]
fn named_breakpoint_update_is_idempotent() {
    var c: ResponsiveConfig = standard_config();
    assert c.breakpoint_count() == (2 as usize);
    assert c.add_breakpoint("mobile", 360.0f64) == status::Status::Ok;
    assert c.breakpoint_count() == (2 as usize);
    assert c.resolve(340.0f64, 700.0f64).is("mobile");
}

#[test]
fn invalid_breakpoints_are_rejected() {
    var c: ResponsiveConfig = ResponsiveConfig::new("wide");
    assert c.add_breakpoint("", 300.0f64) == status::Status::InvalidInput;
    assert c.add_breakpoint("zero", 0.0f64) == status::Status::InvalidInput;
    assert c.add_breakpoint("negative", -1.0f64) == status::Status::InvalidInput;
    let z: f64 = 0.0f64;
    assert c.add_breakpoint("nan", z / z) == status::Status::InvalidInput;
    assert c.breakpoint_count() == (0 as usize);
}

#[test]
fn breakpoint_can_be_removed_and_fallback_changed() {
    var c: ResponsiveConfig = standard_config();
    assert width_or(c.remove_breakpoint("mobile"), -1.0f64) == 300.0f64;
    assert width_or(c.remove_breakpoint("missing"), -1.0f64) == -1.0f64;
    assert c.resolve(280.0f64, 640.0f64).is("tablet");
    assert c.set_fallback("") == status::Status::InvalidInput;
    assert c.set_fallback("large") == status::Status::Ok;
    assert c.resolve(1200.0f64, 800.0f64).is("large");
    c.remove_all_breakpoints();
    assert c.breakpoint_count() == (0 as usize);
    assert c.resolve(100.0f64, 800.0f64).is("large");
}

#[test]
fn environment_reports_orientation_and_class_transition() {
    let c: ResponsiveConfig = standard_config();
    let portrait: LayoutEnvironment = c.resolve(280.0f64, 640.0f64);
    let portrait_again: LayoutEnvironment = c.resolve(300.0f64, 700.0f64);
    let landscape: LayoutEnvironment = c.resolve(700.0f64, 400.0f64);

    assert portrait.orientation() == Orientation::Portrait;
    assert landscape.orientation() == Orientation::Landscape;
    assert portrait.is_same_class(portrait_again);
    assert !portrait.is_same_class(landscape);
}

#[test]
fn negative_dimensions_are_normalized() {
    let c: ResponsiveConfig = standard_config();
    let env: LayoutEnvironment = c.resolve(-10.0f64, -20.0f64);
    assert env.width() == 0.0f64;
    assert env.height() == 0.0f64;
    assert env.is("mobile");
    assert env.orientation() == Orientation::Square;
}
