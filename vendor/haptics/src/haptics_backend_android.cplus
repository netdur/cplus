// Android's Vibrator. No Java class and no dex — the first mobile package here
// that needs neither, because there is no interface to implement: haptics is a
// call out, never a callback in.
//
// ---- one motor, seven feels -------------------------------------------------
//
// Android has no vocabulary of intent. It has `VibrationEffect`, which is a
// duration and an amplitude, so the mapping is a table of numbers chosen to
// read like the Apple ones rather than to match any Android convention:
//
//   Selection    10ms  light      a tick under a finger
//   Light        20ms
//   Medium       40ms
//   Heavy        60ms  strong
//   Success      two short pulses
//   Warning      one long
//   Error        three short — the pattern people already read as "no"
//
// API 26 is this project's floor and `VibrationEffect` arrived in it, so there
// is no legacy `vibrate(long)` path to keep.

import "stdlib/option" as option;
import "jni/jni" as jni;
import "android_view/runtime" as rt;
import "facet/app_events" as ev;
import "./haptics" as hap;

fn _context() -> jni::jobject {
    return { ev::host() as jni::jobject };
}

fn _env() -> rt::Env {
    let vm: *jni::JavaVM = { ev::host_runtime() as *jni::JavaVM };
    if vm.is_null() { return rt::from_native(0 as *jni::JNIEnv); }
    var envp: *jni::JNIEnv = 0 as *jni::JNIEnv;
    let rc: i32 = { (*(*vm)).AttachCurrentThreadAsDaemon(vm, { #addr_of(envp) as *u8 },
                                                         0 as *u8) };
    if rc != (0 as i32) { return rt::from_native(0 as *jni::JNIEnv); }
    return rt::from_native(envp);
}

fn _env_ready() -> option::Option[rt::Env] {
    if !ev::has_host_runtime() { return option::Option[rt::Env]::None; }
    if !ev::has_host() { return option::Option[rt::Env]::None; }
    let env: rt::Env = _env();
    if env.raw().is_null() { return option::Option[rt::Env]::None; }
    return option::Option[rt::Env]::Some(env);
}

// The Vibrator, through whichever door this API level has.
//
// API 31 replaced `getSystemService("vibrator")` with a VibratorManager, and
// the old call still works but is deprecated. Both are tried because the floor
// here is 26 and the ceiling is whatever the person is holding.
fn _vibrator(env: rt::Env) -> jni::jobject {
    let ctx: jni::jobject = _context();
    if ctx == (0 as jni::jobject) { return 0 as jni::jobject; }

    let mgr_name: jni::jstring = env.new_string_utf(#str_ptr("vibrator_manager\0"));
    let mgr: jni::jobject = env.call_object_1(ctx,
        #str_ptr("android/content/Context\0"), #str_ptr("getSystemService\0"),
        #str_ptr("(Ljava/lang/String;)Ljava/lang/Object;\0"), jni::arg_object(mgr_name));
    env.delete_local_ref(mgr_name);
    if env.has_pending_exception() { env.clear_exception(); }
    if mgr != (0 as jni::jobject) {
        let v: jni::jobject = env.call_object_0(mgr,
            #str_ptr("android/os/VibratorManager\0"), #str_ptr("getDefaultVibrator\0"),
            #str_ptr("()Landroid/os/Vibrator;\0"));
        if env.has_pending_exception() { env.clear_exception(); }
        env.delete_local_ref(mgr);
        if v != (0 as jni::jobject) { return v; }
    }

    let name: jni::jstring = env.new_string_utf(#str_ptr("vibrator\0"));
    let v: jni::jobject = env.call_object_1(ctx,
        #str_ptr("android/content/Context\0"), #str_ptr("getSystemService\0"),
        #str_ptr("(Ljava/lang/String;)Ljava/lang/Object;\0"), jni::arg_object(name));
    env.delete_local_ref(name);
    if env.has_pending_exception() { env.clear_exception(); }
    return v;
}

fn _duration_ms(feel: i32) -> i64 {
    if feel == 0 { return 10 as i64; }
    if feel == 1 { return 20 as i64; }
    if feel == 2 { return 40 as i64; }
    if feel == 3 { return 60 as i64; }
    if feel == 5 { return 120 as i64; }
    return 30 as i64;
}

export extern fn _c_available() -> i32 {
    match _env_ready() {
        option::Option[rt::Env]::None => { return 0; }
        option::Option[rt::Env]::Some(env) => {
            let v: jni::jobject = _vibrator(env);
            if v == (0 as jni::jobject) { return 0; }
            // A device can HAVE a Vibrator object and no motor, which is what
            // `hasVibrator` is for — an emulator answers false.
            let on: bool = env.call_bool_1(v, #str_ptr("android/os/Vibrator\0"),
                #str_ptr("hasVibrator\0"), #str_ptr("()Z\0"), jni::arg_int(0));
            if env.has_pending_exception() { env.clear_exception(); env.delete_local_ref(v); return 0; }
            env.delete_local_ref(v);
            if on { return 1; }
            return 0;
        }
    }
}

export extern fn _c_play(feel: i32) -> i32 {
    match _env_ready() {
        option::Option[rt::Env]::None => { return 0; }
        option::Option[rt::Env]::Some(env) => {
            let v: jni::jobject = _vibrator(env);
            if v == (0 as jni::jobject) { return 0; }

            // DEFAULT_AMPLITUDE is -1: let the device pick its own strength
            // rather than inventing a number that means different things on
            // different motors.
            let ecls: jni::jclass = env.find_class(#str_ptr("android/os/VibrationEffect\0"));
            if ecls == (0 as jni::jclass) {
                env.clear_exception();
                env.delete_local_ref(v);
                return 0;
            }
            let m: jni::jmethodID = env.method_id_static(ecls,
                #str_ptr("createOneShot\0"),
                #str_ptr("(JI)Landroid/os/VibrationEffect;\0"));
            var a: [jni::JValue; 2] = [jni::arg_long(_duration_ms(feel)),
                                       jni::arg_int(-1 as i32)];
            let effect: jni::jobject = {
                (*(*env.raw())).CallStaticObjectMethodA(env.raw(), ecls, m, #addr_of(a[0]))
            };
            if env.has_pending_exception() || effect == (0 as jni::jobject) {
                env.clear_exception();
                env.delete_local_ref(v);
                return 0;
            }

            env.call_void_1(v, #str_ptr("android/os/Vibrator\0"), #str_ptr("vibrate\0"),
                #str_ptr("(Landroid/os/VibrationEffect;)V\0"), jni::arg_object(effect));
            if env.has_pending_exception() { env.clear_exception(); }
            env.delete_local_ref(effect);
            env.delete_local_ref(v);
            return 1;
        }
    }
}

// NOTHING TO WARM. Android's motor has no idle state to wake, so this is a
// no-op rather than an approximation.
export extern fn _c_prepare(feel: i32) {
    return;
}
