// facet_device test root. Importing is what compiles a module into the gate.
//
// ---- what can be asserted here ------------------------------------------------
//
// NOTHING IN THIS FILE PROMPTS. `request` puts a consent dialog in front of the
// user, and a suite that does that is a suite nobody can run twice — so what is
// pinned is the part that decides: the vocabulary, the mapping from a portal's
// answer to facet's, and the request path the portal spec makes the caller
// predict. `playground/permissions_probe` is the hands half.
//
// THE LIVE ASSERTIONS ARE GUARDED ON `supported()` rather than skipped. A
// machine with no session bus and one with a portal are both real, and the
// suite states what each must answer — which is how it stays honest on a CI box
// as well as on a desktop.

import "./permissions" as perms;
import "stdlib/text" as text;
import "stdlib/io" as io;

#[test]
fn every_capability_has_a_name_and_they_are_distinct() {
    // The names reach diagnostics and tests, never a user's screen — an
    // application shows its own words, in its own language.
    assert perms::name_of(perms::Capability::Camera) == "camera";
    assert perms::name_of(perms::Capability::Microphone) == "microphone";
    assert perms::name_of(perms::Capability::Location) == "location";
    assert perms::name_of(perms::Capability::Notifications) == "notifications";
    return;
}

#[test]
fn a_platform_with_no_permission_service_says_unavailable_not_granted() {
    // THE FAILURE THIS PINS is the tempting one: a Linux desktop process can
    // open /dev/video0 with no ceremony, so a backend that reported what the
    // SYSCALL would do would answer `Granted` to everything. That is true of
    // the syscall and false of the user's intent. With no service to ask, the
    // honest answer is that there is no way to ask.
    if perms::supported() { return; }
    assert perms::status(perms::Capability::Camera) == perms::Permission::Unavailable;
    assert perms::status(perms::Capability::Microphone) == perms::Permission::Unavailable;
    assert perms::status(perms::Capability::Location) == perms::Permission::Unavailable;
    assert perms::status(perms::Capability::Notifications) == perms::Permission::Unavailable;
    return;
}

#[test]
fn status_never_answers_granted_for_a_gated_capability() {
    // `status` is the read an application makes while BUILDING A SCREEN, so it
    // must not prompt — and without prompting the portal will not reveal a
    // stored decision (that is `org.freedesktop.impl.portal.PermissionStore`,
    // deliberately not an application-facing interface). So the most it can
    // truthfully say is `Undetermined`, and a `Granted` here would be a claim
    // nobody made.
    //
    // Notifications are the exception and are checked separately below: the
    // portal has no request flow for them at all.
    if !perms::supported() { return; }
    let cam: perms::Permission = perms::status(perms::Capability::Camera);
    assert cam != perms::Permission::Granted;
    assert cam != perms::Permission::Denied;
    let mic: perms::Permission = perms::status(perms::Capability::Microphone);
    assert mic != perms::Permission::Granted;
    return;
}

#[test]
fn a_capability_with_no_gate_is_granted_rather_than_undetermined() {
    // `org.freedesktop.portal.Notification` has `AddNotification` and no
    // request flow: the desktop shows the notification and the user turns it
    // off there. Reporting `Undetermined` would send an application looking for
    // a prompt that does not exist — so where the interface is offered the
    // answer is a plain yes.
    if !perms::supported() { return; }
    let n: perms::Permission = perms::status(perms::Capability::Notifications);
    assert n == perms::Permission::Granted || n == perms::Permission::Unavailable;
    return;
}

#[test]
fn status_is_idempotent_and_costs_no_consent() {
    // Called twice, answering the same, with nothing shown. The portal proxy is
    // deliberately not cached, so this also pins that a second round trip
    // answers the same as the first.
    if !perms::supported() { return; }
    let a: perms::Permission = perms::status(perms::Capability::Camera);
    let b: perms::Permission = perms::status(perms::Capability::Camera);
    assert a == b;
    return;
}

// A hand-run reporter rather than an assertion: what this machine actually
// answers is a fact about the machine, and printing it is more useful than
// pinning it.
#[test]
fn report_what_this_machine_says() {
    let s: str = if perms::supported() { "yes" } else { "no" };
    io::println("facet_device: permission service present = ${s}");
    if !perms::supported() { return; }
    io::println("  camera        = ${describe(perms::status(perms::Capability::Camera))}");
    io::println("  microphone    = ${describe(perms::status(perms::Capability::Microphone))}");
    io::println("  location      = ${describe(perms::status(perms::Capability::Location))}");
    io::println("  notifications = ${describe(perms::status(perms::Capability::Notifications))}");
    return;
}

fn describe(p: perms::Permission) -> str {
    match p {
        perms::Permission::Granted => { return "granted"; }
        perms::Permission::Denied => { return "denied"; }
        perms::Permission::Undetermined => { return "undetermined"; }
        perms::Permission::Unavailable => { return "unavailable"; }
    }
}
