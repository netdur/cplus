import "stdlib/vec" as vec;
import "stdlib/option" as option;
import "stdlib/status" as status;

// events — typed signals and a string-keyed event bus.
//
// Two layers, one listener convention:
//
//   Signal[T]  a typed multicast event. `on` registers a listener
//              (`fn(T, *u8)` + ctx), `emit` calls every listener with a
//              borrowed payload. The payload type is checked at compile
//              time. Use one Signal per event, as a field or a static.
//
//   Bus        the dynamic counterpart: string event NAMES, `str` payload.
//              For decoupled cross-module messaging where the sender and
//              receiver share no type — a file tree emits "file:open" and
//              the editor subscribes, with no import between them.
//              `events::shared()` is the app-wide instance.
//
// The listener is a fn pointer plus an opaque `ctx` — the same convention
// facet handlers use, so a component method binds directly:
//
//     sig.on(this.on_file_open);        // fn on_file_open(this, path: str)
//     bus.on("file:open", on_open, ctx: cp);
//
// Borrowed inputs (nothing is copied for identity):
//   - `ctx` is borrowed for the life of the registration;
//   - bus event `name` is a borrowed `str` for the life of the registration
//     (use a string literal or a buffer that outlives the subscription);
//   - `emit` payloads are borrowed for the duration of the call only.
//
// `on` returns a subscription handle (`SignalSubscription[T]` from a
// signal, `Subscription` from a bus). The handle is the control surface:
// `cancel()` removes the listener, `pause()` / `resume()` mute it without
// losing its registration or order, `active()` asks whether it is still
// registered. Handles are Copy and non-owning; a zeroed handle (`none()`,
// or a failed `on`) is inert — every method returns false. The signal or
// bus must outlive its handles' use and must not move (handles reach it by
// address; the shared bus always qualifies). Bulk teardown (`off_all`,
// `off_ctx`, `remove_all`) and raw tokens (`handle.id()`, `off(id)`)
// remain for advanced use. `once: true` (or the `once` method)
// auto-removes after the first delivery.
//
// Delivery semantics (defined, not incidental):
//   - listeners fire in subscription order;
//   - a listener ADDED during an emit does not fire in that emit;
//   - a listener REMOVED during an emit does not fire after its removal;
//   - a PAUSED listener is skipped by emit; it keeps its token and its
//     place in the order, and fires again after `resume()`;
//   - a `once` listener is removed before it fires, so re-subscribing from
//     inside the handler is safe (the new registration waits for the next
//     emit); a paused `once` listener stays registered and fires (once)
//     after `resume()`;
//   - `emit` borrows the payload — listeners read it for the duration of
//     the call and must not retain it.
//
// Emit walks the listener list once per delivery (ordered by token), which
// is quadratic in listener count. That is the price of allocation-free,
// mutation-safe dispatch; event listener counts are small.

// ---- Signal[T] ---------------------------------------------------------------

// One registered listener. `ctx` is a borrowed identity value (a component
// address, an index) passed back to `f`; the signal never owns or frees it.
struct Listener[T] {
    f: fn(T, *u8),
    opaque ctx: *u8,
    id: u64,
    once: bool,
    paused: bool,
}

// A typed multicast event. Fields are private; use the methods.
struct Signal[T] {
    _subs: vec::Vec[Listener[T]],
    _next_id: u64,
}

impl Signal[T] {
    fn new() -> Signal[T] {
        return Signal[T] { _subs: vec::Vec[Listener[T]]::new(), _next_id: 1u64 };
    }

    // Register `f` (with its ctx) and return the subscription handle. Token 0
    // is never issued — a handle carrying id 0 (storage failed to grow) is
    // inert: every method on it returns false.
    fn on(ref this, f: fn(T, *u8), ctx: *u8 = 0 as *u8, once: bool = false) -> SignalSubscription[T] {
        let id: u64 = this._next_id;
        this._next_id = this._next_id + 1u64;
        let added: status::Status =
            this._subs.append(Listener[T] { f: f, ctx: ctx, id: id, once: once, paused: false });
        let granted: u64 = match added {
            status::Status::Ok => id,
            _ => 0u64,
        };
        let sp: *Signal[T] = { #addr_of(this) };
        return SignalSubscription[T] { _sig: sp, _id: granted };
    }

    // `on` with once: true — the listener is removed before its first
    // delivery runs.
    fn once(ref this, f: fn(T, *u8), ctx: *u8 = 0 as *u8) -> SignalSubscription[T] {
        return this.on(f, ctx: ctx, once: true);
    }

    // Remove the listener with this token. False when the token is unknown
    // (already removed, never issued, or 0).
    fn off(ref this, id: u64) -> bool {
        if id == 0u64 { return false; }
        var i: usize = 0usize;
        let n: usize = this._subs.count();
        while i < n {
            var hit: bool = false;
            match this._subs.at_ptr(i) {
                option::Option[*Listener[T]]::Some(p) => { hit = { (*p).id } == id; }
                option::Option[*Listener[T]]::None => {}
            }
            if hit {
                let _gone: option::Option[Listener[T]] = this._subs.remove(i);
                return true;
            }
            i = i + 1usize;
        }
        return false;
    }

    // Remove every listener registered with this ctx — one-call teardown
    // for a receiver: a component detaches all its bound methods (their ctx
    // is the receiver's address) before it goes away, without keeping
    // tokens. Returns how many were removed. Note ctx 0 matches exactly the
    // listeners registered without a ctx.
    fn off_ctx(ref this, ctx: *u8) -> usize {
        var removed: usize = 0usize;
        var i: usize = 0usize;
        while i < this._subs.count() {
            var hit: bool = false;
            match this._subs.at_ptr(i) {
                option::Option[*Listener[T]]::Some(p) => { hit = { (*p).ctx } == ctx; }
                option::Option[*Listener[T]]::None => {}
            }
            if hit {
                let _gone: option::Option[Listener[T]] = this._subs.remove(i);
                removed = removed + 1usize;
            } else {
                i = i + 1usize;
            }
        }
        return removed;
    }

    // Deliver `value` to every listener registered before this call, in
    // subscription order. See the module header for the exact semantics
    // under mid-dispatch mutation.
    fn emit(ref this, value: T) {
        let ceiling: u64 = this._next_id;
        var last: u64 = 0u64;
        loop {
            // The live listener with the smallest token in (last, ceiling).
            // Re-scanned every step so any `on`/`off` a listener performed
            // is respected.
            var best: u64 = 0u64;
            var best_f: fn(T, *u8) = 0 as fn(T, *u8);
            var best_ctx: *u8 = 0 as *u8;
            var best_once: bool = false;
            var i: usize = 0usize;
            let n: usize = this._subs.count();
            while i < n {
                match this._subs.at_ptr(i) {
                    option::Option[*Listener[T]]::Some(p) => {
                        let lid: u64 = { (*p).id };
                        let lpaused: bool = { (*p).paused };
                        if !lpaused && lid > last && lid < ceiling && (best == 0u64 || lid < best) {
                            best = lid;
                            best_f = { (*p).f };
                            best_ctx = { (*p).ctx };
                            best_once = { (*p).once };
                        }
                    }
                    option::Option[*Listener[T]]::None => {}
                }
                i = i + 1usize;
            }
            if best == 0u64 { break; }
            last = best;
            if best_once {
                let _removed: bool = this.off(best);
            }
            best_f(value, best_ctx);
        }
    }

    // True when a listener with this token is still registered (paused or
    // not).
    fn has(this, id: u64) -> bool {
        if id == 0u64 { return false; }
        var i: usize = 0usize;
        let n: usize = this._subs.count();
        while i < n {
            match this._subs.at_ptr(i) {
                option::Option[*Listener[T]]::Some(p) => {
                    if { (*p).id } == id { return true; }
                }
                option::Option[*Listener[T]]::None => {}
            }
            i = i + 1usize;
        }
        return false;
    }

    // Mute the listener with this token: it stays registered, keeps its
    // place in the order, and is skipped by emit until `resume`. False when
    // the token is unknown.
    fn pause(ref this, id: u64) -> bool {
        return this._set_paused(id, true);
    }

    // Undo `pause`. False when the token is unknown.
    fn resume(ref this, id: u64) -> bool {
        return this._set_paused(id, false);
    }

    fn _set_paused(ref this, id: u64, paused: bool) -> bool {
        if id == 0u64 { return false; }
        var i: usize = 0usize;
        let n: usize = this._subs.count();
        while i < n {
            var hit: bool = false;
            match this._subs.at_ptr(i) {
                option::Option[*Listener[T]]::Some(p) => {
                    if { (*p).id } == id {
                        { (*p).paused = paused; }
                        hit = true;
                    }
                }
                option::Option[*Listener[T]]::None => {}
            }
            if hit { return true; }
            i = i + 1usize;
        }
        return false;
    }

    // Number of registered listeners.
    fn count(this) -> usize {
        return this._subs.count();
    }

    fn is_empty(this) -> bool {
        return this._subs.is_empty();
    }

    // Drop every listener. Issued tokens stay dead (token numbering is not
    // reset), so a stale `off` after this stays a false no-op.
    fn remove_all(ref this) {
        this._subs.remove_all();
    }
}

// A handle to one Signal registration — what `on` returns and what the
// subscriber keeps. The handle OWNS the registration: dropping it cancels
// the listener, so a component that stores its handles in fields
// unsubscribes automatically when it drops. `detach()` opts out for
// fire-and-forget wiring. The signal must outlive the handle (its drop
// reaches the signal by address) and must not move. A zeroed handle
// (`none()`, or a failed `on`) is inert.
struct SignalSubscription[T] {
    opaque _sig: *Signal[T],
    _id: u64,
}

impl SignalSubscription[T] {
    // The inert handle — for fields that subscribe later.
    fn none() -> SignalSubscription[T] {
        return SignalSubscription[T] { _sig: 0 as *Signal[T], _id: 0u64 };
    }

    // The raw token, for the advanced `off(id)` surface.
    fn id(this) -> u64 {
        return this._id;
    }

    // Still registered (paused or not)?
    fn active(this) -> bool {
        if this._id == 0u64 { return false; }
        return { (*this._sig).has(this._id) };
    }

    // Remove the listener and make the handle inert. False when already
    // removed or inert.
    fn cancel(ref this) -> bool {
        if this._id == 0u64 { return false; }
        let removed: bool = { (*this._sig).off(this._id) };
        this._id = 0u64;
        return removed;
    }

    // Keep the registration for the life of the signal, give up control:
    // the handle becomes inert and its drop no longer cancels.
    fn detach(ref this) {
        this._id = 0u64;
    }

    // Mute the listener without removing it. False when unknown or inert.
    fn pause(this) -> bool {
        if this._id == 0u64 { return false; }
        return { (*this._sig).pause(this._id) };
    }

    // Undo `pause`. False when unknown or inert.
    fn resume(this) -> bool {
        if this._id == 0u64 { return false; }
        return { (*this._sig).resume(this._id) };
    }

    // Dropping the handle cancels its registration (inert handles no-op).
    fn drop(ref this) {
        if this._id == 0u64 { return; }
        let _removed: bool = { (*this._sig).off(this._id) };
    }
}

// ---- Bus ---------------------------------------------------------------------

// One registered bus listener: a Signal listener plus the event name it
// subscribed to. `name` is borrowed for the life of the registration — same
// rule as `ctx` (literals and long-lived buffers only).
struct BusListener {
    name: str,
    f: fn(str, *u8),
    opaque ctx: *u8,
    id: u64,
    once: bool,
    paused: bool,
}

// A string-keyed multicast event bus. `str` payload; for typed payloads use
// a `Signal[T]`. One flat listener list — emit filters by name, so tokens
// are unique across the whole bus. Registering never allocates for the name.
struct Bus {
    _subs: vec::Vec[BusListener],
    _next_id: u64,
}

impl Bus {
    fn new() -> Bus {
        return Bus { _subs: vec::Vec[BusListener]::new(), _next_id: 1u64 };
    }

    // Register `f` for events named `name`. Same handle contract as
    // `Signal.on`. `name` is stored by view — it must outlive the registration.
    fn on(ref this, name: str, f: fn(str, *u8), ctx: *u8 = 0 as *u8, once: bool = false) -> Subscription {
        let id: u64 = this._next_id;
        this._next_id = this._next_id + 1u64;
        let added: status::Status = this._subs.append(BusListener {
            name: name,
            f: f,
            ctx: ctx,
            id: id,
            once: once,
            paused: false,
        });
        let granted: u64 = match added {
            status::Status::Ok => id,
            _ => 0u64,
        };
        let bp: *Bus = { #addr_of(this) };
        return Subscription { _bus: bp, _id: granted };
    }

    fn once(ref this, name: str, f: fn(str, *u8), ctx: *u8 = 0 as *u8) -> Subscription {
        return this.on(name, f, ctx: ctx, once: true);
    }

    // Remove the listener with this token (any event name). False when the
    // token is unknown.
    fn off(ref this, id: u64) -> bool {
        if id == 0u64 { return false; }
        var i: usize = 0usize;
        let n: usize = this._subs.count();
        while i < n {
            var hit: bool = false;
            match this._subs.at_ptr(i) {
                option::Option[*BusListener]::Some(p) => { hit = { (*p).id } == id; }
                option::Option::None => {}
            }
            if hit {
                let _gone: option::Option[BusListener] = this._subs.remove(i);
                return true;
            }
            i = i + 1usize;
        }
        return false;
    }

    // Remove every listener registered for `name`.
    fn off_all(ref this, name: str) {
        var i: usize = 0usize;
        while i < this._subs.count() {
            var hit: bool = false;
            match this._subs.at_ptr(i) {
                option::Option[*BusListener]::Some(p) => { hit = { (*p).name } == name; }
                option::Option::None => {}
            }
            if hit {
                let _gone: option::Option[BusListener] = this._subs.remove(i);
            } else {
                i = i + 1usize;
            }
        }
    }

    // Remove every listener registered with this ctx, across all names —
    // the same one-call receiver teardown as `Signal.off_ctx`.
    fn off_ctx(ref this, ctx: *u8) -> usize {
        var removed: usize = 0usize;
        var i: usize = 0usize;
        while i < this._subs.count() {
            var hit: bool = false;
            match this._subs.at_ptr(i) {
                option::Option[*BusListener]::Some(p) => { hit = { (*p).ctx } == ctx; }
                option::Option::None => {}
            }
            if hit {
                let _gone: option::Option[BusListener] = this._subs.remove(i);
                removed = removed + 1usize;
            } else {
                i = i + 1usize;
            }
        }
        return removed;
    }

    // Deliver `payload` to every listener of `name`. Same order and
    // mid-dispatch mutation semantics as `Signal.emit`.
    fn emit(ref this, name: str, payload: str = "") {
        let ceiling: u64 = this._next_id;
        var last: u64 = 0u64;
        loop {
            var best: u64 = 0u64;
            var best_f: fn(str, *u8) = 0 as fn(str, *u8);
            var best_ctx: *u8 = 0 as *u8;
            var best_once: bool = false;
            var i: usize = 0usize;
            let n: usize = this._subs.count();
            while i < n {
                match this._subs.at_ptr(i) {
                    option::Option[*BusListener]::Some(p) => {
                        let lid: u64 = { (*p).id };
                        let lpaused: bool = { (*p).paused };
                        if !lpaused && lid > last && lid < ceiling && (best == 0u64 || lid < best) {
                            if { (*p).name } == name {
                                best = lid;
                                best_f = { (*p).f };
                                best_ctx = { (*p).ctx };
                                best_once = { (*p).once };
                            }
                        }
                    }
                    option::Option::None => {}
                }
                i = i + 1usize;
            }
            if best == 0u64 { break; }
            last = best;
            if best_once {
                let _removed: bool = this.off(best);
            }
            best_f(payload, best_ctx);
        }
    }

    // True when a listener with this token is still registered (paused or
    // not).
    fn has(this, id: u64) -> bool {
        if id == 0u64 { return false; }
        var i: usize = 0usize;
        let n: usize = this._subs.count();
        while i < n {
            match this._subs.at_ptr(i) {
                option::Option[*BusListener]::Some(p) => {
                    if { (*p).id } == id { return true; }
                }
                option::Option::None => {}
            }
            i = i + 1usize;
        }
        return false;
    }

    // Mute the listener with this token: it stays registered, keeps its
    // place in the order, and is skipped by emit until `resume`. False when
    // the token is unknown.
    fn pause(ref this, id: u64) -> bool {
        return this._set_paused(id, true);
    }

    // Undo `pause`. False when the token is unknown.
    fn resume(ref this, id: u64) -> bool {
        return this._set_paused(id, false);
    }

    fn _set_paused(ref this, id: u64, paused: bool) -> bool {
        if id == 0u64 { return false; }
        var i: usize = 0usize;
        let n: usize = this._subs.count();
        while i < n {
            var hit: bool = false;
            match this._subs.at_ptr(i) {
                option::Option[*BusListener]::Some(p) => {
                    if { (*p).id } == id {
                        { (*p).paused = paused; }
                        hit = true;
                    }
                }
                option::Option::None => {}
            }
            if hit { return true; }
            i = i + 1usize;
        }
        return false;
    }

    // Number of listeners registered for `name`.
    fn count(this, name: str) -> usize {
        var total: usize = 0usize;
        var i: usize = 0usize;
        let n: usize = this._subs.count();
        while i < n {
            match this._subs.at_ptr(i) {
                option::Option[*BusListener]::Some(p) => {
                    if { (*p).name } == name { total = total + 1usize; }
                }
                option::Option::None => {}
            }
            i = i + 1usize;
        }
        return total;
    }

    // Drop every listener for every name.
    fn remove_all(ref this) {
        this._subs.remove_all();
    }
}

// A handle to one Bus registration — what `Bus.on` and the module verbs
// return. The handle OWNS the registration: dropping it cancels the
// listener, so a component that stores its handles in fields unsubscribes
// automatically when it drops. `detach()` opts out for fire-and-forget
// wiring. The bus must outlive the handle (its drop reaches the bus by
// address) and must not move — the shared bus always qualifies. A zeroed
// handle (`none()`, or a failed `on`) is inert.
struct Subscription {
    opaque _bus: *Bus,
    _id: u64,
}

impl Subscription {
    // The inert handle — for fields that subscribe later.
    fn none() -> Subscription {
        return Subscription { _bus: 0 as *Bus, _id: 0u64 };
    }

    // The raw token, for the advanced `off(id)` surface.
    fn id(this) -> u64 {
        return this._id;
    }

    // Still registered (paused or not)?
    fn active(this) -> bool {
        if this._id == 0u64 { return false; }
        return { (*this._bus).has(this._id) };
    }

    // Remove the listener and make the handle inert. False when already
    // removed or inert.
    fn cancel(ref this) -> bool {
        if this._id == 0u64 { return false; }
        let removed: bool = { (*this._bus).off(this._id) };
        this._id = 0u64;
        return removed;
    }

    // Keep the registration for the life of the bus, give up control: the
    // handle becomes inert and its drop no longer cancels.
    fn detach(ref this) {
        this._id = 0u64;
    }

    // Mute the listener without removing it. False when unknown or inert.
    fn pause(this) -> bool {
        if this._id == 0u64 { return false; }
        return { (*this._bus).pause(this._id) };
    }

    // Undo `pause`. False when unknown or inert.
    fn resume(this) -> bool {
        if this._id == 0u64 { return false; }
        return { (*this._bus).resume(this._id) };
    }

    // Dropping the handle cancels its registration (inert handles no-op).
    fn drop(ref this) {
        if this._id == 0u64 { return; }
        let _removed: bool = { (*this._bus).off(this._id) };
    }
}

// ---- the app-wide bus --------------------------------------------------------

// One process-wide Bus, for the common case where sender and receiver share
// nothing but this package. Lazily initialized on first use (token numbering
// starts at 1, so a zeroed `_next_id` marks "not yet initialized").
static SHARED_BUS: Bus = #zero::[Bus]();

// `keeps(nothing)` because the only thing stored through the pointer is a
// FRESH EMPTY `Vec[BusListener]` — nothing borrowed exists yet to escape.
// The checker asks because `BusListener` carries a `str` name (E0516); the
// lifetime question that field really raises belongs to `on`, not here.
#[keeps(nothing)]
fn shared() -> *Bus {
    let b: *Bus = { #addr_of(SHARED_BUS) };
    if { (*b)._next_id } == 0u64 {
        { (*b)._subs = vec::Vec[BusListener]::new(); }
        { (*b)._next_id = 1u64; }
    }
    return b;
}

// ---- module verbs (the shared bus, pointer-free) -----------------------------
//
// The surface for the common case. Each verb forwards to `shared()`, so app
// code never touches `*Bus`:
//
//     events::on("file:open", open_file);
//     events::emit("file:open", payload: path);
//
// Bound methods work here too: `events::on("file:open", this.on_open)`.

fn on(name: str, f: fn(str, *u8), ctx: *u8 = 0 as *u8, once: bool = false) -> Subscription {
    let b: *Bus = shared();
    return { (*b).on(name, f, ctx: ctx, once: once) };
}

fn once(name: str, f: fn(str, *u8), ctx: *u8 = 0 as *u8) -> Subscription {
    let b: *Bus = shared();
    return { (*b).once(name, f, ctx: ctx) };
}

fn off(id: u64) -> bool {
    let b: *Bus = shared();
    return { (*b).off(id) };
}

fn off_all(name: str) {
    let b: *Bus = shared();
    { (*b).off_all(name); }
}

fn off_ctx(ctx: *u8) -> usize {
    let b: *Bus = shared();
    return { (*b).off_ctx(ctx) };
}

fn emit(name: str, payload: str = "") {
    let b: *Bus = shared();
    { (*b).emit(name, payload: payload); }
}

fn count(name: str) -> usize {
    let b: *Bus = shared();
    return { (*b).count(name) };
}

fn remove_all() {
    let b: *Bus = shared();
    { (*b).remove_all(); }
}
