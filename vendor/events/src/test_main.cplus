import "./events" as events;
import "stdlib/io" as io;

// events test root — `cpc test` discovers the `#[test]` fns below. State
// shared with handlers lives in statics (handlers are free fns); every test
// resets what it uses.
//
// `on` returns an owning subscription handle: dropping it cancels the
// registration. Tests therefore BIND every handle (a bare `on(...)`
// statement would unsubscribe immediately) and call `detach()` where a
// registration must outlive its handle.

// ---- shared handler state ----------------------------------------------------

static LOG: i64 = 0;        // order-sensitive accumulator: LOG = LOG*10 + digit
static HITS: i64 = 0;       // plain counter
static SEEN: i64 = 0;       // last payload seen
static NEST_DEPTH: i64 = 0; // nested-emit guard

fn reset() {
    LOG = 0;
    HITS = 0;
    SEEN = 0;
    NEST_DEPTH = 0;
}

// ---- Signal: order, ctx, payload ----------------------------------------------

fn log_digit(v: i64, ctx: *u8) {
    LOG = LOG * 10 + (ctx as i64);
    SEEN = v;
}

#[test]
fn signal_emits_in_subscription_order_with_ctx() {
    reset();
    var s: events::Signal[i64] = events::Signal[i64]::new();
    let _a: events::SignalSubscription[i64] = s.on(log_digit, ctx: 1 as *u8);
    let _b: events::SignalSubscription[i64] = s.on(log_digit, ctx: 2 as *u8);
    let _c: events::SignalSubscription[i64] = s.on(log_digit, ctx: 3 as *u8);
    s.emit(42);
    assert LOG == 123;
    assert SEEN == 42;
    assert s.count() == 3usize;
}

#[test]
fn signal_emit_with_no_listeners_is_noop() {
    reset();
    var s: events::Signal[i64] = events::Signal[i64]::new();
    s.emit(7);
    assert LOG == 0;
    assert s.is_empty();
}

fn read_str(v: str, ctx: *u8) {
    HITS = HITS + (#str_len(v) as i64);
}

#[test]
fn signal_str_payload_borrows() {
    reset();
    var s: events::Signal[str] = events::Signal[str]::new();
    let _a: events::SignalSubscription[str] = s.on(read_str);
    s.emit("hello");
    s.emit("hi");
    assert HITS == 7;
}

// ---- Signal: once ---------------------------------------------------------------

fn bump(v: i64, ctx: *u8) {
    HITS = HITS + v;
}

#[test]
fn signal_once_fires_exactly_once() {
    reset();
    var s: events::Signal[i64] = events::Signal[i64]::new();
    let _a: events::SignalSubscription[i64] = s.on(bump);
    let _b: events::SignalSubscription[i64] = s.once(bump);
    s.emit(1);
    assert HITS == 2;
    s.emit(1);
    assert HITS == 3;
    assert s.count() == 1usize;
}

// A once handler that re-subscribes itself: the fresh registration must wait
// for the NEXT emit (tokens issued mid-emit are above the ceiling). The
// handler detaches its handle — the registration must outlive the call.
static RESUB_SIG: events::Signal[i64] = #zero::[events::Signal[i64]]();

fn resub_sig() -> *events::Signal[i64] { return { #addr_of(RESUB_SIG) }; }

fn resub(v: i64, ctx: *u8) {
    HITS = HITS + 1;
    let s: *events::Signal[i64] = resub_sig();
    var sub: events::SignalSubscription[i64] = { (*s).once(resub) };
    sub.detach();
}

#[test]
fn signal_once_resubscribing_defers_to_next_emit() {
    reset();
    RESUB_SIG = events::Signal[i64]::new();
    let s: *events::Signal[i64] = resub_sig();
    var first: events::SignalSubscription[i64] = { (*s).once(resub) };
    first.detach();
    { (*s).emit(0); }
    assert HITS == 1;
    { (*s).emit(0); }
    assert HITS == 2;
    { (*s).remove_all(); }
}

// ---- Signal: cancel / off ------------------------------------------------------

#[test]
fn signal_cancel_removes_and_reports() {
    reset();
    var s: events::Signal[i64] = events::Signal[i64]::new();
    var a: events::SignalSubscription[i64] = s.on(bump);
    var b: events::SignalSubscription[i64] = s.on(bump);
    assert a.cancel();
    assert !a.cancel();        // already removed; handle went inert
    assert !s.off(0u64);       // never a valid token
    assert !s.off(9999u64);    // never issued
    s.emit(5);
    assert HITS == 5;          // only b left
    assert b.cancel();
}

#[test]
fn signal_remove_all_drops_everything() {
    reset();
    var s: events::Signal[i64] = events::Signal[i64]::new();
    var a: events::SignalSubscription[i64] = s.on(bump);
    let _b: events::SignalSubscription[i64] = s.on(bump);
    let a_id: u64 = a.id();
    s.remove_all();
    assert s.is_empty();
    assert !s.off(a_id);       // stale token after remove_all
    s.emit(3);
    assert HITS == 0;
}

// ---- Signal: handle ownership --------------------------------------------------

#[test]
fn signal_handle_drop_unsubscribes() {
    reset();
    var s: events::Signal[i64] = events::Signal[i64]::new();
    {
        var a: events::SignalSubscription[i64] = s.on(bump);
        s.emit(2);
        assert HITS == 2;
        assert a.active();
    }
    assert s.count() == 0usize;   // the handle's drop cancelled it
    s.emit(3);
    assert HITS == 2;
}

#[test]
fn signal_detach_keeps_registration() {
    reset();
    var s: events::Signal[i64] = events::Signal[i64]::new();
    {
        var a: events::SignalSubscription[i64] = s.on(bump);
        a.detach();
    }
    s.emit(4);
    assert HITS == 4;             // survived the handle's drop
    s.remove_all();
}

#[test]
fn signal_pause_and_resume() {
    reset();
    var s: events::Signal[i64] = events::Signal[i64]::new();
    var a: events::SignalSubscription[i64] = s.on(log_digit, ctx: 1 as *u8);
    let _b: events::SignalSubscription[i64] = s.on(log_digit, ctx: 2 as *u8);
    assert a.pause();
    s.emit(1);
    assert LOG == 2;              // a skipped, b fired
    assert a.active();            // paused is still registered
    assert a.resume();
    s.emit(2);
    assert LOG == 212;            // a fires again, in its ORIGINAL place
}

#[test]
fn signal_paused_once_waits_for_resume() {
    reset();
    var s: events::Signal[i64] = events::Signal[i64]::new();
    var o: events::SignalSubscription[i64] = s.once(bump);
    assert o.pause();
    s.emit(5);
    assert HITS == 0;
    assert s.count() == 1usize;   // skipped, still registered
    assert o.resume();
    s.emit(7);
    assert HITS == 7;
    assert s.count() == 0usize;   // fired once, removed
}

#[test]
fn inert_handles_are_safe() {
    var sn: events::SignalSubscription[i64] = events::SignalSubscription[i64]::none();
    assert !sn.active();
    assert !sn.cancel();
    assert !sn.pause();
    assert !sn.resume();
    var bn: events::Subscription = events::Subscription::none();
    assert !bn.active();
    assert !bn.cancel();
    assert !bn.pause();
    assert !bn.resume();
}

// ---- Signal: mutation during dispatch ---------------------------------------------

// Listener 1 removes listener 2 (a later token) mid-emit: 2 must not fire.
static KILL_SIG: events::Signal[i64] = #zero::[events::Signal[i64]]();
static KILL_TARGET: u64 = 0u64;

fn kill_sig() -> *events::Signal[i64] { return { #addr_of(KILL_SIG) }; }

fn killer(v: i64, ctx: *u8) {
    HITS = HITS + 1;
    let s: *events::Signal[i64] = kill_sig();
    let _r: bool = { (*s).off(KILL_TARGET) };
}

#[test]
fn signal_off_during_emit_skips_removed_listener() {
    reset();
    KILL_SIG = events::Signal[i64]::new();
    let s: *events::Signal[i64] = kill_sig();
    var a: events::SignalSubscription[i64] = { (*s).on(killer) };
    a.detach();
    var kt: events::SignalSubscription[i64] = { (*s).on(bump) };
    KILL_TARGET = kt.id();
    kt.detach();
    { (*s).emit(100); }
    assert HITS == 1;          // killer ran, bump never did
    assert KILL_SIG.count() == 1usize;
    { (*s).remove_all(); }
}

// A listener that adds a listener mid-emit: the addition waits for the next
// emit.
static GROW_SIG: events::Signal[i64] = #zero::[events::Signal[i64]]();

fn grow_sig() -> *events::Signal[i64] { return { #addr_of(GROW_SIG) }; }

fn grower(v: i64, ctx: *u8) {
    HITS = HITS + 1;
    let s: *events::Signal[i64] = grow_sig();
    var sub: events::SignalSubscription[i64] = { (*s).on(bump) };
    sub.detach();
}

#[test]
fn signal_on_during_emit_defers_to_next_emit() {
    reset();
    GROW_SIG = events::Signal[i64]::new();
    let s: *events::Signal[i64] = grow_sig();
    var a: events::SignalSubscription[i64] = { (*s).on(grower) };
    a.detach();
    { (*s).emit(0); }
    assert HITS == 1;                      // grower only; the added bump deferred
    assert GROW_SIG.count() == 2usize;
    { (*s).remove_all(); }
}

// A listener that re-emits the same signal (bounded): nested dispatch must
// complete and not disturb the outer pass.
static NEST_SIG: events::Signal[i64] = #zero::[events::Signal[i64]]();

fn nest_sig() -> *events::Signal[i64] { return { #addr_of(NEST_SIG) }; }

fn nester(v: i64, ctx: *u8) {
    HITS = HITS + v;
    if NEST_DEPTH == 0 {
        NEST_DEPTH = 1;
        let s: *events::Signal[i64] = nest_sig();
        { (*s).emit(10); }
    }
}

#[test]
fn signal_nested_emit_completes() {
    reset();
    NEST_SIG = events::Signal[i64]::new();
    let s: *events::Signal[i64] = nest_sig();
    var a: events::SignalSubscription[i64] = { (*s).on(nester) };
    a.detach();
    var b: events::SignalSubscription[i64] = { (*s).on(bump) };
    b.detach();
    { (*s).emit(1); }
    // outer: nester(1) -> nested emit(10) fires nester(10)+bump(10) -> bump(1)
    assert HITS == 22;
    { (*s).remove_all(); }
}

// ---- Signal: bound-method listeners ------------------------------------------------

struct Counter {
    total: i64,
}

impl Counter {
    fn add(ref this, v: i64) {
        this.total = this.total + v;
    }
}

#[test]
fn signal_bound_method_listener() {
    reset();
    var c: Counter = Counter { total: 0 };
    var s: events::Signal[i64] = events::Signal[i64]::new();
    let _sub: events::SignalSubscription[i64] = s.on(c.add);
    s.emit(5);
    s.emit(2);
    assert c.total == 7;
}

// ---- Bus ---------------------------------------------------------------------------

fn on_open(payload: str, ctx: *u8) {
    HITS = HITS + (#str_len(payload) as i64);
}

fn on_save(payload: str, ctx: *u8) {
    LOG = LOG + 1;
}

#[test]
fn bus_routes_by_name() {
    reset();
    var b: events::Bus = events::Bus::new();
    let _a: events::Subscription = b.on("file:open", on_open);
    let _b: events::Subscription = b.on("file:save", on_save);
    b.emit("file:open", payload: "abc");
    assert HITS == 3;
    assert LOG == 0;           // save listener untouched
    b.emit("file:save");
    assert LOG == 1;
    assert HITS == 3;
    b.emit("file:rename", payload: "x");   // no listeners: no-op
    assert HITS == 3;
    assert LOG == 1;
}

#[test]
fn bus_once_cancel_and_count() {
    reset();
    var b: events::Bus = events::Bus::new();
    var a: events::Subscription = b.on("tick", on_save);
    let _o: events::Subscription = b.once("tick", on_save);
    assert b.count("tick") == 2usize;
    b.emit("tick");
    assert LOG == 2;
    assert b.count("tick") == 1usize;      // once removed
    b.emit("tick");
    assert LOG == 3;
    assert a.cancel();
    assert !a.cancel();
    assert b.count("tick") == 0usize;
}

#[test]
fn bus_off_all_clears_one_name_only() {
    reset();
    var b: events::Bus = events::Bus::new();
    let _a: events::Subscription = b.on("tick", on_save);
    let _b: events::Subscription = b.on("tick", on_save);
    let _c: events::Subscription = b.on("tock", on_open);
    b.off_all("tick");
    assert b.count("tick") == 0usize;
    assert b.count("tock") == 1usize;
    b.emit("tick");
    assert LOG == 0;
    b.emit("tock", payload: "zz");
    assert HITS == 2;
    b.remove_all();
    assert b.count("tock") == 0usize;
}

#[test]
fn bus_handle_drop_unsubscribes() {
    reset();
    var b: events::Bus = events::Bus::new();
    {
        var sub: events::Subscription = b.on("tick", on_save);
        b.emit("tick");
        assert LOG == 1;
        assert sub.active();
    }
    assert b.count("tick") == 0usize;
    b.emit("tick");
    assert LOG == 1;
}

#[test]
fn bus_pause_and_resume() {
    reset();
    var b: events::Bus = events::Bus::new();
    var t: events::Subscription = b.on("tick", on_save);
    assert t.pause();
    b.emit("tick");
    assert LOG == 0;              // skipped
    assert t.active();
    assert t.resume();
    b.emit("tick");
    assert LOG == 1;
}

#[test]
fn bus_shared_is_one_instance() {
    reset();
    let a: *events::Bus = events::shared();
    let b: *events::Bus = events::shared();
    assert a == b;
    var sub: events::Subscription = { (*a).on("ping", on_save) };
    { (*b).emit("ping"); }
    assert LOG == 1;
    assert sub.cancel();
}

// ---- off_ctx: bulk receiver teardown ------------------------------------------

#[test]
fn signal_off_ctx_removes_by_identity() {
    reset();
    var s: events::Signal[i64] = events::Signal[i64]::new();
    let _a: events::SignalSubscription[i64] = s.on(bump, ctx: 1 as *u8);
    let _b: events::SignalSubscription[i64] = s.on(bump, ctx: 1 as *u8);
    let _c: events::SignalSubscription[i64] = s.on(bump, ctx: 2 as *u8);
    let removed: usize = s.off_ctx(1 as *u8);
    assert removed == 2usize;
    assert s.count() == 1usize;
    let none: usize = s.off_ctx(9 as *u8);   // unknown identity: no-op
    assert none == 0usize;
}

#[test]
fn bus_off_ctx_removes_across_names() {
    reset();
    var b: events::Bus = events::Bus::new();
    let _a: events::Subscription = b.on("tick", on_save, ctx: 5 as *u8);
    let _b: events::Subscription = b.on("tock", on_save, ctx: 5 as *u8);
    let _c: events::Subscription = b.on("tick", on_save, ctx: 6 as *u8);
    let removed: usize = b.off_ctx(5 as *u8);
    assert removed == 2usize;
    assert b.count("tick") == 1usize;
    assert b.count("tock") == 0usize;
}

// ---- module verbs: the pointer-free shared-bus surface --------------------------

#[test]
fn module_verbs_route_through_shared_bus() {
    reset();
    var a: events::Subscription = events::on("mv:ping", on_save);
    let _o: events::Subscription = events::once("mv:ping", on_save);
    assert events::count("mv:ping") == 2usize;
    events::emit("mv:ping");
    assert LOG == 2;
    assert events::count("mv:ping") == 1usize;   // once removed
    events::emit("mv:ping", payload: "x");
    assert LOG == 3;
    assert a.cancel();
    assert !a.cancel();
    assert events::count("mv:ping") == 0usize;
}

#[test]
fn module_handle_drop_unsubscribes_shared() {
    reset();
    {
        var sub: events::Subscription = events::on("mv:raii", on_save);
        events::emit("mv:raii");
        assert LOG == 1;
    }
    assert events::count("mv:raii") == 0usize;   // dropped with the scope
    events::emit("mv:raii");
    assert LOG == 1;
}

#[test]
fn module_off_all_and_off_ctx() {
    reset();
    let _a: events::Subscription = events::on("mv:a", on_save);
    let _b: events::Subscription = events::on("mv:a", on_save);
    let _c: events::Subscription = events::on("mv:b", on_open, ctx: 3 as *u8);
    events::off_all("mv:a");
    assert events::count("mv:a") == 0usize;
    assert events::count("mv:b") == 1usize;
    let removed: usize = events::off_ctx(3 as *u8);
    assert removed == 1usize;
    assert events::count("mv:b") == 0usize;
}

#[test]
fn module_remove_all_clears_shared_bus() {
    reset();
    var a: events::Subscription = events::on("mv:ra", on_save);
    let _b: events::Subscription = events::on("mv:rb", on_open);
    let a_id: u64 = a.id();
    events::remove_all();
    assert events::count("mv:ra") == 0usize;
    assert events::count("mv:rb") == 0usize;
    assert !events::off(a_id);   // stale token after remove_all
}

// A bound method registered through the module verb: `this` rides as ctx
// through the shared bus, payload arrives typed as `str`.
struct Recorder {
    total: i64,
}

impl Recorder {
    fn on_note(ref this, payload: str) {
        this.total = this.total + (#str_len(payload) as i64);
    }
}

#[test]
fn module_verb_bound_method_listener() {
    reset();
    var r: Recorder = Recorder { total: 0 };
    var sub: events::Subscription = events::on("mv:note", r.on_note);
    events::emit("mv:note", payload: "abc");
    events::emit("mv:note", payload: "de");
    assert r.total == 5;
    assert sub.cancel();
}

fn main() -> i32 {
    io::println("events: run `cpc test`");
    return 0;
}
