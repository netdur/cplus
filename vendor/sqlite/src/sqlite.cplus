// vendor/sqlite — idiomatic SQLite façade over `sqlite_ffi`.
//
// Connection + Statement with Result errors, str paths/SQL, owned column
// text, and Drop that closes/finalizes. Raw C entry points stay in
// sqlite_ffi for advanced use.

import "sqlite_ffi/sqlite" as raw;
import "stdlib/option" as option;
import "stdlib/result" as result;
import "stdlib/status" as status;
import "stdlib/text" as text;
import "stdlib/vec" as vec;

// ---- result codes (sqlite3.h; not emitted by bindgen) --------------------

fn ok_code() -> i32 { return 0 as i32; }
fn row_code() -> i32 { return 100 as i32; }
fn done_code() -> i32 { return 101 as i32; }

fn type_integer() -> i32 { return 1 as i32; }
fn type_float() -> i32 { return 2 as i32; }
fn type_text() -> i32 { return 3 as i32; }
fn type_blob() -> i32 { return 4 as i32; }
fn type_null() -> i32 { return 5 as i32; }

// OPEN_* flags
fn open_readonly() -> i32 { return 1 as i32; }
fn open_readwrite() -> i32 { return 2 as i32; }
fn open_create() -> i32 { return 4 as i32; }
fn open_uri() -> i32 { return 64 as i32; }
fn open_memory() -> i32 { return 128 as i32; }

// Default for open(path): read/write + create
fn open_default_flags() -> i32 {
    return open_readwrite() +% open_create();
}

// SQLITE_TRANSIENT — destructor that means "copy now"
fn destructor_transient() -> *u8 {
    return ((0 as isize) -% (1 as isize)) as *u8;
}

// ---- Error ---------------------------------------------------------------

struct Error {
    code: i32,
    message: text::Text,
}

fn c_strlen(p: *u8) -> usize {
    if { #addr(p) } == (0 as usize) { return 0 as usize; }
    var n: usize = 0 as usize;
    while { *(p + n) } != (0 as u8) {
        n = n +% (1 as usize);
    }
    return n;
}

fn text_from_c_ptr(p: *u8) -> text::Text {
    let n: usize = c_strlen(p);
    if n == (0 as usize) {
        return text::from_str("");
    }
    let view: str = { #str_from_raw_parts(p, n) };
    return text::from_str(view);
}

fn error_from_db(db: *u8) -> Error {
    let code: i32 = { raw::sqlite3_errcode(db) };
    let msg_p: *i8 = { raw::sqlite3_errmsg(db) };
    return Error { code: code, message: text_from_c_ptr(msg_p as *u8) };
}

fn error_code_only(code: i32) -> Error {
    let msg_p: *i8 = { raw::sqlite3_errstr(code) };
    return Error { code: code, message: text_from_c_ptr(msg_p as *u8) };
}

fn error_invalid(msg: str) -> Error {
    return Error { code: (0 as i32) -% (1 as i32), message: text::from_str(msg) };
}

// ---- Step ----------------------------------------------------------------

enum Step {
    Row,
    Done,
}

// ---- Column type ---------------------------------------------------------

enum ColumnType {
    Integer,
    Float,
    Text,
    Blob,
    Null,
    Unknown,
}

fn column_type_from_raw(t: i32) -> ColumnType {
    if t == type_integer() { return ColumnType::Integer; }
    if t == type_float() { return ColumnType::Float; }
    if t == type_text() { return ColumnType::Text; }
    if t == type_blob() { return ColumnType::Blob; }
    if t == type_null() { return ColumnType::Null; }
    return ColumnType::Unknown;
}

// ---- Connection ----------------------------------------------------------

struct Connection {
    opaque _db: *u8,
}

fn c_string(s: str) -> option::Option[text::CString] {
    return text::from_str(s).c_str();
}

impl Connection {
    // Open `path` with READWRITE|CREATE.
    fn open(path: str) -> result::Result[Connection, Error] {
        return Connection::open_with_flags(path, open_default_flags());
    }

    // Open with explicit OPEN_* flags (combine with +% or |).
    fn open_with_flags(path: str, flags: i32) -> result::Result[Connection, Error] {
        let path_c: option::Option[text::CString] = c_string(path);
        guard let option::Option[text::CString]::Some(cp) = path_c else {
            return result::Result[Connection, Error]::Err(
                error_invalid("path contains interior NUL")
            );
        };
        var db: *u8 = { 0 as *u8 };
        let rc: i32 = {
            raw::sqlite3_open_v2(
                cp.as_ptr() as *i8,
                #addr_of(db),
                flags,
                0 as *i8
            )
        };
        if rc != ok_code() {
            if { #addr(db) } != (0 as usize) {
                let e: Error = error_from_db(db);
                { raw::sqlite3_close_v2(db); }
                return result::Result[Connection, Error]::Err(e);
            }
            return result::Result[Connection, Error]::Err(error_code_only(rc));
        }
        return result::Result[Connection, Error]::Ok(Connection { _db: db });
    }

    // In-memory database (":memory:").
    fn open_memory() -> result::Result[Connection, Error] {
        return Connection::open(":memory:");
    }

    // Prepare a statement. Parameter indices for bind are 1-based.
    fn prepare(ref this, sql: str) -> result::Result[Statement, Error] {
        let sql_c: option::Option[text::CString] = c_string(sql);
        guard let option::Option[text::CString]::Some(cs) = sql_c else {
            return result::Result[Statement, Error]::Err(
                error_invalid("sql contains interior NUL")
            );
        };
        var stmt: *u8 = { 0 as *u8 };
        let rc: i32 = {
            raw::sqlite3_prepare_v2(
                this._db,
                cs.as_ptr() as *i8,
                (0 as i32) -% (1 as i32),
                #addr_of(stmt),
                0 as **i8
            )
        };
        if rc != ok_code() {
            return result::Result[Statement, Error]::Err(error_from_db(this._db));
        }
        return result::Result[Statement, Error]::Ok(Statement { _stmt: stmt });
    }

    // Run SQL that does not return rows (DDL / INSERT / UPDATE / DELETE).
    // Returns the number of rows changed (sqlite3_changes64).
    fn execute(ref this, sql: str) -> result::Result[i64, Error] {
        let prep: result::Result[Statement, Error] = this.prepare(sql);
        guard let result::Result[Statement, Error]::Ok(st0) = prep
            else |result::Result[Statement, Error]::Err(e)| {
            return result::Result[i64, Error]::Err(e);
        };
        var st: Statement = st0;
        loop {
            let step_r: result::Result[Step, Error] = st.step();
            guard let result::Result[Step, Error]::Ok(s) = step_r
                else |result::Result[Step, Error]::Err(e)| {
                return result::Result[i64, Error]::Err(e);
            };
            // Done ends the loop; Row is ignored for execute().
            let done: bool = match s {
                Step::Done => true,
                Step::Row => false,
            };
            if done {
                let n: i64 = this.changes();
                return result::Result[i64, Error]::Ok(n);
            }
        }
    }

    fn last_insert_rowid(this) -> i64 {
        return { raw::sqlite3_last_insert_rowid(this._db) };
    }

    fn changes(this) -> i64 {
        return { raw::sqlite3_changes64(this._db) };
    }

    // Soft busy wait up to `ms` milliseconds.
    fn set_busy_timeout(ref this, ms: i32) -> result::Result[bool, Error] {
        let rc: i32 = { raw::sqlite3_busy_timeout(this._db, ms) };
        if rc != ok_code() {
            return result::Result[bool, Error]::Err(error_from_db(this._db));
        }
        return result::Result[bool, Error]::Ok(true);
    }

    // Raw sqlite3* for advanced sqlite_ffi calls. Borrowed; do not close.
    fn raw_handle(this) -> *u8 {
        return this._db;
    }

    fn drop(ref this) {
        if { #addr(this._db) } != (0 as usize) {
            { raw::sqlite3_close_v2(this._db); }
            this._db = { 0 as *u8 };
        }
        return;
    }
}

// ---- Statement -----------------------------------------------------------

struct Statement {
    opaque _stmt: *u8,
}

impl Statement {
    fn db_ptr(this) -> *u8 {
        return { raw::sqlite3_db_handle(this._stmt) };
    }

    fn fail(this) -> Error {
        return error_from_db(this.db_ptr());
    }

    // Bind null at 1-based parameter index.
    fn bind_null(ref this, at: i32) -> result::Result[bool, Error] {
        let rc: i32 = { raw::sqlite3_bind_null(this._stmt, at) };
        if rc != ok_code() {
            return result::Result[bool, Error]::Err(this.fail());
        }
        return result::Result[bool, Error]::Ok(true);
    }

    fn bind_i32(ref this, at: i32, value: i32) -> result::Result[bool, Error] {
        let rc: i32 = { raw::sqlite3_bind_int(this._stmt, at, value) };
        if rc != ok_code() {
            return result::Result[bool, Error]::Err(this.fail());
        }
        return result::Result[bool, Error]::Ok(true);
    }

    fn bind_i64(ref this, at: i32, value: i64) -> result::Result[bool, Error] {
        let rc: i32 = { raw::sqlite3_bind_int64(this._stmt, at, value) };
        if rc != ok_code() {
            return result::Result[bool, Error]::Err(this.fail());
        }
        return result::Result[bool, Error]::Ok(true);
    }

    fn bind_f64(ref this, at: i32, value: f64) -> result::Result[bool, Error] {
        let rc: i32 = { raw::sqlite3_bind_double(this._stmt, at, value) };
        if rc != ok_code() {
            return result::Result[bool, Error]::Err(this.fail());
        }
        return result::Result[bool, Error]::Ok(true);
    }

    // Bind UTF-8 text; SQLite copies the bytes (TRANSIENT).
    fn bind_text(ref this, at: i32, value: str) -> result::Result[bool, Error] {
        let n: i32 = #str_len(value) as i32;
        let p: *i8 = #str_ptr(value) as *i8;
        let rc: i32 = {
            raw::sqlite3_bind_text(this._stmt, at, p, n, destructor_transient())
        };
        if rc != ok_code() {
            return result::Result[bool, Error]::Err(this.fail());
        }
        return result::Result[bool, Error]::Ok(true);
    }

    // Bind a blob; SQLite copies `n` bytes from `data`.
    fn bind_blob(ref this, at: i32, data: *u8, n: i32) -> result::Result[bool, Error] {
        let rc: i32 = {
            raw::sqlite3_bind_blob(this._stmt, at, data, n, destructor_transient())
        };
        if rc != ok_code() {
            return result::Result[bool, Error]::Err(this.fail());
        }
        return result::Result[bool, Error]::Ok(true);
    }

    // Advance one step: Row, Done, or Err.
    fn step(ref this) -> result::Result[Step, Error] {
        let rc: i32 = { raw::sqlite3_step(this._stmt) };
        if rc == row_code() {
            return result::Result[Step, Error]::Ok(Step::Row);
        }
        if rc == done_code() {
            return result::Result[Step, Error]::Ok(Step::Done);
        }
        return result::Result[Step, Error]::Err(this.fail());
    }

    fn reset(ref this) -> result::Result[bool, Error] {
        let rc: i32 = { raw::sqlite3_reset(this._stmt) };
        if rc != ok_code() {
            return result::Result[bool, Error]::Err(this.fail());
        }
        return result::Result[bool, Error]::Ok(true);
    }

    fn clear_bindings(ref this) -> result::Result[bool, Error] {
        let rc: i32 = { raw::sqlite3_clear_bindings(this._stmt) };
        if rc != ok_code() {
            return result::Result[bool, Error]::Err(this.fail());
        }
        return result::Result[bool, Error]::Ok(true);
    }

    fn column_count(this) -> i32 {
        return { raw::sqlite3_column_count(this._stmt) };
    }

    fn column_type(this, at: i32) -> ColumnType {
        let t: i32 = { raw::sqlite3_column_type(this._stmt, at) };
        return column_type_from_raw(t);
    }

    fn column_is_null(this, at: i32) -> bool {
        let t: i32 = { raw::sqlite3_column_type(this._stmt, at) };
        return t == type_null();
    }

    // 0-based column index → i64 (0 if NULL).
    fn column_i64(this, at: i32) -> i64 {
        return { raw::sqlite3_column_int64(this._stmt, at) };
    }

    fn column_i32(this, at: i32) -> i32 {
        return { raw::sqlite3_column_int(this._stmt, at) };
    }

    fn column_f64(this, at: i32) -> f64 {
        return { raw::sqlite3_column_double(this._stmt, at) };
    }

    // Owned copy of UTF-8 text, or None if NULL / empty pointer.
    fn column_text(this, at: i32) -> option::Option[text::Text] {
        if this.column_is_null(at) {
            return option::Option[text::Text]::None;
        }
        let p: *u8 = { raw::sqlite3_column_text(this._stmt, at) };
        if { #addr(p) } == (0 as usize) {
            return option::Option[text::Text]::None;
        }
        let n: i32 = { raw::sqlite3_column_bytes(this._stmt, at) };
        if n <= (0 as i32) {
            return option::Option[text::Text]::Some(text::from_str(""));
        }
        let view: str = { #str_from_raw_parts(p, n as usize) };
        return option::Option[text::Text]::Some(text::from_str(view));
    }

    // Owned copy of blob bytes, or None if NULL.
    fn column_blob(this, at: i32) -> option::Option[vec::Vec[u8]] {
        if this.column_is_null(at) {
            return option::Option[vec::Vec[u8]]::None;
        }
        let n: i32 = { raw::sqlite3_column_bytes(this._stmt, at) };
        if n <= (0 as i32) {
            return option::Option[vec::Vec[u8]]::Some(vec::new::[u8]());
        }
        let p: *u8 = { raw::sqlite3_column_blob(this._stmt, at) };
        if { #addr(p) } == (0 as usize) {
            return option::Option[vec::Vec[u8]]::Some(vec::new::[u8]());
        }
        var out: vec::Vec[u8] = vec::with_capacity::[u8](n as usize);
        var i: i32 = 0 as i32;
        while i < n {
            let b: u8 = { *(p + (i as usize)) };
            let _s: status::Status = out.append(b);
            i = i +% (1 as i32);
        }
        return option::Option[vec::Vec[u8]]::Some(out);
    }

    fn column_name(this, at: i32) -> option::Option[text::Text] {
        let p: *i8 = { raw::sqlite3_column_name(this._stmt, at) };
        if { #addr(p) } == (0 as usize) {
            return option::Option[text::Text]::None;
        }
        return option::Option[text::Text]::Some(text_from_c_ptr(p as *u8));
    }

    fn raw_handle(this) -> *u8 {
        return this._stmt;
    }

    fn drop(ref this) {
        if { #addr(this._stmt) } != (0 as usize) {
            { raw::sqlite3_finalize(this._stmt); }
            this._stmt = { 0 as *u8 };
        }
        return;
    }
}

// ---- Tests ---------------------------------------------------------------

#[test]
fn test_open_memory() {
    match Connection::open_memory() {
        result::Result[Connection, Error]::Ok(_) => { assert true; }
        result::Result[Connection, Error]::Err(_) => { assert false; }
    };
}

fn expect_step_done(r: result::Result[Step, Error]) {
    match r {
        result::Result[Step, Error]::Ok(s) => {
            let ok: bool = match s {
                Step::Done => true,
                Step::Row => false,
            };
            assert ok;
        }
        result::Result[Step, Error]::Err(_) => { assert false; }
    };
    return;
}

fn expect_execute_ok(r: result::Result[i64, Error]) {
    match r {
        result::Result[i64, Error]::Ok(_) => { assert true; }
        result::Result[i64, Error]::Err(_) => { assert false; }
    };
    return;
}

fn expect_step_row(r: result::Result[Step, Error]) {
    match r {
        result::Result[Step, Error]::Ok(s) => {
            let ok: bool = match s {
                Step::Row => true,
                Step::Done => false,
            };
            assert ok;
        }
        result::Result[Step, Error]::Err(_) => { assert false; }
    };
    return;
}

#[test]
fn test_execute_create_and_insert() {
    guard let result::Result[Connection, Error]::Ok(db0) = Connection::open_memory() else {
        assert false;
        return;
    };
    var db: Connection = db0;
    match db.execute("create table t(id integer primary key, name text not null)") {
        result::Result[i64, Error]::Ok(_) => { assert true; }
        result::Result[i64, Error]::Err(_) => { assert false; }
    };
    match db.execute("insert into t(name) values ('ada')") {
        result::Result[i64, Error]::Ok(n) => { assert n == (1 as i64); }
        result::Result[i64, Error]::Err(_) => { assert false; }
    };
    assert db.last_insert_rowid() == (1 as i64);
    return;
}

#[test]
fn test_prepare_bind_step_text() {
    guard let result::Result[Connection, Error]::Ok(db0) = Connection::open_memory() else {
        assert false;
        return;
    };
    var db: Connection = db0;
    let _c: result::Result[i64, Error] =
        db.execute("create table t(id integer primary key, name text)");
    let _i: result::Result[i64, Error] =
        db.execute("insert into t(name) values ('grace')");

    guard let result::Result[Statement, Error]::Ok(st0) =
        db.prepare("select id, name from t where name = ?1") else {
        assert false;
        return;
    };
    var st: Statement = st0;
    match st.bind_text(1 as i32, "grace") {
        result::Result[bool, Error]::Ok(_) => { assert true; }
        result::Result[bool, Error]::Err(_) => { assert false; }
    };
    expect_step_row(st.step());
    assert st.column_i64(0 as i32) == (1 as i64);
    match st.column_text(1 as i32) {
        option::Option[text::Text]::Some(t) => { assert t.equals("grace"); }
        option::Option[text::Text]::None => { assert false; }
    };
    expect_step_done(st.step());
    return;
}

#[test]
fn test_bind_null_and_types() {
    guard let result::Result[Connection, Error]::Ok(db0) = Connection::open_memory() else {
        assert false;
        return;
    };
    var db: Connection = db0;
    let _c: result::Result[i64, Error] =
        db.execute("create table t(a integer, b real, c text)");
    guard let result::Result[Statement, Error]::Ok(st0) =
        db.prepare("insert into t(a, b, c) values (?1, ?2, ?3)") else {
        assert false;
        return;
    };
    var st: Statement = st0;
    let _a: result::Result[bool, Error] = st.bind_i64(1 as i32, 7 as i64);
    let _b: result::Result[bool, Error] = st.bind_f64(2 as i32, 3.5f64);
    let _c2: result::Result[bool, Error] = st.bind_null(3 as i32);
    expect_step_done(st.step());

    guard let result::Result[Statement, Error]::Ok(q0) =
        db.prepare("select a, b, c from t") else {
        assert false;
        return;
    };
    var q: Statement = q0;
    expect_step_row(q.step());
    assert q.column_i64(0 as i32) == (7 as i64);
    assert q.column_f64(1 as i32) > 3.0f64;
    assert q.column_is_null(2 as i32);
    assert { raw::sqlite3_column_type(q.raw_handle(), 2 as i32) } == type_null();
    return;
}

#[test]
fn test_prepare_bad_sql_is_err() {
    guard let result::Result[Connection, Error]::Ok(db0) = Connection::open_memory() else {
        assert false;
        return;
    };
    var db: Connection = db0;
    match db.prepare("this is not sql !!!") {
        result::Result[Statement, Error]::Ok(_) => { assert false; }
        result::Result[Statement, Error]::Err(e) => {
            assert e.code != ok_code();
            assert e.message.count() > (0 as usize);
        }
    };
    return;
}

// `execute` on SQL that fails to prepare must hand back a LIVE error. The
// error travels out through `execute`'s `guard let ... else`, which is the
// shape that used to re-match the already-consumed local: the payload's
// destructor had run before the else body read it, so `message` arrived with
// a freed buffer (bugs/moved-from-local-is-readable-and-double-frees.md).
// Reading `message` here is the point of the test — a bare `code` check
// passes even on a corrupted error.
#[test]
fn test_execute_bad_sql_returns_a_live_error() {
    guard let result::Result[Connection, Error]::Ok(db0) = Connection::open_memory() else {
        assert false;
        return;
    };
    var db: Connection = db0;
    match db.execute("this is not sql !!!") {
        result::Result[i64, Error]::Ok(_) => { assert false; }
        result::Result[i64, Error]::Err(e) => {
            assert e.code != ok_code();
            assert e.message.count() > (0 as usize);
        }
    };
    return;
}

// The same path one level deeper: `execute` prepares fine, then `step` fails.
// A UNIQUE violation surfaces at step time, so this exercises the second
// `guard let ... else` in `execute`'s loop.
#[test]
fn test_execute_step_failure_returns_a_live_error() {
    guard let result::Result[Connection, Error]::Ok(db0) = Connection::open_memory() else {
        assert false;
        return;
    };
    var db: Connection = db0;
    expect_execute_ok(db.execute("CREATE TABLE t (k INTEGER PRIMARY KEY)"));
    expect_execute_ok(db.execute("INSERT INTO t (k) VALUES (1)"));
    match db.execute("INSERT INTO t (k) VALUES (1)") {
        result::Result[i64, Error]::Ok(_) => { assert false; }
        result::Result[i64, Error]::Err(e) => {
            assert e.code != ok_code();
            assert e.message.count() > (0 as usize);
        }
    };
    return;
}

#[test]
fn test_reset_and_rebind() {
    guard let result::Result[Connection, Error]::Ok(db0) = Connection::open_memory() else {
        assert false;
        return;
    };
    var db: Connection = db0;
    let _c: result::Result[i64, Error] =
        db.execute("create table t(n integer)");
    guard let result::Result[Statement, Error]::Ok(st0) =
        db.prepare("insert into t(n) values (?1)") else {
        assert false;
        return;
    };
    var st: Statement = st0;
    let _b1: result::Result[bool, Error] = st.bind_i32(1 as i32, 1 as i32);
    let _s1: result::Result[Step, Error] = st.step();
    let _r: result::Result[bool, Error] = st.reset();
    let _cb: result::Result[bool, Error] = st.clear_bindings();
    let _b2: result::Result[bool, Error] = st.bind_i32(1 as i32, 2 as i32);
    expect_step_done(st.step());
    assert db.changes() == (1 as i64);
    return;
}
