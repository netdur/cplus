// stdlib/fs.cplus — file system access.
//
// Built on libc open/read/write/close via `extern fn`. `File` is an owned
// handle; Drop closes the fd on scope exit, so opening without explicit
// close is safe.

import "./result" as result;
import "./vec" as vec;
import "./option" as option;
import "./status" as status;
// v0.0.5 Phase 4 Slice 4C: File::read_async needs the reactor's
// fd-readiness path. Phase 3 Slice 3D's File::lines is sync but
// the gen-method machinery needs Iterator[T] in scope.
import "./net" as net;
import "./iterator" as iterator;
import "./text" as text;

// `open` is variadic in libc — mode is only consumed when O_CREAT is in
// flags. The variadic decl matches the platform ABI exactly (on
// aarch64-darwin a fixed third arg lands in a register but libc's
// implementation reads it via `va_arg`, which expects stack passing).
extern fn open(path: *u8, flags: i32, ...) -> i32;
extern fn read(fd: i32, buf: *u8, count: usize) -> isize;
extern fn write(fd: i32, buf: *u8, count: usize) -> isize;
extern fn close(fd: i32) -> i32;
extern fn malloc(n: usize) -> *u8;
extern fn free(p: *u8);

// Directory + path ops. `mode_t` is `__uint16_t` on Darwin; `__error()` returns
// the address of `errno` (the thread-local). `readdir` yields the 64-bit-inode
// `struct dirent` (the default layout on modern macOS / Apple Silicon).
extern fn access(path: *u8, amode: i32) -> i32;
extern fn mkdir(path: *u8, mode: u16) -> i32;
extern fn unlink(path: *u8) -> i32;
extern fn opendir(path: *u8) -> *u8;
extern fn readdir(dirp: *u8) -> *u8;
extern fn closedir(dirp: *u8) -> i32;
extern fn __error() -> *i32;
extern fn strlen(s: *u8) -> usize;
// Darwin arm64 exposes the 64-bit-inode stat as the bare `stat` symbol (on
// x86_64 it is `stat$INODE64`; this build targets arm64 macOS).
extern fn stat(path: *u8, buf: *u8) -> i32;

// Owned file handle. `fd == -1` is the invalid / closed state (disarms Drop).
struct File {
    _fd: i32,
}

// Copy a `str` path into an owned NUL-terminated C string for libc. A `str` is
// a `(ptr, len)` VIEW with no guaranteed NUL at `ptr[len]`; handing
// `#str_ptr(path)` straight to open/access/mkdir/unlink/opendir makes libc read
// PAST the view until it finds a stray 0 byte — opening the wrong path, or
// ENOENT on a path that exists (any substring view, e.g. a line trimmed of its
// trailing '\n'). `text::CString` owns a malloc'd copy with the terminator
// (exactly `len` bytes copied — never reads past the view), valid for the whole
// call. `None` only when the path holds an interior NUL byte (not a valid path);
// an empty path yields a valid empty C string.
fn c_path(path: str) -> option::Option[text::CString] ;

// Open `path` for reading. macOS + Linux: O_RDONLY = 0.
fn open_read(path: str) -> result::Result[File, result::IoError] ;

// Open `path` for writing, creating + truncating if missing. Mode 0o644.
//
// macOS flags: O_WRONLY = 0x001, O_CREAT = 0x200, O_TRUNC = 0x400.
// Combined: 0x601 = 1537. (Linux numbers differ — Linux build is a Phase 1
// stretch; see plan.md non-goals.)
fn create(path: str) -> result::Result[File, result::IoError] ;

// Open `path` for appending, creating it if missing. Mode 0o644.
//
// macOS flags: O_WRONLY = 0x001, O_CREAT = 0x200, O_APPEND = 0x008.
// Combined: 0x209 = 521. (Linux numbers differ — same caveat as `create`.)
fn open_append(path: str) -> result::Result[File, result::IoError] ;

// File metadata from stat(2): size in bytes, mtime as Unix seconds (whole
// seconds since 1970-01-01 UTC), and whether the path is a directory. Enables
// an in-process mtime sort (retiring `ls -t | head`) and a cheap size probe
// (retiring the fopen/fseek(SEEK_END)/ftell dance).
struct Metadata {
    size: i64,      // st_size
    mtime: i64,     // st_mtimespec.tv_sec
    is_dir: bool,   // (st_mode & S_IFMT) == S_IFDIR
}

// Fields are read straight out of the Darwin (arm64, 64-bit-inode) `struct stat`,
// which is 144 bytes: st_mode is a u16 at byte 4; st_mtimespec.tv_sec an i64 at
// byte 48; st_size an i64 at byte 96. S_IFMT = 0xF000, S_IFDIR = 0x4000.
fn metadata(path: str) -> result::Result[Metadata, result::IoError] ;

// Size in bytes — the common single-field probe over `metadata`.
fn size(path: str) -> result::Result[i64, result::IoError] ;

// Modification time (Unix seconds) — for an in-process newest-first sort.
fn mtime(path: str) -> result::Result[i64, result::IoError] ;

// Does the path exist AND name a directory? False on any error (incl. missing).
fn is_dir(path: str) -> bool ;

impl File {
    // Drain remaining bytes into a fresh heap-allocated buffer. Returns
    // the Vec inside Result::Ok on success, or an IoError on failure.
    fn read_to_end(ref this) -> result::Result[vec::Vec[u8], result::IoError] ;

    // Write `data`. Loops on short writes. On success returns bytes written
    // (always == data.count()); errors return Err.
    fn write_all(ref this, data: vec::Vec[u8]) -> result::Result[usize, result::IoError] ;

    // Write a string view. Loops on short writes, like `write_all`, but takes
    // the bytes straight from the `str` — no intermediate Vec. A `Text` passed
    // here coerces to its view. On success returns bytes written.
    fn write_str(ref this, s: str) -> result::Result[usize, result::IoError] ;

    // Explicit close. Disarms Drop by setting fd to -1.
    fn close(ref this) ;

    // v0.0.5 Phase 4 Slice 4C: flip O_NONBLOCK on the underlying fd so
    // `read_async` can return EAGAIN-loops instead of blocking the
    // executor thread. Idempotent; safe to call repeatedly. Returns 0
    // on success, -1 on fcntl error.
    fn make_nonblocking(ref this) -> i32 ;

    // v0.0.5 Phase 4 Slice 4C: async read. Same semantics as
    // `net::read_fd_async(this._fd, buf, count)` — reactor handles
    // EAGAIN suspension via kqueue EVFILT_READ. Prerequisite: call
    // `make_nonblocking()` once before first use.
    async fn read_async(ref this, buf: *u8, count: usize) -> isize ;

    // v0.0.5 Phase 3 Slice 3D: iterator over '\n'-separated lines.
    // Reads the file in 4 KiB chunks; each yielded `Text` is the
    // line *without* its trailing newline. The carry buffer holds the
    // partial line that spans a chunk boundary, copied into the next
    // chunk's scan. A final fragment without a trailing newline at EOF
    // is yielded as the last line.
    gen fn lines(this) -> text::Text ;

    // Destructor: close the fd if not already closed.
    fn drop(ref this) ;
}

// ─────────────────────── directory / path ops ───────────────────────

// errno as an `IoError`. Only the file-system-relevant codes are named; the
// rest collapse to `Other`.
fn errno() -> i32 ;
fn errno_as_ioerror() -> result::IoError ;

// True if `path` exists (file, directory, or any other node).
fn exists(path: str) -> bool ;

// Create the single directory `path` with mode 0o755. `Err(AlreadyExists)` if it
// is already present — use `create_dir_all` to create parents idempotently.
fn create_dir(path: str) -> result::Result[bool, result::IoError] ;

// Create `path` and every missing parent, like `mkdir -p`. Idempotent: an
// already-existing directory on the path is treated as success (EEXIST is
// swallowed); any other failure stops and returns the reason.
fn create_dir_all(path: str) -> result::Result[bool, result::IoError] ;

// Delete the file at `path`. `Err(NotFound)` if it does not exist.
fn remove_file(path: str) -> result::Result[bool, result::IoError] ;

// `true` for the dirent name "." or "..".
fn _is_dot_entry(p: *u8, len: usize) -> bool ;

// The entry names in directory `path` (excluding "." and ".."), or `None` if the
// directory can't be opened. Names only — not full paths.
fn read_dir(path: str) -> option::Option[vec::Vec[text::Text]] ;

// Read the whole file at `path` into an owned Text, validating UTF-8. Combines
// `open_read` + `File::read_to_end` + `text::from_utf8`; the fd is closed on
// return either way. A non-UTF-8 file is `IoError::InvalidData`. This is the
// tidy path for config / JSON files — feed the Text straight to a parser. Use
// `File::read_to_end` when you want the raw bytes instead.
fn read_to_string(path: str) -> result::Result[text::Text, result::IoError] ;

// Write `contents` to the file at `path`, creating it and replacing what was
// there. Combines `create` + `File::write_str` + `close`; the fd is closed on
// return either way. The mirror of `read_to_string` — and since a `Text`
// coerces to `str`, `fs::write_string(path, "${n}")` writes an interpolated
// value in one call. On success returns bytes written. Use `create` +
// `write_all` when you want raw bytes or several writes into one open file.
fn write_string(path: str, contents: str) -> result::Result[usize, result::IoError] ;

// Append `contents` to the file at `path`, creating it if missing. Combines
// `open_append` + `File::write_str` + `close`; the fd is closed on return
// either way. For logs and transports where history must survive; use
// `write_string` when the new content replaces the old. On success returns
// bytes written.
fn append_string(path: str, contents: str) -> result::Result[usize, result::IoError] ;

