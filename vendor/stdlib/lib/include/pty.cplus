// stdlib/pty.cplus — run a child under a pseudo-terminal.
//
// The difference from `process`: a pipe is not a terminal. A child on pipes has
// no controlling tty, so it takes its non-interactive path — block buffering,
// no prompt, no job control — and cannot be sent Ctrl-C or told the window
// resized. A pty child believes it is on a terminal, because it is.
//
// NOT forkpty. forkpty(3) forks, and this library is used from threaded apps
// (facet's reactor, worker threads), where a forked child may only touch
// async-signal-safe calls before exec — the same reason `process` uses
// posix_spawn rather than fork+exec. Instead: openpty(3) for the pair, then
// posix_spawn with POSIX_SPAWN_SETSID so the child becomes a session leader,
// and a file action that OPENS the slave by path in the child. Opening a tty as
// a session leader with no controlling terminal is what makes it the
// controlling terminal — dup2 alone would not.
//
// The master end is an ordinary fd: hand `read_fd()` to the async reactor
// (`net::read_fd_async`) exactly as with a pipe.


import "./text" as text;
import "./option" as option;
import "./vec" as vec;
import "./status" as status;

extern fn openpty(amaster: *i32, aslave: *i32, name: *u8, termp: *u8, winp: *u8) -> i32;
extern fn close(fd: i32) -> i32;
extern fn read(fd: i32, buf: *u8, count: usize) -> isize;
extern fn write(fd: i32, buf: *u8, count: usize) -> isize;
extern fn waitpid(pid: i32, status: *i32, options: i32) -> i32;
extern fn kill(pid: i32, sig: i32) -> i32;
extern fn malloc(n: usize) -> *u8;
extern fn free(p: *u8);
extern fn __error() -> *i32;
// ioctl is VARIADIC — declaring it fixed-arity passes the third argument in a
// register the callee never reads on AArch64-darwin (see the same note on
// fcntl in process.cplus).
extern fn ioctl(fd: i32, request: u64, ...) -> i32;
extern fn posix_spawn_file_actions_init(fa: *u8) -> i32;
extern fn posix_spawn_file_actions_destroy(fa: *u8) -> i32;
extern fn posix_spawn_file_actions_adddup2(fa: *u8, fd: i32, newfd: i32) -> i32;
extern fn posix_spawn_file_actions_addopen(fa: *u8, fd: i32, path: *u8, oflag: i32, mode: u16) -> i32;
extern fn posix_spawn_file_actions_addclose(fa: *u8, fd: i32) -> i32;
extern fn posix_spawn_file_actions_addchdir_np(fa: *u8, path: *u8) -> i32;
extern fn posix_spawnattr_init(attr: *u8) -> i32;
extern fn posix_spawnattr_destroy(attr: *u8) -> i32;
extern fn posix_spawnattr_setflags(attr: *u8, flags: i16) -> i32;
extern fn posix_spawnp(pid: *i32, file: *u8, file_actions: *u8, attrp: *u8, argv: *u8, envp: *u8) -> i32;
extern fn _NSGetEnviron() -> *u8;

fn e_intr() -> i32 ;
fn sig_int() -> i32 ;        // Ctrl-C
fn sig_term() -> i32 ;
fn sig_kill() -> i32 ;
fn o_rdwr() -> i32 ;
// POSIX_SPAWN_SETSID (sys/spawn.h): the child leads a new session, so the tty
// it opens becomes its controlling terminal.
fn spawn_setsid() -> i16 ;
// TIOCSWINSZ = _IOW('t', 103, struct winsize) = 0x80087467 — tell the child's
// terminal its new size; the kernel then sends it SIGWINCH.
fn tiocswinsz() -> u64 ;

// A child running under a pty. Owns the master fd, which is closed on drop.
// Like process::Child, every accessor takes `ref this`: a by-value receiver
// would move the value into the method and drop it on return, closing the
// master out from under the caller.
struct PtyChild {
    _pid: i32,
    _master: i32,     // -1 once closed/taken
}

// Decode a waitpid status word: exit code, or 128 + signal when killed.
fn decode_status(status_word: i32) -> i32 ;

// `struct winsize { unsigned short ws_row, ws_col, ws_xpixel, ws_ypixel; }`
fn winsize_new(cols: u16, rows: u16) -> *u8 ;

// Start `argv[0]` (searched on PATH) under a new pty of `cols` x `rows`, in
// working directory `cwd` ("" inherits). `None` if argv is empty, a string
// holds an interior NUL, the pty cannot be allocated, or the spawn fails.
//
// Every parameter is required: a pty's size is not something to default
// silently, and `cwd` reads better stated than assumed.
fn spawn(argv: vec::Vec[text::Text], cwd: str, cols: u16, rows: u16) -> option::Option[PtyChild] ;



impl PtyChild {
    fn pid(ref this) -> i32 ;

    // The master fd — readable AND writable, unlike a pipe pair. Hand it to the
    // async reactor to stream output.
    fn read_fd(ref this) -> i32 ;

    // Give the fd away; this PtyChild no longer closes it on drop.
    fn take_fd(ref this) -> i32 ;

    // Write to the child's terminal input, looping over partial writes. This is
    // how a keystroke reaches the program — including a raw control byte.
    fn write(ref this, data: str) -> isize ;

    // Read whatever the terminal has produced. -1 on error; 0 at EOF (the child
    // closed its end). Non-blocking behaviour follows the fd's own flags.
    fn read(ref this, buf: *u8, count: usize) -> isize ;

    // Tell the child's terminal it was resized; the kernel sends it SIGWINCH,
    // which is how a full-screen program learns to redraw.
    fn resize(ref this, cols: u16, rows: u16) -> bool ;

    // Signals. `interrupt` is Ctrl-C — the thing pipes cannot deliver.
    fn signal(ref this, sig: i32) -> bool ;
    fn interrupt(ref this) -> bool ;
    fn terminate(ref this) -> bool ;
    fn kill_now(ref this) -> bool ;

    // Reap the child; 128 + signal if it was killed, -1 if there is nothing to
    // reap. Retries on EINTR — waitpid returning -1 leaves the status word
    // unwritten, so decoding it without the retry reports a random exit.
    fn wait(ref this) -> i32 ;

    // Close the master. The child is NOT reaped here: a blocking waitpid in a
    // destructor would hang an arbitrary caller. Call wait().
    fn drop(ref this) ;
}

// ───────────────────────────── tests ─────────────────────────────

// NOTE on coverage: spawning is not exercised from `cpc test` — a child spawned
// inside the test driver deadlocks the harness (the same limit process.cplus
// documents, bugs/process_spawn_test_harness_hang.md). The pure pieces are
// covered here; the live pty is verified by a standalone binary.

#[test]
fn winsize_is_packed_rows_then_cols() ;

#[test]
fn tiocswinsz_matches_the_kernel_encoding() ;

#[test]
fn pty_decode_status_reads_exit_code_and_signal() ;

#[test]
fn empty_argv_is_none() ;
