// stdlib/atomic.cplus — atomic memory operations on raw pointers.
//
// v0.0.3 Phase 5 Slice 5A. The compiler exposes per-(op, type, ordering)
// intrinsics named `__cplus_atomic_<op>_<ty>_<ordering>`; this module wraps
// them behind ergonomic free functions that take a runtime `Ordering`.
//
// **Why free fns on raw pointers, not an `Atomic[T]` struct.** A struct
// wrapper would require generics-with-width-dispatch (each width calls a
// different intrinsic), which compounds the v0.0.3 generic-method
// limitations. Shipping free fns now keeps the surface ~250 lines and
// covers every Phase 5B/5C threading use case (the parallel-sum recipe
// doesn't need shared state at all; the concurrent-counter recipe in 5D
// shares a `*u64` directly). A struct wrapper can layer on later.
//
// **Why `unsafe` is required.** Every atomic op reads/writes through a
// raw pointer whose validity the compiler can't prove (alignment,
// pointee lifetime, no concurrent non-atomic access). The wrappers
// here forward the `unsafe` requirement: callers must wrap atomic
// calls in `{ ... }` themselves.

enum Ordering {
    Relaxed,
    Acquire,
    Release,
    AcqRel,
    SeqCst,
}

// ============================================================
// i32
// ============================================================

fn load_i32(p: *i32, ordering: Ordering) -> i32 ;

fn store_i32(p: *i32, val: i32, ordering: Ordering) ;

fn swap_i32(p: *i32, val: i32, ordering: Ordering) -> i32 ;

fn fetch_add_i32(p: *i32, val: i32, ordering: Ordering) -> i32 ;

fn fetch_sub_i32(p: *i32, val: i32, ordering: Ordering) -> i32 ;

fn fetch_and_i32(p: *i32, val: i32, ordering: Ordering) -> i32 ;

fn fetch_or_i32(p: *i32, val: i32, ordering: Ordering) -> i32 ;

fn fetch_xor_i32(p: *i32, val: i32, ordering: Ordering) -> i32 ;

// Returns the previous value at `*p`. Compare against `expected` to
// detect success. Uses a single ordering for both success and failure
// (the compiler lowers `release` → success=release, failure=monotonic,
// etc., to satisfy LLVM's "failure-ordering ≤ success-ordering" constraint).
fn compare_exchange_i32(p: *i32, expected: i32, desired: i32, ordering: Ordering) -> i32 ;

// ============================================================
// i64
// ============================================================

fn load_i64(p: *i64, ordering: Ordering) -> i64 ;

fn store_i64(p: *i64, val: i64, ordering: Ordering) ;

fn swap_i64(p: *i64, val: i64, ordering: Ordering) -> i64 ;

fn fetch_add_i64(p: *i64, val: i64, ordering: Ordering) -> i64 ;

fn fetch_sub_i64(p: *i64, val: i64, ordering: Ordering) -> i64 ;

fn fetch_and_i64(p: *i64, val: i64, ordering: Ordering) -> i64 ;

fn fetch_or_i64(p: *i64, val: i64, ordering: Ordering) -> i64 ;

fn fetch_xor_i64(p: *i64, val: i64, ordering: Ordering) -> i64 ;

fn compare_exchange_i64(p: *i64, expected: i64, desired: i64, ordering: Ordering) -> i64 ;

// ============================================================
// u32
// ============================================================

fn load_u32(p: *u32, ordering: Ordering) -> u32 ;

fn store_u32(p: *u32, val: u32, ordering: Ordering) ;

fn fetch_add_u32(p: *u32, val: u32, ordering: Ordering) -> u32 ;

fn fetch_sub_u32(p: *u32, val: u32, ordering: Ordering) -> u32 ;

fn compare_exchange_u32(p: *u32, expected: u32, desired: u32, ordering: Ordering) -> u32 ;

// ============================================================
// u64
// ============================================================

#[no_alloc] #[no_block]
fn load_u64(p: *u64, ordering: Ordering) -> u64 ;

#[no_alloc] #[no_block]
fn store_u64(p: *u64, val: u64, ordering: Ordering) ;

#[no_alloc] #[no_block]
fn fetch_add_u64(p: *u64, val: u64, ordering: Ordering) -> u64 ;

#[no_alloc] #[no_block]
fn fetch_sub_u64(p: *u64, val: u64, ordering: Ordering) -> u64 ;

#[no_alloc] #[no_block]
fn compare_exchange_u64(p: *u64, expected: u64, desired: u64, ordering: Ordering) -> u64 ;

// v0.0.12 G-030 (llama.cplus G-029): standalone memory fence — no
// pointer, no value, just a barrier. Maps to LLVM's `fence` instruction
// with the matching ordering. `Relaxed` is a no-op per C and LLVM
// (LLVM rejects `fence monotonic`; codegen emits nothing). Required
// by `ggml_barrier`-style spin-wait publish patterns where the
// publishing store has already happened on another path and we need
// to seal the happens-before edge with a separate fence.
#[no_alloc] #[no_block]
fn fence(ordering: Ordering) ;

