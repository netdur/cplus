// stdlib/bundle.cplus — locate the running executable and resources beside it,
// WITHOUT mutating the process CWD.
//
// The pattern this replaces: resolve the executable, walk up looking for a
// resource root, then `chdir` into it so later relative paths resolve — a
// process-global side effect every subsequent path silently depends on. Here the
// paths are RETURNED; nothing global changes.
//
// macOS today (via _NSGetExecutablePath + realpath). Swift lens: Bundle.main.

import "./text" as text;
import "./option" as option;
import "./result" as result;
import "./fs" as fs;

// dyld: copy the executable path into `buf`. Returns 0 on success; -1 if `buf` is
// too small, writing the required size (incl. NUL) back through `size`.
extern fn _NSGetExecutablePath(buf: *u8, size: *u32) -> i32;
// libc: canonicalize `path` (resolve symlinks, `.` and `..`) into `resolved`
// (>= PATH_MAX). Returns `resolved` on success, 0 on error.
extern fn realpath(path: *u8, resolved: *u8) -> *u8;
extern fn malloc(n: usize) -> *u8;
extern fn free(p: *u8);
extern fn strlen(s: *u8) -> usize;

// Full, canonical path of the running executable. "" only if dyld refuses (never
// seen in practice).
fn executable_path() -> text::Text ;

// The directory containing `path` — everything before the last '/'. A path with
// no '/' returns as-is; a top-level path like "/foo" returns "/".
fn parent_of(path: str) -> text::Text ;

// The directory the executable lives in — the base for `resource`.
fn dir() -> text::Text ;

// Path to a resource named `name` sitting beside the executable (`dir()/name`).
fn resource(name: str) -> text::Text ;

// Does a path exist at all (file or directory)?
fn exists(path: str) -> bool ;

// Walk up from `start`, returning the nearest ancestor directory that CONTAINS a
// child named `marker` (a resource root marker like an `assets` dir or a
// manifest file). `None` if none up to the filesystem root. Pure string walk on
// the parents — `start` itself need not exist. Bounded at 64 levels.
fn find_up_from(start: str, marker: str) -> option::Option[text::Text] ;

// `find_up_from` anchored at the executable's directory — the no-chdir
// replacement for "walk up from the exe for the resource root".
fn find_up(marker: str) -> option::Option[text::Text] ;

// ───────────────────────────── tests ─────────────────────────────

#[test]
fn executable_path_is_absolute_and_nonempty() ;

#[test]
fn dir_is_a_prefix_and_resource_joins() ;

fn parent_leaf(path: str) -> text::Text ;

#[test]
fn find_up_from_locates_an_ancestor_with_the_marker() ;

#[test]
fn find_up_from_returns_none_when_absent() ;
