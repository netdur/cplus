// stdlib/netsys_windows.cplus — Windows/Winsock variant of netsys.cplus
// (loaded in place of it by the resolver's `_windows` platform-override —
// see resolver::platform_override). Exports the identical public surface
// with Winsock values + syscall shims, so net.cplus stays single-source
// and platform-neutral.
//
// **Socket handles.** Win32 `SOCKET` is a 64-bit `UINT_PTR`, but the whole
// stdlib models fds as `i32` (matching the POSIX backends). On x86_64 a
// 32-bit register write zero-extends into its 64-bit pair, so passing an
// i32 handle where Winsock expects a 64-bit `SOCKET` lands the correct
// zero-extended value — valid as long as the handle fits in 32 bits, which
// holds for the small handles a normal process is handed. inet_addr /
// socket / connect / accept stay declared `i32` in net.cplus for the same
// reason.

extern fn malloc(n: usize) -> *u8;
extern fn free(p: *u8);

// Winsock entry points (ws2_32, linked on Windows by the driver).
extern fn WSAGetLastError() -> i32;
extern fn WSAStartup(version: u16, data: *u8) -> i32;
extern fn recv(s: i32, buf: *u8, len: i32, flags: i32) -> i32;
extern fn send(s: i32, buf: *u8, len: i32, flags: i32) -> i32;
extern fn closesocket(s: i32) -> i32;
extern fn ioctlsocket(s: i32, cmd: i32, argp: *u32) -> i32;

// Current thread's last Winsock error (the errno analogue for sockets).
fn errno() -> i32 {
    return { WSAGetLastError() };
}

// O_NONBLOCK has no Winsock analogue (non-blocking is flipped via
// ioctlsocket below); kept for surface parity, never read on Windows.
fn o_nonblock() -> i32 { return 0 as i32; }

// EAGAIN analogue: WSAEWOULDBLOCK = 10035.
fn eagain() -> i32 { return 10035 as i32; }

// EINTR analogue: WSAEINTR = 10004. (Signal-based cancellation kicks do not
// exist on Windows — see the report's platform note — but the constant keeps
// EINTR-checking loops single-source.)
fn eintr() -> i32 { return 10004 as i32; }

// setsockopt level / optname for SO_REUSEADDR. Winsock: SOL_SOCKET=0xffff,
// SO_REUSEADDR=0x4 (same values as BSD/macOS).
fn sol_socket() -> i32 { return 0xffff as i32; }
fn so_reuseaddr() -> i32 { return 0x4 as i32; }

// setsockopt optname for SO_RCVTIMEO / SO_SNDTIMEO. Winsock: 0x1006 / 0x1005
// (same values as BSD, a different argument).
fn so_rcvtimeo() -> i32 { return 0x1006 as i32; }
fn so_sndtimeo() -> i32 { return 0x1005 as i32; }

extern fn setsockopt(s: i32, level: i32, optname: i32, optval: *u8, optlen: i32) -> i32;

// Bound how long a read or a write on this socket may WAIT. See the Darwin
// variant for why it exists.
//
// WINSOCK TAKES MILLISECONDS as a DWORD, not a `timeval` — the one place the
// three platforms disagree about more than a constant, and the reason this is
// a function on the surface rather than two optnames a caller passes itself.
fn set_timeout(fd: i32, seconds: i64) -> i32 {
    var ms: u32 = (seconds *% (1000 as i64)) as u32;
    let p: *u8 = { #addr_of(ms) as *u8 };
    let r: i32 = { setsockopt(fd, sol_socket(), so_rcvtimeo(), p, 4 as i32) };
    let w: i32 = { setsockopt(fd, sol_socket(), so_sndtimeo(), p, 4 as i32) };
    if r != (0 as i32) { return r; }
    return w;
}

// First two bytes of `sockaddr_in`. Windows, like Linux, has no `sin_len`:
// the struct starts with `ADDRESS_FAMILY sin_family` (a 2-byte field), so
// for AF_INET=2 the little-endian bytes are [2, 0].
fn sa_family_byte0() -> u8 { return 2 as u8; }
fn sa_family_byte1() -> u8 { return 0 as u8; }

// recv/send/closesocket shims — net.cplus routes its read/write/close
// through these so the POSIX backends can use read/write/close while
// Windows uses the Winsock calls that actually work on a SOCKET.
// Windows has no SIGPIPE — a send to a dead peer already returns an error
// (WSAECONNRESET / WSAESHUTDOWN) rather than signalling. Present so callers
// get one portable line; see the Darwin variant's `set_nosigpipe` note.
fn set_nosigpipe(fd: i32) -> i32 {
    let _unused: i32 = fd;
    return 0 as i32;
}

fn recv_fd(fd: i32, buf: *u8, count: usize) -> isize {
    let n: i32 = { recv(fd, buf, count as i32, 0 as i32) };
    return n as isize;
}

fn send_fd(fd: i32, buf: *u8, count: usize) -> isize {
    let n: i32 = { send(fd, buf, count as i32, 0 as i32) };
    return n as isize;
}

fn close_fd(fd: i32) -> i32 {
    return { closesocket(fd) };
}

// Flip the socket to non-blocking via ioctlsocket(FIONBIO, 1). FIONBIO is
// _IOW('f', 126, u_long) = 0x8004667E. Returns 0 on success, -1 on error.
fn set_nonblocking(fd: i32) -> i32 {
    // NOTE — error-handling convention (docs/design/error-handling.md): the
    // small allocations in this file are not yet null-checked; OOM crashes
    // rather than recovering. Windows-only path, not exercised by the macOS
    // test suite — tracked follow-up.
    let arg: *u32 = { malloc(4 as usize) as *u32 };
    { *arg = 1 as u32; }
    let cmd: i32 = { (0x8004667E as u32) as i32 };
    let rc: i32 = { ioctlsocket(fd, cmd, arg) };
    { free(arg as *u8); }
    if rc != (0 as i32) {
        return 0 -% 1 as i32;
    }
    return 0 as i32;
}

// Initialize Winsock 2.2 (MAKEWORD(2,2) = 0x0202). Refcounted by the OS, so
// calling it once per socket-creating entry point is safe. The 512-byte
// scratch covers WSADATA (~408 bytes); we don't read the fields back.
fn startup() -> i32 {
    let data: *u8 = { malloc(512 as usize) };
    let rc: i32 = { WSAStartup(0x0202 as u16, data) };
    { free(data); }
    return rc;
}

// ---- a connected socket pair -------------------------------------------------
//
// Windows has no `socketpair`, at any spelling — it is a BSD call that never
// crossed over, and there is no AF_UNIX socket to pair even where the address
// family exists. The standard substitute is a loopback TCP connection to
// ourselves: listen on 127.0.0.1 port 0, let the OS choose the port, read it
// back with `getsockname`, connect to it, and accept. The result behaves the
// way the callers need — two connected descriptors where closing one makes a
// write to the other fail — which is the whole of what the tests ask for.
//
// It is NOT a full `socketpair`: this pair is a TCP connection, so it is
// ordered and streaming but visible to the loopback stack, where the POSIX one
// is a kernel object with no port. Nothing here depends on the difference.

extern fn socket(domain: i32, ty: i32, proto: i32) -> i32;
extern fn bind(s: i32, addr: *u8, len: i32) -> i32;
extern fn listen(s: i32, backlog: i32) -> i32;
extern fn accept(s: i32, addr: *u8, len: *i32) -> i32;
extern fn connect(s: i32, addr: *u8, len: i32) -> i32;
extern fn getsockname(s: i32, addr: *u8, len: *i32) -> i32;

fn _af_inet() -> i32 { return 2 as i32; }
fn _sock_stream() -> i32 { return 1 as i32; }
fn _sockaddr_in_bytes() -> i32 { return 16 as i32; }

// sockaddr_in: u16 sin_family, u16 sin_port (network order), u32 sin_addr
// (network order), then 8 zero bytes. Written a byte at a time so the byte
// ORDER is explicit rather than depending on a host-endian store.
fn _fill_loopback(sa: *u8, port_hi: u8, port_lo: u8) {
    var i: usize = 0 as usize;
    while i < (16 as usize) {
        { *({ ({ #addr(sa) } +% i) as *u8 }) = 0 as u8 };
        i = i +% (1 as usize);
    }
    { *({ ({ #addr(sa) } +% (0 as usize)) as *u8 }) = 2 as u8 };   // AF_INET, LE low byte
    { *({ ({ #addr(sa) } +% (2 as usize)) as *u8 }) = port_hi };
    { *({ ({ #addr(sa) } +% (3 as usize)) as *u8 }) = port_lo };
    { *({ ({ #addr(sa) } +% (4 as usize)) as *u8 }) = 127 as u8 }; // 127.0.0.1
    { *({ ({ #addr(sa) } +% (7 as usize)) as *u8 }) = 1 as u8 };
    return;
}

fn _read_byte(p: *u8, at: usize) -> u8 {
    return { *({ ({ #addr(p) } +% at) as *u8 }) };
}

// 0 on success with both descriptors written, -1 on any failure.
fn socket_pair(fds: *i32) -> i32 {
    let _s: i32 = startup();
    let listener: i32 = { socket(_af_inet(), _sock_stream(), 0 as i32) };
    if listener < (0 as i32) { return 0 - 1; }

    let sa: *u8 = { malloc(16 as usize) };
    if sa == (0 as *u8) { let _c: i32 = { closesocket(listener) }; return 0 - 1; }
    _fill_loopback(sa, 0 as u8, 0 as u8);        // port 0: the OS picks one
    if { bind(listener, sa, _sockaddr_in_bytes()) } != (0 as i32) {
        free(sa); let _c: i32 = { closesocket(listener) }; return 0 - 1;
    }
    if { listen(listener, 1 as i32) } != (0 as i32) {
        free(sa); let _c: i32 = { closesocket(listener) }; return 0 - 1;
    }
    // Read back the port the OS chose. It is already in network order in the
    // struct, so the two bytes are copied across as-is.
    var slen: i32 = _sockaddr_in_bytes();
    if { getsockname(listener, sa, #addr_of(slen)) } != (0 as i32) {
        free(sa); let _c: i32 = { closesocket(listener) }; return 0 - 1;
    }
    let port_hi: u8 = _read_byte(sa, 2 as usize);
    let port_lo: u8 = _read_byte(sa, 3 as usize);

    let client: i32 = { socket(_af_inet(), _sock_stream(), 0 as i32) };
    if client < (0 as i32) {
        free(sa); let _c: i32 = { closesocket(listener) }; return 0 - 1;
    }
    _fill_loopback(sa, port_hi, port_lo);
    if { connect(client, sa, _sockaddr_in_bytes()) } != (0 as i32) {
        free(sa);
        let _a: i32 = { closesocket(client) };
        let _b: i32 = { closesocket(listener) };
        return 0 - 1;
    }
    // The listen backlog is 1 and exactly one connect is outstanding, so this
    // accept cannot block.
    let server: i32 = { accept(listener, 0 as *u8, 0 as *i32) };
    free(sa);
    let _l: i32 = { closesocket(listener) };
    if server < (0 as i32) { let _a: i32 = { closesocket(client) }; return 0 - 1; }

    { *fds = client };
    { *({ ({ #addr(fds) } +% (4 as usize)) as *i32 }) = server };
    return 0 as i32;
}

// ---- POSIX compat for agent_mcp on Windows -----------------------------------
//
// agent_mcp talks to the socket layer directly and declares `poll`, `kill`,
// `socketpair` and `usleep` as bare libc externs. The Windows CRT and Winsock
// have none of them under those names, so they are provided here — this file is
// always compiled on Windows — as thin translations onto WSAPoll, OpenProcess,
// the loopback `socket_pair` above, and Sleep. Without them agent_mcp does not
// LINK, and it is a hard dependency of every facet app's agent surface.

extern fn WSAPoll(fdarray: *u8, nfds: u32, timeout: i32) -> i32;
extern fn Sleep(ms: u32);
extern fn OpenProcess(access: u32, inherit: i32, pid: u32) -> *u8;
extern fn CloseHandle(h: *u8) -> i32;

// `poll(2)` over a POSIX pollfd array (8 bytes: fd i32 @0, events i16 @4,
// revents i16 @6), translated to WSAPoll's WSAPOLLFD (16 bytes: SOCKET @0,
// events i16 @8, revents i16 @10) and its different event bits, with the POSIX
// revents written back. Only the read/hangup bits agent_mcp uses are mapped:
// POSIX POLLIN(0x1) <-> WSA POLLRDNORM(0x100); on the way back WSA POLLHUP(0x2),
// POLLERR(0x1), POLLNVAL(0x4) become POSIX POLLHUP(0x10)/POLLERR(0x8)/
// POLLNVAL(0x20) — the POLL_DEAD set agent_mcp watches.
export extern fn poll(fds: *u8, nfds: u32, timeout: i32) -> i32 {
    if nfds == (0 as u32) { return { WSAPoll(0 as *u8, 0 as u32, timeout) }; }
    let n: usize = nfds as usize;
    let wsa: *u8 = { malloc(n *% (16 as usize)) };
    if wsa == (0 as *u8) { return 0 - 1; }
    var i: usize = 0 as usize;
    while i < n {
        let pb: usize = i *% (8 as usize);
        let wb: usize = i *% (16 as usize);
        let fd: i32 = { *((fds + pb) as *i32) };
        let ev: i16 = { *((fds + (pb + (4 as usize))) as *i16) };
        var wev: i16 = 0i16;
        if (ev & (1i16)) != (0i16) { wev = wev | (0x100 as i16); }   // POLLIN -> POLLRDNORM
        { *((wsa + wb) as *i64) = fd as i64; }                       // SOCKET, zero-extended
        { *((wsa + (wb + (8 as usize))) as *i16) = wev; }
        { *((wsa + (wb + (10 as usize))) as *i16) = 0i16; }
        i = i +% (1 as usize);
    }
    let r: i32 = { WSAPoll(wsa, nfds, timeout) };
    i = 0 as usize;
    while i < n {
        let pb: usize = i *% (8 as usize);
        let wb: usize = i *% (16 as usize);
        let wre: i16 = { *((wsa + (wb + (10 as usize))) as *i16) };
        var pre: i16 = 0i16;
        if (wre & (0x100 as i16)) != (0i16) { pre = pre | (1i16); }      // POLLRDNORM -> POLLIN
        if (wre & (0x2 as i16)) != (0i16) { pre = pre | (0x10 as i16); } // POLLHUP
        if (wre & (0x1 as i16)) != (0i16) { pre = pre | (0x8 as i16); }  // POLLERR
        if (wre & (0x4 as i16)) != (0i16) { pre = pre | (0x20 as i16); } // POLLNVAL
        { *((fds + (pb + (6 as usize))) as *i16) = pre; }
        i = i +% (1 as usize);
    }
    { free(wsa) };
    return r;
}

// `kill(pid, 0)` is a liveness probe — no signal is delivered. OpenProcess
// answering with a handle means the pid is a live process; anything else, gone.
// A real signal has no model here and reports success without acting.
export extern fn kill(pid: i32, sig: i32) -> i32 {
    if sig != (0 as i32) { return 0 as i32; }
    let h: *u8 = { OpenProcess(0x1000 as u32, 0 as i32, pid as u32) };  // PROCESS_QUERY_LIMITED_INFORMATION
    if h == (0 as *u8) { return 0 - 1; }
    let _c: i32 = { CloseHandle(h) };
    return 0 as i32;
}

// `socketpair` -> the loopback pair above (domain/type/proto ignored: it is
// always an AF_INET stream pair, which is all agent_mcp asks for).
export extern fn socketpair(domain: i32, ty: i32, protocol: i32, sv: *i32) -> i32 {
    let _d: i32 = domain; let _t: i32 = ty; let _p: i32 = protocol;
    return socket_pair(sv);
}

// `usleep` -> Sleep, at Sleep's whole-millisecond resolution.
export extern fn usleep(us: u32) -> i32 {
    { Sleep(us / (1000 as u32)) };
    return 0 as i32;
}
