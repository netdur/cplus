// stdlib/time.cplus — async timer primitives.

// `async fn` needs `Future[T]` from stdlib/future in scope so the
// signature collection wraps the return type correctly. The reactor
// import drags in `stdlib_reactor_register_timer_v1` — the C-ABI
// export the `__cplus_reactor_wait_timer` intrinsic calls — so users
// who pull in `time` automatically get the timer machinery linked.
import "./future" as future;
import "./time_sys" as time_sys;
import "./reactor" as reactor;

//
// v0.0.5 Phase 4 Slice 4A: `sleep(milliseconds)` suspends the current async task
// for the given number of milliseconds via the reactor's `EVFILT_TIMER`
// path. Multiple `sleep`s issued from different `spawn_local`'d tasks
// run concurrently — the reactor's kqueue dispatch reaps timers in
// fire-order, not registration-order, so total wall-clock time is
// `max(durations)` not `sum(durations)`.
//
// The intrinsic `#reactor_wait_timer(milliseconds)` is a compiler-blessed
// suspend point — it can't be expressed in surface C+ because it needs
// raw access to the enclosing coroutine handle (`%.coro.hdl`). The
// stdlib's job here is just to give it a friendly `async fn` face.

async fn sleep(milliseconds: u64) {
    { #reactor_wait_timer(milliseconds); }
}

// ───────────────────── wall-clock (synchronous) ──────────────────
// Reading the system clock is a plain libc call — no async needed. `now()`
// gives whole seconds (the common "last-opened" / "created-at" stamp);
// `now_millis()` gives millisecond resolution for finer ordering.

extern fn time(tloc: *u8) -> i64;


// Seconds since the Unix epoch (1970-01-01 UTC), from the system clock.
fn now() -> i64 {
    return { time(0 as *u8) };
}

// Milliseconds since the Unix epoch. Uses CLOCK_REALTIME (id 0 on Darwin and
// Linux). Falls back to whole-second precision if the clock read fails.
fn now_millis() -> i64 {
    let ms: i64 = time_sys::now_millis_raw();
    if ms < (0 as i64) {
        return now() * (1000 as i64);
    }
    return ms;
}

// ───────────────────────────── tests ─────────────────────────────

// THE INTRINSIC, not `executor::block_on`, and it is a one-line difference for
// a real reason: `executor` gained a deadline on its bridge helpers and needs
// `time::now_millis` for it, which made `time -> executor` a cycle (E0404).
// `executor::block_on` is itself only `return { #block_on::[T](f) };`, so
// calling the intrinsic here costs nothing and leaves the dependency pointing
// one way.
async fn _sleep_then_value() -> i32 {
    await sleep(milliseconds: 1 as u64);
    return 7;
}

#[test]
fn sleep_completes_via_block_on() {
    // Drives the reactor's EVFILT_TIMER path: block_on polls -> sleep registers
    // a 1ms timer -> Pending -> reactor fires -> resume -> Ready(7).
    let v: i32 = { #block_on::[i32](_sleep_then_value()) };
    assert v == 7;
}

async fn _nap(ms: u64) -> i64 {
    await sleep(ms);
    return 1 as i64;
}

// THE ASSERTION THIS FAMILY WAS MISSING, and it is the whole of why the bug
// above it went unseen: `sleep_completes_via_block_on` asserts that the VALUE
// comes back and never that any time passed, so a timer that fired immediately
// — or one that was never registered — passed it. For eight months it did.
//
// What was actually wrong was not in this file. A prebuilt package declares its
// async fns body-less in `lib/include/`, codegen emitted a coroutine RAMP for
// such a declaration instead of a `declare`, and the linker then bound every
// consumer's `await time::sleep(n)` to that empty local copy: allocate a frame,
// run the final-suspend epilogue, mark DONE, return. A 3-second sleep took a
// 0.3-second process. It disarmed all four of `stdlib/net`'s async I/O verbs
// the same way. See bugs/closed/time-sleep-does-not-sleep.md.
//
// 120ms and not 1ms because a 1ms assertion measures scheduler noise, and the
// upper bound is generous on purpose: this is a floor test, not a latency one.
// It fails by a factor of a hundred against the broken build, which is what a
// regression test for this needs to do.
#[test]
fn sleep_actually_waits_rather_than_merely_completing() {
    let t0: i64 = now_millis();
    let v: i64 = { #block_on::[i64](_nap(120 as u64)) };
    let elapsed: i64 = now_millis() - t0;
    assert v == (1 as i64);
    assert elapsed >= (100 as i64);
    assert elapsed < (5000 as i64);
}

#[test]
fn now_is_a_plausible_epoch_time() {
    // Sanity: the clock reads a value well past 2023-11 (1_700_000_000) and
    // millis is ~1000x seconds. Deterministic for any real system clock.
    let s: i64 = now();
    assert s > (1700000000 as i64);
    let ms: i64 = now_millis();
    assert ms > (s - (2 as i64)) * (1000 as i64);   // millis not behind seconds
    assert (ms / (1000 as i64)) >= (s - (2 as i64)); // and consistent within a couple s
}
