// stdlib/process_linux.cplus — subprocess spawning, Linux/Android.
//
// PORTED. This file used to be a stub that refused every call, and its own
// closing note said why: "Nothing in this repo builds for desktop Linux yet."
// That stopped being true, so the refusal did too.
//
// It SHADOWS `process.cplus` whole — same names, same parameters, same types,
// same defaults — so portable code calling `process::capture` needs no branch.
// Read that file first: the pipe, poll, drain and waitpid halves below are its
// code, and its comments explain the two hazards they exist for (a two-pipe
// drain that deadlocks if you read one to EOF first, and a waitpid that leaves
// the status word unwritten on EINTR).
//
// ---- WHAT IS ACTUALLY DIFFERENT, and it is three things ----------------------
//
// The stub was right that "it is only the spawn itself that is Darwin-shaped",
// and the list is shorter than it looks:
//
//   1. `posix_spawn_file_actions_t` IS NOT POINTER-SIZED. On Darwin it is an
//      opaque `void*` and the shared file allocates it with `malloc(8)`. On
//      glibc it is a STRUCT of 80 bytes (and `posix_spawnattr_t` is 336). The
//      same code here would have `posix_spawn_file_actions_init` scribble 72
//      bytes past a malloc — a heap corruption, not a missing symbol, which is
//      the kind that surfaces somewhere else entirely.
//
//      MEASURED on this host rather than read from a man page:
//      `sizeof(posix_spawn_file_actions_t)` == 80, align 8, glibc 2.39.
//
//   2. `errno` is `__errno_location()`, not Darwin's `__error()`. Same value,
//      different symbol; getting it wrong is a link error, which is the failure
//      mode to want.
//
//   3. THERE IS NO `_NSGetEnviron`. `posix_spawnp` needs the environment
//      explicitly — passing NULL gives the child an EMPTY one, so it would lose
//      PATH and everything a caller had just `setenv`'d. POSIX exposes the
//      environment only as the DATA symbol `environ`, and C+'s `extern`
//      declares functions and nothing else, so it cannot be named directly.
//
//      `dlsym` reaches it, which is the same instrument `terminal/appkit` uses
//      to reach libdispatch's `_dispatch_main_q` — also a data symbol. Verified
//      here: `dlsym(RTLD_DEFAULT, "environ")` returns exactly `&environ`, and a
//      variable set with `setenv` AFTER exec is visible through it. That last
//      part is the requirement: `/proc/self/environ` would have been the
//      obvious route and is the WRONG one — it is the kernel's exec-time
//      snapshot and never sees a later `setenv`.
//
// Everything else is byte-for-byte the same interface: `F_SETFD`/`FD_CLOEXEC`
// are 2 and 1, `POLLIN` is 1, `struct pollfd` is the same 8 bytes, `pipe`,
// `waitpid` and the status-word encoding are identical. Checked, not assumed.
//
// ---- A SEAM WOULD BE BETTER, and is a stated debt ----------------------------
//
// Three differences do not justify a second copy of two hundred portable lines,
// and `stdlib` already has the right pattern for this eight times over —
// `netsys`, `fs_sys`, `crypto_sys`, `time_sys`, `thread_sys`, `platform_sys`,
// `argv_sys`, `sync_sys`. `process` and `pty` are the two that shadow whole
// files instead, and they are also the two that were stubs.
//
// The seam is not taken HERE because this file is the one platform that can be
// run and the other two cannot: converting `process.cplus` into
// neutral + `procsys{,_linux,_windows}` edits the Darwin and Windows paths
// blind. Worth doing on a machine that can test all three.

import "./text" as text;
import "./option" as option;
import "./vec" as vec;
import "./status" as status;

extern fn pipe2(fds: *i32, flags: i32) -> i32;
extern fn close(fd: i32) -> i32;
extern fn waitpid(pid: i32, status: *i32, options: i32) -> i32;
extern fn read(fd: i32, buf: *u8, count: usize) -> isize;
extern fn write(fd: i32, buf: *u8, count: usize) -> isize;
extern fn malloc(n: usize) -> *u8;
extern fn free(p: *u8);
extern fn kill(pid: i32, sig: i32) -> i32;
extern fn poll(fds: *u8, nfds: u32, timeout: i32) -> i32;
// &errno, thread-local. glibc's spelling of Darwin's `__error`.
extern fn __errno_location() -> *i32;
// The environment, reached as a symbol ADDRESS — see the header. RTLD_DEFAULT
// is NULL on glibc, unlike Darwin's -2.
extern fn dlsym(handle: *u8, symbol: *u8) -> *u8;

extern fn posix_spawn_file_actions_init(fa: *u8) -> i32;
extern fn posix_spawn_file_actions_destroy(fa: *u8) -> i32;
extern fn posix_spawn_file_actions_adddup2(fa: *u8, fd: i32, newfd: i32) -> i32;
// glibc 2.29+ and bionic API 34+. Named `_np` on both, and it is what makes the
// cwd change part of the spawn rather than a chdir race in the parent.
extern fn posix_spawn_file_actions_addchdir_np(fa: *u8, path: *u8) -> i32;
extern fn posix_spawnp(pid: *i32, file: *u8, file_actions: *u8, attrp: *u8, argv: *u8, envp: *u8) -> i32;

fn e_intr() -> i32 { return 4 as i32; }          // EINTR
fn sig_int() -> i32 { return 2 as i32; }         // SIGINT  (Ctrl-C)
fn sig_term() -> i32 { return 15 as i32; }       // SIGTERM
fn sig_kill() -> i32 { return 9 as i32; }        // SIGKILL

// `sizeof(posix_spawn_file_actions_t)` on glibc/x86-64, measured. Darwin's is a
// pointer; this is a struct. See the header for what using 8 here would do.
fn file_actions_bytes() -> usize { return 80 as usize; }

// O_CLOEXEC, measured. Linux HAS `pipe2`, which sets it ATOMICALLY — Darwin
// lacks the call and has to open the pipe plain and flag both ends with
// `fcntl` afterwards. That gap is a real race in a threaded program: another
// thread spawning in the window between `pipe` and `fcntl` inherits the fd, and
// then the sibling's read side never sees EOF and its drain hangs. `pipe2`
// closes the window rather than narrowing it.
fn o_cloexec() -> i32 { return 0x80000 as i32; }

fn errno_value() -> i32 { return { *{ __errno_location() } }; }

// Decode a waitpid status word into an exit code: WEXITSTATUS on a normal exit,
// or 128 + signal when the child was killed. Pure, so unit-testable without a
// real child.
fn decode_status(status_word: i32) -> i32 {
    if (status_word & (0x7f as i32)) == (0 as i32) {
        return (status_word >> (8 as i32)) & (0xff as i32);
    }
    return (128 as i32) + (status_word & (0x7f as i32));
}

// True where subprocess spawning works.
fn supported() -> bool { return true; }

// A spawned child. Owns the parent-side pipe ends; unclosed fds are closed on
// drop (but the child is NOT reaped there — call `wait` or `output`).
struct Child {
    _pid: i32,
    _stdin: i32,
    _stdout: i32,
    _stderr: i32,
}

struct Output {
    stdout: text::Text,
    stderr: text::Text,
    code: i32,
}

struct Pipe { read: i32, write: i32, ok: bool }

fn make_pipe() -> Pipe {
    let b: *u8 = { malloc(8 as usize) };
    if b.is_null() { return Pipe { read: -1 as i32, write: -1 as i32, ok: false }; }
    let rc: i32 = { pipe2(b as *i32, o_cloexec()) };
    let r: i32 = { *(b as *i32) };
    let w: i32 = { *((b + (4 as usize)) as *i32) };
    free(b);
    return Pipe { read: r, write: w, ok: rc == (0 as i32) };
}

// One `struct pollfd { int fd; short events; short revents; }` = 8 bytes.
fn pollfd_set(base: *u8, slot: usize, fd: i32) {
    let off: usize = slot *% (8 as usize);
    { *((base + off) as *i32) = fd; }
    { *((base + off + (4 as usize)) as *i16) = 1 as i16; }   // POLLIN
    { *((base + off + (6 as usize)) as *i16) = 0 as i16; }   // revents
}
fn pollfd_revents(base: *u8, slot: usize) -> i16 {
    return { *((base + (slot *% (8 as usize)) + (6 as usize)) as *i16) };
}

// Drain stdout AND stderr together, reading whichever has bytes. Draining one
// to EOF before touching the other DEADLOCKS — `process.cplus` explains it in
// full; the short version is that a child writing past the pipe buffer on the
// stream nobody is reading blocks forever in write().
fn drain_both(out_fd: i32, err_fd: i32, out_acc: *vec::Vec[u8], err_acc: *vec::Vec[u8]) {
    let bufsz: usize = 8192;
    let buf: *u8 = { malloc(bufsz) };
    if buf.is_null() { return; }
    let pfds: *u8 = { malloc(16 as usize) };
    if pfds.is_null() { free(buf); return; }
    var o: i32 = out_fd;
    var e: i32 = err_fd;
    loop {
        if o < (0 as i32) && e < (0 as i32) { break; }
        var n: u32 = 0 as u32;
        var o_slot: i64 = -1 as i64;
        var e_slot: i64 = -1 as i64;
        if o >= (0 as i32) { pollfd_set(pfds, n as usize, o); o_slot = n as i64; n = n +% (1 as u32); }
        if e >= (0 as i32) { pollfd_set(pfds, n as usize, e); e_slot = n as i64; n = n +% (1 as u32); }
        let rc: i32 = { poll(pfds, n, -1 as i32) };
        if rc < (0 as i32) {
            if errno_value() == e_intr() { continue; }
            break;
        }
        if o_slot >= (0 as i64) && pollfd_revents(pfds, o_slot as usize) != (0 as i16) {
            let k: isize = { read(o, buf, bufsz) };
            if k > (0 as isize) { let _s: status::Status = (*out_acc).extend_from_raw(buf, k as usize); }
            else if k == (0 as isize) { o = -1 as i32; }
            else if errno_value() != e_intr() { o = -1 as i32; }
        }
        if e_slot >= (0 as i64) && pollfd_revents(pfds, e_slot as usize) != (0 as i16) {
            let k: isize = { read(e, buf, bufsz) };
            if k > (0 as isize) { let _s: status::Status = (*err_acc).extend_from_raw(buf, k as usize); }
            else if k == (0 as isize) { e = -1 as i32; }
            else if errno_value() != e_intr() { e = -1 as i32; }
        }
    }
    free(pfds);
    free(buf);
}

fn bytes_to_text(take bytes: vec::Vec[u8]) -> text::Text {
    return match text::from_utf8(bytes) {
        option::Option[text::Text]::Some(t) => t,
        option::Option[text::Text]::None => text::from_str(""),
    };
}

// The parent's LIVE environment, as the `char **` posix_spawnp wants. See the
// header: this is a data symbol, C+ has no `extern` for one, and the exec-time
// copy in /proc would miss a `setenv` the caller just made.
fn environ_ptr() -> *u8 {
    let slot: *u8 = { dlsym(0 as *u8, #str_ptr("environ\0")) };
    if slot.is_null() { return 0 as *u8; }
    return { *(slot as **u8) };
}

// Spawn `argv[0]` (searched on PATH) with `argv` as its arguments, optionally in
// working directory `cwd` ("" = inherit the parent's). Environment is inherited.
// `None` if argv is empty, an argument/cwd holds an interior NUL, or the spawn
// fails.
fn spawn(argv: vec::Vec[text::Text], cwd: str = "") -> option::Option[Child] {
    let argc: usize = argv.count();
    if argc == (0 as usize) { return option::Option[Child]::None; }

    // The C `char* const argv[]`: a NUL-terminated Vec of CString buffer
    // pointers, with the CStrings parked in `cstrs` so their buffers outlive
    // the spawn.
    var cstrs: vec::Vec[text::CString] = vec::new::[text::CString]();
    var cargv: vec::Vec[*u8] = vec::new::[*u8]();
    var i: usize = 0 as usize;
    while i < argc {
        match argv.at_ptr(i) {
            option::Option[*text::Text]::Some(tp) => {
                match { (*tp).c_str() } {
                    option::Option[text::CString]::Some(cs) => {
                        let _p: status::Status = cargv.append(cs.as_ptr());
                        let _a: status::Status = cstrs.append(cs);
                    }
                    option::Option[text::CString]::None => { return option::Option[Child]::None; }
                }
            }
            option::Option[*text::Text]::None => { return option::Option[Child]::None; }
        }
        i = i +% (1 as usize);
    }
    let _nul: status::Status = cargv.append(0 as *u8);   // argv terminator

    var cwd_cs: option::Option[text::CString] = option::Option[text::CString]::None;
    var cwd_ptr: *u8 = 0 as *u8;
    if cwd != "" {
        match text::from_str(cwd).c_str() {
            option::Option[text::CString]::Some(cs) => { cwd_ptr = cs.as_ptr(); cwd_cs = option::Option[text::CString]::Some(cs); }
            option::Option[text::CString]::None => { return option::Option[Child]::None; }
        }
    }

    let arr: *u8 = match cargv.at_ptr(0 as usize) {
        option::Option[**u8]::Some(base) => base as *u8,
        option::Option[**u8]::None => 0 as *u8,
    };
    let arg0: *u8 = { *(arr as **u8) };

    let in_p: Pipe = make_pipe();
    let out_p: Pipe = make_pipe();
    let err_p: Pipe = make_pipe();
    if !in_p.ok || !out_p.ok || !err_p.ok { return option::Option[Child]::None; }

    // File actions redirect the child's 0/1/2 onto our pipe ends. Every pipe fd
    // is CLOEXEC, so all the OTHERS close at exec; dup2 clears CLOEXEC on its
    // target, so the child's own stdio survives.
    //
    // EIGHTY BYTES, not eight. The header says what a pointer-sized allocation
    // would do here.
    let fa: *u8 = { malloc(file_actions_bytes()) };
    if fa.is_null() {
        { close(in_p.read) }; { close(in_p.write) };
        { close(out_p.read) }; { close(out_p.write) };
        { close(err_p.read) }; { close(err_p.write) };
        return option::Option[Child]::None;
    }
    let _fi: i32 = { posix_spawn_file_actions_init(fa) };
    if cwd_ptr.is_not_null() { let _cd: i32 = { posix_spawn_file_actions_addchdir_np(fa, cwd_ptr) }; }
    let _d0: i32 = { posix_spawn_file_actions_adddup2(fa, in_p.read, 0 as i32) };
    let _d1: i32 = { posix_spawn_file_actions_adddup2(fa, out_p.write, 1 as i32) };
    let _d2: i32 = { posix_spawn_file_actions_adddup2(fa, err_p.write, 2 as i32) };

    let pid_buf: *u8 = { malloc(4 as usize) };
    let envp: *u8 = environ_ptr();
    let rc: i32 = { posix_spawnp(pid_buf as *i32, arg0, fa, 0 as *u8, arr, envp) };
    let pid: i32 = { *(pid_buf as *i32) };
    free(pid_buf);
    let _fd: i32 = { posix_spawn_file_actions_destroy(fa) };
    free(fa);

    // Parent drops the child-side ends whether or not the spawn succeeded.
    { close(in_p.read) };
    { close(out_p.write) };
    { close(err_p.write) };
    if rc != (0 as i32) {
        { close(in_p.write) }; { close(out_p.read) }; { close(err_p.read) };
        return option::Option[Child]::None;
    }
    return option::Option[Child]::Some(Child {
        _pid: pid, _stdin: in_p.write, _stdout: out_p.read, _stderr: err_p.read,
    });
}

impl Child {
    fn pid(ref this) -> i32 { return this._pid; }
    fn stdout_fd(ref this) -> i32 { return this._stdout; }
    fn stderr_fd(ref this) -> i32 { return this._stderr; }

    fn take_stdout_fd(ref this) -> i32 { let fd: i32 = this._stdout; this._stdout = -1 as i32; return fd; }
    fn take_stderr_fd(ref this) -> i32 { let fd: i32 = this._stderr; this._stderr = -1 as i32; return fd; }

    fn signal(ref this, sig: i32) -> bool {
        if this._pid <= (0 as i32) { return false; }
        return { kill(this._pid, sig) } == (0 as i32);
    }
    fn interrupt(ref this) -> bool { return this.signal(sig_int()); }
    fn terminate(ref this) -> bool { return this.signal(sig_term()); }
    fn kill_now(ref this) -> bool { return this.signal(sig_kill()); }

    // Loops over partial writes: a pipe write over PIPE_BUF can be short, so one
    // write() call is not enough.
    fn write_stdin(ref this, data: str) -> isize {
        if this._stdin < (0 as i32) { return -1 as isize; }
        let p: *u8 = #str_ptr(data);
        let total: usize = #str_len(data);
        var off: usize = 0 as usize;
        while off < total {
            let k: isize = { write(this._stdin, p + off, total -% off) };
            if k > (0 as isize) { off = off +% (k as usize); continue; }
            if k < (0 as isize) && errno_value() == e_intr() { continue; }
            if off > (0 as usize) { return off as isize; }
            return -1 as isize;
        }
        return off as isize;
    }

    fn close_stdin(ref this) {
        if this._stdin >= (0 as i32) { let _c: i32 = { close(this._stdin) }; this._stdin = -1 as i32; }
    }

    // Retries on EINTR: waitpid returning -1 leaves the status word UNWRITTEN,
    // so without the retry (and the zero-init) this decodes uninitialised heap
    // and reports a random exit code.
    fn wait(ref this) -> i32 {
        if this._pid <= (0 as i32) { return -1 as i32; }
        let st: *u8 = { malloc(4 as usize) };
        if st.is_null() { return -1 as i32; }
        { *(st as *i32) = 0 as i32; }
        var rc: i32 = 0 as i32;
        loop {
            rc = { waitpid(this._pid, st as *i32, 0 as i32) };
            if rc >= (0 as i32) { break; }
            if errno_value() != e_intr() { break; }
        }
        let status_word: i32 = { *(st as *i32) };
        free(st);
        if rc < (0 as i32) { return -1 as i32; }
        this._pid = -1 as i32;   // reaped once; a second wait has no child
        return decode_status(status_word);
    }

    fn output(take this) -> Output {
        var me: Child = this;
        me.close_stdin();
        var out_bytes: vec::Vec[u8] = vec::new::[u8]();
        var err_bytes: vec::Vec[u8] = vec::new::[u8]();
        drain_both(me._stdout, me._stderr, #addr_of(out_bytes), #addr_of(err_bytes));
        let code: i32 = me.wait();
        if me._stdout >= (0 as i32) { let _a: i32 = { close(me._stdout) }; me._stdout = -1 as i32; }
        if me._stderr >= (0 as i32) { let _b: i32 = { close(me._stderr) }; me._stderr = -1 as i32; }
        return Output {
            stdout: bytes_to_text(out_bytes),
            stderr: bytes_to_text(err_bytes),
            code: code,
        };
    }

    // Closes every parent-side end still owned. The child is deliberately NOT
    // reaped here: a blocking waitpid inside a destructor would hang an
    // arbitrary caller.
    fn drop(ref this) {
        if this._stdin >= (0 as i32) { let _a: i32 = { close(this._stdin) }; this._stdin = -1 as i32; }
        if this._stdout >= (0 as i32) { let _b: i32 = { close(this._stdout) }; this._stdout = -1 as i32; }
        if this._stderr >= (0 as i32) { let _c: i32 = { close(this._stderr) }; this._stderr = -1 as i32; }
    }
}

fn capture(argv: vec::Vec[text::Text], cwd: str = "") -> Output {
    return match spawn(argv, cwd: cwd) {
        option::Option[Child]::Some(ch) => ch.output(),
        option::Option[Child]::None => Output { stdout: text::from_str(""), stderr: text::from_str(""), code: 127 as i32 },
    };
}

// ───────────────────────────── tests ─────────────────────────────
//
// NOTHING HERE SPAWNS, and that is `process.cplus`'s own finding rather than
// caution: a `#[test]` that spawns HANGS the whole test binary, because the
// driver links every stdlib module including the reactor's background
// machinery, and a child forked from inside it deadlocks in a way a standalone
// program does not. The spawn path is verified by a standalone binary instead.

#[test]
fn empty_argv_is_none() {
    let empty: vec::Vec[text::Text] = vec::new::[text::Text]();
    match spawn(empty) {
        option::Option[Child]::Some(c) => { assert false; }
        option::Option[Child]::None => { assert true; }
    }
}

#[test]
fn decode_status_reads_exit_code_and_signal() {
    assert decode_status(0 as i32) == (0 as i32);
    assert decode_status(0x100 as i32) == (1 as i32);
    assert decode_status(0x7f00 as i32) == (127 as i32);
    assert decode_status(9 as i32) == (137 as i32);
}

#[test]
fn the_signal_numbers_match_the_darwin_body() {
    assert sig_int() == (2 as i32);
    assert sig_term() == (15 as i32);
    assert sig_kill() == (9 as i32);
    assert e_intr() == (4 as i32);
}

#[test]
fn spawning_is_supported_here_now() {
    // The stub answered false and refused every call. This is the one-line
    // difference a caller branches on.
    assert supported();
}

#[test]
fn the_file_actions_allocation_is_the_glibc_size() {
    // THE BUG THIS GUARDS is silent: Darwin's `posix_spawn_file_actions_t` is a
    // pointer, so the shared body allocates 8 bytes. glibc's is an 80-byte
    // struct, and `_init` would write 72 bytes past the allocation — heap
    // corruption that surfaces somewhere else entirely. Measured with
    // `sizeof` on this host's own headers.
    assert file_actions_bytes() == (80 as usize);
}

#[test]
fn the_environment_is_reachable_and_not_empty() {
    // `posix_spawnp` with a NULL envp hands the child an EMPTY environment — it
    // would lose PATH and anything the caller had just `setenv`'d. C+ cannot
    // name the `environ` DATA symbol, so this goes through dlsym; if that ever
    // stops resolving, every spawned child silently loses its environment, and
    // this is the assertion that fails instead.
    let e: *u8 = environ_ptr();
    assert e.is_not_null();
    // The first entry is a real "KEY=VALUE" string, not a null slot.
    let first: *u8 = { *(e as **u8) };
    assert first.is_not_null();
}

#[test]
fn bytes_to_text_decodes_utf8_and_empty() {
    let empty: vec::Vec[u8] = vec::new::[u8]();
    assert bytes_to_text(empty).view() == "";
    var hi: vec::Vec[u8] = vec::new::[u8]();
    let _a: status::Status = hi.append('h' as u8);
    let _b: status::Status = hi.append('i' as u8);
    assert bytes_to_text(hi).view() == "hi";
}
