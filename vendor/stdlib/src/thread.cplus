// stdlib/thread.cplus — 1:1 OS threads with value-returning `join`.
//
// v0.0.3 Phase 5 Slice 5B. The cornerstone API for safe split-work-join-
// results: `thread::spawn[O](f) -> JoinHandle[O]` runs `f` on a fresh
// pthread; `JoinHandle[O]::join(move this) -> O` waits for it and
// transfers ownership of the result back to the parent. No shared
// memory, no `unsafe` at the user surface, no raw pointers.
//
// **Scope (5B).** O must be a Copy type whose LLVM representation fits
// in 8 bytes — every integer width, bool, raw and function pointers,
// small Copy enums. Non-Copy O (string, Vec[T], owned aggregates) lands
// in 5C alongside the cross-thread `move` work; they require sret-aware
// trampoline emission, which doubles the codegen surface.
//
// **Layout.** `JoinHandle[O]` is `(tid: u64, ctx: *u8)`. The compiler
// intrinsic `__cplus_thread_spawn` mallocs an 8 + size_of(O) byte
// context, stores the user's fn pointer at offset 0, generates a
// per-O trampoline that calls f and writes the result at offset 8,
// then calls pthread_create. `__cplus_thread_join` runs pthread_join,
// loads the result from the context, frees the context, and returns
// the value. See [cplus-core/src/codegen.rs] for the lowering.
//
// **Panic semantics.** `JoinHandle::join` returns `T`, not
// `Result[T, ThreadPanic]`. C+ has no unwind story today — a worker
// that traps takes the whole process with it (llvm.trap-shaped panic).
// Agents arriving with Rust priors should not expect a Result here;
// the signature is honest and the docstring explains why.

// v0.0.4 Phase 2 Slice 2H: JoinHandle::drop switches from blocking
// pthread_join to true fire-and-forget pthread_detach. Safety is
// preserved by a refcounted ctx (codegen-side layout: u64 refcount @0,
// fn_ptr @8, cancel block @16, result @64, [optional input after the
// result slot]). Parent's drop atomically decrements; worker's
// trampoline also decrements after writing the result; whichever
// thread observes the prev==1 transition frees the ctx. pthread_detach
// tells the OS to reclaim the thread's kernel resources whenever it
// exits.
//
// v0.0.29 CANCELLATION. Every spawned worker carries a 48-byte CANCEL
// BLOCK inside its ctx (offset 16; layout below), and the codegen
// trampoline points the per-thread `@__cplus_cancel_slot` TLS at it for
// the worker's whole run. That makes the token AMBIENT: no worker
// signature carries it, `thread::cancelled()` reads it from anywhere in
// the worker's call tree, and the blocking stdlib calls observe it
// through the park protocol below.
//
// Cancel block layout (offsets relative to the record = ctx+16; this
// mirrors codegen.rs `TrampolineSpec` and the two must agree):
//   +0:  flag       u64   1 = cancellation requested   (canceller writes)
//   +8:  parked     u64   1 = worker inside a cancellable park (worker)
//   +16: verb_lock  u64   spinlock guarding the verb pointers
//   +24: verb_cond  *u8   published condvar wake verb, or null
//   +32: verb_mutex *u8   the mutex that condvar park waits under
//   +40: reserved   u64
//
// The protocol (measured in playground/cancel_spike, 2026-08-22, and in
// bugs/there-is-no-way-to-cancel-anything.md):
//   - `JoinHandle::cancel` is a REQUEST, never a kill: it sets the flag,
//     then kicks the worker out of its CURRENT park — SIGURG for syscall
//     parks (read/kevent return EINTR; stdlib owns SIGURG and installs a
//     no-op handler with SA_RESTART stripped), and the published condvar
//     verb (broadcast under its mutex) for condvar parks. The kick loop
//     ends when the worker leaves the park; a worker that is not parked
//     needs no kick and observes the flag at its next check.
//   - The worker runs its drops and `defer`s and RETURNS on the ordinary
//     path; `join` still waits for that. Cancellation cannot skip a drop.
//   - LOCK ORDER RULE: a thread holding a mutex it published as a wake
//     verb must not call `park_begin*`/`park_end` (they take the verb
//     spinlock, which a canceller holds while locking that same mutex).
//     Publish BEFORE locking, unpark AFTER unlocking; `cancelled()` is a
//     bare atomic load and is safe anywhere, including under the mutex.

import "./atomic" as atomic;
import "./vec" as vec;
import "./option" as option;
import "./status" as status;
import "./netsys" as netsys;
import "./platform_sys" as platform_sys;
import "./sync_sys" as sync_sys;
import "./thread_sys" as thread_sys;

extern fn malloc(n: usize) -> *u8;
extern fn free(p: *u8);

// The per-thread cancel slot, emitted linkonce_odr by codegen in every
// module and coalesced to one per image; the spawn trampolines point it at
// the worker ctx's cancel block. Reached as `#cancel_get_slot()`.
#[runtime_abi]
extern fn __cplus_cancel_get_slot() -> *u8;

// `#[lang("join_handle")]` designates the type `#thread_spawn` returns — see
// the note on `Option` in stdlib/option.cplus for why a name match is not
// enough.
#[lang("join_handle")]
struct JoinHandle[O] {
    _tid: u64,
    // opaque: SHARED (refcounted) ownership, not a plainly-owned pointer — the
    // parent's drop and the worker's trampoline each decrement the refcount,
    // and whichever observes the prev==1 transition frees the ctx (layout in
    // the header comment). Every owning path releases; the conditional-free
    // lint (W0002) cannot prove a refcount protocol, so the intent is marked.
    opaque _ctx: *u8,
}

// Spawn a fresh OS thread that will run `f`. Returns a handle whose
// `join()` blocks until the thread finishes and returns the thread's
// value to the caller. The thread runs concurrently with the parent
// until joined.
//
// Discarding the handle DETACHES the thread: `JoinHandle::drop` does not
// join, so `let _ = thread::spawn(serve);` is the sanctioned idiom for a
// background worker that outlives the spawning scope (the thread keeps
// running; its result is dropped when it finishes).
//
// `O: Send` — the return value must be safely transferrable between
// threads, and the bound is CHECKED: a struct that hides a raw pointer
// (directly or through a field) does not satisfy it and the call is
// E0502. Vouch for one with a marker impl (`impl Handle: Send {}`) when
// you know the pointer is safe to move across threads. The docstring
// here used to say every type was Send, which stopped being true and was
// corrected 2026-08-09 by measuring it.
fn spawn[O: Send](f: fn() -> O) -> JoinHandle[O] {
    return { #thread_spawn::[O](f) };
}

// Spawn a fresh OS thread that will run `f(input)`. The `input` value
// is moved into the worker's heap context — the parent can no longer
// access it after this call (the borrow checker rejects post-move
// use). The thread runs `f` with that input as its sole argument;
// `join()` returns the produced value of type `O`.
//
// `I` and `O` accept scalars (every integer width, bool, f32/f64),
// raw/fn pointers, and structs of any size — Copy structs cross the
// boundary with the C ABI the worker's definition uses (register
// coercion or indirect), and non-Copy ownership-transferring types
// (`Text`, `Vec[T]`-shaped owners) are moved: into the ctx for the
// input, out through the result slot for the output. Slices and
// `str` are rejected as O (a view into the worker's dead stack).
fn spawn_with[I: Send, O: Send](take input: I, f: fn(take I) -> O) -> JoinHandle[O] {
    return { #thread_spawn_with::[I, O](input, f) };
}

impl JoinHandle[O] {
    // Block until the worker thread finishes and return its produced
    // value. Consumes `this` — a handle can only be joined once,
    // enforced by the move-semantics receiver. The borrow checker
    // catches double-join at compile time.
    fn join(take this) -> O {
        return { #thread_join::[O](this) };
    }

    // True when the worker has finished: its result is written and its side
    // of the ctx released, so `join` will return without blocking. The
    // refcount drops to 1 (the parent's ref alone) exactly then; Acquire
    // pairs with the worker trampoline's release decrement, making the
    // result bytes visible to this thread. The async bridge
    // (`executor::join_worker`) polls this.
    fn is_finished(this) -> bool {
        let refct: *u64 = { this._ctx as *u64 };
        return atomic::load_u64(refct, atomic::Ordering::Acquire) == (1 as u64);
    }

    // Ask the worker to stop. A REQUEST, never a kill: the worker observes
    // it at its next `thread::cancelled()` check or cancellable blocking
    // call, runs its drops and `defer`s, and returns on the ordinary path —
    // `join` still waits for that and still returns the worker's value.
    // Idempotent; does not consume the handle; never blocks longer than it
    // takes the worker to leave its CURRENT park (the kick loop below
    // forces that, and a worker that is not parked needs no kick at all).
    fn cancel(this) {
        _cancel_runtime_init();
        let rec: *u8 = { this._ctx + (16 as usize) };
        atomic::store_u64(rec as *u64, 1 as u64, atomic::Ordering::SeqCst);
        // Rounds of kicking, counted only where a kick is not guaranteed to
        // land. See `thread_sys::interrupt_is_reliable`.
        var rounds: u32 = 0 as u32;
        loop {
            let pp: *u64 = { (rec + _c_off_parked()) as *u64 };
            let parked: u64 = atomic::load_u64(pp, atomic::Ordering::SeqCst);
            if parked == (0 as u64) { return; }
            // Syscall parks: a signal until one lands DURING the park and
            // forces EINTR (one landing before is consumed by the no-op
            // handler — hence the loop; measured cost 1 kick, 2 worst).
            thread_sys::interrupt(this._tid);
            // Condvar parks: broadcast the published verb under its mutex.
            // Holding the verb spinlock across the broadcast is what makes
            // `park_end`'s clear a hard barrier — after it returns, this
            // canceller cannot be touching the condvar (lock order rule:
            // the worker never takes the spinlock while holding `m`).
            _verb_lock(rec);
            let cp: **u8 = { (rec + _c_off_verb_cond()) as **u8 };
            let c: *u8 = { *cp };
            if c.is_not_null() {
                let mp: **u8 = { (rec + _c_off_verb_mutex()) as **u8 };
                let m: *u8 = { *mp };
                sync_sys::mutex_lock(m);
                sync_sys::cond_broadcast(c);
                sync_sys::mutex_unlock(m);
            }
            _verb_unlock(rec);
            // WHERE THE KICK IS NOT RELIABLE, STOP KICKING. On POSIX the signal
            // always lands eventually, so the loop is a wait and terminates. On
            // Windows nothing breaks a thread out of a blocking `recv`, so the
            // same loop is an infinite one — measured, it hung a `cancel` on a
            // socket-parked worker forever. Giving up leaves the request in
            // place and every wakeable park already woken above: cancellation
            // becomes cooperative rather than immediate, which is a weaker
            // promise than POSIX's but a promise, where a hang is neither.
            if !thread_sys::interrupt_is_reliable() {
                rounds = rounds +% (1 as u32);
                if rounds >= _max_unreliable_kicks() { return; }
            }
            sync_sys::sleep_us(50 as u32);
        }
    }

    // Drop an un-joined handle: detach the worker from the OS (so its
    // kernel resources get reaped when it eventually exits), then
    // atomically decrement the ctx refcount. If we were the last
    // reference (the worker already finished and decremented its
    // ref), free the ctx ourselves; otherwise the worker will free
    // when it exits. **No blocking** — true fire-and-forget.
    //
    // v0.0.4 Phase 2 Slice 2H: refcounted-ctx design closes the
    // v0.0.3 carryover. The pre-refcount drop blocked on
    // pthread_join because freeing the ctx underneath a still-running
    // worker would race the worker's result-store. With the refcount
    // both sides safely cooperate on lifetime.
    fn drop(ref this) {
        { thread_sys::detach(this._tid); }
        let refct: *u64 = { this._ctx as *u64 };
        let prev: u64 = {
            atomic::fetch_sub_u64(refct, 1 as u64, atomic::Ordering::AcqRel)
        };
        if prev == (1 as u64) {
            { free(this._ctx); }
        }
    }
}

// How many 50 us rounds `cancel` spends kicking a park it may not be able to
// wake. Long enough (10 ms) for a condition-variable park to be broadcast and
// notice, short enough that a caller is not blocked on a thread that will only
// observe the flag when its syscall returns.
fn _max_unreliable_kicks() -> u32 { return 200 as u32; }

// ═══════════════════════════ cancellation ═══════════════════════════
//
// See the header comment for the record layout, the protocol, and the lock
// order rule. Everything here is offset arithmetic over the record the
// trampoline installed in this thread's cancel slot; a thread with no slot
// (the main thread, a `Scope::lend` worker, a foreign thread) reads null
// and every entry point below degrades to a no-op.

// Record offsets — keep in sync with the header comment and codegen.rs.
fn _c_off_parked() -> usize { return 8 as usize; }
fn _c_off_verb_lock() -> usize { return 16 as usize; }
fn _c_off_verb_cond() -> usize { return 24 as usize; }
fn _c_off_verb_mutex() -> usize { return 32 as usize; }

// One-time, process-wide install of the no-op SIGURG handler, with
// SA_RESTART stripped (BSD `signal()` sets it; a restarting park never
// reports EINTR and the kick would be invisible). Runs before the first
// signal is ever sent, from `cancel()` — installation is process-global, so
// installing on the canceller's thread is enough for every target thread.
static _CANCEL_SIG_STATE: i32 = 0;

fn _cancel_runtime_init() {
    loop {
        let s: i32 = atomic::load_i32(#addr_of(_CANCEL_SIG_STATE), atomic::Ordering::Acquire);
        if s == 2 { return; }
        if s == 0 {
            let prev: i32 = atomic::compare_exchange_i32(
                #addr_of(_CANCEL_SIG_STATE), 0, 1, atomic::Ordering::AcqRel);
            if prev == 0 {
                thread_sys::install_interrupt_handler();
                atomic::store_i32(#addr_of(_CANCEL_SIG_STATE), 2, atomic::Ordering::Release);
                return;
            }
        }
        #cpu_relax();
    }
}

fn _verb_lock(rec: *u8) {
    let lp: *u64 = { (rec + _c_off_verb_lock()) as *u64 };
    loop {
        let prev: u64 = atomic::compare_exchange_u64(
            lp, 0 as u64, 1 as u64, atomic::Ordering::AcqRel);
        if prev == (0 as u64) { return; }
        #cpu_relax();
    }
}

fn _verb_unlock(rec: *u8) {
    let lp: *u64 = { (rec + _c_off_verb_lock()) as *u64 };
    atomic::store_u64(lp, 0 as u64, atomic::Ordering::Release);
}

// True when this thread's work has been asked to stop. A bare atomic load:
// safe to call anywhere — compute loops, under a mutex, inside a drop. On a
// thread nobody can cancel it is constantly false.
fn cancelled() -> bool {
    let rec: *u8 = { #cancel_get_slot() };
    if rec.is_null() { return false; }
    let f: u64 = atomic::load_u64(rec as *u64, atomic::Ordering::SeqCst);
    return f != (0 as u64);
}

// Mark this thread as entering a cancellable SYSCALL park (a blocking call
// that a signal interrupts with EINTR: read, accept, kevent, ...). Returns
// true when cancellation was already requested — the caller must NOT enter
// the syscall and should surface `Cancelled` instead. The publish-then-check
// order pairs with cancel()'s set-then-kick: at least one side always sees
// the other.
//
// Callers wrap each park attempt:
//     loop {
//         if thread::park_begin() { thread::park_end(); return CANCELLED; }
//         let n = read(...);
//         thread::park_end();
//         if n < 0 && errno == EINTR { continue; }   // loop re-checks
//         ...
//     }
fn park_begin() -> bool {
    let rec: *u8 = { #cancel_get_slot() };
    if rec.is_null() { return false; }
    let pp: *u64 = { (rec + _c_off_parked()) as *u64 };
    atomic::store_u64(pp, 1 as u64, atomic::Ordering::SeqCst);
    let f: u64 = atomic::load_u64(rec as *u64, atomic::Ordering::SeqCst);
    return f != (0 as u64);
}

// Mark this thread as entering a cancellable CONDVAR park, publishing the
// condvar + mutex as the wake verb (a condvar is not reliably interrupted
// by signals — POSIX lets the implementation absorb them — so the canceller
// broadcasts it under its mutex instead). Call this BEFORE locking `m`
// (lock order rule, header comment); re-check `cancelled()` inside the wait
// loop, under the mutex; call `park_end` AFTER unlocking.
fn park_begin_cond(c: *u8, m: *u8) -> bool {
    let rec: *u8 = { #cancel_get_slot() };
    if rec.is_null() { return false; }
    _verb_lock(rec);
    let cp: **u8 = { (rec + _c_off_verb_cond()) as **u8 };
    *cp = c;
    let mp: **u8 = { (rec + _c_off_verb_mutex()) as **u8 };
    *mp = m;
    _verb_unlock(rec);
    let pp: *u64 = { (rec + _c_off_parked()) as *u64 };
    atomic::store_u64(pp, 1 as u64, atomic::Ordering::SeqCst);
    let f: u64 = atomic::load_u64(rec as *u64, atomic::Ordering::SeqCst);
    return f != (0 as u64);
}

// Leave the park: clear the parked mark and un-publish any wake verb. The
// verb is cleared under the spinlock so a concurrent canceller can never
// broadcast a condvar the caller is about to destroy — after `park_end`
// returns, the canceller is guaranteed to not touch it. Must not be called
// while holding a published verb mutex (lock order rule).
fn park_end() {
    let rec: *u8 = { #cancel_get_slot() };
    if rec.is_null() { return; }
    let pp: *u64 = { (rec + _c_off_parked()) as *u64 };
    atomic::store_u64(pp, 0 as u64, atomic::Ordering::SeqCst);
    _verb_lock(rec);
    let cp: **u8 = { (rec + _c_off_verb_cond()) as **u8 };
    if (*cp).is_not_null() {
        *cp = 0 as *u8;
        let mp: **u8 = { (rec + _c_off_verb_mutex()) as **u8 };
        *mp = 0 as *u8;
    }
    _verb_unlock(rec);
}

// ═══════════════════════════ scoped threads ═══════════════════════════
//
// v0.0.28. `spawn` and `spawn_with` move their data into the worker, which
// is why they can let it outlive the spawning function. The cost is that
// every shared input needs an owner of its own — an `Arc`, a copy, or a
// restructure — even when the parent is going to sit and wait anyway.
//
// A SCOPE is the other trade: it lends a parent local to a worker and
// guarantees the worker is joined before the loan can end. `Scope::drop`
// joins every thread it started, and the borrow checker knows the scope
// borrows what was lent to it (`#[keeps(this)]` on a `ref` parameter), so
// three things are compile errors rather than races:
//
//     var s: Scope = thread::scope();
//     {
//         var d: Data = ...;
//         s.lend(d, worker);      // E0514: `d` dies while `s` still borrows it
//     }
//
//     s.lend(d, w1);
//     d.field = 3;                // E0381: write while borrowed
//     s.lend(d, w2);              // E0381: two exclusive lends of one place
//
// The loan ends where the scope does, which is where the threads are joined
// — so a lent value cannot be read, written, moved or dropped while a worker
// still holds it. No `Arc`, no copy, no atomics.
//
// The worker signature is `fn(ref T)`: results come back through the lent
// value, not through a join. A thread that must RETURN something is
// `spawn`/`spawn_with`'s job.

// The per-worker heap cell: which function to run and what to run it on.
// One `malloc` per lend, freed after the join — it cannot live in the
// scope's `Vec` because a `Vec` moves its elements when it grows, and the
// worker is holding the address.
struct _Lend[T] {
    _f: fn(ref T),
    // opaque: this is the ADDRESS OF THE PARENT'S VALUE, not an allocation
    // this cell owns. What keeps it alive is the borrow checker: the scope
    // borrows the value for as long as it lives, and the scope outlives
    // every worker it started.
    opaque _d: *T,
}

// The pthread entry point, one instantiation per lent type. Unpacks the
// cell and calls the worker with the parent's value as a `ref` argument —
// which is pointer-passed, so the worker writes the parent's memory
// directly.
fn _run_lend[T](arg: *u8) -> *u8 {
    let cell: *_Lend[T] = { arg as *_Lend[T] };
    let f: fn(ref T) = { (*cell)._f };
    let d: *T = { (*cell)._d };
    { f(*d) };
    return { 0 as *u8 };
}

// A set of threads that are all joined before this value goes away.
//
// Declare one with `thread::scope()`, hand it work with `lend`, and let it
// fall out of scope: `drop` joins every worker. There is no `finish()` —
// a scope you could forget to finish would be a scope that proves nothing.
struct Scope {
    _tids: vec::Vec[u64],
    _cells: vec::Vec[*u8],
}

// Open a thread scope. Every thread started through it is joined when the
// returned value is dropped.
fn scope() -> Scope {
    return Scope {
        _tids: vec::new::[u64](),
        _cells: vec::new::[*u8](),
    };
}

impl Scope {
    // Run `f(data)` on a fresh thread, with `data` borrowed from the caller
    // for the rest of this scope's life.
    //
    // `#[keeps(this)]` is the load-bearing declaration: it tells the borrow
    // checker that this scope keeps the borrow after the call returns, which
    // is what turns "the worker might outlive the data" into a compile
    // error. Without it the pointer handed to the thread would be exactly
    // the dangling pointer this API exists to make impossible.
    //
    // Returns `OutOfMemory` when the cell cannot be allocated OR the OS
    // refuses the thread (both are a resource it would not give); in either
    // case nothing was started and the scope is unchanged.
    #[keeps(this)]
    fn lend[T: Send](ref this, ref data: T, f: fn(ref T)) -> status::Status {
        let raw: *u8 = { malloc(#size_of::[_Lend[T]]()) };
        if raw.is_null() {
            return status::Status::OutOfMemory;
        }
        let cell: *_Lend[T] = { raw as *_Lend[T] };
        { (*cell)._f = f; }
        { (*cell)._d = #addr_of(data) as *T; }
        var tid: u64 = 0 as u64;
        let rc: i32 = {
            thread_sys::create(#addr_of(tid), _run_lend::[T], raw)
        };
        if rc != (0 as i32) {
            { free(raw); }
            return status::Status::OutOfMemory;
        }
        if this._tids.append(tid) != status::Status::Ok {
            // The thread is running and we cannot record it. Joining here is
            // the only way to keep the promise this type makes.
            { thread_sys::join(tid); }
            { free(raw); }
            return status::Status::OutOfMemory;
        }
        if this._cells.append(raw) != status::Status::Ok {
            // Same, one step later: the tid IS recorded, so the join happens
            // at drop; only the cell would leak. Free it after joining now.
            { thread_sys::join(tid); }
            { free(raw); }
            return status::Status::OutOfMemory;
        }
        return status::Status::Ok;
    }

    // How many workers this scope has started.
    fn count(this) -> usize {
        return this._tids.count();
    }

    // Join every worker, then release their cells. This is the guarantee the
    // type is for: it runs at scope exit, on every path, and nothing the
    // caller can write skips it.
    fn drop(ref this) {
        var i: usize = 0 as usize;
        while i < this._tids.count() {
            match this._tids.at(i) {
                option::Option[u64]::Some(tid) => { { thread_sys::join(tid); } }
                option::Option[u64]::None => { }
            }
            i = i + (1 as usize);
        }
        var j: usize = 0 as usize;
        while j < this._cells.count() {
            match this._cells.at(j) {
                option::Option[*u8]::Some(p) => { { free(p); } }
                option::Option[*u8]::None => { }
            }
            j = j + (1 as usize);
        }
    }
}

// ───────────────────────────── tests ─────────────────────────────

fn _ret_42() -> i32 {
    return 42;
}

fn _double_it(take x: i32) -> i32 {
    return x *% (2 as i32);
}

// ---- scoped threads ----

struct _Cell {
    v: i64,
}

fn _add_one_million(ref c: _Cell) {
    var i: i64 = 0 as i64;
    while i < (1000000 as i64) {
        c.v = c.v +% (1 as i64);
        i = i +% (1 as i64);
    }
}

#[test]
fn scope_lends_a_local_and_joins_before_it_ends() {
    // The worker writes the PARENT's local through the loan — no Arc, no
    // copy back. The million iterations are there so the assertion would
    // fail if `drop` did not actually join: reading `c.v` while the worker
    // still ran would almost certainly catch it mid-count.
    var c: _Cell = _Cell { v: 0 as i64 };
    {
        var s: Scope = scope();
        assert s.lend::[_Cell](c, _add_one_million) == status::Status::Ok;
        assert s.count() == (1 as usize);
    }
    assert c.v == 1000000;
}

#[test]
fn scope_with_no_workers_is_fine() {
    var s: Scope = scope();
    assert s.count() == (0 as usize);
}

#[test]
fn scope_lends_two_different_locals_at_once() {
    var a: _Cell = _Cell { v: 0 as i64 };
    var b: _Cell = _Cell { v: 0 as i64 };
    {
        var s: Scope = scope();
        assert s.lend::[_Cell](a, _add_one_million) == status::Status::Ok;
        assert s.lend::[_Cell](b, _add_one_million) == status::Status::Ok;
        assert s.count() == (2 as usize);
    }
    assert a.v == 1000000;
    assert b.v == 1000000;
}

// ---- cancellation ----



static _CANCEL_TEST_DROPS: u64 = 0u64;
static _CANCEL_TEST_DEFERS: u64 = 0u64;

struct _DropProbe {
    _v: i64,
}
impl _DropProbe {
    fn drop(ref this) {
        atomic::fetch_add_u64(#addr_of(_CANCEL_TEST_DROPS), 1 as u64, atomic::Ordering::AcqRel);
    }
}

fn _mark_defer() {
    atomic::fetch_add_u64(#addr_of(_CANCEL_TEST_DEFERS), 1 as u64, atomic::Ordering::AcqRel);
}

// A worker that parks in read(2) on a pipe nobody writes; only cancellation
// can end it. Returns 7 on the cancel path — the canonical syscall-park loop
// from the `park_begin` docstring.
fn _read_park_worker(take rfd: i64) -> i64 {
    let fd: i32 = rfd as i32;
    var buf: [u8; 16] = [0u8; 16];
    loop {
        if park_begin() {
            park_end();
            return 7 as i64;
        }
        let n: isize = { netsys::recv_fd(fd, #addr_of(buf) as *u8, 16 as usize) };
        park_end();
        if n < (0 as isize) {
            let e: i32 = netsys::errno();
            if e == netsys::eintr() { continue; }
            return (0 - 2) as i64;
        }
        return (0 - 3) as i64;
    }
}

// Same park, but the worker owns a droppable value and a defer — proving
// the cancel path is an ordinary early return that skips neither.
fn _drop_probe_worker(take rfd: i64) -> i64 {
    let p: _DropProbe = _DropProbe { _v: 1 as i64 };
    defer _mark_defer();
    let r: i64 = _read_park_worker(rfd);
    return r +% p._v;
}

// A compute worker that never parks — it observes cancellation by polling.
fn _poll_worker(take x: i64) -> i64 {
    var spins: i64 = 0 as i64;
    loop {
        if cancelled() { return 9 as i64; }
        sync_sys::sleep_us(100 as u32);
        spins = spins +% (1 as i64);
        if spins > (300000 as i64) { return (0 - 9) as i64; }
    }
}

#[test]
fn cancel_interrupts_a_read_park() {
    var fds: [i32; 2] = [0, 0];
    assert thread_sys::make_pipe(#addr_of(fds) as *i32) == 0;
    let h: JoinHandle[i64] = spawn_with::[i64, i64](fds[0] as i64, _read_park_worker);
    sync_sys::sleep_us(2000 as u32);
    h.cancel();
    assert h.join() == (7 as i64);
    netsys::close_fd(fds[0]);
    netsys::close_fd(fds[1]);
}

#[test]
fn cancel_reaches_a_compute_worker_through_cancelled() {
    let h: JoinHandle[i64] = spawn_with::[i64, i64](0 as i64, _poll_worker);
    sync_sys::sleep_us(1000 as u32);
    h.cancel();
    assert h.join() == (9 as i64);
}

#[test]
fn cancel_is_idempotent() {
    var fds: [i32; 2] = [0, 0];
    assert thread_sys::make_pipe(#addr_of(fds) as *i32) == 0;
    let h: JoinHandle[i64] = spawn_with::[i64, i64](fds[0] as i64, _read_park_worker);
    h.cancel();
    h.cancel();
    assert h.join() == (7 as i64);
    netsys::close_fd(fds[0]);
    netsys::close_fd(fds[1]);
}

#[test]
fn cancel_runs_drops_and_defers() {
    var fds: [i32; 2] = [0, 0];
    assert thread_sys::make_pipe(#addr_of(fds) as *i32) == 0;
    let h: JoinHandle[i64] = spawn_with::[i64, i64](fds[0] as i64, _drop_probe_worker);
    sync_sys::sleep_us(2000 as u32);
    h.cancel();
    assert h.join() == (8 as i64);
    let drops: u64 = atomic::load_u64(#addr_of(_CANCEL_TEST_DROPS), atomic::Ordering::Acquire);
    let defers: u64 = atomic::load_u64(#addr_of(_CANCEL_TEST_DEFERS), atomic::Ordering::Acquire);
    assert drops == (1 as u64);
    assert defers == (1 as u64);
    netsys::close_fd(fds[0]);
    netsys::close_fd(fds[1]);
}

#[test]
fn cancelled_is_false_on_an_uncancellable_thread() {
    // The test runner's thread has no cancel slot — `cancelled()` and the
    // park protocol must degrade to no-ops, not crash.
    assert cancelled() == false;
    assert park_begin() == false;
    park_end();
}

#[test]
fn thread_spawn_join_returns_value() {
    let h: JoinHandle[i32] = spawn::[i32](_ret_42);
    assert h.join() == 42;
}

#[test]
fn thread_spawn_with_moves_input() {
    let h: JoinHandle[i32] = spawn_with::[i32, i32](21, _double_it);
    assert h.join() == 42;
}

// 2026-07-07 spawn ABI audit regression: aggregate I/O across the spawn
// boundary. A >16-byte Copy struct returns via sret, a 16-byte one via
// register coercion, and both shapes pass as input with the worker's
// definition ABI — the trampolines used to call by raw value (SIGBUS).
struct _Triple {
    a: i64,
    b: i64,
    c: i64,
}

fn _make_triple(take n: i64) -> _Triple {
    return _Triple { a: n, b: n +% (1 as i64), c: n +% (2 as i64) };
}

fn _sum_triple(take t: _Triple) -> i64 {
    return t.a + t.b + t.c;
}

#[test]
fn thread_spawn_with_struct_output_round_trips() {
    let h: JoinHandle[_Triple] = spawn_with::[i64, _Triple](10 as i64, _make_triple);
    let t: _Triple = h.join();
    assert t.a == 10;
    assert t.b == 11;
    assert t.c == 12;
}

#[test]
fn thread_spawn_with_struct_input_round_trips() {
    let h: JoinHandle[i64] =
        spawn_with::[_Triple, i64](_Triple { a: 1, b: 2, c: 3 }, _sum_triple);
    assert h.join() == 6;
}
