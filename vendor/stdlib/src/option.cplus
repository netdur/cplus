// stdlib/option.cplus — `Option[T]` (v0.0.4 Phase 4).
//
// The canonical "value or nothing" type. Returned by `Iterator[T]::next()`
// to signal end-of-stream. Also useful anywhere a function might or
// might not produce a value.
//
// **Why not just use `Result[T, E]` with `E = ()`?** Option's `None`
// case is more idiomatic for "no value here, this isn't an error";
// Result's `Err` implies a fault path. Both shapes coexist — pick the
// one that matches caller intent.

// `#[lang("option")]` is how the compiler RECOGNIZES this enum as the one
// `Iterator[T]::next()` returns. It used to be located by matching the name
// `Option` (or any key ending in `.Option`) across the template table, which a
// user enum of the same leaf name also satisfies — and on a two-key match the
// winner was whichever the hash map yielded first.
#[lang("option")]
enum Option[T] {
    Some(T),
    None,
}

// Generic constructor for `Some` — symmetric with `Result::ok`. The
// `None` variant is constructed directly as `Option[T]::None` with the
// turbofish (sema can't infer T from a payload-less variant).
// An `Option` of something that can be copied can be copied. A payload-carrying
// enum derives nothing, so this one is written out — and it is what lets a
// struct with an `Option[Text]` field derive `Clone` with an empty impl.
impl Option[T: Clone]: Clone {
    fn clone(this) -> Option[T] {
        return match this {
            Option::Some(v) => Option[T]::Some(v.clone()),
            Option::None => Option[T]::None,
        };
    }
}

fn some[T](take v: T) -> Option[T] {
    return Option[T]::Some(v);
}

// ───────────────────────────── tests ─────────────────────────────

#[test]
fn option_some_constructor() {
    let o: Option[i32] = some::[i32](42);
    match o {
        Option[i32]::Some(x) => { assert x == 42; }
        Option[i32]::None => { assert false; }
    }
}

#[test]
fn option_some_direct() {
    let o: Option[i32] = Option[i32]::Some(7);
    match o {
        Option[i32]::Some(x) => { assert x == 7; }
        Option[i32]::None => { assert false; }
    }
}

#[test]
fn option_none() {
    let o: Option[i32] = Option[i32]::None;
    match o {
        Option[i32]::Some(x) => { assert false; }
        Option[i32]::None => { assert true; }
    }
}

#[test]
fn an_option_of_a_clonable_value_clones() {
    let a: Option[i32] = Option[i32]::Some(4);
    let b: Option[i32] = a.clone();
    assert match b { Option::Some(v) => v == 4, Option::None => false };
    let n: Option[i32] = Option[i32]::None;
    let m: Option[i32] = n.clone();
    assert match m { Option::Some(_) => false, Option::None => true };
    // The original is still there to be read: `clone` borrows.
    assert match a { Option::Some(v) => v == 4, Option::None => false };
}
