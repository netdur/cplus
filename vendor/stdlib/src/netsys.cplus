// stdlib/netsys.cplus — platform syscall constants + errno accessor for
// stdlib/net. This is the macOS/BSD variant; `netsys_linux.cplus` shadows
// it on Linux via the resolver's `_linux` platform-override (see
// resolver::platform_override). Splitting these few values out keeps
// net.cplus itself single-source and platform-neutral.

// macOS errno location: `int *__error(void)` returns the thread-local
// errno pointer.
extern fn __error() -> *i32;

// Current thread's errno value.
fn errno() -> i32 {
    let p: *i32 = { __error() };
    return { *p };
}

// O_NONBLOCK for fcntl(F_SETFL). macOS: 0x0004.
fn o_nonblock() -> i32 { return 0x0004 as i32; }

// EAGAIN (== EWOULDBLOCK on macOS): 35.
fn eagain() -> i32 { return 35 as i32; }

// EINTR: 4. A blocking syscall interrupted by a signal — the cancellation
// protocol's kick (stdlib/thread.cplus) surfaces as exactly this.
fn eintr() -> i32 { return 4 as i32; }

// setsockopt level / optname for SO_REUSEADDR. macOS: SOL_SOCKET=0xffff,
// SO_REUSEADDR=0x4.
fn sol_socket() -> i32 { return 0xffff as i32; }
fn so_reuseaddr() -> i32 { return 0x4 as i32; }

// SO_NOSIGPIPE (Darwin only): 0x1022. See `set_nosigpipe` below.
fn so_nosigpipe() -> i32 { return 0x1022 as i32; }

// Make writes to this socket REPORT a dead peer instead of KILLING the
// process.
//
// A write to a socket whose peer has gone away raises SIGPIPE, whose default
// disposition terminates the process — with no crash report, no diagnostic,
// and buffered stdout lost. That is a server dying silently because a client
// went away, which is never what a server wants and is impossible to
// diagnose after the fact (see the incident in
// demo/bugs/02-iris-terminated-without-crash-report.md: two processes gone,
// no `.ips` for either).
//
// PER SOCKET, deliberately — not a process-wide `signal(SIGPIPE, SIG_IGN)`.
// A library that changes global signal disposition makes that decision for
// the whole program, including code that never asked. Darwin has the
// socket-scoped answer (`SO_NOSIGPIPE`), Linux has the call-scoped one
// (`MSG_NOSIGNAL`, applied inside `send_fd` there), and Windows has no
// SIGPIPE at all. Each platform's variant of this file implements whichever
// it has, so callers get one portable line.
//
// With this set, a write to a dead peer returns -1/EPIPE and the caller's
// existing error path handles it.
//
// Returns 0 on success, non-zero if the option could not be set (a
// non-socket fd, say — harmless, and the caller carries on).
fn set_nosigpipe(fd: i32) -> i32 {
    var one: i32 = 1 as i32;
    return { setsockopt(fd, sol_socket(), so_nosigpipe(), #addr_of(one) as *u8, 4 as u32) };
}

// setsockopt optname for SO_RCVTIMEO / SO_SNDTIMEO. macOS: 0x1006 / 0x1005.
fn so_rcvtimeo() -> i32 { return 0x1006 as i32; }
fn so_sndtimeo() -> i32 { return 0x1005 as i32; }

// `struct timeval`, as setsockopt wants it for the two timeout options.
//
// The real one is `{ time_t tv_sec; suseconds_t tv_usec; }`, and the second
// field is 8 bytes on Linux and 4 (plus 4 of padding) on Darwin. Both make the
// struct 16 bytes, and a caller here only ever sets whole seconds — so the
// microseconds are zero either way and one shape serves both. Sub-second
// deadlines would have to split this per platform.
struct Timeval {
    sec: i64,
    usec: i64,
}

// Bound how long a read or a write on this socket may WAIT.
//
// Without it, a peer that accepts a connection and then says nothing hangs the
// calling thread for good — not slowly, permanently — and there is no way back
// short of killing the process. That is survivable on a worker and fatal on a
// UI thread, and it is not detectable in advance: a `connect(2)` that succeeds
// says a socket accepted, not that anything behind it will answer. A port
// forward (`adb forward`, `iproxy`) accepts on behalf of a peer that may never
// reply, which is exactly the case a connect probe cannot see.
//
// SECONDS, because the honest floor is "a device at the end of a cable is
// legitimately slow". This is a liveness bound, not a latency budget.
//
// BOTH DIRECTIONS. A peer that stops draining stalls a write the same way, and
// a caller that wanted one wants the other.
//
// After it expires the syscall returns -1 with `eagain()`, which is how a
// caller tells a deadline from a peer that closed (0 bytes). Returns 0 on
// success, non-zero if the option could not be set — harmless, and the caller
// carries on with a socket that simply has no deadline.
fn set_timeout(fd: i32, seconds: i64) -> i32 {
    var tv: Timeval = Timeval { sec: seconds, usec: 0 as i64 };
    let p: *u8 = { #addr_of(tv) as *u8 };
    let r: i32 = { setsockopt(fd, sol_socket(), so_rcvtimeo(), p, 16 as u32) };
    let w: i32 = { setsockopt(fd, sol_socket(), so_sndtimeo(), p, 16 as u32) };
    if r != (0 as i32) { return r; }
    return w;
}

// First two bytes of `sockaddr_in`. macOS lays it out as
// `{ uint8_t sin_len; sa_family_t sin_family; ... }`, so byte0 = sin_len
// (16 for sockaddr_in) and byte1 = AF_INET (2).
fn sa_family_byte0() -> u8 { return 16 as u8; }
fn sa_family_byte1() -> u8 { return 2 as u8; }

// POSIX raw-syscall shims used by net.cplus. Splitting these behind netsys
// keeps net.cplus platform-neutral: the Windows variant routes them to
// Winsock (recv/send/closesocket/ioctlsocket) instead.
extern fn read(fd: i32, buf: *u8, count: usize) -> isize;
extern fn write(fd: i32, buf: *u8, count: usize) -> isize;
extern fn close(fd: i32) -> i32;
extern fn setsockopt(fd: i32, level: i32, optname: i32, optval: *u8, optlen: u32) -> i32;
// fcntl is variadic in libc — the third arg is read from the variadic area,
// not a fixed register. Declaring it fixed-arity silently breaks `F_SETFL`
// on AArch64-darwin where varargs come from the stack.
extern fn fcntl(fd: i32, cmd: i32, ...) -> i32;

fn recv_fd(fd: i32, buf: *u8, count: usize) -> isize {
    return { read(fd, buf, count) };
}

fn send_fd(fd: i32, buf: *u8, count: usize) -> isize {
    return { write(fd, buf, count) };
}

fn close_fd(fd: i32) -> i32 {
    return { close(fd) };
}

// F_GETFL / F_SETFL are 3 / 4 on both macOS and Linux.
fn f_getfl() -> i32 { return 3 as i32; }
fn f_setfl() -> i32 { return 4 as i32; }

// Flip O_NONBLOCK on fd via fcntl. Returns 0 on success, -1 on error.
// Idempotent — safe to call repeatedly on the same fd.
fn set_nonblocking(fd: i32) -> i32 {
    let flags: i32 = { fcntl(fd, f_getfl(), 0 as i32) };
    if flags < (0 as i32) {
        return 0 -% 1 as i32;
    }
    let new_flags: i32 = flags|o_nonblock();
    if new_flags == flags {
        return 0 as i32;
    }
    let rc: i32 = { fcntl(fd, f_setfl(), new_flags) };
    if rc < (0 as i32) {
        return 0 -% 1 as i32;
    }
    return 0 as i32;
}

// Socket subsystem init — a no-op on POSIX (matches Winsock's WSAStartup).
fn startup() -> i32 { return 0 as i32; }

// A connected socket pair, for the tests that need a peer they can hang up on.
// Wrapped because Windows has no `socketpair` at ANY spelling — see
// netsys_windows.cplus, which builds one over loopback TCP.
extern fn socketpair(domain: i32, ty: i32, proto: i32, fds: *i32) -> i32;

// AF_UNIX (1), SOCK_STREAM (1).
fn socket_pair(fds: *i32) -> i32 {
    return { socketpair(1 as i32, 1 as i32, 0 as i32, fds) };
}
