// stdlib/fs.cplus — file system access.
//
// Built on libc open/read/write/close via `extern fn`. `File` is an owned
// handle; Drop closes the fd on scope exit, so opening without explicit
// close is safe.

import "./result" as result;
import "./vec" as vec;
import "./option" as option;
import "./status" as status;
// v0.0.5 Phase 4 Slice 4C: File::read_async needs the reactor's
// fd-readiness path. Phase 3 Slice 3D's File::lines is sync but
// the gen-method machinery needs Iterator[T] in scope.
import "./net" as net;
import "./iterator" as iterator;
import "./text" as text;

// `open` is variadic in libc — mode is only consumed when O_CREAT is in
// flags. The variadic decl matches the platform ABI exactly (on
// aarch64-darwin a fixed third arg lands in a register but libc's
// implementation reads it via `va_arg`, which expects stack passing).
extern fn open(path: *u8, flags: i32, ...) -> i32;
extern fn read(fd: i32, buf: *u8, count: usize) -> isize;
extern fn write(fd: i32, buf: *u8, count: usize) -> isize;
extern fn close(fd: i32) -> i32;
extern fn malloc(n: usize) -> *u8;
extern fn free(p: *u8);

// Directory + path ops. `mode_t` is `__uint16_t` on Darwin; `__error()` returns
// the address of `errno` (the thread-local). `readdir` yields the 64-bit-inode
// `struct dirent` (the default layout on modern macOS / Apple Silicon).
extern fn access(path: *u8, amode: i32) -> i32;
extern fn mkdir(path: *u8, mode: u16) -> i32;
extern fn unlink(path: *u8) -> i32;
extern fn opendir(path: *u8) -> *u8;
extern fn readdir(dirp: *u8) -> *u8;
extern fn closedir(dirp: *u8) -> i32;
extern fn __error() -> *i32;
extern fn strlen(s: *u8) -> usize;

// Owned file handle. `fd == -1` is the invalid / closed state (disarms Drop).
struct File {
    _fd: i32,
}

// Copy a `str` path into an owned NUL-terminated C string for libc. A `str` is
// a `(ptr, len)` VIEW with no guaranteed NUL at `ptr[len]`; handing
// `#str_ptr(path)` straight to open/access/mkdir/unlink/opendir makes libc read
// PAST the view until it finds a stray 0 byte — opening the wrong path, or
// ENOENT on a path that exists (any substring view, e.g. a line trimmed of its
// trailing '\n'). `text::CString` owns a malloc'd copy with the terminator
// (exactly `len` bytes copied — never reads past the view), valid for the whole
// call. `None` only when the path holds an interior NUL byte (not a valid path);
// an empty path yields a valid empty C string.
fn c_path(path: str) -> option::Option[text::CString] {
    return text::from_str(path).c_str();
}

// Open `path` for reading. macOS + Linux: O_RDONLY = 0.
fn open_read(path: str) -> result::Result[File, result::IoError] {
    match c_path(path) {
        option::Option[text::CString]::Some(cp) => {
            let fd: i32 = { open(cp.as_ptr(), 0 as i32, 0 as i32) };
            if fd < (0 as i32) {
                return result::io_err::[File](result::IoError::NotFound);
            }
            return result::io_ok::[File](File { _fd: fd });
        }
        option::Option[text::CString]::None => {
            return result::io_err::[File](result::IoError::InvalidInput);
        }
    }
}

// Open `path` for writing, creating + truncating if missing. Mode 0o644.
//
// macOS flags: O_WRONLY = 0x001, O_CREAT = 0x200, O_TRUNC = 0x400.
// Combined: 0x601 = 1537. (Linux numbers differ — Linux build is a Phase 1
// stretch; see plan.md non-goals.)
fn create(path: str) -> result::Result[File, result::IoError] {
    let flags: i32 = 1537 as i32;
    let mode: i32 = 420 as i32;
    match c_path(path) {
        option::Option[text::CString]::Some(cp) => {
            let fd: i32 = { open(cp.as_ptr(), flags, mode) };
            if fd < (0 as i32) {
                return result::io_err::[File](result::IoError::PermissionDenied);
            }
            return result::io_ok::[File](File { _fd: fd });
        }
        option::Option[text::CString]::None => {
            return result::io_err::[File](result::IoError::InvalidInput);
        }
    }
}

// Open `path` for appending, creating it if missing. Mode 0o644.
//
// macOS flags: O_WRONLY = 0x001, O_CREAT = 0x200, O_APPEND = 0x008.
// Combined: 0x209 = 521. (Linux numbers differ — same caveat as `create`.)
fn open_append(path: str) -> result::Result[File, result::IoError] {
    let flags: i32 = 521 as i32;
    let mode: i32 = 420 as i32;
    match c_path(path) {
        option::Option[text::CString]::Some(cp) => {
            let fd: i32 = { open(cp.as_ptr(), flags, mode) };
            if fd < (0 as i32) {
                return result::io_err::[File](result::IoError::PermissionDenied);
            }
            return result::io_ok::[File](File { _fd: fd });
        }
        option::Option[text::CString]::None => {
            return result::io_err::[File](result::IoError::InvalidInput);
        }
    }
}

impl File {
    // Drain remaining bytes into a fresh heap-allocated buffer. Returns
    // the Vec inside Result::Ok on success, or an IoError on failure.
    fn read_to_end(ref this) -> result::Result[vec::Vec[u8], result::IoError] {
        var buf: vec::Vec[u8] = vec::new::[u8]();
        if this._fd < (0 as i32) {
            return result::io_err::[vec::Vec[u8]](result::IoError::InvalidInput);
        }
        let chunk_size: usize = 4096 as usize;
        let chunk: *u8 = { malloc(chunk_size) };
        if chunk.is_null() {
            return result::io_err::[vec::Vec[u8]](result::IoError::Other);
        }
        loop {
            let n: isize = { read(this._fd, chunk, chunk_size) };
            if n < (0 as isize) {
                { free(chunk); }
                return result::io_err::[vec::Vec[u8]](result::IoError::Other);
            }
            if n == (0 as isize) {
                { free(chunk); }
                return result::io_ok::[vec::Vec[u8]](buf);
            }
            let count: usize = n as usize;
            buf.extend_from_raw(chunk, count);
        }
        return result::io_err::[vec::Vec[u8]](result::IoError::Other);
    }

    // Write `data`. Loops on short writes. On success returns bytes written
    // (always == data.count()); errors return Err.
    fn write_all(ref this, data: vec::Vec[u8]) -> result::Result[usize, result::IoError] {
        if this._fd < (0 as i32) {
            return result::io_err::[usize](result::IoError::InvalidInput);
        }
        let n: usize = data.count();
        let slice: u8[] = data.as_slice();
        let p: *u8 = { #slice_ptr(slice) };
        var written: usize = 0 as usize;
        while written < n {
            let remaining: usize = n -% written;
            let q: *u8 = { p + written };
            let w: isize = { write(this._fd, q, remaining) };
            if w <= (0 as isize) {
                return result::io_err::[usize](result::IoError::BrokenPipe);
            }
            written = written +% (w as usize);
        }
        return result::io_ok::[usize](written);
    }

    // Write a string view. Loops on short writes, like `write_all`, but takes
    // the bytes straight from the `str` — no intermediate Vec. A `Text` passed
    // here coerces to its view. On success returns bytes written.
    fn write_str(ref this, s: str) -> result::Result[usize, result::IoError] {
        if this._fd < (0 as i32) {
            return result::io_err::[usize](result::IoError::InvalidInput);
        }
        let n: usize = { #str_len(s) };
        let p: *u8 = { #str_ptr(s) };
        var written: usize = 0 as usize;
        while written < n {
            let remaining: usize = n -% written;
            let q: *u8 = { p + written };
            let w: isize = { write(this._fd, q, remaining) };
            if w <= (0 as isize) {
                return result::io_err::[usize](result::IoError::BrokenPipe);
            }
            written = written +% (w as usize);
        }
        return result::io_ok::[usize](written);
    }

    // Explicit close. Disarms Drop by setting fd to -1.
    fn close(ref this) {
        if this._fd >= (0 as i32) {
            { close(this._fd); }
            this._fd = 0 -% 1 as i32;
        }
        return;
    }

    // v0.0.5 Phase 4 Slice 4C: flip O_NONBLOCK on the underlying fd so
    // `read_async` can return EAGAIN-loops instead of blocking the
    // executor thread. Idempotent; safe to call repeatedly. Returns 0
    // on success, -1 on fcntl error.
    fn make_nonblocking(ref this) -> i32 {
        return net::set_nonblocking(this._fd);
    }

    // v0.0.5 Phase 4 Slice 4C: async read. Same semantics as
    // `net::read_fd_async(this._fd, buf, count)` — reactor handles
    // EAGAIN suspension via kqueue EVFILT_READ. Prerequisite: call
    // `make_nonblocking()` once before first use.
    async fn read_async(ref this, buf: *u8, count: usize) -> isize {
        return await net::read_fd_async(this._fd, buf, count);
    }

    // v0.0.5 Phase 3 Slice 3D: iterator over '\n'-separated lines.
    // Reads the file in 4 KiB chunks; each yielded `Text` is the
    // line *without* its trailing newline. The carry buffer holds the
    // partial line that spans a chunk boundary, copied into the next
    // chunk's scan. A final fragment without a trailing newline at EOF
    // is yielded as the last line.
    gen fn lines(this) -> text::Text {
        var carry: vec::Vec[u8] = vec::new::[u8]();
        let chunk_size: usize = 4096 as usize;
        let chunk: *u8 = { malloc(chunk_size) };
        if chunk.is_null() {
            return;   // cannot allocate the scan buffer; yield no lines
        }
        loop {
            let n: isize = { read(this._fd, chunk, chunk_size) };
            if n <= (0 as isize) {
                // EOF (n == 0) or error (n < 0). Yield any pending
                // partial line, then stop. Read errors are silently
                // surfaced as "no more lines" — callers needing error
                // detail should use `read_to_end` + manual splitting.
                if carry.count() > (0 as usize) {
                    let cs: u8[] = carry.as_slice();
                    let cp: *u8 = { #slice_ptr(cs) };
                    let view: str = { #str_from_raw_parts(cp, carry.count()) };
                    yield view.to_text();
                }
                { free(chunk); }
                return;
            }
            let count: usize = n as usize;
            var start: usize = 0 as usize;
            var i: usize = 0 as usize;
            while i < count {
                let bp: *u8 = { chunk + i };
                let b: u8 = { *bp };
                if b == (10 as u8) {
                    let chunk_p: *u8 = { chunk + start };
                    let chunk_len: usize = i -% start;
                    if carry.count() == (0 as usize) {
                        let view: str = { #str_from_raw_parts(chunk_p, chunk_len) };
                        yield view.to_text();
                    } else {
                        carry.extend_from_raw(chunk_p, chunk_len);
                        // Inline the slice rather than binding it: a bound `u8[]`
                        // view of `carry` keeps `carry` borrowed through the
                        // `remove_all()` below (borrowck is lexical), even though
                        // the view is dead after `#slice_ptr`. The raw pointer
                        // stays valid until `remove_all` frees the buffer — which
                        // runs after `view` has been copied out via `to_text`.
                        let cp: *u8 = { #slice_ptr(carry.as_slice()) };
                        let view: str = { #str_from_raw_parts(cp, carry.count()) };
                        yield view.to_text();
                        carry.remove_all();
                    }
                    start = i +% (1 as usize);
                }
                i = i +% (1 as usize);
            }
            if start < count {
                let rest_p: *u8 = { chunk + start };
                carry.extend_from_raw(rest_p, count -% start);
            }
        }
        return;
    }

    // Destructor: close the fd if not already closed.
    fn drop(ref this) {
        if this._fd >= (0 as i32) {
            { close(this._fd); }
        }
        return;
    }
}

// ─────────────────────── directory / path ops ───────────────────────

// errno as an `IoError`. Only the file-system-relevant codes are named; the
// rest collapse to `Other`.
fn errno() -> i32 {
    let p: *i32 = { __error() };
    return { *p };
}
fn errno_as_ioerror() -> result::IoError {
    let e: i32 = errno();
    if e == (2 as i32)  { return result::IoError::NotFound; }         // ENOENT
    if e == (13 as i32) { return result::IoError::PermissionDenied; } // EACCES
    if e == (17 as i32) { return result::IoError::AlreadyExists; }    // EEXIST
    return result::IoError::Other;
}

// True if `path` exists (file, directory, or any other node).
fn exists(path: str) -> bool {
    match c_path(path) {
        option::Option[text::CString]::Some(cp) => { return { access(cp.as_ptr(), 0 as i32) } == (0 as i32); }   // F_OK == 0
        option::Option[text::CString]::None => { return false; }
    }
}

// Create the single directory `path` with mode 0o755. `Err(AlreadyExists)` if it
// is already present — use `create_dir_all` to create parents idempotently.
fn create_dir(path: str) -> result::Result[bool, result::IoError] {
    match c_path(path) {
        option::Option[text::CString]::Some(cp) => {
            let r: i32 = { mkdir(cp.as_ptr(), 493 as u16) };   // 0o755
            if r == (0 as i32) { return result::io_ok::[bool](true); }
            return result::io_err::[bool](errno_as_ioerror());
        }
        option::Option[text::CString]::None => {
            return result::io_err::[bool](result::IoError::InvalidInput);
        }
    }
}

// Create `path` and every missing parent, like `mkdir -p`. Idempotent: an
// already-existing directory on the path is treated as success (EEXIST is
// swallowed); any other failure stops and returns the reason.
fn create_dir_all(path: str) -> result::Result[bool, result::IoError] {
    let full: text::Text = text::from_str(path);
    if full.count() == (0 as usize) {
        return result::io_err::[bool](result::IoError::InvalidInput);
    }
    let leading_slash: bool = match full.byte_at(0 as usize) {
        option::Option[u8]::Some(b) => b == (47 as u8),   // '/'
        option::Option[u8]::None => false,
    };
    let parts: vec::Vec[text::Text] = full.split("/");
    // `prefix` always carries a trailing '/' between segments, so each mkdir
    // target is the accumulated path with no duplicate separators.
    var prefix: text::Text = text::with_capacity(full.count() +% (1 as usize));
    if leading_slash { let _s: status::Status = prefix.append("/"); }
    var i: usize = 0 as usize;
    while i < parts.count() {
        match parts.at_ptr(i) {
            option::Option[*text::Text]::Some(seg) => {
                if (*seg).count() > (0 as usize) {
                    let _a: status::Status = prefix.append((*seg).view());
                    match prefix.c_str() {
                        option::Option[text::CString]::Some(cs) => {
                            let r: i32 = { mkdir(cs.as_ptr(), 493 as u16) };
                            if r != (0 as i32) && errno() != (17 as i32) {   // not EEXIST
                                return result::io_err::[bool](errno_as_ioerror());
                            }
                        }
                        option::Option[text::CString]::None => {
                            return result::io_err::[bool](result::IoError::InvalidInput);
                        }
                    }
                    let _b: status::Status = prefix.append("/");
                }
            }
            option::Option[*text::Text]::None => { }
        }
        i = i +% (1 as usize);
    }
    return result::io_ok::[bool](true);
}

// Delete the file at `path`. `Err(NotFound)` if it does not exist.
fn remove_file(path: str) -> result::Result[bool, result::IoError] {
    match c_path(path) {
        option::Option[text::CString]::Some(cp) => {
            let r: i32 = { unlink(cp.as_ptr()) };
            if r == (0 as i32) { return result::io_ok::[bool](true); }
            return result::io_err::[bool](errno_as_ioerror());
        }
        option::Option[text::CString]::None => {
            return result::io_err::[bool](result::IoError::InvalidInput);
        }
    }
}

// `true` for the dirent name "." or "..".
fn _is_dot_entry(p: *u8, len: usize) -> bool {
    if len == (1 as usize) { return { *p } == (46 as u8); }             // "."
    if len == (2 as usize) {
        let p1: *u8 = { p + (1 as usize) };
        return { *p } == (46 as u8) && { *p1 } == (46 as u8);          // ".."
    }
    return false;
}

// The entry names in directory `path` (excluding "." and ".."), or `None` if the
// directory can't be opened. Names only — not full paths.
fn read_dir(path: str) -> option::Option[vec::Vec[text::Text]] {
    // opendir copies the path internally, so the CString need only outlive the
    // call (it does — bound in the match arm).
    let dir: *u8 = match c_path(path) {
        option::Option[text::CString]::Some(cp) => { opendir(cp.as_ptr()) }
        option::Option[text::CString]::None => { 0 as *u8 }
    };
    if dir == { 0 as *u8 } {
        return option::Option[vec::Vec[text::Text]]::None;
    }
    var out: vec::Vec[text::Text] = vec::new::[text::Text]();
    var ent: *u8 = { readdir(dir) };
    while ent != { 0 as *u8 } {
        // Darwin 64-bit-inode `struct dirent`: u64 d_ino, u64 d_seekoff,
        // u16 d_reclen, u16 d_namlen, u8 d_type, then char d_name[] — the name
        // is a NUL-terminated C string starting at byte offset 21.
        let name_ptr: *u8 = { ent + (21 as usize) };
        let len: usize = { strlen(name_ptr) };
        if !_is_dot_entry(name_ptr, len) {
            let name: str = { #str_from_raw_parts(name_ptr, len) };
            out.append(name.to_text());
        }
        ent = { readdir(dir) };
    }
    let _c: i32 = { closedir(dir) };
    return option::Option[vec::Vec[text::Text]]::Some(out);
}

// Read the whole file at `path` into an owned Text, validating UTF-8. Combines
// `open_read` + `File::read_to_end` + `text::from_utf8`; the fd is closed on
// return either way. A non-UTF-8 file is `IoError::InvalidData`. This is the
// tidy path for config / JSON files — feed the Text straight to a parser. Use
// `File::read_to_end` when you want the raw bytes instead.
fn read_to_string(path: str) -> result::Result[text::Text, result::IoError] {
    match open_read(path) {
        result::Result[File, result::IoError]::Ok(f) => {
            var file: File = f;
            match file.read_to_end() {
                result::Result[vec::Vec[u8], result::IoError]::Ok(bytes) => {
                    match text::from_utf8(bytes) {
                        option::Option[text::Text]::Some(t) => {
                            return result::io_ok::[text::Text](t);
                        }
                        option::Option[text::Text]::None => {
                            return result::io_err::[text::Text](result::IoError::InvalidData);
                        }
                    }
                }
                result::Result[vec::Vec[u8], result::IoError]::Err(e) => {
                    return result::io_err::[text::Text](e);
                }
            }
        }
        result::Result[File, result::IoError]::Err(e) => {
            return result::io_err::[text::Text](e);
        }
    }
}

// Write `contents` to the file at `path`, creating it and replacing what was
// there. Combines `create` + `File::write_str` + `close`; the fd is closed on
// return either way. The mirror of `read_to_string` — and since a `Text`
// coerces to `str`, `fs::write_string(path, "${n}")` writes an interpolated
// value in one call. On success returns bytes written. Use `create` +
// `write_all` when you want raw bytes or several writes into one open file.
fn write_string(path: str, contents: str) -> result::Result[usize, result::IoError] {
    match create(path) {
        result::Result[File, result::IoError]::Ok(f) => {
            var file: File = f;
            let written: result::Result[usize, result::IoError] = file.write_str(contents);
            file.close();
            return written;
        }
        result::Result[File, result::IoError]::Err(e) => {
            return result::io_err::[usize](e);
        }
    }
}

// Append `contents` to the file at `path`, creating it if missing. Combines
// `open_append` + `File::write_str` + `close`; the fd is closed on return
// either way. For logs and transports where history must survive; use
// `write_string` when the new content replaces the old. On success returns
// bytes written.
fn append_string(path: str, contents: str) -> result::Result[usize, result::IoError] {
    match open_append(path) {
        result::Result[File, result::IoError]::Ok(f) => {
            var file: File = f;
            let written: result::Result[usize, result::IoError] = file.write_str(contents);
            file.close();
            return written;
        }
        result::Result[File, result::IoError]::Err(e) => {
            return result::io_err::[usize](e);
        }
    }
}

// ───────────────────────────── tests ─────────────────────────────

#[test]
fn append_string_creates_then_extends() {
    let path: str = "/tmp/cplus_stdlib_fs_append.txt";
    let _rm0: result::Result[bool, result::IoError] = remove_file(path);
    let _a: result::Result[usize, result::IoError] = append_string(path, "one\n");
    let _b: result::Result[usize, result::IoError] = append_string(path, "two\n");
    match read_to_string(path) {
        result::Result[text::Text, result::IoError]::Ok(t) => {
            assert t.view() == "one\ntwo\n";
        }
        result::Result[text::Text, result::IoError]::Err(e) => { assert false; }
    }
    let _rm: result::Result[bool, result::IoError] = remove_file(path);
}

#[test]
fn append_string_after_write_string_preserves_content() {
    let path: str = "/tmp/cplus_stdlib_fs_append2.txt";
    let _w: result::Result[usize, result::IoError] = write_string(path, "base");
    let _a: result::Result[usize, result::IoError] = append_string(path, "+more");
    match read_to_string(path) {
        result::Result[text::Text, result::IoError]::Ok(t) => {
            assert t.view() == "base+more";
        }
        result::Result[text::Text, result::IoError]::Err(e) => { assert false; }
    }
    let _rm: result::Result[bool, result::IoError] = remove_file(path);
}

#[test]
fn write_string_then_read_to_string_roundtrip() {
    let path: str = "/tmp/cplus_stdlib_fs_write_string.txt";
    match write_string(path, "hello fs") {
        result::Result[usize, result::IoError]::Ok(n) => { assert n == (8 as usize); }
        result::Result[usize, result::IoError]::Err(e) => { assert false; }
    }
    match read_to_string(path) {
        result::Result[text::Text, result::IoError]::Ok(t) => {
            assert t.view() == "hello fs";
        }
        result::Result[text::Text, result::IoError]::Err(e) => { assert false; }
    }
    let _rm: result::Result[bool, result::IoError] = remove_file(path);
}

#[test]
fn write_string_replaces_previous_content() {
    let path: str = "/tmp/cplus_stdlib_fs_write_string2.txt";
    let _a: result::Result[usize, result::IoError] = write_string(path, "a much longer first version");
    let _b: result::Result[usize, result::IoError] = write_string(path, "short");
    match read_to_string(path) {
        result::Result[text::Text, result::IoError]::Ok(t) => {
            assert t.view() == "short";
        }
        result::Result[text::Text, result::IoError]::Err(e) => { assert false; }
    }
    let _rm: result::Result[bool, result::IoError] = remove_file(path);
}

#[test]
fn write_string_accepts_an_interpolated_text() {
    // "${...}" builds an owned Text; the coercion passes it as the str view.
    let path: str = "/tmp/cplus_stdlib_fs_write_string3.txt";
    let n: i32 = 42;
    let _w: result::Result[usize, result::IoError] = write_string(path, "${n}");
    match read_to_string(path) {
        result::Result[text::Text, result::IoError]::Ok(t) => {
            assert t.view() == "42";
        }
        result::Result[text::Text, result::IoError]::Err(e) => { assert false; }
    }
    let _rm: result::Result[bool, result::IoError] = remove_file(path);
}

#[test]
fn write_string_missing_directory_is_an_error() {
    match write_string("/tmp/cplus_stdlib_fs_missing_dir/f.txt", "x") {
        result::Result[usize, result::IoError]::Ok(n) => { assert false; }
        result::Result[usize, result::IoError]::Err(e) => { }
    };
}

#[test]
fn write_str_appends_within_one_open_file() {
    let path: str = "/tmp/cplus_stdlib_fs_write_str.txt";
    match create(path) {
        result::Result[File, result::IoError]::Ok(f) => {
            var w: File = f;
            let _a: result::Result[usize, result::IoError] = w.write_str("ab");
            let _b: result::Result[usize, result::IoError] = w.write_str("cd");
            w.close();
        }
        result::Result[File, result::IoError]::Err(e) => { assert false; }
    }
    match read_to_string(path) {
        result::Result[text::Text, result::IoError]::Ok(t) => {
            assert t.view() == "abcd";
        }
        result::Result[text::Text, result::IoError]::Err(e) => { assert false; }
    }
    let _rm: result::Result[bool, result::IoError] = remove_file(path);
}

#[test]
fn fs_write_then_read_roundtrip() {
    let path: str = "/tmp/cplus_stdlib_fs_test.bin";
    match create(path) {
        result::Result[File, result::IoError]::Ok(f) => {
            var w: File = f;
            var data: vec::Vec[u8] = vec::new::[u8]();
            data.append(72 as u8);
            data.append(105 as u8);
            match w.write_all(data) {
                result::Result[usize, result::IoError]::Ok(n) => { assert n == (2 as usize); }
                result::Result[usize, result::IoError]::Err(e) => { assert false; }
            }
            w.close();
        }
        result::Result[File, result::IoError]::Err(e) => { assert false; }
    }
    match open_read(path) {
        result::Result[File, result::IoError]::Ok(f) => {
            var r: File = f;
            match r.read_to_end() {
                result::Result[vec::Vec[u8], result::IoError]::Ok(bytes) => { assert bytes.count() == (2 as usize); }
                result::Result[vec::Vec[u8], result::IoError]::Err(e) => { assert false; }
            }
        }
        result::Result[File, result::IoError]::Err(e) => { assert false; }
    }
    return;
}

#[test]
fn fs_path_reads_only_the_view_not_the_buffer_tail() {
    // Regression (2026-07-11): a `str` is a (ptr,len) view with no NUL at
    // ptr[len]. Reach a real file through a view whose backing buffer has
    // trailing junk after `len`; libc must see only the 27-byte view, not read
    // into the junk (before the fix, open/access saw "...binJUNKJUNK" → ENOENT).
    let real: str = "/tmp/cplus_fs_view_test.bin";
    match create(real) {
        result::Result[File, result::IoError]::Ok(f) => { var w: File = f; w.close(); }
        result::Result[File, result::IoError]::Err(e) => { assert false; }
    }
    let padded: str = "/tmp/cplus_fs_view_test.binJUNKJUNK";
    let view: str = { #str_from_raw_parts(#str_ptr(padded), 27 as usize) };   // just the path
    assert exists(view);
    match open_read(view) {
        result::Result[File, result::IoError]::Ok(f) => { var r: File = f; r.close(); }
        result::Result[File, result::IoError]::Err(e) => { assert false; }
    }
    let _c: result::Result[bool, result::IoError] = remove_file(real);
    return;
}

#[test]
fn dir_create_exists_read_remove() {
    let base: str = "/tmp/cplus_fs_dir_test";
    let nested: str = "/tmp/cplus_fs_dir_test/x/y";
    let fpath: str = "/tmp/cplus_fs_dir_test/x/y/f.txt";
    let _cleanup: result::Result[bool, result::IoError] = remove_file(fpath);   // best effort

    // create_dir_all makes every parent; idempotent on re-run.
    match create_dir_all(nested) {
        result::Result[bool, result::IoError]::Ok(v) => { assert v; }
        result::Result[bool, result::IoError]::Err(e) => { assert false; }
    }
    assert exists(base);
    assert exists(nested);
    assert !exists("/tmp/cplus_fs_dir_test/nope");

    // create_dir on an existing directory reports AlreadyExists.
    match create_dir(base) {
        result::Result[bool, result::IoError]::Ok(v) => { assert false; }
        result::Result[bool, result::IoError]::Err(e) => {
            match e { result::IoError::AlreadyExists => { } _ => { assert false; } }
        }
    }

    // a file in the nested dir shows up in read_dir, then removes cleanly.
    match create(fpath) {
        result::Result[File, result::IoError]::Ok(f) => { var w: File = f; w.close(); }
        result::Result[File, result::IoError]::Err(e) => { assert false; }
    }
    assert exists(fpath);
    match read_dir(nested) {
        option::Option[vec::Vec[text::Text]]::Some(names) => {
            var found: bool = false;
            var i: usize = 0 as usize;
            while i < names.count() {
                match names.at_ptr(i) {
                    option::Option[*text::Text]::Some(nm) => { if (*nm).equals("f.txt") { found = true; } }
                    option::Option[*text::Text]::None => { }
                }
                i = i +% (1 as usize);
            }
            assert found;
        }
        option::Option[vec::Vec[text::Text]]::None => { assert false; }
    }

    match remove_file(fpath) {
        result::Result[bool, result::IoError]::Ok(v) => { assert v; }
        result::Result[bool, result::IoError]::Err(e) => { assert false; }
    }
    assert !exists(fpath);

    // removing a missing file reports NotFound.
    match remove_file(fpath) {
        result::Result[bool, result::IoError]::Ok(v) => { assert false; }
        result::Result[bool, result::IoError]::Err(e) => {
            match e { result::IoError::NotFound => { } _ => { assert false; } }
        }
    }
    return;
}

#[test]
fn read_to_string_reads_a_utf8_file() {
    let path: str = "/tmp/cplus_stdlib_read_to_string.txt";
    match create(path) {
        result::Result[File, result::IoError]::Ok(f) => {
            var w: File = f;
            var data: vec::Vec[u8] = vec::new::[u8]();
            data.append(0xC3 as u8); data.append(0xA9 as u8);   // "é"
            data.append(33 as u8);                               // "!"
            let _wr: result::Result[usize, result::IoError] = w.write_all(data);
            w.close();
        }
        result::Result[File, result::IoError]::Err(e) => { assert false; }
    }
    match read_to_string(path) {
        result::Result[text::Text, result::IoError]::Ok(t) => { assert t.count() == (3 as usize); }
        result::Result[text::Text, result::IoError]::Err(e) => { assert false; }
    }
    let _rm: result::Result[bool, result::IoError] = remove_file(path);
    return;
}

#[test]
fn read_to_string_rejects_non_utf8() {
    let path: str = "/tmp/cplus_stdlib_read_to_string_bad.bin";
    match create(path) {
        result::Result[File, result::IoError]::Ok(f) => {
            var w: File = f;
            var data: vec::Vec[u8] = vec::new::[u8]();
            data.append(0xFF as u8); data.append(0xFE as u8);   // never valid UTF-8
            let _wr: result::Result[usize, result::IoError] = w.write_all(data);
            w.close();
        }
        result::Result[File, result::IoError]::Err(e) => { assert false; }
    }
    match read_to_string(path) {
        result::Result[text::Text, result::IoError]::Ok(_t) => { assert false; }
        result::Result[text::Text, result::IoError]::Err(e) => {
            match e { result::IoError::InvalidData => { } _ => { assert false; } }
        }
    }
    let _rm: result::Result[bool, result::IoError] = remove_file(path);
    return;
}

#[test]
fn read_to_string_missing_file_is_not_found() {
    match read_to_string("/tmp/cplus_stdlib_no_such_file_zzz.txt") {
        result::Result[text::Text, result::IoError]::Ok(_t) => { assert false; }
        result::Result[text::Text, result::IoError]::Err(e) => {
            match e { result::IoError::NotFound => { } _ => { assert false; } }
        }
    }
    return;
}
