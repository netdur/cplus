// stdlib/executor.cplus — single-threaded driver for `Future[T]`.
//
// v0.0.3 Phase 5 Slice 5E.5. `block_on` is the canonical entry point
// for synchronous code that wants to consume an `async fn`'s result.
// It loops `Future::poll` (via the compiler's `coro.resume` /
// `coro.done` intrinsics) until the future produces `Ready(T)`,
// then returns T.
//
// **v0.0.3 scope:** synchronous drive only — the loop spins on the
// coroutine until completion. No reactor, no I/O suspension. The
// async-fetch recipe (with kqueue/epoll wake-on-readable) lands
// post-v0.0.3 when the reactor ships.
//
// **No multi-threaded executor.** Single-threaded driver only —
// matches tokio's `current_thread` runtime semantics and sidesteps
// the `Send`/`Sync` design that v0.0.4 will tackle.

import "./future" as future;
import "./time" as time;
// v0.0.4 Phase 3 Slice 3A.1: pull in the reactor so block_on's
// reactor-integrated drive loop has its stable-symbol callees
// (`stdlib_reactor_*_v1`) available at link time. block_on itself
// is compiler-intrinsic, but it now calls into the reactor's drain /
// poll routines emitted by reactor.cplus.
import "./reactor" as reactor;
import "./thread" as thread;
import "./channel" as channel;
import "./atomic" as atomic;
import "./option" as option;
import "./status" as status;

// Codegen-emitted stable wrappers around the LLVM coroutine intrinsics —
// the pieces `run`'s surface-C+ drive loop is written out of.
#[runtime_abi]
extern fn __cplus_coro_resume(hdl: *u8);
#[runtime_abi]
extern fn __cplus_coro_done(hdl: *u8) -> i32;
#[runtime_abi]
extern fn __cplus_coro_destroy(hdl: *u8);

// Drive a `Future[T]` to completion and return its produced value.
// Blocks the calling thread (no other tasks run on it) until the
// future resolves. Drops the coroutine frame after extracting T.
//
// `block_on` is the DRIVE-TO-COMPLETION form: a `JoinHandle::cancel`
// request against this thread does not stop it (same doctrine as a compute
// loop that never checks `thread::cancelled()`). A worker that should be
// stoppable while running async code uses `run` below.
fn block_on[T](f: future::Future[T]) -> T {
    return { #block_on::[T](f) };
}

// v0.0.29 phase 2 — the outcome of a CANCELLABLE drive (`run`).
enum RunResult[T] {
    Done(T),
    Cancelled,
}

// Drive a `Future[T]` to completion — unless this thread is asked to stop.
//
// The same loop as `block_on` (which is intrinsic IR; this is its
// surface-C+ twin), joined to the phase-1 cancellation protocol: the kevent
// park is cancellable, and the loop re-checks `thread::cancelled()` between
// resumes. On cancellation it destroys the task tree it owns — destroying
// the top-level frame cascades through every await's cancel edge, running
// the drops of the locals live at each suspend point — then tears down this
// thread's reactor (closing the kqueue de-registers every waiter and
// timer) and reports `Cancelled`. Cancellation cannot skip a drop, and
// `join` on this worker still returns its value — the value just says the
// work was cut short.
//
// Residual (recorded in the cancellation report): a `spawn_local` task this
// tree does not own is leaked, not destroyed, by the teardown.
fn run[T: Send](take f: future::Future[T]) -> RunResult[T] {
    let hdl: *u8 = f.raw_handle();
    loop {
        // Async fns run eagerly to their first suspend, so the frame may be
        // done before the loop ever resumes it — check first (resuming a
        // done coroutine is UB in LLVM).
        if { #coro_done(hdl) } != (0 as i32) {
            let prom: *T = { #coro_promise::[T](hdl) };
            let v: T = { #take::[T](prom) };
            // `cancel` CONSUMES the future, and consuming it is what frees the
            // frame — `Future::drop` purges the pending queue and destroys.
            // Explicit rather than left to scope exit so the order is on the
            // page: the value is out of the promise before the frame goes.
            f.cancel();
            return RunResult[T]::Done(v);
        }
        if thread::cancelled() {
            // DESTROY BEFORE TEARDOWN, and the order is load-bearing: the
            // frame's cancel edges unregister awaiters and pending entries,
            // and `teardown` has already freed those arrays and closed the
            // kqueue. Consuming `f` here is what keeps the two in this order —
            // leaving it to scope exit would run them the other way round.
            f.cancel();
            reactor::teardown();
            return RunResult[T]::Cancelled;
        }
        { #coro_resume(hdl); }
        if { #coro_done(hdl) } != (0 as i32) { continue; }
        let _n: i32 = reactor::drain_pending();
        if reactor::waiter_count() > (0 as i32) {
            let _p: i32 = reactor::poll_one_event_cancellable();
        }
    }
}

// ── the async ↔ thread bridge (v0.0.29 phase 2) ──

// One reactor tick — a 1ms timer suspend. The polling quantum for the
// bridge helpers below; a dedicated wake channel is the later refinement.
async fn _tick() {
    { #reactor_wait_timer(1 as u64); }
}

// Await a spawned WORKER THREAD's result from async code without blocking
// the executor thread: poll `is_finished` on the reactor's timer quantum,
// then collect through the (now non-blocking) `join`. If THIS task is
// cancelled while waiting, its frame is destroyed at the await — the
// moved-in handle drops, which DETACHES the worker rather than cancelling
// it (cancel the handle yourself first if the worker should stop too).
// THE DEADLINE, on both bridges below, and it answers with the vocabulary each
// one already has rather than inventing one.
//
// `timeout` is SECONDS, and anything <= 0 means "no deadline" — today's
// behaviour, and the default, so no existing call changes. It is a wall-clock
// deadline (`time::now_millis`): stdlib has no monotonic clock, so a system
// clock stepped BACKWARDS by NTP defers the expiry rather than firing it early.
// Recorded rather than hidden; a monotonic read is the refinement, not a
// different design.
//
// Before this, an async caller wanting "this, or give up after two seconds" had
// to build it from a timer future and a race — and there is no `select`/`race`
// either, so what it actually wrote was a poll loop with a sleep in it.
fn _deadline_from(timeout: f64) -> i64 {
    if timeout <= 0.0f64 { return 0 as i64; }
    return time::now_millis() +% { (timeout * 1000.0f64) as i64 };
}

fn _expired(deadline: i64) -> bool {
    if deadline == (0 as i64) { return false; }
    return time::now_millis() > deadline;
}

// Await a worker thread's result, optionally giving up after `timeout` seconds.
//
// GIVING UP CANCELS AND STILL JOINS, which is why this can keep returning `O`
// rather than growing an Option. A cancelled worker's `join` returns its value
// under the phase-1 contract — "the value just says the work was cut short" —
// so the expiry path requests cancellation and then waits for the thread to
// notice, which is the only way to get the value out at all. A worker that
// never checks `thread::cancelled()` and never returns will still be waited
// for: this is a deadline on the ASKING, not a kill.
async fn join_worker[O: Send](take h: thread::JoinHandle[O], timeout: f64 = 0.0f64) -> O {
    let deadline: i64 = _deadline_from(timeout);
    var asked: bool = false;
    loop {
        if h.is_finished() { return h.join(); }
        if !asked && _expired(deadline) {
            h.cancel();
            asked = true;
        }
        await _tick();
    }
}

// Async channel receive: poll `try_receive` on the timer quantum instead of
// parking the executor thread in the channel's condvar, and surface THIS
// task's cancellation as `ReceiveResult::Cancelled` — the same vocabulary
// the blocking `receive` uses for a cancelled thread. Buffered data still
// wins over cancellation.
async fn receive_or_cancel[T: Send](take ch: channel::Channel[T],
                                    timeout: f64 = 0.0f64)
        -> channel::ReceiveResult[T] {
    let deadline: i64 = _deadline_from(timeout);
    loop {
        match ch.try_receive() {
            channel::TryReceiveResult::Value(v) => {
                return channel::ReceiveResult[T]::Value(v);
            }
            channel::TryReceiveResult::Closed => {
                return channel::ReceiveResult[T]::Closed;
            }
            channel::TryReceiveResult::Empty => {
                if thread::cancelled() {
                    return channel::ReceiveResult[T]::Cancelled;
                }
                // AN EXPIRY IS `Cancelled`, the variant this already answers
                // with, because from the caller's side the two are the same
                // fact: no value, and none coming. A third variant would make
                // every `match` here grow an arm to say the same thing.
                //
                // CHECKED AFTER `try_receive`, so buffered data still wins over
                // an expiry exactly as it wins over a cancellation.
                if _expired(deadline) {
                    return channel::ReceiveResult[T]::Cancelled;
                }
            }
        }
        await _tick();
    }
}

// v0.0.4 Phase 3 Slice 3A.2: yield control back to the executor.
// Only meaningful inside an `async fn` body — pushes this onto the
// reactor's pending queue and suspends. On the next block_on
// iteration, the drain step resumes us; cooperative-multitasking
// primitive for "give other tasks a turn."
async fn yield_now() {
    { #reactor_yield_now(); }
}

// v0.0.4 Phase 3 Slice 3A.2: enqueue a future for the executor to
// drive in addition to the one passed to `block_on`. The spawned
// future runs to completion in the same thread, interleaved with
// the awaiter. Single-threaded only.
//
// `T` must be Send for forward compatibility, even though v0.0.4's
// Send is permissive (every type satisfies it).
fn spawn_local[T: Send](take f: future::Future[T]) {
    { #reactor_spawn_local(f); }
}

// Touch reactor module so the `import` isn't treated as unused. The
// reactor's stable-symbol exports are link-time-resolved; this read
// keeps the import elided-pass happy.
fn _touch_reactor() -> i32 {
    return reactor::waiter_count();
}

// ───────────────────────────── tests ─────────────────────────────

extern fn usleep(us: u32) -> i32;

async fn _ready_value() -> i32 {
    return 42;
}

#[test]
fn block_on_drives_async_to_completion() {
    let v: i32 = block_on::[i32](_ready_value());
    assert v == 42;
}

// ── one reactor per thread (2026-08-22) ──
//
// The reactor state slot was a process-global with no lock while `block_on`
// had no thread affinity, so two executors on two threads shared one kqueue
// and one set of six realloc-grown arrays. The lazy init was the sharpest
// instance: both threads see the slot null, both create a kqueue, both
// store, and one fd is orphaned with its waiters attached to a block nobody
// will poll again.
//
// The slot is thread-local now, which is what `reactor.cplus`'s header has
// claimed since v0.0.4. Two threads asking for their kqueue fd must get two
// DIFFERENT descriptors — same answer is the bug, and it is a property no
// amount of running the racy version would reliably show (the report that
// found this got the right answer eight times out of eight).

fn _kqfd_here(take _ignored: i32) -> i32 {
    return reactor::reactor_fd();
}

#[test]
fn each_thread_gets_its_own_reactor() {
    let mine: i32 = reactor::reactor_fd();
    var a: thread::JoinHandle[i32] =
        thread::spawn_with::[i32, i32](0 as i32, _kqfd_here);
    var b: thread::JoinHandle[i32] =
        thread::spawn_with::[i32, i32](0 as i32, _kqfd_here);
    let fa: i32 = a.join();
    let fb: i32 = b.join();
    assert fa >= (0 as i32);
    assert fb >= (0 as i32);
    assert fa != fb;
    assert fa != mine;
    assert fb != mine;
}

// ---- v0.0.29 phase 2: cancellable drive + drop-to-cancel + the bridge ----

static _P2_DROPS: u64 = 0u64;

struct _AsyncProbe {
    _v: i64,
}
impl _AsyncProbe {
    fn drop(ref this) {
        atomic::fetch_add_u64(#addr_of(_P2_DROPS), 1 as u64, atomic::Ordering::AcqRel);
    }
}

// A timer park that will not fire within the suite — only cancellation ends
// it. Deliberately an AWAITED inner frame, not a direct intrinsic call in
// the outer body: the drive loops re-resume the top-level frame every pass,
// and an await re-suspends harmlessly while a bare reactor park would be
// walked past. (This is also the shape all real code has — reactor parks
// live inside awaited stdlib wrappers like `time::sleep`.)
async fn _long_nap() {
    { #reactor_wait_timer(3600000 as u64); }
}

// A frame with an owned local LIVE ACROSS its await — cancelling this must
// destroy the awaited inner frame (via the await's cancel edge, which also
// unregisters the awaiter entry) AND run `p`'s drop.
async fn _sleepy_with_probe() -> i32 {
    let p: _AsyncProbe = _AsyncProbe { _v: 5 as i64 };
    await _long_nap();
    return p._v as i32;
}

fn _run_sleepy(take x: i64) -> i64 {
    return match run::[i32](_sleepy_with_probe()) {
        RunResult::Done(v) => { (v as i64) }
        RunResult::Cancelled => { 77 as i64 }
    };
}

#[test]
fn run_reports_cancellation_and_runs_the_frames_drops() {
    let before: u64 = atomic::load_u64(#addr_of(_P2_DROPS), atomic::Ordering::Acquire);
    let h: thread::JoinHandle[i64] = thread::spawn_with::[i64, i64](0 as i64, _run_sleepy);
    usleep(20000 as u32);
    h.cancel();
    assert h.join() == (77 as i64);
    let after: u64 = atomic::load_u64(#addr_of(_P2_DROPS), atomic::Ordering::Acquire);
    assert after == before +% (1 as u64);
}

// THE SAME SHAPE THROUGH A NAMED LOCAL, and the reason it is a separate
// fixture: `_sleepy_with_probe` above awaits a TEMPORARY, and a temporary and a
// named binding reach the drop machinery by different routes. At an await's
// cancel edge the lowering destroys the awaited frame and then runs the drops
// of the locals live at that suspend point — so a future held in a local is the
// shape where those two could collide into a double destroy.
//
// Uncovered until v0.0.30 gave `Future` a destructor, which is when the
// question started having a wrong answer.
async fn _sleepy_via_a_named_local() -> i32 {
    let p: _AsyncProbe = _AsyncProbe { _v: 5 as i64 };
    let f: future::Future[i32] = _long_nap_value();
    let _v: i32 = await f;
    return p._v as i32;
}

async fn _long_nap_value() -> i32 {
    await _long_nap();
    return 3;
}

fn _run_sleepy_local(take x: i64) -> i64 {
    return match run::[i32](_sleepy_via_a_named_local()) {
        RunResult::Done(v) => { (v as i64) }
        RunResult::Cancelled => { 78 as i64 }
    };
}

#[test]
fn cancelling_through_an_awaited_LOCAL_destroys_once_and_runs_its_drops() {
    let before: u64 = atomic::load_u64(#addr_of(_P2_DROPS), atomic::Ordering::Acquire);
    let h: thread::JoinHandle[i64] = thread::spawn_with::[i64, i64](0 as i64, _run_sleepy_local);
    usleep(20000 as u32);
    h.cancel();
    assert h.join() == (78 as i64);
    // The probe live at the suspend point still dropped exactly once — a
    // double destroy of the inner frame would abort long before this reads.
    let after: u64 = atomic::load_u64(#addr_of(_P2_DROPS), atomic::Ordering::Acquire);
    assert after == before +% (1 as u64);
}

async fn _quick_value() -> i32 {
    return 9;
}

#[test]
fn run_drives_to_done_when_uncancelled() {
    match run::[i32](_quick_value()) {
        RunResult::Done(v) => { assert v == 9; }
        RunResult::Cancelled => { assert false; }
    }
}

async fn _nap_then_value() -> i32 {
    await _tick();
    return 11;
}

#[test]
fn run_drives_through_a_real_suspend() {
    match run::[i32](_nap_then_value()) {
        RunResult::Done(v) => { assert v == 11; }
        RunResult::Cancelled => { assert false; }
    }
}

#[test]
fn future_cancel_destroys_a_suspended_frame_and_runs_drops() {
    let before: u64 = atomic::load_u64(#addr_of(_P2_DROPS), atomic::Ordering::Acquire);
    let f: future::Future[i32] = _sleepy_with_probe();
    f.cancel();
    let after: u64 = atomic::load_u64(#addr_of(_P2_DROPS), atomic::Ordering::Acquire);
    assert after == before +% (1 as u64);
    // The hour-long timer the frame registered is stale in this thread's
    // kqueue now — reset the reactor so later tests start fresh.
    reactor::teardown();
}

// ---- the bridge ----

fn _times_two(take x: i64) -> i64 {
    return x *% (2 as i64);
}

async fn _bridge_join() -> i64 {
    let h: thread::JoinHandle[i64] = thread::spawn_with::[i64, i64](21 as i64, _times_two);
    return await join_worker::[i64](h);
}

#[test]
fn join_worker_bridges_a_thread_result_into_async() {
    let v: i64 = block_on::[i64](_bridge_join());
    assert v == (42 as i64);
}

// ---- the deadlines ----
//
// A DEADLINE THAT DOES NOT EXPIRE MUST CHANGE NOTHING, which is half of what
// these check: the useful assertion is not only "it gives up" but "it does not
// give up early". A timeout implemented as an unconditional expiry would pass
// a test that only ever watched the giving-up half.

fn _slow_double(take x: i64) -> i64 {
    // Long enough that a 20ms deadline is certain to expire first, and short
    // enough that a suite waiting on it is not noticeably slower. The worker
    // never checks `thread::cancelled()`, deliberately: the deadline is a
    // deadline on the ASKING, and this pins that it still waits for the value.
    usleep(120000 as u32);
    return x *% (2 as i64);
}

async fn _join_with_deadline(ms: f64) -> i64 {
    let h: thread::JoinHandle[i64] = thread::spawn_with::[i64, i64](21 as i64, _slow_double);
    return await join_worker::[i64](h, timeout: ms);
}

#[test]
fn a_join_deadline_that_does_not_expire_returns_the_value() {
    let v: i64 = block_on::[i64](_join_with_deadline(5.0f64));
    assert v == (42 as i64);
}

#[test]
fn an_expired_join_deadline_still_hands_back_the_workers_value() {
    // The phase-1 contract: a cancelled worker's `join` returns its value, the
    // value just says the work was cut short. This one ignores the request, so
    // the value is the full answer — which is exactly the point being pinned:
    // the deadline asks, it does not kill, and it never loses the result.
    let t0: i64 = time::now_millis();
    let v: i64 = block_on::[i64](_join_with_deadline(0.02f64));
    let elapsed: i64 = time::now_millis() - t0;
    assert v == (42 as i64);
    // And it really waited for the worker rather than returning at the
    // deadline with something invented.
    assert elapsed >= (100 as i64);
}

async fn _recv_with_deadline(take ch: channel::Channel[i32], secs: f64)
        -> channel::ReceiveResult[i32] {
    return await receive_or_cancel::[i32](ch, timeout: secs);
}

#[test]
fn an_expired_receive_deadline_answers_cancelled() {
    match channel::new::[i32]() {
        option::Option[channel::Channel[i32]]::Some(ch) => {
            let t0: i64 = time::now_millis();
            match block_on::[channel::ReceiveResult[i32]](_recv_with_deadline(ch.clone(), 0.05f64)) {
                channel::ReceiveResult[i32]::Cancelled => { }
                channel::ReceiveResult[i32]::Value(_) => { assert false; }
                channel::ReceiveResult[i32]::Closed => { assert false; }
            };
            let elapsed: i64 = time::now_millis() - t0;
            // It waited for the deadline rather than expiring on the first
            // empty poll — the failure a "timeout" that is really a try_receive
            // would have.
            assert elapsed >= (40 as i64);
        }
        option::Option[channel::Channel[i32]]::None => { assert false; }
    }
}

#[test]
fn a_value_arriving_before_the_deadline_wins() {
    // Buffered data beats an expiry exactly as it beats a cancellation, which
    // is why the deadline is checked AFTER `try_receive` and not before.
    match channel::new::[i32]() {
        option::Option[channel::Channel[i32]]::Some(ch) => {
            let sender: thread::JoinHandle[i64] =
                thread::spawn_with::[channel::Channel[i32], i64](ch.clone(), _send_late);
            match block_on::[channel::ReceiveResult[i32]](_recv_with_deadline(ch.clone(), 5.0f64)) {
                channel::ReceiveResult[i32]::Value(v) => { assert v == 33; }
                channel::ReceiveResult[i32]::Cancelled => { assert false; }
                channel::ReceiveResult[i32]::Closed => { assert false; }
            };
            let _z: i64 = sender.join();
        }
        option::Option[channel::Channel[i32]]::None => { assert false; }
    }
}

#[test]
fn no_deadline_is_the_default_and_zero_means_the_same() {
    // The existing calls elsewhere in this file pass no timeout at all; this
    // pins that the sentinel and the default agree, so a caller writing
    // `timeout: 0.0` explicitly does not get an instant expiry.
    assert _deadline_from(0.0f64) == (0 as i64);
    assert _deadline_from(0.0f64 - 1.0f64) == (0 as i64);
    assert !_expired(_deadline_from(0.0f64));
    assert !_expired(_deadline_from(60.0f64));
}

fn _send_late(take ch: channel::Channel[i32]) -> i64 {
    usleep(5000 as u32);
    let _s: status::Status = ch.send(33);
    return 0 as i64;
}

async fn _recv_via_bridge(take ch: channel::Channel[i32]) -> i32 {
    return match await receive_or_cancel::[i32](ch) {
        channel::ReceiveResult::Value(v) => { v }
        channel::ReceiveResult::Closed => { (0 - 1) }
        channel::ReceiveResult::Cancelled => { (0 - 2) }
    };
}

#[test]
fn receive_or_cancel_gets_a_value_sent_from_a_thread() {
    match channel::new::[i32]() {
        option::Option[channel::Channel[i32]]::Some(ch) => {
            let sender: thread::JoinHandle[i64] =
                thread::spawn_with::[channel::Channel[i32], i64](ch.clone(), _send_late);
            let v: i32 = block_on::[i32](_recv_via_bridge(ch.clone()));
            assert v == 33;
            let _z: i64 = sender.join();
        }
        option::Option[channel::Channel[i32]]::None => { assert false; }
    }
}

fn _recv_bridge_worker(take ch: channel::Channel[i32]) -> i64 {
    // block_on deliberately: the CANCELLATION here is observed by the task
    // itself (receive_or_cancel's own `cancelled()` poll), which makes the
    // outcome deterministic — the driver never wins the race.
    return block_on::[i32](_recv_via_bridge(ch)) as i64;
}

#[test]
fn receive_or_cancel_surfaces_cancellation() {
    match channel::new::[i32]() {
        option::Option[channel::Channel[i32]]::Some(ch) => {
            let h: thread::JoinHandle[i64] =
                thread::spawn_with::[channel::Channel[i32], i64](ch.clone(), _recv_bridge_worker);
            usleep(10000 as u32);
            h.cancel();
            assert h.join() == ((0 - 2) as i64);
        }
        option::Option[channel::Channel[i32]]::None => { assert false; }
    }
}

// ---- the awaiter table's idempotence -----------------------------------------

// An inner task that suspends SEVERAL times, so `block_on` gets several drive
// passes over the outer while the inner is still running. That is the count
// that matters: each pass re-runs the outer's await registration, and an
// append-only awaiter table gains one duplicate entry per pass.
async fn _five_ticks() -> i32 {
    var i: i32 = 0;
    while i < (5 as i32) {
        await _tick();
        i = i +% (1 as i32);
    }
    return 5;
}

async fn _await_five_ticks() -> i32 {
    return await _five_ticks();
}

#[test]
fn the_awaiter_table_is_left_empty_by_a_completed_block_on() {
    // REGRESSION, 2026-08-23, `reactor_linux` / `reactor_windows`: their
    // `register_awaiter` was append-only where Darwin's scans first.
    //
    // `block_on` resumes the OUTERMOST future once per drive pass, and every
    // pass re-runs that future's await registration. Append-only, the table
    // therefore gains one duplicate per pass, and `notify_completed` retires
    // exactly ONE of them — so a completed `block_on` walks away leaving
    // entries that name a frame it has already destroyed.
    //
    // THE CRASH IS NOWHERE NEAR HERE, which is why the assertion is on the
    // table and not on an outcome. The stale entry is inert until malloc
    // hands a later coroutine the same address; then a `notify_completed`
    // matches the dead entry ahead of the live one and puts a freed frame in
    // the pending queue, and the NEXT `block_on` on this thread drains it and
    // resumes freed memory. That surfaced as a SIGSEGV in a different
    // module's test, two suites downstream, with a garbage RIP and no usable
    // backtrace — nothing at the crash site points back to here.
    //
    // Asserting the invariant at the source turns all of that into one
    // deterministic integer compare: run a nested await, and the table is as
    // empty as it was before. `_five_ticks` suspends five times so there are
    // several drive passes to duplicate across; one pass would not show it.
    let before: i32 = reactor::awaiter_count();
    assert block_on::[i32](_await_five_ticks()) == 5;
    assert reactor::awaiter_count() == before;
    // And again, because the failure needs a SECOND round to become a
    // use-after-free — if round one leaks, round two is where it bites.
    assert block_on::[i32](_await_five_ticks()) == 5;
    assert reactor::awaiter_count() == before;
}
