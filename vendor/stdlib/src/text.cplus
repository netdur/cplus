// stdlib/text.cplus — owned, growable string.
//
// `Text` owns a heap buffer (malloc'd) and frees it on drop. It is the owned
// string type: build it incrementally with `append`, read it by lending a
// `str` view. A `Text` coerces to `str` (its `{ptr,len}` prefix) wherever a
// `str` is expected — an argument, a binding, a return. Reads that search the
// contents (`find`/`contains`/`has_prefix`/`has_suffix`) take a `str` needle
// so any source — a literal, a slice, or another Text's view — works without
// allocating.
//
// The coerced `str` is a view into this Text's buffer with no lifetime tie back
// to it. If the Text drops, or reallocates on a later `append`, the view
// dangles. Returning the view of a *local* Text is rejected (E0513); returning
// a view of a parameter is the caller's promise that the Text outlives it.
//
// API (Swift-flavored): count, char_count, capacity, is_empty; append,
// insert(at:), reserve, remove_all, remove_range(from:to:), truncate(to:);
// clone, byte_at(index:), slice(from:to:); has_prefix, has_suffix, contains,
// find, rfind, compare, equals, equals_ignoring_case; trim/trim_start/trim_end,
// lowercased, uppercased, lowercased_first, uppercased_first,
// removing_prefix/removing_suffix, pad_start(to:with:)/pad_end(to:with:),
// split(separator:); c_str. Free fns: new, with_capacity(minimum:),
// from_str, from_utf8, repeating(_, count:), join(_, separator:) (the inverse
// of split).
//
// Bytes are stored as-is (UTF-8 when the inputs are UTF-8). Indices returned by
// `find` are byte offsets. This is the owned half of the `Text` plan; the
// borrowed-static / literal-construction representation is a later slice.

import "./option" as option;
import "./vec" as vec;
import "./status" as status;
// STRM v2 (2026-07-31): text delegates its read methods to the builtin
// `str` method set (the blessed block in ./str). The alias is unused —
// the import exists to include the module, which also means every
// program importing stdlib/text gets `str` methods transitively.
import "./str" as str_view;

extern fn malloc(n: usize) -> *u8;
extern fn realloc(p: *u8, n: usize) -> *u8;
extern fn free(p: *u8);
extern fn memcpy(dest: *u8, src: *u8, n: usize) -> *u8;
extern fn memmove(dest: *u8, src: *u8, n: usize) -> *u8;
extern fn memcmp(a: *u8, b: *u8, n: usize) -> i32;

// `#[lang("string")]` designates this struct as the compiler's owned-string
// type: a string literal in a `Text`-typed context (e.g. `let s: Text = "x";`)
// is lowered to a heap copy constructed as this `{ ptr, len, cap }` layout.
// The field order/shape below is load-bearing for that lowering.
#[lang("string")]
struct Text {
    _ptr: *u8,
    _len: usize,
    _cap: usize,
}

fn max_usize() -> usize {
    return (0 as usize) -% (1 as usize);
}

fn next_capacity(current: usize, required: usize) -> usize {
    if required <= current {
        return current;
    }
    var out: usize = current;
    if out == (0 as usize) {
        out = 1 as usize;
    }
    while out < required {
        if out > (max_usize() / (2 as usize)) {
            out = required;
        } else {
            out = out *% (2 as usize);
        }
    }
    return out;
}

// True if the `n` bytes at `needle` equal the `n` bytes of `hay` starting at
// byte offset `off`. The caller guarantees `off +% n <= hay length`.
fn region_matches(hay: *u8, off: usize, needle: *u8, n: usize) -> bool {
    if n == (0 as usize) {
        return true;
    }
    let a: *u8 = { hay + off };
    return { memcmp(a, needle, n) } == (0 as i32);
}

// FNV-1a over the `n` bytes at `p`. The single hash core behind both
// `Text::hash` and the `str`-keyed `hash_str` below, so a `Text` key and an
// equal `str` lookup always land in the same bucket (see `stdlib/string_map`).
// `n == 0` returns the FNV offset basis without dereferencing `p` (which may be
// null for an empty Text).
fn hash_bytes(p: *u8, n: usize) -> u64 {
    var h: u64 = 14695981039346656037 as u64;
    var i: usize = 0 as usize;
    while i < n {
        let b: u8 = { p[i] };
        h = (h ^ (b as u64)) *% (1099511628211 as u64);
        i = i +% (1 as usize);
    }
    return h;
}

// FNV-1a hash of a `str`'s bytes, in the same domain as `Text::hash`. This is
// the lookup-side hash a `Text`-keyed map uses when queried by a `str` key.
fn hash_str(s: str) -> u64 {
    return hash_bytes({ #str_ptr(s) }, #str_len(s));
}

fn new() -> Text {
    return Text {
        _ptr: { 0 as *u8 },
        _len: 0 as usize,
        _cap: 0 as usize,
    };
}

// Pre-allocate room for at least `minimum` bytes. A value producer, so it
// recovers rather than reports: if the allocation fails it returns a valid empty
// Text (capacity 0) instead of trapping. A later `append` retries and surfaces
// the failure as a `Status`.
fn with_capacity(minimum: usize) -> Text {
    if minimum == (0 as usize) {
        return new();
    }
    let raw: *u8 = { malloc(minimum) };
    if raw.is_not_null() {
        return Text {
            _ptr: raw,
            _len: 0 as usize,
            _cap: minimum,
        };
    }
    return new();
}

fn from_str(s: str) -> Text {
    let n: usize = #str_len(s);
    var t: Text = with_capacity(n);
    t.append(s);
    return t;
}

// A new Text made of `s` repeated `count` times (Swift's String(repeating:count:)).
fn repeating(s: str, count: usize) -> Text {
    var t: Text = new();
    var i: usize = 0 as usize;
    while i < count {
        t.append(s);
        i = i +% (1 as usize);
    }
    return t;
}

// Well-formed UTF-8 check over `len` bytes at `p` (Unicode 15 Table 3-7):
// rejects overlong encodings, UTF-16 surrogates (U+D800..U+DFFF), code points
// above U+10FFFF, and stray/truncated continuation bytes. Empty input is valid.
// The lead byte fixes the sequence length and the tightened range of the first
// continuation byte; the rest are the plain 0x80..0xBF range.
fn is_utf8(p: *u8, len: usize) -> bool {
    var i: usize = 0 as usize;
    while i < len {
        let b0: u8 = { *(p + i) };
        if b0 < (0x80 as u8) {
            // ASCII.
            i = i +% (1 as usize);
        } else if b0 >= (0xC2 as u8) && b0 <= (0xDF as u8) {
            // 2-byte: C2..DF 80..BF.
            if (i +% (1 as usize)) >= len { return false; }
            let b1: u8 = { *(p + (i +% (1 as usize))) };
            if b1 < (0x80 as u8) || b1 > (0xBF as u8) { return false; }
            i = i +% (2 as usize);
        } else if b0 >= (0xE0 as u8) && b0 <= (0xEF as u8) {
            // 3-byte: E0 A0..BF | E1..EC 80..BF | ED 80..9F | EE..EF 80..BF.
            if (i +% (2 as usize)) >= len { return false; }
            let b1: u8 = { *(p + (i +% (1 as usize))) };
            let b2: u8 = { *(p + (i +% (2 as usize))) };
            var lo1: u8 = 0x80 as u8;
            var hi1: u8 = 0xBF as u8;
            if b0 == (0xE0 as u8) { lo1 = 0xA0 as u8; }
            if b0 == (0xED as u8) { hi1 = 0x9F as u8; }
            if b1 < lo1 || b1 > hi1 { return false; }
            if b2 < (0x80 as u8) || b2 > (0xBF as u8) { return false; }
            i = i +% (3 as usize);
        } else if b0 >= (0xF0 as u8) && b0 <= (0xF4 as u8) {
            // 4-byte: F0 90..BF | F1..F3 80..BF | F4 80..8F, then 80..BF 80..BF.
            if (i +% (3 as usize)) >= len { return false; }
            let b1: u8 = { *(p + (i +% (1 as usize))) };
            let b2: u8 = { *(p + (i +% (2 as usize))) };
            let b3: u8 = { *(p + (i +% (3 as usize))) };
            var lo1: u8 = 0x80 as u8;
            var hi1: u8 = 0xBF as u8;
            if b0 == (0xF0 as u8) { lo1 = 0x90 as u8; }
            if b0 == (0xF4 as u8) { hi1 = 0x8F as u8; }
            if b1 < lo1 || b1 > hi1 { return false; }
            if b2 < (0x80 as u8) || b2 > (0xBF as u8) { return false; }
            if b3 < (0x80 as u8) || b3 > (0xBF as u8) { return false; }
            i = i +% (4 as usize);
        } else {
            // 0x80..0xC1 (bare continuation or overlong 2-byte lead) or 0xF5..0xFF.
            return false;
        }
    }
    return true;
}

// Build an owned Text from UTF-8 `bytes`, validating first: `None` if the bytes
// are not well-formed UTF-8. Consumes `bytes` (they drop on return); the result
// is a fresh copy, so the caller's buffer is freed either way. This is the tidy
// `Vec[u8] -> Text` bridge — read a file with `fs::File::read_to_end` (or use
// `fs::read_to_string` directly) and feed the bytes to a parser as a Text.
fn from_utf8(take bytes: vec::Vec[u8]) -> option::Option[Text] {
    let view: str = bytes.as_byte_view();
    if !is_utf8({ #str_ptr(view) }, #str_len(view)) {
        return option::Option[Text]::None;
    }
    return option::Option[Text]::Some(from_str(view));
}

// Glue the pieces of `parts` back into one Text with `separator` between each
// pair — the inverse of `Text::split`, so `join(s.split(separator: sep),
// separator: sep)` reproduces `s`. The separator goes *between* pieces only,
// never before the first or after the last, so a leading/trailing empty piece
// still contributes its separator (`join(["", "", ""], separator: ",")` →
// `",,"`). The default separator is empty, making `join(parts)` a plain
// concatenation (Swift `Array.joined()` / `joined(separator:)`). Each piece is
// read in place and its bytes copied; `parts` is left untouched.
fn join(parts: vec::Vec[Text], separator: str = "") -> Text {
    var out: Text = new();
    var i: usize = 0 as usize;
    while i < parts.count() {
        if i != (0 as usize) {
            out.append(separator);
        }
        match parts.at_ptr(i) {
            option::Option[*Text]::Some(p) => { out.append({ *p }.view()); }
            option::Option[*Text]::None => { }
        }
        i = i +% (1 as usize);
    }
    return out;
}

impl Text {
    // Grow the buffer to at least `new_cap` bytes. Returns `OutOfMemory` (Text
    // unchanged and valid) if `realloc` fails, `Ok` otherwise.
    fn grow_to(ref this, new_cap: usize) -> status::Status {
        if new_cap <= this._cap {
            return status::Status::Ok;
        }
        let raw: *u8 = { realloc(this._ptr, new_cap) };
        if raw.is_not_null() {
            this._ptr = raw;
            this._cap = new_cap;
            return status::Status::Ok;
        }
        return status::Status::OutOfMemory;
    }

    fn count(this) -> usize {
        return this._len;
    }

    fn capacity(this) -> usize {
        return this._cap;
    }

    fn is_empty(this) -> bool {
        return this._len == (0 as usize);
    }

    // A `str` view of this Text's content (no allocation; aliases the buffer).
    fn view(this) -> str {
        if this._len == (0 as usize) {
            return "";
        }
        return { #str_from_raw_parts(this._ptr, this._len) };
    }

    // Ensure room for `additional` more bytes. Returns `OutOfMemory` (Text
    // unchanged) if the new length would overflow `usize` or the allocation
    // fails, `Ok` otherwise.
    fn reserve(ref this, additional: usize) -> status::Status {
        if additional > (max_usize() -% this._len) {
            return status::Status::OutOfMemory;
        }
        let required: usize = this._len +% additional;
        if required <= this._cap {
            return status::Status::Ok;
        }
        return this.grow_to(next_capacity(this._cap, required));
    }

    // Append `s` to the end. Returns `Ok` on success. If the buffer cannot grow
    // it returns `OutOfMemory` and leaves the Text exactly as it was (the append
    // is all-or-nothing). The caller may check the status or ignore it.
    fn append(ref this, s: str) -> status::Status {
        let n: usize = #str_len(s);
        if n == (0 as usize) {
            return status::Status::Ok;
        }
        let st: status::Status = this.reserve(n);
        if st != status::Status::Ok {
            return st;
        }
        let src: *u8 = #str_ptr(s);
        let dest: *u8 = { this._ptr + this._len };
        { memcpy(dest, src, n); }
        this._len = this._len +% n;
        return status::Status::Ok;
    }

    fn remove_all(ref this) {
        this._len = 0 as usize;
        return;
    }

    fn truncate(ref this, to: usize) {
        if to < this._len {
            this._len = to;
        }
        return;
    }

    // Insert `s` at byte offset `at`, shifting the bytes at/after `at` to the
    // right. `at == count` appends. Returns `OutOfBounds` (no change) if `at`
    // is past the end, `OutOfMemory` (no change) if the buffer cannot grow, and
    // `Ok` otherwise. `at` is a byte offset — inserting in the middle of a
    // multibyte scalar produces invalid UTF-8, so split on scalar boundaries.
    fn insert(ref this, s: str, at: usize) -> status::Status {
        if at > this._len {
            return status::Status::OutOfBounds;
        }
        let n: usize = #str_len(s);
        if n == (0 as usize) {
            return status::Status::Ok;
        }
        let st: status::Status = this.reserve(n);
        if st != status::Status::Ok {
            return st;
        }
        // Open a gap: slide the `tail` bytes at `at` up by `n` (regions overlap,
        // so memmove), then copy `s` into the gap.
        let tail: usize = this._len -% at;
        let gap_at: *u8 = { this._ptr + at };
        if tail != (0 as usize) {
            let dest: *u8 = { gap_at + n };
            { memmove(dest, gap_at, tail); }
        }
        { memcpy(gap_at, #str_ptr(s), n); }
        this._len = this._len +% n;
        return status::Status::Ok;
    }

    // Remove the byte range `[from, to)`, sliding the tail left to close the
    // gap. Returns `OutOfBounds` (no change) if the range is inverted
    // (`from > to`) or past the end (`to > count`), `Ok` otherwise. An empty
    // range (`from == to`) is a no-op `Ok`. Byte offsets: cutting through a
    // multibyte scalar produces invalid UTF-8.
    fn remove_range(ref this, from: usize, to: usize) -> status::Status {
        if from > to || to > this._len {
            return status::Status::OutOfBounds;
        }
        let cut: usize = to -% from;
        if cut == (0 as usize) {
            return status::Status::Ok;
        }
        let tail: usize = this._len -% to;
        if tail != (0 as usize) {
            let dest: *u8 = { this._ptr + from };
            let src: *u8 = { this._ptr + to };
            { memmove(dest, src, tail); }
        }
        this._len = this._len -% cut;
        return status::Status::Ok;
    }

    // Owned deep copy. If the allocation fails the copy is empty (best effort);
    // the `t._cap >= this._len` guard keeps the memcpy from writing through the
    // null buffer that `with_capacity` hands back on failure.
    fn clone(this) -> Text {
        var t: Text = with_capacity(this._len);
        if this._len != (0 as usize) && t._cap >= this._len {
            { memcpy(t._ptr, this._ptr, this._len); }
            t._len = this._len;
        }
        return t;
    }

    fn has_prefix(this, prefix: str) -> bool {
        return this.view().has_prefix(prefix);
    }

    fn has_suffix(this, suffix: str) -> bool {
        return this.view().has_suffix(suffix);
    }

    // Byte offset of the first occurrence of `needle`, or None. An empty
    // needle matches at 0.
    fn find(this, needle: str) -> option::Option[usize] {
        return this.view().find(needle);
    }

    fn contains(this, needle: str) -> bool {
        return this.view().contains(needle);
    }

    // Byte offset of the *last* occurrence of `needle`, or None. An empty needle
    // matches at `len`.
    fn rfind(this, needle: str) -> option::Option[usize] {
        return this.view().rfind(needle);
    }

    // Safe, bounds-checked byte read: the byte at `i`, or None if `i >= len`.
    // This is the public read door — it can never read out of bounds. Internal
    // callers that have already proven `i < len` (loop bodies below) use the
    // unchecked `_byte_at_raw` directly to skip the redundant check.
    fn byte_at(this, index: usize) -> option::Option[u8] {
        return this.view().byte_at(index: index);
    }

    // Unchecked byte read — caller guarantees `i < len`. Module-private (the
    // leading `_`): reading past `len` is out-of-bounds memory access, so this
    // is never exposed. Public callers use the bounds-checked `byte_at` instead.
    fn _byte_at_raw(this, i: usize) -> u8 {
        let p: *u8 = { this._ptr + i };
        return { *p };
    }

    // Owned copy of the byte range `[start, end)`. Module-private (the leading
    // `_`): the caller must guarantee the range is in bounds and `start <= end`
    // (an inverted range wraps to a huge length). The public, bounds-checked
    // door is `slice`, which returns None for an invalid range.
    fn _copy_range(this, start: usize, end: usize) -> Text {
        let n: usize = end -% start;
        var t: Text = with_capacity(n);
        if n != (0 as usize) && t._cap >= n {
            let src: *u8 = { this._ptr + start };
            { memcpy(t._ptr, src, n); }
            t._len = n;
        }
        return t;
    }

    // Owned copy of the byte range `[from, to)`, or None if out of bounds /
    // inverted. (Copies — the result owns its bytes.) e.g. `t.slice(from: 2, to: 5)`.
    fn slice(this, from: usize, to: usize) -> option::Option[Text] {
        match this.view().slice(from: from, to: to) {
            option::Option[str]::Some(s) => {
                return option::Option[Text]::Some(s.to_text());
            }
            option::Option[str]::None => {
                return option::Option[Text]::None;
            }
        }
        return option::Option[Text]::None;
    }

    // Owned copy with leading ASCII whitespace removed.
    fn trim_start(this) -> Text {
        return this.view().trim_start().to_text();
    }

    // Owned copy with trailing ASCII whitespace removed.
    fn trim_end(this) -> Text {
        return this.view().trim_end().to_text();
    }

    // Owned copy with leading and trailing ASCII whitespace removed.
    fn trim(this) -> Text {
        return this.view().trim().to_text();
    }

    // ASCII-lowercased owned copy (`A`–`Z` → `a`–`z`; other bytes unchanged).
    fn lowercased(this) -> Text {
        var t: Text = this.clone();
        var i: usize = 0 as usize;
        while i < t._len {
            let p: *u8 = { t._ptr + i };
            let b: u8 = { *p };
            if b >= (65 as u8) && b <= (90 as u8) {
                { *p = b +% (32 as u8); }
            }
            i = i +% (1 as usize);
        }
        return t;
    }

    // ASCII-uppercased owned copy (`a`–`z` → `A`–`Z`; other bytes unchanged).
    fn uppercased(this) -> Text {
        var t: Text = this.clone();
        var i: usize = 0 as usize;
        while i < t._len {
            let p: *u8 = { t._ptr + i };
            let b: u8 = { *p };
            if b >= (97 as u8) && b <= (122 as u8) {
                { *p = b -% (32 as u8); }
            }
            i = i +% (1 as usize);
        }
        return t;
    }

    // Owned copy with only the FIRST byte ASCII-uppercased (`a`–`z` → `A`–`Z`);
    // every other byte is left as-is. The "capitalize first letter" helper:
    // `"hello world"` → `"Hello world"`. An empty Text yields an empty copy.
    fn uppercased_first(this) -> Text {
        var t: Text = this.clone();
        if t._len != (0 as usize) {
            let p: *u8 = { t._ptr + (0 as usize) };
            let b: u8 = { *p };
            if b >= (97 as u8) && b <= (122 as u8) {
                { *p = b -% (32 as u8); }
            }
        }
        return t;
    }

    // Owned copy with only the FIRST byte ASCII-lowercased (`A`–`Z` → `a`–`z`);
    // every other byte is left as-is. The mirror of `uppercased_first`:
    // `"Hello World"` → `"hello World"`. An empty Text yields an empty copy.
    fn lowercased_first(this) -> Text {
        var t: Text = this.clone();
        if t._len != (0 as usize) {
            let p: *u8 = { t._ptr + (0 as usize) };
            let b: u8 = { *p };
            if b >= (65 as u8) && b <= (90 as u8) {
                { *p = b +% (32 as u8); }
            }
        }
        return t;
    }

    // Split on every (non-overlapping) occurrence of `separator`, returning the
    // pieces as owned `Text` values. An empty separator yields the whole string
    // as one piece. `"a,b,c".split(separator: ",")` → `["a", "b", "c"]`.
    fn split(this, separator: str) -> vec::Vec[Text] {
        var out: vec::Vec[Text] = vec::new::[Text]();
        let n: usize = #str_len(separator);
        if n == (0 as usize) {
            out.append(this._copy_range(0 as usize, this._len));
            return out;
        }
        let p: *u8 = #str_ptr(separator);
        var start: usize = 0 as usize;
        var i: usize = 0 as usize;
        while (i +% n) <= this._len {
            if region_matches(this._ptr, i, p, n) {
                out.append(this._copy_range(start, i));
                i = i +% n;
                start = i;
            } else {
                i = i +% (1 as usize);
            }
        }
        out.append(this._copy_range(start, this._len));
        return out;
    }

    // ── Borrowed from Swift String: non-mutating substring + query helpers ──
    // All return owned `Text` (the caller owns the bytes) or a plain value; none
    // alias `this`, and the out-of-range cases clamp instead of trapping.

    // Owned copy of the first `count` bytes — the whole string if it is shorter.
    // Swift's `String.prefix(_:)`. Never traps.
    fn prefix(this, count: usize) -> Text {
        return this.view().prefix(count: count).to_text();
    }

    // Owned copy of the last `count` bytes — the whole string if it is shorter.
    // Swift's `String.suffix(_:)`.
    fn suffix(this, count: usize) -> Text {
        return this.view().suffix(count: count).to_text();
    }

    // Owned copy with the first `count` bytes dropped (Swift `dropFirst`,
    // which defaults to 1).
    fn drop_first(this, count: usize = 1) -> Text {
        return this.view().drop_first(count: count).to_text();
    }

    // Owned copy with the last `count` bytes dropped (Swift `dropLast`,
    // which defaults to 1).
    fn drop_last(this, count: usize = 1) -> Text {
        return this.view().drop_last(count: count).to_text();
    }

    // Owned copy with `s` appended — non-mutating, leaving `this` untouched.
    // C+ has no `+` operator overloading, so this is the value-style concat.
    fn appending(this, s: str) -> Text {
        var t: Text = this.clone();
        t.append(s);
        return t;
    }

    // True when this text's bytes equal `other` exactly (Swift `==`).
    fn equals(this, other: str) -> bool {
        return this.view() == other;
    }

    // True when every byte is ASCII (< 128). Mirrors Swift `String.isASCII`.
    fn is_ascii(this) -> bool {
        return this.view().is_ascii();
    }

    // Count of non-overlapping occurrences of `needle`. An empty needle is 0.
    fn count_of(this, needle: str) -> usize {
        return this.view().count_of(needle);
    }

    // Owned copy with every (non-overlapping) occurrence of `of` replaced by
    // `with` (Swift `replacingOccurrences(of:with:)`). An empty `of` is a no-op
    // copy. e.g. `t.replacing(of: ",", with: "; ")`.
    fn replacing(this, of: str, with: str) -> Text {
        let n: usize = #str_len(of);
        if n == (0 as usize) {
            return this.clone();
        }
        var out: Text = new();
        let p: *u8 = #str_ptr(of);
        var start: usize = 0 as usize;
        var i: usize = 0 as usize;
        while (i +% n) <= this._len {
            if region_matches(this._ptr, i, p, n) {
                out.append(this._copy_range(start, i));
                out.append(with);
                i = i +% n;
                start = i;
            } else {
                i = i +% (1 as usize);
            }
        }
        out.append(this._copy_range(start, this._len));
        return out;
    }

    // Count of Unicode scalars (not bytes). `count` returns the byte length;
    // this returns the number of encoded scalars by counting every byte that is
    // not a UTF-8 continuation byte (0x80–0xBF). For all-ASCII text the two
    // agree. Assumes well-formed UTF-8 (see `from_utf8`).
    fn char_count(this) -> usize {
        return this.view().char_count();
    }

    // Lexicographic byte comparison (unsigned): `-1` if `this` sorts before
    // `other`, `1` if after, `0` if equal. Shorter is less when one is a prefix
    // of the other. The ordering primitive for sorting Texts (`strcmp` /
    // `compareTo`); `equals` is the equality-only fast path.
    fn compare(this, other: str) -> i32 {
        return this.view().compare(other);
    }

    // ASCII case-insensitive equality: like `equals` but treating `A`–`Z` and
    // `a`–`z` as the same letter. Non-letter bytes must still match exactly.
    // (ASCII only — no Unicode case folding.)
    fn equals_ignoring_case(this, other: str) -> bool {
        return this.view().equals_ignoring_case(other);
    }

    // Owned copy with `prefix` removed from the front if present; an unchanged
    // copy otherwise (Rust `strip_prefix`, non-trapping). An empty prefix is a
    // plain copy.
    fn removing_prefix(this, prefix: str) -> Text {
        return this.view().removing_prefix(prefix).to_text();
    }

    // Owned copy with `suffix` removed from the end if present; an unchanged
    // copy otherwise (Rust `strip_suffix`). An empty suffix is a plain copy.
    fn removing_suffix(this, suffix: str) -> Text {
        return this.view().removing_suffix(suffix).to_text();
    }

    // Owned copy left-padded with `with` (a space by default) until it is at
    // least `to` bytes long (JS `padStart`, Python `rjust`). If already `>= to`
    // bytes, or `with` is empty, returns a plain copy. A multi-byte `with` is
    // repeated and the padding is cut to hit `to` exactly, so it can end
    // mid-pattern.
    fn pad_start(this, to: usize, with: str = " ") -> Text {
        if this._len >= to || #str_len(with) == (0 as usize) {
            return this.clone();
        }
        let deficit: usize = to -% this._len;
        var out: Text = with_capacity(to);
        while out._len < deficit {
            out.append(with);
        }
        out.truncate(deficit);
        out.append(this.view());
        return out;
    }

    // Owned copy right-padded with `with` (a space by default) until it is at
    // least `to` bytes long (JS `padEnd`, Python `ljust`). If already `>= to`
    // bytes, or `with` is empty, returns a plain copy. `with` is repeated and
    // cut to hit `to`.
    fn pad_end(this, to: usize, with: str = " ") -> Text {
        if this._len >= to || #str_len(with) == (0 as usize) {
            return this.clone();
        }
        var out: Text = with_capacity(to);
        out.append(this.view());
        while out._len < to {
            out.append(with);
        }
        out.truncate(to);
        return out;
    }

    // Build a C string (owned, NUL-terminated) for passing to a C function.
    // Returns None if the text contains an interior NUL byte (a C string can't
    // represent one) or if the allocation fails — either way no CString is
    // produced and nothing is trapped. The returned `CString` owns its buffer
    // and frees it on drop; pass `cs.as_ptr()` to the `extern fn` and keep `cs`
    // alive across the call. Length-based C APIs don't need this — pass the
    // `str` view's ptr+len.
    fn c_str(this) -> option::Option[CString] {
        var i: usize = 0 as usize;
        while i < this._len {
            if this._byte_at_raw(i) == (0 as u8) {
                return option::Option[CString]::None;
            }
            i = i +% (1 as usize);
        }
        let buf: *u8 = { malloc(this._len +% (1 as usize)) };
        if buf.is_null() {
            return option::Option[CString]::None;
        }
        if this._len != (0 as usize) {
            { memcpy(buf, this._ptr, this._len); }
        }
        let term: *u8 = { buf + this._len };
        { *term = 0 as u8; }
        return option::Option[CString]::Some(CString { _ptr: buf, _len: this._len });
    }

    fn drop(ref this) {
        if this._ptr.is_not_null() {
            { free(this._ptr); }
        }
        return;
    }
}

// Byte-exact value equality and a content hash. Together these make `Text` a
// usable associative-container key (see `stdlib/string_map`), the role `str`
// already fills for `HashMap`. Both borrow their receiver (and `eq` borrows its
// argument): neither moves nor drops a `Text`, so they are safe to call on keys
// that stay live inside a table.
impl Text: Eq {
    // True iff `this` and `other` hold the same bytes. Length is checked first
    // so the `memcmp` only runs on equal-length buffers; two empty Texts (which
    // may hold null `_ptr`s) compare equal without dereferencing.
    fn eq(this, other: Text) -> bool {
        if this._len != other._len {
            return false;
        }
        if this._len == (0 as usize) {
            return true;
        }
        return { memcmp(this._ptr, other._ptr, this._len) } == (0 as i32);
    }
}

impl Text: Hash {
    // FNV-1a over the raw bytes. Deterministic and allocation-free. The only
    // contract a map relies on is hash/eq agreement: equal Texts (same bytes)
    // produce the same hash. Shares its core with the free `hash_str`, so a
    // `Text` key and an equal `str` lookup hash identically. The empty Text
    // hashes to the FNV offset basis.
    fn hash(this) -> u64 {
        return hash_bytes(this._ptr, this._len);
    }
}

// `Text` owns its heap buffer outright (no shared/aliased state, no interior
// mutability), so moving it to another thread (`Send`) and sharing `&Text`
// across threads (`Sync`) are both sound — like Rust's `String`. The
// raw-pointer field makes it `!Send`/`!Sync` by default; these markers opt in.
// `Send` is needed for `thread::spawn` payloads; `Send + Sync` for `Arc[Text]`.
impl Text: Send {}
impl Text: Sync {}

// An owned, NUL-terminated C string — the bridge to `extern fn`s that take a
// `const char*`. The buffer is `len + 1` bytes (the trailing NUL is not counted
// in `len`). Owns its buffer; frees it on drop. Build one with `Text::c_str`.
struct CString {
    _ptr: *u8,
    _len: usize,
}

impl CString {
    // The raw `*u8` the C ABI wants. Valid only while this `CString` is alive.
    fn as_ptr(this) -> *u8 {
        return this._ptr;
    }

    // Length in bytes, NOT counting the trailing NUL.
    fn count(this) -> usize {
        return this._len;
    }

    fn drop(ref this) {
        if this._ptr.is_not_null() {
            { free(this._ptr); }
        }
        return;
    }
}

// ─────────────────────────── intern table ───────────────────────────
// A process-lifetime string table. `intern(s)` copies `s`'s bytes into the
// table (once per distinct string) and returns a view of the table's copy.
// The table is never freed, so the returned `str` is valid for the rest of
// the process: it can sit in a set-once `str` field (a widget key, a label)
// with no tie to the argument's owner. Equal strings intern to the SAME
// bytes, so comparing two interned keys can be a pointer compare.
//
// `#[keeps(nothing)]` is the declared summary (memory-model contract §5):
// the returned view borrows no argument — without it the checker's
// conservative tie would pin the argument's owner for the view's lifetime,
// which is exactly what interning exists to avoid.
//
// Not thread-safe: intern from one thread (keys are built on the UI/main
// thread). Node layout: { next: *u8 @0, hash: u64 @8, len: usize @16,
// bytes @24 }, singly linked, newest first; lookup compares hash, then
// length, then bytes.

static INTERN_HEAD: *u8 = 0 as *u8;

#[keeps(nothing)]
fn intern(s: str) -> str {
    let n: usize = #str_len(s);
    if n == (0 as usize) {
        return "";
    }
    let h: u64 = hash_str(s);
    var node: *u8 = INTERN_HEAD;
    while node.is_not_null() {
        let node_hash: u64 = { *((node + (8 as usize)) as *u64) };
        let node_len: usize = { *((node + (16 as usize)) as *usize) };
        if node_hash == h {
            if node_len == n {
                let bytes: *u8 = { node + (24 as usize) };
                if region_matches(bytes, 0 as usize, { #str_ptr(s) }, n) {
                    return { #str_from_raw_parts(bytes, node_len) };
                }
            }
        }
        node = { *(node as **u8) };
    }
    let raw: *u8 = { malloc((24 as usize) +% n) };
    if raw.is_null() {
        // Allocation failure: a value producer recovers — the empty view is
        // always valid. The caller sees a missing key, not a trap.
        return "";
    }
    {
        *(raw as **u8) = INTERN_HEAD;
        *((raw + (8 as usize)) as *u64) = h;
        *((raw + (16 as usize)) as *usize) = n;
        memcpy(raw + (24 as usize), #str_ptr(s), n);
        INTERN_HEAD = raw;
    }
    return { #str_from_raw_parts(raw + (24 as usize), n) };
}

// ───────────────────────────── tests ─────────────────────────────
// Package unit tests for Text. Run standalone (no e2e):
//     cd vendor/stdlib && cpc test

#[test]
fn text_new_is_empty() {
    let t: Text = new();
    assert t.count() == (0 as usize);
    assert t.is_empty();
}

#[test]
fn text_from_str_basics() {
    let t: Text = from_str("hello");
    assert t.count() == (5 as usize);
    assert t.is_empty() == false;
    assert t.equals("hello");
}

#[test]
fn text_lang_string_literal_lowering() {
    // `#[lang("string")]`: a literal in a Text-typed context lowers to an owned
    // heap Text built by field POSITION. Guards the `_ptr/_len/_cap` rename
    // against the position-based lowering in codegen.
    let t: Text = "hello";
    assert t.count() == (5 as usize);
    assert t.equals("hello");
}

#[test]
fn text_append_concats_and_grows() {
    var t: Text = from_str("foo");
    let st: status::Status = t.append("bar");
    assert st == status::Status::Ok;
    assert t.count() == (6 as usize);
    assert t.equals("foobar");
}

#[test]
fn text_append_empty_is_noop_ok() {
    var t: Text = from_str("x");
    let st: status::Status = t.append("");
    assert st == status::Status::Ok;
    assert t.count() == (1 as usize);
}

#[test]
fn text_reserve_grows_capacity_not_count() {
    var t: Text = new();
    let st: status::Status = t.reserve(16 as usize);
    assert st == status::Status::Ok;
    assert t.capacity() >= (16 as usize);
    assert t.count() == (0 as usize);
}

#[test]
fn text_remove_all_clears_len_keeps_cap() {
    var t: Text = from_str("abcdef");
    let cap: usize = t.capacity();
    t.remove_all();
    assert t.count() == (0 as usize);
    assert t.is_empty();
    assert t.capacity() == cap;
}

#[test]
fn text_truncate_shortens() {
    var t: Text = from_str("abcdef");
    t.truncate(3 as usize);
    assert t.equals("abc");
}

#[test]
fn text_truncate_beyond_len_is_noop() {
    var t: Text = from_str("abc");
    t.truncate(99 as usize);
    assert t.equals("abc");
}

#[test]
fn text_clone_is_independent() {
    let a: Text = from_str("hello");
    var b: Text = a.clone();
    b.append("!");
    assert a.equals("hello");
    assert b.equals("hello!");
}

#[test]
fn text_has_prefix_suffix() {
    let t: Text = from_str("hello world");
    assert t.has_prefix("hello");
    assert t.has_prefix("world") == false;
    assert t.has_suffix("world");
    assert t.has_suffix("hello") == false;
    assert t.has_prefix("");
}

#[test]
fn text_contains() {
    let t: Text = from_str("hello world");
    assert t.contains("o w");
    assert t.contains("xyz") == false;
}

#[test]
fn text_find_first_offset() {
    let t: Text = from_str("abcabc");
    match t.find("bc") {
        option::Option[usize]::Some(i) => { assert i == (1 as usize); }
        option::Option[usize]::None => { assert false; }
    }
    match t.find("zz") {
        option::Option[usize]::Some(i) => { assert false; }
        option::Option[usize]::None => { assert true; }
    }
    return;
}

#[test]
fn text_rfind_last_offset() {
    let t: Text = from_str("abcabc");
    match t.rfind("bc") {
        option::Option[usize]::Some(i) => { assert i == (4 as usize); }
        option::Option[usize]::None => { assert false; }
    }
    return;
}

#[test]
fn text_byte_at_in_and_out_of_bounds() {
    let t: Text = from_str("AB");
    match t.byte_at(index: 0 as usize) {
        option::Option[u8]::Some(b) => { assert b == (65 as u8); }
        option::Option[u8]::None => { assert false; }
    }
    match t.byte_at(index: 9 as usize) {
        option::Option[u8]::Some(b) => { assert false; }
        option::Option[u8]::None => { assert true; }
    }
    return;
}

#[test]
fn text_slice_copies_range() {
    let t: Text = from_str("hello");
    match t.slice(from: 1 as usize, to: 4 as usize) {
        option::Option[Text]::Some(s) => { assert s.equals("ell"); }
        option::Option[Text]::None => { assert false; }
    }
    return;
}

#[test]
fn text_slice_out_of_bounds_is_none() {
    let t: Text = from_str("hi");
    match t.slice(from: 0 as usize, to: 9 as usize) {
        option::Option[Text]::Some(s) => { assert false; }
        option::Option[Text]::None => { assert true; }
    }
    return;
}

#[test]
fn text_slice_inverted_is_none() {
    let t: Text = from_str("hello");
    match t.slice(from: 4 as usize, to: 1 as usize) {
        option::Option[Text]::Some(s) => { assert false; }
        option::Option[Text]::None => { assert true; }
    }
    return;
}

#[test]
fn text_trim_variants() {
    let a: Text = from_str("  hi  ");
    assert a.trim().equals("hi");
    assert a.trim_start().equals("hi  ");
    assert a.trim_end().equals("  hi");
}

#[test]
fn text_lowercased_uppercased() {
    let t: Text = from_str("Hello, World!");
    assert t.lowercased().equals("hello, world!");
    assert t.uppercased().equals("HELLO, WORLD!");
}

#[test]
fn text_uppercased_first_capitalizes_leading_letter_only() {
    assert from_str("hello world").uppercased_first().equals("Hello world");
    // Already-uppercase leading byte is unchanged; the rest is never touched.
    assert from_str("HELLO").uppercased_first().equals("HELLO");
    // A non-letter leading byte is left as-is (no shift into the alphabet).
    assert from_str("1st").uppercased_first().equals("1st");
}

#[test]
fn text_lowercased_first_lowers_leading_letter_only() {
    assert from_str("Hello World").lowercased_first().equals("hello World");
    assert from_str("hello").lowercased_first().equals("hello");
    assert from_str("_X").lowercased_first().equals("_X");
}

#[test]
fn text_cased_first_on_empty_is_empty() {
    assert from_str("").uppercased_first().is_empty();
    assert from_str("").lowercased_first().is_empty();
}

#[test]
fn text_cased_first_is_nonmutating() {
    let t: Text = from_str("hello");
    assert t.uppercased_first().equals("Hello");
    // The receiver is untouched — the helper returns an owned copy.
    assert t.equals("hello");
}

// ── insert / remove_range (mutating buffer edits) ──

#[test]
fn text_insert_in_the_middle_shifts_the_tail() {
    var t: Text = from_str("hello");
    let st: status::Status = t.insert("XY", at: 2 as usize);
    assert st == status::Status::Ok;
    assert t.equals("heXYllo");
}

#[test]
fn text_insert_at_zero_prepends() {
    var t: Text = from_str("bc");
    let st: status::Status = t.insert("a", at: 0 as usize);
    assert st == status::Status::Ok;
    assert t.equals("abc");
}

#[test]
fn text_insert_at_count_appends() {
    var t: Text = from_str("ab");
    let st: status::Status = t.insert("c", at: 2 as usize);
    assert st == status::Status::Ok;
    assert t.equals("abc");
}

#[test]
fn text_insert_past_end_is_out_of_bounds_no_change() {
    var t: Text = from_str("ab");
    let st: status::Status = t.insert("x", at: 9 as usize);
    assert st == status::Status::OutOfBounds;
    assert t.equals("ab");
}

#[test]
fn text_insert_empty_is_noop_ok() {
    var t: Text = from_str("ab");
    let st: status::Status = t.insert("", at: 1 as usize);
    assert st == status::Status::Ok;
    assert t.equals("ab");
}

#[test]
fn text_remove_range_cuts_the_span() {
    var t: Text = from_str("hello world");
    let st: status::Status = t.remove_range(from: 5 as usize, to: 11 as usize);
    assert st == status::Status::Ok;
    assert t.equals("hello");
}

#[test]
fn text_remove_range_full_empties() {
    var t: Text = from_str("abc");
    let st: status::Status = t.remove_range(from: 0 as usize, to: 3 as usize);
    assert st == status::Status::Ok;
    assert t.is_empty();
}

#[test]
fn text_remove_range_empty_span_is_noop_ok() {
    var t: Text = from_str("abc");
    let st: status::Status = t.remove_range(from: 2 as usize, to: 2 as usize);
    assert st == status::Status::Ok;
    assert t.equals("abc");
}

#[test]
fn text_remove_range_inverted_is_out_of_bounds_no_change() {
    var t: Text = from_str("abcde");
    let st: status::Status = t.remove_range(from: 4 as usize, to: 1 as usize);
    assert st == status::Status::OutOfBounds;
    assert t.equals("abcde");
}

#[test]
fn text_remove_range_past_end_is_out_of_bounds_no_change() {
    var t: Text = from_str("abc");
    let st: status::Status = t.remove_range(from: 0 as usize, to: 99 as usize);
    assert st == status::Status::OutOfBounds;
    assert t.equals("abc");
}

// ── compare / equals_ignoring_case ──

#[test]
fn text_compare_orders_lexicographically() {
    assert from_str("abc").compare("abd") == (-1 as i32);
    assert from_str("abd").compare("abc") == (1 as i32);
    assert from_str("abc").compare("abc") == (0 as i32);
}

#[test]
fn text_compare_shorter_prefix_is_less() {
    assert from_str("ab").compare("abc") == (-1 as i32);
    assert from_str("abc").compare("ab") == (1 as i32);
    assert from_str("").compare("a") == (-1 as i32);
    assert from_str("").compare("") == (0 as i32);
}

#[test]
fn text_equals_ignoring_case() {
    assert from_str("Hello").equals_ignoring_case("hELLO");
    assert from_str("a-b").equals_ignoring_case("A-B");
    assert from_str("Hello").equals_ignoring_case("world") == false;
    // Length mismatch is never equal.
    assert from_str("Hi").equals_ignoring_case("Hix") == false;
    // Non-letters must still match exactly ('.' vs ',').
    assert from_str("a.b").equals_ignoring_case("a,b") == false;
}

// ── removing_prefix / removing_suffix ──

#[test]
fn text_removing_prefix() {
    assert from_str("foobar").removing_prefix("foo").equals("bar");
    // Absent prefix → unchanged copy.
    assert from_str("foobar").removing_prefix("xyz").equals("foobar");
    // Empty prefix → plain copy.
    assert from_str("foo").removing_prefix("").equals("foo");
}

#[test]
fn text_removing_suffix() {
    assert from_str("foobar").removing_suffix("bar").equals("foo");
    assert from_str("foobar").removing_suffix("xyz").equals("foobar");
    assert from_str("foo").removing_suffix("").equals("foo");
}

// ── pad_start / pad_end ──

#[test]
fn text_pad_start_left_pads_to_width() {
    assert from_str("42").pad_start(to: 5 as usize, with: "0").equals("00042");
    // Default fill is a space.
    assert from_str("42").pad_start(to: 5 as usize).equals("   42");
    // A multi-byte fill is repeated then cut to hit the width exactly.
    assert from_str("x").pad_start(to: 4 as usize, with: "ab").equals("abax");
}

#[test]
fn text_pad_end_right_pads_to_width() {
    assert from_str("42").pad_end(to: 5 as usize, with: "0").equals("42000");
    assert from_str("42").pad_end(to: 5 as usize).equals("42   ");
}

#[test]
fn text_pad_already_at_width_is_plain_copy() {
    assert from_str("hello").pad_start(to: 3 as usize, with: "0").equals("hello");
    assert from_str("hello").pad_end(to: 3 as usize, with: "0").equals("hello");
    // Empty fill can't pad, so it's a plain copy even when short.
    assert from_str("ab").pad_start(to: 9 as usize, with: "").equals("ab");
}

// ── char_count (Unicode scalars vs bytes) ──

#[test]
fn text_char_count_matches_bytes_for_ascii() {
    let t: Text = from_str("hello");
    assert t.char_count() == (5 as usize);
    assert t.count() == (5 as usize);
}

#[test]
fn text_char_count_counts_scalars_not_bytes() {
    // "café" is 5 bytes (é = C3 A9) but 4 Unicode scalars.
    let t: Text = from_str("café");
    assert t.count() == (5 as usize);
    assert t.char_count() == (4 as usize);
}

#[test]
fn text_char_count_empty_is_zero() {
    assert from_str("").char_count() == (0 as usize);
}

#[test]
fn text_split_on_sep() {
    var parts: vec::Vec[Text] = from_str("a,bb,ccc").split(separator: ",");
    assert parts.count() == (3 as usize);
    match parts.remove_last() {
        option::Option[Text]::Some(last) => { assert last.equals("ccc"); }
        option::Option[Text]::None => { assert false; }
    }
    return;
}

#[test]
fn text_split_empty_sep_is_whole_string() {
    var parts: vec::Vec[Text] = from_str("abc").split(separator: "");
    assert parts.count() == (1 as usize);
}

#[test]
fn text_join_roundtrips_split() {
    var parts: vec::Vec[Text] = from_str("a,bb,ccc").split(separator: ",");
    let whole: Text = join(parts, separator: ",");
    assert whole.equals("a,bb,ccc");
}

#[test]
fn text_join_default_separator_concatenates() {
    var parts: vec::Vec[Text] = vec::new::[Text]();
    parts.append(from_str("foo"));
    parts.append(from_str("bar"));
    parts.append(from_str("baz"));
    assert join(parts).equals("foobarbaz");
}

#[test]
fn text_join_places_separator_between_pieces_only() {
    // Leading/trailing empty pieces still contribute their separators.
    var parts: vec::Vec[Text] = vec::new::[Text]();
    parts.append(from_str(""));
    parts.append(from_str(""));
    parts.append(from_str(""));
    assert join(parts, separator: ",").equals(",,");
}

#[test]
fn text_join_empty_vec_is_empty() {
    let parts: vec::Vec[Text] = vec::new::[Text]();
    assert join(parts, separator: ",").is_empty();
}

#[test]
fn text_join_single_piece_has_no_separator() {
    var parts: vec::Vec[Text] = vec::new::[Text]();
    parts.append(from_str("solo"));
    assert join(parts, separator: ", ").equals("solo");
}

#[test]
fn text_repeating() {
    let t: Text = repeating("ab", 3 as usize);
    assert t.equals("ababab");
}

#[test]
fn text_repeating_zero_is_empty() {
    let t: Text = repeating("ab", 0 as usize);
    assert t.is_empty();
}

#[test]
fn text_prefix_suffix() {
    let t: Text = from_str("hello");
    assert t.prefix(count: 3 as usize).equals("hel");
    assert t.suffix(count: 3 as usize).equals("llo");
}

#[test]
fn text_prefix_suffix_clamp_no_trap() {
    let t: Text = from_str("hi");
    assert t.prefix(count: 99 as usize).equals("hi");
    assert t.suffix(count: 99 as usize).equals("hi");
}

#[test]
fn text_drop_first_last() {
    let t: Text = from_str("hello");
    assert t.drop_first(count: 2 as usize).equals("llo");
    assert t.drop_last(count: 2 as usize).equals("hel");
    // default count is 1 (Swift dropFirst()/dropLast())
    assert t.drop_first().equals("ello");
    assert t.drop_last().equals("hell");
}

#[test]
fn text_appending_is_nonmutating() {
    let a: Text = from_str("foo");
    let b: Text = a.appending("bar");
    assert a.equals("foo");
    assert b.equals("foobar");
}

#[test]
fn text_equals() {
    let t: Text = from_str("abc");
    assert t.equals("abc");
    assert t.equals("ab") == false;
    assert t.equals("abcd") == false;
}

#[test]
fn text_is_ascii() {
    assert from_str("plain ascii 123").is_ascii();
    // 'é' is the 2-byte UTF-8 sequence C3 A9 — both bytes >= 128.
    assert from_str("café").is_ascii() == false;
}

#[test]
fn text_count_of() {
    let t: Text = from_str("abababab");
    assert t.count_of("ab") == (4 as usize);
    assert t.count_of("xyz") == (0 as usize);
    assert t.count_of("") == (0 as usize);
}

#[test]
fn text_replacing() {
    let t: Text = from_str("a,b,c");
    assert t.replacing(of: ",", with: "; ").equals("a; b; c");
    assert t.replacing(of: "x", with: "y").equals("a,b,c");
    assert t.replacing(of: "", with: "z").equals("a,b,c");
}

#[test]
fn text_c_str_counts_without_nul() {
    let t: Text = from_str("hi");
    match t.c_str() {
        option::Option[CString]::Some(cs) => { assert cs.count() == (2 as usize); }
        option::Option[CString]::None => { assert false; }
    }
    return;
}

// ── Eq / Hash (key role for stdlib/string_map) ──

#[test]
fn text_eq_same_bytes() {
    let a: Text = from_str("hello");
    let b: Text = from_str("hello");
    assert a.eq(b);
}

#[test]
fn text_eq_differs_on_content() {
    let a: Text = from_str("hello");
    let b: Text = from_str("world");
    assert a.eq(b) == false;
}

#[test]
fn text_eq_differs_on_length() {
    let a: Text = from_str("hi");
    let b: Text = from_str("hii");
    assert a.eq(b) == false;
}

#[test]
fn text_eq_empty_pair() {
    let a: Text = new();
    let b: Text = new();
    assert a.eq(b);
}

#[test]
fn text_eq_empty_vs_nonempty() {
    let a: Text = new();
    let b: Text = from_str("x");
    assert a.eq(b) == false;
}

#[test]
fn text_hash_agrees_with_eq() {
    let a: Text = from_str("language");
    let b: Text = from_str("language");
    assert a.eq(b);
    assert a.hash() == b.hash();
}

#[test]
fn text_hash_distinguishes_content() {
    let a: Text = from_str("en");
    let b: Text = from_str("fr");
    // Not a hard guarantee in general, but FNV-1a separates these short keys;
    // the test pins the property the map relies on for spread.
    assert a.hash() != b.hash();
}

#[test]
fn text_hash_empty_is_offset_basis() {
    let e: Text = new();
    assert e.hash() == (14695981039346656037 as u64);
}

#[test]
fn text_hash_str_agrees_with_text_hash() {
    // The load-bearing cross-type property for a Text-keyed map queried by str.
    let t: Text = from_str("language");
    assert t.hash() == hash_str("language");
    let e: Text = new();
    assert e.hash() == hash_str("");
}

#[test]
fn from_utf8_valid_ascii_roundtrips() {
    var b: vec::Vec[u8] = vec::new::[u8]();
    b.append(104 as u8);   // 'h'
    b.append(105 as u8);   // 'i'
    match from_utf8(b) {
        option::Option[Text]::Some(t) => { assert t.equals("hi"); }
        option::Option[Text]::None => { assert false; }
    }
    return;
}

#[test]
fn from_utf8_valid_multibyte_is_kept_verbatim() {
    // "é" = U+00E9 = C3 A9 (two bytes).
    var b: vec::Vec[u8] = vec::new::[u8]();
    b.append(0xC3 as u8);
    b.append(0xA9 as u8);
    match from_utf8(b) {
        option::Option[Text]::Some(t) => { assert t.count() == (2 as usize); }
        option::Option[Text]::None => { assert false; }
    }
    return;
}

#[test]
fn from_utf8_empty_is_valid_and_empty() {
    let b: vec::Vec[u8] = vec::new::[u8]();
    match from_utf8(b) {
        option::Option[Text]::Some(t) => { assert t.is_empty(); }
        option::Option[Text]::None => { assert false; }
    }
    return;
}

#[test]
fn from_utf8_rejects_lone_continuation_byte() {
    var b: vec::Vec[u8] = vec::new::[u8]();
    b.append(0x80 as u8);
    match from_utf8(b) {
        option::Option[Text]::Some(_t) => { assert false; }
        option::Option[Text]::None => { }
    }
    return;
}

#[test]
fn from_utf8_rejects_truncated_multibyte() {
    var b: vec::Vec[u8] = vec::new::[u8]();
    b.append(0xC3 as u8);   // 2-byte lead with no continuation
    match from_utf8(b) {
        option::Option[Text]::Some(_t) => { assert false; }
        option::Option[Text]::None => { }
    }
    return;
}

#[test]
fn from_utf8_rejects_surrogate() {
    // ED A0 80 encodes U+D800, a UTF-16 surrogate — not valid UTF-8.
    var b: vec::Vec[u8] = vec::new::[u8]();
    b.append(0xED as u8);
    b.append(0xA0 as u8);
    b.append(0x80 as u8);
    match from_utf8(b) {
        option::Option[Text]::Some(_t) => { assert false; }
        option::Option[Text]::None => { }
    }
    return;
}

#[test]
fn from_utf8_rejects_overlong_encoding() {
    // C0 80 is an overlong encoding of NUL; C0 is below the C2 minimum lead.
    var b: vec::Vec[u8] = vec::new::[u8]();
    b.append(0xC0 as u8);
    b.append(0x80 as u8);
    match from_utf8(b) {
        option::Option[Text]::Some(_t) => { assert false; }
        option::Option[Text]::None => { }
    }
    return;
}

#[test]
fn from_utf8_accepts_max_scalar_and_rejects_above() {
    // F4 8F BF BF = U+10FFFF (max); F4 90 80 80 would be U+110000 (too high).
    var ok: vec::Vec[u8] = vec::new::[u8]();
    ok.append(0xF4 as u8); ok.append(0x8F as u8); ok.append(0xBF as u8); ok.append(0xBF as u8);
    match from_utf8(ok) {
        option::Option[Text]::Some(t) => { assert t.count() == (4 as usize); }
        option::Option[Text]::None => { assert false; }
    }
    var bad: vec::Vec[u8] = vec::new::[u8]();
    bad.append(0xF4 as u8); bad.append(0x90 as u8); bad.append(0x80 as u8); bad.append(0x80 as u8);
    match from_utf8(bad) {
        option::Option[Text]::Some(_t) => { assert false; }
        option::Option[Text]::None => { }
    }
    return;
}

#[test]
fn intern_view_outlives_its_source_text() {
    var key: str = "";
    {
        let t: Text = from_str("row_").appending("42");
        key = intern(t);
    }
    assert key.count() == (6 as usize);
    assert key.compare("row_42") == (0 as i32);
    return;
}

#[test]
fn intern_dedups_equal_strings_to_one_pointer() {
    let a: str = intern("dedup_key");
    let t: Text = from_str("dedup_").appending("key");
    let b: str = intern(t);
    assert ({ #str_ptr(a) } as usize) == ({ #str_ptr(b) } as usize);
    assert a.compare(b) == (0 as i32);
    return;
}

#[test]
fn intern_distinct_strings_get_distinct_bytes() {
    let a: str = intern("alpha_key");
    let b: str = intern("beta_key");
    assert ({ #str_ptr(a) } as usize) != ({ #str_ptr(b) } as usize);
    assert a.compare("alpha_key") == (0 as i32);
    assert b.compare("beta_key") == (0 as i32);
    return;
}

#[test]
fn intern_empty_is_empty() {
    let e: str = intern("");
    assert e.is_empty();
    return;
}
