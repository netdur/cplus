// Linux/Android file-system ABI. The shadow of `fs_sys.cplus` — read that file
// first; it says why these numbers live in a platform file at all.
//
// Verified against the host's own headers (x86_64 glibc 2.39 and bionic agree
// on all of it): every offset below is `offsetof` on a real `struct stat` /
// `struct dirent`, not a reading of the man page.
//
// GLIBC VERSION NOTE: `stat` is a real exported symbol from glibc 2.33 on. On
// anything older the C library only published `__xstat`, and this file would
// fail to LINK rather than silently misbehave — which is the failure mode we
// want if it ever comes up.

// Linux `mode_t` is `unsigned int`, not Darwin's `__uint16_t`.
extern fn mkdir(path: *u8, mode: u32) -> i32;
extern fn stat(path: *u8, buf: *u8) -> i32;

// O_WRONLY = 0x1, O_CREAT = 0x40, O_TRUNC = 0x200 -> 0x241.
fn create_flags() -> i32 { return 577 as i32; }

// O_WRONLY = 0x1, O_CREAT = 0x40, O_APPEND = 0x400 -> 0x441.
fn append_flags() -> i32 { return 1089 as i32; }

fn make_dir(path: *u8, mode: u32) -> i32 {
    return { mkdir(path, mode) };
}

// ---- struct stat -------------------------------------------------------------
//
// x86_64/aarch64 Linux: 144 bytes — the same SIZE as Darwin's and a completely
// different layout, which is exactly why the Darwin offsets read plausible
// garbage instead of faulting. st_size is an i64 at byte 48 and st_mtim.tv_sec
// an i64 at byte 88 on BOTH; `st_mode` is the one field that moves.
//
// AND IT MOVES BY ARCHITECTURE, not by OS — which is how it came to be wrong.
// The two kernel layouts differ in where `st_nlink` sits:
//
//   x86_64    dev@0  ino@8  nlink@16(8)  MODE@24  uid@28 gid@32 ... size@48
//   aarch64   dev@0  ino@8  MODE@16      nlink@20 uid@24 gid@28 ... size@48
//
// This file hard-coded 24, which on aarch64 reads `st_uid`. The effect was not
// a crash and not a wrong number a reader would notice — `fs::is_dir` simply
// answered FALSE for every directory on Android, because a uid ANDed with
// S_IFMT is not S_IFDIR. Measured on an emulator, 2026-08-28, before the fix:
// `fs::is_dir("/data/data/<pkg>/files")` was false while `fs::exists` on the
// same path was true.
//
// `#arch()` is a compile-time string, so the branch folds; there is no runtime
// cost and no way for the two to disagree at run time.

fn stat_buf_bytes() -> usize { return 144 as usize; }

fn stat_path(path: *u8, buf: *u8) -> i32 {
    return { stat(path, buf) };
}

// Where `st_mode` is, for the architecture this binary is being built for.
fn stat_mode_offset() -> usize {
    if #arch() == "aarch64" { return 16 as usize; }
    return 24 as usize;
}

fn stat_mode(buf: *u8) -> u32 {
    return { *((buf + stat_mode_offset()) as *u32) };
}

fn stat_mtime_secs(buf: *u8) -> i64 {
    return { *((buf + (88 as usize)) as *i64) };
}

fn stat_file_size(buf: *u8) -> i64 {
    return { *((buf + (48 as usize)) as *i64) };
}

// ---- struct dirent -----------------------------------------------------------

// Linux `struct dirent`: u64 d_ino, i64 d_off, u16 d_reclen, u8 d_type, then
// char d_name[256] at byte 19 — two bytes earlier than Darwin, which has a
// d_namlen field Linux does not.
fn dirent_name(ent: *u8) -> *u8 {
    return { ent + (19 as usize) };
}
