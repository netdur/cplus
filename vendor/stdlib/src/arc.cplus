// stdlib/arc.cplus — atomically-refcounted shared ownership.
//
// `Arc[T]` is the canonical multi-owner type: cheap to clone, deep
// last-drop free. The control block is `{ refcount: u64, value: T }`
// allocated as one chunk; every `Arc` pointer carries `_ctrl: *u8`
// pointing at the header. `clone()` does an atomic increment;
// `drop()` does an atomic decrement and frees the block on the
// last reference.
//
// **Concurrency.** Refcount uses release-on-decrement + acquire fence
// on the last release (the standard Boost / Rust pattern). For v0.0.4
// the fence is folded into the LLVM atomic ordering (`AcqRel` on
// the decrement); a stand-alone `atomic_fence` lands later if a
// specific workload needs split ordering.
//
// Uniqueness: `is_unique()` reports whether this handle is the only
// strong reference; `try_unwrap()` consumes the handle and recovers the
// inner T when it is (CAS-gated, so the sole-owner claim is exclusive
// even under concurrent drops). That is the safe extraction path for
// non-Copy T (shared `value()` stays `T: Copy`-gated). No `make_mut` —
// clone-on-write needs a `T: Clone` story C+ does not have; use
// `try_unwrap` + `new`.

import "./atomic" as atomic;
import "./option" as option;
import "./status" as status;
import "./text" as text;

extern fn malloc(n: usize) -> *u8;
extern fn free(p: *u8);

struct Arc[T] {
    _ctrl: *u8,
}

// A weak (non-owning) handle to an `Arc`'s value: it keeps the control block
// addressable but does NOT keep the value alive, so it breaks the reference
// cycles a graph of `Arc`s would otherwise leak. `Arc::downgrade` makes one;
// `Weak::upgrade` atomically recovers an `Arc` while the value is still alive,
// yielding `None` once the last strong handle is gone.
struct Weak[T] {
    _ctrl: *u8,
}

// `Arc[T]` hides its control block behind a raw `_ctrl` pointer, so the
// v0.0.14 structural rule marks it `!Send`/`!Sync` by default. The atomic
// refcount makes cross-thread transfer and sharing sound when the payload
// itself is thread-safe, so we vouch for it conditionally: `Arc[T]` is
// `Send`/`Sync` iff `T: Send + Sync` (the value can be touched from another
// thread, and shared `&Arc` reaches the value).
impl Arc[T: Send + Sync]: Send {}
impl Arc[T: Send + Sync]: Sync {}

// A `Weak[T]` reaches the value only through `upgrade` (which hands back an
// `Arc[T]`), so it carries the same thread-safety condition as `Arc[T]`.
impl Weak[T: Send + Sync]: Send {}
impl Weak[T: Send + Sync]: Sync {}

// Control block: `[strong: u64 @0][weak: u64 @8][value: T @16]` (assumes
// align_of[T] <= 8). `strong` counts `Arc` handles; `weak` counts `Weak`
// handles PLUS one implicit weak collectively owned by all the strong handles.
// The value is dropped when `strong` hits 0; the block is freed exactly once —
// by whoever drops `weak` to 0 — which makes the strong/weak teardown race-free
// (a live `Weak` safely outlives the value).
fn new[T](take v: T) -> option::Option[Arc[T]] {
    let header: usize = 16 as usize;
    let value_size: usize = #size_of::[T]();
    let total: usize = header +% value_size;
    let raw: *u8 = { malloc(total) };
    if raw.is_null() {
        return option::Option[Arc[T]]::None;   // v drops here -> recovered
    }
    let strong: *u64 = { raw as *u64 };
    { *strong = 1 as u64; }
    let weak: *u64 = { (raw + (8 as usize)) as *u64 };
    { *weak = 1 as u64; }
    let value_ptr: *T = { (raw + header) as *T };
    { *value_ptr = v; }
    return option::Option[Arc[T]]::Some(Arc[T] { _ctrl: raw });
}

impl Arc[T] {
    // Atomic increment refcount; return a new Arc sharing the storage.
    // Relaxed ordering on the increment is sufficient because the new
    // Arc carries the same _ctrl pointer that's already visible to this
    // thread; no happens-before relationship is established by the
    // increment itself.
    fn clone(this) -> Arc[T] {
        let refct: *u64 = { this._ctrl as *u64 };
        let _prev: u64 = {
            atomic::fetch_add_u64(refct, 1 as u64, atomic::Ordering::Relaxed)
        };
        return Arc[T] { _ctrl: this._ctrl };
    }

    // Make a non-owning `Weak` handle to this value (atomic weak increment).
    // The `Weak` can outlive every `Arc` and cross threads (when `T: Send +
    // Sync`); `upgrade` reports whether the value is still there. Use it for
    // back-pointers so a graph of `Arc`s doesn't leak a cycle. Relaxed is
    // sufficient: the `_ctrl` pointer is already visible to this thread, and the
    // freeing decrement (which needs the ordering) is `AcqRel` in the drops.
    fn downgrade(this) -> Weak[T] {
        let weak: *u64 = { (this._ctrl + (8 as usize)) as *u64 };
        let _prev: u64 = {
            atomic::fetch_add_u64(weak, 1 as u64, atomic::Ordering::Relaxed)
        };
        return Weak[T] { _ctrl: this._ctrl };
    }

    // Current strong-reference count (snapshot — racy under load,
    // useful for tests + debugging only).
    fn strong_count(this) -> u64 {
        let refct: *u64 = { this._ctrl as *u64 };
        return { atomic::load_u64(refct, atomic::Ordering::SeqCst) };
    }

    // Number of live `Weak` handles (excludes the implicit weak that the strong
    // handles share while any strong remains). A racy snapshot under load.
    fn weak_count(this) -> u64 {
        let wp: *u64 = { (this._ctrl + (8 as usize)) as *u64 };
        let sp: *u64 = { this._ctrl as *u64 };
        let raw: u64 = { atomic::load_u64(wp, atomic::Ordering::SeqCst) };
        let s: u64 = { atomic::load_u64(sp, atomic::Ordering::SeqCst) };
        if s > (0 as u64) {
            return raw -% (1 as u64);
        }
        return raw;
    }

    // True when this handle is the only strong reference. A `true` seen
    // by the sole remaining handle is stable — no other handle exists to
    // clone from — while under concurrent handle traffic on other
    // threads the answer is a racy snapshot: fine for assertions and
    // fast paths, not for safety decisions (use `try_unwrap`'s CAS gate
    // for those).
    fn is_unique(this) -> bool {
        let refct: *u64 = { this._ctrl as *u64 };
        let cur: u64 = { atomic::load_u64(refct, atomic::Ordering::Acquire) };
        return cur == (1 as u64);
    }

    // Scoped exclusive access: when this handle is the only strong
    // reference, call `f` with the shared value through a `ref` slot (the
    // callback mutates it in place) and return `Ok`; otherwise return
    // `Shared` without touching the value. An Acquire load of 1 is a
    // stable claim here: we hold one reference, so a count of 1 means no
    // other handle exists anywhere — and none can appear during `f`,
    // because cloning requires a handle and the callback (a plain
    // fn-pointer, no captures) can only reach one through the payload
    // itself, which would have made the count at least 2.
    fn with_mut(ref this, f: fn(ref T)) -> status::Status {
        let refct: *u64 = { this._ctrl as *u64 };
        let cur: u64 = { atomic::load_u64(refct, atomic::Ordering::Acquire) };
        if cur != (1 as u64) {
            return status::Status::Shared;
        }
        // Another thread holding a `Weak` could `upgrade` to a second strong
        // handle mid-callback and read the value while `f` mutates it. Exclusive
        // access therefore also requires that no `Weak` exists (raw weak == 1,
        // the implicit only): with the sole `Arc` busy here, none can appear.
        let weak: *u64 = { (this._ctrl + (8 as usize)) as *u64 };
        let curw: u64 = { atomic::load_u64(weak, atomic::Ordering::Acquire) };
        if curw != (1 as u64) {
            return status::Status::Shared;
        }
        let value_ptr: *T = { (this._ctrl + (16 as usize)) as *T };
        { f(*value_ptr); }
        return status::Status::Ok;
    }

    // Consume the handle; recover the inner T when this is the only
    // strong reference. The claim is a CAS of the count 1 → 0: success
    // proves no other handle existed at that instant (and none can
    // appear — cloning requires a handle), so moving the value out and
    // freeing the block is exclusive. AcqRel pairs the acquire with
    // prior release decrements from other threads' drops. On success
    // the handle is disarmed (null `_ctrl`) so the function-exit Drop
    // skips both inner Drop and free. On failure returns `None`; the
    // function-exit Drop then decrements like any normal handle drop.
    fn try_unwrap(take this) -> option::Option[T] {
        let refct: *u64 = { this._ctrl as *u64 };
        let observed: u64 = {
            atomic::compare_exchange_u64(
                refct, 1 as u64, 0 as u64, atomic::Ordering::AcqRel)
        };
        if observed != (1 as u64) {
            return option::Option[T]::None;
        }
        // The CAS 1 -> 0 wins the value exclusively (any concurrent `upgrade`
        // now sees strong 0 -> None). Move it out, then release the implicit
        // weak; free only if no `Weak` handles remain.
        let value_ptr: *T = { (this._ctrl + (16 as usize)) as *T };
        let v: T = { #take::[T](value_ptr) };
        let weak: *u64 = { (this._ctrl + (8 as usize)) as *u64 };
        let prevw: u64 = {
            atomic::fetch_sub_u64(weak, 1 as u64, atomic::Ordering::AcqRel)
        };
        if prevw == (1 as u64) {
            { free(this._ctrl); }
        }
        { this._ctrl = 0 as *u8; }
        return option::Option[T]::Some(v);
    }

    // Destructor: atomic decrement; free the block on the last ref.
    // AcqRel ordering: release pairs with prior writes through this
    // _ctrl ptr; acquire on the final decrement synchronises with all
    // prior Arc::drop's so the freeing thread sees a consistent view
    // of the value before deallocation.
    // Short-circuits on null `_ctrl` — the `try_unwrap` success path
    // nulls the handle after moving the value out, so this Drop must
    // not touch the already-freed block.
    fn drop(ref this) {
        let null_p: *u8 = { 0 as *u8 };
        if this._ctrl == null_p { return; }
        let refct: *u64 = { this._ctrl as *u64 };
        let prev: u64 = {
            atomic::fetch_sub_u64(refct, 1 as u64, atomic::Ordering::AcqRel)
        };
        if prev == (1 as u64) {
            // Last strong handle: invoke inner-T Drop, then release the implicit
            // weak. The block is freed here only if no `Weak` handles remain;
            // otherwise the final `Weak::drop` frees it (exactly-once teardown).
            let value_ptr: *T = { (this._ctrl + (16 as usize)) as *T };
            { #drop_in_place::[T](value_ptr); }
            let weak: *u64 = { (this._ctrl + (8 as usize)) as *u64 };
            let prevw: u64 = {
                atomic::fetch_sub_u64(weak, 1 as u64, atomic::Ordering::AcqRel)
            };
            if prevw == (1 as u64) {
                { free(this._ctrl); }
            }
        }
        return;
    }
}

impl Weak[T] {
    // Another `Weak` to the same block (atomic weak increment).
    fn clone(this) -> Weak[T] {
        let weak: *u64 = { (this._ctrl + (8 as usize)) as *u64 };
        let _prev: u64 = {
            atomic::fetch_add_u64(weak, 1 as u64, atomic::Ordering::Relaxed)
        };
        return Weak[T] { _ctrl: this._ctrl };
    }

    // Strong count seen through this weak handle: 0 once the value is gone.
    // A racy snapshot under load.
    fn strong_count(this) -> u64 {
        let sp: *u64 = { this._ctrl as *u64 };
        return { atomic::load_u64(sp, atomic::Ordering::SeqCst) };
    }

    // Live `Weak` handles (excludes the implicit weak while any strong remains).
    fn weak_count(this) -> u64 {
        let wp: *u64 = { (this._ctrl + (8 as usize)) as *u64 };
        let sp: *u64 = { this._ctrl as *u64 };
        let raw: u64 = { atomic::load_u64(wp, atomic::Ordering::SeqCst) };
        let s: u64 = { atomic::load_u64(sp, atomic::Ordering::SeqCst) };
        if s > (0 as u64) {
            return raw -% (1 as u64);
        }
        return raw;
    }

    // Try to recover an `Arc`: `Some` while at least one strong handle is alive,
    // `None` once the value has been dropped. A CAS loop guards the race with a
    // concurrent last `Arc::drop`: it only ever bumps a strong count that is
    // still > 0, so it can never resurrect a value already being torn down.
    fn upgrade(this) -> option::Option[Arc[T]] {
        let strong: *u64 = { this._ctrl as *u64 };
        loop {
            let cur: u64 = { atomic::load_u64(strong, atomic::Ordering::Acquire) };
            if cur == (0 as u64) {
                return option::Option[Arc[T]]::None;
            }
            let observed: u64 = {
                atomic::compare_exchange_u64(
                    strong, cur, cur +% (1 as u64), atomic::Ordering::AcqRel)
            };
            if observed == cur {
                return option::Option[Arc[T]]::Some(Arc[T] { _ctrl: this._ctrl });
            }
        }
        return option::Option[Arc[T]]::None;
    }

    // Destructor: atomic weak decrement; free the block once it reaches 0 —
    // which only happens after every strong handle is gone (the last strong
    // drop released the implicit weak). AcqRel pairs with the other releases.
    fn drop(ref this) {
        let null_p: *u8 = { 0 as *u8 };
        if this._ctrl == null_p { return; }
        let weak: *u64 = { (this._ctrl + (8 as usize)) as *u64 };
        let prevw: u64 = {
            atomic::fetch_sub_u64(weak, 1 as u64, atomic::Ordering::AcqRel)
        };
        if prevw == (1 as u64) {
            { free(this._ctrl); }
        }
        return;
    }
}

// `get` bitwise-copies the shared value out, sound only for `Copy` T: an Arc is
// shared ownership, so a non-Copy T can never be safely extracted (it would
// double-free against the storage and other handles). The `T: Copy` bound makes
// a non-Copy `get` a compile error (E0502); kept in its own impl block so
// `Arc[NonCopy]` still works through `clone` / `strong_count` / Drop.
impl Arc[T: Copy] {
    // Read inner T (bitwise copy).
    fn value(this) -> T {
        let header: usize = 16 as usize;
        let value_ptr: *T = { (this._ctrl + header) as *T };
        return { *value_ptr };
    }
}

// ───────────────────────────── tests ─────────────────────────────

#[test]
fn arc_new_and_get() {
    match new::[i32](9) {
        option::Option[Arc[i32]]::Some(a) => { assert a.value() == 9; }
        option::Option[Arc[i32]]::None => { assert false; }
    }
    return;
}

#[test]
fn arc_clone_bumps_strong_count() {
    match new::[i32](9) {
        option::Option[Arc[i32]]::Some(a) => {
            assert a.strong_count() == (1 as u64);
            let a2: Arc[i32] = a.clone();
            assert a.strong_count() == (2 as u64);
            assert a2.value() == 9;
        }
        option::Option[Arc[i32]]::None => { assert false; }
    }
    return;
}

#[test]
fn arc_is_unique_tracks_clones() {
    match new::[i32](3) {
        option::Option[Arc[i32]]::Some(a) => {
            assert a.is_unique();
            let a2: Arc[i32] = a.clone();
            assert !a.is_unique();
            assert !a2.is_unique();
        }
        option::Option[Arc[i32]]::None => { assert false; }
    }
    return;
}

#[test]
fn arc_try_unwrap_sole_handle_recovers_value() {
    match new::[i32](77) {
        option::Option[Arc[i32]]::Some(a) => {
            match a.try_unwrap() {
                option::Option[i32]::Some(v) => { assert v == 77; }
                option::Option[i32]::None => { assert false; }
            }
        }
        option::Option[Arc[i32]]::None => { assert false; }
    }
    return;
}

// Shared handle refuses to unwrap (CAS observes count 2); the refusal
// decrements like a normal drop, storage stays intact for the survivor,
// which can then unwrap.
#[test]
fn arc_try_unwrap_shared_refuses_then_survivor_unwraps() {
    match new::[i32](21) {
        option::Option[Arc[i32]]::Some(a) => {
            let a2: Arc[i32] = a.clone();
            assert a2.strong_count() == (2 as u64);
            match a.try_unwrap() {
                option::Option[i32]::Some(_v) => { assert false; }
                option::Option[i32]::None => { }
            }
            assert a2.strong_count() == (1 as u64);
            assert a2.value() == 21;
            match a2.try_unwrap() {
                option::Option[i32]::Some(v) => { assert v == 21; }
                option::Option[i32]::None => { assert false; }
            }
        }
        option::Option[Arc[i32]]::None => { assert false; }
    }
    return;
}

// Callbacks for the `with_mut` tests — plain fns; a fn-pointer callback
// has no captures, so nothing but its argument is reachable inside it.
fn bump(ref n: i32) { n = n +% 1; return; }
fn append_world(ref t: text::Text) {
    let _st: status::Status = t.append(" world");
    return;
}

#[test]
fn arc_with_mut_unique_mutates_in_place() {
    match new::[i32](41) {
        option::Option[Arc[i32]]::Some(a) => {
            var aa: Arc[i32] = a;
            assert aa.with_mut(bump).is_ok();
            assert aa.value() == 42;
        }
        option::Option[Arc[i32]]::None => { assert false; }
    }
    return;
}

// A shared handle refuses scoped mutation (`Shared`), leaving the value
// untouched.
#[test]
fn arc_with_mut_shared_refuses() {
    match new::[i32](7) {
        option::Option[Arc[i32]]::Some(a) => {
            var aa: Arc[i32] = a;
            let a2: Arc[i32] = aa.clone();
            let st: status::Status = aa.with_mut(bump);
            assert st.is_err();
            assert st == status::Status::Shared;
            assert a2.value() == 7;
        }
        option::Option[Arc[i32]]::None => { assert false; }
    }
    return;
}

// In-place mutation of a non-Copy payload through a shared handle, then
// extraction.
#[test]
fn arc_with_mut_non_copy_payload_in_place() {
    match new::[text::Text](text::from_str("hello")) {
        option::Option[Arc[text::Text]]::Some(a) => {
            var aa: Arc[text::Text] = a;
            assert aa.with_mut(append_world).is_ok();
            match aa.try_unwrap() {
                option::Option[text::Text]::Some(t) => {
                    assert t.equals("hello world");
                }
                option::Option[text::Text]::None => { assert false; }
            }
        }
        option::Option[Arc[text::Text]]::None => { assert false; }
    }
    return;
}

// Non-Copy Drop payload: `value()` is unavailable (T: Copy gate), so
// `try_unwrap` is the extraction path. The recovered Text is owned by
// the caller and drops exactly once at scope exit.
#[test]
fn arc_try_unwrap_non_copy_payload() {
    match new::[text::Text](text::from_str("hello arc")) {
        option::Option[Arc[text::Text]]::Some(a) => {
            match a.try_unwrap() {
                option::Option[text::Text]::Some(t) => {
                    assert t.equals("hello arc");
                }
                option::Option[text::Text]::None => { assert false; }
            }
        }
        option::Option[Arc[text::Text]]::None => { assert false; }
    }
    return;
}

// ─────────────────────────── Weak tests ───────────────────────────

// Consume an Arc and return a Weak to its (now value-dropped) block: the owned
// `a` drops on return, so the returned Weak observes strong == 0.
fn downgrade_and_drop(take a: Arc[i32]) -> Weak[i32] {
    let w: Weak[i32] = a.downgrade();
    return w;
}

// A Drop-observing payload proving the value drops exactly once (never again
// when a lingering Weak later frees the block).
static ARC_WEAK_DROPS: i64 = 0;
struct ArcTracked { _tag: i32 }
impl ArcTracked {
    fn drop(ref this) { ARC_WEAK_DROPS = ARC_WEAK_DROPS +% (1 as i64); return; }
}
fn downgrade_and_drop_tracked(take a: Arc[ArcTracked]) -> Weak[ArcTracked] {
    let w: Weak[ArcTracked] = a.downgrade();
    return w;
}

#[test]
fn arc_downgrade_upgrade_roundtrip_while_alive() {
    match new::[i32](5) {
        option::Option[Arc[i32]]::Some(a) => {
            let w: Weak[i32] = a.downgrade();
            assert a.weak_count() == (1 as u64);
            assert w.strong_count() == (1 as u64);
            match w.upgrade() {
                option::Option[Arc[i32]]::Some(a2) => {
                    assert a2.value() == 5;
                    assert a.strong_count() == (2 as u64);   // upgrade bumped strong
                }
                option::Option[Arc[i32]]::None => { assert false; }
            }
            assert a.strong_count() == (1 as u64);           // a2 dropped, back to 1
        }
        option::Option[Arc[i32]]::None => { assert false; }
    }
    return;
}

#[test]
fn arc_weak_count_excludes_implicit_and_tracks_clones() {
    match new::[i32](1) {
        option::Option[Arc[i32]]::Some(a) => {
            assert a.weak_count() == (0 as u64);             // no user weaks yet
            let w1: Weak[i32] = a.downgrade();
            assert a.weak_count() == (1 as u64);
            let w2: Weak[i32] = w1.clone();
            assert a.weak_count() == (2 as u64);
            assert w2.strong_count() == (1 as u64);
        }
        option::Option[Arc[i32]]::None => { assert false; }
    }
    return;
}

#[test]
fn arc_upgrade_none_after_last_strong_drops() {
    match new::[i32](9) {
        option::Option[Arc[i32]]::Some(a) => {
            let w: Weak[i32] = downgrade_and_drop(a);        // a dropped inside helper
            assert w.strong_count() == (0 as u64);           // value gone
            match w.upgrade() {
                option::Option[Arc[i32]]::Some(_a2) => { assert false; }
                option::Option[Arc[i32]]::None => { }
            }
            // w drops here -> weak 0 -> block freed (no double free / crash).
        }
        option::Option[Arc[i32]]::None => { assert false; }
    }
    return;
}

// The soundness invariant: when the last strong drops but a Weak still points at
// the block, the value is dropped EXACTLY ONCE — the later block-free (when the
// Weak drops) must not drop it again.
#[test]
fn arc_value_dropped_once_when_strong_gone_weak_lingers() {
    ARC_WEAK_DROPS = 0 as i64;
    let payload: ArcTracked = ArcTracked { _tag: 7 };
    match new::[ArcTracked](payload) {
        option::Option[Arc[ArcTracked]]::Some(a) => {
            let w: Weak[ArcTracked] = downgrade_and_drop_tracked(a);
            assert ARC_WEAK_DROPS == (1 as i64);             // dropped once when strong→0
            match w.upgrade() {
                option::Option[Arc[ArcTracked]]::Some(_a2) => { assert false; }
                option::Option[Arc[ArcTracked]]::None => { }
            }
            // w drops here -> block freed, value NOT dropped a second time.
        }
        option::Option[Arc[ArcTracked]]::None => { assert false; }
    }
    assert ARC_WEAK_DROPS == (1 as i64);
    return;
}
