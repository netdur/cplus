// agent_mcp — the MCP bridge for the agent surface (Theme B, plan.agent-mcp.md).
//
// An external agent drives a live `agent_appkit::Surface` over JSON-RPC 2.0:
//
//   - describe_ui  -> the live node snapshot (read path)
//   - click / set_text / scroll_to -> authorized actions (write path)
//   - poll_event   -> the next queued semantic event
//
// Every request is first gated by the agent_core consent `AuthGate` on the
// `External` channel: an un-served (deny-all) gate rejects everything, so the
// surface is closed until the developer arms a policy. This module is the
// protocol + serialization core (pure, no sockets); `serve.cplus` layers the
// UDS-by-PID transport on top.
//
// ---- MCP, and why the flat names stayed -------------------------------------
//
// THE PACKAGE WAS NAMED agent_mcp AND DID NOT SPEAK MCP. It spoke JSON-RPC 2.0
// with its own method names, which is a different thing: JSON-RPC is the
// ENVELOPE (`{"jsonrpc","id","method","params"}` in, `result` or `error` back)
// and MCP is a VOCABULARY written in that envelope — `initialize`, `tools/list`,
// `tools/call` — plus a handshake and a lifecycle. All MCP is JSON-RPC; almost
// no JSON-RPC is MCP. So an MCP client's first message, `initialize`, took
// -32601 and it gave up, and NO MCP CLIENT COULD CONNECT TO A FACET APP AT ALL.
// Measured against a running iris: initialize / tools/list / tools/call all
// -32601, `describe_ui` fine. The envelope was understood; the vocabulary was
// absent.
//
// BOTH VOCABULARIES NOW, over one dispatch. `tools/call` unwraps
// `{"name","arguments"}` and falls through to the very same verb branch the flat
// name reaches, so nothing below this comment had to change and every existing
// client — iris's own 42-flow board sweep among them — keeps working verbatim.
//
// THE SCHEMAS LIVE BESIDE THE VERBS THEY DESCRIBE, which is the whole reason
// this belongs here rather than in an app. A `tools/list` entry for `set_text`
// is this file's knowledge: it changes when this file changes. A copy kept in an
// IDE would drift the way two hand-synced Info.plist templates drift, and the
// first symptom would be a client calling a parameter that no longer exists.
// Every app that links this package now gets the framing for free.
//
// AN EXTENSION DESCRIBES ITS OWN VERBS. The `inspector.` namespace adds twelve
// methods through `arm_extension`, and a tools/list that knew only the nine core
// ones would make the extension invisible to exactly the clients that need to be
// told what exists — the same "the agent sees less than the user" bug in a new
// place. But this module must not know what an inspector IS (the dependency runs
// the other way, and that is deliberate), so registration takes a DESCRIBER
// beside the handler and the namespace answers for itself.

import "stdlib/vec" as vec;
import "stdlib/text" as text;
import "stdlib/option" as option;
import "stdlib/result" as result;
import "stdlib/status" as status;
import "stdlib/thread" as thread;
import "stdlib/netsys" as netsys;
import "json/json" as json;
import "agent_core/backend" as backend;
import "agent_core/identity" as identity;
import "agent_core/surface" as surface;
import "agent_core/events" as events;
import "agent_core/auth" as auth;

// ---- JSON building helpers --------------------------------------------------

fn jstr(s: str) -> json::Value {
    return json::Value::Text(text::from_str(s));
}

// Extract a text::Text from a json::Value (falls back to empty on non-text).
fn val_as_text(v: json::Value) -> text::Text {
    return match v.as_text() {
        option::Option[text::Text]::Some(t) => t,
        option::Option[text::Text]::None => text::from_str(""),
    };
}

// Extract an f64 from a json::Value (falls back to 0.0 on non-number).
fn val_as_number(v: json::Value) -> f64 {
    return match v.as_number() {
        option::Option[f64]::Some(n) => n,
        option::Option[f64]::None => 0.0,
    };
}

// Get an object field by key, or Null if absent / not an object.
fn obj_get(v: json::Value, key: str) -> json::Value {
    return match v.value(key) {
        option::Option[json::Value]::Some(val) => val,
        option::Option[json::Value]::None => json::Value::Null,
    };
}

fn jnum(n: f64) -> json::Value {
    return json::Value::Number(n);
}

fn jbool(b: bool) -> json::Value {
    return json::Value::Bool(b);
}

fn member(k: str, take v: json::Value) -> json::Member {
    return json::Member { key: text::from_str(k), value: v };
}

// ---- enum -> wire string ----------------------------------------------------

fn role_to_str(role: identity::Role) -> str {
    if identity::role_eq(role, identity::Role::Button) { return "button"; }
    if identity::role_eq(role, identity::Role::Text) { return "text"; }
    if identity::role_eq(role, identity::Role::Input) { return "input"; }
    if identity::role_eq(role, identity::Role::List) { return "list"; }
    if identity::role_eq(role, identity::Role::Group) { return "group"; }
    if identity::role_eq(role, identity::Role::Window) { return "window"; }
    return "group";
}

// The declared tier, as the word a model reads. `open` never reaches the wire
// (the field is omitted), so it is not in the vocabulary an agent has to learn.
fn tier_to_str(t: u32) -> str {
    if t == identity::tier_protected() { return "protected"; }
    if t == identity::tier_private() { return "private"; }
    return "open";
}

fn outcome_to_str(o: surface::Outcome) -> str {
    if surface::outcome_eq(o, surface::Outcome::Allowed) { return "allowed"; }
    if surface::outcome_eq(o, surface::Outcome::NotFound) { return "not_found"; }
    if surface::outcome_eq(o, surface::Outcome::NotExposed) { return "not_exposed"; }
    if surface::outcome_eq(o, surface::Outcome::NotActionable) { return "not_actionable"; }
    if surface::outcome_eq(o, surface::Outcome::Stale) { return "stale"; }
    // Their own words, not folded into `not_actionable`. The fall-through
    // below is why these arms are explicit: a new outcome that forgets one is
    // reported as a version conflict, which tells an agent to re-read and try
    // again — the exact loop a refusal on a card field must not start.
    //
    // And the two are not interchangeable. `needs_grant` means a wider grant
    // exists and asking the user is the right next move; `forbidden` means the
    // application declared this tier and does not mint the bit. An agent told
    // the wrong one either nags for a permission that is never coming, or
    // abandons work one approval would have unblocked.
    if surface::outcome_eq(o, surface::Outcome::NeedsGrant) { return "needs_grant"; }
    if surface::outcome_eq(o, surface::Outcome::Forbidden) { return "forbidden"; }
    // `no_handler` says the click WAS delivered and nothing was on the other
    // end — a report, not a refusal, and the one outcome an agent should treat
    // as "this control is dead, stop pressing it". Folding it into
    // `version_conflict` (which the fall-through below does for anything
    // unnamed) would tell an agent to re-read and try again, forever. Adding an
    // outcome without adding an arm here is exactly the mistake this line
    // warned about, and it was made once already while writing it.
    if surface::outcome_eq(o, surface::Outcome::NoHandler) { return "no_handler"; }
    return "version_conflict";
}

fn verb_to_str(v: events::Verb) -> str {
    if events::verb_eq(v, events::Verb::Clicked) { return "clicked"; }
    if events::verb_eq(v, events::Verb::Changed) { return "changed"; }
    if events::verb_eq(v, events::Verb::Submitted) { return "submitted"; }
    if events::verb_eq(v, events::Verb::Selected) { return "selected"; }
    if events::verb_eq(v, events::Verb::Toggled) { return "toggled"; }
    if events::verb_eq(v, events::Verb::Opened) { return "opened"; }
    if events::verb_eq(v, events::Verb::Closed) { return "closed"; }
    if events::verb_eq(v, events::Verb::Enabled) { return "enabled"; }
    if events::verb_eq(v, events::Verb::Disabled) { return "disabled"; }
    if events::verb_eq(v, events::Verb::Added) { return "added"; }
    if events::verb_eq(v, events::Verb::Removed) { return "removed"; }
    if events::verb_eq(v, events::Verb::Appeared) { return "appeared"; }
    if events::verb_eq(v, events::Verb::Disappeared) { return "disappeared"; }
    if events::verb_eq(v, events::Verb::WindowOpened) { return "window_opened"; }
    if events::verb_eq(v, events::Verb::WindowClosed) { return "window_closed"; }
    return "ui_changed";
}

// ---- surface -> JSON --------------------------------------------------------

// One describe_ui node as a JSON object. Takes a raw pointer INTO the node Vec
// and reads fields through it (Text fields coerce to `str` borrows, the rest
// are Copy) — never moving the non-Copy `UiNode` out of the Vec, which would
// double-free its owned `Text`s. `parent` is the index into the node array, or
// JSON null for the window root.
// `with_geometry` says whether this view MEASURED anything. The curated
// "exposed" view does not — it reports identity, not layout — so emitting
// `frame: {0,0,0,0}` there would be a lie in the shape of a measurement, and
// one that reads as a broken backend rather than an absent field. It cost a
// real investigation exactly once (bugs/facet-trailing-padding-lost-in-native-
// placement.md, which could not compare rendered frames against flex output
// because every frame came back zero), so the lean view now OMITS `frame` and
// `class` instead of filling them with placeholders. Same rule as
// `description` below: absent when there is nothing to say.
// `parent_index` is the node's parent POSITION IN THIS ANSWER, or -1 for
// none. It is not always the parent's position in the walked tree: under a
// `prefix` filter the answer is a subset, and `parent` has to be renumbered
// into it (see `describe_to_json`) or it would point at whatever node happens
// to sit at that offset in a shorter array.
fn node_to_json(p: *backend::UiNode, with_geometry: bool, parent_index: i64) -> json::Value {
    let parent_val: json::Value = if parent_index < (0 as i64) {
        json::Value::Null
    } else {
        jnum(parent_index as f64)
    };

    var m: vec::Vec[json::Member] = vec::new::[json::Member]();
    m.append(member("id", jstr({ (*p).id })));
    m.append(member("role", jstr(role_to_str({ (*p).role }))));
    if with_geometry {
        m.append(member("class", jstr({ (*p).class_name })));
        var frame: vec::Vec[json::Member] = vec::new::[json::Member]();
        frame.append(member("x", jnum({ (*p).frame.x })));
        frame.append(member("y", jnum({ (*p).frame.y })));
        frame.append(member("w", jnum({ (*p).frame.w })));
        frame.append(member("h", jnum({ (*p).frame.h })));
        m.append(member("frame", json::Value::Object(frame)));
    }
    m.append(member("hidden", jbool({ (*p).is_hidden })));
    m.append(member("text", jstr({ (*p).text })));
    // ON THE WIRE ONLY WHEN GATED, and then both fields — the ones here that
    // exist to be READ BY A MODEL rather than by a test. `text: ""` on its own
    // says "this field is empty, go and fill it in". With `tier` and
    // `readable` it says which of three things is true, and each has a
    // different correct next move: read it, ask the user for permission, or
    // leave it alone and say so.
    if { (*p).tier } != identity::tier_open() {
        m.append(member("tier", jstr(tier_to_str({ (*p).tier }))));
        m.append(member("readable", jbool({ (*p).readable })));
    } else if { (*p).readable } == false {
        // Open tier and STILL not readable: the node is inside an excluded
        // subtree (or the grant carries no `read` at all). The walked view
        // lists it — it is on screen and it has a frame — and withholds what
        // it says, so the withholding has to be on the wire too. Without this
        // the node goes out as `text: ""` with no `tier` and no `readable`,
        // which is character-for-character what a genuinely empty label looks
        // like, and no client can tell the two apart.
        m.append(member("readable", jbool(false)));
    }
    // The accessibility label, under the same "absent when there is nothing to
    // say" rule as `description`: omitted when empty, and omitted when it only
    // repeats `text` — which is the whole of the lean view, where the name IS
    // the text. What is left is the case the field exists for: a node whose
    // name and content differ, or which has no content at all (an icon button,
    // a drop target, a card titled by a grandchild).
    let np: *text::Text = { #addr_of((*p).name) };
    let tp: *text::Text = { #addr_of((*p).text) };
    if { (*np).view() } != "" {
        if { (*np).view() } != { (*tp).view() } {
            m.append(member("name", jstr({ (*p).name })));
        }
    }
    // Dev-authored intent — only on the wire when present (keeps full lean).
    let dp: *text::Text = { #addr_of((*p).description) };
    if { (*dp).view() } != "" {
        m.append(member("description", jstr({ (*p).description })));
    }
    // The permission/capability pair. Both always on the wire: an agent reading
    // one without the other is how sixteen keyed containers came to advertise a
    // press that does not exist.
    m.append(member("actionable", jbool({ (*p).actionable })));
    m.append(member("clickable", jbool({ (*p).clickable })));
    // DELIVERY, and absent when the backend cannot answer. Omitted rather than
    // sent as `false`, because "not answered" and "answered no" are different
    // facts and a model told the wrong one either skips a working control or
    // keeps pressing a dead one. `hit_test` reports `supported` for the same
    // reason.
    match { (*p).wired } {
        option::Option[bool]::Some(w) => { m.append(member("wired", jbool(w))); }
        option::Option[bool]::None => { }
    }
    m.append(member("parent", parent_val));
    return json::Value::Object(m);
}

// This node's parent index in the walked tree, or None for the window root.
fn parent_of(nodes: vec::Vec[backend::UiNode], i: usize) -> option::Option[usize] {
    return match nodes.at_ptr(i) {
        option::Option[*backend::UiNode]::Some(p) => { (*p).parent }
        option::Option[*backend::UiNode]::None => option::Option[usize]::None,
    };
}

// Does this node's key match the filter? An empty prefix matches everything,
// which is what makes the parameter optional and the default unchanged.
fn node_matches(nodes: vec::Vec[backend::UiNode], i: usize, prefix: str) -> bool {
    if prefix == "" { return true; }
    return match nodes.at_ptr(i) {
        option::Option[*backend::UiNode]::Some(p) => {
            let idp: *text::Text = { #addr_of((*p).id) };
            { (*idp).view() }.has_prefix(prefix)
        }
        option::Option[*backend::UiNode]::None => false,
    };
}

// Where each walked node lands in the filtered answer: its new index, or -1
// when the filter drops it.
fn filtered_positions(nodes: vec::Vec[backend::UiNode], prefix: str) -> vec::Vec[i64] {
    var out: vec::Vec[i64] = vec::new::[i64]();
    var next: i64 = 0 as i64;
    var i: usize = 0 as usize;
    while i < nodes.count() {
        if node_matches(nodes, i, prefix) {
            let _s: status::Status = out.append(next);
            next = next +% (1 as i64);
        } else {
            let _s: status::Status = out.append((0 as i64) -% (1 as i64));
        }
        i = i +% (1 as usize);
    }
    return out;
}

// The nearest ancestor of `start` that survived the filter, as its index in
// the ANSWER; -1 when no ancestor did. Walking up rather than giving up at
// the immediate parent keeps the subset a tree: a match whose parent was
// dropped re-attaches to the nearest match above it, and only a node with no
// surviving ancestor at all comes back parentless.
fn kept_parent_index(
    nodes: vec::Vec[backend::UiNode],
    pos: vec::Vec[i64],
    start: usize,
) -> i64 {
    var cur: option::Option[usize] = parent_of(nodes, start);
    loop {
        match cur {
            option::Option[usize]::Some(pi) => {
                match pos.at(pi) {
                    option::Option[i64]::Some(np) => {
                        if np >= (0 as i64) { return np; }
                    }
                    option::Option[i64]::None => { return (0 as i64) -% (1 as i64); }
                }
                cur = parent_of(nodes, pi);
            }
            option::Option[usize]::None => { return (0 as i64) -% (1 as i64); }
        }
    }
}

// The describe_ui snapshot as a JSON array of node objects, optionally
// narrowed to the nodes whose key starts with `prefix`.
//
// WHY THE FILTER IS HERE and not in the client: the caller's cost is the
// payload, not the walk. A whole-tree answer against a real application is
// tens of thousands of characters — enough that an agent harness refuses it
// outright — spent whether the question was "what is on screen" or "is there
// a `board:detail:*` node". Filtering after the fact means receiving it
// first, which is the cost itself. An agent that notices will go around the
// verb instead, and one did, taking an IDE and the app under test with it
// (demo/bugs/04-describe-verbs-cannot-be-scoped.md).
//
// This narrows an ALREADY-PERMITTED read; it is not a permission gate. Every
// node here passed the same grant checks it would have without a prefix, so
// nothing becomes readable that was not, and nothing off-screen becomes
// reachable. What changes is how much of the answer crosses the wire.
fn describe_to_json(
    nodes: vec::Vec[backend::UiNode],
    with_geometry: bool,
    prefix: str,
) -> json::Value {
    let pos: vec::Vec[i64] = filtered_positions(nodes, prefix);
    var arr: vec::Vec[json::Value] = vec::new::[json::Value]();
    var i: usize = 0 as usize;
    while i < nodes.count() {
        var keep: bool = false;
        match pos.at(i) {
            option::Option[i64]::Some(np) => { if np >= (0 as i64) { keep = true; } }
            option::Option[i64]::None => {}
        }
        if keep {
            match nodes.at_ptr(i) {
                option::Option[*backend::UiNode]::Some(p) => {
                    let pidx: i64 = kept_parent_index(nodes, pos, i);
                    let _s: status::Status = arr.append(node_to_json(p, with_geometry, pidx));
                }
                option::Option[*backend::UiNode]::None => {}
            }
        }
        i = i +% (1 as usize);
    }
    return json::Value::Array(arr);
}

fn outcome_result(o: surface::Outcome) -> json::Value {
    var m: vec::Vec[json::Member] = vec::new::[json::Member]();
    m.append(member("outcome", jstr(outcome_to_str(o))));
    return json::Value::Object(m);
}

// The same answer, plus — on `not_found` — WHERE TO LOOK NEXT.
//
// `{"outcome":"not_found"}` alone is a dead end. It says the id is not here
// and nothing about where "here" is, so the two things that actually produce
// it are indistinguishable: an id that has gone stale, and an agent driving
// the wrong application entirely. The second is the expensive one — the verb
// answers a well-formed no, the agent believes the UI it is looking at, and
// the round trips that follow are all spent against the wrong process. It is
// worth a sentence, because a hint on the failure arrives exactly when it is
// needed and costs nothing on the success path (see
// demo/bugs/06-agent-facing-docs-omit-what-costs-agents-time.md, A.2).
fn outcome_result_for(o: surface::Outcome, target: str) -> json::Value {
    var m: vec::Vec[json::Member] = vec::new::[json::Member]();
    m.append(member("outcome", jstr(outcome_to_str(o))));
    if surface::outcome_eq(o, surface::Outcome::NotFound) {
        let hint: text::Text =
            "no node \"${target}\" in the UI of the application serving this endpoint. Re-read describe_ui — ids change as the UI does — and note that an app launched BY this one has its own agent endpoint: this one only ever answers for its own UI.";
        m.append(member("hint", jstr({ hint.view() })));
    }
    return json::Value::Object(m);
}

// `hit_test`'s result. `outcome` first so it reads like every other verb, then
// the pointer answer. `covered_by` is omitted rather than sent empty: an empty
// id would read as "covered by something with no name", when the truth is
// either nothing is on top or what is on top is not exposed — and `covered`
// already carries that distinction.
fn hit_test_result(take h: surface::HitTest) -> json::Value {
    var m: vec::Vec[json::Member] = vec::new::[json::Member]();
    m.append(member("outcome", jstr(outcome_to_str(h.outcome))));
    m.append(member("supported", jbool(h.supported)));
    m.append(member("reachable", jbool(h.reachable)));
    m.append(member("covered", jbool(h.covered)));
    if { h.covered_by.view() } != "" {
        m.append(member("covered_by", jstr({ h.covered_by.view() })));
    }
    return json::Value::Object(m);
}

// `read_runs`' result: the outcome, whether the backend can answer at all, and
// one entry per stretch of uniform attributes. A run's colour is omitted rather
// than sent empty — a run with no colour of its own draws in the control's, and
// "" would read as a colour nobody set.
fn runs_result(take r: surface::Runs) -> json::Value {
    var m: vec::Vec[json::Member] = vec::new::[json::Member]();
    m.append(member("outcome", jstr(outcome_to_str(r.outcome))));
    m.append(member("supported", jbool(r.supported)));
    var arr: vec::Vec[json::Value] = vec::new::[json::Value]();
    var i: usize = 0 as usize;
    while i < r.runs.count() {
        match r.runs.at_ptr(i) {
            option::Option[*surface::TextRun]::Some(run) => {
                var e: vec::Vec[json::Member] = vec::new::[json::Member]();
                e.append(member("start", jnum({ (*run).start } as f64)));
                e.append(member("length", jnum({ (*run).length } as f64)));
                if { (*run).color.view() } != "" {
                    e.append(member("color", jstr({ (*run).color.view() })));
                }
                if { (*run).is_bold } { e.append(member("bold", jbool(true))); }
                if { (*run).is_italic } { e.append(member("italic", jbool(true))); }
                if { (*run).is_underlined } { e.append(member("underlined", jbool(true))); }
                arr.append(json::Value::Object(e));
            }
            option::Option[*surface::TextRun]::None => { }
        }
        i = i +% (1 as usize);
    }
    m.append(member("runs", json::Value::Array(arr)));
    return json::Value::Object(m);
}

// ---- JSON-RPC envelopes -----------------------------------------------------

fn ok_response(id: f64, take result: json::Value) -> json::Value {
    var m: vec::Vec[json::Member] = vec::new::[json::Member]();
    m.append(member("jsonrpc", jstr("2.0")));
    m.append(member("id", jnum(id)));
    m.append(member("result", result));
    return json::Value::Object(m);
}

// A required parameter is absent — JSON-RPC "invalid params" (-32602), naming
// the method and the parameter so the mistake corrects itself.
//
// This exists because absent and empty were the same thing here: every reader
// falls back ("" for text, 0 for numbers), so `set_text` sent with `text:`
// instead of `value:` answered {"outcome":"allowed"} and wrote an empty string.
// A caller cannot tell that from an app that cleared the field, so a typo in a
// parameter name reads as a broken app — reportedly an hour, every time.
// Absent is now refused; an explicit `"value": ""` still clears the field.
fn missing_param(id: f64, method: str, param: str) -> json::Value {
    let msg: text::Text = "${method}: missing required parameter \"${param}\"";
    return err_response(id, - 32602 as f64, msg.view());
}

fn err_response(id: f64, code: f64, msg: str) -> json::Value {
    var e: vec::Vec[json::Member] = vec::new::[json::Member]();
    e.append(member("code", jnum(code)));
    e.append(member("message", jstr(msg)));
    var m: vec::Vec[json::Member] = vec::new::[json::Member]();
    m.append(member("jsonrpc", jstr("2.0")));
    m.append(member("id", jnum(id)));
    m.append(member("error", json::Value::Object(e)));
    return json::Value::Object(m);
}

// ---- MCP: describing a verb --------------------------------------------------
//
// A tool descriptor is `{name, description, inputSchema}` where inputSchema is
// JSON Schema. This is the part that earns MCP its keep: a client learns the
// verb exists and how to call it FROM THE WIRE, instead of the caller having to
// already know. iris's board sweep works today only because it was written by
// someone who knew `describe_ui` takes a `mode`; nothing on the wire said so.

// One property of an input schema.
fn prop(name: str, ty: str, description: str) -> json::Member {
    var p: vec::Vec[json::Member] = vec::new::[json::Member]();
    p.append(member("type", jstr(ty)));
    p.append(member("description", jstr(description)));
    return member(name, json::Value::Object(p));
}

// One tool. `required` is the subset of `props` a call must carry — and it is
// load-bearing rather than documentation: absent and empty are the same value
// to every reader here (`""` for text, `0` for numbers), which is how a
// `set_text` sent with the wrong parameter name once answered "allowed" and
// wrote an empty string. Naming the requirement lets the CLIENT catch that
// before the call is made.
fn tool(name: str, description: str, take props: vec::Vec[json::Member],
        take required: vec::Vec[json::Value]) -> json::Value {
    var schema: vec::Vec[json::Member] = vec::new::[json::Member]();
    schema.append(member("type", jstr("object")));
    schema.append(member("properties", json::Value::Object(props)));
    schema.append(member("required", json::Value::Array(required)));
    var t: vec::Vec[json::Member] = vec::new::[json::Member]();
    t.append(member("name", jstr(name)));
    t.append(member("description", jstr(description)));
    t.append(member("inputSchema", json::Value::Object(schema)));
    return json::Value::Object(t);
}

fn no_props() -> vec::Vec[json::Member] { return vec::new::[json::Member](); }
fn no_required() -> vec::Vec[json::Value] { return vec::new::[json::Value](); }

fn required1(a: str) -> vec::Vec[json::Value] {
    var r: vec::Vec[json::Value] = vec::new::[json::Value]();
    r.append(jstr(a));
    return r;
}

fn required2(a: str, b: str) -> vec::Vec[json::Value] {
    var r: vec::Vec[json::Value] = vec::new::[json::Value]();
    r.append(jstr(a));
    r.append(jstr(b));
    return r;
}

// THE NINE VERBS. Descriptions are written for the model that will read them —
// they say what the verb is FOR and what the answer means, because a name and a
// type alone leave a client guessing at exactly the points where guessing is
// expensive.
//
// Nothing app-shaped appears here, and that is the design: a board, a card and
// a lane are addressed entirely by KEY, so the verb set stays generic and one
// `describe_ui` teaches a client the whole application. Adding board tools would
// trade that for a surface that has to grow with every screen.
fn core_tools() -> vec::Vec[json::Value] {
    var out: vec::Vec[json::Value] = vec::new::[json::Value]();

    var p_describe: vec::Vec[json::Member] = no_props();
    p_describe.append(prop("mode", "string",
        "\"exposed\" (default) is the curated set the developer chose to expose — small and high-signal. \"full\" is the whole walked tree including auto-keyed structural nodes, and is a superset."));
    p_describe.append(prop("prefix", "string",
        "Answer only with nodes whose id starts with this, e.g. \"board:detail:\". Absent means the whole view. Use it: a whole-tree answer runs to tens of thousands of characters, and the id path is a path, so the question you are asking almost always has a prefix."));
    out.append(tool("describe_ui",
        "The live UI of THE APPLICATION SERVING THIS ENDPOINT, as a flat list of nodes: id, role, text, hidden, actionable, clickable, wired, parent. The three flags are different questions and you need all three: `actionable` is whether you are ALLOWED to act, `clickable` is whether a click would LAND, and `wired` is whether it would reach a handler — a control can pass the first two and still do nothing. `wired` absent means this backend cannot answer it, which is not the same as false. If that application launched another one, the launched app has its own endpoint and does NOT appear here. Read this FIRST — a node's id is its address for every other verb, and the id path is the schema. Pass \"prefix\" to ask about one part of it.",
        p_describe, no_required()));

    var p_click: vec::Vec[json::Member] = no_props();
    p_click.append(prop("id", "string", "The node id, from describe_ui."));
    out.append(tool("click",
        "Activate a control the way a person clicking it would. Answers an outcome: \"allowed\", \"not_actionable\" (disabled or not a control), or \"not_found\".",
        p_click, required1("id")));

    var p_set_text: vec::Vec[json::Member] = no_props();
    p_set_text.append(prop("id", "string", "The node id of a text input."));
    p_set_text.append(prop("value", "string", "The text to place in it. An explicit empty string clears the field."));
    out.append(tool("set_text",
        "Replace the contents of a text input. \"value\" is required: absent would read as an empty string and silently clear the field.",
        p_set_text, required2("id", "value")));

    var p_hit: vec::Vec[json::Member] = no_props();
    p_hit.append(prop("id", "string", "The node id to test."));
    out.append(tool("hit_test",
        "Whether this node is the one that would actually receive a click at its own position, or whether something else is over it. Use when a click reports allowed but nothing happens.",
        p_hit, required1("id")));

    var p_caret: vec::Vec[json::Member] = no_props();
    p_caret.append(prop("id", "string", "The node id of a text control."));
    p_caret.append(prop("at", "number", "Offset in BYTES of the control's own text."));
    p_caret.append(prop("length", "number", "Selection length in bytes; 0 (default) is an insertion point."));
    out.append(tool("set_caret",
        "Place the caret, or select a range, inside a text control.",
        p_caret, required2("id", "at")));

    var p_runs: vec::Vec[json::Member] = no_props();
    p_runs.append(prop("id", "string", "The node id of a text control."));
    out.append(tool("read_runs",
        "The styled runs of a text control — the text with its attributes, rather than the flattened string describe_ui reports.",
        p_runs, required1("id")));

    var p_menu: vec::Vec[json::Member] = no_props();
    p_menu.append(prop("path", "string", "\"Menu/Item\", by the titles as built — for example \"File/Save\"."));
    out.append(tool("invoke_menu",
        "Pick a menu item, validation and all. A menu item is not a node and cannot be reached by id; a disabled one answers \"not_actionable\", the same word a node gets.",
        p_menu, required1("path")));

    var p_scroll: vec::Vec[json::Member] = no_props();
    p_scroll.append(prop("id", "string", "The node id to bring into view."));
    out.append(tool("scroll_to",
        "Scroll a node into view. Needed before interacting with something outside a scroll container's visible region.",
        p_scroll, required1("id")));

    out.append(tool("poll_event",
        "The next queued semantic event, or null when there is none. This is the asynchronous half: it is how an agent notices that the USER did something while it was working.",
        no_props(), no_required()));

    return out;
}

// ---- a second namespace -------------------------------------------------------
//
// One server process, two capability models.
//
// The agent surface is curated and permissioned: it hides unexposed nodes,
// limits actions to declared affordances, and refuses point-addressed
// operations. A DEVELOPER surface — the live inspector — needs the opposite of
// all three, and growing `agent_core::Backend` a debug mode to serve it would
// weaken a user-facing permission model for a development tool.
//
// So the capability models stay separate and only the TRANSPORT is shared. This
// module knows nothing about what it is carrying: an extension registers a
// method prefix and a handler, and every request whose method starts with that
// prefix goes there instead of to the surface vtable. The dependency runs the
// other way — the extension imports this module, not the reverse — so nothing
// here gains a dependency and nothing here can reach into the extension.
//
// ARMING IS EXPLICIT AND IS THE GATE. An extension is more powerful than the
// agent surface, so its presence in the binary must not be enough to expose it;
// a process that never calls `arm_extension` answers "method not found" to
// every extension method. The consent gate still runs FIRST and covers both:
// arming grants no path around it.
static EXT_HANDLER: fn(str, json::Value, f64, auth::Grant) -> json::Value =
    #zero::[fn(str, json::Value, f64, auth::Grant) -> json::Value]();
// Owned, not a `str`. A borrowed {ptr,len} in a static is sound for a literal
// and a use-after-free for anything computed, and a caller composing a prefix
// is not a mistake this module should be able to punish.
static EXT_PREFIX: text::Text = #zero::[text::Text]();
static EXT_ARMED: bool = false;
// How the namespace lists its own verbs for `tools/list`. Separate from the
// handler because answering a call and describing what can be called are
// different questions, and an extension may reasonably do the first without the
// second.
static EXT_DESCRIBER: fn() -> vec::Vec[json::Value] =
    #zero::[fn() -> vec::Vec[json::Value]]();

// `describe` is optional and defaults to none — an extension armed without one
// still WORKS, it is simply not listed by `tools/list`. That is the honest
// degradation: the verbs answer, and a client that was told about them out of
// band can still call them. Supplying one is what makes the namespace
// discoverable, and every namespace should.
fn arm_extension(prefix: str, h: fn(str, json::Value, f64, auth::Grant) -> json::Value,
                 describe: fn() -> vec::Vec[json::Value] = 0 as fn() -> vec::Vec[json::Value]) {
    EXT_PREFIX = text::from_str(prefix);
    EXT_HANDLER = h;
    EXT_DESCRIBER = describe;
    EXT_ARMED = true;
    return;
}

// Every tool this server offers: the nine core verbs, plus whatever an armed
// extension says it has. Built per request rather than cached, because arming
// can happen after the first client connects and a cached list would then be
// wrong in the direction that hides things.
fn all_tools() -> vec::Vec[json::Value] {
    var out: vec::Vec[json::Value] = core_tools();
    if !EXT_ARMED { return out; }
    let d: fn() -> vec::Vec[json::Value] = EXT_DESCRIBER;
    if d == (0 as fn() -> vec::Vec[json::Value]) { return out; }
    // DRAINED, not copied: `json::Value` owns its payloads and has no clone —
    // a descriptor tree is Vecs of Vecs, and duplicating one would mean a deep
    // copy this has no reason to make. The extension handed us its list; we
    // move it across, front first so the order it wrote survives.
    var extra: vec::Vec[json::Value] = d();
    while extra.count() > (0 as usize) {
        match extra.remove(0 as usize) {
            option::Option[json::Value]::Some(v) => { out.append(v); }
            option::Option[json::Value]::None => { return out; }
        }
    }
    return out;
}

// Close the namespace again. The handler is cleared too, so a disarm cannot be
// undone by a stray re-arm of the flag alone.
fn disarm_extension() {
    EXT_ARMED = false;
    EXT_HANDLER = #zero::[fn(str, json::Value, f64, auth::Grant) -> json::Value]();
    EXT_DESCRIBER = #zero::[fn() -> vec::Vec[json::Value]]();
    EXT_PREFIX = text::new();
    return;
}

fn extension_armed() -> bool { return EXT_ARMED; }

fn is_extension_method(method: str) -> bool {
    if !EXT_ARMED { return false; }
    if EXT_HANDLER == (0 as fn(str, json::Value, f64, auth::Grant) -> json::Value) { return false; }
    let p: str = { EXT_PREFIX.view() };
    if p == "" { return false; }
    return text::from_str(method).has_prefix(p);
}

// The credential this request carried, or "" when it carried none. A `token`
// member on `params`, uninterpreted here — the core never reads a token, it
// only hands it to the application's policy, which is the code that knows
// whether it is a JWT, a session id or a shared secret.
//
// On `params` rather than a connection handshake, because a credential that is
// presented once per connection cannot expire during one. See `dispatch`.
// OWNED, not a view. `obj_get` hands back a value the caller owns, so a `str`
// borrowed out of it dangles the moment the expression ends — the token then
// reads as empty garbage and every policy silently sees an anonymous caller.
// The caller keeps this Text alive across its `gate.check`.
fn token_of(params: json::Value) -> text::Text {
    if !params.has("token") { return text::new(); }
    return val_as_text(obj_get(params, "token"));
}

// ---- who is calling ----------------------------------------------------------
//
// A Unix socket carries no identity: `getpeereid` gives a uid, which on a
// single-user Mac is the same uid for every agent and for the user. So the only
// thing that can say WHICH agent is connected is the agent itself — and MCP
// already asks. `initialize` carries `clientInfo: {name, version}`, and that is
// what a consent policy needs in order to say "always allow THIS one" rather
// than "always allow anything that connects".
//
// NOT A CREDENTIAL, AND IT MUST NOT BE READ AS ONE. A client picks its own name
// and can pick any name, so this is an identity in the sense a From: header is:
// it is what makes a prompt legible and a remembered answer specific, not what
// makes it safe. An app that wants unforgeable identity uses `token` and a
// policy that checks it. Saying so here because "remembered per client name"
// looks like authentication from a distance and is not.
//
// PER CONNECTION, cleared when one opens. `serve_fd` handles one connection at
// a time, so a static is the connection's own scope; without the reset a second
// agent would inherit the first's name and, with it, the first's consent.
static CLIENT_NAME: text::Text = #zero::[text::Text]();

fn forget_client() { CLIENT_NAME = text::new(); return; }

// The connected client's self-reported name, or "" before `initialize`.
fn current_client() -> str { return CLIENT_NAME.view(); }

// Read `clientInfo.name` off an initialize request. Called from
// `handle_request` BEFORE dispatch, because the consent gate runs inside
// dispatch and the whole point is that it can ask who this is — including on
// the initialize that introduces them.
fn note_client(req: json::Value) {
    let m: text::Text = val_as_text(obj_get(req, "method"));
    if { m.view() } != "initialize" { return; }
    let params: json::Value = obj_get(req, "params");
    let info: json::Value = obj_get(params, "clientInfo");
    let name: text::Text = val_as_text(obj_get(info, "name"));
    if name.count() == (0 as usize) { return; }
    CLIENT_NAME = name;
    return;
}

// ---- the dispatch -----------------------------------------------------------

// JSON-RPC error codes: -32601 method-not-found (standard); -32001 the
// surface-specific "consent denied" (server error range).

// Dispatch one parsed JSON-RPC request against the live surface. `params` is the
// request's `params` object; `id` is the request id (echoed back). Every call is
// gated on the External consent channel first — a rejected gate yields a
// consent-denied error and never touches the surface.
fn dispatch(
    surf: *u8,
    vt: backend::Backend,
    ref sub: events::Subscriber,
    gate: auth::AuthGate,
    method: str,
    params: json::Value,
    id: f64,
) -> json::Value {
    // MINT THE GRANT ONCE PER REQUEST, from the credential this request
    // carried. Per request rather than per connection: a credential can expire
    // mid-session and a policy that re-reads it is the only version where that
    // means anything. The grant is then threaded down as a parameter — see
    // `backend::Backend` for why it is never stored on the surface.
    let token: text::Text = token_of(params);
    let grant: auth::Grant = gate.check(
        auth::request_with_token(auth::Channel::External, { token.view() }));
    // An empty grant can do nothing at all, so it is refused here rather than
    // one verb at a time. Every other refusal is per node and per tier, and
    // says which.
    if grant.is_empty() {
        return err_response(id, - 32001 as f64, "consent denied");
    }

    // ---- MCP framing ----------------------------------------------------
    //
    // BEHIND THE SAME GATE as everything else, deliberately. A closed surface
    // should look closed: an app that has not armed a policy refuses the
    // handshake rather than advertising a verb list it will not honour. A
    // client that needs to present a credential does it the way every other
    // request does — a `token` on params — which for `tools/call` means inside
    // `arguments`, and which is a transport shim's job to inject.
    if method == "initialize" {
        var caps_tools: vec::Vec[json::Member] = vec::new::[json::Member]();
        caps_tools.append(member("listChanged", json::Value::Bool(false)));
        var caps: vec::Vec[json::Member] = vec::new::[json::Member]();
        caps.append(member("tools", json::Value::Object(caps_tools)));
        var info: vec::Vec[json::Member] = vec::new::[json::Member]();
        info.append(member("name", jstr("facet-agent-surface")));
        info.append(member("version", jstr("0.0.27")));
        var r: vec::Vec[json::Member] = vec::new::[json::Member]();
        // The version this server was written against. Echoing the CLIENT's
        // would be a lie the moment they differ, and the client is required to
        // handle a server naming a different one.
        r.append(member("protocolVersion", jstr("2024-11-05")));
        r.append(member("capabilities", json::Value::Object(caps)));
        r.append(member("serverInfo", json::Value::Object(info)));
        return ok_response(id, json::Value::Object(r));
    }
    if method == "tools/list" {
        var r: vec::Vec[json::Member] = vec::new::[json::Member]();
        r.append(member("tools", json::Value::Array(all_tools())));
        return ok_response(id, json::Value::Object(r));
    }
    if method == "tools/call" {
        if !params.has("name") { return missing_param(id, "tools/call", "name"); }
        let name: text::Text = val_as_text(obj_get(params, "name"));
        let n: str = { name.view() };
        // No recursion, and no reaching the framing through itself: `tools/`
        // is this layer's own namespace and is not a verb.
        if text::from_str(n).has_prefix("tools/") || n == "initialize" {
            let bad: text::Text = "tools/call: \"${n}\" is not a tool";
            return err_response(id, - 32602 as f64, bad.view());
        }
        // The tool's own arguments ARE the verb's params, which is what lets
        // one verb table serve both spellings.
        let args: json::Value = obj_get(params, "arguments");
        let inner: json::Value = dispatch_verb(surf, vt, sub, grant, n, args, id);
        return to_content(id, inner);
    }

    return dispatch_verb(surf, vt, sub, grant, method, params, id);
}

// MCP wants a tool result as CONTENT BLOCKS, not as a bare value. An error
// stays a JSON-RPC error — that is a valid MCP response and it keeps the
// diagnosable ones (missing parameter, consent denied) diagnosable, rather than
// flattening them into prose inside a success.
fn to_content(id: f64, take inner: json::Value) -> json::Value {
    if inner.has("error") { return inner; }
    let payload: json::Value = obj_get(inner, "result");
    var block: vec::Vec[json::Member] = vec::new::[json::Member]();
    block.append(member("type", jstr("text")));
    block.append(member("text", json::Value::Text(payload.to_text())));
    var arr: vec::Vec[json::Value] = vec::new::[json::Value]();
    arr.append(json::Value::Object(block));
    var r: vec::Vec[json::Member] = vec::new::[json::Member]();
    r.append(member("content", json::Value::Array(arr)));
    r.append(member("isError", json::Value::Bool(false)));
    return ok_response(id, json::Value::Object(r));
}

// The verb table, reached by a flat method name or through `tools/call`. The
// grant is already minted and already checked; this only routes.
fn dispatch_verb(
    surf: *u8,
    vt: backend::Backend,
    ref sub: events::Subscriber,
    grant: auth::Grant,
    method: str,
    params: json::Value,
    id: f64,
) -> json::Value {
    // An extension namespace is a second capability model over the same
    // transport, and it is behind consent like everything else — arming opens a
    // namespace, not a bypass.
    //
    // THE GRANT GOES WITH IT. An extension that only learned "consent was not
    // empty" would be a namespace where every credential is equal — which for
    // the inspector meant any agent that could read a label could also rewrite
    // the tree and read a card field through `inspect`, straight past the
    // tiers. A namespace is a place to put verbs, not a place to escape the
    // capability they cost.
    if is_extension_method(method) {
        let h: fn(str, json::Value, f64, auth::Grant) -> json::Value = EXT_HANDLER;
        return h(method, params, id, grant);
    }

    if method == "describe_ui" {
        // The CLIENT chooses the surface view per request: "exposed" (the
        // default) is the curated developer-exposed set — small, high-signal;
        // "full" is the whole walked tree incl. auto-keyed structural nodes.
        let mode: text::Text = val_as_text(obj_get(params, "mode"));
        // ...and how much of it to send. `prefix` narrows the answer to the
        // keys under one path — the shape agents actually ask in, because the
        // key path IS the schema. Absent or "" means the whole view, exactly
        // as before.
        let prefix: text::Text = val_as_text(obj_get(params, "prefix"));
        if { mode.view() } == "full" {
            return ok_response(id,
                describe_to_json((vt.describe)(surf, grant), true, { prefix.view() }));
        }
        return ok_response(id,
            describe_to_json((vt.describe_exposed)(surf, grant), false, { prefix.view() }));
    }
    if method == "click" {
        if !params.has("id") { return missing_param(id, "click", "id"); }
        let target: text::Text = val_as_text(obj_get(params, "id"));
        let o: surface::Outcome = (vt.click)(surf, grant, { target });
        return ok_response(id, outcome_result_for(o, { target.view() }));
    }
    if method == "hit_test" {
        if !params.has("id") { return missing_param(id, "hit_test", "id"); }
        let target: text::Text = val_as_text(obj_get(params, "id"));
        let h: surface::HitTest = (vt.hit_test)(surf, grant, { target });
        return ok_response(id, hit_test_result(h));
    }
    // PLACE THE CARET, in BYTES of the control's own text. `length` defaults to
    // 0 — an insertion point, which is what "place the caret" means; a non-zero
    // length selects.
    if method == "set_caret" {
        if !params.has("id") { return missing_param(id, "set_caret", "id"); }
        if !params.has("at") { return missing_param(id, "set_caret", "at"); }
        let target: text::Text = val_as_text(obj_get(params, "id"));
        let at: u64 = val_as_number(obj_get(params, "at")) as u64;
        let len: u64 = val_as_number(obj_get(params, "length")) as u64;
        let o: surface::Outcome = (vt.set_caret)(surf, grant, { target }, at, len);
        return ok_response(id, outcome_result_for(o, { target.view() }));
    }
    // READ BACK WHAT IS DRAWN — one run per stretch of uniform attributes.
    if method == "read_runs" {
        if !params.has("id") { return missing_param(id, "read_runs", "id"); }
        let target: text::Text = val_as_text(obj_get(params, "id"));
        let r: surface::Runs = (vt.read_runs)(surf, grant, { target });
        return ok_response(id, runs_result(r));
    }
    // INVOKE A MENU ITEM, addressed `Menu/Item` by the titles as built.
    if method == "invoke_menu" {
        if !params.has("path") { return missing_param(id, "invoke_menu", "path"); }
        let path: text::Text = val_as_text(obj_get(params, "path"));
        let o: surface::Outcome = (vt.invoke_menu)(surf, grant, { path });
        return ok_response(id, outcome_result_for(o, { path.view() }));
    }
    if method == "scroll_to" {
        if !params.has("id") { return missing_param(id, "scroll_to", "id"); }
        let target: text::Text = val_as_text(obj_get(params, "id"));
        let o: surface::Outcome = (vt.navigate)(surf, grant, { target });
        return ok_response(id, outcome_result_for(o, { target.view() }));
    }
    if method == "set_text" {
        if !params.has("id") { return missing_param(id, "set_text", "id"); }
        if !params.has("value") { return missing_param(id, "set_text", "value"); }
        let target: text::Text = val_as_text(obj_get(params, "id"));
        let value: text::Text = val_as_text(obj_get(params, "value"));
        let base: u64 = val_as_number(obj_get(params, "base_version")) as u64;
        let o: surface::Outcome = (vt.set_text)(surf, grant, { target }, { value }, base);
        return ok_response(id, outcome_result_for(o, { target.view() }));
    }
    if method == "poll_event" {
        let ev: option::Option[events::Event] = sub.poll();
        let result: json::Value = match ev {
            option::Option[events::Event]::Some(e) => {
                var m: vec::Vec[json::Member] = vec::new::[json::Member]();
                m.append(member("source", jnum(e.source as f64)));
                m.append(member("verb", jstr(verb_to_str(e.verb))));
                json::Value::Object(m)
            }
            option::Option[events::Event]::None => json::Value::Null,
        };
        return ok_response(id, result);
    }
    // Naming the method it received. An extension method arriving at a process
    // that never armed the namespace lands here, and "method not found" alone
    // would read as a protocol mismatch rather than a missing `arm_extension`.
    let unknown: text::Text = "method not found: ${method}";
    return err_response(id, - 32601 as f64, unknown.view());
}

// Convenience: dispatch a raw JSON-RPC request string and return the response
// string. Parses `{ "method": ..., "params": ..., "id": ... }`; a parse failure
// or missing method yields a JSON-RPC error envelope. This is the unit the
// transport reads/writes per line.
fn handle_request(
    surf: *u8,
    vt: backend::Backend,
    ref sub: events::Subscriber,
    gate: auth::AuthGate,
    line: str,
) -> text::Text {
    let out: text::Text = match json::Value::parse(line) {
        result::Result[json::Value, json::ParseError]::Ok(req) => {
            // BEFORE the gate runs, so a policy asked to admit `initialize`
            // already knows who is introducing themselves.
            note_client(req);
            let method_t: text::Text = val_as_text(obj_get(req, "method"));
            // A NOTIFICATION HAS NO id, AND MUST GET NO REPLY. JSON-RPC has
            // always said so and nothing here sent one because nothing sent
            // notifications; MCP's handshake ends with
            // `notifications/initialized`, so the first well-behaved MCP client
            // would have been answered a response it never asked for, carrying
            // `"id": 0` — a message it is entitled to treat as a protocol
            // violation and hang up on. Empty means "write nothing"; see
            // `serve_fd`.
            if !req.has("id") {
                text::new()
            } else {
                let id: f64 = val_as_number(obj_get(req, "id"));
                let params: json::Value = obj_get(req, "params");
                let resp: json::Value = dispatch(surf, vt, sub, gate, method_t.view(), params, id);
                resp.to_text()
            }
        }
        result::Result[json::Value, json::ParseError]::Err(_e) => {
            err_response(0 as f64, - 32700 as f64, "parse error").to_text()
        }
    };
    return out;
}

// ---- UDS transport ----------------------------------------------------------
//
// The wire is newline-delimited JSON-RPC over a Unix-domain stream socket. An
// agent connects (by a per-PID path), sends one request object per line, and
// reads one response object per line, until it closes the connection.
//
// AF_UNIX = 1, SOCK_STREAM = 1, SHUT_WR = 1 on Darwin. `sockaddr_un` is
// { uint8 sun_len; uint8 sun_family; char sun_path[104] } — we build it in a
// byte buffer: offset 1 = family, offset 2 = the NUL-terminated path.

extern fn socket(domain: i32, ty: i32, protocol: i32) -> i32;
extern fn bind(fd: i32, addr: *u8, addrlen: u32) -> i32;
extern fn connect(fd: i32, addr: *u8, addrlen: u32) -> i32;
extern fn listen(fd: i32, backlog: i32) -> i32;
extern fn accept(fd: i32, addr: *u8, addrlen: *u32) -> i32;
extern fn read(fd: i32, buf: *u8, count: usize) -> i64;
extern fn write(fd: i32, buf: *u8, count: usize) -> i64;
extern fn close(fd: i32) -> i32;
extern fn unlink(path: *u8) -> i32;
extern fn getpid() -> i32;
extern fn atexit(f: fn()) -> i32;

// The bound socket path, kept so the exit hook can remove it: `serve_uds` builds
// its sockaddr in a stack buffer that is gone by the time anything could clean
// up, and the accept loop it then blocks in never returns.
// bugs/agent-socket-never-unlinked.md
static SOCK_PATH: [u8; 110] = [0 as u8; 110];
static SOCK_HOOK_ARMED: bool = false;

// Remove the bound socket file, once. Registered with `atexit`, so it runs on a
// normal return, on any `exit()`, and on `-[NSApplication terminate:]` — every
// ordinary way a UI app goes away, including the paths where the serve thread
// is still parked in `accept` and its own teardown is unreachable.
//
// NOT covered: `SIGKILL` and hard crashes. No in-process hook can cover those,
// so a client that finds a socket refusing `connect()` should still treat it as
// dead and may remove it.
fn unlink_bound_socket() {
    if SOCK_PATH[0] == (0 as u8) { return; }
    { unlink(#addr_of(SOCK_PATH[0])); }
    SOCK_PATH[0] = 0 as u8;   // idempotent: the explicit teardown may also call it
    return;
}

// Build the `sockaddr_un` and bind. Returns the bound fd, or the same negative
// setup code `serve_uds` reports (-4 path too long, -1 socket, -2 bind, -5 a
// live server already listening there). Split out of `serve_uds` — which then
// blocks in `accept` forever — so a test can create a real socket file exactly
// the way the server does.
//
// Arms the exit cleanup as soon as the bind succeeds, BEFORE anything that can
// fail or block, so every path from here on removes the file.
fn bind_uds(path: str) -> i32 {
    let plen: usize = #str_len(path);
    if plen > (100 as usize) {
        return - 4 as i32;
    }
    var addr: [u8; 110] = [0 as u8; 110];
    addr[1] = 1 as u8; // sun_family = AF_UNIX
    let pbytes: *u8 = #str_ptr(path);
    var i: usize = 0 as usize;
    while i < plen {
        addr[(2 as usize) +% i] = { *(pbytes + i) };
        i = i +% (1 as usize);
    }
    let path_c: *u8 = { #addr_of(addr[2]) }; // NUL-terminated path inside the struct
    let addrlen: u32 = ((2 as usize) +% plen +% (1 as usize)) as u32;

    let fd: i32 = { socket(1 as i32, 1 as i32, 0 as i32) };
    if fd < (0 as i32) {
        return - 1 as i32;
    }
    // A file may already be sitting at `path`, and `bind` refuses to overwrite
    // one — so it has to go before we can bind. Removing it blind is the wrong
    // way: on a FIXED path (as opposed to the per-PID convention above) that
    // takes the socket out from under a LIVE server, which keeps accepting on
    // an fd no client can reach any more, while this process binds a new file
    // at the same name. So prove the path is dead first, by connecting to it:
    // a refused or absent peer means nobody is listening and the file is a
    // leftover, ours to remove. A peer that ANSWERS is a running instance and
    // this bind is the one that must fail.
    //
    // This is also the only cleanup that covers `SIGKILL` — the `atexit` hook
    // below cannot run for a process that was killed outright, so its socket is
    // removed here, by whoever binds the path next.
    let probe: i32 = { socket(1 as i32, 1 as i32, 0 as i32) };
    if probe >= (0 as i32) {
        let live: i32 = { connect(probe, #addr_of(addr[0]), addrlen) };
        { close(probe); }
        if live == (0 as i32) {
            { close(fd); }
            return - 5 as i32;   // someone is serving here; do not steal it
        }
    }
    { unlink(path_c); }
    if { bind(fd, #addr_of(addr[0]), addrlen) } != (0 as i32) {
        { close(fd); }
        return - 2 as i32;      // bind is what creates the file; none exists yet
    }
    // Bound: the file exists now. Remember it and arm the exit hook.
    var pi: usize = 0 as usize;
    while pi < plen {
        SOCK_PATH[pi] = { *(pbytes + pi) };
        pi = pi +% (1 as usize);
    }
    SOCK_PATH[plen] = 0 as u8;
    if !SOCK_HOOK_ARMED {
        SOCK_HOOK_ARMED = true;
        let _hooked: i32 = { atexit(unlink_bound_socket) };
    }
    return fd;
}

// The PID of this process — for an agent socket path like
// `/tmp/cplus-agent-<pid>.sock` (the path convention is the app's choice).
fn current_pid() -> i32 {
    return { getpid() };
}

// Read one newline-terminated line into `buf` (without the newline). Returns the
// byte length, -1 on EOF before any byte was read, or -2 when this thread was
// CANCELLED (`JoinHandle::cancel`) — the fix for the report's "a worker parked
// in read_line on a socket nobody will write to again is parked for the life
// of the process". A line longer than `cap` is truncated at `cap`. A partial
// line at the moment of cancellation is discarded: the server is shutting
// down, not answering.
fn read_line(fd: i32, buf_ptr: *u8, cap: usize) -> i64 {
    var n: usize = 0 as usize;
    loop {
        if n >= cap {
            break;
        }
        var byte: u8 = 0 as u8;
        if thread::park_begin() {
            thread::park_end();
            return - 2 as i64;
        }
        let r: i64 = { read(fd, #addr_of(byte), 1 as usize) };
        thread::park_end();
        if r <= (0 as i64) {
            if r < (0 as i64) {
                if netsys::errno() == netsys::eintr() {
                    continue;               // the loop's park_begin re-checks
                }
            }
            if n == (0 as usize) {
                return - 1 as i64;
            }
            break;
        }
        if byte == ('\n' as u8) {
            break;
        }
        { *(buf_ptr + n) = byte; }
        n = n +% (1 as usize);
    }
    return n as i64;
}

// Writes go through `netsys::send_fd`, not bare `write`: on Linux that is
// `send(..., MSG_NOSIGNAL)`, which is the only way to keep a dead peer from
// raising SIGPIPE there (Darwin's socket-scoped `SO_NOSIGPIPE` is set on the
// connection instead — see `serve_fd`). Between the two, a client that
// vanishes mid-response ends this write with an error rather than ending the
// process.
fn write_all(fd: i32, ptr: *u8, len: usize) {
    var off: usize = 0 as usize;
    while off < len {
        let w: isize = { netsys::send_fd(fd, ptr + off, len -% off) };
        if w <= (0 as isize) {
            if w < (0 as isize) {
                if netsys::errno() == netsys::eintr() { continue; }
            }
            return;
        }
        off = off +% (w as usize);
    }
    return;
}

// Serve one connected stream socket: read requests line by line, dispatch each
// (re-arming a fresh gate from `policy` per request), and write the response
// line, until the peer closes (EOF) or this thread is cancelled. The
// connection fd is the caller's to close. Returns 0 on EOF, 1 on cancellation.
fn serve_fd(
    surf: *u8,
    vt: backend::Backend,
    ref sub: events::Subscriber,
    policy: fn(auth::Request) -> auth::Grant,
    fd: i32,
) -> i32 {
    // Belt and braces with the accept loops: a caller handing us an fd
    // directly gets the same protection from a peer that goes away
    // (netsys::set_nosigpipe — a no-op on a non-socket fd).
    let _np: i32 = netsys::set_nosigpipe(fd);
    // A NEW CONNECTION IS A NEW CALLER. Without this, a second agent inherits
    // the first's self-reported name — and therefore whatever the user decided
    // about the first.
    forget_client();
    var buf: [u8; 8192] = [0 as u8; 8192];
    loop {
        let len: i64 = read_line(fd, { #addr_of(buf[0]) }, 8192 as usize);
        if len == (- 2 as i64) {
            return 1;                       // cancelled — the caller stops accepting
        }
        if len < (0 as i64) {
            break;
        }
        let line: str = { #str_from_raw_parts(#addr_of(buf[0]), len as usize) };
        let resp: text::Text = handle_request(surf, vt, sub, auth::serve(policy), line);
        // Empty is a NOTIFICATION, which is entitled to no reply — not even a
        // blank line, which a line-delimited client would read as a message.
        if resp.count() > (0 as usize) {
            let rs: str = { resp };
            write_all(fd, #str_ptr(rs), #str_len(rs));
            let nl: u8 = '\n' as u8;
            write_all(fd, { #addr_of(nl) }, 1 as usize);
        }
    }
    return 0;
}

// Bind a Unix-domain socket at `path`, then accept connections and serve each
// (one at a time) via `serve_fd`. Blocks until `accept` fails. Returns a
// negative code on a setup error (socket/bind/listen). `path` must be ≤ 100
// bytes (sun_path limit).
//
// The socket file is removed on entry (a stale one from a previous run, after
// proving nobody is listening on it) and on process exit via an `atexit` hook —
// NOT merely when this function returns. The accept loop below is meant to live
// for the app's whole life, so in a real app it never returns and any teardown
// written here alone is unreachable; the entry-unlink does not compensate,
// because a per-PID path is never reused. A path that a live server is already
// answering on is refused (-5) rather than taken over.
// See `unlink_bound_socket`, `bind_uds` and bugs/agent-socket-never-unlinked.md.
fn serve_uds(
    surf: *u8,
    vt: backend::Backend,
    ref sub: events::Subscriber,
    policy: fn(auth::Request) -> auth::Grant,
    path: str,
) -> i32 {
    let fd: i32 = bind_uds(path);
    if fd < (0 as i32) {
        return fd;
    }
    if { listen(fd, 4 as i32) } != (0 as i32) {
        { close(fd); }
        unlink_bound_socket();  // the bound file would otherwise be orphaned here
        return - 3 as i32;
    }
    loop {
        if thread::park_begin() {
            thread::park_end();
            break;                          // cancelled while about to accept
        }
        let conn: i32 = { accept(fd, 0 as *u8, 0 as *u32) };
        thread::park_end();
        if conn < (0 as i32) {
            if netsys::errno() == netsys::eintr() { continue; }
            break;
        }
        // A CLIENT GOING AWAY MUST NOT KILL THE SERVER. Without this, a
        // write to a disconnected client raises SIGPIPE, whose default
        // disposition terminates the process — no crash report, no log, the
        // whole application gone because an agent pressed ^C on a `nc`.
        // See netsys::set_nosigpipe and
        // demo/bugs/02-iris-terminated-without-crash-report.md.
        let _np: i32 = netsys::set_nosigpipe(conn);
        let served: i32 = serve_fd(surf, vt, sub, policy, conn);
        { close(conn); }
        if served == (1 as i32) {
            break;                          // cancelled mid-connection
        }
    }
    { close(fd); }
    unlink_bound_socket();
    return 0;
}

// ---- TCP transport -----------------------------------------------------------
//
// The same wire on a port instead of a path, and it exists because of ONE
// platform: an iOS app's Unix socket lives inside its sandbox, where nothing on
// the development machine can reach it. There is no shared filesystem to a
// device at all.
//
// A port there IS reachable — forwarded over USB by usbmuxd, which is exactly
// how Flutter's Dart VM Service and Chrome's remote debugging are reached. So
// the transport is the standard one for this problem rather than something
// invented here.
//
// BOUND TO LOOPBACK, never to 0.0.0.0. The forwarder connects locally on the
// device; a listener on all interfaces would put the agent surface — which can
// read a UI and press its buttons — on whatever network the phone is joined to.
// That is not a default anyone should have to remember to change.
//
// AF_INET = 2, SOCK_STREAM = 1, INADDR_LOOPBACK = 0x7f000001. `sockaddr_in` is
// { uint8 sin_len; uint8 sin_family; uint16 sin_port; uint32 sin_addr; char
// sin_zero[8] } on Darwin — 16 bytes, built here in a byte buffer for the same
// reason the `sockaddr_un` above is.

fn put_be16(ref buf: [u8; 16], at: usize, v: u16) {
    buf[at] = { (v / (256 as u16)) as u8 };
    buf[at +% (1 as usize)] = { (v % (256 as u16)) as u8 };
    return;
}

// Bind a loopback listener on `port`. Returns the fd, or a negative setup code
// matching `bind_uds`: -1 socket, -2 bind, -3 listen.
fn bind_tcp(port: u16) -> i32 {
    let fd: i32 = { socket(2 as i32, 1 as i32, 0 as i32) };
    if fd < (0 as i32) { return - 1 as i32; }
    // SO_REUSEADDR, so a restart does not wait out TIME_WAIT on the same port.
    // SOL_SOCKET = 0xffff, SO_REUSEADDR = 4 on Darwin.
    var one: i32 = 1 as i32;
    let _o: i32 = { setsockopt(fd, 65535 as i32, 4 as i32,
                               { #addr_of(one) as *u8 }, 4 as u32) };
    var addr: [u8; 16] = [0 as u8; 16];
    addr[0] = 16 as u8;          // sin_len
    addr[1] = 2 as u8;           // sin_family = AF_INET
    put_be16(addr, 2 as usize, port);
    // 127.0.0.1, in network order — which is the same byte order written out.
    addr[4] = 127 as u8;
    addr[5] = 0 as u8;
    addr[6] = 0 as u8;
    addr[7] = 1 as u8;
    if { bind(fd, { #addr_of(addr[0]) }, 16 as u32) } != (0 as i32) {
        { close(fd); }
        return - 2 as i32;
    }
    if { listen(fd, 4 as i32) } != (0 as i32) {
        { close(fd); }
        return - 3 as i32;
    }
    return fd;
}

// Accept and serve, one connection at a time, forever — the same loop
// `serve_uds` runs, over the same `serve_fd`. Nothing about the protocol knows
// which transport carried it.
fn serve_tcp(
    surf: *u8,
    vt: backend::Backend,
    ref sub: events::Subscriber,
    policy: fn(auth::Request) -> auth::Grant,
    port: u16,
) -> i32 {
    let fd: i32 = bind_tcp(port);
    if fd < (0 as i32) { return fd; }
    loop {
        if thread::park_begin() {
            thread::park_end();
            break;                          // cancelled while about to accept
        }
        let conn: i32 = { accept(fd, 0 as *u8, 0 as *u32) };
        thread::park_end();
        if conn < (0 as i32) {
            if netsys::errno() == netsys::eintr() { continue; }
            break;
        }
        // A CLIENT GOING AWAY MUST NOT KILL THE SERVER. Without this, a
        // write to a disconnected client raises SIGPIPE, whose default
        // disposition terminates the process — no crash report, no log, the
        // whole application gone because an agent pressed ^C on a `nc`.
        // See netsys::set_nosigpipe and
        // demo/bugs/02-iris-terminated-without-crash-report.md.
        let _np: i32 = netsys::set_nosigpipe(conn);
        let served: i32 = serve_fd(surf, vt, sub, policy, conn);
        { close(conn); }
        if served == (1 as i32) {
            break;                          // cancelled mid-connection
        }
    }
    { close(fd); }
    return 0;
}

extern fn setsockopt(fd: i32, level: i32, name: i32, val: *u8, len: u32) -> i32;

// ---- tests for the TCP transport ---------------------------------------------

#[test]
fn a_loopback_listener_binds_and_closes() {
    // Port 0 asks the kernel for a free one, which is the only port a test may
    // take: a fixed number is a test that fails when something else is running.
    let fd: i32 = bind_tcp(0 as u16);
    assert fd >= (0 as i32);
    { close(fd); }
    return;
}

#[test]
fn the_port_is_written_big_endian() {
    var buf: [u8; 16] = [0 as u8; 16];
    put_be16(buf, 2 as usize, 8123 as u16);
    // 8123 = 0x1FBB, so the high byte comes first on the wire.
    assert buf[2] == (0x1F as u8);
    assert buf[3] == (0xBB as u8);
    return;
}

#[test]
fn two_listeners_on_one_port_is_a_bind_error() {
    let a: i32 = bind_tcp(0 as u16);
    assert a >= (0 as i32);
    // A second bind on a port the kernel chose cannot be attempted without
    // reading it back, so this asserts the shape that IS reachable: a
    // privileged port refuses, and the code says which step failed.
    let b: i32 = bind_tcp(1 as u16);
    assert b == (0 as i32 - (2 as i32));
    { close(a); }
    return;
}

// ---- tests -------------------------------------------------------------------
// Dispatch-level: a fake vtable proves the wire behavior without a backend.

static FAKE_SURF: i32 = 0;

fn fake_node(id: str) -> backend::UiNode {
    return backend::UiNode {
        id: text::from_str(id),
        role: identity::Role::Button,
        class_name: text::new(),
        frame: backend::Rect { x: 11.0f64, y: 22.0f64, w: 33.0f64, h: 44.0f64 },
        is_hidden: false,
        text: text::new(),
        name: text::from_str("Do the thing"),
        description: text::from_str("does the thing"),
        tier: identity::tier_open(),
        readable: true,
        actionable: true,
        clickable: true,
        wired: option::Option[bool]::Some(true),
        parent: option::Option[usize]::None,
    };
}

// The same node with its content declared sensitive: present, named, and with
// nothing to say about what is in it.
fn fake_secret_node(id: str, grant: auth::Grant) -> backend::UiNode {
    let may_read: bool = grant.has(auth::cap_read() | auth::cap_read_protected());
    return backend::UiNode {
        id: text::from_str(id),
        role: identity::Role::Input,
        class_name: text::new(),
        frame: backend::Rect { x: 0.0f64, y: 0.0f64, w: 200.0f64, h: 24.0f64 },
        is_hidden: false,
        text: if may_read { text::from_str("4242424242424242") } else { text::new() },
        name: text::from_str("Card number"),
        description: text::new(),
        tier: identity::tier_protected(),
        readable: may_read,
        actionable: grant.has(auth::cap_act() | auth::cap_act_protected()),
        clickable: false,
        wired: option::Option[bool]::Some(false),
        parent: option::Option[usize]::None,
    };
}

// Two nodes that say nothing, for two different reasons. The walked view lists
// both — same role, same empty `text` — and a client has to be able to tell
// "this label is blank" from "this content is not yours".
fn fake_blank_node(id: str, readable: bool) -> backend::UiNode {
    return backend::UiNode {
        id: text::from_str(id),
        role: identity::Role::Text,
        class_name: text::new(),
        frame: backend::Rect { x: 0.0f64, y: 0.0f64, w: 120.0f64, h: 18.0f64 },
        is_hidden: false,
        text: text::new(),
        name: text::new(),
        description: text::new(),
        tier: identity::tier_open(),
        readable: readable,
        actionable: false,
        clickable: false,
        wired: option::Option[bool]::Some(false),
        parent: option::Option[usize]::None,
    };
}

fn fake_describe_full(p: *u8, grant: auth::Grant) -> vec::Vec[backend::UiNode] {
    var out: vec::Vec[backend::UiNode] = vec::new::[backend::UiNode]();
    out.append(fake_node("exposed-node"));
    out.append(fake_node("structural-node"));
    out.append(fake_secret_node("payment:card", grant));
    out.append(fake_blank_node("empty-label", true));
    out.append(fake_blank_node("assistant:line", false));
    return out;
}

fn fake_describe_exposed(p: *u8, grant: auth::Grant) -> vec::Vec[backend::UiNode] {
    var out: vec::Vec[backend::UiNode] = vec::new::[backend::UiNode]();
    out.append(fake_node("exposed-node"));
    // A gated node is EXPOSED. It belongs in the curated view — that is the
    // whole difference between this and simply not tagging the field.
    out.append(fake_secret_node("payment:card", grant));
    return out;
}

fn fake_click(p: *u8, grant: auth::Grant, id: str) -> surface::Outcome { return surface::Outcome::Allowed; }
fn fake_set_text(p: *u8, grant: auth::Grant, id: str, v: str, base: u64) -> surface::Outcome {
    if id == "payment:card" {
        if grant.has(auth::cap_act() | auth::cap_act_protected()) { return surface::Outcome::Allowed; }
        return surface::Outcome::NeedsGrant;
    }
    if id == "payment:cvc" {
        if grant.has(auth::cap_act() | auth::cap_act_private()) { return surface::Outcome::Allowed; }
        return surface::Outcome::Forbidden;
    }
    return surface::Outcome::Allowed;
}
fn fake_nav(p: *u8, grant: auth::Grant, id: str) -> surface::Outcome { return surface::Outcome::Allowed; }

// Three shapes the wire has to carry distinctly: reachable, covered by an
// EXPOSED node (named), and covered by one that is not (fact without identity).
fn fake_hit_test(p: *u8, grant: auth::Grant, id: str) -> surface::HitTest {
    if id == "buried" {
        return surface::HitTest {
            outcome: surface::Outcome::Allowed, supported: true,
            reachable: false, covered: true, covered_by: text::from_str("overlay-node"),
        };
    }
    if id == "buried-anon" {
        return surface::HitTest {
            outcome: surface::Outcome::Allowed, supported: true,
            reachable: false, covered: true, covered_by: text::new(),
        };
    }
    return surface::HitTest {
        outcome: surface::Outcome::Allowed, supported: true,
        reachable: true, covered: false, covered_by: text::new(),
    };
}

fn fake_set_caret(p: *u8, grant: auth::Grant, id: str, at: u64, length: u64) -> surface::Outcome {
    if id == "label" { return surface::Outcome::NotActionable; }
    return surface::Outcome::Allowed;
}

// Two runs and a gap: one coloured and bold, one carrying nothing of its own.
fn fake_read_runs(p: *u8, grant: auth::Grant, id: str) -> surface::Runs {
    if id == "not-text" { return surface::runs_refused(surface::Outcome::Allowed, false); }
    if id == "payment:card" {
        if !grant.has(auth::cap_read() | auth::cap_read_protected()) {
            return surface::runs_refused(surface::Outcome::NeedsGrant, true);
        }
    }
    var runs: vec::Vec[surface::TextRun] = vec::new::[surface::TextRun]();
    runs.append(surface::TextRun {
        start: 0 as u64, length: 3 as u64, color: text::from_str("#ff0000"),
        is_bold: true, is_italic: false, is_underlined: false,
    });
    runs.append(surface::TextRun {
        start: 3 as u64, length: 4 as u64, color: text::new(),
        is_bold: false, is_italic: false, is_underlined: false,
    });
    return surface::Runs {
        outcome: surface::Outcome::Allowed, supported: true, runs: runs,
    };
}

fn fake_invoke_menu(p: *u8, grant: auth::Grant, path: str) -> surface::Outcome {
    if path == "File/Save" { return surface::Outcome::Allowed; }
    if path == "File/Greyed" { return surface::Outcome::NotActionable; }
    return surface::Outcome::NotFound;
}

fn fake_backend() -> backend::Backend {
    return backend::Backend {
        describe: fake_describe_full,
        describe_exposed: fake_describe_exposed,
        click: fake_click,
        set_text: fake_set_text,
        navigate: fake_nav,
        hit_test: fake_hit_test,
        set_caret: fake_set_caret,
        read_runs: fake_read_runs,
        invoke_menu: fake_invoke_menu,
    };
}

fn allow_all(req: auth::Request) -> auth::Grant { return auth::operator(); }

// The grant an app mints once the user has approved autofill.
fn allow_protected(req: auth::Request) -> auth::Grant { return auth::protected_operator(); }

// Nothing at all — an un-served surface, or a caller the policy does not know.
fn allow_nothing(req: auth::Request) -> auth::Grant { return auth::nothing(); }

// ---- MCP framing -------------------------------------------------------------

fn ext_probe(method: str, params: json::Value, id: f64, grant: auth::Grant) -> json::Value {
    return ok_response(id, jstr("ext"));
}

fn ext_describes_two() -> vec::Vec[json::Value] {
    var out: vec::Vec[json::Value] = vec::new::[json::Value]();
    out.append(tool("probe.one", "first", no_props(), no_required()));
    out.append(tool("probe.two", "second", no_props(), required1("x")));
    return out;
}

#[test]
fn an_mcp_client_can_complete_a_handshake() {
    // THE BUG THIS PINS. The package was called agent_mcp and did not speak
    // MCP: `initialize` is the first message every client sends, it took -32601,
    // and the client gave up — so no MCP client could reach a facet app at all.
    var sub: events::Subscriber = events::subscriber(events::everything(), 4 as usize);
    let surf: *u8 = #addr_of(FAKE_SURF) as *u8;
    let r: text::Text = handle_request(surf, fake_backend(), sub, auth::serve(allow_all),
        "{\"jsonrpc\":\"2.0\",\"method\":\"initialize\",\"params\":{\"protocolVersion\":\"2024-11-05\"},\"id\":1}");
    assert r.contains("protocolVersion");
    assert r.contains("serverInfo");
    assert r.contains("capabilities");
    assert r.contains("32601") == false;
}

#[test]
fn tools_list_describes_every_verb_including_an_extensions() {
    // The half that earns MCP its keep: a client learns the verb exists AND how
    // to call it from the wire, instead of the caller having to already know.
    var sub: events::Subscriber = events::subscriber(events::everything(), 4 as usize);
    let surf: *u8 = #addr_of(FAKE_SURF) as *u8;
    disarm_extension();
    let bare: text::Text = handle_request(surf, fake_backend(), sub, auth::serve(allow_all),
        "{\"method\":\"tools/list\",\"id\":1}");
    assert bare.contains("describe_ui");
    assert bare.contains("inputSchema");
    assert bare.contains("poll_event");
    assert bare.contains("probe.one") == false;

    // A NAMESPACE ANSWERS FOR ITSELF. This module must not know what an
    // extension is; without a describer the twelve inspector verbs would be
    // invisible to exactly the clients that need telling.
    arm_extension("probe.", ext_probe, ext_describes_two);
    let armed: text::Text = handle_request(surf, fake_backend(), sub, auth::serve(allow_all),
        "{\"method\":\"tools/list\",\"id\":2}");
    assert armed.contains("describe_ui");
    assert armed.contains("probe.one");
    assert armed.contains("probe.two");
    disarm_extension();
}

#[test]
fn an_extension_armed_without_a_describer_still_works() {
    // Honest degradation: the verbs answer, they are simply not listed. A
    // describer is what makes a namespace discoverable, not what makes it run.
    var sub: events::Subscriber = events::subscriber(events::everything(), 4 as usize);
    let surf: *u8 = #addr_of(FAKE_SURF) as *u8;
    arm_extension("probe.", ext_probe);
    let listed: text::Text = handle_request(surf, fake_backend(), sub, auth::serve(allow_all),
        "{\"method\":\"tools/list\",\"id\":1}");
    assert listed.contains("probe.one") == false;
    let called: text::Text = handle_request(surf, fake_backend(), sub, auth::serve(allow_all),
        "{\"method\":\"probe.anything\",\"id\":2}");
    assert called.contains("ext");
    disarm_extension();
}

#[test]
fn tools_call_reaches_the_same_verb_the_flat_name_does() {
    // One verb table, two spellings. This is what let the whole existing client
    // base — iris's 42-flow board sweep among them — keep working unchanged.
    var sub: events::Subscriber = events::subscriber(events::everything(), 4 as usize);
    let surf: *u8 = #addr_of(FAKE_SURF) as *u8;
    let flat: text::Text = handle_request(surf, fake_backend(), sub, auth::serve(allow_all),
        "{\"method\":\"describe_ui\",\"params\":{\"mode\":\"full\"},\"id\":1}");
    let wrapped: text::Text = handle_request(surf, fake_backend(), sub, auth::serve(allow_all),
        "{\"method\":\"tools/call\",\"params\":{\"name\":\"describe_ui\",\"arguments\":{\"mode\":\"full\"}},\"id\":2}");
    assert flat.contains("structural-node");
    // Same answer, inside an MCP content block rather than bare.
    assert wrapped.contains("structural-node");
    assert wrapped.contains("content");
    assert wrapped.contains("isError");
}

#[test]
fn a_tools_call_error_stays_an_error() {
    // Flattening a refusal into a successful content block would hide exactly
    // the diagnosable ones — a missing parameter, a denied consent.
    var sub: events::Subscriber = events::subscriber(events::everything(), 4 as usize);
    let surf: *u8 = #addr_of(FAKE_SURF) as *u8;
    let missing: text::Text = handle_request(surf, fake_backend(), sub, auth::serve(allow_all),
        "{\"method\":\"tools/call\",\"params\":{\"name\":\"click\",\"arguments\":{}},\"id\":1}");
    assert missing.contains("32602");
    assert missing.contains("missing required parameter");
    assert missing.contains("isError") == false;
    // `tools/` is this layer's own namespace, not a verb — no reaching the
    // framing through itself.
    let loop_: text::Text = handle_request(surf, fake_backend(), sub, auth::serve(allow_all),
        "{\"method\":\"tools/call\",\"params\":{\"name\":\"tools/call\",\"arguments\":{}},\"id\":2}");
    assert loop_.contains("is not a tool");
}

#[test]
fn a_notification_is_answered_with_silence() {
    // A message with no `id` is a notification and JSON-RPC has always said it
    // gets no reply. Nothing here sent one because nothing sent notifications —
    // and then MCP's handshake ends with `notifications/initialized`, so the
    // first well-behaved client would have been handed a response it never
    // asked for, carrying "id": 0, which it may treat as a protocol violation.
    var sub: events::Subscriber = events::subscriber(events::everything(), 4 as usize);
    let surf: *u8 = #addr_of(FAKE_SURF) as *u8;
    let quiet: text::Text = handle_request(surf, fake_backend(), sub, auth::serve(allow_all),
        "{\"jsonrpc\":\"2.0\",\"method\":\"notifications/initialized\"}");
    assert quiet.count() == (0 as usize);
    // An id present, even on the same method name, is a request and is answered.
    let loud: text::Text = handle_request(surf, fake_backend(), sub, auth::serve(allow_all),
        "{\"jsonrpc\":\"2.0\",\"method\":\"notifications/initialized\",\"id\":7}");
    assert loud.count() > (0 as usize);
}

#[test]
fn the_framing_is_behind_consent_like_everything_else() {
    // A closed surface should LOOK closed: an app that never armed a policy
    // refuses the handshake rather than advertising a verb list it will not
    // honour.
    var sub: events::Subscriber = events::subscriber(events::everything(), 4 as usize);
    let surf: *u8 = #addr_of(FAKE_SURF) as *u8;
    let init: text::Text = handle_request(surf, fake_backend(), sub, auth::serve(allow_nothing),
        "{\"method\":\"initialize\",\"id\":1}");
    assert init.contains("consent denied");
    let list: text::Text = handle_request(surf, fake_backend(), sub, auth::serve(allow_nothing),
        "{\"method\":\"tools/list\",\"id\":2}");
    assert list.contains("consent denied");
}

#[test]
fn describe_ui_mode_selects_the_view() {
    var sub: events::Subscriber = events::subscriber(events::everything(), 4 as usize);
    let surf: *u8 = #addr_of(FAKE_SURF) as *u8;
    // Default (no mode): the curated exposed view.
    let r1: text::Text = handle_request(surf, fake_backend(), sub, auth::serve(allow_all), "{\"method\":\"describe_ui\",\"id\":1}");
    assert r1.contains("exposed-node");
    assert r1.contains("structural-node") == false;
    assert r1.contains("does the thing");   // description rides the wire
    // An explicit "exposed" reads the same.
    let r2: text::Text = handle_request(surf, fake_backend(), sub, auth::serve(allow_all), "{\"method\":\"describe_ui\",\"params\":{\"mode\":\"exposed\"},\"id\":2}");
    assert r2.contains("exposed-node");
    assert r2.contains("structural-node") == false;
    // "full" opts into the whole walked tree.
    let r3: text::Text = handle_request(surf, fake_backend(), sub, auth::serve(allow_all), "{\"method\":\"describe_ui\",\"params\":{\"mode\":\"full\"},\"id\":3}");
    assert r3.contains("exposed-node");
    assert r3.contains("structural-node");
}

#[test]
fn the_three_verbs_that_turn_i_believe_into_i_checked() {
    // Every one of these is a place the surface could not reach, and every one
    // is exactly where unverified work had to be handed over: no verb placed a
    // CARET, so a symbol command could not be aimed; none read back ATTRIBUTED
    // RUNS, so "did the syntax colour land" needed a probe compiled into the
    // app four separate times; and none invoked a MENU ITEM, so every key
    // equivalent rested on a link nothing here could drive.
    var sub: events::Subscriber = events::subscriber(events::everything(), 4 as usize);
    let surf: *u8 = #addr_of(FAKE_SURF) as *u8;

    let caret: text::Text = handle_request(surf, fake_backend(), sub, auth::serve(allow_all),
        "{\"method\":\"set_caret\",\"params\":{\"id\":\"editor\",\"at\":12},\"id\":1}");
    assert caret.contains("allowed");
    // A control whose drive is not text refuses rather than no-ops.
    let refused: text::Text = handle_request(surf, fake_backend(), sub, auth::serve(allow_all),
        "{\"method\":\"set_caret\",\"params\":{\"id\":\"label\",\"at\":0},\"id\":2}");
    assert refused.contains("not_actionable");

    let runs: text::Text = handle_request(surf, fake_backend(), sub, auth::serve(allow_all),
        "{\"method\":\"read_runs\",\"params\":{\"id\":\"editor\"},\"id\":3}");
    assert runs.contains("#ff0000");
    assert runs.contains("\"bold\":true");
    assert runs.contains("\"supported\":true");
    // A run with no colour of its own omits the key rather than sending "",
    // which would read as a colour nobody set.
    assert runs.contains("\"color\":\"\"") == false;

    let menu: text::Text = handle_request(surf, fake_backend(), sub, auth::serve(allow_all),
        "{\"method\":\"invoke_menu\",\"params\":{\"path\":\"File/Save\"},\"id\":4}");
    assert menu.contains("allowed");
    // A greyed item is NOT actionable, and a missing one is not found — the
    // same two words a node gets.
    let greyed: text::Text = handle_request(surf, fake_backend(), sub, auth::serve(allow_all),
        "{\"method\":\"invoke_menu\",\"params\":{\"path\":\"File/Greyed\"},\"id\":5}");
    assert greyed.contains("not_actionable");
    let nope: text::Text = handle_request(surf, fake_backend(), sub, auth::serve(allow_all),
        "{\"method\":\"invoke_menu\",\"params\":{\"path\":\"File/Nope\"},\"id\":6}");
    assert nope.contains("not_found");
}

#[test]
fn a_backend_that_cannot_answer_says_so_rather_than_guessing() {
    // `supported: false` is the honest answer, and it is a different answer
    // from "no runs" — the distinction the `clickable` field was added to make.
    var sub: events::Subscriber = events::subscriber(events::everything(), 4 as usize);
    let surf: *u8 = #addr_of(FAKE_SURF) as *u8;
    let r: text::Text = handle_request(surf, fake_backend(), sub, auth::serve(allow_all),
        "{\"method\":\"read_runs\",\"params\":{\"id\":\"not-text\"},\"id\":1}");
    assert r.contains("\"supported\":false");
    assert r.contains("\"runs\":[]");
}

// NEGATIVE: both new verbs name the parameter they are missing, because a
// driver that sends the wrong one otherwise gets a clean-looking sweep in which
// nothing happened. `click` taking `id` and not `key`, and `set_text` taking
// `value` and not `text`, each cost a full round of measuring an app that was
// not responding to anything.
#[test]
fn the_new_verbs_name_the_parameter_they_are_missing() {
    var sub: events::Subscriber = events::subscriber(events::everything(), 4 as usize);
    let surf: *u8 = #addr_of(FAKE_SURF) as *u8;
    let a: text::Text = handle_request(surf, fake_backend(), sub, auth::serve(allow_all),
        "{\"method\":\"set_caret\",\"params\":{\"id\":\"editor\"},\"id\":1}");
    assert a.contains("at");
    let b: text::Text = handle_request(surf, fake_backend(), sub, auth::serve(allow_all),
        "{\"method\":\"invoke_menu\",\"params\":{},\"id\":2}");
    assert b.contains("path");
    let c: text::Text = handle_request(surf, fake_backend(), sub, auth::serve(allow_all),
        "{\"method\":\"read_runs\",\"params\":{},\"id\":3}");
    assert c.contains("id");
}

#[test]
fn only_the_measured_view_carries_geometry() {
    // bugs/facet-trailing-padding-lost-in-native-placement.md: the curated view
    // reports identity, not layout. It must OMIT `frame` rather than serialize
    // `{0,0,0,0}` — placeholder zeros read as a measurement the backend got
    // wrong, and sent one investigation looking for a placement bug that was
    // not there. The fixture carries a distinctive frame so "dropped" and
    // "carried" are told apart by the numbers, not by their absence upstream.
    var sub: events::Subscriber = events::subscriber(events::everything(), 4 as usize);
    let surf: *u8 = #addr_of(FAKE_SURF) as *u8;

    let lean: text::Text = handle_request(surf, fake_backend(), sub, auth::serve(allow_all), "{\"method\":\"describe_ui\",\"params\":{\"mode\":\"exposed\"},\"id\":1}");
    assert lean.contains("exposed-node");
    assert lean.contains("\"frame\"") == false;
    assert lean.contains("\"class\"") == false;
    // ...and specifically not as zeros, which is what used to go out.
    assert lean.contains("\"w\":0") == false;

    let full: text::Text = handle_request(surf, fake_backend(), sub, auth::serve(allow_all), "{\"method\":\"describe_ui\",\"params\":{\"mode\":\"full\"},\"id\":2}");
    assert full.contains("\"frame\"");
    assert full.contains("\"class\"");
    assert full.contains("33");        // the fixture's width survives the wire
    assert full.contains("44");        // ...and its height
}

// ---- hit_test on the wire ------------------------------------------------------

#[test]
fn hit_test_carries_reachability_and_names_only_exposed_obstructions() {
    var sub: events::Subscriber = events::subscriber(events::everything(), 4 as usize);
    let surf: *u8 = #addr_of(FAKE_SURF) as *u8;

    let ok: text::Text = handle_request(surf, fake_backend(), sub, auth::serve(allow_all),
        "{\"method\":\"hit_test\",\"params\":{\"id\":\"btn\"},\"id\":1}");
    assert ok.contains("\"reachable\":true");
    assert ok.contains("\"covered\":false");
    assert ok.contains("\"supported\":true");
    assert ok.contains("allowed");
    // Nothing on top ⇒ no `covered_by` key at all, rather than an empty id
    // (which would read as "covered by something with no name").
    assert ok.contains("covered_by") == false;

    // Covered by an EXPOSED node: the id goes out.
    let buried: text::Text = handle_request(surf, fake_backend(), sub, auth::serve(allow_all),
        "{\"method\":\"hit_test\",\"params\":{\"id\":\"buried\"},\"id\":2}");
    assert buried.contains("\"reachable\":false");
    assert buried.contains("\"covered\":true");
    assert buried.contains("overlay-node");

    // Covered by one that is NOT exposed: the fact travels, the identity does not.
    let anon: text::Text = handle_request(surf, fake_backend(), sub, auth::serve(allow_all),
        "{\"method\":\"hit_test\",\"params\":{\"id\":\"buried-anon\"},\"id\":3}");
    assert anon.contains("\"covered\":true");
    assert anon.contains("covered_by") == false;

    // Addressed by id like every other verb — a missing one is refused, so no
    // caller can slide into a point-addressed reading of this.
    let bad: text::Text = handle_request(surf, fake_backend(), sub, auth::serve(allow_all),
        "{\"method\":\"hit_test\",\"params\":{},\"id\":4}");
    assert bad.contains("-32602");
    assert bad.contains("hit_test");
    return;
}

// The consent gate covers it like every other verb: an un-served (deny-all)
// policy must refuse hit_test too, or it would be a read that bypasses consent.
#[test]
fn hit_test_is_behind_the_consent_gate() {
    var sub: events::Subscriber = events::subscriber(events::everything(), 4 as usize);
    let surf: *u8 = #addr_of(FAKE_SURF) as *u8;
    let denied: text::Text = handle_request(surf, fake_backend(), sub, auth::deny_all(),
        "{\"method\":\"hit_test\",\"params\":{\"id\":\"btn\"},\"id\":1}");
    assert denied.contains("-32001");
    assert denied.contains("reachable") == false;
    return;
}

// ---- required parameters ------------------------------------------------------

// A misspelled parameter name used to be indistinguishable from a working call.
// Every reader here falls back — "" for text, 0 for numbers — so `set_text` sent
// with `text:` instead of `value:` answered {"outcome":"allowed"} and wrote an
// empty string. From the caller's side that is exactly what a working call to
// clear a field looks like, so the app appeared broken and the RPC appeared
// fine. Absent is now refused; an explicit empty string still clears.
#[test]
fn a_misspelled_set_text_parameter_is_refused_not_silently_emptied() {
    var sub: events::Subscriber = events::subscriber(events::everything(), 4 as usize);
    let surf: *u8 = #addr_of(FAKE_SURF) as *u8;

    // THE TRAP: `text` instead of `value`. Must not report success.
    let wrong: text::Text = handle_request(surf, fake_backend(), sub, auth::serve(allow_all),
        "{\"method\":\"set_text\",\"params\":{\"id\":\"n\",\"text\":\"hello\"},\"id\":1}");
    assert wrong.contains("-32602");
    assert wrong.contains("value");        // names the parameter it wanted
    assert wrong.contains("set_text");     // ...and the method that wanted it
    assert wrong.contains("allowed") == false;

    // Clearing a field is a legitimate call and still goes through: the check is
    // ABSENT vs present, not empty vs non-empty.
    let clear: text::Text = handle_request(surf, fake_backend(), sub, auth::serve(allow_all),
        "{\"method\":\"set_text\",\"params\":{\"id\":\"n\",\"value\":\"\"},\"id\":2}");
    assert clear.contains("allowed");
    assert clear.contains("-32602") == false;

    // And a correct call is unaffected.
    let good: text::Text = handle_request(surf, fake_backend(), sub, auth::serve(allow_all),
        "{\"method\":\"set_text\",\"params\":{\"id\":\"n\",\"value\":\"hello\"},\"id\":3}");
    assert good.contains("allowed");
    return;
}

// The same fallback hid a missing target on every verb that takes one. A
// missing `id` reported "not found", which reads as "your id was wrong" rather
// than "you sent no id" — the same wrong-diagnosis cost, one step smaller.
#[test]
fn every_verb_that_takes_a_target_requires_one() {
    var sub: events::Subscriber = events::subscriber(events::everything(), 4 as usize);
    let surf: *u8 = #addr_of(FAKE_SURF) as *u8;

    let c: text::Text = handle_request(surf, fake_backend(), sub, auth::serve(allow_all),
        "{\"method\":\"click\",\"params\":{},\"id\":1}");
    assert c.contains("-32602");
    assert c.contains("click");
    assert c.contains("id");

    let s: text::Text = handle_request(surf, fake_backend(), sub, auth::serve(allow_all),
        "{\"method\":\"scroll_to\",\"params\":{},\"id\":2}");
    assert s.contains("-32602");
    assert s.contains("scroll_to");

    let t: text::Text = handle_request(surf, fake_backend(), sub, auth::serve(allow_all),
        "{\"method\":\"set_text\",\"params\":{\"value\":\"x\"},\"id\":3}");
    assert t.contains("-32602");
    assert t.contains("id");

    // No params object at all is the same answer, not a crash.
    let none: text::Text = handle_request(surf, fake_backend(), sub, auth::serve(allow_all),
        "{\"method\":\"click\",\"id\":4}");
    assert none.contains("-32602");

    // Verbs that take no target are untouched.
    let p: text::Text = handle_request(surf, fake_backend(), sub, auth::serve(allow_all),
        "{\"method\":\"poll_event\",\"id\":5}");
    assert p.contains("-32602") == false;
    return;
}

// ---- the extension namespace ---------------------------------------------------

// A stand-in for a real extension (the live inspector is the one this exists
// for). It answers its own methods and records that it was reached, so a test
// can tell "routed here" from "answered by the surface".
static EXT_CALLS: i32 = 0;

fn fake_extension(method: str, params: json::Value, id: f64, grant: auth::Grant) -> json::Value {
    EXT_CALLS = EXT_CALLS + 1;
    var m: vec::Vec[json::Member] = vec::new::[json::Member]();
    m.append(member("from", jstr("extension")));
    m.append(member("method", jstr(method)));
    // Echoed so a test can assert the namespace was told WHO is asking, not
    // merely that someone was admitted.
    m.append(member("may_edit_tree", jbool(grant.has(auth::cap_edit_tree()))));
    return ok_response(id, json::Value::Object(m));
}

#[test]
fn an_unarmed_extension_namespace_is_simply_not_there() {
    disarm_extension();
    var sub: events::Subscriber = events::subscriber(events::everything(), 4 as usize);
    let surf: *u8 = #addr_of(FAKE_SURF) as *u8;
    assert extension_armed() == false;

    // Present in the binary is not the same as exposed. A process that never
    // armed the namespace does not serve it.
    let r: text::Text = handle_request(surf, fake_backend(), sub, auth::serve(allow_all),
        "{\"method\":\"inspector.describe\",\"id\":1}");
    assert r.contains("-32601");
    // ...and it names the method, so a missing `arm_extension` does not read as
    // a protocol mismatch.
    assert r.contains("inspector.describe");
    assert r.contains("extension") == false;
    return;
}

#[test]
fn an_armed_namespace_routes_its_own_methods_and_leaves_the_surface_alone() {
    disarm_extension();
    EXT_CALLS = 0;
    var sub: events::Subscriber = events::subscriber(events::everything(), 4 as usize);
    let surf: *u8 = #addr_of(FAKE_SURF) as *u8;

    arm_extension("inspector.", fake_extension);
    assert extension_armed();

    let r: text::Text = handle_request(surf, fake_backend(), sub, auth::serve(allow_all),
        "{\"method\":\"inspector.describe\",\"id\":1}");
    assert r.contains("\"from\":\"extension\"");
    assert EXT_CALLS == 1;

    // The agent surface is untouched by the arming: same methods, same answers,
    // and the extension never sees them.
    let d: text::Text = handle_request(surf, fake_backend(), sub, auth::serve(allow_all),
        "{\"method\":\"describe_ui\",\"id\":2}");
    assert d.contains("exposed-node");
    assert d.contains("extension") == false;
    assert EXT_CALLS == 1;

    // A method that merely resembles the prefix is not in it.
    let n: text::Text = handle_request(surf, fake_backend(), sub, auth::serve(allow_all),
        "{\"method\":\"inspector\",\"id\":3}");
    assert n.contains("-32601");
    assert EXT_CALLS == 1;

    disarm_extension();
    assert extension_armed() == false;
    let after: text::Text = handle_request(surf, fake_backend(), sub, auth::serve(allow_all),
        "{\"method\":\"inspector.describe\",\"id\":4}");
    assert after.contains("-32601");
    assert EXT_CALLS == 1;
    return;
}

// Arming opens a namespace, not a way around consent. An extension is strictly
// more powerful than the agent surface, so a gate that stopped covering it
// would be the one place the whole permission model leaks.
#[test]
fn the_consent_gate_covers_the_extension_namespace_too() {
    disarm_extension();
    EXT_CALLS = 0;
    var sub: events::Subscriber = events::subscriber(events::everything(), 4 as usize);
    let surf: *u8 = #addr_of(FAKE_SURF) as *u8;
    arm_extension("inspector.", fake_extension);

    let denied: text::Text = handle_request(surf, fake_backend(), sub, auth::deny_all(),
        "{\"method\":\"inspector.describe\",\"id\":1}");
    assert denied.contains("-32001");
    assert denied.contains("extension") == false;
    // Refused BEFORE the handler ran, not after it answered.
    assert EXT_CALLS == 0;

    disarm_extension();
    return;
}

// The prefix is owned, so a caller that composes one is not punished for it.
// A `str` static here would be a borrowed {ptr,len} into a Text that is gone by
// the first request — sound for a literal, a use-after-free for anything else.
#[test]
fn a_composed_prefix_survives_the_call_that_armed_it() {
    disarm_extension();
    EXT_CALLS = 0;
    var sub: events::Subscriber = events::subscriber(events::everything(), 4 as usize);
    let surf: *u8 = #addr_of(FAKE_SURF) as *u8;

    var built: text::Text = text::from_str("insp");
    let _a: status::Status = built.append("ector.");
    arm_extension(built.view(), fake_extension);
    // The Text that supplied it is finished with here; the prefix must not be.
    built = text::from_str("clobbered");

    let r: text::Text = handle_request(surf, fake_backend(), sub, auth::serve(allow_all),
        "{\"method\":\"inspector.set\",\"id\":1}");
    assert r.contains("\"from\":\"extension\"");
    assert EXT_CALLS == 1;

    disarm_extension();
    return;
}

// ---- socket teardown ---------------------------------------------------------
// bugs/agent-socket-never-unlinked.md

#[link_name = "access"]
extern fn file_access(path: *u8, mode: i32) -> i32;

// F_OK = 0 — does the path exist?
fn path_exists(path: str) -> bool {
    var buf: [u8; 110] = [0 as u8; 110];
    let n: usize = #str_len(path);
    let p: *u8 = #str_ptr(path);
    var i: usize = 0 as usize;
    while i < n {
        buf[i] = { *(p + i) };
        i = i +% (1 as usize);
    }
    buf[n] = 0 as u8;
    return { file_access(#addr_of(buf[0]), 0 as i32) } == (0 as i32);
}

// Binding creates a file on disk, and it must be removed on the way out. The
// teardown that shipped sat after `serve_uds`'s accept loop, which never
// returns in a real app, so nothing ever ran it: every launch leaked one socket
// (46 of them measured in /tmp before this was fixed).
//
// This covers the mechanism — bind arms the cleanup, teardown removes the file,
// and a second call is harmless. That the hook also fires on process EXIT is
// `atexit`'s contract and cannot be asserted from inside the process; it is
// checked by building a binary that binds on a worker and returns from `main`
// with the worker still parked in `accept`.
#[test]
fn binding_arms_the_socket_cleanup() {
    let path: str = "/tmp/cplus-agent-mcp-teardown-test.sock";
    let fd: i32 = bind_uds(path);
    assert fd >= (0 as i32);
    assert path_exists(path);

    unlink_bound_socket();
    assert path_exists(path) == false;

    // Idempotent: the explicit teardown and the exit hook both call it, and a
    // double-unlink must not take out an unrelated file that reused the path.
    unlink_bound_socket();
    assert path_exists(path) == false;

    { close(fd); }
    return;
}

// A path longer than `sun_path` is rejected before any syscall, and rejecting
// it must not disturb a cleanup already armed for a different socket.
#[test]
fn an_over_long_path_is_rejected_without_disarming() {
    let good: str = "/tmp/cplus-agent-mcp-armed.sock";
    let fd: i32 = bind_uds(good);
    assert fd >= (0 as i32);
    assert path_exists(good);

    var long_path: text::Text = text::from_str("/tmp/");
    var i: i32 = 0 as i32;
    while i < (110 as i32) {
        let _a: status::Status = long_path.append("x");
        i = i +% (1 as i32);
    }
    assert bind_uds(long_path.view()) == (- 4 as i32);

    // Still armed for `good`, and teardown still removes it.
    unlink_bound_socket();
    assert path_exists(good) == false;
    { close(fd); }
    return;
}

// A socket file left by a process that died without running its exit hook —
// SIGKILL, or a hard crash — must not block the next launch. Nobody is
// listening on it, so binding the same path removes the leftover and succeeds.
// This is the half of the cleanup `atexit` structurally cannot cover.
#[test]
fn a_stale_socket_file_is_reclaimed_by_the_next_bind() {
    let path: str = "/tmp/cplus-agent-mcp-stale.sock";
    let dead: i32 = bind_uds(path);
    assert dead >= (0 as i32);
    assert path_exists(path);

    // Drop the fd WITHOUT unlinking: exactly the state a killed process leaves,
    // a file on disk with no listener behind it. (No `listen` was called
    // either, so the path was never answering.)
    { close(dead); }
    assert path_exists(path);

    let fresh: i32 = bind_uds(path);
    assert fresh >= (0 as i32);
    assert path_exists(path);

    unlink_bound_socket();
    assert path_exists(path) == false;
    { close(fresh); }
    return;
}

// The other half: a path a LIVE server is answering on must be refused, not
// taken over. Unlinking blind would leave the running instance accepting on an
// fd no client can reach, and the new process bound to a file of the same name
// — two servers, one path, and every agent reaching only the newcomer. The
// per-PID convention makes this collision rare; the probe is what makes a
// FIXED path safe, and what keeps the stale-file cleanup above from being a
// hijack in disguise.
#[test]
fn a_live_server_keeps_its_socket_against_a_second_bind() {
    let path: str = "/tmp/cplus-agent-mcp-live.sock";
    let live: i32 = bind_uds(path);
    assert live >= (0 as i32);
    assert { listen(live, 4 as i32) } == (0 as i32);   // now it ANSWERS connect
    assert path_exists(path);

    // Second bind sees a peer on the path and stands down.
    assert bind_uds(path) == (- 5 as i32);
    // The live socket's file is untouched — the loser removed nothing.
    assert path_exists(path);

    // And the refusal did not re-arm the cleanup onto some other path: teardown
    // still targets the live socket, which is what this process actually owns.
    unlink_bound_socket();
    assert path_exists(path) == false;
    { close(live); }
    return;
}

#[test]
fn a_gated_node_is_on_the_wire_with_its_name_and_no_value() {
    // The two halves of the ask, both asserted here: the model LEARNS the card
    // field exists (id, role, name, position in the tree) and CANNOT read it.
    var sub: events::Subscriber = events::subscriber(events::everything(), 4 as usize);
    let surf: *u8 = #addr_of(FAKE_SURF) as *u8;
    let r: text::Text = handle_request(surf, fake_backend(), sub, auth::serve(allow_all),
        "{\"method\":\"describe_ui\",\"id\":1}");
    assert r.contains("payment:card");           // it is there
    assert r.contains("Card number");            // and it says what it is
    assert r.contains("\"tier\":\"protected\""); // and which gate it is behind
    assert r.contains("\"readable\":false");     // and that this agent is outside it
    assert r.contains("4242") == false;
    return;
}

#[test]
fn the_grant_the_policy_returns_is_what_reaches_the_backend() {
    // The seam the whole model rests on: the policy's answer is threaded into
    // the verb, so the SAME request against the SAME surface answers differently
    // for two credentials. If this ever stops holding, every tier above it is
    // decoration.
    var sub: events::Subscriber = events::subscriber(events::everything(), 4 as usize);
    let surf: *u8 = #addr_of(FAKE_SURF) as *u8;
    let plain: text::Text = handle_request(surf, fake_backend(), sub, auth::serve(allow_all),
        "{\"method\":\"describe_ui\",\"id\":1}");
    assert plain.contains("\"readable\":false");
    assert plain.contains("4242") == false;

    let approved: text::Text = handle_request(surf, fake_backend(), sub,
        auth::serve(allow_protected), "{\"method\":\"describe_ui\",\"id\":2}");
    assert approved.contains("\"readable\":true");
    assert approved.contains("4242424242424242");
    // The DECLARATION does not change with the grant — the field is still a
    // protected one, it is just one this agent may now read.
    assert approved.contains("\"tier\":\"protected\"");
    return;
}

#[test]
fn ask_and_stop_are_different_words_on_the_wire() {
    // `not_actionable` means "not right now" and an agent retries it;
    // `version_conflict` means "re-read and try again", which is worse. A
    // refusal on a card field has to be legible as either "ask the user" or
    // "this is never coming", or the model spends its turn arguing with a form.
    var sub: events::Subscriber = events::subscriber(events::everything(), 4 as usize);
    let surf: *u8 = #addr_of(FAKE_SURF) as *u8;
    let card: text::Text = handle_request(surf, fake_backend(), sub, auth::serve(allow_all),
        "{\"method\":\"set_text\",\"params\":{\"id\":\"payment:card\",\"value\":\"4242424242424242\"},\"id\":1}");
    assert card.contains("needs_grant");
    assert card.contains("version_conflict") == false;
    // The CVC is Private: the app declares the tier and never mints the bit,
    // so even the widest grant it hands out gets `forbidden`.
    let cvc: text::Text = handle_request(surf, fake_backend(), sub, auth::serve(allow_protected),
        "{\"method\":\"set_text\",\"params\":{\"id\":\"payment:cvc\",\"value\":\"999\"},\"id\":2}");
    assert cvc.contains("forbidden");
    assert cvc.contains("needs_grant") == false;
    // The attribute-run read is a content read too — a length is a leak.
    let runs: text::Text = handle_request(surf, fake_backend(), sub, auth::serve(allow_all),
        "{\"method\":\"read_runs\",\"params\":{\"id\":\"payment:card\"},\"id\":3}");
    assert runs.contains("needs_grant");
    return;
}
#[test]
fn every_outcome_has_its_own_word_on_the_wire() {
    // The fall-through in `outcome_to_str` reports anything unnamed as
    // `version_conflict`, which tells an agent to re-read and try again. That
    // is a loop, not an answer — so every outcome must be named, and this test
    // is what makes "must" enforceable. It caught `no_handler` being reported
    // as a version conflict the first time it was added.
    assert outcome_to_str(surface::Outcome::Allowed) == "allowed";
    assert outcome_to_str(surface::Outcome::NotFound) == "not_found";
    assert outcome_to_str(surface::Outcome::NotExposed) == "not_exposed";
    assert outcome_to_str(surface::Outcome::NotActionable) == "not_actionable";
    assert outcome_to_str(surface::Outcome::Stale) == "stale";
    assert outcome_to_str(surface::Outcome::NeedsGrant) == "needs_grant";
    assert outcome_to_str(surface::Outcome::Forbidden) == "forbidden";
    assert outcome_to_str(surface::Outcome::NoHandler) == "no_handler";
    assert outcome_to_str(surface::Outcome::VersionConflict) == "version_conflict";
    return;
}


#[test]
fn the_full_view_is_not_a_way_around_a_tier() {
    // `mode: full` is a parameter the agent chooses. A gate that only held in
    // the curated view would hold exactly until a model tried the other one.
    var sub: events::Subscriber = events::subscriber(events::everything(), 4 as usize);
    let surf: *u8 = #addr_of(FAKE_SURF) as *u8;
    let r: text::Text = handle_request(surf, fake_backend(), sub, auth::serve(allow_all),
        "{\"method\":\"describe_ui\",\"params\":{\"mode\":\"full\"},\"id\":1}");
    assert r.contains("payment:card");
    assert r.contains("\"tier\":\"protected\"");
    assert r.contains("4242") == false;
    return;
}

#[test]
fn a_blank_text_says_whether_it_was_withheld() {
    // iris/components.txt: `text: ""` was the answer to two different
    // questions and nothing on the wire separated them. `readable` used to ride
    // along only on a TIERED node, so the walked view's other blank — a node
    // inside an excluded subtree — went out character-for-character like a
    // label that is genuinely empty, and a model reading it fills in the form
    // field that is not there.
    var sub: events::Subscriber = events::subscriber(events::everything(), 4 as usize);
    let surf: *u8 = #addr_of(FAKE_SURF) as *u8;
    let r: text::Text = handle_request(surf, fake_backend(), sub, auth::serve(allow_all),
        "{\"method\":\"describe_ui\",\"params\":{\"mode\":\"full\"},\"id\":1}");
    // The withheld one says so, and without inventing a tier it does not have.
    assert r.contains("\"id\":\"assistant:line\",\"role\":\"text\"");
    assert r.contains("\"text\":\"\",\"readable\":false");
    // The genuinely empty one stays quiet — the field is absent, which is what
    // keeps it meaningful where it does appear.
    assert r.contains("\"id\":\"empty-label\"");
    assert r.contains("\"text\":\"\",\"actionable\":false");
    return;
}

#[test]
fn an_empty_grant_is_refused_once_rather_than_per_verb() {
    // A policy that returns nothing has said the caller is not an agent of
    // this application at all. That is a connection-level answer, not
    // seventeen per-node ones.
    var sub: events::Subscriber = events::subscriber(events::everything(), 4 as usize);
    let surf: *u8 = #addr_of(FAKE_SURF) as *u8;
    let r: text::Text = handle_request(surf, fake_backend(), sub, auth::serve(allow_nothing),
        "{\"method\":\"describe_ui\",\"id\":1}");
    assert r.contains("consent denied");
    assert r.contains("exposed-node") == false;
    return;
}

// A policy shaped like real middleware: verify the credential in your own code
// (here, a string compare standing in for a signature check), then say what its
// claims amount to.
fn token_policy(req: auth::Request) -> auth::Grant {
    if req.token == "autofill-approved" { return auth::protected_operator(); }
    if req.token == "session-abc" { return auth::operator(); }
    return auth::nothing();
}

#[test]
fn the_request_carries_a_credential_the_policy_can_read() {
    // agent_core deliberately never parses a token — no crypto, no clock, no
    // identity provider. It carries the bytes to the developer's policy and
    // takes back a Grant. This is the seam a JWT middleware plugs into.
    var sub: events::Subscriber = events::subscriber(events::everything(), 4 as usize);
    let surf: *u8 = #addr_of(FAKE_SURF) as *u8;
    let none: text::Text = handle_request(surf, fake_backend(), sub, auth::serve(token_policy),
        "{\"method\":\"describe_ui\",\"id\":1}");
    assert none.contains("consent denied");

    let session: text::Text = handle_request(surf, fake_backend(), sub, auth::serve(token_policy),
        "{\"method\":\"describe_ui\",\"params\":{\"token\":\"session-abc\"},\"id\":2}");
    assert session.contains("exposed-node");
    assert session.contains("4242") == false;

    let approved: text::Text = handle_request(surf, fake_backend(), sub, auth::serve(token_policy),
        "{\"method\":\"describe_ui\",\"params\":{\"token\":\"autofill-approved\"},\"id\":3}");
    assert approved.contains("4242424242424242");
    return;
}

fn allow_builder(req: auth::Request) -> auth::Grant {
    return auth::operator().with(auth::cap_edit_tree());
}

#[test]
fn an_extension_namespace_is_told_which_capabilities_the_caller_has() {
    // The inspector rides this hook, and its verbs REWRITE THE UI — insert,
    // remove, reparent, set any property. A namespace that only learned
    // "consent was not empty" would make every credential equal inside it, so
    // an agent granted a look at the app could rebuild it.
    disarm_extension();
    var sub: events::Subscriber = events::subscriber(events::everything(), 4 as usize);
    let surf: *u8 = #addr_of(FAKE_SURF) as *u8;
    arm_extension("inspector.", fake_extension);

    let plain: text::Text = handle_request(surf, fake_backend(), sub, auth::serve(allow_all),
        "{\"method\":\"inspector.describe\",\"id\":1}");
    assert plain.contains("\"may_edit_tree\":false");

    let builder: text::Text = handle_request(surf, fake_backend(), sub, auth::serve(allow_builder),
        "{\"method\":\"inspector.describe\",\"id\":2}");
    assert builder.contains("\"may_edit_tree\":true");
    disarm_extension();
    return;
}

// ---- cancellation of the transport parks -------------------------------------

extern fn pipe(fds: *i32) -> i32;
extern fn usleep(us: u32) -> i32;

// Parks in read_line on a pipe nobody writes — the exact shape the
// cancellation report filed against this package ("a worker parked in
// read_line on a socket nobody will write to again is parked for the life
// of the process"). Only `JoinHandle::cancel` ends it; 11 is the cancel path.
fn _read_line_until_cancelled(take rfd: i64) -> i64 {
    var buf: [u8; 64] = [0 as u8; 64];
    let len: i64 = read_line(rfd as i32, { #addr_of(buf[0]) }, 64 as usize);
    if len == (- 2 as i64) { return 11 as i64; }
    return len;
}

#[test]
fn read_line_reports_cancellation_instead_of_parking_forever() {
    var fds: [i32; 2] = [0, 0];
    assert { pipe(#addr_of(fds[0])) } == 0;
    let h: thread::JoinHandle[i64] =
        thread::spawn_with::[i64, i64](fds[0] as i64, _read_line_until_cancelled);
    usleep(3000 as u32);
    h.cancel();
    assert h.join() == (11 as i64);
    { close(fds[0]); }
    { close(fds[1]); }
    return;
}

extern fn socketpair(domain: i32, ty: i32, proto: i32, fds: *i32) -> i32;

// A client that goes away mid-response must not take the SERVER with it.
// `write_all` is the response path; with the peer closed it has to return
// having written nothing, leaving this process alive to serve the next
// client. Before the fix this raised SIGPIPE and terminated the host
// application silently — no crash report, buffered output lost — which is
// how an IDE and the app under test were both lost to one `pkill` of a
// stray `nc` (demo/bugs/02-iris-terminated-without-crash-report.md).
//
// Self-proving: a regression KILLS this test process rather than failing an
// assertion, and the suite reports the signal.
#[test]
fn write_all_to_a_departed_client_does_not_kill_the_server() {
    var fds: [i32; 2] = [0, 0];
    assert { socketpair(1 as i32, 1 as i32, 0 as i32, #addr_of(fds[0])) } == 0;
    let _np: i32 = netsys::set_nosigpipe(fds[0]);
    { close(fds[1]); }                          // the client disconnects
    var buf: [u8; 16] = [65 as u8; 16];
    var i: i32 = 0;
    while i < 4 {
        write_all(fds[0], { #addr_of(buf[0]) }, 16 as usize);
        i = i +% 1;
    }
    { close(fds[0]); }
    assert true;                                // reached = we survived
    return;
}

// ---- describe_ui `prefix` (demo/bugs/04-describe-verbs-cannot-be-scoped) -----

fn fake_child_node(id: str, parent: usize) -> backend::UiNode {
    var n: backend::UiNode = fake_node(id);
    n.parent = option::Option[usize]::Some(parent);
    return n;
}

// A tree with real depth, so the `parent` renumbering has something to get
// wrong: window > board > (col:1 > card:1), (detail:3 > detail:title).
fn nested_describe(p: *u8, grant: auth::Grant) -> vec::Vec[backend::UiNode] {
    var out: vec::Vec[backend::UiNode] = vec::new::[backend::UiNode]();
    out.append(fake_node("window"));                          // 0
    out.append(fake_child_node("board", 0 as usize));         // 1
    out.append(fake_child_node("board:col:1", 1 as usize));   // 2
    out.append(fake_child_node("board:card:1", 2 as usize));  // 3
    out.append(fake_child_node("board:detail:3", 1 as usize));        // 4
    out.append(fake_child_node("board:detail:title", 4 as usize));    // 5
    return out;
}

fn nested_backend() -> backend::Backend {
    var b: backend::Backend = fake_backend();
    b.describe = nested_describe;
    b.describe_exposed = nested_describe;
    return b;
}

#[test]
fn describe_ui_prefix_narrows_the_answer() {
    // The question that started the incident: "is there a board:detail:* node,
    // and what is its id?" — asked without paying for the whole tree.
    var sub: events::Subscriber = events::subscriber(events::everything(), 4 as usize);
    let surf: *u8 = #addr_of(FAKE_SURF) as *u8;
    let scoped: text::Text = handle_request(surf, nested_backend(), sub, auth::serve(allow_all),
        "{\"method\":\"describe_ui\",\"params\":{\"prefix\":\"board:detail:\"},\"id\":1}");
    assert scoped.contains("board:detail:3");
    assert scoped.contains("board:detail:title");
    // Everything outside the prefix is gone — including the ancestors, which is
    // the entire point: they are what makes the whole-tree answer expensive.
    assert scoped.contains("board:col:1") == false;
    assert scoped.contains("board:card:1") == false;
    assert scoped.contains("\"window\"") == false;
}

#[test]
fn describe_ui_without_a_prefix_is_unchanged() {
    // The parameter is optional and the default answer must not move.
    var sub: events::Subscriber = events::subscriber(events::everything(), 4 as usize);
    let surf: *u8 = #addr_of(FAKE_SURF) as *u8;
    let all: text::Text = handle_request(surf, nested_backend(), sub, auth::serve(allow_all),
        "{\"method\":\"describe_ui\",\"id\":1}");
    assert all.contains("window");
    assert all.contains("board:col:1");
    assert all.contains("board:detail:title");
    // An explicit empty prefix means the same thing as none.
    let empty: text::Text = handle_request(surf, nested_backend(), sub, auth::serve(allow_all),
        "{\"method\":\"describe_ui\",\"params\":{\"prefix\":\"\"},\"id\":2}");
    assert empty.contains("window");
    assert empty.contains("board:col:1");
}

#[test]
fn a_filtered_answer_renumbers_parent_into_itself() {
    // `parent` is an INDEX INTO THE ANSWER. Filtering shortens the array, so
    // carrying the walked tree's indices through would point each node at
    // whatever now sits at that offset — a wrong parent, silently, which is
    // worse than no parent at all.
    //
    // Here `board:detail:3` (walked index 4) and `board:detail:title` (5) come
    // back as 0 and 1. The title's parent must be 0 — the detail node's new
    // position — and the detail node, whose own parent `board` was filtered
    // out, must come back parentless rather than pointing at index 1.
    var sub: events::Subscriber = events::subscriber(events::everything(), 4 as usize);
    let surf: *u8 = #addr_of(FAKE_SURF) as *u8;
    let scoped: text::Text = handle_request(surf, nested_backend(), sub, auth::serve(allow_all),
        "{\"method\":\"describe_ui\",\"params\":{\"prefix\":\"board:detail:\"},\"id\":1}");
    assert scoped.contains("\"parent\":null");
    assert scoped.contains("\"parent\":0");
    // 4 and 5 were the WALKED indices; neither may survive into a 2-node answer.
    assert scoped.contains("\"parent\":4") == false;
    assert scoped.contains("\"parent\":5") == false;
}

#[test]
fn a_deeper_match_reattaches_to_the_nearest_surviving_ancestor() {
    // `board:` keeps the board and everything under it but drops `window`.
    // The board's parent is gone, so it comes back parentless; its children
    // keep pointing at it through its NEW index.
    var sub: events::Subscriber = events::subscriber(events::everything(), 4 as usize);
    let surf: *u8 = #addr_of(FAKE_SURF) as *u8;
    let scoped: text::Text = handle_request(surf, nested_backend(), sub, auth::serve(allow_all),
        "{\"method\":\"describe_ui\",\"params\":{\"prefix\":\"board\"},\"id\":1}");
    assert scoped.contains("\"window\"") == false;
    assert scoped.contains("board:card:1");
    // board=0, col:1=1, card:1=2, detail:3=3, detail:title=4.
    assert scoped.contains("\"parent\":null");   // board itself
    assert scoped.contains("\"parent\":1");      // card under col
    assert scoped.contains("\"parent\":3");      // title under detail
}

#[test]
fn the_prefix_parameter_is_advertised() {
    // A parameter no client is told about is a parameter no client uses, and
    // this one exists precisely because agents were reaching for workarounds.
    var sub: events::Subscriber = events::subscriber(events::everything(), 4 as usize);
    let surf: *u8 = #addr_of(FAKE_SURF) as *u8;
    let tools: text::Text = handle_request(surf, fake_backend(), sub, auth::serve(allow_all),
        "{\"method\":\"tools/list\",\"id\":1}");
    assert tools.contains("prefix");
    // And it says whose UI it answers for — the confusion that cost an agent
    // its first three calls (06 A.1).
    assert tools.contains("APPLICATION SERVING THIS ENDPOINT");
}

#[test]
fn not_found_carries_a_hint_pointing_somewhere() {
    // `{"outcome":"not_found"}` alone is a dead end; the two causes it conflates
    // (a stale id, and driving the wrong application) need different next moves.
    var sub: events::Subscriber = events::subscriber(events::everything(), 4 as usize);
    let surf: *u8 = #addr_of(FAKE_SURF) as *u8;
    let miss: text::Text = handle_request(surf, fake_backend(), sub, auth::serve(allow_all),
        "{\"method\":\"invoke_menu\",\"params\":{\"path\":\"File/Nope\"},\"id\":1}");
    assert miss.contains("not_found");
    assert miss.contains("hint");
    assert miss.contains("File/Nope");           // names what was not found
    assert miss.contains("own agent endpoint");  // and where else to look
    // The hint rides the failure only — a success carries no such freight.
    let hit: text::Text = handle_request(surf, fake_backend(), sub, auth::serve(allow_all),
        "{\"method\":\"invoke_menu\",\"params\":{\"path\":\"File/Save\"},\"id\":2}");
    assert hit.contains("allowed");
    assert hit.contains("hint") == false;
}
