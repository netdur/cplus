// Both halves in one build, so the seam is checked rather than assumed: the
// facade declares `_c_*` and the backend exports them, and only a link proves
// the two agree.

import "stdlib/option" as option;
import "stdlib/result" as result;
import "permissions/permissions" as perm;
import "./location" as loc;
import "./location_backend" as backend;

// ---- the vocabulary --------------------------------------------------------

#[test]
fn accuracy_codes_round_trip() {
    assert loc::Accuracy::from_code(loc::Accuracy::Coarse.to_code()).to_code()
        == loc::Accuracy::Coarse.to_code();
    assert loc::Accuracy::from_code(loc::Accuracy::Balanced.to_code()).to_code()
        == loc::Accuracy::Balanced.to_code();
    assert loc::Accuracy::from_code(loc::Accuracy::Fine.to_code()).to_code()
        == loc::Accuracy::Fine.to_code();
    assert loc::Accuracy::from_code(loc::Accuracy::Navigation.to_code()).to_code()
        == loc::Accuracy::Navigation.to_code();
}

#[test]
fn an_unknown_accuracy_code_falls_back_to_fine_not_to_garbage() {
    // A newer backend answering a tier this build has no name for must not
    // produce an enum value outside the four — it degrades to the middle of
    // the useful range instead.
    assert loc::Accuracy::from_code(99).to_code() == loc::Accuracy::Fine.to_code();
    assert loc::Accuracy::from_code(-7).to_code() == loc::Accuracy::Fine.to_code();
}

#[test]
fn the_outcomes_are_distinct() {
    // Denied and Disabled in particular: they need different things said to a
    // person, and a backend that conflated them would be invisible here if
    // they shared a code.
    assert loc::Outcome::Ok.to_code() == 0;
    assert loc::Outcome::Denied.to_code() != loc::Outcome::Disabled.to_code();
    assert loc::Outcome::Denied.to_code() != loc::Outcome::Unsupported.to_code();
    assert loc::Outcome::Timeout.to_code() != loc::Outcome::Failed.to_code();
}

// ---- the fix's unknowns ----------------------------------------------------

fn _blank_fix() -> loc::Fix {
    return loc::Fix {
        latitude: 0.0f64, longitude: 0.0f64,
        accuracy_m: -1.0f64,
        altitude_m: 0.0f64, altitude_accuracy_m: -1.0f64,
        speed_mps: -1.0f64, course_deg: -1.0f64,
        timestamp_ms: 0 as i64,
    };
}

#[test]
fn a_negative_accuracy_means_the_coordinate_is_not_a_fix() {
    var f: loc::Fix = _blank_fix();
    // THE POINT: CoreLocation hands back an object with a (0,0) coordinate and
    // a negative accuracy when it has nothing. Trusting lat/lon without this
    // check puts the caller in the Gulf of Guinea.
    assert !f.is_valid();
    f.accuracy_m = 12.0f64;
    assert f.is_valid();
}

#[test]
fn the_unknowns_are_reported_as_unknown_rather_than_as_zero() {
    var f: loc::Fix = _blank_fix();
    assert !f.has_speed();
    assert !f.has_course();
    assert !f.has_altitude();
    // Zero is a REAL reading for all three — a stationary device at sea level
    // due north — so they must not be confused with absent.
    f.speed_mps = 0.0f64;
    f.course_deg = 0.0f64;
    f.altitude_accuracy_m = 0.0f64;
    assert f.has_speed();
    assert f.has_course();
    assert f.has_altitude();
}

// ---- the request -----------------------------------------------------------

#[test]
fn the_default_request_is_the_cheap_one() {
    let r: loc::Request = loc::Request::new();
    // Balanced, not Fine: the default must not switch a GPS radio on for an
    // app that only wanted to know which city it is in.
    assert r.accuracy.to_code() == loc::Accuracy::Balanced.to_code();
    assert r.distance_filter_m == (0.0 as f64);
    assert r.timeout_ms == (0 as i64);
}

#[test]
fn a_request_carries_what_it_was_given() {
    let r: loc::Request = loc::Request::new(accuracy: loc::Accuracy::Navigation,
                                            distance_filter_m: 25.0f64,
                                            timeout_ms: 5000 as i64);
    assert r.accuracy.to_code() == loc::Accuracy::Navigation.to_code();
    assert r.distance_filter_m == (25.0 as f64);
    assert r.timeout_ms == (5000 as i64);
}

// ---- the platform ----------------------------------------------------------

#[test]
fn corelocation_is_present_on_this_host() {
    // e2e through the seam: this reaches the backend, which asks the ObjC
    // runtime for CLLocationManager. It is the check that would fail if the
    // facade and backend disagreed about the symbol.
    assert loc::available();
}

#[test]
fn the_system_switch_answers_without_trapping() {
    // Its VALUE is the machine's business — a build machine may have location
    // services off. That it answers at all is the contract.
    let on: bool = loc::services_enabled();
    assert on || !on;
}

#[test]
fn last_known_is_none_or_a_valid_fix_never_a_bogus_one() {
    match loc::last_known() {
        // Unauthorized or cold, which is the ordinary case in a test runner.
        option::Option[loc::Fix]::None => { }
        // If one comes back it must be usable — the backend rejects an object
        // with negative accuracy rather than passing it through.
        option::Option[loc::Fix]::Some(f) => { assert f.is_valid(); }
    }
}

// ---- negatives -------------------------------------------------------------

fn _never_called(f: loc::Fix, ctx: *u8) { return; }

#[test]
fn a_null_handler_is_refused_rather_than_dispatched_into() {
    let nil: fn(loc::Fix, *u8) = 0 as fn(loc::Fix, *u8);
    assert loc::once(on_fix: nil).to_code() == loc::Outcome::Failed.to_code();
    match loc::updates(on_fix: nil) {
        result::Result[loc::Updates, loc::Outcome]::Ok(_u) => { assert false; }
        result::Result[loc::Updates, loc::Outcome]::Err(e) => {
            assert e.to_code() == loc::Outcome::Failed.to_code();
        }
    }
}

#[test]
fn a_stopped_stream_stays_stopped_and_stopping_twice_is_inert() {
    match loc::updates(on_fix: _never_called) {
        result::Result[loc::Updates, loc::Outcome]::Ok(u) => {
            var up: loc::Updates = u;
            up.stop();
            assert !up.is_running();
            // Idempotent: `stop` also runs from `drop`, so the second call is
            // the NORMAL path and must not double-release the manager.
            up.stop();
            assert !up.is_running();
        }
        result::Result[loc::Updates, loc::Outcome]::Err(e) => {
            // Denied or Disabled on a machine without permission. Both are
            // real answers; what must not happen is a crash.
            assert e.to_code() != loc::Outcome::Ok.to_code();
        }
    }
}

// ---- the permission read ---------------------------------------------------

#[test]
fn permission_answers_a_known_state_without_starting_anything() {
    let st = loc::permission();
    // Any of the five is a legitimate answer here — a build machine may be
    // denied, unasked, or have no CoreLocation at all. What must not happen is
    // a trap, and what must not be assumed is that Unknown means denied.
    assert st.to_code() >= 0;
}

#[test]
fn unknown_is_not_denied() {
    // THE TRAP THIS GUARDS: `notDetermined` and `denied` are different answers
    // and the platforms resolve the first asynchronously. An app that folded
    // them together would never raise a prompt — it would decide it had
    // already been refused.
    assert perm::State::Unknown.to_code() != perm::State::Denied.to_code();
    assert perm::State::Unknown.to_code() != perm::State::Blocked.to_code();
}

#[test]
fn a_failed_one_shot_is_delivered_as_an_invalid_fix() {
    // The contract `once` documents: the handler runs either way, and a fix
    // that never arrived is spelled with a negative accuracy rather than by
    // silence. This pins the SHAPE of that answer — the live path needs a
    // device indoors, which a unit test cannot arrange.
    var miss: loc::Fix = #zero::[loc::Fix]();
    miss.accuracy_m = -1.0f64;
    assert !miss.is_valid();
    // And a caller checking `is_valid` first is safe from the (0,0) that a
    // zeroed fix would otherwise read as the Gulf of Guinea.
    assert miss.latitude == (0.0 as f64);
    assert miss.longitude == (0.0 as f64);
}
