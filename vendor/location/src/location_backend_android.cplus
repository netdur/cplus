// Android's LocationManager, through a small Java listener.
//
// The Java half exists because `LocationListener` is an INTERFACE and JNI
// cannot implement one. `java/cplus/location/CplusLocation.java` is that
// class, and `location.dex` is it compiled — a COMMITTED BUILD ARTIFACT that
// `tools/build_dex.sh` regenerates. Editing the .java changes nothing until
// that runs.
//
// ---- what differs from Apple ------------------------------------------------
//
//   permission   Android THROWS from `requestLocationUpdates` when the grant is
//                missing; it never prompts. Asking is the app's job, before
//                this. Apple prompts on first use. Same package, two models.
//   timeout      honoured here, because the framework has no non-deprecated
//                single-update-with-deadline; the Java half posts its own.
//   accuracy     read from the granted PERMISSION, since Android 12+ lets a
//                person grant approximate while a fine request still succeeds.

import "stdlib/option" as option;
import "stdlib/box" as box;
import "jni/jni" as jni;
import "android_view/runtime" as rt;
import "facet/app_events" as ev;
import "./location" as loc;

const _DEX_LEN: usize = 4948;

// The loaded class, held as a GLOBAL ref for the process. Never `FindClass` by
// name at call time: a class from an InMemoryDexClassLoader is invisible to
// `FindClass`, which searches only the app's own loader.
static _C_LOCATION: usize = 0;
static _LOADER: usize = 0;

// One live request per handle, keyed by a token the Java side echoes back —
// the native callback is static, so the token is how a fix finds its session.
struct _Session {
    token: i64,
    obj: usize,
    on_fix: fn(loc::Fix, *u8),
    opaque ctx: *u8,
    running: bool,
    status: i64,
}

const _MAX_SESSIONS: usize = 8 as usize;
static _SESSIONS: [usize; 8] = #zero::[[usize; 8]]();
static _NEXT_TOKEN: i64 = 1 as i64;

fn _remember(s: *_Session) -> bool {
    var i: usize = 0 as usize;
    while i < _MAX_SESSIONS {
        if _SESSIONS[i] == 0 { _SESSIONS[i] = { #addr(s) }; return true; }
        i = i + (1 as usize);
    }
    return false;
}

fn _forget(s: *_Session) {
    var i: usize = 0 as usize;
    while i < _MAX_SESSIONS {
        if _SESSIONS[i] == { #addr(s) } { _SESSIONS[i] = 0; return; }
        i = i + (1 as usize);
    }
    return;
}

fn _by_token(token: i64) -> *_Session {
    var i: usize = 0 as usize;
    while i < _MAX_SESSIONS {
        let raw: usize = _SESSIONS[i];
        if raw != 0 {
            let s: *_Session = { raw as *_Session };
            if { (*s).token } == token { return s; }
        }
        i = i + (1 as usize);
    }
    return 0 as *_Session;
}

// ---- the JNI record for our one native -------------------------------------
//
// `(JDDDDDFFJ)V` — token, lat, lon, accuracy, altitude, altitudeAccuracy,
// speed, course, timeMs. Written out rather than built, because a JNINativeMethod
// is three pointers with a fixed layout and #[repr(C)] is what makes that true
// across the boundary.
#[repr(C)]
struct _NativeFix {
    opaque name: *u8,
    opaque signature: *u8,
    fn_ptr: fn(*jni::JNIEnv, jni::jobject, i64, f64, f64, f64, f64, f64, f32, f32, i64),
}

fn _context() -> jni::jobject {
    return { ev::host() as jni::jobject };
}

fn _ensure_loaded(env: rt::Env) -> bool {
    if _LOADER != 0 { return _C_LOCATION != 0; }

    // MERGED FIRST. An app whose build fed `location.dex` to `d8` alongside its
    // own classes already has this class, and loading the in-memory copy too
    // would give the process two — natives bound on one, instances of the
    // other, and `nativeFix` never arriving.
    let merged: jni::jclass = env.find_class(#str_ptr("cplus/location/CplusLocation\0"));
    if merged != (0 as jni::jclass) {
        _C_LOCATION = { #addr(env.retain_local_as_global(merged)) };
        _LOADER = 1 as usize;
        _bind_natives(env);
        return true;
    }
    // Not an error: an app that did not merge is the ordinary case. Clear the
    // pending NoClassDefFoundError rather than leaving it for the next call.
    env.clear_exception();

    let dex: *[u8; 4948] = #include_bytes("../location.dex");
    let buffer: jni::jobject = {
        (*(*env.raw())).NewDirectByteBuffer(env.raw(), { dex as *u8 }, _DEX_LEN as i64)
    };
    let app_loader: jni::jobject = env.call_object_0(
        _context(), #str_ptr("android/content/Context\0"), #str_ptr("getClassLoader\0"),
        #str_ptr("()Ljava/lang/ClassLoader;\0"));

    let imdcl: jni::jclass = env.find_class(#str_ptr("dalvik/system/InMemoryDexClassLoader\0"));
    let ctor: jni::jmethodID = env.method_id(imdcl, #str_ptr("<init>\0"),
        #str_ptr("(Ljava/nio/ByteBuffer;Ljava/lang/ClassLoader;)V\0"));
    var ctor_args: [jni::JValue; 2] = [jni::arg_object(buffer), jni::arg_object(app_loader)];
    let loader: jni::jobject = {
        (*(*env.raw())).NewObjectA(env.raw(), imdcl, ctor, #addr_of(ctor_args[0]))
    };
    if loader == (0 as jni::jobject) { env.clear_exception(); return false; }
    _LOADER = { #addr(env.new_global_ref(loader)) };

    let name: jni::jstring = env.new_string_utf(#str_ptr("cplus.location.CplusLocation\0"));
    let local: jni::jobject = env.call_object_1(
        loader, #str_ptr("java/lang/ClassLoader\0"), #str_ptr("loadClass\0"),
        #str_ptr("(Ljava/lang/String;)Ljava/lang/Class;\0"), jni::arg_object(name));
    if local == (0 as jni::jobject) { env.clear_exception(); return false; }
    _C_LOCATION = { #addr(env.new_global_ref(local)) };

    _bind_natives(env);

    env.delete_local_ref(local);
    env.delete_local_ref(name);
    env.delete_local_ref(loader);
    env.delete_local_ref(imdcl);
    env.delete_local_ref(app_loader);
    env.delete_local_ref(buffer);
    return true;
}

// ART resolves a `native` method by symbol only through a classloader's own
// native-library namespace, which an in-memory loader does not have — and
// `nativeFix` is private besides. Explicit binding is not optional.
fn _bind_natives(env: rt::Env) {
    var rec: _NativeFix = _NativeFix {
        name: #str_ptr("nativeFix\0"),
        signature: #str_ptr("(JDDDDDFFJ)V\0"),
        fn_ptr: _location_android_fix,
    };
    let _r: i32 = { (*(*env.raw())).RegisterNatives(env.raw(), { _C_LOCATION as *u8 },
                                                    #addr_of(rec) as *u8, 1) };
    return;
}

// NOT `export`ed, and camera's naming pass is why: `RegisterNatives` takes a
// function POINTER, not a linker symbol, so exporting it publishes a name
// nothing resolves by name.
//
// A fix crossed from Java. Already on the MAIN LOOPER — the Java half asked
// for updates on it — so the package's "fixes arrive on the main thread"
// contract holds without a hop.
fn _location_android_fix(envp: *jni::JNIEnv, cls: jni::jobject,
                                       token: i64, lat: f64, lon: f64,
                                       accuracy: f64, altitude: f64,
                                       altitude_accuracy: f64,
                                       speed: f32, course: f32, time_ms: i64) {
    let s: *_Session = _by_token(token);
    if s.is_null() { return; }
    if !{ (*s).running } { return; }
    let f: fn(loc::Fix, *u8) = { (*s).on_fix };
    if f.is_null() { return; }
    var fix: loc::Fix = loc::Fix {
        latitude: lat,
        longitude: lon,
        accuracy_m: accuracy,
        altitude_m: altitude,
        altitude_accuracy_m: altitude_accuracy,
        speed_mps: { speed as f64 },
        course_deg: { course as f64 },
        timestamp_ms: time_ms,
    };
    f(fix, { (*s).ctx });
    return;
}

// ---- the seam --------------------------------------------------------------

// ATTACHED AS A DAEMON, because a fix can be delivered on a thread this
// package does not own and a non-daemon attachment would hold the VM open past
// it. The same reasoning `camera` records for its photo callback.
fn _env() -> rt::Env {
    let vm: *jni::JavaVM = { ev::host_runtime() as *jni::JavaVM };
    if vm.is_null() { return rt::from_native(0 as *jni::JNIEnv); }
    var envp: *jni::JNIEnv = 0 as *jni::JNIEnv;
    let rc: i32 = { (*(*vm)).AttachCurrentThreadAsDaemon(vm, { #addr_of(envp) as *u8 },
                                                         0 as *u8) };
    if rc != (0 as i32) { return rt::from_native(0 as *jni::JNIEnv); }
    return rt::from_native(envp);
}

// A build with no Activity and no VM is a build with no facet backend — a
// headless tool that linked this package. `Unsupported` is the honest answer.
fn _env_ready() -> option::Option[rt::Env] {
    if !ev::has_host_runtime() { return option::Option[rt::Env]::None; }
    if !ev::has_host() { return option::Option[rt::Env]::None; }
    let env: rt::Env = _env();
    if env.raw().is_null() { return option::Option[rt::Env]::None; }
    if !_ensure_loaded(env) { return option::Option[rt::Env]::None; }
    return option::Option[rt::Env]::Some(env);
}

export extern fn _c_available() -> i32 {
    match _env_ready() {
        option::Option[rt::Env]::Some(_e) => { return 1; }
        option::Option[rt::Env]::None => { return 0; }
    }
}

// PERMISSION IS THE APP'S JOB HERE, which is the opposite of Apple. Android
// throws from `requestLocationUpdates` rather than prompting, so this only
// REPORTS — `permissions::request` is what asks.
export extern fn _c_permission() -> i32 {
    match _env_ready() {
        option::Option[rt::Env]::None => { return 5; }
        option::Option[rt::Env]::Some(env) => {
            let ctx: jni::jobject = _context();
            if ctx == (0 as jni::jobject) { return 5; }
            let fine: jni::jstring = env.new_string_utf(
                #str_ptr("android.permission.ACCESS_FINE_LOCATION\0"));
            let coarse: jni::jstring = env.new_string_utf(
                #str_ptr("android.permission.ACCESS_COARSE_LOCATION\0"));
            let f: i32 = env.call_int_1(ctx, #str_ptr("android/content/Context\0"),
                #str_ptr("checkSelfPermission\0"), #str_ptr("(Ljava/lang/String;)I\0"),
                jni::arg_object(fine));
            let c: i32 = env.call_int_1(ctx, #str_ptr("android/content/Context\0"),
                #str_ptr("checkSelfPermission\0"), #str_ptr("(Ljava/lang/String;)I\0"),
                jni::arg_object(coarse));
            env.delete_local_ref(fine);
            env.delete_local_ref(coarse);
            // PERMISSION_GRANTED is 0.
            if f == 0 { return 1; }
            // COARSE ALONE IS STILL GRANTED. Android 12+ lets a person give
            // approximate location, and refusing to run at all would be worse
            // than running at the tier they allowed — `Updates::accuracy()` is
            // where that shows up honestly.
            if c == 0 { return 1; }
            return 0;
        }
    }
}

export extern fn _c_enabled() -> i32 {
    match _env_ready() {
        option::Option[rt::Env]::None => { return 0; }
        option::Option[rt::Env]::Some(env) => {
            let ctx: jni::jobject = _context();
            if ctx == (0 as jni::jobject) { return 0; }
            let name: jni::jstring = env.new_string_utf(#str_ptr("location\0"));
            let mgr: jni::jobject = env.call_object_1(ctx,
                #str_ptr("android/content/Context\0"), #str_ptr("getSystemService\0"),
                #str_ptr("(Ljava/lang/String;)Ljava/lang/Object;\0"),
                jni::arg_object(name));
            env.delete_local_ref(name);
            if mgr == (0 as jni::jobject) { return 0; }
            // Raw, because `android_view/runtime` has no zero-argument
            // boolean call — only `call_bool_1`.
            let mcls: jni::jclass = env.find_class(
                #str_ptr("android/location/LocationManager\0"));
            let mid: jni::jmethodID = env.method_id(mcls, #str_ptr("isLocationEnabled\0"),
                                                    #str_ptr("()Z\0"));
            let on: u8 = {
                (*(*env.raw())).CallBooleanMethodA(env.raw(), mgr, mid, 0 as *jni::JValue)
            };
            if env.has_pending_exception() { env.clear_exception(); }
            env.delete_local_ref(mcls);
            env.delete_local_ref(mgr);
            if on != (0 as u8) { return 1; }
            return 0;
        }
    }
}

fn _start(req: *loc::Request, on_fix: fn(loc::Fix, *u8), ctx: *u8,
          once: bool, out_code: *i32) -> *_Session {
    match _env_ready() {
        option::Option[rt::Env]::None => {
            if out_code.is_not_null() { { *out_code = 2 }; }
            return 0 as *_Session;
        }
        option::Option[rt::Env]::Some(env) => {
            let token: i64 = _NEXT_TOKEN;
            _NEXT_TOKEN = token + (1 as i64);

            let m: jni::jmethodID = env.method_id({ _C_LOCATION as jni::jclass },
                #str_ptr("<init>\0"), #str_ptr("(J)V\0"));
            var args: [jni::JValue; 1] = [jni::arg_long(token)];
            let local: jni::jobject = {
                (*(*env.raw())).NewObjectA(env.raw(), { _C_LOCATION as *u8 }, m,
                                           #addr_of(args[0]))
            };
            if local == (0 as jni::jobject) {
                env.clear_exception();
                if out_code.is_not_null() { { *out_code = 5 }; }
                return 0 as *_Session;
            }
            let obj: jni::jobject = env.new_global_ref(local);
            env.delete_local_ref(local);

            var blank: _Session = _Session {
                token: token, obj: { #addr(obj) },
                on_fix: on_fix, ctx: ctx, running: true, status: 0 as i64,
            };
            var s: *_Session = match box::new::[_Session](blank) {
                option::Option[box::Box[_Session]]::Some(b) => { b.into_raw() as *_Session },
                option::Option[box::Box[_Session]]::None => { 0 as *_Session },
            };
            if s.is_null() {
                if out_code.is_not_null() { { *out_code = 5 }; }
                return 0 as *_Session;
            }
            if !_remember(s) {
                if out_code.is_not_null() { { *out_code = 5 }; }
                return 0 as *_Session;
            }

            var sa: [jni::JValue; 6] = [
                jni::arg_object(_context()),
                jni::arg_int({ (*req).accuracy.to_code() }),
                jni::arg_float({ { (*req).distance_filter_m } as f32 }),
                jni::arg_long(0 as i64),
                jni::arg_long({ (*req).timeout_ms }),
                jni::arg_bool({ if once { 1 as u8 } else { 0 as u8 } }),
            ];
            let sm: jni::jmethodID = env.method_id({ _C_LOCATION as jni::jclass },
                #str_ptr("start\0"),
                #str_ptr("(Landroid/content/Context;IFJJZ)I\0"));
            let code: i32 = {
                (*(*env.raw())).CallIntMethodA(env.raw(), obj, sm, #addr_of(sa[0]))
            };
            if env.has_pending_exception() { env.clear_exception(); }
            if code != 0 {
                { (*s).running = false };
                _forget(s);
                if out_code.is_not_null() { { *out_code = code }; }
                return 0 as *_Session;
            }
            if out_code.is_not_null() { { *out_code = 0 }; }
            return s;
        }
    }
}

export extern fn _c_once(req: *loc::Request, on_fix: fn(loc::Fix, *u8), ctx: *u8) -> i32 {
    var code: i32 = 0;
    let s: *_Session = _start(req, on_fix, ctx, true, #addr_of(code));
    if s.is_null() { return code; }
    return 0;
}

export extern fn _c_updates_start(req: *loc::Request, on_fix: fn(loc::Fix, *u8),
                                  ctx: *u8, out_code: *i32) -> *u8 {
    let s: *_Session = _start(req, on_fix, ctx, false, out_code);
    if s.is_null() { return 0 as *u8; }
    return s as *u8;
}

export extern fn _c_last_known(into: *loc::Fix) -> i32 {
    // NOT IMPLEMENTED, and said rather than faked. The framework's
    // `getLastKnownLocation` needs a session to deliver through — the Java half
    // has the verb and this seam has no place to put the answer synchronously.
    // A caller gets None, which is a true statement about this build.
    return 0;
}

export extern fn _c_updates_accuracy(h: *u8) -> i32 {
    if h.is_null() { return 1; }
    match _env_ready() {
        option::Option[rt::Env]::None => { return 1; }
        option::Option[rt::Env]::Some(env) => {
            let s: *_Session = h as *_Session;
            let obj: jni::jobject = { { (*s).obj } as jni::jobject };
            if obj == (0 as jni::jobject) { return 1; }
            var a: [jni::JValue; 1] = [jni::arg_object(_context())];
            let m: jni::jmethodID = env.method_id({ _C_LOCATION as jni::jclass },
                #str_ptr("grantedAccuracy\0"),
                #str_ptr("(Landroid/content/Context;)I\0"));
            let g: i32 = {
                (*(*env.raw())).CallIntMethodA(env.raw(), obj, m, #addr_of(a[0]))
            };
            if env.has_pending_exception() { env.clear_exception(); return 1; }
            return g;
        }
    }
}

export extern fn _c_updates_status(h: *u8) -> i32 {
    // Android has no asynchronous authorization callback: the grant is known
    // synchronously, so this is the same answer `_c_permission` gives.
    return _c_permission();
}

export extern fn _c_updates_running(h: *u8) -> i32 {
    if h.is_null() { return 0; }
    let s: *_Session = h as *_Session;
    if { (*s).running } { return 1; }
    return 0;
}

export extern fn _c_updates_stop(h: *u8) {
    if h.is_null() { return; }
    let s: *_Session = h as *_Session;
    if !{ (*s).running } { return; }
    { (*s).running = false };
    match _env_ready() {
        option::Option[rt::Env]::None => { }
        option::Option[rt::Env]::Some(env) => {
            let obj: jni::jobject = { { (*s).obj } as jni::jobject };
            if obj != (0 as jni::jobject) {
                env.call_void_0(obj, #str_ptr("cplus/location/CplusLocation\0"),
                                #str_ptr("stop\0"), #str_ptr("()V\0"));
                if env.has_pending_exception() { env.clear_exception(); }
            }
        }
    }
    _forget(s);
    return;
}
