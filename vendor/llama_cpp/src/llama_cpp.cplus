// vendor/llama_cpp/src/llama_cpp.cplus — C+ facade for llama.cpp's C API.
//
// Raw bindings are generated by `./build.sh` straight from upstream's own
// public headers — there is no hand-curated ABI mirror in this package:
//   llama.cpp include/llama.h      -> src/raw.cplus
//   llama.cpp tools/mtmd/mtmd.h    -> src/mtmd_raw.cplus
//
// Naming-guideline notes (naming_guideline.md):
//   - raw handles are hidden behind `_`-prefixed `opaque` fields; the public
//     surface is role-named accessors and never exposes the raw pointers.
//   - `load` collapses options into one constructor with default-valued
//     labeled params; the common call is `load("model.gguf")`.
//   - absence/failure is a value: `Result`/`Option`/`Status`, never a sentinel.
//   - the high-level generation entry point returns an owned `Text`; the
//     buffer-filling variants stay for callers that own the storage.
//
// Deliberate deviation (thin-binding pragmatism, matching the appkit pass):
//   - the manual decode/sample/token-to-piece loop primitives keep their token
//     (`i32`) and byte-buffer (`u8[]`) shapes. They mirror libllama's own loop
//     contract one-to-one; wrapping each in an owning type would obscure, not
//     clarify, the lower-level surface.

import "stdlib/result" as result;
import "stdlib/option" as option;
import "stdlib/text" as text;
import "stdlib/vec" as vec;
import "./raw" as raw;
import "./mtmd_raw" as mtmd_raw;

type ModelParams = raw::llama_model_params;
type ContextParams = raw::llama_context_params;
type Batch = raw::llama_batch;
type MtmdContextParams = mtmd_raw::mtmd_context_params;
type MtmdCaps = mtmd_raw::mtmd_caps;
type MtmdInputText = mtmd_raw::mtmd_input_text;
type MtmdDecoderPos = mtmd_raw::mtmd_decoder_pos;

enum LlamaError {
    LoadFailed,
    ContextFailed,
    NullHandle,
    InvalidArgument,
    OutOfMemory,
    TokenizeFailed,
    DecodeFailed,
    SampleFailed,
    OutputTooSmall,
}

// A loaded model plus the context and sampler chain that drive it.
//
// One `Session` owns exactly one of each and frees all three in `drop`, in the
// order libllama requires (sampler, context, model). `_vocab` is borrowed from
// the model and is never freed here.
struct Session {
    opaque _model: *u8,
    opaque _ctx: *u8,
    opaque _vocab: *u8,
    opaque _sampler: *raw::llama_sampler,
}

struct MtmdContext {
    opaque _raw: *u8,
}

struct Bitmap {
    opaque _raw: *u8,
}

// Register the backends (CPU, Metal, BLAS, …). Call once before `load`.
//
// Since llama.cpp b4700 this also performs `ggml_backend_load_all()` when no
// backend is registered yet, so a dynamically-linked ggml still finds Metal.
fn backend_init() {
    raw::llama_backend_init();
    return;
}

fn backend_free() {
    raw::llama_backend_free();
    return;
}

fn default_model_params() -> raw::llama_model_params {
    return raw::llama_model_default_params();
}

fn default_context_params() -> raw::llama_context_params {
    return raw::llama_context_default_params();
}

// A `Vec` of `n` zeroed elements — storage whose COUNT is `n`, not merely its
// capacity, so `at_ptr(0)` hands back a pointer a C function can fill.
//
// `with_capacity` alone is NOT enough: `Vec::at_ptr` bounds-checks the index
// against the COUNT, so on a vec that has reserved 256 bytes but holds none,
// `at_ptr(0)` answers `None` and every fill path below it silently gives up.
fn _zeroed[T](n: usize) -> vec::Vec[T] {
    var v: vec::Vec[T] = vec::with_capacity::[T](n);
    var i: usize = 0 as usize;
    while i < n {
        v.append({ #zero::[T]() });
        i = i +% (1 as usize);
    }
    return v;
}

// Build the sampler chain `load` installs.
//
// `temperature <= 0` means greedy: one deterministic pick, no RNG, and the
// truncation samplers would have nothing left to do. Above zero the chain is
// the conventional order — top-k narrows, top-p/min-p trim the tail,
// temperature reshapes, `dist` draws.
fn _build_sampler(
    temperature: f32,
    top_k: i32,
    top_p: f32,
    min_p: f32,
    seed: u32,
) -> *raw::llama_sampler {
    let chain: *raw::llama_sampler =
        raw::llama_sampler_chain_init(raw::llama_sampler_chain_default_params());
    if chain.is_null() {
        return chain;
    }
    if temperature <= (0.0 as f32) {
        raw::llama_sampler_chain_add(chain, raw::llama_sampler_init_greedy());
        return chain;
    }
    if top_k > 0 {
        raw::llama_sampler_chain_add(chain, raw::llama_sampler_init_top_k(top_k));
    }
    if top_p < (1.0 as f32) {
        raw::llama_sampler_chain_add(
            chain,
            raw::llama_sampler_init_top_p(top_p, 1 as u64),
        );
    }
    if min_p > (0.0 as f32) {
        raw::llama_sampler_chain_add(
            chain,
            raw::llama_sampler_init_min_p(min_p, 1 as u64),
        );
    }
    raw::llama_sampler_chain_add(chain, raw::llama_sampler_init_temp(temperature));
    raw::llama_sampler_chain_add(chain, raw::llama_sampler_init_dist(seed));
    return chain;
}

// Load a GGUF model from `path` into a ready-to-run session.
//
// The tuning knobs are labeled parameters with defaults, so the common call is
// just `load("model.gguf")`; override only what you need, in any order:
//   load("model.gguf", context_size: 8192, gpu_layers: 0, temperature: 0.8)
//
// `threads <= 0` (the default) leaves llama.cpp's own thread auto-detection in
// place; a positive value pins both the generation and batch thread counts.
// `temperature <= 0` (the default) selects greedy decoding — see
// `_build_sampler` for the chain each setting produces.
fn load(
    path: str,
    context_size: u32 = 4096 as u32,
    gpu_layers: i32 = -1,
    threads: i32 = 0,
    temperature: f32 = 0.0 as f32,
    top_k: i32 = 40,
    top_p: f32 = 0.95 as f32,
    min_p: f32 = 0.05 as f32,
    seed: u32 = 4294967295 as u32,
) -> result::Result[Session, LlamaError] {
    // `path` is a `str` — a fat pointer with no NUL — so it cannot be handed to
    // a C `const char *` directly. `c_str` copies it into a NUL-terminated
    // buffer that lives until the end of this call.
    var path_text: text::Text = text::from_str(path);
    guard let option::Option[text::CString]::Some(path_c) = path_text.c_str() else {
        return result::Result[Session, LlamaError]::Err(LlamaError::InvalidArgument);
    };

    var mp: raw::llama_model_params = raw::llama_model_default_params();
    mp.n_gpu_layers = gpu_layers;

    let model: *u8 = raw::llama_model_load_from_file({ path_c.as_ptr() as *i8 }, mp);
    if model.is_null() {
        return result::Result[Session, LlamaError]::Err(LlamaError::LoadFailed);
    }

    var cp: raw::llama_context_params = raw::llama_context_default_params();
    cp.n_ctx = context_size;
    if threads > 0 {
        cp.n_threads = threads;
        cp.n_threads_batch = threads;
    }

    let ctx: *u8 = raw::llama_init_from_model(model, cp);
    if ctx.is_null() {
        raw::llama_model_free(model);
        return result::Result[Session, LlamaError]::Err(LlamaError::ContextFailed);
    }

    let sampler: *raw::llama_sampler =
        _build_sampler(temperature, top_k, top_p, min_p, seed);
    if sampler.is_null() {
        raw::llama_free(ctx);
        raw::llama_model_free(model);
        return result::Result[Session, LlamaError]::Err(LlamaError::ContextFailed);
    }

    let vocab: *u8 = raw::llama_model_get_vocab(model);
    return result::Result[Session, LlamaError]::Ok(Session {
        _model: model,
        _ctx: ctx,
        _vocab: vocab,
        _sampler: sampler,
    });
}

impl Session {
    // The context window size (tokens) this session was created with.
    fn context_size(this) -> u32 {
        if this._ctx.is_null() {
            return 0 as u32;
        }
        return raw::llama_n_ctx(this._ctx);
    }

    // The context window the model was TRAINED with, which may be smaller than
    // the one this session asked for.
    fn train_context_size(this) -> i32 {
        if this._model.is_null() {
            return 0;
        }
        return raw::llama_model_n_ctx_train(this._model);
    }

    // The in-memory size of the loaded model, in bytes.
    fn model_size(this) -> u64 {
        if this._model.is_null() {
            return 0 as u64;
        }
        return raw::llama_model_size(this._model);
    }

    // The model's parameter count.
    fn parameter_count(this) -> u64 {
        if this._model.is_null() {
            return 0 as u64;
        }
        return raw::llama_model_n_params(this._model);
    }

    // The width of one embedding vector.
    fn embedding_size(this) -> i32 {
        if this._model.is_null() {
            return 0;
        }
        return raw::llama_model_n_embd(this._model);
    }

    // How many tokens the vocabulary holds.
    fn vocabulary_size(this) -> i32 {
        if this._vocab.is_null() {
            return 0;
        }
        return raw::llama_vocab_n_tokens(this._vocab);
    }

    // The model's own one-line description ("llama 7B Q4_K - Medium", …).
    fn describe(this) -> text::Text {
        var out: text::Text = text::new();
        if this._model.is_null() {
            return out;
        }
        let cap: usize = 256 as usize;
        var buf: vec::Vec[u8] = _zeroed::[u8](cap);
        guard let option::Option[*u8]::Some(p) = buf.at_ptr(0 as usize) else {
            return out;
        };
        let n: i32 = raw::llama_model_desc(this._model, { p as *i8 }, cap as u64);
        if n <= 0 {
            return out;
        }
        let view: str = { #str_from_raw_parts(p, n as usize) };
        out.append(view);
        return out;
    }

    // Forget everything decoded so far: clear the KV cache and reset the
    // sampler's own history. The next `generate` starts from an empty context.
    fn reset(this) {
        if this._ctx.is_not_null() {
            let mem: *u8 = raw::llama_get_memory(this._ctx);
            if mem.is_not_null() {
                raw::llama_memory_clear(mem, true);
            }
        }
        if this._sampler.is_not_null() {
            raw::llama_sampler_reset(this._sampler);
        }
        return;
    }

    // Tokenize `prompt` into the caller-provided `tokens` buffer.
    //
    // Returns the number of tokens written. `add_special`/`parse_special` mirror
    // llama.cpp's flags and default to `false`; the BOS/EOS-adding common path is
    // `tokenize(prompt, into: buf, add_special: true)`.
    fn tokenize(
        this,
        prompt: str,
        into: i32[],
        add_special: bool = false,
        parse_special: bool = false,
    ) -> result::Result[usize, LlamaError] {
        if this._vocab.is_null() {
            return result::Result[usize, LlamaError]::Err(LlamaError::NullHandle);
        }
        let cap: usize = #slice_len(into);
        if cap > (2147483647 as usize) || #str_len(prompt) > (2147483647 as usize) {
            return result::Result[usize, LlamaError]::Err(LlamaError::InvalidArgument);
        }
        let n: i32 = raw::llama_tokenize(
            this._vocab,
            { #str_ptr(prompt) as *i8 },
            #str_len(prompt) as i32,
            { #slice_ptr(into) },
            cap as i32,
            add_special,
            parse_special,
        );
        if n < 0 {
            return result::Result[usize, LlamaError]::Err(LlamaError::TokenizeFailed);
        }
        return result::Result[usize, LlamaError]::Ok(n as usize);
    }

    // Tokenize `prompt` into an owned `Vec`, sizing it for the caller.
    //
    // llama_tokenize reports a too-small buffer by returning the NEGATED token
    // count, so the first call with a zero-length buffer is the measurement and
    // the second is the fill.
    fn tokens_for(
        this,
        prompt: str,
        add_special: bool = true,
        parse_special: bool = true,
    ) -> result::Result[vec::Vec[i32], LlamaError] {
        if this._vocab.is_null() {
            return result::Result[vec::Vec[i32], LlamaError]::Err(LlamaError::NullHandle);
        }
        if #str_len(prompt) > (2147483647 as usize) {
            return result::Result[vec::Vec[i32], LlamaError]::Err(LlamaError::InvalidArgument);
        }
        let measured: i32 = raw::llama_tokenize(
            this._vocab,
            { #str_ptr(prompt) as *i8 },
            #str_len(prompt) as i32,
            { 0 as *i32 },
            0,
            add_special,
            parse_special,
        );
        let needed: i32 = if measured < 0 { 0 - measured } else { measured };
        if needed <= 0 {
            return result::Result[vec::Vec[i32], LlamaError]::Err(LlamaError::TokenizeFailed);
        }

        var tokens: vec::Vec[i32] = _zeroed::[i32](needed as usize);
        guard let option::Option[*i32]::Some(slot) = tokens.at_ptr(0 as usize) else {
            return result::Result[vec::Vec[i32], LlamaError]::Err(LlamaError::OutOfMemory);
        };
        let got: i32 = raw::llama_tokenize(
            this._vocab,
            { #str_ptr(prompt) as *i8 },
            #str_len(prompt) as i32,
            slot,
            needed,
            add_special,
            parse_special,
        );
        if got <= 0 {
            return result::Result[vec::Vec[i32], LlamaError]::Err(LlamaError::TokenizeFailed);
        }
        // The measurement pass is an upper bound; `truncate` cuts the count back
        // to what this pass actually wrote.
        tokens.truncate(got as usize);
        return result::Result[vec::Vec[i32], LlamaError]::Ok(tokens);
    }

    // Decode `tokens` through the context. Returns the count decoded.
    fn decode(this, tokens: i32[]) -> result::Result[usize, LlamaError] {
        if this._ctx.is_null() {
            return result::Result[usize, LlamaError]::Err(LlamaError::NullHandle);
        }
        let n: usize = #slice_len(tokens);
        if n == (0 as usize) || n > (2147483647 as usize) {
            return result::Result[usize, LlamaError]::Err(LlamaError::InvalidArgument);
        }
        let batch: raw::llama_batch = raw::llama_batch_get_one({ #slice_ptr(tokens) }, n as i32);
        let rc: i32 = raw::llama_decode(this._ctx, batch);
        if rc != 0 {
            return result::Result[usize, LlamaError]::Err(LlamaError::DecodeFailed);
        }
        return result::Result[usize, LlamaError]::Ok(n);
    }

    // Sample the next token from the current logits.
    //
    // `llama_sampler_sample` already accepts the token into the chain's history
    // (see its header comment: "Sample and accept a token"). Calling
    // `llama_sampler_accept` after it counts the token twice, which silently
    // skews every stateful sampler — penalties, dry, mirostat, adaptive-p. So
    // this does not.
    fn sample(this) -> result::Result[i32, LlamaError] {
        if this._ctx.is_null() || this._sampler.is_null() {
            return result::Result[i32, LlamaError]::Err(LlamaError::NullHandle);
        }
        let token: i32 = raw::llama_sampler_sample(this._sampler, this._ctx, -1);
        if token < 0 {
            return result::Result[i32, LlamaError]::Err(LlamaError::SampleFailed);
        }
        return result::Result[i32, LlamaError]::Ok(token);
    }

    // Is `token` an end-of-generation token for this model's vocabulary?
    fn is_end_of_generation(this, token: i32) -> bool {
        if this._vocab.is_null() {
            return true;
        }
        return raw::llama_vocab_is_eog(this._vocab, token);
    }

    // Render `token` into the caller-provided `into` buffer. Returns the number
    // of bytes written. `special` (default `false`) controls rendering of
    // control tokens.
    fn token_piece(
        this,
        token: i32,
        into: u8[],
        special: bool = false,
    ) -> result::Result[usize, LlamaError] {
        if this._vocab.is_null() {
            return result::Result[usize, LlamaError]::Err(LlamaError::NullHandle);
        }
        let cap: usize = #slice_len(into);
        if cap > (2147483647 as usize) {
            return result::Result[usize, LlamaError]::Err(LlamaError::InvalidArgument);
        }
        let n: i32 = raw::llama_token_to_piece(
            this._vocab,
            token,
            { #slice_ptr(into) as *i8 },
            cap as i32,
            0,
            special,
        );
        if n < 0 {
            return result::Result[usize, LlamaError]::Err(LlamaError::OutputTooSmall);
        }
        return result::Result[usize, LlamaError]::Ok(n as usize);
    }

    // Generate up to `max_new_tokens` from `prompt`, returning the decoded
    // continuation as an owned `Text`.
    //
    // This is the high-level entry point: it owns the token scratch buffer and
    // the output string, so the caller does not size anything. Generation stops
    // at the model's end-of-generation token or after `max_new_tokens`.
    //
    // `continuing: false` (the default) clears the KV cache and the sampler
    // history first, so each call is an independent completion. Pass
    // `continuing: true` to append this prompt to the running conversation.
    fn generate(
        this,
        prompt: str,
        max_new_tokens: i32 = 256,
        continuing: bool = false,
    ) -> result::Result[text::Text, LlamaError] {
        if this._ctx.is_null() || this._vocab.is_null() || this._sampler.is_null() {
            return result::Result[text::Text, LlamaError]::Err(LlamaError::NullHandle);
        }
        if max_new_tokens <= 0 || #str_len(prompt) > (2147483647 as usize) {
            return result::Result[text::Text, LlamaError]::Err(LlamaError::InvalidArgument);
        }
        if !continuing {
            this.reset();
        }

        guard let result::Result[vec::Vec[i32], LlamaError]::Ok(prompt_tokens) =
            this.tokens_for(prompt) else {
            return result::Result[text::Text, LlamaError]::Err(LlamaError::TokenizeFailed);
        };
        guard let result::Result[usize, LlamaError]::Ok(_decoded_prompt) =
            this.decode(prompt_tokens.as_slice()) else {
            return result::Result[text::Text, LlamaError]::Err(LlamaError::DecodeFailed);
        };

        var out: text::Text = text::new();
        // A token renders to at most ~128 UTF-8 bytes; this scratch covers it.
        let piece_cap: usize = 256 as usize;
        var piece: vec::Vec[u8] = _zeroed::[u8](piece_cap);
        guard let option::Option[*u8]::Some(piece_ptr) = piece.at_ptr(0 as usize) else {
            return result::Result[text::Text, LlamaError]::Err(LlamaError::OutOfMemory);
        };
        let piece_buf: u8[] = { #slice_from_raw_parts(piece_ptr, piece_cap) };

        var i: i32 = 0;
        while i < max_new_tokens {
            guard let result::Result[i32, LlamaError]::Ok(token) = this.sample() else {
                return result::Result[text::Text, LlamaError]::Err(LlamaError::SampleFailed);
            };
            if this.is_end_of_generation(token) {
                return result::Result[text::Text, LlamaError]::Ok(out);
            }
            guard let result::Result[usize, LlamaError]::Ok(n_piece) =
                this.token_piece(token, into: piece_buf) else {
                return result::Result[text::Text, LlamaError]::Err(LlamaError::OutputTooSmall);
            };
            if n_piece > (0 as usize) {
                let rendered: str = { #str_from_raw_parts(piece_ptr, n_piece) };
                out.append(rendered);
            }

            let one: [i32; 1] = [token];
            let one_slice: i32[] = { #slice_from_raw_parts(#addr_of(one[0]), 1 as usize) };
            guard let result::Result[usize, LlamaError]::Ok(_decoded) =
                this.decode(one_slice) else {
                return result::Result[text::Text, LlamaError]::Err(LlamaError::DecodeFailed);
            };
            i = i + 1;
        }
        return result::Result[text::Text, LlamaError]::Ok(out);
    }

    fn drop(ref this) {
        if this._sampler.is_not_null() {
            // Freeing the chain frees every sampler added to it.
            raw::llama_sampler_free(this._sampler);
            this._sampler = { 0 as *raw::llama_sampler };
        }
        if this._ctx.is_not_null() {
            raw::llama_free(this._ctx);
            this._ctx = { 0 as *u8 };
        }
        if this._model.is_not_null() {
            raw::llama_model_free(this._model);
            this._model = { 0 as *u8 };
        }
        // `_vocab` is borrowed from the model; the model's free covers it.
        this._vocab = { 0 as *u8 };
        return;
    }
}

// ---------------- Multimodal (mtmd C API) ---------------------------------

fn mtmd_default_params() -> mtmd_raw::mtmd_context_params {
    return mtmd_raw::mtmd_context_params_default();
}

// Read an mmproj file's capability header without loading the projector.
fn mtmd_caps_from_file(path: str) -> result::Result[MtmdCaps, LlamaError] {
    var path_text: text::Text = text::from_str(path);
    guard let option::Option[text::CString]::Some(path_c) = path_text.c_str() else {
        return result::Result[MtmdCaps, LlamaError]::Err(LlamaError::InvalidArgument);
    };
    let caps: MtmdCaps = mtmd_raw::mtmd_get_cap_from_file({ path_c.as_ptr() as *i8 });
    return result::Result[MtmdCaps, LlamaError]::Ok(caps);
}

fn mtmd_init(
    session: Session,
    mmproj_path: str,
    params: mtmd_raw::mtmd_context_params,
) -> result::Result[MtmdContext, LlamaError] {
    if session._model.is_null() {
        return result::Result[MtmdContext, LlamaError]::Err(LlamaError::NullHandle);
    }
    var path_text: text::Text = text::from_str(mmproj_path);
    guard let option::Option[text::CString]::Some(path_c) = path_text.c_str() else {
        return result::Result[MtmdContext, LlamaError]::Err(LlamaError::InvalidArgument);
    };
    let raw_ctx: *u8 = mtmd_raw::mtmd_init_from_file(
        { path_c.as_ptr() as *i8 },
        session._model,
        params,
    );
    if raw_ctx.is_null() {
        return result::Result[MtmdContext, LlamaError]::Err(LlamaError::LoadFailed);
    }
    return result::Result[MtmdContext, LlamaError]::Ok(MtmdContext { _raw: raw_ctx });
}

impl MtmdContext {
    fn supports_vision(this) -> bool {
        if this._raw.is_null() {
            return false;
        }
        return mtmd_raw::mtmd_support_vision(this._raw);
    }

    fn supports_audio(this) -> bool {
        if this._raw.is_null() {
            return false;
        }
        return mtmd_raw::mtmd_support_audio(this._raw);
    }

    // The sample rate the audio encoder expects, in Hz. 0 when audio is not
    // supported.
    fn audio_sample_rate(this) -> i32 {
        if this._raw.is_null() {
            return 0;
        }
        return mtmd_raw::mtmd_get_audio_sample_rate(this._raw);
    }

    fn drop(ref this) {
        if this._raw.is_not_null() {
            mtmd_raw::mtmd_free(this._raw);
            this._raw = { 0 as *u8 };
        }
        return;
    }
}

// An RGB image for the vision encoder: `width * height * 3` bytes, row-major.
fn bitmap_rgb(width: u32, height: u32, rgb: u8[]) -> result::Result[Bitmap, LlamaError] {
    let expected: usize = (width as usize) *% (height as usize) *% (3 as usize);
    if #slice_len(rgb) < expected || expected == (0 as usize) {
        return result::Result[Bitmap, LlamaError]::Err(LlamaError::InvalidArgument);
    }
    let raw_bitmap: *u8 = mtmd_raw::mtmd_bitmap_init(width, height, { #slice_ptr(rgb) });
    if raw_bitmap.is_null() {
        return result::Result[Bitmap, LlamaError]::Err(LlamaError::InvalidArgument);
    }
    return result::Result[Bitmap, LlamaError]::Ok(Bitmap { _raw: raw_bitmap });
}

// Mono PCM samples for the audio encoder, at `MtmdContext::audio_sample_rate`.
fn bitmap_audio(samples: f32[]) -> result::Result[Bitmap, LlamaError] {
    let n: usize = #slice_len(samples);
    if n == (0 as usize) {
        return result::Result[Bitmap, LlamaError]::Err(LlamaError::InvalidArgument);
    }
    let raw_bitmap: *u8 =
        mtmd_raw::mtmd_bitmap_init_from_audio(n as u64, { #slice_ptr(samples) });
    if raw_bitmap.is_null() {
        return result::Result[Bitmap, LlamaError]::Err(LlamaError::InvalidArgument);
    }
    return result::Result[Bitmap, LlamaError]::Ok(Bitmap { _raw: raw_bitmap });
}

impl Bitmap {
    fn width(this) -> u32 {
        if this._raw.is_null() {
            return 0 as u32;
        }
        return mtmd_raw::mtmd_bitmap_get_nx(this._raw);
    }

    fn height(this) -> u32 {
        if this._raw.is_null() {
            return 0 as u32;
        }
        return mtmd_raw::mtmd_bitmap_get_ny(this._raw);
    }

    fn is_audio(this) -> bool {
        if this._raw.is_null() {
            return false;
        }
        return mtmd_raw::mtmd_bitmap_is_audio(this._raw);
    }

    fn byte_count(this) -> u64 {
        if this._raw.is_null() {
            return 0 as u64;
        }
        return mtmd_raw::mtmd_bitmap_get_n_bytes(this._raw);
    }

    fn drop(ref this) {
        if this._raw.is_not_null() {
            mtmd_raw::mtmd_bitmap_free(this._raw);
            this._raw = { 0 as *u8 };
        }
        return;
    }
}

// ---------------- Tests ---------------------------------------------------
//
// These exercise the pure-logic guard paths and small helpers that do NOT call
// into libllama: a session with null handles short-circuits every accessor and
// fallible method before any `llama_*` symbol is reached, and its `drop` is a
// no-op (all handles already null). So they run host-side with no model loaded.
// The real model-loading paths are covered by the e2e suite in
// `tests/e2e_model.cplus`, which needs a GGUF on disk.

fn null_session() -> Session {
    return Session {
        _model: { 0 as *u8 },
        _ctx: { 0 as *u8 },
        _vocab: { 0 as *u8 },
        _sampler: { 0 as *raw::llama_sampler },
    };
}

#[test]
fn test_null_session_accessors_are_safe() {
    let s: Session = null_session();
    assert s.context_size() == (0 as u32);
    assert s.train_context_size() == 0;
    assert s.model_size() == (0 as u64);
    assert s.parameter_count() == (0 as u64);
    assert s.embedding_size() == 0;
    assert s.vocabulary_size() == 0;
    // A model with no vocabulary treats every token as end-of-generation, which
    // is the safe answer for a generation loop that must terminate.
    assert s.is_end_of_generation(0);
}

#[test]
fn test_describe_on_null_model_is_empty() {
    let s: Session = null_session();
    let d: text::Text = s.describe();
    assert d.count() == (0 as usize);
}

#[test]
fn test_reset_on_null_handles_is_a_noop() {
    let s: Session = null_session();
    s.reset();
    // Reaching here without a fault IS the assertion: reset must not
    // dereference a null context or sampler.
    assert s.context_size() == (0 as u32);
}

#[test]
fn test_tokenize_on_null_vocab_reports_null_handle() {
    let s: Session = null_session();
    var buf: [i32; 4] = [0, 0, 0, 0];
    let into: i32[] = { #slice_from_raw_parts(#addr_of(buf[0]), 4 as usize) };
    match s.tokenize("hello", into: into) {
        result::Result[usize, LlamaError]::Err(e) => { assert e == LlamaError::NullHandle; }
        result::Result[usize, LlamaError]::Ok(_n) => { assert false; }
    }
    return;
}

#[test]
fn test_tokens_for_on_null_vocab_reports_null_handle() {
    let s: Session = null_session();
    match s.tokens_for("hello") {
        result::Result[vec::Vec[i32], LlamaError]::Err(e) => {
            assert e == LlamaError::NullHandle;
        }
        result::Result[vec::Vec[i32], LlamaError]::Ok(_v) => { assert false; }
    }
    return;
}

#[test]
fn test_decode_empty_is_invalid_argument() {
    let s: Session = null_session();
    let empty: i32[] = { #slice_from_raw_parts({ 0 as *i32 }, 0 as usize) };
    // ctx is null, so the null-handle guard fires first.
    match s.decode(empty) {
        result::Result[usize, LlamaError]::Err(e) => { assert e == LlamaError::NullHandle; }
        result::Result[usize, LlamaError]::Ok(_n) => { assert false; }
    }
    return;
}

#[test]
fn test_sample_on_null_handles_reports_null_handle() {
    let s: Session = null_session();
    match s.sample() {
        result::Result[i32, LlamaError]::Err(e) => { assert e == LlamaError::NullHandle; }
        result::Result[i32, LlamaError]::Ok(_t) => { assert false; }
    }
    return;
}

#[test]
fn test_token_piece_on_null_vocab_reports_null_handle() {
    let s: Session = null_session();
    var buf: [u8; 8] = [0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8];
    let into: u8[] = { #slice_from_raw_parts(#addr_of(buf[0]), 8 as usize) };
    match s.token_piece(0, into: into) {
        result::Result[usize, LlamaError]::Err(e) => { assert e == LlamaError::NullHandle; }
        result::Result[usize, LlamaError]::Ok(_n) => { assert false; }
    }
    return;
}

#[test]
fn test_generate_on_null_handles_reports_null_handle() {
    let s: Session = null_session();
    match s.generate("hi") {
        result::Result[text::Text, LlamaError]::Err(e) => { assert e == LlamaError::NullHandle; }
        result::Result[text::Text, LlamaError]::Ok(_t) => { assert false; }
    }
    return;
}

#[test]
fn test_generate_rejects_nonpositive_budget() {
    // Use non-null sentinel handles so the budget check (not the null guard) is
    // the path under test. No libllama call happens: the `max_new_tokens <= 0`
    // guard returns before the reset and before tokenization.
    var s: Session = Session {
        _model: { 1 as *u8 },
        _ctx: { 1 as *u8 },
        _vocab: { 1 as *u8 },
        _sampler: { 1 as *raw::llama_sampler },
    };
    match s.generate("hi", max_new_tokens: 0) {
        result::Result[text::Text, LlamaError]::Err(e) => { assert e == LlamaError::InvalidArgument; }
        result::Result[text::Text, LlamaError]::Ok(_t) => { assert false; }
    }
    // Defuse drop: these are fake handles, never hand them to llama_*_free.
    s._model = { 0 as *u8 };
    s._ctx = { 0 as *u8 };
    s._vocab = { 0 as *u8 };
    s._sampler = { 0 as *raw::llama_sampler };
}

#[test]
fn test_mtmd_and_bitmap_null_guards() {
    let c: MtmdContext = MtmdContext { _raw: { 0 as *u8 } };
    assert !c.supports_vision();
    assert !c.supports_audio();
    assert c.audio_sample_rate() == 0;

    let b: Bitmap = Bitmap { _raw: { 0 as *u8 } };
    assert b.width() == (0 as u32);
    assert b.height() == (0 as u32);
    assert !b.is_audio();
    assert b.byte_count() == (0 as u64);
}

#[test]
fn test_bitmap_rgb_rejects_a_short_buffer() {
    // 2x2 RGB needs 12 bytes; hand it 6. The size check must fire BEFORE
    // mtmd_bitmap_init reads past the end.
    var px: [u8; 6] = [0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8];
    let short: u8[] = { #slice_from_raw_parts(#addr_of(px[0]), 6 as usize) };
    match bitmap_rgb(2 as u32, 2 as u32, short) {
        result::Result[Bitmap, LlamaError]::Err(e) => { assert e == LlamaError::InvalidArgument; }
        result::Result[Bitmap, LlamaError]::Ok(_b) => { assert false; }
    }
    return;
}

#[test]
fn test_bitmap_rgb_rejects_a_zero_sized_image() {
    var px: [u8; 3] = [0 as u8, 0 as u8, 0 as u8];
    let any: u8[] = { #slice_from_raw_parts(#addr_of(px[0]), 3 as usize) };
    match bitmap_rgb(0 as u32, 4 as u32, any) {
        result::Result[Bitmap, LlamaError]::Err(e) => { assert e == LlamaError::InvalidArgument; }
        result::Result[Bitmap, LlamaError]::Ok(_b) => { assert false; }
    }
    return;
}

#[test]
fn test_bitmap_audio_rejects_empty_samples() {
    let none: f32[] = { #slice_from_raw_parts({ 0 as *f32 }, 0 as usize) };
    match bitmap_audio(none) {
        result::Result[Bitmap, LlamaError]::Err(e) => { assert e == LlamaError::InvalidArgument; }
        result::Result[Bitmap, LlamaError]::Ok(_b) => { assert false; }
    }
    return;
}
