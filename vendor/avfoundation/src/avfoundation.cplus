}

fn audio3_d_mixing_rendering_algorithm_raw(v: Audio3DMixingRenderingAlgorithm) -> i64 {
    return match v {
        Audio3DMixingRenderingAlgorithm::EqualPowerPanning => { 0 as i64 },
        Audio3DMixingRenderingAlgorithm::SphericalHead => { 1 as i64 },
        Audio3DMixingRenderingAlgorithm::HRTF => { 2 as i64 },
        Audio3DMixingRenderingAlgorithm::SoundField => { 3 as i64 },
        Audio3DMixingRenderingAlgorithm::StereoPassThrough => { 5 as i64 },
        Audio3DMixingRenderingAlgorithm::HRTFHQ => { 6 as i64 },
        Audio3DMixingRenderingAlgorithm::Auto => { 7 as i64 },
