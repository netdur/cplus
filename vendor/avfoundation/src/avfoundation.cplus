    KCGImagePropertyOrientationUpMirrored,
    KCGImagePropertyOrientationDown,
    KCGImagePropertyOrientationDownMirrored,
    KCGImagePropertyOrientationLeftMirrored,
    KCGImagePropertyOrientationRight,
    KCGImagePropertyOrientationRightMirrored,
    KCGImagePropertyOrientationLeft,
}

fn c_g_image_property_orientation_raw(v: CGImagePropertyOrientation) -> i64 {
    return match v {
        CGImagePropertyOrientation::KCGImagePropertyOrientationUp => { 1 as i64 },
        CGImagePropertyOrientation::KCGImagePropertyOrientationUpMirrored => { 2 as i64 },
        CGImagePropertyOrientation::KCGImagePropertyOrientationDown => { 3 as i64 },
        CGImagePropertyOrientation::KCGImagePropertyOrientationDownMirrored => { 4 as i64 },
        CGImagePropertyOrientation::KCGImagePropertyOrientationLeftMirrored => { 5 as i64 },
        CGImagePropertyOrientation::KCGImagePropertyOrientationRight => { 6 as i64 },
        CGImagePropertyOrientation::KCGImagePropertyOrientationRightMirrored => { 7 as i64 },
        CGImagePropertyOrientation::KCGImagePropertyOrientationLeft => { 8 as i64 },
    };
}

fn c_g_image_property_orientation_from_raw(raw: i64) -> CGImagePropertyOrientation {
    if raw == (2 as i64) { return CGImagePropertyOrientation::KCGImagePropertyOrientationUpMirrored; }
    if raw == (3 as i64) { return CGImagePropertyOrientation::KCGImagePropertyOrientationDown; }
    if raw == (4 as i64) { return CGImagePropertyOrientation::KCGImagePropertyOrientationDownMirrored; }
    if raw == (5 as i64) { return CGImagePropertyOrientation::KCGImagePropertyOrientationLeftMirrored; }
    if raw == (6 as i64) { return CGImagePropertyOrientation::KCGImagePropertyOrientationRight; }
    if raw == (7 as i64) { return CGImagePropertyOrientation::KCGImagePropertyOrientationRightMirrored; }
    if raw == (8 as i64) { return CGImagePropertyOrientation::KCGImagePropertyOrientationLeft; }
    return CGImagePropertyOrientation::KCGImagePropertyOrientationUp;
}

