}

fn audio3_d_mixing_rendering_algorithm_from_raw(raw: i64) -> Audio3DMixingRenderingAlgorithm {
    if raw == (1 as i64) { return Audio3DMixingRenderingAlgorithm::SphericalHead; }
    if raw == (2 as i64) { return Audio3DMixingRenderingAlgorithm::HRTF; }
    if raw == (3 as i64) { return Audio3DMixingRenderingAlgorithm::SoundField; }
    if raw == (5 as i64) { return Audio3DMixingRenderingAlgorithm::StereoPassThrough; }
    if raw == (6 as i64) { return Audio3DMixingRenderingAlgorithm::HRTFHQ; }
    if raw == (7 as i64) { return Audio3DMixingRenderingAlgorithm::Auto; }
    return Audio3DMixingRenderingAlgorithm::EqualPowerPanning;
}

