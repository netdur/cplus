    fn available_reaction_types(this) -> string_set::StringSet {
        let set: *u8 = rt::msg_id(this._obj, rt::sel(#str_ptr("availableReactionTypes\0")));
        let arr: *u8 = rt::msg_id(set, rt::sel(#str_ptr("allObjects\0")));
        let n: u64 = rt::msg_u64(arr, rt::sel(#str_ptr("count\0")));
        var out: string_set::StringSet = string_set::with_capacity(n as usize);
        let at_sel: *u8 = rt::sel(#str_ptr("objectAtIndex:\0"));
        var i: u64 = 0 as u64;
        while i < n {
            let value: *u8 = rt::msg_id_u64(arr, at_sel, i);
            let _st: status::Status = out.insert(bridge::to_text(value));
            i = i +% (1 as u64);
        }
        return out;
    }

