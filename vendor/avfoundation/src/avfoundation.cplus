    fn set_fallback_primary_constituent_devices(this, fallback_primary_constituent_devices: vec::Vec[CaptureDevice]) {
        let arr_fallback_primary_constituent_devices: *u8 = rt::msg_id(rt::get_class(#str_ptr("NSMutableArray\0")), rt::sel(#str_ptr("array\0")));
        let add_sel_fallback_primary_constituent_devices: *u8 = rt::sel(#str_ptr("addObject:\0"));
        let n_fallback_primary_constituent_devices: usize = fallback_primary_constituent_devices.count();
        var i_fallback_primary_constituent_devices: usize = 0 as usize;
        while i_fallback_primary_constituent_devices < n_fallback_primary_constituent_devices {
            match fallback_primary_constituent_devices.at_ptr(i_fallback_primary_constituent_devices) {
                option::Option[*CaptureDevice]::Some(e_fallback_primary_constituent_devices) => { rt::msg_void_id(arr_fallback_primary_constituent_devices, add_sel_fallback_primary_constituent_devices, (*e_fallback_primary_constituent_devices).raw()); }
                option::Option[*CaptureDevice]::None => {}
            }
            i_fallback_primary_constituent_devices = i_fallback_primary_constituent_devices +% (1 as usize);
        }
        rt::msg_void_id(this._obj, rt::sel(#str_ptr("setFallbackPrimaryConstituentDevices:\0")), arr_fallback_primary_constituent_devices);
    }

