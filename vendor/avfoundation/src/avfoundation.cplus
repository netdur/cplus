impl SpeechSynthesisVoice {
    fn raw(this) -> *u8 { return this._obj; }

    fn from_raw(ptr: *u8) -> SpeechSynthesisVoice { return SpeechSynthesisVoice { _obj: ptr }; }

    fn speech_voices() -> vec::Vec[SpeechSynthesisVoice] {
        let arr: *u8 = rt::msg_id(rt::get_class(#str_ptr("AVSpeechSynthesisVoice\0")), rt::sel(#str_ptr("speechVoices\0")));
        let n: u64 = rt::msg_u64(arr, rt::sel(#str_ptr("count\0")));
        var out: vec::Vec[SpeechSynthesisVoice] = vec::Vec[SpeechSynthesisVoice]::with_capacity(n as usize);
        let at_sel: *u8 = rt::sel(#str_ptr("objectAtIndex:\0"));
        var i: u64 = 0 as u64;
        while i < n {
            out.append(SpeechSynthesisVoice::from_raw(rt::msg_id_u64(arr, at_sel, i)));
            i = i +% (1 as u64);
        }
        return out;
    }

    fn current_language_code() -> text::Text {
        let ns: *u8 = rt::msg_id(rt::get_class(#str_ptr("AVSpeechSynthesisVoice\0")), rt::sel(#str_ptr("currentLanguageCode\0")));
        return bridge::to_text(ns);
    }

    fn voice_with_language(language_code: str) -> option::Option[SpeechSynthesisVoice] {
        let obj: *u8 = rt::msg_id_id(rt::get_class(#str_ptr("AVSpeechSynthesisVoice\0")), rt::sel(#str_ptr("voiceWithLanguage:\0")), bridge::nsstring(language_code));
        if obj == { 0 as *u8 } {
            return option::Option[SpeechSynthesisVoice]::None;
        }
        return option::some(SpeechSynthesisVoice { _obj: obj });
    }

    fn voice_with_identifier(identifier: str) -> option::Option[SpeechSynthesisVoice] {
        let obj: *u8 = rt::msg_id_id(rt::get_class(#str_ptr("AVSpeechSynthesisVoice\0")), rt::sel(#str_ptr("voiceWithIdentifier:\0")), bridge::nsstring(identifier));
        if obj == { 0 as *u8 } {
            return option::Option[SpeechSynthesisVoice]::None;
        }
        return option::some(SpeechSynthesisVoice { _obj: obj });
    }

    fn language(this) -> text::Text {
        let ns: *u8 = rt::msg_id(this._obj, rt::sel(#str_ptr("language\0")));
        return bridge::to_text(ns);
    }

    fn identifier(this) -> text::Text {
        let ns: *u8 = rt::msg_id(this._obj, rt::sel(#str_ptr("identifier\0")));
        return bridge::to_text(ns);
    }

    fn name(this) -> text::Text {
        let ns: *u8 = rt::msg_id(this._obj, rt::sel(#str_ptr("name\0")));
        return bridge::to_text(ns);
    }

