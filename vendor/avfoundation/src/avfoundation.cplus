        let arr_channel_assignments: *u8 = rt::msg_id(rt::get_class(#str_ptr("NSMutableArray\0")), rt::sel(#str_ptr("array\0")));
        let add_sel_channel_assignments: *u8 = rt::sel(#str_ptr("addObject:\0"));
        let n_channel_assignments: usize = channel_assignments.count();
        var i_channel_assignments: usize = 0 as usize;
        while i_channel_assignments < n_channel_assignments {
            match channel_assignments.at_ptr(i_channel_assignments) {
                option::Option[*AudioSessionChannelDescription]::Some(e_channel_assignments) => { rt::msg_void_id(arr_channel_assignments, add_sel_channel_assignments, (*e_channel_assignments).raw()); }
                option::Option[*AudioSessionChannelDescription]::None => {}
            }
            i_channel_assignments = i_channel_assignments +% (1 as usize);
        }
        rt::msg_void_id(this._obj, rt::sel(#str_ptr("setChannelAssignments:\0")), arr_channel_assignments);
    }

