// facet_win32/dnd — receiving a drop, and the half of drag-and-drop that does
// not need COM.
//
// facet declares five drag verbs and three sender readers. Win32 offers two
// routes to them and the difference decides what this file can be:
//
//   `WM_DROPFILES`   shell drag-drop. `DragAcceptFiles(h, TRUE)` and the
//                    window is a drop target for FILES. No COM, no
//                    registration, four calls in total.
//   `IDropTarget`    OLE drag-drop. Every format, every edge, and a drag
//                    SOURCE — and it is a COM object: a vtable of seven
//                    function pointers, refcounting, and an `IDataObject`
//                    reached by two more vtable calls to get at the payload.
//
// THIS FILE IS THE FIRST ONE, and the choice is the same one `imaging` made
// against WIC: this package has no COM anywhere, and the shape of the thing
// that would introduce it should be a deliberate decision rather than a side
// effect of wanting one verb.
//
// What that delivers, completely:
//
//   `on_drop`         a file dropped on the node
//   `dropped_text`    the paths, one per line — a drop of three files is three
//                     lines, which is what an application can act on without
//                     this package inventing a container facet does not have
//   `drop_position`   where it landed, in the node's own coordinates
//   `drag_targeted`   whether this node accepts drops at all
//
// What it does not, and MANIFEST §2 says so with this file named: `on_drag_over`
// and `on_drag_leave` have no `WM_DROPFILES` equivalent — the shell sends one
// message, at the drop, and nothing while the pointer is travelling. And
// `on_drag_start` / `on_drop_completed` are the SOURCE half, which is
// `DoDragDrop` and therefore COM again.

import "stdlib/option" as option;
import "stdlib/text" as text;
import "facet/facet" as core;
import "facet/gestures" as gestures;
import "facet/vocabulary" as vocab;
import "win32/winuser" as u;
import "./sys" as sys;

fn wm_dropfiles() -> u32 { return 0x0233 as u32; }

// `DragQueryFile` with 0xFFFFFFFF answers the COUNT rather than a name — the
// same call with two meanings, which is why the sentinel is named.
fn dq_count() -> u32 { return 0xFFFFFFFF as u32; }

#[link_name = "DragAcceptFiles"]
extern fn drag_accept_files(h: *u8, accept: i32);
#[link_name = "DragQueryFileW"]
extern fn drag_query_file(drop: *u8, i: u32, buf: *u16, cch: u32) -> u32;
#[link_name = "DragQueryPoint"]
extern fn drag_query_point(drop: *u8, pt: *u8) -> i32;
#[link_name = "DragFinish"]
extern fn drag_finish(drop: *u8);

// The last drop, held until the handler has read it. facet's readers are
// pull-based — a handler is called and then ASKS what was dropped — so the
// payload has to outlive the notification, and it is cleared on the next one
// rather than at the end of the call.
//
// ONE DROP AT A TIME is not a limitation to record: a pointer performs one
// drop, and the handler runs synchronously inside it.
static DROP_TEXT: text::Text = #zero::[text::Text]();
static DROP_NODE: usize = 0;
static DROP_X: f64 = 0.0f64;
static DROP_Y: f64 = 0.0f64;
static DROP_HAS: bool = false;

// Arm or disarm the window. Called from `input::arm`, so a node that gains a
// drop handler later gains the target with it.
//
// GATED ON THE HANDLER, because `DragAcceptFiles` changes what the SHELL does
// with this window — a window that accepts files shows the drop cursor over
// every part of itself. A node with no `on_drop` must not claim to take one.
fn arm(v: *u8, gs: *gestures::Gestures) {
    if v == (0 as *u8) { return; }
    let wants: bool = gs != (0 as *gestures::Gestures)
                   && { (*gs).on_drop } != gestures::no_gesture;
    let now: bool = { u::GetPropA(v, sys::prop_drop() as *i8) } != (0 as *u8);
    if wants == now { return; }
    { drag_accept_files(v, if wants { 1 as i32 } else { 0 as i32 }) };
    if wants {
        let _p: i32 = { u::SetPropA(v, sys::prop_drop() as *i8, 1 as *u8) };
    } else {
        let _r: *u8 = { u::RemovePropA(v, sys::prop_drop() as *i8) };
    }
    return;
}

fn accepts(v: *u8) -> bool {
    if v == (0 as *u8) { return false; }
    return { u::GetPropA(v, sys::prop_drop() as *i8) } != (0 as *u8);
}

// WM_DROPFILES. `w` is an HDROP and it is OURS TO FINISH — `DragFinish` frees
// the shell's copy, and skipping it leaks the whole payload on every drop.
fn on_drop_files(v: *u8, w: u64, n: *core::Node) -> bool {
    let drop: *u8 = w as *u8;
    if drop == (0 as *u8) { return false; }
    let count: u32 = { drag_query_file(drop, dq_count(), 0 as *u16, 0 as u32) };
    var joined: text::Text = text::new();
    var i: u32 = 0 as u32;
    while i < count {
        // ASKED FOR THE LENGTH FIRST. A path can be longer than MAX_PATH and a
        // fixed buffer would truncate one silently — the caller would then open
        // a file that is not the one dropped.
        let need: u32 = { drag_query_file(drop, i, 0 as *u16, 0 as u32) };
        if need > (0 as u32) {
            let bytes: usize = ((need as usize) +% (1 as usize)) *% (2 as usize);
            let buf: *u8 = { dnd_malloc(bytes) };
            if !buf.is_null() {
                let w16: *u16 = buf as *u16;
                let got: u32 = { drag_query_file(drop, i, w16, need +% (1 as u32)) };
                if got > (0 as u32) {
                    if i > (0 as u32) { joined = joined.appending("\n"); }
                    joined = joined.appending(sys::from_wide(w16).view());
                }
                { dnd_free(buf) };
            }
        }
        i = i +% (1 as u32);
    }
    // WHERE, in the node's own space — which is what `drop_position` promises
    // and what a handler needs to decide which part of itself was hit.
    let pt: *u8 = { dnd_malloc(8 as usize) };
    var x: f64 = 0.0f64;
    var y: f64 = 0.0f64;
    if !pt.is_null() {
        if { drag_query_point(drop, pt) } != (0 as i32) {
            let xs: *i32 = pt as *i32;
            let ys: *i32 = { (pt + (4 as usize)) } as *i32;
            x = { *xs } as f64;
            y = { *ys } as f64;
        }
        { dnd_free(pt) };
    }
    { drag_finish(drop) };

    DROP_TEXT = joined;
    DROP_NODE = { #addr(v) };
    DROP_X = x;
    DROP_Y = y;
    DROP_HAS = true;
    let gs: *gestures::Gestures = gestures::gestures_of(n);
    if gs.is_null() { return false; }
    return gestures::fire(n, { (*gs).on_drop }, { (*gs).on_drop_ctx });
}

// ---- the three readers ------------------------------------------------------------
//
// Each answers for the node that was actually dropped on, and NOTHING for any
// other — a handler that asked a different node would otherwise be told about
// a drop that did not land there.

fn dropped_text(sender: *u8) -> text::Text {
    if !DROP_HAS { return text::new(); }
    if DROP_NODE != { #addr(sender) } { return text::new(); }
    return DROP_TEXT.clone();
}

fn drop_position(sender: *u8) -> option::Option[vocab::Point] {
    if !DROP_HAS { return option::Option[vocab::Point]::None; }
    if DROP_NODE != { #addr(sender) } { return option::Option[vocab::Point]::None; }
    return option::Option[vocab::Point]::Some(vocab::Point { x: DROP_X, y: DROP_Y });
}

// WHETHER THIS NODE TAKES DROPS, which is what the verb asks and not "is a
// drag over it right now" — that second question needs the drag-over edge
// `WM_DROPFILES` does not have, and answering it with a guess would be worse
// than answering the one that is knowable.
fn drag_targeted(sender: *u8) -> bool {
    return accepts(sender);
}

#[link_name = "malloc"]
extern fn dnd_malloc(n: usize) -> *u8;
#[link_name = "free"]
extern fn dnd_free(p: *u8);

#[test]
fn a_reader_answers_only_for_the_node_that_was_dropped_on() {
    // The isolation that makes these safe to install globally: a handler on
    // another node asking `dropped_text` must be told nothing, not told about
    // someone else's drop.
    DROP_HAS = true;
    DROP_NODE = 1234 as usize;
    DROP_TEXT = text::from_str("C:/a.png");
    assert dropped_text(1234 as *u8).view() == "C:/a.png";
    assert dropped_text(5678 as *u8).view() == "";
    assert match drop_position(5678 as *u8) {
        option::Option[vocab::Point]::Some(_p) => false,
        option::Option[vocab::Point]::None => true,
    };
    DROP_HAS = false;
    // And before anything has been dropped at all.
    assert dropped_text(1234 as *u8).view() == "";
    return;
}

#[test]
fn a_window_with_no_drop_handler_is_not_a_drop_target() {
    // `DragAcceptFiles` changes what the SHELL does with the window — it shows
    // the drop cursor over all of it — so claiming to accept a drop nothing
    // will handle is a lie told to the user, not just a wasted call.
    assert !accepts(0 as *u8);
    arm(0 as *u8, 0 as *gestures::Gestures);
    return;
}
