// facet_win32/menustrip — a BLENDED window's menu bar, drawn in the client area.
//
// A window whose caption `caption` has removed cannot keep user32's menu bar,
// and that was measured, not assumed, three ways:
//
//   * WITH WS_CAPTION and the client stretched over the caption (the usual
//     recipe), user32 still positions the bar from the caption's metrics — so it
//     lands under the content — and DWM draws its own minimise / maximise /
//     close glyphs into the strip of non-client area the bar leaves. Seen: the
//     system's three buttons across the top, no File / Edit.
//   * WITHOUT WS_CAPTION the bar is drawn, but by the CLASSIC path: user32 sends
//     WM_UAHDRAWMENU / WM_UAHDRAWMENUITEM only to a captioned window (counted on
//     `playground/win32_bugs_probe`: a dozen per paint with the caption, none
//     without). So in a dark app it stays a white strip whatever `menus` does.
//   * Moving the client top into the frame leaves the bar painted where the
//     frame was, half under the content.
//
// So a blended window's HMENU is DETACHED from the window and handed to this
// strip: a child window across the top of the client area that draws the bar's
// titles itself, in the window's own ground and ink — dark or light, the same
// colours as everything else in it — and opens each title's popup with
// `TrackPopupMenuEx`. The popups are the same HMENUs `menus` built, so their
// commands arrive as WM_COMMAND with the ids `menus::fire` already answers, and
// they are dark through the same uxtheme opt-in as any other popup.
//
// facet_winui made the same call for the same reason (its command strip): a
// window that owns its whole surface draws its own menu.
//
// What the strip does NOT do yet, recorded in MANIFEST §2: keyboard access (F10
// and Alt+letter reach a bar user32 owns, and this one it does not), and sliding
// from one open menu to the next while the mouse button is held.

import "win32/winuser" as u;
import "win32/wingdi" as gdi;
import "./sys" as sys;
import "./paint" as paint;
import "./fonts" as fonts;

// In LOGICAL points, scaled at the seams like the rest of the layout.
fn strip_height() -> f64 { return 28.0f64; }
fn item_pad() -> f64 { return 10.0f64; }
fn edge_pad() -> f64 { return 4.0f64; }

fn prop_strip() -> *u8 { return { #str_ptr("facet-menustrip\0") }; }
fn prop_menu() -> *u8 { return { #str_ptr("facet-menustrip-menu\0") }; }
fn prop_old() -> *u8 { return { #str_ptr("facet-menustrip-oldproc\0") }; }
fn prop_hot() -> *u8 { return { #str_ptr("facet-menustrip-hot\0") }; }
fn prop_open() -> *u8 { return { #str_ptr("facet-menustrip-open\0") }; }

// The strip of a top-level window, or null.
fn strip_of(win: *u8) -> *u8 {
    if win == (0 as *u8) { return 0 as *u8; }
    return { u::GetPropA(win, prop_strip() as *i8) };
}

fn is_strip(v: *u8) -> bool {
    if v == (0 as *u8) { return false; }
    return { u::GetPropA(v, prop_old() as *i8) } != (0 as *u8);
}

// How much of the client area the strip takes, in points: zero without one.
fn height_for(win: *u8) -> f64 {
    let s: *u8 = strip_of(win);
    if s == (0 as *u8) { return 0.0f64; }
    if { u::GetPropA(s, prop_menu() as *i8) } == (0 as *u8) { return 0.0f64; }
    return strip_height();
}

// ---- state riding window properties ----------------------------------------------
//
// Hot and open are item indices; stored +1 so that "none" is the absent
// property rather than a sentinel that collides with item 0.
fn get_index(v: *u8, which: *u8) -> i32 {
    let raw: usize = { #addr({ u::GetPropA(v, which as *i8) }) };
    if raw == (0 as usize) { return 0 -% (1 as i32); }
    return (raw as i32) -% (1 as i32);
}

fn set_index(v: *u8, which: *u8, i: i32) {
    if i < (0 as i32) { let _r: *u8 = { u::RemovePropA(v, which as *i8) }; return; }
    let _s: i32 = { u::SetPropA(v, which as *i8, ((i +% (1 as i32)) as usize) as *u8) };
    return;
}

// ---- adopting a window's bar -----------------------------------------------------

fn proc_addr() -> *u8 {
    let f: fn(*u8, u32, u64, i64) -> i64 = strip_proc;
    return f as *u8;
}

// Take `bar` for `win`'s strip, making the strip if there is none yet. The bar
// the strip held before is destroyed — `SetMenu` would have done the same for a
// bar on the window, and the strip is where this window's bar lives now.
fn adopt(win: *u8, bar: *u8) {
    if win == (0 as *u8) { return; }
    var s: *u8 = strip_of(win);
    if s == (0 as *u8) {
        s = { u::CreateWindowExA(0 as u32, sys::panel_class() as *i8,
                                 { #str_ptr("\0") } as *i8,
                                 sys::ws_child() | sys::ws_visible() | sys::ws_clipsiblings(),
                                 0 as i32, 0 as i32, 0 as i32, 0 as i32,
                                 win, 0 as *u8, { u::GetWindowLongPtrA(win, 0 -% (6 as i32)) } as *u8,
                                 0 as *u8) };
        if s == (0 as *u8) { return; }
        let old: i64 = { u::SetWindowLongPtrA(s, sys::gwlp_wndproc(), proc_addr() as i64) };
        let _p: i32 = { u::SetPropA(s, prop_old() as *i8, old as *u8) };
        let _q: i32 = { u::SetPropA(win, prop_strip() as *i8, s) };
    }
    let previous: *u8 = { u::GetPropA(s, prop_menu() as *i8) };
    if previous != (0 as *u8) && previous != bar { let _d: i32 = { u::DestroyMenu(previous) }; }
    if bar == (0 as *u8) {
        let _r: *u8 = { u::RemovePropA(s, prop_menu() as *i8) };
    } else {
        let _m: i32 = { u::SetPropA(s, prop_menu() as *i8, bar) };
    }
    let _i: i32 = { u::InvalidateRect(s, 0 as *u::tagRECT, 1 as i32) };
    return;
}

// Lay the strip across the top of the client area. `width` in points.
fn place(win: *u8, width: f64) {
    let s: *u8 = strip_of(win);
    if s == (0 as *u8) { return; }
    let scale: f64 = sys::dpi_scale(win);
    let h: i32 = if height_for(win) > (0.0f64) { (strip_height() * scale) as i32 } else { 0 as i32 };
    let _p: i32 = { u::SetWindowPos(s, 0 as *u8, 0 as i32, 0 as i32,
                                    (width * scale) as i32, h,
                                    sys::swp_nozorder() | sys::swp_noactivate()) };
    return;
}

// ---- the items ------------------------------------------------------------------

fn menu_of(s: *u8) -> *u8 { return { u::GetPropA(s, prop_menu() as *i8) }; }

fn font_of(s: *u8) -> *u8 { return fonts::font_for(s, fonts::no_font()); }

// An item's title, UTF-16, into `buf`; answers its length.
fn title_of(menu: *u8, i: i32, buf: *u16) -> i32 {
    // MF_BYPOSITION (0x400) — a popup on the bar has no command id.
    return { u::GetMenuStringW(menu, i as u32, buf, 127 as i32, 0x0400 as u32) };
}

// Item `i`'s rect in the strip's client coordinates, measured in its font.
fn item_rect(s: *u8, i: i32, out: *u::tagRECT) -> bool {
    let menu: *u8 = menu_of(s);
    if menu == (0 as *u8) { return false; }
    let n: i32 = { u::GetMenuItemCount(menu) };
    if i < (0 as i32) || i >= n { return false; }
    var cr: u::tagRECT = u::tagRECT { left: 0 as i32, top: 0 as i32,
                                      right: 0 as i32, bottom: 0 as i32 };
    let _c: i32 = { u::GetClientRect(s, #addr_of(cr)) };
    let scale: f64 = sys::dpi_scale(s);
    let pad: i32 = (item_pad() * scale) as i32;
    let hdc: *u8 = { u::GetDC(s) };
    if hdc == (0 as *u8) { return false; }
    let oldf: *u8 = { gdi::SelectObject(hdc, font_of(s)) };
    var x: i32 = (edge_pad() * scale) as i32;
    var k: i32 = 0 as i32;
    var found: bool = false;
    while k <= i {
        var buf: [u16; 128] = [0 as u16; 128];
        let len: i32 = title_of(menu, k, { #addr_of(buf[0]) } as *u16);
        var sz: gdi::tagSIZE = gdi::tagSIZE { cx: 0 as i32, cy: 0 as i32 };
        if len > (0 as i32) {
            let _t: i32 = { gdi::GetTextExtentPoint32W(hdc, { #addr_of(buf[0]) } as *u16, len, #addr_of(sz)) };
        }
        let w: i32 = sz.cx +% (pad *% (2 as i32));
        if k == i {
            { (*out).left = x };
            { (*out).right = x +% w };
            { (*out).top = cr.top };
            { (*out).bottom = cr.bottom };
            found = true;
        }
        x = x +% w;
        k = k +% (1 as i32);
    }
    if oldf != (0 as *u8) { let _o: *u8 = { gdi::SelectObject(hdc, oldf) }; }
    let _r: i32 = { u::ReleaseDC(s, hdc) };
    return found;
}

// Which item is under a strip-client x, or -1 — the strip's empty run is not
// an item, and in a blended window it is part of the drag region.
fn item_at(s: *u8, x: i32) -> i32 {
    let menu: *u8 = menu_of(s);
    if menu == (0 as *u8) { return 0 -% (1 as i32); }
    let n: i32 = { u::GetMenuItemCount(menu) };
    var i: i32 = 0 as i32;
    while i < n {
        var r: u::tagRECT = u::tagRECT { left: 0 as i32, top: 0 as i32,
                                         right: 0 as i32, bottom: 0 as i32 };
        if item_rect(s, i, #addr_of(r)) {
            if x >= r.left && x < r.right { return i; }
        }
        i = i +% (1 as i32);
    }
    return 0 -% (1 as i32);
}

// ---- painting ----------------------------------------------------------------------

fn ground(s: *u8) -> u32 { return paint::effective_bg(s); }

// Hot and open are a step and two off the ground, in the direction away from
// the ink — lighter on a dark window, darker on a light one.
fn shade(bg: u32, steps: i32) -> u32 {
    let r: i32 = (bg & (0xFF as u32)) as i32;
    let g: i32 = ((bg >> (8 as u32)) & (0xFF as u32)) as i32;
    let b: i32 = ((bg >> (16 as u32)) & (0xFF as u32)) as i32;
    let dark: bool = (r +% g +% b) < (384 as i32);
    let d: i32 = if dark { 22 *% steps } else { 0 -% (16 *% steps) };
    return (clamp_byte(r +% d) as u32) | ((clamp_byte(g +% d) as u32) << (8 as u32))
         | ((clamp_byte(b +% d) as u32) << (16 as u32));
}

fn clamp_byte(v: i32) -> i32 {
    if v < (0 as i32) { return 0 as i32; }
    if v > (255 as i32) { return 255 as i32; }
    return v;
}

fn fill(hdc: *u8, r: *u::tagRECT, c: u32) {
    let b: *u8 = paint::brush_for(c);
    if b == (0 as *u8) { return; }
    let _f: i32 = { u::FillRect(hdc, r, b) };
    return;
}

fn paint_strip(s: *u8, hdc: *u8) {
    var cr: u::tagRECT = u::tagRECT { left: 0 as i32, top: 0 as i32,
                                      right: 0 as i32, bottom: 0 as i32 };
    let _c: i32 = { u::GetClientRect(s, #addr_of(cr)) };
    let bg: u32 = ground(s);
    fill(hdc, #addr_of(cr), bg);
    let menu: *u8 = menu_of(s);
    if menu == (0 as *u8) { return; }
    let n: i32 = { u::GetMenuItemCount(menu) };
    let hot: i32 = get_index(s, prop_hot());
    let open: i32 = get_index(s, prop_open());
    let active: bool = { u::GetActiveWindow() } == { u::GetAncestor(s, 2 as u32) };
    let ink: u32 = paint::ink_over(bg);
    // An inactive window's titles dim, as user32's own bar does.
    let dim: u32 = shade(ink, 0 -% (5 as i32));
    let oldf: *u8 = { gdi::SelectObject(hdc, font_of(s)) };
    let _m: i32 = { gdi::SetBkMode(hdc, 1 as i32) };              // TRANSPARENT
    var i: i32 = 0 as i32;
    while i < n {
        var r: u::tagRECT = u::tagRECT { left: 0 as i32, top: 0 as i32,
                                         right: 0 as i32, bottom: 0 as i32 };
        if item_rect(s, i, #addr_of(r)) {
            if i == open { fill(hdc, #addr_of(r), shade(bg, 2 as i32)); }
            else { if i == hot { fill(hdc, #addr_of(r), shade(bg, 1 as i32)); } }
            var buf: [u16; 128] = [0 as u16; 128];
            let len: i32 = title_of(menu, i, { #addr_of(buf[0]) } as *u16);
            if len > (0 as i32) {
                let _t: u32 = { gdi::SetTextColor(hdc, if active { ink } else { dim }) };
                // DT_CENTER | DT_VCENTER | DT_SINGLELINE | DT_HIDEPREFIX
                let _d: i32 = { u::DrawTextW(hdc, { #addr_of(buf[0]) } as *u16, len,
                                             #addr_of(r), 0x00100025 as u32) };
            }
        }
        i = i +% (1 as i32);
    }
    if oldf != (0 as *u8) { let _o: *u8 = { gdi::SelectObject(hdc, oldf) }; }
    return;
}

// ---- opening a menu -----------------------------------------------------------------

// TrackPopupMenuEx BLOCKS until the menu closes — the same modal shape as
// `menus::show_context_menu` — and the chosen command is POSTED to the owner as
// WM_COMMAND, so it reaches `menus::fire` exactly as a click on a real bar would.
fn open_item(s: *u8, i: i32) {
    let menu: *u8 = menu_of(s);
    if menu == (0 as *u8) { return; }
    let win: *u8 = { u::GetAncestor(s, 2 as u32) };
    var r: u::tagRECT = u::tagRECT { left: 0 as i32, top: 0 as i32,
                                     right: 0 as i32, bottom: 0 as i32 };
    if !item_rect(s, i, #addr_of(r)) { return; }
    let popup: *u8 = { u::GetSubMenu(menu, i) };
    if popup == (0 as *u8) {
        // A plain command on the bar itself, which a declared `menu` tree can
        // make: it is a click, not a menu.
        let id: u32 = { u::GetMenuItemID(menu, i) };
        let _p: i32 = { u::PostMessageA(win, sys::wm_command(), id as u64, 0 as i64) };
        return;
    }
    var pt: u::tagPOINT = u::tagPOINT { x: r.left, y: r.bottom };
    let _c: i32 = { u::ClientToScreen(s, #addr_of(pt)) };
    set_index(s, prop_open(), i);
    let _i: i32 = { u::InvalidateRect(s, 0 as *u::tagRECT, 0 as i32) };
    let _w: i32 = { u::UpdateWindow(s) };
    // TPM_LEFTALIGN | TPM_TOPALIGN | TPM_LEFTBUTTON (all zero) and TPM_VERTICAL
    // (0x40): if the menu does not fit below, it flips above rather than
    // covering the title it came from.
    let _t: i32 = { u::TrackPopupMenuEx(popup, 0x0040 as u32, pt.x, pt.y, win,
                                        0 as *u::tagTPMPARAMS) };
    set_index(s, prop_open(), 0 -% (1 as i32));
    set_index(s, prop_hot(), 0 -% (1 as i32));
    let _j: i32 = { u::InvalidateRect(s, 0 as *u::tagRECT, 0 as i32) };
    return;
}

// ---- the strip's procedure ----------------------------------------------------------

fn lo_x(l: i64) -> i32 {
    let v: i32 = (l & (0xFFFF as i64)) as i32;
    if v >= (0x8000 as i32) { return v -% (0x10000 as i32); }
    return v;
}

fn track_leave(s: *u8) {
    var t: u::tagTRACKMOUSEEVENT = #zero::[u::tagTRACKMOUSEEVENT]();
    t.cbSize = #size_of::[u::tagTRACKMOUSEEVENT]() as u32;
    t.dwFlags = 0x0002 as u32;                                  // TME_LEAVE
    t.hwndTrack = s;
    let _t: i32 = { u::TrackMouseEvent(#addr_of(t)) };
    return;
}

fn strip_proc(hwnd: *u8, msg: u32, w: u64, l: i64) -> i64 {
    let old: *u8 = { u::GetPropA(hwnd, prop_old() as *i8) };
    if old == (0 as *u8) { return { u::DefWindowProcA(hwnd, msg, w, l) }; }
    if msg == sys::wm_paint() {
        var ps: u::tagPAINTSTRUCT = #zero::[u::tagPAINTSTRUCT]();
        let hdc: *u8 = { u::BeginPaint(hwnd, #addr_of(ps)) };
        if hdc != (0 as *u8) { paint_strip(hwnd, hdc); }
        let _e: i32 = { u::EndPaint(hwnd, #addr_of(ps)) };
        return 0 as i64;
    }
    if msg == sys::wm_erasebkgnd() { return 1 as i64; }
    if msg == sys::wm_mousemove() {
        let i: i32 = item_at(hwnd, lo_x(l));
        if i != get_index(hwnd, prop_hot()) {
            set_index(hwnd, prop_hot(), i);
            let _i: i32 = { u::InvalidateRect(hwnd, 0 as *u::tagRECT, 0 as i32) };
        }
        track_leave(hwnd);
        return 0 as i64;
    }
    if msg == (0x02A3 as u32) {                                 // WM_MOUSELEAVE
        set_index(hwnd, prop_hot(), 0 -% (1 as i32));
        let _i: i32 = { u::InvalidateRect(hwnd, 0 as *u::tagRECT, 0 as i32) };
        return 0 as i64;
    }
    if msg == sys::wm_lbuttondown() {
        let i: i32 = item_at(hwnd, lo_x(l));
        if i >= (0 as i32) { open_item(hwnd, i); }
        return 0 as i64;
    }
    if msg == (0x0082 as u32) {                                 // WM_NCDESTROY
        let menu: *u8 = menu_of(hwnd);
        if menu != (0 as *u8) { let _d: i32 = { u::DestroyMenu(menu) }; }
        let _a: *u8 = { u::RemovePropA(hwnd, prop_menu() as *i8) };
        let _b: *u8 = { u::RemovePropA(hwnd, prop_hot() as *i8) };
        let _c: *u8 = { u::RemovePropA(hwnd, prop_open() as *i8) };
        let _o: i64 = { u::SetWindowLongPtrA(hwnd, sys::gwlp_wndproc(), old as i64) };
        let _r: *u8 = { u::RemovePropA(hwnd, prop_old() as *i8) };
        return { u::CallWindowProcA(old, hwnd, msg, w, l) };
    }
    return { u::CallWindowProcA(old, hwnd, msg, w, l) };
}

#[test]
fn hot_and_open_shade_away_from_the_ink() {
    // Lighter on a dark ground, darker on a light one, and never past the ends.
    let dark: u32 = paint::colorref(0.12f64, 0.12f64, 0.12f64);
    assert (shade(dark, 1 as i32) & (0xFF as u32)) > (dark & (0xFF as u32));
    let light: u32 = paint::colorref(0.95f64, 0.95f64, 0.95f64);
    assert (shade(light, 1 as i32) & (0xFF as u32)) < (light & (0xFF as u32));
    assert clamp_byte(300 as i32) == (255 as i32);
    assert clamp_byte(0 -% (4 as i32)) == (0 as i32);
    return;
}

#[test]
fn no_strip_takes_no_height() {
    assert height_for(0 as *u8) == (0.0f64);
    assert strip_of(0 as *u8) == (0 as *u8);
    return;
}
