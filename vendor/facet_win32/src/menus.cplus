// facet_win32/menus — the app menu bar, and a node's context menu.
//
// ---- an HMENU IS NOT A WINDOW ---------------------------------------------------
//
// Every other control in this package is an HWND: it has a node bound to it
// with `SetPropA`, it gets its own messages, and `input` finds its way back to
// facet by walking the window chain. A menu has none of that. An `HMENU` is an
// opaque handle with no properties, no window and no messages of its own — it
// reports a click as `WM_COMMAND` on the OWNING WINDOW with a COMMAND ID in the
// low word of wParam and lParam ZERO.
//
// That zero is the whole difference. A control notification carries the
// sending HWND in lParam, which is how `input::on_command` resolves a control
// with no id table at all. A menu carries nothing but a number, so the number
// has to mean something: this file keeps a table from command id to the facet
// node that owns the item, and the WNDPROC consults it exactly when lParam is
// zero.
//
// ---- WHY A TABLE IS SAFE HERE ------------------------------------------------------
//
// A per-control id table was rejected for controls (`input`'s header says so)
// because the message already carries the identity. Here it does not, and the
// table is bounded by the number of menu ITEMS an application declares — a
// count that is written in the source and does not grow at runtime.
//
// Ids start at 0x100. Below that is where Windows' own dialog answers live
// (IDOK is 1, IDCANCEL 2), and a menu item sharing a number with IDCANCEL is a
// menu item that fires when a dialog is dismissed.

import "stdlib/option" as option;
import "stdlib/text" as text;
import "stdlib/vec" as vec;
import "stdlib/status" as status;
import "facet/facet" as core;
import "facet/props" as props;
import "facet/vocabulary" as vocab;
import "facet/menu" as fmenu;
import "facet/menu_item" as fmenu_item;
import "facet/context_menu_item" as fctx_item;
import "win32/wingdi" as gdi;
import "./paint" as paint;
import "facet/screen" as screen;
import "win32/winuser" as u;
import "./sys" as sys;

// ---- menu flags ---------------------------------------------------------------------

fn mf_string() -> u32 { return 0x0000 as u32; }
fn mf_popup() -> u32 { return 0x0010 as u32; }
fn mf_separator() -> u32 { return 0x0800 as u32; }
fn mf_grayed() -> u32 { return 0x0001 as u32; }
fn mf_enabled() -> u32 { return 0x0000 as u32; }
fn mf_bycommand() -> u32 { return 0x0000 as u32; }

// TrackPopupMenu: return the choice rather than posting it, and align to the
// pointer. `TPM_RETURNCMD` is what makes a context menu answerable in one call
// instead of through a message that arrives later on a window that may have
// gone.
fn tpm_leftalign() -> u32 { return 0x0000 as u32; }
fn tpm_topalign() -> u32 { return 0x0000 as u32; }
fn tpm_returncmd() -> u32 { return 0x0100 as u32; }
fn tpm_rightbutton() -> u32 { return 0x0002 as u32; }

// ---- the command table -----------------------------------------------------------

struct Command {
    // The facet node whose props carry the handler. Zero for an app-menu item,
    // which is a `screen::MenuItem` rather than a node.
    node: usize,
    // The app-menu item's handler and context, for the other case.
    on_click: fn(*u8, *u8),
    ctx: usize,
    live: bool,
}

static COMMANDS: vec::Vec[Command] = #zero::[vec::Vec[Command]]();

fn first_command_id() -> u32 { return 0x100 as u32; }

fn id_of_slot(slot: usize) -> u32 { return first_command_id() +% (slot as u32); }

fn slot_of_id(id: u32) -> usize {
    if id < first_command_id() { return COMMANDS.count(); }
    return (id -% first_command_id()) as usize;
}

// Every id is minted fresh when a menu is (re)built. The table is CLEARED
// first: a rebuilt menu bar has different items, and a stale row would fire a
// handler for an item that is no longer on screen.
fn reset_commands() {
    COMMANDS = vec::new::[Command]();
    return;
}

fn add_node_command(n: *core::Node) -> u32 {
    let slot: usize = COMMANDS.count();
    let _e: status::Status = COMMANDS.append(Command {
        node: { #addr(n as *u8) }, on_click: props::no_handler,
        ctx: 0 as usize, live: true,
    });
    return id_of_slot(slot);
}

fn add_app_command(f: fn(*u8, *u8), ctx: *u8) -> u32 {
    let slot: usize = COMMANDS.count();
    let _e: status::Status = COMMANDS.append(Command {
        node: 0 as usize, on_click: f, ctx: { #addr(ctx) }, live: true,
    });
    return id_of_slot(slot);
}

// Fire the command an id names. Called from the WNDPROC when WM_COMMAND
// arrives with lParam zero — see the header for why that is the test.
fn fire(id: u32) -> bool {
    let slot: usize = slot_of_id(id);
    if slot >= COMMANDS.count() { return false; }
    return match COMMANDS.at_ptr(slot) {
        option::Option[*Command]::Some(c) => {
            if !{ (*c).live } { false } else { fire_command(c) }
        }
        option::Option[*Command]::None => false,
    };
}

fn fire_command(c: *Command) -> bool {
    let n: *core::Node = { (*c).node } as *core::Node;
    if n != (0 as *core::Node) { return fire_node_item(n); }
    let f: fn(*u8, *u8) = { (*c).on_click };
    if f == props::no_handler || f == (0 as fn(*u8, *u8)) { return false; }
    f(0 as *u8, { (*c).ctx } as *u8);
    return true;
}

// A `menu_item` or a `context_menu_item` node. Both carry the same two fields
// under different props, and the KIND is what says which — a viewless node has
// no window to ask.
fn fire_node_item(n: *core::Node) -> bool {
    let d: *core::Data = core::node_data(n);
    if d == (0 as *core::Data) { return false; }
    let kind: u32 = { (*d).kind };
    let p: *u8 = { (*d).props };
    if p == (0 as *u8) { return false; }
    if kind == props::K_MENU_ITEM {
        let q: *props::MenuItemProps = p as *props::MenuItemProps;
        let f: fn(*u8, *u8) = { (*q).on_clicked };
        if f == props::no_handler { return false; }
        f(n as *u8, { (*q).on_clicked_ctx });
        return true;
    }
    if kind == props::K_CONTEXT_MENU_ITEM {
        // A context-menu item EMBEDS the plain menu item rather than restating
        // it, so its text and handler live one level down.
        let q: *props::ContextMenuItemProps = p as *props::ContextMenuItemProps;
        let f: fn(*u8, *u8) = { (*q).menu_item.on_clicked };
        if f == props::no_handler { return false; }
        f(n as *u8, { (*q).menu_item.on_clicked_ctx });
        return true;
    }
    return false;
}

// ---- building a menu from nodes ---------------------------------------------------

fn append_text(menu: *u8, flags: u32, id: u32, t: text::Text) {
    match t.c_str() {
        option::Option[text::CString]::Some(cs) => {
            let _r: i32 = { u::AppendMenuA(menu, flags, id as u64, cs.as_ptr() as *i8) };
        }
        option::Option[text::CString]::None => { }
    }
    return;
}

fn item_text(n: *core::Node) -> text::Text {
    let d: *core::Data = core::node_data(n);
    if d == (0 as *core::Data) { return text::from_str(""); }
    let p: *u8 = { (*d).props };
    if p == (0 as *u8) { return text::from_str(""); }
    let kind: u32 = { (*d).kind };
    if kind == props::K_MENU_ITEM {
        return { (*(p as *props::MenuItemProps)).text }.clone();
    }
    if kind == props::K_CONTEXT_MENU_ITEM {
        let q: *props::ContextMenuItemProps = p as *props::ContextMenuItemProps;
        return with_shortcut({ (*q).menu_item.text }.clone(),
                             { (*q).shortcut_key }.clone(),
                             { (*q).shortcut_modifiers });
    }
    if kind == props::K_MENU {
        return { (*(p as *props::MenuProps)).text }.clone();
    }
    return text::from_str("");
}

// A SHORTCUT IS PART OF THE ITEM'S STRING, separated by a TAB.
//
// That is not a formatting convention this package invented — it is how a
// Win32 menu is told where the accelerator column starts. `AppendMenu` right-
// aligns everything after the first `	`, which is why every Windows menu's
// shortcuts line up without anyone measuring them.
//
// IT IS THE LABEL AND NOT THE BINDING. Appending the text does not make the key
// work: an accelerator has to be in an HACCEL table and pumped through
// `TranslateAccelerator`, which this package does not do yet (§2). So the item
// SAYS Ctrl+S and pressing Ctrl+S does nothing unless the application also
// handled the key itself. Showing it anyway is right — the menu is where a user
// learns the shortcut exists — but a reader must not take the label for the
// binding.
fn with_shortcut(take label: text::Text, key: text::Text,
                 mods: vocab::KeyModifiers) -> text::Text {
    if key.view() == "" { return label; }
    let m: str = match mods {
        vocab::KeyModifiers::Alt => "Alt+",
        vocab::KeyModifiers::Ctrl => "Ctrl+",
        vocab::KeyModifiers::Shift => "Shift+",
        // CMD AND WINDOWS BOTH BECOME THE WINDOWS KEY. `Cmd` is facet's name
        // for the platform's primary modifier and on Windows that is Ctrl —
        // but a node that said `Cmd` on a menu item meant "the Mac one", and
        // rendering it as Ctrl would collide with an item that really said
        // Ctrl. `Win+` is the honest spelling of the key that exists here.
        vocab::KeyModifiers::Cmd => "Win+",
        vocab::KeyModifiers::Windows => "Win+",
        vocab::KeyModifiers::None => "",
    };
    return label.appending("	").appending(m).appending(key.view());
}

// Fill `menu` from `parent`'s child nodes. Recurses for a nested `menu`, which
// becomes a submenu — the one place the tree shape and the HMENU shape agree.
fn fill_from_children(menu: *u8, parent: *core::Node) {
    var i: usize = 0 as usize;
    let count: usize = core::child_count_of(parent);
    while i < count {
        match core::child_of(parent, i) {
            option::Option[*core::Node]::Some(c) => {
                let kind: u32 = core::kind_of(c);
                if kind == props::K_MENU {
                    let sub: *u8 = { u::CreatePopupMenu() };
                    if sub != (0 as *u8) {
                        fill_from_children(sub, c);
                        // A POPUP'S "id" IS THE SUBMENU HANDLE, not a command.
                        // `MF_POPUP` reinterprets the id argument, which is why
                        // a submenu needs no entry in the command table.
                        append_text(menu, mf_string() | mf_popup(),
                                    { #addr(sub) } as u32, item_text(c));
                    }
                } else {
                    if kind == props::K_MENU_ITEM || kind == props::K_CONTEXT_MENU_ITEM {
                        let t: text::Text = item_text(c);
                        // AN EMPTY TITLE IS A SEPARATOR. facet has no separator
                        // kind for these — the ledger's menu item carries only a
                        // text — so an item that names nothing is the rule
                        // between groups, which is what every menu vocabulary
                        // means by a blank entry.
                        if t.view() == "" {
                            let _r: i32 = { u::AppendMenuA(menu, mf_separator(),
                                                           0 as u64, 0 as *i8) };
                        } else if destructive(c) || paint::dark_controls() {
                            // OWNER-DRAWN — for a destructive item always, and
                            // for EVERY item on a dark system.
                            //
                            // The second is a trade this file argued against
                            // and lost to the platform: `SetPreferredAppMode`
                            // and `FlushMenuThemes` are both called and a popup
                            // menu still comes up white, measured. So a dark
                            // application has one white rectangle per menu
                            // unless this package draws them, and drawing them
                            // means owning the check column, the submenu arrow
                            // and the keyboard highlight — which `draw_menu_item`
                            // does, from the system's own metrics.
                            let _r: i32 = { u::AppendMenuA(menu, mf_ownerdraw(),
                                                           add_node_command(c) as u64,
                                                           c as *i8) };
                        } else {
                            append_text(menu, mf_string(), add_node_command(c), t);
                        }
                    }
                }
            }
            option::Option[*core::Node]::None => { }
        }
        i = i +% (1 as usize);
    }
    return;
}

// ---- a destructive item, drawn ------------------------------------------------------
//
// `MF_OWNERDRAW` and the two messages behind it. MANIFEST §1 recorded
// `menu_item.is_destructive` absent on the argument that "a red item in an
// otherwise system-drawn menu reads as a rendering fault rather than as a
// warning" — and that is the swipe argument again, wrong the same way.
//
// A destructive item IS red beside ordinary ones on every platform that has the
// verb; the contrast is the WHOLE POINT of it. macOS draws one red row in a
// menu of black ones and nobody reads it as a fault. And the alternative on
// offer — owner-drawing every item so the red one has company — is worse: it
// would put this package in charge of the check column, the submenu arrow, the
// accelerator column and the keyboard highlight of every menu in every
// application, to change the colour of one row.
//
// So exactly the destructive items are owner-drawn, and they are drawn to match
// what the system draws around them: the menu's own background, the system's
// own highlight when the item is selected, and the standard check-column indent
// so the text lines up with its neighbours'.

fn mf_ownerdraw() -> u32 { return 0x0100 as u32; }
fn odt_menu() -> u32 { return 1 as u32; }
fn ods_selected() -> u32 { return 0x0001 as u32; }
fn ods_grayed() -> u32 { return 0x0002 as u32; }

// MEASUREITEMSTRUCT on x64: CtlType, CtlID, itemID, itemWidth, itemHeight as
// UINTs, then itemData at 24 after the alignment padding.
fn mi_off_type() -> usize { return 0 as usize; }
fn mi_off_width() -> usize { return 12 as usize; }
fn mi_off_height() -> usize { return 16 as usize; }
fn mi_off_data() -> usize { return 24 as usize; }

// DRAWITEMSTRUCT — the same offsets `controls` reads for an owner-drawn button,
// plus `itemData` at the end.
fn di_off_type() -> usize { return 0 as usize; }
fn di_off_state() -> usize { return 16 as usize; }
fn di_off_hdc() -> usize { return 32 as usize; }
fn di_off_rect() -> usize { return 40 as usize; }
fn di_off_data() -> usize { return 56 as usize; }

fn read_u32_at(p: *u8, at: usize) -> u32 {
    let q: *u32 = { (p + at) } as *u32;
    return { *q };
}

fn write_u32_at(p: *u8, at: usize, v: u32) {
    let q: *u32 = { (p + at) } as *u32;
    { *q = v };
    return;
}

fn read_ptr_at(p: *u8, at: usize) -> *u8 {
    let q: *usize = { (p + at) } as *usize;
    return { *q } as *u8;
}

fn destructive(n: *core::Node) -> bool {
    let d: *core::Data = core::node_data(n);
    if d == (0 as *core::Data) { return false; }
    let p: *u8 = { (*d).props };
    if p == (0 as *u8) { return false; }
    let kind: u32 = { (*d).kind };
    if kind == props::K_MENU_ITEM {
        return { (*(p as *props::MenuItemProps)).is_destructive };
    }
    if kind == props::K_CONTEXT_MENU_ITEM {
        return { (*(p as *props::ContextMenuItemProps)).menu_item.is_destructive };
    }
    return false;
}

// SM_CXMENUCHECK is the check-mark column an item's text starts after, and
// SM_CYMENU is the standard row height. Asked of the system rather than stated,
// because both follow the DPI and the user's text scaling — an item that
// guessed either would be a different size from the ones around it.
fn check_column() -> i32 { return { u::GetSystemMetrics(71 as i32) } +% (4 as i32); }
fn menu_row_height() -> i32 { return { u::GetSystemMetrics(15 as i32) }; }

// WM_MEASUREITEM. The width is the text plus the check column and the trailing
// pad the system leaves; the height is the system's own menu row.
//
// MEASURED IN THE SCREEN'S DC, which carries the system font rather than the
// menu's. That is a real approximation and it is the safe direction: the menu
// font is at most a point or two off the shell font, and a width that is
// slightly generous leaves a little space at the end of one row rather than
// clipping its text.
fn measure_menu_item(mi: *u8) -> bool {
    if mi == (0 as *u8) { return false; }
    if read_u32_at(mi, mi_off_type()) != odt_menu() { return false; }
    let n: *core::Node = read_ptr_at(mi, mi_off_data()) as *core::Node;
    if n == (0 as *core::Node) { return false; }
    let t: text::Text = item_text(n);
    var w: i32 = check_column() +% (32 as i32);
    let hdc: *u8 = { u::GetDC(0 as *u8) };
    if hdc != (0 as *u8) {
        var r: u::tagRECT = u::tagRECT { left: 0 as i32, top: 0 as i32,
                                         right: 0 as i32, bottom: 0 as i32 };
        let w16: *u16 = sys::to_wide(t.view());
        if w16 != (0 as *u16) {
            let _d: i32 = { u::DrawTextW(hdc, w16, (0 as i32) -% (1 as i32),
                                         #addr_of(r),
                                         sys::dt_calcrect() | sys::dt_singleline()
                                         | sys::dt_noprefix()) };
            w = (r.right -% r.left) +% check_column() +% (32 as i32);
            sys::free_wide(w16);
        }
        let _r: i32 = { u::ReleaseDC(0 as *u8, hdc) };
    }
    write_u32_at(mi, mi_off_width(), w as u32);
    write_u32_at(mi, mi_off_height(), menu_row_height() as u32);
    return true;
}

// WM_DRAWITEM for a menu. The background and the highlight are the system's
// colours; only the TEXT is red, which is the whole of what the verb asks for.
fn draw_menu_item(di: *u8) -> bool {
    if di == (0 as *u8) { return false; }
    if read_u32_at(di, di_off_type()) != odt_menu() { return false; }
    let n: *core::Node = read_ptr_at(di, di_off_data()) as *core::Node;
    if n == (0 as *core::Node) { return false; }
    let hdc: *u8 = read_ptr_at(di, di_off_hdc());
    if hdc == (0 as *u8) { return false; }
    let state: u32 = read_u32_at(di, di_off_state());
    let selected: bool = (state & ods_selected()) != (0 as u32);
    let grayed: bool = (state & ods_grayed()) != (0 as u32);
    var r: u::tagRECT = u::tagRECT {
        left: read_u32_at(di, di_off_rect()) as i32,
        top: read_u32_at(di, di_off_rect() +% (4 as usize)) as i32,
        right: read_u32_at(di, di_off_rect() +% (8 as usize)) as i32,
        bottom: read_u32_at(di, di_off_rect() +% (12 as usize)) as i32,
    };
    // COLOR_MENU / COLOR_HIGHLIGHT — the system's, so the row sits IN the menu
    // rather than on top of it.
    //
    // ON A DARK SYSTEM THE SYSTEM'S IS WRONG: `GetSysColor(COLOR_MENU)` answers
    // the classic light grey whatever the appearance, which is the whole reason
    // a popup menu comes up white. The appearance's own raised surface is what
    // a dark menu is, and the highlight stays the user's accent either way.
    var bg: u32 = if selected { { u::GetSysColor(13 as i32) } }
                  else { { u::GetSysColor(4 as i32) } };
    if !selected && paint::dark_controls() {
        var mh: bool = false;
        let dark_face: u32 = paint::resolve(vocab::Color::control_background(),
                                            #addr_of(mh));
        if mh { bg = dark_face; }
    }
    let brush: *u8 = paint::brush_for(bg);
    if brush != (0 as *u8) { let _f: i32 = { u::FillRect(hdc, #addr_of(r), brush) }; }
    // THE HIGHLIGHT WINS OVER THE WARNING. Red text on the selection's blue is
    // unreadable, and a selected row is already unmistakable — so a highlighted
    // destructive item is drawn in the highlight's own text colour, which is
    // what macOS does with the same row.
    // A DESTRUCTIVE ITEM IS RED; every other owner-drawn one takes the ink the
    // background asks for, which on a dark menu is light and on a light one is
    // the black it always was.
    var fg: u32 = if destructive(n) { paint::colorref(0.80f64, 0.16f64, 0.16f64) }
                  else { paint::ink_over(bg) };
    if selected { fg = { u::GetSysColor(14 as i32) }; }
    if grayed { fg = { u::GetSysColor(17 as i32) }; }
    let _t: u32 = { gdi::SetTextColor(hdc, fg) };
    let _m: i32 = { gdi::SetBkMode(hdc, sys::bkmode_transparent()) };
    var tr: u::tagRECT = r;
    tr.left = tr.left +% check_column();
    let w16: *u16 = sys::to_wide(item_text(n).view());
    if w16 != (0 as *u16) {
        // DT_EXPANDTABS, because the accelerator column is a TAB — see
        // `with_shortcut`, which builds the string the system would have split
        // itself had this item not been owner-drawn.
        let flags: u32 = sys::dt_singleline() | sys::dt_vcenter()
                       | sys::dt_noprefix() | sys::dt_expandtabs();
        let _d: i32 = { u::DrawTextW(hdc, w16, (0 as i32) -% (1 as i32),
                                     #addr_of(tr), flags) };
        sys::free_wide(w16);
    }
    return true;
}

#[test]
fn only_a_destructive_item_leaves_the_system_to_draw_nothing() {
    // The gate. Every other item stays MF_STRING and the system draws it — the
    // check column, the accelerator column and the keyboard highlight included.
    var plain: core::Node = props_menu_item(false);
    var red: core::Node = props_menu_item(true);
    assert !destructive(#addr_of(plain));
    assert destructive(#addr_of(red));
    return;
}

fn props_menu_item(is_destructive: bool) -> core::Node {
    var n: core::Node = fmenu_item::menu_item(key: "m", text: "Delete",
                                              destructive: is_destructive);
    return n;
}

#[test]
fn an_owner_drawn_row_is_the_systems_own_height() {
    // An item a different size from its neighbours is the tell that a menu is
    // half owner-drawn, so the height comes from SM_CYMENU rather than from a
    // number here — and the text starts after the check column for the same
    // reason.
    assert menu_row_height() > (0 as i32);
    assert check_column() > (0 as i32);
    return;
}

// ---- the window's menu bar ----------------------------------------------------------

// Does this node hold `menu` children? Asked before rebuilding a bar, because
// every node in a tree gets `touch_all` at some point and almost none of them
// have anything to do with a menu.
fn holds_a_menu(n: *core::Node) -> bool {
    var i: usize = 0 as usize;
    let count: usize = core::child_count_of(n);
    while i < count {
        match core::child_of(n, i) {
            option::Option[*core::Node]::Some(c) => {
                if core::kind_of(c) == props::K_MENU { return true; }
            }
            option::Option[*core::Node]::None => { }
        }
        i = i +% (1 as usize);
    }
    return false;
}

// Build the bar for `win` from the `menu` children under `root`.
//
// THE OLD BAR IS DESTROYED. `SetMenu` does not free what it replaces, and a
// menu rebuilt on every model change would leak an HMENU and everything under
// it each time.
// A MENU'S OWN PRIORITY, or zero. Higher leads, which is what the word means
// and what `toolbar_item.priority` already does in this package.
fn menu_priority(n: *core::Node) -> i64 {
    let d: *core::Data = core::node_data(n);
    if d == (0 as *core::Data) { return 0 as i64; }
    if { (*d).kind } != props::K_MENU { return 0 as i64; }
    let p: *props::MenuProps = { (*d).props } as *props::MenuProps;
    if p == (0 as *props::MenuProps) { return 0 as i64; }
    return { (*p).priority };
}

fn build_bar(win: *u8, root: *core::Node) {
    if win == (0 as *u8) { return; }
    if root == (0 as *core::Node) { return; }
    reset_commands();
    let bar: *u8 = { u::CreateMenu() };
    if bar == (0 as *u8) { return; }
    let count: usize = core::child_count_of(root);

    // ORDERED BY PRIORITY, TREE ORDER BREAKING TIES. `menu.priority` was in
    // `menu_bits` — so changing one rebuilt the bar — and nothing read it, so
    // the bar came back in the same order it went out. Higher leads.
    //
    // A SELECTION RATHER THAN A SORT, and stable by construction: each pass
    // takes the highest priority not yet placed, and among equals the lowest
    // index. Menu bars are a handful of entries, so the cost is nothing and
    // there is no comparator to get subtly wrong.
    var placed: [bool; 32] = [false; 32];
    var done: usize = 0 as usize;
    let cap: usize = if count < (32 as usize) { count } else { 32 as usize };
    while done < cap {
        var best: usize = cap;
        var best_pri: i64 = 0 as i64;
        var k: usize = 0 as usize;
        while k < cap {
            if !placed[k] {
                match core::child_of(root, k) {
                    option::Option[*core::Node]::Some(c) => {
                        if core::kind_of(c) == props::K_MENU {
                            let pri: i64 = menu_priority(c);
                            if best == cap || pri > best_pri {
                                best = k;
                                best_pri = pri;
                            }
                        } else { placed[k] = true; done = done +% (1 as usize); }
                    }
                    option::Option[*core::Node]::None => {
                        placed[k] = true; done = done +% (1 as usize);
                    }
                }
            }
            k = k +% (1 as usize);
        }
        if best == cap { done = cap; }
        else {
            placed[best] = true;
            done = done +% (1 as usize);
            match core::child_of(root, best) {
                option::Option[*core::Node]::Some(c) => {
                    let sub: *u8 = { u::CreatePopupMenu() };
                    if sub != (0 as *u8) {
                        fill_from_children(sub, c);
                        append_text(bar, mf_string() | mf_popup(),
                                    { #addr(sub) } as u32, item_text(c));
                    }
                }
                option::Option[*core::Node]::None => { }
            }
        }
    }
    let old: *u8 = { u::GetMenu(win) };
    let _s: i32 = { u::SetMenu(win, bar) };
    if old != (0 as *u8) { let _d: i32 = { u::DestroyMenu(old) }; }
    // The bar occupies client space, so the layout has to be re-run against
    // what is left. `DrawMenuBar` is what makes the change visible at all.
    let _r: i32 = { u::DrawMenuBar(win) };
    return;
}

// ---- the app menu, which is a different shape --------------------------------------
//
// `screen::AppMenu` is a FLAT list of `screen::MenuItem`, each naming the menu
// it belongs to by string. So the bar is grouped here rather than walked: one
// popup per distinct `menu` name, in first-seen order, which is the order the
// application wrote them in.
fn build_app_menu(win: *u8, m: *screen::AppMenu) {
    if win == (0 as *u8) { return; }
    if m == (0 as *screen::AppMenu) { return; }
    let items: *vec::Vec[screen::MenuItem] = #addr_of((*m).items);
    let n: usize = { (*items).count() };
    // NO ITEMS IS NO BAR. An application that returns an empty `menu_items`
    // wanted no menu bar — the gallery does — and creating one anyway leaves a
    // bare strip of `COLOR_MENU` across the top of the window, taking a row of
    // client height and drawing nothing. Reported as a white bar under the
    // title. A window that HAD a bar and now has none has it removed.
    if n == (0 as usize) {
        let had: *u8 = { u::GetMenu(win) };
        if had != (0 as *u8) {
            let _r: i32 = { u::SetMenu(win, 0 as *u8) };
            let _d: i32 = { u::DestroyMenu(had) };
            let _b: i32 = { u::DrawMenuBar(win) };
        }
        return;
    }
    reset_commands();
    let bar: *u8 = { u::CreateMenu() };
    if bar == (0 as *u8) { return; }
    var made: vec::Vec[text::Text] = vec::new::[text::Text]();
    var i: usize = 0 as usize;
    while i < n {
        match { (*items).at_ptr(i) } {
            option::Option[*screen::MenuItem]::Some(it) => {
                let group: str = { (*it).menu }.view();
                if !already_made(made, group) {
                    let _a: status::Status = made.append(text::from_str(group));
                    let popup: *u8 = { u::CreatePopupMenu() };
                    if popup != (0 as *u8) {
                        fill_group(popup, items, group);
                        append_text(bar, mf_string() | mf_popup(),
                                    { #addr(popup) } as u32, text::from_str(group));
                    }
                }
            }
            option::Option[*screen::MenuItem]::None => { }
        }
        i = i +% (1 as usize);
    }
    let old: *u8 = { u::GetMenu(win) };
    let _s: i32 = { u::SetMenu(win, bar) };
    if old != (0 as *u8) { let _d: i32 = { u::DestroyMenu(old) }; }
    let _r: i32 = { u::DrawMenuBar(win) };
    return;
}

// A DEEP COPY of an app menu, for the window tier to OWN.
//
// The facade hands `install_app_menu` the address of a LOCAL — `bar` in
// facet_runtime's `open_owned_window` — and the bar has to be rebuilt later,
// whenever another window opens or a `menu` subtree changes. Holding that
// address was a use-after-return: by the next `open_window` the local had
// been dropped and its stack reused, so `build_app_menu` walked whatever was
// there. In qwen-image's release build that was an item count with a null
// buffer, and `runtime::alert` (which opens a window) died reading address 8.
//
// Every field is a value: three Texts, cloned, and plain words — the handler
// pointers and their ctx are the application's and outlive the menu anyway.
fn copy_app_menu(m: *screen::AppMenu) -> screen::AppMenu {
    var out: screen::AppMenu = screen::empty_app_menu();
    if m == (0 as *screen::AppMenu) { return out; }
    out.title = { (*m).title }.clone();
    let items: *vec::Vec[screen::MenuItem] = #addr_of((*m).items);
    let n: usize = { (*items).count() };
    var i: usize = 0 as usize;
    while i < n {
        match { (*items).at_ptr(i) } {
            option::Option[*screen::MenuItem]::Some(it) => {
                let _a: status::Status = out.items.append(screen::MenuItem {
                    menu: { (*it).menu }.clone(),
                    title: { (*it).title }.clone(),
                    key: { (*it).key }.clone(),
                    shift: { (*it).shift },
                    alt: { (*it).alt },
                    action: { (*it).action },
                    is_enabled: { (*it).is_enabled },
                    enabled_ctx: { (*it).enabled_ctx },
                    title_of: { (*it).title_of },
                    title_ctx: { (*it).title_ctx },
                    is_separator: { (*it).is_separator },
                    on_click: { (*it).on_click },
                    click_ctx: { (*it).click_ctx },
                });
            }
            option::Option[*screen::MenuItem]::None => { }
        }
        i = i +% (1 as usize);
    }
    return out;
}

fn already_made(made: vec::Vec[text::Text], group: str) -> bool {
    var i: usize = 0 as usize;
    let n: usize = made.count();
    while i < n {
        match made.at_ptr(i) {
            option::Option[*text::Text]::Some(t) => {
                if { (*t).view() } == group { return true; }
            }
            option::Option[*text::Text]::None => { }
        }
        i = i +% (1 as usize);
    }
    return false;
}

fn fill_group(popup: *u8, items: *vec::Vec[screen::MenuItem], group: str) {
    var i: usize = 0 as usize;
    let n: usize = { (*items).count() };
    while i < n {
        match { (*items).at_ptr(i) } {
            option::Option[*screen::MenuItem]::Some(it) => {
                if { (*it).menu }.view() == group {
                    if { (*it).is_separator } {
                        let _r: i32 = { u::AppendMenuA(popup, mf_separator(),
                                                       0 as u64, 0 as *i8) };
                    } else {
                        let id: u32 = add_app_command({ (*it).on_click },
                                                      { (*it).click_ctx });
                        append_text(popup, mf_string(), id, { (*it).title }.clone());
                    }
                }
            }
            option::Option[*screen::MenuItem]::None => { }
        }
        i = i +% (1 as usize);
    }
    return;
}

// ---- the menu BAR in dark mode ---------------------------------------------------
//
// THE POPUPS ARE ALREADY DARK and need nothing here: `darkmode::install` calls
// uxtheme's `SetPreferredAppMode(AllowDark)` (ordinal 135) and
// `FlushMenuThemes` (136), and every top-level window is allowed dark
// (`AllowDarkModeForWindow`, 133) as it is made. Measured on
// `playground/win32_bugs_probe`: File's drop-down draws dark.
//
// THE BAR IS NOT, and no public switch makes it so — `DWMWA_USE_IMMERSIVE_DARK_MODE`
// stops at the caption, and the bar is drawn by user32 into the non-client area
// from the classic `COLOR_MENU`. What every dark Win32 application does
// (Explorer, Notepad++, the win32-darkmode sample) is answer two UNDOCUMENTED
// messages user32 sends to the window before it draws the bar itself:
//
//   WM_UAHDRAWMENU      (0x91) "paint the bar's background" — lParam is a
//                       UAHMENU { HMENU hmenu; HDC hdc; DWORD dwFlags; }.
//   WM_UAHDRAWMENUITEM  (0x92) "paint one item" — lParam is a UAHDRAWMENUITEM:
//                       a DRAWITEMSTRUCT (64 bytes on x64), then the UAHMENU at
//                       64 (hmenu 64, hdc 72), then a UAHMENUITEM whose first
//                       field, the item's POSITION, is at 88.
//
// Returning non-zero says "drawn". Both are answered ONLY in dark mode and not in
// high contrast; a light app returns false from every function here and user32
// draws exactly what it always drew.
//
// One more thing user32 paints that the messages do not cover: a single
// light line under the bar, at the client area's top edge, drawn on every
// WM_NCPAINT and WM_NCACTIVATE. `paint_bar_rule` covers it after the default
// has run — the same patch the sample applies.

fn wm_uahdrawmenu() -> u32 { return 0x0091 as u32; }
fn wm_uahdrawmenuitem() -> u32 { return 0x0092 as u32; }

fn uah_off_hmenu() -> usize { return 64 as usize; }
fn uah_off_hdc() -> usize { return 72 as usize; }
fn uah_off_position() -> usize { return 88 as usize; }

// DRAWITEMSTRUCT.itemState bits as they arrive for a menu-bar item.
fn ods_selected_bit() -> u32 { return 0x0001 as u32; }
fn ods_grayed_bit() -> u32 { return 0x0002 as u32; }
fn ods_disabled_bit() -> u32 { return 0x0004 as u32; }
fn ods_hotlight_bit() -> u32 { return 0x0040 as u32; }
fn ods_inactive_bit() -> u32 { return 0x0080 as u32; }
fn ods_noaccel_bit() -> u32 { return 0x0100 as u32; }

fn dark_bar() -> bool { return paint::dark_controls(); }

// The bar's ground is the WINDOW's — the same `effective_bg` the content erases
// with — so the bar reads as part of the window rather than as a strip across
// it. Hot and pressed are the two steps lighter Explorer uses.
fn bar_ground(win: *u8) -> u32 { return paint::effective_bg(win); }
fn bar_hot() -> u32 { return paint::colorref(0.24f64, 0.24f64, 0.24f64); }
fn bar_pressed() -> u32 { return paint::colorref(0.30f64, 0.30f64, 0.30f64); }
fn bar_text() -> u32 { return paint::colorref(0.95f64, 0.95f64, 0.95f64); }
fn bar_text_disabled() -> u32 { return paint::colorref(0.47f64, 0.47f64, 0.47f64); }

// The item's ground for its state. Pressed (the menu is open) wins over hot.
fn item_ground(win: *u8, state: u32) -> u32 {
    if (state & ods_selected_bit()) != (0 as u32) { return bar_pressed(); }
    if (state & ods_hotlight_bit()) != (0 as u32) { return bar_hot(); }
    return bar_ground(win);
}

fn item_ink(state: u32) -> u32 {
    if (state & (ods_grayed_bit() | ods_disabled_bit())) != (0 as u32) {
        return bar_text_disabled();
    }
    // An INACTIVE window's bar is dimmed by user32 in light mode; the same cue
    // here, or a dark app's bar would look focused whichever window was.
    if (state & ods_inactive_bit()) != (0 as u32) { return bar_text_disabled(); }
    return bar_text();
}

// The bar's rect in WINDOW coordinates, which is what the window DC uses.
fn bar_rect(win: *u8, out: *u::tagRECT) -> bool {
    var mbi: u::tagMENUBARINFO = #zero::[u::tagMENUBARINFO]();
    mbi.cbSize = #size_of::[u::tagMENUBARINFO]() as u32;
    // OBJID_MENU is -3.
    if { u::GetMenuBarInfo(win, 0 -% (3 as i32), 0 as i32, #addr_of(mbi)) } == (0 as i32) {
        return false;
    }
    var wr: u::tagRECT = u::tagRECT { left: 0 as i32, top: 0 as i32,
                                      right: 0 as i32, bottom: 0 as i32 };
    if { u::GetWindowRect(win, #addr_of(wr)) } == (0 as i32) { return false; }
    { (*out).left = mbi.rcBar.left -% wr.left };
    { (*out).top = mbi.rcBar.top -% wr.top };
    { (*out).right = mbi.rcBar.right -% wr.left };
    { (*out).bottom = mbi.rcBar.bottom -% wr.top };
    return true;
}

fn fill_with(hdc: *u8, r: *u::tagRECT, c: u32) {
    let b: *u8 = paint::brush_for(c);
    if b == (0 as *u8) { return; }
    let _f: i32 = { u::FillRect(hdc, r, b) };
    return;
}

// WM_UAHDRAWMENU and WM_UAHDRAWMENUITEM. False means "not ours": a light app,
// or a message too malformed to read, and the caller passes it to the default.
fn on_uah(win: *u8, msg: u32, l: i64) -> bool {
    if !dark_bar() { return false; }
    let p: *u8 = l as *u8;
    if p == (0 as *u8) { return false; }
    if msg == wm_uahdrawmenu() {
        let hdc: *u8 = read_ptr_at(p, 8 as usize);
        if hdc == (0 as *u8) { return false; }
        var r: u::tagRECT = u::tagRECT { left: 0 as i32, top: 0 as i32,
                                         right: 0 as i32, bottom: 0 as i32 };
        if !bar_rect(win, #addr_of(r)) { return false; }
        fill_with(hdc, #addr_of(r), bar_ground(win));
        return true;
    }
    if msg == wm_uahdrawmenuitem() {
        let hmenu: *u8 = read_ptr_at(p, uah_off_hmenu());
        let hdc: *u8 = read_ptr_at(p, uah_off_hdc());
        if hmenu == (0 as *u8) || hdc == (0 as *u8) { return false; }
        let state: u32 = read_u32_at(p, di_off_state());
        let pos: u32 = read_u32_at(p, uah_off_position());
        var r: u::tagRECT = u::tagRECT {
            left: read_u32_at(p, di_off_rect()) as i32,
            top: read_u32_at(p, di_off_rect() +% (4 as usize)) as i32,
            right: read_u32_at(p, di_off_rect() +% (8 as usize)) as i32,
            bottom: read_u32_at(p, di_off_rect() +% (12 as usize)) as i32,
        };
        fill_with(hdc, #addr_of(r), item_ground(win, state));
        var buf: [u16; 256] = [0 as u16; 256];
        // MF_BYPOSITION (0x400): the UAH item names its POSITION, not an id —
        // a popup on the bar has no command id at all.
        let n: i32 = { u::GetMenuStringW(hmenu, pos, { #addr_of(buf[0]) } as *u16,
                                         255 as i32, 0x0400 as u32) };
        if n > (0 as i32) {
            let _m: i32 = { gdi::SetBkMode(hdc, 1 as i32) };          // TRANSPARENT
            let _c: u32 = { gdi::SetTextColor(hdc, item_ink(state)) };
            // DT_CENTER | DT_VCENTER | DT_SINGLELINE, and DT_HIDEPREFIX while
            // the keyboard cues are off — the underline appears with Alt, as
            // it does on a light bar.
            var flags: u32 = 0x0025 as u32;
            if (state & ods_noaccel_bit()) != (0 as u32) { flags = flags | (0x00100000 as u32); }
            let _d: i32 = { u::DrawTextW(hdc, { #addr_of(buf[0]) } as *u16, n, #addr_of(r), flags) };
        }
        return true;
    }
    return false;
}

// The light rule user32 draws under the bar, over-painted in the bar's ground.
// Called after the default WM_NCPAINT / WM_NCACTIVATE has drawn it.
fn paint_bar_rule(win: *u8) {
    if !dark_bar() { return; }
    // GetMenu on a CHILD answers its control id, not a menu.
    if { u::GetAncestor(win, 2 as u32) } != win { return; }
    if { u::GetMenu(win) } == (0 as *u8) { return; }
    var cr: u::tagRECT = u::tagRECT { left: 0 as i32, top: 0 as i32,
                                      right: 0 as i32, bottom: 0 as i32 };
    if { u::GetClientRect(win, #addr_of(cr)) } == (0 as i32) { return; }
    let _m: i32 = { u::MapWindowPoints(win, 0 as *u8, #addr_of(cr) as *u::tagPOINT, 2 as u32) };
    var wr: u::tagRECT = u::tagRECT { left: 0 as i32, top: 0 as i32,
                                      right: 0 as i32, bottom: 0 as i32 };
    if { u::GetWindowRect(win, #addr_of(wr)) } == (0 as i32) { return; }
    var line: u::tagRECT = u::tagRECT {
        left: cr.left -% wr.left, top: (cr.top -% wr.top) -% (1 as i32),
        right: cr.right -% wr.left, bottom: cr.top -% wr.top,
    };
    let hdc: *u8 = { u::GetWindowDC(win) };
    if hdc == (0 as *u8) { return; }
    fill_with(hdc, #addr_of(line), bar_ground(win));
    let _r: i32 = { u::ReleaseDC(win, hdc) };
    return;
}

#[test]
fn the_uah_item_layout_follows_the_drawitemstruct() {
    // DRAWITEMSTRUCT is 64 bytes on x64 (its rcItem at 40 and itemData at 56
    // are what `draw_menu_item` already reads), so the UAHMENU that follows it
    // starts at 64 and its HDC at 72; the UAHMENUITEM after the 24-byte UAHMENU
    // starts at 88 with the item's position.
    assert di_off_rect() == (40 as usize);
    assert di_off_data() == (56 as usize);
    assert uah_off_hmenu() == (64 as usize);
    assert uah_off_hdc() == uah_off_hmenu() +% (8 as usize);
    assert uah_off_position() == uah_off_hmenu() +% (24 as usize);
    return;
}

#[test]
fn a_light_app_leaves_the_bar_to_user32() {
    let was: bool = paint::is_dark();
    paint::set_dark(false);
    var junk: [u8; 128] = [0 as u8; 128];
    assert !on_uah(0 as *u8, wm_uahdrawmenu(), { #addr(#addr_of(junk[0])) } as i64);
    assert !on_uah(0 as *u8, wm_uahdrawmenuitem(), { #addr(#addr_of(junk[0])) } as i64);
    paint::set_dark(was);
    return;
}

#[test]
fn an_open_menu_reads_pressed_and_a_disabled_one_dim() {
    assert item_ground(0 as *u8, ods_selected_bit() | ods_hotlight_bit()) == bar_pressed();
    assert item_ground(0 as *u8, ods_hotlight_bit()) == bar_hot();
    assert item_ink(ods_grayed_bit()) == bar_text_disabled();
    assert item_ink(0 as u32) == bar_text();
    return;
}

// ---- a node's context menu -------------------------------------------------------
//
// Shown on demand rather than attached: `TrackPopupMenu` with `TPM_RETURNCMD`
// blocks until the user chooses and ANSWERS the command id, so the whole
// interaction is one call and there is no menu to keep alive between them.
//
// That is also why the command table is rebuilt here: a context menu's ids only
// have to be valid for the duration of this call.
fn show_context_menu(owner: *u8, n: *core::Node) -> bool {
    if owner == (0 as *u8) || n == (0 as *core::Node) { return false; }
    let holder: *core::Node = context_menu_under(n);
    if holder == (0 as *core::Node) { return false; }
    reset_commands();
    let popup: *u8 = { u::CreatePopupMenu() };
    if popup == (0 as *u8) { return false; }
    fill_from_children(popup, holder);
    var pt: u::tagPOINT = u::tagPOINT { x: 0 as i32, y: 0 as i32 };
    let _g: i32 = { u::GetCursorPos(#addr_of(pt)) };
    let chosen: i32 = { u::TrackPopupMenu(popup,
                                          tpm_returncmd() | tpm_rightbutton(),
                                          pt.x, pt.y, 0 as i32, owner,
                                          0 as *u::tagRECT) };
    let _d: i32 = { u::DestroyMenu(popup) };
    if chosen <= (0 as i32) { return false; }
    return fire(chosen as u32);
}

// The `context_menu` child of `n`, if it has one. A context menu DECORATES the
// node it sits under — right-clicking that node is what opens it — so the
// children are already there, built long before mount, even though none of them
// will ever get a window.
fn context_menu_under(n: *core::Node) -> *core::Node {
    var i: usize = 0 as usize;
    let count: usize = core::child_count_of(n);
    while i < count {
        match core::child_of(n, i) {
            option::Option[*core::Node]::Some(c) => {
                if core::kind_of(c) == props::K_CONTEXT_MENU { return c; }
            }
            option::Option[*core::Node]::None => { }
        }
        i = i +% (1 as usize);
    }
    return 0 as *core::Node;
}

fn has_context_menu(n: *core::Node) -> bool {
    return context_menu_under(n) != (0 as *core::Node);
}

// The bits that mean "a menu under this node changed". A viewless child cannot
// say which of its host's verbs it affected, so `mount` raises `touch_all` on
// the host — which is why what this tests for is the bits a MENU carries, on a
// node that holds one.
fn menu_bits() -> u64 {
    // `P_ICON` IS NOT NAMED FOR EITHER ITEM KIND, and that is a withdrawal
    // rather than a decision. A Win32 menu CAN carry a picture — `MIIM_BITMAP`
    // with an `hbmpItem` — so this is buildable; what it needs is facet's icon
    // source rendered to an HBITMAP, which for the glyph tier means drawing the
    // codepoint into a DIB at the menu's own metrics. That is not written.
    //
    // Until it is, naming the bit only promised a rebuild that draws no icon.
    // The tool calls that GATED BUT UNREAD, and it is the state `symbol.fill`
    // was in: the code reads finished. Left as visible debt in §2 instead.
    return fmenu::P_TEXT | fmenu::P_PRIORITY | fmenu_item::P_TEXT
         | fctx_item::P_TEXT
         // A shortcut is part of the item's STRING here — see `with_shortcut` —
         // so changing one is a rebuild exactly as changing the text is.
         | fctx_item::P_SHORTCUT;
}

fn command_table_size() -> usize { return COMMANDS.count(); }

#[test]
fn command_ids_start_above_the_dialog_answers() {
    // IDOK is 1 and IDCANCEL is 2. A menu item numbered 2 fires when any dialog
    // in the process is cancelled — a bug that only appears once an app grows
    // its first dialog, long after the menu was written.
    assert first_command_id() > (2 as u32);
    assert id_of_slot(0 as usize) == first_command_id();
    return;
}

#[test]
fn an_id_round_trips_to_its_slot() {
    assert slot_of_id(id_of_slot(0 as usize)) == (0 as usize);
    assert slot_of_id(id_of_slot(7 as usize)) == (7 as usize);
    return;
}

#[test]
fn an_id_below_the_first_names_no_slot() {
    // WM_COMMAND also carries accelerator and dialog ids. One that is not ours
    // must answer "no slot" rather than index the table negatively.
    reset_commands();
    let _a: u32 = add_app_command(props::no_handler, 0 as *u8);
    assert slot_of_id(1 as u32) >= command_table_size();
    assert fire(1 as u32) == false;
    return;
}

#[test]
fn a_rebuilt_menu_forgets_the_old_ids() {
    // A stale row fires a handler for an item that is no longer on screen —
    // which is what makes `reset_commands` part of every build rather than an
    // optimisation.
    reset_commands();
    let _a: u32 = add_app_command(props::no_handler, 0 as *u8);
    let _b: u32 = add_app_command(props::no_handler, 0 as *u8);
    assert command_table_size() == (2 as usize);
    reset_commands();
    assert command_table_size() == (0 as usize);
    return;
}
