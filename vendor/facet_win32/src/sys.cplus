// ---- DrawText / device context ------------------------------------------------

fn dt_left() -> u32 { return 0x00000000 as u32; }
fn dt_center() -> u32 { return 0x00000001 as u32; }
fn dt_right() -> u32 { return 0x00000002 as u32; }
fn dt_vcenter() -> u32 { return 0x00000004 as u32; }
