// facet_win32/sys — the Win32 CONSTANTS this package needs, and nothing else.
//
// `cpc-bindgen` binds declarations: functions and structs. A `#define` is
// neither, so every `WM_`, `WS_`, `BS_` and `SS_` in the SDK headers is absent
// from `win32/winuser` by construction — the binding is complete and the
// constants are simply not declarations. They have to be written down
// somewhere, and this is that somewhere.
//
// NOT reached through `win32/core`, which carries a dozen of them already.
// That module is the curated FACADE's — it owns a WNDPROC, a command table and
// a dispatch record that this package deliberately does not use, and importing
// it for its constants would tie the backend to a facade it otherwise ignores.
// The overlap is about fifteen values and it is the cheaper of the two costs.
//
// Every value here is from the Windows SDK headers and each is written in the
// same base the header writes it in, so a reader can diff them by eye against
// winuser.h rather than converting first.

// ---- messages ----------------------------------------------------------------

fn wm_create() -> u32 { return 0x0001 as u32; }
fn wm_destroy() -> u32 { return 0x0002 as u32; }
fn wm_size() -> u32 { return 0x0005 as u32; }
fn wm_setfocus() -> u32 { return 0x0007 as u32; }
fn wm_killfocus() -> u32 { return 0x0008 as u32; }
fn wm_paint() -> u32 { return 0x000F as u32; }
fn wm_close() -> u32 { return 0x0010 as u32; }
fn wm_quit() -> u32 { return 0x0012 as u32; }
fn wm_erasebkgnd() -> u32 { return 0x0014 as u32; }
fn wm_settingchange() -> u32 { return 0x001A as u32; }
fn wm_setfont() -> u32 { return 0x0030 as u32; }
fn wm_getminmaxinfo() -> u32 { return 0x0024 as u32; }
fn wm_notify() -> u32 { return 0x004E as u32; }
fn wm_keydown() -> u32 { return 0x0100 as u32; }
fn wm_keyup() -> u32 { return 0x0101 as u32; }
fn wm_char() -> u32 { return 0x0102 as u32; }
fn wm_syskeydown() -> u32 { return 0x0104 as u32; }
fn wm_command() -> u32 { return 0x0111 as u32; }
fn wm_timer() -> u32 { return 0x0113 as u32; }
fn wm_hscroll() -> u32 { return 0x0114 as u32; }
fn wm_vscroll() -> u32 { return 0x0115 as u32; }
fn wm_mousemove() -> u32 { return 0x0200 as u32; }
fn wm_lbuttondown() -> u32 { return 0x0201 as u32; }
fn wm_lbuttonup() -> u32 { return 0x0202 as u32; }
fn wm_lbuttondblclk() -> u32 { return 0x0203 as u32; }
fn wm_rbuttondown() -> u32 { return 0x0204 as u32; }
fn wm_rbuttonup() -> u32 { return 0x0205 as u32; }
fn wm_mousewheel() -> u32 { return 0x020A as u32; }
fn wm_dpichanged() -> u32 { return 0x02E0 as u32; }

// The CTLCOLOR family: a control asks its PARENT for its colours just before
// it draws. This is the one door a Win32 backend has into a system control's
// appearance, which is why `paint` answers four of them rather than one.
fn wm_ctlcoloredit() -> u32 { return 0x0133 as u32; }
fn wm_ctlcolorlistbox() -> u32 { return 0x0134 as u32; }
fn wm_ctlcolorbtn() -> u32 { return 0x0135 as u32; }
fn wm_ctlcolorstatic() -> u32 { return 0x0138 as u32; }

// WM_APP is the first id the SYSTEM will never send. `scheduler` posts one of
// these to itself as the "run a sync when the queue next drains" signal — the
// `g_idle_add` analogue — and a private message is the only kind safe to
// filter on, because WM_USER is claimed per-window-class by controls.
fn wm_app() -> u32 { return 0x8000 as u32; }
fn wm_facet_sync() -> u32 { return 0x8000 as u32; }

// ---- window styles -----------------------------------------------------------

fn ws_overlappedwindow() -> u32 { return 0x00CF0000 as u32; }
fn ws_child() -> u32 { return 0x40000000 as u32; }
fn ws_visible() -> u32 { return 0x10000000 as u32; }
fn ws_disabled() -> u32 { return 0x08000000 as u32; }
fn ws_border() -> u32 { return 0x00800000 as u32; }
fn ws_caption() -> u32 { return 0x00C00000 as u32; }
fn ws_sysmenu() -> u32 { return 0x00080000 as u32; }
fn ws_thickframe() -> u32 { return 0x00040000 as u32; }
fn ws_minimizebox() -> u32 { return 0x00020000 as u32; }
fn ws_maximizebox() -> u32 { return 0x00010000 as u32; }
fn ws_tabstop() -> u32 { return 0x00010000 as u32; }
fn ws_group() -> u32 { return 0x00020000 as u32; }
fn ws_vscroll() -> u32 { return 0x00200000 as u32; }
fn ws_hscroll() -> u32 { return 0x00100000 as u32; }
fn ws_popup() -> u32 { return 0x80000000 as u32; }

// CLIPCHILDREN keeps a parent's paint out of the rectangles its children own,
// and CLIPSIBLINGS keeps overlapping children from painting over each other.
// Both are on every host this package makes: without the first, a panel's band
// paints over every control on it and they flicker back on the next message;
// without the second, z-order — which is how `insert` and `component::raise`
// both work here — has no visible effect at all.
fn ws_clipchildren() -> u32 { return 0x02000000 as u32; }
fn ws_clipsiblings() -> u32 { return 0x04000000 as u32; }

fn ws_ex_controlparent() -> u32 { return 0x00010000 as u32; }
fn ws_ex_transparent() -> u32 { return 0x00000020 as u32; }
fn ws_ex_composited() -> u32 { return 0x02000000 as u32; }
fn ws_ex_clientedge() -> u32 { return 0x00000200 as u32; }
fn ws_ex_layered() -> u32 { return 0x00080000 as u32; }

