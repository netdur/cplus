fn dt_end_ellipsis() -> u32 { return 0x00008000 as u32; }
// A TAB IS THE ACCELERATOR COLUMN in a menu string — `AppendMenu` splits on
// it and right-aligns what follows. An owner-drawn item has to expand tabs
// itself or the shortcut runs into the label.
fn dt_expandtabs() -> u32 { return 0x00000040 as u32; }

fn bkmode_transparent() -> i32 { return 1 as i32; }
fn bkmode_opaque() -> i32 { return 2 as i32; }

// The system's own answer to "how far is a drag" — the distance a press has to
// travel before it stops being a click. Every draggable thing in this package
// asks it rather than picking a number, which is what makes a swipeable's slop
// agree with the desktop's.
fn sm_cxdrag() -> i32 { return 68 as i32; }
fn sm_cydrag() -> i32 { return 69 as i32; }

// The selection pair, which is what a revealed row action is drawn in when the
// application has not asked for a colour: the user's own accent, not a guess.
fn color_highlight() -> i32 { return 13 as i32; }
fn color_highlighttext() -> i32 { return 14 as i32; }

// `CreateWindowEx` takes this for "let Windows choose", and it is the SIGNED
// reading of 0x80000000 — built by negation rather than written as a literal,
// because an integer literal wraps through i32 before `as` and the direct
// spelling of the constant does not survive it.
fn cw_usedefault() -> i32 { return (0x80000000 as u32) as i32; }

fn idc_arrow() -> *u8 { return 32512 as *u8; }
fn idc_hand() -> *u8 { return 32649 as *u8; }
fn idc_ibeam() -> *u8 { return 32513 as *u8; }

// ---- the property keys this package hangs on an HWND --------------------------
//
// `SetPropA` is Win32's `g_object_set_data`: a named slot on any window,
// including a system control's, which is what makes it the right door. The
// alternative — GWLP_USERDATA — is ONE slot per window and the system classes
// do not all promise it is free, so a backend that used it would be racing the
// control for its own storage.

fn prop_node() -> *u8 { return { #str_ptr("facet-win32-node\0") }; }
fn prop_kind() -> *u8 { return { #str_ptr("facet-win32-kind\0") }; }
fn prop_doc() -> *u8 { return { #str_ptr("facet-win32-doc\0") }; }
fn prop_font() -> *u8 { return { #str_ptr("facet-win32-font\0") }; }
fn prop_brush() -> *u8 { return { #str_ptr("facet-win32-brush\0") }; }
// Set on a control that has been dropped out of visual styles — see
// `paint::go_classic`.
fn prop_drop() -> *u8 { return { #str_ptr("facet-win32-drop\0") }; }
fn prop_imagelist() -> *u8 { return { #str_ptr("facet-win32-imagelist\0") }; }
fn prop_classic() -> *u8 { return { #str_ptr("facet-win32-classic\0") }; }
// How far a swipeable has been swiped, in whole points PLUS ONE — see `swipe`
// for why the offset, and why the travel belongs to the window rather than to a
// static this package could have reached more easily.
fn prop_swipe() -> *u8 { return { #str_ptr("facet-win32-swipe\0") }; }

// ---- this package's own window class -----------------------------------------
//
// The GtkFixed analogue: a container that neither clips its children's layout
// nor negotiates for space, because facet already decided both. It exists to
// be a HOST — a thing children can be parented to and positioned in — and to
// own the WNDPROC that the read half and the shared band both hang off.

fn panel_class() -> *u8 { return { #str_ptr("FacetWin32Panel\0") }; }
fn window_class() -> *u8 { return { #str_ptr("FacetWin32Window\0") }; }

#[test]
fn a_child_host_clips_both_ways() {
    // Both flags, on every host — see the note on `ws_clipchildren`. Pinned
    // because dropping either is invisible in code review and shows up as
    // flicker or as z-order doing nothing.
    let host: u32 = ws_child() | ws_visible() | ws_clipchildren() | ws_clipsiblings();
    assert (host & ws_clipchildren()) != (0 as u32);
    assert (host & ws_clipsiblings()) != (0 as u32);
    return;
}

#[test]
fn maximizebox_and_tabstop_are_the_same_bit() {
    // They are, in the SDK — 0x00010000 means one thing on a top-level window
    // and another on a child. Pinned so that a reader who thinks one of them
    // is a typo finds this test instead of "fixing" it.
    assert ws_maximizebox() == ws_tabstop();
    assert ws_minimizebox() == ws_group();
    return;
}

#[test]
fn cw_usedefault_is_negative() {
    // The literal wraps through i32 before `as` — the language gotcha this
    // repo's skill file warns about — so the constant is built by cast rather
    // than written out. If this ever reads positive, every window opens at a
    // stated position instead of the system's.
    assert cw_usedefault() < (0 as i32);
    return;
}

// The recycler's per-control state, hung on its viewport window.
fn prop_list() -> *u8 { return { #str_ptr("facet-win32-list\0") }; }

// BS_PUSHLIKE — a check box or radio that DRAWS as a push button and latches.
// facet's `button.toggles` is exactly this: the same control, keeping its
// pressed state, rather than a different class.
fn bs_pushlike() -> u32 { return 0x1000 as u32; }
// BS_NOTIFY. Without it a button reports BN_CLICKED and NOTHING ELSE — no
// BN_PUSHED, no BN_UNPUSHED, no BN_SETFOCUS — so the press edges facet
// declares would look implemented and never fire.
fn bs_notify() -> u32 { return 0x4000 as u32; }

// BS_OWNERDRAW — the button reports WM_DRAWITEM to its parent instead of
// drawing itself. The only way past the theme engine, which owns every pixel of
// a themed control's frame and ignores BS_FLAT.
fn bs_ownerdraw_style() -> u32 { return 0x000B as u32; }

// WM_DRAWITEM, sent to the OWNER of an owner-drawn control.
fn wm_drawitem() -> u32 { return 0x002B as u32; }

// ---- text goes out WIDE ------------------------------------------------------------
//
// THE ANSI ENTRY POINTS CANNOT CARRY A C+ STRING, and this was wrong from the
// first commit.
//
// `vendor/win32`'s manifest chose the `*A` calls so that "plain NUL-terminated
// C+ strings pass straight through (no UTF-16)". That is true for ASCII and
// false for everything else: an `*A` call decodes its bytes as the system
// ANSI codepage — CP1252 on a Western install — while a C+ `str` is UTF-8. So
// every byte above 0x7F is decoded as the wrong character, one per byte.
//
// Seen in a screenshot as a window titled `facet_win32 â€" first light`. The
// em-dash is UTF-8 `E2 80 94`; CP1252 reads those three bytes as `â`, `€` and
// `"`. Not a font problem and not a rendering problem — the string was already
// wrong before it reached the control.
//
// So text goes out through the `*W` calls, converted with
// `MultiByteToWideChar(CP_UTF8)`. That is the same conversion
// `stdlib/fs_sys_windows` does for every path it opens, and for the same
// reason.
//
// WHAT STAYS ANSI: class names and property keys. Those are ASCII literals this
// package writes itself, they are compared as bytes rather than displayed, and
// converting them would buy nothing.

fn cp_utf8() -> u32 { return 65001 as u32; }

extern fn malloc(n: usize) -> *u8;
extern fn free(p: *u8);

extern fn MultiByteToWideChar(codepage: u32, flags: u32, mb: *u8, mb_len: i32,
                              wc: *u16, wc_len: i32) -> i32;

// UTF-8 -> a NUL-terminated UTF-16 buffer the caller must free.
//
// `-1` for the input length means "the source is NUL-terminated, and count the
// terminator too" — which is what makes the result NUL-terminated without
// writing one by hand.
fn to_wide(s: str) -> *u16 {
    match text::from_str(s).c_str() {
        option::Option[text::CString]::Some(cs) => {
            let need: i32 = { MultiByteToWideChar(cp_utf8(), 0 as u32, cs.as_ptr(),
                                                  0 -% (1 as i32),
                                                  0 as *u16, 0 as i32) };
            if need <= (0 as i32) { return 0 as *u16; }
            let buf: *u8 = { malloc((need as usize) *% (2 as usize)) };
            if buf.is_null() { return 0 as *u16; }
            let w: *u16 = buf as *u16;
            let got: i32 = { MultiByteToWideChar(cp_utf8(), 0 as u32, cs.as_ptr(),
                                                 0 -% (1 as i32), w, need) };
            if got <= (0 as i32) { { free(buf) }; return 0 as *u16; }
            return w;
        }
        option::Option[text::CString]::None => { return 0 as *u16; }
    }
}

fn free_wide(w: *u16) {
    if w == (0 as *u16) { return; }
    { free(w as *u8) };
    return;
}

// The other direction, which nothing needed until a DROP arrived. The shell
// hands paths as UTF-16 and facet's strings are UTF-8, so a path with any
// character above ASCII — which on a Windows desktop is most users' own name —
// would otherwise arrive mangled in exactly the way `to_wide`'s header
// describes for the outbound side.
extern fn WideCharToMultiByte(codepage: u32, flags: u32, wide: *u16, wide_len: i32,
                              mb: *u8, mb_len: i32, default_char: *u8,
                              used_default: *i32) -> i32;

fn from_wide(w: *u16) -> text::Text {
    if w == (0 as *u16) { return text::new(); }
    let need: i32 = { WideCharToMultiByte(cp_utf8(), 0 as u32, w, 0 -% (1 as i32),
                                          0 as *u8, 0 as i32, 0 as *u8, 0 as *i32) };
    if need <= (0 as i32) { return text::new(); }
    let buf: *u8 = { sys_malloc(need as usize) };
    if buf.is_null() { return text::new(); }
    let got: i32 = { WideCharToMultiByte(cp_utf8(), 0 as u32, w, 0 -% (1 as i32),
                                         buf, need, 0 as *u8, 0 as *i32) };
    var out: text::Text = text::new();
    // `need` INCLUDES THE TERMINATOR and a `str` must not, so the length is one
    // short of what the sizing call answered — a copy that kept it would put a
    // NUL inside every path this returns.
    if got > (1 as i32) {
        out = text::from_str({ #str_from_raw_parts(buf, (got -% (1 as i32)) as usize) });
    }
    { sys_free(buf) };
    return out;
}

#[link_name = "malloc"]
extern fn sys_malloc(n: usize) -> *u8;
#[link_name = "free"]
extern fn sys_free(p: *u8);
