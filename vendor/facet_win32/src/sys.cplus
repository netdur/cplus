fn swp_nomove() -> u32 { return 0x0002 as u32; }
fn swp_nozorder() -> u32 { return 0x0004 as u32; }
fn swp_noredraw() -> u32 { return 0x0008 as u32; }
fn swp_noactivate() -> u32 { return 0x0010 as u32; }
fn swp_showwindow() -> u32 { return 0x0040 as u32; }
fn swp_hidewindow() -> u32 { return 0x0080 as u32; }

fn hwnd_top() -> *u8 { return 0 as *u8; }
fn hwnd_bottom() -> *u8 { return 1 as *u8; }

// ---- ShowWindow --------------------------------------------------------------

fn sw_hide() -> i32 { return 0 as i32; }
fn sw_shownormal() -> i32 { return 1 as i32; }
fn sw_show() -> i32 { return 5 as i32; }

// ---- GetWindowLongPtr indices ------------------------------------------------

fn gwlp_wndproc() -> i32 { return 0 -% (4 as i32); }
fn gwlp_userdata() -> i32 { return 0 -% (21 as i32); }
fn gwl_style() -> i32 { return 0 -% (16 as i32); }
fn gwl_exstyle() -> i32 { return 0 -% (20 as i32); }

// ---- control classes ---------------------------------------------------------
//
// The system classes are STRINGS, and the SDK spells them as `#define`s too.
// `#str_ptr` gives the NUL-terminated bytes the ANSI entry points want.

fn button_class() -> *u8 { return { #str_ptr("BUTTON\0") }; }
fn static_class() -> *u8 { return { #str_ptr("STATIC\0") }; }
fn edit_class() -> *u8 { return { #str_ptr("EDIT\0") }; }
fn combo_class() -> *u8 { return { #str_ptr("COMBOBOX\0") }; }
fn progress_class() -> *u8 { return { #str_ptr("msctls_progress32\0") }; }
fn trackbar_class() -> *u8 { return { #str_ptr("msctls_trackbar32\0") }; }
fn updown_class() -> *u8 { return { #str_ptr("msctls_updown32\0") }; }
fn listview_class() -> *u8 { return { #str_ptr("SysListView32\0") }; }
fn treeview_class() -> *u8 { return { #str_ptr("SysTreeView32\0") }; }
fn tab_class() -> *u8 { return { #str_ptr("SysTabControl32\0") }; }
fn datetime_class() -> *u8 { return { #str_ptr("SysDateTimePick32\0") }; }

