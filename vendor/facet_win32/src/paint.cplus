// facet_win32/paint — the SHARED BAND: the props every backed node honours,
// whatever kind it is.
//
// Split from the per-kind bodies for the reason facet_appkit's and
// facet_gtk's `paint` are: these verbs are declared once on the contract and
// answered once here, so a control gaining a window gains the whole band with
// it and cannot answer half of it.
//
// THREE MECHANISMS, and which one a verb uses is not a style choice.
//
//   * `is_enabled` and `is_visible` are calls on the window — `EnableWindow`,
//     `ShowWindow`. Direct, immediate, no repaint to arrange.
//   * `background_color`, `corner_radius` and the brush are PAINT. A panel
//     draws them in its own WM_PAINT (window.cplus owns the WNDPROC; this file
//     owns what it draws). Nothing is stored on the platform side — the node
//     is the truth and the paint re-reads it.
//   * A SYSTEM CONTROL PAINTS ITSELF, and the only door into that is the
//     WM_CTLCOLOR* family: just before a static, edit or button draws, it asks
//     its PARENT for a text colour, a background colour and a brush. That is
//     why those messages are answered on the host rather than on the control,
//     and it is the whole of what a Win32 backend can say about a control's
//     appearance without owner-drawing it.
//
// WHAT THAT LEAVES OUT is recorded in MANIFEST.md rather than faked. A child
// HWND has no alpha (layered windows are top-level only) and no transform, so
// `opacity` and `set_scale` on a CONTROL are honest cannot-rows; on a panel
// they are answerable and the ledger says which is which.
//
// COLOUR TOKENS. `vocab::Color` is FOUR different things wearing one struct,
// told apart by `token`, and a backend that resolves only some of them renders
// the rest BLACK — every component is 0 on a token colour, because the
// components were never where the answer lived. facet_gtk records this as the
// whole of its gallery's washed-out chrome. The four kinds are answered in
// `resolve`.

import "stdlib/option" as option;
import "facet/facet" as core;
import "facet/props" as props;
import "facet/vocabulary" as vocab;
import "facet/theme" as theme;
import "facet/application" as app;
import "stdlib/text" as text;
import "win32/winuser" as u;
import "win32/wingdi" as gdi;
import "./sys" as sys;

// Every state bit — the CREATE pass. Matches `facet_appkit::paint::all_bits`
// and `facet_gtk`'s: create configures the new window with every bit set,
// which is the same call `apply` makes with the node's real dirty word, so a
// prop honoured on update is honoured on create and the two cannot drift.
fn all_bits() -> u64 { return props::C_ALL_STATE; }

// Every FACT and no verb: what a theme flip re-reads. NOT `all_bits`, which is
// also the create sentinel — facet_appkit shipped that bug (an appearance flip
// looked like a create, and `apply_common` honoured focus and blur in order, so
// the caret vanished from whatever the user was typing into). Written down
// there, copied to facet_gtk on purpose, and copied here for the same reason.
fn restyle_bits() -> u64 { return props::C_RESTYLE; }

// The band's own bits, so a caller can ask "is any of this dirty?" without
// keeping a second copy of the list.
fn band_bits() -> u64 {
    return props::C_OPACITY | props::C_BACKGROUND_COLOR | props::C_CORNER_RADIUS
         | props::C_IS_ENABLED | props::C_IS_VISIBLE | props::C_TOOLTIP
         | props::C_SHADOW | props::C_CLIP | props::C_FLOW_DIRECTION
         | props::C_BACKGROUND | props::C_SEMANTICS;
}

// The bits that change what a node PAINTS, as against the ones that are plain
// window calls. `band` asks for these when deciding whether to invalidate.
fn repaint_bits() -> u64 {
    return props::C_BACKGROUND_COLOR | props::C_CORNER_RADIUS
         | props::C_BACKGROUND | props::C_FLOW_DIRECTION;
}

// ---- appearance --------------------------------------------------------------
//
// Which side of an adaptive pair is live. Set by the window tier at install and
// on every appearance change; read here. A static rather than a call into the
// window module because `window` imports this one.
static DARK: bool = false;

fn set_dark(v: bool) { DARK = v; return; }
fn is_dark() -> bool { return DARK; }

// ---- resolving a colour ------------------------------------------------------
//
// The four kinds, told apart by `token`:
//
//   255        a literal rgba. Use the components.
//   254        an adaptive PAIR. Pick a side from the live appearance.
//   100..117   a THEME ROLE — `ink`, `surface`, `raised`. The application's
//              theme answers it, or this file does when the theme is silent.
//   200..217   a DERIVED INK: "the readable ink over role N-100". Not a colour
//              at all but a QUESTION, and only a backend can answer it.
//   1..24      a PLATFORM SEMANTIC colour — `text`, `accent`,
//              `window_background`. This file is where Win32's answers live.
//
// A TOKEN COLOUR CARRIES NO ALPHA, and this is the trap facet_gtk records
// costing it a debugging pass: `Color::tok` builds every named colour with
// `a: 0.0`, because the components are not where its answer lives. So a zero
// alpha on a token means UNSPECIFIED, not transparent — a deliberately
// invisible colour is `Color::none()`, which is token 0 and never reaches here.



// A caller's alpha, with the token trap answered: `Color::tok` leaves `a` at
// zero because the components are not where a token's answer lives, so zero
// means UNSPECIFIED here and not transparent.
fn alpha_of(c: vocab::Color) -> f64 {
    if c.a > (0.0 as f64) { return c.a; }
    return 1.0f64;
}

fn mono(d: f64, l: f64, alpha: f64) -> vocab::Color {
    let v: f64 = if DARK { d } else { l };
    return vocab::Color::rgba(v, v, v, alpha);
}

fn rgba_both(dr: f64, dg: f64, db: f64, lr: f64, lg: f64, lb: f64,
             alpha: f64) -> vocab::Color {
    if DARK { return vocab::Color::rgba(dr, dg, db, alpha); }
    return vocab::Color::rgba(lr, lg, lb, alpha);
}

fn fixed(r: f64, g: f64, b: f64, alpha: f64) -> vocab::Color {
    return vocab::Color::rgba(r, g, b, alpha);
}

// Win32's answers to facet's platform tier.
//
// READ FROM THE SYSTEM where the system genuinely has an opinion, and stated
// as numbers where it does not — the opposite of facet_gtk's decision, and for
// the opposite reason. GTK 4 removed the API that reads a theme colour, so
// that backend had no choice but to write the Adwaita palette down. Win32 has
// `GetSysColor`, which is the real user preference and honours High Contrast
// — so ignoring it would break the one accessibility mode Windows users
// actually switch on.
//
// What `GetSysColor` does NOT cover is the named palette (red, green, teal),
// which is fixed by definition: a "system red" that changed with the
// appearance would not be a named colour.
//
// COLOR_* indices: WINDOW 5, WINDOWTEXT 8, HIGHLIGHT 13, BTNFACE 15,
// GRAYTEXT 17, HOTLIGHT 26.
fn sys_color(index: i32, alpha: f64) -> vocab::Color {
    let v: u32 = { u::GetSysColor(index) };
    // A COLORREF is 0x00BBGGRR — the channels come back in the reverse of the
    // order they are named in.
    let r: f64 = ((v & (0xFF as u32)) as f64) / (255.0 as f64);
    let g: f64 = (((v >> (8 as u32)) & (0xFF as u32)) as f64) / (255.0 as f64);
    let b: f64 = (((v >> (16 as u32)) & (0xFF as u32)) as f64) / (255.0 as f64);
    return vocab::Color::rgba(r, g, b, alpha);
}

fn platform_color(t: u32, alpha: f64) -> vocab::Color {
    if t == (1 as u32) { return sys_color(8 as i32, alpha); }       // text
    if t == (2 as u32) { return sys_color(17 as i32, alpha); }      // text_secondary
    if t == (9 as u32) { return sys_color(17 as i32, alpha); }      // text_tertiary
    if t == (15 as u32) { return sys_color(17 as i32, alpha); }     // placeholder
    if t == (16 as u32) { return sys_color(26 as i32, alpha); }     // link (HOTLIGHT)
    if t == (3 as u32) { return sys_color(13 as i32, alpha); }      // accent (HIGHLIGHT)
    if t == (11 as u32) { return sys_color(15 as i32, alpha); }     // window_background
    if t == (12 as u32) { return mono(0.09f64, 0.94f64, alpha); }   // under_page
    if t == (13 as u32) { return sys_color(5 as i32, alpha); }      // control_background
    if t == (14 as u32) { return mono(0.28f64, 0.80f64, alpha); }   // fill
    if t == (19 as u32) { return mono(0.24f64, 0.86f64, alpha); }   // fill_secondary
    if t == (17 as u32) { return sys_color(13 as i32, alpha); }     // selected content
    if t == (18 as u32) { return sys_color(13 as i32, alpha); }     // selected text bg
    if t == (10 as u32) { return mono(0.30f64, 0.85f64, alpha); }   // separator
    // The system palette. Fixed hues by definition — a "system red" that
    // changed with the appearance would not be a named colour. These are the
    // Windows standard swatches rather than Adwaita's: same roles, the
    // platform's own values.
    if t == (4 as u32) { return fixed(0.90f64, 0.22f64, 0.21f64, alpha); }    // red
    if t == (5 as u32) { return fixed(0.06f64, 0.66f64, 0.35f64, alpha); }    // green
    if t == (6 as u32) { return fixed(0.00f64, 0.47f64, 0.84f64, alpha); }    // blue
    if t == (7 as u32) { return fixed(0.96f64, 0.49f64, 0.00f64, alpha); }    // orange
    if t == (8 as u32) { return fixed(0.60f64, 0.60f64, 0.60f64, alpha); }    // gray
    if t == (20 as u32) { return fixed(0.98f64, 0.79f64, 0.14f64, alpha); }   // yellow
    if t == (21 as u32) { return fixed(0.53f64, 0.35f64, 0.78f64, alpha); }   // purple
    if t == (22 as u32) { return fixed(0.91f64, 0.31f64, 0.55f64, alpha); }   // pink
    if t == (23 as u32) { return fixed(0.00f64, 0.71f64, 0.72f64, alpha); }   // teal
    if t == (24 as u32) { return fixed(0.42f64, 0.40f64, 0.77f64, alpha); }   // indigo
    // An unknown token is NOT black. Black is what this whole function exists
    // to stop being the answer to a question nobody mapped.
    return sys_color(8 as i32, alpha);
}

// Depth guard: a role resolves to a fallback which may itself be a role. The
// chain is one step deep by design (`theme.cplus` says so, and says derived ink
// is the one exception), so four is slack, not a limit anyone should reach.
//
// Structurally identical to `facet_gtk::paint::resolve_depth` — deliberately,
// because this is facet's CONTRACT being read rather than a platform being
// addressed, and two readings that drifted would be two different apps.
fn resolve_depth(c: vocab::Color, depth: i32) -> vocab::Color {
    if depth <= (0 as i32) { return c; }
    let t: u32 = c.token;
    if t == (0 as u32) { return c; }
    if t == (255 as u32) { return c; }
    if t == (254 as u32) {
        if !DARK { return c; }
        var out: vocab::Color = c;
        out.r = c.r2;
        out.g = c.g2;
        out.b = c.b2;
        out.a = c.a2;
        return out;
    }
    // A theme role. The application's theme first; the platform's default when
    // the theme left it unset. ALPHA IS THE CALLER'S: `Color::ink(0.5)` is the
    // ink role at half strength, and resolving the role must not throw that
    // away — it is carried on the token, not in the role's own colour.
    if c.is_theme_role() {
        var slot: vocab::Color = theme::theme_slot(t);
        if !slot.is_set() { slot = theme::theme_fallback(t); }
        var out: vocab::Color = resolve_depth(slot, depth -% (1 as i32));
        out.a = alpha_of(out) * alpha_of(c);
        return out;
    }
    // A derived ink: black or white over whatever the base role resolved to,
    // by luminance. The threshold is 0.55 rather than 0.5 — human perception
    // of a mid grey sits above the arithmetic midpoint, and a 0.5 threshold
    // puts grey text on grey chrome.
    if c.is_derived_ink() {
        let base: vocab::Color = resolve_depth(c.derived_ink_base(), depth -% (1 as i32));
        let lum: f64 = (0.2126 as f64) * base.r + (0.7152 as f64) * base.g
                     + (0.0722 as f64) * base.b;
        if lum > (0.55 as f64) {
            return vocab::Color::rgba(0.0f64, 0.0f64, 0.0f64, alpha_of(c));
        }
        return vocab::Color::rgba(1.0f64, 1.0f64, 1.0f64, alpha_of(c));
    }
    return platform_color(t, alpha_of(c));
}

fn resolved(c: vocab::Color) -> vocab::Color { return resolve_depth(c, 4 as i32); }

// A COLORREF is 0x00BBGGRR — the byte order is REVERSED from every other
// colour format on the platform, and getting it backwards produces a picture
// that looks deliberate (blue where red should be) rather than broken.
fn colorref(r: f64, g: f64, b: f64) -> u32 {
    return chan(r) | (chan(g) << (8 as u32)) | (chan(b) << (16 as u32));
}

fn chan(v: f64) -> u32 {
    if v <= (0.0 as f64) { return 0 as u32; }
    if v >= (1.0 as f64) { return 255 as u32; }
    return (v * (255.0 as f64) + (0.5 as f64)) as u32;
}

// Resolve a facet colour to a COLORREF. `has` says whether there was an answer
// at all — a caller must not paint an unset colour, and a `bool` out is how
// that is said without inventing a sentinel COLORREF (every 24-bit value is a
// real colour, so there is none to invent).
fn resolve(c: vocab::Color, has: *bool) -> u32 {
    if !c.is_set() { { *has = false }; return 0 as u32; }
    { *has = true };
    let live: vocab::Color = resolved(c);
    return colorref(live.r, live.g, live.b);
}
// ---- the band ----------------------------------------------------------------
//
// Called by `views::configure` before the per-kind body, with the node's dirty
// word — or with `all_bits()` on create. Every write is gated on its own bit;
// nothing here reads a bit it does not answer.
fn band(v: *u8, n: *core::Node, d: u64) {
    if v == (0 as *u8) { return; }
    if (d & props::C_IS_ENABLED) != (0 as u64) {
        let on: bool = core::is_enabled(n);
        let _r: i32 = { u::EnableWindow(v, if on { 1 as i32 } else { 0 as i32 }) };
    }
    // C_IS_VISIBLE is answered in `geometry::show_window` rather than here,
    // and deliberately: a window shown before it has a frame appears at 0,0 in
    // its host's corner for one message turn. The layout walk is the only
    // place that knows the frame is ready, so that is where the show happens.
    //
    // Anything that changes what this node DRAWS invalidates it. A panel
    // repaints from `window`'s WM_PAINT; a system control ignores this and
    // re-asks WM_CTLCOLOR* on its own next paint, which the invalidate is what
    // triggers.

    // ---- the tooltip -----------------------------------------------------------
    //
    // Win32 has no per-window tooltip PROPERTY. A tooltip is a control of its
    // own — `TOOLTIPS_CLASS` — that other windows register themselves with, so
    // one is made lazily per top-level window and every node with a tip becomes
    // a TOOL inside it.
    if (d & props::C_TOOLTIP) != (0 as u64) {
        apply_tooltip(v, n);
    }
    // ---- the accessibility name -------------------------------------------------
    //
    // A node's KEY is already the a11y id — one token, three jobs, as on AppKit
    // and GTK — and `C_SEMANTICS` carries the human-readable half beside it.
    //
    // `SetWindowTextA` is the a11y name for a control that DRAWS its text
    // (a button, a label), which means writing a semantic label onto one would
    // change what it shows. So this is answered only for kinds whose text is
    // NOT their content: a panel, a scroll, a list. MSAA would let the rest be
    // answered properly and is not bound.
    if (d & props::C_SEMANTICS) != (0 as u64) {
        apply_semantics(v, n);
    }
    // ---- what an agent may do with this node ------------------------------------
    //
    // Pinned on the WINDOW rather than left in facet: the agent surface walks
    // the platform tree and never sees a facet node, and a pin survives a
    // re-render that replaces a window's contents but not the window.
    //
    // `app::agent_pin` is platform-free — it dispatches through a hook that
    // `agent_win32` fills when an app actually serves, and is a null check
    // otherwise. The whole cost to an app that never served is a stored enum.
    //
    // ITS OWN BIT, and `props.cplus` says why: this is the only shared-band
    // value a security boundary depends on, so re-reading it as a side effect
    // of a label change would put the pin's timing somewhere else.
    if (d & props::C_AGENT) != (0 as u64) {
        app::agent_pin(v, core::agent(n));
    }
    // ---- focus and blur ARE COMMANDS -------------------------------------------
    //
    // Not state: act on the bit and the sync walk clears it. Distinct from the
    // focus HANDLERS in `input`, which are what a node hears when focus moves;
    // these are what a node SAYS to move it.
    //
    // A window only takes focus if it can hold it. A system control is
    // focusable already; a bare panel that asked for focus is not, and
    // `SetFocus` on one silently does nothing — which is the same half-wired
    // failure facet_gtk records fixing with `set_focusable(true)`.
    if (d & props::C_FOCUS) != (0 as u64) {
        let _prev: *u8 = { u::SetFocus(v) };
    }
    if (d & props::C_BLUR) != (0 as u64) {
        // GIVE IT UP, do not hand it anywhere. `SetFocus(0)` detaches the
        // keyboard from this thread's windows entirely, which is what "no
        // longer focused" means when the application named no successor.
        if { u::GetFocus() } == v { let _p: *u8 = { u::SetFocus(0 as *u8) }; }
    }
    if (d & repaint_bits()) != (0 as u64) {
        let _i: i32 = { u::InvalidateRect(v, 0 as *u::tagRECT, 1 as i32) };
    }
    return;
}


// ---- WM_CTLCOLOR* ---------------------------------------------------------------
//
// A system control asks its PARENT for its colours just before it draws. This
// is the only door into a control's appearance short of owner-drawing it, and
// it is answered in three parts: a text colour, a background colour, and a
// BRUSH the control uses to fill everything the text does not cover.
//
// THE BRUSH MUST OUTLIVE THE MESSAGE. Windows keeps using the handle after the
// WNDPROC returns, so a brush created per call and deleted before the return
// is a use-after-free that draws garbage — and one created per call and NOT
// deleted is a handle leak at frame rate, which kills the process at ten
// thousand handles with an error naming none of this. So brushes are cached by
// COLOUR: a small table, one entry per distinct colour in the tree, created
// once and never freed. That is bounded by the palette rather than by time,
// which is the property that makes it safe.

const MAX_BRUSHES: usize = 32 as usize;

static BRUSH_COLORS: [u32; 32] = [0 as u32; 32];
static BRUSH_HANDLES: [usize; 32] = [0 as usize; 32];
static BRUSH_USED: [bool; 32] = [false; 32];

fn brush_for(c: u32) -> *u8 {
    var i: usize = 0 as usize;
    while i < MAX_BRUSHES {
        if BRUSH_USED[i] && BRUSH_COLORS[i] == c { return BRUSH_HANDLES[i] as *u8; }
        i = i +% (1 as usize);
    }
    var j: usize = 0 as usize;
    while j < MAX_BRUSHES {
        if !BRUSH_USED[j] {
            let h: *u8 = { gdi::CreateSolidBrush(c) };
            if h == (0 as *u8) { return 0 as *u8; }
            BRUSH_COLORS[j] = c;
            BRUSH_HANDLES[j] = { #addr(h) };
            BRUSH_USED[j] = true;
            return h;
        }
        j = j +% (1 as usize);
    }
    // THE TABLE IS FULL, and the answer is null rather than an eviction. A
    // brush handed out and then deleted to make room is the use-after-free the
    // cache exists to avoid — so a thirty-third colour falls back to the
    // control's own default, which is a visible narrowing rather than a crash.
    // MANIFEST.md §2 carries the row.
    return 0 as *u8;
}

// ---- the EFFECTIVE background ------------------------------------------------------
//
// A BACKGROUND IS INHERITED, and this is the correction to what this file used
// to do.
//
// It answered a node with no background of its own with `TRANSPARENT` plus the
// HOLLOW brush, reasoning that a label over a coloured card must let the card
// through. That is true and it is not what those two values mean together: a
// hollow brush paints NOTHING, so a static asked to redraw leaves the pixels
// that were already there and draws the new string ON TOP of the old one.
//
// Seen as: clicking the counter turned "clicks: 9" into "clicks: 9" and
// "clicks: 10" superimposed, which reads as a duplicated label and a broken
// font rather than as a missing erase.
//
// So the background is RESOLVED UP the window chain instead. A label on a panel
// with no colour inherits its parent's, and a panel with none inherits the
// window's, and the last resort is the shell's own `COLOR_BTNFACE` — which is
// what a dialog is, and what every control on one erases with.
//
// The case the old code was reaching for is real and is now `§1`'s: a label over
// a node that paints something NON-FLAT (a gradient, a rounded card) gets the
// flat colour underneath it rather than the gradient, because there is nothing
// to sample. Correct erasing first; that row is a narrowing, superimposed text
// was a bug.
fn node_at(v: *u8) -> *core::Node {
    if v == (0 as *u8) { return 0 as *core::Node; }
    return { u::GetPropA(v, sys::prop_node() as *i8) } as *core::Node;
}

fn effective_bg(v: *u8) -> u32 {
    var cur: *u8 = v;
    while cur != (0 as *u8) {
        let n: *core::Node = node_at(cur);
        if n != (0 as *core::Node) {
            var has: bool = false;
            let c: u32 = resolve(core::background_color(n), #addr_of(has));
            if has { return c; }
        }
        cur = { u::GetParent(cur) };
    }
    // COLOR_BTNFACE — the dialog face, which is what a window with no stated
    // background IS on this platform.
    return { u::GetSysColor(15 as i32) };
}

// Fill `v`'s client area with its effective background. What WM_ERASEBKGND
// answers — honestly, now: it used to return "erased" and erase nothing, which
// left every stale pixel exactly where it was.
fn erase(v: *u8, hdc: *u8) {
    var r: u::tagRECT = u::tagRECT { left: 0 as i32, top: 0 as i32,
                                     right: 0 as i32, bottom: 0 as i32 };
    if { u::GetClientRect(v, #addr_of(r)) } == (0 as i32) { return; }
    let b: *u8 = brush_for(effective_bg(v));
    if b == (0 as *u8) { return; }
    let _f: i32 = { u::FillRect(hdc, #addr_of(r), b) };
    return;
}
// Answer one WM_CTLCOLOR*. `ctl` is the control's HWND (lParam) and `hdc` is
// the device context it is about to draw into (wParam).
//
// Returns the brush to hand back, or null to let DefWindowProc answer — which
// is the right answer for a node that states no colours, because the control's
// own default is what the platform's theme says it should be.
fn ctl_color(ctl: *u8, hdc: *u8) -> *u8 {
    if ctl == (0 as *u8) { return 0 as *u8; }
    let n: *core::Node = { u::GetPropA(ctl, sys::prop_node() as *i8) } as *core::Node;
    if n == (0 as *core::Node) { return 0 as *u8; }

    var has_fg: bool = false;
    let fg: u32 = resolve(text_color_of(n), #addr_of(has_fg));
    if has_fg { let _t: u32 = { gdi::SetTextColor(hdc, fg) }; }

    var has_bg: bool = false;
    let bg: u32 = resolve(core::background_color(n), #addr_of(has_bg));
    // NO BACKGROUND OF ITS OWN MEANS INHERIT ONE, not paint nothing — see
    // `effective_bg`. A control has to erase before it draws or its new string
    // lands on top of its old one.
    var fill: u32 = bg;
    if !has_bg { fill = effective_bg(ctl); }
    // OPAQUE, always. The bk mode governs the box behind the TEXT and the brush
    // governs everything around it; both have to paint or the gap between them
    // is where the old pixels survive.
    let _m: i32 = { gdi::SetBkMode(hdc, sys::bkmode_opaque()) };
    let _b: u32 = { gdi::SetBkColor(hdc, fill) };
    return brush_for(fill);
}

// A node's own text colour, per kind. Not a shared-band prop — each control
// that draws text declares its own — so this is the one place the per-kind
// answer is collected, because WM_CTLCOLOR* arrives without knowing the kind.
fn text_color_of(n: *core::Node) -> vocab::Color {
    let kind: u32 = core::kind_of(n);
    let d: *core::Data = core::node_data(n);
    if d == (0 as *core::Data) { return vocab::Color::none(); }
    let p: *u8 = { (*d).props };
    if p == (0 as *u8) { return vocab::Color::none(); }
    if kind == props::K_LABEL { return { (*(p as *props::LabelProps)).text_color }; }
    if kind == props::K_BUTTON { return { (*(p as *props::ButtonProps)).text_color }; }
    if kind == props::K_TEXT_FIELD {
        return { (*(p as *props::TextFieldProps)).input_view.text_color };
    }
    return vocab::Color::none();
}
// ---- painting a panel ---------------------------------------------------------
//
// What `window`'s WNDPROC draws for a FacetWin32Panel on WM_PAINT. The node is
// read fresh every time: there is no cached brush, no shadow copy of the
// colour, and so nothing that can disagree with the tree.
//
// A node with no background paints NOTHING and lets its parent's pixels stand.
// That is not an optimisation — a panel that filled with a default would erase
// the card it is sitting on, and "no background" is a thing facet's model can
// say.
// The shared band's background. `controls::paint_node` calls this and then the
// per-kind drawing — the dispatch lives THERE rather than here because
// `controls` already imports this module, and an import back would be a cycle.
fn paint_band_background(v: *u8, n: *core::Node, hdc: *u8) {
    if n == (0 as *core::Node) { return; }

    var has: bool = false;
    let c: u32 = resolve(core::background_color(n), #addr_of(has));
    if !has { return; }
    var r: u::tagRECT = u::tagRECT { left: 0 as i32, top: 0 as i32,
                                     right: 0 as i32, bottom: 0 as i32 };
    if { u::GetClientRect(v, #addr_of(r)) } == (0 as i32) { return; }
    let brush: *u8 = { gdi::CreateSolidBrush(c) };
    if brush == (0 as *u8) { return; }
    let radius: vocab::Corners = core::corner_radius(n);
    if uniform_radius(radius) > (0.0 as f64) {
        paint_rounded(hdc, r, brush, uniform_radius(radius));
    } else {
        let _f: i32 = { u::FillRect(hdc, #addr_of(r), brush) };
    }
    // EVERY GDI OBJECT IS RELEASED. A brush leaked per paint is a handle leak
    // at frame rate, and the process dies at 10,000 handles with an error that
    // names none of this.
    let _d: i32 = { gdi::DeleteObject(brush) };
    return;
}

// A rounded rectangle needs a PEN as well as a brush, because `RoundRect`
// strokes its outline with whatever pen is selected — and the default is a
// black 1px one, which draws a black keyline around every rounded card. The
// null pen is the fix and it has to be selected and restored.
fn paint_rounded(hdc: *u8, r: u::tagRECT, brush: *u8, radius: f64) {
    let null_pen: *u8 = { gdi::GetStockObject(8 as i32) };   // NULL_PEN
    let old_pen: *u8 = { gdi::SelectObject(hdc, null_pen) };
    let old_brush: *u8 = { gdi::SelectObject(hdc, brush) };
    let d: i32 = ((radius * (2.0 as f64)) as i32);
    // RoundRect's right/bottom are EXCLUSIVE, unlike FillRect's — one pixel of
    // difference, on every rounded node, and it shows as a hairline of the
    // parent's colour down two sides.
    let _r: i32 = { gdi::RoundRect(hdc, r.left, r.top, r.right +% (1 as i32),
                                   r.bottom +% (1 as i32), d, d) };
    let _b: *u8 = { gdi::SelectObject(hdc, old_brush) };
    let _p: *u8 = { gdi::SelectObject(hdc, old_pen) };
    return;
}

// facet's corners are per-corner and Win32's `RoundRect` takes ONE ellipse for
// all four. The largest is used and the narrowing is recorded in MANIFEST.md
// §1 — asking for three square corners and one round one is a region, which is
// a different mechanism and not one this package has yet.
fn uniform_radius(c: vocab::Corners) -> f64 {
    var m: f64 = c.top_leading;
    if c.top_trailing > m { m = c.top_trailing; }
    if c.bottom_leading > m { m = c.bottom_leading; }
    if c.bottom_trailing > m { m = c.bottom_trailing; }
    return m;
}

#[test]
fn a_colorref_is_bgr_not_rgb() {
    // Pure red is 0x0000FF in a COLORREF, NOT 0xFF0000. Getting this backwards
    // produces a picture that looks deliberate rather than broken, which is
    // exactly the kind of bug that survives a screenshot review.
    assert colorref(1.0f64, 0.0f64, 0.0f64) == (0x0000FF as u32);
    assert colorref(0.0f64, 0.0f64, 1.0f64) == (0xFF0000 as u32);
    assert colorref(0.0f64, 1.0f64, 0.0f64) == (0x00FF00 as u32);
    return;
}

#[test]
fn an_unset_colour_answers_no() {
    var has: bool = true;
    let _c: u32 = resolve(vocab::Color::none(), #addr_of(has));
    // `has = false` is what stops a panel painting over its parent — see
    // `paint_panel`. A sentinel COLORREF could not say this, because every
    // 24-bit value is a real colour.
    assert has == false;
    return;
}

#[test]
fn an_rgba_literal_needs_no_theme() {
    var has: bool = false;
    let c: u32 = resolve(vocab::Color::rgba(1.0f64, 0.0f64, 0.0f64), #addr_of(has));
    assert has;
    assert c == (0x0000FF as u32);
    return;
}

#[test]
fn restyle_is_not_the_create_sentinel() {
    // The AppKit bug this package inherited the warning about: if a theme flip
    // raised every bit, it would look like a create and re-issue the COMMANDS
    // — focus among them — stealing the caret from whatever the user was
    // typing into.
    assert restyle_bits() != all_bits();
    return;
}

// ---- tooltips ---------------------------------------------------------------------
//
// A TOOLTIP IS A CONTROL, not a property. Win32 has no `SetTooltip(hwnd, text)`:
// there is a `TOOLTIPS_CLASS` window, and every window that wants a tip
// REGISTERS ITSELF with it as a "tool". So one tooltip control is made per
// process, lazily, and each node with a tip becomes a tool inside it.
//
// One per process rather than per window: the control is invisible, owns no
// layout, and is addressed by the tool's own HWND — so a second one would buy
// nothing and cost a window.

static TOOLTIP: usize = 0 as usize;

fn tooltips_class() -> *u8 { return { #str_ptr("tooltips_class32\0") }; }

// TTM_ADDTOOLA is WM_USER+4, TTM_UPDATETIPTEXTA is WM_USER+12, TTM_DELTOOLA is
// WM_USER+5. WM_USER is 0x400.
fn ttm_addtool() -> u32 { return 0x0404 as u32; }
fn ttm_updatetiptext() -> u32 { return 0x040C as u32; }
fn ttm_deltool() -> u32 { return 0x0405 as u32; }

// TTF_IDISHWND (0x0001) says the tool is identified by its HWND rather than by
// a rectangle; TTF_SUBCLASS (0x0010) makes the tooltip control subclass the
// tool so it sees the mouse itself — without it the owner would have to
// forward every WM_MOUSEMOVE by hand.
fn ttf_idishwnd() -> u32 { return 0x0001 as u32; }
fn ttf_subclass() -> u32 { return 0x0010 as u32; }

// TOOLINFOA, laid out by hand — `cpc-bindgen` did not carry it, and it is
// pointer-and-word fields with no inline arrays:
//
//   0   cbSize     UINT
//   4   uFlags     UINT
//   8   hwnd       HWND
//   16  uId        UINT_PTR
//   24  rect       RECT (4 x LONG)
//   40  hinst      HINSTANCE
//   48  lpszText   LPSTR
//   56  lParam     LPARAM
//   64  lpReserved void*
fn toolinfo_bytes() -> usize { return 72 as usize; }

fn tooltip_window() -> *u8 {
    if TOOLTIP != (0 as usize) { return TOOLTIP as *u8; }
    // WS_POPUP with TTS_ALWAYSTIP (0x01) — the tip shows even when the owning
    // window is inactive, which is what a tooltip is for.
    let h: *u8 = { u::CreateWindowExA(0 as u32, tooltips_class() as *i8,
                                      { #str_ptr("\0") } as *i8,
                                      sys::ws_popup() | (0x01 as u32),
                                      sys::cw_usedefault(), sys::cw_usedefault(),
                                      sys::cw_usedefault(), sys::cw_usedefault(),
                                      0 as *u8, 0 as *u8, 0 as *u8, 0 as *u8) };
    TOOLTIP = { #addr(h) };
    return h;
}

fn apply_tooltip(v: *u8, n: *core::Node) {
    let tip: str = core::tooltip(n);
    let tt: *u8 = tooltip_window();
    if tt == (0 as *u8) { return; }
    let info: *u8 = { tip_malloc(toolinfo_bytes()) };
    if info.is_null() { return; }
    let _z: *u8 = { tip_memset(info, 0 as i32, toolinfo_bytes()) };
    put_u32(info, 0 as usize, toolinfo_bytes() as u32);
    put_u32(info, 4 as usize, ttf_idishwnd() | ttf_subclass());
    put_ptr(info, 8 as usize, v);
    // The tool id IS the window when TTF_IDISHWND is set — the same handle in
    // two fields, which is what the flag means.
    put_ptr(info, 16 as usize, v);
    // AN EMPTY TIP REMOVES THE TOOL rather than showing a blank box. Clearing a
    // tooltip is a thing facet can say and a zero-length string is how it says
    // it.
    if tip == "" {
        let _r: i64 = { u::SendMessageA(tt, ttm_deltool(), 0 as u64, { #addr(info) } as i64) };
        { tip_free(info) };
        return;
    }
    match text::from_str(tip).c_str() {
        option::Option[text::CString]::Some(cs) => {
            put_ptr(info, 48 as usize, cs.as_ptr());
            // ADD then UPDATE: adding a tool that already exists is a no-op
            // rather than an error, and updating one that does not is the same,
            // so the pair together is "make this window's tip say that"
            // whichever state it was in.
            let _a: i64 = { u::SendMessageA(tt, ttm_addtool(), 0 as u64,
                                            { #addr(info) } as i64) };
            let _u: i64 = { u::SendMessageA(tt, ttm_updatetiptext(), 0 as u64,
                                            { #addr(info) } as i64) };
        }
        option::Option[text::CString]::None => { }
    }
    { tip_free(info) };
    return;
}

// ---- the accessibility name ---------------------------------------------------------
//
// A node's KEY is already the a11y id — one token, three jobs — and this is the
// human-readable half.
//
// ONLY FOR KINDS WHOSE TEXT IS NOT THEIR CONTENT. `SetWindowTextA` is what
// screen readers read for a plain window, and it is also what a button DRAWS —
// so writing a semantic label onto a button would silently replace its title.
// A container, a scroll and a list draw no text of their own and can carry one.
//
// The rest need MSAA (`IAccessible`) or UI Automation to answer properly, and
// neither is bound. MANIFEST.md §2 carries the row rather than this writing a
// label somewhere it would be visible.
fn semantics_is_safe(kind: u32) -> bool {
    if kind == core::K_NODE { return true; }
    if kind == props::K_BOX { return true; }
    if kind == props::K_SCROLL { return true; }
    if kind == props::K_LIST { return true; }
    if kind == props::K_TABLE { return true; }
    if kind == props::K_COLLECTION { return true; }
    return false;
}

fn apply_semantics(v: *u8, n: *core::Node) {
    if !semantics_is_safe(core::kind_of(n)) { return; }
    let label: str = core::accessibility_label(n);
    if label == "" { return; }
    match text::from_str(label).c_str() {
        option::Option[text::CString]::Some(cs) => {
            let _r: i32 = { u::SetWindowTextA(v, cs.as_ptr() as *i8) };
        }
        option::Option[text::CString]::None => { }
    }
    return;
}

#[link_name = "malloc"]
extern fn tip_malloc(n: usize) -> *u8;
#[link_name = "free"]
extern fn tip_free(p: *u8);
#[link_name = "memset"]
extern fn tip_memset(p: *u8, v: i32, n: usize) -> *u8;

fn put_u32(p: *u8, at: usize, v: u32) {
    let q: *u32 = { (p + at) } as *u32;
    { *q = v };
    return;
}

fn put_ptr(p: *u8, at: usize, v: *u8) {
    let q: *usize = { (p + at) } as *usize;
    { *q = { #addr(v) } };
    return;
}

// An ellipse filled with `b`. `Ellipse` strokes its outline with the selected
// pen, so the null pen goes on first — the default is a black 1px one, which
// would put a keyline around every dot.
fn fill_ellipse(hdc: *u8, r: u::tagRECT, b: *u8) {
    let null_pen: *u8 = { gdi::GetStockObject(8 as i32) };
    let old_pen: *u8 = { gdi::SelectObject(hdc, null_pen) };
    let old_brush: *u8 = { gdi::SelectObject(hdc, b) };
    let _e: i32 = { gdi::Ellipse(hdc, r.left, r.top, r.right, r.bottom) };
    let _b: *u8 = { gdi::SelectObject(hdc, old_brush) };
    let _p: *u8 = { gdi::SelectObject(hdc, old_pen) };
    return;
}

// An unfilled rectangle stroked in `color` at `width`, optionally rounded.
//
// PS_INSIDEFRAME (6) keeps the whole pen width INSIDE the rectangle. The
// default centres it on the path, so half a wide stroke falls outside the
// node's own box and is clipped — a 6-point border drawing as 3, with nothing
// to explain it.
fn stroke_rect(hdc: *u8, r: u::tagRECT, color: u32, width: i32, radius: f64) {
    if width <= (0 as i32) { return; }
    let pen: *u8 = { gdi::CreatePen(6 as i32, width, color) };
    if pen == (0 as *u8) { return; }
    let hollow: *u8 = { gdi::GetStockObject(5 as i32) };
    let old_pen: *u8 = { gdi::SelectObject(hdc, pen) };
    let old_brush: *u8 = { gdi::SelectObject(hdc, hollow) };
    if radius > (0.0 as f64) {
        let d: i32 = (radius * (2.0 as f64)) as i32;
        let _r: i32 = { gdi::RoundRect(hdc, r.left, r.top, r.right, r.bottom, d, d) };
    } else {
        let _r: i32 = { gdi::Rectangle(hdc, r.left, r.top, r.right, r.bottom) };
    }
    let _b: *u8 = { gdi::SelectObject(hdc, old_brush) };
    let _p: *u8 = { gdi::SelectObject(hdc, old_pen) };
    let _d: i32 = { gdi::DeleteObject(pen) };
    return;
}

// ---- dropping ONE control out of visual styles ---------------------------------------
//
// A themed control owns every pixel of itself. That is the wall §1 records for
// a button's border and a radio's corners, and it is why `PBM_SETBARCOLOR` sets
// a colour that is then never used: the theme engine draws the bar from the
// theme's own bitmap and the stored colour is read by nobody.
//
// `SetWindowTheme(h, L"", L"")` takes that ONE window out of visual styles.
// From then on it draws itself the classic way, which means the classic colour
// messages — `PBM_SETBARCOLOR`, `WM_CTLCOLOR*` — are honoured again.
//
// THIS IS A VISIBLE TRADE and the rule for it is: only a node that ACTUALLY
// STATES A COLOUR pays it. A progress bar nobody has coloured keeps the modern
// look; one that asked to be red gets red, drawn classically, because a red bar
// that silently stays blue is the worse answer of the two. Applying it
// unconditionally would make every control in the process look like Windows
// 2000 to buy a verb almost nobody uses.
//
// It is idempotent and cheap, but the flag keeps it to once per control so a
// per-frame apply is not calling into uxtheme on every tick.
extern fn SetWindowTheme(h: *u8, sub: *u16, id: *u16) -> i32;

fn go_classic(v: *u8) {
    if { u::GetPropA(v, sys::prop_classic() as *i8) } != (0 as *u8) { return; }
    // Two empty wide strings, not null: null means "inherit", which is the
    // opposite of what this asks for.
    var empty: u16 = 0 as u16;
    let _r: i32 = { SetWindowTheme(v, #addr_of(empty), #addr_of(empty)) };
    let _p: i32 = { u::SetPropA(v, sys::prop_classic() as *i8, 1 as *u8) };
    return;
}

