// facet_win32/input — the READ half: what the platform tells facet.
//
// THE ONE PLACE THIS PACKAGE'S SHAPE GENUINELY DEPARTS from facet_gtk's.
//
// A GTK control calls you back: you attach a controller or connect a signal to
// the widget, and the widget is where the handler lives. A Win32 control does
// not. It sends a NOTIFICATION TO ITS PARENT — WM_COMMAND for a button, an
// edit or a combo; WM_HSCROLL for a trackbar; WM_NOTIFY for a common control —
// and the parent is expected to work out which child it came from.
//
// So there is no `arm` that attaches anything per control. Arming here is
// binding the NODE onto the window (`SetPropA`), and the routing lives in one
// place: `window`'s WNDPROC hands a notification to `on_command` / `on_scroll`,
// which resolves the sending HWND back to its node and fires the handler the
// node's props carry.
//
// That resolution is exact and needs no id table, because WM_COMMAND's lParam
// IS the control's HWND for a control notification (it is 0 for a menu or an
// accelerator, which is how the two are told apart). A backend that allocated
// per-control command ids — as the `win32` package's own facade does — would
// be maintaining a second identity for something the message already carries.
//
// A HANDLER IS COMPARED AGAINST `props::no_handler`, NEVER AGAINST NULL. The
// default IS a function, so a null check would never be false. facet's own
// props.cplus says so at the declaration and every backend repeats it.

import "stdlib/option" as option;
import "stdlib/text" as text;
import "facet/facet" as core;
import "facet/props" as props;
import "facet/tabs" as tabs;
import "facet/split" as split;
import "facet/refreshable" as refreshable;
import "facet/text_button" as text_button;
import "facet/component" as component;
import "facet/gestures" as gestures;
import "facet/vocabulary" as vocab;
import "facet/button" as button;
import "facet/checkbox" as checkbox;
import "facet/toggle" as toggle;
import "win32/winuser" as u;
import "./sys" as sys;
import "./controls" as controls;
import "./recycler" as recycler;
import "./dnd" as dnd;
import "./menus" as menus;

// ---- binding a node onto its window -------------------------------------------

fn bind_node(v: *u8, n: *core::Node) {
    if v == (0 as *u8) { return; }
    let _r: i32 = { u::SetPropA(v, sys::prop_node() as *i8, n as *u8) };
    return;
}

fn unbind_node(v: *u8) {
    if v == (0 as *u8) { return; }
    let _r: *u8 = { u::RemovePropA(v, sys::prop_node() as *i8) };
    return;
}

fn node_of_window(v: *u8) -> *core::Node {
    if v == (0 as *u8) { return 0 as *core::Node; }
    return { u::GetPropA(v, sys::prop_node() as *i8) } as *core::Node;
}

// The nearest node at or above `v`. The walk goes UP for the reason AppKit's
// and GTK's do: a click on an untagged icon inside a tagged row is the ROW's.
fn node_at_or_above(v: *u8) -> *core::Node {
    var cur: *u8 = v;
    while cur != (0 as *u8) {
        let n: *core::Node = node_of_window(cur);
        if n != (0 as *core::Node) { return n; }
        cur = { u::GetParent(cur) };
    }
    return 0 as *core::Node;
}

// ---- arming -------------------------------------------------------------------
//
// Binds the node onto the window — which every backed node needs, gestures or
// not, because the sender readers walk it — and answers input transparency.
// There is nothing else to attach: see the header.
fn arm(v: *u8, n: *core::Node) {
    if v == (0 as *u8) { return; }
    if n == (0 as *core::Node) { return; }
    bind_node(v, n);
    apply_input_transparency(v, n);
    // A NODE THAT TAKES DROPS BECOMES A SHELL DROP TARGET, and one that stops
    // taking them stops being one — `arm` is called again on `C_GESTURES`, so
    // both directions are covered here rather than only at create.
    dnd::arm(v, gestures_at(v));
    return;
}

// `input_transparent`, and the one switch that changes what it MEANS.
//
// The band's `input_transparent` is a plain bool; what it CASCADES to is a
// `scroll`'s `cascades_input`, which is the only kind that can say the
// subtree behind it should still be reachable. Same reading as facet_gtk's
// `cascades_input`, and it defaults to true for every other kind.
//
// WS_EX_TRANSPARENT is the CASCADING form: the window is skipped by hit
// testing entirely and so is everything inside it.
//
// The non-cascading form needs no style bit and does not get one: a
// transparent node that must let its CHILDREN through is answered by leaving
// the window alone and simply never routing to it — `on_command` asks the node
// whether it wanted the notification. Setting the ex-style for that case would
// take the children out too, which is the opposite of what was asked.
fn cascades_input(n: *core::Node) -> bool {
    let d: *core::Data = core::node_data(n);
    if d == (0 as *core::Data) { return true; }
    if { (*d).kind } != props::K_SCROLL { return true; }
    let p: *props::ScrollProps = { (*d).props } as *props::ScrollProps;
    if p == (0 as *props::ScrollProps) { return true; }
    return { (*p).cascades_input };
}

fn apply_input_transparency(v: *u8, n: *core::Node) {
    if v == (0 as *u8) || n == (0 as *core::Node) { return; }
    let blocked: bool = core::input_transparent(n) && cascades_input(n);
    var ex: u32 = { u::GetWindowLongPtrA(v, sys::gwl_exstyle()) } as u32;
    if blocked { ex = ex | sys::ws_ex_transparent(); }
    else { ex = ex & ~sys::ws_ex_transparent(); }
    let _o: i64 = { u::SetWindowLongPtrA(v, sys::gwl_exstyle(), ex as i64) };
    return;
}

fn takes_no_input(n: *core::Node) -> bool {
    return core::input_transparent(n);
}

// ---- WM_COMMAND ----------------------------------------------------------------
//
// `ctl` is the sending control's HWND — lParam, straight from the message —
// and `code` is the notification (HIWORD of wParam). Called by `window`'s
// WNDPROC; returns true when facet took the notification, so the WNDPROC knows
// whether to pass it to DefWindowProc.

// ---- a click inside a row ---------------------------------------------------------
//
// A ROW'S CLICK IS THE LIST'S SELECTION. facet's own SKILL states it as a rule
// for application authors — "the table owns the mouse inside its own rows, so
// `.gesture(on_click:)` on anything in a row is a handler nothing will deliver
// to" — and this is the backend half that makes it true.
//
// The realised row's windows are parented to the list's VIEWPORT, so a click on
// a label inside a row arrives at the viewport as WM_COMMAND with `STN_CLICKED`
// (which is 0, the same number as `BN_CLICKED` — they are different
// notifications on different classes and the sending control is what tells them
// apart). The row index comes from the row root's item slot, which
// `recycler::build_row` wrote before realising it.
//
// Asked BEFORE the per-kind dispatch, because a label inside a row is still a
// label and would otherwise fall through to "no handler for this kind".
fn list_above(ctl: *u8) -> *u8 {
    var cur: *u8 = ctl;
    while cur != (0 as *u8) {
        let n: *core::Node = node_of_window(cur);
        if n != (0 as *core::Node) {
            if recycler::holds_rows(n) { return cur; }
        }
        cur = { u::GetParent(cur) };
    }
    return 0 as *u8;
}

fn row_click(ctl: *u8) -> bool {
    let host: *u8 = list_above(ctl);
    if host == (0 as *u8) { return false; }
    // The list's own window is not a row — a click that reached the viewport
    // itself is a click on empty space below the last row, which selects
    // nothing rather than row zero.
    if host == ctl { return false; }
    let ln: *core::Node = node_of_window(host);
    if ln == (0 as *core::Node) { return false; }
    return match component::item_index_of(ctl) {
        option::Option[usize]::Some(i) => recycler::on_row_click(host, ln, i),
        option::Option[usize]::None => false,
    };
}

fn on_command(ctl: *u8, code: u32) -> bool {
    if ctl == (0 as *u8) { return false; }
    let n: *core::Node = node_of_window(ctl);
    if n == (0 as *core::Node) { return false; }
    if takes_no_input(n) { return false; }
    // Inside a list? Then the click is the LIST'S — see `row_click`.
    if code == sys::bn_clicked() {
        if row_click(ctl) { return true; }
    }
    let kind: u32 = core::kind_of(n);
    if kind == props::K_BUTTON {
        if code == sys::bn_clicked() { return fire_button(ctl, n); }
        // THE PRESS EDGES, which a button reports only when it was created
        // with `BS_NOTIFY` — without that style a button sends BN_CLICKED and
        // nothing else, and `on_pressed`/`on_released` would look implemented
        // while never firing.
        if code == bn_pushed() { return fire_press(ctl, n, true); }
        if code == bn_unpushed() { return fire_press(ctl, n, false); }
        return false;
    }
    if kind == props::K_ICON_BUTTON {
        if code == sys::bn_clicked() { return fire_icon_button(ctl, n); }
        if code == bn_pushed() { return fire_icon_press(ctl, n, true); }
        if code == bn_unpushed() { return fire_icon_press(ctl, n, false); }
        return false;
    }
    if kind == text_button::K_TEXT_BUTTON {
        if code == sys::bn_clicked() { return fire_text_button(ctl, n); }
        return false;
    }
    if kind == props::K_CHECKBOX {
        if code == sys::bn_clicked() { return fire_checkbox(ctl, n); }
        return false;
    }
    if kind == props::K_TOGGLE {
        if code == sys::bn_clicked() { return fire_toggle(ctl, n); }
        return false;
    }
    if kind == props::K_TEXT_FIELD {
        if code == sys::en_change() { return fire_text_changed(ctl, n); }
        return false;
    }
    if kind == props::K_TEXT_AREA {
        if code == sys::en_change() { return fire_text_area_changed(ctl, n); }
        return false;
    }
    if kind == props::K_SEARCH_FIELD {
        if code == sys::en_change() { return fire_search_changed(ctl, n); }
        return false;
    }
    if kind == props::K_RADIO {
        if code == sys::bn_clicked() { return fire_radio(ctl, n); }
        return false;
    }
    if kind == props::K_POPUP {
        // The list DROPPING and CLOSING are the popup's open/close edges. A
        // combo box reports both, so these need no state of their own.
        if code == cbn_dropdown() { return fire_popup_edge(ctl, n, true); }
        if code == cbn_closeup() { return fire_popup_edge(ctl, n, false); }
        if code == sys::cbn_selchange() { return fire_popup(ctl, n); }
        return false;
    }
    return false;
}

fn fire_button(v: *u8, n: *core::Node) -> bool {
    let p: *props::ButtonProps =
        controls::props_of(n, props::K_BUTTON) as *props::ButtonProps;
    if p == (0 as *props::ButtonProps) { return false; }
    let h: fn(*u8, *u8) = { (*p).on_click };
    if h == props::no_handler { return false; }
    h(v, { (*p).on_click_ctx });
    return true;
}

// THE CONTROL ALREADY FLIPPED ITSELF. `BS_AUTOCHECKBOX` tracks its own state
// on the click, which is why it is the style `controls` uses — so the node is
// brought up to what the control now SHOWS before the handler runs, or an
// application reading `checkbox.on()` from inside its own handler sees the
// value from before the click.
fn fire_checkbox(v: *u8, n: *core::Node) -> bool {
    let p: *props::CheckboxProps =
        controls::props_of(n, props::K_CHECKBOX) as *props::CheckboxProps;
    if p == (0 as *props::CheckboxProps) { return false; }
    { (*p).on = controls::is_checked(v) };
    let h: fn(*u8, *u8) = { (*p).on_checked_changed };
    if h == props::no_handler { return false; }
    h(v, { (*p).on_checked_changed_ctx });
    return true;
}

fn fire_toggle(v: *u8, n: *core::Node) -> bool {
    let p: *props::ToggleProps =
        controls::props_of(n, props::K_TOGGLE) as *props::ToggleProps;
    if p == (0 as *props::ToggleProps) { return false; }
    // THE NODE IS THE STATE. An owner-drawn switch keeps no check state of its
    // own — see `controls::create_toggle` for why it is owner-drawn — so the
    // click inverts the node and the control repaints from it.
    let _now: bool = controls::flip_toggle(v, p);
    let h: fn(*u8, *u8) = { (*p).on_toggled };
    if h == props::no_handler { return false; }
    h(v, { (*p).on_toggled_ctx });
    return true;
}

// THE EDIT OWNS THE STRING WHILE IT IS BEING TYPED IN, so the node is brought
// up to what the control holds before the handler runs — the same direction as
// the checkbox above, and the reason `controls::apply_text_field` refuses to
// write a focused field. Both halves are needed or the two truths drift within
// one keystroke.
fn fire_text_changed(v: *u8, n: *core::Node) -> bool {
    let p: *props::TextFieldProps =
        controls::props_of(n, props::K_TEXT_FIELD) as *props::TextFieldProps;
    if p == (0 as *props::TextFieldProps) { return false; }
    { (*p).input_view.text = window_text(v) };
    let h: fn(*u8, *u8) = { (*p).input_view.on_text_changed };
    if h == props::no_handler { return false; }
    h(v, { (*p).input_view.on_text_changed_ctx });
    return true;
}


// ---- WM_HSCROLL / WM_VSCROLL -------------------------------------------------------
//
// A TRACKBAR DOES NOT SEND WM_COMMAND. It reports through the scroll messages,
// on the axis it was created with, with the sending control in lParam — which
// is why the trackbar's half of the read surface is a separate door from every
// other control's.
//
// The notification CODE in the low word says what the user did: dragging is a
// run of `TB_THUMBTRACK`, and letting go is `TB_THUMBPOSITION` or `TB_ENDTRACK`.
// facet wants both — `on_value_changed` while it moves, `on_drag_completed`
// when it stops — so the code is read rather than ignored.
fn tb_thumbtrack() -> u32 { return 5 as u32; }
fn tb_thumbposition() -> u32 { return 4 as u32; }
fn tb_endtrack() -> u32 { return 8 as u32; }

// Which trackbar is mid-drag, so `on_drag_started` fires on the edge rather
// than on every tracking message. One slider at a time is the whole of what a
// pointer can do.
static DRAGGING: usize = 0;

fn on_scroll(ctl: *u8, code: u32) -> bool {
    if ctl == (0 as *u8) { return false; }
    let n: *core::Node = node_of_window(ctl);
    if n == (0 as *core::Node) { return false; }
    if takes_no_input(n) { return false; }
    // A LIST SCROLLS ITSELF. Its viewport carries WS_VSCROLL, so the same
    // message family that reports a trackbar reports a scroll bar — told apart
    // by the kind of the node the sending window belongs to.
    if recycler::holds_rows(n) { return recycler::on_vscroll(ctl, n, code); }
    if core::kind_of(n) != props::K_SLIDER { return false; }
    let p: *props::SliderProps =
        controls::props_of(n, props::K_SLIDER) as *props::SliderProps;
    if p == (0 as *props::SliderProps) { return false; }

    // THE CONTROL'S POSITION IS THE TRUTH, not the message. `TB_ENDTRACK`
    // carries no position at all, and reading one out of wParam's high word
    // would answer zero on exactly the message that says the drag finished.
    let pos: i32 = { u::SendMessageA(ctl, sys::tbm_getpos(), 0 as u64, 0 as i64) } as i32;
    let value: f64 = controls::slider_value_of(pos, { (*p).minimum }, { (*p).maximum });
    { (*p).value = value };

    if code == tb_thumbtrack() || code == tb_thumbposition() {
        // THE FIRST TRACK MESSAGE IS THE DRAG STARTING. A trackbar has no
        // "drag began" code — it sends TB_THUMBTRACK continuously — so the
        // edge is the transition into tracking, and TB_ENDTRACK below clears
        // it. Without the flag `on_drag_started` would fire on every pixel.
        if DRAGGING != { #addr(ctl) } {
            DRAGGING = { #addr(ctl) };
            let s: fn(*u8, *u8) = { (*p).on_drag_started };
            if s != props::no_handler { s(ctl, { (*p).on_drag_started_ctx }); }
        }
        let h: fn(*u8, *u8) = { (*p).on_value_changed };
        if h != props::no_handler { h(ctl, { (*p).on_value_changed_ctx }); }
        return true;
    }
    if code == tb_endtrack() {
        DRAGGING = 0 as usize;
        // The value went out on the track messages already; this one is the
        // "let go" edge and nothing else.
        let h: fn(*u8, *u8) = { (*p).on_drag_completed };
        if h != props::no_handler { h(ctl, { (*p).on_drag_completed_ctx }); }
        return true;
    }
    // Every other code — a line or page step from an arrow key or a click on
    // the track — is still a value change.
    let h: fn(*u8, *u8) = { (*p).on_value_changed };
    if h != props::no_handler { h(ctl, { (*p).on_value_changed_ctx }); }
    return true;
}

// ---- the popup's selection -----------------------------------------------------------

fn fire_popup(v: *u8, n: *core::Node) -> bool {
    let p: *props::PopupProps =
        controls::props_of(n, props::K_POPUP) as *props::PopupProps;
    if p == (0 as *props::PopupProps) { return false; }
    // The control already changed its selection; the node is brought up to what
    // it now SHOWS before the handler runs, so an application reading
    // `selected_index` from inside its own handler sees the new one.
    { (*p).selected_index = controls::combo_selection(v) };
    let h: fn(*u8, *u8) = { (*p).on_selected_index_changed };
    if h == props::no_handler { return false; }
    h(v, { (*p).on_selected_index_changed_ctx });
    return true;
}

// ---- the radio group -------------------------------------------------------------------
//
// EXCLUSION IS OURS, NOT WIN32'S. `BS_AUTORADIOBUTTON` clears the other buttons
// in the same WS_GROUP run — adjacent siblings — and facet groups by NAME, which
// need not follow the child order at all. So the platform's grouping is left
// alone and the group is cleared here, by walking the window's tree for radios
// carrying the same `group`.
//
// Relying on adjacency would give the right answer whenever a designer happened
// to put a group's members next to each other and the wrong one the day they
// did not, which is the worst kind of bug: correct in every test anyone thought
// to write.
fn fire_radio(v: *u8, n: *core::Node) -> bool {
    let group: str = controls::radio_group_of(n);
    // The tree ROOT this radio belongs to. `mount::find_node` searches every
    // window in open order, which would reach a same-named group in a sheet
    // over the top — so the walk starts from this window's own root instead.
    let root: *core::Node = root_above(v);
    if root != (0 as *core::Node) { clear_group(root, group, n); }
    controls::set_radio_on(n, true);
    let p: *props::RadioProps =
        controls::props_of(n, props::K_RADIO) as *props::RadioProps;
    if p == (0 as *props::RadioProps) { return false; }
    let h: fn(*u8, *u8) = { (*p).on_checked_changed };
    if h == props::no_handler { return false; }
    h(v, { (*p).on_checked_changed_ctx });
    return true;
}

// The topmost node above `v` — the window's root, found by walking the HWND
// chain to the last window that carries one.
fn root_above(v: *u8) -> *core::Node {
    var cur: *u8 = v;
    var best: *core::Node = 0 as *core::Node;
    while cur != (0 as *u8) {
        let n: *core::Node = node_of_window(cur);
        if n != (0 as *core::Node) { best = n; }
        cur = { u::GetParent(cur) };
    }
    return best;
}

fn clear_group(n: *core::Node, group: str, except: *core::Node) {
    if n != except && core::kind_of(n) == props::K_RADIO {
        if controls::radio_group_of(n) == group { controls::set_radio_on(n, false); }
    }
    var i: usize = 0 as usize;
    let count: usize = core::child_count_of(n);
    while i < count {
        match core::child_of(n, i) {
            option::Option[*core::Node]::Some(c) => { clear_group(c, group, except); }
            option::Option[*core::Node]::None => { }
        }
        i = i +% (1 as usize);
    }
    return;
}

// ---- the editor's text ---------------------------------------------------------------

fn fire_text_area_changed(v: *u8, n: *core::Node) -> bool {
    let p: *props::TextAreaProps =
        controls::props_of(n, props::K_TEXT_AREA) as *props::TextAreaProps;
    if p == (0 as *props::TextAreaProps) { return false; }
    { (*p).input_view.text = window_text(v) };
    let h: fn(*u8, *u8) = { (*p).input_view.on_text_changed };
    if h == props::no_handler { return false; }
    h(v, { (*p).input_view.on_text_changed_ctx });
    return true;
}

fn fire_search_changed(v: *u8, n: *core::Node) -> bool {
    let p: *props::SearchFieldProps =
        controls::props_of(n, props::K_SEARCH_FIELD) as *props::SearchFieldProps;
    if p == (0 as *props::SearchFieldProps) { return false; }
    { (*p).input_view.text = window_text(v) };
    let h: fn(*u8, *u8) = { (*p).input_view.on_text_changed };
    if h == props::no_handler { return false; }
    h(v, { (*p).input_view.on_text_changed_ctx });
    return true;
}
// Read a window's text back out. Two calls — one for the length, one for the
// bytes — because there is no call that answers both, and guessing a buffer
// size is how a long line gets silently truncated.
//
// The buffer is malloc'd rather than borrowed from a `Text`: `GetWindowTextA`
// writes a NUL past the characters, so it needs one byte more than the length
// it just reported, and a Text's own buffer is not ours to write into.
extern fn malloc(n: usize) -> *u8;
extern fn free(p: *u8);

fn window_text(v: *u8) -> text::Text {
    let n: i32 = { u::GetWindowTextLengthA(v) };
    if n <= (0 as i32) { return text::from_str(""); }
    let buf: *u8 = { malloc((n as usize) +% (1 as usize)) };
    if buf.is_null() { return text::from_str(""); }
    let got: i32 = { u::GetWindowTextA(v, buf as *i8, n +% (1 as i32)) };
    var out: text::Text = text::from_str("");
    if got > (0 as i32) { out = { #str_from_raw_parts(buf, got as usize) }.to_text(); }
    { free(buf) };
    return out;
}


// ---- the pointer band ---------------------------------------------------------------
//
// A GESTURE LANDS ON A PANEL, which is this package's own window class, so the
// events arrive at `window::wnd_proc` as ordinary mouse messages and there is
// nothing to attach. That is the opposite of facet_gtk, where every band is a
// GtkGestureClick or a GtkEventControllerMotion added to the widget — and it is
// why `input::arm` here attaches nothing but the node binding.
//
// The consequence worth stating: a gesture on a SYSTEM CONTROL is not
// delivered. A BUTTON, an EDIT and a COMBOBOX each have their own WNDPROC and
// keep the mouse to themselves; the click that reaches us is the control's own
// notification, not a pointer event. facet's model already says a control's own
// verb is what an application should use there — `button(on_click:)` rather
// than `.gesture(on_click:)` on a button — so the gap is where the contract
// already points. MANIFEST.md §1 carries the row.
//
// A CLICK IS A PRESS AND A RELEASE ON THE SAME WINDOW, which is what the
// platform means by one too: `WM_LBUTTONUP` alone is not a click, because the
// press may have started somewhere else and been dragged in. The pressed window
// is tracked in one static — there is one mouse.

static PRESSED: usize = 0 as usize;
static HOVERED: usize = 0 as usize;

// TME_LEAVE. `TRACKMOUSEEVENT` is four fields and 24 bytes: cbSize, dwFlags,
// hwndTrack, dwHoverTime — no inline arrays, so it is laid out by hand for the
// reason the scroll info is.
fn tme_leave() -> u32 { return 0x00000002 as u32; }
fn tme_bytes() -> usize { return 24 as usize; }

// `TrackMouseEvent` is user32's; the allocator is the C runtime's and is already
// declared once in this module for `window_text`. Two declarations of `malloc`
// in one file is a redefinition, and inventing `tme_malloc` to dodge it would
// have linked against a symbol that does not exist.
extern fn TrackMouseEvent(p: *u8) -> i32;

// WM_MOUSELEAVE. Not in `sys` with the rest because it is this band's alone.
fn wm_mouseleave() -> u32 { return 0x02A3 as u32; }

fn ask_for_leave(v: *u8) {
    let p: *u8 = { malloc(tme_bytes()) };
    if p.is_null() { return; }
    let size: *u32 = { p as *u32 };
    { *size = tme_bytes() as u32 };
    let flags: *u32 = { (p + (4 as usize)) as *u32 };
    { *flags = tme_leave() };
    let track: *usize = { (p + (8 as usize)) as *usize };
    { *track = { #addr(v) } };
    let hover: *u32 = { (p + (16 as usize)) as *u32 };
    { *hover = 0 as u32 };
    let _r: i32 = { TrackMouseEvent(p) };
    { free(p) };
    return;
}

fn gestures_at(v: *u8) -> *gestures::Gestures {
    let n: *core::Node = node_at_or_above(v);
    if n == (0 as *core::Node) { return 0 as *gestures::Gestures; }
    if takes_no_input(n) { return 0 as *gestures::Gestures; }
    return gestures::gestures_of(n);
}

fn fire_of(v: *u8, h: gestures::Handler, ctx: *u8) -> bool {
    let n: *core::Node = node_at_or_above(v);
    if n == (0 as *core::Node) { return false; }
    if h == gestures::no_gesture { return false; }
    return gestures::fire(n, h, ctx);
}


// ---- the continuous band ------------------------------------------------------------
//
// Pan, swipe and long press are all DERIVED from the same three mouse messages
// the everyday band already receives — there is no recognizer to attach, the
// way GTK attaches a `GestureDrag`. So the state a recognizer would hold is
// held here: where the press started, whether it has moved, and whether a long
// press already fired.
//
// ONE MOUSE, ONE SET OF STATICS. A second pointer would need a table keyed by
// pointer id, which is `WM_POINTER` territory and a different input stack.

static PRESS_X: i32 = 0 as i32;
static PRESS_Y: i32 = 0 as i32;
static PRESS_MOVED: bool = false;
static LONG_FIRED: bool = false;

// The timer id a long press runs on. Distinct from the scheduler's, which lives
// on its own message-only window — this one is set on the PRESSED window, so it
// arrives at the same WNDPROC as the mouse messages it belongs with.
fn long_press_timer() -> u64 { return 0xFACE7 as u64; }

// lParam carries the cursor in CLIENT coordinates as two signed 16-bit halves.
// Signed: a drag above or left of the window is negative, and reading the halves
// unsigned turns -1 into 65535 — a pan that reports a jump of sixty thousand
// points the moment the pointer leaves the top edge.
fn lo_word(l: i64) -> i32 {
    var v: i32 = (l & (0xFFFF as i64)) as i32;
    if v > (32767 as i32) { v = v -% (65536 as i32); }
    return v;
}

fn hi_word(l: i64) -> i32 {
    var v: i32 = ((l >> (16 as i64)) & (0xFFFF as i64)) as i32;
    if v > (32767 as i32) { v = v -% (65536 as i32); }
    return v;
}

fn dist(ax: i32, ay: i32, bx: i32, by: i32) -> f64 {
    let dx: f64 = (ax -% bx) as f64;
    let dy: f64 = (ay -% by) as f64;
    return sqrt_of(dx * dx + dy * dy);
}

#[link_name = "sqrt"]
extern fn sqrt_of(v: f64) -> f64;

// THE DRAG SLOP. A press is not a pan until the pointer has actually moved:
// every click jitters a pixel or two between down and up, and firing `on_pan`
// for that turns every click into a drag. `SM_CXDRAG` (68) is the platform's
// own answer to "how far is not a click", which is what a double-click
// tolerance is on the other axis of the same question.
fn drag_slop() -> f64 {
    let m: i32 = { u::GetSystemMetrics(68 as i32) };
    if m <= (0 as i32) { return 4.0f64; }
    return m as f64;
}

fn begin_press(v: *u8, gs: *gestures::Gestures, l: i64) {
    PRESS_X = lo_word(l);
    PRESS_Y = hi_word(l);
    PRESS_MOVED = false;
    LONG_FIRED = false;
    // ARMED ONLY IF SOMETHING IS LISTENING. A timer set on every press of every
    // panel is a message per press per node for a handler that does not exist.
    if { (*gs).on_long_press } != gestures::no_gesture {
        var secs: f64 = { (*gs).long_press_seconds };
        if secs <= (0.0 as f64) { secs = 0.5f64; }
        let _t: u64 = { u::SetTimer(v, long_press_timer(),
                                    (secs * (1000.0 as f64)) as u32, 0 as *u8) };
    }
    return;
}

fn end_press(v: *u8) {
    let _k: i32 = { u::KillTimer(v, long_press_timer()) };
    return;
}

// The long-press timer fired. Called from the WNDPROC, which is where WM_TIMER
// on a panel arrives.
fn on_long_press_timer(v: *u8) -> bool {
    let _k: i32 = { u::KillTimer(v, long_press_timer()) };
    // STILL DOWN, AND STILL HERE. The timer outlives a release that happened
    // before it fired — killing it on the way up is a race, not a guarantee,
    // because the message may already be queued.
    if PRESSED != { #addr(v) } { return false; }
    // A press that turned into a drag is not a long press. This is the same
    // distinction a click makes and it is why `PRESS_MOVED` is tracked rather
    // than recomputed.
    if PRESS_MOVED { return false; }
    let gs: *gestures::Gestures = gestures_at(v);
    if gs == (0 as *gestures::Gestures) { return false; }
    LONG_FIRED = true;
    return fire_of(v, { (*gs).on_long_press }, { (*gs).on_long_press_ctx });
}

// Did this move cross the slop? Answers true once and stays true for the press,
// which is what makes `on_pan` fire continuously after it starts rather than
// only while beyond the threshold.
fn note_move(l: i64) -> bool {
    if PRESS_MOVED { return true; }
    if dist(lo_word(l), hi_word(l), PRESS_X, PRESS_Y) < drag_slop() { return false; }
    PRESS_MOVED = true;
    return true;
}

// A release far enough from where it began, in the direction it went. facet's
// `swipe_threshold` is the distance; the DIRECTION is read by the application
// off the node, so this only has to decide that one happened.
fn is_swipe(gs: *gestures::Gestures, l: i64) -> bool {
    var threshold: f64 = { (*gs).swipe_threshold };
    if threshold <= (0.0 as f64) { threshold = 100.0f64; }
    return dist(lo_word(l), hi_word(l), PRESS_X, PRESS_Y) >= threshold;
}
// Route one mouse message. Answers true when facet took it, so the WNDPROC
// knows whether to pass it to DefWindowProc.
fn on_mouse(v: *u8, msg: u32, w: u64, l: i64) -> bool {
    // A TAB IS NOT A CONTROL HERE — the strip is painted into the panel, so
    // there is no child window to send a notification and the click has to be
    // hit-tested. This runs BEFORE the gestures guard below: a tabs node
    // usually carries no gesture handlers at all, and returning early on that
    // would make its tabs unclickable.
    if msg == sys::wm_lbuttondown() {
        if fire_tab_click(v, lo_word(l), hi_word(l)) { return true; }
        // A DIVIDER GRAB CAPTURES THE MOUSE. Without it a drag that leaves the
        // panel — which is most of them, since the pointer is heading for the
        // edge — stops reporting, and the divider sticks halfway.
        if begin_divider_drag(v, lo_word(l), hi_word(l)) { return true; }
        // A PRESS ON A ROW may be the start of a reorder. It does not consume
        // the press — a drag that never moves is still a click, and the
        // selection has to happen on release exactly as it did before.
        let _r: bool = begin_row_reorder(v, hi_word(l));
    }
    if recycler::reorder_active() {
        if msg == sys::wm_mousemove() {
            let _d: bool = recycler::drag_reorder(v, screen_y(v, hi_word(l)));
        }
        if msg == sys::wm_lbuttonup() {
            if end_row_reorder(v, hi_word(l)) { return true; }
        }
    }
    if DRAG_SPLIT != (0 as usize) {
        if msg == sys::wm_mousemove() {
            if drag_divider(v, lo_word(l), hi_word(l)) { return true; }
        }
        if msg == sys::wm_lbuttonup() { end_divider_drag(); return true; }
    }
    // A CANVAS DECLARES ITS OWN POINTER BAND rather than using the shared
    // gesture one — `GraphicsView`'s seven interaction verbs are the kind's,
    // not the band's. So it is read here, before the gestures guard: a canvas
    // that carries no `.gesture()` at all still has every one of them.
    let canvas: bool = fire_canvas(v, msg, l);
    let gs: *gestures::Gestures = gestures_at(v);
    if gs == (0 as *gestures::Gestures) { return canvas; }

    if msg == sys::wm_lbuttondown() {
        PRESSED = { #addr(v) };
        begin_press(v, gs, l);
        // THE MOUSE IS CAPTURED so the matching release is ours even if the
        // pointer left the window on the way up. Without it, pressing a card
        // and releasing one pixel outside it fires nothing — and the press
        // handler has already run, so the application is left mid-gesture.
        let _c: *u8 = { u::SetCapture(v) };
        return fire_of(v, { (*gs).on_press }, { (*gs).on_press_ctx });
    }

    if msg == sys::wm_lbuttonup() {
        let was: usize = PRESSED;
        PRESSED = 0 as usize;
        end_press(v);
        if { u::GetCapture() } == v { let _r: i32 = { u::ReleaseCapture() }; }
        var took: bool = fire_of(v, { (*gs).on_release }, { (*gs).on_release_ctx });
        if was == { #addr(v) } {
            // A SWIPE IS A RELEASE FAR FROM ITS PRESS, and it consumes the
            // click: a gesture that ended somewhere else was never a click on
            // anything.
            if PRESS_MOVED && is_swipe(gs, l) {
                if fire_of(v, { (*gs).on_swipe }, { (*gs).on_swipe_ctx }) {
                    return true;
                }
            }
            // A CLICK ONLY IF THE PRESS STARTED HERE, did not become a drag,
            // and was not already answered as a long press. Firing both is how
            // a long press on a card also opens whatever a tap opens.
            if !PRESS_MOVED && !LONG_FIRED {
                if fire_of(v, { (*gs).on_click }, { (*gs).on_click_ctx }) { took = true; }
            }
        }
        return took;
    }

    if msg == sys::wm_lbuttondblclk() {
        // The class carries CS_DBLCLKS, so Windows sends this INSTEAD of the
        // second WM_LBUTTONDOWN — a node with only `on_click` would otherwise
        // see one click where the user made two. So a double click fires the
        // double handler and, when there is none, the single one.
        if fire_of(v, { (*gs).on_double_click }, { (*gs).on_double_click_ctx }) {
            return true;
        }
        return fire_of(v, { (*gs).on_click }, { (*gs).on_click_ctx });
    }

    if msg == sys::wm_rbuttonup() {
        // THE CONTEXT MENU FIRST, and it takes the event when there is one. A
        // node that declared both a `context_menu` and an `on_right_click`
        // meant the menu — the handler is what a node says when it has no menu
        // to show.
        let n: *core::Node = node_at_or_above(v);
        if n != (0 as *core::Node) {
            if menus::has_context_menu(n) {
                if menus::show_context_menu(v, n) { return true; }
                // Dismissed without choosing. Still ours: the menu was shown,
                // and letting the right-click fall through to a handler after
                // the user cancelled would fire it for a gesture they undid.
                return true;
            }
        }
        return fire_of(v, { (*gs).on_right_click }, { (*gs).on_right_click_ctx });
    }

    if msg == sys::wm_mousemove() {
        var took: bool = false;
        if HOVERED != { #addr(v) } {
            // ENTERING. Windows has no "mouse entered" message — the first move
            // inside a window is it — and no "left" either unless it is asked
            // for, which is what `TrackMouseEvent` does, once per entry.
            HOVERED = { #addr(v) };
            ask_for_leave(v);
            if fire_of(v, { (*gs).on_hover }, { (*gs).on_hover_ctx }) { took = true; }
        }
        if fire_of(v, { (*gs).on_pointer_move }, { (*gs).on_pointer_move_ctx }) {
            took = true;
        }
        // A PAN IS A MOVE WITH THE BUTTON DOWN, past the slop. The button state
        // is `PRESSED` rather than `wParam`, because a move that began outside
        // this window is not this window's pan even while the button is held.
        if PRESSED == { #addr(v) } {
            if note_move(l) {
                if fire_of(v, { (*gs).on_pan }, { (*gs).on_pan_ctx }) { took = true; }
            }
        }
        return took;
    }

    if msg == wm_mouseleave() {
        HOVERED = 0 as usize;
        return fire_of(v, { (*gs).on_unhover }, { (*gs).on_unhover_ctx });
    }

    return false;
}


// ---- the wheel -------------------------------------------------------------------
//
// WM_MOUSEWHEEL DOES NOT GO TO THE WINDOW UNDER THE POINTER. It goes to the
// window with keyboard FOCUS, which for a list nobody has clicked in is some
// other control entirely — or the top-level window, which is where it lands
// when nothing inside has focus.
//
// (Windows 10 added a shell setting that forwards the wheel to the hovered
// window instead. It is on by default and it is a SETTING: an application that
// relied on it would scroll for most users and not for the rest, which is worse
// than not scrolling for anyone because it cannot be reproduced.)
//
// So the wheel is hit-tested. `WindowFromPoint` on the cursor gives the window
// actually under it, and the walk goes UP from there to the first thing that
// can scroll — which is how a wheel over a row inside a list scrolls the list
// rather than nothing.
//
// WHEEL_DELTA is 120 and a notch is one of them; the value is SIGNED and
// arrives in the high word of wParam, so it has to come out as an i16 before it
// is widened or every scroll up reads as a very large scroll down.
fn wheel_delta() -> i32 { return 120 as i32; }

// Three rows a notch, which is the shell's own default for a list. Windows
// exposes the user's setting through `SystemParametersInfo(SPI_GETWHEELSCROLLLINES)`
// and this does not read it yet — MANIFEST.md §2 carries the row.
fn wheel_lines() -> i32 { return 3 as i32; }

fn notches_of(w: u64) -> i32 {
    let hi: u32 = ((w >> (16 as u64)) & (0xFFFF as u64)) as u32;
    // SIGNED. The high word is an i16; widening it unsigned turns every scroll
    // up (-120) into 65416, which is a scroll down of five hundred notches.
    var d: i32 = hi as i32;
    if d > (32767 as i32) { d = d -% (65536 as i32); }
    return d / wheel_delta();
}

// The nearest scrollable window at or above `v`. A list is the only kind that
// scrolls itself so far; a `scroll` will join it when its extent lands.
// THE NEAREST ANCESTOR THAT SCROLLS, which is either a row source or a
// carousel. Whichever is found FIRST wins — a carousel of lists and a list of
// carousels both behave the way the pointer says, because the search starts at
// the window under it and walks outward.
fn scrollable_above(v: *u8) -> *u8 {
    var cur: *u8 = v;
    while cur != (0 as *u8) {
        let n: *core::Node = node_of_window(cur);
        if n != (0 as *core::Node) {
            if recycler::holds_rows(n) { return cur; }
            if core::kind_of(n) == props::K_CAROUSEL { return cur; }
        }
        cur = { u::GetParent(cur) };
    }
    return 0 as *u8;
}

// `l` carries the cursor in SCREEN coordinates — unlike every other mouse
// message, whose position is client-relative. `WindowFromPoint` wants screen
// coordinates, so this one is already in the right space and converting it
// would be the bug.
fn on_wheel(w: u64, l: i64) -> bool {
    let x: i32 = (l & (0xFFFF as i64)) as i32;
    let y: i32 = ((l >> (16 as i64)) & (0xFFFF as i64)) as i32;
    var px: i32 = x;
    var py: i32 = y;
    if px > (32767 as i32) { px = px -% (65536 as i32); }
    if py > (32767 as i32) { py = py -% (65536 as i32); }
    let under: *u8 = { u::WindowFromPoint(point_of(px, py)) };
    if under == (0 as *u8) { return false; }
    let host: *u8 = scrollable_above(under);
    if host == (0 as *u8) { return false; }
    let n: *core::Node = node_of_window(host);
    if n == (0 as *core::Node) { return false; }
    let notches: i32 = notches_of(w);
    if notches == (0 as i32) { return false; }
    // A CAROUSEL STEPS BY PAGES, not by lines — one notch is one item, which is
    // what makes it a carousel rather than a scroll view. It answers false at
    // its ends when it does not wrap, so the wheel falls through to whatever is
    // behind instead of being swallowed by something that has stopped moving.
    if core::kind_of(n) == props::K_CAROUSEL {
        return controls::carousel_step(host, n, (0 as i64) -% (notches as i64));
    }
    // A POSITIVE delta is a scroll AWAY from the user, which is scrolling UP —
    // towards row zero. The sign flip is the whole of the mapping and getting
    // it wrong is a list that scrolls the wrong way, which reads as broken
    // rather than inverted.
    return recycler::scroll_by(host, n,
                               (0.0f64 - (notches as f64)) * (wheel_lines() as f64));
}

fn point_of(x: i32, y: i32) -> u::tagPOINT {
    return u::tagPOINT { x: x, y: y };
}
// ---- the focus band -------------------------------------------------------------------
//
// `on_focus` and `on_blur` are SHARED BAND — every node may carry them, gesture
// set or not — which is why `views::wants_view` asks `core::wants_focus_events`
// separately and why `rearm_bits` carries `C_HANDLERS`. facet_gtk records
// shipping without that second bit: a node that mounted with no focus handler
// and gained one later was never re-armed, and the handler could not fire for
// the life of the node.
fn on_focus_change(v: *u8, gained: bool) -> bool {
    let n: *core::Node = node_at_or_above(v);
    if n == (0 as *core::Node) { return false; }
    let d: *core::Data = core::node_data(n);
    if d == (0 as *core::Data) { return false; }
    if gained {
        let f: fn(*u8, *u8) = { (*d).common.on_focus };
        if f == (0 as fn(*u8, *u8)) || f == props::no_handler { return false; }
        f(v, { (*d).common.on_focus_ctx });
        return true;
    }
    let b: fn(*u8, *u8) = { (*d).common.on_blur };
    if b == (0 as fn(*u8, *u8)) || b == props::no_handler { return false; }
    b(v, { (*d).common.on_blur_ctx });
    return true;
}

// ---- the key band -----------------------------------------------------------------------
//
// `on_key` fires on the FOCUSED element, which on Win32 is whatever window has
// the keyboard focus — so the message arrives at that window's WNDPROC and the
// node is found the same way every other event's is.
//
// The event handed to the readers is the VIRTUAL-KEY CODE ITSELF, cast to a
// pointer. A Win32 key message carries no event object to point at: the whole
// event is (message, wParam, lParam), and wParam is the only part a facet key
// band reads. `key_code` unpacks it and `key_named` maps it; `key_chars`
// answers empty and says why.
fn on_key(v: *u8, vk: u64) -> bool {
    let n: *core::Node = node_at_or_above(v);
    if n == (0 as *core::Node) { return false; }
    if takes_no_input(n) { return false; }
    // F5 IS WHAT A WINDOWS APPLICATION MEANS BY REFRESH, and it is the whole
    // of the refresh gesture here: pull-to-refresh is a TOUCH gesture and a
    // mouse cannot make it — there is no overscroll to pull against, and a
    // wheel past the top is the end of the list rather than a gesture.
    // `is_refreshable` and `can_refresh` gate it; MANIFEST §1.
    if vk == vk_f5() {
        if recycler::holds_rows(n) {
            if recycler::refresh_requested(v, n) { return true; }
        }
        // `refreshable` is the same gesture on a kind that WRAPS content
        // rather than holding rows — a RefreshView around anything. It has no
        // recycler, so it is answered here directly.
        if fire_refreshable(v, n) { return true; }
    }
    // The event is a struct this package defines and facet only ever hands
    // back to the readers below. A stack local is enough: `fire_key` is
    // synchronous and the handler has returned before this frame goes.
    var ev: KeyEvent = KeyEvent { vk: vk as u32 };
    return gestures::fire_key(n, #addr_of(ev) as *u8);
}
// ---- the sender readers -------------------------------------------------------
//
// PARTIALLY FILLED, which is not the same as half-wired: `component::
// SenderReaders` declares a zero field as keeping facet's portable default, so
// the three drag-and-drop readers are left zero because there is no
// IDropTarget in this package yet. A zero reader answers "no backend told me";
// a filled one answering empty would be a lie. facet_gtk records the same
// division for the same reason.

fn key_of(sender: *u8) -> text::Text {
    let n: *core::Node = node_at_or_above(sender);
    if n == (0 as *core::Node) { return text::from_str(""); }
    return text::from_str({ (*n).key() });
}

// The ITEM SLOT of the nearest node, not the node itself.
//
// `component::item_index_of` reads what comes back as a packed index+1, so
// answering the node here made every row report an address as its row number —
// silently, and only in a list, which is the one place it matters.
//
// The walk goes UP because the sender is whatever was clicked: a label inside a
// row carries no item of its own, and the ROW is what was given one.
fn item_of(sender: *u8) -> *u8 {
    var cur: *u8 = sender;
    while cur != (0 as *u8) {
        let n: *core::Node = node_of_window(cur);
        if n != (0 as *core::Node) {
            let item: *u8 = core::item_of(n);
            if item != (0 as *u8) { return item; }
        }
        cur = { u::GetParent(cur) };
    }
    return 0 as *u8;
}

// Bring the keyed node to the front of its siblings. Z-order IS the child order
// here — `views::insert` sets it and paint order follows it — so `raise` is the
// same mechanism as an insert at the end, said in one call.
fn raise(sender: *u8, key: str) {
    let n: *core::Node = node_at_or_above(sender);
    if n == (0 as *core::Node) { return; }
    match core::find_in(n, key) {
        option::Option[*core::Node]::Some(t) => {
            let v: *u8 = core::view_of(t);
            if v == (0 as *u8) { return; }
            let flags: u32 = sys::swp_nomove() | sys::swp_nosize()
                           | sys::swp_noactivate();
            let _r: i32 = { u::SetWindowPos(v, sys::hwnd_top(), 0 as i32, 0 as i32,
                                            0 as i32, 0 as i32, flags) };
        }
        option::Option[*core::Node]::None => { }
    }
    return;
}

fn sender_readers() -> component::SenderReaders {
    return component::SenderReaders {
        raise: raise,
        key_of: key_of,
        item_of: item_of,
        // The drop half is answered — see `dnd`. The SOURCE half is not, and
        // that is a different absence with a different reason (COM), recorded
        // in MANIFEST §2 rather than left as a zero here.
        dropped_text: dnd::dropped_text,
        drop_position: dnd::drop_position,
        drag_targeted: dnd::drag_targeted,
    };
}

// ---- the key reader -----------------------------------------------------------
//
// A key event reaches a handler as an opaque `*u8`; these four read it. This
// package passes the VIRTUAL-KEY CODE itself as that pointer, because a Win32
// key message carries no event object to point at — the whole event is
// (message, wParam, lParam), and wParam is the only part a facet key band
// needs.

// THE EVENT IS A STRUCT this package defines and facet only ever hands back to
// these four readers. A Win32 key message carries no event object to point at —
// the whole event is (message, wParam, lParam) — so the struct is what carries
// wParam across `fire_key`.
struct KeyEvent { vk: u32 }

fn ev_of(e: *u8) -> *KeyEvent { return e as *KeyEvent; }

// The platform key code, raw and non-portable by contract — the VIRTUAL-KEY
// code, which is Win32's counterpart to AppKit's `keyCode` and GTK's hardware
// keycode. An app that wants a portable answer asks `key_named`.
fn key_code(e: *u8) -> i64 {
    if e == (0 as *u8) { return (0 as i64) -% (1 as i64); }
    return { (*ev_of(e)).vk } as i64;
}

fn key_chars(e: *u8) -> text::Text {
    // The character a key produces is WM_CHAR's business, not WM_KEYDOWN's —
    // they are different messages and only the first has been through the
    // keyboard layout. Answering from a virtual-key code here would be
    // guessing at a layout, so this is empty and MANIFEST.md §2 carries the
    // row: the key band reports the KEY, and text arrives through the field.
    return text::from_str("");
}

// `GetKeyState`'s high bit is "down now". The 0x8000 mask is built
// arithmetically: an integer literal wraps through i32 before `as`, which is
// the language gotcha this repo's skill file warns about.
fn modifier_down(vk: i32) -> bool {
    let s: i32 = { u::GetKeyState(vk) } as i32;
    return (s & (0 -% (32768 as i32))) != (0 as i32);
}

fn key_modifiers(e: *u8) -> u64 {
    var m: u64 = 0 as u64;
    if modifier_down(0x10 as i32) { m = m | gestures::mod_shift(); }     // VK_SHIFT
    if modifier_down(0x11 as i32) { m = m | gestures::mod_control(); }   // VK_CONTROL
    if modifier_down(0x12 as i32) { m = m | gestures::mod_option(); }       // VK_MENU — facet calls this modifier `option`, Apple's name for it
    if modifier_down(0x5B as i32) { m = m | gestures::mod_command(); }   // VK_LWIN
    return m;
}

// facet's NAMED keys, from the virtual-key codes. The named set is small and
// the mapping is exact, which is why this one is answered where `chars` is not.
fn key_named(e: *u8) -> i64 {
    let vk: i64 = key_code(e);
    if vk == (0x0D as i64) { return gestures::key_return(); }
    if vk == (0x1B as i64) { return gestures::key_escape(); }
    if vk == (0x09 as i64) { return gestures::key_tab(); }
    if vk == (0x08 as i64) { return gestures::key_delete(); }
    if vk == (0x20 as i64) { return gestures::key_space(); }
    if vk == (0x25 as i64) { return gestures::key_arrow_left(); }
    if vk == (0x26 as i64) { return gestures::key_arrow_up(); }
    if vk == (0x27 as i64) { return gestures::key_arrow_right(); }
    if vk == (0x28 as i64) { return gestures::key_arrow_down(); }
    if vk == (0x24 as i64) { return gestures::key_home(); }
    if vk == (0x23 as i64) { return gestures::key_end(); }
    return gestures::key_none();
}

fn vk_f5() -> u64 { return 0x74 as u64; }

fn fire_refreshable(v: *u8, n: *core::Node) -> bool {
    let p: *props::RefreshableProps =
        controls::props_of(n, props::K_REFRESHABLE) as *props::RefreshableProps;
    if p == (0 as *props::RefreshableProps) { return false; }
    if !{ (*p).is_refreshable } { return false; }
    // THE STATE IS WRITTEN BEFORE THE HANDLER RUNS, so a handler that reads
    // `is_refreshing` to decide whether to start work sees true — the same
    // order `recycler::set_refreshing` uses.
    { (*p).is_refreshing = true };
    core::touch(n, refreshable::P_IS_REFRESHING);
    let h: fn(*u8, *u8) = { (*p).on_refreshing };
    if h == props::no_handler { return true; }
    h(v, { (*p).on_refreshing_ctx });
    return true;
}

fn key_reader() -> gestures::KeyReader {
    return gestures::KeyReader {
        code: key_code,
        chars: key_chars,
        modifiers: key_modifiers,
        named: key_named,
    };
}

fn install() {
    gestures::install_key_reader(key_reader());
    component::install_sender_readers(sender_readers());
    return;
}

fn uninstall() {
    gestures::uninstall_key_reader();
    component::uninstall_sender_readers();
    return;
}

// ---- pinch, as a desktop user performs it ------------------------------------------
//
// A MOUSE CANNOT PINCH. The gesture facet names is a two-finger one, and on a
// desktop the thing users actually do to zoom is CTRL-WHEEL — every browser,
// editor and viewer on the platform. So `on_pinch` is answered by that rather
// than left unfired waiting for a touchscreen, and a node asking for pinch gets
// the interaction its users will attempt.
//
// A real touch pinch arrives as WM_GESTURE (or WM_POINTER on newer input
// stacks) and is a different door; MANIFEST.md §2 carries the row.
//
// MK_CONTROL is 0x0008 in the wheel's key-state word.
fn mk_control() -> u64 { return 0x0008 as u64; }

fn on_pinch_wheel(w: u64, l: i64) -> bool {
    if (w & mk_control()) == (0 as u64) { return false; }
    // Screen coordinates, like every wheel message — see `on_wheel`.
    var px: i32 = (l & (0xFFFF as i64)) as i32;
    var py: i32 = ((l >> (16 as i64)) & (0xFFFF as i64)) as i32;
    if px > (32767 as i32) { px = px -% (65536 as i32); }
    if py > (32767 as i32) { py = py -% (65536 as i32); }
    let under: *u8 = { u::WindowFromPoint(point_of(px, py)) };
    if under == (0 as *u8) { return false; }
    let gs: *gestures::Gestures = gestures_at(under);
    if gs == (0 as *gestures::Gestures) { return false; }
    return fire_of(under, { (*gs).on_pinch }, { (*gs).on_pinch_ctx });
}

// ---- WM_NOTIFY -----------------------------------------------------------------------
//
// THE THIRD DOOR a control reports through, and the one the COMMON controls use.
//
// A BUTTON or an EDIT sends WM_COMMAND; a trackbar sends WM_HSCROLL; everything
// comctl32 added since — the tab control, the up-down, the list view, the date
// picker — sends WM_NOTIFY instead. Three doors for one idea, which is Win32's
// history rather than a design, and a backend has to answer all three.
//
// NMHDR is the common prefix of every notification: the sending window, its
// control id, and the code. Laid out by hand — three pointer-sized fields:
//
//   0   hwndFrom  HWND
//   8   idFrom    UINT_PTR
//   16  code      UINT
fn nmhdr_off_hwnd() -> usize { return 0 as usize; }
fn nmhdr_off_code() -> usize { return 16 as usize; }

// TCN_SELCHANGE is -551, UDN_DELTAPOS is -722, DTN_DATETIMECHANGE is -759.
// Notification codes are NEGATIVE by convention — they are counted down from
// zero so that they cannot collide with a control's own messages — and they
// arrive as an unsigned word, so the comparison has to be done on the same
// width the message carries.
fn tcn_selchange() -> u32 { return (0 as u32) -% (551 as u32); }
fn udn_deltapos() -> u32 { return (0 as u32) -% (722 as u32); }
fn dtn_datetimechange() -> u32 { return (0 as u32) -% (759 as u32); }
// DTN_FIRST2 is -753 and the two edges count DOWN from it. They are NOT near
// the up-down control's codes above, which is worth stating because -721 and
// -722 look like plausible neighbours and are `UDN_FIRST` and `UDN_DELTAPOS` —
// the stepper's. Every one of these is a per-class number in a shared space,
// so a wrong constant matches another control's message rather than nothing.
fn dtn_closeup() -> u32 { return (0 as u32) -% (753 as u32); }
fn dtn_dropdown() -> u32 { return (0 as u32) -% (754 as u32); }

fn read_ptr(p: *u8, at: usize) -> *u8 {
    let q: *usize = { (p + at) } as *usize;
    return { *q } as *u8;
}

fn read_u32(p: *u8, at: usize) -> u32 {
    let q: *u32 = { (p + at) } as *u32;
    return { *q };
}

// NM_CUSTOMDRAW IS ANSWERED BY THE RETURN VALUE, not by a side effect — the
// control is asking who draws each part and reads the LRESULT to find out. So
// it cannot go through `on_notify`, whose whole contract is "handled or not".
// This is the separate door, consulted first, and it reports the LRESULT
// through `out`.
fn on_customdraw(nm: *u8, out: *i64) -> bool {
    if nm == (0 as *u8) { return false; }
    let ctl: *u8 = read_ptr(nm, nmhdr_off_hwnd());
    if ctl == (0 as *u8) { return false; }
    if (read_u32(nm, nmhdr_off_code()) as i32) != controls::nm_customdraw() {
        return false;
    }
    let n: *core::Node = node_of_window(ctl);
    if n == (0 as *core::Node) { return false; }
    if core::kind_of(n) != props::K_SLIDER { return false; }
    { *out = controls::slider_customdraw(ctl, nm) };
    return true;
}

fn on_notify(nm: *u8) -> bool {
    if nm == (0 as *u8) { return false; }
    let ctl: *u8 = read_ptr(nm, nmhdr_off_hwnd());
    if ctl == (0 as *u8) { return false; }
    let code: u32 = read_u32(nm, nmhdr_off_code());
    let n: *core::Node = node_of_window(ctl);
    if n == (0 as *core::Node) { return false; }
    if takes_no_input(n) { return false; }
    let kind: u32 = core::kind_of(n);
    if kind == props::K_STEPPER && code == udn_deltapos() { return fire_stepper(ctl, n); }
    if kind == props::K_DATE_PICKER {
        if code == dtn_datetimechange() { return fire_date_changed(ctl, n); }
        if code == dtn_dropdown() { return fire_date_edge(ctl, n, true); }
        if code == dtn_closeup() { return fire_date_edge(ctl, n, false); }
        return false;
    }
    if kind == props::K_TIME_PICKER && code == dtn_datetimechange() {
        return fire_time_changed(ctl, n);
    }
    return false;
}

// BN_PUSHED 5, BN_UNPUSHED 6 — the press and release edges of a button, sent
// only to a button carrying `BS_NOTIFY`.
fn bn_pushed() -> u32 { return 5 as u32; }
fn bn_unpushed() -> u32 { return 6 as u32; }
// CBN_DROPDOWN 7, CBN_CLOSEUP 8.
fn cbn_dropdown() -> u32 { return 7 as u32; }
fn cbn_closeup() -> u32 { return 8 as u32; }

fn fire_press(v: *u8, n: *core::Node, down: bool) -> bool {
    let p: *props::ButtonProps =
        controls::props_of(n, props::K_BUTTON) as *props::ButtonProps;
    if p == (0 as *props::ButtonProps) { return false; }
    let h: fn(*u8, *u8) = if down { { (*p).on_pressed } } else { { (*p).on_released } };
    let ctx: *u8 = if down { { (*p).on_pressed_ctx } } else { { (*p).on_released_ctx } };
    if h == props::no_handler { return false; }
    h(v, ctx);
    return true;
}

fn fire_icon_button(v: *u8, n: *core::Node) -> bool {
    let p: *props::IconButtonProps =
        controls::props_of(n, props::K_ICON_BUTTON) as *props::IconButtonProps;
    if p == (0 as *props::IconButtonProps) { return false; }
    // A TOGGLING ICON BUTTON KEEPS ITS OWN STATE. It is owner-drawn, so the
    // control has no check state to read — the node is the truth, the same
    // shape `controls::flip_toggle` uses.
    if { (*p).toggles } {
        { (*p).on = !{ (*p).on } };
        let _i: i32 = { u::InvalidateRect(v, 0 as *u::tagRECT, 1 as i32) };
    }
    let h: fn(*u8, *u8) = { (*p).on_clicked };
    if h == props::no_handler { return false; }
    h(v, { (*p).on_clicked_ctx });
    return true;
}

fn fire_icon_press(v: *u8, n: *core::Node, down: bool) -> bool {
    let p: *props::IconButtonProps =
        controls::props_of(n, props::K_ICON_BUTTON) as *props::IconButtonProps;
    if p == (0 as *props::IconButtonProps) { return false; }
    let h: fn(*u8, *u8) = if down { { (*p).on_pressed } } else { { (*p).on_released } };
    let ctx: *u8 = if down { { (*p).on_pressed_ctx } } else { { (*p).on_released_ctx } };
    if h == props::no_handler { return false; }
    h(v, ctx);
    return true;
}

fn fire_text_button(v: *u8, n: *core::Node) -> bool {
    let p: *text_button::TextButtonProps =
        controls::props_of(n, text_button::K_TEXT_BUTTON)
        as *text_button::TextButtonProps;
    if p == (0 as *text_button::TextButtonProps) { return false; }
    if { (*p).toggles } {
        { (*p).on = !{ (*p).on } };
        let _i: i32 = { u::InvalidateRect(v, 0 as *u::tagRECT, 1 as i32) };
    }
    let h: fn(*u8, *u8) = { (*p).on_click };
    if h == props::no_handler { return false; }
    h(v, { (*p).on_click_ctx });
    return true;
}

fn fire_popup_edge(v: *u8, n: *core::Node, opened: bool) -> bool {
    let p: *props::PopupProps =
        controls::props_of(n, props::K_POPUP) as *props::PopupProps;
    if p == (0 as *props::PopupProps) { return false; }
    // THE NODE IS BROUGHT UP TO THE CONTROL, the same direction every other
    // reader in this file runs — an application reading `is_open` after the
    // user opened the list by hand must see true.
    { (*p).is_open = opened };
    let h: fn(*u8, *u8) = if opened { { (*p).on_opened } } else { { (*p).on_closed } };
    let ctx: *u8 = if opened { { (*p).on_opened_ctx } } else { { (*p).on_closed_ctx } };
    if h == props::no_handler { return false; }
    h(v, ctx);
    return true;
}

// The canvas pointer band. Every one of these messages already reaches this
// package — a canvas is a panel and its window is ours — so the verbs cost a
// dispatch and no new plumbing.
//
//   WM_LBUTTONDOWN   on_press
//   WM_LBUTTONUP     on_release
//   WM_MOUSEMOVE     observe_drag_interaction while the button is down,
//                    observe_move_hover_interaction otherwise, and on_hover
//                    on the first move inside
//   WM_MOUSELEAVE    on_unhover
//   WM_CAPTURECHANGED on_cancel
//
// THE CANCEL EDGE IS CAPTURE BEING TAKEN AWAY, which is the honest Win32
// reading of "the interaction was interrupted": another window grabbed the
// pointer, or a modal came up mid-drag. There is no touch-cancel to map.
fn fire_canvas(v: *u8, msg: u32, l: i64) -> bool {
    let n: *core::Node = node_of_window(v);
    if n == (0 as *core::Node) { return false; }
    let p: *props::CanvasProps =
        controls::props_of(n, props::K_CANVAS) as *props::CanvasProps;
    if p == (0 as *props::CanvasProps) { return false; }
    if msg == sys::wm_lbuttondown() {
        return call(v, { (*p).on_press }, { (*p).on_press_ctx });
    }
    if msg == sys::wm_lbuttonup() {
        return call(v, { (*p).on_release }, { (*p).on_release_ctx });
    }
    if msg == wm_capturechanged() {
        return call(v, { (*p).on_cancel }, { (*p).on_cancel_ctx });
    }
    if msg == wm_mouseleave() {
        return call(v, { (*p).on_unhover }, { (*p).on_unhover_ctx });
    }
    if msg == sys::wm_mousemove() {
        var took: bool = false;
        // The first move inside is the ENTRY — Windows has no "mouse entered"
        // message. `on_mouse` arms `TrackMouseEvent` for the matching leave;
        // this rides the same flag rather than arming a second one.
        if HOVERED != { #addr(v) } {
            if call(v, { (*p).on_hover }, { (*p).on_hover_ctx }) { took = true; }
        }
        // A DRAG IS A MOVE WITH THE BUTTON DOWN AND A HOVER IS ONE WITHOUT, and
        // they are different verbs — reporting both for one move would have an
        // application drawing a stroke and a cursor highlight at once.
        if PRESSED == { #addr(v) } {
            if call(v, { (*p).observe_drag_interaction },
                    { (*p).observe_drag_interaction_ctx }) { took = true; }
        } else {
            if call(v, { (*p).observe_move_hover_interaction },
                    { (*p).observe_move_hover_interaction_ctx }) { took = true; }
        }
        return took;
    }
    return false;
}

fn wm_capturechanged() -> u32 { return 0x0215 as u32; }

fn call(v: *u8, h: fn(*u8, *u8), ctx: *u8) -> bool {
    if h == props::no_handler { return false; }
    h(v, ctx);
    return true;
}

// Which split is being dragged. One at a time is the whole of what a pointer
// can do, so a single slot rather than a per-window flag.
static DRAG_SPLIT: usize = 0;

// A press inside a reorderable collection. The ROW is resolved the same way a
// click is — `list_above` then the item slot — so a press on something nested
// inside a row still names the row.
fn begin_row_reorder(v: *u8, y: i32) -> bool {
    let host: *u8 = list_above(v);
    if host == (0 as *u8) || host == v { return false; }
    let n: *core::Node = node_of_window(host);
    if n == (0 as *core::Node) { return false; }
    return match component::item_index_of(v) {
        option::Option[usize]::Some(i) =>
            recycler::begin_reorder(host, n, i, screen_y(v, y)),
        option::Option[usize]::None => false,
    };
}

fn end_row_reorder(v: *u8, y: i32) -> bool {
    let host: *u8 = recycler::reorder_host();
    if host == (0 as *u8) { return false; }
    let n: *core::Node = node_of_window(host);
    if n == (0 as *core::Node) { return false; }
    // IN THE VIEWPORT'S COORDINATES. The press and the release land on
    // different row windows, each with its own origin, so both are converted
    // through the screen — comparing two client-relative values from different
    // windows is how a drag reports the row it started on.
    return recycler::end_reorder(n, viewport_y(host, screen_y(v, y)));
}

// A window-relative y in SCREEN coordinates.
fn screen_y(v: *u8, y: i32) -> i32 {
    var r: u::tagRECT = #zero::[u::tagRECT]();
    if { u::GetWindowRect(v, #addr_of(r)) } == (0 as i32) { return y; }
    return r.top +% y;
}

// ...and back down into `host`'s client space.
fn viewport_y(host: *u8, sy: i32) -> i32 {
    var r: u::tagRECT = #zero::[u::tagRECT]();
    if { u::GetWindowRect(host, #addr_of(r)) } == (0 as i32) { return sy; }
    return sy -% r.top;
}

fn begin_divider_drag(v: *u8, x: i32, y: i32) -> bool {
    let n: *core::Node = node_of_window(v);
    if n == (0 as *core::Node) { return false; }
    if core::kind_of(n) != split::K_SPLIT { return false; }
    if !controls::on_divider(n, x, y) { return false; }
    DRAG_SPLIT = { #addr(v) };
    let _c: *u8 = { u::SetCapture(v) };
    return true;
}

fn drag_divider(v: *u8, x: i32, y: i32) -> bool {
    if DRAG_SPLIT != { #addr(v) } { return false; }
    let n: *core::Node = node_of_window(v);
    if n == (0 as *core::Node) { return false; }
    return controls::split_drag_to(v, n, x, y);
}

fn end_divider_drag() {
    if DRAG_SPLIT == (0 as usize) { return; }
    DRAG_SPLIT = 0 as usize;
    if { u::GetCapture() } != (0 as *u8) { let _r: i32 = { u::ReleaseCapture() }; }
    return;
}

fn fire_tab_click(v: *u8, x: i32, y: i32) -> bool {
    let n: *core::Node = node_of_window(v);
    if n == (0 as *core::Node) { return false; }
    if core::kind_of(n) != props::K_TABS { return false; }
    let at: i64 = controls::tab_at(v, n, x, y);
    if at < (0 as i64) { return false; }
    let p: *props::TabsProps = controls::props_of(n, props::K_TABS) as *props::TabsProps;
    if p == (0 as *props::TabsProps) { return false; }
    // Already showing: not a change, and firing `on_tab_changed` for a tab the
    // user was already on is a spurious event rather than a helpful one.
    if { (*p).selected_index } == at { return true; }
    { (*p).selected_index = at };
    controls::show_selected_pane(n, at);
    let _i: i32 = { u::InvalidateRect(v, 0 as *u::tagRECT, 1 as i32) };
    // THE NODE IS DIRTY, not just repainted: a pane going from `Display::None`
    // to `Flex` is a LAYOUT change, and nothing else will ask for one.
    core::touch(n, tabs::P_SELECTED_INDEX);
    return fire_tabs(v, n);
}

fn fire_date_changed(v: *u8, n: *core::Node) -> bool {
    let p: *props::DatePickerProps =
        controls::props_of(n, props::K_DATE_PICKER) as *props::DatePickerProps;
    if p == (0 as *props::DatePickerProps) { return false; }
    // THE CONTROL IS THE TRUTH while the user is in it — the same direction
    // every other reader in this file runs.
    { (*p).date = controls::date_of(v) };
    let h: fn(*u8, *u8) = { (*p).on_date_selected };
    if h == props::no_handler { return false; }
    h(v, { (*p).on_date_selected_ctx });
    return true;
}

fn fire_date_edge(v: *u8, n: *core::Node, opened: bool) -> bool {
    let p: *props::DatePickerProps =
        controls::props_of(n, props::K_DATE_PICKER) as *props::DatePickerProps;
    if p == (0 as *props::DatePickerProps) { return false; }
    { (*p).is_open = opened };
    let h: fn(*u8, *u8) = if opened { { (*p).on_opened } } else { { (*p).on_closed } };
    let ctx: *u8 = if opened { { (*p).on_opened_ctx } } else { { (*p).on_closed_ctx } };
    if h == props::no_handler { return false; }
    h(v, ctx);
    return true;
}

fn fire_time_changed(v: *u8, n: *core::Node) -> bool {
    let p: *props::TimePickerProps =
        controls::props_of(n, props::K_TIME_PICKER) as *props::TimePickerProps;
    if p == (0 as *props::TimePickerProps) { return false; }
    { (*p).time = controls::time_of(v) };
    let h: fn(*u8, *u8) = { (*p).on_time_selected };
    if h == props::no_handler { return false; }
    h(v, { (*p).on_time_selected_ctx });
    return true;
}

fn fire_tabs(v: *u8, n: *core::Node) -> bool {
    let p: *props::TabsProps = controls::props_of(n, props::K_TABS) as *props::TabsProps;
    if p == (0 as *props::TabsProps) { return false; }
    let h: fn(*u8, *u8) = { (*p).on_tab_changed };
    if h == props::no_handler { return false; }
    h(v, { (*p).on_tab_changed_ctx });
    return true;
}

// UDN_DELTAPOS ARRIVES BEFORE THE MOVE, not after — the notification is the
// control ASKING whether it may change, and its position is still the old one.
// So the value is recomputed from the control on the next turn rather than read
// here; `UDM_GETPOS32` in `stepper_value_of` answers after the control has
// settled.
fn fire_stepper(v: *u8, n: *core::Node) -> bool {
    let p: *props::StepperProps =
        controls::props_of(n, props::K_STEPPER) as *props::StepperProps;
    if p == (0 as *props::StepperProps) { return false; }
    { (*p).value = controls::stepper_value_of(v, p) };
    let h: fn(*u8, *u8) = { (*p).on_value_changed };
    if h == props::no_handler { return false; }
    h(v, { (*p).on_value_changed_ctx });
    return true;
}
