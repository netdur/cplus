// Android's SensorManager, through a small Java listener.
//
// The Java half exists because `SensorEventListener` is an INTERFACE and JNI
// cannot implement one. `java/cplus/sensors/CplusSensors.java` is that class,
// and `sensors.dex` is it compiled — a COMMITTED BUILD ARTIFACT that
// `tools/build_dex.sh` regenerates. Editing the .java changes nothing until
// that runs.
//
// ---- no conversion happens here --------------------------------------------
//
// Android already reports what the facade promises: m/s^2, rad/s, microtesla,
// hectopascal. Apple reports acceleration in G and converts in its own backend.
// This one passes the numbers through, which is why it looks thinner.
//
// ---- and this one has the barometer -----------------------------------------
//
// `TYPE_PRESSURE` is an ordinary sensor here. On Apple the barometer is
// `CMAltimeter`, a different class with no polled form, so the Apple backend
// reports it unavailable. Same package, two answers, both true.

import "stdlib/option" as option;
import "stdlib/box" as box;
import "jni/jni" as jni;
import "android_view/runtime" as rt;
import "facet/app_events" as ev;
import "./sensors" as sens;

const _DEX_LEN: usize = 2764;

static _C_SENSORS: usize = 0;
static _LOADER: usize = 0;

struct _Session {
    token: i64,
    obj: usize,
    kind: i32,
    on_sample: fn(sens::Sample, *u8),
    opaque ctx: *u8,
    running: bool,
}

const _MAX_SESSIONS: usize = 8 as usize;
static _SESSIONS: [usize; 8] = #zero::[[usize; 8]]();
static _NEXT_TOKEN: i64 = 1 as i64;

fn _remember(s: *_Session) -> bool {
    var i: usize = 0 as usize;
    while i < _MAX_SESSIONS {
        if _SESSIONS[i] == 0 { _SESSIONS[i] = { #addr(s) }; return true; }
        i = i + (1 as usize);
    }
    return false;
}

fn _forget(s: *_Session) {
    var i: usize = 0 as usize;
    while i < _MAX_SESSIONS {
        if _SESSIONS[i] == { #addr(s) } { _SESSIONS[i] = 0; return; }
        i = i + (1 as usize);
    }
    return;
}

fn _by_token(token: i64) -> *_Session {
    var i: usize = 0 as usize;
    while i < _MAX_SESSIONS {
        let raw: usize = _SESSIONS[i];
        if raw != 0 {
            let s: *_Session = { raw as *_Session };
            if { (*s).token } == token { return s; }
        }
        i = i + (1 as usize);
    }
    return 0 as *_Session;
}

#[repr(C)]
struct _NativeSample {
    opaque name: *u8,
    opaque signature: *u8,
    fn_ptr: fn(*jni::JNIEnv, jni::jobject, i64, f64, f64, f64, i64),
}

fn _context() -> jni::jobject {
    return { ev::host() as jni::jobject };
}

// ATTACHED AS A DAEMON: a sample can arrive on a thread this package does not
// own, and a non-daemon attachment would hold the VM open past it.
fn _env() -> rt::Env {
    let vm: *jni::JavaVM = { ev::host_runtime() as *jni::JavaVM };
    if vm.is_null() { return rt::from_native(0 as *jni::JNIEnv); }
    var envp: *jni::JNIEnv = 0 as *jni::JNIEnv;
    let rc: i32 = { (*(*vm)).AttachCurrentThreadAsDaemon(vm, { #addr_of(envp) as *u8 },
                                                         0 as *u8) };
    if rc != (0 as i32) { return rt::from_native(0 as *jni::JNIEnv); }
    return rt::from_native(envp);
}

fn _ensure_loaded(env: rt::Env) -> bool {
    if _LOADER != 0 { return _C_SENSORS != 0; }

    // MERGED FIRST. An app that fed `sensors.dex` to `d8` alongside its own
    // classes already has this class; loading the in-memory copy too would give
    // the process two — natives bound on one, instances of the other.
    let merged: jni::jclass = env.find_class(#str_ptr("cplus/sensors/CplusSensors\0"));
    if merged != (0 as jni::jclass) {
        _C_SENSORS = { #addr(env.retain_local_as_global(merged)) };
        _LOADER = 1 as usize;
        _bind_natives(env);
        return true;
    }
    env.clear_exception();

    let dex: *[u8; 2764] = #include_bytes("../sensors.dex");
    let buffer: jni::jobject = {
        (*(*env.raw())).NewDirectByteBuffer(env.raw(), { dex as *u8 }, _DEX_LEN as i64)
    };
    let app_loader: jni::jobject = env.call_object_0(
        _context(), #str_ptr("android/content/Context\0"), #str_ptr("getClassLoader\0"),
        #str_ptr("()Ljava/lang/ClassLoader;\0"));

    let imdcl: jni::jclass = env.find_class(#str_ptr("dalvik/system/InMemoryDexClassLoader\0"));
    let ctor: jni::jmethodID = env.method_id(imdcl, #str_ptr("<init>\0"),
        #str_ptr("(Ljava/nio/ByteBuffer;Ljava/lang/ClassLoader;)V\0"));
    var ctor_args: [jni::JValue; 2] = [jni::arg_object(buffer), jni::arg_object(app_loader)];
    let loader: jni::jobject = {
        (*(*env.raw())).NewObjectA(env.raw(), imdcl, ctor, #addr_of(ctor_args[0]))
    };
    if loader == (0 as jni::jobject) { env.clear_exception(); return false; }
    _LOADER = { #addr(env.new_global_ref(loader)) };

    let name: jni::jstring = env.new_string_utf(#str_ptr("cplus.sensors.CplusSensors\0"));
    let local: jni::jobject = env.call_object_1(
        loader, #str_ptr("java/lang/ClassLoader\0"), #str_ptr("loadClass\0"),
        #str_ptr("(Ljava/lang/String;)Ljava/lang/Class;\0"), jni::arg_object(name));
    if local == (0 as jni::jobject) { env.clear_exception(); return false; }
    _C_SENSORS = { #addr(env.new_global_ref(local)) };

    _bind_natives(env);

    env.delete_local_ref(local);
    env.delete_local_ref(name);
    env.delete_local_ref(loader);
    env.delete_local_ref(imdcl);
    env.delete_local_ref(app_loader);
    env.delete_local_ref(buffer);
    return true;
}

// ART resolves a `native` method by symbol only through a classloader's own
// native-library namespace, which an in-memory loader does not have — and
// `nativeSample` is private besides. Explicit binding is not optional.
fn _bind_natives(env: rt::Env) {
    var rec: _NativeSample = _NativeSample {
        name: #str_ptr("nativeSample\0"),
        signature: #str_ptr("(JDDDJ)V\0"),
        fn_ptr: _sensors_android_sample,
    };
    let _r: i32 = { (*(*env.raw())).RegisterNatives(env.raw(), { _C_SENSORS as *u8 },
                                                    #addr_of(rec) as *u8, 1) };
    return;
}

// NOT `export`ed: `RegisterNatives` takes a function POINTER, not a linker
// symbol.
fn _sensors_android_sample(envp: *jni::JNIEnv, cls: jni::jobject, token: i64,
                           x: f64, y: f64, z: f64, time_ms: i64) {
    let s: *_Session = _by_token(token);
    if s.is_null() { return; }
    if !{ (*s).running } { return; }
    let f: fn(sens::Sample, *u8) = { (*s).on_sample };
    if f.is_null() { return; }
    var out: sens::Sample = sens::Sample {
        x: x, y: y, z: z, timestamp_ms: time_ms,
    };
    f(out, { (*s).ctx });
    return;
}

// ---- the seam --------------------------------------------------------------

fn _env_ready() -> option::Option[rt::Env] {
    if !ev::has_host_runtime() { return option::Option[rt::Env]::None; }
    if !ev::has_host() { return option::Option[rt::Env]::None; }
    let env: rt::Env = _env();
    if env.raw().is_null() { return option::Option[rt::Env]::None; }
    if !_ensure_loaded(env) { return option::Option[rt::Env]::None; }
    return option::Option[rt::Env]::Some(env);
}

export extern fn _c_available(kind: i32) -> i32 {
    match _env_ready() {
        option::Option[rt::Env]::None => { return 0; }
        option::Option[rt::Env]::Some(env) => {
            var a: [jni::JValue; 2] = [jni::arg_object(_context()), jni::arg_int(kind)];
            let m: jni::jmethodID = env.method_id_static({ _C_SENSORS as jni::jclass },
                #str_ptr("available\0"),
                #str_ptr("(Landroid/content/Context;I)Z\0"));
            let on: u8 = {
                (*(*env.raw())).CallStaticBooleanMethodA(env.raw(), { _C_SENSORS as *u8 },
                                                         m, #addr_of(a[0]))
            };
            if env.has_pending_exception() { env.clear_exception(); return 0; }
            if on != (0 as u8) { return 1; }
            return 0;
        }
    }
}

export extern fn _c_start(kind: i32, req: *sens::Request,
                          on_sample: fn(sens::Sample, *u8), ctx: *u8,
                          out_code: *i32) -> *u8 {
    match _env_ready() {
        option::Option[rt::Env]::None => {
            if out_code.is_not_null() { { *out_code = 1 }; }
            return 0 as *u8;
        }
        option::Option[rt::Env]::Some(env) => {
            let token: i64 = _NEXT_TOKEN;
            _NEXT_TOKEN = token + (1 as i64);

            let ctor: jni::jmethodID = env.method_id({ _C_SENSORS as jni::jclass },
                #str_ptr("<init>\0"), #str_ptr("(J)V\0"));
            var cargs: [jni::JValue; 1] = [jni::arg_long(token)];
            let local: jni::jobject = {
                (*(*env.raw())).NewObjectA(env.raw(), { _C_SENSORS as *u8 }, ctor,
                                           #addr_of(cargs[0]))
            };
            if local == (0 as jni::jobject) {
                env.clear_exception();
                if out_code.is_not_null() { { *out_code = 4 }; }
                return 0 as *u8;
            }
            let obj: jni::jobject = env.new_global_ref(local);
            env.delete_local_ref(local);

            var blank: _Session = _Session {
                token: token, obj: { #addr(obj) }, kind: kind,
                on_sample: on_sample, ctx: ctx, running: true,
            };
            var s: *_Session = match box::new::[_Session](blank) {
                option::Option[box::Box[_Session]]::Some(b) => { b.into_raw() as *_Session },
                option::Option[box::Box[_Session]]::None => { 0 as *_Session },
            };
            if s.is_null() {
                if out_code.is_not_null() { { *out_code = 4 }; }
                return 0 as *u8;
            }
            if !_remember(s) {
                if out_code.is_not_null() { { *out_code = 4 }; }
                return 0 as *u8;
            }

            var sa: [jni::JValue; 3] = [
                jni::arg_object(_context()),
                jni::arg_int(kind),
                jni::arg_long({ (*req).interval_ms }),
            ];
            let sm: jni::jmethodID = env.method_id({ _C_SENSORS as jni::jclass },
                #str_ptr("start\0"), #str_ptr("(Landroid/content/Context;IJ)I\0"));
            let code: i32 = {
                (*(*env.raw())).CallIntMethodA(env.raw(), obj, sm, #addr_of(sa[0]))
            };
            if env.has_pending_exception() { env.clear_exception(); }
            if code != 0 {
                { (*s).running = false };
                _forget(s);
                if out_code.is_not_null() { { *out_code = code }; }
                return 0 as *u8;
            }
            if out_code.is_not_null() { { *out_code = 0 }; }
            return s as *u8;
        }
    }
}

export extern fn _c_kind(h: *u8) -> i32 {
    if h.is_null() { return 0; }
    let s: *_Session = h as *_Session;
    return { (*s).kind };
}

export extern fn _c_running(h: *u8) -> i32 {
    if h.is_null() { return 0; }
    let s: *_Session = h as *_Session;
    if { (*s).running } { return 1; }
    return 0;
}

export extern fn _c_stop(h: *u8) {
    if h.is_null() { return; }
    let s: *_Session = h as *_Session;
    if !{ (*s).running } { return; }
    { (*s).running = false };
    match _env_ready() {
        option::Option[rt::Env]::None => { }
        option::Option[rt::Env]::Some(env) => {
            let obj: jni::jobject = { { (*s).obj } as jni::jobject };
            if obj != (0 as jni::jobject) {
                env.call_void_0(obj, #str_ptr("cplus/sensors/CplusSensors\0"),
                                #str_ptr("stop\0"), #str_ptr("()V\0"));
                if env.has_pending_exception() { env.clear_exception(); }
            }
        }
    }
    _forget(s);
    return;
}
