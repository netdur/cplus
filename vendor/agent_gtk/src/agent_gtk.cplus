// agent_gtk — the GTK 4 backend for the agent surface (the Linux/BSD
// counterpart to vendor/agent_appkit and vendor/agent_win32).
//
// `open(window)` walks a live GtkWidget hierarchy into a `Surface`: the
// agent-core identity tree (ids / roles / enabled state / exposure) plus a
// NodeId->GtkWidget map and the text-version state. From a `Surface` you get:
//
//   - the READ path: `describe()` -> `Vec[GtkNode]`, a live snapshot
//     ({ id, role, class_name, frame, is_hidden, text, actionable, parent }) —
//     how an agent sees the UI (describe_ui, not screenshots).
//   - the WRITE path: `click` / `set_text` / `focus`, each gated through the
//     framework-agnostic `agent_core::surface` authorization brain (exposure +
//     affordance ceiling + optimistic-concurrency version); the real widget I/O
//     (gtk_widget_activate / gtk_editable_set_text / gtk_widget_grab_focus)
//     happens only when the core returns `Allowed`.
//
// The agent-visible/actionable surface is the *exposed* subset: a node is
// exposed iff it was tagged with `set_agent_id` (the developer curates what the
// agent can touch). Untagged widgets are still walked for tree completeness but
// are NotExposed, so actions on them are refused.
//
// The walk is a DFS (pre-order) over the GTK 4 child chain
// (gtk_widget_get_first_child / gtk_widget_get_next_sibling); recursion depth
// tracks widget-tree depth, which is shallow in practice. GTK has no
// objc_msgSend dispatch — every introspection call is a direct C symbol — and,
// like Win32, needs no main-thread marshaling helper here: an app that drives
// the surface off the GTK main thread must hop threads itself (GTK is not
// thread-safe), the same constraint any GTK code lives under.

import "stdlib/vec" as vec;
import "stdlib/io" as io;
import "stdlib/atomic" as atomic;
import "stdlib/option" as option;
import "stdlib/text" as text;
import "gobject/bridge" as convert;
import "agent_core/identity" as identity;
import "agent_core/surface" as surface;
import "agent_core/auth" as auth;
import "agent_core/events" as events;
import "agent_core/backend" as mcpb;

// ---- GTK 4 widget introspection + messaging ----

// Tree walk (GTK 4 replaced gtk_container_get_children with a sibling chain).
#[link_name = "gtk_widget_get_first_child"]
extern fn gtk_widget_get_first_child(widget: *u8) -> *u8;
#[link_name = "gtk_widget_get_next_sibling"]
extern fn gtk_widget_get_next_sibling(widget: *u8) -> *u8;
#[link_name = "gtk_widget_get_root"]
extern fn gtk_widget_get_root(widget: *u8) -> *u8;

// GObject runtime type identity. `g_type_check_instance_is_a` is
// ancestry-aware, so a GtkToggleButton answers true to a GtkButton query.
#[link_name = "g_type_from_name"]
extern fn g_type_from_name(name: *u8) -> usize;
#[link_name = "g_type_check_instance_is_a"]
extern fn g_type_check_instance_is_a(instance: *u8, iface_type: usize) -> i32;
#[link_name = "g_type_name_from_instance"]
extern fn g_type_name_from_instance(instance: *u8) -> *u8;

// Live text getters (all return a borrowed `const char*` — do not free).
#[link_name = "gtk_label_get_text"]
extern fn gtk_label_get_text(label: *u8) -> *u8;
#[link_name = "gtk_button_get_label"]
extern fn gtk_button_get_label(button: *u8) -> *u8;
#[link_name = "gtk_check_button_get_label"]
extern fn gtk_check_button_get_label(button: *u8) -> *u8;
#[link_name = "gtk_editable_get_text"]
extern fn gtk_editable_get_text(editable: *u8) -> *u8;
#[link_name = "gtk_window_get_title"]
extern fn gtk_window_get_title(window: *u8) -> *u8;

// Live state.
#[link_name = "gtk_widget_get_sensitive"]
extern fn gtk_widget_get_sensitive(widget: *u8) -> i32;
#[link_name = "gtk_widget_get_visible"]
extern fn gtk_widget_get_visible(widget: *u8) -> i32;
#[link_name = "gtk_widget_get_width"]
extern fn gtk_widget_get_width(widget: *u8) -> i32;
#[link_name = "gtk_widget_get_height"]
extern fn gtk_widget_get_height(widget: *u8) -> i32;
// Out-param is a graphene_rect_t (four f32: origin.x, origin.y, size.width,
// size.height). Returns non-zero on success.
#[link_name = "gtk_widget_compute_bounds"]
extern fn gtk_widget_compute_bounds(widget: *u8, target: *u8, out_bounds: *u8) -> i32;

// Write / nav.
#[link_name = "gtk_widget_activate"]
extern fn gtk_widget_activate(widget: *u8) -> i32;
#[link_name = "gtk_editable_set_text"]
extern fn gtk_editable_set_text(editable: *u8, text: *u8);
#[link_name = "gtk_widget_grab_focus"]
extern fn gtk_widget_grab_focus(widget: *u8) -> i32;

// agent-id tagging: stash an arbitrary pointer on a GObject under a string key.
#[link_name = "g_object_set_data"]
extern fn g_object_set_data(obj: *u8, key: *u8, data: *u8);
#[link_name = "g_object_get_data"]
extern fn g_object_get_data(obj: *u8, key: *u8) -> *u8;
// Scroll a VIRTUALISED list to a model index. See `row_slot_above`.
#[link_name = "gtk_list_view_scroll_to"]
extern fn gtk_list_view_scroll_to(view: *u8, pos: u32, flags: u32, scroll: *u8);
// Declarative tag channel (facet set_identity): gtk_widget_set_name copies
// the id onto the widget; we read it back as a transfer-none C string.
#[link_name = "gtk_widget_get_name"]
extern fn gtk_widget_get_name(widget: *u8) -> *u8;

fn null() -> *u8 { return { 0 as *u8 }; }
fn is_null(p: *u8) -> bool { return p == null(); }

// ---- type queries ------------------------------------------------------------

fn is_a(widget: *u8, name: *u8) -> bool {
    let t: usize = { g_type_from_name(name) };
    if t == (0 as usize) { return false; }
    return { g_type_check_instance_is_a(widget, t) } != (0 as i32);
}

// ---- agent-id tagging --------------------------------------------------------

fn agent_key() -> *u8 { return { #str_ptr("cplus-agent-id\0") }; }

fn set_agent_id(widget: *u8, id: *u8) {
    { g_object_set_data(widget, agent_key(), id); }
    return;
}

// Pinned set_data id wins; otherwise a non-empty gtk_widget_get_name counts
// as the tag (what facet_gtk set_identity writes — parallel to AppKit
// accessibilityIdentifier).
fn get_agent_id(widget: *u8) -> *u8 {
    let pinned: *u8 = { g_object_get_data(widget, agent_key()) };
    if !is_null(pinned) { return pinned; }
    let name: *u8 = { gtk_widget_get_name(widget) };
    if is_null(name) { return null(); }
    // Empty string is not a tag.
    if { *name } == (0 as u8) { return null(); }
    return name;
}

// ---- declared affordance (role + drive-method) ------------------------------
//
// Same contract as agent_appkit: a packed (role, drive) under a stable GObject
// data key. Facet GTK backends (when present) and hand-built widgets write it;
// the walk reads it before falling back to native classify.

fn set_affordance(widget: *u8, role: identity::Role) {
    if is_null(widget) { return; }
    let drive: u32 = identity::drive_for_role(role);
    let packed: *u8 = identity::pack_affordance(identity::role_index(role) as u32, drive);
    { g_object_set_data(widget, identity::affordance_gobject_key(), packed); }
    return;
}

fn set_affordance_drive(widget: *u8, role: identity::Role, drive: u32) {
    if is_null(widget) { return; }
    let packed: *u8 = identity::pack_affordance(identity::role_index(role) as u32, drive);
    { g_object_set_data(widget, identity::affordance_gobject_key(), packed); }
    return;
}

fn get_declared_role(widget: *u8) -> option::Option[identity::Role] {
    if is_null(widget) { return option::Option[identity::Role]::None; }
    let p: *u8 = { g_object_get_data(widget, identity::affordance_gobject_key()) };
    if !identity::is_packed_affordance(p) {
        return option::Option[identity::Role]::None;
    }
    return option::Option[identity::Role]::Some(identity::role_from_index(identity::unpack_role(p)));
}

fn get_declared_drive(widget: *u8) -> option::Option[u32] {
    if is_null(widget) { return option::Option[u32]::None; }
    let p: *u8 = { g_object_get_data(widget, identity::affordance_gobject_key()) };
    if !identity::is_packed_affordance(p) {
        return option::Option[u32]::None;
    }
    return option::Option[u32]::Some(identity::unpack_drive(p));
}

// ---- describe_ui node --------------------------------------------------------

// graphene_rect_t layout: origin.x, origin.y, size.width, size.height (all f32).
#[repr(C)]
struct GrapheneRect {
    x: f32,
    y: f32,
    w: f32,
    h: f32,
}

// Widget rectangle in root (window) coordinates (f32, faithful to graphene).
struct Rect {
    x: f32,
    y: f32,
    w: f32,
    h: f32,
}

// One node of the describe_ui snapshot. `id` is the resolved agent-id; `role`
// the curated role; `class_name` the GType name (e.g. "GtkButton"); `frame` the
// rect in root coordinates; `text` the live label/content; `actionable` whether
// the agent may act on it (exposed + enabled + not observe-only). `parent`
// indexes into the returned `Vec[GtkNode]` (None for the window root) so the
// flat list reconstructs the tree.
struct GtkNode {
    id: text::Text,
    role: identity::Role,
    class_name: text::Text,
    frame: Rect,
    is_hidden: bool,
    text: text::Text,
    actionable: bool,
    // SENSITIVITY, in two fields because they answer two questions. `tier` is
    // what the APPLICATION declared and is the same for every agent;
    // `readable` is what THIS grant may do with it, and when it is false the
    // text is left empty rather than trimmed at the wire.
    tier: u32,
    readable: bool,
    parent: option::Option[usize],
}

// ---- role classification + live state ---------------------------------------

// Native-type fallback. Prefer declared affordance via resolve_role.
fn classify(widget: *u8) -> identity::Role {
    if is_a(widget, #str_ptr("GtkWindow\0")) {
        return identity::Role::Window;
    }
    if is_a(widget, #str_ptr("GtkEditable\0")) || is_a(widget, #str_ptr("GtkTextView\0")) {
        return identity::Role::Input;
    }
    if is_a(widget, #str_ptr("GtkLabel\0")) {
        return identity::Role::Text;
    }
    if is_a(widget, #str_ptr("GtkButton\0"))
        || is_a(widget, #str_ptr("GtkCheckButton\0"))
        || is_a(widget, #str_ptr("GtkSwitch\0")) {
        return identity::Role::Button;
    }
    if is_a(widget, #str_ptr("GtkListBox\0"))
        || is_a(widget, #str_ptr("GtkListView\0"))
        || is_a(widget, #str_ptr("GtkColumnView\0")) {
        return identity::Role::List;
    }
    return identity::Role::Group;
}

fn resolve_role(widget: *u8) -> identity::Role {
    return match get_declared_role(widget) {
        option::Option[identity::Role]::Some(r) => r,
        option::Option[identity::Role]::None => classify(widget),
    };
}

// The GType name as owned Text (e.g. "GtkButton").
fn class_name_text(widget: *u8) -> text::Text {
    return convert::cstr_to_text({ g_type_name_from_instance(widget) });
}

// The live text a node carries, keyed by role. A GtkTextView's content lives in
// its GtkTextBuffer (not GtkEditable), so a multi-line Input reports "".
fn node_text(widget: *u8, role: identity::Role) -> text::Text {
    if identity::role_eq(role, identity::Role::Window) {
        return convert::cstr_to_text({ gtk_window_get_title(widget) });
    }
    if identity::role_eq(role, identity::Role::Input) {
        if is_a(widget, #str_ptr("GtkEditable\0")) {
            return convert::cstr_to_text({ gtk_editable_get_text(widget) });
        }
        return text::from_str("");
    }
    if identity::role_eq(role, identity::Role::Text) {
        return convert::cstr_to_text({ gtk_label_get_text(widget) });
    }
    if identity::role_eq(role, identity::Role::Button) {
        if is_a(widget, #str_ptr("GtkButton\0")) {
            return convert::cstr_to_text({ gtk_button_get_label(widget) });
        }
        if is_a(widget, #str_ptr("GtkCheckButton\0")) {
            return convert::cstr_to_text({ gtk_check_button_get_label(widget) });
        }
    }
    return text::from_str("");
}

// The widget's bounds in root (window) coordinates. `gtk_widget_compute_bounds`
// fills a graphene_rect_t (four f32) relative to the target widget; we use the
// widget's own root. Returns 0 when the widget shares no ancestor with the root
// or has no allocation yet — fall back to a 0-origin rect with the live size.
fn frame_of(widget: *u8) -> Rect {
    var bounds: GrapheneRect = GrapheneRect { x: 0.0 as f32, y: 0.0 as f32, w: 0.0 as f32, h: 0.0 as f32 };
    let root: *u8 = { gtk_widget_get_root(widget) };
    let ok: i32 = if is_null(root) {
        0 as i32
    } else {
        { gtk_widget_compute_bounds(widget, root, { #addr_of(bounds) as *u8 }) }
    };
    if ok != (0 as i32) {
        return Rect { x: bounds.x, y: bounds.y, w: bounds.w, h: bounds.h };
    }
    return Rect {
        x: 0.0 as f32,
        y: 0.0 as f32,
        w: { gtk_widget_get_width(widget) } as f32,
        h: { gtk_widget_get_height(widget) } as f32,
    };
}

fn live_enabled(widget: *u8) -> bool {
    return { gtk_widget_get_sensitive(widget) } != (0 as i32);
}

fn live_hidden(widget: *u8) -> bool {
    return { gtk_widget_get_visible(widget) } == (0 as i32);
}

// ---- the surface -------------------------------------------------------------

// A NodeId->GtkWidget map entry (index-aligned with the identity registry).
// `opaque` marks the borrowed pointer unaccounted-by-design (GTK owns the widget
// lifetime; the surface is valid only while the window is live).
struct WidgetRef {
    opaque p: *u8,
}

// The live surface of one window: the identity tree, the NodeId->GtkWidget map
// (index 0 is the synthetic app root, mapped to null), and the text-version
// state for optimistic-concurrency edits.
struct Surface {
    reg: identity::Registry,
    versions: surface::TextVersions,
    refs: vec::Vec[WidgetRef],
}

// Recursively register a widget subtree: classify it, add it to the identity
// tree (a pinned agent-id becomes the developer id, which also exposes the
// node), reflect its live enabled state, map NodeId->widget, then recurse into
// its children in order (DFS pre-order). `refs` stays index-aligned with the
// registry: each `add_child` is paired with exactly one `refs.append`.
fn walk(ref reg: identity::Registry, ref refs: vec::Vec[WidgetRef], widget: *u8, parent_reg: usize) {
    let role: identity::Role = resolve_role(widget);
    let pinned: *u8 = get_agent_id(widget);
    let reg_node: usize = if is_null(pinned) {
        reg.add_child(parent_reg, option::Option[str]::None, role)
    } else {
        reg.add_child(parent_reg, option::Option[str]::Some(convert::cstr_to_str_unsafe(pinned)), role)
    };
    reg.set_enabled(reg_node, live_enabled(widget));
    // SENSITIVITY. Without this the walk marked every node `tier_open` and
    // `readable: true`, so a node the application put behind `agent: Private`
    // was served wide — and facet_gtk now pins that tier on every C_AGENT
    // node, so the pin had nowhere to land.
    reg.set_policy(reg_node, effective_policy(widget));
    refs.append(WidgetRef { p: widget });

    var child: *u8 = { gtk_widget_get_first_child(widget) };
    while !is_null(child) {
        walk(reg, refs, child, reg_node);
        child = { gtk_widget_get_next_sibling(child) };
    }
    return;
}

// Walk a window's child hierarchy into a `Surface`. The window is the root node
// (role Window) under the registry's app root; its child widgets follow.
fn open(window: *u8) -> Surface {
    var reg: identity::Registry = identity::new();
    var refs: vec::Vec[WidgetRef] = vec::new::[WidgetRef]();
    // NodeId 0 is the synthetic app root — no backing widget.
    refs.append(WidgetRef { p: null() });

    if is_null(window) {
        return Surface { reg: reg, versions: surface::new_text_versions(), refs: refs };
    }

    let win_pinned: *u8 = get_agent_id(window);
    let win_reg: usize = if is_null(win_pinned) {
        reg.add_child(reg.root(), option::Option[str]::None, identity::Role::Window)
    } else {
        reg.add_child(reg.root(), option::Option[str]::Some(convert::cstr_to_str_unsafe(win_pinned)), identity::Role::Window)
    };
    refs.append(WidgetRef { p: window });

    var child: *u8 = { gtk_widget_get_first_child(window) };
    while !is_null(child) {
        walk(reg, refs, child, win_reg);
        child = { gtk_widget_get_next_sibling(child) };
    }

    return Surface { reg: reg, versions: surface::new_text_versions(), refs: refs };
}

// Convenience: the read-only snapshot of a window in one call.
fn describe(window: *u8, grant: auth::Grant) -> vec::Vec[GtkNode] {
    let s: Surface = open(window);
    // The grant is the CALLER'S and is forwarded, not re-minted. `Surface::describe`
    // is the one that checks it; a convenience wrapper that dropped it here would
    // be a read with nobody's permission behind it.
    return s.describe(grant);
}

impl Surface {
    fn widget_of(this, node: usize) -> *u8 {
        return match this.refs.at_ptr(node) {
            option::Option[*WidgetRef]::Some(r) => { (*r).p },
            option::Option[*WidgetRef]::None => null(),
        };
    }

    // Live describe_ui snapshot. Reads each node's current frame / hidden / text
    // from its widget, so it reflects state *now* (e.g. after a `set_text`). The
    // synthetic app root (NodeId 0) is omitted; snapshot index = NodeId - 1.
    fn describe(this, grant: auth::Grant) -> vec::Vec[GtkNode] {
        var out: vec::Vec[GtkNode] = vec::new::[GtkNode]();
        let total: usize = this.reg.count();
        var node: usize = 1 as usize;
        while node < total {
            let widget: *u8 = this.widget_of(node);
            let role: identity::Role = this.reg.role_of(node);
            let parent: option::Option[usize] = match this.reg.parent_of(node) {
                option::Option[usize]::Some(p) => {
                    if p == (0 as usize) {
                        option::Option[usize]::None
                    } else {
                        option::Option[usize]::Some(p -% (1 as usize))
                    }
                }
                option::Option[usize]::None => option::Option[usize]::None,
            };
            // THE GATE IS HERE, not at the wire. A node whose tier this grant
            // cannot reach must never have its text READ, because a describe
            // that reads and then trims has already put the secret in memory
            // the caller can see — and `mode: full` is an agent-reachable
            // parameter, so a gate that only held in the curated view would
            // hold until the model tried the other one.
            let may_read: bool = this.reg.can_read_value_walked(grant, node);
            out.append(GtkNode {
                id: text::from_str(this.reg.resolved_id(node)),
                role: role,
                class_name: class_name_text(widget),
                frame: frame_of(widget),
                is_hidden: live_hidden(widget),
                text: if may_read { node_text(widget, role) } else { text::new() },
                actionable: this.reg.is_exposed(node) && this.reg.is_agent_actionable(node),
                tier: this.reg.tier_of(node),
                readable: may_read,
                parent: parent,
            });
            node = node +% (1 as usize);
        }
        return out;
    }

    // The current text version of a node (for optimistic-concurrency edits).
    fn text_version(this, id: str) -> u64 {
        return match this.reg.lookup(id) {
            option::Option[usize]::Some(n) => this.versions.version_of(n),
            option::Option[usize]::None => 0 as u64,
        };
    }

    // EVENTS: translate a fired widget into an agent event. Resolves the source
    // agent-id to its NodeId and offers `{ source, verb }` to the subscriber.
    // Returns false if the id is unknown. The app installs the actual GObject
    // signal handlers (closure-free C callbacks reaching app-global state) and
    // calls this with the verb the signal denotes (e.g. `Clicked` for "clicked",
    // `Changed` for "changed").
    fn emit(this, ref sub: events::Subscriber, source_id: str, verb: events::Verb) -> bool {
        match this.reg.lookup(source_id) {
            option::Option[usize]::Some(node) => {
                sub.offer({ #addr_of(this.reg) }, events::event(node, verb));
                return true;
            }
            option::Option[usize]::None => {}
        }
        return false;
    }

    // WRITE: click a control. On `Allowed`, activates the backing widget
    // (gtk_widget_activate emits the widget's default action).
    fn click(this, grant: auth::Grant, id: str) -> surface::Outcome {
        match this.reg.lookup(id) {
            option::Option[usize]::Some(node) => {
                let oc: surface::Outcome = surface::authorize_action(this.reg, grant, node);
                if !surface::outcome_eq(oc, surface::Outcome::Allowed) {
                    return oc;
                }
                let w: *u8 = this.widget_of(node);
                // NOTHING LISTENING IS ITS OWN ANSWER. `NoHandler` means the
                // click was permitted and would have landed, and there is no
                // handler at the other end — which is a different fact from
                // "this cannot be clicked" and the one an agent needs to stop
                // retrying. Reporting `Allowed` here is what let a dead control
                // read identically to a working one.
                if !widget_wired(w) {
                    if !press(w) { return surface::Outcome::NotActionable; }
                    return surface::Outcome::NoHandler;
                }
                if !press(w) { return surface::Outcome::NotActionable; }
                return surface::Outcome::Allowed;
            }
            option::Option[usize]::None => {}
        }
        return surface::Outcome::NotFound;
    }

    // WRITE: set an editable's text with optimistic concurrency. `base_version`
    // is the version the agent last read; a racing edit yields `VersionConflict`.
    // On `Allowed`, sets the text (GTK copies the buffer) then bumps the version.
    fn set_text(ref this, grant: auth::Grant, id: str, value: str, base_version: u64) -> surface::Outcome {
        match this.reg.lookup(id) {
            option::Option[usize]::Some(node) => {
                let oc: surface::Outcome =
                    surface::authorize_text_write(this.reg, grant, this.versions, node, base_version);
                if !surface::outcome_eq(oc, surface::Outcome::Allowed) {
                    return oc;
                }
                let c: *u8 = convert::str_to_cstring(value);
                { gtk_editable_set_text(this.widget_of(node), c); }
                convert::free_cstring(c);
                this.versions.bump(node);
                return surface::Outcome::Allowed;
            }
            option::Option[usize]::None => {}
        }
        return surface::Outcome::NotFound;
    }

    // WRITE: place the caret, or select a range.
    //
    // THE OFFSETS ARE BYTES and `gtk_editable_select_region` counts CHARACTERS.
    // A caret placed by an index that means something else is worse than no
    // caret verb at all — it lands in the wrong column and says it worked, and
    // it only ever shows up once someone types an accent. `agent_appkit`
    // records the same trap from the other side (its offsets are UTF-16).
    fn set_caret(ref this, grant: auth::Grant, id: str, at: u64, length: u64) -> surface::Outcome {
        match this.reg.lookup(id) {
            option::Option[usize]::Some(node) => {
                let oc: surface::Outcome = surface::authorize_action(this.reg, grant, node);
                if !surface::outcome_eq(oc, surface::Outcome::Allowed) { return oc; }
                let w: *u8 = this.widget_of(node);
                if is_null(w) { return surface::Outcome::Stale; }
                // A caret belongs to something EDITABLE. A label has text and
                // no caret, and answering `Allowed` for one would be the same
                // false claim `click` used to make.
                if !is_a(w, #str_ptr("GtkEditable\0")) { return surface::Outcome::NotActionable; }
                let body: text::Text = convert::cstr_to_text({ gtk_editable_get_text(w) });
                let start: i32 = chars_before_byte({ body.view() }, at as usize);
                let end: i32 = chars_before_byte({ body.view() }, (at +% length) as usize);
                { gtk_editable_select_region(w, start, end) };
                return surface::Outcome::Allowed;
            }
            option::Option[usize]::None => {}
        }
        return surface::Outcome::NotFound;
    }

    // READ BACK WHAT IS ACTUALLY DRAWN.
    //
    // Every other read verb answers `text` — WHAT the control holds — and
    // nothing answered HOW it is drawn, so "did the syntax colour land" needed
    // a probe compiled into the app. This is that answer for GTK.
    //
    // ---- where the styling actually lives, which is two places --------------
    //
    // A GtkLabel draws through a PangoLayout, and the layout carries a
    // PangoAttrList: one attribute per SPAN, which is what markup and
    // `set_attributes` produce, and exactly the shape the contract's runs want.
    // `pango_attr_iterator` already walks it as maximal stretches of uniform
    // attributes, so the run boundaries are Pango's, not invented here.
    //
    // But the attr list holds only the OVERRIDES. A label made bold by CSS —
    // `.title { font-weight: bold }`, which is how a themed application does it
    // — has no weight attribute anywhere, and reading the list alone reports
    // `is_bold: false` for a label that is visibly bold. That is precisely the
    // plausible-and-wrong answer this package refuses to give, and `is_bold`
    // is a bool with no "unset" to hide in. So the BASE font description off
    // the layout's context supplies the default that each run's own attribute
    // then overrides.
    //
    // COLOUR IS NOT FOLDED IN THE SAME WAY, and the asymmetry is deliberate:
    // the contract says `color` is `#rrggbb` for a run with a colour OF ITS
    // OWN and `""` otherwise, so the widget's inherited CSS colour is left out
    // and `""` keeps meaning "this run does not set one". A bool has no such
    // sentinel, which is the whole reason the two fields are treated
    // differently.
    //
    // ---- what is NOT supported, and says so ---------------------------------
    //
    // GtkEditable (GtkEntry, GtkText) has no public accessor for its layout,
    // and GtkTextView styles through GtkTextTags — a different model that maps
    // to runs differently and is not guessed at here. Both report
    // `supported: false` rather than an empty run list, which would read as
    // "no styling" and be a lie in the shape of a fact.
    fn read_runs(this, grant: auth::Grant, id: str) -> surface::Runs {
        match this.reg.lookup(id) {
            option::Option[usize]::Some(node) => {
                // VALUE READ, not `authorize_read`. `authorize_read` answers
                // "may this agent know the node exists", which a gated node
                // still answers yes to — and a redacted field reporting "one
                // run, sixteen characters" has told an agent the length of a
                // card number.
                let oc: surface::Outcome =
                    surface::authorize_value_read(this.reg, grant, node);
                if !surface::outcome_eq(oc, surface::Outcome::Allowed) {
                    return surface::runs_refused(oc, true);
                }
                let w: *u8 = this.widget_of(node);
                if is_null(w) { return surface::runs_refused(surface::Outcome::Stale, true); }
                if !is_a(w, #str_ptr("GtkLabel\0")) {
                    return surface::runs_refused(surface::Outcome::Allowed, false);
                }
                return label_runs(w);
            }
            option::Option[usize]::None => {}
        }
        return surface::runs_refused(surface::Outcome::NotFound, true);
    }

    // READ: is this node the thing at its own centre, or is something on top?
    //
    // `gtk_widget_pick` is GTK's own answer to "what is under this point", and
    // it is the same question the compositor asks — so a node covered by a
    // popover, a dialog or an overlapping sibling reports COVERED here for the
    // same reason a person's click would miss it.
    //
    // THE CENTRE, not a corner: a corner is on the boundary and picks whatever
    // rounding puts there.
    fn hit_test(this, grant: auth::Grant, id: str) -> surface::HitTest {
        match this.reg.lookup(id) {
            option::Option[usize]::Some(node) => {
                let oc: surface::Outcome = surface::authorize_read(this.reg, grant, node);
                if !surface::outcome_eq(oc, surface::Outcome::Allowed) {
                    return surface::hit_test_refused(oc, true);
                }
                let w: *u8 = this.widget_of(node);
                if is_null(w) { return surface::hit_test_refused(surface::Outcome::Stale, true); }
                let root: *u8 = { gtk_widget_get_root(w) };
                if is_null(root) { return surface::hit_test_refused(surface::Outcome::Stale, true); }
                let r: Rect = frame_of(w);
                if r.w <= (0.0 as f32) || r.h <= (0.0 as f32) {
                    // A node with no area is not covered — it is not THERE.
                    return surface::HitTest { outcome: surface::Outcome::Allowed,
                                              supported: true, reachable: false,
                                              covered: false, covered_by: text::new() };
                }
                let cx: f64 = (r.x + (r.w / (2.0 as f32))) as f64;
                let cy: f64 = (r.y + (r.h / (2.0 as f32))) as f64;
                // GTK_PICK_DEFAULT — insensitive and non-targetable widgets are
                // skipped, which is what a pointer does too.
                let hit: *u8 = { gtk_widget_pick(root, cx, cy, 0 as u32) };
                if is_null(hit) {
                    return surface::HitTest { outcome: surface::Outcome::Allowed,
                                              supported: true, reachable: false,
                                              covered: false, covered_by: text::new() };
                }
                // REACHABLE means the hit is this widget or INSIDE it: a click
                // landing on a node's own label has still reached the node.
                if is_at_or_inside(hit, w) {
                    return surface::HitTest { outcome: surface::Outcome::Allowed,
                                              supported: true, reachable: true,
                                              covered: false, covered_by: text::new() };
                }
                // Something else is on top. Name it only if it is EXPOSED —
                // an internal widget's id would be noise an agent cannot act on.
                return surface::HitTest { outcome: surface::Outcome::Allowed,
                                          supported: true, reachable: false,
                                          covered: true, covered_by: exposed_id_of(hit) };
            }
            option::Option[usize]::None => {}
        }
        return surface::hit_test_refused(surface::Outcome::NotFound, true);
    }

    // NAV: move keyboard focus to a node (a GtkViewport follows focus, so this
    // also scrolls the widget into view inside a scrollable parent). Authorized
    // via `authorize_read` (exposure required; the affordance ceiling does not
    // apply to navigation).
    fn focus(this, grant: auth::Grant, id: str) -> surface::Outcome {
        match this.reg.lookup(id) {
            option::Option[usize]::Some(node) => {
                let oc: surface::Outcome = surface::authorize_read(this.reg, grant, node);
                if !surface::outcome_eq(oc, surface::Outcome::Allowed) {
                    return oc;
                }
                let w: *u8 = this.widget_of(node);
                if is_null(w) { return surface::Outcome::Stale; }
                // FOCUS IS NOT ENOUGH, and `scroll_to` is this verb. A GtkFixed
                // — which is what every facet row and container is — refuses
                // `grab_focus`, so a node inside a list was never brought into
                // view: the call answered `Allowed` and nothing moved.
                //
                // So the scroll is done explicitly, and the focus is still
                // attempted because a control that CAN take it should.
                let _g: i32 = { gtk_widget_grab_focus(w) };
                scroll_into_view(w);
                return surface::Outcome::Allowed;
            }
            option::Option[usize]::None => {}
        }
        return surface::Outcome::NotFound;
    }
}

// ---- MCP backend vtable -----------------------------------------------------
//
// The backend-neutral `agent_core::backend::Backend` for the GTK surface. Each
// fn casts the erased `*u8` back to `*Surface`; `navigate` is grab-focus.
// `describe` widens graphene's f32 frame coordinates to the neutral f64 `Rect`.

fn ctext(s: str) -> text::Text {
    return text::from_str(s);
}

fn mcp_describe(p: *u8, grant: auth::Grant) -> vec::Vec[mcpb::UiNode] {
    refresh_surface(p);
    let s: *Surface = { p as *Surface };
    let local: vec::Vec[GtkNode] = (*s).describe(grant);
    var out: vec::Vec[mcpb::UiNode] = vec::new::[mcpb::UiNode]();
    var i: usize = 0 as usize;
    while i < local.count() {
        match local.at_ptr(i) {
            option::Option[*GtkNode]::Some(n) => {
                out.append(mcpb::UiNode {
                    id: ctext((*n).id.view()),
                    role: { (*n).role },
                    class_name: ctext((*n).class_name.view()),
                    frame: mcpb::Rect {
                        x: { (*n).frame.x } as f64,
                        y: { (*n).frame.y } as f64,
                        w: { (*n).frame.w } as f64,
                        h: { (*n).frame.h } as f64,
                    },
                    is_hidden: { (*n).is_hidden },
                    text: ctext((*n).text.view()),
                    // SENSITIVITY, asked for real now. This said `tier_open`
                    // and meant "never asked" — and an app serving an agent
                    // from this backend had only `exclude` for its secrets.
                    // The walk pins `effective_policy` on every node, so the
                    // registry answers both of these the same way AppKit's
                    // does: the declared tier, and what THIS grant may do with
                    // it.
                    tier: { (*n).tier },
                    readable: { (*n).readable },
                    // This backend has not split the permission from the
                    // capability (see backend::UiNode.clickable) and does not
                    // carry the accessibility label into its own node. Both
                    // report exactly what this backend reported before the
                    // fields existed, rather than a probe written against a
                    // toolkit that was never run — an untested capability
                    // claim is the bug the field was added to remove.
                    name: text::new(),
                    description: text::new(),
                    actionable: { (*n).actionable },
                    clickable: { (*n).actionable },
                    wired: option::Option[bool]::Some(
                        widget_wired(widget_for_id(s, { (*n).id.view() }))),
                    parent: { (*n).parent },
                });
            }
            option::Option[*GtkNode]::None => {}
        }
        i = i +% (1 as usize);
    }
    return out;
}

fn mcp_click(p: *u8, grant: auth::Grant, id: str) -> surface::Outcome {
    refresh_surface(p);
    // ON THE MAIN THREAD. Emitting a GTK signal from the serve thread killed
    // the process on the first nav click — see `run_on_main`.
    return run_on_main(act_click(), p, grant, id, "", 0 as u64, 0 as u64, 0 as u64);
}


fn mcp_set_text(p: *u8, grant: auth::Grant, id: str, value: str, base: u64) -> surface::Outcome {
    refresh_surface(p);
    return run_on_main(act_set_text(), p, grant, id, value, 0 as u64, 0 as u64, base);
}


fn mcp_navigate(p: *u8, grant: auth::Grant, id: str) -> surface::Outcome {
    refresh_surface(p);
    return run_on_main(act_navigate(), p, grant, id, "", 0 as u64, 0 as u64, 0 as u64);
}



// The curated describe: identity::Registry.describe() over the wire — only
// developer-EXPOSED nodes, lean fields (id, role, the human name as `text`,
// actionable, parent re-parented to the nearest exposed ancestor). Structural
// auto-keyed chrome is pruned; frames and classes are omitted so the agent's
// context stays small. describe_ui's DEFAULT view ("full" opts into
// mcp_describe above).
fn mcp_describe_exposed(p: *u8, grant: auth::Grant) -> vec::Vec[mcpb::UiNode] {
    refresh_surface(p);
    let s: *Surface = { p as *Surface };
    let views: vec::Vec[identity::NodeView] = { (*s).reg.describe(grant) };
    var out: vec::Vec[mcpb::UiNode] = vec::new::[mcpb::UiNode]();
    var i: usize = 0 as usize;
    while i < views.count() {
        match views.at_ptr(i) {
            option::Option[*identity::NodeView]::Some(n) => {
                out.append(mcpb::UiNode {
                    id: text::from_str({ (*n).id.view() }),
                    role: { (*n).role },
                    class_name: text::new(),
                    frame: mcpb::Rect { x: 0.0f64, y: 0.0f64, w: 0.0f64, h: 0.0f64 },
                    is_hidden: false,
                    text: text::from_str({ (*n).name.view() }),
                    name: text::from_str({ (*n).name.view() }),
                    description: text::from_str({ (*n).description.view() }),
                    // The registry's own answer, which is real: nothing in this
                    // backend's WALK sets it yet (see the full describe above),
                    // but a declaration made directly on the registry is
                    // honoured here rather than dropped on the floor.
                    tier: { (*n).tier },
                    readable: { (*n).readable },
                    actionable: { (*n).actionable },
                    // See the note in the full describe above.
                    clickable: { (*n).actionable },
                    wired: option::Option[bool]::Some(
                        widget_wired(widget_for_id(s, { (*n).id.view() }))),
                    parent: { (*n).parent },
                });
            }
            option::Option[*identity::NodeView]::None => {}
        }
        i = i +% (1 as usize);
    }
    return out;
}

// No hit-testing on this backend: it would have to reimplement the toolkit's
// own pointer resolution to answer, and a plausible guess is worse than an
// honest refusal — a caller trusting a fabricated "reachable" would conclude
// the human path is verified when nothing verified it.
fn mcp_hit_test(p: *u8, grant: auth::Grant, id: str) -> surface::HitTest {
    refresh_surface(p);
    let s: *Surface = { p as *Surface };
    return (*s).hit_test(grant, id);
}


// The three verbs this backend cannot answer yet. They report what they are —
// unsupported — rather than a plausible answer: an untested capability claim is
// the bug the `clickable` field was added to remove, and the same rule applies
// to a verb. AppKit is where the agent surface is built first (backend
// priority: AppKit -> uikit -> android -> gtk4 -> win32).
fn mcp_set_caret(p: *u8, grant: auth::Grant, id: str, at: u64, length: u64) -> surface::Outcome {
    refresh_surface(p);
    return run_on_main(act_set_caret(), p, grant, id, "", at, length, 0 as u64);
}


// Same posture as `mcp_describe`: re-walk on the main thread, then read. The
// threading assumption is the file's, not this verb's.
fn mcp_read_runs(p: *u8, grant: auth::Grant, id: str) -> surface::Runs {
    refresh_surface(p);
    if is_null(p) { return surface::runs_refused(surface::Outcome::NotFound, true); }
    let s: *Surface = { p as *Surface };
    return (*s).read_runs(grant, id);
}

// ON THE MAIN THREAD, unlike `read_runs`: this one ACTS. Firing a GAction runs
// the application's own handler, and a handler is entitled to assume it is on
// the thread that owns the widgets.
fn mcp_invoke_menu(p: *u8, grant: auth::Grant, path: str) -> surface::Outcome {
    refresh_surface(p);
    return run_on_main(act_invoke_menu(), p, grant, path, "",
                       0 as u64, 0 as u64, 0 as u64);
}

fn mcp_backend() -> mcpb::Backend {
    return mcpb::Backend {
        describe: mcp_describe,
        describe_exposed: mcp_describe_exposed,
        click: mcp_click,
        set_text: mcp_set_text,
        navigate: mcp_navigate,
        hit_test: mcp_hit_test,
        set_caret: mcp_set_caret,
        read_runs: mcp_read_runs,
        invoke_menu: mcp_invoke_menu,
    };
}

// ---- clicking something that is not a GtkButton --------------------------------
//
// `gtk_widget_activate` emits a widget's DEFAULT ACTION, and a great deal of a
// facet application has none: a row, a card, a tappable box is a GtkFixed
// carrying a GtkGestureClick, and a GtkFixed activates nothing. So `click`
// authorized the action, called activate, returned `Allowed` — and NOTHING
// HAPPENED. An agent was told it had clicked.
//
// That is the same failure the `clickable` field exists to prevent, one level
// down: a capability claimed and not delivered.
//
// So the CONTROLLER is found and told. A GtkGestureClick emits `pressed` and
// `released`, and emitting them runs the real handler inside GTK's own
// emission — the sequence a pointer would produce, minus the pointer. GTK 4
// has no public door for a synthetic event; this is the nearest true thing.
//
// ACTIVATE IS STILL TRIED FIRST, because a real GtkButton, GtkSwitch or
// GtkEntry has a default action and that is the more faithful path for one.
// The gesture is the fallback, and answering `NotActionable` when there is
// neither is the honest end — an agent can act on that, where a false
// `Allowed` leaves it believing a click landed.

#[link_name = "gtk_widget_observe_controllers"]
extern fn gtk_widget_observe_controllers(w: *u8) -> *u8;
#[link_name = "g_list_model_get_n_items"]
extern fn g_list_model_get_n_items(m: *u8) -> u32;
#[link_name = "g_list_model_get_item"]
extern fn g_list_model_get_item(m: *u8, i: u32) -> *u8;
#[link_name = "g_signal_emit_by_name"]
extern fn emit_click(o: *u8, name: *u8, n_press: i32, x: f64, y: f64);
#[link_name = "g_object_unref"]
extern fn g_object_unref_(o: *u8);

// Does this widget answer `activate` itself? GtkWidget's activate signal is
// declared per CLASS, and asking the type is how to tell a GtkButton from a
// GtkFixed without a table of class names.
#[link_name = "gtk_widget_class_get_activate_signal"]
extern fn gtk_widget_class_get_activate_signal(klass: *u8) -> u32;
#[link_name = "g_type_check_instance_cast"]
extern fn g_type_check_instance_cast(inst: *u8, t: usize) -> *u8;

fn activates(w: *u8) -> bool {
    if w == (0 as *u8) { return false; }
    // The instance's class pointer is the first word of a GTypeInstance.
    let klass: *u8 = { *(w as **u8) };
    if klass == (0 as *u8) { return false; }
    return { gtk_widget_class_get_activate_signal(klass) } != (0 as u32);
}

// The first GtkGestureClick armed on this widget, or on its immediate child —
// facet arms the band on the node's own widget, and a control that is several
// widgets (a button is a box holding an image and a label) carries it one down.
fn click_gesture_of(w: *u8) -> *u8 {
    if w == (0 as *u8) { return 0 as *u8; }
    let m: *u8 = { gtk_widget_observe_controllers(w) };
    if m == (0 as *u8) { return 0 as *u8; }
    let n: u32 = { g_list_model_get_n_items(m) };
    var i: u32 = 0 as u32;
    var found: *u8 = 0 as *u8;
    while i < n {
        let c: *u8 = { g_list_model_get_item(m, i) };
        if c != (0 as *u8) {
            if found == (0 as *u8) && is_a(c, #str_ptr("GtkGestureClick\0")) { found = c; }
            // `get_item` is transfer-full; the controller outlives this
            // borrow because the widget holds it.
            { g_object_unref_(c) };
        }
        i = i +% (1 as u32);
    }
    { g_object_unref_(m) };
    return found;
}

// ---- MEASURED, because every obvious answer here is wrong ----------------------
//
// `gtk_widget_activate` IS NOT A CLICK. On a GtkButton it returns TRUE and
// emits nothing: it starts the key-binding press ANIMATION, and `clicked`
// arrives later only if a main loop turns. Measured, on a realized button with
// a `clicked` handler attached:
//
//     unrealized activate -> True   hits 0
//     realized   activate -> True   hits 0
//     presented  activate -> True   hits 0
//
// Emitting on the button's OWN GtkGestureClick does not work either — its
// handler reads the real event sequence, and a synthetic emission has none:
//
//     controllers on button: [EventControllerKey, GestureClick, ShortcutController]
//     after gesture emit, hits = 0
//
// What works is per class, so this is a small table rather than one call:
//
//     GtkButton   emit "clicked"        -> fires, synchronously. Toggles a
//                                          GtkToggleButton correctly too, which
//                                          matters because facet_gtk builds
//                                          EVERY button kind as one.
//     GtkSwitch   activate()            -> does NOT toggle. Set the state.
//     a Fixed with a facet GtkGestureClick
//                 emit pressed/released -> fires: facet's handlers read the
//                                          SENDER, not the event.
//
// The point of the table is that each entry was checked. An agent told
// `Allowed` over a click that did not happen is worse than one told it cannot
// click at all.

#[link_name = "g_signal_emit_by_name"]
extern fn emit_bare(o: *u8, name: *u8);
#[link_name = "gtk_switch_get_active"]
extern fn gtk_switch_get_active(w: *u8) -> i32;
#[link_name = "gtk_switch_set_active"]
extern fn gtk_switch_set_active(w: *u8, on: i32);

fn press(w: *u8) -> bool {
    if w == (0 as *u8) { return false; }
    // Every button kind — GtkToggleButton, GtkCheckButton and GtkLinkButton are
    // all GtkButtons, and so is every button facet_gtk builds.
    if is_a(w, #str_ptr("GtkButton\0")) {
        { emit_bare(w, #str_ptr("clicked\0")) };
        return true;
    }
    if is_a(w, #str_ptr("GtkSwitch\0")) {
        let on: i32 = { gtk_switch_get_active(w) };
        { gtk_switch_set_active(w, if on != (0 as i32) { 0 as i32 } else { 1 as i32 }) };
        return true;
    }
    // A facet row, card or tappable box: a GtkFixed carrying a gesture.
    var g_: *u8 = click_gesture_of(w);
    if g_ == (0 as *u8) {
        // One level down, for a control built out of parts.
        var child: *u8 = { gtk_widget_get_first_child(w) };
        while child != (0 as *u8) && g_ == (0 as *u8) {
            g_ = click_gesture_of(child);
            child = { gtk_widget_get_next_sibling(child) };
        }
    }
    if g_ != (0 as *u8) {
        // A press and a release at the widget's own origin. The coordinates are
        // the gesture's to interpret and facet's handlers read the SENDER, not
        // the point — see `input::tree_row_click`, which takes the row from the
        // widget and never looks at where in it the click landed.
        { emit_click(g_, #str_ptr("pressed\0"), 1 as i32, 1.0f64, 1.0f64) };
        { emit_click(g_, #str_ptr("released\0"), 1 as i32, 1.0f64, 1.0f64) };
        return true;
    }
    // LAST, and its answer is believed: `activate` returns FALSE where the
    // widget will not act. It is kept for the classes neither branch above
    // covers and nothing else — it is not a click on its own.
    if activates(w) {
        if { gtk_widget_activate(w) } != (0 as i32) { return true; }
    }
    return false;
}

// ---- byte offsets to character offsets ------------------------------------------
//
// facet's caret offsets are BYTES; `gtk_editable_select_region` counts
// CHARACTERS. The two agree for ASCII and diverge on the first accent, which is
// exactly the kind of bug that ships: it works for everyone who tests in
// English and puts the caret in the wrong column for everyone else.
//
// A UTF-8 continuation byte is `10xxxxxx`, so a character starts at every byte
// that is NOT one. Counting starts is the whole conversion.
fn chars_before_byte(s: str, at: usize) -> i32 {
    let n: usize = s.count();
    var stop: usize = at;
    if stop > n { stop = n; }
    var chars: i32 = 0 as i32;
    var i: usize = 0 as usize;
    while i < stop {
        match s.byte_at(i) {
            option::Option[u8]::Some(b) => {
                // Not a continuation byte: 0b10xxxxxx is 0x80..0xBF.
                if (b & (0xC0 as u8)) != (0x80 as u8) { chars = chars +% (1 as i32); }
            }
            option::Option[u8]::None => { }
        }
        i = i +% (1 as usize);
    }
    // AND THE ONE IT MAY BE STANDING INSIDE. An offset that lands mid-character
    // has counted a character that has not finished — so the caret would go
    // AFTER a glyph the offset points into the middle of. Clamping back to the
    // boundary is the only reading that cannot overshoot.
    if stop < n {
        match s.byte_at(stop) {
            option::Option[u8]::Some(b) => {
                if (b & (0xC0 as u8)) == (0x80 as u8) { chars = chars -% (1 as i32); }
            }
            option::Option[u8]::None => { }
        }
    }
    if chars < (0 as i32) { return 0 as i32; }
    return chars;
}

// The agent id of whatever is on top, when it is one an agent could act on.
// An INTERNAL widget's id is noise: it names something the surface never
// exposed and nothing can be done with.
fn exposed_id_of(w: *u8) -> text::Text {
    var cur: *u8 = w;
    while !is_null(cur) {
        let pinned: *u8 = get_agent_id(cur);
        if !is_null(pinned) { return convert::cstr_to_text(pinned); }
        cur = { gtk_widget_get_parent(cur) };
    }
    return text::new();
}

// Is `hit` the widget `w`, or inside it? A click landing on a node's own label
// has still reached the node.
fn is_at_or_inside(hit: *u8, w: *u8) -> bool {
    var cur: *u8 = hit;
    while !is_null(cur) {
        if cur == w { return true; }
        cur = { gtk_widget_get_parent(cur) };
    }
    return false;
}

#[link_name = "gtk_widget_get_parent"]
extern fn gtk_widget_get_parent(w: *u8) -> *u8;
#[link_name = "gtk_widget_pick"]
extern fn gtk_widget_pick(w: *u8, x: f64, y: f64, flags: u32) -> *u8;
#[link_name = "gtk_editable_select_region"]
extern fn gtk_editable_select_region(e: *u8, start: i32, end: i32);

// ---- DELIVERY: would a click reach a HANDLER? ----------------------------------
//
// `backend::UiNode.wired`, the third question after permission (`actionable`)
// and capability (`clickable`). A control can pass both and still be dead, and
// nothing on the wire could tell the difference — every signal read identically
// to a working button.
//
// This backend answered `None` ("cannot answer"), which was honest and is no
// longer necessary: `press` already knows exactly what it would do to each
// class, so the same table answers what a click would REACH. Measured with
// GObject itself, on two buttons that differ only in whether anything is
// connected:
//
//     with handler -> True
//     no handler   -> False
//
// `g_signal_has_handler_pending` is the question, and it is the same question
// for every branch — the only thing that changes is WHICH signal.
#[link_name = "g_signal_lookup"]
extern fn g_signal_lookup(name: *u8, itype: usize) -> u32;
#[link_name = "g_signal_has_handler_pending"]
extern fn g_signal_has_handler_pending(instance: *u8, signal_id: u32,
                                       detail: u32, may_be_blocked: i32) -> i32;
#[link_name = "g_type_from_name"]
extern fn g_type_from_name(name: *u8) -> usize;

fn listens(instance: *u8, type_name: *u8, signal: *u8) -> bool {
    if is_null(instance) { return false; }
    let t: usize = { g_type_from_name(type_name) };
    if t == (0 as usize) { return false; }
    let sid: u32 = { g_signal_lookup(signal, t) };
    if sid == (0 as u32) { return false; }
    // `may_be_blocked = FALSE`: a handler that is connected but blocked would
    // not run, and "would this reach a handler" has to mean the live answer.
    return { g_signal_has_handler_pending(instance, sid, 0 as u32, 0 as i32) } != (0 as i32);
}

// The same branches `press` takes, asked as a question instead of an action.
// The two must stay together: a class `press` learns to drive is a class this
// has to learn to report, or the wire says dead about something an agent can
// operate — which is the failure the flag exists to name.
// A node is named on the wire by its DEVELOPER id, not its NodeId, so the
// widget comes back through the registry the same way every verb reaches one.
fn widget_for_id(s: *Surface, id: str) -> *u8 {
    if id == "" { return null(); }
    return match (*s).reg.lookup(id) {
        option::Option[usize]::Some(node) => (*s).widget_of(node),
        option::Option[usize]::None => null(),
    };
}

fn widget_wired(w: *u8) -> bool {
    if is_null(w) { return false; }
    if is_a(w, #str_ptr("GtkButton\0")) {
        return listens(w, #str_ptr("GtkButton\0"), #str_ptr("clicked\0"));
    }
    // A SWITCH IS ALWAYS WIRED. `press` sets its state, and the state IS the
    // effect — an application reads `active` rather than connecting to it, so
    // "nothing is listening" does not mean "nothing happens" here.
    if is_a(w, #str_ptr("GtkSwitch\0")) { return true; }
    var g_: *u8 = click_gesture_of(w);
    if g_ == (0 as *u8) {
        var child: *u8 = { gtk_widget_get_first_child(w) };
        while child != (0 as *u8) && g_ == (0 as *u8) {
            g_ = click_gesture_of(child);
            child = { gtk_widget_get_next_sibling(child) };
        }
    }
    if g_ != (0 as *u8) {
        // The gesture exists; the question is whether anything is on it.
        // facet arms `pressed`, which is what `press` emits.
        return listens(g_, #str_ptr("GtkGestureClick\0"), #str_ptr("pressed\0"));
    }
    return false;
}

// ---- what an agent may do with this node's content -------------------------------
//
// `facet_gtk`'s shared band calls `app::agent_pin` for every node carrying a
// non-default `agent` prop, and that dispatches here through the hook
// `facet_agent` installs. Before this existed the pin had nowhere to land:
// the walk marked EVERY node `tier_open` / `readable: true`, so a card number
// declared `agent: Private` was served to whatever connected.
//
// The tier rides on the widget rather than in facet, for the same reason
// AppKit's rides on the view: the agent surface walks the PLATFORM tree and
// never sees a facet node, and a pin survives a re-render that replaces a
// widget's contents but not the widget.

fn policy_key() -> *u8 { return #str_ptr("facet-agent-policy\0"); }

fn set_agent_policy(widget: *u8, policy: u32) {
    if is_null(widget) { return; }
    // Packed as a pointer-sized integer, which is what `set_data` stores; +1
    // so `policy_none` (0) is distinguishable from "never pinned".
    { g_object_set_data(widget, policy_key(), ((policy +% (1 as u32)) as usize) as *u8); }
    return;
}

fn get_agent_policy(widget: *u8) -> u32 {
    if is_null(widget) { return identity::policy_none(); }
    let raw: usize = { #addr(g_object_get_data(widget, policy_key())) };
    if raw == (0 as usize) { return identity::policy_none(); }
    return (raw -% (1 as usize)) as u32;
}

// THE ONE THE DEVELOPER SHOULD NOT HAVE TO ASK FOR.
//
// A GtkEntry with `visibility = false` is a password field — a control whose
// whole reason to exist is that its contents must not be seen. Reading its
// text and handing it to a language model is the same defect as printing it to
// the log. AppKit's side records finding exactly that: a card number arriving
// in the curated describe as the node's NAME.
//
// So an unpinned password field is PRIVATE by default. An explicit pin still
// wins, because an application that deliberately marked one open has said so.
#[link_name = "gtk_entry_get_visibility"]
extern fn gtk_entry_get_visibility(e: *u8) -> i32;

fn is_secure_by_class(widget: *u8) -> bool {
    if !is_a(widget, #str_ptr("GtkEntry\0")) { return false; }
    return { gtk_entry_get_visibility(widget) } == (0 as i32);
}

fn effective_policy(widget: *u8) -> u32 {
    if is_null(widget) { return identity::policy_none(); }
    let raw: usize = { #addr(g_object_get_data(widget, policy_key())) };
    if raw != (0 as usize) { return (raw -% (1 as usize)) as u32; }
    if is_secure_by_class(widget) { return identity::policy_private(); }
    return identity::policy_none();
}

// ---- the snapshot has to be TAKEN AGAIN, and on the right thread ---------------
//
// TWO BUGS IN ONE PLACE, and the first hides the second.
//
// The surface was walked once, at `attach_window`, and every later
// `describe_ui` served that. A GtkListView has NO CELLS at attach — they are
// built when it is first allocated — so a list's rows were simply absent from
// the wire, forever. Driving a facet nav tree over MCP was therefore
// impossible: the rows an agent needs to click are the ones that were missing.
//
// And the walk RUNS ON THE SERVE THREAD. `serve_once` spawns a worker for the
// accept loop, and everything below reads live widgets — `frame_of`,
// `live_hidden`, `node_text` are all `gtk_*` calls. GTK 4 is not thread-safe
// and has no lock to take: the supported way to touch a widget from another
// thread is to not, and to hand the work to the main context instead.
//
// So the refresh is scheduled with `g_main_context_invoke` and the caller
// WAITS. `agent_appkit` reaches the same shape through `performSelectorOnMainThread`
// and for the same reason; this is that, spelled in GLib.
//
// The wait is a spin with a yield rather than a condition variable: the main
// loop is running by construction (an agent is talking to a live app), the work
// is one tree walk, and a mutex/condvar pair across the C boundary is more
// machinery than the wait is worth.

#[link_name = "sched_yield"]
extern fn sched_yield() -> i32;
#[link_name = "g_main_context_invoke"]
extern fn g_main_context_invoke(ctx: *u8, f: fn(*u8) -> i32, data: *u8);

// The surface being refreshed, and the handshake. One at a time: the serve
// loop is single-threaded and a second refresh would be a second answer to a
// question nobody asked twice.
static REFRESH_TARGET: usize = 0;
static REFRESH_DONE: i32 = 0;

// The re-walk itself. `#[keeps(nothing)]` is the honest declaration: `open`
// builds a whole new Surface from the window and the old one is dropped in
// place — nothing of the argument is borrowed onward, the bytes are replaced.
#[keeps(nothing)]
fn replace_surface(s: *Surface, win: *u8) {
    { (*s) = open(win) };
    return;
}

fn refresh_on_main(user: *u8) -> i32 {
    let p: usize = REFRESH_TARGET;
    if p != (0 as usize) {
        let s: *Surface = p as *Surface;
        // The window is NodeId 1 — NodeId 0 is the synthetic app root.
        let win: *u8 = (*s).widget_of(1 as usize);
        if !is_null(win) { replace_surface(s, win); }
    }
    atomic::store_i32(#addr_of(REFRESH_DONE), 1 as i32, atomic::Ordering::Release);
    // G_SOURCE_REMOVE.
    return 0 as i32;
}

fn refresh_surface(p: *u8) {
    if is_null(p) { return; }
    REFRESH_TARGET = { #addr(p) };
    atomic::store_i32(#addr_of(REFRESH_DONE), 0 as i32, atomic::Ordering::Release);
    { g_main_context_invoke(0 as *u8, refresh_on_main, 0 as *u8) };
    // BOUNDED. A main loop that never turns — an app mid-teardown, or one
    // blocked in a modal the agent cannot see — must not hang the serve
    // thread; a stale snapshot is a worse answer than a late one but a hung
    // connection is worse than both.
    var spins: i64 = 0 as i64;
    while spins < (200000 as i64) {
        if atomic::load_i32(#addr_of(REFRESH_DONE), atomic::Ordering::Acquire) != (0 as i32) {
            return;
        }
        // `sched_yield` rather than a spin: the main thread is what has to run
        // for this to finish, and burning the scheduler slice keeps it waiting.
        let _y: i32 = { sched_yield() };
        spins = spins +% (1 as i64);
    }
    return;
}

// ---- an ACTION runs on the main thread too --------------------------------------
//
// `refresh_surface` marshals the WALK and that was only half the problem. The
// verbs themselves — click, set_text, navigate, set_caret — ran on the serve
// thread and emitted GTK signals from there. GTK 4 is not thread-safe and has
// no lock to take, so this is not a race that is merely unlikely: driving the
// gallery's nav over MCP KILLED THE PROCESS on the first click.
//
// The same handshake as the refresh, with a request and an answer beside it.
// Statics rather than a heap message because the serve loop is
// single-threaded — one request is outstanding at a time, by construction —
// and a queue would be machinery for a case that cannot arise.

fn act_click() -> i32 { return 1 as i32; }
fn act_set_text() -> i32 { return 2 as i32; }
fn act_navigate() -> i32 { return 3 as i32; }
fn act_set_caret() -> i32 { return 4 as i32; }
// Addressed by PATH, not by node id — the only verb that is, because a menu
// item is not in the widget tree until its menu is open. `ACT_ID` carries the
// path; the surface's own root is the window the model hangs off.
fn act_invoke_menu() -> i32 { return 5 as i32; }

static ACT_KIND: i32 = 0;
static ACT_SURFACE: usize = 0;
static ACT_ID: text::Text = #zero::[text::Text]();
static ACT_TEXT: text::Text = #zero::[text::Text]();
static ACT_GRANT: auth::Grant = #zero::[auth::Grant]();
static ACT_AT: u64 = 0;
static ACT_LEN: u64 = 0;
static ACT_BASE: u64 = 0;
static ACT_OUT: i32 = 0;
static ACT_DONE: i32 = 0;

// `outcome_index`'s inverse. agent_core exports the encoder because the wire
// needs one; the decoder lives here because only this handshake needs it — an
// enum cannot cross the static that carries the answer back.
fn outcome_from_index(i: i32) -> surface::Outcome {
    if i == (0 as i32) { return surface::Outcome::Allowed; }
    if i == (2 as i32) { return surface::Outcome::NotExposed; }
    if i == (3 as i32) { return surface::Outcome::NotActionable; }
    if i == (4 as i32) { return surface::Outcome::VersionConflict; }
    if i == (5 as i32) { return surface::Outcome::Stale; }
    if i == (6 as i32) { return surface::Outcome::NeedsGrant; }
    if i == (7 as i32) { return surface::Outcome::Forbidden; }
    if i == (8 as i32) { return surface::Outcome::NoHandler; }
    return surface::Outcome::NotFound;
}

fn perform_on_main(user: *u8) -> i32 {
    let p: usize = ACT_SURFACE;
    if p != (0 as usize) {
        let s: *Surface = p as *Surface;
        let id: str = ACT_ID.view();
        var oc: surface::Outcome = surface::Outcome::NotFound;
        if ACT_KIND == act_click() { oc = (*s).click(ACT_GRANT, id); }
        if ACT_KIND == act_navigate() { oc = (*s).focus(ACT_GRANT, id); }
        if ACT_KIND == act_set_text() {
            oc = (*s).set_text(ACT_GRANT, id, ACT_TEXT.view(), ACT_BASE);
        }
        if ACT_KIND == act_set_caret() {
            oc = (*s).set_caret(ACT_GRANT, id, ACT_AT, ACT_LEN);
        }
        if ACT_KIND == act_invoke_menu() {
            // The window is NodeId 1 — NodeId 0 is the synthetic app root,
            // the same convention `refresh_on_main` walks from.
            oc = invoke_menu_path((*s).widget_of(1 as usize), id);
        }
        ACT_OUT = surface::outcome_index(oc);
    }
    atomic::store_i32(#addr_of(ACT_DONE), 1 as i32, atomic::Ordering::Release);
    return 0 as i32;
}

fn run_on_main(kind: i32, p: *u8, grant: auth::Grant, id: str,
               value: str, at: u64, length: u64, base: u64) -> surface::Outcome {
    if is_null(p) { return surface::Outcome::NotFound; }
    ACT_KIND = kind;
    ACT_SURFACE = { #addr(p) };
    ACT_ID = text::from_str(id);
    ACT_TEXT = text::from_str(value);
    ACT_GRANT = grant;
    ACT_AT = at;
    ACT_LEN = length;
    ACT_BASE = base;
    ACT_OUT = surface::outcome_index(surface::Outcome::NotFound);
    atomic::store_i32(#addr_of(ACT_DONE), 0 as i32, atomic::Ordering::Release);
    { g_main_context_invoke(0 as *u8, perform_on_main, 0 as *u8) };
    var spins: i64 = 0 as i64;
    while spins < (200000 as i64) {
        if atomic::load_i32(#addr_of(ACT_DONE), atomic::Ordering::Acquire) != (0 as i32) {
            return outcome_from_index(ACT_OUT);
        }
        let _y: i32 = { sched_yield() };
        spins = spins +% (1 as i64);
    }
    // A main loop that never turned. `Stale` is the honest answer: the surface
    // this action was aimed at is not being serviced.
    return surface::Outcome::Stale;
}

// ---- bringing a node into view --------------------------------------------------
//
// `scroll_to` over the wire is `navigate`, and an agent asking for it means
// "put this where a person could see it". `gtk_widget_grab_focus` is the
// idiomatic way to ask GTK to do that, and it only works on something
// FOCUSABLE — which a GtkFixed is not, and every facet row and container is a
// GtkFixed. So the verb answered `Allowed` over a list that never moved.
//
// The explicit path: find the scrollable ancestor, measure where the node sits
// inside its content, and set the adjustment so the node is on screen. Centred
// rather than flush to the top, because a row pinned to the very edge reads as
// cut off and an agent asking to see something wants context around it.
#[link_name = "gtk_adjustment_get_value"]
extern fn gtk_adj_get_value(a: *u8) -> f64;
#[link_name = "gtk_adjustment_set_value"]
extern fn gtk_adj_set_value(a: *u8, v: f64);
#[link_name = "gtk_adjustment_get_upper"]
extern fn gtk_adj_get_upper(a: *u8) -> f64;
#[link_name = "gtk_adjustment_get_page_size"]
extern fn gtk_adj_get_page_size(a: *u8) -> f64;
#[link_name = "gtk_scrolled_window_get_vadjustment"]
extern fn gtk_sw_get_vadjustment(sw: *u8) -> *u8;
#[link_name = "gtk_scrolled_window_get_hadjustment"]
extern fn gtk_sw_get_hadjustment(sw: *u8) -> *u8;

fn scrollable_above(w: *u8) -> *u8 {
    var cur: *u8 = { gtk_widget_get_parent(w) };
    while !is_null(cur) {
        if is_a(cur, #str_ptr("GtkScrolledWindow\0")) { return cur; }
        cur = { gtk_widget_get_parent(cur) };
    }
    return null();
}

// Move one axis by the DELTA that brings `pos`..`pos+extent` on screen, where
// `pos` is measured against the VIEWPORT and not the content.
//
// Content coordinates are the obvious spelling and they are wrong here: a
// GtkListView is itself a GtkScrollable and VIRTUALISES, so a row's bounds
// relative to the list are where it sits ON SCREEN, not where it sits in the
// model. Measured against the content of a 1312-tall list, every visible row
// answered a small number and the adjustment never moved.
//
// A delta needs no such assumption. Whatever the child does internally, "this
// node is 300 points below the bottom edge" means "scroll 300 further on".
fn nudge_axis(adj: *u8, pos: f64, extent: f64) {
    if is_null(adj) { return; }
    let page: f64 = { gtk_adj_get_page_size(adj) };
    if page <= (0.0 as f64) { return; }
    let value: f64 = { gtk_adj_get_value(adj) };
    let upper: f64 = { gtk_adj_get_upper(adj) };
    var delta: f64 = 0.0f64;
    if pos < (0.0 as f64) {
        // Above the top edge: bring it down, with a little context above it.
        delta = pos - (extent / (2.0 as f64));
    } else {
        if (pos + extent) > page {
            delta = (pos + extent) - page + (extent / (2.0 as f64));
        }
    }
    // ALREADY VISIBLE is the common case and must not move: a `scroll_to` that
    // nudged a node already on screen would make every describe/act cycle
    // jitter under an agent.
    if delta == (0.0 as f64) { return; }
    var want: f64 = value + delta;
    let top: f64 = upper - page;
    if want > top { want = top; }
    if want < (0.0 as f64) { want = 0.0f64; }
    if want == value { return; }
    { gtk_adj_set_value(adj, want) };
    return;
}

// ---- the model index, which is stamped and was being ignored ----------------
//
// A virtualised row's own geometry cannot answer "where is it": see
// `scroll_into_view`. The rest of the way is `gtk_list_view_scroll_to`, which
// is addressed by MODEL INDEX — and the note here used to say the index was
// what this layer did not have, because a cell carries no public accessor for
// its own slot.
//
// It does not need one. `facet_gtk`'s recycler already stamps the slot on the
// row host at every bind, under a stable GObject data key, because its own
// drag-reorder band needs to know which row moved. Reading that key is the
// same channel this file already uses for the declared affordance and the
// agent tier — a backend writes, the walk reads — and it degrades to nothing
// on a plain GTK app, where the key is simply absent.
//
// +1 BIASED, so that an absent key and slot 0 are distinguishable. That is the
// writer's convention and this reader must match it.
fn row_slot_key() -> *u8 { return #str_ptr("facet-gtk-rowslot\0"); }

struct RowSlot {
    // GTK owns the widget; this is a borrow for the length of one call.
    opaque view: *u8,
    at: u32,
    found: bool,
}

// Walk up for the nearest stamped row slot, then on up for the GtkListView it
// belongs to. Both halves must be found: a slot with no list above it is a
// stamp on a widget that has been reparented out, and scrolling nothing is
// better than scrolling the wrong thing.
//
// GtkGridView is not handled because nothing writes the key on one — facet's
// collection is rows-of-slots inside a GtkListView, not a GtkGridView.
fn row_slot_above(w: *u8) -> RowSlot {
    let miss: RowSlot = RowSlot { view: null(), at: 0 as u32, found: false };
    if is_null(w) { return miss; }
    var cur: *u8 = w;
    var at: u32 = 0 as u32;
    var have: bool = false;
    while !is_null(cur) {
        if !have {
            let raw: usize = { #addr({ g_object_get_data(cur, row_slot_key()) }) };
            if raw != (0 as usize) {
                at = (raw -% (1 as usize)) as u32;
                have = true;
            }
        }
        if have && is_a(cur, #str_ptr("GtkListView\0")) {
            return RowSlot { view: cur, at: at, found: true };
        }
        cur = { gtk_widget_get_parent(cur) };
    }
    return miss;
}

// A VIRTUALISED ROW CANNOT BE FOUND THIS WAY, and the measurement says so:
// an off-screen cell in a GtkListView EXISTS as a widget — the walk lists it,
// an agent can name it — but GtkListView never ALLOCATES one, so
// `gtk_widget_compute_bounds` answers 0x0 at the origin:
//
//     [agent] scroll_into_view pos=0 h=0 page=572 value=0
//
// So geometry brings a node into view inside an ordinary scroll and does
// nothing for a row below the fold in a list. `row_slot_above` is the rest of
// the way, and the ORDER between the two is the whole design:
//
// GEOMETRY FIRST, and the index only when geometry found no allocation. A row
// that is already on screen must not move — a `navigate` that nudged a visible
// node would make every describe/act cycle jitter under an agent, which is the
// invariant `nudge_axis` bends over backwards to keep. `gtk_list_view_scroll_to`
// re-anchors the view around the position it is given and does not promise to
// leave an already-visible row where it sits, so it is asked only once the
// zero-sized bounds have PROVEN the row is unallocated, which for a
// GtkListView cell means off screen.
//
// `GTK_LIST_SCROLL_NONE` (0) rather than FOCUS or SELECT: bringing a row into
// view must not select it. An agent that had to change the selection to look
// at something would be acting, not reading, and `navigate` is not an action
// verb.
//
// WHAT THIS STILL DOES NOT REACH: a row so far outside the viewport that
// GtkListView never realised a widget for it has no entry in the walk at all,
// so an agent cannot name it, let alone scroll to it. That is a describe-side
// limit, not a scroll-side one, and it is not fixed here.
fn scroll_into_view(w: *u8) {
    if is_null(w) { return; }
    let sw: *u8 = scrollable_above(w);
    if is_null(sw) { return; }
    var b: GrapheneRect = GrapheneRect { x: 0.0 as f32, y: 0.0 as f32,
                                         w: 0.0 as f32, h: 0.0 as f32 };
    // AGAINST THE SCROLLED WINDOW — see `nudge_axis` for why not the content.
    let measured: bool =
        { gtk_widget_compute_bounds(w, sw, { #addr_of(b) as *u8 }) } != (0 as i32);
    if measured && (b.w != (0.0 as f32) || b.h != (0.0 as f32)) {
        nudge_axis({ gtk_sw_get_vadjustment(sw) }, b.y as f64, b.h as f64);
        nudge_axis({ gtk_sw_get_hadjustment(sw) }, b.x as f64, b.w as f64);
        return;
    }
    // Unallocated: a virtualised row below the fold. Ask the list by index.
    let slot: RowSlot = row_slot_above(w);
    if !slot.found { return; }
    { gtk_list_view_scroll_to(slot.view, slot.at, 0 as u32, null()) };
    return;
}

// ---- the Pango side of `read_runs` -------------------------------------------
//
// THE STRUCT LAYOUTS BELOW ARE PANGO'S PUBLIC ABI. `PangoAttribute` and its
// `PangoAttrInt` / `PangoAttrColor` subclasses are declared in the installed
// `pango-attributes.h` with public fields — reading `value` off an attribute is
// what a C caller does, and there is no accessor function to prefer. They are
// mirrored rather than poked at by byte offset so the compiler does the
// alignment, and they must stay in this order.
struct PangoAttrInt {
    opaque klass: *u8,
    start_index: u32,
    end_index: u32,
    value: i32,
}

struct PangoAttrColor {
    opaque klass: *u8,
    start_index: u32,
    end_index: u32,
    red: u16,
    green: u16,
    blue: u16,
}

// PangoAttrType, from the same header. Only the four the contract reports.
fn attr_style() -> i32 { return 3 as i32; }
fn attr_weight() -> i32 { return 4 as i32; }
fn attr_foreground() -> i32 { return 9 as i32; }
fn attr_underline() -> i32 { return 11 as i32; }

// PANGO_WEIGHT_BOLD is 700, and "bold" is >= it rather than == it: a label set
// to HEAVY or ULTRABOLD is drawn bolder than bold, and reporting `false` for it
// would be the same wrong answer as reporting `false` for CSS bold.
fn weight_is_bold(v: i32) -> bool { return v >= (700 as i32); }
// PangoStyle: NORMAL 0, OBLIQUE 1, ITALIC 2. Oblique is slanted type, which is
// what an agent asking "is this italic" wants to know.
fn style_is_italic(v: i32) -> bool { return v != (0 as i32); }
// PANGO_UNDERLINE_NONE is 0; every other member draws a line.
fn underline_is_on(v: i32) -> bool { return v != (0 as i32); }

fn hex_nibble(v: u32) -> u8 {
    if v < (10 as u32) { return ((48 as u32) +% v) as u8; }
    return ((87 as u32) +% v) as u8;
}

// Pango carries 16 bits per channel; CSS wants 8. The high byte is the
// conversion Pango's own `pango_color_to_string` uses at 8-bit width.
fn css_hex(r: u16, g: u16, b: u16) -> text::Text {
    var bytes: vec::Vec[u8] = vec::new::[u8]();
    bytes.append(35 as u8);
    let ch: vec::Vec[u16] = vec::new::[u16]();
    var chans: vec::Vec[u16] = ch;
    chans.append(r);
    chans.append(g);
    chans.append(b);
    var i: usize = 0 as usize;
    while i < chans.count() {
        match chans.at(i) {
            option::Option[u16]::Some(c) => {
                let byte: u32 = (c as u32) >> (8 as u32);
                bytes.append(hex_nibble((byte >> (4 as u32)) & (15 as u32)));
                bytes.append(hex_nibble(byte & (15 as u32)));
            }
            option::Option[u16]::None => {}
        }
        i = i +% (1 as usize);
    }
    return match text::from_utf8(bytes) {
        option::Option[text::Text]::Some(t) => t,
        option::Option[text::Text]::None => text::new(),
    };
}

fn attr_int_value(a: *u8, fallback: i32) -> i32 {
    if is_null(a) { return fallback; }
    return { (*(a as *PangoAttrInt)).value };
}

// One run per maximal stretch of uniform attributes, which is what the Pango
// iterator already produces — with two corrections it does not make.
fn label_runs(w: *u8) -> surface::Runs {
    let layout: *u8 = { gtk_label_get_layout(w) };
    if is_null(layout) { return surface::runs_refused(surface::Outcome::Stale, true); }
    let body: *u8 = { pango_layout_get_text(layout) };
    let len: i32 = if is_null(body) { 0 as i32 } else { { strlen(body) } as i32 };

    // THE BASE, from the layout's own font description or, when it has none of
    // its own, the context's — which is where the widget's CSS font lands.
    var base_weight: i32 = 400 as i32;
    var base_style: i32 = 0 as i32;
    var desc: *u8 = { pango_layout_get_font_description(layout) };
    if is_null(desc) {
        let ctx: *u8 = { pango_layout_get_context(layout) };
        if !is_null(ctx) { desc = { pango_context_get_font_description(ctx) }; }
    }
    if !is_null(desc) {
        base_weight = { pango_font_description_get_weight(desc) };
        base_style = { pango_font_description_get_style(desc) };
    }

    var out: vec::Vec[surface::TextRun] = vec::new::[surface::TextRun]();
    let attrs: *u8 = { pango_layout_get_attributes(layout) };
    if is_null(attrs) {
        // No spans at all: the whole label is drawn in the base font. ONE RUN,
        // not zero — an empty list would read as "nothing is styled" for a
        // label that CSS made bold.
        if len > (0 as i32) {
            out.append(surface::TextRun {
                start: 0 as u64,
                length: len as u64,
                color: text::new(),
                is_bold: weight_is_bold(base_weight),
                is_italic: style_is_italic(base_style),
                is_underlined: false,
            });
        }
        return surface::Runs { outcome: surface::Outcome::Allowed, supported: true, runs: out };
    }

    let iter: *u8 = { pango_attr_list_get_iterator(attrs) };
    if is_null(iter) { return surface::runs_refused(surface::Outcome::Stale, true); }
    var more: bool = true;
    while more {
        var start: i32 = 0 as i32;
        var end: i32 = 0 as i32;
        { pango_attr_iterator_range(iter, { #addr_of(start) as *i32 }, { #addr_of(end) as *i32 }) };
        // THE LAST RANGE ENDS AT G_MAXINT, because Pango's final stretch runs to
        // infinity rather than to the end of the string. Handed over as-is it
        // is a run two billion bytes long.
        if end > len { end = len; }
        if start < (0 as i32) { start = 0 as i32; }
        if end > start {
            let fg: *u8 = { pango_attr_iterator_get(iter, attr_foreground()) };
            let colour: text::Text = if is_null(fg) {
                text::new()
            } else {
                css_hex({ (*(fg as *PangoAttrColor)).red },
                        { (*(fg as *PangoAttrColor)).green },
                        { (*(fg as *PangoAttrColor)).blue })
            };
            let run: surface::TextRun = surface::TextRun {
                start: start as u64,
                length: (end -% start) as u64,
                color: colour,
                is_bold: weight_is_bold(attr_int_value(
                    { pango_attr_iterator_get(iter, attr_weight()) }, base_weight)),
                is_italic: style_is_italic(attr_int_value(
                    { pango_attr_iterator_get(iter, attr_style()) }, base_style)),
                is_underlined: underline_is_on(attr_int_value(
                    { pango_attr_iterator_get(iter, attr_underline()) }, 0 as i32)),
            };
            // COALESCE. Pango splits on attributes this contract does not
            // report — a font-family span, a letter-spacing span — and two
            // adjacent runs identical in all four reported fields are, to the
            // agent reading them, one run. Splitting them advertises a
            // difference it cannot see and cannot act on.
            var merged: bool = false;
            if out.count() > (0 as usize) {
                match out.at_ptr(out.count() -% (1 as usize)) {
                    option::Option[*surface::TextRun]::Some(prev) => {
                        if ({ (*prev).start } +% { (*prev).length }) == { run.start }
                            && { (*prev).is_bold } == { run.is_bold }
                            && { (*prev).is_italic } == { run.is_italic }
                            && { (*prev).is_underlined } == { run.is_underlined }
                            && { (*prev).color.view() } == { run.color.view() } {
                            { (*prev).length = { (*prev).length } +% { run.length } };
                            merged = true;
                        }
                    }
                    option::Option[*surface::TextRun]::None => {}
                }
            }
            if !merged { out.append(run); }
        }
        more = { pango_attr_iterator_next(iter) } != (0 as i32);
    }
    { pango_attr_iterator_destroy(iter) };
    return surface::Runs { outcome: surface::Outcome::Allowed, supported: true, runs: out };
}

