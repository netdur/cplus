// permissions_backend_windows — the honest Windows answer, with one thing it
// can actually do.
//
// THIS FILE EXISTS SO A WINDOWS BUILD LINKS. `permissions.cplus` declares four
// stable symbols and something must define them on every platform the package
// claims; without a `_windows` sibling the build falls back to
// `permissions_backend.cplus` — the Apple half — and stops at `import
// "objc/runtime"`, which is not available here.
//
// STATE IS `Unsupported`, like Linux and for a similar reason. A classic Win32
// desktop process has no per-app authorization object to read: camera, mic and
// location are governed by GLOBAL Settings toggles (and, for packaged apps, a
// capability manifest), and reading those without asking needs WinRT
// (`Windows.Security.Authorization` / `Windows.Devices.Enumeration`) that this
// pass does not pull in. `Unsupported`, never `Denied` — "the person said no"
// and "this build cannot ask" call for opposite responses, and a Windows build
// that reported refusals would show a settings button on every screen.
//
// `open_settings` IS REAL, though, which is the difference from the Linux stub.
// Windows 10+ deep-links every privacy domain through the `ms-settings:` URI
// scheme, and `ShellExecuteA` on one opens exactly that pane. shell32 is already
// on `cpc`'s Windows link line, so the one extern needs no manifest entry.

import "stdlib/text" as text;
import "stdlib/option" as option;
import "./permissions" as perm;

// ShellExecuteA — the ANSI door is enough here: every `ms-settings:` URI and the
// verb "open" are ASCII, so there is nothing a wide call would carry that this
// one drops. Returns an HINSTANCE-shaped handle; a value ABOVE 32 is success,
// 32-and-below is one of the documented error codes.
#[link_name = "ShellExecuteA"]
extern fn ShellExecuteA(hwnd: *u8, op: *u8, file: *u8, params: *u8,
                        dir: *u8, show: i32) -> *u8;

// The Settings pane for a portable permission name. Split from `open_settings`
// so the mapping is testable without launching the Settings app. An unknown
// name — or the empty pane an app passes for "my settings" — lands on the
// privacy dashboard, which always exists on Windows 10+, so the verb can always
// honestly report that a pane opened.
fn _pane_uri(name: str) -> str {
    if name == perm::CAMERA { return "ms-settings:privacy-webcam"; }
    if name == perm::MICROPHONE { return "ms-settings:privacy-microphone"; }
    if name == perm::LOCATION_WHEN_IN_USE { return "ms-settings:privacy-location"; }
    if name == perm::LOCATION_ALWAYS { return "ms-settings:privacy-location"; }
    if name == perm::CONTACTS { return "ms-settings:privacy-contacts"; }
    if name == perm::CALENDAR { return "ms-settings:privacy-calendar"; }
    if name == perm::PHOTOS_READ { return "ms-settings:privacy-pictures"; }
    if name == perm::PHOTOS_ADD { return "ms-settings:privacy-pictures"; }
    if name == perm::NOTIFICATIONS { return "ms-settings:notifications"; }
    return "ms-settings:privacy";
}

export extern fn cplus_permissions_state_v1(name_ptr: *u8, name_len: usize) -> u32 {
    let _n: str = { #str_from_raw_parts(name_ptr, name_len) };
    return perm::State::Unsupported.to_code();
}

// 0 when a pane opened, non-zero when it did not. `ShellExecuteA`'s handle is
// >32 on success.
export extern fn cplus_permissions_open_settings_v1(name_ptr: *u8, name_len: usize) -> i32 {
    let name: str = { #str_from_raw_parts(name_ptr, name_len) };
    let uri: str = _pane_uri(name);
    match text::from_str(uri).c_str() {
        option::Option[text::CString]::Some(cs) => {
            let h: *u8 = { ShellExecuteA(0 as *u8, { #str_ptr("open\0") }, cs.as_ptr(),
                                         0 as *u8, 0 as *u8, 1 as i32) };
            if (h as usize) > (32 as usize) { return 0 as i32; }
            return 1 as i32;
        }
        option::Option[text::CString]::None => { return 1 as i32; }
    }
}

// The callback still runs, and still gets `Unsupported`. A Windows build that
// answered nothing would hang every caller that waits for the answer before
// showing a screen.
export extern fn cplus_permissions_request_v1(name_ptr: *u8, name_len: usize,
                                              cb_raw: *u8, ctx: *u8) -> i32 {
    if cb_raw.is_null() { return 1 as i32; }
    let cb: fn(str, perm::State, *u8) = { cb_raw as fn(str, perm::State, *u8) };
    cb({ #str_from_raw_parts(name_ptr, name_len) }, perm::State::Unsupported, ctx);
    return 0 as i32;
}

export extern fn cplus_permissions_request_many_v1(names: *str, count: usize,
                                                   cb_raw: *u8, ctx: *u8) -> i32 {
    if cb_raw.is_null() { return 1 as i32; }
    let cb: fn(str, perm::State, *u8) = { cb_raw as fn(str, perm::State, *u8) };
    var i: usize = 0 as usize;
    while i < count {
        cb({ *(names + i) }, perm::State::Unsupported, ctx);
        i = i +% (1 as usize);
    }
    return 0 as i32;
}

// ---- tests -------------------------------------------------------------------
// The pane mapping is asserted here; the ACTUAL launch is not, because a test
// that ran `ShellExecuteA` would pop the Settings app open on the test machine.

#[test]
fn every_name_is_unsupported_and_none_is_denied() {
    assert { cplus_permissions_state_v1(#str_ptr("camera"), #str_len("camera")) } == perm::State::Unsupported.to_code();
    assert { cplus_permissions_state_v1(#str_ptr("camera"), #str_len("camera")) } != perm::State::Denied.to_code();
    assert { cplus_permissions_state_v1(#str_ptr(""), #str_len("")) } == perm::State::Unsupported.to_code();
}

#[test]
fn known_panes_map_to_their_ms_settings_uri() {
    assert _pane_uri("camera") == "ms-settings:privacy-webcam";
    assert _pane_uri("microphone") == "ms-settings:privacy-microphone";
    assert _pane_uri("location.when_in_use") == "ms-settings:privacy-location";
    assert _pane_uri("location.always") == "ms-settings:privacy-location";
    assert _pane_uri("notifications") == "ms-settings:notifications";
}

#[test]
fn an_unknown_pane_falls_back_to_the_privacy_dashboard() {
    // Better a real page than none: an unheard-of name, and the empty "my
    // settings" pane, both land on the dashboard that always exists.
    assert _pane_uri("not.a.real.permission") == "ms-settings:privacy";
    assert _pane_uri("") == "ms-settings:privacy";
}

static _W_SEEN: i32 = 0 as i32;
static _W_LAST: u32 = 99 as u32;
fn _w_probe(name: str, s: perm::State, ctx: *u8) {
    _W_SEEN = _W_SEEN + (1 as i32);
    _W_LAST = s.to_code();
    return;
}

#[test]
fn request_answers_unsupported_and_always_calls_back() {
    _W_SEEN = 0 as i32;
    let f: fn(str, perm::State, *u8) = _w_probe;
    let rc: i32 = { cplus_permissions_request_v1(#str_ptr("camera"), #str_len("camera"),
                                                 { f as *u8 }, 0 as *u8) };
    assert rc == (0 as i32);
    assert _W_SEEN == (1 as i32);
    assert _W_LAST == perm::State::Unsupported.to_code();
}
