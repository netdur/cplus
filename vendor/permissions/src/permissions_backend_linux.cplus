// permissions_backend_linux — the honest Linux answer, which is "cannot ask".
//
// THIS FILE EXISTS SO A LINUX BUILD LINKS. `permissions.cplus` declares two
// stable symbols and something has to define them on every platform the package
// claims to build for; without this the failure is an undefined symbol at link
// time in the CONSUMER's build, naming a mangled C+ symbol.
//
// WHY NOT THE PORTAL, and it is parked rather than forgotten. Linux's answer is
// `xdg-desktop-portal` over D-Bus — `org.freedesktop.portal.Camera`,
// `.Location`. Two things keep it out of this pass: the standing backend
// priority is AppKit first, and more interestingly the portal model has NO
// CHECK-WITHOUT-ASKING. There is no "what is my current state" call at all; a
// portal request either opens a dialog or returns a cached answer, and which
// one happened is not visible to the caller. So `state` is structurally
// unanswerable on Linux even after the portal is built, and this file's
// `Unsupported` is not only the stub answer — it is close to the permanent one
// for that verb.
//
// `Unsupported`, never `Denied`. The difference is the whole reason
// `permissions.cplus` carries both: "the person said no" and "this build cannot
// ask" call for opposite responses from an application, and a Linux build that
// reported refusals would have every app showing a settings button for a
// settings page that does not exist.

import "./permissions" as perm;

export extern fn cplus_permissions_state_v1(name_ptr: *u8, name_len: usize) -> u32 {
    return perm::State::Unsupported.to_code();
}

// 1, not 0: there is no pane, and `open_settings` must report that rather than
// claim it opened one.
export extern fn cplus_permissions_open_settings_v1(name_ptr: *u8, name_len: usize) -> i32 {
    return 1 as i32;
}

// The callback still runs, and still gets `Unsupported`. A Linux build that
// answered nothing would hang every caller that waits for the answer before
// showing a screen.
export extern fn cplus_permissions_request_v1(name_ptr: *u8, name_len: usize,
                                              cb_raw: *u8, ctx: *u8) -> i32 {
    if cb_raw.is_null() { return 1 as i32; }
    let cb: fn(str, perm::State, *u8) = { cb_raw as fn(str, perm::State, *u8) };
    cb({ #str_from_raw_parts(name_ptr, name_len) }, perm::State::Unsupported, ctx);
    return 0 as i32;
}

export extern fn cplus_permissions_request_many_v1(names: *str, count: usize,
                                                   cb_raw: *u8, ctx: *u8) -> i32 {
    if cb_raw.is_null() { return 1 as i32; }
    let cb: fn(str, perm::State, *u8) = { cb_raw as fn(str, perm::State, *u8) };
    var i: usize = 0 as usize;
    while i < count {
        cb({ *(names + i) }, perm::State::Unsupported, ctx);
        i = i +% (1 as usize);
    }
    return 0 as i32;
}

#[test]
fn every_name_is_unsupported_and_none_is_denied() {
    assert { cplus_permissions_state_v1(#str_ptr("camera"), #str_len("camera")) } == perm::State::Unsupported.to_code();
    assert { cplus_permissions_state_v1(#str_ptr("camera"), #str_len("camera")) } != perm::State::Denied.to_code();
    assert { cplus_permissions_state_v1(#str_ptr(""), #str_len("")) } == perm::State::Unsupported.to_code();
}

#[test]
fn opening_settings_reports_that_there_is_no_pane() {
    assert { cplus_permissions_open_settings_v1(#str_ptr("camera"), #str_len("camera")) } != (0 as i32);
}
