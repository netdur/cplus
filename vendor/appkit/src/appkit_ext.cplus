// vendor/appkit/src/appkit_ext.cplus — hand-written companion to the generated
// AppKit binding. It does NOT edit `appkit.cplus` (which is machine-generated);
// it only composes the existing runtime + synthesis helpers to add the things the
// generator can't know to emit. Import it as `appkit/appkit_ext`.
//
// Currently: a flipped NSView (top-left origin). `NSView.isFlipped` is
// override-only in AppKit, so the standard fix is a one-method subclass whose
// isFlipped returns YES — which is exactly what this builds at runtime.

import "objc/runtime" as rt;
import "objc/synthesis" as synth;
import "objc/bridge" as bridge;
import "stdlib/text" as text;
import "stdlib/vec" as vec;
import "stdlib/option" as option;
import "appkit/appkit" as ak;

// `class_addMethod` for a `BOOL (self, _cmd)` method (isFlipped). This shape isn't
// in objc/synthesis yet, so declare it locally — the generated binding declares
// its own delegate shims the same way (`#[link_name = "class_addMethod"]`).
#[link_name = "class_addMethod"]
extern fn add_method_bool_0(cls: *u8, sel: *u8, imp: fn(*u8, *u8) -> i8, types: *u8) -> i8;

// The override: -[isFlipped] -> YES.
fn flipped_is_flipped_imp(self_obj: *u8, cmd: *u8) -> i8 { return 1 as i8; }

// The NSView subclass whose isFlipped is YES. Registered once; reused thereafter
// (`get_class` returns null until the pair is registered).
fn flipped_view_class() -> *u8 {
    let existing: *u8 = rt::get_class(#str_ptr("FlexFlippedView\0"));
    if existing != (0 as *u8) { return existing; }
    let cls: *u8 = synth::allocate_class_pair(rt::get_class(#str_ptr("NSView\0")), #str_ptr("FlexFlippedView\0"), 0 as usize);
    add_method_bool_0(cls, rt::sel(#str_ptr("isFlipped\0")), flipped_is_flipped_imp, #str_ptr("c@:\0"));
    synth::register_class_pair(cls);
    return cls;
}

// A flipped view (top-left origin), constructible like any other view. Use it as
// a scroll view's document view — the first row then sits at the top by
// construction, with no manual scroll-to-top afterwards.
fn new_flipped_view(frame: rt::Rect) -> ak::View {
    let alloced: *u8 = rt::msg_id(flipped_view_class(), rt::sel(#str_ptr("alloc\0")));
    let inited: *u8 = rt::msg_id_rect(alloced, rt::sel(#str_ptr("initWithFrame:\0")), frame);
    // `from_raw` retains; autorelease balances the +1 from `alloc`, so the returned
    // View owns exactly one reference (released by its `drop`).
    return ak::View::from_raw(rt::autorelease(inited));
}

// ---- target/action with userdata ------------------------------------------
//
// The generated binding's `set_on_action` carries a bare `fn(*u8)` (sender
// only), which forces per-item state into side channels (`setTag:` + a
// global). This companion adds the ctx-carrying variant: the handler
// receives `(sender, ctx)`, where `ctx` is an opaque pointer chosen at wiring
// time. The caller owns `ctx` (an integer index smuggled as a pointer needs
// no ownership at all); the target object itself is pinned to the control via
// an associated reference, so it lives exactly as long as the control.

// Associated-object keys. Any unique addresses work; the generated binding
// uses 28672/28673, so this module takes the next block.
fn action_ctx_handler_key() -> *u8 { return { 28680 as *u8 }; }
fn action_ctx_userdata_key() -> *u8 { return { 28681 as *u8 }; }
fn action_ctx_pin_key() -> *u8 { return { 28682 as *u8 }; }

fn action_ctx_imp(self_obj: *u8, cmd: *u8, sender: *u8) {
    let f: fn(*u8, *u8) = { synth::get_associated(self_obj, action_ctx_handler_key()) as fn(*u8, *u8) };
    let ctx: *u8 = synth::get_associated(self_obj, action_ctx_userdata_key());
    f(sender, ctx);
    return;
}

// The selector our target answers. Exposed so a caller can wire the pair
// onto anything that takes target/action (gesture recognizers, menu items).
fn action_ctx_sel() -> *u8 { return rt::sel(#str_ptr("cplusActionCtx:\0")); }

// A fresh autoreleased target answering `action_ctx_sel()` with `handler`
// and `ctx` attached. The caller must keep it alive (pin it to the owning
// object) — `set_control_action_ctx` below does both steps.
fn action_ctx_target(handler: fn(*u8, *u8), ctx: *u8) -> *u8 {
    let name: *u8 = #str_ptr("CplusExt_ActionCtxTarget\0");
    var cls: *u8 = rt::get_class(name);
    if cls == { 0 as *u8 } {
        cls = synth::allocate_class_pair(rt::get_class(#str_ptr("NSObject\0")), name, 0 as usize);
        let added: i8 = cplus_ext_add_action_method(cls, action_ctx_sel(), action_ctx_imp, #str_ptr("v@:@\0"));
        synth::register_class_pair(cls);
    }
    let t: *u8 = synth::alloc_init_class(cls);
    synth::set_associated(t, action_ctx_handler_key(), { handler as *u8 });
    synth::set_associated(t, action_ctx_userdata_key(), ctx);
    return t;
}

// Wire a control to `handler(sender, ctx)`: build the target, pin it to the
// control, and set target/action.
fn set_control_action_ctx(control: ak::Control, handler: fn(*u8, *u8), ctx: *u8) {
    let t: *u8 = action_ctx_target(handler, ctx);
    synth::retain_associated(control.raw(), action_ctx_pin_key(), t);
    rt::msg_void_id(control.raw(), rt::sel(#str_ptr("setTarget:\0")), t);
    rt::msg_void_id(control.raw(), rt::sel(#str_ptr("setAction:\0")), action_ctx_sel());
    return;
}

// `class_addMethod` for the `void (self, _cmd, id)` action shape — declared
// locally, exactly as the generated binding declares its shims.
#[link_name = "class_addMethod"]
extern fn cplus_ext_add_action_method(cls: *u8, sel: *u8, imp: fn(*u8, *u8, *u8), types: *u8) -> i8;


// ---- target/action with a ctx-aware after-hook ------------------------------
// Like `set_control_action_ctx_then`, but `after` RECEIVES the same ctx the
// handler got. This is the component runtime's re-render hook: the ctx is
// the component's address, the handler mutates it, `after(ctx)` re-renders
// exactly that component (a non-component ctx misses the registry and
// no-ops). One documented rule, keyed by identity, no hidden subscriptions.

fn action_after_ctx_key() -> *u8 { return { 28684 as *u8 }; }

fn action_ctx_then_ctx_imp(self_obj: *u8, cmd: *u8, sender: *u8) {
    let f: fn(*u8, *u8) = { synth::get_associated(self_obj, action_ctx_handler_key()) as fn(*u8, *u8) };
    let ctx: *u8 = synth::get_associated(self_obj, action_ctx_userdata_key());
    let after: fn(*u8) = { synth::get_associated(self_obj, action_after_ctx_key()) as fn(*u8) };
    f(sender, ctx);
    after(ctx);
    return;
}

fn action_ctx_then_ctx_sel() -> *u8 { return rt::sel(#str_ptr("cplusActionCtxThenCtx:\0")); }

fn action_ctx_then_ctx_target(handler: fn(*u8, *u8), ctx: *u8, after: fn(*u8)) -> *u8 {
    let name: *u8 = #str_ptr("CplusExt_ActionCtxThenCtxTarget\0");
    var cls: *u8 = rt::get_class(name);
    if cls == { 0 as *u8 } {
        cls = synth::allocate_class_pair(rt::get_class(#str_ptr("NSObject\0")), name, 0 as usize);
        let added: i8 = cplus_ext_add_action_method(cls, action_ctx_then_ctx_sel(), action_ctx_then_ctx_imp, #str_ptr("v@:@\0"));
        synth::register_class_pair(cls);
    }
    let t: *u8 = synth::alloc_init_class(cls);
    synth::set_associated(t, action_ctx_handler_key(), { handler as *u8 });
    synth::set_associated(t, action_ctx_userdata_key(), ctx);
    synth::set_associated(t, action_after_ctx_key(), { after as *u8 });
    return t;
}

// Wire a control to `handler(sender, ctx)` followed by `after(ctx)`.
fn set_control_action_ctx_then_ctx(control: ak::Control, handler: fn(*u8, *u8), ctx: *u8, after: fn(*u8)) {
    let t: *u8 = action_ctx_then_ctx_target(handler, ctx, after);
    synth::retain_associated(control.raw(), action_ctx_pin_key(), t);
    rt::msg_void_id(control.raw(), rt::sel(#str_ptr("setTarget:\0")), t);
    rt::msg_void_id(control.raw(), rt::sel(#str_ptr("setAction:\0")), action_ctx_then_ctx_sel());
    return;
}

// ==========================================================================
// Gesture recognizers -> C+ handler
// ==========================================================================
//
// An actionable *container* (a laid-out row/card, not a control) responds to
// clicks and trackpad gestures via NSGestureRecognizers attached to its NSView.
// A recognizer's `action:(sender)` has the same shape as a control's, so we
// reuse the ActionCtx target: `handler(recognizer, ctx)`. Each recognizer pins
// its own target (so it lives as long as the recognizer, which the view owns).

fn gesture_pin_key() -> *u8 { return { 28685 as *u8 }; }

// NSEvent button masks: primary (left) = 1<<0, secondary (right) = 1<<1.
fn primary_button_mask() -> u64 { return 1 as u64; }
fn secondary_button_mask() -> u64 { return 2 as u64; }

// Pin an ActionCtx target to a recognizer and set its target/action.
fn wire_gesture(recognizer: *u8, handler: fn(*u8, *u8), ctx: *u8) {
    let t: *u8 = action_ctx_target(handler, ctx);
    synth::retain_associated(recognizer, gesture_pin_key(), t);
    rt::msg_void_id(recognizer, rt::sel(#str_ptr("setTarget:\0")), t);
    rt::msg_void_id(recognizer, rt::sel(#str_ptr("setAction:\0")), action_ctx_sel());
    return;
}

// Click / double-click / right-click. `clicks` = 1 or 2; `buttons` selects
// primary (left) vs secondary (right) via the button-mask helpers above.
fn add_click_gesture(view: ak::View, handler: fn(*u8, *u8), ctx: *u8, clicks: i64, buttons: u64) {
    let g: ak::ClickGestureRecognizer = ak::ClickGestureRecognizer::new();
    g.set_number_of_clicks_required(clicks);
    g.set_button_mask(buttons);
    wire_gesture(g.raw(), handler, ctx);
    view.add_gesture_recognizer(g.as_gesture_recognizer());
    return;
}

// Press-and-hold. `min_duration` seconds before the handler fires (0 = the
// system default).
fn add_press_gesture(view: ak::View, handler: fn(*u8, *u8), ctx: *u8, min_duration: f64) {
    let g: ak::PressGestureRecognizer = ak::PressGestureRecognizer::new();
    if min_duration > 0.0f64 { g.set_minimum_press_duration(min_duration); }
    wire_gesture(g.raw(), handler, ctx);
    view.add_gesture_recognizer(g.as_gesture_recognizer());
    return;
}

// Drag (pan). The handler reads the recognizer for translation/state.
fn add_pan_gesture(view: ak::View, handler: fn(*u8, *u8), ctx: *u8) {
    let g: ak::PanGestureRecognizer = ak::PanGestureRecognizer::new();
    wire_gesture(g.raw(), handler, ctx);
    view.add_gesture_recognizer(g.as_gesture_recognizer());
    return;
}

// Pinch-to-zoom (trackpad). The handler reads the recognizer for magnification.
fn add_magnify_gesture(view: ak::View, handler: fn(*u8, *u8), ctx: *u8) {
    let g: ak::MagnificationGestureRecognizer = ak::MagnificationGestureRecognizer::new();
    wire_gesture(g.raw(), handler, ctx);
    view.add_gesture_recognizer(g.as_gesture_recognizer());
    return;
}

// Two-finger rotate (trackpad). The handler reads the recognizer for rotation.
fn add_rotate_gesture(view: ak::View, handler: fn(*u8, *u8), ctx: *u8) {
    let g: ak::RotationGestureRecognizer = ak::RotationGestureRecognizer::new();
    wire_gesture(g.raw(), handler, ctx);
    view.add_gesture_recognizer(g.as_gesture_recognizer());
    return;
}

// ==========================================================================
// Hover + scroll -> C+ handler (a custom view, not a gesture)
// ==========================================================================
//
// Mouse enter/exit and scroll aren't gestures: they need a view that owns an
// NSTrackingArea (hover) and overrides scrollWheel: (scroll). One synthesized
// NSView subclass carries all three handlers + ctx on the instance. A tracking
// area is added only when a hover handler is set (InVisibleRect auto-follows the
// view; facet re-mounts fresh views each render, so one at construction is
// enough). scrollWheel: chains to super, so a scroll still bubbles up to an
// enclosing scroll view — the handler only observes it.

fn av_hover_in_key() -> *u8 { return { 28686 as *u8 }; }
fn av_hover_out_key() -> *u8 { return { 28687 as *u8 }; }
fn av_scroll_key() -> *u8 { return { 28688 as *u8 }; }
fn av_ctx_key() -> *u8 { return { 28689 as *u8 }; }

fn av_call(self_obj: *u8, key: *u8, sender: *u8) {
    let f: fn(*u8, *u8) = { synth::get_associated(self_obj, key) as fn(*u8, *u8) };
    if { f } == (0 as fn(*u8, *u8)) { return; }
    f(sender, synth::get_associated(self_obj, av_ctx_key()));
    return;
}
// Hover handlers receive the view; scroll receives the NSEvent (read deltas).
fn av_entered_imp(self_obj: *u8, cmd: *u8, event: *u8) { av_call(self_obj, av_hover_in_key(), self_obj); return; }
fn av_exited_imp(self_obj: *u8, cmd: *u8, event: *u8) { av_call(self_obj, av_hover_out_key(), self_obj); return; }
fn av_scroll_imp(self_obj: *u8, cmd: *u8, event: *u8) {
    av_call(self_obj, av_scroll_key(), event);
    call_super_void_id(self_obj, rt::get_class(#str_ptr("NSView\0")), rt::sel(#str_ptr("scrollWheel:\0")), event);
    return;
}

// objc_msgSendSuper for a `void (self, _cmd, id)` method — chain to NSView's
// default (keep scroll propagating up the responder chain).
struct ObjcSuper { opaque receiver: *u8, opaque super_class: *u8 }
#[link_name = "objc_msgSendSuper"]
extern fn msg_super_void_id(sup: *ObjcSuper, sel: *u8, arg: *u8);
fn call_super_void_id(self_obj: *u8, super_cls: *u8, sel: *u8, arg: *u8) {
    var sup: ObjcSuper = ObjcSuper { receiver: self_obj, super_class: super_cls };
    msg_super_void_id(#addr_of(sup), sel, arg);
    return;
}

fn actionable_view_class() -> *u8 {
    let existing: *u8 = rt::get_class(#str_ptr("CplusExtActionableView\0"));
    if existing != (0 as *u8) { return existing; }
    let cls: *u8 = synth::allocate_class_pair(rt::get_class(#str_ptr("NSView\0")), #str_ptr("CplusExtActionableView\0"), 0 as usize);
    let a: i8 = synth::add_method_v_1id(cls, rt::sel(#str_ptr("mouseEntered:\0")), av_entered_imp, #str_ptr("v@:@\0"));
    let b: i8 = synth::add_method_v_1id(cls, rt::sel(#str_ptr("mouseExited:\0")), av_exited_imp, #str_ptr("v@:@\0"));
    let c: i8 = synth::add_method_v_1id(cls, rt::sel(#str_ptr("scrollWheel:\0")), av_scroll_imp, #str_ptr("v@:@\0"));
    // A hover/scroll clickable can also carry a click handler; answer
    // performClick: too so it's agent-openable (agent_click_imp reads the
    // handler `set_agent_click` attaches, distinct from the av_* hover keys).
    let d: i8 = synth::add_method_v_1id(cls, rt::sel(#str_ptr("performClick:\0")), agent_click_imp, #str_ptr("v@:@\0"));
    synth::register_class_pair(cls);
    return cls;
}

// `[[NSTrackingArea alloc] initWithRect:options:owner:userInfo:]` — the binding
// skips it (the NSDictionary userInfo), so call objc_msgSend directly (nil
// userInfo). NSRect passes by value in the C ABI.
#[link_name = "objc_msgSend"]
extern fn msg_init_tracking(obj: *u8, sel: *u8, rect: rt::Rect, options: u64, owner: *u8, user_info: *u8) -> *u8;

// A view reporting hover (mouse enter/exit) and/or scroll. Any handler may be
// the null sentinel (ignored). A tracking area is added only when a hover
// handler is set; scrollWheel always chains to super so scrolling still bubbles.
fn new_actionable_view(frame: rt::Rect, on_in: fn(*u8, *u8), on_out: fn(*u8, *u8), on_scroll: fn(*u8, *u8), ctx: *u8) -> ak::View {
    let none: fn(*u8, *u8) = 0 as fn(*u8, *u8);
    let alloced: *u8 = rt::msg_id(actionable_view_class(), rt::sel(#str_ptr("alloc\0")));
    let inited: *u8 = rt::msg_id_rect(alloced, rt::sel(#str_ptr("initWithFrame:\0")), frame);
    synth::set_associated(inited, av_hover_in_key(), { on_in as *u8 });
    synth::set_associated(inited, av_hover_out_key(), { on_out as *u8 });
    synth::set_associated(inited, av_scroll_key(), { on_scroll as *u8 });
    synth::set_associated(inited, av_ctx_key(), ctx);
    if { on_in } != none || { on_out } != none {
        // MouseEnteredAndExited (0x01) | ActiveInKeyWindow (0x20) | InVisibleRect (0x200).
        let ta_alloc: *u8 = rt::msg_id(rt::get_class(#str_ptr("NSTrackingArea\0")), rt::sel(#str_ptr("alloc\0")));
        let ta: *u8 = msg_init_tracking(ta_alloc, rt::sel(#str_ptr("initWithRect:options:owner:userInfo:\0")), frame, 545 as u64, inited, 0 as *u8);
        rt::msg_void_id(inited, rt::sel(#str_ptr("addTrackingArea:\0")), ta);
        rt::release(ta);
    }
    return ak::View::from_raw(rt::autorelease(inited));
}

// ==========================================================================
// Agent-clickable views — answer `performClick:` (the agent-drive path)
// ==========================================================================
//
// A facet `clickable` fires its handler through an NSClickGestureRecognizer,
// which only the user's mouse triggers. The agent surface drives a control by
// sending `performClick:` (agent_appkit `click`) — a selector a plain NSView
// doesn't answer, so a whole-row `clickable` tagged with an agent_id couldn't
// be opened over the app MCP (and the send would raise unrecognized-selector).
// These NSView subclasses implement `performClick:` to fire the SAME primary
// single-click handler the gesture calls, so a tagged clickable is openable by
// both the mouse (via the gesture) and the agent (via performClick:) — the two
// are independent triggers of one handler, no double-fire. `set_agent_click`
// attaches that handler; a null handler (a clickable with only e.g. a
// double-click) makes `performClick:` a no-op.

fn agent_click_handler_key() -> *u8 { return { 28692 as *u8 }; }
fn agent_click_ctx_key() -> *u8 { return { 28693 as *u8 }; }

fn agent_click_imp(self_obj: *u8, cmd: *u8, sender: *u8) {
    let f: fn(*u8, *u8) = { synth::get_associated(self_obj, agent_click_handler_key()) as fn(*u8, *u8) };
    if { f } == (0 as fn(*u8, *u8)) { return; }
    // Fire with the view as sender, matching the gesture path (whose recognizer
    // handler also receives the clicked surface). ctx is the component pointer.
    f(self_obj, synth::get_associated(self_obj, agent_click_ctx_key()));
    return;
}

// Attach the primary-click handler + ctx so the view answers `performClick:`.
// The view's class must implement performClick: (`new_clickable_view` and
// `new_actionable_view` do); called after wiring the click gesture.
fn set_agent_click(view: ak::View, handler: fn(*u8, *u8), ctx: *u8) {
    synth::set_associated(view.raw(), agent_click_handler_key(), { handler as *u8 });
    synth::set_associated(view.raw(), agent_click_ctx_key(), ctx);
    return;
}

// A plain container NSView that also answers `performClick:` (agent-drive).
// A `clickable`'s backing view when it has no hover/scroll handler (those need
// the actionable subclass, which answers performClick: too).
fn clickable_view_class() -> *u8 {
    let existing: *u8 = rt::get_class(#str_ptr("CplusExtClickableView\0"));
    if existing != (0 as *u8) { return existing; }
    let cls: *u8 = synth::allocate_class_pair(rt::get_class(#str_ptr("NSView\0")), #str_ptr("CplusExtClickableView\0"), 0 as usize);
    let a: i8 = synth::add_method_v_1id(cls, rt::sel(#str_ptr("performClick:\0")), agent_click_imp, #str_ptr("v@:@\0"));
    synth::register_class_pair(cls);
    return cls;
}

fn new_clickable_view(frame: rt::Rect) -> ak::View {
    let alloced: *u8 = rt::msg_id(clickable_view_class(), rt::sel(#str_ptr("alloc\0")));
    let inited: *u8 = rt::msg_id_rect(alloced, rt::sel(#str_ptr("initWithFrame:\0")), frame);
    return ak::View::from_raw(rt::autorelease(inited));
}

// ==========================================================================
// Composer — an NSTextView delegate for Enter-to-send / Shift+Enter-newline
// plus a per-edit change hook. NSTextView's `delegate` is a WEAK reference, so
// the delegate object is pinned to the text view; the routing context and the
// (generated) TextViewDelegate struct are heap-boxed and leaked — they live for
// the text view's lifetime, which for a composer is the app's lifetime.
// ==========================================================================

extern fn malloc(n: usize) -> *u8;

// The context the trampolines dispatch through. `caller_ctx` is the component /
// user pointer the app passed; either fn-pointer may be null (a null `on_change`
// means "no change hook").
struct ComposerCtx {
    on_change: fn(*u8, *u8),
    on_submit: fn(*u8, *u8),
    opaque caller_ctx: *u8,
}

fn composer_pin_key() -> *u8 { return { 28690 as *u8 }; }

// `+[NSEvent modifierFlags]` — the modifier keys held down right now.
fn composer_shift_is_down() -> bool {
    let flags: u64 = { rt::msg_u64(rt::get_class(#str_ptr("NSEvent\0")), rt::sel(#str_ptr("modifierFlags\0"))) };
    return (flags & ak::event_modifier_flags_n_s_event_modifier_flag_shift) != (0 as u64);
}

fn composer_did_change_imp(user: *u8, tv: *u8) {
    let c: *ComposerCtx = { user as *ComposerCtx };
    let f: fn(*u8, *u8) = { (*c).on_change };
    if { f as *u8 } != { 0 as *u8 } { f({ (*c).caller_ctx }, tv); }
    return;
}

fn composer_do_command_imp(user: *u8, tv: *u8, sel: *u8) -> i8 {
    // Enter with no Shift submits and swallows the newline; Shift+Enter (and any
    // other command) falls through to the text view's default handling.
    if sel == rt::sel(#str_ptr("insertNewline:\0")) {
        if !composer_shift_is_down() {
            let c: *ComposerCtx = { user as *ComposerCtx };
            let f: fn(*u8, *u8) = { (*c).on_submit };
            if { f as *u8 } != { 0 as *u8 } { f({ (*c).caller_ctx }, tv); }
            return 1 as i8;   // handled -> no newline inserted
        }
    }
    return 0 as i8;   // not handled -> default behavior
}

// Attach a composer delegate to `tv`: `on_change(caller_ctx, tv)` fires on every
// edit, `on_submit(caller_ctx, tv)` on Enter (Shift+Enter inserts a newline
// instead). Either fn-pointer may be null. The delegate is pinned to `tv`.
fn attach_composer_delegate(tv: ak::TextView, on_change: fn(*u8, *u8), on_submit: fn(*u8, *u8), caller_ctx: *u8) {
    let cbox: *ComposerCtx = { malloc(#size_of::[ComposerCtx]()) as *ComposerCtx };
    { *cbox = ComposerCtx { on_change: on_change, on_submit: on_submit, caller_ctx: caller_ctx }; }
    var del: ak::TextViewDelegate = ak::TextViewDelegate_new(cbox as *u8);
    del.set_text_view_did_change_selection(composer_did_change_imp);
    del.set_text_view_do_command_by_selector(composer_do_command_imp);
    let dbox: *ak::TextViewDelegate = { malloc(#size_of::[ak::TextViewDelegate]()) as *ak::TextViewDelegate };
    { *dbox = del; }
    let d: *u8 = ak::create_TextViewDelegate(dbox);
    tv.set_delegate(d);
    synth::retain_associated(tv.raw(), composer_pin_key(), d);
    return;
}

// ==========================================================================
// Split view — minimum pane sizes via NSSplitViewDelegate. The delegate is a
// weak property, so (like the composer) it is pinned to the split view and the
// min-size context is heap-boxed and leaked. Applies to a two-pane split with a
// single divider at index 0.
// ==========================================================================

struct SplitCtx {
    min_first: f64,
    min_second: f64,
    on_resize: fn(*u8),          // called after the panes re-lay (divider drag / resize)
    opaque resize_user: *u8,     // passed back to on_resize (the split view ptr)
}

fn split_pin_key() -> *u8 { return { 28691 as *u8 }; }

// Default resize hook: a split with no hosted panes (all leaf panes) does no
// extra work when the divider moves — NSSplitView autoresizes leaf panes itself.
fn split_noop_resize(user: *u8) { return; }

// NSSplitViewDelegate splitViewDidResizeSubviews: — fires when the panes are
// re-laid (initial sizing, window resize, divider drag). Forwards to the
// registered hook so a multi-element pane can reflow its subtree to the pane's
// new size. `notif` is the NSNotification (unused; the user ctx carries state).
fn split_did_resize_imp(user: *u8, notif: *u8) {
    let c: *SplitCtx = { user as *SplitCtx };
    let f: fn(*u8) = { (*c).on_resize };
    f({ (*c).resize_user });
    return;
}

// The lowest coordinate divider 0 may take = the first pane's minimum extent.
fn split_constrain_min_imp(user: *u8, sv: *u8, proposed: f64, divider: i64) -> f64 {
    let c: *SplitCtx = { user as *SplitCtx };
    if divider == (0 as i64) { return { (*c).min_first }; }
    return proposed;
}

// The highest coordinate divider 0 may take = split extent minus the second
// pane's minimum extent (measured along the split axis).
fn split_constrain_max_imp(user: *u8, sv: *u8, proposed: f64, divider: i64) -> f64 {
    let c: *SplitCtx = { user as *SplitCtx };
    if divider == (0 as i64) {
        let f: rt::Rect = ak::SplitView::from_raw(sv).as_view().frame();
        let extent: f64 = if ak::SplitView::from_raw(sv).is_vertical() { f.w } else { f.h };
        let cap: f64 = extent - { (*c).min_second };
        if proposed > cap { return cap; }
    }
    return proposed;
}

// Enforce `min_first` / `min_second` on a two-pane split view (divider 0).
// `on_resize` (with `resize_user`) is invoked on splitViewDidResizeSubviews:
// so a caller hosting multi-element panes can reflow them to their new size;
// leaf-only splits leave it at the default no-op.
fn attach_split_min_widths(sv: ak::SplitView, min_first: f64, min_second: f64, on_resize: fn(*u8) = split_noop_resize, resize_user: *u8 = 0 as *u8) {
    let cbox: *SplitCtx = { malloc(#size_of::[SplitCtx]()) as *SplitCtx };
    { *cbox = SplitCtx { min_first: min_first, min_second: min_second, on_resize: on_resize, resize_user: resize_user }; }
    var del: ak::SplitViewDelegate = ak::SplitViewDelegate_new(cbox as *u8);
    del.set_split_view_constrain_min_coordinate_of_subview_at(split_constrain_min_imp);
    del.set_split_view_constrain_max_coordinate_of_subview_at(split_constrain_max_imp);
    del.set_split_view_did_resize_subviews(split_did_resize_imp);
    let dbox: *ak::SplitViewDelegate = { malloc(#size_of::[ak::SplitViewDelegate]()) as *ak::SplitViewDelegate };
    { *dbox = del; }
    let d: *u8 = ak::create_SplitViewDelegate(dbox);
    sv.set_delegate(d);
    synth::retain_associated(sv.raw(), split_pin_key(), d);
    return;
}

// ==========================================================================
// Frame-change observer — run a C+ hook after a view resizes
// ==========================================================================
// For content a view caches by its size and must recompute on resize — e.g. an
// NSTableView's wrapped-text row heights, which go stale when the column width
// changes. Registers on NSViewFrameDidChangeNotification; the observer object is
// pinned to the view and lives exactly as long as it. `on_resize(ctx)` fires
// after every frame change (guard on width yourself to skip height-only ones).

fn frame_obs_handler_key() -> *u8 { return { 28697 as *u8 }; }
fn frame_obs_ctx_key() -> *u8 { return { 28698 as *u8 }; }
fn frame_obs_pin_key() -> *u8 { return { 28699 as *u8 }; }

fn frame_obs_sel() -> *u8 { return rt::sel(#str_ptr("cplusFrameDidChange:\0")); }

fn frame_obs_imp(self_obj: *u8, cmd: *u8, notif: *u8) {
    let f: fn(*u8) = { synth::get_associated(self_obj, frame_obs_handler_key()) as fn(*u8) };
    let ctx: *u8 = synth::get_associated(self_obj, frame_obs_ctx_key());
    f(ctx);
    return;
}

fn observe_frame_change(view: ak::View, on_resize: fn(*u8), ctx: *u8) {
    let name: *u8 = #str_ptr("CplusExt_FrameObserver\0");
    var cls: *u8 = rt::get_class(name);
    if cls == { 0 as *u8 } {
        cls = synth::allocate_class_pair(rt::get_class(#str_ptr("NSObject\0")), name, 0 as usize);
        let added: i8 = cplus_ext_add_action_method(cls, frame_obs_sel(), frame_obs_imp, #str_ptr("v@:@\0"));
        synth::register_class_pair(cls);
    }
    let t: *u8 = synth::alloc_init_class(cls);
    synth::set_associated(t, frame_obs_handler_key(), { on_resize as *u8 });
    synth::set_associated(t, frame_obs_ctx_key(), ctx);
    view.set_posts_frame_changed_notifications(true);
    let nc: *u8 = rt::msg_id(rt::get_class(#str_ptr("NSNotificationCenter\0")), rt::sel(#str_ptr("defaultCenter\0")));
    rt::msg_void_id_id_id_id(nc, rt::sel(#str_ptr("addObserver:selector:name:object:\0")), t, frame_obs_sel(), bridge::nsstring("NSViewFrameDidChangeNotification"), view.raw());
    synth::retain_associated(view.raw(), frame_obs_pin_key(), t);
    return;
}

// ==========================================================================
// Drag-and-drop DESTINATION -> C+ handler
// ==========================================================================
//
// A `FacetDropView` is a one-off NSView subclass conforming to the informal
// NSDraggingDestination protocol. draggingEntered: advertises Copy so the
// cursor shows a drop badge; performDragOperation: reads the pasteboard string,
// pins it on the view (so `drop_text_of` can hand it back), then fires the C+
// handler. Payload type is plain UTF-8 text (`public.utf8-plain-text`), which
// also matches text dragged from other apps and Finder text clippings.

fn drop_handler_key() -> *u8 { return { 28690 as *u8 }; }
fn drop_ctx_key() -> *u8 { return { 28691 as *u8 }; }
fn drop_text_key() -> *u8 { return { 28692 as *u8 }; }

// NSDragOperationCopy = 1.
fn drop_entered_imp(self_obj: *u8, cmd: *u8, sender: *u8) -> u64 { return 1 as u64; }
fn drop_prepare_imp(self_obj: *u8, cmd: *u8, sender: *u8) -> i8 { return 1 as i8; }

fn drop_perform_imp(self_obj: *u8, cmd: *u8, sender: *u8) -> i8 {
    let pb: *u8 = rt::msg_id(sender, rt::sel(#str_ptr("draggingPasteboard\0")));
    let ns: *u8 = rt::msg_id_id(pb, rt::sel(#str_ptr("stringForType:\0")), bridge::nsstring("public.utf8-plain-text"));
    synth::retain_associated(self_obj, drop_text_key(), ns);   // keep for drop_text_of (nil is fine)
    let f: fn(*u8, *u8) = { synth::get_associated(self_obj, drop_handler_key()) as fn(*u8, *u8) };
    let ctx: *u8 = synth::get_associated(self_obj, drop_ctx_key());
    if { f as *u8 } != { 0 as *u8 } { f(self_obj, ctx); }
    return 1 as i8;   // YES — accepted
}

fn drop_view_class() -> *u8 {
    let name: *u8 = #str_ptr("FacetDropView\0");
    var cls: *u8 = rt::get_class(name);
    if cls == { 0 as *u8 } {
        cls = synth::allocate_class_pair(rt::get_class(#str_ptr("NSView\0")), name, 0 as usize);
        let a1: i8 = synth::add_method_u64_1id(cls, rt::sel(#str_ptr("draggingEntered:\0")), drop_entered_imp, #str_ptr("Q@:@\0"));
        let a2: i8 = synth::add_method_i8_1id(cls, rt::sel(#str_ptr("prepareForDragOperation:\0")), drop_prepare_imp, #str_ptr("c@:@\0"));
        let a3: i8 = synth::add_method_i8_1id(cls, rt::sel(#str_ptr("performDragOperation:\0")), drop_perform_imp, #str_ptr("c@:@\0"));
        synth::register_class_pair(cls);
    }
    return cls;
}

// A fresh +1 FacetDropView registered for text drops, with `handler`/`ctx`
// attached. Frame is set later by the layout pass.
fn new_drop_view(handler: fn(*u8, *u8), ctx: *u8) -> ak::View {
    let cls: *u8 = drop_view_class();
    let v: *u8 = synth::alloc_init_class(cls);
    synth::set_associated(v, drop_handler_key(), { handler as *u8 });
    synth::set_associated(v, drop_ctx_key(), ctx);
    let view: ak::View = ak::View::from_raw(v);
    var types: vec::Vec[text::Text] = vec::new::[text::Text]();
    types.append(text::from_str("public.utf8-plain-text"));
    view.register_for_dragged_types(types);
    return view;
}

// The last string dropped on `drop_view` (empty if none / non-text). Call from
// an on_drop handler with its `sender`.
fn drop_text_of(drop_view: *u8) -> text::Text {
    let ns: *u8 = synth::get_associated(drop_view, drop_text_key());
    return bridge::to_text(ns);
}

// ==========================================================================
// Drag-and-drop SOURCE -> pasteboard text
// ==========================================================================
//
// A `FacetDragView` starts a copy drag carrying its associated text when the
// user presses inside it. It conforms to NSDraggingSource (advertising Copy for
// any context) and builds the drag preview from a snapshot of the view, so the
// dragged content follows the cursor. SwiftUI `.draggable`. Pairs with the
// FacetDropView destination above.

fn drag_text_key() -> *u8 { return { 28698 as *u8 }; }

// NSDragOperationCopy = 1, for a local or cross-app drag.
fn drag_source_mask_imp(self_obj: *u8, cmd: *u8, session: *u8, context: i64) -> u64 { return 1 as u64; }

fn drag_mousedown_imp(self_obj: *u8, cmd: *u8, event: *u8) {
    let ns: *u8 = synth::get_associated(self_obj, drag_text_key());
    if { ns as *u8 } == { 0 as *u8 } { return; }
    // one NSPasteboardItem carrying the payload as UTF-8 text
    let pbitem: *u8 = rt::msg_id(rt::msg_id(rt::get_class(#str_ptr("NSPasteboardItem\0")), rt::sel(#str_ptr("alloc\0"))), rt::sel(#str_ptr("init\0")));
    rt::msg_void_id_id(pbitem, rt::sel(#str_ptr("setString:forType:\0")), ns, bridge::nsstring("public.utf8-plain-text"));
    let ditem: ak::DraggingItem = ak::DraggingItem::new(ak::PasteboardWriting::from_raw(pbitem));
    let ditem_raw: *u8 = ditem.raw();
    rt::release(pbitem);   // the dragging item retained it
    let view: ak::View = ak::View::from_raw(self_obj);
    let rect: rt::Rect = view.bounds();
    // preview = a snapshot of the view, so something follows the cursor
    var contents: *u8 = 0 as *u8;
    match view.bitmap_image_rep_for_caching_display_in_rect(rect) {
        option::Option[ak::BitmapImageRep]::Some(rep) => {
            view.cache_display_in_rect(rect, rep);
            let img: *u8 = rt::msg_id(rt::msg_id(rt::get_class(#str_ptr("NSImage\0")), rt::sel(#str_ptr("alloc\0"))), rt::sel(#str_ptr("init\0")));
            rt::msg_void_id(img, rt::sel(#str_ptr("addRepresentation:\0")), rep.as_image_rep().raw());
            contents = img;
        }
        option::Option[ak::BitmapImageRep]::None => {}
    }
    ditem.set_dragging_frame_contents(rect, contents);
    if { contents as *u8 } != { 0 as *u8 } { rt::release(contents); }   // the item copied it
    var items: vec::Vec[ak::DraggingItem] = vec::new::[ak::DraggingItem]();
    items.append(ditem);
    let _s: ak::DraggingSession = view.begin_dragging_session_with_items(items, ak::Event::from_raw(event), ak::DraggingSource::from_raw(self_obj));
    rt::release(ditem_raw);   // the session retained it
    return;
}

fn drag_view_class() -> *u8 {
    let name: *u8 = #str_ptr("FacetDragView\0");
    var cls: *u8 = rt::get_class(name);
    if cls == { 0 as *u8 } {
        cls = synth::allocate_class_pair(rt::get_class(#str_ptr("NSView\0")), name, 0 as usize);
        let a1: i8 = synth::add_method_v_1id(cls, rt::sel(#str_ptr("mouseDown:\0")), drag_mousedown_imp, #str_ptr("v@:@\0"));
        let a2: i8 = synth::add_method_u64_1id_i64(cls, rt::sel(#str_ptr("draggingSession:sourceOperationMaskForDraggingContext:\0")), drag_source_mask_imp, #str_ptr("Q@:@q\0"));
        synth::register_class_pair(cls);
    }
    return cls;
}

// A fresh +1 FacetDragView carrying `text` as its drag payload. Frame is set
// later by the layout pass.
fn new_drag_view(text: str) -> ak::View {
    let cls: *u8 = drag_view_class();
    let v: *u8 = synth::alloc_init_class(cls);
    synth::retain_associated(v, drag_text_key(), bridge::nsstring(text));   // pin the payload NSString
    return ak::View::from_raw(v);
}

// ==========================================================================
// Window toolbar (NSToolbar) from a prebuilt item map
// ==========================================================================
//
// NSToolbar vends its items through a delegate. The generated ToolbarDelegate
// already bridges the three required callbacks to C+ fn-pointers, so this just
// supplies the data: an ordered `ids` NSArray (default + allowed identifiers)
// and an `id -> NSToolbarItem` NSDictionary (item lookup). The map rides as a
// retained associated object on the ids array, so a single `user` pointer (the
// ids array) reaches both. facet_appkit builds the items; this wires the plumbing.

fn toolbar_map_key() -> *u8 { return { 28695 as *u8 }; }
fn toolbar_del_pin_key() -> *u8 { return { 28696 as *u8 }; }
fn toolbar_ids_pin_key() -> *u8 { return { 28697 as *u8 }; }

fn tb_ids_imp(user: *u8, toolbar: *u8) -> *u8 { return user; }

fn tb_item_imp(user: *u8, toolbar: *u8, identifier: *u8, flag: i8) -> *u8 {
    let map: *u8 = synth::get_associated(user, toolbar_map_key());
    return rt::msg_id_id(map, rt::sel(#str_ptr("objectForKey:\0")), identifier);
}

// Build an NSToolbar over `ids` (NSArray of NSString) + `map` (NSDictionary
// id->NSToolbarItem). Ownership of the +1 toolbar MOVES to the caller (return by
// value — do not round-trip through a raw ptr, or this fn's local drop would
// release it early). The delegate is pinned to the toolbar (NSToolbar.delegate
// is weak); ids + map are pinned too, so all three live as long as the toolbar.
fn make_toolbar(ids: *u8, map: *u8) -> ak::Toolbar {
    synth::retain_associated(ids, toolbar_map_key(), map);   // ids carries the map
    var del: ak::ToolbarDelegate = ak::ToolbarDelegate_new(ids);
    del.set_toolbar_default_item_identifiers(tb_ids_imp);
    del.set_toolbar_allowed_item_identifiers(tb_ids_imp);
    del.set_toolbar_item_for_item_identifier_will_be_inserted_into_toolbar(tb_item_imp);
    let dbox: *ak::ToolbarDelegate = { malloc(#size_of::[ak::ToolbarDelegate]()) as *ak::ToolbarDelegate };
    { *dbox = del; }
    let d: *u8 = ak::create_ToolbarDelegate(dbox);
    let tb: ak::Toolbar = ak::Toolbar::new_with_identifier("facet.toolbar");
    tb.set_delegate(d);
    synth::retain_associated(tb.raw(), toolbar_del_pin_key(), d);
    synth::retain_associated(tb.raw(), toolbar_ids_pin_key(), ids);
    return tb;
}

// ==========================================================================
// Window-drag surface + window-button actions (custom titlebar chrome)
// ==========================================================================
//
// An app that hides the standard window buttons and draws its OWN titlebar (a
// content row) needs two things AppKit gives a real titlebar for free: the
// region must DRAG the window, and a double-click on it must ZOOM. A
// `CplusExtWindowDragView` provides both — its `mouseDown:` runs
// `-[NSWindow performWindowDragWithEvent:]` (the public 10.11+ window-drag loop)
// for a single press, and `-[NSWindow performZoom:]` on a double-click. Because
// the subclass overrides `mouseDown:`, AppKit's own background-drag
// (`mouseDownCanMoveWindow`) stays off, so the two never fight; child controls
// (buttons) sit in subviews and get their clicks first via hit-testing, so only
// presses on the bare bar reach this view. The window-action helpers below are
// the button-driven equivalents of the traffic lights: a handler calls them with
// its `sender` (the clicked control), and they message the sender's window.

// `-[NSEvent clickCount]`.
fn wd_click_count(event: *u8) -> i64 { return rt::msg_i64(event, rt::sel(#str_ptr("clickCount\0"))); }

fn wd_mousedown_imp(self_obj: *u8, cmd: *u8, event: *u8) {
    let win: *u8 = rt::msg_id(self_obj, rt::sel(#str_ptr("window\0")));
    if win == { 0 as *u8 } { return; }
    if wd_click_count(event) >= (2 as i64) {
        rt::msg_void_id(win, rt::sel(#str_ptr("performZoom:\0")), self_obj);
        return;
    }
    rt::msg_void_id(win, rt::sel(#str_ptr("performWindowDragWithEvent:\0")), event);
    return;
}

// hitTest: routes bare regions to the drag view (so a press there starts the
// window drag) while letting INTERACTIVE content keep its clicks. AppKit's
// synthesized container backing views are hit-testable everywhere, so without
// this a filled toolbar's container would swallow every bare-region press and
// the drag surface below it would never see a mouseDown. We reclaim those: run
// the normal hit-test, then walk from the hit view up to self — if anything on
// that path is interactive (an NSControl, or a view carrying gesture recognizers
// like a facet `clickable`), return it untouched; otherwise the press landed on
// passive chrome, so return self and drag. This is why the window need NOT be
// movableByWindowBackground (which would instead swallow clicks on real controls).
fn wd_is_interactive(v: *u8) -> bool {
    if rt::msg_i8_id(v, rt::sel(#str_ptr("isKindOfClass:\0")), rt::get_class(#str_ptr("NSControl\0"))) != (0 as i8) {
        return true;
    }
    let grs: *u8 = { rt::msg_id(v, rt::sel(#str_ptr("gestureRecognizers\0"))) };
    if grs != { 0 as *u8 } {
        if rt::msg_u64(grs, rt::sel(#str_ptr("count\0"))) > (0 as u64) { return true; }
    }
    return false;
}

#[link_name = "objc_msgSendSuper"]
extern fn msg_super_id_point(sup: *ObjcSuper, sel: *u8, p: rt::Point) -> *u8;

fn wd_hittest_imp(self_obj: *u8, cmd: *u8, p: rt::Point) -> *u8 {
    var sup: ObjcSuper = ObjcSuper { receiver: self_obj, super_class: rt::get_class(#str_ptr("NSView\0")) };
    let hit: *u8 = { msg_super_id_point(#addr_of(sup), rt::sel(#str_ptr("hitTest:\0")), p) };
    if hit == { 0 as *u8 } { return 0 as *u8; }
    if hit == self_obj { return self_obj; }
    var v: *u8 = hit;
    while v != { 0 as *u8 } && v != self_obj {
        if wd_is_interactive(v) { return hit; }
        v = { rt::msg_id(v, rt::sel(#str_ptr("superview\0"))) };
    }
    return self_obj;   // passive region → the drag view handles the press
}

#[link_name = "class_addMethod"]
extern fn wd_add_hittest(cls: *u8, sel: *u8, imp: fn(*u8, *u8, rt::Point) -> *u8, types: *u8) -> i8;

fn window_drag_view_class() -> *u8 {
    let name: *u8 = #str_ptr("CplusExtWindowDragView\0");
    var cls: *u8 = rt::get_class(name);
    if cls == { 0 as *u8 } {
        cls = synth::allocate_class_pair(rt::get_class(#str_ptr("NSView\0")), name, 0 as usize);
        let a: i8 = synth::add_method_v_1id(cls, rt::sel(#str_ptr("mouseDown:\0")), wd_mousedown_imp, #str_ptr("v@:@\0"));
        let b: i8 = wd_add_hittest(cls, rt::sel(#str_ptr("hitTest:\0")), wd_hittest_imp, #str_ptr("@@:{CGPoint=dd}\0"));
        synth::register_class_pair(cls);
    }
    return cls;
}

// A fresh +1 window-drag view. Dragging it moves the window; double-clicking it
// zooms. Frame is set by the layout pass. Put content in subviews (they keep
// their own clicks); only the bare surface drags.
fn new_window_drag_view(frame: rt::Rect) -> ak::View {
    let alloced: *u8 = rt::msg_id(window_drag_view_class(), rt::sel(#str_ptr("alloc\0")));
    let inited: *u8 = rt::msg_id_rect(alloced, rt::sel(#str_ptr("initWithFrame:\0")), frame);
    return ak::View::from_raw(rt::autorelease(inited));
}

// The window behind a handler's `sender`, or nil if unhosted. A control/view
// sender answers `-window` directly; a gesture-recognizer sender (a facet
// `clickable`'s handler fires with the recognizer) answers `-view`, so unwrap to
// its view first. Either way we reach the enclosing NSWindow (or nil).
fn window_of(sender: *u8) -> *u8 {
    if sender == { 0 as *u8 } { return 0 as *u8; }
    let responds: *u8 = rt::sel(#str_ptr("respondsToSelector:\0"));
    if rt::msg_i8_id(sender, responds, rt::sel(#str_ptr("window\0"))) != (0 as i8) {
        return rt::msg_id(sender, rt::sel(#str_ptr("window\0")));
    }
    if rt::msg_i8_id(sender, responds, rt::sel(#str_ptr("view\0"))) != (0 as i8) {
        let v: *u8 = rt::msg_id(sender, rt::sel(#str_ptr("view\0")));
        if v != { 0 as *u8 } { return rt::msg_id(v, rt::sel(#str_ptr("window\0"))); }
    }
    return 0 as *u8;
}

// Button-driven window actions: the equivalents of clicking the standard traffic
// lights, run against `sender`'s window. `performClose:`/`performMiniaturize:`/
// `performZoom:` validate + animate exactly as the native buttons do (and respect
// a delegate's windowShouldClose:). No-op when the sender has no window yet.
fn window_perform_close(sender: *u8) {
    let win: *u8 = window_of(sender);
    if win != { 0 as *u8 } { rt::msg_void_id(win, rt::sel(#str_ptr("performClose:\0")), sender); }
    return;
}
fn window_perform_minimize(sender: *u8) {
    let win: *u8 = window_of(sender);
    if win != { 0 as *u8 } { rt::msg_void_id(win, rt::sel(#str_ptr("performMiniaturize:\0")), sender); }
    return;
}
fn window_perform_zoom(sender: *u8) {
    let win: *u8 = window_of(sender);
    if win != { 0 as *u8 } { rt::msg_void_id(win, rt::sel(#str_ptr("performZoom:\0")), sender); }
    return;
}

// ==========================================================================
// Native window buttons re-parented into a content view (custom titlebar)
// ==========================================================================
//
// A content toolbar under a hidden title bar wants the REAL traffic lights, not
// fakes — hiding them breaks the native zoom TOGGLE and the green-button hover /
// window-tiling menu. So keep the three standard buttons VISIBLE and move them
// into the app's own view: `CplusExtWindowButtonsView`, on `viewDidMoveToWindow`,
// takes window.standardWindowButton(close/miniaturize/zoom), unhides them,
// removeFromSuperview + addSubview into itself, and lays them out (leading 4,
// 14pt gaps, vertically centered). AppKit re-creates/re-lays the buttons on
// full-screen transitions and live-resize end, so it re-attaches on those
// notifications (plus a delayed pass to catch the settle). All native behavior
// survives — the buttons' actions still target the window. Their natural extent
// is reported via `fittingSize` so facet measures the leaf correctly.

fn wb_observed_key() -> *u8 { return { 28731 as *u8 }; }

// `-[NSView setFrameOrigin:]` shape reused from rt (msg_void_point). Place the
// three buttons in `self`: leading inset 4, 14pt between button edges, centered.
fn wb_layout(self_obj: *u8) {
    let win: *u8 = rt::msg_id(self_obj, rt::sel(#str_ptr("window\0")));
    if win == { 0 as *u8 } { return; }
    let self_h: f64 = { rt::msg_rect(self_obj, rt::sel(#str_ptr("bounds\0"))).h };
    let std_sel: *u8 = rt::sel(#str_ptr("standardWindowButton:\0"));
    var x: f64 = 4.0f64;
    var i: i64 = 0 as i64;
    while i < (3 as i64) {
        let btn: *u8 = { rt::msg_id_i64(win, std_sel, i) };   // 0 close, 1 miniaturize, 2 zoom
        if btn != { 0 as *u8 } {
            rt::msg_void_i8(btn, rt::sel(#str_ptr("setHidden:\0")), 0 as i8);   // keep visible
            let bf: rt::Rect = { rt::msg_rect(btn, rt::sel(#str_ptr("frame\0"))) };
            let sv: *u8 = { rt::msg_id(btn, rt::sel(#str_ptr("superview\0"))) };
            if sv != self_obj {
                rt::msg_void(btn, rt::sel(#str_ptr("removeFromSuperview\0")));
                rt::msg_void_id(self_obj, rt::sel(#str_ptr("addSubview:\0")), btn);
            }
            let y: f64 = (self_h - bf.h) / 2.0f64;
            rt::msg_void_point(btn, rt::sel(#str_ptr("setFrameOrigin:\0")), rt::Point { x: x, y: y });
            x = x + bf.w + 14.0f64;
        }
        i = i +% (1 as i64);
    }
    return;
}

// Re-lay after AppKit moves the buttons back (fullscreen / live-resize / settle).
// The notification arg (if any) is ignored — we re-read the window each time.
fn wb_reattach_imp(self_obj: *u8, cmd: *u8, notif: *u8) { wb_layout(self_obj); return; }

fn wb_did_move_to_window_imp(self_obj: *u8, cmd: *u8) {
    let win: *u8 = rt::msg_id(self_obj, rt::sel(#str_ptr("window\0")));
    if win == { 0 as *u8 } { return; }
    wb_layout(self_obj);
    // Register the re-attach observers once, then a delayed pass for the settle.
    if synth::get_associated(self_obj, wb_observed_key()) == { 0 as *u8 } {
        synth::set_associated(self_obj, wb_observed_key(), { 1 as *u8 });
        let nc: *u8 = rt::msg_id(rt::get_class(#str_ptr("NSNotificationCenter\0")), rt::sel(#str_ptr("defaultCenter\0")));
        let add_sel: *u8 = rt::sel(#str_ptr("addObserver:selector:name:object:\0"));
        let re_sel: *u8 = rt::sel(#str_ptr("cplusWBReattach:\0"));
        rt::msg_void_id_id_id_id(nc, add_sel, self_obj, re_sel, bridge::nsstring("NSWindowDidEnterFullScreenNotification"), win);
        rt::msg_void_id_id_id_id(nc, add_sel, self_obj, re_sel, bridge::nsstring("NSWindowDidExitFullScreenNotification"), win);
        rt::msg_void_id_id_id_id(nc, add_sel, self_obj, re_sel, bridge::nsstring("NSWindowDidEndLiveResizeNotification"), win);
    }
    wb_perform_after(self_obj, rt::sel(#str_ptr("cplusWBReattach:\0")), 0 as *u8, 0.15f64);
    return;
}

// Re-center the buttons when the host view is resized (window relayout).
fn wb_set_frame_size_imp(self_obj: *u8, cmd: *u8, size: rt::Size) {
    call_super_void_size(self_obj, rt::get_class(#str_ptr("NSView\0")), rt::sel(#str_ptr("setFrameSize:\0")), size);
    wb_layout(self_obj);
    return;
}

// Natural extent = leading 4 + three ~14pt buttons + two 14pt gaps ≈ 74×16.
// Reported so facet measures the leaf (the buttons aren't reparented yet at
// measure time, so this is a fixed estimate, not read from live frames).
fn wb_fitting_size_imp(self_obj: *u8, cmd: *u8) -> rt::Size { return rt::Size { w: 74.0f64, h: 16.0f64 }; }

// objc_msgSendSuper for `void (self, _cmd, NSSize)` — chain setFrameSize: to NSView.
#[link_name = "objc_msgSendSuper"]
extern fn msg_super_void_size(sup: *ObjcSuper, sel: *u8, a: rt::Size);
fn call_super_void_size(self_obj: *u8, super_cls: *u8, sel: *u8, a: rt::Size) {
    var sup: ObjcSuper = ObjcSuper { receiver: self_obj, super_class: super_cls };
    msg_super_void_size(#addr_of(sup), sel, a);
    return;
}

// `-[NSObject performSelector:withObject:afterDelay:]` — run the settle pass off
// the runloop (nil object; the reattach imp ignores its arg).
#[link_name = "objc_msgSend"]
extern fn msg_perform_after(recv: *u8, sel: *u8, a_sel: *u8, obj: *u8, delay: f64);
fn wb_perform_after(self_obj: *u8, target_sel: *u8, obj: *u8, delay: f64) {
    msg_perform_after(self_obj, rt::sel(#str_ptr("performSelector:withObject:afterDelay:\0")), target_sel, obj, delay);
    return;
}

// class_addMethod shapes not in objc/synthesis: a no-arg void (viewDidMoveToWindow),
// an NSSize-taking void (setFrameSize:), and an NSSize-returning getter (fittingSize).
#[link_name = "class_addMethod"]
extern fn wb_add_void0(cls: *u8, sel: *u8, imp: fn(*u8, *u8), types: *u8) -> i8;
#[link_name = "class_addMethod"]
extern fn wb_add_void_size(cls: *u8, sel: *u8, imp: fn(*u8, *u8, rt::Size), types: *u8) -> i8;
#[link_name = "class_addMethod"]
extern fn wb_add_size0(cls: *u8, sel: *u8, imp: fn(*u8, *u8) -> rt::Size, types: *u8) -> i8;

fn window_buttons_view_class() -> *u8 {
    let name: *u8 = #str_ptr("CplusExtWindowButtonsView\0");
    var cls: *u8 = rt::get_class(name);
    if cls == { 0 as *u8 } {
        cls = synth::allocate_class_pair(rt::get_class(#str_ptr("NSView\0")), name, 0 as usize);
        let a: i8 = wb_add_void0(cls, rt::sel(#str_ptr("viewDidMoveToWindow\0")), wb_did_move_to_window_imp, #str_ptr("v@:\0"));
        let b: i8 = synth::add_method_v_1id(cls, rt::sel(#str_ptr("cplusWBReattach:\0")), wb_reattach_imp, #str_ptr("v@:@\0"));
        let c: i8 = wb_add_void_size(cls, rt::sel(#str_ptr("setFrameSize:\0")), wb_set_frame_size_imp, #str_ptr("v@:{CGSize=dd}\0"));
        let d: i8 = wb_add_size0(cls, rt::sel(#str_ptr("fittingSize\0")), wb_fitting_size_imp, #str_ptr("{CGSize=dd}@:\0"));
        synth::register_class_pair(cls);
    }
    return cls;
}

// A fresh +1 view that re-parents the window's native traffic lights into itself
// once it enters a window. Frame is set by the layout pass; drop it in the custom
// toolbar (pair with a `wants_native_buttons` window so the buttons stay visible).
fn new_window_buttons_view() -> ak::View {
    let alloced: *u8 = rt::msg_id(window_buttons_view_class(), rt::sel(#str_ptr("alloc\0")));
    let inited: *u8 = rt::msg_id_rect(alloced, rt::sel(#str_ptr("initWithFrame:\0")), rt::Rect { x: 0.0, y: 0.0, w: 74.0, h: 16.0 });
    return ak::View::from_raw(rt::autorelease(inited));
}
