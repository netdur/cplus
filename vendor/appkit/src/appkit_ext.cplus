// vendor/appkit/src/appkit_ext.cplus — hand-written companion to the generated
// AppKit binding. It does NOT edit `appkit.cplus` (which is machine-generated);
// it only composes the existing runtime + synthesis helpers to add the things the
// generator can't know to emit. Import it as `appkit/appkit_ext`.
//
// Currently: a flipped NSView (top-left origin). `NSView.isFlipped` is
// override-only in AppKit, so the standard fix is a one-method subclass whose
// isFlipped returns YES — which is exactly what this builds at runtime.

import "objc/runtime" as rt;
import "objc/synthesis" as synth;
import "appkit/appkit" as ak;

// `class_addMethod` for a `BOOL (self, _cmd)` method (isFlipped). This shape isn't
// in objc/synthesis yet, so declare it locally — the generated binding declares
// its own delegate shims the same way (`#[link_name = "class_addMethod"]`).
#[link_name = "class_addMethod"]
extern fn add_method_bool_0(cls: *u8, sel: *u8, imp: fn(*u8, *u8) -> i8, types: *u8) -> i8;

// The override: -[isFlipped] -> YES.
fn flipped_is_flipped_imp(self_obj: *u8, cmd: *u8) -> i8 { return 1 as i8; }

// The NSView subclass whose isFlipped is YES. Registered once; reused thereafter
// (`get_class` returns null until the pair is registered).
fn flipped_view_class() -> *u8 {
    let existing: *u8 = rt::get_class(#str_ptr("FlexFlippedView\0"));
    if existing != (0 as *u8) { return existing; }
    let cls: *u8 = synth::allocate_class_pair(rt::get_class(#str_ptr("NSView\0")), #str_ptr("FlexFlippedView\0"), 0 as usize);
    add_method_bool_0(cls, rt::sel(#str_ptr("isFlipped\0")), flipped_is_flipped_imp, #str_ptr("c@:\0"));
    synth::register_class_pair(cls);
    return cls;
}

// A flipped view (top-left origin), constructible like any other view. Use it as
// a scroll view's document view — the first row then sits at the top by
// construction, with no manual scroll-to-top afterwards.
fn new_flipped_view(frame: rt::Rect) -> ak::View {
    let alloced: *u8 = rt::msg_id(flipped_view_class(), rt::sel(#str_ptr("alloc\0")));
    let inited: *u8 = rt::msg_id_rect(alloced, rt::sel(#str_ptr("initWithFrame:\0")), frame);
    // `from_raw` retains; autorelease balances the +1 from `alloc`, so the returned
    // View owns exactly one reference (released by its `drop`).
    return ak::View::from_raw(rt::autorelease(inited));
}

// ---- target/action with userdata ------------------------------------------
//
// The generated binding's `set_on_action` carries a bare `fn(*u8)` (sender
// only), which forces per-item state into side channels (`setTag:` + a
// global). This companion adds the ctx-carrying variant: the handler
// receives `(sender, ctx)`, where `ctx` is an opaque pointer chosen at wiring
// time. The caller owns `ctx` (an integer index smuggled as a pointer needs
// no ownership at all); the target object itself is pinned to the control via
// an associated reference, so it lives exactly as long as the control.

// Associated-object keys. Any unique addresses work; the generated binding
// uses 28672/28673, so this module takes the next block.
fn action_ctx_handler_key() -> *u8 { return { 28680 as *u8 }; }
fn action_ctx_userdata_key() -> *u8 { return { 28681 as *u8 }; }
fn action_ctx_pin_key() -> *u8 { return { 28682 as *u8 }; }

fn action_ctx_imp(self_obj: *u8, cmd: *u8, sender: *u8) {
    let f: fn(*u8, *u8) = { synth::get_associated(self_obj, action_ctx_handler_key()) as fn(*u8, *u8) };
    let ctx: *u8 = synth::get_associated(self_obj, action_ctx_userdata_key());
    f(sender, ctx);
    return;
}

// The selector our target answers. Exposed so a caller can wire the pair
// onto anything that takes target/action (gesture recognizers, menu items).
fn action_ctx_sel() -> *u8 { return rt::sel(#str_ptr("cplusActionCtx:\0")); }

// A fresh autoreleased target answering `action_ctx_sel()` with `handler`
// and `ctx` attached. The caller must keep it alive (pin it to the owning
// object) — `set_control_action_ctx` below does both steps.
fn action_ctx_target(handler: fn(*u8, *u8), ctx: *u8) -> *u8 {
    let name: *u8 = #str_ptr("CplusExt_ActionCtxTarget\0");
    var cls: *u8 = rt::get_class(name);
    if cls == { 0 as *u8 } {
        cls = synth::allocate_class_pair(rt::get_class(#str_ptr("NSObject\0")), name, 0 as usize);
        let added: i8 = cplus_ext_add_action_method(cls, action_ctx_sel(), action_ctx_imp, #str_ptr("v@:@\0"));
        synth::register_class_pair(cls);
    }
    let t: *u8 = synth::alloc_init_class(cls);
    synth::set_associated(t, action_ctx_handler_key(), { handler as *u8 });
    synth::set_associated(t, action_ctx_userdata_key(), ctx);
    return t;
}

// Wire a control to `handler(sender, ctx)`: build the target, pin it to the
// control, and set target/action.
fn set_control_action_ctx(control: ak::Control, handler: fn(*u8, *u8), ctx: *u8) {
    let t: *u8 = action_ctx_target(handler, ctx);
    synth::retain_associated(control.raw(), action_ctx_pin_key(), t);
    rt::msg_void_id(control.raw(), rt::sel(#str_ptr("setTarget:\0")), t);
    rt::msg_void_id(control.raw(), rt::sel(#str_ptr("setAction:\0")), action_ctx_sel());
    return;
}

// `class_addMethod` for the `void (self, _cmd, id)` action shape — declared
// locally, exactly as the generated binding declares its shims.
#[link_name = "class_addMethod"]
extern fn cplus_ext_add_action_method(cls: *u8, sel: *u8, imp: fn(*u8, *u8, *u8), types: *u8) -> i8;


// ---- target/action with an after-hook --------------------------------------
// The same wiring as `set_control_action_ctx`, plus a zero-arg `after` fn
// that runs once the handler returns. This is the MVU runtime's re-render
// hook: the handler mutates state, `after` re-renders — one documented rule,
// no hidden subscriptions.

fn action_after_key() -> *u8 { return { 28683 as *u8 }; }

fn action_ctx_then_imp(self_obj: *u8, cmd: *u8, sender: *u8) {
    let f: fn(*u8, *u8) = { synth::get_associated(self_obj, action_ctx_handler_key()) as fn(*u8, *u8) };
    let ctx: *u8 = synth::get_associated(self_obj, action_ctx_userdata_key());
    let after: fn() = { synth::get_associated(self_obj, action_after_key()) as fn() };
    f(sender, ctx);
    after();
    return;
}

fn action_ctx_then_sel() -> *u8 { return rt::sel(#str_ptr("cplusActionCtxThen:\0")); }

fn action_ctx_then_target(handler: fn(*u8, *u8), ctx: *u8, after: fn()) -> *u8 {
    let name: *u8 = #str_ptr("CplusExt_ActionCtxThenTarget\0");
    var cls: *u8 = rt::get_class(name);
    if cls == { 0 as *u8 } {
        cls = synth::allocate_class_pair(rt::get_class(#str_ptr("NSObject\0")), name, 0 as usize);
        let added: i8 = cplus_ext_add_action_method(cls, action_ctx_then_sel(), action_ctx_then_imp, #str_ptr("v@:@\0"));
        synth::register_class_pair(cls);
    }
    let t: *u8 = synth::alloc_init_class(cls);
    synth::set_associated(t, action_ctx_handler_key(), { handler as *u8 });
    synth::set_associated(t, action_ctx_userdata_key(), ctx);
    synth::set_associated(t, action_after_key(), { after as *u8 });
    return t;
}

// Wire a control to `handler(sender, ctx)` followed by `after()`.
fn set_control_action_ctx_then(control: ak::Control, handler: fn(*u8, *u8), ctx: *u8, after: fn()) {
    let t: *u8 = action_ctx_then_target(handler, ctx, after);
    synth::retain_associated(control.raw(), action_ctx_pin_key(), t);
    rt::msg_void_id(control.raw(), rt::sel(#str_ptr("setTarget:\0")), t);
    rt::msg_void_id(control.raw(), rt::sel(#str_ptr("setAction:\0")), action_ctx_then_sel());
    return;
}
