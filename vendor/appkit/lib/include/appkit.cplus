// `NSItemProvider` (Foundation/ObjC). Owned via alloc/init; `drop` releases the +1.
struct ItemProvider {
    _obj: *u8,
}

impl ItemProvider {
    fn raw(this) -> *u8 ;

    fn from_raw(ptr: *u8) -> ItemProvider ;

    fn new() -> ItemProvider ;

    fn register_data_representation_for_type_identifier(this, type_identifier: str, visibility: ItemProviderRepresentationVisibility, cb: fn(*u8, *u8) -> *u8, ctx: *u8) ;

    fn register_file_representation_for_type_identifier(this, type_identifier: str, file_options: u64, visibility: ItemProviderRepresentationVisibility, cb: fn(*u8, *u8) -> *u8, ctx: *u8) ;

    fn registered_type_identifiers_with_file_options(this, file_options: u64) -> vec::Vec[text::Text] ;

