        let dict_keyed_values: *u8 = rt::msg_id(rt::get_class(#str_ptr("NSMutableDictionary\0")), rt::sel(#str_ptr("dictionary\0")));
        let dset_keyed_values: *u8 = rt::sel(#str_ptr("setObject:forKey:\0"));
        let dcap_keyed_values: usize = keyed_values.slot_capacity();
        var dsi_keyed_values: usize = 0 as usize;
        while dsi_keyed_values < dcap_keyed_values {
            match keyed_values.value_ptr_at_slot(dsi_keyed_values) {
                option::Option[*AnyObject]::Some(dvp_keyed_values) => {
                    match keyed_values.key_ptr_at_slot(dsi_keyed_values) {
                        option::Option[*text::Text]::Some(dkp_keyed_values) => {
                    let dval_keyed_values: *u8 = (*dvp_keyed_values).raw();
                            rt::msg_void_id_id(dict_keyed_values, dset_keyed_values, dval_keyed_values, bridge::nsstring((*dkp_keyed_values).view()));
                        }
                        option::Option[*text::Text]::None => {}
                    }
                }
                option::Option[*AnyObject]::None => {}
            }
            dsi_keyed_values = dsi_keyed_values +% (1 as usize);
        }
        return rt::msg_i8_id_id(this._obj, rt::sel(#str_ptr("setResourceValues:error:\0")), dict_keyed_values, error) != (0 as i8);
    }

