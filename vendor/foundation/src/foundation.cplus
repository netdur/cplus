// `NSString` (Foundation/ObjC). Owned via alloc/init; `drop` releases the +1.
struct String {
    _obj: *u8,
}

impl String {
    fn raw(this) -> *u8 { return this._obj; }

    fn from_raw(ptr: *u8) -> String { return String { _obj: rt::retain(ptr) }; }

    // Upcast to `NSObject` (superclass). Safe typed reinterpret.
    fn as_object(this) -> Object { return Object::from_raw(this._obj); }

    fn character_at_index(this, index: u64) -> u16 {
        return objc_msg_u16_u64(this._obj, rt::sel(#str_ptr("characterAtIndex:\0")), index);
    }

    fn new() -> String {
        let cls: *u8 = rt::get_class(#str_ptr("NSString\0"));
        let alloced: *u8 = rt::msg_id(cls, rt::sel(#str_ptr("alloc\0")));
        return String { _obj: rt::msg_id(alloced, rt::sel(#str_ptr("init\0"))) };
    }

    fn new_with_coder(coder: Coder) -> String {
        let cls: *u8 = rt::get_class(#str_ptr("NSString\0"));
        let alloced: *u8 = rt::msg_id(cls, rt::sel(#str_ptr("alloc\0")));
        return String { _obj: rt::msg_id_id(alloced, rt::sel(#str_ptr("initWithCoder:\0")), coder.raw()) };
    }

    fn length(this) -> u64 {
        return rt::msg_u64(this._obj, rt::sel(#str_ptr("length\0")));
    }

    fn substring_from_index(this, from: u64) -> text::Text {
        let ns: *u8 = rt::msg_id_u64(this._obj, rt::sel(#str_ptr("substringFromIndex:\0")), from);
        return bridge::to_text(ns);
    }

    fn substring_to_index(this, to: u64) -> text::Text {
        let ns: *u8 = rt::msg_id_u64(this._obj, rt::sel(#str_ptr("substringToIndex:\0")), to);
        return bridge::to_text(ns);
    }

    fn substring_with_range(this, range: rt::Range) -> text::Text {
        let ns: *u8 = rt::msg_id_range(this._obj, rt::sel(#str_ptr("substringWithRange:\0")), range);
        return bridge::to_text(ns);
    }

    fn get_characters_range(this, buffer: *u8, range: rt::Range) {
        rt::msg_void_id_range(this._obj, rt::sel(#str_ptr("getCharacters:range:\0")), buffer, range);
    }

    fn compare(this, string: str) -> ComparisonResult {
        return comparison_result_from_raw(rt::msg_i64_id(this._obj, rt::sel(#str_ptr("compare:\0")), bridge::nsstring(string)));
    }

    fn compare_options(this, string: str, mask: u64) -> ComparisonResult {
        return comparison_result_from_raw(rt::msg_i64_id_u64(this._obj, rt::sel(#str_ptr("compare:options:\0")), bridge::nsstring(string), mask));
    }

    fn compare_options_range(this, string: str, mask: u64, range_of_receiver_to_compare: rt::Range) -> ComparisonResult {
        return comparison_result_from_raw(objc_msg_i64_id_u64_range(this._obj, rt::sel(#str_ptr("compare:options:range:\0")), bridge::nsstring(string), mask, range_of_receiver_to_compare));
