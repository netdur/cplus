    }

    fn local_time_zone() -> TimeZone {
        return TimeZone { _obj: rt::retain(rt::msg_id(rt::get_class(#str_ptr("NSTimeZone\0")), rt::sel(#str_ptr("localTimeZone\0")))) };
    }

    fn known_time_zone_names() -> vec::Vec[text::Text] {
        let arr: *u8 = rt::msg_id(rt::get_class(#str_ptr("NSTimeZone\0")), rt::sel(#str_ptr("knownTimeZoneNames\0")));
        let n: u64 = rt::msg_u64(arr, rt::sel(#str_ptr("count\0")));
        var out: vec::Vec[text::Text] = vec::Vec[text::Text]::with_capacity(n as usize);
        let at_sel: *u8 = rt::sel(#str_ptr("objectAtIndex:\0"));
        var i: u64 = 0 as u64;
        while i < n {
            let value: *u8 = rt::msg_id_u64(arr, at_sel, i);
            out.append(bridge::to_text(value));
            i = i +% (1 as u64);
        }
        return out;
    }

    fn set_abbreviation_dictionary(abbreviation_dictionary: string_map::StringMap[text::Text]) {
        let dict_abbreviation_dictionary: *u8 = rt::msg_id(rt::get_class(#str_ptr("NSMutableDictionary\0")), rt::sel(#str_ptr("dictionary\0")));
        let dset_abbreviation_dictionary: *u8 = rt::sel(#str_ptr("setObject:forKey:\0"));
        let dcap_abbreviation_dictionary: usize = abbreviation_dictionary.slot_capacity();
        var dsi_abbreviation_dictionary: usize = 0 as usize;
        while dsi_abbreviation_dictionary < dcap_abbreviation_dictionary {
            match abbreviation_dictionary.value_ptr_at_slot(dsi_abbreviation_dictionary) {
                option::Option[*text::Text]::Some(dvp_abbreviation_dictionary) => {
                    match abbreviation_dictionary.key_ptr_at_slot(dsi_abbreviation_dictionary) {
                        option::Option[*text::Text]::Some(dkp_abbreviation_dictionary) => {
                    let dval_abbreviation_dictionary: *u8 = bridge::nsstring((*dvp_abbreviation_dictionary).view());
                            rt::msg_void_id_id(dict_abbreviation_dictionary, dset_abbreviation_dictionary, dval_abbreviation_dictionary, bridge::nsstring((*dkp_abbreviation_dictionary).view()));
                        }
                        option::Option[*text::Text]::None => {}
                    }
                }
                option::Option[*text::Text]::None => {}
            }
            dsi_abbreviation_dictionary = dsi_abbreviation_dictionary +% (1 as usize);
        }
        rt::msg_void_id(rt::get_class(#str_ptr("NSTimeZone\0")), rt::sel(#str_ptr("setAbbreviationDictionary:\0")), dict_abbreviation_dictionary);
    }

    fn time_zone_data_version() -> text::Text {
        let ns: *u8 = rt::msg_id(rt::get_class(#str_ptr("NSTimeZone\0")), rt::sel(#str_ptr("timeZoneDataVersion\0")));
        return bridge::to_text(ns);
    }

