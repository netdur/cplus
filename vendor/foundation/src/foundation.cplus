        rt::msg_void_range(this._obj, rt::sel(#str_ptr("addCharactersInRange:\0")), a_range);
    }

    fn remove_characters_in_range(this, a_range: rt::Range) {
        rt::msg_void_range(this._obj, rt::sel(#str_ptr("removeCharactersInRange:\0")), a_range);
    }

    fn add_characters_in_string(this, a_string: str) {
        rt::msg_void_id(this._obj, rt::sel(#str_ptr("addCharactersInString:\0")), bridge::nsstring(a_string));
    }

    fn remove_characters_in_string(this, a_string: str) {
        rt::msg_void_id(this._obj, rt::sel(#str_ptr("removeCharactersInString:\0")), bridge::nsstring(a_string));
    }

