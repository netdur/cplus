struct Formatter {
    opaque _obj: *u8,
}

impl Formatter {
    fn raw(this) -> *u8 { return this._obj; }

    fn from_raw(ptr: *u8) -> Formatter { return Formatter { _obj: ptr }; }

    // Upcast to `NSObject` (superclass). Safe typed reinterpret.
    fn as_object(this) -> Object { return Object::from_raw(this._obj); }

    fn string_for_object_value(this, obj: *u8) -> option::Option[text::Text] {
        let ns: *u8 = rt::msg_id_id(this._obj, rt::sel(#str_ptr("stringForObjectValue:\0")), obj);
        return bridge::to_text_option(ns);
    }

    fn attributed_string_for_object_value(this, obj: *u8, with_default_attributes: string_map::StringMap[AnyObject]) -> option::Option[AttributedString] {
        let dict_with_default_attributes: *u8 = rt::msg_id(rt::get_class(#str_ptr("NSMutableDictionary\0")), rt::sel(#str_ptr("dictionary\0")));
        let dset_with_default_attributes: *u8 = rt::sel(#str_ptr("setObject:forKey:\0"));
        let dcap_with_default_attributes: usize = with_default_attributes.slot_capacity();
        var dsi_with_default_attributes: usize = 0 as usize;
        while dsi_with_default_attributes < dcap_with_default_attributes {
            match with_default_attributes.value_ptr_at_slot(dsi_with_default_attributes) {
                option::Option[*AnyObject]::Some(dvp_with_default_attributes) => {
                    match with_default_attributes.key_ptr_at_slot(dsi_with_default_attributes) {
                        option::Option[*text::Text]::Some(dkp_with_default_attributes) => {
                    let dval_with_default_attributes: *u8 = (*dvp_with_default_attributes).raw();
                            rt::msg_void_id_id(dict_with_default_attributes, dset_with_default_attributes, dval_with_default_attributes, bridge::nsstring((*dkp_with_default_attributes).view()));
                        }
                        option::Option[*text::Text]::None => {}
                    }
                }
                option::Option[*AnyObject]::None => {}
            }
            dsi_with_default_attributes = dsi_with_default_attributes +% (1 as usize);
        }
        let obj: *u8 = rt::msg_id_id_id(this._obj, rt::sel(#str_ptr("attributedStringForObjectValue:withDefaultAttributes:\0")), obj, dict_with_default_attributes);
        if obj == { 0 as *u8 } {
            return option::Option[AttributedString]::None;
        }
        return option::some(AttributedString::from_raw(obj));
    }

    fn editing_string_for_object_value(this, obj: *u8) -> option::Option[text::Text] {
        let ns: *u8 = rt::msg_id_id(this._obj, rt::sel(#str_ptr("editingStringForObjectValue:\0")), obj);
        return bridge::to_text_option(ns);
    }

    fn get_object_value(this, obj: *u8, for_string: str, error_description: *u8) -> bool {
        return rt::msg_i8_id_id_id(this._obj, rt::sel(#str_ptr("getObjectValue:forString:errorDescription:\0")), obj, bridge::nsstring(for_string), error_description) != (0 as i8);
    }

    fn is_partial_string_valid(this, partial_string: str, new_editing_string: *u8, error_description: *u8) -> bool {
        return rt::msg_i8_id_id_id(this._obj, rt::sel(#str_ptr("isPartialStringValid:newEditingString:errorDescription:\0")), bridge::nsstring(partial_string), new_editing_string, error_description) != (0 as i8);
    }

    fn is_partial_string_valid_proposed_selected_range(this, partial_string_ptr: *u8, proposed_sel_range_ptr: *u8, original_string: str, original_selected_range: rt::Range, error_description: *u8) -> bool {
        return objc_msg_i8_id_id_id_range_id(this._obj, rt::sel(#str_ptr("isPartialStringValid:proposedSelectedRange:originalString:originalSelectedRange:errorDescription:\0")), partial_string_ptr, proposed_sel_range_ptr, bridge::nsstring(original_string), original_selected_range, error_description) != (0 as i8);
    }

    fn new() -> Formatter {
        let cls: *u8 = rt::get_class(#str_ptr("NSFormatter\0"));
        let alloced: *u8 = rt::msg_id(cls, rt::sel(#str_ptr("alloc\0")));
        return Formatter { _obj: rt::autorelease(rt::msg_id(alloced, rt::sel(#str_ptr("init\0")))) };
    }

}

