        let dset_dict: *u8 = rt::sel(#str_ptr("setObject:forKey:\0"));
        let dcap_dict: usize = dict.slot_capacity();
        var dsi_dict: usize = 0 as usize;
        while dsi_dict < dcap_dict {
            match dict.value_ptr_at_slot(dsi_dict) {
                option::Option[*text::Text]::Some(dvp_dict) => {
                    match dict.key_ptr_at_slot(dsi_dict) {
                        option::Option[*text::Text]::Some(dkp_dict) => {
                    let dval_dict: *u8 = bridge::nsstring((*dvp_dict).view());
                            rt::msg_void_id_id(dict_dict, dset_dict, dval_dict, bridge::nsstring((*dkp_dict).view()));
                        }
                        option::Option[*text::Text]::None => {}
                    }
                }
                option::Option[*text::Text]::None => {}
            }
            dsi_dict = dsi_dict +% (1 as usize);
        }
        let ns: *u8 = rt::msg_id_id(rt::get_class(#str_ptr("NSLocale\0")), rt::sel(#str_ptr("localeIdentifierFromComponents:\0")), dict_dict);
        return bridge::to_text(ns);
