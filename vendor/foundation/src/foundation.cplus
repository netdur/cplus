    fn string_encoding_for_data(data: Data, encoding_options: string_map::StringMap[AnyObject], converted_string: *u8, used_lossy_conversion: *u8) -> u64 {
        let dict_encoding_options: *u8 = rt::msg_id(rt::get_class(#str_ptr("NSMutableDictionary\0")), rt::sel(#str_ptr("dictionary\0")));
        let dset_encoding_options: *u8 = rt::sel(#str_ptr("setObject:forKey:\0"));
        let dcap_encoding_options: usize = encoding_options.slot_capacity();
        var dsi_encoding_options: usize = 0 as usize;
        while dsi_encoding_options < dcap_encoding_options {
            match encoding_options.value_ptr_at_slot(dsi_encoding_options) {
                option::Option[*AnyObject]::Some(dvp_encoding_options) => {
                    match encoding_options.key_ptr_at_slot(dsi_encoding_options) {
                        option::Option[*text::Text]::Some(dkp_encoding_options) => {
                    let dval_encoding_options: *u8 = (*dvp_encoding_options).raw();
                            rt::msg_void_id_id(dict_encoding_options, dset_encoding_options, dval_encoding_options, bridge::nsstring((*dkp_encoding_options).view()));
                        }
                        option::Option[*text::Text]::None => {}
                    }
                }
                option::Option[*AnyObject]::None => {}
            }
            dsi_encoding_options = dsi_encoding_options +% (1 as usize);
        }
        return objc_msg_u64_id_id_id_id(rt::get_class(#str_ptr("NSString\0")), rt::sel(#str_ptr("stringEncodingForData:encodingOptions:convertedString:usedLossyConversion:\0")), data.raw(), dict_encoding_options, converted_string, used_lossy_conversion);
    }

