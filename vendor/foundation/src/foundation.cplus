// `NSMutableCharacterSet` (Foundation/ObjC). Non-owning handle (factory/singleton); `opaque`, no drop.
struct MutableCharacterSet {
    opaque _obj: *u8,
}

impl MutableCharacterSet {
    fn raw(this) -> *u8 { return this._obj; }

    fn from_raw(ptr: *u8) -> MutableCharacterSet { return MutableCharacterSet { _obj: ptr }; }

    // Upcast to `NSCharacterSet` (superclass). Safe typed reinterpret.
    fn as_character_set(this) -> CharacterSet { return CharacterSet::from_raw(this._obj); }

    // Upcast to `NSObject` (superclass). Safe typed reinterpret.
