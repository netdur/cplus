        let dict_bindings: *u8 = rt::msg_id(rt::get_class(#str_ptr("NSMutableDictionary\0")), rt::sel(#str_ptr("dictionary\0")));
        let dset_bindings: *u8 = rt::sel(#str_ptr("setObject:forKey:\0"));
        let dcap_bindings: usize = bindings.slot_capacity();
        var dsi_bindings: usize = 0 as usize;
        while dsi_bindings < dcap_bindings {
            match bindings.value_ptr_at_slot(dsi_bindings) {
                option::Option[*AnyObject]::Some(dvp_bindings) => {
                    match bindings.key_ptr_at_slot(dsi_bindings) {
                        option::Option[*text::Text]::Some(dkp_bindings) => {
                    let dval_bindings: *u8 = (*dvp_bindings).raw();
                            rt::msg_void_id_id(dict_bindings, dset_bindings, dval_bindings, bridge::nsstring((*dkp_bindings).view()));
                        }
                        option::Option[*text::Text]::None => {}
                    }
                }
                option::Option[*AnyObject]::None => {}
            }
            dsi_bindings = dsi_bindings +% (1 as usize);
        }
        return rt::msg_i8_id_id(this._obj, rt::sel(#str_ptr("evaluateWithObject:substitutionVariables:\0")), object, dict_bindings) != (0 as i8);
    }

    fn allow_evaluation(this) {
        rt::msg_void(this._obj, rt::sel(#str_ptr("allowEvaluation\0")));
    }

    fn allow_evaluation_with_validator(this, validator: PredicateValidating, error: *u8) -> bool {
        return rt::msg_i8_id_id(this._obj, rt::sel(#str_ptr("allowEvaluationWithValidator:error:\0")), validator.raw(), error) != (0 as i8);
    }

    fn predicate_format(this) -> text::Text {
        let ns: *u8 = rt::msg_id(this._obj, rt::sel(#str_ptr("predicateFormat\0")));
        return bridge::to_text(ns);
    }

    fn new() -> Predicate {
        let cls: *u8 = rt::get_class(#str_ptr("NSPredicate\0"));
        let alloced: *u8 = rt::msg_id(cls, rt::sel(#str_ptr("alloc\0")));
        return Predicate { _obj: rt::autorelease(rt::msg_id(alloced, rt::sel(#str_ptr("init\0")))) };
