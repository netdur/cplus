        return TimeZone { _obj: rt::retain(rt::msg_id(rt::get_class(#str_ptr("NSTimeZone\0")), rt::sel(#str_ptr("systemTimeZone\0")))) };
    }

    fn default_time_zone() -> TimeZone {
