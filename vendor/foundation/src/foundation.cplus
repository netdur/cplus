        return bridge::to_text(ns);
    }

    fn data(this) -> Data {
        return Data::from_raw(rt::msg_id(this._obj, rt::sel(#str_ptr("data\0"))));
    }

    fn reset_system_time_zone() {
        rt::msg_void(rt::get_class(#str_ptr("NSTimeZone\0")), rt::sel(#str_ptr("resetSystemTimeZone\0")));
    }

    fn abbreviation_dictionary() -> string_map::StringMap[text::Text] {
        let dict: *u8 = rt::msg_id(rt::get_class(#str_ptr("NSTimeZone\0")), rt::sel(#str_ptr("abbreviationDictionary\0")));
        let keys: *u8 = rt::msg_id(dict, rt::sel(#str_ptr("allKeys\0")));
        let n: u64 = rt::msg_u64(keys, rt::sel(#str_ptr("count\0")));
        var out: string_map::StringMap[text::Text] = string_map::new::[text::Text]();
        let at_sel: *u8 = rt::sel(#str_ptr("objectAtIndex:\0"));
        let obj_sel: *u8 = rt::sel(#str_ptr("objectForKey:\0"));
        var i: u64 = 0 as u64;
        while i < n {
            let nskey: *u8 = rt::msg_id_u64(keys, at_sel, i);
            let nsval: *u8 = rt::msg_id_id(dict, obj_sel, nskey);
            out.insert(bridge::to_text(nskey), bridge::to_text(nsval));
            i = i +% (1 as u64);
        }
        return out;
    }

    fn is_equal_to_time_zone(this, a_time_zone: TimeZone) -> bool {
        return rt::msg_i8_id(this._obj, rt::sel(#str_ptr("isEqualToTimeZone:\0")), a_time_zone.raw()) != (0 as i8);
    }

