            return option::Option[Predicate]::None;
        }
        return option::some(Predicate { _obj: obj });
    }

    fn predicate_with_value(value: bool) -> Predicate {
        return Predicate { _obj: rt::msg_id_i8(rt::get_class(#str_ptr("NSPredicate\0")), rt::sel(#str_ptr("predicateWithValue:\0")), value as i8) };
    }

    fn predicate_with_block(cb: fn(*u8, *u8, *u8) -> i8, ctx: *u8) -> Predicate {
        var desc: rt::BlockDescriptor = rt::BlockDescriptor { reserved: 0 as u64, size: 48 as u64 };
        var blk: Predicate_predicate_with_block_block = Predicate_predicate_with_block_block { isa: rt::stack_block_isa(), flags: 0 as i32, reserved: 0 as i32, invoke: Predicate_predicate_with_block_invoke, descriptor: { #addr_of(desc) as *u8 }, user_fn: cb, ctx: ctx };
        let bp: *u8 = { #addr_of(blk) as *u8 };
        return Predicate::from_raw(rt::msg_id_id(rt::get_class(#str_ptr("NSPredicate\0")), rt::sel(#str_ptr("predicateWithBlock:\0")), bp));
    }

    fn predicate_with_substitution_variables(this, variables: string_map::StringMap[AnyObject]) -> *u8 {
        let dict_variables: *u8 = rt::msg_id(rt::get_class(#str_ptr("NSMutableDictionary\0")), rt::sel(#str_ptr("dictionary\0")));
        let dset_variables: *u8 = rt::sel(#str_ptr("setObject:forKey:\0"));
        let dcap_variables: usize = variables.slot_capacity();
        var dsi_variables: usize = 0 as usize;
        while dsi_variables < dcap_variables {
            match variables.value_ptr_at_slot(dsi_variables) {
                option::Option[*AnyObject]::Some(dvp_variables) => {
                    match variables.key_ptr_at_slot(dsi_variables) {
                        option::Option[*text::Text]::Some(dkp_variables) => {
                    let dval_variables: *u8 = (*dvp_variables).raw();
                            rt::msg_void_id_id(dict_variables, dset_variables, dval_variables, bridge::nsstring((*dkp_variables).view()));
                        }
                        option::Option[*text::Text]::None => {}
                    }
                }
                option::Option[*AnyObject]::None => {}
            }
            dsi_variables = dsi_variables +% (1 as usize);
        }
        return rt::msg_id_id(this._obj, rt::sel(#str_ptr("predicateWithSubstitutionVariables:\0")), dict_variables);
    }

