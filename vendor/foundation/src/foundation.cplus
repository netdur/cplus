    if raw == (3 as i64) { return UserNotificationActivationType::Replied; }
    if raw == (4 as i64) { return UserNotificationActivationType::AdditionalActionClicked; }
    return UserNotificationActivationType::None;
}

// `NSCalculationError` (NS_ENUM)
enum CalculationError {
    NSCalculationNoError,
    NSCalculationLossOfPrecision,
    NSCalculationUnderflow,
    NSCalculationOverflow,
    NSCalculationDivideByZero,
}

fn calculation_error_raw(v: CalculationError) -> i64 {
    return match v {
        CalculationError::NSCalculationNoError => { 0 as i64 },
        CalculationError::NSCalculationLossOfPrecision => { 1 as i64 },
        CalculationError::NSCalculationUnderflow => { 2 as i64 },
        CalculationError::NSCalculationOverflow => { 3 as i64 },
        CalculationError::NSCalculationDivideByZero => { 4 as i64 },
    };
}

fn calculation_error_from_raw(raw: i64) -> CalculationError {
    if raw == (1 as i64) { return CalculationError::NSCalculationLossOfPrecision; }
    if raw == (2 as i64) { return CalculationError::NSCalculationUnderflow; }
    if raw == (3 as i64) { return CalculationError::NSCalculationOverflow; }
    if raw == (4 as i64) { return CalculationError::NSCalculationDivideByZero; }
    return CalculationError::NSCalculationNoError;
}

// `NSAffineTransformStruct` — by-value C struct.
#[repr(C)]
struct AffineTransformStruct {
    m11: f64,
    m12: f64,
    m21: f64,
    m22: f64,
    tX: f64,
    tY: f64,
}

// `NSEdgeInsets` — by-value C struct.
#[repr(C)]
struct EdgeInsets {
    top: f64,
    left: f64,
    bottom: f64,
    right: f64,
}

// `NSOperatingSystemVersion` — by-value C struct.
#[repr(C)]
struct OperatingSystemVersion {
    majorVersion: i64,
    minorVersion: i64,
    patchVersion: i64,
}

// Untyped Objective-C object handle (`id` / `NSObject *` with no bound type).
// Non-owning; the caller manages lifetime.
struct AnyObject {
    opaque _obj: *u8,
}

impl AnyObject {
    fn raw(this) -> *u8 { return this._obj; }
    fn from_raw(ptr: *u8) -> AnyObject { return AnyObject { _obj: ptr }; }
}

