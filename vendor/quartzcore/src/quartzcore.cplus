// Untyped Objective-C object handle (`id` / `NSObject *` with no bound type).
// Non-owning; the caller manages lifetime.
struct AnyObject {
    opaque _obj: *u8,
}

impl AnyObject {
    fn raw(this) -> *u8 { return this._obj; }
    fn from_raw(ptr: *u8) -> AnyObject { return AnyObject { _obj: ptr }; }
}

