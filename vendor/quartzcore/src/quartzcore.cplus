        let obj: *u8 = rt::msg_id_id_id(rt::get_class(#str_ptr("CIRAWFilter\0")), rt::sel(#str_ptr("filterWithCVPixelBuffer:properties:\0")), buffer, properties.raw());
        if obj == { 0 as *u8 } {
