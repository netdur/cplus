#[repr(C)]
struct Transaction_set_completion_block_block {
    opaque isa: *u8,
    flags: i32,
    reserved: i32,
    invoke: fn(*u8),
    opaque descriptor: *u8,
    user_fn: fn(*u8),
    opaque ctx: *u8,
}

fn Transaction_set_completion_block_invoke(block: *u8) {
    let bl: *Transaction_set_completion_block_block = { block as *Transaction_set_completion_block_block };
    let f: fn(*u8) = { (*bl).user_fn };
    let ctx: *u8 = { (*bl).ctx };
    f(ctx);
    return;
}

// `CIVector` (Foundation/ObjC). Owned via alloc/init; `drop` releases the +1.
struct CIVector {
    _obj: *u8,
}

impl CIVector {
    fn raw(this) -> *u8 { return this._obj; }

    fn from_raw(ptr: *u8) -> CIVector { return CIVector { _obj: rt::retain(ptr) }; }

    fn vector_with_values(values: *u8, count: u64) -> CIVector {
        return CIVector { _obj: rt::retain(rt::msg_id_id_u64(rt::get_class(#str_ptr("CIVector\0")), rt::sel(#str_ptr("vectorWithValues:count:\0")), values, count)) };
    }

