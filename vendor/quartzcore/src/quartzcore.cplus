        var out: vec::Vec[EmitterCell] = vec::Vec[EmitterCell]::with_capacity(n as usize);
        let at_sel: *u8 = rt::sel(#str_ptr("objectAtIndex:\0"));
        var i: u64 = 0 as u64;
        while i < n {
            out.append(EmitterCell::from_raw(rt::msg_id_u64(arr, at_sel, i)));
            i = i +% (1 as u64);
        }
        return out;
    }

    fn set_emitter_cells(this, emitter_cells: vec::Vec[EmitterCell]) {
        let arr_emitter_cells: *u8 = rt::msg_id(rt::get_class(#str_ptr("NSMutableArray\0")), rt::sel(#str_ptr("array\0")));
        let add_sel_emitter_cells: *u8 = rt::sel(#str_ptr("addObject:\0"));
        let n_emitter_cells: usize = emitter_cells.count();
        var i_emitter_cells: usize = 0 as usize;
        while i_emitter_cells < n_emitter_cells {
            match emitter_cells.at_ptr(i_emitter_cells) {
                option::Option[*EmitterCell]::Some(e_emitter_cells) => { rt::msg_void_id(arr_emitter_cells, add_sel_emitter_cells, (*e_emitter_cells).raw()); }
                option::Option[*EmitterCell]::None => {}
            }
            i_emitter_cells = i_emitter_cells +% (1 as usize);
        }
        rt::msg_void_id(this._obj, rt::sel(#str_ptr("setEmitterCells:\0")), arr_emitter_cells);
    }

    fn style(this) -> option::Option[NSDictionary] {
        let obj: *u8 = rt::msg_id(this._obj, rt::sel(#str_ptr("style\0")));
        if obj == { 0 as *u8 } {
            return option::Option[NSDictionary]::None;
        }
        return option::some(NSDictionary::from_raw(obj));
    }

