    }

    fn sublayers(this) -> vec::Vec[Layer] {
        let arr: *u8 = rt::msg_id(this._obj, rt::sel(#str_ptr("sublayers\0")));
        let n: u64 = rt::msg_u64(arr, rt::sel(#str_ptr("count\0")));
        var out: vec::Vec[Layer] = vec::Vec[Layer]::with_capacity(n as usize);
        let at_sel: *u8 = rt::sel(#str_ptr("objectAtIndex:\0"));
        var i: u64 = 0 as u64;
        while i < n {
            out.append(Layer::from_raw(rt::msg_id_u64(arr, at_sel, i)));
            i = i +% (1 as u64);
        }
        return out;
    }

    fn set_sublayers(this, sublayers: vec::Vec[Layer]) {
        let arr_sublayers: *u8 = rt::msg_id(rt::get_class(#str_ptr("NSMutableArray\0")), rt::sel(#str_ptr("array\0")));
        let add_sel_sublayers: *u8 = rt::sel(#str_ptr("addObject:\0"));
        let n_sublayers: usize = sublayers.count();
        var i_sublayers: usize = 0 as usize;
        while i_sublayers < n_sublayers {
            match sublayers.at_ptr(i_sublayers) {
                option::Option[*Layer]::Some(e_sublayers) => { rt::msg_void_id(arr_sublayers, add_sel_sublayers, (*e_sublayers).raw()); }
                option::Option[*Layer]::None => {}
            }
            i_sublayers = i_sublayers +% (1 as usize);
        }
        rt::msg_void_id(this._obj, rt::sel(#str_ptr("setSublayers:\0")), arr_sublayers);
    }

