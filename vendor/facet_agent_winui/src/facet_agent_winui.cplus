// facet_agent_winui - the WinUI agent connector, kept as a door onto
// facet_agent.
//
// facet_agent's Windows facade IS the WinUI connector now (netdu/cplus#20):
// `facet_agent/agent::enable()` installs facet_winui's agent hooks and serves
// agent_winui. This package remains so apps and probes written against it -
// `facet_winui::run` hosts that call `enable(id)` themselves - keep building;
// every call forwards. New code imports `facet_agent/agent`.
import "agent_core/backend" as backend;
import "facet_agent/agent" as facade;

// Install the hooks, and serve under `mcp_id` (when given) as the first window opens.
fn enable(mcp_id: str = "") {
    facade::enable();
    if mcp_id != "" { facade::serve_once(mcp_id); }
}
fn disable() { facade::disable(); }
// The bound port, or a negative setup error (-12 before any window).
fn serve(id: str) -> i32 { return facade::serve(id); }
fn surface_ptr() -> *u8 { return facade::surface_ptr(); }
fn mcp_backend() -> backend::Backend { return facade::mcp_backend(); }
