// securestore_backend_android — an AES key the app cannot extract, and the
// ciphertext beside it.
//
// ---- why not EncryptedSharedPreferences ------------------------------------
//
// That is `androidx.security:security-crypto`, an `.aar`. Linking one without
// Gradle is possible — unzip, `d8` the classes.jar, merge — but it depends on
// Tink, a large general-purpose crypto library, for what is the sixty lines
// below over classes already in `android.jar`. Pulling a crypto library plus a
// Maven resolution step to avoid sixty lines is the wrong trade for the first
// package in the tree that would do it. See plans/securestore.md §2.
//
// ---- the shape --------------------------------------------------------------
//
//   KeyStore.getInstance("AndroidKeyStore").load(null)
//   if !containsAlias:  KeyGenerator("AES","AndroidKeyStore")
//                         .init(KeyGenParameterSpec.Builder(alias, ENC|DEC)
//                                 .setBlockModes("GCM")
//                                 .setEncryptionPaddings("NoPadding").build())
//                         .generateKey()
//   Cipher("AES/GCM/NoPadding") encrypt -> (iv, ciphertext)
//   SharedPreferences.putString(key, base64(len(iv) || iv || ciphertext))
//
// THE KEY NEVER LEAVES THE KEYSTORE. That is the entire point: what lands in
// SharedPreferences is worthless without key material the OS holds, and on a
// device with a TEE or StrongBox that material is not extractable even with
// root. The prefs file is readable by `adb shell run-as`, and it should be —
// asserting that what is in it is NOT the plaintext is the security claim this
// package makes, and the one worth testing.
//
// GCM GENERATES ITS OWN IV, which is lucky rather than clever: `stdlib/crypto`
// is macOS/BSD only, so there is no CSPRNG on this platform, and a hand-rolled
// IV would be the worst part of this file. `Cipher.getIV()` hands back the one
// it chose, and reuse of an IV under one key is the failure GCM cannot survive.

import "stdlib/option" as option;
import "stdlib/text" as text;
import "stdlib/vec" as vec;
import "stdlib/status" as status;
import "stdlib/base64" as base64;
import "jni/jni" as jni;
import "android_view/runtime" as rt;
import "facet/app_events" as ev;
import "./securestore" as ss;

// The status codes the facade maps back. Negative, because `_c_get` reports a
// byte count through the same return.
fn _ok() -> i32 { return 0 as i32; }
fn _not_found() -> i32 { return 0 -% 1; }
fn _denied() -> i32 { return 0 -% 2; }
fn _unsupported() -> i32 { return 0 -% 3; }
fn _failed() -> i32 { return 0 -% 4; }

// One key per service, named for it, so `clear` on one namespace cannot destroy
// another's ability to read its own data.
const _KEY_PREFIX: str = "cplus.securestore.";
const _PROVIDER: str = "AndroidKeyStore";
const _TRANSFORM: str = "AES/GCM/NoPadding";

// javax.crypto.Cipher
fn _encrypt_mode() -> i32 { return 1 as i32; }
fn _decrypt_mode() -> i32 { return 2 as i32; }
// android.security.keystore.KeyProperties: PURPOSE_ENCRYPT | PURPOSE_DECRYPT.
// Spelled arithmetically rather than as 3 so both halves stay legible.
fn _purposes() -> i32 { return (1 as i32) +% (2 as i32); }
// GCM's authentication tag, in BITS. 128 is the only length worth using and the
// only one `GCMParameterSpec` is given here.
fn _tag_bits() -> i32 { return 128 as i32; }

fn _current_env() -> rt::Env {
    let raw: *u8 = ev::host_runtime();
    if raw.is_null() { return rt::from_native(0 as *jni::JNIEnv); }
    let vm: *jni::JavaVM = { raw as *jni::JavaVM };
    var envp: *jni::JNIEnv = 0 as *jni::JNIEnv;
    // JNI_VERSION_1_6 = 0x00010006.
    let got: i32 = { (*(*vm)).GetEnv(vm, { #addr_of(envp) as *u8 }, 65542 as i32) };
    if got == (0 as i32) { return rt::from_native(envp); }
    // AS DAEMON, the same rule `permissions` and `facet_android/mainthread`
    // write down: a non-daemon attachment keeps the VM alive and the process
    // never exits.
    let rc: i32 = { (*(*vm)).AttachCurrentThreadAsDaemon(vm, { #addr_of(envp) as *u8 },
                                                         0 as *u8) };
    if rc != (0 as i32) { return rt::from_native(0 as *jni::JNIEnv); }
    return rt::from_native(envp);
}

// A build with no Activity and no VM is a build with no facet backend — a
// headless tool linking this package. `Unsupported` is the honest answer.
fn _ready() -> bool {
    if !ev::has_host() { return false; }
    if !ev::has_host_runtime() { return false; }
    return true;
}

fn _view(p: *u8, n: usize) -> str { return { #str_from_raw_parts(p, n) }; }

// A JVM exception left pending poisons the NEXT JNI call, which then fails for
// a reason that has nothing to do with it. Cleared at every exit from this
// file, and the boolean says whether one was there.
fn _threw(env: rt::Env) -> bool {
    if !env.has_pending_exception() { return false; }
    env.clear_exception();
    return true;
}

// A `jstring` from a C+ view. `NewStringUTF` wants NUL-terminated bytes and a
// `str` is not, so this copies through a buffer.
//
// SIXTEEN KILOBYTES, and the number is derived rather than picked. The longest
// thing that goes through here is the stored BLOB: a 4096-byte value
// (MAX_VALUE_BYTES) plus GCM's 16-byte tag, a 12-byte IV and a length byte is
// 4125 bytes, and base64 expands by 4/3 to about 5.5KB. 16K leaves room for the
// limit to move without this becoming the thing that caps it.
//
// It was 512, and that is the bug this comment exists for: a 4096-byte value
// silently produced a NULL jstring, `putString` stored null, and `set` answered
// `Ok` for a value that was never written. Caught by `playground/ssprobe` on the
// emulator — "4096 bytes -> Ok" followed by a failed read.
const _JSTR_CAP: usize = 16384 as usize;

fn _jstr(env: rt::Env, s: str) -> jni::jobject {
    var buf: [u8; 16384] = #zero::[[u8; 16384]]();
    let p: *u8 = { #addr_of(buf) as *u8 };
    var i: usize = 0 as usize;
    let n: usize = #str_len(s);
    // REFUSED, not truncated: a truncated blob decodes to nothing and the
    // failure surfaces at the read, a long way from the call that caused it.
    if n >= _JSTR_CAP { return 0 as jni::jobject; }
    while i < n { { *(p + i) = *(#str_ptr(s) + i); } i = i +% (1 as usize); }
    { *(p + n) = 0 as u8; }
    return env.new_string_utf(p);
}

// ---- the keystore ------------------------------------------------------------

fn _keystore(env: rt::Env) -> jni::jobject {
    let ks: jni::jobject = env.call_object_static_1(
        #str_ptr("java/security/KeyStore\0"), #str_ptr("getInstance\0"),
        #str_ptr("(Ljava/lang/String;)Ljava/security/KeyStore;\0"),
        jni::JValue::of_object(_jstr(env, _PROVIDER)));
    if _threw(env) { return 0 as jni::jobject; }
    if ks == (0 as jni::jobject) { return 0 as jni::jobject; }
    // `load(null)` is not optional — an unloaded KeyStore throws on every
    // query, and the exception says "Uninitialized keystore" three calls later.
    env.call_void_1(ks, #str_ptr("java/security/KeyStore\0"), #str_ptr("load\0"),
                    #str_ptr("(Ljava/security/KeyStore$LoadStoreParameter;)V\0"),
                    jni::JValue::of_object(0 as jni::jobject));
    if _threw(env) { return 0 as jni::jobject; }
    return ks;
}

fn _alias_for(service: str) -> text::Text {
    return text::from_str("${_KEY_PREFIX}${service}");
}

// The AES key for `alias`, generated inside the keystore on first use.
//
// GENERATED, NEVER IMPORTED. `setKey`/`SecretKeySpec` would mean the key
// material existed in this process's memory at some point, which is the one
// property this package is bought for.
fn _key(env: rt::Env, ks: jni::jobject, alias: str) -> jni::jobject {
    let a: jni::jobject = _jstr(env, alias);
    if a == (0 as jni::jobject) { return 0 as jni::jobject; }

    let has: bool = env.call_bool_1(ks, #str_ptr("java/security/KeyStore\0"),
                                    #str_ptr("containsAlias\0"),
                                    #str_ptr("(Ljava/lang/String;)Z\0"),
                                    jni::JValue::of_object(a));
    if _threw(env) { return 0 as jni::jobject; }

    if !has {
        let keygen: jni::jobject = env.call_object_static_2(
            #str_ptr("javax/crypto/KeyGenerator\0"), #str_ptr("getInstance\0"),
            #str_ptr("(Ljava/lang/String;Ljava/lang/String;)Ljavax/crypto/KeyGenerator;\0"),
            jni::JValue::of_object(_jstr(env, "AES")),
            jni::JValue::of_object(_jstr(env, _PROVIDER)));
        if _threw(env) { return 0 as jni::jobject; }
        if keygen == (0 as jni::jobject) { return 0 as jni::jobject; }

        // THE BUILDER CHAIN, which is the ugliest part of this file and is
        // written once. Each link is a GetMethodID plus a CallObjectMethod, and
        // the two array arguments exist because the API takes varargs.
        var b: jni::jobject = env.new_object_2(
            #str_ptr("android/security/keystore/KeyGenParameterSpec$Builder\0"),
            #str_ptr("(Ljava/lang/String;I)V\0"),
            jni::JValue::of_object(a), jni::JValue::of_int(_purposes()));
        if _threw(env) { return 0 as jni::jobject; }
        if b == (0 as jni::jobject) { return 0 as jni::jobject; }

        let modes: jni::jobjectArray = env.new_object_array(
            1 as i32, #str_ptr("java/lang/String\0"), _jstr(env, "GCM"));
        b = env.call_object_1(b,
            #str_ptr("android/security/keystore/KeyGenParameterSpec$Builder\0"),
            #str_ptr("setBlockModes\0"),
            #str_ptr("([Ljava/lang/String;)Landroid/security/keystore/KeyGenParameterSpec$Builder;\0"),
            jni::JValue::of_object({ modes as jni::jobject }));
        if _threw(env) { return 0 as jni::jobject; }

        let pads: jni::jobjectArray = env.new_object_array(
            1 as i32, #str_ptr("java/lang/String\0"), _jstr(env, "NoPadding"));
        b = env.call_object_1(b,
            #str_ptr("android/security/keystore/KeyGenParameterSpec$Builder\0"),
            #str_ptr("setEncryptionPaddings\0"),
            #str_ptr("([Ljava/lang/String;)Landroid/security/keystore/KeyGenParameterSpec$Builder;\0"),
            jni::JValue::of_object({ pads as jni::jobject }));
        if _threw(env) { return 0 as jni::jobject; }

        let spec: jni::jobject = env.call_object_0(b,
            #str_ptr("android/security/keystore/KeyGenParameterSpec$Builder\0"),
            #str_ptr("build\0"),
            #str_ptr("()Landroid/security/keystore/KeyGenParameterSpec;\0"));
        if _threw(env) { return 0 as jni::jobject; }

        env.call_void_1(keygen, #str_ptr("javax/crypto/KeyGenerator\0"), #str_ptr("init\0"),
                        #str_ptr("(Ljava/security/spec/AlgorithmParameterSpec;)V\0"),
                        jni::JValue::of_object(spec));
        if _threw(env) { return 0 as jni::jobject; }
        let _k: jni::jobject = env.call_object_0(keygen,
            #str_ptr("javax/crypto/KeyGenerator\0"), #str_ptr("generateKey\0"),
            #str_ptr("()Ljavax/crypto/SecretKey;\0"));
        if _threw(env) { return 0 as jni::jobject; }
    }

    let k: jni::jobject = env.call_object_2(ks, #str_ptr("java/security/KeyStore\0"),
        #str_ptr("getKey\0"),
        #str_ptr("(Ljava/lang/String;[C)Ljava/security/Key;\0"),
        jni::JValue::of_object(a), jni::JValue::of_object(0 as jni::jobject));
    if _threw(env) { return 0 as jni::jobject; }
    return k;
}

// ---- the preferences file ----------------------------------------------------

fn _prefs(env: rt::Env, service: str) -> jni::jobject {
    // MODE_PRIVATE = 0. The file is readable only by this uid, which is the
    // sandbox's job; the encryption is what protects it from a backup or an
    // extracted image.
    let p: jni::jobject = env.call_object_2(ev::host(),
        #str_ptr("android/content/Context\0"), #str_ptr("getSharedPreferences\0"),
        #str_ptr("(Ljava/lang/String;I)Landroid/content/SharedPreferences;\0"),
        jni::JValue::of_object(_jstr(env, service)), jni::JValue::of_int(0 as i32));
    if _threw(env) { return 0 as jni::jobject; }
    return p;
}

fn _editor(env: rt::Env, prefs: jni::jobject) -> jni::jobject {
    let e: jni::jobject = env.call_object_0(prefs,
        #str_ptr("android/content/SharedPreferences\0"), #str_ptr("edit\0"),
        #str_ptr("()Landroid/content/SharedPreferences$Editor;\0"));
    if _threw(env) { return 0 as jni::jobject; }
    return e;
}

fn _apply(env: rt::Env, editor: jni::jobject) {
    // `apply`, not `commit`: the write is asynchronous but atomic, and the
    // in-memory map is updated before it returns — so a `get` right after a
    // `set` reads the new value whether or not the file has landed.
    env.call_void_0(editor, #str_ptr("android/content/SharedPreferences$Editor\0"),
                    #str_ptr("apply\0"), #str_ptr("()V\0"));
    if _threw(env) { return; }
    return;
}

// ---- the verbs ---------------------------------------------------------------

export extern fn _c_set(key: *u8, key_len: usize, value: *u8, value_len: usize,
                        service: *u8, service_len: usize) -> i32 {
    if !_ready() { return _unsupported(); }
    let env: rt::Env = _current_env();
    if env.raw().is_null() { return _unsupported(); }
    let k: str = _view(key, key_len);
    let s: str = _view(service, service_len);
    let v: str = _view(value, value_len);

    let ks: jni::jobject = _keystore(env);
    if ks == (0 as jni::jobject) { return _denied(); }
    let alias: text::Text = _alias_for(s);
    let secret: jni::jobject = _key(env, ks, alias.view());
    if secret == (0 as jni::jobject) { return _denied(); }

    let cipher: jni::jobject = env.call_object_static_1(
        #str_ptr("javax/crypto/Cipher\0"), #str_ptr("getInstance\0"),
        #str_ptr("(Ljava/lang/String;)Ljavax/crypto/Cipher;\0"),
        jni::JValue::of_object(_jstr(env, _TRANSFORM)));
    if _threw(env) { return _failed(); }
    if cipher == (0 as jni::jobject) { return _failed(); }

    env.call_void_2(cipher, #str_ptr("javax/crypto/Cipher\0"), #str_ptr("init\0"),
                    #str_ptr("(ILjava/security/Key;)V\0"),
                    jni::JValue::of_int(_encrypt_mode()),
                    jni::JValue::of_object(secret));
    if _threw(env) { return _denied(); }

    let plain: jni::jbyteArray = env.new_byte_array({ #str_len(v) as i32 });
    if plain == (0 as jni::jbyteArray) { return _failed(); }
    env.byte_array_set(plain, #str_ptr(v), { #str_len(v) as i32 });
    let ct: jni::jobject = env.call_object_1(cipher, #str_ptr("javax/crypto/Cipher\0"),
        #str_ptr("doFinal\0"), #str_ptr("([B)[B\0"),
        jni::JValue::of_object({ plain as jni::jobject }));
    if _threw(env) { return _failed(); }

    let iv: jni::jobject = env.call_object_0(cipher, #str_ptr("javax/crypto/Cipher\0"),
        #str_ptr("getIV\0"), #str_ptr("()[B\0"));
    if _threw(env) { return _failed(); }

    // [iv_len][iv][ciphertext], base64'd. One byte for the length because GCM's
    // IV is twelve; a delimiter would have to be escaped out of the ciphertext,
    // which is binary.
    var packed: [u8; 8192] = #zero::[[u8; 8192]]();
    let pp: *u8 = { #addr_of(packed) as *u8 };
    let iv_len: i32 = env.byte_array_len({ iv as jni::jbyteArray });
    let ct_len: i32 = env.byte_array_len({ ct as jni::jbyteArray });
    if (iv_len +% ct_len +% (1 as i32)) > (8192 as i32) { return _failed(); }
    { *pp = iv_len as u8; }
    let _a: i32 = env.byte_array_into({ iv as jni::jbyteArray }, { pp + (1 as usize) }, iv_len);
    let _b: i32 = env.byte_array_into({ ct as jni::jbyteArray },
                                      { pp + ((1 as usize) +% { iv_len as usize }) }, ct_len);
    let total: usize = (1 as usize) +% { iv_len as usize } +% { ct_len as usize };
    let blob: text::Text = base64::encode_bytes(pp, total);

    let prefs: jni::jobject = _prefs(env, s);
    if prefs == (0 as jni::jobject) { return _failed(); }
    let ed: jni::jobject = _editor(env, prefs);
    if ed == (0 as jni::jobject) { return _failed(); }
    // BOTH STRINGS CHECKED. `putString` accepts a null value and stores null,
    // so an unchecked conversion turns "too long to convert" into a silent
    // successful-looking write — which is exactly what happened when the buffer
    // above was 512 bytes.
    let jkey: jni::jobject = _jstr(env, k);
    let jblob: jni::jobject = _jstr(env, blob.view());
    if jkey == (0 as jni::jobject) { return _failed(); }
    if jblob == (0 as jni::jobject) { return _failed(); }
    let _e: jni::jobject = env.call_object_2(ed,
        #str_ptr("android/content/SharedPreferences$Editor\0"), #str_ptr("putString\0"),
        #str_ptr("(Ljava/lang/String;Ljava/lang/String;)Landroid/content/SharedPreferences$Editor;\0"),
        jni::JValue::of_object(jkey),
        jni::JValue::of_object(jblob));
    if _threw(env) { return _failed(); }
    _apply(env, ed);
    return _ok();
}

export extern fn _c_get(key: *u8, key_len: usize, service: *u8, service_len: usize,
                        out: *u8, cap: usize) -> i64 {
    if !_ready() { return { _unsupported() as i64 }; }
    let env: rt::Env = _current_env();
    if env.raw().is_null() { return { _unsupported() as i64 }; }
    let k: str = _view(key, key_len);
    let s: str = _view(service, service_len);

    let prefs: jni::jobject = _prefs(env, s);
    if prefs == (0 as jni::jobject) { return { _failed() as i64 }; }
    let stored: jni::jobject = env.call_object_2(prefs,
        #str_ptr("android/content/SharedPreferences\0"), #str_ptr("getString\0"),
        #str_ptr("(Ljava/lang/String;Ljava/lang/String;)Ljava/lang/String;\0"),
        jni::JValue::of_object(_jstr(env, k)),
        jni::JValue::of_object(0 as jni::jobject));
    if _threw(env) { return { _failed() as i64 }; }
    if stored == (0 as jni::jobject) { return { _not_found() as i64 }; }

    var b64: [u8; 12288] = #zero::[[u8; 12288]]();
    let bp: *u8 = { #addr_of(b64) as *u8 };
    if !env.string_utf_into(stored, bp, 12288 as usize) { return { _failed() as i64 }; }
    var blen: usize = 0 as usize;
    while blen < (12288 as usize) { if { *(bp + blen) } == (0 as u8) { break; } blen = blen +% (1 as usize); }

    let packed: vec::Vec[u8] = match base64::decode({ #str_from_raw_parts(bp, blen) }) {
        option::Option[vec::Vec[u8]]::Some(v) => v,
        option::Option::None => { return { _failed() as i64 }; }
    };
    if { packed.count() } < (2 as usize) { return { _failed() as i64 }; }
    // `as_byte_view` rather than an `as_ptr` this Vec does not have: it hands
    // back a `str` over the same buffer, and `#str_ptr` is its address.
    let view: str = { packed.as_byte_view() };
    let raw: *u8 = #str_ptr(view);
    let iv_len: usize = { { *raw } as usize };
    if ({ (1 as usize) +% iv_len }) >= { packed.count() } { return { _failed() as i64 }; }
    let ct_len: usize = { packed.count() } -% (1 as usize) -% iv_len;

    let ks: jni::jobject = _keystore(env);
    if ks == (0 as jni::jobject) { return { _denied() as i64 }; }
    let alias: text::Text = _alias_for(s);
    let secret: jni::jobject = _key(env, ks, alias.view());
    if secret == (0 as jni::jobject) { return { _denied() as i64 }; }

    let ivarr: jni::jbyteArray = env.new_byte_array({ iv_len as i32 });
    env.byte_array_set(ivarr, { raw + (1 as usize) }, { iv_len as i32 });
    let spec: jni::jobject = env.new_object_2(
        #str_ptr("javax/crypto/spec/GCMParameterSpec\0"), #str_ptr("(I[B)V\0"),
        jni::JValue::of_int(_tag_bits()), jni::JValue::of_object({ ivarr as jni::jobject }));
    if _threw(env) { return { _failed() as i64 }; }

    let cipher: jni::jobject = env.call_object_static_1(
        #str_ptr("javax/crypto/Cipher\0"), #str_ptr("getInstance\0"),
        #str_ptr("(Ljava/lang/String;)Ljavax/crypto/Cipher;\0"),
        jni::JValue::of_object(_jstr(env, _TRANSFORM)));
    if _threw(env) { return { _failed() as i64 }; }
    env.call_void_3(cipher, #str_ptr("javax/crypto/Cipher\0"), #str_ptr("init\0"),
                    #str_ptr("(ILjava/security/Key;Ljava/security/spec/AlgorithmParameterSpec;)V\0"),
                    jni::JValue::of_int(_decrypt_mode()),
                    jni::JValue::of_object(secret),
                    jni::JValue::of_object(spec));
    if _threw(env) { return { _denied() as i64 }; }

    let ctarr: jni::jbyteArray = env.new_byte_array({ ct_len as i32 });
    env.byte_array_set(ctarr, { raw + ((1 as usize) +% iv_len) }, { ct_len as i32 });
    let plain: jni::jobject = env.call_object_1(cipher, #str_ptr("javax/crypto/Cipher\0"),
        #str_ptr("doFinal\0"), #str_ptr("([B)[B\0"),
        jni::JValue::of_object({ ctarr as jni::jobject }));
    // A THROW HERE IS AN AUTHENTICATION FAILURE, and it is the interesting one:
    // GCM refuses ciphertext that was altered, so a tampered prefs file reads as
    // `Failed` rather than as plausible garbage.
    if _threw(env) { return { _failed() as i64 }; }

    let n: i32 = env.byte_array_len({ plain as jni::jbyteArray });
    if { n as usize } > cap { return { _failed() as i64 }; }
    let _c: i32 = env.byte_array_into({ plain as jni::jbyteArray }, out, n);
    return { n as i64 };
}

export extern fn _c_remove(key: *u8, key_len: usize,
                           service: *u8, service_len: usize) -> i32 {
    if !_ready() { return _unsupported(); }
    let env: rt::Env = _current_env();
    if env.raw().is_null() { return _unsupported(); }
    let k: str = _view(key, key_len);
    let prefs: jni::jobject = _prefs(env, _view(service, service_len));
    if prefs == (0 as jni::jobject) { return _failed(); }
    let present: bool = env.call_bool_1(prefs,
        #str_ptr("android/content/SharedPreferences\0"), #str_ptr("contains\0"),
        #str_ptr("(Ljava/lang/String;)Z\0"), jni::JValue::of_object(_jstr(env, k)));
    if _threw(env) { return _failed(); }
    // NOT AN ERROR, and the same answer the Apple half gives: a caller clearing
    // a token it may never have written should not have to check first.
    if !present { return _not_found(); }
    let ed: jni::jobject = _editor(env, prefs);
    if ed == (0 as jni::jobject) { return _failed(); }
    let _e: jni::jobject = env.call_object_1(ed,
        #str_ptr("android/content/SharedPreferences$Editor\0"), #str_ptr("remove\0"),
        #str_ptr("(Ljava/lang/String;)Landroid/content/SharedPreferences$Editor;\0"),
        jni::JValue::of_object(_jstr(env, k)));
    if _threw(env) { return _failed(); }
    _apply(env, ed);
    return _ok();
}

export extern fn _c_contains(key: *u8, key_len: usize,
                             service: *u8, service_len: usize) -> i32 {
    if !_ready() { return 0 as i32; }
    let env: rt::Env = _current_env();
    if env.raw().is_null() { return 0 as i32; }
    let prefs: jni::jobject = _prefs(env, _view(service, service_len));
    if prefs == (0 as jni::jobject) { return 0 as i32; }
    // NO DECRYPT: existence is a question about the file, and decrypting to
    // answer it would spend a keystore round-trip and could fail for reasons
    // that have nothing to do with whether the key is there.
    let present: bool = env.call_bool_1(prefs,
        #str_ptr("android/content/SharedPreferences\0"), #str_ptr("contains\0"),
        #str_ptr("(Ljava/lang/String;)Z\0"),
        jni::JValue::of_object(_jstr(env, _view(key, key_len))));
    if _threw(env) { return 0 as i32; }
    if present { return 1 as i32; }
    return 0 as i32;
}

export extern fn _c_clear(service: *u8, service_len: usize) -> i32 {
    if !_ready() { return _unsupported(); }
    let env: rt::Env = _current_env();
    if env.raw().is_null() { return _unsupported(); }
    let prefs: jni::jobject = _prefs(env, _view(service, service_len));
    if prefs == (0 as jni::jobject) { return _failed(); }
    let ed: jni::jobject = _editor(env, prefs);
    if ed == (0 as jni::jobject) { return _failed(); }
    // `clear()` empties THIS FILE, which is this service and nothing else — the
    // namespace bound the facade promises, here for free rather than by a
    // careful query.
    let _e: jni::jobject = env.call_object_0(ed,
        #str_ptr("android/content/SharedPreferences$Editor\0"), #str_ptr("clear\0"),
        #str_ptr("()Landroid/content/SharedPreferences$Editor;\0"));
    if _threw(env) { return _failed(); }
    _apply(env, ed);
    // THE KEY IS LEFT IN THE KEYSTORE deliberately. Deleting it would make every
    // value written before this call permanently unreadable — which is exactly
    // what `clear` just did anyway, but it would ALSO break a concurrent reader
    // holding a decrypt cipher. The alias is reused on the next `set`.
    return _ok();
}
