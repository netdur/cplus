// securestore_backend_windows — the honest stub, for now.
//
// THIS FILE EXISTS SO A WINDOWS BUILD LINKS. `securestore.cplus` declares five
// stable symbols and something must define them on every platform the package
// claims; without a `_windows` sibling the build falls back to
// `securestore_backend.cplus` — the Keychain half — and stops at its Apple
// imports.
//
// EVERY VERB ANSWERS `Unsupported`, and that is the honest answer rather than a
// dangerous one: `set` returns `_C_UNSUPPORTED` (not `_C_OK`), so an application
// that stores a token learns immediately that it was NOT stored, instead of
// believing a secret is safe and losing it. `contains` is a plain `0`. Nothing
// is written, so nothing is ever read back — the one thing a secure store must
// never do is silently claim success.
//
// THE REAL WINDOWS STORE IS THE CREDENTIAL MANAGER — `CredWriteW` / `CredReadW`
// / `CredDeleteW` over `CRED_TYPE_GENERIC` credentials, which the OS encrypts
// per-user with DPAPI, keyed on a `service/key` target name. That is the direct
// analogue of the Keychain this package's Apple half uses, and it is a real,
// round-trippable backend rather than a stub — a well-scoped next pass, kept out
// of this one so the package builds first and gains function second.


// The wire codes `securestore.cplus` decodes: 0 Ok, -1 NotFound, -2 Denied,
// -3 Unsupported, -4 Failed. `_c_get` returns i64 (a non-negative byte count on
// success, one of these negatives on failure); the rest return i32.
fn _c_ok() -> i32 { return 0 as i32; }
fn _c_unsupported() -> i32 { return 0 -% (3 as i32); }

export extern fn _c_set(key: *u8, key_len: usize, value: *u8, value_len: usize,
                        service: *u8, service_len: usize) -> i32 {
    return _c_unsupported();
}

export extern fn _c_get(key: *u8, key_len: usize, service: *u8, service_len: usize,
                        out: *u8, cap: usize) -> i64 {
    // A NEGATIVE i64 is a status on this seam; a non-negative one would be a
    // byte count and a claim that `out` now holds a secret. Nothing was stored,
    // so the only truthful answer is the status.
    return { _c_unsupported() as i64 };
}

export extern fn _c_remove(key: *u8, key_len: usize, service: *u8, service_len: usize) -> i32 {
    return _c_unsupported();
}

// 1 present, 0 absent. Nothing is ever stored here, so nothing is present.
export extern fn _c_contains(key: *u8, key_len: usize, service: *u8, service_len: usize) -> i32 {
    return 0 as i32;
}

export extern fn _c_clear(service: *u8, service_len: usize) -> i32 {
    // Nothing to clear; report the build has no store rather than a false `Ok`.
    return _c_unsupported();
}

// ---- tests -------------------------------------------------------------------

// `securestore.cplus` keeps its `_C_*` wire codes private, so these assert
// against this file's own honest answers (0 = Ok, -3 = Unsupported) — the codes
// the facade's `_from_code` turns into `Outcome::Ok` / `Outcome::Unsupported`.

#[test]
fn set_reports_unsupported_rather_than_a_false_ok() {
    let rc: i32 = { _c_set(#str_ptr("k"), #str_len("k"), #str_ptr("v"), #str_len("v"),
                           #str_ptr(""), #str_len("")) };
    assert rc == _c_unsupported();
    assert rc != _c_ok();
}

#[test]
fn get_answers_a_negative_status_never_a_byte_count() {
    var buf: [u8; 16] = [0u8; 16];
    let n: i64 = { _c_get(#str_ptr("k"), #str_len("k"), #str_ptr(""), #str_len(""),
                          #addr_of(buf) as *u8, 16 as usize) };
    // Non-negative would be a claim that `buf` holds a secret; it must not be.
    assert n < (0 as i64);
    assert { n as i32 } == _c_unsupported();
}

#[test]
fn contains_is_false_and_clear_and_remove_do_not_claim_success() {
    assert { _c_contains(#str_ptr("k"), #str_len("k"), #str_ptr(""), #str_len("")) } == (0 as i32);
    assert { _c_remove(#str_ptr("k"), #str_len("k"), #str_ptr(""), #str_len("")) } != _c_ok();
    assert { _c_clear(#str_ptr(""), #str_len("")) } != _c_ok();
}
