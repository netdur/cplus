// securestore_backend_linux — the Secret Service, through libsecret.
//
// A REAL BACKEND, not a refusal. The desktop has exactly the facility this
// package describes: `org.freedesktop.secrets`, implemented by gnome-keyring
// or kwallet, storing items encrypted under a key derived from the login
// password and unlocked with the session. That is the same shape as the
// Keychain — a daemon that holds key material the app cannot extract, and
// answers per-item.
//
// WHAT "SECURE" MEANS ON THIS PLATFORM, since the facade is careful about the
// word: the item file is AES-encrypted under a key derived from the user's
// login password, and the daemon will not hand a secret to anyone but a
// session that unlocked the collection. It is NOT tied to code identity the way
// the macOS keychain is — any process running as the user can ask the daemon
// for this app's items. That is weaker than Apple's guarantee and it is the
// platform's, not this file's; the threat the facade names (a stolen device, a
// copied backup, a sandbox someone walked out with) is still answered.
//
// ---- why libsecret, and why dlopen ------------------------------------------
//
// The Secret Service wire protocol is not one call. Storing an item is: open a
// session with an algorithm, find the default collection through an alias,
// build a `(oayays)` secret struct, CreateItem, and then handle a Prompt object
// with its own asynchronous Completed signal if the collection is locked. The
// prompt is the part that matters — a synchronous `get` cannot drive an
// asynchronous unlock, so a hand-rolled D-Bus half would answer `Denied` for
// every locked keyring rather than unlocking it, which is the ordinary case on
// a machine where the login password and the keyring password differ.
//
// libsecret does all of that, and `secret_password_*_sync` runs its own loop
// for the prompt. So this file is thin on purpose.
//
// IT IS OPENED AT RUNTIME rather than linked. `[<platform>.link]` is reserved
// in the manifest but not implemented (`manifest.rs`: "a future
// `[<platform>.link]` arrives as a feature"), so the only way to name a library
// is `[link]`, which is not platform-scoped — adding `-lsecret-1` there would
// put it on the macOS and Windows link lines too, where it does not exist. So:
// `dlopen`, the same instrument `facet_gtk/web` uses for WebKitGTK, and for the
// same reason it uses it there — a machine without the library gets an honest
// `Unsupported` instead of a binary that will not start.
//
// `dlsym` on libsecret's handle also reaches its dependencies, which is where
// the four glib entry points below come from. No glib dependency is added to
// this package: a securestore that dragged in GObject would tax every consumer
// for a table with three entries in it.
//
// ---- a schema is not needed ---------------------------------------------------
//
// `secret_password_storev_sync` takes a `SecretSchema *` that may be NULL, and
// this passes NULL. A schema does two things: it validates attribute names, and
// it adds an `xdg:schema` attribute so one app's items do not match another's.
// The second is the one that matters, and it is three characters of table entry
// — `"xdg:schema" = "org.cplus.securestore"`, written here by hand — while the
// first would cost a 592-byte struct whose layout this tree cannot verify
// (libsecret's headers are not a build dependency). Guessing a struct layout to
// get validation of attribute names that are literals in this file is the wrong
// trade. Verified against the live daemon: store, lookup and a partial-attribute
// clear all behave with a NULL schema.
//
// ---- the item's identity ------------------------------------------------------
//
// Attributes, not a composed name: `{ xdg:schema, service, key }`. A LOOKUP IS
// AN ATTRIBUTE MATCH, and a partial one matches every item carrying the given
// attributes — which is what makes `clear` a single call over
// `{ xdg:schema, service }` rather than an enumerate-and-delete loop. The
// facade's "bounded by construction" claim holds literally here: the service is
// always in the query, so no shape of call reaches outside one namespace.
//
// ---- the one thing that does not round-trip -----------------------------------
//
// A VALUE CONTAINING A NUL BYTE IS REFUSED. libsecret's password API is
// `const gchar *` — NUL-terminated — so a value with an embedded NUL would be
// stored truncated and read back short. Truncation is precisely the failure
// `MAX_VALUE_BYTES` exists to prevent (a half a token fails authentication
// somewhere far away and nobody traces it back to storage), so this answers
// `Failed` at the write instead. Every value the facade describes — a token, a
// refresh token, a password, an API key — is text and unaffected.
//
// The wire codes `securestore.cplus` decodes: 0 Ok, -1 NotFound, -2 Denied,
// -3 Unsupported, -4 Failed. `_c_get` returns i64 (a non-negative byte count on
// success, one of these negatives on failure); the rest return i32.

extern fn memcpy(dst: *u8, src: *u8, n: usize) -> *u8;
extern fn strlen(p: *u8) -> usize;
extern fn dlopen(path: *u8, flags: i32) -> *u8;
extern fn dlsym(handle: *u8, symbol: *u8) -> *u8;

fn _ok() -> i32 { return 0 as i32; }
fn _not_found() -> i32 { return 0 -% (1 as i32); }
fn _denied() -> i32 { return 0 -% (2 as i32); }
fn _unsupported() -> i32 { return 0 -% (3 as i32); }
fn _failed() -> i32 { return 0 -% (4 as i32); }

// The attribute set every item in this package carries.
fn _attr_schema() -> *u8 { return #str_ptr("xdg:schema\0"); }
fn _schema_name() -> *u8 { return #str_ptr("org.cplus.securestore\0"); }
fn _attr_service() -> *u8 { return #str_ptr("service\0"); }
fn _attr_key() -> *u8 { return #str_ptr("key\0"); }

// A key or a service longer than this is a caller error rather than a platform
// limit; the buffers below are stack-sized and this is what they hold.
fn _name_cap() -> usize { return 512 as usize; }
// MAX_VALUE_BYTES plus its terminator. The facade refuses a longer write before
// it gets here; this is the second half of "enforced at both ends".
fn _value_cap() -> usize { return 4097 as usize; }

// ---- the resolved library ------------------------------------------------------
//
// EVERY SYMBOL OR NONE, the rule `facet_gtk/web` writes down: a half-resolved
// library is worse than an absent one, because the first call nobody checked
// traps instead of answering `Unsupported`.

struct Secret {
    // libsecret
    service_get: fn(i32, *u8, *u8) -> *u8,
    storev: fn(*u8, *u8, *u8, *u8, *u8, *u8, *u8) -> i32,
    lookupv: fn(*u8, *u8, *u8, *u8) -> *u8,
    clearv: fn(*u8, *u8, *u8, *u8) -> i32,
    password_free: fn(*u8),
    collection_for_alias: fn(*u8, *u8, i32, *u8, *u8) -> *u8,
    collection_locked: fn(*u8) -> i32,
    // glib and gobject, reached through libsecret's own dependencies
    ht_new: fn(*u8, *u8, *u8, *u8) -> *u8,
    ht_insert: fn(*u8, *u8, *u8) -> i32,
    ht_unref: fn(*u8),
    object_unref: fn(*u8),
    error_free: fn(*u8),
    io_error_quark: fn() -> u32,
    // Passed on as data, never called from here.
    opaque str_hash: *u8,
    opaque str_equal: *u8,
}

static LOADED: bool = false;
static AVAILABLE: bool = false;
static API: Secret = #zero::[Secret]();

fn _sym(handle: *u8, name: *u8, ok: *bool) -> *u8 {
    let p: *u8 = { dlsym(handle, name) };
    if p == (0 as *u8) { { (*ok) = false }; }
    return p;
}

fn _resolve(handle: *u8) -> bool {
    var ok: bool = true;
    API.service_get = _sym(handle, #str_ptr("secret_service_get_sync\0"), #addr_of(ok))
        as fn(i32, *u8, *u8) -> *u8;
    API.storev = _sym(handle, #str_ptr("secret_password_storev_sync\0"), #addr_of(ok))
        as fn(*u8, *u8, *u8, *u8, *u8, *u8, *u8) -> i32;
    API.lookupv = _sym(handle, #str_ptr("secret_password_lookupv_sync\0"), #addr_of(ok))
        as fn(*u8, *u8, *u8, *u8) -> *u8;
    API.clearv = _sym(handle, #str_ptr("secret_password_clearv_sync\0"), #addr_of(ok))
        as fn(*u8, *u8, *u8, *u8) -> i32;
    API.password_free = _sym(handle, #str_ptr("secret_password_free\0"), #addr_of(ok))
        as fn(*u8);
    API.collection_for_alias = _sym(handle, #str_ptr("secret_collection_for_alias_sync\0"), #addr_of(ok))
        as fn(*u8, *u8, i32, *u8, *u8) -> *u8;
    API.collection_locked = _sym(handle, #str_ptr("secret_collection_get_locked\0"), #addr_of(ok))
        as fn(*u8) -> i32;
    API.ht_new = _sym(handle, #str_ptr("g_hash_table_new_full\0"), #addr_of(ok))
        as fn(*u8, *u8, *u8, *u8) -> *u8;
    API.ht_insert = _sym(handle, #str_ptr("g_hash_table_insert\0"), #addr_of(ok))
        as fn(*u8, *u8, *u8) -> i32;
    API.ht_unref = _sym(handle, #str_ptr("g_hash_table_unref\0"), #addr_of(ok))
        as fn(*u8);
    API.object_unref = _sym(handle, #str_ptr("g_object_unref\0"), #addr_of(ok))
        as fn(*u8);
    API.error_free = _sym(handle, #str_ptr("g_error_free\0"), #addr_of(ok))
        as fn(*u8);
    API.io_error_quark = _sym(handle, #str_ptr("g_io_error_quark\0"), #addr_of(ok))
        as fn() -> u32;
    API.str_hash = _sym(handle, #str_ptr("g_str_hash\0"), #addr_of(ok));
    API.str_equal = _sym(handle, #str_ptr("g_str_equal\0"), #addr_of(ok));
    return ok;
}

// Is there secure storage this process can reach?
//
// THIS ONE DOES DESCRIBE THE MACHINE, unlike `available` on a package whose
// facility is a backend capability. Secure storage on Linux is a daemon that
// may genuinely not be there — a headless box, a container, a session with no
// keyring — and an app told "yes" would get `Failed` from every verb instead of
// the `Unsupported` that tells it to keep its secret somewhere else.
//
// `secret_service_get_sync` connects to (and D-Bus-activates) the daemon and
// nothing more: no collection is opened and no prompt can appear.
fn _load() -> bool {
    if LOADED { return AVAILABLE; }
    LOADED = true;
    // RTLD_NOW: a lazy handle would defer the very failure `_resolve` exists to
    // catch. The versioned soname first, the linker name as the fallback for a
    // machine that has only the development symlink.
    var handle: *u8 = { dlopen(#str_ptr("libsecret-1.so.0\0"), 2 as i32) };
    if handle == (0 as *u8) { handle = { dlopen(#str_ptr("libsecret-1.so\0"), 2 as i32) }; }
    if handle == (0 as *u8) { return false; }
    if !_resolve(handle) { return false; }
    let get: fn(i32, *u8, *u8) -> *u8 = API.service_get;
    var err: *u8 = 0 as *u8;
    let svc: *u8 = get(0 as i32, 0 as *u8, #addr_of(err) as *u8);
    if err != (0 as *u8) { let f: fn(*u8) = API.error_free; f(err); }
    if svc == (0 as *u8) { return false; }
    let unref: fn(*u8) = API.object_unref;
    unref(svc);
    AVAILABLE = true;
    return true;
}

// ---- GError, which is the only place a code is worth reading -------------------
//
// `{ GQuark domain; gint code; gchar *message; }` — domain@0, code@4, message@8.
// Two of libsecret's codes are worth telling apart from "something broke": a
// dismissed unlock prompt and a refused item both arrive as G_IO_ERROR, and both
// mean the platform said no rather than the platform being broken. The facade
// has a `Denied` for exactly that and an app acts on it differently (ask again
// later, versus give up).
//
// FREES THE ERROR. Every caller below hands its GError here exactly once.
fn _map_error(e: *u8) -> i32 {
    if e == (0 as *u8) { return _failed(); }
    let domain: u32 = { *(e as *u32) };
    let code: i32 = { *((e + (4 as usize)) as *i32) };
    let free: fn(*u8) = API.error_free;
    free(e);
    let quark: fn() -> u32 = API.io_error_quark;
    if domain == quark() {
        // G_IO_ERROR_PERMISSION_DENIED = 14, G_IO_ERROR_CANCELLED = 19. The
        // second is what a dismissed unlock prompt answers.
        if code == (14 as i32) { return _denied(); }
        if code == (19 as i32) { return _denied(); }
    }
    return _failed();
}

// ---- attributes ----------------------------------------------------------------
//
// The table borrows every string rather than copying: both destroy functions are
// NULL, so the buffers the callers keep on their own frames have to outlive the
// call — and they do, because the call is on the same frame.

fn _table(sv: *u8, k: *u8) -> *u8 {
    let new: fn(*u8, *u8, *u8, *u8) -> *u8 = API.ht_new;
    let t: *u8 = new(API.str_hash, API.str_equal, 0 as *u8, 0 as *u8);
    if t == (0 as *u8) { return 0 as *u8; }
    let insert: fn(*u8, *u8, *u8) -> i32 = API.ht_insert;
    let _a: i32 = insert(t, _attr_schema(), _schema_name());
    let _b: i32 = insert(t, _attr_service(), sv);
    // A NULL key narrows the match to the whole service — what `clear` wants.
    if k != (0 as *u8) { let _c: i32 = insert(t, _attr_key(), k); }
    return t;
}

fn _drop_table(t: *u8) {
    let unref: fn(*u8) = API.ht_unref;
    unref(t);
    return;
}

// ---- bytes to C strings --------------------------------------------------------

fn _has_nul(p: *u8, n: usize) -> bool {
    var i: usize = 0 as usize;
    while i < n {
        if { *(p + i) } == (0 as u8) { return true; }
        i = i +% (1 as usize);
    }
    return false;
}

fn _cstr(dst: *u8, cap: usize, p: *u8, n: usize) -> bool {
    if n +% (1 as usize) > cap { return false; }
    if n > (0 as usize) { { memcpy(dst, p, n) }; }
    { *(dst + n) = 0 as u8 };
    return true;
}

// `cplus securestore: <service>/<key>` — what a person sees in Seahorse. The
// label is decoration: nothing matches on it, and the attributes are the
// identity.
fn _label(dst: *u8, cap: usize, sv: *u8, svn: usize, k: *u8, kn: usize) -> bool {
    let pre: str = "cplus securestore: ";
    let pn: usize = #str_len(pre);
    if pn +% svn +% kn +% (2 as usize) > cap { return false; }
    let slash: usize = pn +% svn;
    let after: usize = slash +% (1 as usize);
    { memcpy(dst, #str_ptr(pre), pn) };
    if svn > (0 as usize) { { memcpy(dst + pn, sv, svn) }; }
    { *(dst + slash) = 47 as u8 };                           // '/'
    if kn > (0 as usize) { { memcpy(dst + after, k, kn) }; }
    { *(dst + (after +% kn)) = 0 as u8 };
    return true;
}

// ---- the seam ------------------------------------------------------------------

export extern fn _c_set(key: *u8, key_len: usize, value: *u8, value_len: usize,
                        service: *u8, service_len: usize) -> i32 {
    if !_load() { return _unsupported(); }
    // See the header: `const gchar *` cannot carry an embedded NUL, and a
    // silently truncated secret is the failure this package spends a constant
    // to prevent.
    if _has_nul(value, value_len) { return _failed(); }

    var kbuf: [u8; 512] = #zero::[[u8; 512]]();
    var sbuf: [u8; 512] = #zero::[[u8; 512]]();
    var vbuf: [u8; 4097] = #zero::[[u8; 4097]]();
    var lbuf: [u8; 1064] = #zero::[[u8; 1064]]();
    let kp: *u8 = { #addr_of(kbuf) as *u8 };
    let sp: *u8 = { #addr_of(sbuf) as *u8 };
    let vp: *u8 = { #addr_of(vbuf) as *u8 };
    let lp: *u8 = { #addr_of(lbuf) as *u8 };
    if !_cstr(kp, _name_cap(), key, key_len) { return _failed(); }
    if !_cstr(sp, _name_cap(), service, service_len) { return _failed(); }
    if !_cstr(vp, _value_cap(), value, value_len) { return _failed(); }
    if !_label(lp, 1064 as usize, service, service_len, key, key_len) { return _failed(); }

    let t: *u8 = _table(sp, kp);
    if t == (0 as *u8) { return _failed(); }
    // UPDATE-OR-INSERT IS ONE CALL HERE, unlike Apple's two: the Secret Service
    // replaces an item whose attributes match, so `storev` is already the `set`
    // the facade describes. A NULL collection means the default one.
    let store: fn(*u8, *u8, *u8, *u8, *u8, *u8, *u8) -> i32 = API.storev;
    var err: *u8 = 0 as *u8;
    let r: i32 = store(0 as *u8, t, 0 as *u8, lp, vp, 0 as *u8, #addr_of(err) as *u8);
    _drop_table(t);
    if err != (0 as *u8) { return _map_error(err); }
    if r == (0 as i32) { return _failed(); }
    return _ok();
}

export extern fn _c_get(key: *u8, key_len: usize, service: *u8, service_len: usize,
                        out: *u8, cap: usize) -> i64 {
    if !_load() { return { _unsupported() as i64 }; }
    var kbuf: [u8; 512] = #zero::[[u8; 512]]();
    var sbuf: [u8; 512] = #zero::[[u8; 512]]();
    let kp: *u8 = { #addr_of(kbuf) as *u8 };
    let sp: *u8 = { #addr_of(sbuf) as *u8 };
    if !_cstr(kp, _name_cap(), key, key_len) { return { _failed() as i64 }; }
    if !_cstr(sp, _name_cap(), service, service_len) { return { _failed() as i64 }; }

    let t: *u8 = _table(sp, kp);
    if t == (0 as *u8) { return { _failed() as i64 }; }
    let lookup: fn(*u8, *u8, *u8, *u8) -> *u8 = API.lookupv;
    var err: *u8 = 0 as *u8;
    let p: *u8 = lookup(0 as *u8, t, 0 as *u8, #addr_of(err) as *u8);
    _drop_table(t);
    if p == (0 as *u8) {
        // NULL WITH NO ERROR IS ABSENCE, which is the ordinary first-run case
        // and the whole reason `NotFound` is its own outcome.
        if err != (0 as *u8) { return { _map_error(err) as i64 }; }
        return { _not_found() as i64 };
    }
    if err != (0 as *u8) { let f: fn(*u8) = API.error_free; f(err); }
    let free: fn(*u8) = API.password_free;
    let n: usize = { strlen(p) };
    // The facade's contract: a value that does not fit `cap` is `_C_FAILED`, not
    // a short count. `cap` is the contract, not a hint.
    if n > cap { free(p); return { _failed() as i64 }; }
    if n > (0 as usize) { { memcpy(out, p, n) }; }
    // `secret_password_free` wipes the page before releasing it — the reason to
    // use it rather than `g_free`.
    free(p);
    return n as i64;
}

export extern fn _c_remove(key: *u8, key_len: usize, service: *u8, service_len: usize) -> i32 {
    if !_load() { return _unsupported(); }
    var kbuf: [u8; 512] = #zero::[[u8; 512]]();
    var sbuf: [u8; 512] = #zero::[[u8; 512]]();
    let kp: *u8 = { #addr_of(kbuf) as *u8 };
    let sp: *u8 = { #addr_of(sbuf) as *u8 };
    if !_cstr(kp, _name_cap(), key, key_len) { return _failed(); }
    if !_cstr(sp, _name_cap(), service, service_len) { return _failed(); }

    let t: *u8 = _table(sp, kp);
    if t == (0 as *u8) { return _failed(); }
    let clear: fn(*u8, *u8, *u8, *u8) -> i32 = API.clearv;
    var err: *u8 = 0 as *u8;
    let r: i32 = clear(0 as *u8, t, 0 as *u8, #addr_of(err) as *u8);
    _drop_table(t);
    if err != (0 as *u8) { return _map_error(err); }
    // FALSE WITHOUT AN ERROR MEANS NOTHING MATCHED. The facade calls that
    // `NotFound` and says it is not an error: a caller clearing a token it may
    // never have written should not have to check first.
    if r == (0 as i32) { return _not_found(); }
    return _ok();
}

export extern fn _c_contains(key: *u8, key_len: usize, service: *u8, service_len: usize) -> i32 {
    if !_load() { return 0 as i32; }
    var kbuf: [u8; 512] = #zero::[[u8; 512]]();
    var sbuf: [u8; 512] = #zero::[[u8; 512]]();
    let kp: *u8 = { #addr_of(kbuf) as *u8 };
    let sp: *u8 = { #addr_of(sbuf) as *u8 };
    if !_cstr(kp, _name_cap(), key, key_len) { return 0 as i32; }
    if !_cstr(sp, _name_cap(), service, service_len) { return 0 as i32; }

    let t: *u8 = _table(sp, kp);
    if t == (0 as *u8) { return 0 as i32; }
    let lookup: fn(*u8, *u8, *u8, *u8) -> *u8 = API.lookupv;
    var err: *u8 = 0 as *u8;
    let p: *u8 = lookup(0 as *u8, t, 0 as *u8, #addr_of(err) as *u8);
    _drop_table(t);
    if err != (0 as *u8) { let f: fn(*u8) = API.error_free; f(err); }
    if p == (0 as *u8) { return 0 as i32; }
    // THE SECRET IS READ TO ANSWER THIS, and there is no cheaper call in the
    // password API. It is released immediately and wiped on release; the
    // facade's own note says a caller that needs more than a bool calls `get`.
    let free: fn(*u8) = API.password_free;
    free(p);
    return 1 as i32;
}

export extern fn _c_clear(service: *u8, service_len: usize) -> i32 {
    if !_load() { return _unsupported(); }
    var sbuf: [u8; 512] = #zero::[[u8; 512]]();
    let sp: *u8 = { #addr_of(sbuf) as *u8 };
    if !_cstr(sp, _name_cap(), service, service_len) { return _failed(); }

    // NO KEY ATTRIBUTE: a partial match is every item in the namespace, and the
    // schema attribute is still in the table — so this cannot reach another
    // application's items even if they use the same service name. Verified
    // against the live daemon.
    let t: *u8 = _table(sp, 0 as *u8);
    if t == (0 as *u8) { return _failed(); }
    let clear: fn(*u8, *u8, *u8, *u8) -> i32 = API.clearv;
    var err: *u8 = 0 as *u8;
    let _r: i32 = clear(0 as *u8, t, 0 as *u8, #addr_of(err) as *u8);
    _drop_table(t);
    if err != (0 as *u8) { return _map_error(err); }
    // `Ok` WHEN THERE WAS NOTHING TO REMOVE — an empty namespace is already in
    // the state this asks for, so the FALSE-without-error that `remove` reads
    // as `NotFound` is success here.
    return _ok();
}

// ---- tests ---------------------------------------------------------------------
//
// A REAL ROUND-TRIP, against the real daemon, under a self-test service that is
// cleared at both ends. This is the opposite of what the facade's note says
// about the macOS half, and the difference is the reason given there: the
// legacy keychain ties item access to code identity, so a rebuilt test binary
// reading what its predecessor wrote can raise a modal password dialog. The
// Secret Service does not — any process running as the user may ask — so a
// rebuilt binary reads its own items with no prompt at all.
//
// THE ONE PROMPT THAT COULD APPEAR is the unlock of a locked collection, so
// every test below is skipped when the default collection is locked. A suite
// that can interrupt you with a password prompt is a suite you stop running.

fn _testable() -> bool {
    if !_load() { return false; }
    let get: fn(i32, *u8, *u8) -> *u8 = API.service_get;
    var err: *u8 = 0 as *u8;
    let svc: *u8 = get(0 as i32, 0 as *u8, #addr_of(err) as *u8);
    if err != (0 as *u8) { let f: fn(*u8) = API.error_free; f(err); }
    if svc == (0 as *u8) { return false; }
    let unref: fn(*u8) = API.object_unref;
    let for_alias: fn(*u8, *u8, i32, *u8, *u8) -> *u8 = API.collection_for_alias;
    var err2: *u8 = 0 as *u8;
    let col: *u8 = for_alias(svc, #str_ptr("default\0"), 0 as i32, 0 as *u8,
                             #addr_of(err2) as *u8);
    if err2 != (0 as *u8) { let f: fn(*u8) = API.error_free; f(err2); }
    unref(svc);
    if col == (0 as *u8) { return false; }
    let locked: fn(*u8) -> i32 = API.collection_locked;
    let is_locked: i32 = locked(col);
    unref(col);
    return is_locked == (0 as i32);
}

fn _svc() -> str { return "cplus-linux-selftest"; }

fn _set(k: str, v: str) -> i32 {
    return { _c_set(#str_ptr(k), #str_len(k), #str_ptr(v), #str_len(v),
                    #str_ptr(_svc()), #str_len(_svc())) };
}
fn _has(k: str) -> i32 {
    return { _c_contains(#str_ptr(k), #str_len(k), #str_ptr(_svc()), #str_len(_svc())) };
}
fn _del(k: str) -> i32 {
    return { _c_remove(#str_ptr(k), #str_len(k), #str_ptr(_svc()), #str_len(_svc())) };
}
fn _wipe() -> i32 {
    return { _c_clear(#str_ptr(_svc()), #str_len(_svc())) };
}

#[test]
fn a_secret_round_trips_through_the_secret_service() {
    if !_testable() { return; }
    let k: str = "roundtrip-key";
    let _c0: i32 = _del(k);
    assert _set(k, "s3cr3t-value") == _ok();
    assert _has(k) == (1 as i32);

    var buf: [u8; 64] = [0u8; 64];
    let n: i64 = { _c_get(#str_ptr(k), #str_len(k), #str_ptr(_svc()), #str_len(_svc()),
                          #addr_of(buf) as *u8, 64 as usize) };
    assert n == (12 as i64);
    let got: str = { #str_from_raw_parts(#addr_of(buf) as *u8, n as usize) };
    assert got == "s3cr3t-value";

    assert _del(k) == _ok();
    assert _has(k) == (0 as i32);
}

#[test]
fn set_replaces_rather_than_adding_a_second_item() {
    if !_testable() { return; }
    let k: str = "replace-key";
    assert _set(k, "first") == _ok();
    assert _set(k, "second") == _ok();
    var buf: [u8; 32] = [0u8; 32];
    let n: i64 = { _c_get(#str_ptr(k), #str_len(k), #str_ptr(_svc()), #str_len(_svc()),
                          #addr_of(buf) as *u8, 32 as usize) };
    assert n == (6 as i64);
    assert { #str_from_raw_parts(#addr_of(buf) as *u8, n as usize) } == "second";
    // One item, not two: the first `remove` empties the key.
    assert _del(k) == _ok();
    assert _has(k) == (0 as i32);
}

#[test]
fn get_on_a_missing_key_is_not_found_and_writes_nothing() {
    if !_testable() { return; }
    let k: str = "definitely-absent-key";
    let _c0: i32 = _del(k);
    var buf: [u8; 16] = [0u8; 16];
    let n: i64 = { _c_get(#str_ptr(k), #str_len(k), #str_ptr(_svc()), #str_len(_svc()),
                          #addr_of(buf) as *u8, 16 as usize) };
    assert n == { _not_found() as i64 };
    assert { *(#addr_of(buf) as *u8) } == (0 as u8);
}

#[test]
fn remove_on_a_missing_key_is_not_found_not_a_failure() {
    if !_testable() { return; }
    let _c0: i32 = _del("never-written-key");
    assert _del("never-written-key") == _not_found();
}

#[test]
fn a_value_larger_than_cap_is_failed_not_a_short_count() {
    if !_testable() { return; }
    let k: str = "toobig-key";
    assert _set(k, "0123456789") == _ok();
    var small: [u8; 4] = [0u8; 4];
    let n: i64 = { _c_get(#str_ptr(k), #str_len(k), #str_ptr(_svc()), #str_len(_svc()),
                          #addr_of(small) as *u8, 4 as usize) };
    assert n == { _failed() as i64 };
    let _c1: i32 = _del(k);
}

#[test]
fn a_value_with_an_embedded_nul_is_refused_rather_than_truncated() {
    if !_testable() { return; }
    let k: str = "nul-key";
    let _c0: i32 = _del(k);
    var v: [u8; 5] = [0u8; 5];
    let p: *u8 = { #addr_of(v) as *u8 };
    { *(p + (0 as usize)) = 97 as u8 };
    { *(p + (1 as usize)) = 0 as u8 };
    { *(p + (2 as usize)) = 98 as u8 };
    let r: i32 = { _c_set(#str_ptr(k), #str_len(k), p, 3 as usize,
                          #str_ptr(_svc()), #str_len(_svc())) };
    assert r == _failed();
    // Refused at the write means nothing was stored — not a truncated "a".
    assert _has(k) == (0 as i32);
}

#[test]
fn clear_removes_every_key_under_the_service() {
    if !_testable() { return; }
    let _s1: i32 = _set("clr-a", "1");
    let _s2: i32 = _set("clr-b", "2");
    assert _has("clr-a") == (1 as i32);
    assert _has("clr-b") == (1 as i32);
    assert _wipe() == _ok();
    assert _has("clr-a") == (0 as i32);
    assert _has("clr-b") == (0 as i32);
    // Clearing an empty service is success, not failure.
    assert _wipe() == _ok();
}

#[test]
fn one_service_cannot_clear_another() {
    if !_testable() { return; }
    let other: str = "cplus-linux-selftest-other";
    assert _set("shared-name", "mine") == _ok();
    let r: i32 = { _c_set(#str_ptr("shared-name"), 11 as usize,
                          #str_ptr("theirs"), 6 as usize,
                          #str_ptr(other), #str_len(other)) };
    assert r == _ok();
    assert _wipe() == _ok();
    // The other namespace is untouched: the service is always part of the query.
    assert { _c_contains(#str_ptr("shared-name"), 11 as usize,
                         #str_ptr(other), #str_len(other)) } == (1 as i32);
    assert { _c_clear(#str_ptr(other), #str_len(other)) } == _ok();
    assert { _c_contains(#str_ptr("shared-name"), 11 as usize,
                         #str_ptr(other), #str_len(other)) } == (0 as i32);
}
