// facet_gtk — facet's GTK 4 backend, the Linux/BSD counterpart of
// facet_appkit.
//
// facet owns the description tree and ALL layout (the shared `flex_layout`
// engine). This package answers one question per verb the contract declares:
// implement it with what GTK offers, or state plainly in MANIFEST.md that GTK
// cannot. It holds nothing else — no second vocabulary, no portable-looking
// side door. An application may still drop beneath facet and call GTK
// directly; that is a visible choice made in the application, not something
// this package offers as a shortcut.
//
// This file is the whole registration surface: `install()`, and nothing else a
// backend could smuggle a hook through.
//
//   mount::install(Renderer)                 create / apply / insert / remove / schedule
//   services::install_scheduler(Scheduler)   run_on_main / after / observe_size
//   theme::set_is_dark_fn                    the system appearance read
//   theme::set_theme_changed_fn              repaint the running app's chrome
//   gestures::install_key_reader             input.cplus — the key band's readers
//   component::install_sender_readers        input.cplus — key / item / raise
//
// The sender readers are PARTIALLY filled, which is not the same as
// half-wired: `component::SenderReaders` declares a zero field as keeping
// facet's portable default, and the three drag-and-drop readers are left zero
// because there is no GtkDropTarget in this package yet. A zero reader answers
// "no backend told me"; a filled one answering empty would be a lie.
//
// STATUS. Read MANIFEST.md, which is a MEASUREMENT (`tools/parity.py`) rather
// than a claim. This backend is early: the shared band and a first set of kinds
// are live, every other kind gets a container that honours the band and holds
// its children, and the read half now covers the gesture band, the key band and
// the own actions of every kind that has a body. That is a floor, not a
// finished backend, and the tool prints the number so it cannot be overstated.

import "stdlib/option" as option;
import "facet/facet" as core;
import "facet/mount" as mount;
import "facet/services" as services;
import "facet/theme" as theme;
import "facet/application" as app;
import "gtk4/gtk4" as gtk;
import "./controls" as controls;
import "./recycler" as recycler;
import "./input" as input;
import "./views" as views;
import "./paint" as paint;
import "./scheduler" as scheduler;
import "./window" as window;

fn renderer() -> mount::Renderer {
    return mount::Renderer {
        ctx: 0 as *u8,
        create: views::create,
        view_release: views::view_release,
        apply: views::apply,
        insert: views::insert,
        remove: views::remove,
        schedule: scheduler::schedule,
    };
}

// Install the backend. Idempotent: a facade doing belt-and-braces registration
// must not arm the idle source twice.
static INSTALLED: bool = false;

fn install() {
    if INSTALLED { return; }
    INSTALLED = true;
    // GTK must be up before any widget is made, and `create` runs during
    // `mount::mount`. Idempotent in GTK itself, so a caller that already
    // called it loses nothing.
    gtk::init();
    // THE ICON FONT, BEFORE ANYTHING RENDERS. Pango caches its family list on
    // first use and adding a font to fontconfig does not invalidate it, so
    // registering late means a font that is present and unreachable —
    // `controls::register_bundled_font` explains the measurement. Free when the
    // font is already installed system-wide, and it says so once when it is
    // nowhere.
    let _font: bool = controls::register_bundled_font();
    mount::install(renderer());
    services::install_scheduler(scheduler::scheduler());
    input::install();
    theme::set_is_dark_fn(window::is_dark);
    theme::set_theme_changed_fn(theme_changed);
    window::sync_appearance();
    // AND LISTEN FOR THE NEXT ONE. Reading the appearance once at startup is
    // what this did; nothing was connected to hear a desktop-wide flip, so the
    // repaint hook registered above was never called by anything but the app
    // itself.
    window::watch_theme();
    return;
}

fn installed() -> bool { return INSTALLED; }

// Tests and teardown: back to facet's portable no-backend posture.
fn uninstall() {
    mount::uninstall();
    services::uninstall_scheduler();
    input::uninstall();
    theme::set_is_dark_fn(0 as fn() -> bool);
    theme::set_theme_changed_fn(0 as fn());
    INSTALLED = false;
    return;
}

// ---- theme changed -----------------------------------------------------------
// A palette swap or an appearance flip. Colours are resolved at APPLY time —
// `paint::css_rgba` picks the side of an adaptive pair from the live
// appearance — so chrome that used a theme role has to be re-applied.
//
// The tree IS the registry: marking the restyle bits routes the repaint
// through the ordinary sync, so there is one code path for "the colour
// changed" whatever changed it.
fn theme_changed() {
    window::sync_appearance();
    var i: usize = 0 as usize;
    let n: usize = app::window_count();
    while i < n {
        let r: *core::Node = app::window_root(i);
        if r != (0 as *core::Node) { repaint_walk(r); }
        i = i +% (1 as usize);
    }
    return;
}

fn repaint_walk(n: *core::Node) {
    // EVERY STATE BIT, not the two shared-band colours: a colour on a CONTROL
    // is a per-kind prop, so a label carrying an adaptive pair as its TEXT
    // colour would otherwise keep the side it was mounted with.
    //
    // `C_RESTYLE` is `~C_COMMANDS` with one bit withheld — every fact and no
    // verb — and NOT `all_bits()`, which is also the create sentinel. Passing
    // that here would make every appearance flip look like a create. The
    // AppKit backend shipped exactly that bug; it is written down there and
    // copied here on purpose.
    core::touch(n, paint::restyle_bits());
    // A LIST'S ROWS ARE NOT ITS CHILDREN. They are realised into pooled cells
    // and their roots live on the GtkListItem, so this walk cannot reach them
    // — and a flip repainted every window EXCEPT the inside of every list,
    // tree and collection. `recycler::restyle_rows` follows the cells.
    if recycler::holds_rows(n) { recycler::restyle_rows(n, paint::restyle_bits()); }
    var i: usize = 0 as usize;
    let count: usize = core::child_count_of(n);
    while i < count {
        match core::child_of(n, i) {
            option::Option[*core::Node]::Some(c) => { repaint_walk(c); }
            option::Option[*core::Node]::None => { }
        }
        i = i +% (1 as usize);
    }
    return;
}

// ---- hosting -----------------------------------------------------------------

// Mount a tree and put it on screen.
//
// ONE ENTRY, and the mount is inside it. `window::open_window` mounts because
// `mount::mount` is what opens the window on the app's record — the two have to
// happen together or `app::newest_window_root()` answers about a window that is
// not there yet. A caller that wants them apart mounts and then calls
// `mount::mount`'s own no-op second time, which is not a thing to want.
fn open_window(root: *core::Node, title: str, width: f64, height: f64) -> bool {
    if !INSTALLED { install(); }
    return window::open(root, title, width, height);
}
