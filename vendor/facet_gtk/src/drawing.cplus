// facet_gtk drawing — the canvas replay.
//
// facet's `canvas` carries a `Drawable`, and a Drawable RECORDS: it is handed a
// `vocab::Canvas` and appends commands to it. Nothing here is called back into
// facet; this module reads the recording and executes it against cairo, once,
// in order. That is the whole seam, and it is why the backend has one replay
// loop instead of forty registered callbacks.
//
// The AppKit backend's `drawing.cplus` is the same loop against Core Graphics
// and was read as the SHAPE, not ported: a GtkDrawingArea hands a cairo context
// to a draw function where AppKit hands a CGContext to `drawRect:`, and cairo
// keeps its path in the context where CG builds one separately.
//
// Two things make the replay short:
//
//   cairo is already TOP-LEFT with y growing downward, the same as flex — so
//   unlike the AppKit backend there is no flip arithmetic anywhere below;
//   the recording is already in the widget's own space, because the Drawable
//   was given the laid-out size and drew inside it.
//
// ---- cairo, hand-bound --------------------------------------------------------
//
// `vendor/cairo` binds the TYPES and none of the calls — cpc-bindgen had no GIR
// to read for a C library that ships none. These are the drawing calls one
// module makes, and they are declared here rather than grown into the cairo
// package because nothing else in facet draws.

import "stdlib/option" as option;
import "stdlib/text" as text;
import "stdlib/vec" as vec;
import "flex_layout/flex_layout" as flex;
import "facet/facet" as core;
import "facet/props" as props;
import "facet/vocabulary" as vocab;
import "facet/canvas" as canvas;
import "stdlib/status" as status;
import "gtk4/gtk4" as gtk;
import "gdk/gdk" as gdk;
import "gio/gio" as gio;
import "gdkpixbuf/gdkpixbuf" as pixbuf;
import "pango/pango" as pango;
import "pangocairo/pangocairo" as pangocairo;
import "cairo/cairo" as cairo;
import "gobject/runtime" as g;
import "./paint" as paint;

extern fn cairo_save(cr: *u8);
extern fn cairo_restore(cr: *u8);
extern fn cairo_translate(cr: *u8, tx: f64, ty: f64);
extern fn cairo_scale(cr: *u8, sx: f64, sy: f64);
extern fn cairo_rotate(cr: *u8, radians: f64);
// cairo_matrix_t is six doubles in the order xx yx xy yy x0 y0 — which is
// vocab::Transform's a b c d tx ty under different names and in the same
// order, so the copy is the whole conversion.
#[repr(C)]
struct Matrix { xx: f64, yx: f64, xy: f64, yy: f64, x0: f64, y0: f64 }
extern fn cairo_transform(cr: *u8, matrix: *Matrix);
extern fn cairo_identity_matrix(cr: *u8);

extern fn cairo_set_line_width(cr: *u8, width: f64);
extern fn cairo_set_miter_limit(cr: *u8, limit: f64);
extern fn cairo_set_line_cap(cr: *u8, cap: i32);
extern fn cairo_set_line_join(cr: *u8, join: i32);
extern fn cairo_set_dash(cr: *u8, dashes: *f64, num_dashes: i32, offset: f64);
extern fn cairo_set_source_rgba(cr: *u8, r: f64, gg: f64, b: f64, a: f64);
extern fn cairo_set_antialias(cr: *u8, antialias: i32);
extern fn cairo_set_operator(cr: *u8, op: i32);

extern fn cairo_new_path(cr: *u8);
extern fn cairo_close_path(cr: *u8);
extern fn cairo_move_to(cr: *u8, x: f64, y: f64);
extern fn cairo_line_to(cr: *u8, x: f64, y: f64);
extern fn cairo_curve_to(cr: *u8, x1: f64, y1: f64, x2: f64, y2: f64, x3: f64, y3: f64);
extern fn cairo_rectangle(cr: *u8, x: f64, y: f64, width: f64, height: f64);
extern fn cairo_arc(cr: *u8, xc: f64, yc: f64, radius: f64, angle1: f64, angle2: f64);
extern fn cairo_arc_negative(cr: *u8, xc: f64, yc: f64, radius: f64,
                             angle1: f64, angle2: f64);
extern fn cairo_stroke(cr: *u8);
extern fn cairo_fill(cr: *u8);
extern fn cairo_fill_preserve(cr: *u8);
extern fn cairo_clip(cr: *u8);
extern fn cairo_set_fill_rule(cr: *u8, rule: i32);

extern fn cairo_pattern_create_linear(x0: f64, y0: f64, x1: f64, y1: f64) -> *u8;
extern fn cairo_pattern_add_color_stop_rgba(pattern: *u8, offset: f64,
                                            r: f64, gg: f64, b: f64, a: f64);
extern fn cairo_set_source(cr: *u8, source: *u8);
#[link_name = "cairo_paint_with_alpha"]
extern fn cairo_paint_with_alpha(cr: *u8, alpha: f64);
// gdk's, not cairo's: it turns a GdkPixbuf into the context's source surface.
// One call, so it is hand-bound here rather than routed through `vendor/gdk`'s
// wrapper, which would want a `cairo::Context` this loop does not have.
#[link_name = "gdk_cairo_set_source_pixbuf"]
extern fn gdk_cairo_set_source_pixbuf(cr: *u8, pixbuf: *u8, x: f64, y: f64);
#[link_name = "cairo_get_source"]
extern fn cairo_get_source(cr: *u8) -> *u8;
#[link_name = "cairo_pattern_set_extend"]
extern fn cairo_pattern_set_extend(pattern: *u8, extend: i32);
extern fn cairo_pattern_destroy(pattern: *u8);

// NO TOY TEXT API. cairo's `show_text` takes one string at one point and knows
// nothing about wrapping, alignment or per-run styling — it also has two font
// weights where facet names ten. So all three text commands go through Pango,
// which is already a dependency of this package and is what GTK itself draws
// text with.

// ---- the widget ---------------------------------------------------------------

fn canvas_node_key() -> *u8 { return #str_ptr("facet-gtk-canvas-node\0"); }

fn create_canvas(n: *core::Node) -> *u8 {
    let area: gtk::DrawingArea = gtk::DrawingArea::new();
    g::set_data(area.raw(), canvas_node_key(), n as *u8);
    // The draw function is set ONCE. GTK calls it whenever the area needs
    // painting; a `redraw` is `queue_draw`, not a second registration.
    set_draw_func(area.raw(), canvas_draw, n as *u8, 0 as *u8);
    return area.upcast().raw();
}

// `gtk_drawing_area_set_draw_func` takes a GtkDrawingAreaDrawFunc, which the
// GIR presents as a callback cpc-bindgen skips — so it is bound here with the
// shape the callback actually has.
#[link_name = "gtk_drawing_area_set_draw_func"]
extern fn set_draw_func(area: *u8, draw_func: fn(*u8, *u8, i32, i32, *u8),
                        user_data: *u8, destroy: *u8);

fn apply_canvas(v: *u8, n: *core::Node, dirty: u64) {
    // `drawable` and `redraw` both mean the same thing to a drawing area: what
    // it paints has changed. GTK repaints on its own schedule, so the answer to
    // both is to ask for one.
    if (dirty & (canvas::P_DRAWABLE | canvas::P_REDRAW)) != (0 as u64) {
        gtk::Widget::from_raw(v).queue_draw();
    }
    return;
}

fn drawable_of(n: *core::Node) -> vocab::Drawable {
    let d: *core::Data = core::node_data(n);
    if d == (0 as *core::Data) { return vocab::Drawable::none(); }
    if { (*d).kind } != props::K_CANVAS { return vocab::Drawable::none(); }
    let p: *props::CanvasProps = { (*d).props } as *props::CanvasProps;
    if p == (0 as *props::CanvasProps) { return vocab::Drawable::none(); }
    return { (*p).drawable };
}

// GTK's draw function. The recording is made HERE, per paint, rather than kept:
// a Drawable is a function of the size it is given, so a canvas that is resized
// draws itself again rather than scaling what it drew before.
fn canvas_draw(area: *u8, cr: *u8, width: i32, height: i32, user: *u8) {
    let n: *core::Node = user as *core::Node;
    if n == (0 as *core::Node) { return; }
    let d: vocab::Drawable = drawable_of(n);
    if d.is_none() { return; }
    let size: vocab::Size = vocab::Size::of(width as f64, height as f64);
    let scale: f64 = { gtk::Widget::from_raw(area).get_scale_factor() } as f64;
    var canvas: vocab::Canvas = vocab::Canvas::of(size, scale);
    let f: fn(*vocab::Canvas, vocab::Rect, *u8) = d.draw;
    f(#addr_of(canvas), vocab::Rect::sized(size.width, size.height), d.ctx);
    replay(cr, #addr_of(canvas));
    return;
}

// ---- the replay ---------------------------------------------------------------
//
// cairo carries most of the state itself (line width, dash, cap, join, the
// matrix, the clip) and `cairo_save`/`cairo_restore` save all of it. What cairo
// has no state for is the STROKE and FILL colours as separate things — it has
// ONE source — and the font and the fill brush. Those four ride here and are
// pushed and popped alongside.

struct DrawState {
    stroke: vocab::Color,
    fill: vocab::Color,
    text_color: vocab::Color,
    font_family: i64,          // index into the canvas text table, -1 = system
    font_size: f64,
    font_weight: vocab::FontWeight,
    is_italic: bool,
    has_brush: bool,
    brush: vocab::Brush,
    // The box the gradient runs ACROSS, which `set_fill_brush` records with
    // the brush — a gradient is an axis over a rect and not over whatever
    // shape happens to be filled with it.
    brush_rect: vocab::Rect,
    opacity: f64,
    // The shadow is STATE, the same as a fill colour: `set_shadow` arms it and
    // every fill and stroke after it casts one until the state is popped or
    // re-armed. `has_shadow` is the arm bit — a radius of zero is a HARD
    // shadow, not an absent one.
    has_shadow: bool,
    shadow: vocab::Color,
    shadow_dx: f64,
    shadow_dy: f64,
    shadow_radius: f64,
    shadow_opacity: f64,
}

fn initial_state() -> DrawState {
    return DrawState {
        stroke: vocab::Color::text(),
        fill: vocab::Color::text(),
        text_color: vocab::Color::text(),
        font_family: (0 as i64) -% (1 as i64),
        font_size: 0.0f64,
        font_weight: vocab::FontWeight::Default,
        is_italic: false,
        has_brush: false,
        brush: vocab::Brush::none(),
        brush_rect: vocab::Rect::zero(),
        opacity: 1.0f64,
        has_shadow: false,
        shadow: vocab::Color::text(),
        shadow_dx: 0.0f64,
        shadow_dy: 0.0f64,
        shadow_radius: 0.0f64,
        shadow_opacity: 1.0f64,
    };
}

const MAX_DEPTH: usize = 32;

fn replay(cr: *u8, c: *vocab::Canvas) {
    var st: DrawState = initial_state();
    var stack: [DrawState; MAX_DEPTH] = [#zero::[DrawState](); MAX_DEPTH];
    var depth: usize = 0 as usize;
    var i: usize = 0 as usize;
    let count: usize = { (*c).count() };
    while i < count {
        let cmd: vocab::DrawCommand = { (*c).at(i) };
        step(cr, c, cmd, #addr_of(st), #addr_of(stack), #addr_of(depth));
        i = i +% (1 as usize);
    }
    // A recording that saved and never restored leaves cairo's own stack
    // unbalanced, and the context is GTK's — so it is unwound here rather than
    // handed back deeper than it arrived.
    while depth > (0 as usize) {
        { cairo_restore(cr) };
        depth = depth -% (1 as usize);
    }
    return;
}

fn step(cr: *u8, c: *vocab::Canvas, cmd: vocab::DrawCommand, st: *DrawState,
        stack: *[DrawState; MAX_DEPTH], depth: *usize) {
    match cmd.op {
        vocab::DrawOp::None => { }
        // ---- state ----
        vocab::DrawOp::SetStroke => { { (*st).stroke = cmd.color }; }
        vocab::DrawOp::SetFill => {
            { (*st).fill = cmd.color };
            { (*st).has_brush = false };
        }
        vocab::DrawOp::SetFillBrush => {
            if cmd.has_aux() {
                { (*st).brush = { (*c).brush(cmd.aux as usize) } };
                { (*st).brush_rect = cmd.bounds };
                { (*st).has_brush = true };
            }
        }
        vocab::DrawOp::SetTextColor => { { (*st).text_color = cmd.color }; }
        vocab::DrawOp::SetStrokeWidth => { { cairo_set_line_width(cr, cmd.stroke_width()) }; }
        vocab::DrawOp::SetMiterLimit => { { cairo_set_miter_limit(cr, cmd.miter_limit()) }; }
        vocab::DrawOp::SetStrokeCap => { { cairo_set_line_cap(cr, cairo_cap(cmd.cap)) }; }
        vocab::DrawOp::SetStrokeJoin => { { cairo_set_line_join(cr, cairo_join(cmd.join)) }; }
        vocab::DrawOp::SetStrokeDash => { set_dash(cr, c, cmd); }
        vocab::DrawOp::SetFont => {
            { (*st).font_size = cmd.font_size() };
            { (*st).font_weight = cmd.weight };
            { (*st).is_italic = cmd.is_italic };
            { (*st).font_family = cmd.aux };
        }
        // OPACITY IS NOT A CAIRO STATE. cairo has `paint_with_alpha` and no
        // global alpha, so the value is kept and folded into every colour on
        // its way to the source — which is the same result and the reason
        // `source_rgba` is the one door a colour goes through.
        vocab::DrawOp::SetOpacity => { { (*st).opacity = cmd.opacity() }; }
        vocab::DrawOp::SetAntialiased => {
            // CAIRO_ANTIALIAS_DEFAULT 0, NONE 1.
            { cairo_set_antialias(cr, if cmd.is_on { 0 as i32 } else { 1 as i32 }) };
        }
        vocab::DrawOp::SetBlend => { { cairo_set_operator(cr, cairo_operator(cmd.blend)) }; }
        vocab::DrawOp::SetShadow => {
            // A radius that is not positive still ARMS the shadow — that is a
            // hard offset copy, which is a legitimate shadow and the one a
            // recording asks for by passing zero. Clearing one is `restore`,
            // or re-arming with a transparent colour.
            let sh: vocab::Shadow = cmd.shadow();
            { (*st).has_shadow = true };
            { (*st).shadow = sh.color };
            { (*st).shadow_dx = sh.offset.x };
            { (*st).shadow_dy = sh.offset.y };
            { (*st).shadow_radius = sh.radius };
            { (*st).shadow_opacity = sh.opacity };
        }
        // ---- the stack and the transform ----
        vocab::DrawOp::Save => {
            if { (*depth) } < MAX_DEPTH {
                { (*stack)[{ (*depth) }] = { (*st) } };
                { (*depth) = { (*depth) } +% (1 as usize) };
                { cairo_save(cr) };
            }
        }
        vocab::DrawOp::Restore => {
            if { (*depth) } > (0 as usize) {
                { (*depth) = { (*depth) } -% (1 as usize) };
                { (*st) = { (*stack)[{ (*depth) }] } };
                { cairo_restore(cr) };
            }
        }
        vocab::DrawOp::Reset => {
            { cairo_identity_matrix(cr) };
            { (*st) = initial_state() };
        }
        vocab::DrawOp::Rotate => {
            // About a PIVOT, which cairo expresses as a move there and back.
            let p: vocab::Point = cmd.pivot();
            { cairo_translate(cr, p.x, p.y) };
            { cairo_rotate(cr, radians(cmd.degrees())) };
            { cairo_translate(cr, (0.0 as f64) - p.x, (0.0 as f64) - p.y) };
        }
        vocab::DrawOp::Scale => { { cairo_scale(cr, cmd.x(), cmd.y()) }; }
        vocab::DrawOp::Translate => { { cairo_translate(cr, cmd.x(), cmd.y()) }; }
        vocab::DrawOp::ConcatTransform => {
            let t: vocab::Transform = cmd.transform();
            var m: Matrix = Matrix { xx: t.a, yx: t.b, xy: t.c, yy: t.d, x0: t.tx, y0: t.ty };
            { cairo_transform(cr, #addr_of(m)) };
        }
        // ---- clipping ----
        vocab::DrawOp::ClipRect => {
            { cairo_new_path(cr) };
            rect_path(cr, cmd.bounds);
            { cairo_clip(cr) };
        }
        vocab::DrawOp::ClipPath => {
            if cmd.has_aux() {
                { cairo_new_path(cr) };
                build_path(cr, { (*c).path(cmd.aux as usize) });
                { cairo_set_fill_rule(cr, fill_rule(cmd.winding)) };
                { cairo_clip(cr) };
            }
        }
        // SUBTRACTING from a clip is an even-odd trick: the whole surface plus
        // the shape, filled even-odd, is everything OUTSIDE the shape. cairo
        // intersects clips, so that is the one way to take a bite out of one.
        vocab::DrawOp::SubtractFromClip => {
            { cairo_new_path(cr) };
            { cairo_rectangle(cr, -100000.0f64, -100000.0f64, 200000.0f64, 200000.0f64) };
            rect_path(cr, cmd.bounds);
            { cairo_set_fill_rule(cr, 1 as i32) };          // CAIRO_FILL_RULE_EVEN_ODD
            { cairo_clip(cr) };
        }
        // ---- shapes ----
        vocab::DrawOp::DrawLine => {
            let a: vocab::Point = cmd.from();
            let b: vocab::Point = cmd.to();
            { cairo_new_path(cr) };
            { cairo_move_to(cr, a.x, a.y) };
            { cairo_line_to(cr, b.x, b.y) };
            stroke_with(cr, st);
        }
        vocab::DrawOp::DrawRect => {
            { cairo_new_path(cr) };
            rect_path(cr, cmd.bounds);
            stroke_with(cr, st);
        }
        vocab::DrawOp::FillRect => {
            { cairo_new_path(cr) };
            rect_path(cr, cmd.bounds);
            fill_with(cr, st, cmd.bounds, false);
        }
        vocab::DrawOp::DrawRoundedRect => {
            { cairo_new_path(cr) };
            rounded_rect_path(cr, cmd.bounds, cmd.corner_radius());
            stroke_with(cr, st);
        }
        vocab::DrawOp::FillRoundedRect => {
            { cairo_new_path(cr) };
            rounded_rect_path(cr, cmd.bounds, cmd.corner_radius());
            fill_with(cr, st, cmd.bounds, false);
        }
        vocab::DrawOp::DrawEllipse => {
            { cairo_new_path(cr) };
            ellipse_path(cr, cmd.bounds);
            stroke_with(cr, st);
        }
        vocab::DrawOp::FillEllipse => {
            { cairo_new_path(cr) };
            ellipse_path(cr, cmd.bounds);
            fill_with(cr, st, cmd.bounds, false);
        }
        vocab::DrawOp::DrawArc => {
            { cairo_new_path(cr) };
            arc_path(cr, cmd.bounds, cmd.start_angle(), cmd.end_angle(),
                     cmd.is_clockwise, cmd.is_closed);
            stroke_with(cr, st);
        }
        vocab::DrawOp::FillArc => {
            { cairo_new_path(cr) };
            arc_path(cr, cmd.bounds, cmd.start_angle(), cmd.end_angle(),
                     cmd.is_clockwise, true);
            fill_with(cr, st, cmd.bounds, false);
        }
        vocab::DrawOp::DrawPath => {
            if cmd.has_aux() {
                { cairo_new_path(cr) };
                build_path(cr, { (*c).path(cmd.aux as usize) });
                stroke_with(cr, st);
            }
        }
        vocab::DrawOp::FillPath => {
            if cmd.has_aux() {
                { cairo_new_path(cr) };
                build_path(cr, { (*c).path(cmd.aux as usize) });
                fill_with(cr, st, cmd.bounds, is_even_odd(cmd.winding));
            }
        }
        // ---- content ----
        vocab::DrawOp::DrawText => { draw_text_at(cr, c, cmd, st); }
        vocab::DrawOp::DrawTextBlock => { draw_text_block(cr, c, cmd, st); }
        vocab::DrawOp::DrawSpans => { draw_spans(cr, c, cmd, st); }
        vocab::DrawOp::DrawImage => { draw_image(cr, c, cmd, st); }
    }
    return;
}

// ---- colour, and the one source ------------------------------------------------
//
// cairo has ONE source where Core Graphics has a stroke colour and a fill
// colour, so the source is set immediately before each stroke or fill rather
// than when the state command arrives. `opacity` folds in here, which is the
// only place it can: cairo has no global alpha.

fn use_color(cr: *u8, col: vocab::Color, opacity: f64) {
    let r: vocab::Color = paint::resolved(col);
    { cairo_set_source_rgba(cr, r.r, r.g, r.b, r.a * opacity) };
    return;
}

fn stroke_with(cr: *u8, st: *DrawState) {
    // UNDER the shape, and from the same path — `cast_shadow` copies it and
    // leaves it in place for the stroke below.
    cast_shadow(cr, st, true);
    use_color(cr, { (*st).stroke }, { (*st).opacity });
    { cairo_stroke(cr) };
    return;
}

fn fill_with(cr: *u8, st: *DrawState, box: vocab::Rect, even_odd: bool) {
    { cairo_set_fill_rule(cr, if even_odd { 1 as i32 } else { 0 as i32 }) };
    // UNDER the shape. The fill rule is set FIRST so the shadow of an even-odd
    // path has the same holes the shape does.
    cast_shadow(cr, st, false);
    if { (*st).has_brush } {
        let b: vocab::Brush = { (*st).brush };
        if b.is_gradient {
            // The recorded box when there is one — the axis belongs to the
            // BRUSH — and the shape's own only when the brush named none.
            var across: vocab::Rect = { (*st).brush_rect };
            if across.width <= (0.0 as f64) || across.height <= (0.0 as f64) { across = box; }
            let pat: *u8 = gradient_for(b, across, { (*st).opacity });
            if pat != (0 as *u8) {
                { cairo_set_source(cr, pat) };
                { cairo_fill(cr) };
                { cairo_pattern_destroy(pat) };
                return;
            }
        }
        use_color(cr, b.start, { (*st).opacity });
        { cairo_fill(cr) };
        return;
    }
    use_color(cr, { (*st).fill }, { (*st).opacity });
    { cairo_fill(cr) };
    return;
}

// A linear gradient across the box at the brush's angle. Zero degrees runs
// left to right, which is the convention the ledger's own brushes use.
fn gradient_for(b: vocab::Brush, box: vocab::Rect, opacity: f64) -> *u8 {
    let cx: f64 = box.x + (box.width / (2.0 as f64));
    let cy: f64 = box.y + (box.height / (2.0 as f64));
    let rad: f64 = radians(b.angle);
    let half: f64 = ((box.width + box.height) / (4.0 as f64));
    let dx: f64 = paint::cos_approx(rad) * half;
    let dy: f64 = paint::sin_approx(rad) * half;
    let pat: *u8 = { cairo_pattern_create_linear(cx - dx, cy - dy, cx + dx, cy + dy) };
    if pat == (0 as *u8) { return 0 as *u8; }
    let s: vocab::Color = paint::resolved(b.start);
    let e: vocab::Color = paint::resolved(b.end);
    { cairo_pattern_add_color_stop_rgba(pat, 0.0f64, s.r, s.g, s.b, s.a * opacity) };
    { cairo_pattern_add_color_stop_rgba(pat, 1.0f64, e.r, e.g, e.b, e.a * opacity) };
    return pat;
}

// ---- paths ---------------------------------------------------------------------

fn rect_path(cr: *u8, r: vocab::Rect) {
    { cairo_rectangle(cr, r.x, r.y, r.width, r.height) };
    return;
}

// A rounded rectangle is four arcs and four lines, and cairo's `arc` continues
// the current path — so the corners join without a `move_to` between them.
fn rounded_rect_path(cr: *u8, r: vocab::Rect, radius: f64) {
    var rad: f64 = radius;
    let max: f64 = if r.width < r.height { r.width / (2.0 as f64) }
                   else { r.height / (2.0 as f64) };
    if rad > max { rad = max; }
    if rad <= (0.0 as f64) { rect_path(cr, r); return; }
    let x: f64 = r.x;
    let y: f64 = r.y;
    let w: f64 = r.width;
    let h: f64 = r.height;
    let pi: f64 = 3.14159265358979323846f64;
    { cairo_move_to(cr, x + rad, y) };
    { cairo_line_to(cr, x + w - rad, y) };
    { cairo_arc(cr, x + w - rad, y + rad, rad, (0.0 as f64) - (pi / (2.0 as f64)), 0.0f64) };
    { cairo_line_to(cr, x + w, y + h - rad) };
    { cairo_arc(cr, x + w - rad, y + h - rad, rad, 0.0f64, pi / (2.0 as f64)) };
    { cairo_line_to(cr, x + rad, y + h) };
    { cairo_arc(cr, x + rad, y + h - rad, rad, pi / (2.0 as f64), pi) };
    { cairo_line_to(cr, x, y + rad) };
    { cairo_arc(cr, x + rad, y + rad, rad, pi, (3.0 as f64) * pi / (2.0 as f64)) };
    { cairo_close_path(cr) };
    return;
}

// An ellipse is a CIRCLE IN A SCALED SPACE. cairo has no ellipse call, and
// scaling around the box's centre is the standard way to get one — the save
// and restore keep the scale off everything after it.
fn ellipse_path(cr: *u8, r: vocab::Rect) {
    if r.width <= (0.0 as f64) || r.height <= (0.0 as f64) { return; }
    let pi: f64 = 3.14159265358979323846f64;
    { cairo_save(cr) };
    { cairo_translate(cr, r.x + (r.width / (2.0 as f64)),
                          r.y + (r.height / (2.0 as f64))) };
    { cairo_scale(cr, r.width / (2.0 as f64), r.height / (2.0 as f64)) };
    { cairo_arc(cr, 0.0f64, 0.0f64, 1.0f64, 0.0f64, (2.0 as f64) * pi) };
    { cairo_restore(cr) };
    return;
}

// THE ONE CONVENTION THAT HAS TO BE CHOSEN rather than inherited.
//
// facet's angles are DEGREES measured from the x axis, and its `is_clockwise`
// is about the direction on SCREEN. cairo's y grows downward, so its own
// `cairo_arc` sweeps clockwise on screen and `cairo_arc_negative`
// anticlockwise — the opposite of the names' mathematical reading. Taking the
// names at face value here is how an arc comes out mirrored.
fn arc_path(cr: *u8, box: vocab::Rect, from: f64, to: f64,
            clockwise: bool, closed: bool) {
    if box.width <= (0.0 as f64) || box.height <= (0.0 as f64) { return; }
    let cx: f64 = box.x + (box.width / (2.0 as f64));
    let cy: f64 = box.y + (box.height / (2.0 as f64));
    let a: f64 = radians(from);
    let b: f64 = radians(to);
    { cairo_save(cr) };
    { cairo_translate(cr, cx, cy) };
    { cairo_scale(cr, box.width / (2.0 as f64), box.height / (2.0 as f64)) };
    if closed { { cairo_move_to(cr, 0.0f64, 0.0f64) }; }
    if clockwise { { cairo_arc(cr, 0.0f64, 0.0f64, 1.0f64, a, b) }; }
    else { { cairo_arc_negative(cr, 0.0f64, 0.0f64, 1.0f64, a, b) }; }
    if closed { { cairo_close_path(cr) }; }
    { cairo_restore(cr) };
    return;
}

// A recorded path, segment by segment. cairo builds the path IN the context,
// so this appends rather than answering an object — which is the one shape
// difference from the Core Graphics version of the same walk.
fn build_path(cr: *u8, p: *vocab::Path) {
    if p == (0 as *vocab::Path) { return; }
    var last: vocab::Point = vocab::Point::zero();
    var i: usize = 0 as usize;
    let count: usize = { (*p).count() };
    while i < count {
        let s: vocab::PathSegment = { (*p).at(i) };
        match s.op {
            vocab::PathOp::None => { }
            vocab::PathOp::Move => {
                { cairo_move_to(cr, s.point.x, s.point.y) };
                last = s.point;
            }
            vocab::PathOp::Line => {
                { cairo_line_to(cr, s.point.x, s.point.y) };
                last = s.point;
            }
            // A QUADRATIC raised to a cubic: cairo has only `curve_to`, and the
            // two control points are the quad's own, each two thirds of the way
            // from its end. Exact, not an approximation.
            vocab::PathOp::Quad => {
                let c1: vocab::Point = s.control1;
                let e: vocab::Point = s.point;
                let t: f64 = 2.0f64 / 3.0f64;
                { cairo_curve_to(cr,
                    last.x + ((c1.x - last.x) * t), last.y + ((c1.y - last.y) * t),
                    e.x + ((c1.x - e.x) * t), e.y + ((c1.y - e.y) * t),
                    e.x, e.y) };
                last = e;
            }
            vocab::PathOp::Curve => {
                { cairo_curve_to(cr, s.control1.x, s.control1.y,
                                     s.control2.x, s.control2.y,
                                     s.point.x, s.point.y) };
                last = s.point;
            }
            vocab::PathOp::Arc => {
                arc_path(cr, s.bounds, s.start_angle(), s.end_angle(),
                         s.is_clockwise, false);
            }
            vocab::PathOp::Rect => { rect_path(cr, s.bounds); }
            vocab::PathOp::RoundedRect => {
                rounded_rect_path(cr, s.bounds, s.corner_radius());
            }
            vocab::PathOp::Ellipse => { ellipse_path(cr, s.bounds); }
            vocab::PathOp::Close => { { cairo_close_path(cr) }; }
        }
        i = i +% (1 as usize);
    }
    return;
}

// ---- text ----------------------------------------------------------------------
//
// ALL THREE TEXT COMMANDS GO THROUGH ONE LAYOUT. `draw_text` is a layout with
// no width, `draw_text_block` one with a width and an alignment, `draw_spans`
// one filled from markup — so wrapping, ellipsizing and per-run styling are the
// same machinery rather than three text paths that disagree about a font.

// Pango measures in 1024ths of a point — `paint::pango_scale`, which the
// markup builder uses too.
fn pango_scale() -> f64 { return paint::pango_scale(); }

fn pango_weight(w: vocab::FontWeight) -> i32 { return paint::pango_weight(w); }

// PangoAlignment: 0 LEFT, 1 CENTER, 2 RIGHT. Pango has no JUSTIFY alignment —
// justification is a separate flag — so `Justify` sets the flag and leaves the
// alignment at the start, which is what justified text is.
fn pango_align(a: vocab::TextAlign) -> i32 {
    return match a {
        vocab::TextAlign::Start => 0,
        vocab::TextAlign::Center => 1,
        vocab::TextAlign::End => 2,
        vocab::TextAlign::Justify => 0,
    };
}

fn is_justified(a: vocab::TextAlign) -> bool {
    return match a { vocab::TextAlign::Justify => true, _other => false };
}

// A layout carrying the recorded font. The context is cairo's own, so the
// layout is measured against the surface it will be drawn on — which is what
// makes a hairline at 2x actually hairline.
fn layout_for(cr: *u8, c: *vocab::Canvas, st: *DrawState) -> pango::Layout {
    let layout: pango::Layout = pangocairo::create_layout(cairo::Context::from_raw(cr));
    let desc: pango::FontDescription = pango::FontDescription::new();
    var family: str = "";
    let at: i64 = { (*st).font_family };
    if at >= (0 as i64) { family = { (*c).text(at as usize) }; }
    if family != "" { desc.set_family(family); }
    let size: f64 = { (*st).font_size };
    if size > (0.0 as f64) { desc.set_size((size * pango_scale()) as i32); }
    desc.set_weight(pango_weight({ (*st).font_weight }));
    // PangoStyle: 0 NORMAL, 1 OBLIQUE, 2 ITALIC.
    desc.set_style(if { (*st).is_italic } { 2 as i32 } else { 0 as i32 });
    layout.set_font_description(desc);
    desc.free();
    return layout;
}

// ONE STRING AT A POINT, and the point is its BASELINE — which is what the
// AppKit backend's `drawAtPoint:` takes and what an application that placed
// text by hand expects. Pango draws a layout from its TOP-LEFT, so the
// baseline is subtracted on the way in; without that every recorded string
// sits one line lower than it was asked for.
fn draw_text_at(cr: *u8, c: *vocab::Canvas, cmd: vocab::DrawCommand, st: *DrawState) {
    if !cmd.has_aux() { return; }
    let s: str = { (*c).text(cmd.aux as usize) };
    if s == "" { return; }
    let layout: pango::Layout = layout_for(cr, c, st);
    layout.set_text(s, (0 as i32) -% (1 as i32));
    layout.set_alignment(pango_align(cmd.align));
    use_color(cr, { (*st).text_color }, { (*st).opacity });
    let at: vocab::Point = cmd.at();
    let baseline: f64 = (layout.get_baseline() as f64) / pango_scale();
    { cairo_move_to(cr, at.x, at.y - baseline) };
    pangocairo::show_layout(cairo::Context::from_raw(cr), layout);
    g::object_unref(layout.raw());
    return;
}

// WRAPPED, ALIGNED TEXT IN A BOX. The width is the box's, which is what makes
// it wrap at all; the height is only used to place the block vertically,
// because Pango's own height is a limit on ellipsization and not on drawing.
fn draw_text_block(cr: *u8, c: *vocab::Canvas, cmd: vocab::DrawCommand, st: *DrawState) {
    if !cmd.has_aux() { return; }
    let s: str = { (*c).text(cmd.aux as usize) };
    if s == "" { return; }
    let box: vocab::Rect = cmd.bounds;
    if box.width <= (0.0 as f64) { return; }
    let layout: pango::Layout = layout_for(cr, c, st);
    layout.set_text(s, (0 as i32) -% (1 as i32));
    layout.set_width((box.width * pango_scale()) as i32);
    layout.set_alignment(pango_align(cmd.align));
    layout.set_justify(is_justified(cmd.align));
    // `line_spacing` is a FACTOR on Pango and a factor in the recording too, so
    // zero means "the font's own" on both sides and there is nothing to
    // convert.
    let spacing: f64 = cmd.line_spacing();
    if spacing > (0.0 as f64) { layout.set_line_spacing(spacing as f32); }
    // `TextFlow::Clip` is text that must not leave its box, which Pango says
    // with an ellipsis at the end; `Overflow` lets it run on.
    match cmd.flow {
        vocab::TextFlow::Clip => {
            layout.set_height((box.height * pango_scale()) as i32);
            layout.set_ellipsize(3 as i32);          // PANGO_ELLIPSIZE_END
        }
        vocab::TextFlow::Overflow => { layout.set_ellipsize(0 as i32); }
    }
    var w: i32 = 0 as i32;
    var h: i32 = 0 as i32;
    layout.get_pixel_size(w, h);
    // VERTICAL alignment is not Pango's — it lays a block out from the top and
    // says how tall it came out. Placing that block in the box is this
    // module's arithmetic.
    var y: f64 = box.y;
    match cmd.vertical_align {
        vocab::VerticalAlign::Top => { }
        vocab::VerticalAlign::Center => { y = box.y + ((box.height - (h as f64)) / (2.0 as f64)); }
        vocab::VerticalAlign::Bottom => { y = box.y + (box.height - (h as f64)); }
    }
    use_color(cr, { (*st).text_color }, { (*st).opacity });
    { cairo_move_to(cr, box.x, y) };
    pangocairo::show_layout(cairo::Context::from_raw(cr), layout);
    g::object_unref(layout.raw());
    return;
}

// PER-RUN STYLING, as Pango markup. A `Spans` is a list of runs each with its
// own font, colour and decoration, and markup is the one way to hand Pango all
// of that in a single layout — the alternative is a PangoAttrList built run by
// run, which says the same thing in ten times the code.
fn draw_spans(cr: *u8, c: *vocab::Canvas, cmd: vocab::DrawCommand, st: *DrawState) {
    if !cmd.has_aux() { return; }
    let runs: *vocab::Spans = { (*c).spans(cmd.aux as usize) };
    if runs == (0 as *vocab::Spans) { return; }
    if { (*runs).is_empty() } { return; }
    let markup: text::Text = spans_markup(runs);
    if markup.view() == "" { return; }
    let box: vocab::Rect = cmd.bounds;
    let layout: pango::Layout = layout_for(cr, c, st);
    layout.set_markup(markup.view(), (0 as i32) -% (1 as i32));
    if box.width > (0.0 as f64) {
        layout.set_width((box.width * pango_scale()) as i32);
        layout.set_alignment(pango_align(cmd.align));
    }
    use_color(cr, { (*st).text_color }, { (*st).opacity });
    { cairo_move_to(cr, box.x, box.y) };
    pangocairo::show_layout(cairo::Context::from_raw(cr), layout);
    g::object_unref(layout.raw());
    return;
}

// One `<span>` per run, built from the shared markup builder in `paint` — the
// same one a label with span children uses, so a run styled in a drawing and a
// run styled in a label cannot disagree about what a weight means.
fn spans_markup(runs: *vocab::Spans) -> text::Text {
    var out: text::Text = text::from_str("");
    var i: usize = 0 as usize;
    let count: usize = { (*runs).count() };
    while i < count {
        let r: *vocab::TextSpan = { (*runs).at(i) };
        if r != (0 as *vocab::TextSpan) {
            let attrs: text::Text = paint::span_attrs(
                { (*r).font_family.view() }, { (*r).font_size }, { (*r).font_weight },
                { (*r).is_italic }, true, { (*r).color }, { (*r).background_color },
                { (*r).decoration }, 0.0f64, 0.0f64);
            out = out.appending(paint::markup_run(attrs.view(), { (*r).view() }).view());
        }
        i = i +% (1 as usize);
    }
    return out;
}

// ---- the small conversions -----------------------------------------------------

// CAIRO_LINE_CAP_BUTT 0, ROUND 1, SQUARE 2.
fn cairo_cap(c: vocab::LineCap) -> i32 {
    return match c {
        vocab::LineCap::Flat => 0,
        vocab::LineCap::Round => 1,
        vocab::LineCap::Square => 2,
    };
}

// CAIRO_LINE_JOIN_MITER 0, ROUND 1, BEVEL 2.
fn cairo_join(j: vocab::LineJoin) -> i32 {
    return match j {
        vocab::LineJoin::Miter => 0,
        vocab::LineJoin::Round => 1,
        vocab::LineJoin::Bevel => 2,
    };
}

// cairo_operator_t. `Normal` is OVER (2); the rest are the Porter-Duff and
// blend modes cairo carries under the same names the ledger uses.
fn cairo_operator(b: vocab::Blend) -> i32 {
    return match b {
        vocab::Blend::Normal => 2,
        vocab::Blend::Multiply => 14,
        vocab::Blend::Screen => 15,
        vocab::Blend::Overlay => 16,
        vocab::Blend::Darken => 17,
        vocab::Blend::Lighten => 18,
        vocab::Blend::ColorDodge => 19,
        vocab::Blend::ColorBurn => 20,
        vocab::Blend::HardLight => 21,
        vocab::Blend::SoftLight => 22,
        vocab::Blend::Difference => 23,
        vocab::Blend::Exclusion => 24,
        vocab::Blend::Hue => 25,
        vocab::Blend::Saturation => 26,
        vocab::Blend::Color => 27,
        vocab::Blend::Luminosity => 28,
        vocab::Blend::Clear => 0,
        vocab::Blend::Copy => 1,
        vocab::Blend::SourceIn => 3,
        vocab::Blend::SourceOut => 4,
        vocab::Blend::SourceAtop => 5,
        vocab::Blend::DestinationOver => 6,
        vocab::Blend::DestinationIn => 7,
        vocab::Blend::DestinationOut => 8,
        vocab::Blend::DestinationAtop => 9,
        vocab::Blend::Xor => 10,
        vocab::Blend::PlusDarker => 11,
        vocab::Blend::PlusLighter => 12,
    };
}

fn fill_rule(w: vocab::Winding) -> i32 {
    return match w {
        vocab::Winding::NonZero => 0,
        vocab::Winding::EvenOdd => 1,
    };
}

fn is_even_odd(w: vocab::Winding) -> bool {
    return match w { vocab::Winding::EvenOdd => true, vocab::Winding::NonZero => false };
}

fn set_dash(cr: *u8, c: *vocab::Canvas, cmd: vocab::DrawCommand) {
    if !cmd.has_aux() { { cairo_set_dash(cr, 0 as *f64, 0 as i32, 0.0f64) }; return; }
    let d: vocab::Dashes = { (*c).dashes(cmd.aux as usize) };
    let n: usize = d.count;
    if n == (0 as usize) { { cairo_set_dash(cr, 0 as *f64, 0 as i32, 0.0f64) }; return; }
    // Copied into a local array because cairo reads the runs from contiguous
    // memory and a `Dashes` keeps its own.
    var runs: [f64; 8] = [0.0f64; 8];
    var i: usize = 0 as usize;
    while i < n && i < (8 as usize) {
        runs[i] = d.run(i);
        i = i +% (1 as usize);
    }
    { cairo_set_dash(cr, #addr_of(runs) as *f64, i as i32, cmd.dash_offset()) };
    return;
}

fn radians(degrees: f64) -> f64 {
    return degrees * (3.14159265358979323846f64 / 180.0f64);
}



// ---- the canvas image ----------------------------------------------------------
//
// `Drawable.draw_image(source, box)` names an image the way facet names one
// everywhere else: a source STRING the backend resolves, so `canvas` and the
// `image` control agree on what an image is. `controls::set_image_source` reads
// it as a path when it has a separator or an extension and as a theme icon
// name otherwise, and this reads it the same way — an app that puts
// `"folder-symbolic"` in an `image` and in a canvas gets the same picture.
//
// THE BOX IS THE DESTINATION AND THE IMAGE IS STRETCHED INTO IT. facet's call
// carries a rect and no content mode, so "fit" and "fill" are not choices the
// recording offers; stretching is the literal reading of the one argument
// there is. An application that wants aspect preserved passes a box with the
// aspect it wants, which it can compute and this cannot.

struct ImageEntry { key: text::Text, opaque pixbuf: *u8 }

// Bounded by the number of DISTINCT sources a canvas names, which is small and
// does not grow with frames — the whole point of the cache is that a replay
// running at 60Hz decodes nothing. Entries live for the process, like the
// pixbufs they hold; a canvas that named a thousand images would want eviction
// and nothing does.
static IMAGE_CACHE: vec::Vec[ImageEntry] = #zero::[vec::Vec[ImageEntry]]();

// A FAILED LOAD IS CACHED TOO, as a null pixbuf. Otherwise a canvas naming a
// file that is not there would re-open it sixty times a second, and the miss
// is the expensive case.
fn cached_pixbuf(source: str) -> *u8 {
    var i: usize = 0 as usize;
    let n: usize = IMAGE_CACHE.count();
    while i < n {
        match IMAGE_CACHE.at_ptr(i) {
            option::Option[*ImageEntry]::Some(e) => {
                if { (*e).key }.view() == source { return { (*e).pixbuf }; }
            }
            option::Option[*ImageEntry]::None => { }
        }
        i = i +% (1 as usize);
    }
    let pb: *u8 = load_pixbuf(source);
    let _s: status::Status = IMAGE_CACHE.append(
        ImageEntry { key: text::from_str(source), pixbuf: pb });
    return pb;
}

// For the suite: the cache is the thing with a property worth pinning (a miss
// is remembered), and it is a static nothing else can see.
fn image_cache_count() -> usize { return IMAGE_CACHE.count(); }

fn load_pixbuf(source: str) -> *u8 {
    if source == "" { return 0 as *u8; }
    if paint::looks_like_path(source) { return from_file(source); }
    return icon_pixbuf(source);
}

// A THEME ICON IS A FILE, and the way to its path is the icon theme's own
// lookup: GtkIconPaintable is a GdkPaintable, and painting one needs a
// GtkSnapshot rather than the cairo context this loop holds. The paintable
// knows the file it came from, so the icon goes through the same decoder as
// every other image.
//
// An icon that is NOT file-backed answers a null file — a builder-drawn or
// resource-only icon — and draws nothing. MANIFEST.md §3 records it; the
// alternative is a second rendering path for a case no theme on a desktop
// actually produces.
#[link_name = "gdk_display_get_default"]
extern fn gdk_display_get_default() -> *u8;
#[link_name = "gtk_icon_theme_get_for_display"]
extern fn gtk_icon_theme_get_for_display(display: *u8) -> *u8;
// Seven arguments and an array of fallbacks — the generator skipped it for the
// array, which is passed NULL here because facet's source is one name.
#[link_name = "gtk_icon_theme_lookup_icon"]
extern fn gtk_icon_theme_lookup_icon(theme: *u8, name: *u8, fallbacks: *u8,
                                     size: i32, scale: i32, direction: i32,
                                     flags: i32) -> *u8;

// The size asked for is a HINT, not a ceiling: the pixbuf is scaled into the
// destination box anyway, and a symbolic SVG re-renders at whatever size. Large
// enough that a canvas drawing an icon big does not get a blurry one.
const ICON_LOOKUP_SIZE: i32 = 128;

fn icon_pixbuf(name: str) -> *u8 {
    // `gdk_display_get_default` is a static and the generator binds no statics —
    // it binds METHODS, and the default display belongs to no instance. One
    // extern, the same as every other symbol in this file.
    let display: *u8 = { gdk_display_get_default() };
    if display == (0 as *u8) { return 0 as *u8; }
    let theme: *u8 = { gtk_icon_theme_get_for_display(display) };
    if theme == (0 as *u8) { return 0 as *u8; }
    var icon: *u8 = 0 as *u8;
    match text::from_str(name).c_str() {
        option::Option[text::CString]::Some(cs) => {
            icon = { gtk_icon_theme_lookup_icon(theme, cs.as_ptr(), 0 as *u8,
                                                ICON_LOOKUP_SIZE, 1 as i32,
                                                0 as i32, 0 as i32) };
        }
        option::Option[text::CString]::None => { }
    }
    if icon == (0 as *u8) { return 0 as *u8; }
    // `lookup_icon` is transfer-full and always answers SOMETHING — the
    // theme's own missing-image icon when the name is unknown. So a bad name
    // draws the broken-image glyph rather than nothing, which is GTK's answer
    // and is more use than a blank box.
    let paintable: gtk::IconPaintable = gtk::IconPaintable::from_raw(icon);
    var out: *u8 = 0 as *u8;
    match paintable.get_file() {
        option::Option[gio::File]::Some(f) => {
            match f.get_path() {
                option::Option[text::Text]::Some(pt) => { out = from_file(pt.view()); }
                option::Option[text::Text]::None => { }
            }
        }
        option::Option[gio::File]::None => { }
    }
    { g::object_unref(icon) };
    return out;
}

fn from_file(path: str) -> *u8 {
    return match pixbuf::Pixbuf::new_from_file(path) {
        option::Option[pixbuf::Pixbuf]::Some(pb) => pb.raw(),
        option::Option[pixbuf::Pixbuf]::None => 0 as *u8,
    };
}

#[link_name = "gdk_pixbuf_get_width"]
extern fn gdk_pixbuf_get_width(pb: *u8) -> i32;
#[link_name = "gdk_pixbuf_get_height"]
extern fn gdk_pixbuf_get_height(pb: *u8) -> i32;

fn draw_image(cr: *u8, c: *vocab::Canvas, cmd: vocab::DrawCommand, st: *DrawState) {
    if !cmd.has_aux() { return; }
    let pb: *u8 = cached_pixbuf({ (*c).text(cmd.aux as usize) });
    paint_pixbuf(cr, pb, cmd.bounds, { (*st).opacity });
    return;
}

// The PAINT, split from the resolve so the suite can drive it: a pixbuf made
// in memory and a cairo image surface need no display and no file, and this is
// the half with geometry in it. Resolving a source is a table lookup and is
// pinned separately.
fn paint_pixbuf(cr: *u8, pb: *u8, b: vocab::Rect, opacity: f64) {
    if pb == (0 as *u8) { return; }
    let iw: f64 = { gdk_pixbuf_get_width(pb) } as f64;
    let ih: f64 = { gdk_pixbuf_get_height(pb) } as f64;
    if iw <= (0.0 as f64) { return; }
    if ih <= (0.0 as f64) { return; }
    if b.width <= (0.0 as f64) { return; }
    if b.height <= (0.0 as f64) { return; }
    { cairo_save(cr) };
    // CLIP FIRST, because a scaled source surface is unbounded: cairo would
    // paint the whole plane and the box is what the recording asked for.
    { cairo_rectangle(cr, b.x, b.y, b.width, b.height) };
    { cairo_clip(cr) };
    { cairo_translate(cr, b.x, b.y) };
    { cairo_scale(cr, b.width / iw, b.height / ih) };
    { gdk_cairo_set_source_pixbuf(cr, pb, 0.0 as f64, 0.0 as f64) };
    // EXTEND_PAD (3), not cairo's default of NONE. A stretched image is
    // sampled bilinearly, and at the very edge half the filter kernel falls
    // OUTSIDE the source — where NONE reads transparent, so a scaled image
    // comes out with a translucent fringe all the way round. Measured: an
    // opaque 2x2 red pixbuf drawn into an 8x8 box had semi-transparent edge
    // pixels. PAD repeats the border sample instead, which is what every
    // toolkit that stretches an image does.
    { cairo_pattern_set_extend({ cairo_get_source(cr) }, 3 as i32) };
    // `opacity` folds in HERE, the same as it folds into every colour — see
    // `source_rgba`. cairo has no global alpha and this is the one paint that
    // would otherwise ignore it.
    { cairo_paint_with_alpha(cr, opacity) };
    { cairo_restore(cr) };
    return;
}

// ---- the shadow, and the blur cairo does not have ------------------------------
//
// Core Graphics has `CGContextSetShadow` and casts one for every subsequent
// draw; cairo has NO SHADOW AND NO BLUR. So the shape is drawn a second time
// into an image surface of its own, that surface is blurred, and the result is
// composited under the shape at the recorded offset. That is what a shadow IS,
// and doing it here rather than declining keeps `set_shadow` from being a
// command that silently does nothing.
//
// THE PATH IS COPIED, NOT REBUILT. Every caster already has its path in the
// context, so `cairo_copy_path` takes it — one implementation serves rects,
// rounded rects, ellipses, arcs, lines and an arbitrary `Path` alike, and none
// of them needs to know a shadow exists.
//
// TRANSFORMS SURVIVE, because the copy is replayed under the SAME matrix. The
// scratch surface is positioned in DEVICE space from the path's device
// extents, so a scaled or rotated canvas casts a scaled or rotated shadow
// rather than one drawn in the wrong place at the wrong size.

#[link_name = "cairo_get_matrix"]
extern fn cairo_get_matrix(cr: *u8, matrix: *Matrix);
#[link_name = "cairo_set_matrix"]
extern fn cairo_set_matrix(cr: *u8, matrix: *Matrix);
#[link_name = "cairo_copy_path"]
extern fn cairo_copy_path(cr: *u8) -> *u8;
#[link_name = "cairo_append_path"]
extern fn cairo_append_path(cr: *u8, path: *u8);
#[link_name = "cairo_path_destroy"]
extern fn cairo_path_destroy(path: *u8);
#[link_name = "cairo_fill_extents"]
extern fn cairo_fill_extents(cr: *u8, x1: *f64, y1: *f64, x2: *f64, y2: *f64);
#[link_name = "cairo_stroke_extents"]
extern fn cairo_stroke_extents(cr: *u8, x1: *f64, y1: *f64, x2: *f64, y2: *f64);
#[link_name = "cairo_user_to_device"]
extern fn cairo_user_to_device(cr: *u8, x: *f64, y: *f64);
#[link_name = "cairo_get_line_width"]
extern fn cairo_get_line_width(cr: *u8) -> f64;
#[link_name = "cairo_get_fill_rule"]
extern fn cairo_get_fill_rule(cr: *u8) -> i32;
#[link_name = "cairo_get_line_cap"]
extern fn cairo_get_line_cap(cr: *u8) -> i32;
#[link_name = "cairo_get_line_join"]
extern fn cairo_get_line_join(cr: *u8) -> i32;
#[link_name = "cairo_get_miter_limit"]
extern fn cairo_get_miter_limit(cr: *u8) -> f64;
#[link_name = "cairo_image_surface_create"]
extern fn cairo_image_surface_create(format: i32, width: i32, height: i32) -> *u8;
#[link_name = "cairo_create"]
extern fn cairo_create(surface: *u8) -> *u8;
#[link_name = "cairo_destroy"]
extern fn cairo_destroy(cr: *u8);
#[link_name = "cairo_surface_destroy"]
extern fn cairo_surface_destroy(s: *u8);
#[link_name = "cairo_surface_flush"]
extern fn cairo_surface_flush(s: *u8);
#[link_name = "cairo_surface_mark_dirty"]
extern fn cairo_surface_mark_dirty(s: *u8);
#[link_name = "cairo_image_surface_get_data"]
extern fn cairo_image_surface_get_data(s: *u8) -> *u8;
#[link_name = "cairo_image_surface_get_stride"]
extern fn cairo_image_surface_get_stride(s: *u8) -> i32;
#[link_name = "cairo_set_source_surface"]
extern fn cairo_set_source_surface(cr: *u8, surface: *u8, x: f64, y: f64);

// A scratch surface no bigger than this on a side. A canvas is a widget and a
// widget is not a billboard; the cap is what stops a recording with an absurd
// blur radius from asking for a gigabyte. Past it the shadow is DROPPED rather
// than drawn wrong-sized, which is the failure that looks like a bug.
const MAX_SHADOW_SIDE: i64 = 4096;

// ---- the blur ------------------------------------------------------------------
//
// THREE BOX PASSES, which is the standard approximation of a gaussian and is
// within about 3% of one — the same trick every compositor uses, because a true
// gaussian is O(r) per pixel per axis and a box blur is O(1) with a running sum.
//
// The surface is ARGB32 PREMULTIPLIED, and that is what makes blurring all four
// channels independently correct: in premultiplied form every channel is
// already colour×alpha, so a weighted average of the four is the weighted
// average of the composite. Blurring UNpremultiplied colour would bleed the
// shadow's hue into the fully transparent surround and put a coloured halo
// around the edge.

fn box_radius_for(sigma: f64) -> i64 {
    // The box width that best matches a gaussian of this sigma, from the
    // standard three-pass identity. Floor of one: a zero-width box is the
    // identity and a "blurred" shadow that is not blurred at all reads as a
    // bug rather than as a radius of nearly nothing.
    var r: i64 = ((sigma * (1.5 as f64)) + (0.5 as f64)) as i64;
    if r < (1 as i64) { r = 1 as i64; }
    return r;
}

fn blur_surface(surf: *u8, radius: f64) {
    if radius <= (0.0 as f64) { return; }
    { cairo_surface_flush(surf) };
    let data: *u8 = { cairo_image_surface_get_data(surf) };
    if data == (0 as *u8) { return; }
    let stride: i64 = { cairo_image_surface_get_stride(surf) } as i64;
    let w: i64 = { cairo_image_surface_get_width(surf) } as i64;
    let h: i64 = { cairo_image_surface_get_height(surf) } as i64;
    if w <= (0 as i64) { return; }
    if h <= (0 as i64) { return; }
    // facet's `radius` is the visual reach of the shadow, the same as
    // CGContextSetShadow's blur; sigma is half of it, which is the convention
    // that makes a radius of 8 look like a radius of 8 next to the AppKit
    // backend rather than twice as soft.
    let r: i64 = box_radius_for(radius / (2.0 as f64));
    var pass: i64 = 0 as i64;
    while pass < (3 as i64) {
        blur_rows(data, stride, w, h, r);
        blur_cols(data, stride, w, h, r);
        pass = pass +% (1 as i64);
    }
    { cairo_surface_mark_dirty(surf) };
    return;
}

fn byte_at(data: *u8, off: i64) -> u8 {
    return { *(((data as usize) +% (off as usize)) as *u8) };
}

fn set_byte_at(data: *u8, off: i64, v: u8) {
    let p: *u8 = ((data as usize) +% (off as usize)) as *u8;
    { *p = v };
    return;
}

// One box pass along a row, per channel, with a RUNNING SUM: the window moves
// one pixel at a time and costs one add and one subtract however wide it is.
// Reading is from `data` and writing is to `data`, so each row is copied into a
// scratch line first — a box blur that reads what it has already written is a
// smear in one direction, which is the classic way to get this wrong.
fn blur_rows(data: *u8, stride: i64, w: i64, h: i64, r: i64) {
    var line: vec::Vec[u8] = vec::new::[u8]();
    let span: i64 = w *% (4 as i64);
    var i: i64 = 0 as i64;
    while i < span { let _e: status::Status = line.append(0 as u8); i = i +% (1 as i64); }
    var y: i64 = 0 as i64;
    while y < h {
        let base: i64 = y *% stride;
        var k: i64 = 0 as i64;
        while k < span {
            match line.at_ptr(k as usize) {
                option::Option[*u8]::Some(p) => { { *p = byte_at(data, base +% k) }; }
                option::Option[*u8]::None => { }
            }
            k = k +% (1 as i64);
        }
        var ch: i64 = 0 as i64;
        while ch < (4 as i64) {
            var sum: i64 = 0 as i64;
            // Seat the window over [-r, r], clamping at the edges — which is
            // an EDGE-EXTEND and not a wrap: a shadow that wrapped would put
            // the right side's darkness on the left.
            var j: i64 = (0 as i64) -% r;
            while j <= r {
                sum = sum +% (line_at(line, clampi(j, 0 as i64, w -% (1 as i64)), ch) as i64);
                j = j +% (1 as i64);
            }
            let width: i64 = (r *% (2 as i64)) +% (1 as i64);
            var x: i64 = 0 as i64;
            while x < w {
                set_byte_at(data, base +% (x *% (4 as i64)) +% ch, (sum / width) as u8);
                let out: i64 = clampi(x -% r, 0 as i64, w -% (1 as i64));
                let inn: i64 = clampi(x +% r +% (1 as i64), 0 as i64, w -% (1 as i64));
                sum = sum -% (line_at(line, out, ch) as i64);
                sum = sum +% (line_at(line, inn, ch) as i64);
                x = x +% (1 as i64);
            }
            ch = ch +% (1 as i64);
        }
        y = y +% (1 as i64);
    }
    return;
}

fn blur_cols(data: *u8, stride: i64, w: i64, h: i64, r: i64) {
    var col: vec::Vec[u8] = vec::new::[u8]();
    let span: i64 = h *% (4 as i64);
    var i: i64 = 0 as i64;
    while i < span { let _e: status::Status = col.append(0 as u8); i = i +% (1 as i64); }
    var x: i64 = 0 as i64;
    while x < w {
        var k: i64 = 0 as i64;
        while k < h {
            var ch0: i64 = 0 as i64;
            while ch0 < (4 as i64) {
                match col.at_ptr(((k *% (4 as i64)) +% ch0) as usize) {
                    option::Option[*u8]::Some(p) => {
                        { *p = byte_at(data, (k *% stride) +% (x *% (4 as i64)) +% ch0) };
                    }
                    option::Option[*u8]::None => { }
                }
                ch0 = ch0 +% (1 as i64);
            }
            k = k +% (1 as i64);
        }
        var ch: i64 = 0 as i64;
        while ch < (4 as i64) {
            var sum: i64 = 0 as i64;
            var j: i64 = (0 as i64) -% r;
            while j <= r {
                sum = sum +% (line_at(col, clampi(j, 0 as i64, h -% (1 as i64)), ch) as i64);
                j = j +% (1 as i64);
            }
            let width: i64 = (r *% (2 as i64)) +% (1 as i64);
            var y: i64 = 0 as i64;
            while y < h {
                set_byte_at(data, (y *% stride) +% (x *% (4 as i64)) +% ch, (sum / width) as u8);
                let out: i64 = clampi(y -% r, 0 as i64, h -% (1 as i64));
                let inn: i64 = clampi(y +% r +% (1 as i64), 0 as i64, h -% (1 as i64));
                sum = sum -% (line_at(col, out, ch) as i64);
                sum = sum +% (line_at(col, inn, ch) as i64);
                y = y +% (1 as i64);
            }
            ch = ch +% (1 as i64);
        }
        x = x +% (1 as i64);
    }
    return;
}

fn line_at(v: vec::Vec[u8], index: i64, channel: i64) -> u8 {
    return match v.at_ptr(((index *% (4 as i64)) +% channel) as usize) {
        option::Option[*u8]::Some(p) => { *p },
        option::Option[*u8]::None => 0 as u8,
    };
}

fn clampi(v: i64, lo: i64, hi: i64) -> i64 {
    if v < lo { return lo; }
    if v > hi { return hi; }
    return v;
}

#[link_name = "cairo_image_surface_get_width"]
extern fn cairo_image_surface_get_width(s: *u8) -> i32;
#[link_name = "cairo_image_surface_get_height"]
extern fn cairo_image_surface_get_height(s: *u8) -> i32;

// ---- casting one ---------------------------------------------------------------
//
// Called from `fill_with` and `stroke_with` BEFORE the shape, with the path
// still in the context. Both preserve it; the shadow copies it.
fn cast_shadow(cr: *u8, st: *DrawState, is_stroke: bool) {
    if !{ (*st).has_shadow } { return; }
    let col: vocab::Color = paint::resolved({ (*st).shadow });
    let alpha: f64 = col.a * { (*st).shadow_opacity } * { (*st).opacity };
    if alpha <= (0.0 as f64) { return; }

    // The path's extents in DEVICE space, which is where the scratch surface
    // lives. `fill_extents` and `stroke_extents` are the two the path can have
    // and they differ by the line width, which is exactly why the stroke gets
    // its own — a hairline's shadow measured as a fill would be clipped.
    var x1: f64 = 0.0f64; var y1: f64 = 0.0f64;
    var x2: f64 = 0.0f64; var y2: f64 = 0.0f64;
    if is_stroke {
        { cairo_stroke_extents(cr, #addr_of(x1), #addr_of(y1), #addr_of(x2), #addr_of(y2)) };
    } else {
        { cairo_fill_extents(cr, #addr_of(x1), #addr_of(y1), #addr_of(x2), #addr_of(y2)) };
    }
    if x2 <= x1 { return; }
    if y2 <= y1 { return; }
    // Four CORNERS, not two: under a rotation the axis-aligned box of the
    // transformed extents is not the transform of the axis-aligned box.
    var dx1: f64 = x1; var dy1: f64 = y1;
    var dx2: f64 = x2; var dy2: f64 = y1;
    var dx3: f64 = x2; var dy3: f64 = y2;
    var dx4: f64 = x1; var dy4: f64 = y2;
    { cairo_user_to_device(cr, #addr_of(dx1), #addr_of(dy1)) };
    { cairo_user_to_device(cr, #addr_of(dx2), #addr_of(dy2)) };
    { cairo_user_to_device(cr, #addr_of(dx3), #addr_of(dy3)) };
    { cairo_user_to_device(cr, #addr_of(dx4), #addr_of(dy4)) };
    let minx: f64 = min4(dx1, dx2, dx3, dx4);
    let miny: f64 = min4(dy1, dy2, dy3, dy4);
    let maxx: f64 = max4(dx1, dx2, dx3, dx4);
    let maxy: f64 = max4(dy1, dy2, dy3, dy4);

    // Room for the blur to spread into, plus a pixel for antialiasing. Without
    // it the blur runs into the edge of its own surface and the shadow comes
    // out with a straight cut across it.
    let pad: f64 = { (*st).shadow_radius } + (2.0 as f64);
    let ox: f64 = floorf(minx - pad);
    let oy: f64 = floorf(miny - pad);
    let w: i64 = (ceilf(maxx + pad) - ox) as i64;
    let h: i64 = (ceilf(maxy + pad) - oy) as i64;
    if w <= (0 as i64) { return; }
    if h <= (0 as i64) { return; }
    if w > MAX_SHADOW_SIDE { return; }
    if h > MAX_SHADOW_SIDE { return; }

    // CAIRO_FORMAT_ARGB32 is 0.
    let surf: *u8 = { cairo_image_surface_create(0 as i32, w as i32, h as i32) };
    if surf == (0 as *u8) { return; }
    let cr2: *u8 = { cairo_create(surf) };
    if cr2 == (0 as *u8) { { cairo_surface_destroy(surf) }; return; }

    // The scratch context maps the SAME user space, shifted into the surface:
    // translate in device space first (cr2 starts at identity), then apply the
    // caller's own user-to-device matrix.
    var m: Matrix = Matrix { xx: 1.0f64, yx: 0.0f64, xy: 0.0f64,
                             yy: 1.0f64, x0: 0.0f64, y0: 0.0f64 };
    { cairo_get_matrix(cr, #addr_of(m)) };
    { cairo_translate(cr2, (0.0 as f64) - ox, (0.0 as f64) - oy) };
    { cairo_transform(cr2, #addr_of(m)) };

    let path: *u8 = { cairo_copy_path(cr) };
    if path != (0 as *u8) {
        { cairo_append_path(cr2, path) };
        { cairo_path_destroy(path) };
    }
    // FULLY OPAQUE into the scratch surface, with the real alpha applied at
    // composite time: blurring a colour that is already faint and then fading
    // it again would square the alpha and give a shadow half as dark as asked.
    { cairo_set_source_rgba(cr2, col.r, col.g, col.b, 1.0f64) };
    if is_stroke {
        // THE PEN IS COPIED. A fresh context has cairo's defaults, so a dashed
        // hairline would cast the shadow of a solid two-unit line — a shadow
        // that is not the shape's silhouette is not that shape's shadow. The
        // dash is the one part not carried: reading it back is an allocating
        // two-call dance for a difference nothing has asked to see, and it is
        // written down here rather than left to be discovered.
        { cairo_set_line_width(cr2, { cairo_get_line_width(cr) }) };
        { cairo_set_line_cap(cr2, { cairo_get_line_cap(cr) }) };
        { cairo_set_line_join(cr2, { cairo_get_line_join(cr) }) };
        { cairo_set_miter_limit(cr2, { cairo_get_miter_limit(cr) }) };
        { cairo_stroke(cr2) };
    } else {
        // The FILL RULE too — an even-odd path's shadow must have the holes.
        { cairo_set_fill_rule(cr2, { cairo_get_fill_rule(cr) }) };
        { cairo_fill(cr2) };
    }
    { cairo_destroy(cr2) };

    blur_surface(surf, { (*st).shadow_radius });

    // Composite in DEVICE space, at the recorded offset — which is in USER
    // space, so it goes through the matrix's linear part (the translation is
    // already in the surface's position and must not be applied twice).
    let odx: f64 = (m.xx * { (*st).shadow_dx }) + (m.xy * { (*st).shadow_dy });
    let ody: f64 = (m.yx * { (*st).shadow_dx }) + (m.yy * { (*st).shadow_dy });
    { cairo_save(cr) };
    { cairo_identity_matrix(cr) };
    { cairo_set_source_surface(cr, surf, ox + odx, oy + ody) };
    { cairo_paint_with_alpha(cr, alpha) };
    { cairo_restore(cr) };
    { cairo_surface_destroy(surf) };
    return;
}

fn min4(a: f64, b: f64, c: f64, d: f64) -> f64 {
    var m: f64 = a;
    if b < m { m = b; }
    if c < m { m = c; }
    if d < m { m = d; }
    return m;
}

fn max4(a: f64, b: f64, c: f64, d: f64) -> f64 {
    var m: f64 = a;
    if b > m { m = b; }
    if c > m { m = c; }
    if d > m { m = d; }
    return m;
}

fn floorf(v: f64) -> f64 {
    let t: f64 = (v as i64) as f64;
    if t > v { return t - (1.0 as f64); }
    return t;
}

fn ceilf(v: f64) -> f64 {
    let t: f64 = (v as i64) as f64;
    if t < v { return t + (1.0 as f64); }
    return t;
}

// ---- a bordered's DRAWN stroke -------------------------------------------------
//
// A `bordered` is a CSS border on the node's own widget, and that answers most
// of the kind: a width, a colour or a gradient, a radius, and `solid` / `dashed`
// / `dotted`. What CSS has no words for at all is the SHAPE OF THE STROKE
// ITSELF — where a dash starts, how a dash ends, how two segments meet — so
// `stroke_cap`, `stroke_join`, `stroke_miter_limit` and `stroke_dash_offset`
// were four props nothing could honour, and MANIFEST §1 recorded them as absent
// on the grounds that "a GtkFixed is not a canvas".
//
// It is not, but it can HOLD one. This is the same answer `facet_appkit` gives
// (`wants_shape` → a CAShapeLayer over the view, else the plain border), built
// out of the cairo this module already has for `canvas`: the three path
// builders above are exactly the three `stroke_shape` kinds.
//
// ONLY WHEN CSS CANNOT — narrower than AppKit's trigger on purpose. AppKit
// takes the path whenever there are dashes or any shape at all; here a dashed
// or rounded border keeps the CSS that already draws it correctly, and the
// overlay appears only for the four verbs CSS has no spelling for. Swapping a
// working border for a hand-drawn one to answer a prop nobody set would be a
// regression wearing a feature's clothes.

fn stroke_overlay_key() -> *u8 { return #str_ptr("facet-gtk-stroke\0"); }

// `controls::props_of` inlined rather than imported: `drawing` importing
// `controls` closes a cycle (E0404), which is the same wall `looks_like_path`
// hit and the reason it lives in `paint`. Six lines is cheaper than moving a
// third thing into the shared leaf.
fn bordered_of(n: *core::Node) -> *props::BorderedProps {
    let d: *core::Data = core::node_data(n);
    if d == (0 as *core::Data) { return 0 as *props::BorderedProps; }
    if { (*d).kind } != props::K_BORDERED { return 0 as *props::BorderedProps; }
    return { (*d).props } as *props::BorderedProps;
}

// `Flat` and `Miter` are CSS's own behaviour, so asking for either is not
// asking for a path — it is what the plain border already draws.
fn is_shaped_cap(c: vocab::LineCap) -> bool {
    return match c {
        vocab::LineCap::Flat => false,
        vocab::LineCap::Round => true,
        vocab::LineCap::Square => true,
    };
}

fn is_shaped_join(j: vocab::LineJoin) -> bool {
    return match j {
        vocab::LineJoin::Miter => false,
        vocab::LineJoin::Bevel => true,
        vocab::LineJoin::Round => true,
    };
}

// THE TRIGGER. A miter limit only means anything on a miter join, and a dash
// offset only on a dashed stroke — asking for either without the thing it
// modifies is not a request for a path.
fn wants_drawn_stroke(p: *props::BorderedProps) -> bool {
    if p == (0 as *props::BorderedProps) { return false; }
    if { (*p).stroke_width } <= (0.0 as f64) { return false; }
    if is_shaped_cap({ (*p).stroke_cap }) { return true; }
    if is_shaped_join({ (*p).stroke_join }) { return true; }
    let dashed: bool = { (*p).stroke_dash.count } > (0 as usize);
    if dashed && { (*p).stroke_dash_offset } != (0.0 as f64) { return true; }
    if { (*p).stroke_miter_limit } > (0.0 as f64) { return true; }
    return false;
}

fn stroke_overlay_of(v: *u8) -> *u8 {
    if v == (0 as *u8) { return 0 as *u8; }
    return g::get_data(v, stroke_overlay_key());
}

// Called from `views::configure` on the same bits that rebuild the CSS. Adds
// the overlay, removes it, or asks it to repaint — whichever the props now say.
fn sync_stroke(v: *u8, n: *core::Node) {
    if v == (0 as *u8) { return; }
    let p: *props::BorderedProps = bordered_of(n);
    let have: *u8 = stroke_overlay_of(v);
    if !wants_drawn_stroke(p) {
        if have != (0 as *u8) {
            gtk::Fixed::from_raw(v).remove(gtk::Widget::from_raw(have));
            g::set_data(v, stroke_overlay_key(), 0 as *u8);
        }
        return;
    }
    if have != (0 as *u8) {
        gtk::Widget::from_raw(have).queue_draw();
        return;
    }
    let area: gtk::DrawingArea = gtk::DrawingArea::new();
    // NOT A TARGET. The overlay sits over the node's own content, and a widget
    // that can be picked would swallow every click the node was built to
    // receive — which is the whole node, since the overlay covers it.
    area.upcast().set_can_target(false);
    area.upcast().set_can_focus(false);
    set_draw_func(area.raw(), stroke_draw, n as *u8, 0 as *u8);
    gtk::Fixed::from_raw(v).put(area.upcast(), 0.0f64, 0.0f64);
    g::set_data(v, stroke_overlay_key(), area.raw());
    return;
}

// Called from `geometry::reposition_children`, beside the other placements this
// package owns. A GtkFixed does not size its children, so the overlay is as big
// as the node or it draws in a 0x0 box.
fn layout_stroke(n: *core::Node, v: *u8, frame: flex::Frame) {
    let area: *u8 = stroke_overlay_of(v);
    if area == (0 as *u8) { return; }
    gtk::Widget::from_raw(area).set_size_request(frame.width as i32, frame.height as i32);
    gtk::Fixed::from_raw(v).move_(gtk::Widget::from_raw(area), 0.0f64, 0.0f64);
    gtk::Widget::from_raw(area).queue_draw();
    return;
}

fn stroke_draw(area: *u8, cr: *u8, width: i32, height: i32, user: *u8) {
    let n: *core::Node = user as *core::Node;
    if n == (0 as *core::Node) { return; }
    let p: *props::BorderedProps = bordered_of(n);
    if p == (0 as *props::BorderedProps) { return; }
    let w: f64 = { (*p).stroke_width };
    if w <= (0.0 as f64) { return; }

    // INSET BY HALF THE WIDTH. cairo strokes CENTRED on the path, so a path on
    // the box edge loses its outer half to the clip — the same reason a CSS
    // border is drawn inside the box. Half in on every side puts the whole
    // stroke where the border would have been.
    let half: f64 = w / (2.0 as f64);
    let box: vocab::Rect = vocab::Rect {
        x: half,
        y: half,
        width: (width as f64) - w,
        height: (height as f64) - w,
    };
    if box.width <= (0.0 as f64) || box.height <= (0.0 as f64) { return; }

    { cairo_set_line_width(cr, w) };
    { cairo_set_line_cap(cr, cairo_cap({ (*p).stroke_cap })) };
    { cairo_set_line_join(cr, cairo_join({ (*p).stroke_join })) };
    // Zero is facet's "unset", and cairo's own default is 10.
    let miter: f64 = { (*p).stroke_miter_limit };
    if miter > (0.0 as f64) { { cairo_set_miter_limit(cr, miter) }; }
    stroke_dashes(cr, p);

    let shape: vocab::Shape = { (*p).stroke_shape };
    let kind: i64 = { shape.kind };
    if kind == (3 as i64) {
        ellipse_path(cr, box);
    } else {
        if kind == (2 as i64) {
            rounded_rect_path(cr, box, { shape.corners.top_leading });
        } else {
            rect_path(cr, box);
        }
    }
    let brush: vocab::Brush = { (*p).stroke };
    // A GRADIENT stroke is the same source a fill would take. `gradient_for`
    // owns the pattern and the reference it returns is released here.
    if { brush.is_gradient } {
        let pat: *u8 = gradient_for(brush, box, 1.0f64);
        if pat != (0 as *u8) {
            { cairo_set_source(cr, pat) };
            { cairo_stroke(cr) };
            { cairo_pattern_destroy(pat) };
            return;
        }
    }
    use_color(cr, { brush.start }, 1.0f64);
    { cairo_stroke(cr) };
    return;
}

// The dash pattern, WITH its offset — which is the whole point of drawing this
// rather than writing `border-style: dashed`. An empty pattern clears cairo's,
// because the state is the context's and this draw does not own a fresh one.
fn stroke_dashes(cr: *u8, p: *props::BorderedProps) {
    let d: *vocab::Dashes = #addr_of((*p).stroke_dash);
    let n: usize = { (*d).count };
    if n == (0 as usize) { { cairo_set_dash(cr, 0 as *f64, 0 as i32, 0.0f64) }; return; }
    var runs: [f64; 8] = [0.0f64; 8];
    var i: usize = 0 as usize;
    while i < n && i < (8 as usize) {
        runs[i] = { (*d).run(i) };
        i = i +% (1 as usize);
    }
    { cairo_set_dash(cr, #addr_of(runs) as *f64, i as i32, { (*p).stroke_dash_offset }) };
    return;
}
