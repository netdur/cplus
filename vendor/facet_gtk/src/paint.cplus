// facet_gtk/paint — the SHARED BAND: the props every backed node honours,
// whatever kind it is.
//
// Split from the per-kind bodies for the reason `facet_appkit/paint` is: these
// verbs are declared once on the contract and answered once here, so a control
// gaining a view gains the whole band with it and cannot answer half of it.
//
// TWO MECHANISMS, and which one a verb uses is not a style choice.
//
//   * `opacity`, `is_visible`, `is_enabled`, `tooltip` are GtkWidget
//     PROPERTIES. Direct calls, no CSS, no parsing.
//   * `background_color`, `corner_radius`, `border` are CSS in GTK 4 — there
//     is no `gtk_widget_set_background_color`, by design. So each backed
//     widget carries its OWN GtkCssProvider, added to its style context once
//     and reloaded whenever one of its bits is dirty.
//
// WHY A PROVIDER PER WIDGET rather than one document with a rule per node: a
// shared provider has to be re-parsed in full on any single change, and it
// needs a unique selector per widget, which means inventing names and keeping
// them alive. A provider bound to the widget it styles has neither problem and
// dies with the widget. The cost is one GObject per backed node; GTK's own
// widgets carry more than that.
//
// COLOUR TOKENS. `vocab::Color` carries an `adaptive` pair (token 254) whose
// second half is the dark-appearance colour. AppKit resolves that by drawing
// inside an appearance; GTK has no such scope, so the side is chosen HERE from
// the current theme — see `window::is_dark`. That makes an appearance flip a
// re-apply, which is exactly what `theme::set_theme_changed_fn` is for.

import "stdlib/option" as option;
import "stdlib/text" as text;
import "facet/facet" as core;
import "facet/props" as props;
import "facet/vocabulary" as vocab;
import "facet/theme" as theme;
import "gtk4/gtk4" as gtk;
import "gobject/runtime" as g;

// Every state bit — the CREATE pass. Matches `facet_appkit::paint::all_bits`.
fn all_bits() -> u64 { return props::C_ALL_STATE; }

// Every FACT and no verb: what a theme flip re-reads. NOT `all_bits`, which is
// also the create sentinel — see the note in facet_appkit's `repaint_walk`.
fn restyle_bits() -> u64 { return props::C_RESTYLE; }

// The band's bits that feed the CSS DOCUMENT, as against the ones that are
// plain widget properties. `views::configure` asks for these when deciding
// whether the document has to be rebuilt.
fn css_band_bits() -> u64 {
    // C_FLOW_DIRECTION is here because a corner radius is LOGICAL and CSS's is
    // PHYSICAL: changing the flow swaps leading for trailing, so the document
    // has to be recomposed even though no radius moved. C_BACKGROUND carries
    // both the brush and the background image — `props.cplus` says the image
    // deliberately takes no bit of its own.
    return props::C_BACKGROUND_COLOR | props::C_CORNER_RADIUS
         | props::C_FLOW_DIRECTION | props::C_BACKGROUND;
}

// The band's own bits, so a caller can ask "is any of this dirty?" without
// keeping a second copy of the list.
fn band_bits() -> u64 {
    return props::C_OPACITY | props::C_BACKGROUND_COLOR | props::C_CORNER_RADIUS
         | props::C_IS_ENABLED | props::C_IS_VISIBLE | props::C_TOOLTIP
         | props::C_SHADOW | props::C_CLIP | props::C_FLOW_DIRECTION
         | props::C_BACKGROUND | props::C_TRANSFORM | props::C_ANIMATE
         | props::C_CANCEL_ANIMATIONS;
}

// Which side of an adaptive pair is live. Set by the window tier at install
// and on every appearance change; read here.
static DARK: bool = false;

fn set_dark(v: bool) { DARK = v; return; }
fn is_dark() -> bool { return DARK; }

// The desktop text-scaling factor, read once per appearance sync by the window
// tier. `font_scales` multiplies a size by this rather than switching CSS
// units — see `window::text_scale` for why the unit switch is wrong.
static TEXT_SCALE: f64 = 1.0f64;

fn set_text_scale(v: f64) { if v > (0.0 as f64) { TEXT_SCALE = v; } return; }
fn text_scale() -> f64 { return TEXT_SCALE; }

// ---- resolving a colour ------------------------------------------------------
//
// A `vocab::Color` is FOUR different things wearing one struct, told apart by
// `token`, and a backend that resolves only some of them renders the rest
// BLACK — every component is 0 on a token colour, because the components were
// never where the answer lived.
//
//   255        a literal rgba. Use the components.
//   254        an adaptive PAIR. Pick a side from the live appearance.
//   100..117   a THEME ROLE — `ink`, `surface`, `raised`. The application's
//              theme answers it, or the platform does when the theme is silent.
//   200..217   a DERIVED INK: "the readable ink over role N-100". Not a colour
//              at all but a QUESTION, and only a backend can answer it,
//              because the role beneath usually resolves to a platform token
//              whose value nothing portable knows.
//   1..24      a PLATFORM SEMANTIC colour — `text`, `accent`,
//              `window_background`. This file is where GTK's answers live.
//
// This was the whole of the gallery's washed-out chrome: `Color::ink()` is
// token 104 and arrived here with r=g=b=0, so every heading was drawn black on
// a dark background. Nothing was wrong with the colours; three of the four
// kinds were never being asked.

// A TOKEN COLOUR CARRIES NO ALPHA, and this is the trap that cost a debugging
// pass: `Color::tok` builds every named colour with `a: 0.0`, because the
// components are not where its answer lives. Only the constructors that take
// one write it — `Color::ink(0.5)` sets `a = 0.5`, plain `Color::ink()` sets
// 1.0 — so a token that arrived through `theme_fallback` (which returns
// `Color::text()`, a bare `tok`) has alpha 0 and multiplying by it makes the
// resolved colour INVISIBLE.
//
// Measured, before the fix: every colour resolved to the right RGB and
// `a=0.00`, and the gallery's whole content pane rendered transparent. So a
// token's zero alpha means UNSPECIFIED, not transparent — a deliberately
// invisible colour is `Color::none()`, which is token 0 and never reaches
// here.
fn alpha_of(c: vocab::Color) -> f64 {
    if c.a > (0.0 as f64) { return c.a; }
    return 1.0f64;
}

// Depth guard: a role resolves to a fallback which may itself be a role. The
// chain is one step deep by design (`theme.cplus` says so, and says derived ink
// is the one exception), so four is slack, not a limit anyone should reach.
fn resolve_depth(c: vocab::Color, depth: i32) -> vocab::Color {
    if depth <= (0 as i32) { return c; }
    let t: u32 = c.token;
    // Unset and literal: nothing to do.
    if t == (0 as u32) { return c; }
    if t == (255 as u32) { return c; }
    // The adaptive pair.
    if t == (254 as u32) {
        if !DARK { return c; }
        var out: vocab::Color = c;
        out.r = c.r2;
        out.g = c.g2;
        out.b = c.b2;
        out.a = c.a2;
        return out;
    }
    // A theme role. The application's theme first; the platform's default when
    // the theme left it unset. ALPHA IS THE CALLER'S: `Color::ink(0.5)` is the
    // ink role at half strength, and resolving the role must not throw that
    // away — it is carried on the token, not in the role's own colour.
    if c.is_theme_role() {
        var slot: vocab::Color = theme::theme_slot(t);
        if !slot.is_set() { slot = theme::theme_fallback(t); }
        var out: vocab::Color = resolve_depth(slot, depth -% (1 as i32));
        out.a = alpha_of(out) * alpha_of(c);
        return out;
    }
    // A derived ink: black or white over whatever the base role resolved to,
    // by luminance. The threshold is 0.55 rather than 0.5 — human perception
    // of a mid grey sits above the arithmetic midpoint, and a 0.5 threshold
    // puts grey text on grey chrome.
    if c.is_derived_ink() {
        let base: vocab::Color = resolve_depth(c.derived_ink_base(), depth -% (1 as i32));
        let lum: f64 = (0.2126 as f64) * base.r + (0.7152 as f64) * base.g
                     + (0.0722 as f64) * base.b;
        if lum > (0.55 as f64) {
            return vocab::Color::rgba(0.0f64, 0.0f64, 0.0f64, alpha_of(c));
        }
        return vocab::Color::rgba(1.0f64, 1.0f64, 1.0f64, alpha_of(c));
    }
    // A platform semantic colour.
    return platform_color(t, alpha_of(c));
}

fn resolved(c: vocab::Color) -> vocab::Color {
    return resolve_depth(c, 4 as i32);
}

// GTK's answers to facet's platform tier.
//
// Stated as NUMBERS rather than read from the theme, and that is a decision
// with a reason: GTK 4 removed `gtk_style_context_get_color`, and the CSS
// custom properties a theme exposes (`@theme_fg_color`) are only readable by
// parsing a stylesheet the toolkit does not hand out. What IS knowable is the
// appearance, so these are the two Adwaita palettes — the values GNOME's own
// HIG publishes — chosen by `DARK`.
//
// The accent is the one that should not be a constant. GNOME 47 exposes a user
// accent colour and this build's GTK (4.14) does not, so it is Adwaita blue
// and MANIFEST.md records the narrowing rather than the flat number pretending
// to be a preference.
fn platform_color(t: u32, alpha: f64) -> vocab::Color {
    if t == (1 as u32) { return mono(1.0f64, 0.0f64, alpha); }            // text
    if t == (2 as u32) { return mono(0.7f64, 0.36f64, alpha); }           // text_secondary
    if t == (9 as u32) { return mono(0.55f64, 0.55f64, alpha); }          // text_tertiary
    if t == (15 as u32) { return mono(0.55f64, 0.55f64, alpha); }         // placeholder
    if t == (16 as u32) { return rgba_both(0.47f64, 0.68f64, 0.93f64,
                                           0.11f64, 0.44f64, 0.85f64, alpha); }  // link
    if t == (3 as u32) { return rgba_both(0.21f64, 0.52f64, 0.89f64,
                                          0.21f64, 0.52f64, 0.89f64, alpha); }   // accent
    if t == (11 as u32) { return mono(0.14f64, 0.98f64, alpha); }         // window_background
    if t == (12 as u32) { return mono(0.09f64, 0.94f64, alpha); }         // under_page
    if t == (13 as u32) { return mono(0.20f64, 1.0f64, alpha); }          // control_background
    if t == (14 as u32) { return mono(0.28f64, 0.80f64, alpha); }         // fill
    if t == (19 as u32) { return mono(0.24f64, 0.86f64, alpha); }         // fill_secondary
    if t == (17 as u32) { return rgba_both(0.21f64, 0.52f64, 0.89f64,
                                           0.21f64, 0.52f64, 0.89f64, alpha); }  // selected content
    if t == (18 as u32) { return rgba_both(0.24f64, 0.36f64, 0.55f64,
                                           0.70f64, 0.82f64, 0.98f64, alpha); }  // selected text bg
    if t == (10 as u32) { return mono(0.30f64, 0.85f64, alpha); }         // separator
    // The system palette. Fixed hues by definition — a "system red" that
    // changed with the appearance would not be a named colour.
    if t == (4 as u32) { return fixed(0.88f64, 0.11f64, 0.14f64, alpha); }    // red
    if t == (5 as u32) { return fixed(0.18f64, 0.76f64, 0.49f64, alpha); }    // green
    if t == (6 as u32) { return fixed(0.21f64, 0.52f64, 0.89f64, alpha); }    // blue
    if t == (7 as u32) { return fixed(1.0f64, 0.47f64, 0.0f64, alpha); }      // orange
    if t == (8 as u32) { return fixed(0.60f64, 0.60f64, 0.60f64, alpha); }    // gray
    if t == (20 as u32) { return fixed(0.96f64, 0.83f64, 0.18f64, alpha); }   // yellow
    if t == (21 as u32) { return fixed(0.57f64, 0.35f64, 0.78f64, alpha); }   // purple
    if t == (22 as u32) { return fixed(0.91f64, 0.35f64, 0.60f64, alpha); }   // pink
    if t == (23 as u32) { return fixed(0.13f64, 0.70f64, 0.72f64, alpha); }   // teal
    if t == (24 as u32) { return fixed(0.35f64, 0.36f64, 0.78f64, alpha); }   // indigo
    // An unknown token is NOT black. Black is what this whole function exists
    // to stop being the answer to a question nobody mapped.
    return mono(1.0f64, 0.0f64, alpha);
}

// A grey whose level depends on the appearance: `d` when dark, `l` when light.
fn mono(d: f64, l: f64, alpha: f64) -> vocab::Color {
    let v: f64 = if DARK { d } else { l };
    return vocab::Color::rgba(v, v, v, alpha);
}

// An appearance-dependent colour, spelled out on both sides.
fn rgba_both(dr: f64, dg: f64, db: f64, lr: f64, lg: f64, lb: f64,
             alpha: f64) -> vocab::Color {
    if DARK { return vocab::Color::rgba(dr, dg, db, alpha); }
    return vocab::Color::rgba(lr, lg, lb, alpha);
}

fn fixed(r: f64, g: f64, b: f64, alpha: f64) -> vocab::Color {
    return vocab::Color::rgba(r, g, b, alpha);
}

// `Color` -> a CSS `rgba(...)`. Resolves the adaptive pair against `DARK`.
fn css_rgba(c: vocab::Color) -> text::Text {
    let live: vocab::Color = resolved(c);
    let r: f64 = live.r;
    let gg: f64 = live.g;
    let b: f64 = live.b;
    let a: f64 = live.a;
    let ri: i32 = (r * (255.0 as f64) + (0.5 as f64)) as i32;
    let gi: i32 = (gg * (255.0 as f64) + (0.5 as f64)) as i32;
    let bi: i32 = (b * (255.0 as f64) + (0.5 as f64)) as i32;
    // GTK's CSS parser takes a DECIMAL alpha, and the decimal has to be
    // written as one.
    //
    // This emitted `0.${thousandths}` — so an alpha of 1.0 came out as
    // `0.1000`, which GTK parses as ONE TENTH. Measured with `gdk_rgba_parse`:
    // `rgba(255,0,0,0.1000)` is alpha 0.100. Every opaque colour this package
    // wrote was being drawn at a tenth of its opacity, and three tests in this
    // suite pinned the broken string as the expected one.
    //
    // Three fraction digits is past what an 8-bit channel can show, which is
    // why thousandths; what was missing is the WHOLE part.
    let ai: i32 = (a * (1000.0 as f64) + (0.5 as f64)) as i32;
    let whole: i32 = ai / (1000 as i32);
    var frac: i32 = ai -% (whole *% (1000 as i32));
    if frac < (0 as i32) { frac = 0 as i32; }
    var digits: text::Text = text::from_str("${frac}");
    if frac < (100 as i32) { digits = text::from_str("0${frac}"); }
    if frac < (10 as i32) { digits = text::from_str("00${frac}"); }
    return "rgba(${ri},${gi},${bi},${whole}.${digits})";
}

// ---- Pango markup ------------------------------------------------------------
//
// The OTHER string facet styling becomes. CSS is what a widget's own band
// compiles to; markup is what a RUN of styled text compiles to, and three
// callers need it — a label with span children, a label with a `formatted_text`
// value, and the canvas's `draw_spans`. It lives here for the same reason
// `css_rgba` does: one translation of facet's vocabulary into a platform
// string, not three that drift.

// facet's named weights -> Pango's numeric ones, which are the CSS numbers —
// so this is `css_weight` under another name and deliberately not a second
// table.
fn pango_weight(w: vocab::FontWeight) -> i32 {
    return match w {
        vocab::FontWeight::Default => 400,
        vocab::FontWeight::UltraLight => 100,
        vocab::FontWeight::Thin => 200,
        vocab::FontWeight::Light => 300,
        vocab::FontWeight::Regular => 400,
        vocab::FontWeight::Medium => 500,
        vocab::FontWeight::Semibold => 600,
        vocab::FontWeight::Bold => 700,
        vocab::FontWeight::Heavy => 800,
        vocab::FontWeight::Black => 900,
    };
}

// Pango measures in 1024ths of a point.
fn pango_scale() -> f64 { return 1024.0f64; }

// One `<span>`'s attribute list. Every argument is a facet verb and every one
// of them is omitted when it is unset, so a run that names nothing inherits the
// label's own font and colour — which is what an unstyled run should do.
fn span_attrs(family: str, size: f64, weight: vocab::FontWeight, italic: bool,
              scales: bool, color: vocab::Color, background: vocab::Color,
              decoration: vocab::TextDecoration, spacing: f64,
              line_height: f64) -> text::Text {
    var a: text::Text = text::from_str("");
    if family != "" { a = a.appending(" face=\"${family}\""); }
    if size > (0.0 as f64) {
        var px: f64 = size;
        if scales { px = px * text_scale(); }
        let units: i32 = (px * pango_scale()) as i32;
        a = a.appending(" size=\"${units}\"");
    }
    let w: i32 = pango_weight(weight);
    a = a.appending(" weight=\"${w}\"");
    if italic { a = a.appending(" style=\"italic\""); }
    a = a.appending(markup_color("foreground", color).view());
    a = a.appending(markup_color("background", background).view());
    match decoration {
        vocab::TextDecoration::None => { }
        vocab::TextDecoration::Underline => { a = a.appending(" underline=\"single\""); }
        vocab::TextDecoration::Strikethrough => { a = a.appending(" strikethrough=\"true\""); }
    }
    if spacing != (0.0 as f64) {
        // Pango's letter spacing is in 1024ths too, and facet's is in points.
        let units: i32 = (spacing * pango_scale()) as i32;
        a = a.appending(" letter_spacing=\"${units}\"");
    }
    if line_height > (0.0 as f64) {
        // A FACTOR on both sides, so there is nothing to convert — and zero
        // means "the font's own" on both, which is why it is gated.
        a = a.appending(" line_height=\"${line_height}\"");
    }
    return a;
}

// Pango takes a colour as `#rrggbb`; its markup has NO alpha channel, so a
// translucent run draws opaque. Recorded in MANIFEST.md §3 rather than left for
// someone to find.
fn markup_color(attr: str, c: vocab::Color) -> text::Text {
    if !c.is_set() { return text::from_str(""); }
    let live: vocab::Color = resolved(c);
    let r: i32 = (live.r * (255.0 as f64) + (0.5 as f64)) as i32;
    let g2: i32 = (live.g * (255.0 as f64) + (0.5 as f64)) as i32;
    let b: i32 = (live.b * (255.0 as f64) + (0.5 as f64)) as i32;
    return text::from_str(" ${attr}=\"#${hex2(r)}${hex2(g2)}${hex2(b)}\"");
}

fn hex2(v: i32) -> text::Text {
    var n: i32 = v;
    if n < (0 as i32) { n = 0 as i32; }
    if n > (255 as i32) { n = 255 as i32; }
    var out: text::Text = text::from_str("");
    out = out.appending(hex_digit(n / (16 as i32)));
    out = out.appending(hex_digit(n % (16 as i32)));
    return out;
}

fn hex_digit(v: i32) -> str {
    if v == (0 as i32) { return "0"; }
    if v == (1 as i32) { return "1"; }
    if v == (2 as i32) { return "2"; }
    if v == (3 as i32) { return "3"; }
    if v == (4 as i32) { return "4"; }
    if v == (5 as i32) { return "5"; }
    if v == (6 as i32) { return "6"; }
    if v == (7 as i32) { return "7"; }
    if v == (8 as i32) { return "8"; }
    if v == (9 as i32) { return "9"; }
    if v == (10 as i32) { return "a"; }
    if v == (11 as i32) { return "b"; }
    if v == (12 as i32) { return "c"; }
    if v == (13 as i32) { return "d"; }
    if v == (14 as i32) { return "e"; }
    return "f";
}

// The five XML entities, of which three appear in ordinary prose. Pango's
// markup IS XML, so a run containing `&` or `<` would end the layout at that
// character or fail to parse outright — and a caption is exactly where an
// ampersand turns up.
//
// Replaced in ONE pass over the bytes rather than five passes with `replacing`:
// `&` has to go first, and a second pass would then escape the `&` of the
// entities the first pass wrote. Walking BYTES is right for UTF-8 — every byte
// of a multi-byte sequence is >= 0x80 and none of the five entities is, so a
// continuation byte falls through and the sequence is rebuilt exactly.
fn escape_markup(s: str) -> text::Text {
    var out: text::Text = text::from_str("");
    let base: *u8 = { #str_ptr(s) };
    var i: usize = 0 as usize;
    let n: usize = { #str_len(s) };
    while i < n {
        let b: u8 = { *(((base as usize) +% i) as *u8) };
        if b == (38 as u8) { out = out.appending("&amp;"); }
        else if b == (60 as u8) { out = out.appending("&lt;"); }
        else if b == (62 as u8) { out = out.appending("&gt;"); }
        else if b == (34 as u8) { out = out.appending("&quot;"); }
        else if b == (39 as u8) { out = out.appending("&apos;"); }
        else {
            let one: str = { #str_from_raw_parts(((base as usize) +% i) as *u8,
                                                 1 as usize) };
            out = out.appending(one);
        }
        i = i +% (1 as usize);
    }
    return out;
}

// One run, whole. `body` is escaped here so no caller can forget.
fn markup_run(attrs: str, body: str) -> text::Text {
    let escaped: text::Text = escape_markup(body);
    return text::from_str("<span${attrs}>${escaped}</span>");
}

// facet's `text_transform`, applied to the run's own text — markup has no
// transform attribute, so the string is transformed before it is escaped.
fn transformed(s: str, t: vocab::TextTransform) -> text::Text {
    return match t {
        vocab::TextTransform::Uppercase => text::from_str(s).uppercased(),
        vocab::TextTransform::Lowercase => text::from_str(s).lowercased(),
        vocab::TextTransform::None => text::from_str(s),
        vocab::TextTransform::Default => text::from_str(s),
    };
}

// The per-widget provider, keyed on the widget itself. `g_object_set_data`
// is the standard place to hang a companion object off a GObject, and it is
// what keeps the provider alive exactly as long as the widget.
fn provider_key() -> *u8 { return #str_ptr("facet-gtk-css\0"); }

// The class the band's rule is written AGAINST — see `set_css`. Added once,
// beside the provider, because the two are the same act.
fn band_class() -> str { return "facet-band"; }

fn provider_for(v: *u8) -> gtk::CssProvider {
    let existing: *u8 = g::get_data(v, provider_key());
    if existing != (0 as *u8) { return gtk::CssProvider::from_raw(existing); }
    let p: gtk::CssProvider = gtk::CssProvider::new();
    gtk::Widget::from_raw(v).add_css_class(band_class());
    // GTK_STYLE_PROVIDER_PRIORITY_APPLICATION (600): above the theme, below a
    // user stylesheet. facet is the application here.
    gtk::Widget::from_raw(v).get_style_context()
        .add_provider(gtk::StyleProvider::from_raw(p.raw()), 600 as u32);
    g::set_data(v, provider_key(), p.raw());
    return p;
}

// The band's own CSS, derived from the node. Rebuilt rather than cached: it
// is short, and a cache is a second copy of the truth that can disagree with
// the node.
fn band_css(n: *core::Node) -> text::Text {
    var body: text::Text = text::from_str("");
    let bg: vocab::Color = core::background_color(n);
    if bg.is_set() {
        let rgba: text::Text = css_rgba(bg);
        body = body.appending("background-color: ${rgba};");
    }
    body = body.appending(background_decls(n).view());
    let cr: vocab::Corners = core::corner_radius(n);
    if cr.top_leading > (0.0 as f64) || cr.top_trailing > (0.0 as f64)
        || cr.bottom_leading > (0.0 as f64) || cr.bottom_trailing > (0.0 as f64) {
        // CSS order is TL TR BR BL and is PHYSICAL; facet's is
        // leading/trailing per edge and is LOGICAL. In a left-to-right flow
        // they coincide; in a right-to-left one leading IS the right side, so
        // the pairs swap. CSS has logical corner properties
        // (`border-start-start-radius`) and GTK's CSS engine does not
        // implement them, so the mirroring is done here.
        let rtl: bool = is_rtl(n);
        let tl: i32 = if rtl { cr.top_trailing as i32 } else { cr.top_leading as i32 };
        let tr: i32 = if rtl { cr.top_leading as i32 } else { cr.top_trailing as i32 };
        let br: i32 = if rtl { cr.bottom_leading as i32 } else { cr.bottom_trailing as i32 };
        let bl: i32 = if rtl { cr.bottom_trailing as i32 } else { cr.bottom_leading as i32 };
        body = body.appending("border-radius: ${tl}px ${tr}px ${br}px ${bl}px;");
    }
    return body;
}

// Load a document of exactly the band, plus the kind's own declarations, plus
// any whole RULES the kind needs for its subnodes.
//
// ALWAYS THE WHOLE DOCUMENT, and always rebuilt from the node — a
// GtkCssProvider has no per-declaration edit, so a control writing its font
// would otherwise drop the background the band wrote. The kind bodies call
// this with their styling; nothing else appends.
//
// `.facet-band`, NOT `*`. A widget's provider is reachable from that widget's
// CSS SUBNODES too — a GtkScale is a `scale` node over `trough` over `slider`,
// and a GtkProgressBar likewise — so a universal selector paints a control's
// internal parts with the node's background as well as the control. The class
// is on the widget's own node and on nothing beneath it, which is exactly the
// scope the band means.
//
// That reachability is also what makes `rules` work at all: a kind that wants
// its thumb coloured writes `slider { background-color: ... }` and it lands on
// this widget's slider and no other's, because the provider is this widget's.
fn set_css(v: *u8, n: *core::Node, extra: str, rules: str) {
    var body: text::Text = band_css(n);
    if extra != "" { body = body.appending(extra); }
    var doc: text::Text = text::from_str("");
    if body.count() != (0 as usize) {
        let cls: str = band_class();
        doc = doc.appending(".${cls} { ${body} }");
    }
    if rules != "" { doc = doc.appending(rules); }
    // An EMPTY document rather than skipping the load: a widget that HAD a
    // background and lost it must lose it on screen too.
    provider_for(v).load_from_string(doc.view());
    return;
}

// The kind bodies' door: their own declarations, on top of the live band.
fn append_css(v: *u8, n: *core::Node, extra: str) {
    set_css(v, n, extra, "");
    return;
}

// The same, plus whole rules for the control's own CSS subnodes.
fn append_css_rules(v: *u8, n: *core::Node, extra: str, rules: str) {
    set_css(v, n, extra, rules);
    return;
}

fn reload_css(v: *u8, n: *core::Node) {
    set_css(v, n, "", "");
    return;
}

// Apply the band. `d` is the dirty word; every write is gated on its bit so a
// re-apply touches only what changed — except on the create pass, where `d` is
// `all_bits()` and everything lands.
fn band(v: *u8, n: *core::Node, d: u64) {
    if v == (0 as *u8) { return; }
    let w: gtk::Widget = gtk::Widget::from_raw(v);
    if (d & props::C_OPACITY) != (0 as u64) {
        w.set_opacity(core::opacity(n));
    }
    if (d & props::C_IS_VISIBLE) != (0 as u64) {
        w.set_visible(core::is_visible(n));
    }
    if (d & props::C_IS_ENABLED) != (0 as u64) {
        // GTK's word is "sensitive", and it is inherited by descendants — the
        // same semantics AppKit gives `enabled` on a container.
        w.set_sensitive(core::is_enabled(n));
    }
    if (d & props::C_TOOLTIP) != (0 as u64) {
        let t: str = core::tooltip(n);
        if t != "" { w.set_tooltip_text(t); }
    }
    if (d & props::C_FLOW_DIRECTION) != (0 as u64) {
        apply_flow_direction(w, n);
    }

    // The CSS document is NOT written here. It is one document per widget with
    // no per-declaration edit, so composing it is `views::configure`'s job —
    // reloading it from the band would drop whatever the kind had put in it.
    return;
}

// GtkImage takes an icon NAME or a file. facet's source is one string for
// both, so it is read the way every toolkit reads it: a path has a separator
// or an extension, a theme icon has neither.
//
// It lives HERE, in the leaf both callers already import, because `controls`
// and `drawing` have to answer it the same way — an app that puts
// `"folder-symbolic"` in an `image` and in a canvas gets one picture, not two
// readings of one string. `drawing` cannot import `controls` (that is a cycle
// through `anim`), and a second copy is where the two would drift.
fn looks_like_path(s: str) -> bool {
    var t: text::Text = text::from_str(s);
    if t.contains("/") { return true; }
    if t.contains(".") { return true; }
    return false;
}

// ---- the flow direction --------------------------------------------------------
//
// `C_FLOW_DIRECTION` — RTL. Two halves, and facet already does the harder one:
// `core::set_flow_direction` hands flex its own direction, and flex mirrors row
// layout, justification and edge resolution from there. What is left is the
// WIDGET, which GTK propagates to every descendant that has not set its own —
// text alignment, entry base direction, scale fill, and the arrows on a
// spin button all follow it.
fn apply_flow_direction(w: gtk::Widget, n: *core::Node) {
    // GtkTextDirection: NONE 0, LTR 1, RTL 2. `MatchParent` is NONE, which is
    // GTK's own word for "take the parent's" — not a third direction.
    w.set_direction(match core::flow_direction(n) {
        vocab::FlowDirection::LeftToRight => 1 as i32,
        vocab::FlowDirection::RightToLeft => 2 as i32,
        vocab::FlowDirection::MatchParent => 0 as i32,
    });
    return;
}

// Does this node resolve to a right-to-left flow?
//
// `MatchParent` is the DEFAULT and it is the case that has to be answered from
// somewhere other than the node — GTK's own default direction, which is the
// locale's, and which a `MatchParent` node inherits through the widget tree.
// So the question is asked of GTK rather than walked up facet's tree: the two
// agree by construction, because the widget direction is set from the node's.
fn is_rtl(n: *core::Node) -> bool {
    return match core::flow_direction(n) {
        vocab::FlowDirection::LeftToRight => false,
        vocab::FlowDirection::RightToLeft => true,
        vocab::FlowDirection::MatchParent => locale_is_rtl(),
    };
}

fn locale_is_rtl() -> bool { return { gtk_get_locale_direction() } == (2 as i32); }

#[link_name = "gtk_widget_get_default_direction"]
extern fn gtk_get_locale_direction() -> i32;

// ---- the background brush, and the background image ----------------------------
//
// THREE BACKGROUND VERBS, and this package answered one. `background_color` is
// a Color and was applied; `background` is a Brush — a solid or a linear
// gradient — and `background_image` is a source string, and neither appeared
// anywhere in this backend. `core::background(` had zero hits, which is the
// same hole `facet_appkit/paint.cplus` records finding on its own side.
//
// In CSS all three are one declaration each, so what AppKit needs a
// CAGradientLayer and a sublayer-ordering rule for, this needs a string.
//
// PRECEDENCE, most specific last: `background_color` is the oldest and
// narrowest verb and is written first; a brush overrides it (a solid brush
// re-states `background-color`, a gradient becomes `background-image`); an
// explicit image overrides that, because naming a file is the most specific
// thing an application can do.

fn background_decls(n: *core::Node) -> text::Text {
    var body: text::Text = text::from_str("");
    let b: vocab::Brush = core::background(n);
    if b.is_gradient {
        let g: text::Text = css_gradient(b);
        body = body.appending("background-image: ${g};");
    } else {
        if b.start.is_set() {
            let rgba: text::Text = css_rgba(b.start);
            body = body.appending("background-color: ${rgba};");
        }
    }
    let src: str = core::background_image(n);
    if src != "" {
        let url: text::Text = css_url(src);
        body = body.appending("background-image: ${url};");
        // A background IMAGE that is not sized is tiled at its natural size,
        // which is almost never what a background means. `cover` is the
        // ledger's own default for one and is what every other toolkit does.
        body = body.appending("background-size: cover;");
        body = body.appending("background-repeat: no-repeat;");
        body = body.appending("background-position: center;");
    }
    return body;
}

// facet's angle and CSS's differ by a QUARTER TURN, and getting it wrong is a
// gradient that runs the wrong way rather than one that fails to render — so
// it is written out.
//
// facet's is the canvas convention: zero degrees runs LEFT TO RIGHT, which is
// what `drawing::gradient_for` here and `facet_appkit/drawing.cplus`'s
// `gradient_axis` both implement (`cos`/`sin` of the angle as the axis, from
// the x axis). CSS's zero points TO THE TOP and increases clockwise, so `to
// right` is 90deg. The two therefore differ by +90.
//
// A DISAGREEMENT WORTH NAMING: `facet_appkit/paint.cplus`'s `apply_brush` — the
// VIEW background rather than the canvas — uses zero as top-to-bottom, which is
// neither of the canvas implementations. Two of the three agree and the canvas
// is the one facet's own `DrawCommand` documents, so this follows the canvas.
// MANIFEST.md §3 records the discrepancy so it is not rediscovered as a bug.
fn css_gradient(b: vocab::Brush) -> text::Text {
    // NORMALISED BEFORE ROUNDING, not after: a float-to-int cast truncates
    // toward zero, so -89.5 becomes -89 and a -180 degree brush came out one
    // degree off. Bringing the angle positive first makes the rounding a plain
    // floor, which is what `+ 0.5` means.
    var turn: f64 = b.angle + (90.0 as f64);
    while turn < (0.0 as f64) { turn = turn + (360.0 as f64); }
    var deg: i64 = (turn + (0.5 as f64)) as i64;
    // CSS accepts any angle, but a normalised one reads better in a dump and
    // makes the suite's expectations exact.
    deg = deg % (360 as i64);
    let a: text::Text = css_rgba(b.start);
    let z: text::Text = css_rgba(b.end);
    return text::from_str("linear-gradient(${deg}deg, ${a}, ${z})");
}

// A source is a PATH here, not a theme icon: CSS `url()` takes a file and the
// icon-name half of `looks_like_path` has no spelling in a stylesheet. A name
// that is not a path is skipped rather than emitted as a broken url.
//
// QUOTED, and the quote is why this is a function: a path with a space or a
// bracket in it would otherwise end the declaration early and take the rest of
// the document with it.
fn css_url(source: str) -> text::Text {
    if !looks_like_path(source) { return text::from_str("none"); }
    var t: text::Text = text::from_str(source);
    if t.contains("\"") { return text::from_str("none"); }
    if t.contains(")") { return text::from_str("none"); }
    return text::from_str("url(\"${source}\")");
}

// ---- comparing a C string to a str ---------------------------------------------
//
// Pango hands back a family name as a `const char *` and the name to compare it
// with is a `str`. CASE-INSENSITIVE, because font family names are matched that
// way everywhere — fontconfig, CSS and Pango all treat "Material Symbols
// Outlined" and "material symbols outlined" as one family, and a case-sensitive
// test here would report a correctly-loaded font as a substitution.
//
// ASCII folding only, which is what a font family name is.
fn cstr_equals_ignoring_case(c: *u8, s: str) -> bool {
    if c == (0 as *u8) { return false; }
    var i: usize = 0 as usize;
    let n: usize = s.count();
    while i < n {
        let a: u8 = { *(((c as usize) +% i) as *u8) };
        if a == (0 as u8) { return false; }
        let b: u8 = match s.byte_at(i) {
            option::Option[u8]::Some(x) => x,
            option::Option[u8]::None => { return false; }
        };
        if lower_ascii(a) != lower_ascii(b) { return false; }
        i = i +% (1 as usize);
    }
    // Both must END here — "Material" is not "Material Symbols Outlined".
    return { *(((c as usize) +% n) as *u8) } == (0 as u8);
}

fn lower_ascii(b: u8) -> u8 {
    if b >= (65 as u8) && b <= (90 as u8) { return b +% (32 as u8); }
    return b;
}

// ---- the pure math the curves and the canvas share -----------------------------
//
// `drawing` had these and `paint` now needs them for the easings; `drawing`
// imports `paint`, so they move DOWN rather than the dependency going up.
fn cos_approx(x: f64) -> f64 {
    return sin_approx(x + (3.14159265358979323846f64 / 2.0f64));
}

// sin and cos for the ONE place that needs them — a gradient's axis. The angle
// is a brush's, so this is read once per fill and never in a loop.
//
// A TAYLOR SERIES ONLY WORKS NEAR ZERO, and the fold is what makes it usable
// across a turn: seven terms at π give -0.075 for a value that is 0. So the
// angle comes down to the first quadrant and the sign is carried separately —
// which is what every fixed-point sine does and what the first version of this
// claimed to do and did not.
fn sin_approx(x: f64) -> f64 {
    let pi: f64 = 3.14159265358979323846f64;
    let two_pi: f64 = 6.28318530717958647692f64;
    var t: f64 = x;
    while t >= two_pi { t = t - two_pi; }
    while t < (0.0 as f64) { t = t + two_pi; }
    var sign: f64 = 1.0f64;
    // Past half a turn the curve is its own negative, half a turn back.
    if t > pi { t = t - pi; sign = (0.0 as f64) - 1.0f64; }
    // And within a half turn it is symmetric about the quarter.
    if t > (pi / 2.0f64) { t = pi - t; }
    let t2: f64 = t * t;
    let t3: f64 = t2 * t;
    let t5: f64 = t3 * t2;
    let t7: f64 = t5 * t2;
    return sign * (t - (t3 / 6.0f64) + (t5 / 120.0f64) - (t7 / 5040.0f64));
}

// Four parabolic arcs, each shorter and lower than the last. The constants are
// Penner's and are what every implementation of this curve uses.
fn bounce_out(t: f64) -> f64 {
    let n: f64 = 7.5625f64;
    let d: f64 = 2.75f64;
    if t < ((1.0 as f64) / d) { return n * t * t; }
    if t < ((2.0 as f64) / d) {
        let a: f64 = t - ((1.5 as f64) / d);
        return (n * a * a) + (0.75 as f64);
    }
    if t < ((2.5 as f64) / d) {
        let b: f64 = t - ((2.25 as f64) / d);
        return (n * b * b) + (0.9375 as f64);
    }
    let c: f64 = t - ((2.625 as f64) / d);
    return (n * c * c) + (0.984375 as f64);
}

// The standard "back out" spring: overshoots by about 10% and settles. A cubic
// rather than a decaying sine, because a cubic lands EXACTLY on 1 at t=1 and a
// decaying sine only approaches it.
fn spring_out(t: f64) -> f64 {
    let c: f64 = 1.70158f64;
    let inv: f64 = t - (1.0 as f64);
    return (1.0 as f64) + (((c + (1.0 as f64)) * inv * inv * inv) + (c * inv * inv));
}

// ---- the easing curves ---------------------------------------------------------
//
// Eleven presets, COMPUTED rather than tabulated. They live here rather than in
// `anim` because two modules need them — `anim` for the progress tween and a
// carousel's slide, `transform` for the shared band's `animate_*` — and
// `transform` cannot import `anim` without closing a cycle through `drawing`.
// `paint` is the leaf both reach.
fn eased(t: f64, curve: vocab::Easing) -> f64 {
    let x: f64 = t;
    if x <= (0.0 as f64) { return 0.0f64; }
    if x >= (1.0 as f64) { return 1.0f64; }
    let half_pi: f64 = 1.5707963267948966f64;
    return match curve {
        vocab::Easing::Linear => x,
        vocab::Easing::SinIn => (1.0 as f64) - cos_approx(x * half_pi),
        vocab::Easing::SinOut => sin_approx(x * half_pi),
        vocab::Easing::SinInOut =>
            ((1.0 as f64) - cos_approx(x * (half_pi * (2.0 as f64)))) / (2.0 as f64),
        vocab::Easing::CubicIn => x * x * x,
        vocab::Easing::CubicOut => {
            let inv: f64 = (1.0 as f64) - x;
            (1.0 as f64) - (inv * inv * inv)
        }
        vocab::Easing::CubicInOut => {
            if x < (0.5 as f64) { (4.0 as f64) * x * x * x }
            else {
                let inv: f64 = ((0.0 as f64) - ((2.0 as f64) * x)) + (2.0 as f64);
                (1.0 as f64) - ((inv * inv * inv) / (2.0 as f64))
            }
        }
        // A bounce is the OUT curve read backwards, which is how every toolkit
        // defines the pair — writing two tables is how they come to disagree.
        vocab::Easing::BounceIn => (1.0 as f64) - bounce_out((1.0 as f64) - x),
        vocab::Easing::BounceOut => bounce_out(x),
        // A spring OVERSHOOTS and settles. `SpringOut` is the familiar one (the
        // thing arrives, goes past, comes back); `SpringIn` is its mirror, and
        // it dips below zero on the way out — which for a progress fraction is
        // clamped by the CALLER, not here, because clamping a curve is how a
        // spring stops being one.
        vocab::Easing::SpringIn => (1.0 as f64) - spring_out((1.0 as f64) - x),
        vocab::Easing::SpringOut => spring_out(x),
    };
}
