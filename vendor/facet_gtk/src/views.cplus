// facet_gtk/views — the Renderer's five verbs.
//
// `mount::Renderer` is the whole seam between facet and a backend: create a
// view for a node, apply its dirty word, insert into a host, remove, and ask
// for a sync. Everything else this package does hangs off these.
//
// ONE CODE PATH FOR CREATE AND APPLY. `create` configures the new widget with
// `paint::all_bits()`, which is the same call `apply` makes with the node's
// real dirty word — so a prop honoured on update is honoured on create, and
// the two cannot drift. That rule is `facet_appkit/views`', and it is the
// reason the coverage number means anything.
//
// OWNERSHIP. A fresh GtkWidget carries a FLOATING reference (it is a
// GInitiallyUnowned). facet holds the widget in the node, so this package
// SINKS that reference at create and drops it in `view_release` — the pairing
// `gobject/runtime` exists for. Without the sink, a widget that is never
// parented leaks; without the release, one removed from its host does.

import "stdlib/option" as option;
import "facet/facet" as core;
import "facet/props" as props;
import "facet/gestures" as gestures;
import "flex_layout/flex_layout" as flex;
import "gtk4/gtk4" as gtk;
import "gobject/runtime" as g;
import "./controls" as controls;
import "./paint" as paint;

// Kinds that are not rectangles at all — read as NODES by whatever owns them,
// never given a widget of their own. Same list, same reasons, as the AppKit
// backend's `non_view_kind`: a span is a run inside its label's string, a menu
// item is a row in a menu.
fn non_view_kind(kind: u32) -> bool {
    if kind == props::K_SPAN { return true; }
    if kind == props::K_MENU { return true; }
    if kind == props::K_MENU_ITEM { return true; }
    if kind == props::K_CONTEXT_MENU { return true; }
    if kind == props::K_CONTEXT_MENU_ITEM { return true; }
    if kind == props::K_SWIPE_ITEM { return true; }
    if kind == props::K_TOOLBAR_ITEM { return true; }
    return false;
}

// Does this node need a widget? A bare container does not, unless something
// has to arrive ON it — gestures need a widget to land on, and a key gives it
// an address.
fn wants_view(n: *core::Node) -> bool {
    let kind: u32 = core::kind_of(n);
    if non_view_kind(kind) { return false; }
    if kind != core::K_NODE { return true; }
    if gestures::has_gestures(n) { return true; }
    return { (*n).key() } != "";
}

// Build the widget for a kind. A kind with no body yet answers null, and a
// null view is a node facet lays out and does not draw — honest, and visible
// in the coverage tool rather than hidden behind a placeholder rectangle.
fn create_for_kind(kind: u32, n: *core::Node) -> *u8 {
    if kind == props::K_LABEL { return controls::create_label(n); }
    if kind == props::K_BUTTON { return controls::create_button(n); }
    if kind == props::K_TOGGLE { return controls::create_toggle(n); }
    if kind == props::K_CHECKBOX { return controls::create_checkbox(n); }
    if kind == props::K_PROGRESS { return controls::create_progress(n); }
    if kind == props::K_SLIDER { return controls::create_slider(n); }
    if kind == props::K_TEXT_FIELD { return controls::create_text_field(n); }
    if kind == props::K_BOX { return controls::create_box(n); }
    // Every remaining backed kind is a plain container until it has a body:
    // it holds children and honours the shared band, which is more than a
    // null view and less than a claim.
    return controls::create_box(n);
}

fn apply_for_kind(kind: u32, v: *u8, n: *core::Node, dirty: u64) {
    if kind == props::K_LABEL { controls::apply_label(v, n, dirty); return; }
    if kind == props::K_BUTTON { controls::apply_button(v, n, dirty); return; }
    if kind == props::K_TOGGLE { controls::apply_toggle(v, n, dirty); return; }
    if kind == props::K_CHECKBOX { controls::apply_checkbox(v, n, dirty); return; }
    if kind == props::K_PROGRESS { controls::apply_progress(v, n, dirty); return; }
    if kind == props::K_SLIDER { controls::apply_slider(v, n, dirty); return; }
    if kind == props::K_TEXT_FIELD { controls::apply_text_field(v, n, dirty); return; }
    if kind == props::K_BOX { controls::apply_box(v, n, dirty); return; }
    return;
}

// The band, then the kind's own body. Order matters: a kind writes CSS ON TOP
// of the band's document (see `paint::append_css`), so the band has to have
// gone in first.
fn configure(v: *u8, n: *core::Node, d: u64) {
    paint::band(v, n, d);
    apply_for_kind(core::kind_of(n), v, n, d);
    return;
}

// ---- intrinsic size ----------------------------------------------------------
//
// flex sizes a LEAF from its measure callback, and a node without one measures
// 0x0. That is not a subtle failure: a `label("Save")` in a column becomes a
// zero-height strip and simply does not appear, with everything about it
// correct except its size. The AppKit backend records finding this the same
// way — by seeing nothing.
//
// GTK's answer is `gtk_widget_measure`, which fills min/natural for ONE
// orientation and takes the other as `for_size`. So a height is measured
// against the width flex is offering, which is what makes a wrapped label
// answer the height its text actually needs.
//
// `context` is flex's spare slot and carries the widget: facet's own Data
// rides the attachment, so nothing else wants it.

// min/natural for one orientation. 0 = horizontal, 1 = vertical; `for_size` of
// -1 means "unconstrained".
#[link_name = "gtk_widget_measure"]
extern fn gtk_widget_measure(widget: *u8, orientation: i32, for_size: i32,
                             minimum: *i32, natural: *i32,
                             minimum_baseline: *i32, natural_baseline: *i32);

// Kinds whose size is genuinely INTRINSIC — named one by one rather than
// "everything with a view". A scroll view or a canvas has a natural size too
// and it means something else: a surface is sized by its container, and asking
// it how big it would like to be is not a useful question.
fn has_intrinsic_size(kind: u32) -> bool {
    if kind == props::K_LABEL { return true; }
    if kind == props::K_BUTTON { return true; }
    if kind == props::K_TOGGLE { return true; }
    if kind == props::K_CHECKBOX { return true; }
    if kind == props::K_PROGRESS { return true; }
    if kind == props::K_SLIDER { return true; }
    if kind == props::K_TEXT_FIELD { return true; }
    return false;
}

// Controls MEANT TO FILL their line. GTK gives these a small natural width —
// a GtkScale's is its trough minimum, a GtkEntry's is a few characters — and
// flex trusts the number, so a slider laid out at its natural width is a stub
// rather than a control. The AppKit backend hits the same wall from the other
// side (`fittingSize` answers 0) and answers it the same way: a floor, stated
// here rather than left to the platform's idea of small.
fn fills_line(kind: u32) -> bool {
    if kind == props::K_SLIDER { return true; }
    if kind == props::K_PROGRESS { return true; }
    if kind == props::K_TEXT_FIELD { return true; }
    return false;
}

fn measure_natural(v: *u8, orientation: i32, for_size: i32) -> f64 {
    var mn: i32 = 0 as i32;
    var nat: i32 = 0 as i32;
    var mb: i32 = 0 as i32;
    var nb: i32 = 0 as i32;
    { gtk_widget_measure(v, orientation, for_size, #addr_of(mn), #addr_of(nat),
                         #addr_of(mb), #addr_of(nb)) };
    return nat as f64;
}

fn measure_view(ctx: *u8, avail_w: f64, wm: flex::MeasureMode,
                avail_h: f64, hm: flex::MeasureMode) -> flex::Size {
    if ctx == (0 as *u8) { return flex::Size { width: 0.0f64, height: 0.0f64 }; }
    // Width first, unconstrained: what the widget would like.
    var w: f64 = measure_natural(ctx, 0 as i32, 0 -% (1 as i32));
    // `avail_w == avail_w` is the NaN test — flex passes NaN for "no
    // constraint", and NaN is the one value not equal to itself.
    if avail_w == avail_w && avail_w > (0.0 as f64) {
        if w > avail_w { w = avail_w; }
    }
    // Height AGAINST that width: a label that wraps needs the width to know
    // how tall it is, which is the whole reason `for_size` exists.
    let h: f64 = measure_natural(ctx, 1 as i32, w as i32);
    return flex::Size { width: w, height: h };
}

// The fill-line variant: take the width offered rather than the natural one.
fn measure_filling(ctx: *u8, avail_w: f64, wm: flex::MeasureMode,
                   avail_h: f64, hm: flex::MeasureMode) -> flex::Size {
    if ctx == (0 as *u8) { return flex::Size { width: 0.0f64, height: 0.0f64 }; }
    var w: f64 = measure_natural(ctx, 0 as i32, 0 -% (1 as i32));
    if avail_w == avail_w && avail_w > (0.0 as f64) { w = avail_w; }
    let h: f64 = measure_natural(ctx, 1 as i32, w as i32);
    return flex::Size { width: w, height: h };
}

// ---- the five verbs ----------------------------------------------------------

fn create(ctx: *u8, n: *core::Node) -> *u8 {
    if n == (0 as *core::Node) { return 0 as *u8; }
    if !wants_view(n) {
        // A non-view kind is not a zero-sized box either — it must leave the
        // LAYOUT, or it consumes a `gap` and a `justify` slot it has no
        // business in. `Display::None` is flex's own word for that and does
        // not remove the node from the tree.
        if non_view_kind(core::kind_of(n)) { { (*n).set_display(flex::Display::None) }; }
        return 0 as *u8;
    }
    let v: *u8 = create_for_kind(core::kind_of(n), n);
    if v == (0 as *u8) { return 0 as *u8; }
    // Claim the floating reference — see the header.
    let _s: *u8 = g::object_ref_sink(v);
    // The key IS the accessibility name: facet's address and the platform's
    // a11y id are one token, as they are on AppKit.
    let k: str = { (*n).key() };
    if k != "" { gtk::Widget::from_raw(v).set_name(k); }
    // Configure it WHOLE — the same call apply makes, with every bit set.
    configure(v, n, paint::all_bits());
    // Intrinsic size: from here the node measures itself through its widget.
    let kind: u32 = core::kind_of(n);
    if has_intrinsic_size(kind) {
        { (*n).set_context(v) };
        if fills_line(kind) { { (*n).set_measure(measure_filling) }; }
        else { { (*n).set_measure(measure_view) }; }
    }
    return v;
}

fn apply(ctx: *u8, n: *core::Node) {
    if n == (0 as *core::Node) { return; }
    let v: *u8 = core::view_of(n);
    if v == (0 as *u8) { return; }
    let d: u64 = core::dirty_of(n);
    if d == (0 as u64) { return; }
    configure(v, n, d);
    // A node that measures ITSELF has just been written to, so its measurement
    // is stale — and nothing else in the pipeline knows that. flex's
    // incremental cache prunes a subtree whose STYLE is unchanged, and
    // `set_text` changes no style: it changes what the widget would answer if
    // asked again. Without this the label keeps the box it was given for its
    // OLD string.
    if has_intrinsic_size(core::kind_of(n)) { { (*n).mark_content_changed() }; }
    return;
}

fn insert(ctx: *u8, host: *u8, child: *u8, slot: usize) {
    if host == (0 as *u8) { return; }
    if child == (0 as *u8) { return; }
    // Every backed container is a GtkFixed, so there is ONE child model here.
    // The frame comes later, from the layout walk — `put` at the origin is
    // just "it is in the tree now".
    if geometry_parent(child) == host { return; }
    gtk::Fixed::from_raw(host).put(gtk::Widget::from_raw(child), 0.0f64, 0.0f64);
    return;
}

fn remove(ctx: *u8, host: *u8, child: *u8) {
    if child == (0 as *u8) { return; }
    // `unparent` rather than `Fixed::remove`, because it is right whatever the
    // host turns out to be — and a child whose host has already gone still
    // needs taking out of a tree that no longer exists.
    gtk::Widget::from_raw(child).unparent();
    return;
}

// The node let go of the widget: drop the reference `create` sank.
fn view_release(v: *u8) {
    if v == (0 as *u8) { return; }
    g::object_unref(v);
    return;
}

fn geometry_parent(child: *u8) -> *u8 {
    match gtk::Widget::from_raw(child).get_parent() {
        option::Option[gtk::Widget]::Some(p) => { return p.raw(); }
        option::Option[gtk::Widget]::None => { return 0 as *u8; }
    }
}

