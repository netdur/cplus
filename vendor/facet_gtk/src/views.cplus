// facet_gtk/views — the Renderer's five verbs.
//
// `mount::Renderer` is the whole seam between facet and a backend: create a
// view for a node, apply its dirty word, insert into a host, remove, and ask
// for a sync. Everything else this package does hangs off these.
//
// ONE CODE PATH FOR CREATE AND APPLY. `create` configures the new widget with
// `paint::all_bits()`, which is the same call `apply` makes with the node's
// real dirty word — so a prop honoured on update is honoured on create, and
// the two cannot drift. That rule is `facet_appkit/views`', and it is the
// reason the coverage number means anything.
//
// OWNERSHIP. A fresh GtkWidget carries a FLOATING reference (it is a
// GInitiallyUnowned). facet holds the widget in the node, so this package
// SINKS that reference at create and drops it in `view_release` — the pairing
// `gobject/runtime` exists for. Without the sink, a widget that is never
// parented leaks; without the release, one removed from its host does.

import "stdlib/option" as option;
import "stdlib/text" as text;
import "facet/facet" as core;
import "facet/props" as props;
import "facet/gestures" as gestures;
import "facet/text_button" as text_button;
import "facet/symbol" as symbol;
import "facet/menu" as menu;
import "facet/menu_item" as menu_item;
import "facet/context_menu_item" as context_menu_item;
import "facet/split" as split;
import "facet/window_chrome" as window_chrome;
import "facet/toolbar_item" as toolbar_item;
import "facet/tree" as tree;
import "flex_layout/flex_layout" as flex;
import "gtk4/gtk4" as gtk;
import "gobject/runtime" as g;
import "./controls" as controls;
import "./drawing" as drawing;
import "./window" as window;
import "./web" as web;
import "./input" as input;
import "./paint" as paint;
import "./transform" as transform;
import "./chrome" as chrome;
import "./swipe" as swipe;
import "./recycler" as recycler;

// Kinds that are not rectangles at all — read as NODES by whatever owns them,
// never given a widget of their own. Same list, same reasons, as the AppKit
// backend's `non_view_kind`: a span is a run inside its label's string, a menu
// item is a row in a menu.
fn non_view_kind(kind: u32) -> bool {
    if kind == props::K_SPAN { return true; }
    if kind == props::K_MENU { return true; }
    if kind == props::K_MENU_ITEM { return true; }
    if kind == props::K_CONTEXT_MENU { return true; }
    if kind == props::K_CONTEXT_MENU_ITEM { return true; }
    if kind == props::K_SWIPE_ITEM { return true; }
    if kind == props::K_TOOLBAR_ITEM { return true; }
    return false;
}

// Does this node need a widget? A bare container does not, unless something
// has to arrive ON it — gestures need a widget to land on, and a key gives it
// an address.
fn wants_view(n: *core::Node) -> bool {
    let kind: u32 = core::kind_of(n);
    if non_view_kind(kind) { return false; }
    if kind != core::K_NODE { return true; }
    if gestures::has_gestures(n) { return true; }
    // A bare container carrying only a FOCUS handler needs one too. Focus
    // arrives on a widget exactly as input does, so an unkeyed
    // `column(...).on_focus(...)` would otherwise describe a handler nothing
    // could ever deliver to — the same claim the gestures line above makes,
    // for the band `input::arm` wires before it reaches gestures at all.
    if core::wants_focus_events(n) { return true; }
    return { (*n).key() } != "";
}

// Build the widget for a kind. A kind with no body yet answers null, and a
// null view is a node facet lays out and does not draw — honest, and visible
// in the coverage tool rather than hidden behind a placeholder rectangle.
fn create_for_kind(kind: u32, n: *core::Node) -> *u8 {
    if kind == props::K_LABEL { return controls::create_label(n); }
    if kind == props::K_BUTTON { return controls::create_button(n); }
    if kind == text_button::K_TEXT_BUTTON { return controls::create_text_button(n); }
    if kind == props::K_ICON_BUTTON { return controls::create_icon_button(n); }
    if kind == props::K_TOGGLE { return controls::create_toggle(n); }
    if kind == props::K_CHECKBOX { return controls::create_checkbox(n); }
    if kind == props::K_RADIO { return controls::create_radio(n); }
    if kind == props::K_PROGRESS { return controls::create_progress(n); }
    if kind == props::K_SPINNER { return controls::create_spinner(n); }
    if kind == props::K_SLIDER { return controls::create_slider(n); }
    if kind == props::K_STEPPER { return controls::create_stepper(n); }
    if kind == props::K_IMAGE { return controls::create_image(n); }
    if kind == props::K_TEXT_FIELD { return controls::create_text_field(n); }
    if kind == props::K_SEARCH_FIELD { return controls::create_search_field(n); }
    if kind == props::K_TEXT_AREA { return controls::create_text_area(n); }
    if kind == symbol::K_SYMBOL { return controls::create_symbol(n); }
    if kind == props::K_PAGE_DOTS { return controls::create_page_dots(n); }
    if kind == props::K_SCROLL { return controls::create_scroll(n); }
    if kind == split::K_SPLIT { return controls::create_split(n); }
    if kind == tree::K_TREE { return recycler::create_tree(n); }
    if kind == props::K_LIST { return recycler::create_sequence(n); }
    if kind == props::K_COLLECTION { return recycler::create_sequence(n); }
    if kind == props::K_TABLE { return recycler::create_sequence(n); }
    if kind == props::K_POPUP { return controls::create_popup(n); }
    if kind == props::K_TABS { return controls::create_tabs(n); }
    if kind == props::K_DATE_PICKER { return controls::create_date_picker(n); }
    if kind == props::K_TIME_PICKER { return controls::create_time_picker(n); }
    if kind == props::K_CAROUSEL { return controls::create_carousel(n); }
    if kind == props::K_REFRESHABLE { return controls::create_refreshable(n); }
    if kind == props::K_SWIPEABLE { return swipe::create_swipeable(n); }
    if kind == window_chrome::K_WINDOW_BUTTONS { return chrome::create_window_buttons(n); }
    if kind == props::K_CANVAS { return drawing::create_canvas(n); }
    if kind == props::K_WEB { return web::create_web(n); }
    if kind == props::K_HYBRID_WEB { return web::create_web(n); }
    if kind == props::K_BOX { return controls::create_box(n); }
    // Every remaining backed kind is a plain container until it has a body:
    // it holds children and honours the shared band, which is more than a
    // null view and less than a claim.
    return controls::create_box(n);
}

fn apply_for_kind(kind: u32, v: *u8, n: *core::Node, dirty: u64) {
    if kind == props::K_LABEL { controls::apply_label(v, n, dirty); return; }
    if kind == props::K_BUTTON { controls::apply_button(v, n, dirty); return; }
    if kind == text_button::K_TEXT_BUTTON { controls::apply_text_button(v, n, dirty); return; }
    if kind == props::K_ICON_BUTTON { controls::apply_icon_button(v, n, dirty); return; }
    if kind == props::K_TOGGLE { controls::apply_toggle(v, n, dirty); return; }
    if kind == props::K_CHECKBOX { controls::apply_checkbox(v, n, dirty); return; }
    if kind == props::K_RADIO { controls::apply_radio(v, n, dirty); return; }
    if kind == props::K_PROGRESS { controls::apply_progress(v, n, dirty); return; }
    if kind == props::K_SPINNER { controls::apply_spinner(v, n, dirty); return; }
    if kind == props::K_SLIDER { controls::apply_slider(v, n, dirty); return; }
    if kind == props::K_STEPPER { controls::apply_stepper(v, n, dirty); return; }
    if kind == props::K_IMAGE { controls::apply_image(v, n, dirty); return; }
    if kind == props::K_TEXT_FIELD { controls::apply_text_field(v, n, dirty); return; }
    if kind == props::K_SEARCH_FIELD { controls::apply_search_field(v, n, dirty); return; }
    if kind == props::K_TEXT_AREA { controls::apply_text_area(v, n, dirty); return; }
    if kind == symbol::K_SYMBOL { controls::apply_symbol(v, n, dirty); return; }
    if kind == props::K_PAGE_DOTS { controls::apply_page_dots(v, n, dirty); return; }
    if kind == props::K_SCROLL { controls::apply_scroll(v, n, dirty); return; }
    if kind == split::K_SPLIT { controls::apply_split(v, n, dirty); return; }
    if kind == tree::K_TREE { recycler::apply_tree(v, n, dirty); return; }
    if kind == props::K_LIST { recycler::apply_list(v, n, dirty); return; }
    if kind == props::K_COLLECTION { recycler::apply_collection(v, n, dirty); return; }
    if kind == props::K_TABLE { recycler::apply_table(v, n, dirty); return; }
    if kind == props::K_POPUP { controls::apply_popup(v, n, dirty); return; }
    if kind == props::K_TABS { controls::apply_tabs(v, n, dirty); return; }
    if kind == props::K_DATE_PICKER { controls::apply_date_picker(v, n, dirty); return; }
    if kind == props::K_TIME_PICKER { controls::apply_time_picker(v, n, dirty); return; }
    if kind == props::K_CAROUSEL { controls::apply_carousel(v, n, dirty); return; }
    if kind == props::K_REFRESHABLE { controls::apply_refreshable(v, n, dirty); return; }
    if kind == props::K_SWIPEABLE { swipe::apply_swipeable(v, n, dirty); return; }
    if kind == window_chrome::K_WINDOW_BUTTONS { chrome::apply_window_buttons(v, n, dirty); return; }
    if kind == props::K_CANVAS { drawing::apply_canvas(v, n, dirty); return; }
    if kind == props::K_WEB { web::apply_web(v, n, dirty); return; }
    if kind == props::K_HYBRID_WEB { web::apply_hybrid_web(v, n, dirty); return; }
    if kind == props::K_BOX { controls::apply_box(v, n, dirty); return; }
    return;
}

// Does this node hold a `menu` among its children? Asked before rebuilding a
// menu bar, because every node in a tree gets `touch_all` at some point and
// almost none of them have anything to do with a menu.
fn holds_a_menu(n: *core::Node) -> bool {
    var i: usize = 0 as usize;
    let count: usize = core::child_count_of(n);
    while i < count {
        match core::child_of(n, i) {
            option::Option[*core::Node]::Some(c) => {
                if core::kind_of(c) == props::K_MENU { return true; }
            }
            option::Option[*core::Node]::None => { }
        }
        i = i +% (1 as usize);
    }
    return false;
}

// The same question for a `toolbar_item`. Separate from `holds_a_menu` rather
// than one walk answering both: they are asked under different dirty gates, and
// a shared walk would run for either kind's bits.
fn holds_a_toolbar_item(n: *core::Node) -> bool {
    var i: usize = 0 as usize;
    let count: usize = core::child_count_of(n);
    while i < count {
        match core::child_of(n, i) {
            option::Option[*core::Node]::Some(c) => {
                if core::kind_of(c) == props::K_TOOLBAR_ITEM { return true; }
            }
            option::Option[*core::Node]::None => { }
        }
        i = i +% (1 as usize);
    }
    return false;
}

// The band's PROPERTIES, then the whole CSS document, then the kind's own
// non-CSS writes.
//
// The CSS is composed in ONE place because a GtkCssProvider has no
// per-declaration edit: a kind that wrote its font from `apply` would drop the
// background the band had just written, and a band that reloaded would drop
// the font. So the document is rebuilt whole from the node whenever anything
// that feeds it is dirty — the band's two colour bits, or the kind's own
// styling bits, which each kind declares in `controls::css_bits`.
fn configure(v: *u8, n: *core::Node, d: u64) {
    let kind: u32 = core::kind_of(n);
    // ANIMATE BEFORE THE BAND, and this ordering is the whole difference
    // between a fade and a jump.
    //
    // `paint::band` answers `C_OPACITY` by writing the node's opacity straight
    // onto the widget. An animation starts FROM WHAT THE VIEW SHOWS — that is
    // the contract's rule and the reason `facet.cplus` warns about a `set_*` in
    // the same tick — so if the band runs first the start it reads is already
    // the end. MEASURED, with the dispatch after the band: scale interpolated
    // 100 → 106 → 122 → ... → 200 while opacity went 0 → 100 in one frame,
    // because scale has no snap branch in the band and opacity does.
    //
    // `facet_appkit/paint.cplus` records the same order in one line: "Animate
    // before snap: C_ANIMATE alone carries the channels; set_* would have
    // raised C_OPACITY / C_TRANSFORM and cleared those channels."
    //
    // Dispatched here rather than inside `paint::band` because `transform`
    // needs `paint`'s easing curves and `paint` would then need `transform`
    // back; `views` already owns the apply order.
    if (d & props::C_CANCEL_ANIMATIONS) != (0 as u64) { transform::cancel(v, n); }
    if (d & props::C_ANIMATE) != (0 as u64) { transform::animate(v, n); }
    paint::band(v, n, d);
    // The transform SNAP goes after, for the same reason the band's opacity
    // does: it is the end state, and an animation that just armed has already
    // taken its start.
    if (d & props::C_TRANSFORM) != (0 as u64) { transform::apply(v, n); }
    if (d & (paint::css_band_bits() | controls::css_bits(kind))) != (0 as u64) {
        let decls: text::Text = controls::css_decls(kind, n);
        let rules: text::Text = controls::css_rules(kind, n);
        paint::set_css(v, n, decls.view(), rules.view());
    }
    apply_for_kind(kind, v, n, d);
    return;
}

// ---- intrinsic size ----------------------------------------------------------
//
// flex sizes a LEAF from its measure callback, and a node without one measures
// 0x0. That is not a subtle failure: a `label("Save")` in a column becomes a
// zero-height strip and simply does not appear, with everything about it
// correct except its size. The AppKit backend records finding this the same
// way — by seeing nothing.
//
// GTK's answer is `gtk_widget_measure`, which fills min/natural for ONE
// orientation and takes the other as `for_size`. So a height is measured
// against the width flex is offering, which is what makes a wrapped label
// answer the height its text actually needs.
//
// `context` is flex's spare slot and carries the widget: facet's own Data
// rides the attachment, so nothing else wants it.

// min/natural for one orientation. 0 = horizontal, 1 = vertical; `for_size` of
// -1 means "unconstrained".
#[link_name = "gtk_widget_measure"]
extern fn gtk_widget_measure(widget: *u8, orientation: i32, for_size: i32,
                             minimum: *i32, natural: *i32,
                             minimum_baseline: *i32, natural_baseline: *i32);

// Kinds whose size is genuinely INTRINSIC — named one by one rather than
// "everything with a view". A scroll view or a canvas has a natural size too
// and it means something else: a surface is sized by its container, and asking
// it how big it would like to be is not a useful question.
fn has_intrinsic_size(kind: u32) -> bool {
    if kind == props::K_LABEL { return true; }
    if kind == props::K_BUTTON { return true; }
    if kind == text_button::K_TEXT_BUTTON { return true; }
    if kind == props::K_ICON_BUTTON { return true; }
    if kind == props::K_TOGGLE { return true; }
    if kind == props::K_CHECKBOX { return true; }
    if kind == props::K_RADIO { return true; }
    if kind == props::K_PROGRESS { return true; }
    if kind == props::K_SPINNER { return true; }
    if kind == props::K_SLIDER { return true; }
    if kind == props::K_STEPPER { return true; }
    if kind == props::K_TEXT_FIELD { return true; }
    if kind == props::K_SEARCH_FIELD { return true; }
    if kind == props::K_POPUP { return true; }
    if kind == props::K_DATE_PICKER { return true; }
    if kind == props::K_TIME_PICKER { return true; }
    if kind == symbol::K_SYMBOL { return true; }
    if kind == props::K_PAGE_DOTS { return true; }
    // The group is three buttons wide and as tall as a button — a size an
    // application should not have to state, and one only GTK knows.
    if kind == window_chrome::K_WINDOW_BUTTONS { return true; }
    return false;
}

// Controls MEANT TO FILL their line. GTK gives these a small natural width —
// a GtkScale's is its trough minimum, a GtkEntry's is a few characters — and
// flex trusts the number, so a slider laid out at its natural width is a stub
// rather than a control. The AppKit backend hits the same wall from the other
// side (`fittingSize` answers 0) and answers it the same way: a floor, stated
// here rather than left to the platform's idea of small.
fn fills_line(kind: u32) -> bool {
    if kind == props::K_SLIDER { return true; }
    if kind == props::K_PROGRESS { return true; }
    if kind == props::K_TEXT_FIELD { return true; }
    if kind == props::K_SEARCH_FIELD { return true; }
    return false;
}

fn measure_natural(v: *u8, orientation: i32, for_size: i32) -> f64 {
    var mn: i32 = 0 as i32;
    var nat: i32 = 0 as i32;
    var mb: i32 = 0 as i32;
    var nb: i32 = 0 as i32;
    { gtk_widget_measure(v, orientation, for_size, #addr_of(mn), #addr_of(nat),
                         #addr_of(mb), #addr_of(nb)) };
    return nat as f64;
}

// MEASURE THE WIDGET, NOT WHAT WE LAST TOLD IT TO BE.
//
// `geometry::place` sets the frame with `set_size_request`, and a size request
// is a MINIMUM: `gtk_widget_measure` can never answer less than one. So asking
// a placed widget for its natural size returns `max(natural, what we asked for
// last pass)` — the measurement reads back our own previous answer.
//
// That is a RATCHET, and it is what made the gallery walk off the bottom of
// the window. A wrapping label's height is measured against an offered width;
// any pass where that width came out a little narrower produced a taller
// label, `place` wrote the taller height into the request, and the next
// measurement could never go below it again. Each click added another line —
// measured at ~31px per click on the Button demo, whose snippet grew from 81px
// to 680px over nineteen clicks and pushed everything after it off-screen.
//
// So the request is lifted for the duration of the measurement and put back
// immediately. Nothing else may run in between: this is the same widget the
// caller is about to place, and leaving it unconstrained would let one
// intervening layout pass see a size nobody asked for.
//
// The AppKit backend has no equivalent guard and needs none — `setFrame:` does
// not change what `fittingSize` answers.
fn measure_unconstrained(v: *u8, orientation: i32, for_size: i32) -> f64 {
    let w: gtk::Widget = gtk::Widget::from_raw(v);
    var req_w: i32 = 0 as i32;
    var req_h: i32 = 0 as i32;
    w.get_size_request(req_w, req_h);
    let none: i32 = 0 -% (1 as i32);
    w.set_size_request(none, none);
    let n: f64 = measure_natural(v, orientation, for_size);
    w.set_size_request(req_w, req_h);
    return n;
}

fn measure_view(ctx: *u8, avail_w: f64, wm: flex::MeasureMode,
                avail_h: f64, hm: flex::MeasureMode) -> flex::Size {
    if ctx == (0 as *u8) { return flex::Size { width: 0.0f64, height: 0.0f64 }; }
    // Width first, unconstrained: what the widget would like.
    var w: f64 = measure_unconstrained(ctx, 0 as i32, 0 -% (1 as i32));
    // `avail_w == avail_w` is the NaN test — flex passes NaN for "no
    // constraint", and NaN is the one value not equal to itself.
    if avail_w == avail_w && avail_w > (0.0 as f64) {
        if w > avail_w { w = avail_w; }
    }
    // Height AGAINST that width: a label that wraps needs the width to know
    // how tall it is, which is the whole reason `for_size` exists.
    let h: f64 = measure_unconstrained(ctx, 1 as i32, w as i32);
    return flex::Size { width: w, height: h };
}

// The fill-line variant: take the width offered rather than the natural one.
fn measure_filling(ctx: *u8, avail_w: f64, wm: flex::MeasureMode,
                   avail_h: f64, hm: flex::MeasureMode) -> flex::Size {
    if ctx == (0 as *u8) { return flex::Size { width: 0.0f64, height: 0.0f64 }; }
    var w: f64 = measure_unconstrained(ctx, 0 as i32, 0 -% (1 as i32));
    if avail_w == avail_w && avail_w > (0.0 as f64) { w = avail_w; }
    let h: f64 = measure_unconstrained(ctx, 1 as i32, w as i32);
    return flex::Size { width: w, height: h };
}

// ---- the five verbs ----------------------------------------------------------

fn create(ctx: *u8, n: *core::Node) -> *u8 {
    if n == (0 as *core::Node) { return 0 as *u8; }
    if !wants_view(n) {
        // A non-view kind is not a zero-sized box either — it must leave the
        // LAYOUT, or it consumes a `gap` and a `justify` slot it has no
        // business in. `Display::None` is flex's own word for that and does
        // not remove the node from the tree.
        if non_view_kind(core::kind_of(n)) { { (*n).set_display(flex::Display::None) }; }
        return 0 as *u8;
    }
    let v: *u8 = create_for_kind(core::kind_of(n), n);
    if v == (0 as *u8) { return 0 as *u8; }
    // Claim the floating reference — see the header.
    let _s: *u8 = g::object_ref_sink(v);
    // The key IS the accessibility name: facet's address and the platform's
    // a11y id are one token, as they are on AppKit.
    let k: str = { (*n).key() };
    if k != "" { gtk::Widget::from_raw(v).set_name(k); }
    // Configure it WHOLE — the same call apply makes, with every bit set.
    configure(v, n, paint::all_bits());
    // The READ half. `arm` binds the node onto the widget — which every backed
    // node needs, gestures or not, because the sender readers walk it — and
    // then arms only the gesture bands this node actually declared.
    input::arm(v, n);
    // A `context_menu` DECORATES this node: right-clicking it is what opens the
    // menu, so the menu is built from the child NODES the moment this node has
    // a widget to hang it on. The children are already there — `build` ran long
    // before mount — even though none of them will ever get a widget.
    window::attach_context_menu(v, n);
    // Intrinsic size: from here the node measures itself through its widget.
    let kind: u32 = core::kind_of(n);
    if has_intrinsic_size(kind) {
        { (*n).set_context(v) };
        if fills_line(kind) { { (*n).set_measure(measure_filling) }; }
        else { { (*n).set_measure(measure_view) }; }
    }
    // `text_area.auto_size` is the one kind whose intrinsic sizing is a
    // PROPERTY rather than a fact about the kind: an editor is normally sized
    // by its container, and `AutoSize::TextChanges` is the application asking
    // for the other thing. It fills its line for the same reason a text field
    // does — GTK's natural width for a GtkTextView is its widest line, and an
    // editor laid out at that width is one that never wraps.
    if input::auto_sizes(n) {
        { (*n).set_context(v) };
        { (*n).set_measure(measure_filling) };
    }
    return v;
}

fn apply(ctx: *u8, n: *core::Node) {
    if n == (0 as *core::Node) { return; }
    let v: *u8 = core::view_of(n);
    if v == (0 as *u8) { return; }
    let d: u64 = core::dirty_of(n);
    if d == (0 as u64) { return; }
    configure(v, n, d);
    // `attach` / `detach` / a whole-set swap all raise C_GESTURES, and arming
    // is idempotent per band — so a set that gained a verb gains its
    // controller here, and one that gained nothing pays a handful of null
    // reads. `C_INPUT_TRANSPARENT` rides along because `arm` answers it.
    if (d & (core::C_GESTURES | props::C_INPUT_TRANSPARENT)) != (0 as u64) {
        input::arm(v, n);
    }
    // A `menu` subtree changed under this node. A viewless child cannot say
    // which of its host's verbs it affected, so `mount` raises `touch_all` on
    // the host — which is why the bits a MENU carries are what this tests for,
    // on a node that holds one.
    // NOT `menu_item::P_IS_DESTRUCTIVE`, which this backend does not answer —
    // naming a bit in a gate that then does nothing with it is exactly how the
    // coverage number gets inflated. See MANIFEST.md §1.
    if (d & (menu::P_TEXT | menu::P_PRIORITY | menu_item::P_TEXT
             | menu_item::P_ICON)) != (0 as u64) {
        if holds_a_menu(n) { window::menus_changed(); }
    }
    // The same shape for a `context_menu`, which decorates THIS node — so the
    // change arrives here rather than on a window, and the popover is rebuilt
    // in place.
    if (d & (context_menu_item::P_TEXT | context_menu_item::P_ICON
             | context_menu_item::P_SHORTCUT)) != (0 as u64) {
        window::attach_context_menu(v, n);
    }
    // And a `toolbar_item`, which is viewless in the same way but belongs to
    // the WINDOW rather than to the node it was declared under — so the whole
    // bar is repacked rather than one button edited in place.
    if (d & chrome::toolbar_bits()) != (0 as u64) {
        if holds_a_toolbar_item(n) { window::toolbars_changed(); }
    }
    // A node that measures ITSELF has just been written to, so its measurement
    // is stale — and nothing else in the pipeline knows that. flex's
    // incremental cache prunes a subtree whose STYLE is unchanged, and
    // `set_text` changes no style: it changes what the widget would answer if
    // asked again. Without this the label keeps the box it was given for its
    // OLD string.
    if has_intrinsic_size(core::kind_of(n)) || input::auto_sizes(n) {
        { (*n).mark_content_changed() };
    }
    return;
}

fn insert(ctx: *u8, raw_host: *u8, child: *u8, slot: usize) {
    if raw_host == (0 as *u8) { return; }
    if child == (0 as *u8) { return; }
    // A scroll's children belong in its DOCUMENT, not in the scroll view — the
    // one kind whose widget and whose child host differ. Every other kind
    // answers itself, so there is still ONE child model below this line.
    let host: *u8 = controls::document_host(raw_host);
    // The frame comes later, from the layout walk — `put` at the origin is
    // just "it is in the tree now".
    if geometry_parent(child) != host {
        gtk::Fixed::from_raw(host).put(gtk::Widget::from_raw(child), 0.0f64, 0.0f64);
    }
    // `put` APPENDS, which is right for a fresh mount and wrong for an insert
    // into the middle of a live list. A GtkFixed has no ordering API of its
    // own, but GtkWidget does — and the order matters twice over: it is the
    // paint order (a Fixed's later children draw on top) and it is what
    // `component::raise` moves a node through.
    place_at_slot(host, child, slot);
    return;
}

// Move `child` so that exactly `slot` siblings precede it. `insert_after` with
// a NULL sibling means "make it first"; anything else names the widget it
// follows.
fn place_at_slot(host: *u8, child: *u8, slot: usize) {
    let hw: gtk::Widget = gtk::Widget::from_raw(host);
    let cw: gtk::Widget = gtk::Widget::from_raw(child);
    if slot == (0 as usize) {
        // Already first: a fresh mount inserts in order, so this is the common
        // case and a reorder per child would make mounting quadratic.
        if first_facet_child(host) == child { return; }
        cw.insert_after(hw, gtk::Widget::from_raw(0 as *u8));
        return;
    }
    // Walk to the widget that should end up just before it, skipping the child
    // itself — it is already somewhere in this list and must not count.
    var prev: *u8 = 0 as *u8;
    var seen: usize = 0 as usize;
    var cur: *u8 = first_child_raw(host);
    while cur != (0 as *u8) {
        // Only widgets that carry a NODE are facet's children. A split's
        // divider lives in the same GtkFixed and belongs to this package, so
        // counting it would shift every slot after it by one.
        if cur != child && input::node_of_widget(cur) != (0 as *core::Node) {
            prev = cur;
            seen = seen +% (1 as usize);
            if seen == slot {
                if next_sibling_raw(prev) == child { return; }   // already there
                cw.insert_after(hw, gtk::Widget::from_raw(prev));
                return;
            }
        }
        cur = next_sibling_raw(cur);
    }
    // Fewer siblings than the slot asked for: the end is where it belongs.
    return;
}

// The first child that is one of FACET's, skipping anything this package put
// in the same host for itself.
fn first_facet_child(host: *u8) -> *u8 {
    var cur: *u8 = first_child_raw(host);
    while cur != (0 as *u8) {
        if input::node_of_widget(cur) != (0 as *core::Node) { return cur; }
        cur = next_sibling_raw(cur);
    }
    return 0 as *u8;
}

fn first_child_raw(v: *u8) -> *u8 {
    match gtk::Widget::from_raw(v).get_first_child() {
        option::Option[gtk::Widget]::Some(c) => { return c.raw(); }
        option::Option[gtk::Widget]::None => { return 0 as *u8; }
    }
}

fn next_sibling_raw(v: *u8) -> *u8 {
    match gtk::Widget::from_raw(v).get_next_sibling() {
        option::Option[gtk::Widget]::Some(c) => { return c.raw(); }
        option::Option[gtk::Widget]::None => { return 0 as *u8; }
    }
}

fn remove(ctx: *u8, host: *u8, child: *u8) {
    if child == (0 as *u8) { return; }
    // `unparent` rather than `Fixed::remove`, because it is right whatever the
    // host turns out to be — and a child whose host has already gone still
    // needs taking out of a tree that no longer exists.
    gtk::Widget::from_raw(child).unparent();
    return;
}

// The node let go of the widget: drop the reference `create` sank.
fn view_release(v: *u8) {
    if v == (0 as *u8) { return; }
    // BEFORE THE UNREF. An animation still running on this widget would write
    // an opacity or a transform to it on its next frame, sixteen milliseconds
    // after the last reference went — which is a use-after-free with a timer
    // attached to it.
    transform::released(v);
    g::object_unref(v);
    return;
}

fn geometry_parent(child: *u8) -> *u8 {
    match gtk::Widget::from_raw(child).get_parent() {
        option::Option[gtk::Widget]::Some(p) => { return p.raw(); }
        option::Option[gtk::Widget]::None => { return 0 as *u8; }
    }
}

