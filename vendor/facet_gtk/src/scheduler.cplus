// facet_gtk/scheduler — the Renderer's `schedule` verb and facet's Scheduler
// service, both over the GLib main loop.
//
// facet coalesces: a handler that writes ten props marks ten bits and asks for
// ONE sync. `schedule` is that ask, and it must be idempotent within a turn —
// so a pending flag, not a queue.
//
// `g_idle_add` runs the callback when the loop next goes idle, which is after
// the current event is fully dispatched. That is exactly the AppKit backend's
// "run loop observer" position: every write from one event lands, then one
// layout and one frame walk.

import "stdlib/option" as option;
import "stdlib/io" as io;
import "stdlib/env" as env;
import "stdlib/vec" as vec;
import "stdlib/status" as status;
import "flex_layout/flex_layout" as flex;
import "facet/facet" as core;
import "facet/mount" as mount;
import "facet/services" as services;
import "./observers" as observers;
import "./window" as window;

// `guint g_idle_add(GSourceFunc, gpointer)` — the callback returns FALSE to be
// removed after one run, which is what a one-shot needs.
#[link_name = "g_idle_add"]
extern fn g_idle_add(f: fn(*u8) -> i32, data: *u8) -> u32;

// `guint g_timeout_add(guint interval_ms, GSourceFunc, gpointer)`.
#[link_name = "g_timeout_add"]
extern fn g_timeout_add(interval: u32, f: fn(*u8) -> i32, data: *u8) -> u32;

#[link_name = "g_source_remove"]
extern fn g_source_remove(tag: u32) -> i32;

// One pending sync at a time — see the header.
static PENDING: bool = false;

// `FACET_GTK_SYNC=1` — WHAT A FRAME COSTS, in the three parts it has. The
// MANIFEST's §2 debt rows are guesses until they are numbers: "relayout_all
// re-lays every window on every sync" is a worry, and "the relayout is 0.2ms of
// a 3ms sync" is a decision. Off by default and read once.
static SYNC_TRACE_READ: bool = false;
static SYNC_TRACE_ON: bool = false;

fn tracing_sync() -> bool {
    if !SYNC_TRACE_READ {
        SYNC_TRACE_READ = true;
        SYNC_TRACE_ON = env::has_var("FACET_GTK_SYNC");
    }
    return SYNC_TRACE_ON;
}

#[link_name = "g_get_monotonic_time"]
extern fn g_get_monotonic_time() -> i64;

fn drain(user: *u8) -> i32 {
    PENDING = false;
    let t0: i64 = if tracing_sync() { { g_get_monotonic_time() } } else { 0 as i64 };
    mount::sync();
    // Layout is facet's, but PLACING the results is ours, and it has to happen
    // in the same turn as the sync or the frame the user sees is one write
    // behind.
    let t1: i64 = if tracing_sync() { { g_get_monotonic_time() } } else { 0 as i64 };
    window::relayout_all();
    let t2: i64 = if tracing_sync() { { g_get_monotonic_time() } } else { 0 as i64 };
    // The app menu's `is_enabled` and `title_of` are answered "when the menu
    // opens" in the ledger, and a GtkPopoverMenuBar gives no such moment — so
    // they are answered once per sync instead, which is more often than a menu
    // opens and costs one call per item.
    window::refresh_menu_state();
    if tracing_sync() {
        let t3: i64 = { g_get_monotonic_time() };
        io::eprintln("[sync] mount=${t1 -% t0}us relayout=${t2 -% t1}us menu=${t3 -% t2}us total=${t3 -% t0}us");
    }
    return 0 as i32;   // G_SOURCE_REMOVE
}

fn schedule(ctx: *u8) {
    if PENDING { return; }
    PENDING = true;
    let _t: u32 = { g_idle_add(drain, 0 as *u8) };
    return;
}

// ---- the Scheduler service ---------------------------------------------------

// The GTK main loop IS the main thread here, and facet only ever calls this
// from it, so "run on main" is "run now". A backend with a worker tier would
// hand this to `g_idle_add`; this one would only be adding a turn's latency to
// something already on the right thread.
fn run_on_main(f: fn(*u8), ctx: *u8) {
    f(ctx);
    return;
}

// ---- timers --------------------------------------------------------------------
//
// A one-shot timer. facet's unit is SECONDS and GLib's is milliseconds.
//
// MANY OUTSTANDING, not one. This held a single static pair until now, so a
// second `after` before the first fired replaced it — which is fine for the
// one-at-a-time uses facet itself has (a debounce, a settle) and silently
// wrong for an application that sets two. The table costs nothing when empty
// and the slot is what GLib carries as the callback's user data, so no
// allocation rides on the timer.

struct Timer { tag: u64, f: fn(*u8), ctx: usize, live: bool }

static TIMERS: vec::Vec[Timer] = #zero::[vec::Vec[Timer]]();

// A DEAD SLOT IS REUSED. An application that polls with `after` would
// otherwise grow the table without bound — the entries are tiny, but a table
// that only grows is a leak whatever the constant is.
fn timer_slot() -> usize {
    var i: usize = 0 as usize;
    let n: usize = TIMERS.count();
    while i < n {
        match TIMERS.at_ptr(i) {
            option::Option[*Timer]::Some(t) => { if !{ (*t).live } { return i; } }
            option::Option[*Timer]::None => { }
        }
        i = i +% (1 as usize);
    }
    let _e: status::Status = TIMERS.append(
        Timer { tag: 0 as u64, f: 0 as fn(*u8), ctx: 0 as usize, live: false });
    return n;
}

fn after_fire(user: *u8) -> i32 {
    // The slot is carried +1 so that it is never a null pointer.
    let slot: usize = { #addr(user) } -% (1 as usize);
    var f: fn(*u8) = 0 as fn(*u8);
    var c: *u8 = 0 as *u8;
    match TIMERS.at_ptr(slot) {
        option::Option[*Timer]::Some(t) => {
            if !{ (*t).live } { return 0 as i32; }
            f = { (*t).f };
            c = { (*t).ctx } as *u8;
            // DEAD BEFORE THE CALL, because the callback is entitled to
            // schedule another timer and would otherwise be handed back the
            // slot it is standing in — and because a `cancel_after` from
            // inside the callback must not try to remove a source GLib is
            // already tearing down.
            { (*t).live = false };
        }
        option::Option[*Timer]::None => { return 0 as i32; }
    }
    if f.is_not_null() { f(c); }
    // G_SOURCE_REMOVE: one shot.
    return 0 as i32;
}

fn after(seconds: f64, f: fn(*u8), ctx: *u8) -> u64 {
    let slot: usize = timer_slot();
    match TIMERS.at_ptr(slot) {
        option::Option[*Timer]::Some(t) => {
            { (*t).f = f };
            { (*t).ctx = { #addr(ctx) } };
            { (*t).live = true };
            { (*t).tag = 0 as u64 };
        }
        option::Option[*Timer]::None => { return 0 as u64; }
    }
    let ms: f64 = seconds * (1000.0 as f64);
    let id: u64 = { g_timeout_add(ms as u32, after_fire,
                                  (slot +% (1 as usize)) as *u8) } as u64;
    match TIMERS.at_ptr(slot) {
        option::Option[*Timer]::Some(t) => { { (*t).tag = id }; }
        option::Option[*Timer]::None => { }
    }
    return id;
}

fn cancel_after(tag: u64) {
    if tag == (0 as u64) { return; }
    var i: usize = 0 as usize;
    let n: usize = TIMERS.count();
    while i < n {
        match TIMERS.at_ptr(i) {
            option::Option[*Timer]::Some(t) => {
                if { (*t).tag } == tag {
                    // A tag that already FIRED is not a source any more, and
                    // asking GLib to remove one prints a critical. The live
                    // bit is the difference and it is why cancelling twice, or
                    // cancelling after the fact, is quiet.
                    if !{ (*t).live } { return; }
                    { (*t).live = false };
                    let _r: i32 = { g_source_remove(tag as u32) };
                    return;
                }
            }
            option::Option[*Timer]::None => { }
        }
        i = i +% (1 as usize);
    }
    return;
}

// For the suite: the table is a static nothing else can see, and "a dead slot
// is reused" is the property worth pinning.
fn timer_table_size() -> usize { return TIMERS.count(); }

// ---- size observers ------------------------------------------------------------
//
// The table lives in `observers`, a leaf, because the two ends of this verb sit
// on opposite sides of an import cycle: registration is a scheduler service,
// and the moment a size actually changes is inside `geometry`'s layout walk —
// and `scheduler` imports `window` imports `geometry`. A leaf both can reach is
// the seam.
fn observe_size(n: *core::Node, f: fn(*u8), ctx: *u8) -> u64 {
    return observers::observe_size(n, f, ctx);
}

fn cancel_observe_size(tag: u64) { observers::cancel_observe_size(tag); return; }

fn scheduler() -> services::Scheduler {
    return services::Scheduler {
        run_on_main: run_on_main,
        after: after,
        cancel_after: cancel_after,
        observe_size: observe_size,
        cancel_observe_size: cancel_observe_size,
    };
}
