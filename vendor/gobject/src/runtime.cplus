// Framework-agnostic GObject runtime: lifetime + type-cast primitives that every
// GObject-based binding (GTK, Adwaita, ...) builds on, so each one stops
// re-declaring `g_object_ref` / `g_type_*` inline. The GObject analog of the
// class/selector/ARC helpers in `vendor/objc/src/runtime.cplus` — minus the
// `objc_msgSend` shims, which GObject does not need (every method is its own
// C symbol).
//
// Ownership model. A GObject is reference-counted like an ObjC object, but with
// one extra state ObjC lacks: a *floating* reference. Freshly-constructed
// `GtkWidget`s (and any `GInitiallyUnowned`) start with a floating ref that the
// container "sinks" when you add the widget to it. So the +1/drop model is:
//   - a widget you hand to a container: let the container sink it; do nothing.
//   - a widget you keep yourself: `object_ref_sink` to claim ownership, and
//     `object_unref` when done.
//   - a plain GObject (non-floating): `object_ref` / `object_unref` as usual.

// --- GObject lifetime (libgobject-2.0) ---

#[link_name = "g_object_ref"]
extern fn g_object_ref(obj: *u8) -> *u8;

#[link_name = "g_object_unref"]
extern fn g_object_unref(obj: *u8);

#[link_name = "g_object_ref_sink"]
extern fn g_object_ref_sink(obj: *u8) -> *u8;

#[link_name = "g_object_is_floating"]
extern fn g_object_is_floating(obj: *u8) -> i32;

// Increment the reference count (+1). Returns the same handle for chaining.
fn object_ref(obj: *u8) -> *u8 {
    return { g_object_ref(obj) };
}

// Decrement the reference count; frees the object when it reaches zero.
fn object_unref(obj: *u8) {
    { g_object_unref(obj); }
    return;
}

// Claim ownership of a possibly-floating object: sinks the floating ref if
// present (turning it into a real +1 you own), otherwise takes a normal +1.
// This is the call to make when C+ keeps a widget rather than handing it to a
// container. Returns the same handle for chaining.
fn object_ref_sink(obj: *u8) -> *u8 {
    return { g_object_ref_sink(obj) };
}

// True while `obj` still carries an un-sunk floating reference (nobody owns it
// yet). A container `add`/`append` sinks it; after that this is false.
fn object_is_floating(obj: *u8) -> bool {
    return { g_object_is_floating(obj) } != (0 as i32);
}

// --- Per-instance user data (libgobject-2.0) ---
// Keyed opaque slots on any GObject — the standard place to stash a C+ pointer
// (an agent id, a callback context) so a signal handler can recover it later.

#[link_name = "g_object_set_data"]
extern fn g_object_set_data(obj: *u8, key: *u8, data: *u8);

#[link_name = "g_object_get_data"]
extern fn g_object_get_data(obj: *u8, key: *u8) -> *u8;

// Associate `data` with `obj` under NUL-terminated `key` (e.g. `#str_ptr("id\0")`).
fn set_data(obj: *u8, key: *u8, data: *u8) {
    { g_object_set_data(obj, key, data); }
    return;
}

// Retrieve data previously stored under `key` (null if unset).
fn get_data(obj: *u8, key: *u8) -> *u8 {
    return { g_object_get_data(obj, key) };
}

// --- GType identity & safe casting (libgobject-2.0) ---
// GObject's `GTK_BUTTON(w)`-style casts are C macros, not symbols. Upcasts are
// free (a GtkButton* IS a GtkWidget*/GObject*). A *downcast* must be checked:
// resolve the target GType by name and test membership before treating the
// handle as that type.

#[link_name = "g_type_from_name"]
extern fn g_type_from_name(name: *u8) -> usize;

#[link_name = "g_type_check_instance_is_a"]
extern fn g_type_check_instance_is_a(instance: *u8, iface_type: usize) -> i32;

#[link_name = "g_type_name_from_instance"]
extern fn g_type_name_from_instance(instance: *u8) -> *u8;

// Look up the registered GType id for a type name (`#str_ptr("GtkButton\0")`).
// Zero if the type is not registered (its module was never loaded).
fn type_from_name(name: *u8) -> usize {
    return { g_type_from_name(name) };
}

// True iff `instance` is (a subtype of) the named GObject type — the runtime
// half of a safe downcast. `type_name` is NUL-terminated (`#str_ptr("GtkLabel\0")`).
fn is_a(instance: *u8, type_name: *u8) -> bool {
    let gtype: usize = { g_type_from_name(type_name) };
    if gtype == (0 as usize) { return false; }
    return { g_type_check_instance_is_a(instance, gtype) } != (0 as i32);
}

// The runtime type name of an instance (borrowed `const gchar*`; do not free).
fn instance_type_name(instance: *u8) -> *u8 {
    return { g_type_name_from_instance(instance) };
}

// --- GLib allocator (libglib-2.0) ---
// GObject APIs that return owned strings/buffers (transfer-full) must be freed
// with `g_free`, NOT libc `free`. The bridge uses this for transfer-full copies.

#[link_name = "g_free"]
extern fn g_free(p: *u8);

// Free a block returned by a glib/GObject API (transfer-full result).
fn free(p: *u8) {
    { g_free(p); }
    return;
}

// ====================================================================
// Tests
//
// Against a REAL libgobject, on a real GObject — not a stand-in. Every
// assertion below is about what the C library actually does with a handle we
// created, because the failure mode this file guards against is an `extern fn`
// whose declared shape disagrees with the symbol's (a `GType` narrowed to 32
// bits, a `gboolean` read as a bool). A mock would agree with the declaration
// and prove nothing.
//
// The whole GTK stack rests on these: a wrong ref/unref pairing is a leak or a
// double-free, and a wrong `is_a` is an unchecked downcast.
// ====================================================================

// `gpointer g_object_new(GType, const gchar *first_property_name, ...)`.
// Variadic, and DECLARED variadic — a fixed-arity declaration passes the
// sentinel in the wrong place on some ABIs (see the note in stdlib/fs).
#[link_name = "g_object_new"]
extern fn g_object_new(gtype: usize, first_property: *u8, ...) -> *u8;

// G_TYPE_INITIALLY_UNOWNED is NOT a compile-time constant like G_TYPE_OBJECT
// (80) — it is whatever id the runtime registered, so it has to be asked for.
#[link_name = "g_initially_unowned_get_type"]
extern fn g_initially_unowned_get_type() -> usize;

// G_TYPE_OBJECT: fundamental 20, shifted left by G_TYPE_FUNDAMENTAL_SHIFT (2).
fn _g_type_object() -> usize { return 80 as usize; }

#[test]
fn a_plain_gobject_refs_and_unrefs() {
    let o: *u8 = { g_object_new(_g_type_object(), 0 as *u8) };
    assert o != { 0 as *u8 };
    // `object_ref` returns the SAME handle — the chaining contract. A binding
    // that returned a copy would break `let w = ref(make())` everywhere.
    assert object_ref(o) == o;
    object_unref(o);       // drop the +1 we just took
    object_unref(o);       // drop the construction ref; the object dies here
    return;
}

#[test]
fn a_plain_gobject_is_not_floating_but_an_initially_unowned_one_is() {
    // THE STATE OBJC DOES NOT HAVE, and the reason this module exists rather
    // than each binding calling g_object_ref inline. A fresh GtkWidget is a
    // GInitiallyUnowned: it carries a floating ref that a container sinks. Get
    // this backwards and you either leak every widget or free one the
    // container still owns.
    let plain: *u8 = { g_object_new(_g_type_object(), 0 as *u8) };
    assert !object_is_floating(plain);
    object_unref(plain);

    let floaty: *u8 = { g_object_new({ g_initially_unowned_get_type() }, 0 as *u8) };
    assert object_is_floating(floaty);
    // Sinking claims it: the floating ref becomes a real one that we now owe.
    assert object_ref_sink(floaty) == floaty;
    assert !object_is_floating(floaty);
    object_unref(floaty);
    return;
}

#[test]
fn type_from_name_resolves_registered_types_and_rejects_unknown_ones() {
    assert type_from_name(#str_ptr("GObject\0")) == _g_type_object();
    assert type_from_name(#str_ptr("GInitiallyUnowned\0"))
        == { g_initially_unowned_get_type() };
    // NEGATIVE: 0 for a name nothing registered — the documented "its module
    // was never loaded" answer, not a crash and not a garbage id. `is_a` leans
    // on this to fail closed.
    assert type_from_name(#str_ptr("NoSuchTypeExistsHere\0")) == (0 as usize);
    assert type_from_name(#str_ptr("\0")) == (0 as usize);
    return;
}

#[test]
fn is_a_accepts_the_type_and_its_parents_and_refuses_everything_else() {
    let u: *u8 = { g_object_new({ g_initially_unowned_get_type() }, 0 as *u8) };
    assert object_is_floating(u);
    assert is_a(u, #str_ptr("GInitiallyUnowned\0"));   // its own type
    assert is_a(u, #str_ptr("GObject\0"));             // and its parent
    // NEGATIVE: a real, registered, UNRELATED type must be refused — this is
    // the half that makes a downcast safe.
    assert !is_a(u, #str_ptr("GBinding\0"));
    // NEGATIVE: an unregistered name fails closed rather than passing because
    // the lookup returned 0.
    assert !is_a(u, #str_ptr("NoSuchTypeExistsHere\0"));
    object_ref_sink(u);
    object_unref(u);
    return;
}

#[test]
fn instance_type_name_reports_the_runtime_type() {
    let o: *u8 = { g_object_new(_g_type_object(), 0 as *u8) };
    let name: *u8 = instance_type_name(o);
    assert name != { 0 as *u8 };
    // Borrowed, per the contract — read it, do not free it.
    assert { #str_from_raw_parts(name, 7 as usize) } == "GObject";
    object_unref(o);
    return;
}

#[test]
fn user_data_round_trips_and_is_null_when_unset() {
    let o: *u8 = { g_object_new(_g_type_object(), 0 as *u8) };
    var payload: i64 = 0x5eed as i64;
    let p: *u8 = #addr_of(payload) as *u8;
    set_data(o, #str_ptr("cplus-test\0"), p);
    assert get_data(o, #str_ptr("cplus-test\0")) == p;
    // ...and it is the SAME memory, not a copy of the pointer's target.
    assert { *(get_data(o, #str_ptr("cplus-test\0")) as *i64) } == (0x5eed as i64);
    // NEGATIVE: an unset key is null. Signal handlers recover context this
    // way, so "never set" must be distinguishable rather than garbage.
    assert get_data(o, #str_ptr("never-set\0")) == { 0 as *u8 };
    object_unref(o);
    return;
}
