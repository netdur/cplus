// UIActivityViewController. iOS only.
//
// ---- an iPad crashes without an anchor --------------------------------------
//
// On iPhone the sheet slides up and needs nothing. On iPad it is a POPOVER,
// and UIKit throws `NSGenericException` — "your application has presented a
// UIPopoverPresentationController with a nil sourceView" — if nothing tells it
// where to point. That is a crash, not a layout glitch, and it is the single
// most common way this API is got wrong.
//
// So the anchor is always set: the presenting controller's own view, pointing
// at the middle of it. An app with a share BUTTON would rather anchor to the
// button, and cannot from here — the facade takes no view, because a
// `source_rect:` parameter would mean nothing on the other two platforms.
// Centre-of-screen is the price of one portable verb, and it is stated rather
// than discovered.

import "objc/runtime" as rt;
import "objc/bridge" as bridge;
import "./share" as sh;

// `objc/runtime` has no variant of this shape and facet_uikit declares its own
// for the same selector — `presentViewController:animated:completion:` is the
// only caller either of us has.
#[link_name = "objc_msgSend"]
extern fn _msg_present(recv: *u8, sel: *u8, a: *u8, b: i8, c: *u8);

fn _root_controller() -> *u8 {
    let app: *u8 = rt::msg_id(rt::get_class(#str_ptr("UIApplication\0")),
                              rt::sel(#str_ptr("sharedApplication\0")));
    if app.is_null() { return 0 as *u8; }
    let wins: *u8 = rt::msg_id(app, rt::sel(#str_ptr("windows\0")));
    if wins.is_null() { return 0 as *u8; }
    let n: i64 = rt::msg_i64(wins, rt::sel(#str_ptr("count\0")));
    var i: i64 = 0 as i64;
    while i < n {
        let w: *u8 = rt::msg_id_i64(wins, rt::sel(#str_ptr("objectAtIndex:\0")), i);
        if w.is_not_null() {
            // KEY WINDOW FIRST. A scene-based app can have several, and
            // presenting from a non-key one puts the sheet behind the visible
            // window with no error.
            if rt::msg_i8(w, rt::sel(#str_ptr("isKeyWindow\0"))) != (0 as i8) {
                let c: *u8 = rt::msg_id(w, rt::sel(#str_ptr("rootViewController\0")));
                if c.is_not_null() { return c; }
            }
        }
        i = i + (1 as i64);
    }
    // No key window yet — take the first that has a controller at all.
    i = 0 as i64;
    while i < n {
        let w: *u8 = rt::msg_id_i64(wins, rt::sel(#str_ptr("objectAtIndex:\0")), i);
        if w.is_not_null() {
            let c: *u8 = rt::msg_id(w, rt::sel(#str_ptr("rootViewController\0")));
            if c.is_not_null() { return c; }
        }
        i = i + (1 as i64);
    }
    return 0 as *u8;
}

fn _present(item: *u8) -> i32 {
    if item.is_null() { return 3; }
    let root: *u8 = _root_controller();
    if root.is_null() { return 1; }

    let items: *u8 = rt::msg_id_id(rt::get_class(#str_ptr("NSArray\0")),
                                   rt::sel(#str_ptr("arrayWithObject:\0")), item);
    if items.is_null() { return 3; }

    let cls: *u8 = rt::get_class(#str_ptr("UIActivityViewController\0"));
    if cls.is_null() { return 1; }
    let vc: *u8 = rt::msg_id_id_id(rt::msg_id(cls, rt::sel(#str_ptr("alloc\0"))),
        rt::sel(#str_ptr("initWithActivityItems:applicationActivities:\0")),
        items, 0 as *u8);
    if vc.is_null() { return 3; }

    // THE ANCHOR, and skipping it is a CRASH on iPad rather than a bad layout.
    let pop: *u8 = rt::msg_id(vc, rt::sel(#str_ptr("popoverPresentationController\0")));
    if pop.is_not_null() {
        let view: *u8 = rt::msg_id(root, rt::sel(#str_ptr("view\0")));
        if view.is_not_null() {
            rt::msg_void_id(pop, rt::sel(#str_ptr("setSourceView:\0")), view);
            let b: rt::Rect = rt::msg_rect(view, rt::sel(#str_ptr("bounds\0")));
            var mid: rt::Rect = rt::Rect {
                x: b.w / (2.0 as f64), y: b.h / (2.0 as f64),
                w: 0.0f64, h: 0.0f64,
            };
            rt::msg_void_rect(pop, rt::sel(#str_ptr("setSourceRect:\0")), mid);
            // 0 = UIPopoverArrowDirectionUnknown: no arrow rather than one
            // pointing at the middle of the screen for no reason.
            rt::msg_void_u64(pop, rt::sel(#str_ptr("setPermittedArrowDirections:\0")),
                             0 as u64);
        }
    }

    { _msg_present(root, rt::sel(#str_ptr("presentViewController:animated:completion:\0")),
                   vc, 1 as i8, 0 as *u8) };
    return 0;
}

export extern fn _c_available() -> i32 {
    if rt::get_class(#str_ptr("UIActivityViewController\0")).is_null() { return 0; }
    if _root_controller().is_null() { return 0; }
    return 1;
}

// SUBJECT RIDES ALONG on iOS: `UIActivityViewController` reads it from the
// item's `activityViewController:subjectForActivityType:`, which needs a
// delegate object. Rather than synthesise one for a field Mail alone reads,
// the body is shared and the subject dropped — the same call this backend's
// macOS sibling makes, for the same reason.
export extern fn _c_text(body: *u8, body_len: usize,
                         subject: *u8, subject_len: usize) -> i32 {
    return _present(bridge::nsstring({ #str_from_raw_parts(body, body_len) }));
}

export extern fn _c_url(link: *u8, link_len: usize) -> i32 {
    let s: *u8 = bridge::nsstring({ #str_from_raw_parts(link, link_len) });
    if s.is_null() { return 3; }
    let u: *u8 = rt::msg_id_id(rt::get_class(#str_ptr("NSURL\0")),
                               rt::sel(#str_ptr("URLWithString:\0")), s);
    if u.is_null() { return 2; }
    return _present(u);
}

export extern fn _c_file(path: *u8, path_len: usize) -> i32 {
    let s: *u8 = bridge::nsstring({ #str_from_raw_parts(path, path_len) });
    if s.is_null() { return 3; }
    let u: *u8 = rt::msg_id_id(rt::get_class(#str_ptr("NSURL\0")),
                               rt::sel(#str_ptr("fileURLWithPath:\0")), s);
    if u.is_null() { return 2; }
    return _present(u);
}
