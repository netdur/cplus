// jni-min: Core JNI interop types for C+
// Maps the JVM's jni.h to C+ types using #[repr(C)] and TypeKind::FnPtr.
//
// Naming-guideline notes (naming_guideline.md):
//   - `JValue` hides its raw argument word behind `_bits`; build a value with
//     a role-named constructor that takes its content — `JValue::of_object(o)`,
//     `of_int(n)`, `of_bool(b)`, `of_long(n)` — and read the raw word back with
//     `bits()`. The package-level `arg_object` / `arg_int` / `arg_bool` /
//     `arg_long` functions remain as thin shims: they are the cross-package
//     surface the `android_view` package already calls by name, so they are
//     kept for source compatibility.
//   - DEFERRED (deliberately): the fn-pointer fields of `JNINativeInterface`
//     and `JNIInvokeInterface` keep their exact `jni.h` C names (`FindClass`,
//     `GetVersion`, `NewObjectA`, ...). These two structs are a byte-for-byte
//     layout mirror of the JVM's interface tables, accessed by both position
//     and field name from `android_view`; renaming them would break that
//     documented "must exactly match jni.h" contract and the consumers. They
//     are a thin C-ABI mirror, not an imperative API surface to re-skin.

type jint = i32;
type jlong = i64;
type jbyte = i8;
type jboolean = u8;
type jchar = u16;
type jshort = i16;
type jfloat = f32;
type jdouble = f64;
type jsize = i32;

// Opaque pointers to Java objects/classes
type jobject = *u8;
type jclass = *u8;
type jstring = *u8;
type jarray = *u8;
type jobjectArray = *u8;
type jbooleanArray = *u8;
type jbyteArray = *u8;
type jcharArray = *u8;
type jshortArray = *u8;
type jintArray = *u8;
type jlongArray = *u8;
type jfloatArray = *u8;
type jdoubleArray = *u8;
type jthrowable = *u8;
type jweak = *u8;

type jfieldID = *u8;
type jmethodID = *u8;

// In C, `JNIEnv` is `const JNINativeInterface*` and native methods receive
// `JNIEnv *env` — a pointer to the thread-local table pointer. JNI functions
// must be called with that double pointer (ART derives the thread state from
// it); passing the bare table pointer trips an ART CHECK and aborts.
type JNIEnv = *JNINativeInterface;
type JavaVM = *JNIInvokeInterface;

// JNI's `jvalue` is a C union. C+ does not expose C unions yet, so this
// binding models each argument slot as the union's ABI size: one 8-byte word.
//
// Float and double are carried too, and they need a REINTERPRET rather than a
// conversion: `1.0f32 as jlong` is the integer 1, but the JVM reads the slot's
// raw bits as an IEEE float. C+ has no bitcast intrinsic, so the constructors
// punt through a pointer. Without these, `setTextSize`, `setAlpha`,
// `setTranslationX` and `setElevation` are unreachable from C+ — which is
// exactly where the first Android probe stopped.
//
// The raw 8-byte word is hidden behind `_bits`; construct a `JValue` through a
// role-named constructor that takes its content, and read the word back with
// `bits()`.
#[repr(C)]
struct JValue {
    _bits: jlong,
}

impl JValue {
    // A `jvalue` carrying an object reference. The reference's address is
    // stored as the argument word; a null `jobject` becomes a zero word.
    fn of_object(obj: jobject) -> JValue {
        return JValue { _bits: { #addr(obj) as jlong } };
    }

    // A `jvalue` carrying a 32-bit Java `int`, sign-extended into the word.
    fn of_int(value: jint) -> JValue {
        return JValue { _bits: value as jlong };
    }

    // A `jvalue` carrying a Java `boolean` (0 or 1) in the low byte.
    fn of_bool(value: jboolean) -> JValue {
        return JValue { _bits: value as jlong };
    }

    // A `jvalue` carrying a 64-bit Java `long` directly as the word.
    fn of_long(value: jlong) -> JValue {
        return JValue { _bits: value };
    }

    // A `jvalue` carrying a Java `float`. The JVM reads the low four bytes of
    // the slot as IEEE-754, so the bits are REINTERPRETED, not converted, and
    // the high word is left zero rather than sign-extended — it is padding the
    // callee does not read, and a negative float would otherwise fill it with
    // ones for no reason.
    fn of_float(value: jfloat) -> JValue {
        var v: jfloat = value;
        let p: *u32 = { #addr_of(v) as *u32 };
        let raw: u32 = { *p };
        return JValue { _bits: { (raw as u64) as jlong } };
    }

    // A `jvalue` carrying a Java `double`: all eight bytes, reinterpreted.
    fn of_double(value: jdouble) -> JValue {
        var v: jdouble = value;
        let p: *jlong = { #addr_of(v) as *jlong };
        return JValue { _bits: { *p } };
    }

    // The raw 8-byte argument word as the JVM ABI sees it.
    fn bits(this) -> jlong {
        return this._bits;
    }
}

// Cross-package shims: `android_view` calls these by name. Each forwards to the
// matching `JValue::of_*` constructor.
fn arg_object(obj: jobject) -> JValue {
    return JValue::of_object(obj);
}

fn arg_int(v: jint) -> JValue {
    return JValue::of_int(v);
}

fn arg_bool(v: jboolean) -> JValue {
    return JValue::of_bool(v);
}

fn arg_long(v: jlong) -> JValue {
    return JValue::of_long(v);
}

fn arg_float(v: jfloat) -> JValue {
    return JValue::of_float(v);
}

fn arg_double(v: jdouble) -> JValue {
    return JValue::of_double(v);
}

// The core JNI environment struct.
// Note: This struct must exactly match the memory layout of JNINativeInterface_ in jni.h.
// Since we only *read* from the JVM-provided pointer, we only need to define 
// the fields up to the methods we actually intend to call.
#[repr(C)]
struct JNINativeInterface {
    opaque reserved0: *u8,
    opaque reserved1: *u8,
    opaque reserved2: *u8,
    opaque reserved3: *u8,
    GetVersion: fn(*JNIEnv) -> jint,
    DefineClass: fn(*JNIEnv, *u8, jobject, *u8, jsize) -> jclass,
    FindClass: fn(*JNIEnv, *u8) -> jclass,
    FromReflectedMethod: fn(*JNIEnv, jobject) -> jmethodID,
    FromReflectedField: fn(*JNIEnv, jobject) -> jfieldID,
    ToReflectedMethod: fn(*JNIEnv, jclass, jmethodID, jboolean) -> jobject,
    GetSuperclass: fn(*JNIEnv, jclass) -> jclass,
    IsAssignableFrom: fn(*JNIEnv, jclass, jclass) -> jboolean,
    ToReflectedField: fn(*JNIEnv, jclass, jfieldID, jboolean) -> jobject,
    Throw: fn(*JNIEnv, jthrowable) -> jint,
    ThrowNew: fn(*JNIEnv, jclass, *u8) -> jint,
    ExceptionOccurred: fn(*JNIEnv) -> jthrowable,
    ExceptionDescribe: fn(*JNIEnv),
    ExceptionClear: fn(*JNIEnv),
    FatalError: fn(*JNIEnv, *u8),
    PushLocalFrame: fn(*JNIEnv, jint) -> jint,
    PopLocalFrame: fn(*JNIEnv, jobject) -> jobject,
    NewGlobalRef: fn(*JNIEnv, jobject) -> jobject,
    DeleteGlobalRef: fn(*JNIEnv, jobject),
    DeleteLocalRef: fn(*JNIEnv, jobject),
    IsSameObject: fn(*JNIEnv, jobject, jobject) -> jboolean,
    NewLocalRef: fn(*JNIEnv, jobject) -> jobject,
    EnsureLocalCapacity: fn(*JNIEnv, jint) -> jint,
    AllocObject: fn(*JNIEnv, jclass) -> jobject,
    NewObject: fn(*JNIEnv, jclass, jmethodID) -> jobject, // varargs conceptually
    NewObjectV: fn(*JNIEnv, jclass, jmethodID, *u8) -> jobject,
    NewObjectA: fn(*JNIEnv, jclass, jmethodID, *JValue) -> jobject,
    GetObjectClass: fn(*JNIEnv, jobject) -> jclass,
    IsInstanceOf: fn(*JNIEnv, jobject, jclass) -> jboolean,
    GetMethodID: fn(*JNIEnv, jclass, *u8, *u8) -> jmethodID,
    CallObjectMethod: fn(*JNIEnv, jobject, jmethodID) -> jobject,
    CallObjectMethodV: fn(*JNIEnv, jobject, jmethodID, *u8) -> jobject,
    CallObjectMethodA: fn(*JNIEnv, jobject, jmethodID, *JValue) -> jobject,
    CallBooleanMethod: fn(*JNIEnv, jobject, jmethodID) -> jboolean,
    CallBooleanMethodV: fn(*JNIEnv, jobject, jmethodID, *u8) -> jboolean,
    CallBooleanMethodA: fn(*JNIEnv, jobject, jmethodID, *JValue) -> jboolean,
    CallByteMethod: fn(*JNIEnv, jobject, jmethodID) -> jbyte,
    CallByteMethodV: fn(*JNIEnv, jobject, jmethodID, *u8) -> jbyte,
    CallByteMethodA: fn(*JNIEnv, jobject, jmethodID, *JValue) -> jbyte,
    CallCharMethod: fn(*JNIEnv, jobject, jmethodID) -> jchar,
    CallCharMethodV: fn(*JNIEnv, jobject, jmethodID, *u8) -> jchar,
    CallCharMethodA: fn(*JNIEnv, jobject, jmethodID, *JValue) -> jchar,
    CallShortMethod: fn(*JNIEnv, jobject, jmethodID) -> jshort,
    CallShortMethodV: fn(*JNIEnv, jobject, jmethodID, *u8) -> jshort,
    CallShortMethodA: fn(*JNIEnv, jobject, jmethodID, *JValue) -> jshort,
    CallIntMethod: fn(*JNIEnv, jobject, jmethodID) -> jint,
    CallIntMethodV: fn(*JNIEnv, jobject, jmethodID, *u8) -> jint,
    CallIntMethodA: fn(*JNIEnv, jobject, jmethodID, *JValue) -> jint,
    CallLongMethod: fn(*JNIEnv, jobject, jmethodID) -> jlong,
    CallLongMethodV: fn(*JNIEnv, jobject, jmethodID, *u8) -> jlong,
    CallLongMethodA: fn(*JNIEnv, jobject, jmethodID, *JValue) -> jlong,
    CallFloatMethod: fn(*JNIEnv, jobject, jmethodID) -> jfloat,
    CallFloatMethodV: fn(*JNIEnv, jobject, jmethodID, *u8) -> jfloat,
    CallFloatMethodA: fn(*JNIEnv, jobject, jmethodID, *JValue) -> jfloat,
    CallDoubleMethod: fn(*JNIEnv, jobject, jmethodID) -> jdouble,
    CallDoubleMethodV: fn(*JNIEnv, jobject, jmethodID, *u8) -> jdouble,
    CallDoubleMethodA: fn(*JNIEnv, jobject, jmethodID, *JValue) -> jdouble,
    CallVoidMethod: fn(*JNIEnv, jobject, jmethodID),
    CallVoidMethodV: fn(*JNIEnv, jobject, jmethodID, *u8),
    CallVoidMethodA: fn(*JNIEnv, jobject, jmethodID, *JValue),
    opaque reserved_call_nonvirtual_object_method: *u8,
    opaque reserved_call_nonvirtual_object_method_v: *u8,
    opaque reserved_call_nonvirtual_object_method_a: *u8,
    opaque reserved_call_nonvirtual_boolean_method: *u8,
    opaque reserved_call_nonvirtual_boolean_method_v: *u8,
    opaque reserved_call_nonvirtual_boolean_method_a: *u8,
    opaque reserved_call_nonvirtual_byte_method: *u8,
    opaque reserved_call_nonvirtual_byte_method_v: *u8,
    opaque reserved_call_nonvirtual_byte_method_a: *u8,
    opaque reserved_call_nonvirtual_char_method: *u8,
    opaque reserved_call_nonvirtual_char_method_v: *u8,
    opaque reserved_call_nonvirtual_char_method_a: *u8,
    opaque reserved_call_nonvirtual_short_method: *u8,
    opaque reserved_call_nonvirtual_short_method_v: *u8,
    opaque reserved_call_nonvirtual_short_method_a: *u8,
    opaque reserved_call_nonvirtual_int_method: *u8,
    opaque reserved_call_nonvirtual_int_method_v: *u8,
    opaque reserved_call_nonvirtual_int_method_a: *u8,
    opaque reserved_call_nonvirtual_long_method: *u8,
    opaque reserved_call_nonvirtual_long_method_v: *u8,
    opaque reserved_call_nonvirtual_long_method_a: *u8,
    opaque reserved_call_nonvirtual_float_method: *u8,
    opaque reserved_call_nonvirtual_float_method_v: *u8,
    opaque reserved_call_nonvirtual_float_method_a: *u8,
    opaque reserved_call_nonvirtual_double_method: *u8,
    opaque reserved_call_nonvirtual_double_method_v: *u8,
    opaque reserved_call_nonvirtual_double_method_a: *u8,
    opaque reserved_call_nonvirtual_void_method: *u8,
    opaque reserved_call_nonvirtual_void_method_v: *u8,
    opaque reserved_call_nonvirtual_void_method_a: *u8,
    // 94-112: instance fields. `DisplayMetrics.density` is an instance
    // FIELD, which is how a backend reads dp without the sp trick.
    GetFieldID: fn(*JNIEnv, jclass, *u8, *u8) -> jfieldID,
    GetObjectField: fn(*JNIEnv, jobject, jfieldID) -> jobject,
    GetBooleanField: fn(*JNIEnv, jobject, jfieldID) -> jboolean,
    GetByteField: fn(*JNIEnv, jobject, jfieldID) -> jbyte,
    GetCharField: fn(*JNIEnv, jobject, jfieldID) -> jchar,
    GetShortField: fn(*JNIEnv, jobject, jfieldID) -> jshort,
    GetIntField: fn(*JNIEnv, jobject, jfieldID) -> jint,
    GetLongField: fn(*JNIEnv, jobject, jfieldID) -> jlong,
    GetFloatField: fn(*JNIEnv, jobject, jfieldID) -> jfloat,
    GetDoubleField: fn(*JNIEnv, jobject, jfieldID) -> jdouble,
    SetObjectField: fn(*JNIEnv, jobject, jfieldID, jobject),
    SetBooleanField: fn(*JNIEnv, jobject, jfieldID, jboolean),
    SetByteField: fn(*JNIEnv, jobject, jfieldID, jbyte),
    SetCharField: fn(*JNIEnv, jobject, jfieldID, jchar),
    SetShortField: fn(*JNIEnv, jobject, jfieldID, jshort),
    SetIntField: fn(*JNIEnv, jobject, jfieldID, jint),
    SetLongField: fn(*JNIEnv, jobject, jfieldID, jlong),
    SetFloatField: fn(*JNIEnv, jobject, jfieldID, jfloat),
    SetDoubleField: fn(*JNIEnv, jobject, jfieldID, jdouble),
    // 113-143: the static call surface. `Choreographer.getInstance`,
    // `TypedValue.applyDimension`, `Color.argb` and most of
    // android.graphics are static; leaving these reserved is what made
    // the first Android probe build its MeasureSpec constants by hand.
    GetStaticMethodID: fn(*JNIEnv, jclass, *u8, *u8) -> jmethodID,
    CallStaticObjectMethod: fn(*JNIEnv, jclass, jmethodID) -> jobject,
    CallStaticObjectMethodV: fn(*JNIEnv, jclass, jmethodID, *u8) -> jobject,
    CallStaticObjectMethodA: fn(*JNIEnv, jclass, jmethodID, *JValue) -> jobject,
    CallStaticBooleanMethod: fn(*JNIEnv, jclass, jmethodID) -> jboolean,
    CallStaticBooleanMethodV: fn(*JNIEnv, jclass, jmethodID, *u8) -> jboolean,
    CallStaticBooleanMethodA: fn(*JNIEnv, jclass, jmethodID, *JValue) -> jboolean,
    CallStaticByteMethod: fn(*JNIEnv, jclass, jmethodID) -> jbyte,
    CallStaticByteMethodV: fn(*JNIEnv, jclass, jmethodID, *u8) -> jbyte,
    CallStaticByteMethodA: fn(*JNIEnv, jclass, jmethodID, *JValue) -> jbyte,
    CallStaticCharMethod: fn(*JNIEnv, jclass, jmethodID) -> jchar,
    CallStaticCharMethodV: fn(*JNIEnv, jclass, jmethodID, *u8) -> jchar,
    CallStaticCharMethodA: fn(*JNIEnv, jclass, jmethodID, *JValue) -> jchar,
    CallStaticShortMethod: fn(*JNIEnv, jclass, jmethodID) -> jshort,
    CallStaticShortMethodV: fn(*JNIEnv, jclass, jmethodID, *u8) -> jshort,
    CallStaticShortMethodA: fn(*JNIEnv, jclass, jmethodID, *JValue) -> jshort,
    CallStaticIntMethod: fn(*JNIEnv, jclass, jmethodID) -> jint,
    CallStaticIntMethodV: fn(*JNIEnv, jclass, jmethodID, *u8) -> jint,
    CallStaticIntMethodA: fn(*JNIEnv, jclass, jmethodID, *JValue) -> jint,
    CallStaticLongMethod: fn(*JNIEnv, jclass, jmethodID) -> jlong,
    CallStaticLongMethodV: fn(*JNIEnv, jclass, jmethodID, *u8) -> jlong,
    CallStaticLongMethodA: fn(*JNIEnv, jclass, jmethodID, *JValue) -> jlong,
    CallStaticFloatMethod: fn(*JNIEnv, jclass, jmethodID) -> jfloat,
    CallStaticFloatMethodV: fn(*JNIEnv, jclass, jmethodID, *u8) -> jfloat,
    CallStaticFloatMethodA: fn(*JNIEnv, jclass, jmethodID, *JValue) -> jfloat,
    CallStaticDoubleMethod: fn(*JNIEnv, jclass, jmethodID) -> jdouble,
    CallStaticDoubleMethodV: fn(*JNIEnv, jclass, jmethodID, *u8) -> jdouble,
    CallStaticDoubleMethodA: fn(*JNIEnv, jclass, jmethodID, *JValue) -> jdouble,
    CallStaticVoidMethod: fn(*JNIEnv, jclass, jmethodID),
    CallStaticVoidMethodV: fn(*JNIEnv, jclass, jmethodID, *u8),
    CallStaticVoidMethodA: fn(*JNIEnv, jclass, jmethodID, *JValue),
    // 144-162: static fields.
    GetStaticFieldID: fn(*JNIEnv, jclass, *u8, *u8) -> jfieldID,
    GetStaticObjectField: fn(*JNIEnv, jclass, jfieldID) -> jobject,
    GetStaticBooleanField: fn(*JNIEnv, jclass, jfieldID) -> jboolean,
    GetStaticByteField: fn(*JNIEnv, jclass, jfieldID) -> jbyte,
    GetStaticCharField: fn(*JNIEnv, jclass, jfieldID) -> jchar,
    GetStaticShortField: fn(*JNIEnv, jclass, jfieldID) -> jshort,
    GetStaticIntField: fn(*JNIEnv, jclass, jfieldID) -> jint,
    GetStaticLongField: fn(*JNIEnv, jclass, jfieldID) -> jlong,
    GetStaticFloatField: fn(*JNIEnv, jclass, jfieldID) -> jfloat,
    GetStaticDoubleField: fn(*JNIEnv, jclass, jfieldID) -> jdouble,
    SetStaticObjectField: fn(*JNIEnv, jclass, jfieldID, jobject),
    SetStaticBooleanField: fn(*JNIEnv, jclass, jfieldID, jboolean),
    SetStaticByteField: fn(*JNIEnv, jclass, jfieldID, jbyte),
    SetStaticCharField: fn(*JNIEnv, jclass, jfieldID, jchar),
    SetStaticShortField: fn(*JNIEnv, jclass, jfieldID, jshort),
    SetStaticIntField: fn(*JNIEnv, jclass, jfieldID, jint),
    SetStaticLongField: fn(*JNIEnv, jclass, jfieldID, jlong),
    SetStaticFloatField: fn(*JNIEnv, jclass, jfieldID, jfloat),
    SetStaticDoubleField: fn(*JNIEnv, jclass, jfieldID, jdouble),
    opaque reserved_new_string: *u8,
    opaque reserved_get_string_length: *u8,
    opaque reserved_get_string_chars: *u8,
    opaque reserved_release_string_chars: *u8,
    NewStringUTF: fn(*JNIEnv, *u8) -> jstring,
    GetStringUTFLength: fn(*JNIEnv, jstring) -> jsize,
    GetStringUTFChars: fn(*JNIEnv, jstring, *jboolean) -> *u8,
    ReleaseStringUTFChars: fn(*JNIEnv, jstring, *u8),
    // Object arrays (slots 171-174 in jni.h).
    GetArrayLength: fn(*JNIEnv, jarray) -> jsize,
    NewObjectArray: fn(*JNIEnv, jsize, jclass, jobject) -> jobjectArray,
    GetObjectArrayElement: fn(*JNIEnv, jobjectArray, jsize) -> jobject,
    SetObjectArrayElement: fn(*JNIEnv, jobjectArray, jsize, jobject),
    // Primitive arrays (175-214): 8 New<P>Array, 8 Get<P>ArrayElements,
    // 8 Release<P>ArrayElements, 8 Get<P>ArrayRegion, 8 Set<P>ArrayRegion.
    opaque reserved_new_prim_array_0: *u8,
    opaque reserved_new_prim_array_1: *u8,
    opaque reserved_new_prim_array_2: *u8,
    opaque reserved_new_prim_array_3: *u8,
    opaque reserved_new_prim_array_4: *u8,
    opaque reserved_new_prim_array_5: *u8,
    opaque reserved_new_prim_array_6: *u8,
    opaque reserved_new_prim_array_7: *u8,
    opaque reserved_get_prim_elems_0: *u8,
    opaque reserved_get_prim_elems_1: *u8,
    opaque reserved_get_prim_elems_2: *u8,
    opaque reserved_get_prim_elems_3: *u8,
    opaque reserved_get_prim_elems_4: *u8,
    opaque reserved_get_prim_elems_5: *u8,
    opaque reserved_get_prim_elems_6: *u8,
    opaque reserved_get_prim_elems_7: *u8,
    opaque reserved_release_prim_elems_0: *u8,
    opaque reserved_release_prim_elems_1: *u8,
    opaque reserved_release_prim_elems_2: *u8,
    opaque reserved_release_prim_elems_3: *u8,
    opaque reserved_release_prim_elems_4: *u8,
    opaque reserved_release_prim_elems_5: *u8,
    opaque reserved_release_prim_elems_6: *u8,
    opaque reserved_release_prim_elems_7: *u8,
    opaque reserved_get_prim_region_0: *u8,
    opaque reserved_get_prim_region_1: *u8,
    opaque reserved_get_prim_region_2: *u8,
    opaque reserved_get_prim_region_3: *u8,
    opaque reserved_get_prim_region_4: *u8,
    opaque reserved_get_prim_region_5: *u8,
    opaque reserved_get_prim_region_6: *u8,
    opaque reserved_get_prim_region_7: *u8,
    opaque reserved_set_prim_region_0: *u8,
    opaque reserved_set_prim_region_1: *u8,
    opaque reserved_set_prim_region_2: *u8,
    opaque reserved_set_prim_region_3: *u8,
    opaque reserved_set_prim_region_4: *u8,
    opaque reserved_set_prim_region_5: *u8,
    opaque reserved_set_prim_region_6: *u8,
    opaque reserved_set_prim_region_7: *u8,
    // 215: explicit native-method binding. `methods` is a pointer to
    // `count` packed records { name, signature, fnPtr } — callers define
    // the record with a concretely-typed fn field (see
    // android_view/listener). Required for classes from
    // InMemoryDexClassLoader: ART resolves `native` methods by symbol
    // only through a classloader's own native-lib namespace, which an
    // in-memory loader does not have.
    RegisterNatives: fn(*JNIEnv, jclass, *u8, jint) -> jint,
    opaque reserved_unregister_natives: *u8,
    opaque reserved_monitor_enter: *u8,
    opaque reserved_monitor_exit: *u8,
    opaque reserved_get_java_vm: *u8,
    opaque reserved_get_string_region: *u8,
    opaque reserved_get_string_utf_region: *u8,
    opaque reserved_get_prim_critical: *u8,
    opaque reserved_release_prim_critical: *u8,
    opaque reserved_get_string_critical: *u8,
    opaque reserved_release_string_critical: *u8,
    opaque reserved_new_weak_global_ref: *u8,
    opaque reserved_delete_weak_global_ref: *u8,
    // 228: pending-exception predicate (cheaper than ExceptionOccurred —
    // no local ref).
    ExceptionCheck: fn(*JNIEnv) -> jboolean,
    // 229: wrap native memory as a java.nio.ByteBuffer. The memory must
    // outlive the buffer; `#include_bytes` blobs (static lifetime) qualify.
    NewDirectByteBuffer: fn(*JNIEnv, *u8, jlong) -> jobject,
    opaque reserved_get_direct_buffer_address: *u8,
    opaque reserved_get_direct_buffer_capacity: *u8,
    opaque reserved_get_object_ref_type: *u8,
}

#[repr(C)]
struct JNIInvokeInterface {
    opaque reserved0: *u8,
    opaque reserved1: *u8,
    opaque reserved2: *u8,
    DestroyJavaVM: fn(*JavaVM) -> jint,
    AttachCurrentThread: fn(*JavaVM, *u8, *u8) -> jint,
    DetachCurrentThread: fn(*JavaVM) -> jint,
    GetEnv: fn(*JavaVM, *u8, jint) -> jint,
    AttachCurrentThreadAsDaemon: fn(*JavaVM, *u8, *u8) -> jint,
}

// Layout sanity: the binding's correctness rests entirely on every function
// pointer sitting at its `jni.h` offset, so pin the total size. A dropped,
// added, or mistyped field shifts every later offset and changes the size.
// 64-bit: the full JNI 1.6 table is 233 slots (GetVersion at index 4
// through GetObjectRefType at 232, verified against the NDK r29 jni.h),
// 233 * 8 = 1864. JNIInvokeInterface = 3 reserved + 5 fn-ptrs = 64.
#[test]
fn jni_interface_layout_sizes() {
    assert #size_of::[JNINativeInterface]() == (1864 as usize);
    assert #size_of::[JNIInvokeInterface]() == (64 as usize);
    assert #align_of::[JNINativeInterface]() == (8 as usize);
}

// The size test above pins the field COUNT; it cannot see a field that moved.
// This one checks placement BY NAME: build a synthetic table whose word `i`
// holds `i`, then read named fields back and assert each answers its own index
// in the NDK's jni.h. Any field inserted, dropped or reordered shifts every
// later slot and fails here with the name of the first one that moved.
//
// The expected indices are ground truth from
// `offsetof(struct JNINativeInterface, f) / sizeof(void*)` against NDK r29's
// jni.h, not from reading this file.
#[test]
fn table_fields_sit_at_their_jni_h_indices() {
    var words: [usize; 233] = #zero::[[usize; 233]]();
    var i: usize = 0 as usize;
    while i < (233 as usize) {
        words[i] = i;
        i = i +% (1 as usize);
    }
    let t: *JNINativeInterface = { #addr_of(words[0]) as *JNINativeInterface };

    // The slots that existed before the static/field blocks were filled — if
    // these move, the fill went in at the wrong place.
    assert { (*t).GetVersion as usize } == (4 as usize);
    assert { (*t).GetMethodID as usize } == (33 as usize);
    assert { (*t).CallVoidMethodA as usize } == (63 as usize);
    assert { (*t).NewStringUTF as usize } == (167 as usize);
    assert { (*t).RegisterNatives as usize } == (215 as usize);
    assert { (*t).ExceptionCheck as usize } == (228 as usize);

    // The instance calls filled for float/double reads (getAlpha, getX).
    assert { (*t).CallCharMethodA as usize } == (45 as usize);
    assert { (*t).CallFloatMethodA as usize } == (57 as usize);
    assert { (*t).CallDoubleMethodA as usize } == (60 as usize);

    // The instance field block: DisplayMetrics.density is a FIELD read.
    assert { (*t).GetFieldID as usize } == (94 as usize);
    assert { (*t).GetIntField as usize } == (100 as usize);
    assert { (*t).GetFloatField as usize } == (102 as usize);
    assert { (*t).SetDoubleField as usize } == (112 as usize);

    // The static call block: Choreographer.getInstance, Color.argb.
    assert { (*t).GetStaticMethodID as usize } == (113 as usize);
    assert { (*t).CallStaticObjectMethodA as usize } == (116 as usize);
    assert { (*t).CallStaticIntMethodA as usize } == (131 as usize);
    assert { (*t).CallStaticVoidMethodA as usize } == (143 as usize);

    // The static field block.
    assert { (*t).GetStaticFieldID as usize } == (144 as usize);
    assert { (*t).SetStaticDoubleField as usize } == (162 as usize);
    return;
}

// ---------------- JValue constructor / accessor tests ----------------

// `JValue` is a one-word `#[repr(C)]` mirror of `jvalue`; pin its size so a
// future field can't silently widen the argument slot.
#[test]
fn jvalue_is_one_word() {
    assert #size_of::[JValue]() == (8 as usize);
    assert #align_of::[JValue]() == (8 as usize);
}

#[test]
fn jvalue_of_int_round_trips() {
    let v: JValue = JValue::of_int(12345 as jint);
    assert v.bits() == (12345 as jlong);
}

#[test]
fn jvalue_of_int_sign_extends_negative() {
    // A negative 32-bit int must sign-extend into the 64-bit word, not appear
    // as a large positive value.
    let neg_one: jint = (0 as jint) -% (1 as jint);   // -1
    let v: JValue = JValue::of_int(neg_one);
    let expected: jlong = (0 as jlong) -% (1 as jlong);
    assert v.bits() == expected;
}

#[test]
fn jvalue_of_bool_true_and_false() {
    let t: JValue = JValue::of_bool(1 as jboolean);
    assert t.bits() == (1 as jlong);
    // Negative case: false carries a zero word, not a sentinel.
    let f: JValue = JValue::of_bool(0 as jboolean);
    assert f.bits() == (0 as jlong);
}

#[test]
fn jvalue_of_long_round_trips() {
    // A value that needs the full 64 bits — would be truncated by `of_int`.
    let big: jlong = 4294967297 as jlong;   // 2^32 + 1
    let v: JValue = JValue::of_long(big);
    assert v.bits() == big;
}

#[test]
fn jvalue_of_object_null_is_zero_word() {
    // Negative case: a null object reference must encode as a zero word so the
    // JVM sees a Java `null`, not a stray address.
    let v: JValue = JValue::of_object({ 0 as jobject });
    assert v.bits() == (0 as jlong);
}

#[test]
fn jvalue_of_object_carries_address() {
    var sentinel: jint = 7 as jint;
    let p: jobject = { #addr_of(sentinel) as jobject };
    let v: JValue = JValue::of_object(p);
    assert v.bits() == ({ #addr(p) } as jlong);
    assert v.bits() != (0 as jlong);
}

// A float is REINTERPRETED, never converted. This is the whole reason
// `of_float` exists: `1.0f32 as jlong` is the integer 1, and the JVM would read
// the slot as a denormal near zero. 1.0f is 0x3F800000.
#[test]
fn jvalue_of_float_reinterprets_rather_than_converts() {
    let v: JValue = JValue::of_float(1.0f32);
    assert v.bits() == (1065353216 as jlong);      // 0x3F800000
    assert v.bits() != (1 as jlong);               // the conversion bug
    return;
}

// Negative case: the high word is PADDING and must stay zero. A sign-extending
// cast of a negative float's bit pattern would fill it with ones.
#[test]
fn jvalue_of_float_leaves_the_high_word_zero() {
    let v: JValue = JValue::of_float(-1.0f32);   // -1.0f = 0xBF800000
    assert v.bits() == (3212836864 as jlong);             // zero-extended
    assert v.bits() > (0 as jlong);
    return;
}

#[test]
fn jvalue_of_float_zero_is_a_zero_word() {
    assert JValue::of_float(0.0f32).bits() == (0 as jlong);
    return;
}

// A double is all eight bytes. 1.0 is 0x3FF0000000000000.
#[test]
fn jvalue_of_double_reinterprets_the_whole_word() {
    let v: JValue = JValue::of_double(1.0f64);
    assert v.bits() == (4607182418800017408 as jlong);
    assert v.bits() != (1 as jlong);
    return;
}

#[test]
fn jvalue_of_double_zero_is_a_zero_word() {
    assert JValue::of_double(0.0f64).bits() == (0 as jlong);
    return;
}

// The `arg_*` package shims must produce exactly what the `JValue::of_*`
// constructors do — `android_view` relies on the equivalence.
#[test]
fn arg_shims_match_constructors() {
    assert arg_int(99 as jint).bits() == JValue::of_int(99 as jint).bits();
    assert arg_bool(1 as jboolean).bits() == JValue::of_bool(1 as jboolean).bits();
    assert arg_long(123456789 as jlong).bits() == JValue::of_long(123456789 as jlong).bits();
    assert arg_object({ 0 as jobject }).bits() == JValue::of_object({ 0 as jobject }).bits();
    assert arg_float(2.5f32).bits() == JValue::of_float(2.5f32).bits();
    assert arg_double(2.5f64).bits() == JValue::of_double(2.5f64).bits();
}
