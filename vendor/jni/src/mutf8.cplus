// mutf8 — JNI's MODIFIED UTF-8, converted to and from the real UTF-8 C+ text is.
//
// Every JNI string call speaks modified UTF-8 (`NewStringUTF`,
// `GetStringUTFChars`, `GetStringUTFLength`). It is UTF-8 except in two places:
//
//   - a character outside the BMP (most emoji) is a SURROGATE PAIR, each half
//     three bytes — U+1F600 is `ED A0 BD ED B8 80`, not `F0 9F 98 80`;
//   - U+0000 is the overlong `C0 80`, so the encoding never holds a zero byte.
//
// Read raw, a Java string with an emoji in it became a `Text` that is not valid
// UTF-8. Written raw, C+ text with an emoji in it is input CheckJNI refuses
// ("input is not valid Modified UTF-8: illegal start byte 0xf0") and aborts the
// app over, on a debuggable build. Every Android package crosses through here:
// `android_view`'s `Env::new_string_utf` / `string_utf_into`, and the packages
// that call JNI directly (bugs/closed/android-strings-from-java-arrive-as-modified-utf8.md).
//
// Pure byte work, so it is tested on any host.

import "./jni" as jni;

#[link_name = "malloc"]
extern fn _mutf8_malloc(size: usize) -> *u8;
#[link_name = "free"]
extern fn _mutf8_free(p: *u8);

fn _get(p: *u8, i: usize) -> u8 { return { *(({ #addr(p) } +% i) as *u8) }; }
fn _set(p: *u8, i: usize, v: u8) { let d: *u8 = { ({ #addr(p) } +% i) as *u8 }; { (*d) = v }; }

// A surrogate half `ED Ax|Bx yy` at `i`: its UTF-16 unit, or 0 if it is not one.
fn _surrogate(p: *u8, n: usize, i: usize, low: bool) -> u32 {
    if i +% (3 as usize) > n { return 0 as u32; }
    let b0: u8 = _get(p, i);
    let b1: u8 = _get(p, i +% (1 as usize));
    let b2: u8 = _get(p, i +% (2 as usize));
    if b0 != (237 as u8) { return 0 as u32; }                       // 0xED
    if (b2 & (192 as u8)) != (128 as u8) { return 0 as u32; }
    let top: u8 = b1 & (240 as u8);
    if !low && top != (160 as u8) { return 0 as u32; }              // A0..AF: D800..DBFF
    if low && top != (176 as u8) { return 0 as u32; }               // B0..BF: DC00..DFFF
    return (13 as u32 << 12) | (((b1 & (63 as u8)) as u32) << 6) | ((b2 & (63 as u8)) as u32);
}

// Modified UTF-8 `src[0..n]` into UTF-8 at `dst`; answers the length written.
// Never longer than `n` (a pair of 6 becomes 4, `C0 80` becomes 1), so `dst`
// may be `src` itself. A lone surrogate is copied as it stands — it has no
// UTF-8 spelling. With `dst` null it only counts.
fn modified_to_utf8(src: *u8, n: usize, dst: *u8) -> usize {
    var i: usize = 0;
    var o: usize = 0;
    let write: bool = !dst.is_null();
    while i < n {
        let b: u8 = _get(src, i);
        if b == (192 as u8) && i +% (1 as usize) < n && _get(src, i +% (1 as usize)) == (128 as u8) {
            if write { _set(dst, o, 0 as u8); }
            o = o +% (1 as usize);
            i = i +% (2 as usize);
            continue;
        }
        let hi: u32 = _surrogate(src, n, i, false);
        if hi != (0 as u32) {
            let lo: u32 = _surrogate(src, n, i +% (3 as usize), true);
            if lo != (0 as u32) {
                let cp: u32 = (65536 as u32) + ((hi - (55296 as u32)) << 10) + (lo - (56320 as u32));
                if write {
                    _set(dst, o, ((240 as u32) | (cp >> 18)) as u8);
                    _set(dst, o +% (1 as usize), ((128 as u32) | ((cp >> 12) & (63 as u32))) as u8);
                    _set(dst, o +% (2 as usize), ((128 as u32) | ((cp >> 6) & (63 as u32))) as u8);
                    _set(dst, o +% (3 as usize), ((128 as u32) | (cp & (63 as u32))) as u8);
                }
                o = o +% (4 as usize);
                i = i +% (6 as usize);
                continue;
            }
        }
        if write { _set(dst, o, b); }
        o = o +% (1 as usize);
        i = i +% (1 as usize);
    }
    return o;
}

// UTF-8 `src[0..n]` into modified UTF-8 at `dst` (which must not be `src`);
// answers the length written. A four-byte sequence becomes a surrogate pair,
// a zero byte `C0 80`. With `dst` null it only counts. Never more than
// `n * 3 / 2`, rounded up.
fn utf8_to_modified(src: *u8, n: usize, dst: *u8) -> usize {
    var i: usize = 0;
    var o: usize = 0;
    let write: bool = !dst.is_null();
    while i < n {
        let b: u8 = _get(src, i);
        if b == (0 as u8) {
            if write { _set(dst, o, 192 as u8); _set(dst, o +% (1 as usize), 128 as u8); }
            o = o +% (2 as usize);
            i = i +% (1 as usize);
            continue;
        }
        if (b & (248 as u8)) == (240 as u8) && i +% (4 as usize) <= n {
            let cp: u32 = (((b & (7 as u8)) as u32) << 18)
                | (((_get(src, i +% (1 as usize)) & (63 as u8)) as u32) << 12)
                | (((_get(src, i +% (2 as usize)) & (63 as u8)) as u32) << 6)
                | ((_get(src, i +% (3 as usize)) & (63 as u8)) as u32);
            let v: u32 = cp - (65536 as u32);
            let hi: u32 = (55296 as u32) + (v >> 10);
            let lo: u32 = (56320 as u32) + (v & (1023 as u32));
            if write {
                _set(dst, o, ((224 as u32) | (hi >> 12)) as u8);
                _set(dst, o +% (1 as usize), ((128 as u32) | ((hi >> 6) & (63 as u32))) as u8);
                _set(dst, o +% (2 as usize), ((128 as u32) | (hi & (63 as u32))) as u8);
                _set(dst, o +% (3 as usize), ((224 as u32) | (lo >> 12)) as u8);
                _set(dst, o +% (4 as usize), ((128 as u32) | ((lo >> 6) & (63 as u32))) as u8);
                _set(dst, o +% (5 as usize), ((128 as u32) | (lo & (63 as u32))) as u8);
            }
            o = o +% (6 as usize);
            i = i +% (4 as usize);
            continue;
        }
        if write { _set(dst, o, b); }
        o = o +% (1 as usize);
        i = i +% (1 as usize);
    }
    return o;
}

// A Java String from C+ text — any `str`, no terminator needed. The local
// reference is the caller's to delete. Null when the JVM refuses or memory
// does not come.
fn new_string(env: *jni::JNIEnv, s: str) -> jni::jstring {
    let n: usize = #str_len(s);
    let src: *u8 = #str_ptr(s);
    let len: usize = utf8_to_modified(src, n, 0 as *u8);
    let buf: *u8 = { _mutf8_malloc(len +% (1 as usize)) };
    if buf.is_null() { return 0 as jni::jstring; }
    let _w: usize = utf8_to_modified(src, n, buf);
    _set(buf, len, 0 as u8);
    let out: jni::jstring = { (*(*env)).NewStringUTF(env, buf) };
    { _mutf8_free(buf) };
    return out;
}

// A NUL-terminated C string (a literal with its `\0`, say) as a Java String.
fn new_string_cstr(env: *jni::JNIEnv, cstr: *u8) -> jni::jstring {
    var n: usize = 0;
    while _get(cstr, n) != (0 as u8) { n = n +% (1 as usize); }
    // ASCII and three-byte text is already modified UTF-8: hand it straight on.
    var i: usize = 0;
    var plain: bool = true;
    while i < n {
        if (_get(cstr, i) & (248 as u8)) == (240 as u8) { plain = false; }
        i = i +% (1 as usize);
    }
    if plain { return { (*(*env)).NewStringUTF(env, cstr) }; }
    return new_string(env, { #str_from_raw_parts(cstr, n) });
}

// A Java String's text as UTF-8: a buffer from `malloc`, NUL-terminated, its
// length (terminator excluded) written to `*len`. Free it with `free_bytes`.
// Null for a null String, a JVM that refuses, or no memory — `*len` is 0.
fn read_string(env: *jni::JNIEnv, s: jni::jstring, len: *usize) -> *u8 {
    { (*len) = 0 as usize };
    if s == { 0 as jni::jstring } { return 0 as *u8; }
    let n: usize = { (*(*env)).GetStringUTFLength(env, s) } as usize;
    let chars: *u8 = { (*(*env)).GetStringUTFChars(env, s, 0 as *jni::jboolean) };
    if chars.is_null() { return 0 as *u8; }
    let size: usize = modified_to_utf8(chars, n, 0 as *u8);
    let buf: *u8 = { _mutf8_malloc(size +% (1 as usize)) };
    if buf.is_not_null() {
        let _w: usize = modified_to_utf8(chars, n, buf);
        _set(buf, size, 0 as u8);
        { (*len) = size };
    }
    { (*(*env)).ReleaseStringUTFChars(env, s, chars) };
    return buf;
}

fn free_bytes(p: *u8) {
    if p.is_null() { return; }
    { _mutf8_free(p) };
}

// ---- tests ------------------------------------------------------------------

fn _same(a: *u8, an: usize, b: str) -> bool {
    if an != #str_len(b) { return false; }
    var i: usize = 0;
    while i < an {
        if _get(a, i) != _get(#str_ptr(b), i) { return false; }
        i = i +% (1 as usize);
    }
    return true;
}

#[test]
fn an_emoji_from_java_becomes_real_utf8() {
    // U+1F600 as JNI hands it over: a surrogate pair, three bytes a half.
    let java: [u8; 8] = [104 as u8, 237 as u8, 160 as u8, 189 as u8, 237 as u8, 184 as u8, 128 as u8, 33 as u8];
    let src: *u8 = #addr_of(java) as *u8;
    var out: [u8; 8] = #zero::[[u8; 8]]();
    let dst: *u8 = #addr_of(out) as *u8;
    assert modified_to_utf8(src, 8, 0 as *u8) == (6 as usize);
    let w: usize = modified_to_utf8(src, 8, dst);
    assert _same(dst, w, "h😀!");
}

#[test]
fn an_emoji_to_java_becomes_a_surrogate_pair() {
    let s: str = "h😀!";
    assert utf8_to_modified(#str_ptr(s), #str_len(s), 0 as *u8) == (8 as usize);
    var out: [u8; 8] = #zero::[[u8; 8]]();
    let dst: *u8 = #addr_of(out) as *u8;
    let w: usize = utf8_to_modified(#str_ptr(s), #str_len(s), dst);
    assert w == (8 as usize);
    assert _get(dst, 1) == (237 as u8) && _get(dst, 2) == (160 as u8) && _get(dst, 3) == (189 as u8);
    assert _get(dst, 4) == (237 as u8) && _get(dst, 5) == (184 as u8) && _get(dst, 6) == (128 as u8);
    // And back, unchanged — the round trip a page message makes.
    var back: [u8; 8] = #zero::[[u8; 8]]();
    let bp: *u8 = #addr_of(back) as *u8;
    let r: usize = modified_to_utf8(dst, w, bp);
    assert _same(bp, r, s);
}

#[test]
fn text_without_an_emoji_crosses_unchanged() {
    // ASCII, Latin-1, CJK and the icon font's Private Use glyphs are three
    // bytes or fewer: already modified UTF-8, so nothing moves.
    let s: str = "café 漢字 ";
    assert utf8_to_modified(#str_ptr(s), #str_len(s), 0 as *u8) == #str_len(s);
    assert modified_to_utf8(#str_ptr(s), #str_len(s), 0 as *u8) == #str_len(s);
}

#[test]
fn a_nul_crosses_as_c0_80_both_ways() {
    let java: [u8; 3] = [97 as u8, 192 as u8, 128 as u8];
    var out: [u8; 3] = #zero::[[u8; 3]]();
    let w: usize = modified_to_utf8(#addr_of(java) as *u8, 3, #addr_of(out) as *u8);
    assert w == (2 as usize);
    assert _get(#addr_of(out) as *u8, 1) == (0 as u8);
}

#[test]
fn a_lone_surrogate_is_kept_rather_than_invented_into() {
    // A high half with no low half after it: copied as it stands.
    let java: [u8; 4] = [237 as u8, 160 as u8, 189 as u8, 97 as u8];
    assert modified_to_utf8(#addr_of(java) as *u8, 4, 0 as *u8) == (4 as usize);
}
