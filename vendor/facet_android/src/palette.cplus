// THE SYSTEM PALETTE — Material You.
//
// From Android 12 (API 31) the system derives five tonal ramps from the
// wallpaper and hands them to every app as colour resources:
// `system_accent1_0` .. `system_neutral2_1000`, thirteen tones a ramp. A native
// app's palette IS those ramps, read through Material 3's tone mapping, and an
// app that paints fixed values looks like it belongs to an older phone
// (reports/spendwise/S10).
//
// facet's colour model was already the right shape for it: a Color is a TOKEN
// resolved at paint time, and an unset theme role falls through to a platform
// token. What was missing was the SOURCE. This reads the ramps once per
// Activity — a wallpaper or appearance change recreates it, so that is also
// when they can move — and answers the platform tokens and the unset roles
// from them. Below API 31, or when the app's theme says `fixed_palette`, it
// answers nothing and paint.cplus keeps its fixed table.
//
// No AAR. The ramps are framework resources, read by name through
// `Resources.getIdentifier`, so the Gradle-free build stays Gradle-free.

import "stdlib/option" as option;
import "stdlib/text" as text;
import "jni/jni" as jni;
import "android_view/runtime" as rt;
import "facet/theme" as theme;

// Ramps, in the order the resource names use.
const RAMP_ACCENT1: i32 = 0;
const RAMP_ACCENT2: i32 = 1;
const RAMP_ACCENT3: i32 = 2;
const RAMP_NEUTRAL1: i32 = 3;
const RAMP_NEUTRAL2: i32 = 4;
const RAMPS: i32 = 5;
const TONES: i32 = 13;

// ARGB per ramp x tone; meaningful only while LOADED.
static VALUES: [i32; 65] = [0; 65];
static LOADED: bool = false;

fn ramp_name(r: i32) -> str {
    if r == RAMP_ACCENT1 { return "accent1"; }
    if r == RAMP_ACCENT2 { return "accent2"; }
    if r == RAMP_ACCENT3 { return "accent3"; }
    if r == RAMP_NEUTRAL1 { return "neutral1"; }
    return "neutral2";
}

// The shade numbers Android names the tones by: 0 is white, 1000 black.
fn shade_at(i: i32) -> i32 {
    if i == (0 as i32) { return 0 as i32; }
    if i == (1 as i32) { return 10 as i32; }
    if i == (2 as i32) { return 50 as i32; }
    return (i -% (2 as i32)) *% (100 as i32);
}

fn index_of_shade(shade: i32) -> i32 {
    if shade == (0 as i32) { return 0 as i32; }
    if shade == (10 as i32) { return 1 as i32; }
    if shade == (50 as i32) { return 2 as i32; }
    return (shade / (100 as i32)) +% (2 as i32);
}

fn sdk_int(env: rt::Env) -> i32 {
    let cls: jni::jclass = env.class_cached(#str_ptr("android/os/Build$VERSION\0"));
    if cls == (0 as jni::jclass) { return 0 as i32; }
    let fid: jni::jfieldID = env.static_field_id(cls, #str_ptr("SDK_INT\0"), #str_ptr("I\0"));
    if fid == (0 as jni::jfieldID) { return 0 as i32; }
    return { (*(*env.raw())).GetStaticIntField(env.raw(), cls, fid) };
}

// Read every ramp off `activity`. All or nothing: a device that answers some
// names and not others is not one whose palette this can claim to follow.
fn load(env: rt::Env, activity: jni::jobject) {
    LOADED = false;
    if activity == (0 as jni::jobject) { return; }
    if sdk_int(env) < (31 as i32) { return; }
    let res: jni::jobject = env.call_object_0(
        activity, #str_ptr("android/content/Context\0"), #str_ptr("getResources\0"),
        #str_ptr("()Landroid/content/res/Resources;\0"));
    if res == (0 as jni::jobject) { return; }
    let get_id: jni::jmethodID = env.method(#str_ptr("android/content/res/Resources\0"),
        #str_ptr("getIdentifier\0"),
        #str_ptr("(Ljava/lang/String;Ljava/lang/String;Ljava/lang/String;)I\0"));
    let get_color: jni::jmethodID = env.method(#str_ptr("android/content/Context\0"),
        #str_ptr("getColor\0"), #str_ptr("(I)I\0"));
    if get_id == (0 as jni::jmethodID) || get_color == (0 as jni::jmethodID) {
        env.delete_local_ref(res);
        return;
    }
    let kind: jni::jstring = env.new_string_utf(#str_ptr("color\0"));
    let pkg: jni::jstring = env.new_string_utf(#str_ptr("android\0"));
    var ok: bool = true;
    var r: i32 = 0 as i32;
    while ok && r < RAMPS {
        var i: i32 = 0 as i32;
        while ok && i < TONES {
            let name: text::Text = "system_${ramp_name(r)}_${shade_at(i)}\0";
            let jname: jni::jstring = env.new_string_utf(#str_ptr(name.view()));
            var a: [jni::JValue; 3] = [jni::arg_object(jname), jni::arg_object(kind), jni::arg_object(pkg)];
            let id: i32 = { (*(*env.raw())).CallIntMethodA(env.raw(), res, get_id, #addr_of(a[0])) };
            env.delete_local_ref(jname);
            if env.has_pending_exception() || id == (0 as i32) {
                env.clear_exception();
                ok = false;
            } else {
                var b: [jni::JValue; 1] = [jni::arg_int(id)];
                let argb: i32 = { (*(*env.raw())).CallIntMethodA(env.raw(), activity, get_color, #addr_of(b[0])) };
                if env.has_pending_exception() {
                    env.clear_exception();
                    ok = false;
                } else {
                    VALUES[(r *% TONES +% i) as usize] = argb;
                }
            }
            i = i +% (1 as i32);
        }
        r = r +% (1 as i32);
    }
    env.delete_local_ref(kind);
    env.delete_local_ref(pkg);
    env.delete_local_ref(res);
    LOADED = ok;
}

// Whether paint should consult the ramps right now.
fn active() -> bool { return LOADED && theme::uses_system_palette(); }

fn tone(ramp: i32, shade: i32) -> i32 {
    return VALUES[(ramp *% TONES +% index_of_shade(shade)) as usize];
}

fn pick(dark: bool, ramp: i32, light_shade: i32, dark_shade: i32) -> option::Option[i32] {
    if dark { return option::Option[i32]::Some(tone(ramp, dark_shade)); }
    return option::Option[i32]::Some(tone(ramp, light_shade));
}

fn with_alpha(argb: i32, a: f64) -> i32 {
    let ai: i32 = { (a * 255.0f64) as i32 };
    return (ai *% (16777216 as i32)) +% (argb & (16777215 as i32));
}

// A PLATFORM token (1..24) from the ramps — Material 3's role tones, light and
// dark. None for a token the palette does not speak for: the system hues
// (red, green, …) are fixed colours by meaning, and the translucent fills stay
// translucent.
fn platform_argb(t: u32, dark: bool) -> option::Option[i32] {
    if !active() { return option::Option[i32]::None; }
    let n1: i32 = RAMP_NEUTRAL1;
    let n2: i32 = RAMP_NEUTRAL2;
    let a1: i32 = RAMP_ACCENT1;
    // text = on-surface; text_secondary = on-surface-variant
    if t == (1 as u32) { return pick(dark, n1, 900 as i32, 100 as i32); }
    if t == (2 as u32) { return pick(dark, n2, 700 as i32, 200 as i32); }
    // accent / link = primary
    if t == (3 as u32) || t == (16 as u32) { return pick(dark, a1, 600 as i32, 200 as i32); }
    // text_tertiary / placeholder = outline
    if t == (9 as u32) || t == (15 as u32) { return pick(dark, n2, 500 as i32, 400 as i32); }
    // separator = outline-variant
    if t == (10 as u32) { return pick(dark, n2, 200 as i32, 700 as i32); }
    // window_background = surface
    if t == (11 as u32) { return pick(dark, n1, 10 as i32, 900 as i32); }
    // under_page_background = surface-container-lowest/low, below the surface
    if t == (12 as u32) { return pick(dark, n1, 100 as i32, 1000 as i32); }
    // control_background = surface-container
    if t == (13 as u32) { return pick(dark, n1, 50 as i32, 800 as i32); }
    // selected_content_background = secondary-container
    if t == (17 as u32) { return pick(dark, RAMP_ACCENT2, 100 as i32, 700 as i32); }
    // selected_text_background = primary, translucent
    if t == (18 as u32) {
        if dark { return option::Option[i32]::Some(with_alpha(tone(a1, 200 as i32), 0.35f64)); }
        return option::Option[i32]::Some(with_alpha(tone(a1, 600 as i32), 0.35f64));
    }
    return option::Option[i32]::None;
}

// An UNSET theme role the platform-token fallback would get wrong. `primary`
// falls to `accent` and needs nothing here; the ones below do not:
//
// - on_primary's fallback is white, and dynamic primary is a LIGHT tone in the
//   dark appearance — white on it is unreadable.
// - secondary's fallback is a neutral fill, deliberately not the accent; under
//   Material You there is a second hue for it, and it is accent2.
fn role_argb(token: u32, dark: bool) -> option::Option[i32] {
    if !active() { return option::Option[i32]::None; }
    if token == (101 as u32) { return pick(dark, RAMP_ACCENT1, 0 as i32, 800 as i32); }
    if token == (102 as u32) { return pick(dark, RAMP_ACCENT2, 600 as i32, 200 as i32); }
    if token == (103 as u32) { return pick(dark, RAMP_ACCENT2, 0 as i32, 800 as i32); }
    if token == (108 as u32) { return pick(dark, RAMP_NEUTRAL2, 500 as i32, 400 as i32); }
    return option::Option[i32]::None;
}

// ---- tests: the mapping, with a synthetic palette ---------------------------

fn fill_synthetic() {
    var r: i32 = 0 as i32;
    while r < RAMPS {
        var i: i32 = 0 as i32;
        while i < TONES {
            VALUES[(r *% TONES +% i) as usize] = r *% (1000 as i32) +% shade_at(i);
            i = i +% (1 as i32);
        }
        r = r +% (1 as i32);
    }
    LOADED = true;
}

fn value_of(o: option::Option[i32]) -> i32 {
    return match o {
        option::Option[i32]::Some(v) => v,
        option::Option[i32]::None => -1 as i32,
    };
}

#[test]
fn shades_and_indices_round_trip() {
    var i: i32 = 0 as i32;
    while i < TONES {
        assert index_of_shade(shade_at(i)) == i;
        i = i +% (1 as i32);
    }
    assert shade_at(12 as i32) == (1000 as i32);
}

#[test]
fn tokens_take_material_3_tones_per_appearance() {
    fill_synthetic();
    theme::set_theme(theme::Theme::new());
    // accent = accent1 600 light, 200 dark
    assert value_of(platform_argb(3 as u32, false)) == (600 as i32);
    assert value_of(platform_argb(3 as u32, true)) == (200 as i32);
    // window = neutral1 10 / 900
    assert value_of(platform_argb(11 as u32, false)) == (3010 as i32);
    assert value_of(platform_argb(11 as u32, true)) == (3900 as i32);
    // separator = neutral2 200 / 700
    assert value_of(platform_argb(10 as u32, false)) == (4200 as i32);
    // the system hues are fixed by meaning
    assert value_of(platform_argb(4 as u32, false)) == (-1 as i32);
    // on_primary is the dark tone over a light dark-appearance primary
    assert value_of(role_argb(101 as u32, true)) == (800 as i32);
    assert value_of(role_argb(102 as u32, false)) == (1600 as i32);
    // a role the platform fallback already answers is left to it
    assert value_of(role_argb(100 as u32, false)) == (-1 as i32);
    LOADED = false;
}

#[test]
fn a_fixed_palette_or_no_palette_answers_nothing() {
    fill_synthetic();
    theme::set_theme(theme::Theme::new(fixed_palette: true));
    assert value_of(platform_argb(3 as u32, false)) == (-1 as i32);
    assert value_of(role_argb(101 as u32, false)) == (-1 as i32);
    theme::set_theme(theme::Theme::new());
    LOADED = false;
    assert value_of(platform_argb(3 as u32, false)) == (-1 as i32);
}
