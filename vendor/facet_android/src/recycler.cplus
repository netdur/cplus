// The recycler: `list` today, and the machinery `tree`, `table` and
// `collection` will sit on.
//
// A RECYCLED ROW IS A SUBTREE THE PLATFORM OWNS. ListView creates, pools and
// destroys cells on its own schedule, and a row is not in the window walk — so
// facet's own door is `mount::realise` / `unrealise` / `sync_from` rather than
// anything this file invents. That door exists precisely for this.
//
// The cycle, and the reason it is worth the machinery:
//
//   first sight of a shape   build the row's node, realise it INTO the cell
//   every row after that     bind() writes props into the SAME subtree,
//                            sync_from carries them across
//
// Without a bind the cell is emptied and rebuilt, which is a subtree, a layout
// and a view per node per row — what a list costs before the contract can say
// otherwise. facet_appkit's recycler makes the same split and this is a port of
// its `fill_cell`.

import "stdlib/box" as box;
import "stdlib/option" as option;
import "jni/jni" as jni;
import "android_view/runtime" as rt;
import "android_view/widgets" as w;
import "flex_layout/flex_layout" as flex;
import "facet/facet" as core;
import "facet/props" as props;
import "facet/mount" as mount;
import "facet/list" as list;
import "facet/tree" as tree;
import "facet/elements" as ui;
import "facet/vocabulary" as vocab;
import "stdlib/vec" as vec;
import "stdlib/status" as status;
import "stdlib/text" as text;
import "./env" as e;
import "./paint" as paint;
import "./dex" as dex;
import "./geometry" as geometry;
import "./scheduler" as scheduler;
import "./log" as log;
import "./controls" as controls;

// Keyed tags on the LIST's view, so a re-entry finds what it made. Resource-id
// shaped, because `View.setTag(int, Object)` refuses anything whose top byte is
// under 2 — see controls::SCROLL_DOC_TAG.
const LIST_ADAPTER_TAG: i32 = 2131886083 as i32;   // 0x7F0F0003
// And on the CELL: the boxed row node it is currently showing.
const CELL_NODE_TAG: i32 = 2131886084 as i32;      // 0x7F0F0004

fn list_props(n: *core::Node) -> *props::ListProps {
    return controls::props_of(n, props::K_LIST) as *props::ListProps;
}

fn create_list(n: *core::Node) -> *u8 { return create_list_view(n); }

// The ListView, its adapter and its tap listener. Shared by `list` and `tree`,
// which differ only in the MODEL the adapter is answered from.
fn create_list_view(n: *core::Node) -> *u8 {
    let env: rt::Env = e::env();
    var lv: w::ListView = w::ListView::new_context(env, e::context());
    let raw: *u8 = lv.into_raw();

    // The adapter and the tap listener both carry the NODE as their token, so
    // one hook routes any number of lists and there is no side table.
    let token: i64 = { #addr(n) as i64 };
    let adapter: jni::jobject = dex::new_with_token(env, dex::rows_class(), token);
    var av: w::AdapterView = w::AdapterView::from_global(env, env.new_global_ref(raw));
    av.set_adapter(adapter);
    let tap: jni::jobject = dex::new_with_token(env, dex::rowtap_class(), token);
    av.set_on_item_click_listener(tap);
    let _keep: *u8 = av.into_raw();

    // The adapter is KEPT: `notifyDataSetChanged` needs the same object, and a
    // local ref does not survive the call that made it.
    var view: w::View = w::View::from_global(env, raw);
    view.set_tag_i_object(LIST_ADAPTER_TAG, adapter);
    paint::unwrap_keep(view);
    env.delete_local_ref(adapter);
    env.delete_local_ref(tap);
    // THE VISIBLE WINDOW, reported back: `observe_scrolled`, the two appearance
    // events and the remaining-items threshold are all one callback — Android
    // hands over the first visible row, how many are visible and how many there
    // are, which is exactly what those four are computed from.
    let watcher: jni::jobject =
        dex::new_with_token(env, dex::scroll_class(), { #addr(n) as i64 });
    if watcher != (0 as jni::jobject) {
        var av: w::AbsListView = w::AbsListView::from_global(env, raw);
        av.set_on_scroll_listener(watcher);
        let _k: *u8 = av.into_raw();
        env.delete_local_ref(watcher);
    }
    return raw;
}

fn adapter_of(env: rt::Env, v: *u8) -> jni::jobject {
    var view: w::View = w::View::from_global(env, v);
    let t: jni::jobject = view.get_tag_i(LIST_ADAPTER_TAG);
    paint::unwrap_keep(view);
    return t;
}

fn apply_list(v: *u8, n: *core::Node, dirty: u64) {
    let p: *props::ListProps = list_props(n);
    if p == (0 as *props::ListProps) { return; }
    let env: rt::Env = e::env();

    // ANY of these means the model moved, and the answer is the same: ask the
    // adapter again. ListView re-reads the count and re-binds what is on
    // screen; the rows it is not showing cost nothing.
    let moved: u64 = list::P_COUNT | list::P_ROW | list::P_INVALIDATE_ROW
                   | list::P_SPLICE_ROWS | list::P_GROUP | list::P_GROUP_COUNT;
    if (dirty & moved) != (0 as u64) {
        let a: jni::jobject = adapter_of(env, v);
        if a != (0 as jni::jobject) {
            dex::rows_changed(env, a);
            env.delete_local_ref(a);
        }
    }
    // THE SEPARATOR, which is a ListView's DIVIDER — a drawable and a height,
    // and `None` is a divider of nothing rather than a null one, because a null
    // divider still leaves the default height behind it.
    if (dirty & (list::P_SEPARATOR | list::P_SEPARATOR_COLOR)) != (0 as u64)
       || dirty == paint::all_bits() {
        apply_separator(env, v, p);
    }
    if (dirty & (list::P_VERTICAL_SCROLL_BARS
                 | list::P_HORIZONTAL_SCROLL_BARS)) != (0 as u64) {
        var sv: w::View = w::View::from_global(env, v);
        sv.set_vertical_scroll_bar_enabled(
            controls::bars_shown({ (*p).vertical_scroll_bars }));
        sv.set_horizontal_scroll_bar_enabled(
            controls::bars_shown({ (*p).horizontal_scroll_bars }));
        paint::unwrap_keep(sv);
    }
    // WHICH ROWS CAN BE PICKED. Android's choice mode is the same three
    // answers, and it is what makes a tap STICK rather than just fire.
    if (dirty & list::P_SELECTION_MODE) != (0 as u64) {
        var av: w::AbsListView = w::AbsListView::from_global(env, env.new_global_ref(v));
        av.set_choice_mode(match { (*p).selection_mode } {
            vocab::SelectionMode::Single => 1 as i32,     // CHOICE_MODE_SINGLE
            vocab::SelectionMode::Multiple => 2 as i32,   // CHOICE_MODE_MULTIPLE
            vocab::SelectionMode::None => 0 as i32,       // CHOICE_MODE_NONE
        });
        let _k: *u8 = av.into_raw();
    }
    if (dirty & list::P_SELECTED_INDEX) != (0 as u64) {
        let idx: i64 = { (*p).selected_index };
        if idx >= (0 as i64) {
            var av: w::AdapterView = w::AdapterView::from_global(env, env.new_global_ref(v));
            av.set_selection({ idx as i32 });
            let _k: *u8 = av.into_raw();
        }
    }
    if (dirty & list::P_SCROLL_TO) != (0 as u64) {
        let idx: i64 = { (*p).scroll_to_index };
        // PAST THE END IS NOT A SCROLL. The same guard `cv_scroll_to` needed on
        // the other backend, for the same reason: a target the model does not
        // have is a request that cannot be honoured, not one to approximate.
        if idx >= (0 as i64) && idx < { (*p).count } {
            var lv: w::ListView = w::ListView::from_global(env, env.new_global_ref(v));
            var av2: w::AdapterView = lv.as_abs_list_view().as_adapter_view();
            av2.set_selection({ idx as i32 });
            let _k: *u8 = lv.into_raw();
        }
    }
    return;
}

// ---- the adapter's two questions ---------------------------------------------

// ONE ADAPTER, TWO MODELS. The token is the node, and the node's kind says
// whether the count comes from a `count` prop or from the visible-row index.
fn row_count(token: i64) -> i32 {
    let n: *core::Node = { token as *core::Node };
    if n == (0 as *core::Node) { return 0 as i32; }
    if core::kind_of(n) == tree::K_TREE { return tree_row_count(n); }
    let p: *props::ListProps = list_props(n);
    if p == (0 as *props::ListProps) { return 0 as i32; }
    return { (*p).count as i32 };
}

fn row_tapped(token: i64, position: i32) {
    let n: *core::Node = { token as *core::Node };
    if n == (0 as *core::Node) { return; }
    if core::kind_of(n) == tree::K_TREE { tree_row_tapped(n, position); return; }
    let p: *props::ListProps = list_props(n);
    if p == (0 as *props::ListProps) { return; }
    { (*p).selected_index = { position as i64 } };
    let t: fn(*u8, *u8) = { (*p).on_item_tapped };
    if t != props::no_handler { t(core::view_of(n), { (*p).on_item_tapped_ctx }); }
    let s: fn(*u8, *u8) = { (*p).on_item_selected };
    if s != props::no_handler { s(core::view_of(n), { (*p).on_item_selected_ctx }); }
    return;
}

// The DEFAULT is a real function, not a null pointer — `props::no_bind` — so
// "has a bind" is a comparison against that sentinel. Testing for null would
// answer true for every list and send a rebuild down the recycling path.
fn has_bind(p: *props::ListProps) -> bool {
    return { (*p).bind } != props::no_bind;
}

// A POINTER IN A TAG. A keyed tag holds an Object, so a raw pointer travels as
// a boxed java.lang.Long — which is also why these two are a pair: the box is
// made on one side and unwrapped on the other, and nothing else should know.
fn long_tag(env: rt::Env, v: *u8, key: i32) -> i64 {
    var view: w::View = w::View::from_global(env, env.new_global_ref(v));
    let t: jni::jobject = view.get_tag_i(key);
    let _k: *u8 = view.into_raw();
    if t == (0 as jni::jobject) { return 0 as i64; }
    let cls: jni::jclass = env.class_cached(#str_ptr("java/lang/Long\0"));
    let mid: jni::jmethodID = env.method_id(cls, #str_ptr("longValue\0"), #str_ptr("()J\0"));
    let bits: i64 = { (*(*env.raw())).CallLongMethodA(env.raw(), t, mid, 0 as *jni::JValue) };
    env.delete_local_ref(t);
    return bits;
}

fn set_long_tag(env: rt::Env, v: *u8, key: i32, bits: i64) {
    let cls: jni::jclass = env.class_cached(#str_ptr("java/lang/Long\0"));
    let mid: jni::jmethodID = env.method_id_static(cls, #str_ptr("valueOf\0"),
                                                   #str_ptr("(J)Ljava/lang/Long;\0"));
    var args: [jni::JValue; 1] = [jni::arg_long(bits)];
    let boxed: jni::jobject = {
        (*(*env.raw())).CallStaticObjectMethodA(env.raw(), cls, mid, #addr_of(args[0]))
    };
    var view: w::View = w::View::from_global(env, env.new_global_ref(v));
    view.set_tag_i_object(key, boxed);
    let _k: *u8 = view.into_raw();
    env.delete_local_ref(boxed);
    return;
}

fn cell_node(env: rt::Env, cell: jni::jobject) -> *core::Node {
    return { long_tag(env, { #addr(cell) as *u8 }, CELL_NODE_TAG) as *core::Node };
}

fn set_cell_node(env: rt::Env, cell: jni::jobject, n: *core::Node) {
    set_long_tag(env, { #addr(cell) as *u8 }, CELL_NODE_TAG, { #addr(n) as i64 });
    return;
}

// The row ListView asked for, in a cell it may have handed back.
fn row_view(token: i64, position: i32, convert: jni::jobject, parent: jni::jobject) -> jni::jobject {
    let n: *core::Node = { token as *core::Node };
    if n == (0 as *core::Node) { return 0 as jni::jobject; }
    if core::kind_of(n) == tree::K_TREE { return tree_row_view(n, position, convert); }
    let p: *props::ListProps = list_props(n);
    if p == (0 as *props::ListProps) { return 0 as jni::jobject; }
    let env: rt::Env = e::env();
    let row: usize = { position as usize };

    // The width a row gets is the LIST'S, which is the frame flex gave the
    // list node — not the parent's measured width, which is zero before the
    // first layout.
    let lf: flex::Frame = core::frame_of(n);
    var width: f64 = lf.width;
    if width <= 0.0f64 { width = scheduler::width(); }

    if convert != (0 as jni::jobject) {
        let existing: *core::Node = cell_node(env, convert);
        if existing != (0 as *core::Node) && has_bind(p) {
            bind_into(p, row, existing);
            // A bind WRITES PROPS, which marks nodes dirty and touches nothing
            // native. A realised row is outside the window walk, so nothing
            // would carry those writes across — `sync_from` is that walk,
            // rooted here, applied immediately because the row is about to be
            // shown.
            mount::sync_from(existing);
            place_row(env, convert, existing, width, fixed_height(p));
            return convert;
        }
        // No bind, or an empty cell: tear the old row down before reusing it.
        if existing != (0 as *core::Node) { mount::unrealise(existing); }
    }

    let cell: jni::jobject = new_cell(env, convert);
    var node: core::Node = build_row(p, row);
    match box::new::[core::Node](node) {
        option::Option[box::Box[core::Node]]::Some(b) => {
            let np: *core::Node = { b.into_raw() as *core::Node };
            // THE CELL IS THE HOST. A row's root is usually a bare container —
            // nothing keys it, nothing gives it gestures — so it is not backed
            // and its children pass straight into the cell, exactly as a
            // layout-only column does inside a scroll.
            let _rv: *u8 = mount::realise(np, cell);
            // Bound immediately, INCLUDING on the first use, so the builder is
            // responsible for shape only and a row can never show the data of
            // whichever row happened to build its cell.
            if has_bind(p) { bind_into(p, row, np); }
            mount::sync_from(np);
            place_row(env, cell, np, width, fixed_height(p));
            set_cell_node(env, cell, np);
        }
        option::Option[box::Box[core::Node]]::None => { }
    }
    return cell;
}

fn new_cell(env: rt::Env, convert: jni::jobject) -> jni::jobject {
    if convert != (0 as jni::jobject) {
        // Reuse the host itself; only its contents were torn down.
        empty_cell(env, convert);
        return convert;
    }
    return dex::new_host(env, e::context());
}

fn empty_cell(env: rt::Env, cell: jni::jobject) {
    var g: w::ViewGroup = w::ViewGroup::from_global(env, env.new_global_ref(cell));
    g.remove_all_views();
    let _k: *u8 = g.into_raw();
    return;
}

// A stated `row_height`, or 0 for "ask the content".
fn fixed_height(p: *props::ListProps) -> f64 {
    let h: i64 = { (*p).row_height };
    if h <= (0 as i64) { return 0.0f64; }
    return { h as f64 };
}

fn build_row(p: *props::ListProps, row: usize) -> core::Node {
    let f: fn(usize, *u8) -> flex::Node = { (*p).row };
    if f == (0 as fn(usize, *u8) -> flex::Node) { return core::column(core::Builder::new()); }
    return f(row, { (*p).row_ctx });
}

// `bind` carries no ctx of its own: it shares `row_ctx` with the builder, which
// is right — the two are halves of one thing and an app that needed different
// context for them would be describing two lists.
fn bind_into(p: *props::ListProps, row: usize, n: *core::Node) {
    let f: fn(usize, *flex::Node, *u8) = { (*p).bind };
    if f == props::no_bind { return; }
    f(row, n, { (*p).row_ctx });
    return;
}

// Lay the row out at the list's width and push the frames into the cell.
//
// The cell's own height is what ListView asks for, and `FacetHost.setWanted` is
// how it answers — an adapter's view is measured with a LOOSE height spec, and
// `MeasureSpec.getSize` of UNSPECIFIED is zero.
fn place_row(env: rt::Env, cell: jni::jobject, n: *core::Node, width: f64, row_h: f64) {
    // WIDTH ONLY, as a named argument — the height is left to the content.
    // Passing an explicit "undefined" height instead produced a row of ZERO,
    // and a ListView full of hairlines is what that looks like.
    { (*n).calculate_layout(width: width) };
    // A STATED row_height wins, but only if the content fits inside it: a
    // builder that ignores the wrap should not be clipped to a row it overflows.
    // The same rule facet_appkit's `place_row` applies, for the same reason.
    if row_h >= 1.0f64 {
        let natural: f64 = { (*n).frame().height };
        if natural + 0.5f64 >= row_h {
            { (*n).calculate_layout(width: width, height: row_h) };
        } else {
            { (*n).calculate_layout(width: width, height: row_h) };
        }
    }
    let f: flex::Frame = core::frame_of(n);
    var ht: f64 = f.height;
    if ht <= 0.0f64 { ht = 1.0f64; }
    dex::host_set_wanted(env, cell, { geometry::px(width) as i32 }, { geometry::px(ht) as i32 });
    geometry::place(cell, 0.0f64, 0.0f64, width, ht);
    geometry::reposition_children(n, core::frame_of(n));
    return;
}

// ---- tree ---------------------------------------------------------------------
//
// The SAME ListView and the SAME adapter as a list. What differs is the model:
// a tree is a hierarchy, and a ListView takes a flat one — so the backend keeps
// an INDEX of the rows that are currently visible, in display order, and every
// adapter question is answered against that.
//
// The flatten is a port of facet_gtk's `walk_visible`, including the two things
// it gets right: the ROOT IS THE CONTAINER and not a row (a tree shows its
// children), and a closed branch is not descended into at all — so a
// hundred-thousand-node model with everything shut costs two rows.

struct VisibleRow {
    node: usize,
    depth: i64,
}

// Boxed and hung off the ListView, because it must survive between adapter
// calls and be dropped when it is replaced.
const TREE_INDEX_TAG: i32 = 2131886085 as i32;   // 0x7F0F0005

fn tree_props(n: *core::Node) -> *tree::TreeProps {
    return controls::props_of(n, tree::K_TREE) as *tree::TreeProps;
}

fn is_expanded(p: *tree::TreeProps, node: *tree::TreeNode) -> bool {
    let id: str = { (*node).id_of() };
    if id == "" { return false; }
    let ex: *vocab::TextList = { #addr_of((*p).expanded) };
    var i: usize = 0 as usize;
    let n: usize = { (*ex).count() };
    while i < n {
        if { (*ex).at(i) } == id { return true; }
        i = i +% (1 as usize);
    }
    return false;
}

fn walk_visible(node: *tree::TreeNode, p: *tree::TreeProps, depth: i64,
                is_root: bool, out: *vec::Vec[VisibleRow]) {
    if !is_root {
        let _a: status::Status = { (*out).append(
            VisibleRow { node: { #addr(node) }, depth: depth }) };
        if !is_expanded(p, node) { return; }
    }
    var i: usize = 0 as usize;
    let count: usize = { (*node).child_count() };
    while i < count {
        match { (*node).child_ptr(i) } {
            option::Option[*tree::TreeNode]::Some(c) => {
                var next: i64 = depth;
                if !is_root { next = depth +% (1 as i64); }
                walk_visible(c, p, next, false, out);
            }
            option::Option[*tree::TreeNode]::None => { }
        }
        i = i +% (1 as usize);
    }
    return;
}

fn visible_rows(n: *core::Node) -> vec::Vec[VisibleRow] {
    var rows: vec::Vec[VisibleRow] = vec::new::[VisibleRow]();
    let p: *tree::TreeProps = tree_props(n);
    if p == (0 as *tree::TreeProps) { return rows; }
    walk_visible(#addr_of((*p).root), p, 0 as i64, true, #addr_of(rows));
    return rows;
}

fn create_tree(n: *core::Node) -> *u8 {
    let raw: *u8 = create_list_view(n);
    reindex_tree(n, raw);
    return raw;
}

fn apply_tree(v: *u8, n: *core::Node, dirty: u64) {
    let env: rt::Env = e::env();
    // THE INDEX IS THE MODEL as far as the adapter is concerned, so anything
    // that changes which rows are visible rebuilds it before telling ListView.
    let moved: u64 = tree::P_ROOT | tree::P_EXPANDED | tree::P_ROW;
    if (dirty & moved) != (0 as u64) {
        reindex_tree(n, v);
        let a: jni::jobject = adapter_of(env, v);
        if a != (0 as jni::jobject) {
            dex::rows_changed(env, a);
            env.delete_local_ref(a);
        }
    }
    return;
}

fn reindex_tree(n: *core::Node, v: *u8) {
    if v == (0 as *u8) { return; }
    forget_index(v);
    if tree_props(n) == (0 as *tree::TreeProps) { return; }
    var rows: vec::Vec[VisibleRow] = visible_rows(n);
    match box::new::[vec::Vec[VisibleRow]](rows) {
        option::Option[box::Box[vec::Vec[VisibleRow]]]::Some(b) => {
            set_long_tag(e::env(), v, TREE_INDEX_TAG, { #addr(b.into_raw()) as i64 });
        }
        option::Option[box::Box[vec::Vec[VisibleRow]]]::None => { }
    }
    return;
}

fn forget_index(v: *u8) {
    let bits: i64 = long_tag(e::env(), v, TREE_INDEX_TAG);
    if bits == (0 as i64) { return; }
    let _dropped: box::Box[vec::Vec[VisibleRow]] =
        box::from_raw::[vec::Vec[VisibleRow]]({ bits as *u8 });
    set_long_tag(e::env(), v, TREE_INDEX_TAG, 0 as i64);
    return;
}

fn index_of(n: *core::Node) -> *vec::Vec[VisibleRow] {
    let v: *u8 = core::view_of(n);
    if v == (0 as *u8) { return 0 as *vec::Vec[VisibleRow]; }
    let bits: i64 = long_tag(e::env(), v, TREE_INDEX_TAG);
    return { bits as *vec::Vec[VisibleRow] };
}

fn row_at(n: *core::Node, position: i32) -> option::Option[VisibleRow] {
    let idx: *vec::Vec[VisibleRow] = index_of(n);
    if idx == (0 as *vec::Vec[VisibleRow]) { return option::Option[VisibleRow]::None; }
    return match { (*idx).at_ptr({ position as usize }) } {
        option::Option[*VisibleRow]::Some(r) => option::Option[VisibleRow]::Some({ (*r) }),
        option::Option[*VisibleRow]::None => option::Option[VisibleRow]::None,
    };
}

fn tree_row_count(n: *core::Node) -> i32 {
    let idx: *vec::Vec[VisibleRow] = index_of(n);
    if idx == (0 as *vec::Vec[VisibleRow]) { return 0 as i32; }
    return { { (*idx).count() } as i32 };
}

// A tap on a tree row means one of two things, and which is not a preference:
// a row with children TOGGLES, a leaf SELECTS. Android has no disclosure
// triangle of its own here — the row is ours — so the whole row is the control.
fn tree_row_tapped(n: *core::Node, position: i32) {
    let p: *tree::TreeProps = tree_props(n);
    if p == (0 as *tree::TreeProps) { return; }
    match row_at(n, position) {
        option::Option[VisibleRow]::Some(r) => {
            let node: *tree::TreeNode = { r.node as *tree::TreeNode };
            if { (*node).child_count() } > (0 as usize) {
                toggle(p, n, node);
                return;
            }
            { (*p).selected = text::from_str({ (*node).id_of() }) };
            core::touch(n, tree::P_SELECTED);
            let f: fn(*tree::TreeNode, *u8) = { (*p).on_select };
            if f != tree::no_select { f(node, select_ctx(p)); }
        }
        option::Option[VisibleRow]::None => { }
    }
    return;
}

// The handler's own context, falling back to the set-wide one — the same
// fallback facet's own accessors make, so a `tree(ctx:)` call site keeps working.
fn select_ctx(p: *tree::TreeProps) -> *u8 {
    let c: *u8 = { (*p).on_select_ctx };
    if c != (0 as *u8) { return c; }
    return { (*p).ctx };
}

fn toggle(p: *tree::TreeProps, n: *core::Node, node: *tree::TreeNode) {
    let id: str = { (*node).id_of() };
    if id == "" { return; }
    if is_expanded(p, node) {
        // Rebuilt without the id: `TextList` has no remove, and a list this
        // short is cheaper to rebuild than to grow one.
        var kept: vocab::TextList = vocab::TextList::new();
        var i: usize = 0 as usize;
        let cnt: usize = { (*p).expanded.count() };
        while i < cnt {
            let e_id: str = { (*p).expanded.at(i) };
            if e_id != id { let _a: status::Status = kept.add(e_id); }
            i = i +% (1 as usize);
        }
        { (*p).expanded = kept };
    } else {
        let _a: status::Status = { (*p).expanded.add(id) };
    }
    // TOUCHED, so the apply above rebuilds the index and tells the adapter —
    // one path for an expansion whether it came from a tap or from the app.
    core::touch(n, tree::P_EXPANDED);
    return;
}

// A tree's row, through the same cell cycle as a list's: realise once, bind on
// reuse. The item stands where a list's index stands, which is the only
// difference the contract makes between them.
fn tree_row_view(n: *core::Node, position: i32, convert: jni::jobject) -> jni::jobject {
    let p: *tree::TreeProps = tree_props(n);
    if p == (0 as *tree::TreeProps) { return 0 as jni::jobject; }
    let env: rt::Env = e::env();
    let lf: flex::Frame = core::frame_of(n);
    var width: f64 = lf.width;
    if width <= 0.0f64 { width = scheduler::width(); }

    var item: *tree::TreeNode = 0 as *tree::TreeNode;
    var depth: i64 = 0 as i64;
    match row_at(n, position) {
        option::Option[VisibleRow]::Some(r) => {
            item = { r.node as *tree::TreeNode };
            depth = r.depth;
        }
        option::Option[VisibleRow]::None => { return 0 as jni::jobject; }
    }

    if convert != (0 as jni::jobject) {
        let existing: *core::Node = cell_node(env, convert);
        if existing != (0 as *core::Node) && has_tree_bind(p) {
            bind_tree_row(p, item, existing);
            mount::sync_from(existing);
            indent(existing, depth);
            place_row(env, convert, existing, width, tree_fixed_height(p));
            return convert;
        }
        if existing != (0 as *core::Node) { mount::unrealise(existing); }
    }

    let cell: jni::jobject = new_cell(env, convert);
    var node: core::Node = build_tree_row(p, item);
    match box::new::[core::Node](node) {
        option::Option[box::Box[core::Node]]::Some(b) => {
            let np: *core::Node = { b.into_raw() as *core::Node };
            let _rv: *u8 = mount::realise(np, cell);
            if has_tree_bind(p) { bind_tree_row(p, item, np); }
            mount::sync_from(np);
            indent(np, depth);
            place_row(env, cell, np, width, tree_fixed_height(p));
            set_cell_node(env, cell, np);
        }
        option::Option[box::Box[core::Node]]::None => { }
    }
    return cell;
}

// DEPTH IS THE BACKEND'S, not the builder's. A row builder describes one item
// and knows nothing about where it sits, so the indent is applied to the row's
// root here — which also means a recycled cell has to have it REWRITTEN, since
// the cell it came from was at some other depth.
fn indent(row: *core::Node, depth: i64) {
    { (*row).set_padding_edge(flex::Edge::Start,
                              { depth as f64 } * indent_step()) };
    return;
}

fn indent_step() -> f64 { return 16.0f64; }

// AGAINST THE SENTINEL, not against null — `tree::no_bind` and `tree::no_row`
// are real functions, exactly as `props::no_bind` is for a list. Testing for a
// null pointer answers "yes, there is a builder" for every tree, and
// `no_row` returns an EMPTY node: thirty-five rows of the right height with
// nothing in them.
fn has_tree_bind(p: *tree::TreeProps) -> bool {
    return { (*p).bind } != tree::no_bind;
}

fn tree_fixed_height(p: *tree::TreeProps) -> f64 {
    let h: f64 = { (*p).row_height };
    if h <= 0.0f64 { return 0.0f64; }
    return h;
}

fn build_tree_row(p: *tree::TreeProps, item: *tree::TreeNode) -> core::Node {
    let f: fn(*tree::TreeNode, *u8) -> flex::Node = { (*p).row };
    if f == tree::no_row {
        // NO BUILDER: show the label, which is what `TreeNode.label` is for.
        var b: core::Builder = core::Builder::new();
        b.add(ui::label({ (*item).label_of() }, key: "", font_size: 16.0f64));
        return core::column(b).padding(10.0f64);
    }
    var ctx: *u8 = { (*p).row_ctx };
    if ctx == (0 as *u8) { ctx = { (*p).ctx }; }
    return f(item, ctx);
}

fn bind_tree_row(p: *tree::TreeProps, item: *tree::TreeNode, row: *core::Node) {
    let f: fn(*tree::TreeNode, *u8, *flex::Node) = { (*p).bind };
    if f == tree::no_bind { return; }
    var ctx: *u8 = { (*p).bind_ctx };
    if ctx == (0 as *u8) { ctx = { (*p).ctx }; }
    f(item, ctx, row);
    return;
}

// ---- what the agent surface can see -------------------------------------------
//
// A REALISED ROW IS NOT IN FACET'S TREE. It is a subtree the platform owns,
// mounted into a cell ListView made — so a walk over `child_of` reaches the list
// node and stops, and `describe_ui` answers a two-hundred-row list as ONE node
// an agent can read and cannot drive.
//
// The other backends do not meet this: they walk the NATIVE view hierarchy,
// where a cell is just another view. Walking facet's tree is what buys this
// backend its accuracy everywhere else (see agent_android's manifest), and this
// is the one place it has to reach across.
//
// Only the rows ON SCREEN exist. That is not a limitation to apologise for: an
// agent cannot click what is not realised, and reporting a row that has no view
// would be reporting something it cannot act on.

struct RealisedRow {
    node: usize,
    position: i32,
}

fn realised_rows(n: *core::Node) -> vec::Vec[RealisedRow] {
    var out: vec::Vec[RealisedRow] = vec::new::[RealisedRow]();
    let v: *u8 = core::view_of(n);
    if v == (0 as *u8) { return out; }
    if !e::have_env() { return out; }
    // THE UI THREAD OR NOTHING. This reads the live View hierarchy, and the
    // agent surface — its only caller — answers on a socket worker whose JNIEnv
    // is not the one this backend holds. An empty answer is the honest one
    // until the surface can hop; a JNI call on the wrong thread is undefined
    // and CheckJNI aborts on it. See agent_android's MANIFEST §2.
    if !e::on_ui_thread() { return out; }
    let kind: u32 = core::kind_of(n);
    if kind != props::K_LIST && kind != tree::K_TREE { return out; }
    let env: rt::Env = e::env();

    // TWO WRAPPERS OVER ONE OBJECT: the scroll position is AdapterView's and the
    // children are ViewGroup's, and the generated binding emits no upcast
    // between them — `AdapterView<T>` is generic, and the generator only
    // upcasts to a superclass it saw in the same run.
    var lv: w::AdapterView = w::AdapterView::from_global(env, env.new_global_ref(v));
    let first: i32 = lv.get_first_visible_position();
    var group: w::ViewGroup = w::ViewGroup::from_global(env, env.new_global_ref(v));
    let count: i32 = group.get_child_count();
    var i: i32 = 0 as i32;
    while i < count {
        let cell: jni::jobject = group.get_child_at(i);
        if cell != (0 as jni::jobject) {
            let rn: *core::Node = cell_node(env, cell);
            if rn != (0 as *core::Node) {
                let _a: status::Status = out.append(
                    RealisedRow { node: { #addr(rn) }, position: first +% i });
            }
            env.delete_local_ref(cell);
        }
        i = i +% (1 as i32);
    }
    let _k1: *u8 = group.into_raw();
    let _k2: *u8 = lv.into_raw();
    return out;
}

// A row's name on the agent surface.
//
// A TREE has one by construction: `row_id` exists because a row is content
// mounted inside a cell the backend owns, so nothing the application writes
// ever names the row itself. A LIST has none — its rows carry app-keyed
// controls INSIDE them, which is the accident facet's own comment describes —
// so a list row is unnamed here and agent_core gives it a positional auto-id.
fn row_identity(n: *core::Node, position: i32) -> text::Text {
    if core::kind_of(n) != tree::K_TREE { return text::new(); }
    let p: *tree::TreeProps = tree_props(n);
    if p == (0 as *tree::TreeProps) { return text::new(); }
    let f: fn(*tree::TreeNode, *u8) -> text::Text = { (*p).row_id };
    if f == tree::no_row_id { return text::new(); }
    match row_at(n, position) {
        option::Option[VisibleRow]::Some(r) => {
            var ctx: *u8 = { (*p).row_id_ctx };
            if ctx == (0 as *u8) { ctx = { (*p).ctx }; }
            return f({ r.node as *tree::TreeNode }, ctx);
        }
        option::Option[VisibleRow]::None => { return text::new(); }
    }
}

// A row's tap, by the same door a finger uses.
fn tap_row(n: *core::Node, position: i32) {
    row_tapped({ #addr(n) as i64 }, position);
    return;
}

// ---- what is on screen ---------------------------------------------------------
// One callback carries four of facet's verbs, and they are computed here rather
// than asked for separately because Android reports them together.
//
// THE PREVIOUS WINDOW HAS TO BE REMEMBERED to turn a range into EVENTS: a row
// appeared if it is visible now and was not, and disappeared the other way
// round. There is no field on ListProps for it, so it lives in a small table
// keyed by node — eight slots, because a screen with nine live lists on it is
// not a shape this backend has met, and the ninth costs a duplicate appearing
// event rather than anything worse.

const WINDOWS: usize = 8 as usize;
static WIN_NODE: [usize; 8] = [0 as usize; 8];
static WIN_FIRST: [i32; 8] = [0 as i32; 8];
// -2 as a literal is not spellable in a static initializer, and -1 would be a
// legitimate "empty window" — so an EMPTY window is `first > last`, which
// zero-and-minus-one already is. Both start zeroed and `WIN_LAST` is set to -1
// on first use, below.
static WIN_LAST: [i32; 8] = [0 as i32; 8];
static WIN_SEEN: [bool; 8] = [false; 8];

fn window_slot(n: *core::Node) -> usize {
    let key: usize = { #addr(n) };
    var i: usize = 0 as usize;
    while i < WINDOWS {
        if WIN_NODE[i] == key { return i; }
        i = i +% (1 as usize);
    }
    i = 0 as usize;
    while i < WINDOWS {
        if WIN_NODE[i] == (0 as usize) {
            WIN_NODE[i] = key;
            WIN_SEEN[i] = false;
            return i;
        }
        i = i +% (1 as usize);
    }
    // Full: the oldest slot is taken. A duplicate `on_item_appearing` is the
    // whole cost.
    WIN_NODE[0 as usize] = key;
    WIN_SEEN[0 as usize] = false;
    return 0 as usize;
}

fn rows_visible(token: i64, first: i32, visible: i32, total: i32) {
    let n: *core::Node = { token as *core::Node };
    if n == (0 as *core::Node) { return; }
    let p: *props::ListProps = list_props(n);
    if p == (0 as *props::ListProps) { return; }
    let v: *u8 = core::view_of(n);

    let h: fn(*u8, *u8) = { (*p).observe_scrolled };
    if h != props::no_handler { h(v, { (*p).observe_scrolled_ctx }); }

    // APPEARED AND DISAPPEARED, from the two windows. Android reports a RANGE,
    // so the events are its edges — and a list scrolled a whole screen in one
    // frame fires for every row that crossed, which is what the verbs mean.
    let last: i32 = first +% visible -% (1 as i32);
    let slot: usize = window_slot(n);
    // THE FIRST REPORT HAS NO PREVIOUS WINDOW, and an empty one is what makes
    // every visible row "appear" — which is right: they did.
    var was_first: i32 = WIN_FIRST[slot];
    var was_last: i32 = WIN_LAST[slot];
    if !WIN_SEEN[slot] {
        was_first = 0 as i32;
        was_last = (0 as i32) -% (1 as i32);
        WIN_SEEN[slot] = true;
    }
    WIN_FIRST[slot] = first;
    WIN_LAST[slot] = last;
    if visible > (0 as i32) {
        fire_range(p, v, first, last, was_first, was_last, true);
        fire_range(p, v, was_first, was_last, first, last, false);
    }

    // WHAT IS NOT HERE: `on_remaining_items_threshold_reached`, which is
    // ItemsViewProps' — a `collection`'s and a `table`'s, not a list's. facet's
    // ListProps declares no threshold, so there is nothing to compare `total`
    // against and the tail event belongs to the kinds that carry it.
    return;
}

// Every index in [lo, hi] that is NOT in [other_lo, other_hi], fired as one of
// the two appearance handlers.
fn fire_range(p: *props::ListProps, v: *u8, lo: i32, hi: i32,
              other_lo: i32, other_hi: i32, appearing: bool) {
    if hi < lo { return; }
    var h: fn(*u8, *u8) = { (*p).on_item_disappearing };
    var ctx: *u8 = { (*p).on_item_disappearing_ctx };
    if appearing {
        h = { (*p).on_item_appearing };
        ctx = { (*p).on_item_appearing_ctx };
    }
    if h == props::no_handler { return; }
    var i: i32 = lo;
    while i <= hi {
        if i < other_lo || i > other_hi { h(v, ctx); }
        i = i +% (1 as i32);
    }
    return;
}

// A LIST'S SEPARATOR: a divider drawable and its height. `Separator::None` is
// height ZERO with a transparent divider — a null drawable alone leaves the
// theme's height behind it, which is a gap where the line used to be.
fn apply_separator(env: rt::Env, v: *u8, p: *props::ListProps) {
    var lv: w::ListView = w::ListView::from_global(env, env.new_global_ref(v));
    let shown: bool = match { (*p).separator } {
        vocab::Separator::None => false,
        vocab::Separator::Default => true,
    };
    if !shown {
        lv.set_divider(0 as jni::jobject);
        lv.set_divider_height(0 as i32);
        let _k0: *u8 = lv.into_raw();
        return;
    }
    let c: vocab::Color = { (*p).separator_color };
    if c.is_set() {
        var d: w::ColorDrawable = w::ColorDrawable::new_i(env, paint::argb_of(c));
        var drawable: w::Drawable = d.as_drawable();
        lv.set_divider(drawable.into_raw());
        let _kd: *u8 = d.into_raw();
    }
    // ONE PIXEL, not one facet unit: a hairline is a device pixel everywhere
    // else in this backend and a divider is a hairline.
    lv.set_divider_height(1 as i32);
    let _k: *u8 = lv.into_raw();
    return;
}
