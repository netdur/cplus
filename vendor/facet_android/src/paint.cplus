// The shared band — the props every node carries, applied the same way whatever
// the control is. facet_appkit and facet_uikit both keep this apart from the
// per-kind bodies for the same reason: a background colour means the same thing
// on a label and on a box, and writing it twice is how the two drift.

import "stdlib/option" as option;
import "jni/jni" as jni;
import "android_view/runtime" as rt;
import "android_view/widgets" as w;
import "facet/facet" as core;
import "facet/props" as props;
import "facet/vocabulary" as vocab;
import "./env" as e;
import "facet/theme" as theme;

// Every bit set. `create` configures a view WHOLE by calling the same body with
// this, so a control cannot be correct on mount and wrong on its first update.
// It is also what an Activity recreation replays — see window.cplus, where it
// is the difference between a restored screen and one showing construction
// defaults.
fn all_bits() -> u64 { return props::C_ALL_STATE; }

// A facet Color -> Android's packed ARGB int (A<<24|R<<16|G<<8|B).
//
// Built arithmetically on purpose: an integer literal wraps through i32 before
// `as`, so a shifted 0xFF000000 written as a literal is not the mask it looks
// like. The repo CLAUDE.md names this as a thing that costs hours.
// A COLOUR IS USUALLY A TOKEN, NOT A NUMBER, and reading `r`/`g`/`b` off one
// gives 0,0,0,0 — transparent black. That is what this did, and it is why every
// themed surface on this backend painted nothing at all while literal colours
// looked fine: `vocab::Color` carries a `token`, and only token 255 means "the
// rgba fields are the answer".
//
// Four kinds resolve before the numbers mean anything:
//
//   100..117  a THEME ROLE — the application's palette, or facet's fallback
//   200..217  a DERIVED INK — a role read against what it sits on
//   254       an ADAPTIVE PAIR — one side per appearance
//   1..24     a PLATFORM token — a system colour by name
//
// The order is facet_appkit's, because a role must substitute BEFORE anything
// else looks at the token.
fn argb_of(c: vocab::Color) -> i32 {
    return argb_resolved(c, 0 as i32);
}

// `depth` guards the one cycle that can happen: a role whose fallback is
// another role. facet_appkit keeps the same counter.
fn argb_resolved(c: vocab::Color, depth: i32) -> i32 {
    if depth > (4 as i32) { return literal_argb(c); }
    var cc: vocab::Color = c;

    // `ink(a)` carries its own alpha, and the role substitution is about to
    // throw the whole colour away — so the mark's alpha is kept first.
    var mark_alpha: f64 = -1.0f64;
    if { cc.token } == (104 as u32) {
        if { c.a } < 1.0f64 { mark_alpha = { c.a }; }
    }

    if cc.is_theme_role() {
        var slot: vocab::Color = theme::theme_slot({ cc.token });
        if !slot.is_set() { slot = theme::theme_fallback({ cc.token }); }
        cc = slot;
    }

    // A DERIVED INK IS THE CONTRAST OF ITS BASE, not the base. `on(surface)`
    // means "the ink that belongs ON surface" — resolving it to surface itself
    // paints text the colour of the thing behind it, which is what this did: a
    // whole demo of dark-grey words on a near-black card, each half correct and
    // the pair invisible.
    //
    // AppKit has a real answer (`ink_over`, reading the effective appearance).
    // Android has none, so the base's luminance decides: light base, dark ink;
    // dark base, light ink. A reduction, and recorded as one in MANIFEST §1.
    if cc.is_derived_ink() {
        let base: i32 = argb_resolved(cc.derived_ink_base(), depth +% (1 as i32));
        var out: i32 = ink_over(base);
        if mark_alpha >= 0.0f64 { out = with_alpha(out, mark_alpha); }
        return out;
    }

    let t: u32 = { cc.token };

    // The adaptive pair: the side for THIS appearance, which is the whole
    // point of it.
    if t == (254 as u32) {
        if e::is_dark_cached() {
            return pack({ cc.r2 }, { cc.g2 }, { cc.b2 }, { cc.a2 });
        }
        return pack({ cc.r }, { cc.g }, { cc.b }, { cc.a });
    }

    if t == (255 as u32) {
        if mark_alpha >= 0.0f64 { return pack({ cc.r }, { cc.g }, { cc.b }, mark_alpha); }
        return literal_argb(cc);
    }
    if t == (0 as u32) { return 0 as i32; }

    // A PLATFORM token — a system colour by name. Android's are resources on a
    // theme rather than constants, and reading them means a Resources round
    // trip per colour per paint; these are the Material palette's own values,
    // which is what those resources resolve to on a stock theme. §1.
    var out: i32 = platform_argb(t);
    if mark_alpha >= 0.0f64 { out = with_alpha(out, mark_alpha); }
    return out;
}

// The ink that reads against `base`. Rec. 601 luma — the cheap approximation
// everyone uses for exactly this question, and right about every colour a UI
// actually paints on.
fn ink_over(base: i32) -> i32 {
    let r: i32 = (base >> (16 as i32)) & (255 as i32);
    let g: i32 = (base >> (8 as i32)) & (255 as i32);
    let b: i32 = base & (255 as i32);
    let luma: i32 = ((r *% (299 as i32)) +% (g *% (587 as i32)) +% (b *% (114 as i32)))
                    / (1000 as i32);
    if luma > (140 as i32) { return pack(0.05f64, 0.05f64, 0.07f64, 1.0f64); }
    return pack(0.95f64, 0.95f64, 0.97f64, 1.0f64);
}

fn literal_argb(c: vocab::Color) -> i32 {
    return pack({ c.r }, { c.g }, { c.b }, { c.a });
}

fn pack(r: f64, g: f64, b: f64, a: f64) -> i32 {
    let ai: i32 = { (a * 255.0f64) as i32 };
    let ri: i32 = { (r * 255.0f64) as i32 };
    let gi: i32 = { (g * 255.0f64) as i32 };
    let bi: i32 = { (b * 255.0f64) as i32 };
    return (ai *% (16777216 as i32)) +% (ri *% (65536 as i32))
         +% (gi *% (256 as i32)) +% bi;
}

fn with_alpha(argb: i32, a: f64) -> i32 {
    let ai: i32 = { (a * 255.0f64) as i32 };
    let rgb: i32 = argb & (16777215 as i32);
    return (ai *% (16777216 as i32)) +% rgb;
}

// Light and dark for each platform token. Two tables rather than one, because a
// label that is near-black on a light theme has to be near-white on a dark one
// — a single table would make every system colour wrong on one appearance.
fn platform_argb(t: u32) -> i32 {
    let dark: bool = e::is_dark_cached();
    if t == (1 as u32) { if dark { return pack(0.90f64,0.90f64,0.92f64,1.0f64); } return pack(0.05f64,0.05f64,0.07f64,1.0f64); }
    if t == (2 as u32) { if dark { return pack(0.68f64,0.68f64,0.72f64,1.0f64); } return pack(0.33f64,0.33f64,0.37f64,1.0f64); }
    if t == (3 as u32) { return pack(0.00f64,0.48f64,1.00f64,1.0f64); }
    if t == (4 as u32) { return pack(0.96f64,0.26f64,0.21f64,1.0f64); }
    if t == (5 as u32) { return pack(0.30f64,0.69f64,0.31f64,1.0f64); }
    if t == (6 as u32) { return pack(0.13f64,0.59f64,0.95f64,1.0f64); }
    if t == (7 as u32) { return pack(1.00f64,0.60f64,0.00f64,1.0f64); }
    if t == (8 as u32) { return pack(0.56f64,0.56f64,0.58f64,1.0f64); }
    if t == (9 as u32) { if dark { return pack(0.50f64,0.50f64,0.54f64,1.0f64); } return pack(0.55f64,0.55f64,0.58f64,1.0f64); }
    if t == (10 as u32) { if dark { return pack(1.0f64,1.0f64,1.0f64,0.16f64); } return pack(0.0f64,0.0f64,0.0f64,0.12f64); }
    if t == (11 as u32) { if dark { return pack(0.07f64,0.07f64,0.09f64,1.0f64); } return pack(0.98f64,0.98f64,0.98f64,1.0f64); }
    if t == (12 as u32) { if dark { return pack(0.04f64,0.04f64,0.05f64,1.0f64); } return pack(0.93f64,0.93f64,0.94f64,1.0f64); }
    if t == (13 as u32) { if dark { return pack(0.11f64,0.11f64,0.13f64,1.0f64); } return pack(1.0f64,1.0f64,1.0f64,1.0f64); }
    if t == (14 as u32) { if dark { return pack(1.0f64,1.0f64,1.0f64,0.10f64); } return pack(0.0f64,0.0f64,0.0f64,0.06f64); }
    if t == (15 as u32) { return pack(0.56f64,0.56f64,0.58f64,1.0f64); }
    if t == (16 as u32) { return pack(0.13f64,0.45f64,0.85f64,1.0f64); }
    if t == (17 as u32) { return pack(0.13f64,0.59f64,0.95f64,1.0f64); }
    if t == (18 as u32) { return pack(0.13f64,0.59f64,0.95f64,0.35f64); }
    if t == (19 as u32) { if dark { return pack(1.0f64,1.0f64,1.0f64,0.06f64); } return pack(0.0f64,0.0f64,0.0f64,0.04f64); }
    if t == (20 as u32) { return pack(1.00f64,0.84f64,0.00f64,1.0f64); }
    if t == (21 as u32) { return pack(0.61f64,0.15f64,0.69f64,1.0f64); }
    if t == (22 as u32) { return pack(0.91f64,0.12f64,0.39f64,1.0f64); }
    if t == (23 as u32) { return pack(0.00f64,0.59f64,0.65f64,1.0f64); }
    if t == (24 as u32) { return pack(0.25f64,0.32f64,0.71f64,1.0f64); }
    // UNKNOWN IS NOT TRANSPARENT. A token this backend has never heard of paints
    // the label colour, which is visible and obviously wrong — the failure mode
    // that gets fixed rather than the one that gets shipped.
    if dark { return pack(0.90f64,0.90f64,0.92f64,1.0f64); }
    return pack(0.05f64,0.05f64,0.07f64,1.0f64);
}

// Copy a `str` into a NUL-terminated buffer.
//
// Needed because the two disagree: a `str` is a borrowed {ptr, len} with no
// terminator, and `NewStringUTF` reads until NUL. Handing it a bare `#str_ptr`
// reads past the end into whatever follows — which is exactly the kind of bug
// that looks like a JVM problem.
fn cstr(s: str, buf: *u8, cap: usize) -> bool {
    let n: usize = s.count();
    if (n +% (1 as usize)) > cap { return false; }
    let src: *u8 = { #str_ptr(s) };
    var i: usize = 0 as usize;
    while i < n {
        let d: *u8 = { ({ #addr(buf) } +% i) as *u8 };
        let p: *u8 = { ({ #addr(src) } +% i) as *u8 };
        { (*d) = (*p) };
        i = i +% (1 as usize);
    }
    let term: *u8 = { ({ #addr(buf) } +% n) as *u8 };
    { (*term) = 0 as u8 };
    return true;
}

// A NON-OWNING wrapper over a view facet already owns.
//
// The generated wrappers own a global ref and free it on drop, which is right
// for a wrapper that made the view and wrong for one that merely borrows
// facet's. `into_raw` disarms the drop; every borrowed view in this backend goes
// through this pair so nobody has to remember.
fn wrap(v: *u8) -> w::View { return w::View::from_global(e::env(), v); }

fn unwrap_keep(take b: w::View) {
    var owned: w::View = b;
    let _kept: jni::jobject = owned.into_raw();
    return;
}

// Apply the shared band to any view.
fn configure(v: *u8, n: *core::Node, dirty: u64) {
    let env: rt::Env = e::env();
    var view: w::View = wrap(v);

    // ONE DRAWABLE FOR FOUR PROPS. A colour, a gradient, a corner radius and a
    // border are separate bits in facet and ONE `GradientDrawable` on Android —
    // `setBackgroundColor` can express only the first of them, and calling it
    // after building a drawable throws the drawable away. So any of the four
    // rebuilds the background whole.
    let deco: u64 = props::C_BACKGROUND_COLOR | props::C_BACKGROUND
                  | props::C_CORNER_RADIUS | props::C_CLIP;
    if (dirty & deco) != (0 as u64) { apply_decoration(env, v, n); }

    if (dirty & props::C_SHADOW) != (0 as u64) {
        // ELEVATION, which is Android's whole shadow model: a Material shadow
        // is derived from a view's height above the surface, not authored as an
        // offset, a radius and a colour. So facet's four fields collapse to one
        // number and MANIFEST §1 records what is lost — the colour above all,
        // which Android draws from the theme.
        let sh: vocab::Shadow = core::shadow(n);
        view.set_elevation({ e::px(sh.radius) as f32 });
    }

    if (dirty & props::C_TRANSFORM) != (0 as u64) {
        // SCALE and ROTATION are about the view's CENTRE by default on Android,
        // which is what facet means by them. Translation is in facet's units.
        view.set_rotation({ core::rotation(n) as f32 });
        view.set_rotation_x({ core::rotation_x(n) as f32 });
        view.set_rotation_y({ core::rotation_y(n) as f32 });
        let sc: f64 = core::scale(n);
        view.set_scale_x({ (core::scale_x(n) * sc) as f32 });
        view.set_scale_y({ (core::scale_y(n) * sc) as f32 });
        view.set_translation_x({ e::px(core::translation_x(n)) as f32 });
        view.set_translation_y({ e::px(core::translation_y(n)) as f32 });
    }
    if (dirty & props::C_OPACITY) != (0 as u64) {
        view.set_alpha({ core::opacity(n) as f32 });
    }
    if (dirty & props::C_IS_VISIBLE) != (0 as u64) {
        // INVISIBLE (4), never GONE (8): facet's `is_visible` is the hide that
        // KEEPS the node's space — flex's `display: none` is the other one, and
        // conflating them silently reflows the tree.
        view.set_visibility(visibility_of(n));
    }
    if (dirty & props::C_IS_ENABLED) != (0 as u64) {
        view.set_enabled(core::is_enabled(n));
    }

    // THE KEY. On the other two backends it is also the platform's
    // accessibilityIdentifier — one token, three jobs. Android has no such
    // property (MANIFEST.md §1), so it rides `setTag`, which is the identity
    // slot rather than the a11y one. Deliberately NOT contentDescription: that
    // is what a screen reader reads aloud, and an address is not a description.
    let k: str = { (*n).key() };
    if k != "" {
        var buf: [u8; 160] = #zero::[[u8; 160]]();
        let base: *u8 = { #addr_of(buf[0]) };
        if cstr(k, base, 160 as usize) {
            let js: jni::jstring = env.new_string_utf(base);
            view.set_tag_object(js);
            env.delete_local_ref(js);
        }
    }

    unwrap_keep(view);
    return;
}

// What a node's view should be showing, from BOTH rules that can hide it — and
// stated once, because two writers with two rules would fight.
//
// `is_visible` is the application's own IsVisible prop. `is_hidden` is flex's
// `Display::None`, which `mount::switch_to` sets on every parked pane: flex
// takes the node out of layout and gives it a zero frame, but a FacetHost does
// not clip its children — `setClipChildren(false)` — so the subtree goes on
// drawing at the frames it last had. Collapsed space, visible content: the
// parked screen sat on top of the one that replaced it.
//
// GONE rather than INVISIBLE for the display case: the node is out of layout,
// and INVISIBLE would leave Android reserving the space facet already gave
// away. The same distinction facet_appkit makes with `set_hidden`.
fn visibility_of(n: *core::Node) -> i32 {
    if core::is_hidden(n) { return 8 as i32; }
    // A STOPPED SPINNER IS GONE, and the rule lives HERE rather than in
    // `apply_spinner` because the frame walk rewrites visibility on every pass.
    // Two writers with two rules is not a style question: the walk ran after
    // the apply and put the stopped spinner straight back on screen.
    if core::kind_of(n) == props::K_SPINNER {
        let p: *props::SpinnerProps = spinner_props(n);
        if p != (0 as *props::SpinnerProps) {
            if !{ (*p).is_running } { return 8 as i32; }
        }
    }
    if !core::is_visible(n) { return 4 as i32; }
    return 0 as i32;
}

fn spinner_props(n: *core::Node) -> *props::SpinnerProps {
    let d: *core::Data = core::node_data(n);
    if d == (0 as *core::Data) { return 0 as *props::SpinnerProps; }
    if { (*d).kind } != props::K_SPINNER { return 0 as *props::SpinnerProps; }
    return { (*d).props } as *props::SpinnerProps;
}

// The background, corner radius, border and clip as ONE drawable.
//
// A solid colour could be `setBackgroundColor`, and that is what this did — but
// then a corner radius had nowhere to go, and setting the colour afterwards
// silently discards a drawable built for the radius. One builder for all of it
// is the only version that cannot half-apply.
fn apply_decoration(env: rt::Env, v: *u8, n: *core::Node) {
    let brush: vocab::Brush = core::background(n);
    let flat: vocab::Color = core::background_color(n);
    let corners: vocab::Corners = core::corner_radius(n);
    let radius: f64 = corners.top_leading;
    let has_radius: bool = radius > 0.0f64;

    var view: w::View = wrap(v);
    if !brush.is_gradient && !flat.is_set() && !brush.start.is_set() && !has_radius {
        // NOTHING DECLARED. Clearing rather than leaving the last drawable is
        // what makes this idempotent — a node that loses its colour loses it.
        view.set_background(0 as jni::jobject);
        view.set_clip_to_outline(false);
        unwrap_keep(view);
        return;
    }

    var d: w::GradientDrawable = w::GradientDrawable::new_void(env);
    // A GRADIENT IS NOT BUILT — see MANIFEST §2. It needs two things this does
    // not have: `setColors` takes an `int[]`, and vendor/jni types no array
    // slots yet; and GradientDrawable takes an Orientation ENUM where facet's
    // Brush carries degrees, so the mapping would be a guess. The start colour
    // is used, which is at least the gradient's own first stop rather than an
    // invented average.
    var c: vocab::Color = flat;
    if !c.is_set() { c = brush.start; }
    if c.is_set() { d.set_color_i(argb_of(c)); }
    if has_radius { d.set_corner_radius({ e::px(radius) as f32 }); }

    var drawable: w::Drawable = d.as_drawable();
    view.set_background(drawable.into_raw());
    // CLIP TO THE OUTLINE, so a rounded background actually clips its children
    // rather than being a rounded rectangle with square content on top of it.
    view.set_clip_to_outline(has_radius);
    unwrap_keep(view);
    let _keep: *u8 = d.into_raw();
    return;
}

// ---- C string helpers --------------------------------------------------------
// `cstr` above writes them; these two read them back. Both exist because the
// JNI boundary deals in NUL-terminated bytes and facet deals in `str`, which
// carries its own length.

fn cstr_len(p: *u8) -> usize {
    var i: usize = 0 as usize;
    var going: bool = true;
    while going {
        let c: *u8 = { ({ #addr(p) } +% i) as *u8 };
        if { (*c) } == (0 as u8) { going = false; } else { i = i +% (1 as usize); }
    }
    return i;
}

fn same_cstr(a: *u8, b: *u8) -> bool {
    var i: usize = 0 as usize;
    var going: bool = true;
    var same: bool = true;
    while going {
        let pa: *u8 = { ({ #addr(a) } +% i) as *u8 };
        let pb: *u8 = { ({ #addr(b) } +% i) as *u8 };
        let ca: u8 = { (*pa) };
        let cb: u8 = { (*pb) };
        if ca != cb { same = false; going = false; }
        if going {
            if ca == (0 as u8) { going = false; } else { i = i +% (1 as usize); }
        }
    }
    return same;
}
