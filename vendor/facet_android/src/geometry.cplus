// The layout pass, and the frame walk that follows it.
//
// facet holds zero layout code and the Renderer has no geometry verb: the
// backend owns this. flex computes the frames; this module puts them on the
// Android views. Same division as facet_appkit, and the same optimisation is
// preserved — nothing is rebuilt, flex's incremental cache gets hits, and the
// walk prunes itself on the cache's verdict.
//
// Android is EASIER here than AppKit was: a View's coordinate space is
// top-left origin, the same as flex's, so there is no flip math anywhere. flex
// frames are ABSOLUTE in the root's space, so a child's native frame is simply
// `child.frame - host.frame` in origin.
//
// One Android-specific obligation: a View must be MEASURED before it is laid
// out, or its internal state (a TextView's text Layout, built in onMeasure) is
// never created and it draws nothing. So every placement is measure-then-layout
// with EXACTLY specs — the size is flex's answer, not the widget's.

import "stdlib/option" as option;
import "jni/jni" as jni;
import "flex_layout/flex_layout" as flex;
import "android_view/runtime" as rt;
import "android_view/widgets" as w;
import "facet/facet" as core;
import "./env" as e;
import "./paint" as paint;
import "./controls" as controls;
import "./dex" as dex;
import "facet/props" as props;
import "facet/split" as split;

type Node = flex::Node;

// MeasureSpec, read from the platform rather than hardcoded.
static MODE_EXACTLY: i32 = 0;
static MODE_AT_MOST: i32 = 0;
static MODES_READ: bool = false;

fn read_modes() {
    if MODES_READ { return; }
    MODES_READ = true;
    let env: rt::Env = e::env();
    let cls: jni::jclass = env.find_class(#str_ptr("android/view/View$MeasureSpec\0"));
    let f1: jni::jfieldID = env.static_field_id(cls, #str_ptr("EXACTLY\0"), #str_ptr("I\0"));
    let f2: jni::jfieldID = env.static_field_id(cls, #str_ptr("AT_MOST\0"), #str_ptr("I\0"));
    MODE_EXACTLY = { (*(*env.raw())).GetStaticIntField(env.raw(), cls, f1) };
    MODE_AT_MOST = { (*(*env.raw())).GetStaticIntField(env.raw(), cls, f2) };
    env.delete_local_ref(cls);
    return;
}

fn spec_exactly(size: i32) -> i32 { read_modes(); return size | MODE_EXACTLY; }
fn spec_at_most(size: i32) -> i32 { read_modes(); return size | MODE_AT_MOST; }

// Ask a view how big it wants to be. This is what flex's `set_measure` hook
// routes to for the kinds that have intrinsic size (a label, a button).
//
// A JNI round trip inside flex's layout pass is the one shape this backend has
// that the others do not, and it is the thing to watch if a large tree ever
// feels slow — a batched pre-measure sweep is the intended answer and is not
// built. Cheap enough at the sizes measured so far.
// flex's measure hook. `ctx` is the view, put there by `set_context` at create
// time.
//
// The modes matter: `Exactly` means flex has already decided that axis and the
// answer must be taken as given, `AtMost` is a bound to fit within, and
// `Undefined` is unbounded — which for a View means "measure at your natural
// size", spelled as an enormous AT_MOST rather than UNSPECIFIED, because a
// TextView given UNSPECIFIED lays its text out on ONE line however long it is.
// NaN is the only value that is not equal to itself, which is the whole test.
fn is_number(v: f64) -> bool { return v == v; }

fn measure_node(ctx: *u8, avail_w: f64, wm: flex::MeasureMode,
                avail_h: f64, hm: flex::MeasureMode) -> flex::Size {
    if ctx == (0 as *u8) { return flex::Size { width: 0.0f64, height: 0.0f64 }; }
    let big: f64 = 1000000.0f64;
    var w_spec: i32 = spec_at_most({ big as i32 });
    var h_spec: i32 = spec_at_most({ big as i32 });
    // AN UNDEFINED AVAILABLE SIZE IS NOT ZERO, and conflating the two is a
    // silent, total failure.
    //
    // flex's `undefined()` is NaN, and `NaN as i32` is 0 — so a mode of AtMost
    // with an undefined extent turned into `AT_MOST(0)`, which asks a view to
    // fit in nothing. Every child then measured to height 0. It never showed
    // while the root had a definite height, because then every extent handed
    // down is a real number; it appeared the moment something was laid out
    // UNBOUNDED, which is exactly what a recycled row is — `calculate_layout`
    // with a width and no height, so the row can be as tall as its content.
    // Two hundred rows of nothing, and the measure looked like it was working
    // because the WIDTHS were right.
    //
    // A NaN is the only value not equal to itself, which is the whole test.
    // The extents arrive in facet's units and a MeasureSpec is in pixels.
    if is_number(avail_w) {
        match wm {
            flex::MeasureMode::Exactly => { w_spec = spec_exactly({ px(avail_w) as i32 }); }
            flex::MeasureMode::AtMost => { w_spec = spec_at_most({ px(avail_w) as i32 }); }
            flex::MeasureMode::Undefined => { }
        }
    }
    if is_number(avail_h) {
        match hm {
            flex::MeasureMode::Exactly => { h_spec = spec_exactly({ px(avail_h) as i32 }); }
            flex::MeasureMode::AtMost => { h_spec = spec_at_most({ px(avail_h) as i32 }); }
            flex::MeasureMode::Undefined => { }
        }
    }
    var view: w::View = paint::wrap(ctx);
    view.measure(w_spec, h_spec);
    let mw: i32 = view.get_measured_width();
    let mh: i32 = view.get_measured_height();
    paint::unwrap_keep(view);
    // And the answer comes back in pixels, which flex must not see.
    return flex::Size { width: dp({ mw as f64 }), height: dp({ mh as f64 }) };
}

fn measure_intrinsic(v: *u8, max_w: f64, max_h: f64) -> flex::Size {
    var view: w::View = paint::wrap(v);
    view.measure(spec_at_most({ max_w as i32 }), spec_at_most({ max_h as i32 }));
    let mw: i32 = view.get_measured_width();
    let mh: i32 = view.get_measured_height();
    paint::unwrap_keep(view);
    return flex::Size { width: { mw as f64 }, height: { mh as f64 } };
}

// The density boundary lives in `env` — see `env::px`. Re-exported here because
// this file is where most of the crossings are.
fn px(v: f64) -> f64 { return e::px(v); }
fn dp(v: f64) -> f64 { return e::dp(v); }

fn place(v: *u8, x: f64, y: f64, wd: f64, ht: f64) {
    var view: w::View = paint::wrap(v);
    let iw: i32 = { px(wd) as i32 };
    let ih: i32 = { px(ht) as i32 };
    let ix: i32 = { px(x) as i32 };
    let iy: i32 = { px(y) as i32 };
    // MEASURE THEN LAYOUT, always. A View that was never measured has no
    // internal layout — a TextView builds its text Layout in onMeasure — and
    // draws nothing at whatever rect it is given.
    view.measure(spec_exactly(iw), spec_exactly(ih));
    view.layout(ix, iy, ix +% iw, iy +% ih);
    paint::unwrap_keep(view);
    return;
}

// A scroll's DOCUMENT, sized to what it holds.
//
// The document is a second view inside the scroll's own, and nothing in facet's
// tree corresponds to it — so nothing else in this walk would ever place it, and
// an unplaced FacetHost is zero by zero. The rule is facet_gtk's, ported whole:
// the union of the children, and never SMALLER than the viewport, because a
// document short of its scroll leaves a strip nothing draws.
//
// Sized at the origin: the children are placed against the scroll's frame
// already, and the document shares that origin.
fn size_document(n: *core::Node, v: *u8, frame: flex::Frame) {
    if core::kind_of(n) != props::K_SCROLL { return; }
    let doc: *u8 = controls::document_host(v);
    if doc == v { return; }
    let e_size: flex::Size = content_extent(n, frame);
    // TOLD BEFORE PLACED. `place` measures EXACTLY, which is right — but the
    // ScrollView will measure this same child AGAIN on its own terms, with an
    // UNSPECIFIED height, and take THAT as the scroll range. The host has to be
    // able to answer that question on its own.
    if e::have_env() {
        dex::host_set_wanted(e::env(), doc, { px(e_size.width) as i32 }, { px(e_size.height) as i32 });
    }
    place(doc, 0.0f64, 0.0f64, e_size.width, e_size.height);
    if !e::have_env() { return; }
    e::env().delete_global_ref(doc);
    return;
}

fn content_extent(node: *core::Node, frame: flex::Frame) -> flex::Size {
    var wd: f64 = 0.0f64;
    var ht: f64 = 0.0f64;
    var i: usize = 0 as usize;
    let count: usize = core::child_count_of(node);
    while i < count {
        match core::child_of(node, i) {
            option::Option[*core::Node]::Some(c) => {
                let cf: flex::Frame = core::frame_of(c);
                let right: f64 = (cf.left - frame.left) + cf.width;
                let bottom: f64 = (cf.top - frame.top) + cf.height;
                if right > wd { wd = right; }
                if bottom > ht { ht = bottom; }
            }
            option::Option[*core::Node]::None => { }
        }
        i = i +% (1 as usize);
    }
    if wd < frame.width { wd = frame.width; }
    if ht < frame.height { ht = frame.height; }
    return flex::Size { width: wd, height: ht };
}

// Re-run the layout for a root at a given size, then push every frame.
fn relayout_root(root: *core::Node, width: f64, height: f64) {
    if root == (0 as *core::Node) { return; }
    // THE ROOT FILLS ITS WINDOW, stated as style rather than assumed.
    //
    // `calculate_layout` takes the AVAILABLE space, not the size — a root whose
    // height is `auto` still sizes to its content. That is invisible while
    // every root is a column of leaves, and wrong the moment one is a `scroll`:
    // the scroll grew to the height of what it held (2979 against a 2593 screen
    // in the probe), so the ScrollView had exactly nothing to scroll and the
    // page simply ran off the bottom of the window.
    { (*root).set_width(flex::StyleLength::points(width)) };
    { (*root).set_height(flex::StyleLength::points(height)) };
    { (*root).calculate_layout(width, height) };
    // THE SPLITS, WHICH READ THEIR OWN EXTENT. A split's clamps are against the
    // box its parent gave it, so the division cannot be written until there has
    // been a layout — and writing it changes styles, so there has to be another.
    // Twice is enough in practice and bounded on principle: the second pass
    // only re-clamps against an extent the first pass fixed.
    var pass: i32 = 0 as i32;
    while pass < (2 as i32) {
        if !settle_splits(root) { pass = 2 as i32; }
        else {
            { (*root).calculate_layout(width, height) };
            pass = pass +% (1 as i32);
        }
    }
    reposition(root);
    return;
}

// Every split in the tree, settled against the extent it was just given.
// Answers whether any style was written, which is what makes the loop above
// terminate on the pass that changed nothing.
fn settle_splits(node: *core::Node) -> bool {
    if node == (0 as *core::Node) { return false; }
    var wrote: bool = false;
    if core::kind_of(node) == split::K_SPLIT {
        let p: *split::SplitProps = controls::split_props(node);
        if p != (0 as *split::SplitProps) {
            if controls::settle_split(node, p) { wrote = true; }
        }
    }
    var i: usize = 0 as usize;
    let count: usize = core::child_count_of(node);
    while i < count {
        match core::child_of(node, i) {
            option::Option[*core::Node]::Some(c) => {
                if settle_splits(c) { wrote = true; }
            }
            option::Option[*core::Node]::None => { }
        }
        i = i +% (1 as usize);
    }
    return wrote;
}

// A split's divider sits ON the seam where the leading pane ends — this
// package's own view rather than one of facet's children, so nothing else in
// the frame walk places it. Drawn on the seam and not between the panes:
// `position` is the distance from the leading edge to the divider, and taking
// a thickness out of a pane would make the panes disagree with the number the
// application set and reads back.
fn place_split_divider(n: *core::Node, v: *u8, frame: flex::Frame) {
    if core::kind_of(n) != split::K_SPLIT { return; }
    let p: *split::SplitProps = controls::split_props(n);
    if p == (0 as *split::SplitProps) { return; }
    let thick: f64 = { (*p).divider_thickness };
    if thick <= 0.0f64 { return; }
    let bar: jni::jobject = controls::divider_of(v);
    if bar == (0 as jni::jobject) { return; }
    // Where the LEADING PANE ENDS, read from the pane rather than from the
    // props: the position the application asked for is not the one that landed
    // when a minimum or the split's own extent clamped it, and the line has to
    // be where the panes actually parted.
    var at: f64 = 0.0f64;
    match core::child_of(n, 0 as usize) {
        option::Option[*core::Node]::Some(lead) => {
            let lf: flex::Frame = core::frame_of(lead);
            match { (*p).axis } {
                split::SplitAxis::Columns => { at = (lf.left - frame.left) + lf.width; }
                split::SplitAxis::Rows => { at = (lf.top - frame.top) + lf.height; }
            }
        }
        option::Option[*core::Node]::None => { }
    }
    match { (*p).axis } {
        split::SplitAxis::Columns => { place(bar, at, 0.0f64, thick, frame.height); }
        split::SplitAxis::Rows => { place(bar, 0.0f64, at, frame.width, thick); }
    }
    if e::have_env() { e::env().delete_local_ref(bar); }
    return;
}

// The frame walk. A node WITH a view is placed and becomes the host for its
// subtree; a node WITHOUT one contributes nothing of its own and its children
// are placed against the same host — which is exactly how a pure-layout column
// inside a real scroll view costs no view.
fn reposition(root: *core::Node) {
    if root == (0 as *core::Node) { return; }
    let f: flex::Frame = core::frame_of(root);
    // THE ROOT'S OWN VIEW, which the walk below never reaches: it places
    // CHILDREN. This was invisible for as long as every root was a keyless
    // column — a viewless root contributes nothing to place, and
    // `add_root_views` hands its backed descendants to the Activity's host
    // directly. The moment an app makes its whole page one `scroll`, which is
    // the ordinary shape on a phone, the root HAS a view, nothing measures or
    // lays it out, and the screen is blank with nothing in the log.
    let rv: *u8 = core::view_of(root);
    if rv != (0 as *u8) { place(rv, f.left, f.top, f.width, f.height); }
    // And its document, for the same reason one layer down.
    size_document(root, rv, f);
    if rv != (0 as *u8) { place_split_divider(root, rv, f); }
    reposition_children(root, f);
    return;
}

fn reposition_children(node: *core::Node, host_abs: flex::Frame) {
    var i: usize = 0 as usize;
    let count: usize = core::child_count_of(node);
    while i < count {
        match core::child_of(node, i) {
            option::Option[*core::Node]::Some(c) => {
                let cf: flex::Frame = core::frame_of(c);
                let v: *u8 = core::view_of(c);
                if v != (0 as *u8) {
                    // A PARKED PANE HAS TO BE TOLD, every pass. `Display::None`
                    // gives it a zero frame and a FacetHost does not clip, so
                    // its subtree draws on at the rects it last had — see
                    // paint::visibility_of. This is the frame walk's business
                    // rather than apply's because nothing marks a node dirty
                    // when its DISPLAY changes.
                    var vw: w::View = paint::wrap(v);
                    vw.set_visibility(paint::visibility_of(c));
                    paint::unwrap_keep(vw);
                    // Host-relative: flex frames are absolute in the root's
                    // space, so subtract the host's origin.
                    place(v, cf.left - host_abs.left, cf.top - host_abs.top, cf.width, cf.height);
                    size_document(c, v, cf);
                    place_split_divider(c, v, cf);
                    reposition_children(c, cf);
                } else {
                    // Viewless: pass the SAME host down, so a keyless container
                    // does not shift its children's coordinate space.
                    reposition_children(c, host_abs);
                }
            }
            option::Option[*core::Node]::None => { }
        }
        i = i +% (1 as usize);
    }
    return;
}
