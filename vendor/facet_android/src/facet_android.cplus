export extern fn facet_android_time_set(envp: *jni::JNIEnv, cls: jni::jobject, token: i64,
                                        hour: i32, minute: i32) {
    e::set_env(rt::from_native(envp));
    controls::fire_time_set(token, hour, minute);
    return;
}

export extern fn facet_android_time_opened(envp: *jni::JNIEnv, cls: jni::jobject, token: i64) {
    e::set_env(rt::from_native(envp));
    controls::fire_time_edge(token, true);
    return;
}

export extern fn facet_android_time_dismissed(envp: *jni::JNIEnv, cls: jni::jobject,
                                              token: i64) {
    e::set_env(rt::from_native(envp));
    controls::fire_time_edge(token, false);
    return;
}

export extern fn facet_android_date_set(envp: *jni::JNIEnv, cls: jni::jobject, token: i64,
                                        y: i32, m: i32, d: i32) {
    e::set_env(rt::from_native(envp));
    controls::fire_date_set(token, y, m, d);
    return;
}

export extern fn facet_android_date_opened(envp: *jni::JNIEnv, cls: jni::jobject, token: i64) {
    e::set_env(rt::from_native(envp));
    controls::fire_date_edge(token, true);
    return;
}

export extern fn facet_android_date_dismissed(envp: *jni::JNIEnv, cls: jni::jobject, token: i64) {
    e::set_env(rt::from_native(envp));
    controls::fire_date_edge(token, false);
    return;
}

export extern fn facet_android_intercept(envp: *jni::JNIEnv, cls: jni::jobject, token: i64,
                                         action: i32, x: f32, y: f32) -> u8 {
    e::set_env(rt::from_native(envp));
    if swipe::intercept(token, action, x, y) { return 1 as u8; }
    return 0 as u8;
}

export extern fn facet_android_touch(envp: *jni::JNIEnv, cls: jni::jobject, token: i64,
                                     action: i32, x: f32, y: f32) -> u8 {
    e::set_env(rt::from_native(envp));
    if swipe::touch(token, action, x, y) { return 1 as u8; }
    return 0 as u8;
}

export extern fn facet_android_job(envp: *jni::JNIEnv, cls: jni::jobject) {
    e::set_env(rt::from_native(envp));
    mainthread::run_pending();
    return;
}

export extern fn facet_android_row_count(envp: *jni::JNIEnv, cls: jni::jobject, token: i64) -> i32 {
    e::set_env(rt::from_native(envp));
    return recycler::row_count(token);
}

export extern fn facet_android_row_view(envp: *jni::JNIEnv, cls: jni::jobject, token: i64,
                                        position: i32, convert: jni::jobject,
                                        parent: jni::jobject) -> jni::jobject {
    e::set_env(rt::from_native(envp));
    return recycler::row_view(token, position, convert, parent);
}

export extern fn facet_android_row_tapped(envp: *jni::JNIEnv, cls: jni::jobject, token: i64,
                                          position: i32) {
    e::set_env(rt::from_native(envp));
    recycler::row_tapped(token, position);
    return;
}

export extern fn facet_android_size_changed(envp: *jni::JNIEnv, cls: jni::jobject, wd: i32, ht: i32) {
    e::set_env(rt::from_native(envp));
    window::size_changed(wd, ht);
    return;
}
