// facet_android app_dirs — where this app keeps its files (spendwise S42).
//
// MAUI's FileSystem.AppDataDirectory and CacheDirectory: on Android,
// `Context.getFilesDir()` and `Context.getCacheDir()`. Both are private to the
// app, exist already, and need no permission. Nothing else on this platform
// is writable by an app: there is no HOME, no writable /tmp and no Library, so
// an app that guessed opened its database nowhere and its first save went
// nowhere with it. Guessing /data/data/<package>/files from /proc is wrong for
// a second user (/data/user/<n>/...), which is why the Context answers.

import "stdlib/option" as option;
import "stdlib/text" as text;
import "android_view/runtime" as rt;
import "jni/jni" as jni;
import "./env" as e;
import "./paint" as paint;

fn data_dir() -> option::Option[text::Text] {
    return context_dir(#str_ptr("getFilesDir\0"));
}

fn cache_dir() -> option::Option[text::Text] {
    return context_dir(#str_ptr("getCacheDir\0"));
}

// `getter` is a Context method answering a java.io.File.
fn context_dir(getter: *u8) -> option::Option[text::Text] {
    if !e::have_env() { return option::Option[text::Text]::None; }
    let ctx: jni::jobject = e::context();
    if ctx == (0 as jni::jobject) { return option::Option[text::Text]::None; }
    let env: rt::Env = e::env();
    let file: jni::jobject = env.call_object_0(ctx, #str_ptr("android/content/Context\0"), getter,
                                               #str_ptr("()Ljava/io/File;\0"));
    env.clear_exception();
    if file == (0 as jni::jobject) { return option::Option[text::Text]::None; }
    let js: jni::jobject = env.call_object_0(file, #str_ptr("java/io/File\0"),
                                             #str_ptr("getAbsolutePath\0"),
                                             #str_ptr("()Ljava/lang/String;\0"));
    env.clear_exception();
    env.delete_local_ref(file);
    if js == (0 as jni::jobject) { return option::Option[text::Text]::None; }
    var buf: [u8; 1024] = #zero::[[u8; 1024]]();
    let base: *u8 = { #addr_of(buf[0]) };
    let ok: bool = env.string_utf_into(js as jni::jstring, base, 1024 as usize);
    env.delete_local_ref(js);
    if !ok { return option::Option[text::Text]::None; }
    let n: usize = paint::cstr_len(base);
    if n == (0 as usize) { return option::Option[text::Text]::None; }
    return option::Option[text::Text]::Some(text::from_str({ #str_from_raw_parts(base, n) }));
}
