// THE WINDOW'S INSETS, in pixels, as {left, top, right, bottom}.
//
// `FacetActivity` is the one class NOT in this dex — the system instantiates
// the launch Activity before any of our code runs, so it is merged into the
// APK's own classes.dex — which is why this is looked up by name off the
// activity's own class rather than through a cached handle.
fn window_insets(env: rt::Env, host: jni::jobject) -> i64 {
    let cls: jni::jclass = env.class_cached(#str_ptr("cplus/facet/FacetActivity\0"));
    if cls == (0 as jni::jclass) { return 0 as i64; }
    let mid: jni::jmethodID = env.method_id_static(cls, #str_ptr("windowInsets\0"),
        #str_ptr("(Landroid/view/View;)J\0"));
    if mid == (0 as jni::jmethodID) { return 0 as i64; }
    var args: [jni::JValue; 1] = [jni::arg_object(host)];
    return { (*(*env.raw())).CallStaticLongMethodA(env.raw(), cls, mid, #addr_of(args[0])) };
}

