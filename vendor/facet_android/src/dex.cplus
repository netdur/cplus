    if C_DRAW == 0 { return 0 as jni::jobject; }
    let mid: jni::jmethodID = env.method_id_static({ C_DRAW as *u8 }, #str_ptr("iconFont\0"),
        #str_ptr("(Landroid/content/Context;Ljava/lang/String;I)Landroid/graphics/Typeface;\0"));
    if mid == (0 as jni::jmethodID) { return 0 as jni::jobject; }
    let js: jni::jstring = env.new_string_utf(path);
    var args: [jni::JValue; 3] = [jni::arg_object(ctx), jni::arg_object(js),
                                  jni::arg_int(fill)];
    let r: jni::jobject = { (*(*env.raw())).CallStaticObjectMethodA(env.raw(),
                                { C_DRAW as *u8 }, mid, #addr_of(args[0])) };
    env.delete_local_ref(js);
    env.clear_exception();
    return r;
}

