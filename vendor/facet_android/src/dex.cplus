// The package's own Java side, shipped as a precompiled DEX.
//
// Java interfaces and ViewGroup subclasses cannot be written from native code,
// so a handful of small classes have to exist on the JVM side: the
// do-nothing-layout host, the Choreographer tick, the delayed-post adapter, and
// one listener adapter per event shape a control reports — click, checked
// change, seek, text.
// They ship INSIDE this package (tools/build_dex.sh regenerates
// facet_android.dex; consumers never run it), are embedded here with
// `#include_bytes`, and are loaded at runtime with `InMemoryDexClassLoader`.
//
// The consequence is the point: an app using this backend ships NO Java beyond
// its own Activity. That is an unusual position for a UI framework, and it is
// the same instinct the rest of this repo has everywhere else.
//
// ART resolves a `native` method by symbol only through a classloader's own
// native-library namespace, which an in-memory loader does not have — so the
// natives are bound explicitly with `RegisterNatives`. This is not optional.

import "jni/jni" as jni;
import "android_view/runtime" as rt;

// Kept in step by tools/build_dex.sh; do not hand-edit.
const DEX_LEN: usize = 33716;

static LOADER: usize = 0;
static C_HOST: usize = 0;
static C_TICK: usize = 0;
static C_CLICK: usize = 0;
static C_POST: usize = 0;
static C_CHECKED: usize = 0;
static C_SEEK: usize = 0;
static C_TEXT: usize = 0;
static C_STEP: usize = 0;
static C_ROWS: usize = 0;
static C_ROWTAP: usize = 0;
static C_JOB: usize = 0;
static C_CANVAS: usize = 0;
static C_DRAW: usize = 0;
static C_SWIPE: usize = 0;
static C_DATE: usize = 0;
static C_EDIT: usize = 0;
static C_SCROLL: usize = 0;
static C_TOUCH: usize = 0;
static C_TIME: usize = 0;
static C_POPUP: usize = 0;
static C_WEB: usize = 0;
static C_ZOOM: usize = 0;
static C_CAROUSEL: usize = 0;
static C_BRIDGE: usize = 0;

// jni.h's JNINativeMethod with the fn slot concretely typed per shape.
#[repr(C)]
struct Native0 {
    opaque name: *u8,
    opaque signature: *u8,
    fn_ptr: fn(*jni::JNIEnv, jni::jobject),
}

#[repr(C)]
struct Native1L {
    opaque name: *u8,
    opaque signature: *u8,
    fn_ptr: fn(*jni::JNIEnv, jni::jobject, i64),
}

#[repr(C)]
struct Native2LZ {
    opaque name: *u8,
    opaque signature: *u8,
    // JNI's jboolean is an unsigned byte, not C+'s bool — the JVM passes 0 or 1
    // in a byte-wide slot and a wider `bool` would read the neighbouring bytes.
    fn_ptr: fn(*jni::JNIEnv, jni::jobject, i64, u8),
}

#[repr(C)]
struct Native2LI {
    opaque name: *u8,
    opaque signature: *u8,
    fn_ptr: fn(*jni::JNIEnv, jni::jobject, i64, i32),
}

#[repr(C)]
struct Native2LO {
    opaque name: *u8,
    opaque signature: *u8,
    fn_ptr: fn(*jni::JNIEnv, jni::jobject, i64, jni::jobject),
}

#[repr(C)]
struct NativeL_I {
    opaque name: *u8,
    opaque signature: *u8,
    fn_ptr: fn(*jni::JNIEnv, jni::jobject, i64) -> i32,
}

#[repr(C)]
struct NativeLIOO_O {
    opaque name: *u8,
    opaque signature: *u8,
    fn_ptr: fn(*jni::JNIEnv, jni::jobject, i64, i32, jni::jobject, jni::jobject) -> jni::jobject,
}

#[repr(C)]
struct Native3LZZ {
    opaque name: *u8,
    opaque signature: *u8,
    fn_ptr: fn(*jni::JNIEnv, jni::jobject, i64, u8, u8),
}

#[repr(C)]
struct Native3LII_B {
    opaque name: *u8,
    opaque signature: *u8,
    fn_ptr: fn(*jni::JNIEnv, jni::jobject, i64, i32, i32),
}

#[repr(C)]
struct Native3LII {
    opaque name: *u8,
    opaque signature: *u8,
    fn_ptr: fn(*jni::JNIEnv, jni::jobject, i64, i32, i32),
}

#[repr(C)]
struct Native4LIII {
    opaque name: *u8,
    opaque signature: *u8,
    fn_ptr: fn(*jni::JNIEnv, jni::jobject, i64, i32, i32, i32),
}

#[repr(C)]
struct NativeLIFF {
    opaque name: *u8,
    opaque signature: *u8,
    fn_ptr: fn(*jni::JNIEnv, jni::jobject, i64, i32, f32, f32),
}

#[repr(C)]
struct NativeLIFF_Z {
    opaque name: *u8,
    opaque signature: *u8,
    fn_ptr: fn(*jni::JNIEnv, jni::jobject, i64, i32, f32, f32) -> u8,
}

#[repr(C)]
struct Native2I {
    opaque name: *u8,
    opaque signature: *u8,
    fn_ptr: fn(*jni::JNIEnv, jni::jobject, i32, i32),
}

extern fn facet_android_tick(envp: *jni::JNIEnv, cls: jni::jobject);
extern fn facet_android_click(envp: *jni::JNIEnv, cls: jni::jobject, token: i64);
extern fn facet_android_after(envp: *jni::JNIEnv, cls: jni::jobject, token: i64);
extern fn facet_android_size_changed(envp: *jni::JNIEnv, cls: jni::jobject, w: i32, h: i32);
extern fn facet_android_checked(envp: *jni::JNIEnv, cls: jni::jobject, token: i64, on: u8);
extern fn facet_android_progress(envp: *jni::JNIEnv, cls: jni::jobject, token: i64, p: i32);
extern fn facet_android_seek_start(envp: *jni::JNIEnv, cls: jni::jobject, token: i64);
extern fn facet_android_seek_stop(envp: *jni::JNIEnv, cls: jni::jobject, token: i64);
extern fn facet_android_text(envp: *jni::JNIEnv, cls: jni::jobject, token: i64, s: jni::jobject);
extern fn facet_android_step(envp: *jni::JNIEnv, cls: jni::jobject, token: i64, delta: i32);
extern fn facet_android_carousel_page(envp: *jni::JNIEnv, cls: jni::jobject, token: i64,
                                      index: i32);
extern fn facet_android_raw_message(envp: *jni::JNIEnv, cls: jni::jobject, token: i64,
                                    body: jni::jobject);
extern fn facet_android_resource(envp: *jni::JNIEnv, cls: jni::jobject, token: i64,
                                 url: jni::jobject);
extern fn facet_android_row_count(envp: *jni::JNIEnv, cls: jni::jobject, token: i64) -> i32;
extern fn facet_android_row_view(envp: *jni::JNIEnv, cls: jni::jobject, token: i64, position: i32,
                                 convert: jni::jobject, parent: jni::jobject) -> jni::jobject;
extern fn facet_android_row_tapped(envp: *jni::JNIEnv, cls: jni::jobject, token: i64, position: i32);
extern fn facet_android_job(envp: *jni::JNIEnv, cls: jni::jobject);
extern fn facet_android_draw(envp: *jni::JNIEnv, cls: jni::jobject, token: i64,
                             canvas: jni::jobject);
extern fn facet_android_touch_event(envp: *jni::JNIEnv, cls: jni::jobject, token: i64,
                                    action: i32, x: f32, y: f32);
extern fn facet_android_scrolled(envp: *jni::JNIEnv, cls: jni::jobject, token: i64,
                                 x: i32, y: i32);
extern fn facet_android_rows_visible(envp: *jni::JNIEnv, cls: jni::jobject, token: i64,
                                     first: i32, visible: i32, total: i32);
extern fn facet_android_submit(envp: *jni::JNIEnv, cls: jni::jobject, token: i64);
extern fn facet_android_focus(envp: *jni::JNIEnv, cls: jni::jobject, token: i64, on: u8);
extern fn facet_android_navigating(envp: *jni::JNIEnv, cls: jni::jobject, token: i64);
extern fn facet_android_navigated(envp: *jni::JNIEnv, cls: jni::jobject, token: i64,
                                  back: u8, forward: u8);
extern fn facet_android_terminated(envp: *jni::JNIEnv, cls: jni::jobject, token: i64);
extern fn facet_android_picked(envp: *jni::JNIEnv, cls: jni::jobject, token: i64,
                               index: i32);
extern fn facet_android_time_set(envp: *jni::JNIEnv, cls: jni::jobject, token: i64,
                                 hour: i32, minute: i32);
extern fn facet_android_time_opened(envp: *jni::JNIEnv, cls: jni::jobject, token: i64);
extern fn facet_android_time_dismissed(envp: *jni::JNIEnv, cls: jni::jobject, token: i64);
extern fn facet_android_date_set(envp: *jni::JNIEnv, cls: jni::jobject, token: i64,
                                 y: i32, m: i32, d: i32);
extern fn facet_android_date_opened(envp: *jni::JNIEnv, cls: jni::jobject, token: i64);
extern fn facet_android_date_dismissed(envp: *jni::JNIEnv, cls: jni::jobject, token: i64);
extern fn facet_android_intercept(envp: *jni::JNIEnv, cls: jni::jobject, token: i64,
                                  action: i32, x: f32, y: f32) -> u8;
extern fn facet_android_touch(envp: *jni::JNIEnv, cls: jni::jobject, token: i64,
                              action: i32, x: f32, y: f32) -> u8;

fn host_class() -> jni::jclass { return { C_HOST as *u8 }; }
fn tick_class() -> jni::jclass { return { C_TICK as *u8 }; }
fn click_class() -> jni::jclass { return { C_CLICK as *u8 }; }
fn post_class() -> jni::jclass { return { C_POST as *u8 }; }
fn checked_class() -> jni::jclass { return { C_CHECKED as *u8 }; }
fn seek_class() -> jni::jclass { return { C_SEEK as *u8 }; }
fn text_class() -> jni::jclass { return { C_TEXT as *u8 }; }
fn step_class() -> jni::jclass { return { C_STEP as *u8 }; }
fn rows_class() -> jni::jclass { return { C_ROWS as *u8 }; }
fn rowtap_class() -> jni::jclass { return { C_ROWTAP as *u8 }; }
fn job_class() -> jni::jclass { return { C_JOB as *u8 }; }
fn canvas_class() -> jni::jclass { return { C_CANVAS as *u8 }; }
fn swipe_class() -> jni::jclass { return { C_SWIPE as *u8 }; }
fn date_class() -> jni::jclass { return { C_DATE as *u8 }; }
fn edit_class() -> jni::jclass { return { C_EDIT as *u8 }; }
fn scroll_class() -> jni::jclass { return { C_SCROLL as *u8 }; }
fn touch_class() -> jni::jclass { return { C_TOUCH as *u8 }; }
fn time_class() -> jni::jclass { return { C_TIME as *u8 }; }
fn popup_class() -> jni::jclass { return { C_POPUP as *u8 }; }
fn web_class() -> jni::jclass { return { C_WEB as *u8 }; }
fn zoom_class() -> jni::jclass { return { C_ZOOM as *u8 }; }
fn carousel_class() -> jni::jclass { return { C_CAROUSEL as *u8 }; }
fn bridge_class() -> jni::jclass { return { C_BRIDGE as *u8 }; }
fn loaded() -> bool { return LOADER != 0; }

// Load the dex and bind every native. Idempotent; `any_view` is only needed to
// reach a Context, and through it the app's classloader — an in-memory loader
// must be parented to it or the app's own classes become invisible to it.
fn ensure_loaded(env: rt::Env, any_view: jni::jobject) {
    if LOADER != 0 { return; }
    // MERGED FIRST. An app whose build fed this package's `facet_android.dex`
    // to `d8` alongside its own classes already HAS these classes in its own
    // classes.dex — and its loader is the one that supplied `FacetActivity`,
    // the launch Activity an in-memory loader cannot provide.
    //
    // Loading the in-memory copy anyway would give the process TWO sets: the
    // Activity would hold a FacetHost of one class while this code registered
    // natives on the other, and `nativeSizeChanged` would never arrive.
    if load_merged(env) { return; }
    let dex: *[u8; 33716] = #include_bytes("../facet_android.dex");
    let buffer: jni::jobject = {
        (*(*env.raw())).NewDirectByteBuffer(env.raw(), { dex as *u8 }, DEX_LEN as i64)
    };
    let ctx: jni::jobject = env.call_object_0(
        any_view, #str_ptr("android/view/View\0"), #str_ptr("getContext\0"),
        #str_ptr("()Landroid/content/Context;\0"));
    let app_loader: jni::jobject = env.call_object_0(
        ctx, #str_ptr("android/content/Context\0"), #str_ptr("getClassLoader\0"),
        #str_ptr("()Ljava/lang/ClassLoader;\0"));

    let imdcl: jni::jclass = env.find_class(#str_ptr("dalvik/system/InMemoryDexClassLoader\0"));
    let ctor: jni::jmethodID = env.method_id(imdcl, #str_ptr("<init>\0"),
        #str_ptr("(Ljava/nio/ByteBuffer;Ljava/lang/ClassLoader;)V\0"));
    var ctor_args: [jni::JValue; 2] = [jni::arg_object(buffer), jni::arg_object(app_loader)];
    let loader: jni::jobject = {
        (*(*env.raw())).NewObjectA(env.raw(), imdcl, ctor, #addr_of(ctor_args[0]))
    };
    LOADER = { #addr(env.new_global_ref(loader)) };

    C_HOST = { #addr(load_class(env, loader, #str_ptr("cplus.facet.FacetHost\0"))) };
    C_TICK = { #addr(load_class(env, loader, #str_ptr("cplus.facet.FacetTick\0"))) };
    C_CLICK = { #addr(load_class(env, loader, #str_ptr("cplus.facet.FacetClick\0"))) };
    C_POST = { #addr(load_class(env, loader, #str_ptr("cplus.facet.FacetPost\0"))) };
    C_CHECKED = { #addr(load_class(env, loader, #str_ptr("cplus.facet.FacetChecked\0"))) };
    C_SEEK = { #addr(load_class(env, loader, #str_ptr("cplus.facet.FacetSeek\0"))) };
    C_TEXT = { #addr(load_class(env, loader, #str_ptr("cplus.facet.FacetText\0"))) };
    C_STEP = { #addr(load_class(env, loader, #str_ptr("cplus.facet.FacetStep\0"))) };
    C_ROWS = { #addr(load_class(env, loader, #str_ptr("cplus.facet.FacetRows\0"))) };
    C_ROWTAP = { #addr(load_class(env, loader, #str_ptr("cplus.facet.FacetRowTap\0"))) };
    C_JOB = { #addr(load_class(env, loader, #str_ptr("cplus.facet.FacetJob\0"))) };
    C_CANVAS = { #addr(load_class(env, loader, #str_ptr("cplus.facet.FacetCanvas\0"))) };
    C_DRAW = { #addr(load_class(env, loader, #str_ptr("cplus.facet.FacetDraw\0"))) };
    C_SWIPE = { #addr(load_class(env, loader, #str_ptr("cplus.facet.FacetSwipeHost\0"))) };
    C_DATE = { #addr(load_class(env, loader, #str_ptr("cplus.facet.FacetDate\0"))) };
    C_EDIT = { #addr(load_class(env, loader, #str_ptr("cplus.facet.FacetEdit\0"))) };
    C_SCROLL = { #addr(load_class(env, loader, #str_ptr("cplus.facet.FacetScroll\0"))) };
    C_TOUCH = { #addr(load_class(env, loader, #str_ptr("cplus.facet.FacetTouch\0"))) };
    C_TIME = { #addr(load_class(env, loader, #str_ptr("cplus.facet.FacetTime\0"))) };
    C_POPUP = { #addr(load_class(env, loader, #str_ptr("cplus.facet.FacetPopup\0"))) };
    C_WEB = { #addr(load_class(env, loader, #str_ptr("cplus.facet.FacetWeb\0"))) };
    C_ZOOM = { #addr(load_class(env, loader, #str_ptr("cplus.facet.FacetZoomHost\0"))) };
    C_CAROUSEL = { #addr(load_class(env, loader, #str_ptr("cplus.facet.FacetCarousel\0"))) };
    C_BRIDGE = { #addr(load_class(env, loader, #str_ptr("cplus.facet.FacetBridge\0"))) };

    bind_natives(env);

    env.delete_local_ref(loader);
    env.delete_local_ref(imdcl);
    env.delete_local_ref(app_loader);
    env.delete_local_ref(ctx);
    env.delete_local_ref(buffer);
    return;
}

// The classes as the APP's own loader sees them. False when the app did not
// merge the dex, which is the ordinary case and not an error — so the pending
// NoClassDefFoundError is cleared rather than left for the next JNI call to
// trip over.
fn load_merged(env: rt::Env) -> bool {
    let host: jni::jclass = env.find_class(#str_ptr("cplus/facet/FacetHost\0"));
    if host == (0 as jni::jclass) { env.clear_exception(); return false; }
    C_HOST = { #addr(env.retain_local_as_global(host)) };
    C_TICK = { #addr(find_global(env, #str_ptr("cplus/facet/FacetTick\0"))) };
    C_CLICK = { #addr(find_global(env, #str_ptr("cplus/facet/FacetClick\0"))) };
    C_POST = { #addr(find_global(env, #str_ptr("cplus/facet/FacetPost\0"))) };
    C_CHECKED = { #addr(find_global(env, #str_ptr("cplus/facet/FacetChecked\0"))) };
    C_SEEK = { #addr(find_global(env, #str_ptr("cplus/facet/FacetSeek\0"))) };
    C_TEXT = { #addr(find_global(env, #str_ptr("cplus/facet/FacetText\0"))) };
    C_STEP = { #addr(find_global(env, #str_ptr("cplus/facet/FacetStep\0"))) };
    C_ROWS = { #addr(find_global(env, #str_ptr("cplus/facet/FacetRows\0"))) };
    C_ROWTAP = { #addr(find_global(env, #str_ptr("cplus/facet/FacetRowTap\0"))) };
    C_JOB = { #addr(find_global(env, #str_ptr("cplus/facet/FacetJob\0"))) };
    C_CANVAS = { #addr(find_global(env, #str_ptr("cplus/facet/FacetCanvas\0"))) };
    C_DRAW = { #addr(find_global(env, #str_ptr("cplus/facet/FacetDraw\0"))) };
    C_SWIPE = { #addr(find_global(env, #str_ptr("cplus/facet/FacetSwipeHost\0"))) };
    C_DATE = { #addr(find_global(env, #str_ptr("cplus/facet/FacetDate\0"))) };
    C_EDIT = { #addr(find_global(env, #str_ptr("cplus/facet/FacetEdit\0"))) };
    C_SCROLL = { #addr(find_global(env, #str_ptr("cplus/facet/FacetScroll\0"))) };
    C_TOUCH = { #addr(find_global(env, #str_ptr("cplus/facet/FacetTouch\0"))) };
    C_TIME = { #addr(find_global(env, #str_ptr("cplus/facet/FacetTime\0"))) };
    C_POPUP = { #addr(find_global(env, #str_ptr("cplus/facet/FacetPopup\0"))) };
    C_WEB = { #addr(find_global(env, #str_ptr("cplus/facet/FacetWeb\0"))) };
    C_ZOOM = { #addr(find_global(env, #str_ptr("cplus/facet/FacetZoomHost\0"))) };
    C_CAROUSEL = { #addr(find_global(env, #str_ptr("cplus/facet/FacetCarousel\0"))) };
    C_BRIDGE = { #addr(find_global(env, #str_ptr("cplus/facet/FacetBridge\0"))) };
    // A sentinel rather than a loader object: `loaded()` asks whether the
    // classes are here, and by this path there is no loader to keep.
    LOADER = 1 as usize;
    bind_natives(env);
    return true;
}

fn find_global(env: rt::Env, name: *u8) -> jni::jobject {
    let c: jni::jclass = env.find_class(name);
    if c == (0 as jni::jclass) { env.clear_exception(); return 0 as jni::jobject; }
    return env.retain_local_as_global(c);
}

// Bind every native. Both paths need it: a class from the app's loader resolves
// a native by symbol, but only for a name JNI can mangle — and every adapter
// here is a nested class whose methods are private, so all of them are bound
// explicitly either way.
fn bind_natives(env: rt::Env) {
    var tick_rec: Native0 = Native0 {
        name: #str_ptr("nativeTick\0"),
        signature: #str_ptr("()V\0"),
        fn_ptr: facet_android_tick,
    };
    let _r0: i32 = { (*(*env.raw())).RegisterNatives(env.raw(), { C_TICK as *u8 },
                                                     #addr_of(tick_rec) as *u8, 1) };
    var click_rec: Native1L = Native1L {
        name: #str_ptr("nativeClick\0"),
        signature: #str_ptr("(J)V\0"),
        fn_ptr: facet_android_click,
    };
    let _r1: i32 = { (*(*env.raw())).RegisterNatives(env.raw(), { C_CLICK as *u8 },
                                                     #addr_of(click_rec) as *u8, 1) };
    var post_rec: Native1L = Native1L {
        name: #str_ptr("nativeAfter\0"),
        signature: #str_ptr("(J)V\0"),
        fn_ptr: facet_android_after,
    };
    let _r2: i32 = { (*(*env.raw())).RegisterNatives(env.raw(), { C_POST as *u8 },
                                                     #addr_of(post_rec) as *u8, 1) };
    var size_rec: Native2I = Native2I {
        name: #str_ptr("nativeSizeChanged\0"),
        signature: #str_ptr("(II)V\0"),
        fn_ptr: facet_android_size_changed,
    };
    let _r3: i32 = { (*(*env.raw())).RegisterNatives(env.raw(), { C_HOST as *u8 },
                                                     #addr_of(size_rec) as *u8, 1) };

    var checked_rec: Native2LZ = Native2LZ {
        name: #str_ptr("nativeChecked\0"),
        signature: #str_ptr("(JZ)V\0"),
        fn_ptr: facet_android_checked,
    };
    let _r4: i32 = { (*(*env.raw())).RegisterNatives(env.raw(), { C_CHECKED as *u8 },
                                                     #addr_of(checked_rec) as *u8, 1) };
    // THREE IN ONE CALL, because RegisterNatives takes an ARRAY and a slider
    // reports three things. Registering them one at a time would work as well;
    // the array is what jni.h's shape is for, and it keeps the three names that
    // must match FacetSeek.java side by side.
    var seek_recs: [Native2LI; 1] = [Native2LI {
        name: #str_ptr("nativeProgress\0"),
        signature: #str_ptr("(JI)V\0"),
        fn_ptr: facet_android_progress,
    }];
    let _r5: i32 = { (*(*env.raw())).RegisterNatives(env.raw(), { C_SEEK as *u8 },
                                                     #addr_of(seek_recs[0]) as *u8, 1) };
    var track_recs: [Native1L; 2] = [
        Native1L {
            name: #str_ptr("nativeSeekStart\0"),
            signature: #str_ptr("(J)V\0"),
            fn_ptr: facet_android_seek_start,
        },
        Native1L {
            name: #str_ptr("nativeSeekStop\0"),
            signature: #str_ptr("(J)V\0"),
            fn_ptr: facet_android_seek_stop,
        },
    ];
    let _r6: i32 = { (*(*env.raw())).RegisterNatives(env.raw(), { C_SEEK as *u8 },
                                                     #addr_of(track_recs[0]) as *u8, 2) };
    var text_rec: Native2LO = Native2LO {
        name: #str_ptr("nativeText\0"),
        signature: #str_ptr("(JLjava/lang/String;)V\0"),
        fn_ptr: facet_android_text,
    };
    let _r7: i32 = { (*(*env.raw())).RegisterNatives(env.raw(), { C_TEXT as *u8 },
                                                     #addr_of(text_rec) as *u8, 1) };

    var job_rec: Native0 = Native0 {
        name: #str_ptr("nativeJob\0"),
        signature: #str_ptr("()V\0"),
        fn_ptr: facet_android_job,
    };
    var touch_rec: NativeLIFF = NativeLIFF {
        name: #str_ptr("nativeTouchEvent\0"),
