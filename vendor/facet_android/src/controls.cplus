// The per-kind bodies. facet never sees these — Stage 2's rule is that facet
// grows no verb table, so the ~N per-kind functions live INSIDE the backend's
// create and apply, dispatched on `Data.kind`.
//
// `create` and `apply` share every body: create calls the same `apply_<kind>`
// with an all-ones dirty word, so a control cannot be correct on mount and
// wrong on its first update.

import "stdlib/text" as text;
import "stdlib/option" as option;
import "jni/jni" as jni;
import "android_view/runtime" as rt;
import "flex_layout/flex_layout" as flex;
import "android_view/widgets" as w;
import "facet/facet" as core;
import "facet/props" as props;
import "facet/mount" as mount;
import "facet/label" as label;
import "facet/button" as button;
import "facet/checkbox" as checkbox;
import "facet/toggle" as toggle;
import "facet/radio" as radio;
import "facet/slider" as slider;
import "facet/progress" as progress;
import "facet/spinner" as spinner;
import "facet/text_field" as text_field;
import "facet/text_area" as text_area;
import "facet/search_field" as search_field;
import "facet/text_button" as text_button;
import "facet/image" as image;
import "facet/icon_button" as icon_button;
import "facet/scroll" as scroll;
import "facet/stepper" as stepper;
import "facet/split" as split;
import "facet/carousel" as carousel;
import "facet/canvas" as canvas;
import "facet/page_dots" as page_dots;
import "facet/date_picker" as date_picker;
import "facet/symbol" as symbol;
import "facet/time_picker" as time_picker;
import "facet/bordered" as bordered;
import "facet/popup" as popup;
import "facet/web" as web;
import "facet/hybrid_web" as hybrid_web;
import "facet/table" as table;
import "facet/vocabulary" as vocab;
import "./env" as e;
import "./paint" as paint;
import "./dex" as dex;
import "./swipe" as swipe;
import "./log" as log;

fn props_of(n: *core::Node, kind: u32) -> *u8 {
    let d: *core::Data = core::node_data(n);
    if d == (0 as *core::Data) { return 0 as *u8; }
    if { (*d).kind } != kind { return 0 as *u8; }
    return { (*d).props };
}

// Every created view is handed to facet as a GLOBAL ref: it has to outlive the
// native call that made it, and a local ref does not.
fn global_of(local: jni::jobject) -> *u8 {
    return e::env().retain_local_as_global(local);
}

// EVERY view gets LayoutParams the moment it is created, before anything is
// written to it.
//
// This is not tidiness. facet's mount walk (mount.cplus M3) creates a view
// FULLY CONFIGURED and inserts it afterwards — top-down, insert-as-created —
// and `TextView.setText` calls `checkForRelayout()`, which dereferences
// `getLayoutParams()`. A view that has never been added to a parent has none,
// so the very first `set_text` on a freshly created label threw
//
//   NullPointerException: Attempt to read from field
//   'int android.view.ViewGroup$LayoutParams.width' ...
//   at android.widget.TextView.checkForRelayout
//
// AppKit and UIKit do not care about the order; Android does. Reordering
// facet's walk to insert-then-configure would be the wrong fix — M3 is the
// same on every backend and the walk needs a host view to exist first — so the
// backend satisfies the platform's precondition instead.
//
// WRAP_CONTENT (-2) for both axes: the values are never consulted, because this
// backend measures and lays out every child explicitly (geometry.cplus). What
// matters is only that the object is not null.
fn attach_layout_params(v: *u8) {
    let env: rt::Env = e::env();
    let cls: jni::jclass = env.class_cached(#str_ptr("android/view/ViewGroup$LayoutParams\0"));
    let ctor: jni::jmethodID = env.method_id(cls, #str_ptr("<init>\0"), #str_ptr("(II)V\0"));
    let wrap: i32 = (0 as i32) -% (2 as i32);
    var args: [jni::JValue; 2] = [rt::arg_int(wrap), rt::arg_int(wrap)];
    let lp: jni::jobject = {
        (*(*env.raw())).NewObjectA(env.raw(), cls, ctor, #addr_of(args[0]))
    };
    var view: w::View = paint::wrap(v);
    view.set_layout_params(lp);
    paint::unwrap_keep(view);
    env.delete_local_ref(lp);
    return;
}

// ---- label -------------------------------------------------------------------

fn create_label(n: *core::Node) -> *u8 {
    var tv: w::TextView = w::TextView::new_context(e::env(), e::context());
    return tv.into_raw();
}

fn apply_label(v: *u8, n: *core::Node, dirty: u64) {
    let p: *props::LabelProps = props_of(n, props::K_LABEL) as *props::LabelProps;
    if p == (0 as *props::LabelProps) { return; }
    let env: rt::Env = e::env();
    var tv: w::TextView = w::TextView::from_global(env, v);

    if (dirty & (label::P_TEXT | label::P_TEXT_FORMAT)) != (0 as u64) {
        var buf: [u8; 1024] = #zero::[[u8; 1024]]();
        let base: *u8 = { #addr_of(buf[0]) };
        if paint::cstr({ (*p).text.view() }, base, 1024 as usize) {
            // HTML OR PLAIN, which is the same string through a different
            // door: `Html.fromHtml` is Android's own parser, so a label that
            // asks for markup gets the platform's reading of it rather than
            // one invented here.
            match { (*p).text_format } {
                vocab::TextFormat::Html => { dex::set_html(env, v, base); }
                vocab::TextFormat::Text => { tv.set_text_str(base); }
            }
        }
    }
    // A SIZE AND WHETHER IT SCALES ARE ONE CALL, so the two bits are one branch.
    // 0 means "the platform's own", which is what a TextView already has.
    if (dirty & (label::P_FONT_SIZE | label::P_FONT_SCALES)) != (0 as u64) {
        apply_text_size(tv, { (*p).font_size }, { (*p).font_scales });
    }
    // THE RUN LIST WINS OVER THE PLAIN TEXT when there is one, and it is
    // applied after it: `text` and `formatted_text` are two ways to say what a
    // label reads, and the second is the specific one.
    if (dirty & (label::P_FORMATTED_TEXT | label::P_TEXT)) != (0 as u64) {
        apply_formatted_text(env, v, { #addr_of((*p).formatted_text) });
    }
    if (dirty & label::P_TEXT_COLOR) != (0 as u64) {
        let c: vocab::Color = { (*p).text_color };
        if c.is_set() { tv.set_text_color_i(paint::argb_of(c)); }
    }
    let typography: u64 = label::P_FONT_FAMILY | label::P_FONT_WEIGHT | label::P_IS_ITALIC
                        | label::P_TEXT_ALIGN | label::P_VERTICAL_ALIGN
                        | label::P_LINE_BREAK | label::P_MAX_LINES
                        | label::P_TEXT_DECORATION | label::P_TEXT_TRANSFORM
                        | label::P_CHARACTER_SPACING | label::P_LINE_HEIGHT
                        | label::P_FONT_SIZE;
    if (dirty & typography) != (0 as u64) || dirty == paint::all_bits() {
        var st: TextStyle = TextStyle::none();
        st.family = { (*p).font_family.view() };
        st.weight = { (*p).font_weight };
        st.is_italic = { (*p).is_italic };
        st.size = { (*p).font_size };
        st.scales = { (*p).font_scales };
        st.align = { (*p).text_align };
        st.vertical_align = { (*p).vertical_align };
        st.line_break = { (*p).line_break };
        st.max_lines = { (*p).max_lines };
        st.decoration = { (*p).text_decoration };
        st.transform = { (*p).text_transform };
        st.character_spacing = { (*p).character_spacing };
        st.line_height = { (*p).line_height };
        apply_text_style(env, tv, st);
    }

    var borrowed: w::View = w::View::from_global(env, tv.into_raw());
    paint::unwrap_keep(borrowed);
    return;
}

// ---- button ------------------------------------------------------------------

fn create_button(n: *core::Node) -> *u8 {
    let env: rt::Env = e::env();
    var b: w::Button = w::Button::new_context(env, e::context());
    let raw: *u8 = b.into_raw();
    // The click adapter carries the NODE ADDRESS as its token, so one hook
    // routes every button in the tree and no side table is needed.
    let listener: jni::jobject = dex::new_with_token(env, dex::click_class(), { #addr(n) as i64 });
    var view: w::View = w::View::from_global(env, raw);
    view.set_on_click_listener(listener);
    paint::unwrap_keep(view);
    env.delete_local_ref(listener);
    // The PRESS and the RELEASE, which a click does not carry.
    arm_touch(env, raw, n);
    return raw;
}

fn apply_button(v: *u8, n: *core::Node, dirty: u64) {
    let p: *props::ButtonProps = props_of(n, props::K_BUTTON) as *props::ButtonProps;
    if p == (0 as *props::ButtonProps) { return; }
    let env: rt::Env = e::env();
    // A Button declares no setText of its own — javap lists DECLARED members
    // only — so the inherited surface is reached through the typed upcast. The
    // upcast takes its own global ref, which is why it is released separately.
    var b: w::Button = w::Button::from_global(env, v);
    var tv: w::TextView = b.as_text_view();

    if (dirty & button::P_TITLE) != (0 as u64) {
        var buf: [u8; 512] = #zero::[[u8; 512]]();
        let base: *u8 = { #addr_of(buf[0]) };
        if paint::cstr({ (*p).title.view() }, base, 512 as usize) {
            tv.set_text_str(base);
        }
    }
    if (dirty & (button::P_FONT_SIZE | button::P_FONT_SCALES)) != (0 as u64) {
        apply_text_size(tv, { (*p).font_size }, { (*p).font_scales });
    }
    if (dirty & button::P_TEXT_COLOR) != (0 as u64) {
        let c: vocab::Color = { (*p).text_color };
        if c.is_set() { tv.set_text_color_i(paint::argb_of(c)); }
    }
    // The CHROME, watched on the band's decoration bits as well as its own:
    // `configure` runs before this body and restores the platform's background
    // whenever the band declares nothing, so the two have to move together.
    if (dirty & (button::P_TOGGLES | button::P_ON)) != (0 as u64) {
        var sel: w::View = w::View::from_global(env, v);
        if { (*p).toggles } { sel.set_selected({ (*p).on }); }
        paint::unwrap_keep(sel);
    }
    // A BUTTON'S IMAGE is a COMPOUND DRAWABLE — a glyph beside the title, and
    // `content_layout` is which of the four sides it sits on. Android says the
    // same thing with the same four slots, which is why the two are one branch:
    // the drawable and its side cannot be written apart.
    if (dirty & (button::P_IMAGE | button::P_CONTENT_LAYOUT)) != (0 as u64) {
        apply_button_image(env, tv, { (*p).image.view() }, { (*p).content_layout });
    }
    let chrome: u64 = button::P_BORDERED | button::P_BORDER_COLOR
                    | button::P_BORDER_WIDTH | button::P_CORNER_RADIUS
                    | props::C_BACKGROUND_COLOR | props::C_CORNER_RADIUS;
    if (dirty & chrome) != (0 as u64) || dirty == paint::all_bits() {
        apply_control_chrome(env, v, n, { (*p).bordered }, { (*p).border_color },
                             { (*p).border_width }, { (*p).corner_radius });
    }
    let typography: u64 = button::P_FONT_FAMILY | button::P_FONT_WEIGHT
                        | button::P_IS_ITALIC | button::P_LINE_BREAK
                        | button::P_TEXT_TRANSFORM | button::P_CHARACTER_SPACING
                        | button::P_FONT_SIZE;
    if (dirty & typography) != (0 as u64) || dirty == paint::all_bits() {
        var st: TextStyle = TextStyle::none();
        st.family = { (*p).font_family.view() };
        st.weight = { (*p).font_weight };
        st.is_italic = { (*p).is_italic };
        st.size = { (*p).font_size };
        st.scales = { (*p).font_scales };
        // A BUTTON'S TITLE IS CENTRED, and facet gives a button no alignment
        // verb — so the platform's own posture is kept rather than reset to a
        // label's `Start`.
        st.align = vocab::TextAlign::Center;
        st.vertical_align = vocab::TextAlign::Center;
        st.line_break = { (*p).line_break };
        st.transform = { (*p).text_transform };
        st.character_spacing = { (*p).character_spacing };
        apply_text_style(env, tv, st);
    }

    // `tv` owns a ref of its own (the upcast made one) — let it drop. `b`
    // borrows facet's, so disarm that one.
    var bv: w::View = w::View::from_global(env, b.into_raw());
    paint::unwrap_keep(bv);
    return;
}

// A tap arrived. The token IS the node, so the handler is read from the node's
// own props — no registry, nothing to keep in step.
fn fire_click(token: i64) {
    let n: *core::Node = { token as *core::Node };
    if n == (0 as *core::Node) { return; }
    // A text_button is a different KIND with a different props struct, and it
    // shares this adapter. Asking it first costs one compare and stops a
    // TextButtonProps being read through ButtonProps' layout.
    // A swipe ITEM's button is this backend's own, and its token is the item
    // node — so the swipe path is asked before any props struct is read.
    if swipe::fire_action(n) { return; }
    if fire_date_picker_click(n) { return; }
    if fire_time_picker_click(n) { return; }
    if fire_text_button_click(n) { return; }
    if fire_icon_button_click(n) { return; }
    let p: *props::ButtonProps = props_of(n, props::K_BUTTON) as *props::ButtonProps;
    if p == (0 as *props::ButtonProps) { return; }
    let h: fn(*u8, *u8) = { (*p).on_click };
    if h != props::no_handler { h(core::view_of(n), { (*p).on_click_ctx }); }
    return;
}

// ---- box / plain container ---------------------------------------------------
// A `box` and a keyed container are the same thing to Android: a FacetHost with
// the shared band applied. Nothing kind-specific to write, which is the point —
// the band already said everything a box can say.

fn create_container(n: *core::Node) -> *u8 {
    return global_of(dex::new_host(e::env(), e::context()));
}

fn apply_container(v: *u8, n: *core::Node, dirty: u64) { return; }

// ---- the compound buttons: checkbox, toggle, radio ---------------------------
// CheckBox, Switch and RadioButton are all CompoundButton, so the read half is
// ONE adapter and one native. They differ only in which props struct holds the
// `on` bit — which is exactly the seam the uikit backend got wrong: a handler
// name read for one kind counted for every kind that declares one, and the
// checkbox was live on screen and dead to facet for it. Each kind below names
// its own struct.
//
// `set_checked` from an apply pass fires the listener too. The C+ side is
// idempotent — it writes the same value into the props it just read from and
// calls the handler with a state that did not change — so the guard is to
// compare before writing, not to mute the listener.

fn arm_checked(env: rt::Env, raw: *u8, n: *core::Node) {
    let listener: jni::jobject =
        dex::new_with_token(env, dex::checked_class(), { #addr(n) as i64 });
    var cb: w::CompoundButton = w::CompoundButton::from_global(env, raw);
    cb.set_on_checked_change_listener(listener);
    let _keep: *u8 = cb.into_raw();
    env.delete_local_ref(listener);
    return;
}

fn create_checkbox(n: *core::Node) -> *u8 {
    let env: rt::Env = e::env();
    var c: w::CheckBox = w::CheckBox::new_context(env, e::context());
    let raw: *u8 = c.into_raw();
    arm_checked(env, raw, n);
    return raw;
}

fn apply_checkbox(v: *u8, n: *core::Node, dirty: u64) {
    let p: *props::CheckboxProps = props_of(n, props::K_CHECKBOX) as *props::CheckboxProps;
    if p == (0 as *props::CheckboxProps) { return; }
    let env: rt::Env = e::env();
    var c: w::CheckBox = w::CheckBox::from_global(env, v);
    if (dirty & checkbox::P_ON) != (0 as u64) {
        var cb: w::CompoundButton = c.as_compound_button();
        if cb.is_checked() != { (*p).on } { cb.set_checked({ (*p).on }); }
    }
    if (dirty & checkbox::P_COLOR) != (0 as u64) {
        let col: vocab::Color = { (*p).color };
        if col.is_set() {
            var tv: w::TextView = c.as_compound_button().as_button().as_text_view();
            tv.set_text_color_i(paint::argb_of(col));
        }
    }
    let _keep: *u8 = c.into_raw();
    return;
}

fn create_toggle(n: *core::Node) -> *u8 {
    let env: rt::Env = e::env();
    var s: w::Switch = w::Switch::new_context(env, e::context());
    let raw: *u8 = s.into_raw();
    arm_checked(env, raw, n);
    return raw;
}

fn apply_toggle(v: *u8, n: *core::Node, dirty: u64) {
    let p: *props::ToggleProps = props_of(n, props::K_TOGGLE) as *props::ToggleProps;
    if p == (0 as *props::ToggleProps) { return; }
    let env: rt::Env = e::env();
    var s: w::Switch = w::Switch::from_global(env, v);
    if (dirty & toggle::P_ON) != (0 as u64) {
        var cb: w::CompoundButton = s.as_compound_button();
        if cb.is_checked() != { (*p).on } { cb.set_checked({ (*p).on }); }
    }
    // ON AND OFF ARE ONE COLOUR LIST, not two writes: Android asks for a colour
    // per STATE, so the pair has to be built together or the second would erase
    // the first.
    if (dirty & (toggle::P_ON_COLOR | toggle::P_OFF_COLOR)) != (0 as u64) {
        let on: vocab::Color = { (*p).on_color };
        let off: vocab::Color = { (*p).off_color };
        if on.is_set() || off.is_set() {
            let t: jni::jobject = checked_tint(env, on, off);
            if t != (0 as jni::jobject) {
                s.set_track_tint_list(t);
                env.delete_local_ref(t);
            }
        }
    }
    if (dirty & toggle::P_THUMB_COLOR) != (0 as u64) {
        let c: vocab::Color = { (*p).thumb_color };
        if c.is_set() {
            let t: jni::jobject = tint(env, c);
            s.set_thumb_tint_list(t);
            env.delete_local_ref(t);
        }
    }
    let _keep: *u8 = s.into_raw();
    return;
}

fn create_radio(n: *core::Node) -> *u8 {
    let env: rt::Env = e::env();
    var r: w::RadioButton = w::RadioButton::new_context(env, e::context());
    let raw: *u8 = r.into_raw();
    arm_checked(env, raw, n);
    return raw;
}

fn apply_radio(v: *u8, n: *core::Node, dirty: u64) {
    let p: *props::RadioProps = props_of(n, props::K_RADIO) as *props::RadioProps;
    if p == (0 as *props::RadioProps) { return; }
    let env: rt::Env = e::env();
    var r: w::RadioButton = w::RadioButton::from_global(env, v);
    if (dirty & radio::P_ON) != (0 as u64) {
        var cb: w::CompoundButton = r.as_compound_button();
        if cb.is_checked() != { (*p).on } { cb.set_checked({ (*p).on }); }
    }
    if (dirty & radio::P_TEXT) != (0 as u64) {
        var buf: [u8; 512] = #zero::[[u8; 512]]();
        let base: *u8 = { #addr_of(buf[0]) };
        if paint::cstr({ (*p).text.view() }, base, 512 as usize) {
            var tv: w::TextView = r.as_compound_button().as_button().as_text_view();
            tv.set_text_str(base);
        }
    }
    if (dirty & radio::P_TEXT_COLOR) != (0 as u64) {
        let col: vocab::Color = { (*p).text_color };
        if col.is_set() {
            var tv: w::TextView = r.as_compound_button().as_button().as_text_view();
            tv.set_text_color_i(paint::argb_of(col));
        }
    }
    if (dirty & (radio::P_FONT_SIZE | radio::P_FONT_SCALES)) != (0 as u64) {
        var tv: w::TextView = r.as_compound_button().as_button().as_text_view();
        apply_text_size(tv, { (*p).font_size }, { (*p).font_scales });
    }
    let chrome: u64 = radio::P_BORDER_COLOR | radio::P_BORDER_WIDTH
                    | radio::P_CORNER_RADIUS | props::C_BACKGROUND_COLOR
                    | props::C_CORNER_RADIUS;
    if (dirty & chrome) != (0 as u64) || dirty == paint::all_bits() {
        // A radio declares no `bordered` — its three are a border it draws
        // around the whole control, which is what the iOS backend reads too.
        apply_control_chrome(env, v, n, false, { (*p).border_color },
                             { (*p).border_width }, { (*p).corner_radius });
    }
    let typography: u64 = radio::P_FONT_FAMILY | radio::P_FONT_WEIGHT
                        | radio::P_IS_ITALIC | radio::P_TEXT_TRANSFORM
                        | radio::P_CHARACTER_SPACING | radio::P_FONT_SIZE;
    if (dirty & typography) != (0 as u64) || dirty == paint::all_bits() {
        var st: TextStyle = TextStyle::none();
        st.family = { (*p).font_family.view() };
        st.weight = { (*p).font_weight };
        st.is_italic = { (*p).is_italic };
        st.size = { (*p).font_size };
        st.scales = { (*p).font_scales };
        // The LABEL of a compound button sits beside its circle, and facet
        // gives a radio no alignment verb — so the platform's own posture
        // stays rather than being reset to a label's.
        st.align = vocab::TextAlign::Start;
        st.vertical_align = vocab::TextAlign::Center;
        st.transform = { (*p).text_transform };
        st.character_spacing = { (*p).character_spacing };
        var tv: w::TextView = r.as_compound_button().as_button().as_text_view();
        apply_text_style(env, tv, st);
    }
    let _keep: *u8 = r.into_raw();
    return;
}

// A compound button reported a change. Which props struct holds the bit is the
// kind's business, so this asks the node rather than assuming.
fn fire_checked(token: i64, on: bool) {
    let n: *core::Node = { token as *core::Node };
    if n == (0 as *core::Node) { return; }
    let d: *core::Data = core::node_data(n);
    if d == (0 as *core::Data) { return; }
    let kind: u32 = { (*d).kind };
    let raw: *u8 = { (*d).props };
    if raw == (0 as *u8) { return; }

    if kind == props::K_CHECKBOX {
        let p: *props::CheckboxProps = raw as *props::CheckboxProps;
        // WRITTEN BACK FIRST, so a handler asking `checkbox.on()` is told the
        // state that caused the call and not the one before it.
        { (*p).on = on };
        let h: fn(*u8, *u8) = { (*p).on_checked_changed };
        if h != props::no_handler { h(core::view_of(n), { (*p).on_checked_changed_ctx }); }
        return;
    }
    if kind == props::K_TOGGLE {
        let p: *props::ToggleProps = raw as *props::ToggleProps;
        { (*p).on = on };
        let h: fn(*u8, *u8) = { (*p).on_toggled };
        if h != props::no_handler { h(core::view_of(n), { (*p).on_toggled_ctx }); }
        return;
    }
    if kind == props::K_RADIO {
        radio_changed(n, raw as *props::RadioProps, on);
        return;
    }
    return;
}

// A RADIO IS NOT A CHECKBOX, and Android does not know the difference.
//
// `RadioButton` is a CompoundButton like the other two, so a tap TOGGLES it and
// nothing turns its siblings off. Exclusivity on Android is `RadioGroup`'s job
// — and RadioGroup is a LinearLayout, one of the layout containers this backend
// deliberately never binds because facet owns geometry. So the group is this
// side's business, exactly as it is on uikit and appkit, and this is a port of
// `facet_uikit::input::radio_pressed` with one root instead of a window list.
//
// Two rules, and the second is the one a checkbox does not have:
//   * turning one ON turns every other in its group OFF;
//   * a radio cannot be turned off BY TAPPING IT. Android will have toggled the
//     control already, so the answer is to put it back.
fn radio_changed(n: *core::Node, p: *props::RadioProps, on: bool) {
    if p == (0 as *props::RadioProps) { return; }
    if !on {
        // The person tapped the one that was already selected. Android toggled
        // the widget; facet's model says nothing happened, so the widget is
        // corrected and no handler hears about a change that did not occur.
        if { (*p).on } { core::touch(n, radio::P_ON); }
        return;
    }
    if { (*p).on } { return; }
    { (*p).on = true };
    core::touch(n, radio::P_ON);
    turn_off_group_siblings(n, { (*p).group.view() });
    let h: fn(*u8, *u8) = { (*p).on_checked_changed };
    if h != props::no_handler { h(core::view_of(n), { (*p).on_checked_changed_ctx }); }
    return;
}

// Every other radio in the same group, off. Walked from the mounted root
// because a node carries no parent pointer.
//
// An EMPTY group is a radio that is in no group, and it stands alone — the same
// answer the other backends give, and the reason is that a radio with no group
// name has nothing to be exclusive WITH.
fn turn_off_group_siblings(me: *core::Node, group: str) {
    if group == "" { return; }
    let root: *core::Node = mount::mounted_root();
    if root == (0 as *core::Node) { return; }
    group_walk(root, me, group);
    return;
}

fn group_walk(node: *core::Node, me: *core::Node, group: str) {
    if node != me {
        if core::kind_of(node) == props::K_RADIO {
            let rp: *props::RadioProps = props_of(node, props::K_RADIO) as *props::RadioProps;
            if rp != (0 as *props::RadioProps) {
                if { (*rp).group.view() } == group {
                    if { (*rp).on } {
                        { (*rp).on = false };
                        // TOUCHED, not written straight to the widget: the
                        // sibling's own `apply` is the one place that knows how
                        // to write it, and the tick coalesces the whole group
                        // into one pass.
                        core::touch(node, radio::P_ON);
                    }
                }
            }
        }
    }
    var i: usize = 0 as usize;
    let count: usize = core::child_count_of(node);
    while i < count {
        match core::child_of(node, i) {
            option::Option[*core::Node]::Some(c) => { group_walk(c, me, group); }
            option::Option[*core::Node]::None => { }
        }
        i = i +% (1 as usize);
    }
    return;
}

// ---- slider ------------------------------------------------------------------
// A SeekBar counts in whole steps from 0; facet's slider is a f64 range with a
// minimum that need not be zero. So the range is mapped onto a fixed number of
// steps and the value converted at the boundary — the alternative, setting
// `setMin` to facet's minimum, only works when both ends are integers.
//
// STEPS is the resolution of a drag, not of the value: a handler still receives
// the f64 it declared.
const SLIDER_STEPS: i32 = 1000 as i32;

fn slider_span(p: *props::SliderProps) -> f64 {
    let lo: f64 = { (*p).minimum };
    let hi: f64 = { (*p).maximum };
    if hi <= lo { return 0.0f64; }
    return hi - lo;
}

fn create_slider(n: *core::Node) -> *u8 {
    let env: rt::Env = e::env();
    var sb: w::SeekBar = w::SeekBar::new_context(env, e::context());
    let raw: *u8 = sb.into_raw();
    let listener: jni::jobject =
        dex::new_with_token(env, dex::seek_class(), { #addr(n) as i64 });
    var b: w::SeekBar = w::SeekBar::from_global(env, raw);
    b.set_on_seek_bar_change_listener(listener);
    let _keep: *u8 = b.into_raw();
    env.delete_local_ref(listener);
    return raw;
}

fn apply_slider(v: *u8, n: *core::Node, dirty: u64) {
    let p: *props::SliderProps = props_of(n, props::K_SLIDER) as *props::SliderProps;
    if p == (0 as *props::SliderProps) { return; }
    let env: rt::Env = e::env();
    var sb: w::SeekBar = w::SeekBar::from_global(env, v);
    var pb: w::ProgressBar = sb.as_abs_seek_bar().as_progress_bar();

    // The step count is fixed, so it is written once — but MINIMUM and MAXIMUM
    // still dirty the value, because the same f64 lands on a different step
    // when the range moves under it.
    if (dirty & (slider::P_MINIMUM | slider::P_MAXIMUM | slider::P_VALUE)) != (0 as u64) {
        pb.set_max(SLIDER_STEPS);
        let span: f64 = slider_span(p);
        if span > 0.0f64 {
            let frac: f64 = ({ (*p).value } - { (*p).minimum }) / span;
            var step: i32 = { (frac * (SLIDER_STEPS as f64)) as i32 };
            if step < (0 as i32) { step = 0 as i32; }
            if step > SLIDER_STEPS { step = SLIDER_STEPS; }
            pb.set_progress_i(step);
        }
    }
    // THE THREE COLOURS A SLIDER HAS. The minimum track is the filled half —
    // Android's `progress` tint — and the maximum track is the rest, which is
    // its BACKGROUND tint. Naming them that way round is the whole mapping.
    if (dirty & slider::P_THUMB_COLOR) != (0 as u64) {
        let c: vocab::Color = { (*p).thumb_color };
        if c.is_set() {
            var asb: w::AbsSeekBar = sb.as_abs_seek_bar();
            let t: jni::jobject = tint(env, c);
            asb.set_thumb_tint_list(t);
            env.delete_local_ref(t);
            let _k: *u8 = asb.into_raw();
        }
    }
    if (dirty & slider::P_MINIMUM_TRACK_COLOR) != (0 as u64) {
        let c: vocab::Color = { (*p).minimum_track_color };
        if c.is_set() {
            let t: jni::jobject = tint(env, c);
            pb.set_progress_tint_list(t);
            env.delete_local_ref(t);
        }
    }
    if (dirty & slider::P_MAXIMUM_TRACK_COLOR) != (0 as u64) {
        let c: vocab::Color = { (*p).maximum_track_color };
        if c.is_set() {
            let t: jni::jobject = tint(env, c);
            pb.set_progress_background_tint_list(t);
            env.delete_local_ref(t);
        }
    }
    // A THUMB IMAGE goes through the same four doors an `image` source does.
    if (dirty & slider::P_THUMB_IMAGE) != (0 as u64) {
        let src: str = { (*p).thumb_image.view() };
        if src != "" { set_thumb_image(env, v, src); }
    }
    let _keep: *u8 = sb.into_raw();
    return;
}

// The thumb moved. The step comes back; the f64 is this side's business.
fn fire_progress(token: i64, step: i32) {
    let n: *core::Node = { token as *core::Node };
    if n == (0 as *core::Node) { return; }
    let p: *props::SliderProps = props_of(n, props::K_SLIDER) as *props::SliderProps;
    if p == (0 as *props::SliderProps) { return; }
    let span: f64 = slider_span(p);
    if span > 0.0f64 {
        { (*p).value = { (*p).minimum } + (({ step as f64 }) / (SLIDER_STEPS as f64)) * span };
    }
    let h: fn(*u8, *u8) = { (*p).on_value_changed };
    if h != props::no_handler { h(core::view_of(n), { (*p).on_value_changed_ctx }); }
    return;
}

fn fire_seek_edge(token: i64, started: bool) {
    let n: *core::Node = { token as *core::Node };
    if n == (0 as *core::Node) { return; }
    let p: *props::SliderProps = props_of(n, props::K_SLIDER) as *props::SliderProps;
    if p == (0 as *props::SliderProps) { return; }
    if started {
        let h: fn(*u8, *u8) = { (*p).on_drag_started };
        if h != props::no_handler { h(core::view_of(n), { (*p).on_drag_started_ctx }); }
        return;
    }
    let h: fn(*u8, *u8) = { (*p).on_drag_completed };
    if h != props::no_handler { h(core::view_of(n), { (*p).on_drag_completed_ctx }); }
    return;
}

// ---- progress and spinner ----------------------------------------------------
// ONE Android widget, two facet kinds. A ProgressBar is determinate or not, and
// which it is decides everything else — so `progress` creates it horizontal and
// determinate, `spinner` creates it indeterminate and never touches a value.
//
// The style is a CONSTRUCTOR argument on Android (there is no setter that turns
// a spinner into a bar), so the two cannot share a create.

fn create_progress(n: *core::Node) -> *u8 {
    let env: rt::Env = e::env();
    // style="?android:attr/progressBarStyleHorizontal" — the platform's own id,
    // asked for rather than hard-coded, which is the same posture rung 0 took
    // with MeasureSpec.
    let attrs: jni::jclass = env.class_cached(#str_ptr("android/R$attr\0"));
    let fid: jni::jfieldID = env.static_field_id(
        attrs, #str_ptr("progressBarStyleHorizontal\0"), #str_ptr("I\0"));
    let style: i32 = { (*(*env.raw())).GetStaticIntField(env.raw(), attrs, fid) };
    var pb: w::ProgressBar = w::ProgressBar::new_context_attribute_set_i(
        env, e::context(), 0 as jni::jobject, style);
    let raw: *u8 = pb.into_raw();
    var b: w::ProgressBar = w::ProgressBar::from_global(env, raw);
    b.set_indeterminate(false);
    b.set_max(PROGRESS_STEPS);
    let _keep: *u8 = b.into_raw();
    return raw;
}

const PROGRESS_STEPS: i32 = 1000 as i32;

fn apply_progress(v: *u8, n: *core::Node, dirty: u64) {
    let p: *props::ProgressProps = props_of(n, props::K_PROGRESS) as *props::ProgressProps;
    if p == (0 as *props::ProgressProps) { return; }
    let env: rt::Env = e::env();
    var pb: w::ProgressBar = w::ProgressBar::from_global(env, v);
    if (dirty & (progress::P_PROGRESS | progress::P_ANIMATE_PROGRESS)) != (0 as u64) {
        var step: i32 = { ({ (*p).progress } * (PROGRESS_STEPS as f64)) as i32 };
        if step < (0 as i32) { step = 0 as i32; }
        if step > PROGRESS_STEPS { step = PROGRESS_STEPS; }
        // ANIMATED OR NOT IS THE SAME CALL with a second argument, and the BIT
        // is the instruction: `animate_progress` raises P_ANIMATE_PROGRESS and
        // a plain `set_progress` does not.
        //
        // What does NOT arrive is the duration and the easing the verb also
        // carries — `setProgress(int, boolean)` animates on Android's own
        // curve and its own clock, with no knob for either. MANIFEST §2.
        pb.set_progress_i_z(step, (dirty & progress::P_ANIMATE_PROGRESS) != (0 as u64));
    }
    if (dirty & progress::P_PROGRESS_COLOR) != (0 as u64) {
        let c: vocab::Color = { (*p).progress_color };
        if c.is_set() {
            let t: jni::jobject = tint(env, c);
            pb.set_progress_tint_list(t);
            env.delete_local_ref(t);
        }
    }
    let _keep: *u8 = pb.into_raw();
    return;
}

fn create_spinner(n: *core::Node) -> *u8 {
    let env: rt::Env = e::env();
    var pb: w::ProgressBar = w::ProgressBar::new_context(env, e::context());
    let raw: *u8 = pb.into_raw();
    var b: w::ProgressBar = w::ProgressBar::from_global(env, raw);
    b.set_indeterminate(true);
    let _keep: *u8 = b.into_raw();
    return raw;
}

fn apply_spinner(v: *u8, n: *core::Node, dirty: u64) {
    let p: *props::SpinnerProps = props_of(n, props::K_SPINNER) as *props::SpinnerProps;
    if p == (0 as *props::SpinnerProps) { return; }
    let env: rt::Env = e::env();
    var pb: w::ProgressBar = w::ProgressBar::from_global(env, v);
    if (dirty & spinner::P_IS_RUNNING) != (0 as u64) {
        // Android has no stop/start — a spinner that is not running is hidden.
        // Through `paint::visibility_of`, which is the one rule: the frame walk
        // rewrites visibility every pass and would otherwise undo this.
        var view: w::View = pb.as_view();
        view.set_visibility(paint::visibility_of(n));
    }
    if (dirty & spinner::P_COLOR) != (0 as u64) {
        let c: vocab::Color = { (*p).color };
        if c.is_set() {
            // The INDETERMINATE tint: a spinner is a progress bar that never
            // arrives, and its colour lives on the other tint slot.
            let t: jni::jobject = tint(env, c);
            pb.set_indeterminate_tint_list(t);
            env.delete_local_ref(t);
        }
    }
    let _keep: *u8 = pb.into_raw();
    return;
}

// ---- text field --------------------------------------------------------------

fn create_text_field(n: *core::Node) -> *u8 {
    let env: rt::Env = e::env();
    var et: w::EditText = w::EditText::new_context(env, e::context());
    let raw: *u8 = et.into_raw();
    let watcher: jni::jobject =
        dex::new_with_token(env, dex::text_class(), { #addr(n) as i64 });
    var t: w::EditText = w::EditText::from_global(env, raw);
    var tv: w::TextView = t.as_text_view();
    tv.add_text_changed_listener(watcher);
    let _keep: *u8 = t.into_raw();
    // The watcher is kept alive by the TextView's own list; the local ref is
    // not what holds it.
    env.delete_local_ref(watcher);
    arm_edit(env, raw, n);
    return raw;
}

fn apply_text_field(v: *u8, n: *core::Node, dirty: u64) {
    let p: *props::TextFieldProps = props_of(n, props::K_TEXT_FIELD) as *props::TextFieldProps;
    if p == (0 as *props::TextFieldProps) { return; }
    let env: rt::Env = e::env();
    var et: w::EditText = w::EditText::from_global(env, v);
    var tv: w::TextView = et.as_text_view();

    if (dirty & text_field::P_TEXT) != (0 as u64) {
        var buf: [u8; 1024] = #zero::[[u8; 1024]]();
        let base: *u8 = { #addr_of(buf[0]) };
        if paint::cstr({ (*p).input_view.text.view() }, base, 1024 as usize) {
            // ONLY WHEN IT DIFFERS. `setText` moves the caret to the end, so
            // writing the value the field already holds would fight the person
            // typing — the application's own echo of a keystroke arrives here
            // one tick later and would jump the caret on every character.
            var have: [u8; 1024] = #zero::[[u8; 1024]]();
            let hbase: *u8 = { #addr_of(have[0]) };
            read_field_text(env, v, hbase, 1024 as usize);
            if !paint::same_cstr(base, hbase) { tv.set_text_str(base); }
        }
    }
    if (dirty & text_field::P_PLACEHOLDER) != (0 as u64) {
        var buf: [u8; 512] = #zero::[[u8; 512]]();
        let base: *u8 = { #addr_of(buf[0]) };
        if paint::cstr({ (*p).input_view.placeholder.view() }, base, 512 as usize) {
            let hint: jni::jstring = env.new_string_utf(base);
            env.call_void_1(v, #str_ptr("android/widget/TextView\0"),
                            #str_ptr("setHint\0"),
                            #str_ptr("(Ljava/lang/CharSequence;)V\0"),
                            rt::arg_object(hint));
            env.delete_local_ref(hint);
        }
    }
    if (dirty & text_field::P_TEXT_COLOR) != (0 as u64) {
        let c: vocab::Color = { (*p).input_view.text_color };
        if c.is_set() { tv.set_text_color_i(paint::argb_of(c)); }
    }
    if (dirty & (text_field::P_FONT_SIZE | text_field::P_FONT_SCALES)) != (0 as u64) {
        apply_text_size(tv, { (*p).input_view.font_size }, { (*p).input_view.font_scales });
    }
    let typography: u64 = text_field::P_FONT_FAMILY | text_field::P_FONT_WEIGHT
                        | text_field::P_IS_ITALIC | text_field::P_TEXT_TRANSFORM
                        | text_field::P_CHARACTER_SPACING | text_field::P_TEXT_ALIGN
                        | text_field::P_VERTICAL_ALIGN | text_field::P_FONT_SIZE;
    if (dirty & typography) != (0 as u64) || dirty == paint::all_bits() {
        var st: TextStyle = TextStyle::none();
        st.family = { (*p).input_view.font_family.view() };
        st.weight = { (*p).input_view.font_weight };
        st.is_italic = { (*p).input_view.is_italic };
        st.size = { (*p).input_view.font_size };
        st.scales = { (*p).input_view.font_scales };
        st.align = { (*p).text_align };
        st.vertical_align = { (*p).vertical_align };
        st.transform = { (*p).input_view.text_transform };
        st.character_spacing = { (*p).input_view.character_spacing };
        apply_text_style(env, tv, st);
    }
    let flags: u64 = text_field::P_KEYBOARD | text_field::P_CHECKS_SPELLING
                   | text_field::P_PREDICTS_TEXT | text_field::P_IS_READ_ONLY
                   | text_field::P_MAX_LENGTH | text_field::P_IS_SECURE;
    if (dirty & flags) != (0 as u64) || dirty == paint::all_bits() {
        apply_input_flags(env, tv, { #addr_of((*p).input_view) }, { (*p).is_secure }, false);
    }
    if (dirty & text_field::P_PLACEHOLDER_COLOR) != (0 as u64) {
        let pc: vocab::Color = { (*p).input_view.placeholder_color };
        if pc.is_set() { tv.set_hint_text_color_i(paint::argb_of(pc)); }
    }
    if (dirty & (text_field::P_CURSOR_POSITION
                 | text_field::P_SELECTION_LENGTH)) != (0 as u64) {
        let at: i64 = { (*p).input_view.cursor_position };
        let len: i64 = { (*p).input_view.selection_length };
        if at >= (0 as i64) {
            if len > (0 as i64) { et.set_selection_i_i({ at as i32 }, { (at +% len) as i32 }); }
            else { et.set_selection_i({ at as i32 }); }
        }
    }
    if (dirty & text_field::P_RETURN_KEY) != (0 as u64) {
        set_return_key(env, v, { (*p).return_key });
    }
    // A CLEAR BUTTON is a drawable at the END of the field — Android has no
    // property for it, so the platform's own cancel glyph is put there and the
    // touch that clears it is the field's own. MANIFEST §2 carries the touch.
    if (dirty & text_field::P_CLEAR_BUTTON) != (0 as u64) {
        apply_clear_button(env, tv, { (*p).clear_button });
    }
    if (dirty & text_field::P_IS_SECURE) != (0 as u64) {
        // TYPE_CLASS_TEXT | TYPE_TEXT_VARIATION_PASSWORD = 0x81, and plain text
        // is TYPE_CLASS_TEXT. Constants rather than a platform read: these are
        // in InputType, which is not in the bound class list.
        var kind: i32 = 1 as i32;
        if { (*p).is_secure } { kind = 129 as i32; }
        tv.set_input_type(kind);
    }
    let _keep: *u8 = et.into_raw();
    return;
}

fn read_field_text(env: rt::Env, v: *u8, buf: *u8, cap: usize) {
    let cs: jni::jobject = env.call_object_0(
        v, #str_ptr("android/widget/TextView\0"), #str_ptr("getText\0"),
        #str_ptr("()Ljava/lang/CharSequence;\0"));
    if cs == (0 as jni::jobject) { { (*buf) = 0 as u8 }; return; }
    let s: jni::jobject = env.call_object_0(
        cs, #str_ptr("java/lang/Object\0"), #str_ptr("toString\0"),
        #str_ptr("()Ljava/lang/String;\0"));
    let _ok: bool = env.string_utf_into(s, buf, cap);
    env.delete_local_ref(s);
    env.delete_local_ref(cs);
    return;
}

// A keystroke arrived, with the whole text beside it.
fn fire_text(token: i64, s: jni::jstring) {
    let n: *core::Node = { token as *core::Node };
    if n == (0 as *core::Node) { return; }
    // A field, an area and a search field all arrive here: one watcher class,
    // three kinds, and the shared `input_view` block is what they have in
    // common. Asking the KIND is what keeps the three props structs apart.
    let iv: *props::InputViewProps = input_view_of(n);
    if iv == (0 as *props::InputViewProps) { return; }
    var buf: [u8; 1024] = #zero::[[u8; 1024]]();
    let base: *u8 = { #addr_of(buf[0]) };
    if !e::env().string_utf_into(s, base, 1024 as usize) { return; }
    // WRITTEN BACK FIRST, so a handler asking `field.text()` is told what was
    // typed rather than what was there before it.
    let n_bytes: usize = paint::cstr_len(base);
    { (*iv).text = text::from_str({ #str_from_raw_parts(base, n_bytes) }) };
    let h: fn(*u8, *u8) = { (*iv).on_text_changed };
    if h != props::no_handler { h(core::view_of(n), { (*iv).on_text_changed_ctx }); }
    return;
}

// ---- text_button -------------------------------------------------------------
// A borderless Button. facet's `text_button` is its own kind (K_TEXT_BUTTON,
// numbered in its own module rather than props.cplus) and its own props struct,
// so it gets its own pair rather than sharing the button's: the two structs have
// different layouts and a shared body would read one through the other.
//
// The style is a CONSTRUCTOR argument, as it was for the progress bar.

fn borderless_style(env: rt::Env) -> i32 {
    let attrs: jni::jclass = env.class_cached(#str_ptr("android/R$attr\0"));
    let fid: jni::jfieldID = env.static_field_id(
        attrs, #str_ptr("borderlessButtonStyle\0"), #str_ptr("I\0"));
    return { (*(*env.raw())).GetStaticIntField(env.raw(), attrs, fid) };
}

fn create_text_button(n: *core::Node) -> *u8 {
    let env: rt::Env = e::env();
    var b: w::Button = w::Button::new_context_attribute_set_i(
        env, e::context(), 0 as jni::jobject, borderless_style(env));
    let raw: *u8 = b.into_raw();
    let listener: jni::jobject = dex::new_with_token(env, dex::click_class(), { #addr(n) as i64 });
    var view: w::View = w::View::from_global(env, raw);
    view.set_on_click_listener(listener);
    paint::unwrap_keep(view);
    env.delete_local_ref(listener);
    return raw;
}

fn apply_text_button(v: *u8, n: *core::Node, dirty: u64) {
    let p: *text_button::TextButtonProps = props_of(n, text_button::K_TEXT_BUTTON) as *text_button::TextButtonProps;
    if p == (0 as *text_button::TextButtonProps) { return; }
    let env: rt::Env = e::env();
    var b: w::Button = w::Button::from_global(env, v);
    var tv: w::TextView = b.as_text_view();
    if (dirty & text_button::P_TITLE) != (0 as u64) {
        var buf: [u8; 512] = #zero::[[u8; 512]]();
        let base: *u8 = { #addr_of(buf[0]) };
        if paint::cstr({ (*p).title.view() }, base, 512 as usize) { tv.set_text_str(base); }
    }
    if (dirty & text_button::P_TEXT_COLOR) != (0 as u64) {
        let c: vocab::Color = { (*p).text_color };
        if c.is_set() { tv.set_text_color_i(paint::argb_of(c)); }
    }
    if (dirty & (text_button::P_FONT_SIZE | text_button::P_FONT_SCALES)) != (0 as u64) {
        apply_text_size(tv, { (*p).font_size }, { (*p).font_scales });
    }
    if (dirty & (text_button::P_TOGGLES | text_button::P_ON)) != (0 as u64) {
        var sel: w::View = w::View::from_global(env, v);
        if { (*p).toggles } { sel.set_selected({ (*p).on }); }
        paint::unwrap_keep(sel);
    }
    let chrome: u64 = text_button::P_BORDERED | text_button::P_BORDER_COLOR
                    | text_button::P_BORDER_WIDTH | text_button::P_CORNER_RADIUS
                    | props::C_BACKGROUND_COLOR | props::C_CORNER_RADIUS;
    if (dirty & chrome) != (0 as u64) || dirty == paint::all_bits() {
        apply_control_chrome(env, v, n, { (*p).bordered }, { (*p).border_color },
                             { (*p).border_width }, { (*p).corner_radius });
    }
    let typography: u64 = text_button::P_FONT_FAMILY | text_button::P_FONT_WEIGHT
                        | text_button::P_IS_ITALIC | text_button::P_LINE_BREAK
                        | text_button::P_TEXT_TRANSFORM | text_button::P_TEXT_DECORATION
                        | text_button::P_CHARACTER_SPACING | text_button::P_TEXT_ALIGN
                        | text_button::P_FONT_SIZE;
    if (dirty & typography) != (0 as u64) || dirty == paint::all_bits() {
        var st: TextStyle = TextStyle::none();
        st.family = { (*p).font_family.view() };
        st.weight = { (*p).font_weight };
        st.is_italic = { (*p).is_italic };
        st.size = { (*p).font_size };
        st.scales = { (*p).font_scales };
        st.align = { (*p).text_align };
        st.vertical_align = vocab::TextAlign::Center;
        st.line_break = { (*p).line_break };
        st.decoration = { (*p).text_decoration };
        st.transform = { (*p).text_transform };
        st.character_spacing = { (*p).character_spacing };
        apply_text_style(env, tv, st);
    }
    var bv: w::View = w::View::from_global(env, b.into_raw());
    paint::unwrap_keep(bv);
    return;
}

fn fire_text_button_click(n: *core::Node) -> bool {
    let p: *text_button::TextButtonProps =
        props_of(n, text_button::K_TEXT_BUTTON) as *text_button::TextButtonProps;
    if p == (0 as *text_button::TextButtonProps) { return false; }
    let h: fn(*u8, *u8) = { (*p).on_click };
    if h != props::no_handler { h(core::view_of(n), { (*p).on_click_ctx }); }
    return true;
}

// ---- text_area and search_field ----------------------------------------------
// Both are an EditText with a different posture, which is also how facet
// describes them: each carries the SAME embedded `input_view` block as
// text_field, so the text, placeholder, colour and per-keystroke callback are
// one implementation reached three ways.

fn create_multiline(n: *core::Node) -> *u8 {
    let env: rt::Env = e::env();
    var et: w::EditText = w::EditText::new_context(env, e::context());
    let raw: *u8 = et.into_raw();
    let watcher: jni::jobject = dex::new_with_token(env, dex::text_class(), { #addr(n) as i64 });
    var t: w::EditText = w::EditText::from_global(env, raw);
    var tv: w::TextView = t.as_text_view();
    tv.add_text_changed_listener(watcher);
    tv.set_single_line_z(false);
    // TOP|START (0x30 | 0x800003). A multi-line field whose text sits centred
    // vertically is the tell that nobody set this.
    tv.set_gravity(8388659 as i32);
    let _keep: *u8 = t.into_raw();
    env.delete_local_ref(watcher);
    arm_edit(env, raw, n);
    return raw;
}

fn create_search_field(n: *core::Node) -> *u8 {
    let env: rt::Env = e::env();
    var et: w::EditText = w::EditText::new_context(env, e::context());
    let raw: *u8 = et.into_raw();
    let watcher: jni::jobject = dex::new_with_token(env, dex::text_class(), { #addr(n) as i64 });
    var t: w::EditText = w::EditText::from_global(env, raw);
    var tv: w::TextView = t.as_text_view();
    tv.add_text_changed_listener(watcher);
    tv.set_single_line_z(true);
    // IME_ACTION_SEARCH — the magnifier on the keyboard's action key. Android
    // has no search-field WIDGET; the search-ness is the IME action plus, on a
    // real design, an icon. MANIFEST §2 carries the icon as a debt.
    tv.set_ime_options(3 as i32);
    let _keep: *u8 = t.into_raw();
    env.delete_local_ref(watcher);
    arm_edit(env, raw, n);
    return raw;
}

// The input_view block is shared, so the apply is too — only the dirty BITS
// differ per kind, and they happen to sit at the same offsets because
// gen_contract.py emits the block once.
// THE INPUT TYPE, which on Android is ONE integer carrying five of facet's
// verbs at once: the keyboard, the secure bit, the multi-line bit, the spell
// checker and the prediction. They cannot be written separately — `setInputType`
// replaces the word — so they are read together and written once.
//
// The constants are typed out rather than read from `InputType`, which is an
// interface of static finals and not in the bound class list; each is named
// beside its number.
fn apply_input_flags(env: rt::Env, tv: w::TextView, iv: *props::InputViewProps,
                     secure: bool, multiline: bool) {
    let class_text: i32 = 1 as i32;              // TYPE_CLASS_TEXT
    let class_number: i32 = 2 as i32;            // TYPE_CLASS_NUMBER
    let class_phone: i32 = 3 as i32;             // TYPE_CLASS_PHONE
    let var_email: i32 = 32 as i32;              // TYPE_TEXT_VARIATION_EMAIL_ADDRESS
    let var_uri: i32 = 16 as i32;                // TYPE_TEXT_VARIATION_URI
    let var_password: i32 = 128 as i32;          // TYPE_TEXT_VARIATION_PASSWORD
    let var_no_suggest: i32 = 524288 as i32;     // TYPE_TEXT_FLAG_NO_SUGGESTIONS
    let flag_multi: i32 = 131072 as i32;         // TYPE_TEXT_FLAG_MULTI_LINE
    let flag_cap_sent: i32 = 16384 as i32;       // TYPE_TEXT_FLAG_CAP_SENTENCES

    var t: i32 = match { (*iv).keyboard } {
        vocab::Keyboard::Numeric => class_number,
        vocab::Keyboard::Telephone => class_phone,
        vocab::Keyboard::Email => class_text | var_email,
        vocab::Keyboard::Url => class_text | var_uri,
        // `Chat` is a sentence keyboard — capitals after a full stop, which is
        // what a message field does everywhere.
        vocab::Keyboard::Chat => class_text | flag_cap_sent,
        // `Plain` is text with the helpers OFF, which is what plain means.
        vocab::Keyboard::Plain => class_text | var_no_suggest,
        _ => class_text,
    };
    if secure { t = class_text | var_password; }
    if multiline { t = t | flag_multi; }
    // SPELLING AND PREDICTION ARE THE SAME BIT on Android — `NO_SUGGESTIONS`
    // turns off the underline and the strip together, so either one asking for
    // off gets it. Two verbs, one switch, said here rather than pretending to
    // honour them apart.
    if !{ (*iv).checks_spelling } || !{ (*iv).predicts_text } { t = t | var_no_suggest; }
    tv.set_input_type(t);

    // READ-ONLY is not an Android property: a field that cannot be edited is
    // one with no key listener and no focus in touch mode. `setEnabled(false)`
    // would grey it out, which is a different claim — facet has `is_enabled`
    // for that.
    let ro: bool = { (*iv).is_read_only };
    var view: w::View = w::View::from_global(env, tv.as_obj());
    view.set_focusable_z(!ro);
    view.set_focusable_in_touch_mode(!ro);
    paint::unwrap_keep(view);
    tv.set_cursor_visible(!ro);
    // A LENGTH CAP is an InputFilter array, which lives in FacetDraw.
    dex::max_length(env, tv.as_obj(), { { (*iv).max_length } as i32 });
    return;
}

// A CLEAR BUTTON, which Android has no property for: the convention is a
// drawable at the END of the field, and `ic_menu_close_clear_cancel` is the
// platform's own glyph for it — the system tier again, by name, rather than one
// drawn here.
//
// WHAT IS ABSENT is the TOUCH: a compound drawable is decoration, and making it
// clear the field needs a touch listener that reads the x against the field's
// padding. MANIFEST §2 carries that; the glyph appearing while editing is the
// half that is honest on its own.
fn apply_clear_button(env: rt::Env, tv: w::TextView, mode: vocab::ClearButton) {
    let show: bool = match mode {
        vocab::ClearButton::WhileEditing => true,
        vocab::ClearButton::Never => false,
    };
    if !show {
        tv.set_compound_drawables_relative_with_intrinsic_bounds_drawable_drawable_drawable_drawable(
            0 as jni::jobject, 0 as jni::jobject, 0 as jni::jobject, 0 as jni::jobject);
        return;
    }
    let id: i32 = drawable_id(env, #str_ptr("ic_menu_close_clear_cancel\0"));
    if id == (0 as i32) { return; }
    let d: jni::jobject = env.call_object_1(
        e::context(), #str_ptr("android/content/Context\0"), #str_ptr("getDrawable\0"),
        #str_ptr("(I)Landroid/graphics/drawable/Drawable;\0"), jni::arg_int(id));
    env.clear_exception();
    if d == (0 as jni::jobject) { return; }
    tv.set_compound_drawables_relative_with_intrinsic_bounds_drawable_drawable_drawable_drawable(
        0 as jni::jobject, 0 as jni::jobject, d, 0 as jni::jobject);
    env.delete_local_ref(d);
    return;
}

// A MAGNIFIER AND A CANCEL, as compound drawables. Tinted per glyph, which
// needs two drawables rather than a tint on the view: `setCompoundDrawableTint`
// colours BOTH and facet names them separately.
//
// WHAT IS ABSENT is the cancel's TOUCH — a compound drawable is decoration, and
// making it clear the field needs a touch listener that reads the x against the
// field's padding. MANIFEST §2, the same line the text field's clear button
// carries.
fn apply_search_glyphs(env: rt::Env, v: *u8, search: vocab::Color, cancel: vocab::Color) {
    let mag: jni::jobject = tinted_drawable(env, #str_ptr("ic_menu_search\0"), search);
    let clear: jni::jobject =
        tinted_drawable(env, #str_ptr("ic_menu_close_clear_cancel\0"), cancel);
    var tv: w::TextView = w::TextView::from_global(env, v);
    tv.set_compound_drawables_relative_with_intrinsic_bounds_drawable_drawable_drawable_drawable(
        mag, 0 as jni::jobject, clear, 0 as jni::jobject);
    let _k: *u8 = tv.into_raw();
    if mag != (0 as jni::jobject) { env.delete_local_ref(mag); }
    if clear != (0 as jni::jobject) { env.delete_local_ref(clear); }
    return;
}

// One of Android's own drawables, tinted if facet named a colour. A LOCAL ref
// or null.
fn tinted_drawable(env: rt::Env, name: *u8, c: vocab::Color) -> jni::jobject {
    let id: i32 = drawable_id(env, name);
    if id == (0 as i32) { return 0 as jni::jobject; }
    let d: jni::jobject = env.call_object_1(
        e::context(), #str_ptr("android/content/Context\0"), #str_ptr("getDrawable\0"),
        #str_ptr("(I)Landroid/graphics/drawable/Drawable;\0"), jni::arg_int(id));
    env.clear_exception();
    if d == (0 as jni::jobject) { return 0 as jni::jobject; }
    if c.is_set() {
        env.call_void_1(d, #str_ptr("android/graphics/drawable/Drawable\0"),
                        #str_ptr("setTint\0"), #str_ptr("(I)V\0"),
                        jni::arg_int(paint::argb_of(c)));
        env.clear_exception();
    }
    return d;
}

// THE ACTION KEY's label, which is an IME option. `Default` is UNSPECIFIED —
// the keyboard picks, which is what "default" means — and the five named ones
// are Android's own five.
fn set_return_key(env: rt::Env, v: *u8, key: vocab::ReturnKey) {
    let action: i32 = match key {
        vocab::ReturnKey::Done => 6 as i32,      // IME_ACTION_DONE
        vocab::ReturnKey::Go => 2 as i32,        // IME_ACTION_GO
        vocab::ReturnKey::Next => 5 as i32,      // IME_ACTION_NEXT
        vocab::ReturnKey::Search => 3 as i32,    // IME_ACTION_SEARCH
        vocab::ReturnKey::Send => 4 as i32,      // IME_ACTION_SEND
        vocab::ReturnKey::Default => 0 as i32,   // IME_ACTION_UNSPECIFIED
    };
    var tv: w::TextView = w::TextView::from_global(env, v);
    tv.set_ime_options(action);
    let _k: *u8 = tv.into_raw();
    return;
}

// THE TWO READS BEYOND KEYSTROKES: the action key and focus. One adapter
// carries both, because they arrive on the same view and the same token.
//
// FOCUS IS ON THE SHARED BAND, not on the input tier — `on_focus` and
// `on_blur` are CommonProps, so every node could want them. They are armed
// here because an EditText is the only kind that takes focus in a facet tree
// today; the day a node with `on_focus` and no field appears, `wants_focus_
// events` is the reader that says so.
fn arm_edit(env: rt::Env, raw: *u8, n: *core::Node) {
    let listener: jni::jobject =
        dex::new_with_token(env, dex::edit_class(), { #addr(n) as i64 });
    if listener == (0 as jni::jobject) { return; }
    var tv: w::TextView = w::TextView::from_global(env, raw);
    tv.set_on_editor_action_listener(listener);
    let _k: *u8 = tv.into_raw();
    var view: w::View = w::View::from_global(env, raw);
    view.set_on_focus_change_listener(listener);
    paint::unwrap_keep(view);
    env.delete_local_ref(listener);
    return;
}

// The action key was pressed on a field, an area or a search field. Which
// handler that is belongs to the KIND, because the three declare their own.
fn fire_submit(token: i64) {
    let n: *core::Node = { token as *core::Node };
    if n == (0 as *core::Node) { return; }
    let d: *core::Data = core::node_data(n);
    if d == (0 as *core::Data) { return; }
    let raw: *u8 = { (*d).props };
    if raw == (0 as *u8) { return; }
    let kind: u32 = { (*d).kind };
    var h: fn(*u8, *u8) = props::no_handler;
    var ctx: *u8 = 0 as *u8;
    if kind == props::K_TEXT_FIELD {
        let p: *props::TextFieldProps = raw as *props::TextFieldProps;
        h = { (*p).on_submit };
        ctx = { (*p).on_submit_ctx };
    } else if kind == props::K_TEXT_AREA {
        let p: *props::TextAreaProps = raw as *props::TextAreaProps;
        h = { (*p).on_submit };
        ctx = { (*p).on_submit_ctx };
    } else if kind == props::K_SEARCH_FIELD {
        let p: *props::SearchFieldProps = raw as *props::SearchFieldProps;
        h = { (*p).on_submit };
        ctx = { (*p).on_submit_ctx };
    }
    if h != props::no_handler { h(core::view_of(n), ctx); }
    return;
}

// Focus arrived or left. The handlers are the SHARED band's, so facet's own
// readers fire them — a backend that reached into CommonProps itself would be
// a second copy of the same two lines.
fn fire_focus(token: i64, focused: bool) {
    let n: *core::Node = { token as *core::Node };
    if n == (0 as *core::Node) { return; }
    if focused { core::fire_focus_handler(n); } else { core::fire_blur_handler(n); }
    return;
}

fn apply_input_common(v: *u8, iv: *props::InputViewProps, text_bit: bool,
                      placeholder_bit: bool, color_bit: bool, size_bit: bool,
                      type_bit: bool, align: vocab::TextAlign,
                      vertical: vocab::TextAlign, flags_bit: bool = false,
                      secure: bool = false, caret_bit: bool = false,
                      multiline: bool = false) {
    let env: rt::Env = e::env();
    var et: w::EditText = w::EditText::from_global(env, v);
    var tv: w::TextView = et.as_text_view();
    if text_bit {
        var buf: [u8; 1024] = #zero::[[u8; 1024]]();
        let base: *u8 = { #addr_of(buf[0]) };
        if paint::cstr({ (*iv).text.view() }, base, 1024 as usize) {
            var have: [u8; 1024] = #zero::[[u8; 1024]]();
            let hbase: *u8 = { #addr_of(have[0]) };
            read_field_text(env, v, hbase, 1024 as usize);
            if !paint::same_cstr(base, hbase) { tv.set_text_str(base); }
        }
    }
    if placeholder_bit {
        var buf: [u8; 512] = #zero::[[u8; 512]]();
        let base: *u8 = { #addr_of(buf[0]) };
        if paint::cstr({ (*iv).placeholder.view() }, base, 512 as usize) {
            let hint: jni::jstring = env.new_string_utf(base);
            env.call_void_1(v, #str_ptr("android/widget/TextView\0"), #str_ptr("setHint\0"),
                            #str_ptr("(Ljava/lang/CharSequence;)V\0"), rt::arg_object(hint));
            env.delete_local_ref(hint);
        }
    }
    if color_bit {
        let c: vocab::Color = { (*iv).text_color };
        if c.is_set() { tv.set_text_color_i(paint::argb_of(c)); }
    }
    if size_bit {
        apply_text_size(tv, { (*iv).font_size }, { (*iv).font_scales });
    }
    if flags_bit { apply_input_flags(env, tv, iv, secure, multiline); }
    if placeholder_bit {
        let pc: vocab::Color = { (*iv).placeholder_color };
        if pc.is_set() { tv.set_hint_text_color_i(paint::argb_of(pc)); }
    }
    // THE CARET, and a SELECTION when one is asked for. `selection_length` of
    // zero is a caret, which is what `setSelection(int)` is; anything else is
    // the two-argument call.
    if caret_bit {
        let at: i64 = { (*iv).cursor_position };
        let len: i64 = { (*iv).selection_length };
        if at >= (0 as i64) {
            var et2: w::EditText = w::EditText::from_global(env, v);
            if len > (0 as i64) { et2.set_selection_i_i({ at as i32 }, { (at +% len) as i32 }); }
            else { et2.set_selection_i({ at as i32 }); }
            let _k: *u8 = et2.into_raw();
        }
    }
    if type_bit {
        var st: TextStyle = TextStyle::none();
        st.family = { (*iv).font_family.view() };
        st.weight = { (*iv).font_weight };
        st.is_italic = { (*iv).is_italic };
        st.size = { (*iv).font_size };
        st.scales = { (*iv).font_scales };
        st.align = align;
        st.vertical_align = vertical;
        // A FIELD WRAPS OR IT DOES NOT, and that is the kind's shape rather
        // than a prop: an area is multi-line and the other two are one line.
        // `line_break` is not on an input view's vocabulary at all.
        st.line_break = vocab::LineBreak::WordWrap;
        st.transform = { (*iv).text_transform };
        st.character_spacing = { (*iv).character_spacing };
        apply_text_style(env, tv, st);
    }
    let _keep: *u8 = et.into_raw();
    return;
}

fn apply_text_area(v: *u8, n: *core::Node, dirty: u64) {
    let p: *props::TextAreaProps = props_of(n, props::K_TEXT_AREA) as *props::TextAreaProps;
    if p == (0 as *props::TextAreaProps) { return; }
    let typography: u64 = text_area::P_FONT_FAMILY | text_area::P_FONT_WEIGHT
                        | text_area::P_IS_ITALIC | text_area::P_TEXT_TRANSFORM
                        | text_area::P_CHARACTER_SPACING | text_area::P_TEXT_ALIGN
                        | text_area::P_VERTICAL_ALIGN | text_area::P_FONT_SIZE;
    // AUTO SIZE, which Android grew in API 26 — this backend's floor exactly.
    // `TextChanges` is the platform's own default axis and granularity; the
    // other answer is the fixed size the style already set.
    if (dirty & text_area::P_AUTO_SIZE) != (0 as u64) || dirty == paint::all_bits() {
        let env2: rt::Env = e::env();
        var tv2: w::TextView = w::TextView::from_global(env2, v);
        tv2.set_auto_size_text_type_with_defaults(match { (*p).auto_size } {
            vocab::AutoSize::TextChanges => 1 as i32,   // AUTO_SIZE_TEXT_TYPE_UNIFORM
            vocab::AutoSize::Disabled => 0 as i32,      // AUTO_SIZE_TEXT_TYPE_NONE
        });
        let _k2: *u8 = tv2.into_raw();
    }
    let flags: u64 = text_area::P_KEYBOARD | text_area::P_CHECKS_SPELLING
                   | text_area::P_PREDICTS_TEXT | text_area::P_IS_READ_ONLY
                   | text_area::P_MAX_LENGTH;
    apply_input_common(v, { #addr_of((*p).input_view) },
                       (dirty & text_area::P_TEXT) != (0 as u64),
                       (dirty & (text_area::P_PLACEHOLDER
                                 | text_area::P_PLACEHOLDER_COLOR)) != (0 as u64),
                       (dirty & text_area::P_TEXT_COLOR) != (0 as u64),
                       (dirty & (text_area::P_FONT_SIZE | text_area::P_FONT_SCALES)) != (0 as u64),
                       (dirty & typography) != (0 as u64) || dirty == paint::all_bits(),
                       { (*p).text_align }, { (*p).vertical_align },
                       (dirty & flags) != (0 as u64) || dirty == paint::all_bits(),
                       false,
                       (dirty & (text_area::P_CURSOR_POSITION
                                 | text_area::P_SELECTION_LENGTH)) != (0 as u64),
                       // AN AREA IS THE MULTI-LINE ONE — the kind carries that,
                       // not a prop, so it is passed rather than read.
                       true);
    // AFTER THE TEXT IS WRITTEN, and that ordering is not a preference.
    //
    // The runs style what is already in the control, so the spannable is built
    // from the VIEW'S text — and `setText` on an EditText runs the TextWatcher,
    // which writes what it sees back into the props. Restyling first therefore
    // committed the view's OLD text (empty, at create), the watcher copied that
    // emptiness into `text`, and the real text was gone before anything could
    // write it. The editor showed its placeholder.
    //
    // An empty run list is nothing to do at all rather than "no styling applied
    // over the top": calling in with it would rebuild the spannable on every
    // keystroke for no change.
    let restyle: u64 = text_area::P_STYLE_RUNS | text_area::P_TEXT;
    if (dirty & restyle) != (0 as u64) {
        let runs: *vocab::StyleRuns = { #addr_of((*p).style_runs) };
        if !{ (*runs).is_empty() } {
            var cur: [u8; 4096] = #zero::[[u8; 4096]]();
            let cbase: *u8 = { #addr_of(cur[0]) };
            let _c: bool = paint::cstr({ (*p).input_view.text.view() }, cbase,
                                       4096 as usize);
            let clen: usize = paint::cstr_len(cbase);
            apply_style_runs(e::env(), v, runs, { #str_from_raw_parts(cbase, clen) });
        }
    }
    return;
}

fn apply_search_field(v: *u8, n: *core::Node, dirty: u64) {
    let p: *props::SearchFieldProps = props_of(n, props::K_SEARCH_FIELD) as *props::SearchFieldProps;
    if p == (0 as *props::SearchFieldProps) { return; }
    let typography: u64 = search_field::P_FONT_FAMILY | search_field::P_FONT_WEIGHT
                        | search_field::P_IS_ITALIC | search_field::P_TEXT_TRANSFORM
                        | search_field::P_CHARACTER_SPACING | search_field::P_TEXT_ALIGN
                        | search_field::P_VERTICAL_ALIGN | search_field::P_FONT_SIZE;
    let flags: u64 = search_field::P_KEYBOARD | search_field::P_CHECKS_SPELLING
                   | search_field::P_PREDICTS_TEXT | search_field::P_IS_READ_ONLY
                   | search_field::P_MAX_LENGTH;
    apply_input_common(v, { #addr_of((*p).input_view) },
                       (dirty & search_field::P_TEXT) != (0 as u64),
                       (dirty & (search_field::P_PLACEHOLDER
                                 | search_field::P_PLACEHOLDER_COLOR)) != (0 as u64),
                       (dirty & search_field::P_TEXT_COLOR) != (0 as u64),
                       (dirty & (search_field::P_FONT_SIZE | search_field::P_FONT_SCALES)) != (0 as u64),
                       (dirty & typography) != (0 as u64) || dirty == paint::all_bits(),
                       { (*p).text_align }, { (*p).vertical_align },
                       (dirty & flags) != (0 as u64) || dirty == paint::all_bits(),
                       false,
                       (dirty & (search_field::P_CURSOR_POSITION
                                 | search_field::P_SELECTION_LENGTH)) != (0 as u64),
                       false);
    // THE RETURN KEY, which a search field states outright and the other two
    // take from their own verb.
    if (dirty & search_field::P_RETURN_KEY) != (0 as u64) {
        set_return_key(e::env(), v, { (*p).return_key });
    }
    // THE TWO GLYPHS a search field has: a magnifier at the start and a cancel
    // at the end. Android has no search WIDGET — the search-ness is the IME
    // action plus these two — so they are the platform's own drawables, tinted
    // by the colours facet names for them.
    if (dirty & (search_field::P_SEARCH_ICON_COLOR
                 | search_field::P_CANCEL_BUTTON_COLOR)) != (0 as u64)
       || dirty == paint::all_bits() {
        apply_search_glyphs(e::env(), v, { (*p).search_icon_color },
                            { (*p).cancel_button_color });
    }
    return;
}

// The input block is reached by KIND, because the three structs put it at their
// own offsets and only the kind says which is there.
fn input_view_of(n: *core::Node) -> *props::InputViewProps {
    let d: *core::Data = core::node_data(n);
    if d == (0 as *core::Data) { return 0 as *props::InputViewProps; }
    let raw: *u8 = { (*d).props };
    if raw == (0 as *u8) { return 0 as *props::InputViewProps; }
    let kind: u32 = { (*d).kind };
    if kind == props::K_TEXT_FIELD {
        let p: *props::TextFieldProps = raw as *props::TextFieldProps;
        return { #addr_of((*p).input_view) };
    }
    if kind == props::K_TEXT_AREA {
        let p: *props::TextAreaProps = raw as *props::TextAreaProps;
        return { #addr_of((*p).input_view) };
    }
    if kind == props::K_SEARCH_FIELD {
        let p: *props::SearchFieldProps = raw as *props::SearchFieldProps;
        return { #addr_of((*p).input_view) };
    }
    return 0 as *props::InputViewProps;
}

// ---- image and icon_button ---------------------------------------------------
// WHERE AN IMAGE COMES FROM is the Android-shaped question here, and this pass
// answers only half of it. `BitmapFactory.decodeFile` reads a FILESYSTEM path,
// which covers a source the app wrote or downloaded; an image packed into the
// APK lives in `assets/` and is reached through an AssetManager instead, and
// that is MANIFEST §2's debt. A source that decodes to null leaves the view
// empty and warns once rather than drawing a placeholder — an image that
// silently is not there looks like a layout bug.
//
// The FIT enum is an object-typed static field (`ImageView$ScaleType.CENTER_CROP`
// and friends), which the generator SKIPS by design — it emits no invented
// objects. So the four are read by hand.

fn scale_type(env: rt::Env, name: *u8) -> jni::jobject {
    let cls: jni::jclass = env.class_cached(#str_ptr("android/widget/ImageView$ScaleType\0"));
    let fid: jni::jfieldID = env.static_field_id(
        cls, name, #str_ptr("Landroid/widget/ImageView$ScaleType;\0"));
    if fid == (0 as jni::jfieldID) { return 0 as jni::jobject; }
    return { (*(*env.raw())).GetStaticObjectField(env.raw(), cls, fid) };
}

fn scale_type_for(env: rt::Env, fit: vocab::ImageFit) -> jni::jobject {
    return match fit {
        // CENTER_CROP fills the box and crops the overflow; FIT_CENTER fits the
        // whole image inside it. The two are easy to swap and the difference is
        // invisible until an image is the wrong aspect.
        vocab::ImageFit::AspectFill => scale_type(env, #str_ptr("CENTER_CROP\0")),
        vocab::ImageFit::AspectFit => scale_type(env, #str_ptr("FIT_CENTER\0")),
        vocab::ImageFit::Center => scale_type(env, #str_ptr("CENTER\0")),
        vocab::ImageFit::Fill => scale_type(env, #str_ptr("FIT_XY\0")),
    };
}

// WHERE AN IMAGE COMES FROM, in the order an Android app would look:
//
//   a FILE on disk        — what the camera and the downloads directory hand back
//   an APK ASSET          — `assets/logo.png`, opened through the AssetManager
//   a DRAWABLE RESOURCE   — `res/drawable/logo.png`, resolved by NAME
//
// Three doors and no guessing: each is asked exactly what it is, and a source
// that is none of them warns once. An SF Symbol name (`square.and.arrow.up`) is
// none of them and never can be — Android ships no such glyph set, and mapping
// one onto `android.R.drawable` by hand would be inventing a picture the app
// did not ask for. MANIFEST §1 says so.
fn set_source(env: rt::Env, v: *u8, source: str) {
    var buf: [u8; 1024] = #zero::[[u8; 1024]]();
    let base: *u8 = { #addr_of(buf[0]) };
    if !paint::cstr(source, base, 1024 as usize) { return; }

    var bmp: jni::jobject = w::BitmapFactory::decode_file_str(env, base);
    if bmp == (0 as jni::jobject) {
        // decodeFile sets no exception, but decodeStream on a missing asset
        // throws — so the slate is cleared between doors either way.
        env.clear_exception();
        bmp = decode_asset(env, base);
    }
    if bmp != (0 as jni::jobject) {
        var iv: w::ImageView = w::ImageView::from_global(env, v);
        iv.set_image_bitmap(bmp);
        let _keep: *u8 = iv.into_raw();
        env.delete_local_ref(bmp);
        return;
    }
    let id: i32 = drawable_id(env, base);
    if id != (0 as i32) {
        var iv: w::ImageView = w::ImageView::from_global(env, v);
        iv.set_image_resource(id);
        let _keep: *u8 = iv.into_raw();
        return;
    }
    log::warn(#str_ptr("image: source is not a file, an asset or a drawable - see MANIFEST 1\0"));
    return;
}

// `assets/<name>`, opened and decoded. The stream is CLOSED whatever the decode
// answered: an AssetManager holds a file descriptor per open stream.
fn decode_asset(env: rt::Env, name: *u8) -> jni::jobject {
    let assets: jni::jobject = env.call_object_0(
        e::context(), #str_ptr("android/content/Context\0"), #str_ptr("getAssets\0"),
        #str_ptr("()Landroid/content/res/AssetManager;\0"));
    if assets == (0 as jni::jobject) { env.clear_exception(); return 0 as jni::jobject; }
    let js: jni::jstring = env.new_string_utf(name);
    let stream: jni::jobject = env.call_object_1(
        assets, #str_ptr("android/content/res/AssetManager\0"), #str_ptr("open\0"),
        #str_ptr("(Ljava/lang/String;)Ljava/io/InputStream;\0"), rt::arg_object(js));
    env.delete_local_ref(js);
    if stream == (0 as jni::jobject) {
        // A MISSING ASSET IS AN IOException, and a pending exception poisons
        // the next JNI call rather than this one — which is the shape of the
        // NoSuchMethodError that took a debugging round out of cpc-bindgen.
        env.clear_exception();
        env.delete_local_ref(assets);
        return 0 as jni::jobject;
    }
    let bmp: jni::jobject = w::BitmapFactory::decode_stream_input_stream(env, stream);
    env.call_void_0(stream, #str_ptr("java/io/InputStream\0"), #str_ptr("close\0"),
                    #str_ptr("()V\0"));
    env.clear_exception();
    env.delete_local_ref(stream);
    env.delete_local_ref(assets);
    return bmp;
}

// `res/drawable/<name>`, by name — the APP's first, then ANDROID'S OWN.
//
// The second package is the system tier `symbol.cplus` describes: "the
// platform's own set. macOS reads SF Symbols, Linux the freedesktop theme,
// Windows Segoe Fluent." Android's is `android.R.drawable`, and asking for it
// by name is how a caller reaches it without this backend carrying a table of
// translations from somebody else's vocabulary.
//
// `getIdentifier` answers 0 for a name that is not a resource, which includes
// every name with a dot in it — so an SF Symbol name falls through both
// packages without a special case.
fn drawable_id(env: rt::Env, name: *u8) -> i32 {
    let own: i32 = drawable_id_in(env, name, 0 as jni::jobject);
    if own != (0 as i32) { return own; }
    let android_pkg: jni::jstring = env.new_string_utf(#str_ptr("android\0"));
    let sys: i32 = drawable_id_in(env, name, android_pkg);
    env.delete_local_ref(android_pkg);
    return sys;
}

// `package` null means the app's own, which is what `getPackageName` answers.
fn drawable_id_in(env: rt::Env, name: *u8, package: jni::jobject) -> i32 {
    let res: jni::jobject = env.call_object_0(
        e::context(), #str_ptr("android/content/Context\0"), #str_ptr("getResources\0"),
        #str_ptr("()Landroid/content/res/Resources;\0"));
    if res == (0 as jni::jobject) { env.clear_exception(); return 0 as i32; }
    var pkg: jni::jobject = package;
    var own_pkg: bool = false;
    if pkg == (0 as jni::jobject) {
        pkg = env.call_object_0(
            e::context(), #str_ptr("android/content/Context\0"), #str_ptr("getPackageName\0"),
            #str_ptr("()Ljava/lang/String;\0"));
        own_pkg = true;
    }
    let js: jni::jstring = env.new_string_utf(name);
    let kind: jni::jstring = env.new_string_utf(#str_ptr("drawable\0"));
    let cls: jni::jclass = env.class_cached(#str_ptr("android/content/res/Resources\0"));
    let mid: jni::jmethodID = env.method_id(cls, #str_ptr("getIdentifier\0"),
        #str_ptr("(Ljava/lang/String;Ljava/lang/String;Ljava/lang/String;)I\0"));
    var id: i32 = 0 as i32;
    if mid != (0 as jni::jmethodID) {
        var args: [jni::JValue; 3] = [jni::arg_object(js), jni::arg_object(kind),
                                      jni::arg_object(pkg)];
        id = { (*(*env.raw())).CallIntMethodA(env.raw(), res, mid, #addr_of(args[0])) };
    }
    env.clear_exception();
    env.delete_local_ref(kind);
    env.delete_local_ref(js);
    // Only the one this frame MADE — the caller's package string is theirs.
    if own_pkg { env.delete_local_ref(pkg); }
    env.delete_local_ref(res);
    return id;
}

fn set_fit(env: rt::Env, v: *u8, fit: vocab::ImageFit) {
    let st: jni::jobject = scale_type_for(env, fit);
    if st == (0 as jni::jobject) { return; }
    env.call_void_1(v, #str_ptr("android/widget/ImageView\0"), #str_ptr("setScaleType\0"),
                    #str_ptr("(Landroid/widget/ImageView$ScaleType;)V\0"), rt::arg_object(st));
    env.delete_local_ref(st);
    return;
}

fn create_image(n: *core::Node) -> *u8 {
    let env: rt::Env = e::env();
    var iv: w::ImageView = w::ImageView::new_context(env, e::context());
    return iv.into_raw();
}

fn apply_image(v: *u8, n: *core::Node, dirty: u64) {
    let p: *props::ImageProps = props_of(n, props::K_IMAGE) as *props::ImageProps;
    if p == (0 as *props::ImageProps) { return; }
    let env: rt::Env = e::env();
    if (dirty & image::P_SOURCE) != (0 as u64) { set_source(env, v, { (*p).source.view() }); }
    if (dirty & image::P_FIT) != (0 as u64) { set_fit(env, v, { (*p).fit }); }
    // AN ANIMATED IMAGE is an AnimatedImageDrawable or an AnimationDrawable
    // depending on where it came from — both answer `start` and `stop`, and
    // both are reached through the one thing they have in common: the drawable
    // the ImageView is holding.
    if (dirty & image::P_IS_ANIMATION_PLAYING) != (0 as u64) {
        play_image(env, v, { (*p).is_animation_playing });
    }
    // `is_opaque` — a promise that nothing behind shows through. Android reads
    // that from the drawable rather than from a flag on the view, so what this
    // can honour is the OPPOSITE claim: a view told it is not opaque must not
    // be skipped. MANIFEST §2 carries the rest.
    if (dirty & image::P_IS_OPAQUE) != (0 as u64) {
        var iv2: w::View = w::View::from_global(env, v);
        iv2.set_will_not_draw(false);
        paint::unwrap_keep(iv2);
    }
    return;
}

// A GLYPH ONLY, which is the posture the kind's name states — so it is a
// BORDERLESS button, the same style `text_button` takes.
//
// The default `imageButtonStyle` carries an opaque slab of a background, and a
// glyph button wearing it is a grey rectangle with an icon on it rather than an
// icon. When the glyph does not resolve at all — an SF Symbol name, which
// Android has no answer for (MANIFEST §1) — that slab was the whole control,
// and it read as a broken button rather than as an empty one.
fn create_icon_button(n: *core::Node) -> *u8 {
    let env: rt::Env = e::env();
    var ib: w::ImageButton = w::ImageButton::new_context_attribute_set_i(
        env, e::context(), 0 as jni::jobject, borderless_style(env));
    let raw: *u8 = ib.into_raw();
    let listener: jni::jobject = dex::new_with_token(env, dex::click_class(), { #addr(n) as i64 });
    var view: w::View = w::View::from_global(env, raw);
    view.set_on_click_listener(listener);
    paint::unwrap_keep(view);
    env.delete_local_ref(listener);
    // NO CHROME AT ALL, which is what glyph-only means — and what leaves ONE
    // press to see. The borderless style still carries a background ripple of
    // its own, bounded to the whole box, so a wide glyph button lit up as a
    // band with a circle inside it. The band is the part that is not the
    // control.
    //
    // Cleared BEFORE `views::create` remembers the platform's background, so
    // "facet declares nothing" restores nothing rather than putting the band
    // back on the next apply.
    var bare: w::View = w::View::from_global(env, raw);
    bare.set_background(0 as jni::jobject);
    paint::unwrap_keep(bare);
    // ROUND, because a glyph button's press is round on this platform — and the
    // theme's own borderless ripple IS that circle, rather than one this
    // package draws from a mask that would be an ellipse in a wide box.
    dex::tap_feedback_borderless(env, raw);
    arm_touch(env, raw, n);
    return raw;
}

fn apply_icon_button(v: *u8, n: *core::Node, dirty: u64) {
    let p: *props::IconButtonProps = props_of(n, props::K_ICON_BUTTON) as *props::IconButtonProps;
    if p == (0 as *props::IconButtonProps) { return; }
    let env: rt::Env = e::env();
    if (dirty & icon_button::P_SOURCE) != (0 as u64) { set_source(env, v, { (*p).source.view() }); }
    if (dirty & icon_button::P_FIT) != (0 as u64) { set_fit(env, v, { (*p).fit }); }
    // ITS OWN CHROME, the same four a button has — and asking for any of them
    // is asking for a background, which is what takes this kind OUT of the
    // glyph-only posture it wears by default.
    let chrome: u64 = icon_button::P_BORDERED | icon_button::P_BORDER_COLOR
                    | icon_button::P_BORDER_WIDTH | icon_button::P_CORNER_RADIUS
                    | props::C_BACKGROUND_COLOR | props::C_CORNER_RADIUS;
    if (dirty & chrome) != (0 as u64) {
        apply_control_chrome(env, v, n, { (*p).bordered }, { (*p).border_color },
                             { (*p).border_width }, { (*p).corner_radius });
    }
    // A TOGGLING BUTTON keeps its state, and Android's word for that state is
    // SELECTED — `setChecked` belongs to a CompoundButton, which an ImageButton
    // is not. The selected state is what a background's state list draws from.
    if (dirty & (icon_button::P_TOGGLES | icon_button::P_ON)) != (0 as u64) {
        var view: w::View = w::View::from_global(env, v);
        if { (*p).toggles } { view.set_selected({ (*p).on }); }
        paint::unwrap_keep(view);
    }
    // `is_opaque` — a promise that nothing behind this view shows through, so
    // the platform may skip drawing what is under it. Android's word is the
    // same one facet uses, one layer down.
    if (dirty & icon_button::P_IS_OPAQUE) != (0 as u64) {
        var view: w::View = w::View::from_global(env, v);
        view.set_will_not_draw(false);
        paint::unwrap_keep(view);
    }
    return;
}

fn fire_icon_button_click(n: *core::Node) -> bool {
    let p: *props::IconButtonProps =
        props_of(n, props::K_ICON_BUTTON) as *props::IconButtonProps;
    if p == (0 as *props::IconButtonProps) { return false; }
    let h: fn(*u8, *u8) = { (*p).on_clicked };
    if h != props::no_handler { h(core::view_of(n), { (*p).on_clicked_ctx }); }
    return true;
}

// ---- scroll ------------------------------------------------------------------
// A ScrollView takes exactly ONE child, so facet's children go into a FacetHost
// inside it and the scroll's own view is never their parent. `document_host`
// below is the redirect, and `insert` / `remove` go through it — the same shape
// facet_gtk uses for its ScrolledWindow, and for the same reason.
//
// The document is sized by `geometry`, not here: it is the union of the
// children and never smaller than the viewport, because a document SHORT of its
// scroll leaves a strip nothing draws. A document that merely wrapped its
// content would also never scroll, since Android would size the ScrollView to
// fit it.
//
// The axis is a CONSTRUCTOR choice: ScrollView scrolls vertically and
// HorizontalScrollView horizontally, and neither turns into the other.
// `ScrollAxis::Both` has no single Android widget — nesting one in the other is
// the usual trick and it fights the gesture arbiter — so it takes the vertical
// one and MANIFEST §2 carries the difference.

// Keyed-tag ids. Shaped like application resource ids because
// `View.setTag(int, Object)` insists: `key >>> 24` must be at least 2.
const SCROLL_DOC_TAG: i32 = 2131886081 as i32;   // 0x7F0F0001

fn create_scroll(n: *core::Node) -> *u8 {
    let env: rt::Env = e::env();
    let p: *props::ScrollProps = props_of(n, props::K_SCROLL) as *props::ScrollProps;
    var horizontal: bool = false;
    if p != (0 as *props::ScrollProps) {
        horizontal = match { (*p).axis } {
            vocab::ScrollAxis::Horizontal => true,
            vocab::ScrollAxis::Both => false,
            vocab::ScrollAxis::Vertical => false,
            vocab::ScrollAxis::Neither => false,
        };
    }
    // A SCROLL YIELDS TO ITS CONTAINER. Without this a scroll nested in a column
    // grows to its content for the same reason the root did — flex sizes an
    // auto node from its children, and a viewport that is as tall as what it
    // holds never scrolls. facet_gtk says the same thing to GTK with
    // `set_propagate_natural_height(false)`.
    { (*n).set_flex_shrink(1.0f64) };
    var raw: *u8 = 0 as *u8;
    if horizontal {
        var hs: w::HorizontalScrollView = w::HorizontalScrollView::new_context(env, e::context());
        raw = hs.into_raw();
    } else {
        var vs: w::ScrollView = w::ScrollView::new_context(env, e::context());
        raw = vs.into_raw();
    }
    // The document, and the KEYED tag that finds it again. A keyed tag rather
    // than the plain one because `paint::configure` already owns
    // `setTag(Object)` — it carries the node's key there, Android having no
    // accessibilityIdentifier — and a second writer would silently take it
    // over. Reading it back as the document is worse: `getTag` then answers a
    // java.lang.String, and `addView` on a String is a CheckJNI abort with a
    // stack pointing at the innocent call that came after it.
    //
    // The key must look like a RESOURCE id. `View.setTag(int, Object)` rejects
    // anything with `key >>> 24 < 2` — an application-specific id is the
    // contract, and a small integer throws.
    let doc: jni::jobject = dex::new_host(env, e::context());
    var group: w::ViewGroup = w::ViewGroup::from_global(env, raw);
    group.add_view_view(doc);
    var gv: w::View = w::View::from_global(env, group.into_raw());
    gv.set_tag_i_object(SCROLL_DOC_TAG, doc);
    paint::unwrap_keep(gv);
    env.delete_local_ref(doc);
    // WHERE THE SCROLL IS, reported back. Without this `observe_scrolled` never
    // fired and `scroll_x()` / `scroll_y()` answered the last value WRITTEN
    // rather than where the finger left it — the same omission facet_uikit
    // found in its own scroll and fixed in scrolling.cplus.
    let listener: jni::jobject =
        dex::new_with_token(env, dex::scroll_class(), { #addr(n) as i64 });
    if listener != (0 as jni::jobject) {
        var sv: w::View = w::View::from_global(env, raw);
        sv.set_on_scroll_change_listener(listener);
        paint::unwrap_keep(sv);
        env.delete_local_ref(listener);
    }
    return raw;
}

fn apply_scroll(v: *u8, n: *core::Node, dirty: u64) {
    let p: *props::ScrollProps = props_of(n, props::K_SCROLL) as *props::ScrollProps;
    if p == (0 as *props::ScrollProps) { return; }
    let env: rt::Env = e::env();
    if (dirty & (scroll::P_SCROLL_X | scroll::P_SCROLL_Y)) != (0 as u64) {
        var view: w::View = w::View::from_global(env, v);
        view.scroll_to({ { (*p).scroll_x } as i32 }, { { (*p).scroll_y } as i32 });
        paint::unwrap_keep(view);
    }
    if (dirty & scroll::P_VERTICAL_SCROLL_BARS) != (0 as u64) {
        var view: w::View = w::View::from_global(env, v);
        view.set_vertical_scroll_bar_enabled(bars_shown({ (*p).vertical_scroll_bars }));
        paint::unwrap_keep(view);
    }
    // `cascades_input` — whether a gesture this scroll does not use passes to an
    // ancestor that can. Android's word for exactly that is NESTED SCROLLING.
    if (dirty & scroll::P_CASCADES_INPUT) != (0 as u64) {
        var view: w::View = w::View::from_global(env, v);
        view.set_nested_scrolling_enabled({ (*p).cascades_input });
        paint::unwrap_keep(view);
    }
    if (dirty & scroll::P_HORIZONTAL_SCROLL_BARS) != (0 as u64) {
        var view: w::View = w::View::from_global(env, v);
        view.set_horizontal_scroll_bar_enabled(bars_shown({ (*p).horizontal_scroll_bars }));
        paint::unwrap_keep(view);
    }
    return;
}

fn bars_shown(b: vocab::ScrollBars) -> bool {
    return match b {
        vocab::ScrollBars::Default => true,
        vocab::ScrollBars::Always => true,
        vocab::ScrollBars::Never => false,
    };
}

// A SCROLL MOVED. The offset is written into the props DIRECTLY, with no
// `core::touch` — marking it dirty would send the value straight back out
// through the next apply's `scrollTo`, the view telling the model telling the
// view, and a scroll that fights the finger is worse than one that cannot be
// read. facet_uikit's scrolling.cplus carries the same rule for the same
// reason.
fn fire_scrolled(token: i64, x: i32, y: i32) {
    let n: *core::Node = { token as *core::Node };
    if n == (0 as *core::Node) { return; }
    // A CAROUSEL IS A SCROLL THAT PAGES, and `observe_scrolled` is the one verb
    // it shares with one — its own record has no offset to write, so the
    // handler is fired and nothing is stored.
    if core::kind_of(n) == props::K_CAROUSEL {
        let cp: *props::CarouselProps = carousel_props(n);
        if cp == (0 as *props::CarouselProps) { return; }
        { (*cp).is_scrolling = true };
        let ch: fn(*u8, *u8) = { (*cp).items_view.observe_scrolled };
        if ch != props::no_handler {
            ch(core::view_of(n), { (*cp).items_view.observe_scrolled_ctx });
        }
        return;
    }
    let p: *props::ScrollProps = props_of(n, props::K_SCROLL) as *props::ScrollProps;
    if p == (0 as *props::ScrollProps) { return; }
    // PIXELS ON THE WAY IN, facet's units on the way out.
    { (*p).scroll_x = e::dp({ x as f64 }) };
    { (*p).scroll_y = e::dp({ y as f64 }) };
    let h: fn(*u8, *u8) = { (*p).observe_scrolled };
    if h != props::no_handler { h(core::view_of(n), { (*p).observe_scrolled_ctx }); }
    return;
}

// The view a node's children go into: its own, except for a scroll, where it is
// the document tagged onto it at create.
fn document_host(v: *u8) -> *u8 {
    if v == (0 as *u8) { return v; }
    if !e::have_env() { return v; }
    let env: rt::Env = e::env();
    var view: w::View = w::View::from_global(env, v);
    let tag: jni::jobject = view.get_tag_i(SCROLL_DOC_TAG);
    paint::unwrap_keep(view);
    if tag == (0 as jni::jobject) { return v; }
    // The tag is a LOCAL ref from getTag and the caller is about to add a view
    // to it, which is fine within this native call — but it must not be handed
    // back as if it were the global facet holds.
    let g: jni::jobject = env.new_global_ref(tag);
    env.delete_local_ref(tag);
    return g;
}

// ---- stepper -----------------------------------------------------------------
// THREE ANDROID VIEWS INSIDE ONE FACET NODE, and the only control here that is
// a composite. Android has no stepper widget: it is a minus, a value and a plus.
//
// A horizontal LinearLayout arranges them, and that is not a breach of "facet
// owns geometry". facet owns the layout of facet's TREE; these three views are
// not in it — no node, no frame, nothing for flex to place — so something has to
// arrange them and LinearLayout is the platform's answer. A layout container
// reaching a facet CHILD would still be wrong.
//
// The two buttons share the node as their token and are told apart by a delta,
// which is why `FacetStep` carries a second field.

const STEP_VALUE_TAG: i32 = 2131886082 as i32;   // 0x7F0F0002 — see SCROLL_DOC_TAG

fn step_button(env: rt::Env, n: *core::Node, caption: *u8, delta: i32) -> jni::jobject {
    var b: w::Button = w::Button::new_context_attribute_set_i(
        env, e::context(), 0 as jni::jobject, borderless_style(env));
    let raw: *u8 = b.into_raw();
    var tv: w::TextView = w::TextView::from_global(env, raw);
    tv.set_text_str(caption);
    let _k1: *u8 = tv.into_raw();
    let listener: jni::jobject =
        dex::new_with_token_i(env, dex::step_class(), { #addr(n) as i64 }, delta);
    var view: w::View = w::View::from_global(env, raw);
    view.set_on_click_listener(listener);
    let _k2: *u8 = view.into_raw();
    env.delete_local_ref(listener);
    return raw;
}

fn create_stepper(n: *core::Node) -> *u8 {
    let env: rt::Env = e::env();
    var row: w::LinearLayout = w::LinearLayout::new_context(env, e::context());
    let raw: *u8 = row.into_raw();
    var r: w::LinearLayout = w::LinearLayout::from_global(env, raw);
    r.set_orientation(0 as i32);   // HORIZONTAL
    r.set_gravity(16 as i32);      // CENTER_VERTICAL

    let minus: jni::jobject = step_button(env, n, #str_ptr("-\0"), (0 as i32) -% (1 as i32));
    var value: w::TextView = w::TextView::new_context(env, e::context());
    let value_raw: *u8 = value.into_raw();
    // Tagged ON THE ROW, which is the view facet holds and the only one `apply`
    // is given. Tagging the value view with itself finds nothing: the lookup
    // starts from the row.
    var rv: w::View = w::View::from_global(env, raw);
    rv.set_tag_i_object(STEP_VALUE_TAG, value_raw);
    let _k: *u8 = rv.into_raw();
    let plus: jni::jobject = step_button(env, n, #str_ptr("+\0"), 1 as i32);

    var group: w::ViewGroup = w::ViewGroup::from_global(env, raw);
    group.add_view_view(minus);
    group.add_view_view(value_raw);
    group.add_view_view(plus);
    let _k3: *u8 = group.into_raw();
    let _k4: *u8 = r.into_raw();
    return raw;
}

fn stepper_value_view(env: rt::Env, v: *u8) -> jni::jobject {
    var view: w::View = w::View::from_global(env, v);
    let t: jni::jobject = view.get_tag_i(STEP_VALUE_TAG);
    paint::unwrap_keep(view);
    return t;
}

fn apply_stepper(v: *u8, n: *core::Node, dirty: u64) {
    let p: *props::StepperProps = props_of(n, props::K_STEPPER) as *props::StepperProps;
    if p == (0 as *props::StepperProps) { return; }
    if (dirty & stepper::P_VALUE) == (0 as u64) { return; }
    let env: rt::Env = e::env();
    let mid: jni::jobject = stepper_value_view(env, v);
    if mid == (0 as jni::jobject) { return; }
    var buf: [u8; 64] = #zero::[[u8; 64]]();
    let base: *u8 = { #addr_of(buf[0]) };
    let i: usize = put_f64(base, 0 as usize, { (*p).value });
    put_byte(base, i, 0 as u8);
    var tv: w::TextView = w::TextView::from_global(env, mid);
    tv.set_text_str(base);
    paint::unwrap_keep(w::View::from_global(env, tv.into_raw()));
    return;
}

// A step arrived. The clamp is this side's, because Android's two buttons know
// nothing about a range.
fn fire_step(token: i64, delta: i32) {
    let n: *core::Node = { token as *core::Node };
    if n == (0 as *core::Node) { return; }
    let p: *props::StepperProps = props_of(n, props::K_STEPPER) as *props::StepperProps;
    if p == (0 as *props::StepperProps) { return; }
    var inc: f64 = { (*p).increment };
    if inc <= 0.0f64 { inc = 1.0f64; }
    var next: f64 = { (*p).value } + ({ delta as f64 } * inc);
    let lo: f64 = { (*p).minimum };
    let hi: f64 = { (*p).maximum };
    if hi > lo {
        if next < lo { next = lo; }
        if next > hi { next = hi; }
    }
    if next == { (*p).value } { return; }
    { (*p).value = next };
    // The middle view is written from here rather than waiting for an apply:
    // nothing marked the node dirty, because the change came from the platform
    // and not from the application.
    let env: rt::Env = e::env();
    let mid: jni::jobject = stepper_value_view(env, core::view_of(n));
    if mid != (0 as jni::jobject) {
        var buf: [u8; 64] = #zero::[[u8; 64]]();
        let base: *u8 = { #addr_of(buf[0]) };
        let i: usize = put_f64(base, 0 as usize, next);
        put_byte(base, i, 0 as u8);
        var tv: w::TextView = w::TextView::from_global(env, mid);
        tv.set_text_str(base);
        paint::unwrap_keep(w::View::from_global(env, tv.into_raw()));
    }
    let h: fn(*u8, *u8) = { (*p).on_value_changed };
    if h != props::no_handler { h(core::view_of(n), { (*p).on_value_changed_ctx }); }
    return;
}

// A number, printed without stdlib's formatter: this runs on the UI thread per
// tap and the value is a stepper's, which is small and usually whole.
fn put_f64(buf: *u8, at: usize, v: f64) -> usize {
    var i: usize = at;
    var x: f64 = v;
    if x < 0.0f64 { i = put_byte(buf, i, 45 as u8); x = 0.0f64 - x; }
    let whole: i64 = { x as i64 };
    i = put_i64(buf, i, whole);
    let frac: f64 = x - { whole as f64 };
    // One decimal, and only when there is one: "3" reads better than "3.0" on a
    // stepper whose increment is whole, which is the common case.
    let tenths: i64 = { ((frac * 10.0f64) + 0.5f64) as i64 };
    if tenths > (0 as i64) {
        i = put_byte(buf, i, 46 as u8);
        i = put_i64(buf, i, tenths);
    }
    return i;
}

fn put_i64(buf: *u8, at: usize, v: i64) -> usize {
    if v == (0 as i64) { return put_byte(buf, at, 48 as u8); }
    // NEGATIVES PRINT. Without this the loop below runs zero times and the
    // number vanishes — which is how a MeasureSpec, whose AT_MOST mode is
    // 0x80000000 and therefore negative, logged as an empty string and cost a
    // round of debugging.
    if v < (0 as i64) {
        let i: usize = put_byte(buf, at, 45 as u8);
        return put_i64(buf, i, (0 as i64) -% v);
    }
    var digits: [u8; 24] = #zero::[[u8; 24]]();
    var n: usize = 0 as usize;
    var x: i64 = v;
    while x > (0 as i64) {
        { digits[n] = { ((x % (10 as i64)) as u8) } +% (48 as u8) };
        x = x / (10 as i64);
        n = n +% (1 as usize);
    }
    var i: usize = at;
    while n > (0 as usize) {
        n = n -% (1 as usize);
        i = put_byte(buf, i, { digits[n] });
    }
    return i;
}

fn put_byte(buf: *u8, at: usize, b: u8) -> usize {
    let d: *u8 = { ({ #addr(buf) } +% at) as *u8 };
    { (*d) = b };
    return at +% (1 as usize);
}

fn put_str_at(buf: *u8, at: usize, s: *u8) -> usize {
    var i: usize = at;
    var j: usize = 0 as usize;
    var going: bool = true;
    while going {
        let p: *u8 = { ({ #addr(s) } +% j) as *u8 };
        let c: u8 = { (*p) };
        if c == (0 as u8) { going = false; } else {
            i = put_byte(buf, i, c);
            j = j +% (1 as usize);
        }
    }
    return i;
}

// ---- tints -------------------------------------------------------------------
// EVERY COLOUR VERB ON A PLATFORM WIDGET IS A TINT, and a tint is a
// ColorStateList — a colour per state rather than a colour. `valueOf` makes the
// one-colour kind, which is what facet's single-value verbs mean.

// A SLIDER'S THUMB, from the same four doors an `image` source uses — a file,
// an APK asset, a drawable in the app, then one in `android`. The first two
// arrive as Bitmaps and need wrapping; the third is a drawable already.
fn set_thumb_image(env: rt::Env, v: *u8, src: str) {
    var buf: [u8; 512] = #zero::[[u8; 512]]();
    let base: *u8 = { #addr_of(buf[0]) };
    if !paint::cstr(src, base, 512 as usize) { return; }
    // The upcast takes a ref of its own, so this one drops normally — the
    // borrowed `v` is facet's and is never wrapped here.
    var sb: w::SeekBar = w::SeekBar::from_global(env, v);
    var asb: w::AbsSeekBar = sb.as_abs_seek_bar();
    let _borrowed: *u8 = sb.into_raw();
    let id: i32 = drawable_id(env, base);
    if id != (0 as i32) {
        let d: jni::jobject = env.call_object_1(
            e::context(), #str_ptr("android/content/Context\0"), #str_ptr("getDrawable\0"),
            #str_ptr("(I)Landroid/graphics/drawable/Drawable;\0"), jni::arg_int(id));
        env.clear_exception();
        if d != (0 as jni::jobject) {
            asb.set_thumb(d);
            env.delete_local_ref(d);
        }
    }
    return;
}

fn tint(env: rt::Env, c: vocab::Color) -> jni::jobject {
    return w::ColorStateList::value_of(env, paint::argb_of(c));
}

// A colour for CHECKED and another for unchecked, which is what a switch's two
// verbs are. The pair needs an `int[][]` and lives in FacetDraw for that.
fn checked_tint(env: rt::Env, on: vocab::Color, off: vocab::Color) -> jni::jobject {
    return dex::checked_csl(env, paint::argb_of(on), paint::argb_of(off));
}

// ---- symbol ------------------------------------------------------------------
// A GLYPH, and facet's one control that facet invented rather than adopted.
//
// Two tiers reach two different Android things, so they reach two different
// VIEWS and the kind picks at create:
//
//   Bundled — facet's own MaterialSymbolsOutlined, a variable font shipped in
//             the APK's assets. A TextView whose text is ONE CODEPOINT and
//             whose typeface is that font. Portable, and the name was checked
//             at compile time by `icons::`.
//   System  — the platform's own set, which on Android is `android.R.drawable`
//             by name (MANIFEST §1). An ImageView, resolved through the same
//             four doors an `image` uses.
//
// A node whose SET changes after it is mounted keeps the view it was made with,
// because a view is not re-created — and that is warned rather than left to
// look like a font problem.

fn symbol_props(n: *core::Node) -> *symbol::SymbolProps {
    return props_of(n, symbol::K_SYMBOL) as *symbol::SymbolProps;
}

fn is_system_symbol(p: *symbol::SymbolProps) -> bool {
    return match { (*p).set } {
        symbol::IconSet::System => true,
        symbol::IconSet::Bundled => false,
    };
}

fn create_symbol(n: *core::Node) -> *u8 {
    let env: rt::Env = e::env();
    let p: *symbol::SymbolProps = symbol_props(n);
    if p != (0 as *symbol::SymbolProps) && is_system_symbol(p) {
        var iv: w::ImageView = w::ImageView::new_context(env, e::context());
        return iv.into_raw();
    }
    var tv: w::TextView = w::TextView::new_context(env, e::context());
    let raw: *u8 = tv.into_raw();
    var t: w::TextView = w::TextView::from_global(env, raw);
    t.set_gravity(17 as i32);   // CENTER
    // A GLYPH IS NOT PROSE: it does not grow with the reader's text setting,
    // because its size is a layout dimension the application chose.
    t.set_include_font_padding(false);
    let _k: *u8 = t.into_raw();
    return raw;
}

fn apply_symbol(v: *u8, n: *core::Node, dirty: u64) {
    let p: *symbol::SymbolProps = symbol_props(n);
    if p == (0 as *symbol::SymbolProps) { return; }
    let env: rt::Env = e::env();
    if is_system_symbol(p) {
        if (dirty & symbol::P_NAME) != (0 as u64) || dirty == paint::all_bits() {
            set_source(env, v, { (*p).name.view() });
        }
        if (dirty & symbol::P_COLOR) != (0 as u64) || dirty == paint::all_bits() {
            let c: vocab::Color = { (*p).color };
            if c.is_set() { tint_image(env, v, c); }
        }
        return;
    }
    var tv: w::TextView = w::TextView::from_global(env, v);
    // THE GLYPH, ITS FONT AND ITS FILL ARE ONE WRITE: the fill is an axis of
    // the font, so a new fill is a new Typeface and the glyph has to be put
    // back into it.
    let watched: u64 = symbol::P_ICON | symbol::P_FILL | symbol::P_FONT | symbol::P_SIZE;
    if (dirty & watched) != (0 as u64) || dirty == paint::all_bits() {
        var buf: [u8; 8] = #zero::[[u8; 8]]();
        let base: *u8 = { #addr_of(buf[0]) };
        put_codepoint(base, { (*p).icon });
        tv.set_text_str(base);
        let sz: f64 = { (*p).size };
        if sz > 0.0f64 { tv.set_text_size_i_f(1 as i32, { sz as f32 }); }   // DIP
        apply_icon_font(env, tv, { (*p).font.view() }, { (*p).fill });
    }
    if (dirty & symbol::P_COLOR) != (0 as u64) || dirty == paint::all_bits() {
        let c: vocab::Color = { (*p).color };
        if c.is_set() { tv.set_text_color_i(paint::argb_of(c)); }
    }
    let _k: *u8 = tv.into_raw();
    return;
}

// facet's font unless the application named its own — and a named one is an
// ASSET PATH, because that is how an Android app ships a font.
fn apply_icon_font(env: rt::Env, tv: w::TextView, family: str, fill: f64) {
    var buf: [u8; 256] = #zero::[[u8; 256]]();
    let base: *u8 = { #addr_of(buf[0]) };
    var path: *u8 = #str_ptr("MaterialSymbolsOutlined.ttf\0");
    if family != "" {
        if paint::cstr(family, base, 256 as usize) { path = base; }
    }
    // The axis has TWO ends and facet's `fill` is a number between them: the
    // ends are two different glyphs in the font's own terms, so a value in
    // between rounds to the nearer rather than interpolating.
    var fill_axis: i32 = 0 as i32;
    if fill >= 0.5f64 { fill_axis = 1 as i32; }
    let tf: jni::jobject = dex::icon_font(env, e::context(), path, fill_axis);
    if tf == (0 as jni::jobject) {
        warn_no_icon_font();
        return;
    }
    tv.set_typeface_typeface(tf);
    env.delete_local_ref(tf);
    return;
}

static ICON_FONT_WARNED: bool = false;

fn warn_no_icon_font() {
    if ICON_FONT_WARNED { return; }
    ICON_FONT_WARNED = true;
    log::warn(#str_ptr("symbol: no MaterialSymbolsOutlined.ttf in assets/ - the app's build must ship facet's icon font, see MANIFEST 3\0"));
    return;
}

// ONE CODEPOINT, as the modified UTF-8 `NewStringUTF` reads.
//
// Not plain UTF-8: a codepoint above the BMP is written as its SURROGATE PAIR,
// each surrogate encoded in three bytes — which is what the JVM's modified
// UTF-8 means and what a four-byte sequence would NOT be. Material Symbols has
// glyphs at U+FFF0E and above, so this is not theoretical.
fn put_codepoint(buf: *u8, cp: u32) {
    var i: usize = 0 as usize;
    if cp < (65536u32) {
        i = put_utf8_bmp(buf, i, cp);
    } else {
        let v: u32 = cp -% (65536u32);
        let hi: u32 = (55296u32) +% (v >> (10u32));
        let lo: u32 = (56320u32) +% (v & (1023u32));
        i = put_utf8_bmp(buf, i, hi);
        i = put_utf8_bmp(buf, i, lo);
    }
    let term: *u8 = { ({ #addr(buf) } +% i) as *u8 };
    { (*term) = 0 as u8 };
    return;
}

// A BMP code unit, in one, two or three bytes. Every icon codepoint is in the
// private-use area, which is three — the shorter cases are here because a
// caller's own font may not be.
fn put_utf8_bmp(buf: *u8, at: usize, c: u32) -> usize {
    var i: usize = at;
    if c < (128u32) {
        i = put_byte(buf, i, { c as u8 });
        return i;
    }
    if c < (2048u32) {
        i = put_byte(buf, i, { ((192u32) | (c >> (6u32))) as u8 });
        i = put_byte(buf, i, { ((128u32) | (c & (63u32))) as u8 });
        return i;
    }
    i = put_byte(buf, i, { ((224u32) | (c >> (12u32))) as u8 });
    i = put_byte(buf, i, { ((128u32) | ((c >> (6u32)) & (63u32))) as u8 });
    i = put_byte(buf, i, { ((128u32) | (c & (63u32))) as u8 });
    return i;
}

// An ImageView's TINT, which is what a coloured system glyph is: the drawable
// is a shape and the colour is applied over it.
fn tint_image(env: rt::Env, v: *u8, c: vocab::Color) {
    env.call_void_1(v, #str_ptr("android/widget/ImageView\0"), #str_ptr("setColorFilter\0"),
                    #str_ptr("(I)V\0"), jni::arg_int(paint::argb_of(c)));
    return;
}

// A BUTTON'S IMAGE, on one of four sides. The drawable comes through the same
// four doors an `image` source does, and the SIDE is which of the compound
// slots it lands in — Android's `setCompoundDrawablesRelativeWithIntrinsic
// Bounds` takes start, top, end and bottom, which is facet's ImageLeft,
// ImageTop, ImageRight and ImageBottom one word apart.
// START OR STOP, asked of whatever drawable is there. `Animatable` is the
// interface both animated drawables implement, and calling through it is what
// keeps this one line rather than a type test per source kind.
fn play_image(env: rt::Env, v: *u8, playing: bool) {
    let d: jni::jobject = env.call_object_0(
        v, #str_ptr("android/widget/ImageView\0"), #str_ptr("getDrawable\0"),
        #str_ptr("()Landroid/graphics/drawable/Drawable;\0"));
    if d == (0 as jni::jobject) { env.clear_exception(); return; }
    var name: *u8 = #str_ptr("stop\0");
    if playing { name = #str_ptr("start\0"); }
    env.call_void_0(d, #str_ptr("android/graphics/drawable/Animatable\0"), name,
                    #str_ptr("()V\0"));
    // A still image is not Animatable, and asking it to start is a
    // NoSuchMethodError rather than a crash — cleared here, where it is
    // expected, rather than left for the next JNI call to trip over.
    env.clear_exception();
    env.delete_local_ref(d);
    return;
}

fn apply_button_image(env: rt::Env, tv: w::TextView, src: str, side: vocab::ContentLayout) {
    if src == "" {
        tv.set_compound_drawables_relative_with_intrinsic_bounds_drawable_drawable_drawable_drawable(
            0 as jni::jobject, 0 as jni::jobject, 0 as jni::jobject, 0 as jni::jobject);
        return;
    }
    var buf: [u8; 512] = #zero::[[u8; 512]]();
    let base: *u8 = { #addr_of(buf[0]) };
    if !paint::cstr(src, base, 512 as usize) { return; }
    let id: i32 = drawable_id(env, base);
    if id == (0 as i32) { return; }
    let d: jni::jobject = env.call_object_1(
        e::context(), #str_ptr("android/content/Context\0"), #str_ptr("getDrawable\0"),
        #str_ptr("(I)Landroid/graphics/drawable/Drawable;\0"), jni::arg_int(id));
    env.clear_exception();
    if d == (0 as jni::jobject) { return; }
    let none: jni::jobject = 0 as jni::jobject;
    match side {
        vocab::ContentLayout::ImageLeft => {
            tv.set_compound_drawables_relative_with_intrinsic_bounds_drawable_drawable_drawable_drawable(
                d, none, none, none);
        }
        vocab::ContentLayout::ImageTop => {
            tv.set_compound_drawables_relative_with_intrinsic_bounds_drawable_drawable_drawable_drawable(
                none, d, none, none);
        }
        vocab::ContentLayout::ImageRight => {
            tv.set_compound_drawables_relative_with_intrinsic_bounds_drawable_drawable_drawable_drawable(
                none, none, d, none);
        }
        vocab::ContentLayout::ImageBottom => {
            tv.set_compound_drawables_relative_with_intrinsic_bounds_drawable_drawable_drawable_drawable(
                none, none, none, d);
        }
    }
    env.delete_local_ref(d);
    return;
}

// ---- a control's OWN chrome --------------------------------------------------
// `bordered`, `border_color`, `border_width` and `corner_radius` are the
// BUTTON's props, not the shared band's — a button, a text button and a radio
// each declare their own four, and they mean the control's outline rather than
// the node's background.
//
// One GradientDrawable again, for the same reason the band builds one: a
// colour, a radius and a stroke are three calls on one drawable and there is no
// way to add a stroke to a background that is already there. A control that
// declares NONE of the four keeps what the platform gave it — which is what
// makes an ordinary `button` a filled Material button rather than a hole with a
// title in it.
fn apply_control_chrome(env: rt::Env, v: *u8, n: *core::Node, bordered: bool,
                        border_color: vocab::Color, border_width: f64,
                        corners: vocab::Corners) {
    // THE RADIUS THE RIPPLE IS CLIPPED TO, which is the control's own when it
    // declared one and the band's otherwise — a rounded card holding a square
    // ripple is the tell that these two were read separately.
    var radius: f64 = corners.top_leading;
    if radius <= 0.0f64 { radius = core::corner_radius(n).top_leading; }
    if !bordered && border_width <= 0.0f64 && !border_color.is_set()
       && corners.top_leading <= 0.0f64 {
        // NO CHROME OF ITS OWN, so the platform's background stands — but the
        // tap still has to show, and this theme's button background has no
        // pressed layer of its own.
        dex::tap_feedback(env, v, e::px(radius));
        return;
    }
    // The FILL is the shared band's, if the node declared one — the two are
    // different verbs and both land on the same drawable.
    let fill: vocab::Color = core::background_color(n);
    // `bordered: true` with no width and no colour is still a border — the
    // hairline the platform would draw — so the two get a default here rather
    // than resolving to an invisible zero-width stroke.
    var width: f64 = border_width;
    if bordered && width <= 0.0f64 { width = 1.0f64; }
    var stroke: vocab::Color = border_color;
    if bordered && !stroke.is_set() { stroke = vocab::Color::separator(); }
    var stroke_px: i32 = 0 as i32;
    if width > 0.0f64 && stroke.is_set() { stroke_px = { e::px(width) as i32 }; }
    // THROUGH FacetDraw, because a control's background is a background AND a
    // TOUCH: replacing the platform's drawable takes the pressed state with it,
    // and a button that does not answer a finger reads as broken however right
    // it looks. The ripple is built there, around this shape.
    dex::control_background(env, v, paint::argb_of(fill), fill.is_set(),
                            paint::argb_of(stroke), stroke_px, e::px(radius));
    dex::tap_feedback(env, v, e::px(radius));
    var view: w::View = w::View::from_global(env, v);
    view.set_clip_to_outline(radius > 0.0f64);
    paint::unwrap_keep(view);
    return;
}

// ---- the text band -----------------------------------------------------------
// EVERY CONTROL WITH A TITLE HAS THE SAME TYPOGRAPHY, and it is spelled once
// here rather than seven times in seven bodies. A label, a button, a text
// button, a radio and the three input views are all TextViews underneath, and
// facet gives each of them the same vocabulary: a family, a weight, an italic
// bit, an alignment, a line break, a decoration, a transform, a letter spacing
// and a line height.
//
// The props structs are NOT layout-compatible, so each kind reads its own and
// hands the values over. The dirty bits are each kind's too — same numbers,
// different modules — so each caller tests its own and calls this with what it
// found.

struct TextStyle {
    family: str,
    weight: vocab::FontWeight,
    is_italic: bool,
    size: f64,
    scales: bool,
    align: vocab::TextAlign,
    vertical_align: vocab::TextAlign,
    line_break: vocab::LineBreak,
    max_lines: i64,
    decoration: vocab::TextDecoration,
    transform: vocab::TextTransform,
    character_spacing: f64,
    line_height: f64,
}

impl TextStyle {
    fn none() -> TextStyle {
        return TextStyle {
            family: "",
            weight: vocab::FontWeight::Default,
            is_italic: false,
            size: 0.0f64,
            scales: true,
            align: vocab::TextAlign::Start,
            vertical_align: vocab::TextAlign::Start,
            line_break: vocab::LineBreak::WordWrap,
            max_lines: 0 as i64,
            decoration: vocab::TextDecoration::None,
            transform: vocab::TextTransform::Default,
            character_spacing: 0.0f64,
            line_height: 0.0f64,
        };
    }
}

// A SIZE AND WHETHER IT SCALES ARE ONE CALL. `setTextSize(float)` is SP, which
// is Android's dynamic-type unit: it grows with the reader's font setting. That
// is right for `font_scales: true` and WRONG for false, and the two were the
// same call — so every label in this backend scaled whether it asked to or not.
// COMPLEX_UNIT_DIP is the same number of points without the reader's multiplier.
fn apply_text_size(tv: w::TextView, size: f64, scales: bool) {
    if size <= 0.0f64 { return; }
    var unit: i32 = 1 as i32;   // COMPLEX_UNIT_DIP
    if scales { unit = 2 as i32; }   // COMPLEX_UNIT_SP
    tv.set_text_size_i_f(unit, { size as f32 });
    return;
}

fn apply_text_style(env: rt::Env, tv: w::TextView, st: TextStyle) {
    let tf: jni::jobject = typeface_of(env, st.family, st.weight, st.is_italic);
    if tf != (0 as jni::jobject) {
        tv.set_typeface_typeface(tf);
        env.delete_local_ref(tf);
    }
    tv.set_gravity(gravity_of(st.align, st.vertical_align));
    // JUSTIFY IS ITS OWN MODE on Android rather than a gravity — and it is API
    // 26, which is this backend's floor exactly. INTER_WORD is 1, NONE is 0.
    tv.set_justification_mode(match st.align {
        vocab::TextAlign::Justify => 1 as i32,
        _ => 0 as i32,
    });
    apply_line_break(env, tv, st.line_break);
    // `max_lines` zero is UNBOUNDED, which is the reading every numeric zero
    // gets in facet's contract — and Android's own unbounded is a very large
    // number rather than a zero, which means nothing.
    if st.max_lines > (0 as i64) { tv.set_max_lines({ st.max_lines as i32 }); }
    else { tv.set_max_lines(2147483647 as i32); }
    apply_decoration_flags(tv, st.decoration);
    // TRANSFORM: only the uppercase half exists. `setAllCaps` is Android's, and
    // there is no `setAllLower` — a lowercase transform would have to rewrite
    // the string, which would then disagree with the props the app reads back.
    // MANIFEST §2.
    tv.set_all_caps(match st.transform {
        vocab::TextTransform::Uppercase => true,
        _ => false,
    });
    // LETTER SPACING IS IN EMS on Android and in POINTS in facet, so the
    // conversion needs the font size — which is why this runs after it is
    // known rather than beside the other one-liners.
    var em: f64 = 0.0f64;
    if st.character_spacing != 0.0f64 && st.size > 0.0f64 {
        em = st.character_spacing / st.size;
    }
    tv.set_letter_spacing({ em as f32 });
    // LINE HEIGHT is a TOTAL in facet and an EXTRA in `setLineSpacing`, so the
    // font's own line goes out of the difference. `setLineHeight` says it
    // directly and is API 28; this backend's floor is 26.
    var extra: f64 = 0.0f64;
    if st.line_height > 0.0f64 && st.size > 0.0f64 && st.line_height > st.size {
        extra = e::px(st.line_height - st.size);
    }
    tv.set_line_spacing({ extra as f32 }, 1.0f64 as f32);
    return;
}

fn typeface_of(env: rt::Env, family: str, weight: vocab::FontWeight, italic: bool) -> jni::jobject {
    var style: i32 = 0 as i32;
    if is_bold_weight(weight) { style = 1 as i32; }
    if italic { style = style | (2 as i32); }
    var buf: [u8; 128] = #zero::[[u8; 128]]();
    let base: *u8 = { #addr_of(buf[0]) };
    var name: *u8 = #str_ptr("sans-serif\0");
    if family != "" {
        if paint::cstr(family, base, 128 as usize) { name = base; }
    }
    return w::Typeface::create_str_i(env, name, style);
}

// Gravity, both axes at once. START and END rather than LEFT and RIGHT: facet's
// `Start` is the writing direction's start, and 8388611/8388613 are what
// Android calls the same idea.
fn gravity_of(align: vocab::TextAlign, vertical: vocab::TextAlign) -> i32 {
    var g: i32 = match align {
        vocab::TextAlign::Center => 1 as i32,             // CENTER_HORIZONTAL
        vocab::TextAlign::End => 8388613 as i32,          // END
        // Justify is a MODE, set below; the gravity under it is START.
        vocab::TextAlign::Justify => 8388611 as i32,
        vocab::TextAlign::Start => 8388611 as i32,        // START
    };
    let v: i32 = match vertical {
        vocab::TextAlign::Center => 16 as i32,            // CENTER_VERTICAL
        vocab::TextAlign::End => 80 as i32,               // BOTTOM
        _ => 48 as i32,                                    // TOP
    };
    return g | v;
}

// TRUNCATION, which is an ellipsize on Android and a line-break mode in facet.
// The three truncations map exactly; the two WRAPS are Android's default (no
// ellipsize at all) and `NoWrap` is a single line with no ellipsis.
fn apply_line_break(env: rt::Env, tv: w::TextView, lb: vocab::LineBreak) {
    let name: *u8 = match lb {
        vocab::LineBreak::HeadTruncation => #str_ptr("START\0"),
        vocab::LineBreak::MiddleTruncation => #str_ptr("MIDDLE\0"),
        vocab::LineBreak::TailTruncation => #str_ptr("END\0"),
        _ => 0 as *u8,
    };
    tv.set_single_line_z(match lb {
        vocab::LineBreak::NoWrap => true,
        _ => false,
    });
    if name == (0 as *u8) {
        tv.set_ellipsize(0 as jni::jobject);
        return;
    }
    let cls: jni::jclass = env.class_cached(#str_ptr("android/text/TextUtils$TruncateAt\0"));
    let fid: jni::jfieldID = env.static_field_id(
        cls, name, #str_ptr("Landroid/text/TextUtils$TruncateAt;\0"));
    if fid == (0 as jni::jfieldID) { return; }
    let at: jni::jobject = { (*(*env.raw())).GetStaticObjectField(env.raw(), cls, fid) };
    tv.set_ellipsize(at);
    env.delete_local_ref(at);
    return;
}

// UNDERLINE AND STRIKETHROUGH ARE PAINT FLAGS, and the two bits have to be
// cleared as well as set — a label that loses its underline loses it, which is
// the same idempotence rule the background follows.
fn apply_decoration_flags(tv: w::TextView, d: vocab::TextDecoration) {
    let underline: i32 = 8 as i32;      // Paint.UNDERLINE_TEXT_FLAG
    let strike: i32 = 16 as i32;        // Paint.STRIKE_THRU_TEXT_FLAG
    // ~(underline | strike), built arithmetically — `~x` is `-x - 1`, and an
    // integer literal in this language wraps through i32 before a cast, so a
    // mask is safer derived than typed.
    let keep: i32 = (0 as i32) -% (underline | strike) -% (1 as i32);
    var flags: i32 = tv.get_paint_flags();
    flags = flags & keep;
    match d {
        vocab::TextDecoration::Underline => { flags = flags | underline; }
        vocab::TextDecoration::Strikethrough => { flags = flags | strike; }
        vocab::TextDecoration::None => { }
    }
    tv.set_paint_flags(flags);
    return;
}

// ---- date picker -------------------------------------------------------------
// A FIELD THAT OPENS A PICKER, which is what a 44-point date picker means.
//
// Android's `DatePicker` widget is a full calendar — hundreds of points tall,
// with a mode fixed by an XML attribute that has no setter. UIDatePicker's
// compact posture is a chip that opens a wheel; here it is a Button that opens
// a DatePickerDialog, and every verb the kind names lands somewhere real:
// `date` is the title, `format` is the pattern, the two bounds are the dialog's
// limits, `open` shows it and the three events are its edges.
//
// AND THE FONT WORKS, which is the one place this backend can do something the
// iOS one cannot: a Button IS a TextView, so `font_size`, `font_family`,
// `font_weight`, `is_italic` and `text_color` all reach it. facet_uikit's
// manifest records twelve verbs with nowhere to land because UIDatePicker has
// no font property of any kind.

fn create_date_picker(n: *core::Node) -> *u8 {
    let env: rt::Env = e::env();
    var b: w::Button = w::Button::new_context_attribute_set_i(
        env, e::context(), 0 as jni::jobject, borderless_style(env));
    let raw: *u8 = b.into_raw();
    let listener: jni::jobject =
        dex::new_with_token(env, dex::click_class(), { #addr(n) as i64 });
    var view: w::View = w::View::from_global(env, raw);
    view.set_on_click_listener(listener);
    // NO PADDING OF ITS OWN. facet owns the box — a picker asked for 44 points
    // gets 44 — and a Button's default vertical padding is 8 more on each side,
    // which a 28pt font then overflows. The control's internals may not spend
    // the box facet handed it.
    view.set_padding(0 as i32, 0 as i32, 0 as i32, 0 as i32);
    paint::unwrap_keep(view);
    var tv: w::TextView = w::TextView::from_global(env, raw);
    tv.set_gravity(17 as i32);   // CENTER
    let _k: *u8 = tv.into_raw();
    env.delete_local_ref(listener);
    dex::tap_feedback(env, raw, 0.0f64);
    return raw;
}

fn apply_date_picker(v: *u8, n: *core::Node, dirty: u64) {
    let p: *props::DatePickerProps = props_of(n, props::K_DATE_PICKER) as *props::DatePickerProps;
    if p == (0 as *props::DatePickerProps) { return; }
    let env: rt::Env = e::env();
    if (dirty & (date_picker::P_DATE | date_picker::P_FORMAT)) != (0 as u64)
       || dirty == paint::all_bits() {
        write_date_title(env, v, p);
    }
    var tv: w::TextView = w::TextView::from_global(env, v);
    if (dirty & (date_picker::P_FONT_SIZE | date_picker::P_FONT_SCALES)) != (0 as u64) {
        apply_text_size(tv, { (*p).font_size }, { (*p).font_scales });
    }
    if (dirty & date_picker::P_TEXT_COLOR) != (0 as u64) {
        let c: vocab::Color = { (*p).text_color };
        if c.is_set() { tv.set_text_color_i(paint::argb_of(c)); }
    }
    // THROUGH THE TEXT BAND, like every other titled control — which is what
    // brings the letter spacing and the scaling bit with it. `apply_typeface`
    // alone answered three of the five verbs a picker's font has.
    let typography: u64 = date_picker::P_FONT_FAMILY | date_picker::P_FONT_WEIGHT
                        | date_picker::P_IS_ITALIC | date_picker::P_CHARACTER_SPACING
                        | date_picker::P_FONT_SCALES | date_picker::P_FONT_SIZE;
    if (dirty & typography) != (0 as u64) || dirty == paint::all_bits() {
        var st: TextStyle = TextStyle::none();
        st.family = { (*p).font_family.view() };
        st.weight = { (*p).font_weight };
        st.is_italic = { (*p).is_italic };
        st.size = { (*p).font_size };
        st.scales = { (*p).font_scales };
        st.align = vocab::TextAlign::Center;
        st.vertical_align = vocab::TextAlign::Center;
        st.character_spacing = { (*p).character_spacing };
        apply_text_style(env, tv, st);
    }
    let _k: *u8 = tv.into_raw();
    // `open` — a COMMAND expressed as a prop, so it is acted on when the bit
    // says it changed and never re-asserted on an unrelated pass. A dialog
    // shown twice is two dialogs.
    if (dirty & date_picker::P_IS_OPEN) != (0 as u64) {
        if { (*p).is_open } { open_date_dialog(env, n, p); }
    }
    return;
}

fn write_date_title(env: rt::Env, v: *u8, p: *props::DatePickerProps) {
    let d: vocab::Date = { (*p).date };
    var pat: [u8; 128] = #zero::[[u8; 128]]();
    let pat_base: *u8 = { #addr_of(pat[0]) };
    if !paint::cstr({ (*p).format.view() }, pat_base, 128 as usize) {
        { (*pat_base) = 0 as u8 };
    }
    let js: jni::jobject = dex::date_format(env, pat_base, { d.year as i32 },
                                            { d.month as i32 }, { d.day as i32 });
    if js == (0 as jni::jobject) { return; }
    var buf: [u8; 256] = #zero::[[u8; 256]]();
    let base: *u8 = { #addr_of(buf[0]) };
    if env.string_utf_into(js, base, 256 as usize) {
        var tv: w::TextView = w::TextView::from_global(env, v);
        tv.set_text_str(base);
        let _k: *u8 = tv.into_raw();
    }
    env.delete_local_ref(js);
    return;
}

// A family, a weight and an italic bit, as the four Typeface styles Android
// has. The same rounding `drawing` does, for the same reason: the
// variable-weight door is API 28 and this backend's floor is 26.
fn apply_typeface(env: rt::Env, tv: w::TextView, family: str, weight: vocab::FontWeight,
                  italic: bool) {
    var style: i32 = 0 as i32;
    if is_bold_weight(weight) { style = 1 as i32; }
    if italic { style = style | (2 as i32); }
    var buf: [u8; 128] = #zero::[[u8; 128]]();
    let base: *u8 = { #addr_of(buf[0]) };
    var name: *u8 = #str_ptr("sans-serif\0");
    if family != "" {
        if paint::cstr(family, base, 128 as usize) { name = base; }
    }
    let tf: jni::jobject = w::Typeface::create_str_i(env, name, style);
    if tf == (0 as jni::jobject) { return; }
    tv.set_typeface_typeface(tf);
    env.delete_local_ref(tf);
    return;
}

fn is_bold_weight(weight: vocab::FontWeight) -> bool {
    return match weight {
        vocab::FontWeight::Semibold => true,
        vocab::FontWeight::Bold => true,
        vocab::FontWeight::Heavy => true,
        vocab::FontWeight::Black => true,
        _ => false,
    };
}

fn open_date_dialog(env: rt::Env, n: *core::Node, p: *props::DatePickerProps) {
    let d: vocab::Date = { (*p).date };
    let lo: vocab::Date = { (*p).minimum_date };
    let hi: vocab::Date = { (*p).maximum_date };
    dex::date_show(env, e::context(), { #addr(n) as i64 },
                   { d.year as i32 }, { d.month as i32 }, { d.day as i32 },
                   { lo.year as i32 }, { lo.month as i32 }, { lo.day as i32 },
                   { hi.year as i32 }, { hi.month as i32 }, { hi.day as i32 });
    return;
}

// The button was tapped: OPEN, which is what a compact picker's field does.
fn fire_date_picker_click(n: *core::Node) -> bool {
    let p: *props::DatePickerProps = props_of(n, props::K_DATE_PICKER) as *props::DatePickerProps;
    if p == (0 as *props::DatePickerProps) { return false; }
    if !e::have_env() { return true; }
    open_date_dialog(e::env(), n, p);
    return true;
}

// A date was chosen. WRITTEN BACK FIRST, so a handler asking `picker.date()` is
// told what was picked rather than what was there before it — the same order
// `fire_text` uses, and the same reason.
fn fire_date_set(token: i64, y: i32, m: i32, d: i32) {
    let n: *core::Node = { token as *core::Node };
    if n == (0 as *core::Node) { return; }
    let p: *props::DatePickerProps = props_of(n, props::K_DATE_PICKER) as *props::DatePickerProps;
    if p == (0 as *props::DatePickerProps) { return; }
    { (*p).date = vocab::Date { year: { y as i64 }, month: { m as i64 }, day: { d as i64 } } };
    core::touch(n, date_picker::P_DATE);
    let h: fn(*u8, *u8) = { (*p).on_date_selected };
    if h != props::no_handler { h(core::view_of(n), { (*p).on_date_selected_ctx }); }
    return;
}

fn fire_date_edge(token: i64, opened: bool) {
    let n: *core::Node = { token as *core::Node };
    if n == (0 as *core::Node) { return; }
    let p: *props::DatePickerProps = props_of(n, props::K_DATE_PICKER) as *props::DatePickerProps;
    if p == (0 as *props::DatePickerProps) { return; }
    // The props follow the dialog: an app reading `is_open` after a dismiss is
    // told the truth, and the next `open: true` is a CHANGE again.
    { (*p).is_open = opened };
    var h: fn(*u8, *u8) = { (*p).on_closed };
    var ctx: *u8 = { (*p).on_closed_ctx };
    if opened { h = { (*p).on_opened }; ctx = { (*p).on_opened_ctx }; }
    if h != props::no_handler { h(core::view_of(n), ctx); }
    return;
}

// ---- time picker ---------------------------------------------------------------
// The date picker one field over, and the same posture for the same reason:
// Android's embedded `TimePicker` is a clock face or a pair of spinners, and
// what an app asking for a 44-point picker means is a chip that opens one.
//
// `time` is a DURATION — seconds since midnight — which is facet's way of
// saying a wall-clock time without a date attached. Hours and minutes come out
// of it here, once, at the boundary.

fn time_props(n: *core::Node) -> *props::TimePickerProps {
    return props_of(n, props::K_TIME_PICKER) as *props::TimePickerProps;
}

fn hour_of(p: *props::TimePickerProps) -> i32 {
    let secs: f64 = { (*p).time.seconds };
    if secs <= 0.0f64 { return 0 as i32; }
    return { (secs / 3600.0f64) as i32 } % (24 as i32);
}

fn minute_of(p: *props::TimePickerProps) -> i32 {
    let secs: f64 = { (*p).time.seconds };
    if secs <= 0.0f64 { return 0 as i32; }
    return { ((secs / 60.0f64) as i32) } % (60 as i32);
}

fn create_time_picker(n: *core::Node) -> *u8 {
    let env: rt::Env = e::env();
    var b: w::Button = w::Button::new_context_attribute_set_i(
        env, e::context(), 0 as jni::jobject, borderless_style(env));
    let raw: *u8 = b.into_raw();
    let listener: jni::jobject =
        dex::new_with_token(env, dex::click_class(), { #addr(n) as i64 });
    var view: w::View = w::View::from_global(env, raw);
    view.set_on_click_listener(listener);
    view.set_padding(0 as i32, 0 as i32, 0 as i32, 0 as i32);
    paint::unwrap_keep(view);
    var tv: w::TextView = w::TextView::from_global(env, raw);
    tv.set_gravity(17 as i32);   // CENTER
    let _k: *u8 = tv.into_raw();
    env.delete_local_ref(listener);
    dex::tap_feedback(env, raw, 0.0f64);
    return raw;
}

fn apply_time_picker(v: *u8, n: *core::Node, dirty: u64) {
    let p: *props::TimePickerProps = time_props(n);
    if p == (0 as *props::TimePickerProps) { return; }
    let env: rt::Env = e::env();
    if (dirty & (time_picker::P_TIME | time_picker::P_FORMAT)) != (0 as u64)
       || dirty == paint::all_bits() {
        write_time_title(env, v, p);
    }
    var tv: w::TextView = w::TextView::from_global(env, v);
    if (dirty & (time_picker::P_FONT_SIZE | time_picker::P_FONT_SCALES)) != (0 as u64) {
        apply_text_size(tv, { (*p).font_size }, { (*p).font_scales });
    }
    if (dirty & time_picker::P_TEXT_COLOR) != (0 as u64) {
        let c: vocab::Color = { (*p).text_color };
        if c.is_set() { tv.set_text_color_i(paint::argb_of(c)); }
    }
    let typography: u64 = time_picker::P_FONT_FAMILY | time_picker::P_FONT_WEIGHT
                        | time_picker::P_IS_ITALIC | time_picker::P_CHARACTER_SPACING
                        | time_picker::P_FONT_SIZE;
    if (dirty & typography) != (0 as u64) || dirty == paint::all_bits() {
        var st: TextStyle = TextStyle::none();
        st.family = { (*p).font_family.view() };
        st.weight = { (*p).font_weight };
        st.is_italic = { (*p).is_italic };
        st.size = { (*p).font_size };
        st.scales = { (*p).font_scales };
        st.align = vocab::TextAlign::Center;
        st.vertical_align = vocab::TextAlign::Center;
        st.character_spacing = { (*p).character_spacing };
        apply_text_style(env, tv, st);
    }
    let _k: *u8 = tv.into_raw();
    if (dirty & time_picker::P_IS_OPEN) != (0 as u64) {
        if { (*p).is_open } { open_time_dialog(env, n, p); }
    }
    return;
}

fn write_time_title(env: rt::Env, v: *u8, p: *props::TimePickerProps) {
    var pat: [u8; 128] = #zero::[[u8; 128]]();
    let pat_base: *u8 = { #addr_of(pat[0]) };
    if !paint::cstr({ (*p).format.view() }, pat_base, 128 as usize) {
        { (*pat_base) = 0 as u8 };
    }
    let js: jni::jobject = dex::time_format(env, pat_base, hour_of(p), minute_of(p));
    if js == (0 as jni::jobject) { return; }
    var buf: [u8; 128] = #zero::[[u8; 128]]();
    let base: *u8 = { #addr_of(buf[0]) };
    if env.string_utf_into(js, base, 128 as usize) {
        var tv: w::TextView = w::TextView::from_global(env, v);
        tv.set_text_str(base);
        let _k: *u8 = tv.into_raw();
    }
    env.delete_local_ref(js);
    return;
}

fn open_time_dialog(env: rt::Env, n: *core::Node, p: *props::TimePickerProps) {
    dex::time_show(env, e::context(), { #addr(n) as i64 }, hour_of(p), minute_of(p));
    return;
}

fn fire_time_picker_click(n: *core::Node) -> bool {
    let p: *props::TimePickerProps = time_props(n);
    if p == (0 as *props::TimePickerProps) { return false; }
    if !e::have_env() { return true; }
    open_time_dialog(e::env(), n, p);
    return true;
}

// A time was chosen. WRITTEN BACK FIRST, so a handler asking `picker.time()` is
// told what was picked — the same order every other read here takes.
fn fire_time_set(token: i64, hour: i32, minute: i32) {
    let n: *core::Node = { token as *core::Node };
    if n == (0 as *core::Node) { return; }
    let p: *props::TimePickerProps = time_props(n);
    if p == (0 as *props::TimePickerProps) { return; }
    let secs: f64 = ({ hour as f64 } * 3600.0f64) + ({ minute as f64 } * 60.0f64);
    { (*p).time = vocab::Duration::of_seconds(secs) };
    core::touch(n, time_picker::P_TIME);
    let h: fn(*u8, *u8) = { (*p).on_time_selected };
    if h != props::no_handler { h(core::view_of(n), { (*p).on_time_selected_ctx }); }
    return;
}

fn fire_time_edge(token: i64, opened: bool) {
    let n: *core::Node = { token as *core::Node };
    if n == (0 as *core::Node) { return; }
    let p: *props::TimePickerProps = time_props(n);
    if p == (0 as *props::TimePickerProps) { return; }
    { (*p).is_open = opened };
    var h: fn(*u8, *u8) = { (*p).on_closed };
    var ctx: *u8 = { (*p).on_closed_ctx };
    if opened { h = { (*p).on_opened }; ctx = { (*p).on_opened_ctx }; }
    if h != props::no_handler { h(core::view_of(n), ctx); }
    return;
}

// ---- bordered --------------------------------------------------------------------
// A STROKE AROUND WHAT IT HOLDS. facet's `bordered` is a container whose whole
// job is an outline, and on Android an outline is the same GradientDrawable
// every other border here is — a shape, a corner radius and a stroke.
//
// WHAT A DRAWABLE CANNOT SAY: a cap, a join and a miter limit are PAINT
// properties, and a drawable's stroke has none of them — `setStroke` takes a
// width, a colour and a dash pair and nothing else. Those three are MANIFEST §2
// rather than read and dropped.

fn create_bordered(n: *core::Node) -> *u8 {
    return global_of(dex::new_host(e::env(), e::context()));
}

fn apply_bordered(v: *u8, n: *core::Node, dirty: u64) {
    let p: *props::BorderedProps = props_of(n, props::K_BORDERED) as *props::BorderedProps;
    if p == (0 as *props::BorderedProps) { return; }
    let watched: u64 = bordered::P_STROKE | bordered::P_STROKE_WIDTH
                     | bordered::P_STROKE_DASH | bordered::P_STROKE_DASH_OFFSET
                     | bordered::P_STROKE_SHAPE | props::C_BACKGROUND_COLOR;
    if (dirty & watched) == (0 as u64) && dirty != paint::all_bits() { return; }
    let env: rt::Env = e::env();
    var d: w::GradientDrawable = w::GradientDrawable::new_void(env);

    // The node's own background, if it declared one — the border is drawn
    // AROUND something, and that something is the shared band's.
    let fill: vocab::Color = core::background_color(n);
    if fill.is_set() { d.set_color_i(paint::argb_of(fill)); }
    else { d.set_color_i(0 as i32); }

    // THE SHAPE: `Shape.kind` is 0 none, 1 rect, 2 rounded, 3 ellipse — facet's
    // own numbering, and the three that draw map to Android's two plus a radius.
    let shape: vocab::Shape = { (*p).stroke_shape };
    if { shape.kind } == (3 as i64) { d.set_shape(oval_shape(env)); }
    else if { shape.kind } == (2 as i64) {
        d.set_corner_radius({ e::px({ shape.corners.top_leading }) as f32 });
    }

    let width: f64 = { (*p).stroke_width };
    var stroke: vocab::Color = { (*p).stroke.start };
    if !stroke.is_set() { stroke = vocab::Color::separator(); }
    if width > 0.0f64 {
        var dash: vocab::Dashes = { (*p).stroke_dash };
        if dash.is_solid() {
            d.set_stroke_i_i({ e::px(width) as i32 }, paint::argb_of(stroke));
        } else {
            // A DASH IS TWO NUMBERS HERE — on and off — where facet carries up
            // to eight. Android's drawable stroke takes exactly one pair, so a
            // longer pattern is read from its first two runs and MANIFEST §2
            // says so rather than silently drawing a different pattern.
            d.set_stroke_i_i_f_f({ e::px(width) as i32 }, paint::argb_of(stroke),
                                 { e::px(dash.run(0 as usize)) as f32 },
                                 { e::px(dash.run(1 as usize)) as f32 });
        }
    }
    var drawable: w::Drawable = d.as_drawable();
    var view: w::View = w::View::from_global(env, v);
    view.set_background(drawable.into_raw());
    view.set_clip_to_outline({ shape.kind } != (0 as i64));
    paint::unwrap_keep(view);
    let _k: *u8 = d.into_raw();
    return;
}

// ---- table -----------------------------------------------------------------------
// NOT A DATA SOURCE. facet's `table` carries no rows and no builder — three
// props and its CHILDREN are its content, which is why it is here beside the
// containers rather than in the recycler with `list` and `collection`.
//
// The three say how the rows it holds are drawn: whether they may differ in
// height, what the table is FOR, and how tall a row is when they do not.

fn table_props(n: *core::Node) -> *props::TableProps {
    return props_of(n, props::K_TABLE) as *props::TableProps;
}

fn create_table(n: *core::Node) -> *u8 {
    return global_of(dex::new_host(e::env(), e::context()));
}

fn apply_table(v: *u8, n: *core::Node, dirty: u64) {
    let p: *props::TableProps = table_props(n);
    if p == (0 as *props::TableProps) { return; }
    let watched: u64 = table::P_STYLE | table::P_ROW_HEIGHT | table::P_HAS_UNEVEN_ROWS;
    if (dirty & watched) == (0 as u64) && dirty != paint::all_bits() { return; }
    let env: rt::Env = e::env();

    // A ROW HEIGHT the table STATES is written onto its children, because a
    // table's rows are its children and nothing else would carry the number to
    // them — unless the rows may differ, which is exactly what
    // `has_uneven_rows` says. The two are one decision.
    let uneven: bool = { (*p).has_uneven_rows };
    let h: i64 = { (*p).row_height };
    if !uneven && h > (0 as i64) {
        var i: usize = 0 as usize;
        let count: usize = core::child_count_of(n);
        while i < count {
            match core::child_of(n, i) {
                option::Option[*core::Node]::Some(c) => { core::set_height(c, { h as f64 }); }
                option::Option[*core::Node]::None => { }
            }
            i = i +% (1 as usize);
        }
    }

    // WHAT THE TABLE IS FOR, which Android has no widget for and every platform
    // draws differently. `Menu` and `Settings` are the grouped, inset postures —
    // a card with the theme's own surface behind the rows — and `Data` and
    // `Form` are plain. That is the one distinction the four make that a
    // container can honour without inventing a look.
    let grouped: bool = match { (*p).style } {
        vocab::TableStyle::Menu => true,
        vocab::TableStyle::Settings => true,
        _ => false,
    };
    var view: w::View = w::View::from_global(env, v);
    if grouped {
        var d: w::GradientDrawable = w::GradientDrawable::new_void(env);
        d.set_color_i(paint::argb_of(vocab::Color::surface()));
        d.set_corner_radius({ e::px(12.0f64) as f32 });
        var drawable: w::Drawable = d.as_drawable();
        view.set_background(drawable.into_raw());
        view.set_clip_to_outline(true);
        let _k: *u8 = d.into_raw();
    }
    paint::unwrap_keep(view);
    return;
}

// ---- popup -----------------------------------------------------------------------
// A `Spinner`, which is Android's picker: a field showing the selection that
// opens a list of the rest. facet's `label` is what the field reads and `title`
// is the list's prompt, which is exactly the split Android draws.
//
// THE LISTENER IS MUTED while the backend writes. `setSelection` fires it, so
// an apply pass would report facet's own write back as if a finger had chosen
// it — the guard `FacetText` carries for a keystroke, one control over.

const POPUP_LISTENER_TAG: i32 = 2131886092 as i32;   // 0x7F0F000C — see SCROLL_DOC_TAG

fn popup_props(n: *core::Node) -> *props::PopupProps {
    return props_of(n, props::K_POPUP) as *props::PopupProps;
}

fn create_popup(n: *core::Node) -> *u8 {
    let env: rt::Env = e::env();
    var sp: w::Spinner = w::Spinner::new_context(env, e::context());
    let raw: *u8 = sp.into_raw();
    let token: i64 = { #addr(n) as i64 };
    let listener: jni::jobject = dex::new_with_token(env, dex::popup_class(), token);
    if listener != (0 as jni::jobject) {
        var av: w::AdapterView = w::AdapterView::from_global(env, env.new_global_ref(raw));
        av.set_on_item_selected_listener(listener);
        let _k: *u8 = av.into_raw();
        // KEPT, because `mute` is called on this exact object every time the
        // backend writes a selection — and a local ref does not survive the
        // call that made it.
        var sv: w::View = w::View::from_global(env, raw);
        sv.set_tag_i_object(POPUP_LISTENER_TAG, env.new_global_ref(listener));
        paint::unwrap_keep(sv);
        env.delete_local_ref(listener);
    }
    return raw;
}

fn popup_listener_of(env: rt::Env, v: *u8) -> jni::jobject {
    var view: w::View = w::View::from_global(env, v);
    let t: jni::jobject = view.get_tag_i(POPUP_LISTENER_TAG);
    paint::unwrap_keep(view);
    return t;
}

fn apply_popup(v: *u8, n: *core::Node, dirty: u64) {
    let p: *props::PopupProps = popup_props(n);
    if p == (0 as *props::PopupProps) { return; }
    let env: rt::Env = e::env();
    // THE ITEMS AND THE SELECTION ARE ONE WRITE: committing an adapter resets
    // the selection, so a list rebuilt without re-asserting it would silently
    // jump to row zero.
    let rebuilt: u64 = popup::P_ITEMS | popup::P_ITEM_ENABLED | popup::P_SELECTED_INDEX;
    if (dirty & rebuilt) != (0 as u64) || dirty == paint::all_bits() {
        rebuild_popup_items(env, v, n, p);
    }
    if (dirty & popup::P_TITLE) != (0 as u64) {
        var buf: [u8; 256] = #zero::[[u8; 256]]();
        let base: *u8 = { #addr_of(buf[0]) };
        if paint::cstr({ (*p).title.view() }, base, 256 as usize) {
            var sp: w::Spinner = w::Spinner::from_global(env, env.new_global_ref(v));
            sp.set_prompt(base);
            let _k: *u8 = sp.into_raw();
        }
    }
    // `open` is a COMMAND: a spinner opens by being clicked, which is what
    // `performClick` is — and it is acted on when the bit says so rather than
    // re-asserted, because a list opened twice is two lists.
    if (dirty & popup::P_IS_OPEN) != (0 as u64) {
        if { (*p).is_open } {
            var sp: w::Spinner = w::Spinner::from_global(env, env.new_global_ref(v));
            let _o: bool = sp.perform_click();
            let _k: *u8 = sp.into_raw();
            let h: fn(*u8, *u8) = { (*p).on_opened };
            if h != props::no_handler { h(v, { (*p).on_opened_ctx }); }
        } else {
            let h: fn(*u8, *u8) = { (*p).on_closed };
            if h != props::no_handler { h(v, { (*p).on_closed_ctx }); }
        }
    }
    return;
}

fn rebuild_popup_items(env: rt::Env, v: *u8, n: *core::Node, p: *props::PopupProps) {
    let token: i64 = { #addr(n) as i64 };
    dex::popup_begin(env, token);
    var i: usize = 0 as usize;
    let count: usize = { (*p).items.count() };
    var buf: [u8; 256] = #zero::[[u8; 256]]();
    let base: *u8 = { #addr_of(buf[0]) };
    while i < count {
        if !paint::cstr({ (*p).items.at(i) }, base, 256 as usize) { { (*base) = 0 as u8 }; }
        // `item_enabled` is a CALLBACK, and a header answers false — which is
        // what makes a header a header rather than a pickable row.
        var enabled: bool = true;
        let f: fn(usize, *u8) -> bool = { (*p).item_enabled };
        if f != props::every_item_enabled { enabled = f(i, { (*p).item_enabled_ctx }); }
        dex::popup_add(env, token, base, enabled);
        i = i +% (1 as usize);
    }
    // THE COMMIT SETS THE SELECTION, and that fires the listener — but not
    // synchronously: a Spinner POSTS `onItemSelected`, so a mute held across
    // this call is already released by the time the callback lands. Measured,
    // not assumed — the log read `muted=false` every time.
    //
    // `fire_picked` is what suppresses the echo, by returning early when the
    // index it is handed is the one the props already hold.
    dex::popup_commit(env, v, token, { { (*p).selected_index } as i32 });
    return;
}

// A row was picked. WRITTEN BACK FIRST, so a handler asking `popup.selected_
// index()` is told what was chosen rather than what was there before it.
fn fire_picked(token: i64, index: i32) {
    let n: *core::Node = { token as *core::Node };
    if n == (0 as *core::Node) { return; }
    let p: *props::PopupProps = popup_props(n);
    if p == (0 as *props::PopupProps) { return; }
    if { (*p).selected_index } == { index as i64 } { return; }
    { (*p).selected_index = { index as i64 } };
    let h: fn(*u8, *u8) = { (*p).on_selected_index_changed };
    if h != props::no_handler { h(core::view_of(n), { (*p).on_selected_index_changed_ctx }); }
    return;
}

// ---- web -------------------------------------------------------------------------
// A `WebView`, which android.jar has and which is the one control here that
// brings a whole engine with it.
//
// THE NAVIGATION EDGES COME FROM A SUBCLASS, because `WebViewClient` is a class
// and cannot be implemented from native code — the same wall `BaseAdapter` is.
// FacetWeb is the smallest one that reports what facet asks for, and it is also
// where `can_go_back` and `can_go_forward` are read from: they are answers the
// view gives at the moment a page finishes, not properties an app sets.

fn web_props(n: *core::Node) -> *props::WebProps {
    return props_of(n, props::K_WEB) as *props::WebProps;
}

fn create_web(n: *core::Node) -> *u8 {
    let env: rt::Env = e::env();
    var wv: w::WebView = w::WebView::new_context(env, e::context());
    let raw: *u8 = wv.into_raw();
    let client: jni::jobject =
        dex::new_with_token(env, dex::web_class(), { #addr(n) as i64 });
    if client != (0 as jni::jobject) {
        var v2: w::WebView = w::WebView::from_global(env, env.new_global_ref(raw));
        v2.set_web_view_client(client);
        let _k: *u8 = v2.into_raw();
        env.delete_local_ref(client);
    }
    // JAVASCRIPT IS OFF BY DEFAULT on a WebView, and `eval` is one of the six
    // verbs the kind declares — a web view that cannot run a script answers
    // half its contract. An application that does not want it does not call
    // `eval`; the switch is the platform's default being wrong for this control
    // rather than a policy this backend gets to hold.
    let settings: jni::jobject = env.call_object_0(
        raw, #str_ptr("android/webkit/WebView\0"), #str_ptr("getSettings\0"),
        #str_ptr("()Landroid/webkit/WebSettings;\0"));
    if settings != (0 as jni::jobject) {
        env.call_void_1(settings, #str_ptr("android/webkit/WebSettings\0"),
                        #str_ptr("setJavaScriptEnabled\0"), #str_ptr("(Z)V\0"),
                        rt::arg_bool(true));
        env.delete_local_ref(settings);
    }
    return raw;
}

fn apply_web(v: *u8, n: *core::Node, dirty: u64) {
    let p: *props::WebProps = web_props(n);
    if p == (0 as *props::WebProps) { return; }
    let env: rt::Env = e::env();
    var wv: w::WebView = w::WebView::from_global(env, env.new_global_ref(v));
    if (dirty & web::P_SOURCE) != (0 as u64) {
        var buf: [u8; 1024] = #zero::[[u8; 1024]]();
        let base: *u8 = { #addr_of(buf[0]) };
        if paint::cstr({ (*p).source.view() }, base, 1024 as usize) {
            wv.load_url_str(base);
        }
    }
    if (dirty & web::P_USER_AGENT) != (0 as u64) {
        var buf: [u8; 512] = #zero::[[u8; 512]]();
        let base: *u8 = { #addr_of(buf[0]) };
        if paint::cstr({ (*p).user_agent.view() }, base, 512 as usize) {
            let settings: jni::jobject = env.call_object_0(
                v, #str_ptr("android/webkit/WebView\0"), #str_ptr("getSettings\0"),
                #str_ptr("()Landroid/webkit/WebSettings;\0"));
            if settings != (0 as jni::jobject) {
                let js: jni::jstring = env.new_string_utf(base);
                env.call_void_1(settings, #str_ptr("android/webkit/WebSettings\0"),
                                #str_ptr("setUserAgentString\0"),
                                #str_ptr("(Ljava/lang/String;)V\0"), rt::arg_object(js));
                env.delete_local_ref(js);
                env.delete_local_ref(settings);
            }
        }
    }
    // THE THREE COMMANDS. Acted on when the bit says they were asked for and
    // never re-asserted: a `reload` re-run on an unrelated pass would throw
    // away a page the person is reading.
    if (dirty & web::P_GO_BACK) != (0 as u64) { wv.go_back(); }
    if (dirty & web::P_GO_FORWARD) != (0 as u64) { wv.go_forward(); }
    if (dirty & web::P_RELOAD) != (0 as u64) { wv.reload(); }
    if (dirty & web::P_EVAL) != (0 as u64) {
        var buf: [u8; 2048] = #zero::[[u8; 2048]]();
        let base: *u8 = { #addr_of(buf[0]) };
        if paint::cstr({ (*p).eval_script.view() }, base, 2048 as usize) {
            // A null callback: facet's `eval` is fire-and-forget — the verb
            // takes a script and answers nothing, so a ValueCallback would
            // have nowhere to deliver.
            wv.evaluate_javascript(base, 0 as jni::jobject);
        }
    }
    let _k: *u8 = wv.into_raw();
    return;
}

// A page started, finished, or the renderer died. `can_go_back` and
// `can_go_forward` are WRITTEN BACK on the finish, because they are answers the
// view gives rather than state an application holds — and a direct field write,
// with no `core::touch`: marking them dirty would send them back out as
// commands, and `go_back` is a command.
fn fire_web_edge(token: i64, edge: i32, back: bool, forward: bool) {
    let n: *core::Node = { token as *core::Node };
    if n == (0 as *core::Node) { return; }
    // A HYBRID VIEW IS A WEB VIEW WITH ANOTHER RECORD, and the navigation edges
    // are the plain kind's. What a hybrid does extra on a finished load is put
    // its channel back: a new document wipes whatever the last one had.
    if core::kind_of(n) == props::K_HYBRID_WEB {
        if edge == (1 as i32) { install_channel(core::view_of(n)); }
        return;
    }
    let p: *props::WebProps = web_props(n);
    if p == (0 as *props::WebProps) { return; }
    let v: *u8 = core::view_of(n);
    if edge == (0 as i32) {
        let h: fn(*u8, *u8) = { (*p).on_navigating };
        if h != props::no_handler { h(v, { (*p).on_navigating_ctx }); }
        return;
    }
    if edge == (1 as i32) {
        { (*p).can_go_back = back };
        { (*p).can_go_forward = forward };
        let h: fn(*u8, *u8) = { (*p).on_navigated };
        if h != props::no_handler { h(v, { (*p).on_navigated_ctx }); }
        return;
    }
    let h: fn(*u8, *u8) = { (*p).on_process_terminated };
    if h != props::no_handler { h(v, { (*p).on_process_terminated_ctx }); }
    return;
}

// ---- page dots ---------------------------------------------------------------
// Android has no page control — UIPageControl's opposite number is a ViewPager
// INDICATOR from a support library this project does not ship, and the widget
// itself is five circles. So it is five circles: a horizontal LinearLayout of
// dot views, each an oval GradientDrawable, rebuilt when the count changes and
// recoloured when the position does.
//
// Three views inside one facet node, which is the stepper's shape and the same
// rule: facet owns the layout of facet's TREE, not of a control's INTERNALS.

fn dot_gap() -> f64 { return 8.0f64; }
fn default_dot_size() -> f64 { return 8.0f64; }

fn create_page_dots(n: *core::Node) -> *u8 {
    let env: rt::Env = e::env();
    var row: w::LinearLayout = w::LinearLayout::new_context(env, e::context());
    let raw: *u8 = row.into_raw();
    var r: w::LinearLayout = w::LinearLayout::from_global(env, raw);
    r.set_orientation(0 as i32);   // HORIZONTAL
    r.set_gravity(16 as i32);      // CENTER_VERTICAL
    let _k: *u8 = r.into_raw();
    return raw;
}

fn apply_page_dots(v: *u8, n: *core::Node, dirty: u64) {
    let p: *props::PageDotsProps = props_of(n, props::K_PAGE_DOTS) as *props::PageDotsProps;
    if p == (0 as *props::PageDotsProps) { return; }
    let env: rt::Env = e::env();

    // HOW MANY DOTS THERE ACTUALLY ARE. `max_dots` is a CAP: showing more dots
    // than the application allowed is the one reading that is definitely wrong,
    // and Android has no strip that condenses on its own to do anything
    // cleverer with.
    var shown: i64 = { (*p).count };
    let max: i64 = { (*p).max_dots };
    if max > (0 as i64) && shown > max { shown = max; }
    if shown < (0 as i64) { shown = 0 as i64; }
    // `hides_single` — one page is no pages worth showing.
    if { (*p).hides_single } && shown <= (1 as i64) { shown = 0 as i64; }

    let watched: u64 = page_dots::P_COUNT | page_dots::P_MAX_DOTS
                     | page_dots::P_HIDES_SINGLE | page_dots::P_DOT_SIZE
                     | page_dots::P_DOT_SHAPE;
    let had: i64 = dot_count_of(env, v);
    if (dirty & watched) != (0 as u64) || dirty == paint::all_bits() || had != shown {
        rebuild_dots(env, v, p, shown);
    }
    // The colours are per-dot and cheap, so they are written on every pass that
    // could have moved the selection.
    let recolour: u64 = page_dots::P_POSITION | page_dots::P_DOT_COLOR
                      | page_dots::P_SELECTED_DOT_COLOR | props::C_RESTYLE;
    if (dirty & (recolour | watched)) != (0 as u64) || dirty == paint::all_bits() {
        colour_dots(env, v, p, shown);
    }
    return;
}

// HOW MANY DOTS ARE THERE — asked of the row itself rather than remembered.
//
// The first shape of this stored the count in a keyed TAG as a packed integer,
// on the reasoning that a tag slot is a word and an address is a word. A tag is
// an OBJECT slot: the JVM took `5` for a reference and dereferenced it, and the
// process died inside setTag with a null-page fault. The row already knows how
// many children it has.
fn dot_count_of(env: rt::Env, v: *u8) -> i64 {
    var g: w::ViewGroup = w::ViewGroup::from_global(env, v);
    let n: i32 = g.get_child_count();
    let _k: *u8 = g.into_raw();
    return { n as i64 };
}

fn rebuild_dots(env: rt::Env, v: *u8, p: *props::PageDotsProps, shown: i64) {
    var g: w::ViewGroup = w::ViewGroup::from_global(env, v);
    g.remove_all_views();
    let _k: *u8 = g.into_raw();
    var size: f64 = { (*p).dot_size };
    if size <= 0.0f64 { size = default_dot_size(); }
    var i: i64 = 0 as i64;
    while i < shown {
        add_dot(env, v, size, i > (0 as i64));
        i = i +% (1 as i64);
    }
    return;
}

fn add_dot(env: rt::Env, host: *u8, size: f64, gap_before: bool) {
    var dot: w::View = w::View::new_context(env, e::context());
    let raw: *u8 = dot.into_raw();
    // MARGIN-FREE and sized by LayoutParams: a dot is not in facet's tree, so
    // flex never places it — its box is Android's to decide and this is where
    // it is said.
    let cls: jni::jclass = env.class_cached(#str_ptr("android/widget/LinearLayout$LayoutParams\0"));
    let ctor: jni::jmethodID = env.method_id(cls, #str_ptr("<init>\0"), #str_ptr("(II)V\0"));
    let px: i32 = { e::px(size) as i32 };
    var args: [jni::JValue; 2] = [jni::arg_int(px), jni::arg_int(px)];
    let lp: jni::jobject = { (*(*env.raw())).NewObjectA(env.raw(), cls, ctor,
                                                        #addr_of(args[0])) };
    if gap_before {
        let fid: jni::jfieldID = env.field_id(cls, #str_ptr("leftMargin\0"), #str_ptr("I\0"));
        { (*(*env.raw())).SetIntField(env.raw(), lp, fid, { e::px(dot_gap()) as i32 }) };
    }
    var dv: w::View = w::View::from_global(env, raw);
    dv.set_layout_params(lp);
    paint::unwrap_keep(dv);
    env.delete_local_ref(lp);
    var group: w::ViewGroup = w::ViewGroup::from_global(env, host);
    group.add_view_view(raw);
    let _k: *u8 = group.into_raw();
    return;
}

fn colour_dots(env: rt::Env, v: *u8, p: *props::PageDotsProps, shown: i64) {
    var plain: vocab::Color = { (*p).dot_color };
    if !plain.is_set() { plain = vocab::Color::ink(0.3f64); }
    var selected: vocab::Color = { (*p).selected_dot_color };
    if !selected.is_set() { selected = vocab::Color::ink(0.9f64); }
    var size: f64 = { (*p).dot_size };
    if size <= 0.0f64 { size = default_dot_size(); }
    let square: bool = match { (*p).dot_shape } {
        vocab::DotShape::Square => true,
        vocab::DotShape::Circle => false,
    };
    var g: w::ViewGroup = w::ViewGroup::from_global(env, v);
    var i: i32 = 0 as i32;
    while i < { shown as i32 } {
        let child: jni::jobject = g.get_child_at(i);
        if child != (0 as jni::jobject) {
            var c: vocab::Color = plain;
            if { i as i64 } == { (*p).position } { c = selected; }
            paint_dot(env, child, c, size, square);
            env.delete_local_ref(child);
        }
        i = i +% (1 as i32);
    }
    let _k: *u8 = g.into_raw();
    return;
}

// One dot. A GradientDrawable is what every rounded rectangle in this package
// is; the SHAPE call is the only thing that makes this one a circle — `1` is
// GradientDrawable.OVAL, read from the class rather than typed in.
fn paint_dot(env: rt::Env, dot: jni::jobject, c: vocab::Color, size: f64, square: bool) {
    var d: w::GradientDrawable = w::GradientDrawable::new_void(env);
    if square { d.set_corner_radius({ e::px(size / 4.0f64) as f32 }); }
    else { d.set_shape(oval_shape(env)); }
    d.set_color_i(paint::argb_of(c));
    var drawable: w::Drawable = d.as_drawable();
    var dv: w::View = w::View::from_global(env, dot);
    dv.set_background(drawable.into_raw());
    let _keep: *u8 = dv.into_raw();
    let _k: *u8 = d.into_raw();
    return;
}

fn oval_shape(env: rt::Env) -> i32 {
    let cls: jni::jclass = env.class_cached(#str_ptr("android/graphics/drawable/GradientDrawable\0"));
    let fid: jni::jfieldID = env.static_field_id(cls, #str_ptr("OVAL\0"), #str_ptr("I\0"));
    return { (*(*env.raw())).GetStaticIntField(env.raw(), cls, fid) };
}

// ---- canvas ------------------------------------------------------------------
// The one control whose backing view has behaviour of its own, and so the one
// with a class of its own: FacetCanvas exists to have an `onDraw`. Everything
// about the drawing lives in drawing.cplus; this is the two verbs that reach it.

fn create_canvas(n: *core::Node) -> *u8 {
    let env: rt::Env = e::env();
    let raw: *u8 = global_of(dex::new_view_with_token(env, dex::canvas_class(),
                                                      e::context(), { #addr(n) as i64 }));
    // THE INTERACTION BAND, which is what a canvas is for beyond drawing.
    arm_touch(env, raw, n);
    return raw;
}

fn apply_canvas(v: *u8, n: *core::Node, dirty: u64) {
    let p: *props::CanvasProps = props_of(n, props::K_CANVAS) as *props::CanvasProps;
    if p == (0 as *props::CanvasProps) { return; }
    // A new Drawable, an explicit `redraw()`, or a new box: the drawing is a
    // function of the laid-out size, so a resize is a repaint.
    let watched: u64 = canvas::P_DRAWABLE | canvas::P_REDRAW | props::C_LAYOUT;
    if (dirty & watched) != (0 as u64) || dirty == paint::all_bits() {
        let env: rt::Env = e::env();
        var view: w::View = w::View::from_global(env, v);
        view.invalidate_void();
        paint::unwrap_keep(view);
    }
    return;
}

// ---- split -------------------------------------------------------------------
// Android has no split widget, and — as on iOS — one FACT is what is missing
// rather than the whole kind: there is no touch gesture that means "grab this
// hairline", so the divider does not drag. Everything else a split is (an axis,
// a position, two pane minimums, a collapse, a drawn divider) is geometry, and
// geometry is flex's.
//
// So the split is a plain host, the division is written into facet's own
// layout — leading pane fixed, trailing pane growing from a zero basis, the
// divider a GAP between them — and the divider itself is one extra View this
// package owns. MANIFEST.md §2 says "no drag", not "no split".
//
// The divider is a NATIVE child and not a facet node, exactly as GTK's is. It
// is added at create, so facet's own inserts (always at a slot inside the pane
// range) push it to the end and it draws last, on top. `geometry` places it —
// nothing else in the frame walk knows it exists.

const SPLIT_DIVIDER_TAG: i32 = 2131886086 as i32;   // 0x7F0F0006 — see SCROLL_DOC_TAG

// WHERE ON THE DIVIDER THE FINGER LANDED, kept for the length of one drag. A
// single static rather than a per-node one because a drag is a single pointer
// on a single divider: two at once is two fingers on two splits, which no
// backend here answers and none of the three platforms offer.
static SPLIT_GRAB: f64 = 0.0f64;

// MotionEvent's hover actions.
const HOVER_MOVE: i32 = 7 as i32;
const HOVER_ENTER: i32 = 9 as i32;
const HOVER_EXIT: i32 = 10 as i32;

fn create_split(n: *core::Node) -> *u8 {
    let env: rt::Env = e::env();
    let raw: *u8 = global_of(dex::new_host(env, e::context()));
    var bar: w::View = w::View::new_context(env, e::context());
    let bar_raw: *u8 = bar.into_raw();
    attach_layout_params(bar_raw);
    var host: w::ViewGroup = w::ViewGroup::from_global(env, raw);
    host.add_view_view(bar_raw);
    let _k: *u8 = host.into_raw();
    var hv: w::View = w::View::from_global(env, raw);
    hv.set_tag_i_object(SPLIT_DIVIDER_TAG, bar_raw);
    paint::unwrap_keep(hv);
    // THE DRAG. CLICKABLE FIRST, and it is not decoration: a View that does not
    // handle touches returns false from `onTouchEvent` and is sent the DOWN and
    // nothing after it — no MOVE, no UP. The observer listener returns false
    // too, so the View's own handling is what keeps the stream coming; without
    // the flag the divider would report the press of a drag and never the drag.
    var bv: w::View = w::View::from_global(env, bar_raw);
    bv.set_clickable(true);
    paint::unwrap_keep(bv);
    arm_touch(env, bar_raw, n);
    return raw;
}

// WHERE THE FINGER IS, IN THE SPLIT'S OWN SPACE. The touch arrives in the
// DIVIDER'S coordinates, and the divider is the thing being moved — so a
// running total of local deltas double-counts whenever the layout that answers
// the last one has not landed yet. Adding the divider's own offset converts to
// a space that does not move, and the arithmetic is then the same whether the
// relayout was synchronous or a frame late.
fn divider_origin(v: *u8, vertical: bool) -> f64 {
    if !e::have_env() { return 0.0f64; }
    let env: rt::Env = e::env();
    let bar: jni::jobject = divider_of(v);
    if bar == (0 as jni::jobject) { return 0.0f64; }
    var bv: w::View = w::View::from_global(env, env.new_global_ref({ bar as *u8 }));
    var at: i32 = bv.get_top();
    if vertical { at = bv.get_left(); }
    let _k: *u8 = bv.into_raw();
    env.delete_local_ref(bar);
    return e::dp({ at as f64 });
}

// The divider view, as a LOCAL ref — the caller's for the length of the call.
fn divider_of(v: *u8) -> jni::jobject {
    if v == (0 as *u8) { return 0 as jni::jobject; }
    if !e::have_env() { return 0 as jni::jobject; }
    var view: w::View = w::View::from_global(e::env(), v);
    let t: jni::jobject = view.get_tag_i(SPLIT_DIVIDER_TAG);
    paint::unwrap_keep(view);
    return t;
}

fn split_props(n: *core::Node) -> *split::SplitProps {
    return props_of(n, split::K_SPLIT) as *split::SplitProps;
}

fn apply_split(v: *u8, n: *core::Node, dirty: u64) {
    let p: *split::SplitProps = split_props(n);
    if p == (0 as *split::SplitProps) { return; }
    if (dirty & split::P_AXIS) != (0 as u64) || dirty == paint::all_bits() {
        var flow: flex::FlexDirection = flex::FlexDirection::Row;
        match { (*p).axis } {
            split::SplitAxis::Rows => { flow = flex::FlexDirection::Column; }
            split::SplitAxis::Columns => { }
        }
        core::set_flow(n, flow);
    }
    let watched: u64 = split::P_POSITION | split::P_COLLAPSED | split::P_MIN_LEADING
                       | split::P_MIN_TRAILING | split::P_DIVIDER | split::P_AXIS;
    if (dirty & watched) != (0 as u64) || dirty == paint::all_bits() {
        let _changed: bool = settle_split(n, p);
    }
    if (dirty & split::P_DIVIDER) != (0 as u64) || dirty == paint::all_bits() {
        paint_divider(v, p);
    }
    return;
}

// The divider's own paint. A View with a background colour and nothing else —
// a thickness of zero is a split that asked for no line, and GONE is how a
// View says that without a rect anywhere in the walk.
fn paint_divider(v: *u8, p: *split::SplitProps) {
    let env: rt::Env = e::env();
    let bar: jni::jobject = divider_of(v);
    if bar == (0 as jni::jobject) { return; }
    var bv: w::View = w::View::from_global(env, bar);
    let c: vocab::Color = { (*p).divider_color };
    if c.is_set() { bv.set_background_color(paint::argb_of(c)); }
    var vis: i32 = 0 as i32;                       // VISIBLE
    if { (*p).divider_thickness } <= 0.0f64 { vis = 8 as i32; }   // GONE
    bv.set_visibility(vis);
    let local: *u8 = bv.into_raw();
    env.delete_local_ref(local);
    return;
}

// THE DIVISION, written into flex — the whole of what a split is on this
// backend. Ported from facet_uikit, which ported the arithmetic from AppKit;
// every comment there is about flex and not about the platform, which is why
// it moves unchanged. Answers whether it wrote anything, so the layout pass
// knows to compute again.
fn settle_split(n: *core::Node, p: *split::SplitProps) -> bool {
    var wrote: bool = false;
    var vertical: bool = true;
    match { (*p).axis } {
        split::SplitAxis::Rows => { vertical = false; }
        split::SplitAxis::Columns => { }
    }
    let f: flex::Frame = core::frame_of(n);
    var extent: f64 = { f.height };
    if vertical { extent = { f.width }; }

    // THE SPLIT'S SIZE IS ITS PARENT'S BUSINESS, NEVER ITS PANES'. The leading
    // pane is given a fixed main-axis size below, and a fixed size is content
    // the container has to fit — so without a zero basis the split's own base
    // size grows with the position, the bigger split reports a bigger extent,
    // and the extent moves the clamp that moves the pane. Measured elsewhere at
    // 456 -> 547 -> 580 on a probe; the arithmetic is flex's, not a platform's.
    if { (*n).style.flex_grow } > 0.0f64 && !is_points({ (*n).style.flex_basis }, 0.0f64) {
        core::set_basis(n, 0.0f64);
        wrote = true;
    }

    // The divider occupies real points between the panes, and flex knows
    // nothing about it — so it is a GAP. Without this the two panes divide the
    // whole extent between them and every frame is the divider's width out.
    let gap: f64 = { (*p).divider_thickness };
    if !is_points({ (*n).style.gap_row }, gap) || !is_points({ (*n).style.gap_column }, gap) {
        core::set_gap(n, gap);
        wrote = true;
    }

    var want: f64 = { (*p).position };
    if { (*p).collapsed_leading } { want = 0.0f64; }
    else if { (*p).collapsed_trailing } { want = extent; }
    if extent > 0.0f64 {
        // A position past the end IS a collapse — `1e6` is how an application
        // asks for one — so clamp before it becomes a pane size.
        if want > extent { want = extent; }
        if !{ (*p).collapsed_leading } && !{ (*p).collapsed_trailing } {
            let ceiling: f64 = extent - { (*p).min_trailing };
            if ceiling > 0.0f64 && want > ceiling { want = ceiling; }
            let floor: f64 = { (*p).min_leading };
            if floor < extent && want < floor { want = floor; }
        }
    }
    if want < 0.0f64 { want = 0.0f64; }

    match core::child_of(n, 0 as usize) {
        option::Option[*core::Node]::Some(lead) => {
            if vertical {
                if !is_points({ (*lead).style.width }, want) {
                    core::set_width(lead, want);
                    wrote = true;
                }
            } else {
                if !is_points({ (*lead).style.height }, want) {
                    core::set_height(lead, want);
                    wrote = true;
                }
            }
            if { (*lead).style.flex_grow } != 0.0f64 { core::set_grow(lead, 0.0f64); wrote = true; }
            // SHRINKABLE, and load-bearing: a fixed main-axis size the pane
            // cannot give back becomes the split's min-content, and flex shrink
            // defaults to 0 — so a split asked for more than its parent offers
            // grows PAST the parent instead of being squeezed back, and the
            // inflated frame is what the next settle reads as `extent`.
            if { (*lead).style.flex_shrink } != 1.0f64 {
                core::set_shrink(lead, 1.0f64);
                wrote = true;
            }
        }
        option::Option[*core::Node]::None => { return wrote; }
    }
    // The trailing pane takes the rest, from a base of ZERO — which is what
    // makes "the rest" true. A flex item's base size is its CONTENT, so a
    // trailing pane holding 115pt of content would otherwise force the leading
    // pane to give up points the divider had just been put at.
    match core::child_of(n, 1 as usize) {
        option::Option[*core::Node]::Some(trail) => {
            if { (*trail).style.flex_grow } != 1.0f64 { core::set_grow(trail, 1.0f64); wrote = true; }
            if !is_points({ (*trail).style.flex_basis }, 0.0f64) {
                core::set_basis(trail, 0.0f64);
                wrote = true;
            }
        }
        option::Option[*core::Node]::None => { }
    }
    return wrote;
}

fn is_points(l: flex::StyleLength, v: f64) -> bool {
    let val: f64 = { l.value };
    return match { l.unit } {
        flex::Unit::Point => val == v,
        _ => false,
    };
}

// ---- the refresh indicator's slot ---------------------------------------------
// The TAG and its reader live here rather than in `recycler`, because the frame
// walk needs them too — and `geometry` already imports this module while
// `recycler` imports `geometry`. One more edge the other way would be a cycle.

const REFRESH_SPINNER_TAG: i32 = 2131886091 as i32;   // 0x7F0F000B — see SCROLL_DOC_TAG

fn refresh_spinner_tag() -> i32 { return REFRESH_SPINNER_TAG; }

// A LOCAL ref or null.
fn refresh_spinner_of(env: rt::Env, v: *u8) -> jni::jobject {
    if v == (0 as *u8) { return 0 as jni::jobject; }
    var view: w::View = w::View::from_global(env, v);
    let t: jni::jobject = view.get_tag_i(REFRESH_SPINNER_TAG);
    paint::unwrap_keep(view);
    return t;
}

// How tall the indicator is, which the frame walk needs and the recycler sets.
fn refresh_height() -> f64 { return 48.0f64; }

// ---- the raw touch ------------------------------------------------------------
// TWO KINDS WANT THE EDGES OF A TOUCH rather than the click it becomes: a
// button, which declares `on_pressed` and `on_released`, and a canvas, whose
// interaction band is five verbs about a finger.
//
// One adapter serves both and the KIND decides what the edges mean — the same
// shape `fire_click` takes, and for the same reason: one hook, one token, no
// side table.
//
// WHAT IS NOT HERE is the HOVER half of the canvas band. `on_hover`,
// `on_unhover` and `observe_move_hover_interaction` need a pointer that is not
// touching, and a finger is never that. MANIFEST §1, the same reading
// facet_uikit records.

// THE ANCESTOR SCROLL'S PROMISE not to take the rest of this gesture.
// `requestDisallowInterceptTouchEvent` is asked of the PARENT, which is the
// chain a ScrollView is somewhere up. Used by any control that owns a drag a
// scrolling page would otherwise steal at the touch slop.
fn hold_parent(env: rt::Env, v: *u8, on: bool) {
    if v == (0 as *u8) { return; }
    var view: w::View = w::View::from_global(env, v);
    let parent: jni::jobject = view.get_parent();
    paint::unwrap_keep(view);
    if parent == (0 as jni::jobject) { return; }
    var g: w::ViewGroup = w::ViewGroup::from_global(env, parent);
    g.request_disallow_intercept_touch_event(on);
    let _k: *u8 = g.into_raw();
    return;
}

fn arm_touch(env: rt::Env, raw: *u8, n: *core::Node) {
    let listener: jni::jobject =
        dex::new_with_token(env, dex::touch_class(), { #addr(n) as i64 });
    if listener == (0 as jni::jobject) { return; }
    var view: w::View = w::View::from_global(env, raw);
    view.set_on_touch_listener(listener);
    // THE SAME OBJECT ON BOTH STREAMS. Hover is dispatched separately from
    // touch and reaches a mouse or a stylus only, so a canvas asking for
    // `on_hover` gets nothing from the touch listener however it is written.
    view.set_on_hover_listener(listener);
    paint::unwrap_keep(view);
    env.delete_local_ref(listener);
    return;
}

fn fire_touch_event(token: i64, action: i32, x: f32, y: f32) {
    let n: *core::Node = { token as *core::Node };
    if n == (0 as *core::Node) { return; }
    let d: *core::Data = core::node_data(n);
    if d == (0 as *core::Data) { return; }
    let raw: *u8 = { (*d).props };
    if raw == (0 as *u8) { return; }
    let kind: u32 = { (*d).kind };
    let v: *u8 = core::view_of(n);
    // MotionEvent: DOWN 0, UP 1, MOVE 2, CANCEL 3 — and the hover stream's own
    // three, which arrive through the same listener and mean the pointer moved
    // WITHOUT touching anything.
    let down: bool = action == (0 as i32);
    let up: bool = action == (1 as i32);
    let moved: bool = action == (2 as i32);
    let cancelled: bool = action == (3 as i32);

    if kind == props::K_BUTTON {
        let p: *props::ButtonProps = raw as *props::ButtonProps;
        if down { fire_one(v, { (*p).on_pressed }, { (*p).on_pressed_ctx }); }
        // A CANCEL IS A RELEASE for a button: the finger left without a click,
        // and a control that reported the press and never the release would
        // leave an application holding a pressed state forever.
        if up || cancelled { fire_one(v, { (*p).on_released }, { (*p).on_released_ctx }); }
        return;
    }
    if kind == props::K_ICON_BUTTON {
        let p: *props::IconButtonProps = raw as *props::IconButtonProps;
        if down { fire_one(v, { (*p).on_pressed }, { (*p).on_pressed_ctx }); }
        if up || cancelled { fire_one(v, { (*p).on_released }, { (*p).on_released_ctx }); }
        return;
    }
    // A LIST'S PULL is the recycler's, and it is dispatched by the NATIVE rather
    // than from here: `recycler` already imports this module for the touch
    // adapter and the layout params, so calling back into it would close a
    // cycle. facet_android.cplus imports both and is the place that can.
    // A DIVIDER DRAG. `position` is written and marked dirty, which is what
    // makes the settle walk re-divide the panes; `on_move` is the report, and
    // it fires on the MOVE rather than the release because a split that only
    // tells you where it landed cannot drive anything live.
    if kind == split::K_SPLIT {
        let p: *split::SplitProps = raw as *split::SplitProps;
        var vertical: bool = true;
        match { (*p).axis } {
            split::SplitAxis::Rows => { vertical = false; }
            split::SplitAxis::Columns => { }
        }
        var along: f64 = e::dp({ y as f64 });
        if vertical { along = e::dp({ x as f64 }); }
        let here: f64 = divider_origin(v, vertical) + along;
        if down { SPLIT_GRAB = here - { (*p).position }; return; }
        if !moved { return; }
        // CLAMPED BEFORE IT IS STORED, not just before it is laid out. The
        // settle walk clamps what it DRAWS and leaves the prop alone, which is
        // right for an application writing a position — but a drag reads the
        // prop back to find its grab offset, so an unclamped value that the
        // layout ignored puts the divider and the number in different places
        // and the drag cannot come back. Measured: a pull past the end left
        // `position` at 269 in a 120-tall split, and dragging up did nothing.
        let f: flex::Frame = core::frame_of(n);
        var extent: f64 = { f.height };
        if vertical { extent = { f.width }; }
        var want: f64 = here - SPLIT_GRAB;
        var floor: f64 = { (*p).min_leading };
        var ceiling: f64 = extent - { (*p).min_trailing };
        if ceiling < floor { ceiling = floor; }
        if want < floor { want = floor; }
        if extent > 0.0f64 && want > ceiling { want = ceiling; }
        { (*p).position = want };
        core::touch(n, split::P_POSITION);
        let h: fn(*u8, *u8) = { (*p).on_move };
        if h != split::no_move { h(v, { (*p).ctx }); }
        return;
    }
    if kind == props::K_CANVAS {
        let p: *props::CanvasProps = raw as *props::CanvasProps;
        if down { fire_one(v, { (*p).on_press }, { (*p).on_press_ctx }); }
        if moved {
            fire_one(v, { (*p).observe_drag_interaction },
                     { (*p).observe_drag_interaction_ctx });
        }
        if up { fire_one(v, { (*p).on_release }, { (*p).on_release_ctx }); }
        if cancelled { fire_one(v, { (*p).on_cancel }, { (*p).on_cancel_ctx }); }
        // THE POINTER, WHICH IS NOT THE FINGER. Hover is a real Android stream
        // and an empty one on a phone held in a hand: it is delivered to a
        // mouse, a stylus and a trackpad. A canvas that asks for it on a
        // desktop-class Android device gets it, and on a touchscreen it is
        // simply never sent — which is the honest answer to a verb about a
        // pointer that is not there.
        if action == HOVER_ENTER { fire_one(v, { (*p).on_hover }, { (*p).on_hover_ctx }); }
        if action == HOVER_EXIT { fire_one(v, { (*p).on_unhover }, { (*p).on_unhover_ctx }); }
        if action == HOVER_MOVE {
            fire_one(v, { (*p).observe_move_hover_interaction },
                     { (*p).observe_move_hover_interaction_ctx });
        }
        return;
    }
    return;
}

fn fire_one(sender: *u8, h: fn(*u8, *u8), ctx: *u8) {
    if h == props::no_handler { return; }
    h(sender, ctx);
    return;
}

// ---- the agent's door --------------------------------------------------------
//
// An agent's click IS the control's own event path — the same function the
// Java listener adapter calls, one layer below the adapter. Nothing here
// synthesizes a touch, and nothing here can drag, pinch or swipe: an agent has
// no hands, and that is a property of the surface rather than a gap in it.

fn agent_click(n: *core::Node) -> bool {
    let d: *core::Data = core::node_data(n);
    if d == (0 as *core::Data) { return false; }
    let kind: u32 = { (*d).kind };
    if kind == props::K_BUTTON { fire_click({ #addr(n) as i64 }); return true; }
    if kind == text_button::K_TEXT_BUTTON { fire_click({ #addr(n) as i64 }); return true; }
    if kind == props::K_ICON_BUTTON { fire_click({ #addr(n) as i64 }); return true; }
    // A compound button TOGGLES: clicking one is asking for the other state,
    // which is what a finger does to it and what the props then have to say.
    if kind == props::K_CHECKBOX {
        let p: *props::CheckboxProps = { (*d).props } as *props::CheckboxProps;
        fire_checked({ #addr(n) as i64 }, !{ (*p).on });
        return true;
    }
    if kind == props::K_TOGGLE {
        let p: *props::ToggleProps = { (*d).props } as *props::ToggleProps;
        fire_checked({ #addr(n) as i64 }, !{ (*p).on });
        return true;
    }
    // A RADIO IS NOT A TOGGLE. Clicking one asks for it to be ON; clicking the
    // selected one is not a request to clear the group, and `radio_changed`
    // already knows that.
    if kind == props::K_RADIO { fire_checked({ #addr(n) as i64 }, true); return true; }
    // A DATE PICKER'S CLICK IS "OPEN", which is what its field does under a
    // finger. The date itself is chosen in a dialog the agent cannot reach —
    // an agent has no hands and a modal has no facet tree — so `set_text` is
    // the door for choosing one, not this.
    if kind == props::K_DATE_PICKER { return fire_date_picker_click(n); }
    return false;
}

// Writing into a field WITHOUT the platform in the loop: the props are written
// and the handler told, then the control is brought into step by an ordinary
// dirty bit. Going through the widget instead would fire the TextWatcher and
// arrive back here as if a finger had typed it.
fn agent_set_text(n: *core::Node, value: str) -> bool {
    let iv: *props::InputViewProps = input_view_of(n);
    if iv == (0 as *props::InputViewProps) { return false; }
    { (*iv).text = text::from_str(value) };
    core::touch(n, text_field::P_TEXT);
    let h: fn(*u8, *u8) = { (*iv).on_text_changed };
    if h != props::no_handler { h(core::view_of(n), { (*iv).on_text_changed_ctx }); }
    return true;
}

// ---- carousel ------------------------------------------------------------------
//
// A PAGING HorizontalScrollView. Not an adapter view: a carousel's pages are the
// CHILDREN facet already built and mounted under the node, so there is nothing
// for a `getView` to answer. The document host and its tag are the scroll's,
// unchanged, which is what lets `document_host`, `size_document` and the mount
// walk treat the two the same.

fn carousel_props(n: *core::Node) -> *props::CarouselProps {
    return props_of(n, props::K_CAROUSEL) as *props::CarouselProps;
}

fn create_carousel(n: *core::Node) -> *u8 {
    let env: rt::Env = e::env();
    { (*n).set_flex_shrink(1.0f64) };
    let raw_local: jni::jobject = dex::new_carousel(env, e::context(), { #addr(n) as i64 });
    if raw_local == (0 as jni::jobject) { return 0 as *u8; }
    var hv: w::HorizontalScrollView = w::HorizontalScrollView::from_local(env, raw_local);
    let raw: *u8 = hv.into_raw();
    let doc: jni::jobject = dex::new_host(env, e::context());
    var group: w::ViewGroup = w::ViewGroup::from_global(env, raw);
    group.add_view_view(doc);
    // A VIEWPORT CLIPS, and this one has to say so. Every FacetHost turns
    // clipping OFF in its constructor — facet places children by frame and a
    // shadow or an overshoot must not be cut — and the document is a FacetHost
    // four pages wide. Without this the pages either side of the current one
    // are drawn straight over whatever the carousel sits in.
    group.set_clip_children(true);
    group.set_clip_to_padding(true);
    var gv: w::View = w::View::from_global(env, group.into_raw());
    gv.set_tag_i_object(SCROLL_DOC_TAG, doc);
    paint::unwrap_keep(gv);
    env.delete_local_ref(doc);
    let listener: jni::jobject =
        dex::new_with_token(env, dex::scroll_class(), { #addr(n) as i64 });
    if listener != (0 as jni::jobject) {
        var sv: w::View = w::View::from_global(env, raw);
        sv.set_on_scroll_change_listener(listener);
        paint::unwrap_keep(sv);
        env.delete_local_ref(listener);
    }
    return raw;
}

fn apply_carousel(v: *u8, n: *core::Node, dirty: u64) {
    let p: *props::CarouselProps = carousel_props(n);
    if p == (0 as *props::CarouselProps) { return; }
    let env: rt::Env = e::env();
    if (dirty & carousel::P_IS_SWIPEABLE) != (0 as u64) {
        dex::carousel_set_flag(env, { v as jni::jobject }, #str_ptr("setSwipeable\0"),
                               { (*p).is_swipeable });
    }
    if (dirty & carousel::P_ANIMATES_SCROLL) != (0 as u64) {
        dex::carousel_set_flag(env, { v as jni::jobject }, #str_ptr("setAnimated\0"),
                               { (*p).animates_scroll });
    }
    // BOUNCES is the overscroll glow, which is the whole of Android's answer:
    // a HorizontalScrollView has no rubber band to switch off, it has an edge
    // effect, and NEVER is what "does not bounce" looks like here.
    if (dirty & carousel::P_BOUNCES) != (0 as u64) {
        var bv: w::View = w::View::from_global(env, v);
        bv.set_over_scroll_mode(if { (*p).bounces } { 0 as i32 } else { 2 as i32 });
        paint::unwrap_keep(bv);
    }
    if (dirty & (carousel::P_HORIZONTAL_SCROLL_BARS
                 | carousel::P_VERTICAL_SCROLL_BARS)) != (0 as u64) {
        var sv: w::View = w::View::from_global(env, v);
        sv.set_horizontal_scroll_bar_enabled(
            bars_shown({ (*p).items_view.horizontal_scroll_bars }));
        sv.set_vertical_scroll_bar_enabled(
            bars_shown({ (*p).items_view.vertical_scroll_bars }));
        paint::unwrap_keep(sv);
    }
    // POSITION and SCROLL_TO are the same move under two names — one is where
    // the carousel IS, the other is an application asking it to go somewhere —
    // and both land on `goTo`, which does not report a page it was told to show.
    // COLUMNS changes the PAGE WIDTH, which is flex's to know — the settle walk
    // writes it every layout, and this is what makes that layout happen.
    if (dirty & carousel::P_COLUMNS) != (0 as u64) {
        let _changed: bool = settle_carousel(n, p);
    }
    // THE TAIL THRESHOLD, in pages. A carousel's pages are its children, so
    // "remaining" is how many are still to the right of the one showing.
    if (dirty & carousel::P_REMAINING_THRESHOLD) != (0 as u64) {
        carousel_threshold(n, p);
    }
    if (dirty & carousel::P_POSITION) != (0 as u64) {
        dex::carousel_go_to(env, { v as jni::jobject }, { { (*p).position } as i32 });
    }
    if (dirty & carousel::P_SCROLL_TO) != (0 as u64) {
        let to: i64 = { (*p).items_view.scroll_to_index };
        if to >= (0 as i64) { dex::carousel_go_to(env, { v as jni::jobject }, { to as i32 }); }
    }
    return;
}

// THE PAGE GEOMETRY, written into flex rather than onto the views.
//
// A carousel is a ROW of fixed-width pages that OVERFLOWS its own frame: that
// overflow is the scroll range, and it is why the pages must not shrink. The
// page width is the viewport less the peek insets, divided by `columns` — which
// is what makes a carousel showing three at a time three columns wide and one
// showing a sliver of the next narrower than its own frame.
fn settle_carousel(n: *core::Node, p: *props::CarouselProps) -> bool {
    var wrote: bool = false;
    let f: flex::Frame = core::frame_of(n);
    let insets: vocab::Insets = { (*p).peek_insets };
    var page: f64 = { f.width } - { insets.leading } - { insets.trailing };
    var cols: usize = { (*p).structured_items_view.columns };
    if cols < (1 as usize) { cols = 1 as usize; }
    page = page / { cols as f64 };
    if page < 1.0f64 { return false; }
    match { (*n).style.flex_direction } {
        flex::FlexDirection::Row => { }
        _ => { core::set_flow(n, flex::FlexDirection::Row); wrote = true; }
    }
    var i: usize = 0 as usize;
    let count: usize = core::child_count_of(n);
    while i < count {
        match core::child_of(n, i) {
            option::Option[*core::Node]::Some(c) => {
                if !is_points({ (*c).style.width }, page) {
                    { (*c).set_width(flex::StyleLength::points(page)) };
                    wrote = true;
                }
                if { (*c).style.flex_shrink } != 0.0f64 {
                    { (*c).set_flex_shrink(0.0f64) };
                    wrote = true;
                }
            }
            option::Option[*core::Node]::None => { }
        }
        i = i +% (1 as usize);
    }
    // The widget needs the same two numbers to snap with, in pixels.
    if !e::have_env() { return wrote; }
    let v: *u8 = core::view_of(n);
    if v == (0 as *u8) { return wrote; }
    dex::carousel_set_page(e::env(), { v as jni::jobject },
                           { e::px(page) as i32 }, { count as i32 });
    return wrote;
}

// A PAGE SETTLED UNDER THE FINGER. `position` is written back so a read of the
// prop answers where the carousel actually is, and both handlers fire: facet
// distinguishes the current ITEM from the POSITION, and a carousel whose pages
// are its children has no item that is not its index.
// HOW MANY PAGES ARE LEFT, against the threshold the application named. Fired
// on every settle and whenever the threshold itself changes, because a
// threshold raised past where the carousel already sits has to fire now.
fn carousel_threshold(n: *core::Node, p: *props::CarouselProps) {
    let threshold: i64 = { (*p).items_view.remaining_threshold };
    if threshold <= (0 as i64) { return; }
    let total: i64 = { core::child_count_of(n) as i64 };
    if total <= (0 as i64) { return; }
    let remaining: i64 = total - ({ (*p).position } + (1 as i64));
    if remaining > threshold { return; }
    let h: fn(*u8, *u8) = { (*p).items_view.on_remaining_items_threshold_reached };
    if h != props::no_handler {
        h(core::view_of(n), { (*p).items_view.on_remaining_items_threshold_reached_ctx });
    }
    return;
}

fn fire_carousel_page(token: i64, index: i32) {
    let n: *core::Node = { token as *core::Node };
    if n == (0 as *core::Node) { return; }
    let p: *props::CarouselProps = carousel_props(n);
    if p == (0 as *props::CarouselProps) { return; }
    if { (*p).position } == { index as i64 } { return; }
    { (*p).position = { index as i64 } };
    // SETTLED, so it is no longer scrolling. `is_scrolling` is a prop an
    // application READS — written here and in `fire_scrolled`, and never
    // marked dirty: sending it back out through an apply would be the view
    // telling the model telling the view.
    { (*p).is_scrolling = false };
    carousel_threshold(n, p);
    let v: *u8 = core::view_of(n);
    let ph: fn(*u8, *u8) = { (*p).on_position_changed };
    if ph != props::no_handler { ph(v, { (*p).on_position_changed_ctx }); }
    let ih: fn(*u8, *u8) = { (*p).on_current_item_changed };
    if ih != props::no_handler { ih(v, { (*p).on_current_item_changed_ctx }); }
    return;
}

// ---- hybrid_web ----------------------------------------------------------------
//
// A WEB VIEW THAT SERVES A LOCAL APP AND TALKS TO IT. The kind is `web` plus
// three things: the page comes from the APK's assets rather than a URL, the
// page can post messages up, and the application can send them down.
//
// `file:///android_asset/` is Android's bundle folder — the same standing the
// icon font already has here — and it is why `hybrid_root` maps onto a path
// rather than a scheme handler: a page loaded from there resolves its own
// relative scripts and styles, which is the whole reason facet's contract names
// a ROOT and a FILE separately.

fn hybrid_props(n: *core::Node) -> *props::HybridWebProps {
    return props_of(n, props::K_HYBRID_WEB) as *props::HybridWebProps;
}

fn create_hybrid_web(n: *core::Node) -> *u8 {
    let v: *u8 = create_web(n);
    if v == (0 as *u8) { return v; }
    let env: rt::Env = e::env();
    let p: *props::HybridWebProps = hybrid_props(n);
    if p == (0 as *props::HybridWebProps) { return v; }
    // `on_web_view_initializing` is the application's one chance to touch the
    // view before a page can see it, and `on_web_view_initialized` says the
    // channel is up. Both are edges of CONSTRUCTION, which is why they are
    // here and not in an apply — facet_uikit reads them the same way.
    let a: fn(*u8, *u8) = { (*p).on_web_view_initializing };
    if a != props::no_handler { a(v, { (*p).on_web_view_initializing_ctx }); }
    // The page's channel up. Named `facet` on both backends, so a page written
    // for one posts on the other unchanged.
    // INJECTED UNDER A PRIVATE NAME, and that is not tidiness. An
    // `addJavascriptInterface` object is a Java object, and a page cannot add
    // properties to one — so injecting it as `window.facet` makes the page's own
    // `window.facet.receive = ...` fail silently, and the DOWN channel is dead
    // for the sake of the up one. The name a page uses is built in JavaScript
    // instead, by `install_channel`, over a plain object.
    let bridge: jni::jobject = dex::new_bridge(env, { #addr(n) as i64 }, { v as jni::jobject });
    if bridge != (0 as jni::jobject) {
        // The NAME is a C string here: a `_str`-shaped binding takes `*u8` and
        // makes the Java string itself. Handing it one already made runs
        // `NewStringUTF` over a Java object POINTER, and CheckJNI quotes the
        // pointer's own bytes back at you as invalid modified UTF-8. Three
        // calls in this file had it wrong; the binding's signature is the
        // authority, not the shape of the Java method it wraps.
        var wv: w::WebView = w::WebView::from_global(env, env.new_global_ref(v));
        wv.add_javascript_interface(bridge, #str_ptr("__facet_host\0"));
        let _k: *u8 = wv.into_raw();
        env.delete_local_ref(bridge);
    }
    // A LOCAL PAGE NEEDS FILE ACCESS, and a WebView does not grant it: without
    // this the asset URL loads and every relative <script> and <link> in it
    // fails, which looks like a page that renders unstyled and does nothing.
    let settings: jni::jobject = env.call_object_0(
        v, #str_ptr("android/webkit/WebView\0"), #str_ptr("getSettings\0"),
        #str_ptr("()Landroid/webkit/WebSettings;\0"));
    if settings != (0 as jni::jobject) {
        env.call_void_1(settings, #str_ptr("android/webkit/WebSettings\0"),
                        #str_ptr("setAllowFileAccess\0"), #str_ptr("(Z)V\0"),
                        rt::arg_bool(true));
        env.delete_local_ref(settings);
    }
    let b: fn(*u8, *u8) = { (*p).on_web_view_initialized };
    if b != props::no_handler { b(v, { (*p).on_web_view_initialized_ctx }); }
    return v;
}

// THE PAGE'S SIDE OF THE CHANNEL, defined in JavaScript over a plain object so
// the page can hang its own `receive` on the same name. Re-run on every finished
// load, because a new document starts with nothing.
//
// `postMessage` up and `receive` down are the names facet_uikit's page sees, so
// a page written against one backend runs on the other.
fn install_channel(v: *u8) {
    if v == (0 as *u8) { return; }
    if !e::have_env() { return; }
    let env: rt::Env = e::env();
    // A C STRING, NOT A jstring. The binding takes `*u8` and makes the Java
    // string itself — handing it one already made runs `NewStringUTF` over a
    // Java object POINTER, which CheckJNI reports as invalid modified UTF-8
    // with the pointer's own bytes quoted back at you.
    var wv: w::WebView = w::WebView::from_global(env, env.new_global_ref(v));
    wv.evaluate_javascript(#str_ptr(
        "window.facet = window.facet || {}; window.facet.postMessage = function (m) { __facet_host.postMessage(String(m)); };\0"),
        0 as jni::jobject);
    let _k: *u8 = wv.into_raw();
    return;
}

fn apply_hybrid_web(v: *u8, n: *core::Node, dirty: u64) {
    let p: *props::HybridWebProps = hybrid_props(n);
    if p == (0 as *props::HybridWebProps) { return; }
    let env: rt::Env = e::env();
    if (dirty & (hybrid_web::P_HYBRID_ROOT | hybrid_web::P_DEFAULT_FILE)) != (0 as u64) {
        // BUILT IN A BUFFER, and every view used INSIDE the statement that
        // reads it. `let s: str = { (*p).some_text.view() }` looks like the
        // obvious way to name a prop's text and it is a dangling one: the
        // braces read a Text VALUE out of the pointer, the view borrows that
        // temporary, and the temporary is dropped at the end of the statement —
        // taking the buffer with it. It comes back as a poisoned pointer inside
        // whatever reads the str next, which here was `NewStringUTF` quoting
        // 0xdead10ad at us. The rest of this file passes such views straight
        // into a call for exactly this reason.
        var buf: [u8; 1024] = #zero::[[u8; 1024]]();
        let base: *u8 = { #addr_of(buf[0]) };
        let _pre: bool = paint::cstr("file:///android_asset/", base, 1024 as usize);
        let root_at: usize = paint::cstr_len(base);
        append_cstr(base, 1024 as usize, { (*p).hybrid_root.view() });
        if paint::cstr_len(base) > root_at { append_cstr(base, 1024 as usize, "/"); }
        append_cstr(base, 1024 as usize, { (*p).default_file.view() });
        var wv: w::WebView = w::WebView::from_global(env, env.new_global_ref(v));
        wv.load_url_str(base);
        let _k: *u8 = wv.into_raw();
    }
    // THE APPLICATION CALLING INTO THE PAGE. The message is arbitrary text
    // spliced into source, so it is quoted first — an unescaped quote in a
    // message is an injection into the page's own script.
    if (dirty & hybrid_web::P_SEND_MESSAGE) != (0 as u64) {
        var mbuf: [u8; 1024] = #zero::[[u8; 1024]]();
        let mbase: *u8 = { #addr_of(mbuf[0]) };
        let _m: bool = paint::cstr({ (*p).outgoing_message.view() }, mbase, 1024 as usize);
        let m_len: usize = paint::cstr_len(mbase);
        if m_len > (0 as usize) {
            var js: [u8; 2048] = #zero::[[u8; 2048]]();
            let jbase: *u8 = { #addr_of(js[0]) };
            let _j: bool = paint::cstr(
                "window.facet && window.facet.receive && window.facet.receive(",
                jbase, 2048 as usize);
            var quoted: text::Text = js_quoted({ #str_from_raw_parts(mbase, m_len) });
            append_cstr(jbase, 2048 as usize, quoted.view());
            append_cstr(jbase, 2048 as usize, ")");
            var wv: w::WebView = w::WebView::from_global(env, env.new_global_ref(v));
            wv.evaluate_javascript(jbase, 0 as jni::jobject);
            let _k: *u8 = wv.into_raw();
        }
    }
    return;
}

// APPEND ONE str TO A C STRING already in `base`, at its NUL.
fn append_cstr(base: *u8, cap: usize, s: str) {
    let at: usize = paint::cstr_len(base);
    if at +% (1 as usize) >= cap { return; }
    let _ok: bool = paint::cstr(s, { base + at }, cap -% at);
    return;
}

// A JSON string literal. Quote, backslash and the control range are the only
// things that can end a literal early or leave it unparseable; everything else
// is passed through, including UTF-8, which JSON takes as-is.
fn js_quoted(s: str) -> text::Text {
    var out: text::Text = text::from_str("\"");
    var i: usize = 0 as usize;
    while i < s.count() {
        let b: u8 = match s.byte_at(i) {
            option::Option[u8]::Some(x) => x,
            option::Option[u8]::None => 0 as u8,
        };
        if b == (34 as u8) { out.append("\\\""); }
        else if b == (92 as u8) { out.append("\\\\"); }
        else if b == (10 as u8) { out.append("\\n"); }
        else if b == (13 as u8) { out.append("\\r"); }
        else if b == (9 as u8) { out.append("\\t"); }
        else if b < (32 as u8) { }
        else {
            match s.slice(i, i +% (1 as usize)) {
                option::Option[str]::Some(one) => { out.append(one); }
                option::Option[str]::None => { }
            }
        }
        i = i +% (1 as usize);
    }
    out.append("\"");
    return out;
}

// THE PAGE POSTED. facet's handler shape is (sender, ctx) and its props carry
// no field for an incoming message, so the BODY is what arrives as the sender —
// a NUL-terminated UTF-8 pointer, valid for the length of the call. facet_uikit
// hands over an NSString in the same slot for the same reason. See MANIFEST §2:
// the contract has no place to put this, and until it does the two backends
// deliver it as two different pointers.
fn fire_raw_message(token: i64, body: jni::jstring) {
    let n: *core::Node = { token as *core::Node };
    if n == (0 as *core::Node) { return; }
    let p: *props::HybridWebProps = hybrid_props(n);
    if p == (0 as *props::HybridWebProps) { return; }
    let h: fn(*u8, *u8) = { (*p).on_raw_message_received };
    if h == props::no_handler { return; }
    var buf: [u8; 2048] = #zero::[[u8; 2048]]();
    let base: *u8 = { #addr_of(buf[0]) };
    if !e::env().string_utf_into(body, base, 2048 as usize) { return; }
    h(base, { (*p).on_raw_message_received_ctx });
    return;
}

// THE PAGE ASKED FOR SOMETHING. A report, not an interception — the URL arrives
// in the sender slot for the same reason a message does.
fn fire_resource_requested(token: i64, url: jni::jstring) {
    let n: *core::Node = { token as *core::Node };
    if n == (0 as *core::Node) { return; }
    let p: *props::HybridWebProps = hybrid_props(n);
    if p == (0 as *props::HybridWebProps) { return; }
    let h: fn(*u8, *u8) = { (*p).on_web_resource_requested };
    if h == props::no_handler { return; }
    var buf: [u8; 1024] = #zero::[[u8; 1024]]();
    let base: *u8 = { #addr_of(buf[0]) };
    if !e::env().string_utf_into(url, base, 1024 as usize) { return; }
    h(base, { (*p).on_web_resource_requested_ctx });
    return;
}

// ---- rich text -------------------------------------------------------------------
//
// TWO VERBS, ONE MECHANISM. A label's `formatted_text` is a formatted STRING:
// each run carries its own text and writing it replaces the content. A text
// area's `style_runs` styles text that is ALREADY THERE and must not touch it —
// re-setting an editor's text moves the caret and breaks the undo stack. Both
// end up as spans on a SpannableStringBuilder; they differ only in where the
// string comes from and how a run's range is stated.

// HOW MANY UTF-16 UNITS the first `upto` bytes of `s` come to.
//
// facet counts offsets in BYTES, the way `str` does, and says so: "a backend
// that indexes in UTF-16 (AppKit) or code points converts on the way in, once,
// where it knows the encoding". Java is that kind of backend. A leading byte is
// one unit unless it starts a four-byte sequence, which is a surrogate PAIR;
// continuation bytes count for nothing.
fn utf16_len(s: str, upto: usize) -> i32 {
    var units: i32 = 0 as i32;
    var i: usize = 0 as usize;
    var n: usize = s.count();
    if upto < n { n = upto; }
    while i < n {
        let b: u8 = match s.byte_at(i) {
            option::Option[u8]::Some(x) => x,
            option::Option[u8]::None => 0 as u8,
        };
        if (b & (192 as u8)) != (128 as u8) {
            if b >= (240 as u8) { units = units +% (2 as i32); }
            else { units = units +% (1 as i32); }
        }
        i = i +% (1 as usize);
    }
    return units;
}

fn span_decoration(d: vocab::TextDecoration) -> i32 {
    return match d {
        vocab::TextDecoration::None => 0 as i32,
        vocab::TextDecoration::Strikethrough => 1 as i32,
        vocab::TextDecoration::Underline => 2 as i32,
    };
}

// A LABEL'S FORMATTED TEXT. The runs are concatenated into the string the view
// gets, and each run's range is where its own text landed in it.
fn apply_formatted_text(env: rt::Env, v: *u8, f: *vocab::Spans) {
    let count: usize = { (*f).count() };
    if count == (0 as usize) { return; }
    // THE WHOLE STRING FIRST, because a span cannot be set on text that is not
    // there yet. Built in one buffer, run by run.
    var whole: [u8; 4096] = #zero::[[u8; 4096]]();
    let base: *u8 = { #addr_of(whole[0]) };
    var i: usize = 0 as usize;
    while i < count {
        let r: *vocab::TextSpan = { (*f).at(i) };
        if r != (0 as *vocab::TextSpan) {
            append_cstr(base, 4096 as usize, { (*r).text.view() });
        }
        i = i +% (1 as usize);
    }
    dex::spans_begin(env, { v as jni::jobject }, base);
    var at: i32 = 0 as i32;
    var links: bool = false;
    i = 0 as usize;
    while i < count {
        let r: *vocab::TextSpan = { (*f).at(i) };
        if r == (0 as *vocab::TextSpan) { i = i +% (1 as usize); continue; }
        var tbuf: [u8; 1024] = #zero::[[u8; 1024]]();
        let tbase: *u8 = { #addr_of(tbuf[0]) };
        let _t: bool = paint::cstr({ (*r).text.view() }, tbase, 1024 as usize);
        let tlen: usize = paint::cstr_len(tbase);
        let units: i32 = utf16_len({ #str_from_raw_parts(tbase, tlen) }, tlen);
        var lbuf: [u8; 512] = #zero::[[u8; 512]]();
        let lbase: *u8 = { #addr_of(lbuf[0]) };
        let _l: bool = paint::cstr({ (*r).link.view() }, lbase, 512 as usize);
        let has_link: bool = paint::cstr_len(lbase) > (0 as usize);
        if has_link { links = true; }
        let fg: vocab::Color = { (*r).color };
        let bg: vocab::Color = { (*r).background_color };
        var size_px: i32 = 0 as i32;
        if { (*r).font_size } > 0.0f64 { size_px = { e::px({ (*r).font_size }) as i32 }; }
        dex::spans_add(env, { v as jni::jobject }, at, units,
                       paint::argb_of(fg), fg.is_set(),
                       paint::argb_of(bg), bg.is_set(),
                       is_bold_weight({ (*r).font_weight }), { (*r).is_italic },
                       span_decoration({ (*r).decoration }), size_px, lbase);
        at = at +% units;
        i = i +% (1 as usize);
    }
    dex::spans_commit(env, { v as jni::jobject }, links);
    return;
}

// A TEXT AREA'S STYLE RUNS, over the text the user has. The offsets arrive in
// BYTES and the view indexes in UTF-16, so each one is converted against the
// control's own text — which is why the text is read here rather than the runs
// being trusted to be ASCII.
fn apply_style_runs(env: rt::Env, v: *u8, runs: *vocab::StyleRuns, current: str) {
    dex::spans_begin_from_view(env, { v as jni::jobject });
    let count: usize = { (*runs).count() };
    var i: usize = 0 as usize;
    while i < count {
        let r: *vocab::StyleRun = { (*runs).at(i) };
        if r == (0 as *vocab::StyleRun) { i = i +% (1 as usize); continue; }
        let start_b: usize = { (*r).start };
        let len_b: usize = { (*r).length };
        let start16: i32 = utf16_len(current, start_b);
        let end16: i32 = utf16_len(current, start_b +% len_b);
        let fg: vocab::Color = { (*r).color };
        let bg: vocab::Color = { (*r).background_color };
        dex::spans_add(env, { v as jni::jobject }, start16, end16 -% start16,
                       paint::argb_of(fg), fg.is_set(),
                       paint::argb_of(bg), bg.is_set(),
                       is_bold_weight({ (*r).font_weight }), { (*r).is_italic },
                       span_decoration({ (*r).decoration }), 0 as i32, 0 as *u8);
        i = i +% (1 as usize);
    }
    // NO LINKS on an editor: a URLSpan in an EditText makes the text clickable
    // and the caret unreachable, and `StyleRun` carries no destination anyway.
    dex::spans_commit(env, { v as jni::jobject }, false);
    return;
}
