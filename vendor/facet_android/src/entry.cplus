// The entry point, and the reason an app needs no Java and no glue.
//
// `FacetActivity` ships in this package's dex (merged into the app's
// classes.dex at build time) and calls the native below. THIS package exports
// it, not the app: an app whose source is shared with iOS has no
// Android-shaped export to give, and that portability is the whole point.
//
// So the app's entry is found BY NAME, from manifest meta-data:
//
//     <meta-data android:name="cplus.facet.lib"  android:value="gallery" />
//     <meta-data android:name="cplus.facet.main" android:value="facet_gallery_ios_main" />
//
// which is `dlsym`'d out of the process and called once. A manifest is
// Android-specific configuration an app must write anyway; a differently-named
// entry function is Android-specific CODE, and that is the thing this avoids.
// The same shape `NativeActivity` uses for `android.app.lib_name`.
//
// The app's entry does what it does on every other platform — sets a theme,
// enables the agent, calls `runtime::run_component` — and the Android facade
// stores the tree instead of entering a loop. By the time the entry returns,
// `ROOT` is set and there is a View to hand back.

import "stdlib/box" as box;
import "stdlib/option" as option;
import "jni/jni" as jni;
import "android_view/runtime" as rt;
import "facet/facet" as core;
import "./facet_android" as backend;
import "./window" as window;
import "./env" as e;
import "./log" as log;

// THE ROOT HAS TO OUTLIVE THE CALL, and that is the structural difference from
// the other two platforms. macOS `run` enters its own loop and iOS
// `UIApplicationMain` takes the process; Android's onCreate calls in, takes a
// View back, and RETURNS. So the tree is boxed and leaked: it lives for the
// process, which is exactly as long as the Activity can be recreated against
// it.
static ROOT: usize = 0;

fn root() -> *core::Node { return { ROOT as *core::Node }; }
fn has_root() -> bool { return ROOT != 0; }

// The facade's door. `runtime_android::run_component` calls this with the tree
// it just built; nothing else should.
//
// FIRST WINS. A recreated Activity — a rotation, a theme flip — runs the app's
// entry again, and rebuilding would throw away every piece of state the person
// had put into the old tree. The old tree is still live and still correct, so
// the second tree is dropped on the floor.
fn set_root(take n: core::Node) {
    if ROOT != 0 { return; }
    var owned: core::Node = n;
    match box::new::[core::Node](owned) {
        option::Option[box::Box[core::Node]]::Some(bx) => { ROOT = { #addr(bx.into_raw()) }; }
        option::Option[box::Box[core::Node]]::None => { }
    }
    return;
}

// THE COMPONENT'S `on_attach`, which nothing else can fire.
//
// `component::Lifecycle` is the COMPONENT's hook, not a node's — the mount walk
// fires node lifecycle, and a component is not in the tree. On iOS the facade
// hands the backend a monomorphised trampoline and the launch hook calls it
// once the window exists; the same problem arrives here for the same reason,
// one step later: `run_component` returns BEFORE the tree is mounted, because
// mounting is what the Activity does with the View it is about to be handed.
//
// So the facade leaves a trampoline and this calls it after `attach_root`. Do
// it earlier and a component asking `mount::find` in `on_attach` gets None and
// comes up with its shell and no content — which is exactly what facet_uikit
// records measuring in the simulator.
static ATTACH_FN: usize = 0;
static ATTACH_CTX: usize = 0;
static ATTACHED: bool = false;

fn on_attached(f: fn(*u8), ctx: *u8) {
    ATTACH_FN = { f as usize };
    ATTACH_CTX = { #addr(ctx) };
    return;
}

fn fire_attached() {
    if ATTACH_FN == 0 { return; }
    // ONCE. A recreated Activity re-attaches the same tree; the component has
    // been attached for the life of the process and telling it again would run
    // an app's setup twice.
    if ATTACHED { return; }
    ATTACHED = true;
    let f: fn(*u8) = { ATTACH_FN as fn(*u8) };
    f({ ATTACH_CTX as *u8 });
    return;
}

// `System.loadLibrary` has already run by the time this is called — it is what
// found this symbol — so the app's entry is in the process and reachable by
// name. RTLD_DEFAULT is a null handle on LP64 bionic, which is what searches
// everything already loaded.
#[link_name = "dlsym"]
extern fn dlsym(handle: *u8, symbol: *u8) -> *u8;

static ENTERED: bool = false;

export extern fn Java_cplus_facet_FacetActivity_nativeCreateView(
    envp: *jni::JNIEnv,
    cls: jni::jobject,
    activity: jni::jobject,
) -> jni::jobject {
    let env: rt::Env = rt::from_native(envp);
    e::set_env(env);
    backend::install();

    // ONCE PER PROCESS. The Activity is recreated on rotation with the same
    // library loaded and the same statics live; running the app's entry again
    // would build a second tree, re-enable the agent and re-bind a port.
    if !ENTERED {
        ENTERED = true;
        call_app_entry(env, activity);
    }
    if ROOT == 0 {
        log::warn(#str_ptr("entry: the app built no tree - is cplus.facet.main named in AndroidManifest.xml?\0"));
        return 0 as jni::jobject;
    }
    let host: jni::jobject = window::attach_root(env, activity, root());
    // AFTER the mount, which `attach_root` is.
    fire_attached();
    return host;
}

fn call_app_entry(env: rt::Env, activity: jni::jobject) {
    var buf: [u8; 256] = #zero::[[u8; 256]]();
    let name: *u8 = { #addr_of(buf[0]) };
    if !meta_string(env, activity, #str_ptr("cplus.facet.main\0"), name, 256 as usize) {
        log::warn(#str_ptr("entry: no cplus.facet.main meta-data in AndroidManifest.xml\0"));
        return;
    }
    let sym: *u8 = { dlsym(0 as *u8, name) };
    if sym == (0 as *u8) {
        log::warn(#str_ptr("entry: cplus.facet.main names a symbol this library does not export\0"));
        return;
    }
    // The app's entry has the same shape on every platform: `-> i32`, and the
    // value is the process exit code nobody reads here.
    let entry: fn() -> i32 = { sym as fn() -> i32 };
    let _code: i32 = entry();
    return;
}

// One `<meta-data>` string off the Activity. Verbose because there is no NDK
// door to the manifest: it is PackageManager, ActivityInfo and a Bundle, three
// JNI hops.
fn meta_string(env: rt::Env, activity: jni::jobject, key: *u8, out: *u8, cap: usize) -> bool {
    { (*out) = 0 as u8 };
    let pm: jni::jobject = env.call_object_0(
        activity, #str_ptr("android/content/Context\0"), #str_ptr("getPackageManager\0"),
        #str_ptr("()Landroid/content/pm/PackageManager;\0"));
    if pm == (0 as jni::jobject) { return false; }
    let cn: jni::jobject = env.call_object_0(
        activity, #str_ptr("android/app/Activity\0"), #str_ptr("getComponentName\0"),
        #str_ptr("()Landroid/content/ComponentName;\0"));
    if cn == (0 as jni::jobject) { env.delete_local_ref(pm); return false; }
    // GET_META_DATA = 128.
    let cls_pm: jni::jclass = env.class_cached(#str_ptr("android/content/pm/PackageManager\0"));
    let mid: jni::jmethodID = env.method_id(cls_pm, #str_ptr("getActivityInfo\0"),
        #str_ptr("(Landroid/content/ComponentName;I)Landroid/content/pm/ActivityInfo;\0"));
    var args: [jni::JValue; 2] = [jni::arg_object(cn), jni::arg_int(128 as i32)];
    let info: jni::jobject = {
        (*(*env.raw())).CallObjectMethodA(env.raw(), pm, mid, #addr_of(args[0]))
    };
    env.delete_local_ref(cn);
    env.delete_local_ref(pm);
    if info == (0 as jni::jobject) { env.clear_exception(); return false; }

    let cls_info: jni::jclass = env.class_cached(#str_ptr("android/content/pm/ActivityInfo\0"));
    let fid: jni::jfieldID = env.field_id(cls_info, #str_ptr("metaData\0"),
                                          #str_ptr("Landroid/os/Bundle;\0"));
    let bundle: jni::jobject = {
        (*(*env.raw())).GetObjectField(env.raw(), info, fid)
    };
    env.delete_local_ref(info);
    if bundle == (0 as jni::jobject) { return false; }

    let jkey: jni::jstring = env.new_string_utf(key);
    let value: jni::jobject = env.call_object_1(
        bundle, #str_ptr("android/os/Bundle\0"), #str_ptr("getString\0"),
        #str_ptr("(Ljava/lang/String;)Ljava/lang/String;\0"), jni::arg_object(jkey));
    env.delete_local_ref(jkey);
    env.delete_local_ref(bundle);
    if value == (0 as jni::jobject) { return false; }
    let ok: bool = env.string_utf_into(value, out, cap);
    env.delete_local_ref(value);
    if !ok { return false; }
    return { (*out) } != (0 as u8);
}
