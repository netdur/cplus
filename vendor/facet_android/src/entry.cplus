// The zero-Java entry point.
//
// An app that names `cplus.facet.FacetActivity` in its manifest writes NO JAVA
// AT ALL: the Activity ships in this package's dex, merged into the app's
// classes.dex at build time, and calls back through the one native below.
//
// What an app still writes is the export itself:
//
//     export extern fn Java_cplus_facet_FacetActivity_nativeCreateView(
//         envp: *jni::JNIEnv, cls: jni::jobject, activity: jni::jobject,
//     ) -> jni::jobject {
//         return entry::start(envp, activity, build);
//     }
//
// It lives in the APP rather than here on purpose. Exporting it from this
// package would make the symbol part of every consumer's link whether or not
// that consumer is an Activity — cpc emits one object per package, so a package
// that names a symbol obligates everything that links it. Five lines of C+ in
// the app is the cheaper half of that trade.

import "stdlib/box" as box;
import "stdlib/option" as option;
import "jni/jni" as jni;
import "android_view/runtime" as rt;
import "facet/facet" as core;
import "./facet_android" as backend;
import "./window" as window;

// THE ROOT HAS TO OUTLIVE THE CALL, and that is the structural difference from
// the other two platforms. macOS `run` and iOS `run_component` both keep the
// tree on the stack of a function that never returns; Android's onCreate calls
// in, takes a View back, and RETURNS. So the tree is boxed and leaked: it lives
// for the process, which is exactly as long as the Activity can be recreated
// against it.
//
// Kept HERE rather than in every app, because every app needs it and getting it
// wrong looks like a rotation bug rather than a lifetime one.
static ROOT: usize = 0;

fn root() -> *core::Node { return { ROOT as *core::Node }; }
fn built() -> bool { return ROOT != 0; }

// `build` is called ONCE per process. A recreated Activity — a rotation, a
// theme flip — re-attaches the SAME tree rather than rebuilding it, which is
// what makes state survive without an app writing a single line about it.
fn start(envp: *jni::JNIEnv, activity: jni::jobject, build: fn() -> core::Node) -> jni::jobject {
    let env: rt::Env = rt::from_native(envp);
    backend::install();
    if ROOT == 0 {
        var n: core::Node = build();
        // `box::new` answers None on allocation failure rather than trapping.
        // Nothing sensible follows a failed root, so the entry point hands back
        // null and the Activity shows an empty screen — a visible failure
        // rather than a half-built tree.
        match box::new::[core::Node](n) {
            option::Option[box::Box[core::Node]]::Some(bx) => { ROOT = { #addr(bx.into_raw()) }; }
            option::Option[box::Box[core::Node]]::None => { return 0 as jni::jobject; }
        }
    }
    return window::attach_root(env, activity, root());
}
