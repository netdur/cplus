// The process's JNI handle, the Activity, and the root host.
//
// A `JNIEnv*` is THREAD-LOCAL, not global — and that is exactly why caching one
// is safe here and would not be anywhere else. facet asserts every tree write
// happens on the thread that installed the backend (mount.cplus M6), and this
// backend is installed from the Activity's `onCreate`, so the one env cached
// below is the UI thread's and no other thread ever reads it.
//
// If a worker thread ever needs to touch the tree, it must NOT use this: it has
// to `AttachCurrentThread` for its own env. facet's rule is that it should hop
// to the main thread instead (`services::run_on_main`), which is what the
// scheduler provides.

import "jni/jni" as jni;
import "android_view/runtime" as rt;

static ENV: usize = 0;
static ACTIVITY: usize = 0;    // global ref
static HOST: usize = 0;        // global ref to the root FacetHost

fn set_env(e: rt::Env) { ENV = { #addr(e.raw()) }; return; }
fn env() -> rt::Env { return rt::from_native({ ENV as *jni::JNIEnv }); }
fn have_env() -> bool { return ENV != 0; }

fn set_activity(a: jni::jobject) { ACTIVITY = { #addr(a) }; return; }
fn activity() -> jni::jobject { return { ACTIVITY as *u8 }; }

fn set_host(h: jni::jobject) { HOST = { #addr(h) }; return; }
fn host() -> jni::jobject { return { HOST as *u8 }; }
fn have_host() -> bool { return HOST != 0; }

// The Context every widget constructor wants. The Activity IS one.
fn context() -> jni::jobject { return activity(); }
