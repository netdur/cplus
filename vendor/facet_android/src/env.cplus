// The process's JNI handle, the Activity, and the root host.
//
// A `JNIEnv*` is THREAD-LOCAL, not global — and that is exactly why caching one
// is safe here and would not be anywhere else. facet asserts every tree write
// happens on the thread that installed the backend (mount.cplus M6), and this
// backend is installed from the Activity's `onCreate`, so the one env cached
// below is the UI thread's and no other thread ever reads it.
//
// If a worker thread ever needs to touch the tree, it must NOT use this: it has
// to `AttachCurrentThread` for its own env. facet's rule is that it should hop
// to the main thread instead (`services::run_on_main`), which is what the
// scheduler provides.

import "jni/jni" as jni;
import "android_view/runtime" as rt;

static ENV: usize = 0;
static ACTIVITY: usize = 0;    // global ref
static HOST: usize = 0;        // global ref to the root FacetHost

fn set_env(e: rt::Env) { ENV = { #addr(e.raw()) }; return; }
fn env() -> rt::Env { return rt::from_native({ ENV as *jni::JNIEnv }); }
fn have_env() -> bool { return ENV != 0; }

fn set_activity(a: jni::jobject) { ACTIVITY = { #addr(a) }; return; }
fn activity() -> jni::jobject { return { ACTIVITY as *u8 }; }

fn set_host(h: jni::jobject) { HOST = { #addr(h) }; return; }
fn host() -> jni::jobject { return { HOST as *u8 }; }
fn have_host() -> bool { return HOST != 0; }

// The Context every widget constructor wants. The Activity IS one.
fn context() -> jni::jobject { return activity(); }

// ---- the screen's density -------------------------------------------------------
//
// `DisplayMetrics.density` — the platform's own number, asked for rather than
// re-derived, which is rung 0's lesson about MeasureSpec.
//
// CACHED, and it has to be: `geometry::px` crosses the density boundary for
// every frame in every layout pass, and this is three JNI calls. Reading it per
// conversion would put a PackageManager round trip inside the frame loop.
//
// It lives HERE rather than in `window` because `geometry` needs it and
// window -> scheduler -> geometry is already a chain; `env` is below all three.
static DENSITY: f64 = 0.0f64;

fn density() -> f64 {
    if DENSITY > 0.0f64 { return DENSITY; }
    DENSITY = read_density();
    return DENSITY;
}

// ---- the density boundary ------------------------------------------------------
//
// FACET'S UNITS ARE DENSITY-INDEPENDENT and Android's View geometry is in
// PHYSICAL PIXELS. Every other backend gets this free — a point is a point on
// AppKit and UIKit, and GTK scales the surface — so these two functions are the
// only crossing, and everything above them is in facet's units.
//
// They live beside `density` rather than in `geometry` because `paint` needs
// them too, and paint -> geometry -> paint is a cycle.
fn px(v: f64) -> f64 { return v * density(); }
fn dp(v: f64) -> f64 { return v / density(); }

// A configuration change can move it (a foldable, a display switch), so the
// cache is dropped rather than trusted forever.
fn forget_density() { DENSITY = 0.0f64; return; }

fn read_density() -> f64 {
    if !have_env() { return 1.0f64; }
    let e: rt::Env = env();
    let res: jni::jobject = e.call_object_0(
        activity(), #str_ptr("android/content/Context\0"), #str_ptr("getResources\0"),
        #str_ptr("()Landroid/content/res/Resources;\0"));
    if res == (0 as jni::jobject) { return 1.0f64; }
    let dm: jni::jobject = e.call_object_0(
        res, #str_ptr("android/content/res/Resources\0"), #str_ptr("getDisplayMetrics\0"),
        #str_ptr("()Landroid/util/DisplayMetrics;\0"));
    e.delete_local_ref(res);
    if dm == (0 as jni::jobject) { return 1.0f64; }
    let cls: jni::jclass = e.class_cached(#str_ptr("android/util/DisplayMetrics\0"));
    let fid: jni::jfieldID = e.field_id(cls, #str_ptr("density\0"), #str_ptr("F\0"));
    let d: f32 = { (*(*e.raw())).GetFloatField(e.raw(), dm, fid) };
    e.delete_local_ref(dm);
    if d <= 0.0f32 { return 1.0f64; }
    return { d as f64 };
}
