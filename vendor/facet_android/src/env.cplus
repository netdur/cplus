// The process's JNI handle, the Activity, and the root host.
//
// A `JNIEnv*` is THREAD-LOCAL, not global — and that is exactly why caching one
// is safe here and would not be anywhere else. facet asserts every tree write
// happens on the thread that installed the backend (mount.cplus M6), and this
// backend is installed from the Activity's `onCreate`, so the one env cached
// below is the UI thread's and no other thread ever reads it.
//
// If a worker thread ever needs to touch the tree, it must NOT use this: it has
// to `AttachCurrentThread` for its own env. facet's rule is that it should hop
// to the main thread instead (`services::run_on_main`), which is what the
// scheduler provides.

import "jni/jni" as jni;
import "android_view/runtime" as rt;
import "facet/app_events" as ev;

static ENV: usize = 0;
static ACTIVITY: usize = 0;    // global ref
static HOST: usize = 0;        // global ref to the root FacetHost

// WHICH THREAD THIS IS. A JNIEnv belongs to ONE thread — using another's is
// undefined, and CheckJNI calls it an error — and facet's tree is the UI
// thread's besides (mount.cplus M6 asserts it on every write).
//
// `ENV` is a process-wide static holding the UI thread's env, which is right for
// everything the backend does: every call into it arrives from a JVM callback on
// that thread. It is NOT right for the agent surface, which answers on a socket
// worker, so the thread is recorded here and anything that could be called from
// elsewhere asks first.
static UI_TID: i32 = 0;

#[link_name = "gettid"]
extern fn gettid() -> i32;

fn set_env(e: rt::Env) {
    ENV = { #addr(e.raw()) };
    if UI_TID == (0 as i32) { UI_TID = { gettid() }; }
    return;
}

fn on_ui_thread() -> bool {
    if UI_TID == (0 as i32) { return false; }
    return { gettid() } == UI_TID;
}
fn env() -> rt::Env { return rt::from_native({ ENV as *jni::JNIEnv }); }
fn have_env() -> bool { return ENV != 0; }

// THE ACTIVITY, and the one slot every package that is not this backend reads
// it from.
//
// `app_events::set_host` is published alongside because `requestPermissions`
// and `shouldShowRequestPermissionRationale` are Activity methods, and a
// services package must not depend on a UI backend to reach them. Published
// HERE rather than from `install` because this is the call that runs again on
// every Activity recreation — a rotation replaces the global ref, and a package
// holding the old one holds a dead jobject.
fn set_activity(a: jni::jobject) {
    ACTIVITY = { #addr(a) };
    // AND THE DENSITY, for the same reason the global ref is replaced. This runs
    // on every Activity recreation, and a fold is one — the manifest's
    // configChanges covers orientation|screenSize|keyboardHidden and NOT
    // screenLayout — so the inner and outer screens of a foldable arrive here as
    // two Activities in ONE process. Native statics do not reload with the
    // Activity, so without this the second screen lays out at the first's
    // density.
    forget_density();
    ev::set_host(a);
    return;
}
fn activity() -> jni::jobject { return { ACTIVITY as *u8 }; }

fn set_host(h: jni::jobject) { HOST = { #addr(h) }; return; }
fn host() -> jni::jobject { return { HOST as *u8 }; }
fn have_host() -> bool { return HOST != 0; }

// The Context every widget constructor wants. The Activity IS one.
fn context() -> jni::jobject { return activity(); }

// ---- the screen's density -------------------------------------------------------
//
// `DisplayMetrics.density` — the platform's own number, asked for rather than
// re-derived, which is rung 0's lesson about MeasureSpec.
//
// CACHED, and it has to be: `geometry::px` crosses the density boundary for
// every frame in every layout pass, and this is three JNI calls. Reading it per
// conversion would put a PackageManager round trip inside the frame loop.
//
// It lives HERE rather than in `window` because `geometry` needs it and
// window -> scheduler -> geometry is already a chain; `env` is below all three.
static DENSITY: f64 = 0.0f64;

// A FAILED READ IS NOT CACHED, and the difference is the whole app.
//
// `read_density` answers 0 when it could not ask — no env yet, a null Resources
// — and the fallback of 1.0 is applied HERE, for that call only. Caching the
// fallback instead was a one-way door: `density()` caches anything above zero,
// so a single call before the Activity was attached pinned the process at 1.0
// for its whole life and every dimension in the app came out at a third of its
// size on a 3x phone, with nothing in any log to say why.
fn density() -> f64 {
    if DENSITY > 0.0f64 { return DENSITY; }
    let d: f64 = read_density();
    if d <= 0.0f64 { return 1.0f64; }
    DENSITY = d;
    return DENSITY;
}

// ---- the density boundary ------------------------------------------------------
//
// FACET'S UNITS ARE DENSITY-INDEPENDENT and Android's View geometry is in
// PHYSICAL PIXELS. Every other backend gets this free — a point is a point on
// AppKit and UIKit, and GTK scales the surface — so these two functions are the
// only crossing, and everything above them is in facet's units.
//
// They live beside `density` rather than in `geometry` because `paint` needs
// them too, and paint -> geometry -> paint is a cycle.
fn px(v: f64) -> f64 { return v * density(); }
fn dp(v: f64) -> f64 { return v / density(); }

// A configuration change can move it (a foldable, a display switch), so the
// cache is dropped rather than trusted forever. Called from `set_activity` —
// which runs again on every Activity recreation, and a fold IS one — and from
// `window::size_changed`, which covers the folds an app has told the system it
// handles itself. Nothing called it for a long time, and a stale density
// survives an Activity recreation because the .so does not reload with it.
fn forget_density() { DENSITY = 0.0f64; return; }

// 0 MEANS "COULD NOT ASK", not "1x". See `density` for why the distinction is
// load-bearing: this function's answer is cached forever if it is positive.
fn read_density() -> f64 {
    if !have_env() { return 0.0f64; }
    let e: rt::Env = env();
    let res: jni::jobject = e.call_object_0(
        activity(), #str_ptr("android/content/Context\0"), #str_ptr("getResources\0"),
        #str_ptr("()Landroid/content/res/Resources;\0"));
    if res == (0 as jni::jobject) { return 0.0f64; }
    let dm: jni::jobject = e.call_object_0(
        res, #str_ptr("android/content/res/Resources\0"), #str_ptr("getDisplayMetrics\0"),
        #str_ptr("()Landroid/util/DisplayMetrics;\0"));
    e.delete_local_ref(res);
    if dm == (0 as jni::jobject) { return 0.0f64; }
    let cls: jni::jclass = e.class_cached(#str_ptr("android/util/DisplayMetrics\0"));
    let fid: jni::jfieldID = e.field_id(cls, #str_ptr("density\0"), #str_ptr("F\0"));
    let d: f32 = { (*(*e.raw())).GetFloatField(e.raw(), dm, fid) };
    e.delete_local_ref(dm);
    if d <= 0.0f32 { return 0.0f64; }
    return { d as f64 };
}

// The appearance, cached like the density and for the same reason: a colour
// resolves per paint, and the read behind it is three JNI calls. Dropped on a
// configuration change, which is when it can move.
static IS_DARK: i32 = 0;      // 0 = unknown, 1 = light, 2 = dark

fn is_dark_cached() -> bool {
    if IS_DARK != (0 as i32) { return IS_DARK == (2 as i32); }
    return false;
}

fn set_is_dark(v: bool) {
    if v { IS_DARK = 2 as i32; } else { IS_DARK = 1 as i32; }
    return;
}

fn forget_is_dark() { IS_DARK = 0 as i32; return; }

// THE WINDOW'S INSETS, CACHED. Reading them is a JNI round trip and the layout
// pass wants them every time it runs; they change only when the window does —
// a rotation, a split-screen resize, the IME opening — or when a node changes
// its own `safe_area` answer. `-1` means "not read yet", which is why this is
// signed: zero is a legitimate inset on a device with no bars in the way.
static INSETS: i64 = 0 as i64 - (1 as i64);

fn insets_cache() -> i64 { return INSETS; }
fn set_insets_cache(v: i64) { INSETS = v; return; }
fn invalidate_insets() { INSETS = 0 as i64 - (1 as i64); return; }
