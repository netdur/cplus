// camera_backend_windows — a real capture device, through Media Foundation.
//
// THIS FILE EXISTS SO A WINDOWS BUILD LINKS. `camera.cplus` declares
// twenty-four stable symbols and something must define them on every platform
// the package claims; without a `_windows` sibling the build falls back to
// `camera_backend.cplus`, the AVFoundation half, and stops at
// `import "objc/runtime"`.
//
// WHAT IS REAL HERE: enumerating capture devices, opening one, reporting the
// format it settled on, and streaming frames. What is not is written down at
// the bottom, verb by verb, with the reason each one refuses rather than
// pretending.
//
// ---- COM BY VTABLE INDEX, and why that is not as fragile as it looks --------
//
// C+ has no COM. An interface pointer is a pointer to a vtable pointer, so a
// method is `(*(*obj))[i]` called with `obj` as the first argument — which is
// exactly what `call_*` below do. `webview2.cplus` in facet_win32 established
// the shape; this is the same idea against a different set of interfaces.
//
// EVERY INDEX BELOW WAS MEASURED, not counted off a header. A C# harness made
// the identical calls against this machine's camera before a line of this file
// existed, and the numbers here are the ones that answered S_OK. That matters
// because a wrong index is not a compile error and not a crash — it is a call
// into a DIFFERENT method with the same arity, which is the worst failure this
// file could have.
//
// The awkward ones are the derived interfaces. `IMFActivate` extends
// `IMFAttributes`, which is thirty methods, so `ActivateObject` is at 3 + 30 =
// 33 rather than at 3. `IMFSample` extends `IMFAttributes` the same way, which
// puts `ConvertToContiguousBuffer` at 41.
//
// ---- THE FRAME PUMP IS A THREAD ---------------------------------------------
//
// `IMFSourceReader::ReadSample` blocks until a frame is ready. A UI cannot call
// it, so `_c_on_frame` starts a thread that reads in a loop and calls the
// handler from there — and the handler therefore runs OFF the UI thread, which
// is the same contract the AppKit half has (AVFoundation delivers on its own
// queue). A caller that touches the UI hops itself, exactly as it must there.
//
// The loop owns the reader for its lifetime and stops on a flag. Nothing is
// freed under it: `_c_close` sets the flag, waits for the thread to notice, and
// only then releases the COM objects.

import "stdlib/text" as text;
import "stdlib/option" as option;
import "./camera" as camera;

// The request as the facade packs it. Layout must match `_CRequest`,
// which is module-private there — so it is mirrored rather than imported, and
// the pointer type in the seam signature matches by construction.
#[repr(C)]
struct _CRequest {
    opaque device: *u8,
    device_len: usize,
    facing: i32,
    width: i32,
    height: i32,
    frame_rate: i32,
    pixel: i32,
    color: i32,
    hdr: i32,
    stabilization: i32,
    depth: i32,
    high_speed: i32,
    buffers: i32,
}

extern fn malloc(n: usize) -> *u8;
extern fn free(p: *u8);
extern fn memset(p: *u8, v: i32, n: usize) -> *u8;
extern fn memcpy(dst: *u8, src: *u8, n: usize) -> *u8;

// ---- Media Foundation IS LOADED AT RUNTIME, not linked -------------------------
//
// `mfplat.dll`, `mf.dll` and `mfreadwrite.dll` ship with every ordinary Windows
// — and NOT with the N editions or with Server Core, where the Media Feature
// Pack is a separate install. A link-time dependency on a DLL that might be
// absent makes the whole program REFUSE TO START, which for a package whose
// contract already includes "there is no camera here" would be a catastrophic
// way to say it: an application that merely IMPORTS camera would die on a
// machine that simply has no lens.
//
// So the entry points are bound with `LoadLibrary` and a machine without them
// answers `count() == 0` and keeps running. It also keeps every other C+
// program off the hook — nothing is added to `cpc`'s Windows link line for a
// package most programs never touch, which is the same call `haptics` makes for
// XInput and for the same reason.
extern fn LoadLibraryA(name: *u8) -> *u8;
extern fn GetProcAddress(module: *u8, name: *u8) -> *u8;

static MF_STARTUP: fn(u32, u32) -> i32 = #zero::[fn(u32, u32) -> i32]();
static MF_CREATE_ATTRS: fn(**u8, u32) -> i32 = #zero::[fn(**u8, u32) -> i32]();
static MF_ENUM: fn(*u8, ***u8, *u32) -> i32 = #zero::[fn(*u8, ***u8, *u32) -> i32]();
static MF_READER: fn(*u8, *u8, **u8) -> i32 = #zero::[fn(*u8, *u8, **u8) -> i32]();
static CO_FREE: fn(*u8) = #zero::[fn(*u8)]();
static MF_BOUND: bool = false;
static MF_OK: bool = false;

fn bind_mf() -> bool {
    if MF_BOUND { return MF_OK; }
    MF_BOUND = true;
    let plat: *u8 = { LoadLibraryA({ #str_ptr("mfplat.dll\0") }) };
    let mf: *u8 = { LoadLibraryA({ #str_ptr("mf.dll\0") }) };
    let rw: *u8 = { LoadLibraryA({ #str_ptr("mfreadwrite.dll\0") }) };
    let ole: *u8 = { LoadLibraryA({ #str_ptr("ole32.dll\0") }) };
    if plat == (0 as *u8) || mf == (0 as *u8) || rw == (0 as *u8) || ole == (0 as *u8) {
        return false;
    }
    let a: *u8 = { GetProcAddress(plat, { #str_ptr("MFStartup\0") }) };
    let b: *u8 = { GetProcAddress(plat, { #str_ptr("MFCreateAttributes\0") }) };
    let c: *u8 = { GetProcAddress(mf, { #str_ptr("MFEnumDeviceSources\0") }) };
    let d: *u8 = { GetProcAddress(rw, { #str_ptr("MFCreateSourceReaderFromMediaSource\0") }) };
    let e: *u8 = { GetProcAddress(ole, { #str_ptr("CoTaskMemFree\0") }) };
    if a == (0 as *u8) || b == (0 as *u8) || c == (0 as *u8)
        || d == (0 as *u8) || e == (0 as *u8) { return false; }
    MF_STARTUP = { a as fn(u32, u32) -> i32 };
    MF_CREATE_ATTRS = { b as fn(**u8, u32) -> i32 };
    MF_ENUM = { c as fn(*u8, ***u8, *u32) -> i32 };
    MF_READER = { d as fn(*u8, *u8, **u8) -> i32 };
    CO_FREE = { e as fn(*u8) };
    MF_OK = true;
    return true;
}

fn MFStartup(version: u32, flags: u32) -> i32 {
    let f: fn(u32, u32) -> i32 = MF_STARTUP;
    return { f(version, flags) };
}
fn MFCreateAttributes(out: **u8, initial: u32) -> i32 {
    let f: fn(**u8, u32) -> i32 = MF_CREATE_ATTRS;
    return { f(out, initial) };
}
fn MFEnumDeviceSources(attrs: *u8, devices: ***u8, count: *u32) -> i32 {
    let f: fn(*u8, ***u8, *u32) -> i32 = MF_ENUM;
    return { f(attrs, devices, count) };
}
fn MFCreateSourceReaderFromMediaSource(src: *u8, attrs: *u8, reader: **u8) -> i32 {
    let f: fn(*u8, *u8, **u8) -> i32 = MF_READER;
    return { f(src, attrs, reader) };
}
fn CoTaskMemFree(p: *u8) {
    let f: fn(*u8) = CO_FREE;
    if f.is_not_null() { { f(p) }; }
    return;
}

#[link_name = "WideCharToMultiByte"]
extern fn WideCharToMultiByte(cp: u32, flags: u32, wide: *u8, wlen: i32,
                              mb: *u8, mblen: i32, def: *u8, used: *u8) -> i32;
#[link_name = "CreateThread"]
extern fn CreateThread(attrs: *u8, stack: usize, start: fn(*u8) -> *u8,
                       arg: *u8, flags: u32, tid: *u32) -> *u8;
#[link_name = "CloseHandle"]
extern fn CloseHandle(h: *u8) -> i32;
#[link_name = "Sleep"]
extern fn Sleep(ms: u32);

// ---- calling a COM method by vtable index --------------------------------------

fn slot(obj: *u8, idx: usize) -> *u8 {
    let vtbl: *u8 = { *(obj as **u8) };
    return { *((vtbl + (idx *% (8 as usize))) as **u8) };
}

fn call_release(obj: *u8) -> u32 {
    if obj == (0 as *u8) { return 0 as u32; }
    let f: fn(*u8) -> u32 = { slot(obj, 2 as usize) as fn(*u8) -> u32 };
    return { f(obj) };
}

fn call_gg(obj: *u8, idx: usize, a: *u8, b: *u8) -> i32 {
    let f: fn(*u8, *u8, *u8) -> i32 = { slot(obj, idx) as fn(*u8, *u8, *u8) -> i32 };
    return { f(obj, a, b) };
}

fn call_ggg(obj: *u8, idx: usize, a: *u8, b: *u8, c: *u8) -> i32 {
    let f: fn(*u8, *u8, *u8, *u8) -> i32 = { slot(obj, idx) as fn(*u8, *u8, *u8, *u8) -> i32 };
    return { f(obj, a, b, c) };
}

fn call_u_p(obj: *u8, idx: usize, a: u32, b: *u8) -> i32 {
    let f: fn(*u8, u32, *u8) -> i32 = { slot(obj, idx) as fn(*u8, u32, *u8) -> i32 };
    return { f(obj, a, b) };
}

fn call_u_i(obj: *u8, idx: usize, a: u32, b: i32) -> i32 {
    let f: fn(*u8, u32, i32) -> i32 = { slot(obj, idx) as fn(*u8, u32, i32) -> i32 };
    return { f(obj, a, b) };
}

fn call_p(obj: *u8, idx: usize, a: *u8) -> i32 {
    let f: fn(*u8, *u8) -> i32 = { slot(obj, idx) as fn(*u8, *u8) -> i32 };
    return { f(obj, a) };
}

fn call_0(obj: *u8, idx: usize) -> i32 {
    let f: fn(*u8) -> i32 = { slot(obj, idx) as fn(*u8) -> i32 };
    return { f(obj) };
}

fn call_read_sample(obj: *u8, stream: u32, flags: u32,
                    a: *u8, b: *u8, c: *u8, d: *u8) -> i32 {
    let f: fn(*u8, u32, u32, *u8, *u8, *u8, *u8) -> i32 =
        { slot(obj, 9 as usize) as fn(*u8, u32, u32, *u8, *u8, *u8, *u8) -> i32 };
    return { f(obj, stream, flags, a, b, c, d) };
}

fn call_lock(obj: *u8, p: *u8, max: *u8, cur: *u8) -> i32 {
    let f: fn(*u8, *u8, *u8, *u8) -> i32 =
        { slot(obj, 3 as usize) as fn(*u8, *u8, *u8, *u8) -> i32 };
    return { f(obj, p, max, cur) };
}

// ---- the vtable indices, all measured ------------------------------------------
//
// IMFAttributes: GetUINT64 8, GetGUID 10, GetAllocatedString 13, SetGUID 24.
// IMFActivate = IUnknown(3) + IMFAttributes(30), so ActivateObject is 33.
// IMFSourceReader: SetStreamSelection 4, GetCurrentMediaType 6, ReadSample 9.
// IMFSample = IUnknown(3) + IMFAttributes(30), so ConvertToContiguousBuffer 41.
// IMFMediaBuffer: Lock 3, Unlock 4.
fn idx_get_u64() -> usize { return 8 as usize; }
fn idx_get_guid() -> usize { return 10 as usize; }
fn idx_get_alloc_string() -> usize { return 13 as usize; }
fn idx_set_guid() -> usize { return 24 as usize; }
fn idx_activate_object() -> usize { return 33 as usize; }
fn idx_set_stream_selection() -> usize { return 4 as usize; }
fn idx_get_current_media_type() -> usize { return 6 as usize; }
fn idx_to_contiguous() -> usize { return 41 as usize; }
fn idx_unlock() -> usize { return 4 as usize; }

// MF_VERSION for Windows 7 and later, and MFSTARTUP_LITE.
fn mf_version() -> u32 { return 0x00020070 as u32; }
fn mf_startup_lite() -> u32 { return 1 as u32; }
fn first_video_stream() -> u32 { return 0xFFFFFFFC as u32; }
fn cp_utf8() -> u32 { return 65001 as u32; }

// ---- the GUIDs, as bytes -------------------------------------------------------
//
// A GUID is `{u32, u16, u16, u8[8]}` in memory, which is NOT the order it is
// written in: the first three fields are little-endian and the last eight bytes
// are literal. Writing them by hand is where a transcription error hides, so
// each is built from its printed form field by field and the layout is pinned
// by a test.
struct Guid { a: u32, b: u16, c: u16, d: [u8; 8] }

fn guid_bytes() -> usize { return 16 as usize; }

fn mk(a: u32, b: u16, c: u16, d0: u8, d1: u8, d2: u8, d3: u8,
      d4: u8, d5: u8, d6: u8, d7: u8) -> Guid {
    return Guid { a: a, b: b, c: c, d: [d0, d1, d2, d3, d4, d5, d6, d7] };
}

// {c60ac5fe-252a-478f-a0ef-bc8fa5f7cad3}
fn g_source_type() -> Guid {
    return mk(0xc60ac5fe as u32, 0x252a as u16, 0x478f as u16,
              0xa0 as u8, 0xef as u8, 0xbc as u8, 0x8f as u8,
              0xa5 as u8, 0xf7 as u8, 0xca as u8, 0xd3 as u8);
}
// {8ac3587a-4ae7-42d8-99e0-0a6013eef90f}
fn g_vidcap() -> Guid {
    return mk(0x8ac3587a as u32, 0x4ae7 as u16, 0x42d8 as u16,
              0x99 as u8, 0xe0 as u8, 0x0a as u8, 0x60 as u8,
              0x13 as u8, 0xee as u8, 0xf9 as u8, 0x0f as u8);
}
// {60d0e559-52f8-4fa2-bbce-acdb34a8ec01}
fn g_friendly_name() -> Guid {
    return mk(0x60d0e559 as u32, 0x52f8 as u16, 0x4fa2 as u16,
              0xbb as u8, 0xce as u8, 0xac as u8, 0xdb as u8,
              0x34 as u8, 0xa8 as u8, 0xec as u8, 0x01 as u8);
}
// {279a808d-aec7-40c8-9c6b-a6b492c78a66} IID_IMFMediaSource
fn g_iid_media_source() -> Guid {
    return mk(0x279a808d as u32, 0xaec7 as u16, 0x40c8 as u16,
              0x9c as u8, 0x6b as u8, 0xa6 as u8, 0xb4 as u8,
              0x92 as u8, 0xc7 as u8, 0x8a as u8, 0x66 as u8);
}
// {1652c33d-d6b2-4012-b834-72030849a37d} MF_MT_FRAME_SIZE
fn g_frame_size() -> Guid {
    return mk(0x1652c33d as u32, 0xd6b2 as u16, 0x4012 as u16,
              0xb8 as u8, 0x34 as u8, 0x72 as u8, 0x03 as u8,
              0x08 as u8, 0x49 as u8, 0xa3 as u8, 0x7d as u8);
}
// {c459a2e8-3d2c-4e44-b132-fee5156c7bb0} MF_MT_FRAME_RATE
fn g_frame_rate() -> Guid {
    return mk(0xc459a2e8 as u32, 0x3d2c as u16, 0x4e44 as u16,
              0xb1 as u8, 0x32 as u8, 0xfe as u8, 0xe5 as u8,
              0x15 as u8, 0x6c as u8, 0x7b as u8, 0xb0 as u8);
}
// {f7e34c9a-42e8-4714-b74b-cb29d72c35e5} MF_MT_SUBTYPE
fn g_subtype() -> Guid {
    return mk(0xf7e34c9a as u32, 0x42e8 as u16, 0x4714 as u16,
              0xb7 as u8, 0x4b as u8, 0xcb as u8, 0x29 as u8,
              0xd7 as u8, 0x2c as u8, 0x35 as u8, 0xe5 as u8);
}

// A media subtype's FOURCC lives in the first four bytes: NV12 is 0x3231564E,
// YUY2 0x32595559, RGB32 0x00000016. Comparing that one word is enough to tell
// the formats apart and avoids sixteen byte compares per frame.
fn fourcc_nv12() -> u32 { return 0x3231564E as u32; }
fn fourcc_yuy2() -> u32 { return 0x32595559 as u32; }
fn fourcc_rgb32() -> u32 { return 0x00000016 as u32; }

// ---- the open session ------------------------------------------------------------
//
// ONE SESSION, in a static rather than on the heap. The facade hands back an
// opaque `*u8` handle and this returns the address of the block below, which
// means a second `open` while one is live is refused rather than silently
// handing out a second view of the same device — which is what Windows would do
// anyway, with the second `ActivateObject` failing.
struct Session {
    live: bool,
    source: usize,
    reader: usize,
    width: i32,
    height: i32,
    fps: i32,
    fourcc: u32,
    name: text::Text,
    // The pump: the handler, its context, and the two flags that stop it.
    on_frame: fn(*u8, i32, i32, i32, *u8, *u8),
    opaque frame_ctx: *u8,
    streaming: bool,
    stopped: bool,
}

static SESSION: Session = #zero::[Session]();
static LAST_ERROR: i32 = 0 as i32;
static MF_STARTED: bool = false;

fn ok() -> i32 { return 0 as i32; }

// Start Media Foundation once per process. `MFShutdown` is deliberately never
// called: the pump thread and the COM objects outlive any one session, and a
// shutdown while another part of the process still holds an MF object is a
// crash rather than a tidy-up.
fn ensure_mf() -> bool {
    if MF_STARTED { return true; }
    // A MACHINE WITHOUT MEDIA FOUNDATION is not an error — it is a machine with
    // no camera stack, which the contract already has a word for. `Unsupported`
    // rather than `Failed`: an N edition without the Media Feature Pack is a
    // configuration, not a fault.
    if !bind_mf() { LAST_ERROR = camera::Outcome::Unsupported.to_code(); return false; }
    let hr: i32 = { MFStartup(mf_version(), mf_startup_lite()) };
    if hr != ok() { LAST_ERROR = camera::Outcome::Failed.to_code(); return false; }
    MF_STARTED = true;
    return true;
}

// The attribute block that says "video capture devices". Caller releases.
fn vidcap_attributes() -> *u8 {
    var attrs: *u8 = 0 as *u8;
    if { MFCreateAttributes(#addr_of(attrs), 1 as u32) } != ok() { return 0 as *u8; }
    var key: Guid = g_source_type();
    var val: Guid = g_vidcap();
    if call_gg(attrs, idx_set_guid(), { #addr_of(key) as *u8 }, { #addr_of(val) as *u8 }) != ok() {
        let _r: u32 = call_release(attrs);
        return 0 as *u8;
    }
    return attrs;
}

// Enumerate. `out_count` receives how many; the returned array is the caller's
// to free with `CoTaskMemFree` after releasing each element.
fn enumerate(out_count: *u32) -> **u8 {
    { *out_count = 0 as u32 };
    if !ensure_mf() { return 0 as **u8; }
    let attrs: *u8 = vidcap_attributes();
    if attrs == (0 as *u8) { return 0 as **u8; }
    var devices: **u8 = 0 as **u8;
    var count: u32 = 0 as u32;
    let hr: i32 = { MFEnumDeviceSources(attrs, #addr_of(devices), #addr_of(count)) };
    let _r: u32 = call_release(attrs);
    if hr != ok() { return 0 as **u8; }
    { *out_count = count };
    return devices;
}

fn release_devices(devices: **u8, count: u32) {
    if devices == (0 as **u8) { return; }
    var i: u32 = 0 as u32;
    while i < count {
        let d: *u8 = { *(devices + (i as usize)) };
        let _r: u32 = call_release(d);
        i = i +% (1 as u32);
    }
    { CoTaskMemFree(devices as *u8) };
    return;
}

// A device's friendly name as UTF-8. Empty when it will not say.
fn device_name(dev: *u8) -> text::Text {
    var key: Guid = g_friendly_name();
    var wide: *u8 = 0 as *u8;
    var wlen: u32 = 0 as u32;
    if call_ggg(dev, idx_get_alloc_string(), { #addr_of(key) as *u8 },
                { #addr_of(wide) as *u8 }, { #addr_of(wlen) as *u8 }) != ok() {
        return text::new();
    }
    if wide == (0 as *u8) { return text::new(); }
    let need: i32 = { WideCharToMultiByte(cp_utf8(), 0 as u32, wide, wlen as i32,
                                          0 as *u8, 0 as i32, 0 as *u8, 0 as *u8) };
    if need <= (0 as i32) { { CoTaskMemFree(wide) }; return text::new(); }
    let buf: *u8 = { malloc((need as usize) +% (1 as usize)) };
    if buf == (0 as *u8) { { CoTaskMemFree(wide) }; return text::new(); }
    let got: i32 = { WideCharToMultiByte(cp_utf8(), 0 as u32, wide, wlen as i32,
                                         buf, need, 0 as *u8, 0 as *u8) };
    { CoTaskMemFree(wide) };
    if got <= (0 as i32) { free(buf); return text::new(); }
    let view: str = { #str_from_raw_parts(buf, got as usize) };
    let out: text::Text = text::from_str(view);
    free(buf);
    return out;
}

// ---- the seam ---------------------------------------------------------------------

export extern fn _c_count() -> i64 {
    var count: u32 = 0 as u32;
    let devices: **u8 = enumerate(#addr_of(count));
    if devices == (0 as **u8) { return 0 as i64; }
    release_devices(devices, count);
    return count as i64;
}

// WINDOWS HAS NO FACING. A capture device is addressed by name or by index and
// says nothing about which way it points — `Facing` is an Apple and Android
// idea, and the contract's own comment says so where it defines `External`. So
// any camera answers a request for any facing, and `_c_actual_facing` reports
// `External` rather than guessing a side.
export extern fn _c_has(facing: i32) -> i32 {
    let _f: i32 = facing;
    if { _c_count() } > (0 as i64) { return 1 as i32; }
    return 0 as i32;
}

export extern fn _c_last_error() -> i32 { return LAST_ERROR; }

// Read the settled format off the reader's current media type.
fn read_format(reader: *u8) {
    var mt: *u8 = 0 as *u8;
    if call_u_p(reader, idx_get_current_media_type(), first_video_stream(),
                { #addr_of(mt) as *u8 }) != ok() { return; }
    if mt == (0 as *u8) { return; }

    var key_sz: Guid = g_frame_size();
    var packed: u64 = 0 as u64;
    if call_gg(mt, idx_get_u64(), { #addr_of(key_sz) as *u8 },
               { #addr_of(packed) as *u8 }) == ok() {
        // WIDTH IN THE HIGH HALF, height in the low — MF packs it that way and
        // reading it the other round gives a 360x640 portrait camera.
        SESSION.width = (packed / (4294967296 as u64)) as i32;
        SESSION.height = (packed -% ((packed / (4294967296 as u64)) *% (4294967296 as u64))) as i32;
    }

    var key_fr: Guid = g_frame_rate();
    var rate: u64 = 0 as u64;
    if call_gg(mt, idx_get_u64(), { #addr_of(key_fr) as *u8 },
               { #addr_of(rate) as *u8 }) == ok() {
        // A RATIO, not a number: 30/1 and 30000/1001 are both "thirty".
        let num: u64 = rate / (4294967296 as u64);
        let den: u64 = rate -% (num *% (4294967296 as u64));
        if den > (0 as u64) { SESSION.fps = (num / den) as i32; }
    }

    var key_st: Guid = g_subtype();
    var sub: Guid = #zero::[Guid]();
    if call_gg(mt, idx_get_guid(), { #addr_of(key_st) as *u8 },
               { #addr_of(sub) as *u8 }) == ok() {
        SESSION.fourcc = sub.a;
    }
    let _r: u32 = call_release(mt);
    return;
}

export extern fn _c_open(req: *_CRequest) -> *u8 {
    LAST_ERROR = camera::Outcome::Ok.to_code();
    // ONE AT A TIME. A second open would ask Windows for a device this process
    // already holds, and the honest answer to that is Busy rather than a second
    // handle onto the same frames.
    if SESSION.live { LAST_ERROR = camera::Outcome::Busy.to_code(); return 0 as *u8; }

    var count: u32 = 0 as u32;
    let devices: **u8 = enumerate(#addr_of(count));
    if devices == (0 as **u8) || count == (0 as u32) {
        if devices != (0 as **u8) { release_devices(devices, count); }
        LAST_ERROR = camera::Outcome::Unsupported.to_code();
        return 0 as *u8;
    }

    // WHICH DEVICE. `Request::device` names one — the contract's own answer for
    // a platform with no facing — and an empty name takes the first. A name
    // that matches nothing is NOT silently the first: asking for a camera that
    // is not here and being handed a different one is the lie this package
    // exists to avoid.
    var chosen: u32 = 0 as u32;
    var found: bool = true;
    if req != (0 as *_CRequest) {
        let want_len: usize = { (*req).device_len };
        if want_len > (0 as usize) {
            let want: str = { #str_from_raw_parts({ (*req).device }, want_len) };
            found = false;
            var i: u32 = 0 as u32;
            while i < count {
                let d: *u8 = { *(devices + (i as usize)) };
                let nm: text::Text = device_name(d);
                if nm.view() == want { chosen = i; found = true; i = count; }
                else { i = i +% (1 as u32); }
            }
        }
    }
    if !found {
        release_devices(devices, count);
        LAST_ERROR = camera::Outcome::Unsupported.to_code();
        return 0 as *u8;
    }

    let dev: *u8 = { *(devices + (chosen as usize)) };
    let name: text::Text = device_name(dev);

    var iid: Guid = g_iid_media_source();
    var source: *u8 = 0 as *u8;
    let hr: i32 = call_gg(dev, idx_activate_object(), { #addr_of(iid) as *u8 },
                          { #addr_of(source) as *u8 });
    if hr != ok() || source == (0 as *u8) {
        release_devices(devices, count);
        // A DEVICE THAT ENUMERATES AND WILL NOT ACTIVATE is almost always held
        // by something else — a video call, the Camera app. `Busy` is the
        // actionable answer; `Failed` would send a caller looking for a bug.
        LAST_ERROR = camera::Outcome::Busy.to_code();
        return 0 as *u8;
    }

    var reader: *u8 = 0 as *u8;
    let hr2: i32 = { MFCreateSourceReaderFromMediaSource(source, 0 as *u8,
                                                         #addr_of(reader)) };
    if hr2 != ok() || reader == (0 as *u8) {
        let _r: u32 = call_release(source);
        release_devices(devices, count);
        LAST_ERROR = camera::Outcome::Failed.to_code();
        return 0 as *u8;
    }
    let _sel: i32 = call_u_i(reader, idx_set_stream_selection(),
                             first_video_stream(), 1 as i32);

    SESSION.live = true;
    SESSION.source = { #addr(source) };
    SESSION.reader = { #addr(reader) };
    SESSION.width = 0 as i32;
    SESSION.height = 0 as i32;
    SESSION.fps = 0 as i32;
    SESSION.fourcc = 0 as u32;
    SESSION.name = name;
    SESSION.streaming = false;
    SESSION.stopped = true;
    read_format(reader);

    release_devices(devices, count);
    return { #addr_of(SESSION) as *u8 };
}

fn is_live(h: *u8) -> bool {
    if h == (0 as *u8) { return false; }
    return SESSION.live;
}

export extern fn _c_actual_facing(h: *u8) -> i32 {
    if !is_live(h) { return 3 as i32; }          // Unspecified
    // EXTERNAL, and never a guess. Windows does not report which way a camera
    // points, so calling a laptop's built-in lens `Front` would be inventing
    // the one fact this enum exists to carry honestly.
    return 2 as i32;
}

export extern fn _c_frame_rate(h: *u8) -> i32 {
    if !is_live(h) { return 0 as i32; }
    return SESSION.fps;
}

export extern fn _c_frame_size(h: *u8, out_width: *i32, out_height: *i32) {
    if out_width != (0 as *i32) { { *out_width = 0 as i32 }; }
    if out_height != (0 as *i32) { { *out_height = 0 as i32 }; }
    if !is_live(h) { return; }
    if out_width != (0 as *i32) { { *out_width = SESSION.width }; }
    if out_height != (0 as *i32) { { *out_height = SESSION.height }; }
    return;
}

// NV12 and YUY2 both carry a full-resolution LUMA plane first, which is exactly
// what `PixelFormat::Luma8` means and what `Frame::luma` slices. RGB32 is packed
// and has no luma plane, so it reports `Bgra32` and the pixels arrive through
// `Frame::native`. Anything else answers `Any` rather than naming a layout a
// caller would then read by.
export extern fn _c_pixel_format(h: *u8) -> i32 {
    if !is_live(h) { return 0 as i32; }
    if SESSION.fourcc == fourcc_nv12() { return 1 as i32; }
    if SESSION.fourcc == fourcc_yuy2() { return 1 as i32; }
    if SESSION.fourcc == fourcc_rgb32() { return 2 as i32; }
    return 0 as i32;
}

export extern fn _c_device(h: *u8, into: *text::Text) -> i32 {
    if into == (0 as *text::Text) { return camera::Outcome::Failed.to_code(); }
    if !is_live(h) { return camera::Outcome::Failed.to_code(); }
    { *into = SESSION.name.clone() };
    return camera::Outcome::Ok.to_code();
}

// ---- the frame pump ----------------------------------------------------------------

// One row of luma. NV12 and YUY2 differ here and the difference is the whole of
// what a handler needs to walk the plane: NV12's Y plane is one byte per pixel,
// YUY2 packs Y and chroma together at two bytes per pixel.
fn luma_stride() -> i32 {
    if SESSION.fourcc == fourcc_yuy2() { return SESSION.width *% (2 as i32); }
    return SESSION.width;
}

fn pump(arg: *u8) -> *u8 {
    let _a: *u8 = arg;
    let reader: *u8 = { SESSION.reader as *u8 };
    if reader == (0 as *u8) { SESSION.stopped = true; return 0 as *u8; }
    while SESSION.streaming {
        var actual: u32 = 0 as u32;
        var flags: u32 = 0 as u32;
        var stamp: u64 = 0 as u64;
        var sample: *u8 = 0 as *u8;
        let hr: i32 = call_read_sample(reader, first_video_stream(), 0 as u32,
                                       { #addr_of(actual) as *u8 },
                                       { #addr_of(flags) as *u8 },
                                       { #addr_of(stamp) as *u8 },
                                       { #addr_of(sample) as *u8 });
        if hr != ok() { SESSION.streaming = false; }
        else {
            // A NULL SAMPLE IS NORMAL, not an error: the reader returns S_OK
            // with nothing while the pipeline spins up or a format changes.
            if sample == (0 as *u8) { { Sleep(5 as u32) }; }
            else {
                var buf: *u8 = 0 as *u8;
                if call_p(sample, idx_to_contiguous(), { #addr_of(buf) as *u8 }) == ok() {
                    var p: *u8 = 0 as *u8;
                    var maxlen: u32 = 0 as u32;
                    var curlen: u32 = 0 as u32;
                    if call_lock(buf, { #addr_of(p) as *u8 },
                                 { #addr_of(maxlen) as *u8 },
                                 { #addr_of(curlen) as *u8 }) == ok() {
                        let f: fn(*u8, i32, i32, i32, *u8, *u8) = SESSION.on_frame;
                        if f.is_not_null() {
                            // THE BUFFER IS VALID FOR THIS CALL ONLY, which is
                            // the contract `Frame::luma` states — it is unlocked
                            // the moment the handler returns.
                            f(p, SESSION.width, SESSION.height, luma_stride(),
                              p, SESSION.frame_ctx);
                        }
                        let _u: i32 = call_0(buf, idx_unlock());
                    }
                    let _rb: u32 = call_release(buf);
                }
                let _rs: u32 = call_release(sample);
            }
        }
    }
    SESSION.stopped = true;
    return 0 as *u8;
}

export extern fn _c_on_frame(h: *u8, cb: fn(*u8, i32, i32, i32, *u8, *u8), ctx: *u8) -> i32 {
    if !is_live(h) { return camera::Outcome::Failed.to_code(); }
    if cb.is_null() { return camera::Outcome::Failed.to_code(); }
    if SESSION.streaming { return camera::Outcome::Ok.to_code(); }
    SESSION.on_frame = cb;
    SESSION.frame_ctx = ctx;
    SESSION.streaming = true;
    SESSION.stopped = false;
    let start: fn(*u8) -> *u8 = pump;
    let t: *u8 = { CreateThread(0 as *u8, 0 as usize, start, 0 as *u8,
                                0 as u32, 0 as *u32) };
    if t == (0 as *u8) {
        SESSION.streaming = false;
        SESSION.stopped = true;
        return camera::Outcome::Failed.to_code();
    }
    let _c: i32 = { CloseHandle(t) };
    return camera::Outcome::Ok.to_code();
}

// Stop the pump and WAIT for it. The thread holds the reader for the length of
// a `ReadSample`, so returning before it has noticed would let `_c_close`
// release an interface a live call is still inside.
fn stop_pump() {
    if !SESSION.streaming { return; }
    SESSION.streaming = false;
    var spins: i32 = 0 as i32;
    while !SESSION.stopped && spins < (2000 as i32) {
        { Sleep(2 as u32) };
        spins = spins +% (1 as i32);
    }
    return;
}

export extern fn _c_stop_frames(h: *u8) -> i32 {
    if !is_live(h) { return camera::Outcome::Failed.to_code(); }
    stop_pump();
    return camera::Outcome::Ok.to_code();
}

export extern fn _c_close(h: *u8) {
    if !is_live(h) { return; }
    stop_pump();
    let reader: *u8 = { SESSION.reader as *u8 };
    let source: *u8 = { SESSION.source as *u8 };
    if reader != (0 as *u8) { let _r: u32 = call_release(reader); }
    if source != (0 as *u8) { let _s: u32 = call_release(source); }
    SESSION.reader = 0 as usize;
    SESSION.source = 0 as usize;
    SESSION.live = false;
    SESSION.width = 0 as i32;
    SESSION.height = 0 as i32;
    SESSION.fps = 0 as i32;
    SESSION.fourcc = 0 as u32;
    return;
}

// ---- the verbs this backend does not answer, and why --------------------------------
//
// Each returns the contract's `Unsupported` rather than a false `Ok`. The rule
// the facade sets is that a caller must be able to tell "this device cannot"
// from "it did" — a `set_torch` that reported success and did nothing is
// exactly the silent failure the whole package is written against.

// A STILL PHOTO IS AN ENCODER, not a frame grab. The contract hands back JPEG
// bytes, and turning an NV12 buffer into one means WIC or the JPEG MFT — a
// second pipeline with its own format negotiation. `on_frame` already delivers
// the pixels; what is missing is only the encode.
//
// The handler is still CALLED, with an empty slice, because the facade's own
// note says an awaiting caller must never be left hanging on a capture that
// will not arrive.
export extern fn _c_capture(h: *u8, cb: fn(*u8, usize, *u8), ctx: *u8) -> i32 {
    if cb.is_not_null() { cb(0 as *u8, 0 as usize, ctx); }
    return camera::Outcome::Unsupported.to_code();
}

// ZOOM, TORCH, FOCUS, EXPOSURE, WHITE BALANCE. Media Foundation exposes these
// through `IAMCameraControl` and `IAMVideoProcAmp` on the capture source, in
// DEVICE-DEFINED units with per-device ranges that have to be queried before a
// value means anything — and most webcams implement almost none of them. They
// are a pass of their own, and refusing is the honest answer until then.
//
// A LAPTOP WEBCAM HAS NO TORCH at all, which is why `_c_has_torch` is a flat
// no rather than a query: there is no lamp on the far side of the lens.
export extern fn _c_set_zoom(h: *u8, factor: f64) -> i32 { return camera::Outcome::Unsupported.to_code(); }
export extern fn _c_zoom(h: *u8) -> f64 { return 1.0; }
export extern fn _c_max_zoom(h: *u8) -> f64 { return 1.0; }
export extern fn _c_set_torch(h: *u8, on: i32) -> i32 { return camera::Outcome::Unsupported.to_code(); }
export extern fn _c_has_torch(h: *u8) -> i32 { return 0 as i32; }
export extern fn _c_set_focus(h: *u8, mode: i32) -> i32 { return camera::Outcome::Unsupported.to_code(); }
export extern fn _c_set_exposure(h: *u8, mode: i32) -> i32 { return camera::Outcome::Unsupported.to_code(); }
export extern fn _c_set_white_balance(h: *u8, mode: i32) -> i32 { return camera::Outcome::Unsupported.to_code(); }

// SWITCHING BY FACING NEEDS A FACING, and Windows has none — see
// `_c_actual_facing`. An application that wants a different camera on this
// platform names it in `Request::device` and opens that one.
export extern fn _c_switch_to(h: *u8, facing: i32) -> i32 { return camera::Outcome::Unsupported.to_code(); }

// A PREVIEW IS A VIEW, and this backend has none to give. The frames are
// delivered; drawing them is `facet_win32`'s business, and the node facet would
// adopt has to come from there rather than from here.
export extern fn _c_preview_create(h: *u8) -> *u8 { return 0 as *u8; }
export extern fn _c_preview_release(v: *u8) { return; }

// ---- tests -------------------------------------------------------------------------
//
// Against the REAL Media Foundation stack and whatever camera this machine has.
// A build server with no lens takes the `count == 0` branch of every test below
// and still exercises the enumeration path — which is the half that runs before
// any device exists.

#[test]
fn a_guid_is_sixteen_bytes_in_the_layout_com_expects() {
    // THE ONE THING A WRONG ANSWER HERE WOULD HIDE. Every GUID below is passed
    // to COM by address; if the struct were padded, `SetGUID` would read four
    // bytes of nothing and enumeration would quietly find no devices.
    assert { #size_of::[Guid]() } == (16 as usize);
    assert guid_bytes() == (16 as usize);
}

#[test]
fn the_guids_carry_the_values_they_are_written_as() {
    // Transcribed by hand from their printed forms, so the first field of each
    // is pinned — a digit lost there is a different attribute and a silent
    // enumeration of nothing.
    assert g_source_type().a == (0xc60ac5fe as u32);
    assert g_vidcap().a == (0x8ac3587a as u32);
    assert g_friendly_name().a == (0x60d0e559 as u32);
    assert g_iid_media_source().a == (0x279a808d as u32);
    assert g_frame_size().a == (0x1652c33d as u32);
    assert g_frame_rate().a == (0xc459a2e8 as u32);
    assert g_subtype().a == (0xf7e34c9a as u32);
    // And the trailing bytes, which are literal rather than byte-swapped.
    assert g_vidcap().d[7] == (0x0f as u8);
    assert g_source_type().d[7] == (0xd3 as u8);
}

#[test]
fn media_foundation_starts_on_this_machine() {
    // If MF will not start, every verb below is unreachable and the reason is
    // worth naming rather than discovering as "no cameras".
    // MF is absent on an N edition without the Media Feature Pack, which is a
    // configuration rather than a fault — so what is asserted is that BINDING
    // answers cleanly either way and that a bound stack really does start.
    let bound: bool = bind_mf();
    if bound { assert ensure_mf(); }
}

#[test]
fn counting_devices_does_not_need_a_camera_to_be_safe() {
    // 0 on a machine with no lens and a positive number on one with. Both are
    // correct; what is asserted is that enumeration completes and never reports
    // a negative count.
    let n: i64 = { _c_count() };
    assert n >= (0 as i64);
    // Idempotent — the attribute block and the device array are released each
    // time, so a second call must answer the same.
    assert { _c_count() } == n;
}

#[test]
fn has_answers_for_every_facing_the_same_way() {
    // Windows reports no facing, so every facing is answered by whether ANY
    // camera is present — see `_c_has`. What must never happen is a `true` for
    // one facing and `false` for another on the same machine, which would send
    // an application looking for a second lens that does not exist.
    let back: i32 = { _c_has(0 as i32) };
    let front: i32 = { _c_has(1 as i32) };
    let ext: i32 = { _c_has(2 as i32) };
    assert back == front;
    assert front == ext;
    if { _c_count() } > (0 as i64) { assert back == (1 as i32); }
    else { assert back == (0 as i32); }
}

#[test]
fn opening_and_closing_a_real_camera_reports_a_real_format() {
    if { _c_count() } == (0 as i64) { return; }
    var req: _CRequest = #zero::[_CRequest]();
    let h: *u8 = { _c_open(#addr_of(req)) };
    assert h != (0 as *u8);

    // A REAL FORMAT, read off the reader's own media type rather than assumed.
    var w: i32 = 0 as i32;
    var ht: i32 = 0 as i32;
    { _c_frame_size(h, #addr_of(w), #addr_of(ht)) };
    assert w > (0 as i32);
    assert ht > (0 as i32);
    assert { _c_frame_rate(h) } > (0 as i32);

    // And the device names itself.
    var name: text::Text = text::new();
    assert { _c_device(h, #addr_of(name)) } == camera::Outcome::Ok.to_code();
    assert name.count() > (0 as usize);

    // Windows has no facing: External, never a guess at a side.
    assert { _c_actual_facing(h) } == (2 as i32);

    { _c_close(h) };
    // Closed means closed: the geometry is gone rather than stale.
    var w2: i32 = 9 as i32;
    { _c_frame_size(h, #addr_of(w2), #addr_of(ht)) };
    assert w2 == (0 as i32);
}

#[test]
fn a_second_open_is_busy_rather_than_a_second_handle() {
    if { _c_count() } == (0 as i64) { return; }
    var req: _CRequest = #zero::[_CRequest]();
    let h: *u8 = { _c_open(#addr_of(req)) };
    assert h != (0 as *u8);
    // BUSY, not a second view of the same device — and the code says which, so
    // a caller can retry rather than conclude there is no camera.
    let second: *u8 = { _c_open(#addr_of(req)) };
    assert second == (0 as *u8);
    assert { _c_last_error() } == camera::Outcome::Busy.to_code();
    { _c_close(h) };
}

#[test]
fn a_device_name_nothing_matches_is_refused_rather_than_substituted() {
    if { _c_count() } == (0 as i64) { return; }
    let want: str = "no-such-camera-on-this-machine";
    var req: _CRequest = #zero::[_CRequest]();
    req.device = { #str_ptr(want) };
    req.device_len = { #str_len(want) };
    let h: *u8 = { _c_open(#addr_of(req)) };
    // Handing back a DIFFERENT camera than the one asked for is the lie this
    // package exists to avoid.
    assert h == (0 as *u8);
    assert { _c_last_error() } == camera::Outcome::Unsupported.to_code();
}

static FRAMES: i32 = 0 as i32;
static FRAME_W: i32 = 0 as i32;
static FRAME_BYTES: u8 = 0 as u8;

fn count_frame(luma: *u8, w: i32, h: i32, stride: i32, native: *u8, ctx: *u8) {
    FRAMES = FRAMES + (1 as i32);
    FRAME_W = w;
    if luma.is_not_null() && w > (0 as i32) { FRAME_BYTES = { *luma }; }
    return;
}

#[test]
fn frames_arrive_from_a_real_lens() {
    if { _c_count() } == (0 as i64) { return; }
    var req: _CRequest = #zero::[_CRequest]();
    let h: *u8 = { _c_open(#addr_of(req)) };
    assert h != (0 as *u8);
    FRAMES = 0 as i32;
    FRAME_W = 0 as i32;
    let cb: fn(*u8, i32, i32, i32, *u8, *u8) = count_frame;
    assert { _c_on_frame(h, cb, 0 as *u8) } == camera::Outcome::Ok.to_code();

    // A camera takes a moment to start; 30fps means a frame every 33ms, so this
    // is generous rather than tight.
    var waited: i32 = 0 as i32;
    while FRAMES == (0 as i32) && waited < (5000 as i32) {
        { Sleep(20 as u32) };
        waited = waited +% (20 as i32);
    }
    assert FRAMES > (0 as i32);
    // The frame carries the geometry the session reported, not zeroes.
    var w: i32 = 0 as i32;
    var ht: i32 = 0 as i32;
    { _c_frame_size(h, #addr_of(w), #addr_of(ht)) };
    assert FRAME_W == w;

    assert { _c_stop_frames(h) } == camera::Outcome::Ok.to_code();
    { _c_close(h) };
}

#[test]
fn the_device_controls_refuse_rather_than_lying() {
    // Every one of these reports `Unsupported`, and NEVER `Ok` — a `set_torch`
    // that answered success and did nothing is the exact silent failure the
    // facade's own notes are written against.
    let h: *u8 = 0 as *u8;
    assert { _c_set_zoom(h, 2.0) } == camera::Outcome::Unsupported.to_code();
    assert { _c_set_torch(h, 1 as i32) } == camera::Outcome::Unsupported.to_code();
    assert { _c_set_focus(h, 0 as i32) } == camera::Outcome::Unsupported.to_code();
    assert { _c_set_exposure(h, 0 as i32) } == camera::Outcome::Unsupported.to_code();
    assert { _c_set_white_balance(h, 0 as i32) } == camera::Outcome::Unsupported.to_code();
    assert { _c_switch_to(h, 1 as i32) } == camera::Outcome::Unsupported.to_code();
    // A laptop lens has no lamp behind it.
    assert { _c_has_torch(h) } == (0 as i32);
    // And zoom reads as 1.0 rather than 0, which would read as "no image".
    assert { _c_zoom(h) } == (1.0);
    assert { _c_max_zoom(h) } == (1.0);
}

static CAPTURED: i32 = 0 as i32;
fn note_capture(data: *u8, len: usize, ctx: *u8) {
    CAPTURED = CAPTURED + (1 as i32);
    return;
}

#[test]
fn capture_calls_back_even_though_it_cannot_encode() {
    // THE HANDLER MUST STILL RUN. An awaiting caller left hanging on a photo
    // that will never arrive is worse than one told immediately that it cannot
    // — the facade's own note, and the rule every seam here follows.
    CAPTURED = 0 as i32;
    let cb: fn(*u8, usize, *u8) = note_capture;
    assert { _c_capture(0 as *u8, cb, 0 as *u8) } == camera::Outcome::Unsupported.to_code();
    assert CAPTURED == (1 as i32);
}
