// The iOS face of `inspector/appkit` — a forwarder to the UIKit half.
//
// WHY THIS FILE EXISTS. A prebuilt package is compiled from a generated entry
// that imports EVERY module in `src/`, so the archive covers the whole public
// surface and matches the declarations in `lib/include/`. That is right for a
// portable package and wrong for a module that is one platform's half:
// `appkit.cplus` imports the `appkit` package, which is a
// `[macos.dependencies]` and is not linked for iOS — so the iOS slice carried
// references to it and a facet app on the simulator died at the link on 59
// undefined symbols named after a package it never asked for. The developer's
// own code was fine; the archive was not.
//
// The `_<platform>` sibling is the mechanism the resolver already documents for
// exactly this, and `facet_agent/agent_ios.cplus` is the same file for the same
// reason: the module names a platform package, and on this platform that
// package does not exist.
//
// IT FORWARDS RATHER THAN REFUSES. `serve_ios.cplus` is the UIKit twin of
// `appkit.cplus` — same six entry points, same job — so `inspector/appkit` can
// mean the platform half on BOTH platforms instead of quietly meaning nothing
// on one. A no-op would compile and then not draw an overlay, which is the kind
// of silence that costs an afternoon. An iOS app normally arrives through
// `inspector/serve` and never names this module at all; a shared entry that
// does name it now works.

import "stdlib/vec" as vec;
import "facet/facet" as core;
import "./inspector" as insp;
import "./serve_ios" as ios;

fn install() { ios::install(); return; }

fn serve_if_asked() { ios::serve_if_asked(); return; }

fn place(n: *core::Node) -> ios::Placed { return ios::place(n); }

fn highlight(s: *u8, h: insp::Handle) { ios::highlight(s, h); return; }

fn clear_highlight(s: *u8) { ios::clear_highlight(s); return; }

fn native_props(n: *core::Node) -> vec::Vec[insp::Prop] { return ios::native_props(n); }
