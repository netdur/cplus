// The Linux face of `inspector/appkit` — a forwarder to the GTK half.
//
// WHY THIS FILE EXISTS, and it is the same reason `appkit_ios.cplus` gives: a
// prebuilt package is compiled from a generated entry that imports EVERY module
// in `src/`, so the archive covers the whole public surface. That is right for
// a portable package and wrong for a module that is one platform's half —
// `appkit.cplus` imports the `appkit` package, which is a
// `[macos.dependencies]` and is not linked here, so a Linux slice built from it
// would carry references to a package it never asked for and die at the link.
//
// IT FORWARDS RATHER THAN REFUSES. `serve_linux.cplus` is the GTK twin of
// `appkit.cplus` — same six entry points, same job — so `inspector/appkit` can
// mean the platform half on all THREE platforms instead of quietly meaning
// nothing on one. A no-op would compile and then not draw an overlay, which is
// the kind of silence that costs an afternoon. A Linux app normally arrives
// through `inspector/serve` and never names this module at all; a shared entry
// or a test that does name it now works.

import "stdlib/vec" as vec;
import "facet/facet" as core;
import "./inspector" as insp;
import "./serve_linux" as gtk;

// The type the tests and any shared entry name as `platform::Placed`. A
// forwarding FUNCTION cannot re-export a type, and the alias is what makes
// `inspector/appkit` mean the same six-entry surface here as on the other two
// platforms rather than five and a hole.
type Placed = gtk::Placed;

fn install() { gtk::install(); return; }

fn serve_if_asked() { gtk::serve_if_asked(); return; }

fn place(n: *core::Node) -> Placed { return gtk::place(n); }

fn highlight(s: *u8, h: insp::Handle) { gtk::highlight(s, h); return; }

fn clear_highlight(s: *u8) { gtk::clear_highlight(s); return; }

fn native_props(n: *core::Node) -> vec::Vec[insp::Prop] { return gtk::native_props(n); }
