// android — the same one thing facet's tree cannot answer, on the third
// backend.
//
// This file is the Android twin of `appkit.cplus` and `serve_ios.cplus`, and
// the twinning is again the point: everything else in this package walks
// facet's own tree, so a third platform costs one overlay, one native-props
// reader and one serve entry. Read `appkit.cplus` first — the reasoning for
// keeping the highlight out of the tree it draws over, and for the synchronous
// main-thread hop a socket request needs, is written out there and is the same
// reasoning here.
//
// FOUR DIFFERENCES from the two Apple halves, all of them Android's and none of
// them the inspector's:
//
//   * THE OVERLAY IS A VIEW, not a layer. A CALayer is not a view, is not laid
//     out and is not hit-tested, which is what made it the right answer twice.
//     Android has no such object below View — a Drawable is not addressable
//     without a host — so the overlay is a plain `android.view.View` added to
//     the ROOT FacetHost. That costs exactly what the AppKit header warns
//     about, and each cost is paid here explicitly:
//       - LAYOUT: FacetHost's `onLayout` is empty by design (facet places every
//         child with `View.layout()`), so a child Android never lays out is the
//         normal case here rather than a fight.
//       - HIT TESTING: the overlay is never clickable and never focusable, and
//         it is added to the root host rather than to the inspected view, so no
//         inspected control is modified to draw it.
//       - THE WALKS: facet's tree does not contain it (it is not a facet node),
//         and this backend's own walks go node -> view, never view -> node.
//
//   * THE COORDINATE SPACE IS THE ROOT HOST'S, and `place` answers in it.
//     AppKit and UIKit both have `convertRect:toView:`; Android's equivalent
//     wants an `int[2]` out-parameter, and vendor/jni types no arrays. So the
//     conversion is done here by walking the VIEW parent chain and summing
//     `getLeft`/`getTop` less each parent's `getScrollX`/`getScrollY` — which
//     is what the platform's own conversion does, and gets a highlight inside a
//     scrolled list right for the same reason.
//
//   * THE UNITS. facet's are density-independent and Android's View geometry is
//     in physical pixels, so the walk above is in PIXELS and every crossing
//     goes through `env::px` / `env::dp`. `native_frame` is reported in facet's
//     units so it is directly comparable with the frame row beside it, and
//     `native_density` is reported next to it so the pixel numbers a person
//     reads in a layout dump are recoverable rather than a mystery factor of 3.
//
//   * THE TARGET IS A SYSTEM PROPERTY, not an environment variable. See
//     `arm`.

import "stdlib/vec" as vec;
import "stdlib/text" as text;
import "stdlib/option" as option;
import "stdlib/status" as status;
import "stdlib/env" as env;
import "flex_layout/flex_layout" as flex;
import "jni/jni" as jni;
import "android_view/runtime" as rt;
import "android_view/widgets" as w;
import "facet/facet" as core;
import "facet/mount" as mount;
import "facet/application" as runtime;
import "facet_agent/agent" as agent;
import "facet_android/env" as aenv;
import "facet_android/paint" as paint;
import "facet_android/geometry" as geometry;
import "facet_android/mainthread" as mainthread;
import "facet_android/scheduler" as sched;
import "facet_android/log" as alog;
import "./inspector" as insp;
import "./tree" as tree;
import "./mcp" as mcp;

// ---- the hop to the UI thread --------------------------------------------------
//
// Two things belong to the UI thread here where the Apple halves have one.
// facet's tree is the UI thread's on every backend (mount.cplus M6 asserts it
// on every write), and on top of that a JNIEnv belongs to ONE thread — so a
// read arriving from the socket worker cannot even ASK the platform what it
// holds, let alone write.
//
// `mainthread::run_on_ui` is the backend's own answer and already both halves:
// it posts a Runnable through `View.post` and waits, and on the UI thread it is
// a direct call with no queue. This is the argument-order shim and nothing
// more.
//
// IT DOES NOT FALL BACK TO RUNNING INLINE. The AppKit half can, because there
// the worst case is a call on the wrong thread; here it would also be the wrong
// JNIEnv, which is undefined rather than merely racy. A refusal is a request
// that answers empty — which is what an inspector request arriving before the
// Activity has attached honestly is — and it says so once in logcat rather than
// silently.
fn run_on_main_sync(ctx: *u8, work: fn(*u8)) {
    if mainthread::run_on_ui(work, ctx) { return; }
    alog::warn(#str_ptr("inspector: a request could not reach the UI thread - answering empty\0"));
}

// ---- the JNI calls this file needs and the binding does not name -------------

fn same_object(e: rt::Env, a: jni::jobject, b: jni::jobject) -> bool {
    if a == (0 as jni::jobject) { return false; }
    if b == (0 as jni::jobject) { return false; }
    let p: *jni::JNIEnv = e.raw();
    return { (*(*p)).IsSameObject(p, a, b) } != (0 as jni::jboolean);
}

// Is this object a View? The parent chain ends above the content view in
// `ViewRootImpl`, which is a ViewParent and NOT a View — calling `getLeft` on
// it would be a method id resolved against a class the object is not an
// instance of, which is exactly the CheckJNI error the walk must not commit.
fn is_view(e: rt::Env, o: jni::jobject) -> bool {
    if o == (0 as jni::jobject) { return false; }
    let cls: jni::jclass = e.class_cached(#str_ptr("android/view/View\0"));
    if cls == (0 as jni::jclass) { return false; }
    let p: *jni::JNIEnv = e.raw();
    return { (*(*p)).IsInstanceOf(p, o, cls) } != (0 as jni::jboolean);
}

fn class_name_of(e: rt::Env, o: jni::jobject, buf: *u8, cap: usize) -> bool {
    { (*buf) = 0 };
    let p: *jni::JNIEnv = e.raw();
    let cls: jni::jclass = { (*(*p)).GetObjectClass(p, o) };
    if cls == (0 as jni::jclass) { return false; }
    let s: jni::jobject = e.call_object_0(cls, #str_ptr("java/lang/Class\0"),
                                          #str_ptr("getName\0"),
                                          #str_ptr("()Ljava/lang/String;\0"));
    e.delete_local_ref(cls);
    if s == (0 as jni::jobject) { return false; }
    let ok: bool = e.string_utf_into(s, buf, cap);
    e.delete_local_ref(s);
    return ok;
}

// ---- the overlay ---------------------------------------------------------------
//
// REBUILT PER HIGHLIGHT rather than cached, which is the opposite of what the
// two Apple halves do and is right for the one thing this platform does that
// they do not: AN ACTIVITY CAN BE DESTROYED AND RECREATED UNDER A LIVE TREE
// (window.cplus opens on it). A cached overlay would hold a global ref to a
// View belonging to a dead Activity, and the host it was added to would be a
// different object on the other side of a rotation. A highlight is a
// developer-tool operation at human speed, so a handful of JNI calls per
// highlight buys away a whole class of staleness.
//
// Two statics, both process-scoped and both nulled the moment the overlay is
// taken down: the ref to release and the host to take it out of.
static OVERLAY: usize = 0;
static OVERLAY_HOST: usize = 0;

// Solid enough to find, transparent enough to read the control under it — the
// same 0.13/0.47/1.0 blue the other two halves draw, packed as ARGB because
// that is the only colour Android takes.
fn fill_argb() -> i32 { return { 56 << 24 } | (0x2278FF as i32); }
fn stroke_argb() -> i32 { return { { 0 -% 16777216 } | (0x2278FF as i32) }; }

fn new_overlay(e: rt::Env) -> jni::jobject {
    let ctx: jni::jobject = aenv::context();
    if ctx == (0 as jni::jobject) { return 0 as jni::jobject; }
    var v: w::View = w::View::new_context(e, ctx);

    var d: w::GradientDrawable = w::GradientDrawable::new_void(e);
    d.set_color_i(fill_argb());
    d.set_stroke_i_i({ { aenv::px(1.0) as i32 } }, stroke_argb());
    d.set_corner_radius({ { aenv::px(2.0) } as f32 });
    var drawable: w::Drawable = d.as_drawable();
    v.set_background(drawable.into_raw());
    let _kept: jni::jobject = d.into_raw();

    // NOT IN ANYONE'S WAY: a highlight that could take a touch would make the
    // control under it unreachable while the inspector is looking at it.
    v.set_clickable(false);
    v.set_focusable_z(false);
    v.set_enabled(false);
    // ABOVE EVERYTHING. A ViewGroup draws its children in Z order when they
    // have one, and `setZ` reorders the drawing without the `requestLayout`
    // that `bringToFront` raises — which on this host is forwarded to facet and
    // would schedule a layout pass for a rectangle.
    v.set_z({ 10000.0 as f32 });
    return v.into_raw();
}

fn clear_highlight(_s: *u8) {
    stop_glide();
    if OVERLAY == 0 { return; }
    if !aenv::have_env() { OVERLAY = 0; OVERLAY_HOST = 0; return; }
    let e: rt::Env = aenv::env();
    let ov: jni::jobject = { OVERLAY as jni::jobject };
    if OVERLAY_HOST != 0 {
        var host: w::ViewGroup = w::ViewGroup::from_global(e, { OVERLAY_HOST as jni::jobject });
        host.remove_view(ov);
        let _keep: jni::jobject = host.into_raw();
    }
    e.delete_global_ref(ov);
    OVERLAY = 0;
    OVERLAY_HOST = 0;
}

fn highlight(s: *u8, h: insp::Handle) {
    // A REQUEST THAT CANNOT BE ANSWERED TAKES THE HIGHLIGHT DOWN, and each of
    // these used to reach `clear_highlight` by being the first line of the
    // function. It is spelled out now because the success path no longer clears
    // — see below, it is what makes the glide possible.
    if !h.is_live() { clear_highlight(s); return; }
    if !aenv::have_env() { clear_highlight(s); return; }
    if !aenv::have_host() { clear_highlight(s); return; }
    let p: Placed = place(h.node);
    if !p.found { clear_highlight(s); return; }

    // BACK THROUGH FACET'S UNITS on purpose. `geometry::place` is the one place
    // in this family that knows a View must be MEASURED before it is laid out —
    // an unmeasured View draws nothing at whatever rect it is given — so the
    // pixel rect is handed back in the units that function takes rather than
    // this file growing a second copy of that rule. Everything the glide holds
    // is in those units for the same reason.
    let want: Rect = Rect {
        x: aenv::dp(p.rect.x), y: aenv::dp(p.rect.y),
        w: aenv::dp(p.rect.w), h: aenv::dp(p.rect.h),
    };

    let e: rt::Env = aenv::env();
    let host_obj: jni::jobject = aenv::host();

    // THE OVERLAY IS MADE ONCE AND KEPT. It used to be built fresh on every
    // call, which is the second of the two reasons the highlight did not move —
    // see the glide section. Reusing it is safe because `new_overlay` returns a
    // GLOBAL ref: it outlives the JNI frame that made it, which a local would
    // not. A host that is not the one it was added to is a new Activity, and
    // that overlay belongs to a window nobody is looking at any more.
    if OVERLAY == 0 || OVERLAY_HOST != { #addr(host_obj) } {
        clear_highlight(s);
        let ov: jni::jobject = new_overlay(e);
        if ov == (0 as jni::jobject) { return; }
        var host: w::ViewGroup = w::ViewGroup::from_global(e, host_obj);
        host.add_view_view(ov);
        let _keep: jni::jobject = host.into_raw();
        OVERLAY = { #addr(ov) };
        OVERLAY_HOST = { #addr(host_obj) };
        // NO GLIDE ON THE FIRST SHOW. There is nowhere to come from, and
        // animating out of the origin would throw the box across the screen on
        // the one frame a person is most likely to be watching.
        CUR = want;
        place_overlay(want);
        return;
    }

    glide_to(want);
}

// ---- resolving a node to a rectangle -----------------------------------------

// PIXELS, and in the ROOT HOST'S space — which is the one place the two Apple
// halves and this one differ in what they answer, and the reason is in the
// header: there is no `convertRect:toView:` to call afterwards.
struct Rect {
    x: f64,
    y: f64,
    w: f64,
    h: f64,
}

// `view` is borrowed exactly as the AppKit half documents: the backend that
// mounted it owns it, and this struct is a short-lived answer rather than a
// second owner. It is 0 for a viewless node, whose rectangle is real all the
// same — see `place`.
struct Placed {
    opaque view: *u8,
    rect: Rect,
    found: bool,
}

fn nothing_placed() -> Placed {
    return Placed {
        view: 0 as *u8,
        rect: Rect { x: 0.0, y: 0.0, w: 0.0, h: 0.0 },
        found: false,
    };
}

// The offset from `v`'s own origin to the root host's, in pixels.
//
// `ok` is false when `v` is not under the host at all — a view from a
// destroyed Activity, or one whose subtree has been detached — and a highlight
// then draws nowhere rather than at a plausible wrong place.
struct Offset {
    x: f64,
    y: f64,
    ok: bool,
}

fn offset_to_host(e: rt::Env, from: jni::jobject) -> Offset {
    let host: jni::jobject = aenv::host();
    var x: f64 = 0.0;
    var y: f64 = 0.0;
    var cur: jni::jobject = from;
    // A LOCAL REF PER STEP, released as the walk moves on. The first `cur` is
    // the caller's and is never released here.
    var owned: jni::jobject = 0 as jni::jobject;
    var steps: i32 = 0;
    while steps < 128 {
        if same_object(e, cur, host) {
            if owned != (0 as jni::jobject) { e.delete_local_ref(owned); }
            return Offset { x: x, y: y, ok: true };
        }
        var cv: w::View = w::View::from_global(e, cur);
        x = x + { cv.get_left() as f64 };
        y = y + { cv.get_top() as f64 };
        let parent: jni::jobject = cv.get_parent();
        paint::unwrap_keep(cv);

        if !is_view(e, parent) {
            if parent != (0 as jni::jobject) { e.delete_local_ref(parent); }
            if owned != (0 as jni::jobject) { e.delete_local_ref(owned); }
            return Offset { x: 0.0, y: 0.0, ok: false };
        }
        // A CHILD SITS IN ITS PARENT'S SCROLLED CONTENT. `getLeft` is the
        // unscrolled position, so a row halfway down a scrolled list would
        // highlight where it WOULD be if nothing had moved without this.
        var pv: w::View = w::View::from_global(e, parent);
        x = x - { pv.get_scroll_x() as f64 };
        y = y - { pv.get_scroll_y() as f64 };
        paint::unwrap_keep(pv);

        if owned != (0 as jni::jobject) { e.delete_local_ref(owned); }
        owned = parent;
        cur = parent;
        steps = steps +% 1;
    }
    if owned != (0 as jni::jobject) { e.delete_local_ref(owned); }
    return Offset { x: 0.0, y: 0.0, ok: false };
}

fn place(n: *core::Node) -> Placed {
    if n.is_null() { return nothing_placed(); }
    if !aenv::have_env() { return nothing_placed(); }
    if !aenv::have_host() { return nothing_placed(); }
    let e: rt::Env = aenv::env();

    let own: *u8 = core::view_of(n);
    if own.is_not_null() {
        var v: w::View = w::View::from_global(e, own);
        let wd: f64 = { v.get_width() as f64 };
        let ht: f64 = { v.get_height() as f64 };
        paint::unwrap_keep(v);
        let o: Offset = offset_to_host(e, own);
        if !o.ok { return nothing_placed(); }
        return Placed {
            view: own,
            rect: Rect { x: o.x, y: o.y, w: wd, h: ht },
            found: true,
        };
    }

    // A viewless node is not a node without a place — it is a node drawn inside
    // someone else's view, so its flex offsets accumulate up to the nearest
    // backed ancestor and the answer is that ancestor's rect plus the offset.
    // Same walk as the two Apple halves; the crossing into pixels happens once,
    // at the end, because flex speaks facet's units and the view chain speaks
    // the screen's.
    let f: flex::Frame = core::frame_of(n);
    var x: f64 = f.left;
    var y: f64 = f.top;
    let wd: f64 = f.width;
    let ht: f64 = f.height;

    var cur: *core::Node = n;
    var steps: usize = 0;
    while steps < 256 {
        let p: *core::Node = match mount::parent_of(cur) {
            option::Option[*core::Node]::Some(q) => q,
            option::Option::None => 0 as *core::Node,
        };
        if p.is_null() {
            // THE ROOT ITSELF IS OFTEN VIEWLESS, and that is the ordinary shape
            // rather than an edge: an app whose page is a plain column gets no
            // view for it, and `window::add_root_views` hands the backed
            // DESCENDANTS to the Activity's host directly. So the walk running
            // out of parents does not mean "nowhere to draw" here the way it
            // does on the two Apple halves, where the window's content view is
            // always the last backed ancestor. The host IS the anchor.
            //
            // The offset is the one `geometry::reposition` applies: facet's
            // point is the host's point less the safe-area inset, asked for
            // rather than recomputed. `cur` is the root, and its own frame
            // offset came into `x`/`y` on the last step, so it comes back off.
            let rf: flex::Frame = core::frame_of(cur);
            return Placed {
                view: 0 as *u8,
                rect: Rect {
                    x: aenv::px(x - rf.left + geometry::inset_left()),
                    y: aenv::px(y - rf.top + geometry::inset_top()),
                    w: aenv::px(wd),
                    h: aenv::px(ht),
                },
                found: true,
            };
        }
        let pv: *u8 = core::view_of(p);
        if pv.is_not_null() {
            let o: Offset = offset_to_host(e, pv);
            if !o.ok { return nothing_placed(); }
            return Placed {
                // NO VIEW OF ITS OWN, said by the field rather than implied by
                // a rectangle: `native_props` reads the same node and answers
                // "(drawn by an ancestor)" for exactly this case.
                view: 0 as *u8,
                rect: Rect {
                    x: o.x + aenv::px(x),
                    y: o.y + aenv::px(y),
                    w: aenv::px(wd),
                    h: aenv::px(ht),
                },
                found: true,
            };
        }
        let pf: flex::Frame = core::frame_of(p);
        x = x + pf.left;
        y = y + pf.top;
        cur = p;
        steps = steps +% 1;
    }
    return nothing_placed();
}

// ---- the glide ---------------------------------------------------------------
//
// WHY THIS IS WRITTEN HERE AND ON NEITHER APPLE HALF. The highlight slides from
// one control to the next on AppKit and UIKit and NOBODY WROTE THAT. The
// overlay there is a CALayer, `highlight` reuses the same one every time, and a
// CALayer animates a `frame` change IMPLICITLY — a quarter of a second, ease in
// ease out, for free. Android has neither half of it: a plain View has no
// implicit animation, and this file built a NEW overlay on every call, so there
// was no "from" to move out of even if it had one.
//
// Both halves are supplied now. The overlay is made once and reused (see
// `highlight`), and the move between two rectangles is stepped by the backend's
// own `after` timer. Fifteen steps of a sixtieth of a second is CoreAnimation's
// own default duration, and `t*t*(3-2t)` is near enough its ease curve to sit
// beside the other two backends without looking like a different product.
//
// A TWEEN, NOT AN ANIMATOR, and that is deliberate. `ViewPropertyAnimator` can
// move x and y but not width and height — it offers scaleX/scaleY instead,
// which would stretch the 1dp border into a smear every time the box grows.
// Placing the real rectangle each tick keeps that stroke exactly 1dp the whole
// way across, which is the thing a highlight is FOR.
//
// IT IS A TIMER, NOT A FRAME CALLBACK, and this is the one honest compromise.
// `scheduler::schedule` is `postOnAnimation` and would land each step on the
// Choreographer exactly; `after` is `postDelayed`, so a step can arrive a
// millisecond off its frame. For a 250ms move of a rectangle nobody is
// measuring, a dropped or doubled frame is invisible — and `schedule` is facet's
// own sync channel, which an overlay that is not a facet node must not enter.
const GLIDE_STEPS: i32 = 15;
const GLIDE_TICK: f64 = 0.0166;

// Where the overlay IS, where it started, and where it is going. `CUR` is the
// one that matters between glides: a move interrupted half way starts from
// where the box actually is rather than from where the last one was aimed.
static CUR: Rect = #zero::[Rect]();
static FROM: Rect = #zero::[Rect]();
static TO: Rect = #zero::[Rect]();
static STEP: i32 = 0;
static GLIDE_TOKEN: u64 = 0;

fn place_overlay(r: Rect) {
    if OVERLAY == 0 { return; }
    let ov: jni::jobject = { OVERLAY as jni::jobject };
    geometry::place(ov, r.x, r.y, r.w, r.h);
}

fn stop_glide() {
    if GLIDE_TOKEN == 0 { return; }
    sched::cancel_after(GLIDE_TOKEN);
    GLIDE_TOKEN = 0;
}

fn lerp(a: f64, b: f64, t: f64) -> f64 { return a + { (b - a) * t }; }

// Start a move. An existing one is abandoned WHERE IT IS rather than snapped to
// its destination first: clicking down a list of nodes faster than 250ms is the
// normal way to use an inspector, and finishing each move before starting the
// next would run the box a whole step behind the selection.
fn glide_to(want: Rect) {
    stop_glide();
    FROM = CUR;
    TO = want;
    STEP = 0;
    GLIDE_TOKEN = sched::after(GLIDE_TICK, glide_tick, 0 as *u8);
    // A timer that could not be scheduled — no env, no host, or all 64 slots
    // taken — is not a reason to leave the highlight behind on the last node.
    if GLIDE_TOKEN == 0 {
        CUR = want;
        place_overlay(want);
    }
}

fn glide_tick(_ctx: *u8) {
    GLIDE_TOKEN = 0;
    if OVERLAY == 0 { return; }
    if !aenv::have_env() { return; }
    STEP = STEP + 1;
    let raw: f64 = { STEP as f64 } / { GLIDE_STEPS as f64 };
    let t: f64 = if raw > 1.0 { 1.0 } else { raw };
    let e: f64 = { t * t } * { 3.0 - { 2.0 * t } };
    CUR = Rect {
        x: lerp(FROM.x, TO.x, e),
        y: lerp(FROM.y, TO.y, e),
        w: lerp(FROM.w, TO.w, e),
        h: lerp(FROM.h, TO.h, e),
    };
    place_overlay(CUR);
    if STEP >= GLIDE_STEPS {
        // Land exactly on it. Fifteen lerps of a float do not have to arrive,
        // and a highlight one pixel off the control it names is the one error
        // this whole file exists to avoid.
        CUR = TO;
        place_overlay(CUR);
        return;
    }
    GLIDE_TOKEN = sched::after(GLIDE_TICK, glide_tick, 0 as *u8);
}

// ---- native rows -------------------------------------------------------------

fn native_props(n: *core::Node) -> vec::Vec[insp::Prop] {
    var out: vec::Vec[insp::Prop] = vec::new::[insp::Prop]();
    let v: *u8 = core::view_of(n);
    if v.is_null() {
        // Not an absence of information — a fact about the node, and the one
        // that explains why it has no frame of its own. Same sentence as the
        // other two, deliberately.
        let _a: status::Status = out.append(insp::Prop::read_only(
            "native_class", insp::Value::Str(text::from_str("(drawn by an ancestor)"))));
        return out;
    }
    if !aenv::have_env() {
        let _b: status::Status = out.append(insp::Prop::read_only(
            "native_class", insp::Value::Str(text::from_str("(no JNI environment)"))));
        return out;
    }
    let e: rt::Env = aenv::env();

    // `android.widget.TextView`, the object's OWN class — not the role, and not
    // a name derived from the kind. agent_android reports the role instead and
    // says why (a JNI round trip per node, to re-learn what the kind already
    // said); an inspector row is one node at a time and the fact is the point.
    var buf: [u8; 256] = #zero::[[u8; 256]]();
    let base: *u8 = { #addr_of(buf[0]) };
    var name: text::Text = text::from_str("(unreadable)");
    if class_name_of(e, v, base, 256) {
        name = text::from_str({ #str_from_raw_parts(base, paint::cstr_len(base)) });
    }
    let _c: status::Status = out.append(insp::Prop::read_only(
        "native_class", insp::Value::Str(name)));

    var view: w::View = w::View::from_global(e, v);
    // VISIBLE is 0; INVISIBLE and GONE are both "not showing", and the pair the
    // other two backends report as one bool. The distinction between them is a
    // layout question this row is not asked.
    let vis: i32 = view.get_visibility();
    let _d: status::Status = out.append(insp::Prop::read_only(
        "native_hidden", insp::Value::Bool(vis != 0)));

    // IN FACET'S UNITS, so the row beside it is comparable. The frame Android
    // holds is in physical pixels and would read three times too large on a
    // normal phone; `native_density` below is what makes the pixel numbers in a
    // `dumpsys` or a layout inspector recoverable from this.
    let left: f64 = aenv::dp({ view.get_left() as f64 });
    let top: f64 = aenv::dp({ view.get_top() as f64 });
    let wd: f64 = aenv::dp({ view.get_width() as f64 });
    let ht: f64 = aenv::dp({ view.get_height() as f64 });
    var geom: text::Text = text::from_str("");
    let _e1: status::Status = geom.append({ (left as i64) }.to_text().view());
    let _e2: status::Status = geom.append(", ");
    let _e3: status::Status = geom.append({ (top as i64) }.to_text().view());
    let _e4: status::Status = geom.append(", ");
    let _e5: status::Status = geom.append({ (wd as i64) }.to_text().view());
    let _e6: status::Status = geom.append(", ");
    let _e7: status::Status = geom.append({ (ht as i64) }.to_text().view());
    let _e8: status::Status = out.append(insp::Prop::read_only(
        "native_frame", insp::Value::Str(geom)));

    let _f1: status::Status = out.append(insp::Prop::read_only(
        "native_density", insp::Value::Num(aenv::density())));

    // Android asks the view itself, as UIKit does, where AppKit asks the window
    // whose one first responder it is. Same question, and this is the phrasing
    // this toolkit ships.
    let _g1: status::Status = out.append(insp::Prop::read_only(
        "first_responder", insp::Value::Bool(view.is_focused())));
    paint::unwrap_keep(view);
    return out;
}

// ---- installation ------------------------------------------------------------

fn install() {
    tree::install_platform(highlight, clear_highlight);
    tree::set_native_fn(native_props);
    mcp::set_marshal(run_on_main_sync);
}

// The launcher's channel, and it is the one part of this file with no analogue
// on either Apple platform.
//
// AN ANDROID APP HAS NO ENVIRONMENT TO SET. `simctl launch` passes
// `SIMCTL_CHILD_FACET_INSPECT` through to the process it starts, and a desktop
// binary is spawned by the IDE with a whole environment; `am start` takes an
// Intent, and the environment an Activity inherits belongs to zygote. So the
// port arrives as a SYSTEM PROPERTY, which is Android's own configuration
// channel and the one every debug switch on the platform already uses:
//
//     adb shell setprop debug.facet.inspect 8787
//     adb shell am start -n <pkg>/cplus.facet.FacetActivity
//     adb forward tcp:8787 tcp:8787
//
// `debug.` is the prefix adb shell may write without root, on a stock emulator
// and on a stock device — which is what makes this a channel a launcher can
// actually use rather than one that needs a rooted build.
//
// A PORT AND NOT A PATH, for the reason facet_agent's Android facade already
// records: an app's files live under /data/data/<pkg>, which the development
// machine cannot reach, so a Unix socket is as unreachable here as it is inside
// an iOS sandbox. `adb forward` is the counterpart of usbmuxd and the same MCP
// client talks to both without knowing which it reached.
//
// `FACET_INSPECT` is read too, and second. Nothing on a device sets it; a
// host-side harness that dlopen's the .so and calls the entry directly can, and
// then the variable means what it means everywhere else.
// PROP_VALUE_MAX is 92 and the buffer must be at least that: the platform
// writes up to it and does not take a capacity.
#[link_name = "__system_property_get"]
extern fn system_property_get(name: *u8, value: *u8) -> i32;

fn asked_port() -> text::Text {
    var buf: [u8; 96] = #zero::[[u8; 96]]();
    let base: *u8 = { #addr_of(buf[0]) };
    let n: i32 = { system_property_get(#str_ptr("debug.facet.inspect\0"), base) };
    if n > 0 {
        return text::from_str({ #str_from_raw_parts(base, { n as usize }) });
    }
    return match env::var("FACET_INSPECT") {
        option::Option[text::Text]::Some(p) => p,
        option::Option::None => text::new(),
    };
}

// Serve the inspector IF the launcher asked. Everything it does is the explicit
// wiring the other two entries spell out: the platform half, the armed
// namespace, and the serving thread. Arming stays a deliberate act — linking
// this package in still exposes nothing; only the launcher that set the
// property gets a listener.
// Arm the inspector namespace on the agent's socket, WITHOUT binding anything.
//
// This is the half an application actually chooses. `agent_mcp` decides whether
// this process serves at all and at what address; this decides whether the
// twelve `inspector.*` verbs are among what it serves. Separating them is the
// point: there is one server and one consent gate, and the inspector is a
// namespace inside it rather than a second door with its own socket.
//
// STILL EXPLICIT. Linking this package in exposes nothing — a process that
// never calls `arm` answers "method not found" to every `inspector.*` method,
// and the agent's policy still runs first and covers this namespace too.
// Arming opens a door; it is not a way around the gate.
//
// Call it before the host, beside `agent_mcp`:
//
//     agent::enable();
//     inspect::arm();
//     runtime::agent_mcp("/tmp/myapp.sock");
//     runtime::run_screen(Home::new());
//
fn arm() {
    install();
    mcp::arm(tree::local_backend());
}

