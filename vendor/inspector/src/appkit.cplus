// appkit — the one thing facet's own tree cannot answer.
//
// Everything else in this package is portable: the walker reads facet's
// mounted tree, and the setters go through facet's own verbs. What needs the
// platform is drawing a rectangle over a window without becoming part of the
// UI, plus reading back what the platform owns for the native panel.
//
// That asymmetry is the payoff for walking facet rather than NSView. The agent
// surface needed a whole backend per platform because it walks the native
// hierarchy; the inspector needs one walker plus this file.
//
// ---- the overlay is a layer, not a view --------------------------------------
//
// A highlight must not participate in layout, must not intercept a hit test,
// and must not appear in the tree it is drawn over. A CALayer satisfies all
// three by construction: layers are not views, they do not lay out, they are
// not hit-tested, and nothing that walks `subviews` or facet's tree will ever
// see one. A transparent overlay VIEW would have had to be excluded from three
// different walks and would still have been in the responder chain.
//
// It is attached to the window's CONTENT view rather than to the node's own
// view, so the inspected view is never modified — not its layer-backing, not
// its sublayers, not its rendering path. The rect is converted into the
// content view's space instead.

import "stdlib/vec" as vec;
import "stdlib/text" as text;
import "stdlib/option" as option;
import "stdlib/status" as status;
import "flex_layout/flex_layout" as flex;
import "objc/runtime" as rt;
import "objc/bridge" as bridge;
import "appkit/appkit" as ak;
import "quartzcore/quartzcore" as qc;
import "facet/facet" as core;
import "facet/application" as app;
import "facet/mount" as mount;
import "./inspector" as insp;
import "./tree" as tree;

#[link_name = "CGColorCreateGenericRGB"]
extern fn cg_rgba(r: f64, g: f64, b: f64, a: f64) -> *u8;

#[link_name = "NSStringFromClass"]
extern fn ns_string_from_class(c: *u8) -> *u8;

// The overlay layer and its two colours, made once. A CGColor from
// `CGColorCreate*` arrives at +1; holding both for the life of the process is
// two allocations, against one per highlight if they were made per call.
static OVERLAY: *u8 = 0 as *u8;
static FILL: *u8 = 0 as *u8;
static STROKE: *u8 = 0 as *u8;

fn ensure_colours() {
    if FILL == (0 as *u8) {
        // A wash plus a solid edge. Two channels, not one: a fill alone
        // disappears over busy content and an edge alone is invisible on a
        // one-pixel control.
        FILL = cg_rgba(0.13f64, 0.47f64, 1.0f64, 0.22f64);
        STROKE = cg_rgba(0.13f64, 0.47f64, 1.0f64, 0.95f64);
    }
    return;
}

fn overlay_layer() -> qc::Layer {
    ensure_colours();
    if OVERLAY == (0 as *u8) {
        let l: qc::Layer = qc::Layer::new();
        l.set_background_color(FILL);
        l.set_border_color(STROKE);
        l.set_border_width(1.0f64);
        l.set_corner_radius(2.0f64);
        // Above whatever the application drew into the same layer tree.
        l.set_z_position(10000.0f64);
        OVERLAY = rt::retain(l.raw());
        return l;
    }
    return qc::Layer::from_raw(OVERLAY);
}

// ---- resolving a node to a rectangle -----------------------------------------

// Where a node is, in the coordinate space of the nearest ancestor that has a
// backing view.
//
// A node with its own view is its own answer. A VIEWLESS node is not a node
// without a place — it is a node whose place is inside someone else's view: a
// span is a run in its label's string, a menu item a row in its menu. Its flex
// frame is relative to its parent, so the offsets accumulate up the chain
// until a backed ancestor is reached, and the result is a rect in that view.
// `view` is BORROWED — the backend that mounted it owns it and releases it
// through the node's `view_release`. This struct is a short-lived answer, not
// a second owner, so it carries no destructor and says so.
struct Placed {
    opaque view: *u8,
    rect: rt::Rect,
    found: bool,
}

fn place(n: *core::Node) -> Placed {
    let none: Placed = Placed {
        view: 0 as *u8,
        rect: rt::Rect { x: 0.0f64, y: 0.0f64, w: 0.0f64, h: 0.0f64 },
        found: false,
    };
    if n == (0 as *core::Node) { return none; }

    let own: *u8 = core::view_of(n);
    if own != (0 as *u8) {
        let b: rt::Rect = { ak::View::from_raw(own).bounds() };
        return Placed { view: own, rect: b, found: true };
    }

    let f: flex::Frame = core::frame_of(n);
    var x: f64 = f.left;
    var y: f64 = f.top;
    let w: f64 = f.width;
    let h: f64 = f.height;

    var cur: *core::Node = n;
    // Bounded by the tree's own depth; a parent link always goes up.
    var steps: usize = 0 as usize;
    while steps < (256 as usize) {
        let p: *core::Node = match mount::parent_of(cur) {
            option::Option[*core::Node]::Some(q) => q,
            option::Option[*core::Node]::None => 0 as *core::Node,
        };
        if p == (0 as *core::Node) { return none; }
        let pv: *u8 = core::view_of(p);
        if pv != (0 as *u8) {
            let host: ak::View = ak::View::from_raw(pv);
            var top: f64 = y;
            // facet's hosts are flipped, so flex's top-left origin is the
            // view's own. Asked at runtime rather than assumed, because a host
            // that is not flipped would put every highlight on the wrong side
            // of the window and look like a layout bug.
            if !host.is_flipped() {
                let hb: rt::Rect = host.bounds();
                top = hb.h - y - h;
            }
            return Placed {
                view: pv,
                rect: rt::Rect { x: x, y: top, w: w, h: h },
                found: true,
            };
        }
        let pf: flex::Frame = core::frame_of(p);
        x = x + pf.left;
        y = y + pf.top;
        cur = p;
        steps = steps +% (1 as usize);
    }
    return none;
}

// ---- highlight ---------------------------------------------------------------

fn clear_highlight(_s: *u8) {
    if OVERLAY == (0 as *u8) { return; }
    let l: qc::Layer = qc::Layer::from_raw(OVERLAY);
    l.remove_from_superlayer();
    return;
}

fn highlight(s: *u8, h: insp::Handle) {
    clear_highlight(s);
    if !h.is_live() { return; }
    let p: Placed = place(h.node);
    if !p.found { return; }

    let target: ak::View = ak::View::from_raw(p.view);
    let win: ak::Window = match target.window() {
        option::Option[ak::Window]::Some(w) => w,
        option::Option[ak::Window]::None => { return; }
    };
    let content: ak::View = match win.content_view() {
        option::Option[ak::View]::Some(c) => c,
        option::Option[ak::View]::None => { return; }
    };

    // Into the content view's space, which is where the overlay lives. The
    // conversion carries flipped-ness across, so this is one call rather than
    // a coordinate argument this module has to get right twice.
    let r: rt::Rect = target.convert_rect_to_view(p.rect, content);

    content.set_wants_layer(true);
    let host: qc::Layer = content.layer();
    if host.raw() == (0 as *u8) { return; }

    let l: qc::Layer = overlay_layer();
    l.set_frame(r);
    host.add_sublayer(l);
    return;
}

// ---- native rows -------------------------------------------------------------

// What the platform owns, for the third panel. Read-only by construction: a
// native class name is not something an inspector can set, and saying so with
// no editor is clearer than an editor that refuses.
fn native_props(n: *core::Node) -> vec::Vec[insp::Prop] {
    var out: vec::Vec[insp::Prop] = vec::new::[insp::Prop]();
    let v: *u8 = core::view_of(n);
    if v == (0 as *u8) {
        // Not an absence of information — a fact about the node, and the one
        // that explains why it has no frame of its own.
        let _a: status::Status = out.append(insp::Prop::read_only(
            "native_class", insp::Value::Str(text::from_str("(drawn by an ancestor)"))));
        return out;
    }

    let cls: *u8 = rt::msg_id(v, rt::sel(#str_ptr("class\0")));
    let name: text::Text = bridge::to_text(ns_string_from_class(cls));
    let _b: status::Status = out.append(insp::Prop::read_only(
        "native_class", insp::Value::Str(name)));

    let view: ak::View = ak::View::from_raw(v);
    let _c: status::Status = out.append(insp::Prop::read_only(
        "native_hidden", insp::Value::Bool(view.is_hidden())));

    let f: rt::Rect = view.frame();
    var geom: text::Text = text::from_str("");
    let _d: status::Status = geom.append({ (f.x as i64) }.to_text().view());
    let _e: status::Status = geom.append(", ");
    let _f2: status::Status = geom.append({ (f.y as i64) }.to_text().view());
    let _g: status::Status = geom.append(", ");
    let _h: status::Status = geom.append({ (f.w as i64) }.to_text().view());
    let _i: status::Status = geom.append(", ");
    let _j: status::Status = geom.append({ (f.h as i64) }.to_text().view());
    let _k: status::Status = out.append(insp::Prop::read_only(
        "native_frame", insp::Value::Str(geom)));

    match view.window() {
        option::Option[ak::Window]::Some(w) => {
            let fr: *u8 = rt::msg_id(w.raw(), rt::sel(#str_ptr("firstResponder\0")));
            let _l: status::Status = out.append(insp::Prop::read_only(
                "first_responder", insp::Value::Bool(fr == v)));
        }
        option::Option[ak::Window]::None => { }
    }
    return out;
}

// ---- installation ------------------------------------------------------------

// Hand the portable side its platform. Until this is called the inspector
// still works — it just cannot highlight, and says so through the no-ops
// rather than by crashing.
fn install() {
    tree::install_platform(highlight, clear_highlight);
    tree::set_native_fn(native_props);
    return;
}
