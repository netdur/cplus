// tree — the facet-tree walker and the typed property dispatch.
//
// This is the inspector's read and write path, and it is PORTABLE. It walks
// facet's own mounted tree, not a platform's view hierarchy, which is what
// lets one implementation serve every backend. The agent surface needed an
// `agent_appkit` because it walks `NSView`; the inspector needs a platform
// module only for the two things facet genuinely cannot answer — where the
// pointer is, and how to draw a highlight over a window.
//
// Walking facet rather than the platform is also the only way to see:
//   - pure-layout nodes, which have no view at all;
//   - spans and menu items, which are runs and rows inside someone else's view;
//   - what the application DECLARED, as against what layout computed;
//   - the dirty word, which is the whole of facet's update model.
//
// ---- the three tiers ----------------------------------------------------------
//
// Writable properties are not one flat set. They fall into three tiers, and
// only the third needs to know what control it is talking to:
//
//   1. THE COMMON BAND. `props::CommonProps` is inline on EVERY node — opacity,
//      background, corners, shadow, visibility, transform. One reader and one
//      writer each, no kind dispatch, all 38 control kinds and every bare
//      container at once.
//   2. FLEX STYLE. facet's tree IS flex's tree, so width, padding, margin, gap,
//      grow and shrink are style writes plus `C_LAYOUT`. Also uniform.
//   3. CONTROL PROPS. `text` on a label, `title` on a button. These live behind
//      the typed handles the generator emits, and those are reachable only by
//      key — so tier 3 answers `Unsupported` on an unkeyed node. That is a real
//      v1 limit, reported rather than hidden, and it closes when
//      `gen_contract.py` emits an inspector dispatch layer.
//
// ---- what this module must never do -------------------------------------------
//
// Never raise `C_FOCUS`, `C_BLUR` or `C_FLUSH`. Those three are COMMANDS the
// backend performs and clears, not state it re-reads. Re-applying a node with
// every bit set re-issues them, and the symptom is the caret vanishing from
// whatever the user was typing into on an unrelated node's update. Every write
// below names the one bit it changed; the only wholesale re-read is
// `core::touch_all`, which is `C_ALL_STATE` and excludes the commands by
// construction.
//
// Never write the platform view directly. A native-only write leaves facet's
// declared state stale and is overwritten by the next sync walk. Every edit
// goes through the same setters an application calls, so it takes the same
// path: prop, dirty bit, scheduled sync, backend apply.

import "stdlib/vec" as vec;
import "stdlib/text" as text;
import "stdlib/option" as option;
import "stdlib/status" as status;
import "flex_layout/flex_layout" as flex;
import "facet/facet" as core;
import "facet/application" as app;
import "facet/elements" as ui;
import "facet/mount" as mount;
import "facet/vocabulary" as vocab;
import "facet/props" as props;
import "stdlib/str" as _;
import "facet/label" as label;
import "facet/button" as button;
import "facet/text_field" as text_field;
import "facet/text_area" as text_area;
import "facet/checkbox" as checkbox;
import "facet/toggle" as toggle;
import "./inspector" as insp;
import "./vocabulary" as voc;

// ---- the override ledger -----------------------------------------------------

// What a property was before the inspector first wrote it.
//
// Reset has to restore what the APPLICATION declared, not the type's default.
// An app that shipped `opacity: 0.8` and an inspector that resets to 1.0 has
// not undone the experiment — it has started a second one. So the first write
// to a given (node, property) records the old value and every later write to
// the same pair leaves that record alone.
//
// Volatile by design: the ledger dies with the process and is not consulted
// when a node is rebuilt. An inspector that silently reapplied edits to new
// nodes would be an application state store wearing a development tool's
// clothes. `snippet_for` is the deliberate, explicit way an experiment leaves
// this process — the developer copies it into source.
struct Override {
    opaque node: *core::Node,
    // The window the write went through. Reading the CURRENT value back for the
    // diff needs a `Handle`, and a handle needs a window — tier 3 resolves a
    // control by key from that window's root. Recorded here rather than
    // searched for later: the write had it.
    window: usize,
    // A borrowed {ptr,len}, and sound only because every name that reaches here
    // is a literal from `declared_names`. A caller-supplied name — a property
    // parsed off a socket into a request-scoped `Text` — must be exchanged for
    // ours through `canonical_prop` first, or this record outlives its bytes
    // and `reset` quietly matches nothing. See that function.
    prop: str,
    original: insp::Value,
}

static OVERRIDES: vec::Vec[Override] = #zero::[vec::Vec[Override]]();

// The inspector UI's own subtree root, if it is embedded in the tree it is
// inspecting. Marked rather than skipped: the walk has one descent rule, and
// the listing carries `is_inspector` so a UI can filter. An inspector that
// offers its own panel as something to restyle is a tool inviting you to
// break your view of the thing you are debugging.
static SELF_ROOT: *core::Node = 0 as *core::Node;

fn mark_self(n: *core::Node) { SELF_ROOT = n; return; }
fn self_root() -> *core::Node { return SELF_ROOT; }
fn clear_self() { SELF_ROOT = 0 as *core::Node; return; }

fn ledger_index(n: *core::Node, prop: str) -> option::Option[usize] {
    var i: usize = 0;
    let c: usize = OVERRIDES.count();
    while i < c {
        match OVERRIDES.at_ptr(i) {
            option::Option[*Override]::Some(p) => {
                if { (*p).node } == n {
                    if { (*p).prop } == prop { return option::Option[usize]::Some(i); }
                }
            }
            option::Option::None => { }
        }
        i = i +% 1;
    }
    return option::Option[usize]::None;
}

fn is_overridden(n: *core::Node, prop: str) -> bool {
    return match ledger_index(n, prop) {
        option::Option[usize]::Some(_i) => true,
        option::Option::None => false,
    };
}

// Record only the FIRST write. A second edit to the same property must not
// overwrite the application's value with the inspector's own earlier one.
fn ledger_record(n: *core::Node, window: usize, prop: str, take original: insp::Value) {
    match ledger_index(n, prop) {
        option::Option[usize]::Some(_i) => { return; }
        option::Option::None => { }
    }
    let _s: status::Status = OVERRIDES.append(Override {
        node: n, window: window, prop: prop, original: original,
    });
}

// Duplicate the record, THEN drop it. `Override` owns a `Value` which owns a
// `Text`, so the field cannot be moved out of it — and the copy has to be
// taken before the removal anyway, because removal is what runs the
// destructor that would free the bytes the answer points at.
fn ledger_take(n: *core::Node, prop: str) -> option::Option[insp::Value] {
    return match ledger_index(n, prop) {
        option::Option[usize]::Some(i) => {
            var copied: insp::Value = insp::Value::Nothing;
            match OVERRIDES.at_ptr(i) {
                option::Option[*Override]::Some(p) => { copied = { (*p).original }.clone(); }
                option::Option::None => { }
            }
            let _gone: option::Option[Override] = OVERRIDES.remove(i);
            option::Option[insp::Value]::Some(copied)
        }
        option::Option::None => option::Option[insp::Value]::None,
    };
}

fn override_count() -> usize { return OVERRIDES.count(); }

// Drop every record without restoring anything. For tests and for a session
// that is starting over; NOT what `reset` does.
fn forget_all_overrides() {
    OVERRIDES.remove_all();
}

// ---- the walk ----------------------------------------------------------------

fn row_of(
    n: *core::Node,
    parent: option::Option[usize],
    depth: usize,
    window: usize,
    mine: bool,
) -> insp::Node {
    return insp::Node {
        handle: insp::Handle::of(n, window),
        parent: parent,
        depth: depth,
        key: text::from_str({ (*n).key() }),
        slot: text::from_str(core::slot_of(n)),
        kind: core::kind_of(n),
        frame: core::frame_of(n),
        has_view: core::view_of(n) != (0 as *u8),
        is_attached: core::is_attached(n),
        is_focused: core::is_focused(n),
        is_visible: core::is_visible(n),
        dirty: core::dirty_of(n),
        child_count: core::child_count_of(n),
        agent_tier: match core::agent(n) {
            vocab::Agent::Open => 0,
            vocab::Agent::Protected => 1,
            vocab::Agent::Private => 2,
            vocab::Agent::Hidden => 3,
        },
        is_inspector: mine,
    };
}

fn walk(
    n: *core::Node,
    parent: option::Option[usize],
    depth: usize,
    window: usize,
    in_self: bool,
    out: *vec::Vec[insp::Node],
) {
    if n.is_null() { return; }
    var mine: bool = in_self;
    if SELF_ROOT.is_not_null() {
        if n == SELF_ROOT { mine = true; }
    }
    let idx: usize = { (*out).count() };
    let _s: status::Status = { (*out).append(row_of(n, parent, depth, window, mine)) };
    var i: usize = 0;
    let c: usize = core::child_count_of(n);
    while i < c {
        match core::child_of(n, i) {
            option::Option[*core::Node]::Some(ch) => {
                walk(ch, option::Option[usize]::Some(idx), depth +% 1,
                     window, mine, out);
            }
            option::Option::None => { }
        }
        i = i +% 1;
    }
    return;
}

// Every mounted node in every window of the running app, in window-open order
// and then document order — the same order `mount::find` resolves in, so a row
// number and a key lookup never disagree about which node is "first".
fn describe() -> vec::Vec[insp::Node] {
    var out: vec::Vec[insp::Node] = vec::new::[insp::Node]();
    var w: usize = 0;
    let n: usize = app::window_count();
    while w < n {
        let r: *core::Node = app::window_root(w);
        if r.is_not_null() {
            walk(r, option::Option[usize]::None, 0, w, false, #addr_of(out));
        }
        w = w +% 1;
    }
    return out;
}

// ---- reading -----------------------------------------------------------------

fn num(v: f64) -> option::Option[insp::Value] {
    return option::Option[insp::Value]::Some(insp::Value::Num(v));
}
fn boolean(v: bool) -> option::Option[insp::Value] {
    return option::Option[insp::Value]::Some(insp::Value::Bool(v));
}
fn owned(v: str) -> option::Option[insp::Value] {
    return option::Option[insp::Value]::Some(insp::Value::Str(text::from_str(v)));
}
fn colour(v: vocab::Color) -> option::Option[insp::Value] {
    return option::Option[insp::Value]::Some(insp::Value::Color(v));
}

// A style length as a value. Only points survive the round trip: an `auto` or
// a percent has no number an inspector could hand back unchanged, and
// answering 0.0 for `auto` would be a lie the UI would then write back as a
// real zero. Unset reads as `Nothing`, which the UI draws as an empty field.
fn as_points(l: flex::StyleLength) -> option::Option[f64] {
    return match l.unit {
        flex::Unit::Point => option::Option[f64]::Some(l.value),
        _ => option::Option[f64]::None,
    };
}

fn same_points(l: flex::StyleLength, x: f64) -> bool {
    return match as_points(l) {
        option::Option[f64]::Some(y) => y == x,
        option::Option::None => false,
    };
}

fn plain_num(x: f64) -> text::Text {
    // Whole numbers read as whole numbers. This is the value a person copies
    // back into source, so `50%` beats `50.000000%`.
    let r: f64 = x - (((x as i64) as f64));
    if r == 0.0 { return { (x as i64) }.to_text(); }
    return x.to_text();
}

// A length answers as the thing a developer would write.
//
// Points are a number. A percent and `auto` are STRINGS, because they are not
// numbers and answering the bare scalar of a percent would be read back as
// points — the nudge loop's worst failure, where reading a value and writing it
// straight back moves the element. Unset is `Nothing`, which draws as an empty
// field and means "the app never said".
fn len_value(l: flex::StyleLength) -> insp::Value {
    return match l.unit {
        flex::Unit::Point => insp::Value::Num(l.value),
        flex::Unit::Percent => {
            var t: text::Text = plain_num(l.value);
            let _a: status::Status = t.append("%");
            insp::Value::Str(t)
        }
        flex::Unit::Auto => insp::Value::Str(text::from_str("auto")),
        _ => insp::Value::Nothing,
    };
}

// And the same three shapes on the way in. `Nothing` CLEARS — it is what a
// reset of a property the app never set puts back, and without it the round
// trip has a hole exactly where an unset length is.
fn length_of(v: insp::Value) -> option::Option[flex::StyleLength] {
    return match v {
        insp::Value::Num(x) => option::Option[flex::StyleLength]::Some(flex::StyleLength::points(x)),
        insp::Value::Int(i) => option::Option[flex::StyleLength]::Some(flex::StyleLength::points(i as f64)),
        insp::Value::Nothing => option::Option[flex::StyleLength]::Some(flex::StyleLength::undefined()),
        insp::Value::Str(t) => parse_length(t.view()),
        _ => option::Option[flex::StyleLength]::None,
    };
}

fn parse_length(spelled: str) -> option::Option[flex::StyleLength] {
    let t: str = spelled.trim();
    if t == "auto" { return option::Option[flex::StyleLength]::Some(flex::StyleLength::auto()); }
    if t == "" { return option::Option[flex::StyleLength]::Some(flex::StyleLength::undefined()); }
    if t.has_suffix("%") {
        return match t.drop_last(1).trim().to_f64() {
            option::Option[f64]::Some(x) =>
                option::Option[flex::StyleLength]::Some(flex::StyleLength::percent(x)),
            option::Option::None => option::Option[flex::StyleLength]::None,
        };
    }
    // A bare number in a string is points — a client that sends "12" for a
    // length means 12, and refusing it teaches nothing.
    return match t.to_f64() {
        option::Option[f64]::Some(x) =>
            option::Option[flex::StyleLength]::Some(flex::StyleLength::points(x)),
        option::Option::None => option::Option[flex::StyleLength]::None,
    };
}

// Four edges agree, or the answer is `Nothing`. A single `padding` box that
// silently shows only the left edge is how a developer sets all four to the
// value that was already on one of them.
//
// Compared as lengths rather than as `Value`s: matching a `Value` moves it,
// and a comparison that consumes one of its operands cannot then return it.
fn uniform(a: flex::StyleLength, b: flex::StyleLength,
           c: flex::StyleLength, d: flex::StyleLength) -> insp::Value {
    return match as_points(a) {
        option::Option[f64]::Some(x) => {
            if !same_points(b, x) { return insp::Value::Nothing; }
            if !same_points(c, x) { return insp::Value::Nothing; }
            if !same_points(d, x) { return insp::Value::Nothing; }
            insp::Value::Num(x)
        }
        option::Option::None => insp::Value::Nothing,
    };
}

// Tier 1 + tier 2: everything readable without knowing the control kind.
fn get_uniform(n: *core::Node, prop: str) -> option::Option[insp::Value] {
    // ---- tier 1: the common band ----
    if prop == "opacity" { return num(core::opacity(n)); }
    if prop == "visible" { return boolean(core::is_visible(n)); }
    if prop == "enabled" { return boolean(core::is_enabled(n)); }
    if prop == "input_transparent" { return boolean(core::input_transparent(n)); }
    if prop == "background_color" { return colour(core::background_color(n)); }
    if prop == "tooltip" { return owned(core::tooltip(n)); }
    if prop == "accessibility_label" { return owned(core::accessibility_label(n)); }
    if prop == "rotation" { return num(core::rotation(n)); }
    if prop == "rotation_x" { return num(core::rotation_x(n)); }
    if prop == "rotation_y" { return num(core::rotation_y(n)); }
    if prop == "scale_x" { return num(core::scale_x(n)); }
    if prop == "scale_y" { return num(core::scale_y(n)); }
    if prop == "scale" { return num(core::scale(n)); }
    if prop == "translation_x" { return num(core::translation_x(n)); }
    if prop == "translation_y" { return num(core::translation_y(n)); }
    if prop == "corner_radius" {
        let c: vocab::Corners = core::corner_radius(n);
        return num(c.top_leading);
    }

    // ---- tier 2: flex style ----
    // ---- position, sizing, transform ----
    //
    // Read straight off the style, the way every row below does. `len_value`
    // renders a StyleLength as the number a developer typed, so an unset inset
    // reads as nothing rather than as 0 — "not positioned" and "positioned at
    // zero" are different answers and a nudge loop needs to tell them apart.
    if prop == "absolute" {
        return option::Option[insp::Value]::Some(insp::Value::Bool(
            match { (*n).style.position_type } { flex::PositionType::Absolute => true, _ => false }));
    }
    if prop == "z_index" { return num({ (*n).style.z_index } as f64); }
    if prop == "top" { return option::Option[insp::Value]::Some(len_value({ (*n).style.position_top })); }
    if prop == "left" { return option::Option[insp::Value]::Some(len_value({ (*n).style.position_left })); }
    if prop == "right" { return option::Option[insp::Value]::Some(len_value({ (*n).style.position_right })); }
    if prop == "bottom" { return option::Option[insp::Value]::Some(len_value({ (*n).style.position_bottom })); }
    if prop == "min_width" { return option::Option[insp::Value]::Some(len_value({ (*n).style.min_width })); }
    if prop == "max_width" { return option::Option[insp::Value]::Some(len_value({ (*n).style.max_width })); }
    if prop == "min_height" { return option::Option[insp::Value]::Some(len_value({ (*n).style.min_height })); }
    if prop == "max_height" { return option::Option[insp::Value]::Some(len_value({ (*n).style.max_height })); }
    // UNSET IS NOTHING, NOT A NUMBER. flex spells an unset ratio `undefined()`,
    // which is NaN — and a NaN reaching the wire is `null` at best (json
    // encodes it so rather than emitting invalid JSON) and a nonsense value in
    // a panel at worst. `Nothing` is what every other unset length answers.
    if prop == "aspect_ratio" {
        let ar: f64 = { (*n).style.aspect_ratio };
        if ar != ar { return option::Option[insp::Value]::Some(insp::Value::Nothing); }
        return num(ar);
    }
    // ---- how the children sit ----
    //
    // Carried as SPELLINGS. These are the properties a person actually reaches
    // for when a row is not centred, and they were unreachable — the surface
    // could move a node to an absolute position but could not say `center`.
    if prop == "flex_direction" { return named(voc::flex_direction_name({ (*n).style.flex_direction })); }
    if prop == "justify_content" { return named(voc::justify_name({ (*n).style.justify_content })); }
    if prop == "align_items" { return named(voc::align_name({ (*n).style.align_items })); }
    if prop == "align_self" { return named(voc::align_name({ (*n).style.align_self })); }
    if prop == "align_content" { return named(voc::align_name({ (*n).style.align_content })); }
    if prop == "flex_wrap" { return named(voc::wrap_name({ (*n).style.flex_wrap })); }
    if prop == "overflow" { return named(voc::overflow_name({ (*n).style.overflow })); }
    if prop == "display" { return named(voc::display_name({ (*n).style.display })); }
    if prop == "box_sizing" { return named(voc::box_sizing_name({ (*n).style.box_sizing })); }

    // ---- the drop shadow, one scalar at a time ----
    //
    // `Value` has no tag for a struct, and inventing one for the single
    // property that needs it would be a second encoding for every client to
    // learn. A shadow is five numbers and a colour; five names cost nothing and
    // each one is editable on its own, which is what a nudge loop wants anyway.
    if prop == "shadow_color" { let sh: vocab::Shadow = core::shadow(n); return colour(sh.color); }
    if prop == "shadow_opacity" { let sh: vocab::Shadow = core::shadow(n); return num(sh.opacity); }
    if prop == "shadow_radius" { let sh: vocab::Shadow = core::shadow(n); return num(sh.radius); }
    if prop == "shadow_offset_x" { let sh: vocab::Shadow = core::shadow(n); return num(sh.offset.x); }
    if prop == "shadow_offset_y" { let sh: vocab::Shadow = core::shadow(n); return num(sh.offset.y); }

    if prop == "flex_basis" { return option::Option[insp::Value]::Some(len_value({ (*n).style.flex_basis })); }
    if prop == "width" { return option::Option[insp::Value]::Some(len_value({ (*n).style.width })); }
    if prop == "height" { return option::Option[insp::Value]::Some(len_value({ (*n).style.height })); }
    if prop == "grow" { return num({ (*n).style.flex_grow }); }
    if prop == "shrink" { return num({ (*n).style.flex_shrink }); }
    if prop == "padding_left" { return option::Option[insp::Value]::Some(len_value({ (*n).style.padding_left })); }
    if prop == "padding_top" { return option::Option[insp::Value]::Some(len_value({ (*n).style.padding_top })); }
    if prop == "padding_right" { return option::Option[insp::Value]::Some(len_value({ (*n).style.padding_right })); }
    if prop == "padding_bottom" { return option::Option[insp::Value]::Some(len_value({ (*n).style.padding_bottom })); }
    if prop == "padding" {
        return option::Option[insp::Value]::Some(uniform(
            { (*n).style.padding_left }, { (*n).style.padding_top },
            { (*n).style.padding_right }, { (*n).style.padding_bottom }));
    }
    if prop == "margin_left" { return option::Option[insp::Value]::Some(len_value({ (*n).style.margin_left })); }
    if prop == "margin_top" { return option::Option[insp::Value]::Some(len_value({ (*n).style.margin_top })); }
    if prop == "margin_right" { return option::Option[insp::Value]::Some(len_value({ (*n).style.margin_right })); }
    if prop == "margin_bottom" { return option::Option[insp::Value]::Some(len_value({ (*n).style.margin_bottom })); }
    if prop == "margin" {
        return option::Option[insp::Value]::Some(uniform(
            { (*n).style.margin_left }, { (*n).style.margin_top },
            { (*n).style.margin_right }, { (*n).style.margin_bottom }));
    }
    if prop == "gap_row" { return option::Option[insp::Value]::Some(len_value({ (*n).style.gap_row })); }
    if prop == "gap_column" { return option::Option[insp::Value]::Some(len_value({ (*n).style.gap_column })); }
    if prop == "gap" {
        let gr: flex::StyleLength = { (*n).style.gap_row };
        let gc: flex::StyleLength = { (*n).style.gap_column };
        return match as_points(gr) {
            option::Option[f64]::Some(x) => {
                if same_points(gc, x) { num(x) }
                else { option::Option[insp::Value]::Some(insp::Value::Nothing) }
            }
            option::Option::None =>
                option::Option[insp::Value]::Some(insp::Value::Nothing),
        };
    }

    return option::Option[insp::Value]::None;
}

// Does this node's key resolve back to this very node, in this window?
//
// Tier 3 goes through the generated typed handles, and those are reachable
// only by key. Before using one, prove the key names THIS node: two windows
// may share a key, and `find` answers the first match in open order. If the
// key resolves elsewhere, the write must be refused rather than landing on a
// stranger.
fn keyed_resolves_here(n: *core::Node, window: usize) -> bool {
    let k: str = { (*n).key() };
    if k == "" { return false; }
    let r: *core::Node = app::window_root(window);
    if r.is_null() { return false; }
    return match core::find_in(r, k) {
        option::Option[*core::Node]::Some(p) => p == n,
        option::Option::None => false,
    };
}

// Tier 3: control props, by key, for the kinds whose text or value is the
// thing a developer actually reaches for.
fn get_control(n: *core::Node, prop: str, window: usize) -> option::Option[insp::Value] {
    let k: str = { (*n).key() };
    if !keyed_resolves_here(n, window) { return option::Option[insp::Value]::None; }
    let root: *core::Node = app::window_root(window);
    let kind: u32 = core::kind_of(n);

    if is_type_face(prop) {
        if kind == props::K_LABEL {
            return match label::find(k, within: root) {
                option::Option[label::Label]::Some(l) => {
                    if prop == "font_size" { return num(l.font_size()); }
                    if prop == "font_weight" { return named(voc::font_weight_name(l.font_weight())); }
                    return colour(l.text_color());
                }
                option::Option::None => option::Option[insp::Value]::None,
            };
        }
        if kind == props::K_BUTTON {
            return match button::find(k, within: root) {
                option::Option[button::Button]::Some(b) => {
                    if prop == "font_size" { return num(b.font_size()); }
                    if prop == "font_weight" { return named(voc::font_weight_name(b.font_weight())); }
                    return colour(b.text_color());
                }
                option::Option::None => option::Option[insp::Value]::None,
            };
        }
        if kind == props::K_TEXT_FIELD {
            return match text_field::find(k, within: root) {
                option::Option[text_field::TextField]::Some(t) => {
                    if prop == "font_size" { return num(t.font_size()); }
                    if prop == "font_weight" { return named(voc::font_weight_name(t.font_weight())); }
                    return colour(t.text_color());
                }
                option::Option::None => option::Option[insp::Value]::None,
            };
        }
        if kind == props::K_TEXT_AREA {
            return match text_area::find(k, within: root) {
                option::Option[text_area::TextArea]::Some(t) => {
                    if prop == "font_size" { return num(t.font_size()); }
                    if prop == "font_weight" { return named(voc::font_weight_name(t.font_weight())); }
                    return colour(t.text_color());
                }
                option::Option::None => option::Option[insp::Value]::None,
            };
        }
        return option::Option[insp::Value]::None;
    }

    if is_button_border(prop) {
        if kind != props::K_BUTTON { return option::Option[insp::Value]::None; }
        return match button::find(k, within: root) {
            option::Option[button::Button]::Some(b) => {
                if prop == "border_width" { return num(b.border_width()); }
                return colour(b.border_color());
            }
            option::Option::None => option::Option[insp::Value]::None,
        };
    }

    if prop == "text" {
        if kind == props::K_LABEL {
            return match label::find(k, within: root) {
                option::Option[label::Label]::Some(l) => owned(l.text()),
                option::Option::None => option::Option[insp::Value]::None,
            };
        }
        if kind == props::K_TEXT_FIELD {
            return match text_field::find(k, within: root) {
                option::Option[text_field::TextField]::Some(t) => owned(t.text()),
                option::Option::None => option::Option[insp::Value]::None,
            };
        }
        if kind == props::K_TEXT_AREA {
            return match text_area::find(k, within: root) {
                option::Option[text_area::TextArea]::Some(t) => owned(t.text()),
                option::Option::None => option::Option[insp::Value]::None,
            };
        }
        return option::Option[insp::Value]::None;
    }

    if prop == "title" {
        if kind == props::K_BUTTON {
            return match button::find(k, within: root) {
                option::Option[button::Button]::Some(b) => owned(b.title()),
                option::Option::None => option::Option[insp::Value]::None,
            };
        }
        return option::Option[insp::Value]::None;
    }

    if prop == "on" {
        if kind == props::K_CHECKBOX {
            return match checkbox::find(k, within: root) {
                option::Option[checkbox::Checkbox]::Some(c) => boolean(c.on()),
                option::Option::None => option::Option[insp::Value]::None,
            };
        }
        if kind == props::K_TOGGLE {
            return match toggle::find(k, within: root) {
                option::Option[toggle::Toggle]::Some(t) => boolean(t.on()),
                option::Option::None => option::Option[insp::Value]::None,
            };
        }
        return option::Option[insp::Value]::None;
    }

    return option::Option[insp::Value]::None;
}

fn get(h: insp::Handle, prop: str) -> option::Option[insp::Value] {
    if !h.is_live() { return option::Option[insp::Value]::None; }
    let n: *core::Node = h.node;
    match get_uniform(n, prop) {
        option::Option[insp::Value]::Some(v) => { return option::Option[insp::Value]::Some(v); }
        option::Option::None => { }
    }
    return get_control(n, prop, h.window);
}

// ---- parsing a value a client sent -------------------------------------------
//
// Shared by both consumers on purpose. The panel reads what a developer typed
// into a text field; the socket adapter reads what arrived as JSON. The RULE is
// the same for both — read it as the tag the property already holds — and two
// implementations of one rule is one place to notice when they stop agreeing.

fn hex_digit(b: u8) -> i32 {
    let c: i32 = b as i32;
    if (c >= 48) && (c <= 57) { return c - 48; }          // 0-9
    if (c >= 97) && (c <= 102) { return (c - 97) + 10; }  // a-f
    if (c >= 65) && (c <= 70) { return (c - 65) + 10; }   // A-F
    return -1;
}

fn hex_pair(t: text::Text, at: usize) -> i32 {
    let hi: i32 = match t.byte_at(at) {
        option::Option[u8]::Some(b) => hex_digit(b),
        option::Option::None => -1,
    };
    let lo: i32 = match t.byte_at(at +% 1) {
        option::Option[u8]::Some(b) => hex_digit(b),
        option::Option::None => -1,
    };
    if hi < 0 { return -1; }
    if lo < 0 { return -1; }
    return (hi * 16) + lo;
}

// `#2277ff`, the spelling every developer already has in their fingers.
fn parse_hex_color(s: str) -> option::Option[vocab::Color] {
    let t: text::Text = text::from_str(s);
    if t.count() != 7 { return option::Option[vocab::Color]::None; }
    if !t.has_prefix("#") { return option::Option[vocab::Color]::None; }
    let r: i32 = hex_pair(t, 1);
    let g: i32 = hex_pair(t, 3);
    let b: i32 = hex_pair(t, 5);
    if r < 0 { return option::Option[vocab::Color]::None; }
    if g < 0 { return option::Option[vocab::Color]::None; }
    if b < 0 { return option::Option[vocab::Color]::None; }
    return option::Option[vocab::Color]::Some(vocab::Color::rgba(
        (r as f64) / 255.0, (g as f64) / 255.0, (b as f64) / 255.0, 1.0));
}

// What arrived, read as the tag the property already holds. The current value
// is the type declaration: a property reading `0.65` takes a number, one
// reading `true` takes a boolean. Nothing has to be declared twice, and a
// property whose current value is `Nothing` is read as a length, which is the
// only tag that reads as unset.
fn parse_as(current: insp::Value, typed: str) -> option::Option[insp::Value] {
    return match current {
        insp::Value::Bool(_b) => {
            if typed == "true" { option::Option[insp::Value]::Some(insp::Value::Bool(true)) }
            else if typed == "false" { option::Option[insp::Value]::Some(insp::Value::Bool(false)) }
            else { option::Option[insp::Value]::None }
        }
        insp::Value::Num(_x) => match typed.to_f64() {
            option::Option[f64]::Some(f) => option::Option[insp::Value]::Some(insp::Value::Num(f)),
            option::Option::None => option::Option[insp::Value]::None,
        },
        insp::Value::Int(_i) => match typed.to_i64() {
            option::Option[i64]::Some(n) => option::Option[insp::Value]::Some(insp::Value::Int(n)),
            option::Option::None => option::Option[insp::Value]::None,
        },
        insp::Value::Str(_s) =>
            option::Option[insp::Value]::Some(insp::Value::Str(text::from_str(typed))),
        insp::Value::Color(_c) => match parse_hex_color(typed) {
            option::Option[vocab::Color]::Some(c) =>
                option::Option[insp::Value]::Some(insp::Value::Color(c)),
            option::Option::None => option::Option[insp::Value]::None,
        },
        // An unset length. Empty clears nothing (there is no "unset" write in
        // v1), a number sets points.
        insp::Value::Nothing => match typed.to_f64() {
            option::Option[f64]::Some(f) => option::Option[insp::Value]::Some(insp::Value::Num(f)),
            option::Option::None => option::Option[insp::Value]::None,
        },
        insp::Value::Enum(_e) =>
            option::Option[insp::Value]::Some(insp::Value::Enum(text::from_str(typed))),
    };
}

// The same rule, aimed at a live node: read the property, then parse against
// what it holds. `None` when the node does not answer that property at all,
// which the caller reports as `UnknownProperty` rather than guessing a tag.
fn parse_for(h: insp::Handle, prop: str, typed: str) -> option::Option[insp::Value] {
    // A LENGTH IS NOT ITS CURRENT TAG.
    //
    // Everything else parses against what the property holds, which is the rule
    // that makes `#2277ff` a colour on a colour property. A length breaks it:
    // one holding 120 points reads as a Num, and parsing `50%` against a Num
    // fails — so a percent was writable only onto a property that already held
    // a percent, which is nearly none of them. A length knows its own three
    // shapes, so it parses as a length wherever it stands.
    if is_length_prop(prop) {
        return match parse_length(typed) {
            option::Option[flex::StyleLength]::Some(l) =>
                option::Option[insp::Value]::Some(len_value(l)),
            option::Option::None => option::Option[insp::Value]::None,
        };
    }
    return match get(h, prop) {
        option::Option[insp::Value]::Some(cur) => parse_as(cur, typed),
        option::Option::None => option::Option[insp::Value]::None,
    };
}

// ---- writing -----------------------------------------------------------------

// Scalars only. A `str` pulled out of a `Value` would be a view into a `Text`
// this function does not own, and a view outliving its bytes is the
// use-after-free the borrow checker cannot see through a return. Text and
// colour are matched where they are used instead.
fn num_of(v: insp::Value) -> option::Option[f64] {
    return match v {
        insp::Value::Num(x) => option::Option[f64]::Some(x),
        // A client that sends 12 for a length means 12.0. Refusing that would
        // be pedantry dressed as type safety.
        insp::Value::Int(i) => option::Option[f64]::Some(i as f64),
        _ => option::Option[f64]::None,
    };
}

fn bool_of(v: insp::Value) -> option::Option[bool] {
    return match v {
        insp::Value::Bool(b) => option::Option[bool]::Some(b),
        _ => option::Option[bool]::None,
    };
}

// EVERY length goes through here. Before this there were three write paths —
// `core::set_top` and friends took an f64, `set_len` took an f64, and the
// min/max pair took a third — and all three could only say points. A property
// whose read can answer `50%` and whose write cannot accept it is a round trip
// that silently converts, so they are one path that speaks the whole unit.
fn set_len(n: *core::Node, which: str, l: flex::StyleLength) {
    if which == "width" { { (*n).set_width(l) }; }
    if which == "height" { { (*n).set_height(l) }; }
    if which == "padding" { { (*n).set_padding(flex::Edge::All, l) }; }
    if which == "padding_left" { { (*n).set_padding(flex::Edge::Left, l) }; }
    if which == "padding_top" { { (*n).set_padding(flex::Edge::Top, l) }; }
    if which == "padding_right" { { (*n).set_padding(flex::Edge::Right, l) }; }
    if which == "padding_bottom" { { (*n).set_padding(flex::Edge::Bottom, l) }; }
    if which == "margin" { { (*n).set_margin(flex::Edge::All, l) }; }
    if which == "margin_left" { { (*n).set_margin(flex::Edge::Left, l) }; }
    if which == "margin_top" { { (*n).set_margin(flex::Edge::Top, l) }; }
    if which == "margin_right" { { (*n).set_margin(flex::Edge::Right, l) }; }
    if which == "margin_bottom" { { (*n).set_margin(flex::Edge::Bottom, l) }; }
    if which == "gap" { { (*n).set_gap(flex::Gutter::All, l) }; }
    if which == "gap_row" { { (*n).set_gap(flex::Gutter::Row, l) }; }
    if which == "gap_column" { { (*n).set_gap(flex::Gutter::Column, l) }; }
    if which == "top" { { (*n).set_position(flex::Edge::Top, l) }; }
    if which == "left" { { (*n).set_position(flex::Edge::Left, l) }; }
    if which == "right" { { (*n).set_position(flex::Edge::Right, l) }; }
    if which == "bottom" { { (*n).set_position(flex::Edge::Bottom, l) }; }
    if which == "min_width" { { (*n).set_min_width(l) }; }
    if which == "max_width" { { (*n).set_max_width(l) }; }
    if which == "min_height" { { (*n).set_min_height(l) }; }
    if which == "max_height" { { (*n).set_max_height(l) }; }
    if which == "flex_basis" { { (*n).set_flex_basis(l) }; }
    // One bit for every one of them: layout is re-run, props are not re-read.
    core::touch(n, props::C_LAYOUT);
}

fn is_length_prop(prop: str) -> bool {
    if prop == "width" { return true; }
    if prop == "height" { return true; }
    if prop == "padding" { return true; }
    if prop == "padding_left" { return true; }
    if prop == "padding_top" { return true; }
    if prop == "padding_right" { return true; }
    if prop == "padding_bottom" { return true; }
    if prop == "margin" { return true; }
    if prop == "margin_left" { return true; }
    if prop == "margin_top" { return true; }
    if prop == "margin_right" { return true; }
    if prop == "margin_bottom" { return true; }
    if prop == "gap" { return true; }
    if prop == "gap_row" { return true; }
    if prop == "gap_column" { return true; }
    if prop == "top" { return true; }
    if prop == "left" { return true; }
    if prop == "right" { return true; }
    if prop == "bottom" { return true; }
    if prop == "min_width" { return true; }
    if prop == "max_width" { return true; }
    if prop == "min_height" { return true; }
    if prop == "max_height" { return true; }
    if prop == "flex_basis" { return true; }
    return false;
}

// The names a developer will type that name something real and read-only.
// Answering `ReadOnly` rather than `UnknownProperty` is the difference between
// "layout decided that" and "you misspelled it".
fn computed_names() -> vec::Vec[str] {
    var v: vec::Vec[str] = vec::new::[str]();
    let _a: status::Status = v.append("frame_x");
    let _b: status::Status = v.append("frame_y");
    let _c: status::Status = v.append("frame_width");
    let _d: status::Status = v.append("frame_height");
    let _e: status::Status = v.append("attached");
    let _f: status::Status = v.append("focused");
    let _g: status::Status = v.append("kind");
    let _h: status::Status = v.append("key");
    let _i: status::Status = v.append("native_class");
    let _j: status::Status = v.append("has_view");
    return v;
}

fn in_list(names: vec::Vec[str], prop: str) -> bool {
    var i: usize = 0;
    while i < names.count() {
        match names.at(i) {
            option::Option[str]::Some(nm) => { if nm == prop { return true; } }
            option::Option::None => { }
        }
        i = i +% 1;
    }
    return false;
}

fn is_computed_prop(prop: str) -> bool { return in_list(computed_names(), prop); }

// The LITERAL this package owns for a property name a caller supplied.
//
// This is not politeness, it is the ledger's invariant. `Override.prop` is a
// `str` — a borrowed {ptr,len} — because every name reaching it came from the
// tables above and therefore lives as long as the program. A caller-supplied
// name does not: a socket adapter parses one into a request-scoped `Text`, and
// recording a view of THAT leaves the ledger holding freed bytes. The symptom
// is not a crash, which is what makes it worth a function: `reset` compares the
// dangling name against the one it was asked for, matches nothing, and answers
// `Ok` having done nothing at all.
//
// So a caller with a name in hand exchanges it for ours before it goes any
// further, and a name that is in neither table is refused here rather than
// stored.
fn canonical_prop(name: str) -> option::Option[str] {
    let declared: vec::Vec[str] = declared_names();
    var i: usize = 0;
    while i < declared.count() {
        match declared.at(i) {
            option::Option[str]::Some(nm) => {
                if nm == name { return option::Option[str]::Some(nm); }
            }
            option::Option::None => { }
        }
        i = i +% 1;
    }
    // The read-only ones too, so a caller naming a computed property is told it
    // is read-only rather than that it does not exist.
    let computed: vec::Vec[str] = computed_names();
    var j: usize = 0;
    while j < computed.count() {
        match computed.at(j) {
            option::Option[str]::Some(nm) => {
                if nm == name { return option::Option[str]::Some(nm); }
            }
            option::Option::None => { }
        }
        j = j +% 1;
    }
    return option::Option[str]::None;
}

// An enum write is two steps kept apart on purpose: the SPELLING is pulled out
// of the value where it lives (a `str` lifted out of a `Text` and returned
// would be a view into bytes the caller still owns), and the already-decoded
// variant is handed to the applier. So each of these takes an Option that has
// already failed or not, and `None` is one answer in one place.
fn set_align_to(n: *core::Node, prop: str, o: option::Option[flex::Align]) -> insp::Outcome {
    return match o {
        option::Option[flex::Align]::Some(a) => {
            if prop == "align_items" { { (*n).set_align_items(a) }; }
            if prop == "align_self" { { (*n).set_align_self(a) }; }
            if prop == "align_content" { { (*n).set_align_content(a) }; }
            core::touch(n, props::C_LAYOUT);
            insp::Outcome::Ok
        }
        option::Option::None => insp::Outcome::TypeMismatch,
    };
}

fn set_justify_to(n: *core::Node, o: option::Option[flex::Justify]) -> insp::Outcome {
    return match o {
        option::Option[flex::Justify]::Some(j) => {
            { (*n).set_justify_content(j) };
            core::touch(n, props::C_LAYOUT);
            insp::Outcome::Ok
        }
        option::Option::None => insp::Outcome::TypeMismatch,
    };
}

fn set_flex_direction_to(n: *core::Node, o: option::Option[flex::FlexDirection]) -> insp::Outcome {
    return match o {
        option::Option[flex::FlexDirection]::Some(d) => {
            { (*n).set_flex_direction(d) };
            core::touch(n, props::C_LAYOUT);
            insp::Outcome::Ok
        }
        option::Option::None => insp::Outcome::TypeMismatch,
    };
}

fn set_wrap_to(n: *core::Node, o: option::Option[flex::Wrap]) -> insp::Outcome {
    return match o {
        option::Option[flex::Wrap]::Some(w) => {
            { (*n).set_flex_wrap(w) };
            core::touch(n, props::C_LAYOUT);
            insp::Outcome::Ok
        }
        option::Option::None => insp::Outcome::TypeMismatch,
    };
}

fn set_overflow_to(n: *core::Node, o: option::Option[flex::Overflow]) -> insp::Outcome {
    return match o {
        option::Option[flex::Overflow]::Some(x) => {
            { (*n).set_overflow(x) };
            core::touch(n, props::C_LAYOUT);
            insp::Outcome::Ok
        }
        option::Option::None => insp::Outcome::TypeMismatch,
    };
}

fn set_display_to(n: *core::Node, o: option::Option[flex::Display]) -> insp::Outcome {
    return match o {
        option::Option[flex::Display]::Some(x) => {
            { (*n).set_display(x) };
            core::touch(n, props::C_LAYOUT);
            insp::Outcome::Ok
        }
        option::Option::None => insp::Outcome::TypeMismatch,
    };
}

fn set_box_sizing_to(n: *core::Node, o: option::Option[flex::BoxSizing]) -> insp::Outcome {
    return match o {
        option::Option[flex::BoxSizing]::Some(x) => {
            { (*n).set_box_sizing(x) };
            core::touch(n, props::C_LAYOUT);
            insp::Outcome::Ok
        }
        option::Option::None => insp::Outcome::TypeMismatch,
    };
}

fn apply_style_enum(n: *core::Node, prop: str, v: insp::Value) -> insp::Outcome {
    if prop == "align_items" || prop == "align_self" || prop == "align_content" {
        return match v {
            insp::Value::Enum(e) => set_align_to(n, prop, voc::align_from(e.view())),
            insp::Value::Str(t) => set_align_to(n, prop, voc::align_from(t.view())),
            _ => insp::Outcome::TypeMismatch,
        };
    }
    if prop == "justify_content" {
        return match v {
            insp::Value::Enum(e) => set_justify_to(n, voc::justify_from(e.view())),
            insp::Value::Str(t) => set_justify_to(n, voc::justify_from(t.view())),
            _ => insp::Outcome::TypeMismatch,
        };
    }
    if prop == "flex_direction" {
        return match v {
            insp::Value::Enum(e) => set_flex_direction_to(n, voc::flex_direction_from(e.view())),
            insp::Value::Str(t) => set_flex_direction_to(n, voc::flex_direction_from(t.view())),
            _ => insp::Outcome::TypeMismatch,
        };
    }
    if prop == "flex_wrap" {
        return match v {
            insp::Value::Enum(e) => set_wrap_to(n, voc::wrap_from(e.view())),
            insp::Value::Str(t) => set_wrap_to(n, voc::wrap_from(t.view())),
            _ => insp::Outcome::TypeMismatch,
        };
    }
    if prop == "overflow" {
        return match v {
            insp::Value::Enum(e) => set_overflow_to(n, voc::overflow_from(e.view())),
            insp::Value::Str(t) => set_overflow_to(n, voc::overflow_from(t.view())),
            _ => insp::Outcome::TypeMismatch,
        };
    }
    if prop == "display" {
        return match v {
            insp::Value::Enum(e) => set_display_to(n, voc::display_from(e.view())),
            insp::Value::Str(t) => set_display_to(n, voc::display_from(t.view())),
            _ => insp::Outcome::TypeMismatch,
        };
    }
    if prop == "box_sizing" {
        return match v {
            insp::Value::Enum(e) => set_box_sizing_to(n, voc::box_sizing_from(e.view())),
            insp::Value::Str(t) => set_box_sizing_to(n, voc::box_sizing_from(t.view())),
            _ => insp::Outcome::TypeMismatch,
        };
    }
    return insp::Outcome::UnknownProperty;
}

fn is_style_enum(prop: str) -> bool {
    if prop == "flex_direction" { return true; }
    if prop == "justify_content" { return true; }
    if prop == "align_items" { return true; }
    if prop == "align_self" { return true; }
    if prop == "align_content" { return true; }
    if prop == "flex_wrap" { return true; }
    if prop == "overflow" { return true; }
    if prop == "display" { return true; }
    if prop == "box_sizing" { return true; }
    return false;
}

// A shadow is read whole, one field replaced, and written back — there is one
// setter and it takes the struct.
fn apply_shadow(n: *core::Node, prop: str, v: insp::Value) -> insp::Outcome {
    var sh: vocab::Shadow = core::shadow(n);
    if prop == "shadow_color" {
        match color_of(v) {
            option::Option[vocab::Color]::Some(c) => { sh.color = c; }
            option::Option::None => { return insp::Outcome::TypeMismatch; }
        }
        core::set_shadow(n, sh);
        return insp::Outcome::Ok;
    }
    return match num_of(v) {
        option::Option[f64]::Some(x) => {
            if prop == "shadow_opacity" { sh.opacity = x; }
            if prop == "shadow_radius" { sh.radius = x; }
            if prop == "shadow_offset_x" { sh.offset.x = x; }
            if prop == "shadow_offset_y" { sh.offset.y = x; }
            core::set_shadow(n, sh);
            insp::Outcome::Ok
        }
        option::Option::None => insp::Outcome::TypeMismatch,
    };
}

fn is_shadow_prop(prop: str) -> bool {
    if prop == "shadow_color" { return true; }
    if prop == "shadow_opacity" { return true; }
    if prop == "shadow_radius" { return true; }
    if prop == "shadow_offset_x" { return true; }
    if prop == "shadow_offset_y" { return true; }
    return false;
}

fn apply_uniform(n: *core::Node, prop: str, v: insp::Value) -> insp::Outcome {
    // ---- position: the DOM move ----
    //
    // `absolute` takes the node out of flow; `top`/`left`/`right`/`bottom` then
    // place it. That pairing is the whole "nudge it until it sits right" loop,
    // and none of it was reachable before — `flex_layout` has had
    // `PositionType::Absolute` and computed insets all along.
    if prop == "absolute" {
        return match bool_of(v) {
            option::Option[bool]::Some(b) => { core::set_absolute(n, b); insp::Outcome::Ok }
            option::Option::None => insp::Outcome::TypeMismatch,
        };
    }
    if prop == "z_index" {
        return match num_of(v) {
            option::Option[f64]::Some(x) => { core::set_z_index(n, x as i64); insp::Outcome::Ok }
            option::Option::None => insp::Outcome::TypeMismatch,
        };
    }
    if prop == "scale_x" {
        return match num_of(v) {
            option::Option[f64]::Some(x) => { core::set_scale_x(n, x); insp::Outcome::Ok }
            option::Option::None => insp::Outcome::TypeMismatch,
        };
    }
    if prop == "scale_y" {
        return match num_of(v) {
            option::Option[f64]::Some(x) => { core::set_scale_y(n, x); insp::Outcome::Ok }
            option::Option::None => insp::Outcome::TypeMismatch,
        };
    }
    if prop == "rotation_x" {
        return match num_of(v) {
            option::Option[f64]::Some(x) => { core::set_rotation_x(n, x); insp::Outcome::Ok }
            option::Option::None => insp::Outcome::TypeMismatch,
        };
    }
    if prop == "rotation_y" {
        return match num_of(v) {
            option::Option[f64]::Some(x) => { core::set_rotation_y(n, x); insp::Outcome::Ok }
            option::Option::None => insp::Outcome::TypeMismatch,
        };
    }
    if prop == "aspect_ratio" {
        // Unset is a value here too — `Nothing` puts back flex's undefined,
        // which is what a reset of a ratio the app never set has to write.
        match v {
            insp::Value::Nothing => {
                core::set_aspect_ratio(n, flex::undefined());
                return insp::Outcome::Ok;
            }
            _ => { }
        }
        return match num_of(v) {
            option::Option[f64]::Some(x) => { core::set_aspect_ratio(n, x); insp::Outcome::Ok }
            option::Option::None => insp::Outcome::TypeMismatch,
        };
    }
    // ---- tier 1: the common band ----
    if prop == "opacity" {
        return match num_of(v) {
            option::Option[f64]::Some(x) => { core::set_opacity(n, x); insp::Outcome::Ok }
            option::Option::None => insp::Outcome::TypeMismatch,
        };
    }
    if prop == "visible" {
        return match bool_of(v) {
            option::Option[bool]::Some(b) => { core::set_visible(n, b); insp::Outcome::Ok }
            option::Option::None => insp::Outcome::TypeMismatch,
        };
    }
    if prop == "enabled" {
        return match bool_of(v) {
            option::Option[bool]::Some(b) => { core::set_enabled(n, b); insp::Outcome::Ok }
            option::Option::None => insp::Outcome::TypeMismatch,
        };
    }
    if prop == "input_transparent" {
        return match bool_of(v) {
            option::Option[bool]::Some(b) => { core::set_input_transparent(n, b); insp::Outcome::Ok }
            option::Option::None => insp::Outcome::TypeMismatch,
        };
    }
    if prop == "rotation" {
        return match num_of(v) {
            option::Option[f64]::Some(x) => { core::set_rotation(n, x); insp::Outcome::Ok }
            option::Option::None => insp::Outcome::TypeMismatch,
        };
    }
    if prop == "scale" {
        return match num_of(v) {
            option::Option[f64]::Some(x) => { core::set_scale(n, x); insp::Outcome::Ok }
            option::Option::None => insp::Outcome::TypeMismatch,
        };
    }
    if prop == "translation_x" {
        return match num_of(v) {
            option::Option[f64]::Some(x) => { core::set_translation_x(n, x); insp::Outcome::Ok }
            option::Option::None => insp::Outcome::TypeMismatch,
        };
    }
    if prop == "translation_y" {
        return match num_of(v) {
            option::Option[f64]::Some(x) => { core::set_translation_y(n, x); insp::Outcome::Ok }
            option::Option::None => insp::Outcome::TypeMismatch,
        };
    }
    if prop == "corner_radius" {
        return match num_of(v) {
            option::Option[f64]::Some(x) => {
                core::set_corner_radius(n, vocab::Corners::all(x));
                insp::Outcome::Ok
            }
            option::Option::None => insp::Outcome::TypeMismatch,
        };
    }
    if prop == "background_color" {
        return match v {
            insp::Value::Color(c) => { core::set_background_color(n, c); insp::Outcome::Ok }
            _ => insp::Outcome::TypeMismatch,
        };
    }
    if prop == "tooltip" {
        return match v {
            insp::Value::Str(s) => { core::set_tooltip(n, s.view()); insp::Outcome::Ok }
            _ => insp::Outcome::TypeMismatch,
        };
    }
    if prop == "accessibility_label" {
        return match v {
            insp::Value::Str(s) => { core::set_accessibility_label(n, s.view()); insp::Outcome::Ok }
            _ => insp::Outcome::TypeMismatch,
        };
    }

    // ---- tier 2: flex style ----
    if prop == "grow" {
        return match num_of(v) {
            option::Option[f64]::Some(x) => { core::set_grow(n, x); insp::Outcome::Ok }
            option::Option::None => insp::Outcome::TypeMismatch,
        };
    }
    if prop == "shrink" {
        return match num_of(v) {
            option::Option[f64]::Some(x) => { core::set_shrink(n, x); insp::Outcome::Ok }
            option::Option::None => insp::Outcome::TypeMismatch,
        };
    }
    if is_style_enum(prop) { return apply_style_enum(n, prop, v); }
    if is_shadow_prop(prop) { return apply_shadow(n, prop, v); }
    if is_length_prop(prop) {
        return match length_of(v) {
            option::Option[flex::StyleLength]::Some(l) => { set_len(n, prop, l); insp::Outcome::Ok }
            option::Option::None => insp::Outcome::TypeMismatch,
        };
    }

    return insp::Outcome::UnknownProperty;
}

// Tier 3. `Unsupported` and not `UnknownProperty` when the node has no usable
// key: the name was right, this build cannot reach it here.
// ---- the type face -------------------------------------------------------------
//
// The spellings live in `vocabulary`, with every other closed set and with the
// descriptor that advertises them. Here is only the decoding.

fn named(v: str) -> option::Option[insp::Value] {
    return option::Option[insp::Value]::Some(insp::Value::Enum(text::from_str(v)));
}

// A weight arrives as its spelling. `Str` is accepted alongside `Enum` because
// a client that has not read `vocabulary` sends JSON, and JSON has one string.
fn weight_of(v: insp::Value) -> option::Option[vocab::FontWeight] {
    return match v {
        insp::Value::Enum(e) => voc::font_weight_from(e.view()),
        insp::Value::Str(s) => voc::font_weight_from(s.view()),
        _ => option::Option[vocab::FontWeight]::None,
    };
}

// Colour is scalars all the way down, so unlike text it survives being pulled
// out of a `Value` and returned.
fn color_of(v: insp::Value) -> option::Option[vocab::Color] {
    return match v {
        insp::Value::Color(c) => option::Option[vocab::Color]::Some(c),
        _ => option::Option[vocab::Color]::None,
    };
}

// The three every text-bearing control carries, and the two only a button does.
fn is_type_face(prop: str) -> bool {
    return (prop == "font_size") || (prop == "font_weight") || (prop == "text_color");
}

fn is_button_border(prop: str) -> bool {
    return (prop == "border_color") || (prop == "border_width");
}

fn apply_control(n: *core::Node, prop: str, v: insp::Value, window: usize) -> insp::Outcome {
    let kind: u32 = core::kind_of(n);
    let known: bool = (prop == "text") || (prop == "title") || (prop == "on")
        || is_type_face(prop) || is_button_border(prop);
    if !known { return insp::Outcome::UnknownProperty; }
    if !keyed_resolves_here(n, window) { return insp::Outcome::Unsupported; }
    let k: str = { (*n).key() };
    let root: *core::Node = app::window_root(window);

    // ---- the type face ----
    //
    // Decoded BEFORE the kind switch. A wrong type is wrong on a label and on a
    // button alike, and checking it once is the difference between one answer
    // and four copies of it that drift.
    if is_type_face(prop) {
        var size: f64 = 0.0f64;
        var weight: vocab::FontWeight = vocab::FontWeight::Default;
        var color: vocab::Color = vocab::Color::clear();
        if prop == "font_size" {
            match num_of(v) {
                option::Option[f64]::Some(x) => { size = x; }
                option::Option::None => { return insp::Outcome::TypeMismatch; }
            }
        }
        if prop == "font_weight" {
            match weight_of(v) {
                option::Option[vocab::FontWeight]::Some(w) => { weight = w; }
                option::Option::None => { return insp::Outcome::TypeMismatch; }
            }
        }
        if prop == "text_color" {
            match color_of(v) {
                option::Option[vocab::Color]::Some(c) => { color = c; }
                option::Option::None => { return insp::Outcome::TypeMismatch; }
            }
        }
        if kind == props::K_LABEL {
            match label::find(k, within: root) {
                option::Option[label::Label]::Some(l) => {
                    if prop == "font_size" {
                        let _h: label::Label = l.set_font_size(size);
                        return insp::Outcome::Ok;
                    }
                    if prop == "font_weight" {
                        let _h: label::Label = l.set_font_weight(weight);
                        return insp::Outcome::Ok;
                    }
                    let _h: label::Label = l.set_text_color(color);
                    return insp::Outcome::Ok;
                }
                option::Option::None => { return insp::Outcome::NotFound; }
            }
        }
        if kind == props::K_BUTTON {
            match button::find(k, within: root) {
                option::Option[button::Button]::Some(b) => {
                    if prop == "font_size" {
                        let _h: button::Button = b.set_font_size(size);
                        return insp::Outcome::Ok;
                    }
                    if prop == "font_weight" {
                        let _h: button::Button = b.set_font_weight(weight);
                        return insp::Outcome::Ok;
                    }
                    let _h: button::Button = b.set_text_color(color);
                    return insp::Outcome::Ok;
                }
                option::Option::None => { return insp::Outcome::NotFound; }
            }
        }
        if kind == props::K_TEXT_FIELD {
            match text_field::find(k, within: root) {
                option::Option[text_field::TextField]::Some(t) => {
                    if prop == "font_size" {
                        let _h: text_field::TextField = t.set_font_size(size);
                        return insp::Outcome::Ok;
                    }
                    if prop == "font_weight" {
                        let _h: text_field::TextField = t.set_font_weight(weight);
                        return insp::Outcome::Ok;
                    }
                    let _h: text_field::TextField = t.set_text_color(color);
                    return insp::Outcome::Ok;
                }
                option::Option::None => { return insp::Outcome::NotFound; }
            }
        }
        if kind == props::K_TEXT_AREA {
            match text_area::find(k, within: root) {
                option::Option[text_area::TextArea]::Some(t) => {
                    if prop == "font_size" {
                        let _h: text_area::TextArea = t.set_font_size(size);
                        return insp::Outcome::Ok;
                    }
                    if prop == "font_weight" {
                        let _h: text_area::TextArea = t.set_font_weight(weight);
                        return insp::Outcome::Ok;
                    }
                    let _h: text_area::TextArea = t.set_text_color(color);
                    return insp::Outcome::Ok;
                }
                option::Option::None => { return insp::Outcome::NotFound; }
            }
        }
        return insp::Outcome::UnknownProperty;
    }

    // ---- the button's border ----
    //
    // Only a button carries one. A box draws its edge with `background_color`
    // and `corner_radius` on the shared band, which is a different property and
    // reached by a different door.
    if is_button_border(prop) {
        if kind != props::K_BUTTON { return insp::Outcome::UnknownProperty; }
        if prop == "border_width" {
            return match num_of(v) {
                option::Option[f64]::Some(x) => {
                    match button::find(k, within: root) {
                        option::Option[button::Button]::Some(b) => {
                            let _h: button::Button = b.set_border_width(x);
                            return insp::Outcome::Ok;
                        }
                        option::Option::None => { return insp::Outcome::NotFound; }
                    }
                }
                option::Option::None => insp::Outcome::TypeMismatch,
            };
        }
        return match color_of(v) {
            option::Option[vocab::Color]::Some(c) => {
                match button::find(k, within: root) {
                    option::Option[button::Button]::Some(b) => {
                        let _h: button::Button = b.set_border_color(c);
                        return insp::Outcome::Ok;
                    }
                    option::Option::None => { return insp::Outcome::NotFound; }
                }
            }
            option::Option::None => insp::Outcome::TypeMismatch,
        };
    }

    if prop == "text" {
        return match v {
            insp::Value::Str(s) => {
                if kind == props::K_LABEL {
                    match label::find(k, within: root) {
                        option::Option[label::Label]::Some(l) => {
                            let _h: label::Label = l.set_text(s.view());
                            return insp::Outcome::Ok;
                        }
                        option::Option::None => { return insp::Outcome::NotFound; }
                    }
                }
                if kind == props::K_TEXT_FIELD {
                    match text_field::find(k, within: root) {
                        option::Option[text_field::TextField]::Some(t) => {
                            let _h: text_field::TextField = t.set_text(s.view());
                            return insp::Outcome::Ok;
                        }
                        option::Option::None => { return insp::Outcome::NotFound; }
                    }
                }
                if kind == props::K_TEXT_AREA {
                    match text_area::find(k, within: root) {
                        option::Option[text_area::TextArea]::Some(t) => {
                            let _h: text_area::TextArea = t.set_text(s.view());
                            return insp::Outcome::Ok;
                        }
                        option::Option::None => { return insp::Outcome::NotFound; }
                    }
                }
                return insp::Outcome::UnknownProperty;
            }
            _ => insp::Outcome::TypeMismatch,
        };
    }

    if prop == "title" {
        if kind != props::K_BUTTON { return insp::Outcome::UnknownProperty; }
        return match v {
            insp::Value::Str(s) => {
                match button::find(k, within: root) {
                    option::Option[button::Button]::Some(b) => {
                        let _h: button::Button = b.set_title(s.view());
                        return insp::Outcome::Ok;
                    }
                    option::Option::None => { return insp::Outcome::NotFound; }
                }
            }
            _ => insp::Outcome::TypeMismatch,
        };
    }

    // prop == "on"
    return match bool_of(v) {
        option::Option[bool]::Some(b) => {
            if kind == props::K_CHECKBOX {
                match checkbox::find(k, within: root) {
                    option::Option[checkbox::Checkbox]::Some(c) => {
                        let _h: checkbox::Checkbox = c.set_on(b);
                        return insp::Outcome::Ok;
                    }
                    option::Option::None => { return insp::Outcome::NotFound; }
                }
            }
            if kind == props::K_TOGGLE {
                match toggle::find(k, within: root) {
                    option::Option[toggle::Toggle]::Some(t) => {
                        let _h: toggle::Toggle = t.set_on(b);
                        return insp::Outcome::Ok;
                    }
                    option::Option::None => { return insp::Outcome::NotFound; }
                }
            }
            return insp::Outcome::UnknownProperty;
        }
        option::Option::None => insp::Outcome::TypeMismatch,
    };
}

// The one write door. Order matters: liveness before existence before
// writability before type, so the answer names the FIRST thing that was wrong
// rather than the last thing checked.
fn set(h: insp::Handle, prop: str, take v: insp::Value) -> insp::Outcome {
    if h.is_none() { return insp::Outcome::NotFound; }
    if !h.is_live() { return insp::Outcome::Stale; }
    if is_computed_prop(prop) { return insp::Outcome::ReadOnly; }
    let n: *core::Node = h.node;

    // Record what the application declared, before the first inspector write
    // to this pair replaces it.
    match get(h, prop) {
        option::Option[insp::Value]::Some(orig) => { ledger_record(n, h.window, prop, orig); }
        option::Option::None => { }
    }

    let r: insp::Outcome = apply_uniform(n, prop, v);
    return match r {
        insp::Outcome::UnknownProperty => apply_control(n, prop, v, h.window),
        _ => r,
    };
}

// Put back what the application declared and forget the record. Resetting a
// property that was never overridden is `Ok` and changes nothing: it is
// already at the declared value, which is what was asked for.
fn reset(h: insp::Handle, prop: str) -> insp::Outcome {
    if h.is_none() { return insp::Outcome::NotFound; }
    if !h.is_live() { return insp::Outcome::Stale; }
    if is_computed_prop(prop) { return insp::Outcome::ReadOnly; }
    let n: *core::Node = h.node;
    return match ledger_take(n, prop) {
        option::Option[insp::Value]::Some(orig) => {
            let r: insp::Outcome = apply_uniform(n, prop, orig);
            match r {
                insp::Outcome::UnknownProperty => apply_control(n, prop, orig, h.window),
                _ => r,
            }
        }
        option::Option::None => insp::Outcome::Ok,
    };
}

// ---- inspect -----------------------------------------------------------------

// Installed by a platform module; zero keeps the portable answer, which is
// that facet knows nothing about native classes and says so by listing none.
//
// It RETURNS its rows rather than filling a vector through a pointer. A local
// whose address is taken cannot then be moved into a returned struct — the
// borrow checker treats the escape as a view that would dangle, which for a
// vector about to be handed back by value is exactly the shape it is there to
// refuse. Returning the vector never takes an address at all.
static NATIVE_FN: fn(*core::Node) -> vec::Vec[insp::Prop] =
    #zero::[fn(*core::Node) -> vec::Vec[insp::Prop]]();

fn set_native_fn(f: fn(*core::Node) -> vec::Vec[insp::Prop]) { NATIVE_FN = f; return; }

// ONE LIST, and it is not this one.
//
// `vocabulary::table` is the list — name, type, unit, the kinds that carry it,
// and a line saying what it does — and this reads the names off it. Before,
// the names were written here and the types were written in a tool description
// that promised them and never returned any, and the two disagreed about five
// properties. A second hand-written list cannot drift from the first if there
// is no second list.
//
// The order is the table's order, which is the order the UI draws: what it is,
// then how big, then how it looks.
fn declared_names() -> vec::Vec[str] {
    var v: vec::Vec[str] = vec::new::[str]();
    let t: vec::Vec[voc::Descriptor] = voc::table();
    var i: usize = 0;
    while i < t.count() {
        match t.at_ptr(i) {
            option::Option[*voc::Descriptor]::Some(p) => {
                let _s: status::Status = v.append({ (*p).name });
            }
            option::Option::None => { }
        }
        i = i +% 1;
    }
    return v;
}

// Every declared property this node actually answers, in draw order. A name
// the node does not carry (`title` on a label) is absent rather than present
// and empty: an editor for a property that does not exist is an invitation to
// write into nothing.
fn declared_props(h: insp::Handle, n: *core::Node) -> vec::Vec[insp::Prop] {
    var out: vec::Vec[insp::Prop] = vec::new::[insp::Prop]();
    let names: vec::Vec[str] = declared_names();
    var i: usize = 0;
    let c: usize = names.count();
    while i < c {
        match names.at(i) {
            option::Option[str]::Some(nm) => {
                match get(h, nm) {
                    option::Option[insp::Value]::Some(v) => {
                        let _s: status::Status =
                            out.append(insp::Prop::editable(nm, v, is_overridden(n, nm)));
                    }
                    option::Option::None => { }
                }
            }
            option::Option::None => { }
        }
        i = i +% 1;
    }
    return out;
}

// What layout and mount decided. Never writable — setting `width` writes a
// style, and reading the frame reads what came out the other side. Two
// different questions that happen to share a word, which is why they are two
// panels and not one list.
fn computed_props(n: *core::Node) -> vec::Vec[insp::Prop] {
    var out: vec::Vec[insp::Prop] = vec::new::[insp::Prop]();
    let f: insp::Frame = core::frame_of(n);
    let _a: status::Status = out.append(insp::Prop::read_only("frame_x", insp::Value::Num(f.left)));
    let _b: status::Status = out.append(insp::Prop::read_only("frame_y", insp::Value::Num(f.top)));
    let _c: status::Status = out.append(insp::Prop::read_only("frame_width", insp::Value::Num(f.width)));
    let _d: status::Status = out.append(insp::Prop::read_only("frame_height", insp::Value::Num(f.height)));
    let _e: status::Status = out.append(insp::Prop::read_only("attached", insp::Value::Bool(core::is_attached(n))));
    let _f: status::Status = out.append(insp::Prop::read_only("focused", insp::Value::Bool(core::is_focused(n))));
    let _g: status::Status = out.append(insp::Prop::read_only("kind",
        insp::Value::Str(text::from_str(insp::kind_name(core::kind_of(n))))));
    let _h: status::Status = out.append(insp::Prop::read_only("has_view",
        insp::Value::Bool(core::view_of(n) != (0 as *u8))));
    return out;
}

fn native_props(n: *core::Node) -> vec::Vec[insp::Prop] {
    let nf: fn(*core::Node) -> vec::Vec[insp::Prop] = NATIVE_FN;
    if nf.is_null() {
        return vec::new::[insp::Prop]();
    }
    return nf(n);
}

fn inspect(h: insp::Handle) -> option::Option[insp::Detail] {
    if !h.is_live() { return option::Option[insp::Detail]::None; }
    let n: *core::Node = h.node;
    return option::Option[insp::Detail]::Some(insp::Detail {
        node: row_of(n, option::Option[usize]::None, 0, h.window, false),
        declared: declared_props(h, n),
        computed: computed_props(n),
        native: native_props(n),
    });
}

// ---- the C+ snippet ----------------------------------------------------------

fn append_num(t: *text::Text, x: f64) {
    // Whole numbers read as whole numbers: `12` and not `12.000000`, because
    // the snippet is meant to be pasted into source a human will read.
    let r: f64 = x - (((x as i64) as f64));
    if r == 0.0 {
        let _a: status::Status = { (*t).append({ (x as i64) }.to_text().view()) };
        let _b: status::Status = { (*t).append(".0f64") };
        return;
    }
    let _c: status::Status = { (*t).append(x.to_text().view()) };
    let _d: status::Status = { (*t).append("f64") };
}

// The experiment, as source. This is v1's whole persistence story and it is
// deliberately the smallest one that works: the developer copies a line they
// can read into the file it belongs in. An override ledger that reapplied
// itself would be a development tool quietly becoming part of the application.
//
// Answers "" for a node with no key, because a snippet that cannot address
// its target is not a snippet.
fn snippet_for(h: insp::Handle, prop: str) -> text::Text {
    var out: text::Text = text::new();
    if !h.is_live() { return out; }
    let n: *core::Node = h.node;
    let k: str = { (*n).key() };
    if k == "" { return out; }

    match get(h, prop) {
        option::Option[insp::Value]::Some(v) => {
            let _a: status::Status = out.append("core::set_");
            let _b: status::Status = out.append(prop);
            let _c: status::Status = out.append("(mount::node(\"");
            let _d: status::Status = out.append(k);
            let _e: status::Status = out.append("\"), ");
            match v {
                insp::Value::Num(x) => { append_num(#addr_of(out), x); }
                insp::Value::Int(i) => {
                    let _f: status::Status = out.append(i.to_text().view());
                }
                insp::Value::Bool(b) => {
                    let _g: status::Status = out.append(if b { "true" } else { "false" });
                }
                insp::Value::Str(s) => {
                    let _h2: status::Status = out.append("\"");
                    let _i: status::Status = out.append(s.view());
                    let _j: status::Status = out.append("\"");
                }
                insp::Value::Color(_c2) => {
                    let _k2: status::Status = out.append("/* colour */");
                }
                _ => { let _l: status::Status = out.append("/* unset */"); }
            }
            let _m: status::Status = out.append(");");
        }
        option::Option::None => { }
    }
    return out;
}

// ---- the diff ------------------------------------------------------------------
//
// THE JOURNAL IS THE DIFF between the tree the application built and the tree
// as it stands. Not a log of calls: nobody transcribing an editing session
// wants the nineteen intermediate values a nudge passed through, they want the
// one it landed on and the one it started from.
//
// The override ledger already IS that diff for properties — it records the
// first write to each (node, property) pair and nothing after it — so this
// reads it out rather than keeping a second record that could disagree. A
// `reset` removes the row, which is exactly right: the difference is gone.
//
// Structural edits keep their append-only lines. An insert is not a value that
// changed, it is a node that was not there, and the only honest way to state
// that difference is the operation that made it.

fn hex_digit_str(v: usize) -> str {
    if v == 0 { return "0"; }   if v == 1 { return "1"; }
    if v == 2 { return "2"; }   if v == 3 { return "3"; }
    if v == 4 { return "4"; }   if v == 5 { return "5"; }
    if v == 6 { return "6"; }   if v == 7 { return "7"; }
    if v == 8 { return "8"; }   if v == 9 { return "9"; }
    if v == 10 { return "a"; }  if v == 11 { return "b"; }
    if v == 12 { return "c"; }  if v == 13 { return "d"; }
    if v == 14 { return "e"; }
    return "f";
}

fn hex2(out: *text::Text, v: f64) {
    var x: f64 = v;
    if x < 0.0 { x = 0.0; }
    if x > 1.0 { x = 1.0; }
    let n: i64 = ((x * 255.0) + 0.5) as i64;
    let _a: status::Status = { (*out).append(hex_digit_str(((n / 16) as usize))) };
    let _b: status::Status = { (*out).append(hex_digit_str(((n % 16) as usize))) };
}

// A colour as the thing a person types back: `#rrggbb`, or `#rrggbbaa` when it
// is not fully opaque. A token-only colour (a theme role, no channels) says so
// by name — writing `#000000` for it would be a lie the developer then pastes.
fn color_text(c: vocab::Color) -> text::Text {
    if c.token != 255u32 {
        var t: text::Text = text::from_str("token ");
        let _a: status::Status = t.append((c.token as i64).to_text().view());
        return t;
    }
    var out: text::Text = text::from_str("#");
    hex2(#addr_of(out), c.r);
    hex2(#addr_of(out), c.g);
    hex2(#addr_of(out), c.b);
    if c.a < 1.0 { hex2(#addr_of(out), c.a); }
    return out;
}

// One value, as it would be written. Every shape the surface can hold — which
// is the part `snippet_for` never grew: a colour came out `/* colour */` and
// every enum fell through to `/* unset */`.
fn value_text(v: insp::Value) -> text::Text {
    return match v {
        insp::Value::Nothing => text::from_str("unset"),
        insp::Value::Bool(b) => text::from_str(if b { "true" } else { "false" }),
        insp::Value::Int(i) => i.to_text(),
        insp::Value::Num(x) => plain_num(x),
        insp::Value::Str(t) => t.clone(),
        insp::Value::Enum(e) => e.clone(),
        insp::Value::Color(c) => color_text(c),
    };
}

// Every property that differs from what the application declared.
fn changes() -> vec::Vec[insp::Change] {
    var out: vec::Vec[insp::Change] = vec::new::[insp::Change]();
    var i: usize = 0;
    while i < OVERRIDES.count() {
        match OVERRIDES.at_ptr(i) {
            option::Option[*Override]::Some(p) => {
                let n: *core::Node = { (*p).node };
                let h: insp::Handle = insp::Handle::of(n, { (*p).window });
                // A node the tree no longer holds is not a difference anyone
                // can act on — the row would name a key that is gone.
                if h.is_live() {
                    let k: str = { (*n).key() };
                    if k != "" {
                        let nowv: insp::Value = match get(h, { (*p).prop }) {
                            option::Option[insp::Value]::Some(v) => v,
                            option::Option::None => insp::Value::Nothing,
                        };
                        var label: text::Text =
                            text::from_str(insp::kind_name(core::kind_of(n)));
                        let _h2: status::Status = label.append("#");
                        let _h3: status::Status = label.append(k);
                        let _s: status::Status = out.append(insp::Change {
                            node: label, prop: { (*p).prop }, now: nowv,
                        });
                    }
                }
            }
            option::Option::None => { }
        }
        i = i +% 1;
    }
    return out;
}

// The diff as the text a person pastes. The same two levels the `journal` verb
// answers, laid out to be read:
//
//     {
//       "label#title": { "font_size": 30, "text_color": "#cc2200" },
//       "node#card":   { "padding": 24 }
//     }
//
// Written here rather than in the widget so both consumers — the panel's Copy
// button and anything that wants the text form over the wire — say the same
// thing, and so the widget stays free of a JSON dependency it has no other use
// for.
fn quoted_value(v: insp::Value) -> text::Text {
    // Numbers and booleans are bare; everything else is a string, which is what
    // the wire form does too — a colour is `"#cc2200"`, an enum is its
    // spelling, a percent length is `"50%"`.
    let bare: bool = match v {
        insp::Value::Num(_x) => true,
        insp::Value::Int(_i) => true,
        insp::Value::Bool(_b) => true,
        _ => false,
    };
    let body: text::Text = value_text(v);
    if bare { return body; }
    var out: text::Text = text::from_str("\"");
    let _a: status::Status = out.append(body.view());
    let _b: status::Status = out.append("\"");
    return out;
}

fn changes_text() -> text::Text {
    let cs: vec::Vec[insp::Change] = changes();
    if cs.count() == 0 { return text::from_str("{}\n"); }
    var out: text::Text = text::from_str("{\n");
    var i: usize = 0;
    while i < cs.count() {
        var label: text::Text = text::new();
        match cs.at_ptr(i) {
            option::Option[*insp::Change]::Some(c) => { label = { (*c).node }.clone(); }
            option::Option::None => { }
        }
        // One entry per node, gathering its rows: the ledger is in write order,
        // so a node's properties are not necessarily adjacent.
        if !node_written_before(cs, i, { label.view() }) {
            if out.count() > (2 as usize) { let _s: status::Status = out.append(",\n"); }
            let _a: status::Status = out.append("  \"");
            let _b: status::Status = out.append(label.view());
            let _c2: status::Status = out.append("\": { ");
            var first: bool = true;
            var j: usize = i;
            while j < cs.count() {
                match cs.at_ptr(j) {
                    option::Option[*insp::Change]::Some(c) => {
                        if { (*c).node.view() } == { label.view() } {
                            if !first { let _d: status::Status = out.append(", "); }
                            first = false;
                            let _e: status::Status = out.append("\"");
                            let _f: status::Status = out.append({ (*c).prop });
                            let _g: status::Status = out.append("\": ");
                            let _h2: status::Status =
                                out.append(quoted_value({ (*c).now }.clone()).view());
                        }
                    }
                    option::Option::None => { }
                }
                j = j +% 1;
            }
            let _i2: status::Status = out.append(" }");
        }
        i = i +% 1;
    }
    let _z: status::Status = out.append("\n}\n");
    return out;
}

fn node_written_before(cs: vec::Vec[insp::Change], i: usize, label: str) -> bool {
    var k: usize = 0;
    while k < i {
        match cs.at_ptr(k) {
            option::Option[*insp::Change]::Some(c) => {
                if { (*c).node.view() } == label { return true; }
            }
            option::Option::None => { }
        }
        k = k +% 1;
    }
    return false;
}

// ---- the clipboard -------------------------------------------------------------
//
// Installed by a platform module, like the highlight overlay and the native
// rows. Zero keeps the portable answer, which is that this build cannot reach a
// clipboard and says so rather than reporting a copy that did not happen — the
// panel's status line is the only feedback a Copy button has, and one that
// always says "copied" is worse than no button.
static CLIPBOARD_FN: fn(str) -> bool = #zero::[fn(str) -> bool]();

fn set_clipboard_fn(f: fn(str) -> bool) { CLIPBOARD_FN = f; return; }

fn can_copy() -> bool { return CLIPBOARD_FN.is_not_null(); }

fn copy_text(s: str) -> bool {
    if CLIPBOARD_FN.is_null() { return false; }
    let f: fn(str) -> bool = CLIPBOARD_FN;
    return f(s);
}

// ---- structure ---------------------------------------------------------------
//
// Adding and removing nodes, which is the same live-tree machinery property
// editing already rides. `facet/mount` owns every actual operation: it creates
// the views for an inserted subtree and computes the native slot through
// passthrough containers, and on removal it notifies detach while the subtree
// is still whole, pulls the views out of the host, and hands the subtree back.
//
// So this section is not a tree editor. It is an ADDRESSER and a set of
// refusals — the cases mount would perform faithfully and a developer would
// not have wanted.
//
// ---- what a structural edit does to handles -----------------------------------
//
// An insert leaves every outstanding handle live: `flex::removal_count()` moves
// on removals only. A REMOVE ends every generation in every tree, which is
// conservative and is what facet's own typed handles already do. The consumer's
// answer to both is the same and is cheap: re-describe. The panel does it on
// every structural verb, and its tree pane keys folds and selection by node
// address, so the user's view survives the rebuild.

// The makers, spelled as `elements` spells them.
//
// A short hand-written list rather than a generated table over all 38 controls.
// Two reasons it is the right size: a structural experiment is nearly always
// "what if there were a row here with a label in it", and every one of these
// takes at most one string, so the spec stays three fields instead of becoming
// a second property-writing path. A control that needs configuring is made
// here and then edited with the editor that already exists.
//
// This is the list `gen_contract.py` should emit when it grows an inspector
// dispatch layer. Until then, adding one is a line here and a line in
// `maker_names`.
fn make(sp: insp::Spec) -> option::Option[core::Node] {
    let m: str = sp.maker.view();
    let k: str = sp.key.view();
    let t: str = sp.label.view();

    if m == "label" {
        return option::Option[core::Node]::Some(
            ui::label(t, key: k, text_align: vocab::TextAlign::Start));
    }
    if m == "button" {
        // No `on_click`. A button the inspector made has no handler and cannot
        // be given one — a function pointer is not a value any inspector can
        // carry, and typing one into a text box is a crash with extra steps.
        // That boundary is exactly where structural editing stops and code
        // reloading would begin.
        return option::Option[core::Node]::Some(ui::button(t, key: k));
    }
    if m == "text_button" {
        return option::Option[core::Node]::Some(
            ui::text_button(t, key: k, text_color: vocab::Color::link()));
    }
    if m == "text_field" {
        return option::Option[core::Node]::Some(
            ui::text_field(t, key: k, text_align: vocab::TextAlign::Start));
    }
    if m == "checkbox" {
        return option::Option[core::Node]::Some(ui::checkbox(false, key: k));
    }
    if m == "row" {
        var b: core::Builder = core::Builder::new();
        return option::Option[core::Node]::Some(ui::row(b, key: k));
    }
    if m == "column" {
        var b: core::Builder = core::Builder::new();
        return option::Option[core::Node]::Some(ui::column(b, key: k));
    }
    if m == "spacer" {
        return option::Option[core::Node]::Some(ui::spacer(key: k).grow(1.0));
    }
    if m == "box" {
        return option::Option[core::Node]::Some(
            ui::box(vocab::Color::control_background(), key: k));
    }
    return option::Option[core::Node]::None;
}

// For a UI that wants to offer the list rather than make the developer
// remember it. Same order as `make`, and the same names.
fn maker_names() -> vec::Vec[str] {
    var v: vec::Vec[str] = vec::new::[str]();
    let _a: status::Status = v.append("label");
    let _b: status::Status = v.append("button");
    let _c: status::Status = v.append("text_button");
    let _d: status::Status = v.append("text_field");
    let _e: status::Status = v.append("checkbox");
    let _f: status::Status = v.append("row");
    let _g: status::Status = v.append("column");
    let _h: status::Status = v.append("spacer");
    let _i: status::Status = v.append("box");
    return v;
}

// Can this node take an inserted child?
//
// Kind 0 is every container facet did not generate — row, column, stack, card
// — and those are the answer nearly every time. `box` and `scroll` are
// generated controls that are nonetheless plain hosts.
//
// Everything else is refused, and the refusal is not caution. A leaf control
// hosts no views, so `nearest_host` would put the new child's view in the
// LEAF'S parent while the node sat under the leaf: visibly in the wrong place,
// and wrong in the leaf's measure too. A list, table, tabs or collection owns
// its children through recycling or a pane registry, which a raw insert fights
// rather than joins.
fn can_host_children(n: *core::Node) -> bool {
    if n.is_null() { return false; }
    let kind: u32 = core::kind_of(n);
    if kind == 0 { return true; }
    if kind == props::K_BOX { return true; }
    if kind == props::K_SCROLL { return true; }
    return false;
}

// Is `target` inside `root`'s subtree (or `root` itself)?
//
// Used twice, for two different refusals that are the same walk: protecting the
// panel's own subtree from being edited by the panel, and refusing a move that
// would put a node inside itself.
fn within(root: *core::Node, target: *core::Node) -> bool {
    if root.is_null() { return false; }
    if target.is_null() { return false; }
    if root == target { return true; }
    var i: usize = 0;
    let c: usize = core::child_count_of(root);
    while i < c {
        match core::child_of(root, i) {
            option::Option[*core::Node]::Some(ch) => {
                if within(ch, target) { return true; }
            }
            option::Option::None => { }
        }
        i = i +% 1;
    }
    return false;
}

// The panel is part of the tree it inspects. A tool that can delete its own
// controls can end a debugging session with one misplaced click.
fn is_panels_own(n: *core::Node) -> bool { return within(SELF_ROOT, n); }

// ---- the trash ---------------------------------------------------------------
//
// A removed subtree, kept so `undo` can put it back where it was.
//
// PARALLEL VECTORS AND NOT ONE OF A STRUCT, for a language reason worth
// stating: `core::Node` carries a destructor, so a field of it cannot be moved
// out of an owning struct — the same rule `ledger_take` documents for `Value`.
// Undo has to MOVE the node into `insert_child`, which takes it by value, so
// the node has to live in a vector of its own where `remove_last` hands the
// whole element over.
//
// THE PARENT IS RECORDED AS A PATH, NOT AS A POINTER. An address is not an
// identity for a node that can move, and the undo stack is exactly where one
// does: `remove(kid); remove(holder); undo(); undo()` restores the holder by
// MOVING it back into its parent's child vector, at whatever address that
// vector's storage gives it. Usually — but not reliably — the one it had
// before. So the kid's stored parent pointer was a coin flip, the mounted-check
// answered false when it landed wrong, and the second undo refused. That is
// bugs/closed/inspector-undo-test-is-flaky.md: about one run in four, with nothing
// but the allocator differing between them.
//
// A path — a window index plus the chain of child indices down to the parent —
// survives the move, because the stack restores the structure the path was
// recorded against before it needs it. Flattened into one vector with a
// parallel length, rather than a `Vec[Vec[usize]]`, so the pop stays a
// `remove_last` loop and the nested-generic question never comes up.
static TRASH: vec::Vec[core::Node] = #zero::[vec::Vec[core::Node]]();
static TRASH_WINDOW: vec::Vec[usize] = #zero::[vec::Vec[usize]]();
static TRASH_PATH: vec::Vec[usize] = #zero::[vec::Vec[usize]]();
static TRASH_PATH_LEN: vec::Vec[usize] = #zero::[vec::Vec[usize]]();
static TRASH_AT: vec::Vec[usize] = #zero::[vec::Vec[usize]]();

fn trash_count() -> usize { return TRASH.count(); }

// Drop every held subtree without restoring anything. This is what RELEASES
// their native views — `remove_child` took them out of the host, and the
// renderer's paired release runs with the node's destructor.
fn empty_trash() {
    TRASH.remove_all();
    TRASH_WINDOW.remove_all();
    TRASH_PATH.remove_all();
    TRASH_PATH_LEN.remove_all();
    TRASH_AT.remove_all();
}

// The child-index chain from `root` down to `target`, deepest step last,
// appended to `out`. False (and `out` left as it was found) when `target` is
// not in `root`'s subtree. A `root == target` answer is an empty chain, which
// is the right one: the window root's own path is no steps.
fn path_to(root: *core::Node, target: *core::Node, ref out: vec::Vec[usize]) -> bool {
    if root.is_null() { return false; }
    if target.is_null() { return false; }
    if root == target { return true; }
    var i: usize = 0;
    let c: usize = core::child_count_of(root);
    while i < c {
        match core::child_of(root, i) {
            option::Option[*core::Node]::Some(ch) => {
                let _a: status::Status = out.append(i);
                if path_to(ch, target, out) { return true; }
                let _r: option::Option[usize] = out.remove_last();
            }
            option::Option::None => { }
        }
        i = i +% 1;
    }
    return false;
}

// Record `p`'s position as a path. False when `p` is in no open window, which
// is a removal whose parent is already gone — the caller keeps the subtree out
// of the trash rather than storing a path that can never resolve.
fn trash_push_parent(p: *core::Node) -> bool {
    var w: usize = 0;
    let n: usize = app::window_count();
    while w < n {
        let before: usize = TRASH_PATH.count();
        if path_to(app::window_root(w), p, TRASH_PATH) {
            let _w: status::Status = TRASH_WINDOW.append(w);
            let _l: status::Status = TRASH_PATH_LEN.append(TRASH_PATH.count() -% before);
            return true;
        }
        w = w +% 1;
    }
    return false;
}

// An in-range `at` never answers `None`; the fallback exists so the walk below
// stays a plain expression rather than a flag.
fn or_zero(o: option::Option[usize]) -> usize {
    return match o {
        option::Option[usize]::Some(x) => x,
        option::Option::None => 0,
    };
}

// Resolve the path recorded for the entry on top of the trash. Null when the
// window is gone or a step no longer exists — the parent this entry named is
// not there any more, and `undo_remove` refuses rather than guessing.
fn trash_top_parent() -> *core::Node {
    let c: usize = TRASH_PATH_LEN.count();
    if c == 0 { return 0 as *core::Node; }
    let last: usize = c -% 1;
    let len: usize = or_zero(TRASH_PATH_LEN.at(last));
    let w: usize = or_zero(TRASH_WINDOW.at(last));
    if w >= app::window_count() { return 0 as *core::Node; }
    if len > TRASH_PATH.count() { return 0 as *core::Node; }
    var n: *core::Node = app::window_root(w);
    let base: usize = TRASH_PATH.count() -% len;
    var i: usize = 0;
    while i < len {
        if n.is_null() { return 0 as *core::Node; }
        match core::child_of(n, or_zero(TRASH_PATH.at(base +% i))) {
            option::Option[*core::Node]::Some(ch) => { n = ch; }
            option::Option::None => { return 0 as *core::Node; }
        }
        i = i +% 1;
    }
    return n;
}

// Drop the top entry's path. Paired with every `TRASH.remove_last()`.
fn trash_pop_parent() {
    let c: usize = TRASH_PATH_LEN.count();
    if c == 0 { return; }
    let len: usize = match TRASH_PATH_LEN.remove_last() {
        option::Option[usize]::Some(x) => x,
        option::Option::None => 0,
    };
    let _w: option::Option[usize] = TRASH_WINDOW.remove_last();
    var i: usize = 0;
    while i < len {
        let _s: option::Option[usize] = TRASH_PATH.remove_last();
        i = i +% 1;
    }
}

// ---- the journal -------------------------------------------------------------
//
// A structural edit has no "value it used to be", so the override ledger cannot
// hold it and `reset` cannot undo it. What it has instead is the same thing the
// property tier's `snippet_for` has: the edit, as the line of source that would
// make it. The journal accumulates those lines in the order they happened, and
// `Copy as C+` prints them.
//
// Volatile, like the ledger, and for the same reason: an inspector that
// replayed its own structural edits at startup would have become the part of
// the application that builds the UI.
static JOURNAL: vec::Vec[text::Text] = #zero::[vec::Vec[text::Text]]();

fn journal_count() -> usize { return JOURNAL.count(); }

fn journal_at(i: usize) -> option::Option[text::Text] {
    return match JOURNAL.at_ptr(i) {
        option::Option[*text::Text]::Some(p) => option::Option[text::Text]::Some({ (*p) }.clone()),
        option::Option::None => option::Option[text::Text]::None,
    };
}

fn forget_journal() {
    JOURNAL.remove_all();
}

fn journal(take line: text::Text) {
    let _s: status::Status = JOURNAL.append(line);
}

// How a node is named in a snippet. A key, or nothing at all — an unkeyed node
// has no expression that addresses it, and inventing one would produce a line
// that compiles and edits the wrong node.
fn addressable(n: *core::Node) -> bool {
    if n.is_null() { return false; }
    return { (*n).key() } != "";
}

fn append_target(t: *text::Text, n: *core::Node) {
    let _a: status::Status = { (*t).append("mount::node(\"") };
    let _b: status::Status = { (*t).append({ (*n).key() }) };
    let _c: status::Status = { (*t).append("\")") };
}

// `ui::label("hi", key: "greeting")` — the maker call, as source.
fn append_maker(t: *text::Text, sp: insp::Spec) {
    let m: str = sp.maker.view();
    let takes_string: bool = (m == "label") || (m == "button") || (m == "text_button")
        || (m == "text_field");
    let _a: status::Status = { (*t).append("ui::") };
    let _b: status::Status = { (*t).append(m) };
    let _c: status::Status = { (*t).append("(") };
    if takes_string {
        let _d: status::Status = { (*t).append("\"") };
        let _e: status::Status = { (*t).append(sp.label.view()) };
        let _f: status::Status = { (*t).append("\"") };
    }
    if m == "checkbox" { let _g: status::Status = { (*t).append("false") }; }
    if m == "box" {
        let _h: status::Status = { (*t).append("vocab::Color::control_background()") };
    }
    if !sp.key.is_empty() {
        if takes_string || (m == "checkbox") || (m == "box") {
            let _i: status::Status = { (*t).append(", ") };
        }
        let _j: status::Status = { (*t).append("key: \"") };
        let _k: status::Status = { (*t).append(sp.key.view()) };
        let _l: status::Status = { (*t).append("\"") };
    }
    let _m: status::Status = { (*t).append(")") };
}

fn journal_insert(parent: *core::Node, at: usize, count: usize, sp: insp::Spec) {
    var line: text::Text = text::new();
    if !addressable(parent) {
        // Said rather than skipped. A developer who edits and then finds one
        // line missing from the copy has to work out which edit it was; a
        // developer told the parent needs a key knows what to do next.
        let _a: status::Status = line.append("// inserted ");
        let _b: status::Status = line.append(sp.maker.view());
        let _c: status::Status =
            line.append(" under an unkeyed node - give that node a key to address this");
        journal(line);
        return;
    }
    // An append is `add_child`, which is what an application writes. Only a
    // genuine mid-list insert needs the index.
    if at >= count {
        let _d: status::Status = line.append("mount::add_child(");
        append_target(#addr_of(line), parent);
        let _e: status::Status = line.append(", ");
        append_maker(#addr_of(line), sp);
        let _f: status::Status = line.append(");");
        journal(line);
        return;
    }
    let _g: status::Status = line.append("mount::insert_child(");
    append_target(#addr_of(line), parent);
    let _h: status::Status = line.append(", ");
    append_maker(#addr_of(line), sp);
    let _i: status::Status = line.append(", ");
    let _j: status::Status = line.append({ (at as i64) }.to_text().view());
    let _k: status::Status = line.append(");");
    journal(line);
}

fn journal_remove(n: *core::Node) {
    var line: text::Text = text::new();
    if !addressable(n) {
        let _a: status::Status = line.append("// removed an unkeyed ");
        let _b: status::Status = line.append(insp::kind_name(core::kind_of(n)));
        let _c: status::Status = line.append(" - no key, so no line that addresses it");
        journal(line);
        return;
    }
    let _d: status::Status = line.append("mount::remove(\"");
    let _e: status::Status = line.append({ (*n).key() });
    let _f: status::Status = line.append("\");");
    journal(line);
}

// ---- the verbs ---------------------------------------------------------------

// Everything both structural verbs check before they touch anything: the
// handle is live, the node is real, and it is not the panel's own.
fn structural_guard(h: insp::Handle) -> insp::Outcome {
    if h.is_none() { return insp::Outcome::NotFound; }
    if !h.is_live() { return insp::Outcome::Stale; }
    if is_panels_own(h.node) { return insp::Outcome::Protected; }
    return insp::Outcome::Ok;
}

// Build `sp` and put it in `parent` at `at`, clamped to the end.
fn insert(parent: insp::Handle, at: usize, take sp: insp::Spec) -> insp::Outcome {
    let g: insp::Outcome = structural_guard(parent);
    if !g.is_ok() { return g; }
    let p: *core::Node = parent.node;
    if !can_host_children(p) { return insp::Outcome::NotAContainer; }

    // Made BEFORE the journal line, so a maker name nobody implements is
    // `UnknownKind` rather than a journal entry for an edit that never
    // happened.
    return match make(sp.clone()) {
        option::Option[core::Node]::Some(child) => {
            let count: usize = core::child_count_of(p);
            if mount::insert_child(p, child, at) {
                journal_insert(p, at, count, sp);
                insp::Outcome::Ok
            } else {
                insp::Outcome::NotAContainer
            }
        }
        option::Option::None => insp::Outcome::UnknownKind,
    };
}

// Take the node out and KEEP it, so `undo` can put it back.
//
// `mount::remove_node` is the other spelling and it drops the subtree; this one
// wants the subtree, which is what `remove_child` hands back.
fn remove(h: insp::Handle) -> insp::Outcome {
    let g: insp::Outcome = structural_guard(h);
    if !g.is_ok() { return g; }
    let n: *core::Node = h.node;
    return match mount::parent_of(n) {
        // No parent means a window root — closed with `app::close_window`, not
        // deleted out from under itself.
        option::Option::None => insp::Outcome::Protected,
        option::Option[*core::Node]::Some(p) => match { (*p).child_index(n) } {
            option::Option::None => insp::Outcome::NotFound,
            option::Option[usize]::Some(at) => {
                // Journalled while the node is still whole: after the removal
                // its key is not readable from a pointer this scope still has.
                journal_remove(n);
                // The parent's path is taken while the tree still holds it,
                // and BEFORE the removal shifts its siblings — the path names
                // the parent, not the node, so the removal below does not
                // move it.
                if !trash_push_parent(p) {
                    insp::Outcome::NotFound
                } else {
                    match mount::remove_child(p, at) {
                        option::Option[core::Node]::Some(gone) => {
                            let _a: status::Status = TRASH.append(gone);
                            let _c: status::Status = TRASH_AT.append(at);
                            insp::Outcome::Ok
                        }
                        option::Option::None => {
                            trash_pop_parent();
                            insp::Outcome::NotFound
                        }
                    }
                }
            }
        },
    };
}

// Move a live node under a new parent.
//
// Remove-then-insert, but as ONE verb, because between the two halves the
// subtree is owned by nobody a caller could name — `remove_child` hands back a
// value, and a value that is not immediately moved somewhere is a value that is
// dropped.
fn reparent(h: insp::Handle, parent: insp::Handle, at: usize) -> insp::Outcome {
    let g: insp::Outcome = structural_guard(h);
    if !g.is_ok() { return g; }
    let g2: insp::Outcome = structural_guard(parent);
    if !g2.is_ok() { return g2; }
    let n: *core::Node = h.node;
    let p: *core::Node = parent.node;
    if !can_host_children(p) { return insp::Outcome::NotAContainer; }
    // Into itself, or into anything under itself. Checked before the removal:
    // afterwards the answer would be no and the tree would already be cut.
    if within(n, p) { return insp::Outcome::Cycle; }

    return match mount::parent_of(n) {
        option::Option::None => insp::Outcome::Protected,
        option::Option[*core::Node]::Some(old) => match { (*old).child_index(n) } {
            option::Option::None => insp::Outcome::NotFound,
            option::Option[usize]::Some(from) => {
                var line: text::Text = text::new();
                if addressable(n) {
                    if addressable(p) {
                        let _a: status::Status = line.append("// moved #");
                        let _b: status::Status = line.append({ (*n).key() });
                        let _c: status::Status = line.append(" under #");
                        let _d: status::Status = line.append({ (*p).key() });
                        let _e: status::Status =
                            line.append(" - move the builder call, there is no runtime verb for it");
                        journal(line);
                    }
                }
                match mount::remove_child(old, from) {
                    option::Option[core::Node]::Some(moved) => {
                        if mount::insert_child(p, moved, at) { insp::Outcome::Ok }
                        // The subtree was dropped by `insert_child`'s failure
                        // path taking it by value. Nothing to put back and
                        // nothing that still points at it.
                        else { insp::Outcome::NotAContainer }
                    }
                    option::Option::None => insp::Outcome::NotFound,
                }
            }
        },
    };
}

// Put the most recent removal back where it came from.
fn undo_remove() -> insp::Outcome {
    let c: usize = TRASH.count();
    if c == 0 { return insp::Outcome::NothingToUndo; }
    let at: usize = match TRASH_AT.at(c -% 1) {
        option::Option[usize]::Some(x) => x,
        option::Option::None => 0,
    };
    // Resolved now, not stored then: the parent may have been removed and put
    // back by an earlier undo, at a different address. Null means the path no
    // longer leads anywhere. Answering `NothingToUndo` keeps the subtree in the
    // trash rather than inserting it into a node that is no longer in any
    // window, where it would be invisible and unreachable.
    // Null is the only failure to test for: the path is walked FROM a window
    // root, so anything it reaches is mounted by construction. The pointer
    // version needed a `still_mounted` sweep here precisely because its parent
    // came from nowhere the tree could vouch for.
    let parent: *core::Node = trash_top_parent();
    if parent.is_null() { return insp::Outcome::NothingToUndo; }

    trash_pop_parent();
    let _a: option::Option[usize] = TRASH_AT.remove_last();
    return match TRASH.remove_last() {
        option::Option[core::Node]::Some(n) => {
            if mount::insert_child(parent, n, at) { insp::Outcome::Ok }
            else { insp::Outcome::NotAContainer }
        }
        option::Option::None => insp::Outcome::NothingToUndo,
    };
}

// ---- the backend -------------------------------------------------------------

fn bk_describe(_s: *u8) -> vec::Vec[insp::Node] { return describe(); }
fn bk_inspect(_s: *u8, h: insp::Handle) -> option::Option[insp::Detail] { return inspect(h); }
fn bk_set(_s: *u8, h: insp::Handle, p: str, take v: insp::Value) -> insp::Outcome {
    return set(h, p, v);
}
fn bk_reset(_s: *u8, h: insp::Handle, p: str) -> insp::Outcome { return reset(h, p); }
fn bk_insert(_s: *u8, h: insp::Handle, at: usize, take sp: insp::Spec) -> insp::Outcome {
    return insert(h, at, sp);
}
fn bk_remove(_s: *u8, h: insp::Handle) -> insp::Outcome { return remove(h); }
fn bk_reparent(_s: *u8, h: insp::Handle, p: insp::Handle, at: usize) -> insp::Outcome {
    return reparent(h, p, at);
}
fn bk_undo(_s: *u8) -> insp::Outcome { return undo_remove(); }

// Installed by a platform module. Zero keeps the portable no-ops from
// `inspector`, so a build with no platform degrades to "cannot highlight"
// rather than to a crash.
static HIGHLIGHT_FN: fn(*u8, insp::Handle) = #zero::[fn(*u8, insp::Handle)]();
static CLEAR_FN: fn(*u8) = #zero::[fn(*u8)]();

fn install_platform(highlight: fn(*u8, insp::Handle), clear_highlight: fn(*u8)) {
    HIGHLIGHT_FN = highlight;
    CLEAR_FN = clear_highlight;
}

fn bk_highlight(s: *u8, h: insp::Handle) {
    let f: fn(*u8, insp::Handle) = HIGHLIGHT_FN;
    if f.is_not_null() { f(s, h); }
}
fn bk_clear_highlight(s: *u8) {
    let f: fn(*u8) = CLEAR_FN;
    if f.is_not_null() { f(s); }
}

// The in-process backend: no transport, no marshaling, and none needed.
// `core::touch` asserts it is on the UI thread, and an embedded consumer is
// already there. A socket adapter is the thing that will have to marshal, and
// that is exactly where the cost belongs — not on the local case that does not
// need it.
fn local_backend() -> insp::Backend {
    return insp::Backend {
        surface: 0 as *u8,
        describe: bk_describe,
        inspect: bk_inspect,
        set: bk_set,
        reset: bk_reset,
        highlight: bk_highlight,
        clear_highlight: bk_clear_highlight,
        insert: bk_insert,
        remove: bk_remove,
        reparent: bk_reparent,
        undo: bk_undo,
    };
}
