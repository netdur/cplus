// The Android face of `inspector/appkit` — a forwarder to the Android half.
//
// WHY THIS FILE EXISTS, and it is the same reason `appkit_ios.cplus` exists. A
// prebuilt package is compiled from a generated entry that imports EVERY module
// in `src/`, so the archive covers the whole public surface and matches the
// declarations in `lib/include/`. That is right for a portable package and
// wrong for a module that is one platform's half: `appkit.cplus` imports the
// `appkit` package, which is a `[macos.dependencies]` and is not linked for
// Android — so the Android slice would carry references to a package the app
// never asked for and the link would end on a list of undefined symbols named
// after it.
//
// IT FORWARDS RATHER THAN REFUSES, for the reason the iOS twin gives:
// `serve_android.cplus` is the Android twin of `appkit.cplus` — same six entry
// points, same job — so `inspector/appkit` can mean the platform half on ALL
// THREE platforms instead of quietly meaning nothing on one. A no-op would
// compile and then not draw an overlay, which is the kind of silence that costs
// an afternoon. An Android app normally arrives through `inspector/serve` and
// never names this module at all; a shared entry that does name it now works.

import "stdlib/vec" as vec;
import "facet/facet" as core;
import "./inspector" as insp;
import "./serve_android" as android;

fn install() { android::install(); return; }

fn serve_if_asked() { android::serve_if_asked(); return; }

fn place(n: *core::Node) -> android::Placed { return android::place(n); }

fn highlight(s: *u8, h: insp::Handle) { android::highlight(s, h); return; }

fn clear_highlight(s: *u8) { android::clear_highlight(s); return; }

fn native_props(n: *core::Node) -> vec::Vec[insp::Prop] { return android::native_props(n); }
