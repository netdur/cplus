// inspector/vocabulary — what a property IS.
//
// Three things live here, and they live together because they are one fact
// seen from three sides:
//
//   * the closed sets a style property can hold, as SPELLINGS. `align_items`
//     is not a number a client should send; it is one of eleven words, and the
//     word is the contract. A discriminant would break the first time the set
//     gained a member in the middle.
//   * the descriptor for every writable property — its type, its unit, the
//     kinds that carry it, and one line saying what it does.
//   * nothing else. `tree` decides what a write DOES; this module only says
//     what a client is allowed to send and what the answer will mean.
//
// The descriptor table is what the `vocabulary` verb serves, and it is checked
// against `tree::declared_names` BOTH WAYS by the suite. That check is the
// point of the file: before it, the tool description promised "which properties
// exist and what types they take" and the verb answered two arrays of bare
// names, which is neither.

import "stdlib/vec" as vec;
import "stdlib/status" as status;
import "stdlib/option" as option;
import "stdlib/str" as _;
import "flex_layout/flex_layout" as flex;
import "facet/vocabulary" as fvocab;

// ---- the closed sets ---------------------------------------------------------
//
// Every one of these is a pair — a spelling from a value and a value from a
// spelling — and the pair has to round-trip. A name that parses to a variant
// whose name is a different spelling is a property that silently changes when
// you read it back, which in a nudge loop reads as the app fighting you.

fn font_weight_names() -> vec::Vec[str] {
    var v: vec::Vec[str] = vec::new::[str]();
    let _a: status::Status = v.append("default");
    let _b: status::Status = v.append("ultra_light");
    let _c: status::Status = v.append("thin");
    let _d: status::Status = v.append("light");
    let _e: status::Status = v.append("regular");
    let _f: status::Status = v.append("medium");
    let _g: status::Status = v.append("semibold");
    let _h: status::Status = v.append("bold");
    let _i: status::Status = v.append("heavy");
    let _j: status::Status = v.append("black");
    return v;
}

fn font_weight_name(w: fvocab::FontWeight) -> str {
    return match w {
        fvocab::FontWeight::Default => "default",
        fvocab::FontWeight::UltraLight => "ultra_light",
        fvocab::FontWeight::Thin => "thin",
        fvocab::FontWeight::Light => "light",
        fvocab::FontWeight::Regular => "regular",
        fvocab::FontWeight::Medium => "medium",
        fvocab::FontWeight::Semibold => "semibold",
        fvocab::FontWeight::Bold => "bold",
        fvocab::FontWeight::Heavy => "heavy",
        fvocab::FontWeight::Black => "black",
    };
}

fn font_weight_from(name: str) -> option::Option[fvocab::FontWeight] {
    if name == "default" { return option::Option[fvocab::FontWeight]::Some(fvocab::FontWeight::Default); }
    if name == "ultra_light" { return option::Option[fvocab::FontWeight]::Some(fvocab::FontWeight::UltraLight); }
    if name == "thin" { return option::Option[fvocab::FontWeight]::Some(fvocab::FontWeight::Thin); }
    if name == "light" { return option::Option[fvocab::FontWeight]::Some(fvocab::FontWeight::Light); }
    if name == "regular" { return option::Option[fvocab::FontWeight]::Some(fvocab::FontWeight::Regular); }
    if name == "medium" { return option::Option[fvocab::FontWeight]::Some(fvocab::FontWeight::Medium); }
    if name == "semibold" { return option::Option[fvocab::FontWeight]::Some(fvocab::FontWeight::Semibold); }
    if name == "bold" { return option::Option[fvocab::FontWeight]::Some(fvocab::FontWeight::Bold); }
    if name == "heavy" { return option::Option[fvocab::FontWeight]::Some(fvocab::FontWeight::Heavy); }
    if name == "black" { return option::Option[fvocab::FontWeight]::Some(fvocab::FontWeight::Black); }
    return option::Option[fvocab::FontWeight]::None;
}

