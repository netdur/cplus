// inspector tests. No backend and no platform: the facet tree is facet's own
// state, so the walker, the dispatch, the override ledger and every refusal
// are exercisable headlessly.
//
// The suite is in three parts — unit, end-to-end over a mounted tree, and
// negative. The negative part is the one that matters most here: an inspector
// whose refusals are silent teaches a developer that a property does nothing,
// which is worse than teaching them nothing at all.

import "stdlib/vec" as vec;
import "stdlib/text" as text;
import "stdlib/option" as option;
import "stdlib/status" as status;
import "flex_layout/flex_layout" as flex;
import "facet/facet" as core;
import "facet/elements" as ui;
import "facet/application" as app;
import "facet/vocabulary" as vocab;
import "facet/props" as props;
import "facet/label" as label;
import "facet/button" as button;
import "facet/mount" as mount;
import "facet/tree" as ftree;
import "./inspector" as insp;
import "./tree" as tree;
import "./widget" as widget;
import "./appkit" as platform;
// Pulled in for its own `#[test]`s: without an import the module is not in the
// test binary at all, and its checks silently do not run.
import "./remote" as remote;
import "./mcp" as mcp;
import "agent_mcp/agent_mcp" as bridge;
import "agent_core/events" as aevents;
import "agent_core/auth" as aauth;

// ---- helpers -----------------------------------------------------------------

// The handle for the first row carrying `key`, or a null handle. By-value
// params borrow, so the listing is not consumed and the caller keeps it.
fn row_for(rows: vec::Vec[insp::Node], key: str) -> insp::Handle {
    var i: usize = 0 as usize;
    let c: usize = rows.count();
    while i < c {
        match rows.at_ptr(i) {
            option::Option[*insp::Node]::Some(p) => {
                if { (*p).key.view() } == key { return { (*p).handle }; }
            }
            option::Option[*insp::Node]::None => { }
        }
        i = i +% (1 as usize);
    }
    return insp::Handle::none();
}

// The `nth` row carrying `key`, for the duplicate-key case where "first
// match wins" is the behaviour under test.
fn nth_for(rows: vec::Vec[insp::Node], key: str, nth: usize) -> insp::Handle {
    var i: usize = 0 as usize;
    var seen: usize = 0 as usize;
    let c: usize = rows.count();
    while i < c {
        match rows.at_ptr(i) {
            option::Option[*insp::Node]::Some(p) => {
                if { (*p).key.view() } == key {
                    if seen == nth { return { (*p).handle }; }
                    seen = seen +% (1 as usize);
                }
            }
            option::Option[*insp::Node]::None => { }
        }
        i = i +% (1 as usize);
    }
    return insp::Handle::none();
}

// The first node of a given kind carrying no key — how a test reaches the
// unkeyed nodes that are the whole reason for walking facet's tree.
fn unkeyed_of_kind(rows: vec::Vec[insp::Node], kind: u32) -> insp::Handle {
    var i: usize = 0 as usize;
    let c: usize = rows.count();
    while i < c {
        match rows.at_ptr(i) {
            option::Option[*insp::Node]::Some(p) => {
                if { (*p).kind } == kind {
                    if { (*p).key.view() } == "" { return { (*p).handle }; }
                }
            }
            option::Option[*insp::Node]::None => { }
        }
        i = i +% (1 as usize);
    }
    return insp::Handle::none();
}

fn row_index(rows: vec::Vec[insp::Node], key: str) -> option::Option[usize] {
    var i: usize = 0 as usize;
    let c: usize = rows.count();
    while i < c {
        match rows.at_ptr(i) {
            option::Option[*insp::Node]::Some(p) => {
                if { (*p).key.view() } == key { return option::Option[usize]::Some(i); }
            }
            option::Option[*insp::Node]::None => { }
        }
        i = i +% (1 as usize);
    }
    return option::Option[usize]::None;
}

fn depth_of(rows: vec::Vec[insp::Node], key: str) -> usize {
    return match row_index(rows, key) {
        option::Option[usize]::Some(i) => {
            match rows.at_ptr(i) {
                option::Option[*insp::Node]::Some(p) => { (*p).depth }
                option::Option[*insp::Node]::None => 0 as usize,
            }
        }
        option::Option[usize]::None => 0 as usize,
    };
}

fn num_of_value(v: insp::Value) -> f64 {
    return match v {
        insp::Value::Num(x) => x,
        insp::Value::Int(i) => i as f64,
        _ => 0.0f64 / 0.0f64,
    };
}

fn get_num(h: insp::Handle, prop: str) -> f64 {
    return match tree::get(h, prop) {
        option::Option[insp::Value]::Some(v) => num_of_value(v),
        option::Option[insp::Value]::None => 0.0f64 / 0.0f64,
    };
}

fn get_bool(h: insp::Handle, prop: str) -> bool {
    return match tree::get(h, prop) {
        option::Option[insp::Value]::Some(v) => match v {
            insp::Value::Bool(b) => b,
            _ => false,
        },
        option::Option[insp::Value]::None => false,
    };
}

fn text_eq(h: insp::Handle, prop: str, want: str) -> bool {
    return match tree::get(h, prop) {
        option::Option[insp::Value]::Some(v) => match v {
            insp::Value::Str(s) => s.view() == want,
            _ => false,
        },
        option::Option[insp::Value]::None => false,
    };
}

fn prop_named(props_in: vec::Vec[insp::Prop], name: str) -> bool {
    var i: usize = 0 as usize;
    let c: usize = props_in.count();
    while i < c {
        match props_in.at_ptr(i) {
            option::Option[*insp::Prop]::Some(p) => {
                if { (*p).name } == name { return true; }
            }
            option::Option[*insp::Prop]::None => { }
        }
        i = i +% (1 as usize);
    }
    return false;
}

fn prop_overridden(props_in: vec::Vec[insp::Prop], name: str) -> bool {
    var i: usize = 0 as usize;
    let c: usize = props_in.count();
    while i < c {
        match props_in.at_ptr(i) {
            option::Option[*insp::Prop]::Some(p) => {
                if { (*p).name } == name { return { (*p).overridden }; }
            }
            option::Option[*insp::Prop]::None => { }
        }
        i = i +% (1 as usize);
    }
    return false;
}

fn fresh() {
    app::reset_default_for_tests();
    tree::forget_all_overrides();
    tree::clear_self();
    // The trash holds removed subtrees and a pointer to the parent they came
    // from. Both are meaningless once the windows are gone, and dropping the
    // subtrees here is what releases them.
    tree::empty_trash();
    tree::forget_journal();
    return;
}

// The key of `parent`'s child at `at`. Answered as a comparison rather than as
// a `str`, so no view of a node's key outlives the call that read it.
fn child_key_is(parent: *core::Node, at: usize, want: str) -> bool {
    return match core::child_of(parent, at) {
        option::Option[*core::Node]::Some(c) => ({ (*c).key() } == want),
        option::Option[*core::Node]::None => false,
    };
}

fn journal_line_is(i: usize, want: str) -> bool {
    return match tree::journal_at(i) {
        option::Option[text::Text]::Some(line) => line.view() == want,
        option::Option[text::Text]::None => false,
    };
}

// ==============================================================================
// unit
// ==============================================================================

#[test]
fn a_fresh_handle_is_live_and_a_null_one_is_not() {
    var n: core::Node = core::node_with("probe", 0u32, 0 as *u8, core::no_release);
    let h: insp::Handle = insp::Handle::of(#addr_of(n), 0 as usize);
    assert h.is_live();
    assert !h.is_none();
    let z: insp::Handle = insp::Handle::none();
    assert z.is_none();
    assert !z.is_live();
    return;
}

#[test]
fn value_tags_name_themselves() {
    assert insp::Value::Bool(true).type_name() == "bool";
    assert insp::Value::Int(1 as i64).type_name() == "int";
    assert insp::Value::Num(1.0f64).type_name() == "number";
    assert insp::Value::Str(text::from_str("x")).type_name() == "text";
    assert insp::Value::Color(vocab::Color::none()).type_name() == "color";
    assert insp::Value::Enum(text::from_str("auto")).type_name() == "enum";
    assert insp::Value::Nothing.type_name() == "nothing";
    assert insp::Value::Nothing.is_nothing();
    assert !insp::Value::Bool(false).is_nothing();
    return;
}

// The ledger hands back a duplicate, not a view: the record it copied from is
// destroyed in the same breath.
#[test]
fn cloning_a_text_value_survives_the_original() {
    var copied: insp::Value = insp::Value::Nothing;
    {
        let original: insp::Value = insp::Value::Str(text::from_str("declared"));
        copied = original.clone();
    }
    assert match copied {
        insp::Value::Str(s) => s.view() == "declared",
        _ => false,
    };
    return;
}

// Every constant the generator owns has a name here. When `gen_contract.py`
// adds a control this fails, which is the point: a tree row reading "node"
// where a date picker is would otherwise pass in silence.
#[test]
fn kind_names_cover_every_generated_control() {
    assert insp::kind_name(props::K_SPINNER) == "spinner";
    assert insp::kind_name(props::K_BORDERED) == "bordered";
    assert insp::kind_name(props::K_BOX) == "box";
    assert insp::kind_name(props::K_BUTTON) == "button";
    assert insp::kind_name(props::K_CAROUSEL) == "carousel";
    assert insp::kind_name(props::K_CHECKBOX) == "checkbox";
    assert insp::kind_name(props::K_COLLECTION) == "collection";
    assert insp::kind_name(props::K_DATE_PICKER) == "date_picker";
    assert insp::kind_name(props::K_TEXT_AREA) == "text_area";
    assert insp::kind_name(props::K_TEXT_FIELD) == "text_field";
    assert insp::kind_name(props::K_CANVAS) == "canvas";
    assert insp::kind_name(props::K_HYBRID_WEB) == "hybrid_web";
    assert insp::kind_name(props::K_IMAGE) == "image";
    assert insp::kind_name(props::K_ICON_BUTTON) == "icon_button";
    assert insp::kind_name(props::K_PAGE_DOTS) == "page_dots";
    assert insp::kind_name(props::K_LABEL) == "label";
    assert insp::kind_name(props::K_LIST) == "list";
    assert insp::kind_name(props::K_MENU) == "menu";
    assert insp::kind_name(props::K_CONTEXT_MENU) == "context_menu";
    assert insp::kind_name(props::K_CONTEXT_MENU_ITEM) == "context_menu_item";
    assert insp::kind_name(props::K_MENU_ITEM) == "menu_item";
    assert insp::kind_name(props::K_POPUP) == "popup";
    assert insp::kind_name(props::K_PROGRESS) == "progress";
    assert insp::kind_name(props::K_RADIO) == "radio";
    assert insp::kind_name(props::K_REFRESHABLE) == "refreshable";
    assert insp::kind_name(props::K_SCROLL) == "scroll";
    assert insp::kind_name(props::K_SEARCH_FIELD) == "search_field";
    assert insp::kind_name(props::K_SLIDER) == "slider";
    assert insp::kind_name(props::K_SPAN) == "span";
    assert insp::kind_name(props::K_STEPPER) == "stepper";
    assert insp::kind_name(props::K_SWIPE_ITEM) == "swipe_item";
    assert insp::kind_name(props::K_SWIPEABLE) == "swipeable";
    assert insp::kind_name(props::K_TOGGLE) == "toggle";
    assert insp::kind_name(props::K_TABS) == "tabs";
    assert insp::kind_name(props::K_TABLE) == "table";
    assert insp::kind_name(props::K_TIME_PICKER) == "time_picker";
    assert insp::kind_name(props::K_TOOLBAR_ITEM) == "toolbar_item";
    assert insp::kind_name(props::K_WEB) == "web";
    assert insp::kind_name(0u32) == "node";
    return;
}

#[test]
fn outcomes_describe_themselves_and_only_ok_is_ok() {
    assert insp::Outcome::Ok.is_ok();
    assert !insp::Outcome::Stale.is_ok();
    assert !insp::Outcome::TypeMismatch.is_ok();
    assert insp::Outcome::Stale.describe() == "stale: the tree changed, re-describe";
    return;
}

#[test]
fn the_none_backend_refuses_every_write_and_answers_nothing() {
    let b: insp::Backend = insp::Backend::none();
    let rows: vec::Vec[insp::Node] = b.describe_now();
    assert rows.count() == (0 as usize);
    let h: insp::Handle = insp::Handle::none();
    assert b.set_now(h, "opacity", insp::Value::Num(0.5f64)) == insp::Outcome::Unsupported;
    assert b.reset_now(h, "opacity") == insp::Outcome::Unsupported;
    return;
}

// ==============================================================================
// end to end, over a mounted tree
// ==============================================================================

#[test]
fn describe_lists_the_whole_tree_in_document_order_with_parents_and_depth() {
    fresh();
    var bar: core::Builder = core::Builder::new();
    bar.add(ui::button("Save", key: "save"));
    bar.add(ui::button("Cancel", key: "cancel"));
    var body: core::Builder = core::Builder::new();
    body.add(ui::row(bar, key: "toolbar"));
    body.add(ui::label("Ready", key: "status"));
    var root: core::Node = ui::column(body, key: "root");
    app::open_window(#addr_of(root));

    let rows: vec::Vec[insp::Node] = tree::describe();
    assert rows.count() == (5 as usize);
    assert depth_of(rows, "root") == (0 as usize);
    assert depth_of(rows, "toolbar") == (1 as usize);
    assert depth_of(rows, "save") == (2 as usize);
    assert depth_of(rows, "status") == (1 as usize);

    // A root's parent is nothing; a child's is the row above it that owns it.
    assert match row_index(rows, "root") {
        option::Option[usize]::Some(i) => match rows.at_ptr(i) {
            option::Option[*insp::Node]::Some(p) => match { (*p).parent } {
                option::Option[usize]::Some(_x) => false,
                option::Option[usize]::None => true,
            },
            option::Option[*insp::Node]::None => false,
        },
        option::Option[usize]::None => false,
    };
    let i_bar: usize = match row_index(rows, "toolbar") {
        option::Option[usize]::Some(i) => i,
        option::Option[usize]::None => 999 as usize,
    };
    assert match row_index(rows, "save") {
        option::Option[usize]::Some(i) => match rows.at_ptr(i) {
            option::Option[*insp::Node]::Some(p) => match { (*p).parent } {
                option::Option[usize]::Some(x) => x == i_bar,
                option::Option[usize]::None => false,
            },
            option::Option[*insp::Node]::None => false,
        },
        option::Option[usize]::None => false,
    };

    // Document order: the toolbar and its children precede the status label.
    let i_toolbar: usize = match row_index(rows, "toolbar") {
        option::Option[usize]::Some(i) => i,
        option::Option[usize]::None => 999 as usize,
    };
    let i_status: usize = match row_index(rows, "status") {
        option::Option[usize]::Some(i) => i,
        option::Option[usize]::None => 0 as usize,
    };
    assert i_toolbar < i_status;
    return;
}

// The unkeyed pure-layout node the native walk cannot see. This is the whole
// reason the inspector walks facet rather than NSView.
#[test]
fn describe_includes_unkeyed_nodes_that_a_native_walk_would_miss() {
    fresh();
    var leaf: core::Builder = core::Builder::new();
    leaf.add(ui::label("buried", key: "buried"));
    var mid: core::Builder = core::Builder::new();
    // No key: an unkeyed pure-layout container costs no native view, so it
    // carries no accessibility identifier and a walk of NSView cannot see it.
    mid.add(ui::column(leaf));
    var root: core::Node = ui::column(mid, key: "root");
    app::open_window(#addr_of(root));

    let rows: vec::Vec[insp::Node] = tree::describe();
    assert rows.count() == (3 as usize);
    assert depth_of(rows, "buried") == (2 as usize);
    // The invisible middle node is present, addressable, and has no view.
    let mid_h: insp::Handle = unkeyed_of_kind(rows, 0u32);
    assert !mid_h.is_none();
    assert tree::set(mid_h, "padding", insp::Value::Num(8.0f64)) == insp::Outcome::Ok;
    return;
}

// The `@ui` DSL hands back a wrapper node that carries no facet `Data` at all.
// The walk has to survive one: `key()`, `kind_of` and the band readers all go
// through a null data pointer.
#[test]
fn the_walk_survives_the_dataless_wrapper_the_dsl_hands_back() {
    fresh();
    var root: core::Node = @ui {
        column(key: "root") {
            label("Ready", key: "status")
        }
    };
    app::open_window(#addr_of(root));

    let rows: vec::Vec[insp::Node] = tree::describe();
    // wrapper, column, label.
    assert rows.count() == (3 as usize);
    let wrapper: insp::Handle = match rows.at_ptr(0 as usize) {
        option::Option[*insp::Node]::Some(p) => { (*p).handle }
        option::Option[*insp::Node]::None => insp::Handle::none(),
    };
    assert !wrapper.is_none();
    // It has no key and no kind, and reads as a plain node rather than
    // crashing the walk.
    assert match rows.at_ptr(0 as usize) {
        option::Option[*insp::Node]::Some(p) => ({ (*p).key.view() } == ""),
        option::Option[*insp::Node]::None => false,
    };
    // Keys inside it still resolve, and the depth accounts for the wrapper.
    assert depth_of(rows, "root") == (1 as usize);
    assert depth_of(rows, "status") == (2 as usize);
    assert !row_for(rows, "status").is_none();
    return;
}

#[test]
fn describe_spans_every_open_window() {
    fresh();
    var ba: core::Builder = core::Builder::new();
    ba.add(ui::label("A", key: "a"));
    var a: core::Node = ui::column(ba, key: "win_a");
    var bb: core::Builder = core::Builder::new();
    bb.add(ui::label("B", key: "b"));
    var b: core::Node = ui::column(bb, key: "win_b");
    app::open_window(#addr_of(a));
    app::open_window(#addr_of(b));

    let rows: vec::Vec[insp::Node] = tree::describe();
    assert rows.count() == (4 as usize);
    assert !row_for(rows, "a").is_none();
    assert !row_for(rows, "b").is_none();
    // Each row remembers which window it came from, so a keyed re-resolve is
    // scoped to the right tree. Two windows sharing a key is legal.
    assert row_for(rows, "a").window == (0 as usize);
    assert row_for(rows, "b").window == (1 as usize);
    return;
}

// The same key in two windows is legal and each write must land in its own.
#[test]
fn the_same_key_in_two_windows_writes_to_the_right_one() {
    fresh();
    var ba: core::Builder = core::Builder::new();
    ba.add(ui::label("from a", key: "shared"));
    var a: core::Node = ui::column(ba, key: "win_a");
    var bb: core::Builder = core::Builder::new();
    bb.add(ui::label("from b", key: "shared"));
    var b: core::Node = ui::column(bb, key: "win_b");
    app::open_window(#addr_of(a));
    app::open_window(#addr_of(b));

    let rows: vec::Vec[insp::Node] = tree::describe();
    let in_a: insp::Handle = nth_for(rows, "shared", 0 as usize);
    let in_b: insp::Handle = nth_for(rows, "shared", 1 as usize);
    assert in_a.window == (0 as usize);
    assert in_b.window == (1 as usize);

    assert tree::set(in_b, "text", insp::Value::Str(text::from_str("edited b")))
        == insp::Outcome::Ok;
    assert text_eq(in_b, "text", "edited b");
    // The other window's node of the same name was not touched.
    assert text_eq(in_a, "text", "from a");
    return;
}

#[test]
fn the_inspectors_own_subtree_is_marked_and_the_rest_is_not() {
    fresh();
    var root: core::Node = @ui {
        column(key: "root") {
            label("app content", key: "content")
            column(key: "panel") {
                label("inspector row", key: "panel_row")
            }
        }
    };
    app::open_window(#addr_of(root));
    match core::find_in(#addr_of(root), "panel") {
        option::Option[*core::Node]::Some(p) => { tree::mark_self(p); }
        option::Option[*core::Node]::None => { assert false; }
    }

    let rows: vec::Vec[insp::Node] = tree::describe();
    var saw_app: bool = false;
    var saw_panel_row: bool = false;
    var i: usize = 0 as usize;
    let c: usize = rows.count();
    while i < c {
        match rows.at_ptr(i) {
            option::Option[*insp::Node]::Some(p) => {
                if { (*p).key.view() } == "content" {
                    saw_app = true;
                    assert !{ (*p).is_inspector };
                }
                if { (*p).key.view() } == "panel_row" {
                    saw_panel_row = true;
                    // Marked through its ancestor, not by naming it.
                    assert { (*p).is_inspector };
                }
            }
            option::Option[*insp::Node]::None => { }
        }
        i = i +% (1 as usize);
    }
    assert saw_app;
    assert saw_panel_row;
    return;
}

// Tier 1: the common band, on a node with no control props at all.
#[test]
fn common_band_properties_round_trip_on_a_bare_container() {
    fresh();
    var root: core::Node = @ui { column(key: "root") { label("x", key: "x") } };
    app::open_window(#addr_of(root));
    let h: insp::Handle = row_for(tree::describe(), "root");
    assert !h.is_none();

    assert tree::set(h, "opacity", insp::Value::Num(0.65f64)) == insp::Outcome::Ok;
    assert get_num(h, "opacity") == 0.65f64;

    assert tree::set(h, "visible", insp::Value::Bool(false)) == insp::Outcome::Ok;
    assert !get_bool(h, "visible");

    assert tree::set(h, "enabled", insp::Value::Bool(false)) == insp::Outcome::Ok;
    assert !get_bool(h, "enabled");

    assert tree::set(h, "corner_radius", insp::Value::Num(8.0f64)) == insp::Outcome::Ok;
    assert get_num(h, "corner_radius") == 8.0f64;

    assert tree::set(h, "tooltip", insp::Value::Str(text::from_str("hi"))) == insp::Outcome::Ok;
    assert text_eq(h, "tooltip", "hi");

    assert tree::set(h, "background_color",
                     insp::Value::Color(vocab::Color::system_blue())) == insp::Outcome::Ok;
    return;
}

// Tier 2: flex style, also with no kind dispatch.
#[test]
fn layout_properties_round_trip_and_raise_only_the_layout_bit() {
    fresh();
    var root: core::Node = @ui { column(key: "root") { label("x", key: "x") } };
    app::open_window(#addr_of(root));
    let h: insp::Handle = row_for(tree::describe(), "root");
    let n: *core::Node = h.node;

    core::clear_dirty(n);
    assert tree::set(h, "width", insp::Value::Num(320.0f64)) == insp::Outcome::Ok;
    assert get_num(h, "width") == 320.0f64;
    assert ({ core::dirty_of(n) } & props::C_LAYOUT) != (0 as u64);

    assert tree::set(h, "padding", insp::Value::Num(12.0f64)) == insp::Outcome::Ok;
    assert get_num(h, "padding") == 12.0f64;

    assert tree::set(h, "grow", insp::Value::Num(1.0f64)) == insp::Outcome::Ok;
    assert get_num(h, "grow") == 1.0f64;

    assert tree::set(h, "gap", insp::Value::Num(6.0f64)) == insp::Outcome::Ok;
    assert get_num(h, "gap") == 6.0f64;
    return;
}

// An integer for a length is a kindness, not a type error.
#[test]
fn an_int_is_accepted_where_a_number_is_wanted() {
    fresh();
    var root: core::Node = @ui { column(key: "root") { label("x", key: "x") } };
    app::open_window(#addr_of(root));
    let h: insp::Handle = row_for(tree::describe(), "root");
    assert tree::set(h, "padding", insp::Value::Int(10 as i64)) == insp::Outcome::Ok;
    assert get_num(h, "padding") == 10.0f64;
    return;
}

// A padding box shows a number only when all four edges agree. Otherwise it
// is empty, so nobody sets four edges to the one that happened to be left.
#[test]
fn a_mixed_padding_reads_as_nothing_rather_than_as_one_edge() {
    fresh();
    var root: core::Node = @ui { column(key: "root") { label("x", key: "x") } };
    app::open_window(#addr_of(root));
    let h: insp::Handle = row_for(tree::describe(), "root");

    assert tree::set(h, "padding", insp::Value::Num(4.0f64)) == insp::Outcome::Ok;
    assert get_num(h, "padding") == 4.0f64;
    assert tree::set(h, "padding_left", insp::Value::Num(20.0f64)) == insp::Outcome::Ok;

    assert match tree::get(h, "padding") {
        option::Option[insp::Value]::Some(v) => v.is_nothing(),
        option::Option[insp::Value]::None => false,
    };
    assert get_num(h, "padding_left") == 20.0f64;
    assert get_num(h, "padding_top") == 4.0f64;
    return;
}

// Tier 3, on a keyed node.
#[test]
fn control_text_and_title_round_trip_on_keyed_nodes() {
    fresh();
    var root: core::Node = @ui {
        column(key: "root") {
            label("Ready", key: "status")
            button("Save", key: "save")
        }
    };
    app::open_window(#addr_of(root));
    let rows: vec::Vec[insp::Node] = tree::describe();

    let l: insp::Handle = row_for(rows, "status");
    assert text_eq(l, "text", "Ready");
    assert tree::set(l, "text", insp::Value::Str(text::from_str("Busy"))) == insp::Outcome::Ok;
    assert text_eq(l, "text", "Busy");
    // And the application's own typed read agrees — the inspector went through
    // the same setter, not around it.
    match label::find("status", within: #addr_of(root)) {
        option::Option[label::Label]::Some(hit) => { assert hit.text() == "Busy"; }
        option::Option[label::Label]::None => { assert false; }
    }

    let b: insp::Handle = row_for(rows, "save");
    assert text_eq(b, "title", "Save");
    assert tree::set(b, "title", insp::Value::Str(text::from_str("Store"))) == insp::Outcome::Ok;
    match button::find("save", within: #addr_of(root)) {
        option::Option[button::Button]::Some(hit) => { assert hit.title() == "Store"; }
        option::Option[button::Button]::None => { assert false; }
    }
    return;
}

#[test]
fn inspect_separates_declared_from_computed() {
    fresh();
    var root: core::Node = @ui { column(key: "root") { label("hi", key: "hi") } };
    app::open_window(#addr_of(root));
    let h: insp::Handle = row_for(tree::describe(), "hi");

    match tree::inspect(h) {
        option::Option[insp::Detail]::Some(d) => {
            // Declared carries what the application asked for, and is writable.
            assert prop_named(d.declared, "text");
            assert prop_named(d.declared, "opacity");
            assert prop_named(d.declared, "padding");
            // A label has no title, so no editor is offered for one.
            assert !prop_named(d.declared, "title");
            // Computed carries what layout decided, and never appears in declared.
            assert prop_named(d.computed, "frame_width");
            assert prop_named(d.computed, "attached");
            assert prop_named(d.computed, "kind");
            assert !prop_named(d.declared, "frame_width");
            // No platform module is installed in a headless suite.
            assert d.native.count() == (0 as usize);
        }
        option::Option[insp::Detail]::None => { assert false; }
    }
    return;
}

// Reset restores what the APPLICATION declared, not the type's default. An app
// that shipped 0.8 and an inspector that resets to 1.0 has started a second
// experiment rather than ending the first.
#[test]
fn reset_restores_the_declared_value_and_not_the_type_default() {
    fresh();
    var root: core::Node = @ui { column(key: "root") { label("x", key: "x") } };
    app::open_window(#addr_of(root));
    let h: insp::Handle = row_for(tree::describe(), "root");

    // What the application declared.
    core::set_opacity(h.node, 0.8f64);
    assert get_num(h, "opacity") == 0.8f64;

    assert tree::set(h, "opacity", insp::Value::Num(0.2f64)) == insp::Outcome::Ok;
    assert get_num(h, "opacity") == 0.2f64;
    assert tree::override_count() == (1 as usize);

    assert tree::reset(h, "opacity") == insp::Outcome::Ok;
    assert get_num(h, "opacity") == 0.8f64;
    assert tree::override_count() == (0 as usize);
    return;
}

// A second edit must not record the inspector's own first edit as "what the
// application declared".
#[test]
fn a_second_write_does_not_overwrite_the_recorded_original() {
    fresh();
    var root: core::Node = @ui { column(key: "root") { label("x", key: "x") } };
    app::open_window(#addr_of(root));
    let h: insp::Handle = row_for(tree::describe(), "root");

    core::set_opacity(h.node, 0.9f64);
    let _a: insp::Outcome = tree::set(h, "opacity", insp::Value::Num(0.5f64));
    let _b: insp::Outcome = tree::set(h, "opacity", insp::Value::Num(0.1f64));
    assert tree::override_count() == (1 as usize);
    assert tree::reset(h, "opacity") == insp::Outcome::Ok;
    assert get_num(h, "opacity") == 0.9f64;
    return;
}

#[test]
fn reset_restores_a_text_value_it_recorded() {
    fresh();
    var root: core::Node = @ui { column(key: "root") { label("Declared", key: "l") } };
    app::open_window(#addr_of(root));
    let h: insp::Handle = row_for(tree::describe(), "l");

    assert tree::set(h, "text", insp::Value::Str(text::from_str("Edited"))) == insp::Outcome::Ok;
    assert text_eq(h, "text", "Edited");
    assert tree::reset(h, "text") == insp::Outcome::Ok;
    assert text_eq(h, "text", "Declared");
    return;
}

#[test]
fn resetting_a_property_that_was_never_overridden_changes_nothing() {
    fresh();
    var root: core::Node = @ui { column(key: "root") { label("x", key: "x") } };
    app::open_window(#addr_of(root));
    let h: insp::Handle = row_for(tree::describe(), "root");
    core::set_opacity(h.node, 0.7f64);
    assert tree::reset(h, "opacity") == insp::Outcome::Ok;
    assert get_num(h, "opacity") == 0.7f64;
    return;
}

#[test]
fn inspect_marks_the_properties_an_override_is_currently_holding() {
    fresh();
    var root: core::Node = @ui { column(key: "root") { label("x", key: "x") } };
    app::open_window(#addr_of(root));
    let h: insp::Handle = row_for(tree::describe(), "root");

    let _a: insp::Outcome = tree::set(h, "opacity", insp::Value::Num(0.3f64));
    match tree::inspect(h) {
        option::Option[insp::Detail]::Some(d) => {
            assert prop_overridden(d.declared, "opacity");
            assert !prop_overridden(d.declared, "padding");
        }
        option::Option[insp::Detail]::None => { assert false; }
    }
    return;
}

#[test]
fn a_snippet_names_the_key_and_the_value_that_was_set() {
    fresh();
    var root: core::Node = @ui { column(key: "root") { label("x", key: "x") } };
    app::open_window(#addr_of(root));
    let h: insp::Handle = row_for(tree::describe(), "root");

    let _a: insp::Outcome = tree::set(h, "opacity", insp::Value::Num(0.5f64));
    let s: text::Text = tree::snippet_for(h, "opacity");
    assert s.contains("set_opacity");
    assert s.contains("\"root\"");
    assert s.contains("0.5");

    let _b: insp::Outcome = tree::set(h, "padding", insp::Value::Num(12.0f64));
    let p: text::Text = tree::snippet_for(h, "padding");
    // Whole numbers read as whole numbers, for a line a human will paste.
    assert p.contains("12.0f64");
    return;
}

#[test]
fn a_snippet_for_an_unkeyed_node_is_empty_rather_than_unaddressable() {
    fresh();
    var body: core::Builder = core::Builder::new();
    body.add(ui::label("x"));
    var root: core::Node = ui::column(body, key: "root");
    app::open_window(#addr_of(root));

    let h: insp::Handle = unkeyed_of_kind(tree::describe(), props::K_LABEL);
    assert !h.is_none();
    // A snippet that cannot address its target is not a snippet.
    let s: text::Text = tree::snippet_for(h, "opacity");
    assert s.is_empty();
    return;
}

#[test]
fn the_local_backend_answers_through_the_vtable() {
    fresh();
    var body: core::Builder = core::Builder::new();
    body.add(ui::label("x", key: "x"));
    var root: core::Node = ui::column(body, key: "root");
    app::open_window(#addr_of(root));
    let b: insp::Backend = tree::local_backend();

    let rows: vec::Vec[insp::Node] = b.describe_now();
    assert rows.count() == (2 as usize);
    let h: insp::Handle = row_for(rows, "root");
    assert b.set_now(h, "opacity", insp::Value::Num(0.4f64)) == insp::Outcome::Ok;
    assert match b.inspect_now(h) {
        option::Option[insp::Detail]::Some(d) => prop_named(d.declared, "opacity"),
        option::Option[insp::Detail]::None => false,
    };
    // No platform installed: highlighting degrades rather than crashing.
    b.highlight_now(h);
    b.clear_highlight_now();
    return;
}

// ==============================================================================
// negative
// ==============================================================================

// The one that matters most. `C_FOCUS`, `C_BLUR` and `C_FLUSH` are commands
// the backend performs and clears, not state it re-reads. An inspector write
// that raised them would take first responder away from whatever the developer
// was typing into — on an unrelated node's property edit.
#[test]
fn no_inspector_write_ever_issues_a_focus_blur_or_flush_command() {
    fresh();
    var root: core::Node = @ui {
        column(key: "root") {
            label("Ready", key: "status")
            button("Save", key: "save")
        }
    };
    app::open_window(#addr_of(root));
    let rows: vec::Vec[insp::Node] = tree::describe();
    let h: insp::Handle = row_for(rows, "status");
    let n: *core::Node = h.node;

    core::clear_dirty(n);
    let _a: insp::Outcome = tree::set(h, "opacity", insp::Value::Num(0.5f64));
    let _b: insp::Outcome = tree::set(h, "visible", insp::Value::Bool(false));
    let _c: insp::Outcome = tree::set(h, "padding", insp::Value::Num(4.0f64));
    let _d: insp::Outcome = tree::set(h, "text", insp::Value::Str(text::from_str("Busy")));
    let _e: insp::Outcome = tree::set(h, "background_color",
                                      insp::Value::Color(vocab::Color::system_red()));
    let after: u64 = core::dirty_of(n);

    // Real state bits were raised...
    assert (after & props::C_OPACITY) != (0 as u64);
    assert (after & props::C_LAYOUT) != (0 as u64);
    // ...and not one command bit.
    assert (after & props::C_COMMANDS) == (0 as u64);

    // Reset takes the same path and must obey the same rule.
    core::clear_dirty(n);
    let _f: insp::Outcome = tree::reset(h, "opacity");
    assert (core::dirty_of(n) & props::C_COMMANDS) == (0 as u64);
    return;
}

#[test]
fn a_misspelled_property_is_an_error_and_not_a_silent_no_op() {
    fresh();
    var root: core::Node = @ui { column(key: "root") { label("x", key: "x") } };
    app::open_window(#addr_of(root));
    let h: insp::Handle = row_for(tree::describe(), "root");
    assert tree::set(h, "opasity", insp::Value::Num(0.5f64)) == insp::Outcome::UnknownProperty;
    assert tree::set(h, "", insp::Value::Num(0.5f64)) == insp::Outcome::UnknownProperty;
    assert match tree::get(h, "opasity") {
        option::Option[insp::Value]::Some(_v) => false,
        option::Option[insp::Value]::None => true,
    };
    return;
}

#[test]
fn a_wrongly_typed_value_is_refused_by_tag() {
    fresh();
    var root: core::Node = @ui { column(key: "root") { label("x", key: "x") } };
    app::open_window(#addr_of(root));
    let rows: vec::Vec[insp::Node] = tree::describe();
    let h: insp::Handle = row_for(rows, "root");

    assert tree::set(h, "opacity", insp::Value::Bool(true)) == insp::Outcome::TypeMismatch;
    assert tree::set(h, "visible", insp::Value::Num(1.0f64)) == insp::Outcome::TypeMismatch;
    assert tree::set(h, "background_color", insp::Value::Num(1.0f64)) == insp::Outcome::TypeMismatch;
    assert tree::set(h, "tooltip", insp::Value::Num(1.0f64)) == insp::Outcome::TypeMismatch;
    assert tree::set(h, "width", insp::Value::Str(text::from_str("wide")))
        == insp::Outcome::TypeMismatch;

    let l: insp::Handle = row_for(rows, "x");
    assert tree::set(l, "text", insp::Value::Num(1.0f64)) == insp::Outcome::TypeMismatch;
    return;
}

// A refused write leaves the node exactly as it was.
#[test]
fn a_refused_write_changes_nothing_and_records_nothing() {
    fresh();
    var root: core::Node = @ui { column(key: "root") { label("x", key: "x") } };
    app::open_window(#addr_of(root));
    let h: insp::Handle = row_for(tree::describe(), "root");
    core::set_opacity(h.node, 0.75f64);

    assert tree::set(h, "opacity", insp::Value::Bool(true)) == insp::Outcome::TypeMismatch;
    assert get_num(h, "opacity") == 0.75f64;
    return;
}

// "Layout decided that" and "you misspelled it" are different answers.
#[test]
fn a_computed_property_is_read_only_and_says_so() {
    fresh();
    var root: core::Node = @ui { column(key: "root") { label("x", key: "x") } };
    app::open_window(#addr_of(root));
    let h: insp::Handle = row_for(tree::describe(), "root");

    assert tree::set(h, "frame_width", insp::Value::Num(100.0f64)) == insp::Outcome::ReadOnly;
    assert tree::set(h, "attached", insp::Value::Bool(true)) == insp::Outcome::ReadOnly;
    assert tree::set(h, "kind", insp::Value::Str(text::from_str("button")))
        == insp::Outcome::ReadOnly;
    assert tree::reset(h, "frame_width") == insp::Outcome::ReadOnly;
    return;
}

// Tier 3 needs a key. The name was right, so the answer is not
// `UnknownProperty` — it is "not reachable on this node in this build".
#[test]
fn a_control_property_on_an_unkeyed_node_is_unsupported_not_unknown() {
    fresh();
    var body: core::Builder = core::Builder::new();
    body.add(ui::label("buried"));
    var root: core::Node = ui::column(body, key: "root");
    app::open_window(#addr_of(root));

    let h: insp::Handle = unkeyed_of_kind(tree::describe(), props::K_LABEL);
    assert !h.is_none();

    // The NAME was right; this build cannot reach it without a key.
    assert tree::set(h, "text", insp::Value::Str(text::from_str("nope")))
        == insp::Outcome::Unsupported;
    // The common band and flex style still work on that very same node: tiers
    // 1 and 2 need no key at all, which is most of what an inspector edits.
    assert tree::set(h, "opacity", insp::Value::Num(0.5f64)) == insp::Outcome::Ok;
    assert get_num(h, "opacity") == 0.5f64;
    assert tree::set(h, "padding", insp::Value::Num(6.0f64)) == insp::Outcome::Ok;
    return;
}

// A duplicate key inside one window makes `find` answer the first match. A
// write aimed at the second must be refused rather than landing on a stranger.
#[test]
fn a_duplicate_key_refuses_the_write_it_cannot_aim() {
    fresh();
    var body: core::Builder = core::Builder::new();
    body.add(ui::label("first", key: "dup"));
    body.add(ui::label("second", key: "dup"));
    var root: core::Node = ui::column(body, key: "root");
    app::open_window(#addr_of(root));

    let rows: vec::Vec[insp::Node] = tree::describe();
    let first: insp::Handle = nth_for(rows, "dup", 0 as usize);
    let second: insp::Handle = nth_for(rows, "dup", 1 as usize);
    assert !first.is_none();
    assert !second.is_none();
    assert first.node != second.node;

    // The first match is what `find` resolves, so it is writable.
    assert tree::set(first, "text", insp::Value::Str(text::from_str("ok")))
        == insp::Outcome::Ok;
    assert text_eq(first, "text", "ok");

    // The second cannot be aimed, so it is refused.
    assert tree::set(second, "text", insp::Value::Str(text::from_str("nope")))
        == insp::Outcome::Unsupported;
    // And the refused write did not land on the stranger that the key DOES
    // resolve to — which is the whole reason for the check.
    assert text_eq(first, "text", "ok");

    // The reader is symmetric with the writer: a tier-3 property the inspector
    // cannot aim is one it declines to report, rather than quietly showing the
    // other node's value as though it belonged to this one.
    assert match tree::get(second, "text") {
        option::Option[insp::Value]::Some(_v) => false,
        option::Option[insp::Value]::None => true,
    };
    // So `inspect` offers no text editor on it at all, while the common band
    // it CAN aim stays available.
    match tree::inspect(second) {
        option::Option[insp::Detail]::Some(d) => {
            assert !prop_named(d.declared, "text");
            assert prop_named(d.declared, "opacity");
        }
        option::Option[insp::Detail]::None => { assert false; }
    }
    assert tree::set(second, "opacity", insp::Value::Num(0.5f64)) == insp::Outcome::Ok;
    return;
}

#[test]
fn a_null_handle_is_not_found_and_a_dead_generation_is_stale() {
    fresh();
    var body: core::Builder = core::Builder::new();
    body.add(ui::label("a", key: "a"));
    body.add(ui::label("b", key: "b"));
    var root: core::Node = ui::column(body, key: "root");
    app::open_window(#addr_of(root));
    let h: insp::Handle = row_for(tree::describe(), "a");
    assert h.is_live();

    let z: insp::Handle = insp::Handle::none();
    assert tree::set(z, "opacity", insp::Value::Num(0.5f64)) == insp::Outcome::NotFound;
    assert tree::reset(z, "opacity") == insp::Outcome::NotFound;

    // Removing anything from any tree ends every outstanding generation.
    let gone: option::Option[core::Node] = { root.remove_child(1 as usize) };
    match gone {
        option::Option[core::Node]::Some(d) => { let _drop: core::Node = d; }
        option::Option[core::Node]::None => { assert false; }
    }

    assert !h.is_live();
    assert tree::set(h, "opacity", insp::Value::Num(0.5f64)) == insp::Outcome::Stale;
    assert tree::reset(h, "opacity") == insp::Outcome::Stale;
    assert match tree::inspect(h) {
        option::Option[insp::Detail]::Some(_d) => false,
        option::Option[insp::Detail]::None => true,
    };
    assert match tree::get(h, "opacity") {
        option::Option[insp::Value]::Some(_v) => false,
        option::Option[insp::Value]::None => true,
    };
    return;
}

#[test]
fn an_unset_length_reads_as_nothing_rather_than_as_zero() {
    fresh();
    var root: core::Node = @ui { column(key: "root") { label("x", key: "x") } };
    app::open_window(#addr_of(root));
    let h: insp::Handle = row_for(tree::describe(), "root");
    // Nothing has declared a width, and `auto` is not a number the inspector
    // could hand back unchanged. Answering 0.0 would be a value the UI then
    // writes back as a real zero.
    assert match tree::get(h, "width") {
        option::Option[insp::Value]::Some(v) => v.is_nothing(),
        option::Option[insp::Value]::None => false,
    };
    return;
}

#[test]
fn describing_an_app_with_no_windows_is_empty_and_not_a_crash() {
    fresh();
    let rows: vec::Vec[insp::Node] = tree::describe();
    assert rows.count() == (0 as usize);
    return;
}

// ==============================================================================
// widget — the panel's own logic, headless
// ==============================================================================

fn vt(v: insp::Value) -> text::Text { return widget::value_text(v); }

#[test]
fn a_whole_number_renders_without_a_decimal_tail() {
    // `12.000000` in a padding box is a number a developer has to edit before
    // they can think.
    assert vt(insp::Value::Num(12.0f64)).view() == "12";
    assert vt(insp::Value::Num(0.0f64)).view() == "0";
    assert vt(insp::Value::Num(-8.0f64)).view() == "-8";
    // A real fraction keeps its digits.
    assert !(vt(insp::Value::Num(0.65f64)).view() == "0");
    return;
}

#[test]
fn values_render_by_tag() {
    assert vt(insp::Value::Bool(true)).view() == "true";
    assert vt(insp::Value::Bool(false)).view() == "false";
    assert vt(insp::Value::Str(text::from_str("hi"))).view() == "hi";
    assert vt(insp::Value::Nothing).is_empty();
    assert vt(insp::Value::Int(7 as i64)).view() == "7";
    return;
}

// A theme token is a NAME, not a colour. Reporting rgba for one would invent
// four numbers the application never wrote.
// `vocabulary` reserves 255 for a literal rgba and 254 for a light/dark pair;
// every other non-zero token is a theme NAME whose channels are all zero. A
// renderer that treated "non-zero token" as "themed" would report every
// literal colour as `token:255`, and one that treated it as "has channels"
// would report every themed colour as transparent black.
#[test]
fn a_theme_token_renders_as_a_token_and_a_literal_renders_as_channels() {
    let named: text::Text = vt(insp::Value::Color(vocab::Color::system_blue()));
    assert named.has_prefix("token:");

    let literal: text::Text =
        vt(insp::Value::Color(vocab::Color::rgba(1.0f64, 0.0f64, 0.0f64, 1.0f64)));
    assert literal.has_prefix("rgba(");
    assert !literal.contains("token");

    // Unset is a word, not four zeroes that read as a colour someone chose.
    assert vt(insp::Value::Color(vocab::Color::clear())).view() == "clear";

    // A light/dark pair shows both sides, because either one alone is half an
    // answer about what will actually be drawn.
    let pair: text::Text = vt(insp::Value::Color(vocab::Color::adaptive(
        vocab::Color::rgba(1.0f64, 1.0f64, 1.0f64, 1.0f64),
        vocab::Color::rgba(0.0f64, 0.0f64, 0.0f64, 1.0f64))));
    assert pair.contains("light");
    assert pair.contains("dark");
    return;
}

#[test]
fn hex_colours_parse_and_bad_ones_are_refused() {
    assert match tree::parse_hex_color("#2277ff") {
        option::Option[vocab::Color]::Some(c) => {
            // 0x22 == 34, 34/255 is a shade over 0.13.
            (c.r > 0.12f64) && (c.r < 0.14f64) && (c.b > 0.99f64)
        }
        option::Option[vocab::Color]::None => false,
    };
    // Uppercase is the same colour.
    assert match tree::parse_hex_color("#2277FF") {
        option::Option[vocab::Color]::Some(_c) => true,
        option::Option[vocab::Color]::None => false,
    };
    return;
}

#[test]
fn a_malformed_colour_is_refused_rather_than_read_as_black() {
    assert match tree::parse_hex_color("2277ff") {          // no hash
        option::Option[vocab::Color]::Some(_c) => false,
        option::Option[vocab::Color]::None => true,
    };
    assert match tree::parse_hex_color("#22") {             // too short
        option::Option[vocab::Color]::Some(_c) => false,
        option::Option[vocab::Color]::None => true,
    };
    assert match tree::parse_hex_color("#gggggg") {         // not hex
        option::Option[vocab::Color]::Some(_c) => false,
        option::Option[vocab::Color]::None => true,
    };
    assert match tree::parse_hex_color("") {
        option::Option[vocab::Color]::Some(_c) => false,
        option::Option[vocab::Color]::None => true,
    };
    return;
}

// The current value is the type declaration: a field showing `0.65` takes a
// number, one showing `true` takes a boolean. Nothing is declared twice.
#[test]
fn typed_input_is_read_as_the_tag_the_property_already_holds() {
    assert match tree::parse_as(insp::Value::Num(1.0f64), "0.65") {
        option::Option[insp::Value]::Some(v) => match v {
            insp::Value::Num(x) => x == 0.65f64,
            _ => false,
        },
        option::Option[insp::Value]::None => false,
    };
    assert match tree::parse_as(insp::Value::Bool(false), "true") {
        option::Option[insp::Value]::Some(v) => match v {
            insp::Value::Bool(b) => b,
            _ => false,
        },
        option::Option[insp::Value]::None => false,
    };
    assert match tree::parse_as(insp::Value::Str(text::from_str("a")), "anything at all") {
        option::Option[insp::Value]::Some(v) => match v {
            insp::Value::Str(s) => s.view() == "anything at all",
            _ => false,
        },
        option::Option[insp::Value]::None => false,
    };
    // An unset length reads as a number, which is the only tag "unset" takes.
    assert match tree::parse_as(insp::Value::Nothing, "16") {
        option::Option[insp::Value]::Some(v) => match v {
            insp::Value::Num(x) => x == 16.0f64,
            _ => false,
        },
        option::Option[insp::Value]::None => false,
    };
    return;
}

#[test]
fn unreadable_input_is_refused_rather_than_written_as_zero() {
    assert match tree::parse_as(insp::Value::Num(1.0f64), "wide") {
        option::Option[insp::Value]::Some(_v) => false,
        option::Option[insp::Value]::None => true,
    };
    assert match tree::parse_as(insp::Value::Bool(false), "yes") {
        option::Option[insp::Value]::Some(_v) => false,
        option::Option[insp::Value]::None => true,
    };
    assert match tree::parse_as(insp::Value::Color(vocab::Color::none()), "blue") {
        option::Option[insp::Value]::Some(_v) => false,
        option::Option[insp::Value]::None => true,
    };
    return;
}

#[test]
fn a_composed_key_gives_back_the_name_it_was_built_from() {
    assert widget::key_tail(text::from_str("insp:f:opacity")).view() == "opacity";
    assert widget::key_tail(text::from_str("insp:t:37")).view() == "37";
    assert widget::key_tail(text::from_str("insp:f:background_color")).view()
        == "background_color";
    assert widget::key_tail(text::from_str("nocolon")).is_empty();
    return;
}

// The panel refreshes from the backend and keeps its selection across a
// refresh, which re-issues every handle with the current generation.
#[test]
fn the_panel_refreshes_and_keeps_its_selection_across_a_new_snapshot() {
    fresh();
    var body: core::Builder = core::Builder::new();
    body.add(ui::label("Ready", key: "status"));
    body.add(ui::button("Save", key: "save"));
    var root: core::Node = ui::column(body, key: "root");
    app::open_window(#addr_of(root));

    // Not mounted as a panel, so its own controls do not exist and every write
    // to them is a no-op. The state machine is what is under test.
    var panel: widget::Inspector = widget::new(tree::local_backend(), hide_self: false);
    widget::refresh(#addr_of(panel));
    assert panel.row_count() == (3 as usize);
    assert panel.shown_count() == (3 as usize);

    let h: insp::Handle = row_for(tree::describe(), "save");
    { panel.selected = h };
    widget::refresh(#addr_of(panel));
    // Same node, re-issued handle, still live.
    assert panel.selection().node == h.node;
    assert panel.selection().is_live();
    return;
}

// The model the outline view is given excludes the panel's own subtree, so
// the panel never offers its own controls as something to restyle.
#[test]
fn the_model_leaves_out_the_inspectors_own_subtree() {
    fresh();
    var pb: core::Builder = core::Builder::new();
    pb.add(ui::label("panel row", key: "insp:row"));
    var appb: core::Builder = core::Builder::new();
    appb.add(ui::label("app one", key: "one"));
    appb.add(ui::column(pb, key: "insp:root"));
    appb.add(ui::label("app two", key: "two"));
    var root: core::Node = ui::column(appb, key: "root");
    app::open_window(#addr_of(root));
    tree::mark_self(mount::node("insp:root"));

    var panel: widget::Inspector = widget::new(tree::local_backend(), hide_self: true);
    { panel.rows = tree::describe() };

    var model: ftree::TreeNode = widget::build_model(#addr_of(panel));
    assert panel.row_count() == (5 as usize);
    assert widget::model_count(#addr_of(model)) == (3 as usize);
    return;
}

#[test]
fn the_ancestry_trail_reads_from_the_root_down() {
    fresh();
    var bar: core::Builder = core::Builder::new();
    bar.add(ui::button("Save", key: "save"));
    var body: core::Builder = core::Builder::new();
    body.add(ui::row(bar, key: "toolbar"));
    var root: core::Node = ui::column(body, key: "root");
    app::open_window(#addr_of(root));

    var panel: widget::Inspector = widget::new(tree::local_backend(), hide_self: false);
    widget::refresh(#addr_of(panel));

    match row_index(tree::describe(), "save") {
        option::Option[usize]::Some(at) => {
            let t: text::Text = panel.trail(at);
            assert t.contains("#root");
            assert t.contains("#toolbar");
            assert t.contains("#save");
            // Root first, leaf last.
            assert match t.find("#root") {
                option::Option[usize]::Some(a) => match t.find("#save") {
                    option::Option[usize]::Some(b) => a < b,
                    option::Option[usize]::None => false,
                },
                option::Option[usize]::None => false,
            };
        }
        option::Option[usize]::None => { assert false; }
    }
    return;
}

// A row line says what the node is and what it is called, the way a
// stylesheet writes it — `label#status`. Depth is the row's left padding, NOT
// leading spaces, so the disclosure triangles line up in a column.
#[test]
fn a_tree_line_names_the_kind_and_key_without_indenting_the_text() {
    fresh();
    var body: core::Builder = core::Builder::new();
    body.add(ui::label("Ready", key: "status"));
    var root: core::Node = ui::column(body, key: "root");
    app::open_window(#addr_of(root));

    var panel: widget::Inspector = widget::new(tree::local_backend(), hide_self: false);
    widget::refresh(#addr_of(panel));

    let line: text::Text = panel.line_for(1 as usize);
    assert line.has_prefix("label#status");
    assert !line.has_prefix(" ");
    // Nothing has mounted a backend in this suite, so no node has a view — and
    // "an ancestor draws this one" is the thing a native tree cannot say.
    assert line.contains("(viewless)");
    // An unkeyed node is just its kind, with no dangling hash.
    let root_line: text::Text = panel.line_for(0 as usize);
    assert root_line.has_prefix("node#root");
    return;
}

// ---- the tree model ----------------------------------------------------------
//
// Folding, recycling and indentation belong to `facet/tree` and its backend.
// What THIS package owns is the model handed to it: the shape, the labels, the
// branch flags and the identities.

fn model_child(n: *ftree::TreeNode, at: usize) -> *ftree::TreeNode {
    return match { (*n).child_ptr(at) } {
        option::Option[*ftree::TreeNode]::Some(c) => c,
        option::Option[*ftree::TreeNode]::None => 0 as *ftree::TreeNode,
    };
}

fn model_of(panel: *widget::Inspector) -> ftree::TreeNode {
    { (*panel).rows = tree::describe() };
    return widget::build_model(panel);
}

#[test]
fn the_model_mirrors_the_snapshots_shape() {
    fresh();
    var inner: core::Builder = core::Builder::new();
    inner.add(ui::label("a", key: "a"));
    inner.add(ui::label("b", key: "b"));
    var outer: core::Builder = core::Builder::new();
    outer.add(ui::column(inner, key: "card"));
    outer.add(ui::label("after", key: "after"));
    var root: core::Node = ui::column(outer, key: "root");
    app::open_window(#addr_of(root));

    var panel: widget::Inspector = widget::new(tree::local_backend(), hide_self: false);
    var model: ftree::TreeNode = model_of(#addr_of(panel));

    // The synthetic root is not itself a row; the window root is its one child.
    assert { model.child_count() } == (1 as usize);
    let win: *ftree::TreeNode = model_child(#addr_of(model), 0 as usize);
    assert { (*win).child_count() } == (2 as usize);       // card, after
    let card: *ftree::TreeNode = model_child(win, 0 as usize);
    assert { (*card).child_count() } == (2 as usize);      // a, b
    // The sibling AFTER a subtree stays a sibling — the case a depth-based
    // walk gets wrong by carrying on too long.
    let after: *ftree::TreeNode = model_child(win, 1 as usize);
    // The label also carries the viewless marker in a headless suite, so
    // match the head of it rather than the whole line.
    var after_label: text::Text = text::from_str({ (*after).label_of() });
    assert after_label.has_prefix("label#after");
    assert widget::model_count(#addr_of(model)) == (5 as usize);
    return;
}

// A disclosure triangle is drawn for a branch. A leaf must not claim one: an
// affordance that does nothing is worse than none.
#[test]
fn only_a_node_with_children_is_marked_a_branch() {
    fresh();
    var inner: core::Builder = core::Builder::new();
    inner.add(ui::label("a", key: "a"));
    var outer: core::Builder = core::Builder::new();
    outer.add(ui::column(inner, key: "card"));
    var root: core::Node = ui::column(outer, key: "root");
    app::open_window(#addr_of(root));

    var panel: widget::Inspector = widget::new(tree::local_backend(), hide_self: false);
    var model: ftree::TreeNode = model_of(#addr_of(panel));
    let win: *ftree::TreeNode = model_child(#addr_of(model), 0 as usize);
    let card: *ftree::TreeNode = model_child(win, 0 as usize);
    let leaf: *ftree::TreeNode = model_child(card, 0 as usize);

    assert { (*win).is_branch };
    assert { (*card).is_branch };
    assert !{ (*leaf).is_branch };
    return;
}

// Identity must be the ITEM's, not the slot's. A positional id renames every
// row after an insert, so expansion and selection would follow the slot
// instead of the node — the bug that reads as "the selection jumped".
#[test]
fn identities_are_addresses_and_survive_a_rebuild() {
    fresh();
    var outer: core::Builder = core::Builder::new();
    outer.add(ui::label("a", key: "a"));
    outer.add(ui::label("b", key: "b"));
    var root: core::Node = ui::column(outer, key: "root");
    app::open_window(#addr_of(root));

    var panel: widget::Inspector = widget::new(tree::local_backend(), hide_self: false);
    var m1: ftree::TreeNode = model_of(#addr_of(panel));
    let win1: *ftree::TreeNode = model_child(#addr_of(m1), 0 as usize);
    let b_id: text::Text = text::from_str({ (*model_child(win1, 1 as usize)).id_of() });

    // Rebuild with no change: the same node keeps the same identity, which is
    // what lets `restore` put expansion and selection back afterwards.
    var m2: ftree::TreeNode = model_of(#addr_of(panel));
    let win2: *ftree::TreeNode = model_child(#addr_of(m2), 0 as usize);
    assert { (*model_child(win2, 1 as usize)).id_of() } == b_id.view();

    let a_id: text::Text = text::from_str({ (*model_child(win2, 0 as usize)).id_of() });
    assert a_id.view() != b_id.view();
    return;
}

#[test]
fn the_model_carries_the_facet_node_so_selection_needs_no_lookup() {
    fresh();
    var outer: core::Builder = core::Builder::new();
    outer.add(ui::label("a", key: "a"));
    var root: core::Node = ui::column(outer, key: "root");
    app::open_window(#addr_of(root));

    var panel: widget::Inspector = widget::new(tree::local_backend(), hide_self: false);
    var model: ftree::TreeNode = model_of(#addr_of(panel));
    let win: *ftree::TreeNode = model_child(#addr_of(model), 0 as usize);
    let a: *ftree::TreeNode = model_child(win, 0 as usize);

    assert ({ (*a).data } as *core::Node) == mount::node("a");

    // And selecting through it lands on that node.
    widget::on_tree_select(a, #addr_of(panel) as *u8);
    assert panel.selection().node == mount::node("a");
    assert tree::set(panel.selection(), "opacity", insp::Value::Num(0.5f64))
        == insp::Outcome::Ok;
    return;
}

// A panel alone in a window models NOTHING, because the only thing in that
// window is the panel and it filters itself out.
#[test]
fn a_panel_alone_in_a_window_models_nothing_rather_than_itself() {
    fresh();
    var panel: widget::Inspector = widget::new(tree::local_backend(), hide_self: true);
    var root: core::Node = panel.build();
    app::open_window(#addr_of(root));
    tree::mark_self(mount::node("insp:root"));

    var model: ftree::TreeNode = model_of(#addr_of(panel));
    assert panel.row_count() > (0 as usize);
    assert widget::model_count(#addr_of(model)) == (0 as usize);
    return;
}

// Selecting a node the tree no longer contains is reported, not acted on.
#[test]
fn selecting_a_departed_node_is_refused() {
    fresh();
    var outer: core::Builder = core::Builder::new();
    outer.add(ui::label("a", key: "a"));
    var root: core::Node = ui::column(outer, key: "root");
    app::open_window(#addr_of(root));

    var panel: widget::Inspector = widget::new(tree::local_backend(), hide_self: false);
    { panel.rows = tree::describe() };

    var orphan: ftree::TreeNode = ftree::TreeNode::new("gone", "n999", data: 0 as *u8);
    widget::on_tree_select(#addr_of(orphan), #addr_of(panel) as *u8);
    assert panel.selection().is_none();
    return;
}

// ==============================================================================
// appkit — the platform module's own logic
// ==============================================================================

// A node with no backing view and no backed ancestor has nowhere to draw a
// highlight, and the answer is "not found" rather than a rectangle at the
// origin.
#[test]
fn placing_a_node_with_no_backed_ancestor_finds_nothing() {
    fresh();
    var body: core::Builder = core::Builder::new();
    body.add(ui::label("x", key: "x"));
    var root: core::Node = ui::column(body, key: "root");
    app::open_window(#addr_of(root));

    let h: insp::Handle = row_for(tree::describe(), "x");
    let p: platform::Placed = platform::place(h.node);
    assert !p.found;
    assert platform::place(0 as *core::Node).found == false;
    return;
}

// The native panel is empty when nothing is installed, and says what it knows
// when it is. A viewless node's native row is a FACT about the node — it is
// drawn by an ancestor — not a blank.
#[test]
fn native_rows_explain_a_viewless_node_rather_than_being_empty() {
    fresh();
    var body: core::Builder = core::Builder::new();
    body.add(ui::label("x", key: "x"));
    var root: core::Node = ui::column(body, key: "root");
    app::open_window(#addr_of(root));
    let h: insp::Handle = row_for(tree::describe(), "x");

    // Before install: facet knows nothing about the platform and lists none.
    match tree::inspect(h) {
        option::Option[insp::Detail]::Some(d) => { assert d.native.count() == (0 as usize); }
        option::Option[insp::Detail]::None => { assert false; }
    }

    platform::install();
    match tree::inspect(h) {
        option::Option[insp::Detail]::Some(d) => {
            assert d.native.count() >= (1 as usize);
            assert prop_named(d.native, "native_class");
            // And it never leaks into the writable list.
            assert !prop_named(d.declared, "native_class");
        }
        option::Option[insp::Detail]::None => { assert false; }
    }
    // Installing the platform must not have made a native row writable.
    assert tree::set(h, "native_class", insp::Value::Str(text::from_str("NSButton")))
        == insp::Outcome::ReadOnly;

    // Put the portable no-ops back so test order cannot matter.
    tree::set_native_fn(#zero::[fn(*core::Node) -> vec::Vec[insp::Prop]]());
    tree::install_platform(#zero::[fn(*u8, insp::Handle)](), #zero::[fn(*u8)]());
    return;
}

// ==============================================================================
// structure
// ==============================================================================
//
// Adding and removing nodes. `facet/mount` owns the operations and has its own
// suite over them; what is under test here is the ADDRESSING and the refusals —
// the cases mount would perform faithfully and a developer would not have
// wanted, plus the journal that turns an edit back into source.

// ---- unit ----

#[test]
fn a_spec_carries_its_maker_and_clones_whole() {
    let sp: insp::Spec = insp::Spec::of("label", "greeting", "hello");
    assert sp.maker.view() == "label";
    assert sp.key.view() == "greeting";
    assert sp.label.view() == "hello";

    let copy: insp::Spec = sp.clone();
    assert copy.maker.view() == "label";
    assert copy.label.view() == "hello";
    // The original is intact: `clone` duplicates rather than moving out, which
    // is what lets `insert` both build from a spec and journal it.
    assert sp.label.view() == "hello";

    // Key and label default, because the common case is a bare container.
    let bare: insp::Spec = insp::Spec::of("column");
    assert bare.key.is_empty();
    assert bare.label.is_empty();
    return;
}

#[test]
fn every_maker_name_builds_and_an_unknown_one_builds_nothing() {
    let names: vec::Vec[str] = tree::maker_names();
    assert names.count() > (0 as usize);
    var i: usize = 0 as usize;
    while i < names.count() {
        match names.at(i) {
            option::Option[str]::Some(nm) => {
                // The listed vocabulary and the vocabulary that builds are one
                // list. A name the UI offers and `make` refuses is the drift
                // this pins.
                match tree::make(insp::Spec::of(nm, "k", "t")) {
                    option::Option[core::Node]::Some(n) => {
                        assert { n.key() } == "k";
                    }
                    option::Option[core::Node]::None => { assert false; }
                }
            }
            option::Option[str]::None => { assert false; }
        }
        i = i +% (1 as usize);
    }

    match tree::make(insp::Spec::of("frobnicate", "k", "t")) {
        option::Option[core::Node]::Some(_n) => { assert false; }
        option::Option[core::Node]::None => { }
    }
    return;
}

#[test]
fn containers_host_children_and_leaf_controls_do_not() {
    var empty: core::Builder = core::Builder::new();
    var col: core::Node = ui::column(empty, key: "c");
    assert tree::can_host_children(#addr_of(col));

    var scroll: core::Node = ui::scroll(key: "s");
    assert tree::can_host_children(#addr_of(scroll));

    var lab: core::Node = ui::label("x", key: "l");
    assert !tree::can_host_children(#addr_of(lab));

    var btn: core::Node = ui::button("x", key: "b");
    assert !tree::can_host_children(#addr_of(btn));

    // A null parent is not a container either, rather than a crash.
    assert !tree::can_host_children(0 as *core::Node);
    return;
}

#[test]
fn within_finds_a_descendant_itself_and_nothing_else() {
    var inner: core::Builder = core::Builder::new();
    inner.add(ui::label("deep", key: "deep"));
    var mid: core::Builder = core::Builder::new();
    mid.add(ui::column(inner, key: "mid"));
    var root: core::Node = ui::column(mid, key: "root");

    let r: *core::Node = #addr_of(root);
    assert tree::within(r, r);
    match core::child_of(r, 0 as usize) {
        option::Option[*core::Node]::Some(m) => {
            assert tree::within(r, m);
            // ...and not the other way. Containment has a direction, which is
            // the whole point of the cycle check that uses it.
            assert !tree::within(m, r);
        }
        option::Option[*core::Node]::None => { assert false; }
    }

    var stranger: core::Node = ui::label("elsewhere", key: "elsewhere");
    assert !tree::within(r, #addr_of(stranger));
    return;
}

// ---- e2e ----

#[test]
fn add_child_appends_into_the_live_tree_and_the_walk_sees_it() {
    fresh();
    var body: core::Builder = core::Builder::new();
    body.add(ui::label("a", key: "a"));
    var root: core::Node = ui::column(body, key: "root");
    app::open_window(#addr_of(root));

    let h: insp::Handle = row_for(tree::describe(), "root");
    // Past the end: `insert_child` clamps, so any index beyond the last is an
    // append. That is what makes "Add child" one verb rather than two.
    assert tree::insert(h, 99 as usize, insp::Spec::of("label", "b", "hello")).is_ok();

    let r: *core::Node = #addr_of(root);
    assert core::child_count_of(r) == (2 as usize);
    assert child_key_is(r, 0 as usize, "a");
    assert child_key_is(r, 1 as usize, "b");

    // And the inspector's own walk sees it, with a live handle and the tier-3
    // property the new node's kind carries.
    let rows: vec::Vec[insp::Node] = tree::describe();
    let nh: insp::Handle = row_for(rows, "b");
    assert !nh.is_none();
    assert nh.is_live();
    assert text_eq(nh, "text", "hello");
    return;
}

#[test]
fn insert_lands_at_the_index_asked_for() {
    fresh();
    var body: core::Builder = core::Builder::new();
    body.add(ui::label("a", key: "a"));
    body.add(ui::label("c", key: "c"));
    var root: core::Node = ui::column(body, key: "root");
    app::open_window(#addr_of(root));

    let h: insp::Handle = row_for(tree::describe(), "root");
    assert tree::insert(h, 1 as usize, insp::Spec::of("label", "b", "mid")).is_ok();

    let r: *core::Node = #addr_of(root);
    assert core::child_count_of(r) == (3 as usize);
    assert child_key_is(r, 0 as usize, "a");
    assert child_key_is(r, 1 as usize, "b");
    assert child_key_is(r, 2 as usize, "c");
    return;
}

#[test]
fn an_inserted_node_is_editable_through_the_ordinary_property_path() {
    fresh();
    var body: core::Builder = core::Builder::new();
    var root: core::Node = ui::column(body, key: "root");
    app::open_window(#addr_of(root));

    let h: insp::Handle = row_for(tree::describe(), "root");
    assert tree::insert(h, 0 as usize, insp::Spec::of("column", "made")).is_ok();

    // The point of making the node rather than configuring it: it is
    // addressable the instant it exists, by the editor that was already there.
    let made: insp::Handle = row_for(tree::describe(), "made");
    assert tree::set(made, "padding", insp::Value::Num(12.0f64)).is_ok();
    assert get_num(made, "padding") == 12.0f64;
    assert tree::set(made, "opacity", insp::Value::Num(0.5f64)).is_ok();
    assert get_num(made, "opacity") == 0.5f64;
    return;
}

#[test]
fn remove_takes_the_node_out_and_undo_puts_it_back_where_it_was() {
    fresh();
    var body: core::Builder = core::Builder::new();
    body.add(ui::label("a", key: "a"));
    body.add(ui::label("b", key: "b"));
    body.add(ui::label("c", key: "c"));
    var root: core::Node = ui::column(body, key: "root");
    app::open_window(#addr_of(root));

    let r: *core::Node = #addr_of(root);
    let h: insp::Handle = row_for(tree::describe(), "b");
    assert tree::remove(h).is_ok();
    assert core::child_count_of(r) == (2 as usize);
    assert child_key_is(r, 0 as usize, "a");
    assert child_key_is(r, 1 as usize, "c");
    assert row_for(tree::describe(), "b").is_none();
    // Held, not freed. That is the difference between `remove_child` and
    // `remove_node`, and it is what makes the verb undoable.
    assert tree::trash_count() == (1 as usize);

    assert tree::undo_remove().is_ok();
    assert core::child_count_of(r) == (3 as usize);
    // Back in the MIDDLE, not appended: the index went into the trash with it.
    assert child_key_is(r, 1 as usize, "b");
    assert tree::trash_count() == (0 as usize);
    assert !row_for(tree::describe(), "b").is_none();
    return;
}

#[test]
fn undo_unwinds_in_reverse_and_a_restored_parent_can_take_its_child_back() {
    fresh();
    var inner: core::Builder = core::Builder::new();
    inner.add(ui::label("kid", key: "kid"));
    var body: core::Builder = core::Builder::new();
    body.add(ui::column(inner, key: "holder"));
    var root: core::Node = ui::column(body, key: "root");
    app::open_window(#addr_of(root));

    assert tree::remove(row_for(tree::describe(), "kid")).is_ok();
    assert tree::remove(row_for(tree::describe(), "holder")).is_ok();
    assert tree::trash_count() == (2 as usize);

    // The holder comes back first, and only then is there a parent for the kid
    // to go back into. A stack, and it has to be one.
    assert tree::undo_remove().is_ok();
    assert !row_for(tree::describe(), "holder").is_none();
    assert tree::undo_remove().is_ok();
    assert !row_for(tree::describe(), "kid").is_none();
    assert tree::trash_count() == (0 as usize);
    return;
}

// The deterministic half of the test above. That one restores the holder into
// the same slot it came out of, so it read the same address back and passed —
// about three runs in four (bugs/closed/inspector-undo-test-is-flaky.md). Here
// the parent's child vector is grown past its old capacity while the holder is
// in the trash, so the holder provably comes back at a DIFFERENT address, and
// the kid's undo can only work if what was recorded for it is a position rather
// than a pointer.
#[test]
fn undo_restores_into_a_parent_that_came_back_at_a_new_address() {
    fresh();
    var inner: core::Builder = core::Builder::new();
    inner.add(ui::label("kid", key: "kid"));
    var body: core::Builder = core::Builder::new();
    body.add(ui::column(inner, key: "holder"));
    var root: core::Node = ui::column(body, key: "root");
    app::open_window(#addr_of(root));

    let held: *core::Node = match core::child_of(#addr_of(root), 0 as usize) {
        option::Option[*core::Node]::Some(c) => c,
        option::Option[*core::Node]::None => 0 as *core::Node,
    };
    assert held != (0 as *core::Node);

    assert tree::remove(row_for(tree::describe(), "kid")).is_ok();
    assert tree::remove(row_for(tree::describe(), "holder")).is_ok();

    // Eight siblings into a container that just went empty: whatever capacity
    // its child vector had for one node, it does not have for eight.
    var i: i32 = 0;
    while i < 8 {
        assert tree::insert(
            row_for(tree::describe(), "root"),
            0 as usize,
            insp::Spec::of("label", "filler", "f")
        ).is_ok();
        i = i + 1;
    }

    assert tree::undo_remove().is_ok();
    let back: *core::Node = match core::child_of(#addr_of(root), 0 as usize) {
        option::Option[*core::Node]::Some(c) => c,
        option::Option[*core::Node]::None => 0 as *core::Node,
    };
    assert back != (0 as *core::Node);
    assert child_key_is(#addr_of(root), 0 as usize, "holder");
    // The premise of the test: the holder is NOT where it was.
    assert back != held;

    // ...and the kid goes home to the HOLDER, because the trash recorded where
    // the holder is and not where it was. Asserted as parentage, not as
    // presence: the vacated slot gets reused, so a stale pointer can land the
    // kid inside whichever node took the address over and still report `Ok`.
    assert tree::undo_remove().is_ok();
    assert !row_for(tree::describe(), "kid").is_none();
    assert core::child_count_of(back) == (1 as usize);
    assert child_key_is(back, 0 as usize, "kid");
    assert tree::trash_count() == (0 as usize);
    return;
}

#[test]
fn reparent_moves_a_node_between_containers() {
    fresh();
    var left: core::Builder = core::Builder::new();
    left.add(ui::label("x", key: "x"));
    var right: core::Builder = core::Builder::new();
    var body: core::Builder = core::Builder::new();
    body.add(ui::column(left, key: "left"));
    body.add(ui::column(right, key: "right"));
    var root: core::Node = ui::column(body, key: "root");
    app::open_window(#addr_of(root));

    let rows: vec::Vec[insp::Node] = tree::describe();
    assert tree::reparent(row_for(rows, "x"), row_for(rows, "right"), 0 as usize).is_ok();

    let after: vec::Vec[insp::Node] = tree::describe();
    let lh: insp::Handle = row_for(after, "left");
    let rh: insp::Handle = row_for(after, "right");
    assert core::child_count_of(lh.node) == (0 as usize);
    assert core::child_count_of(rh.node) == (1 as usize);
    assert child_key_is(rh.node, 0 as usize, "x");
    // Moved, not copied and not dropped — the walk still finds exactly one.
    assert !row_for(after, "x").is_none();
    return;
}

#[test]
fn an_insert_leaves_handles_live_and_a_removal_ends_them() {
    fresh();
    var body: core::Builder = core::Builder::new();
    body.add(ui::label("a", key: "a"));
    body.add(ui::label("b", key: "b"));
    var root: core::Node = ui::column(body, key: "root");
    app::open_window(#addr_of(root));

    let held: insp::Handle = row_for(tree::describe(), "a");
    assert held.is_live();

    // An insert does not touch flex's removal counter, so a client's whole
    // snapshot survives it.
    assert tree::insert(row_for(tree::describe(), "root"), 0 as usize,
                        insp::Spec::of("spacer")).is_ok();
    assert held.is_live();

    // A removal ends EVERY outstanding generation, everywhere. Conservative on
    // purpose, and the same rule facet's own typed handles use.
    assert tree::remove(row_for(tree::describe(), "b")).is_ok();
    assert !held.is_live();
    assert tree::set(held, "opacity", insp::Value::Num(0.5f64)) == insp::Outcome::Stale;
    return;
}

#[test]
fn the_journal_reads_as_the_source_that_made_the_edit() {
    fresh();
    var body: core::Builder = core::Builder::new();
    body.add(ui::label("a", key: "a"));
    var root: core::Node = ui::column(body, key: "root");
    app::open_window(#addr_of(root));

    let h: insp::Handle = row_for(tree::describe(), "root");
    // An append is `add_child`, which is what an application writes...
    assert tree::insert(h, 9 as usize, insp::Spec::of("label", "b", "hello")).is_ok();
    assert journal_line_is(0 as usize,
        "mount::add_child(mount::node(\"root\"), ui::label(\"hello\", key: \"b\"));");

    // ...and only a genuine mid-list insert carries an index.
    assert tree::insert(h, 0 as usize, insp::Spec::of("spacer", "sp")).is_ok();
    assert journal_line_is(1 as usize,
        "mount::insert_child(mount::node(\"root\"), ui::spacer(key: \"sp\"), 0);");

    assert tree::remove(row_for(tree::describe(), "a")).is_ok();
    assert journal_line_is(2 as usize, "mount::remove(\"a\");");
    assert tree::journal_count() == (3 as usize);

    tree::forget_journal();
    assert tree::journal_count() == (0 as usize);
    return;
}

#[test]
fn the_journal_says_so_rather_than_inventing_an_address_it_does_not_have() {
    fresh();
    var inner: core::Builder = core::Builder::new();
    var body: core::Builder = core::Builder::new();
    body.add(ui::column(inner));
    var root: core::Node = ui::column(body, key: "root");
    app::open_window(#addr_of(root));

    // An unkeyed parent has no expression that addresses it. Inventing one
    // would produce a line that compiles and edits a different node.
    let un: insp::Handle = unkeyed_of_kind(tree::describe(), 0u32);
    assert !un.is_none();
    assert tree::insert(un, 0 as usize, insp::Spec::of("label", "", "hi")).is_ok();
    assert journal_line_is(0 as usize,
        "// inserted label under an unkeyed node - give that node a key to address this");

    // Same for a removal with no key of its own.
    let made: insp::Handle = unkeyed_of_kind(tree::describe(), props::K_LABEL);
    assert !made.is_none();
    assert tree::remove(made).is_ok();
    assert journal_line_is(1 as usize,
        "// removed an unkeyed label - no key, so no line that addresses it");
    return;
}

// ---- negative ----

#[test]
fn a_leaf_control_refuses_an_inserted_child() {
    fresh();
    var body: core::Builder = core::Builder::new();
    body.add(ui::label("a", key: "a"));
    body.add(ui::button("go", key: "go"));
    var root: core::Node = ui::column(body, key: "root");
    app::open_window(#addr_of(root));

    let rows: vec::Vec[insp::Node] = tree::describe();
    // A label hosts no views: the child's view would land in the LABEL'S
    // parent while the node sat under the label. Faithful, and not what
    // anybody meant.
    assert tree::insert(row_for(rows, "a"), 0 as usize, insp::Spec::of("label"))
        == insp::Outcome::NotAContainer;
    assert tree::insert(row_for(rows, "go"), 0 as usize, insp::Spec::of("label"))
        == insp::Outcome::NotAContainer;
    // Refused all the way down: nothing was made and nothing was journalled.
    assert core::child_count_of(row_for(rows, "a").node) == (0 as usize);
    assert tree::journal_count() == (0 as usize);
    return;
}

#[test]
fn an_unknown_maker_is_its_own_refusal_and_changes_nothing() {
    fresh();
    var body: core::Builder = core::Builder::new();
    var root: core::Node = ui::column(body, key: "root");
    app::open_window(#addr_of(root));

    let h: insp::Handle = row_for(tree::describe(), "root");
    // `UnknownKind` and not `NotAContainer`: the parent was fine, the spelling
    // was not. Same distinction as `UnknownProperty` against `Unsupported`.
    assert tree::insert(h, 0 as usize, insp::Spec::of("blink", "k"))
        == insp::Outcome::UnknownKind;
    assert core::child_count_of(#addr_of(root)) == (0 as usize);
    assert tree::journal_count() == (0 as usize);
    return;
}

#[test]
fn a_window_root_is_protected_from_removal() {
    fresh();
    var body: core::Builder = core::Builder::new();
    body.add(ui::label("a", key: "a"));
    var root: core::Node = ui::column(body, key: "root");
    app::open_window(#addr_of(root));

    // A second window, so there is somewhere a root could be moved TO that is
    // not inside itself.
    var other_body: core::Builder = core::Builder::new();
    var other: core::Node = ui::column(other_body, key: "other");
    app::open_window(#addr_of(other));

    // A root is closed with `app::close_window`, not deleted out from under
    // itself. It still takes children, because that is a different question.
    let rows: vec::Vec[insp::Node] = tree::describe();
    let h: insp::Handle = row_for(rows, "root");
    assert tree::remove(h) == insp::Outcome::Protected;
    assert tree::reparent(h, row_for(rows, "other"), 0 as usize)
        == insp::Outcome::Protected;
    // Into ITSELF is the cycle check, which runs first because it is the
    // cheaper answer and the more specific one.
    assert tree::reparent(h, h, 0 as usize) == insp::Outcome::Cycle;
    assert tree::insert(h, 0 as usize, insp::Spec::of("spacer")).is_ok();
    return;
}

#[test]
fn the_panels_own_subtree_is_protected_from_every_structural_verb() {
    fresh();
    var panel_body: core::Builder = core::Builder::new();
    panel_body.add(ui::label("a control of the panel's own", key: "insp:label"));
    var body: core::Builder = core::Builder::new();
    body.add(ui::label("app", key: "app"));
    body.add(ui::column(panel_body, key: "insp:root"));
    var root: core::Node = ui::column(body, key: "root");
    app::open_window(#addr_of(root));

    let rows: vec::Vec[insp::Node] = tree::describe();
    tree::mark_self(row_for(rows, "insp:root").node);

    // The panel is the thing the developer is READING. A tool that can delete
    // its own controls can end a debugging session by accident — and unlike a
    // property edit, that one has no field to type the old value back into.
    let own: insp::Handle = row_for(rows, "insp:root");
    let inside: insp::Handle = row_for(rows, "insp:label");
    let app_side: insp::Handle = row_for(rows, "app");
    assert tree::remove(own) == insp::Outcome::Protected;
    // Not just the root of it: everything under it, which is what the walk in
    // `within` is for.
    assert tree::remove(inside) == insp::Outcome::Protected;
    assert tree::insert(own, 0 as usize, insp::Spec::of("label"))
        == insp::Outcome::Protected;
    assert tree::reparent(app_side, own, 0 as usize) == insp::Outcome::Protected;
    // ...while the application beside it is editable as ever.
    assert tree::remove(app_side).is_ok();
    return;
}

#[test]
fn a_move_into_a_nodes_own_subtree_is_refused_as_a_cycle() {
    fresh();
    var inner: core::Builder = core::Builder::new();
    var mid: core::Builder = core::Builder::new();
    mid.add(ui::column(inner, key: "inner"));
    var body: core::Builder = core::Builder::new();
    body.add(ui::column(mid, key: "outer"));
    var root: core::Node = ui::column(body, key: "root");
    app::open_window(#addr_of(root));

    let rows: vec::Vec[insp::Node] = tree::describe();
    let outer: insp::Handle = row_for(rows, "outer");
    let inner_h: insp::Handle = row_for(rows, "inner");

    // Checked BEFORE the removal. Afterwards the answer would still be no and
    // the tree would already be cut.
    assert tree::reparent(outer, inner_h, 0 as usize) == insp::Outcome::Cycle;
    assert tree::reparent(outer, outer, 0 as usize) == insp::Outcome::Cycle;
    assert core::child_count_of(outer.node) == (1 as usize);
    assert tree::trash_count() == (0 as usize);
    return;
}

#[test]
fn undo_refuses_rather_than_restoring_into_a_parent_that_has_gone() {
    fresh();
    var inner: core::Builder = core::Builder::new();
    inner.add(ui::label("kid", key: "kid"));
    var body: core::Builder = core::Builder::new();
    body.add(ui::column(inner, key: "holder"));
    var root: core::Node = ui::column(body, key: "root");
    app::open_window(#addr_of(root));

    assert tree::remove(row_for(tree::describe(), "kid")).is_ok();
    // The APPLICATION deletes the holder — `mount::remove` drops it outright
    // rather than putting it in the inspector's trash. The stored parent
    // pointer now names a node in no window.
    assert mount::remove("holder");

    assert tree::undo_remove() == insp::Outcome::NothingToUndo;
    // And the subtree is still held rather than inserted somewhere it cannot
    // be seen or reached.
    assert tree::trash_count() == (1 as usize);
    return;
}

#[test]
fn undo_with_nothing_removed_says_so() {
    fresh();
    assert tree::trash_count() == (0 as usize);
    assert tree::undo_remove() == insp::Outcome::NothingToUndo;
    return;
}

#[test]
fn structural_verbs_refuse_a_null_or_stale_handle() {
    fresh();
    var body: core::Builder = core::Builder::new();
    body.add(ui::label("a", key: "a"));
    body.add(ui::label("b", key: "b"));
    var root: core::Node = ui::column(body, key: "root");
    app::open_window(#addr_of(root));

    let none: insp::Handle = insp::Handle::none();
    assert tree::insert(none, 0 as usize, insp::Spec::of("label")) == insp::Outcome::NotFound;
    assert tree::remove(none) == insp::Outcome::NotFound;
    assert tree::reparent(none, none, 0 as usize) == insp::Outcome::NotFound;

    // Liveness before existence: a handle from before a removal is `Stale`,
    // which tells the client to re-describe, rather than `NotFound`, which
    // would say the node was never there.
    let held: insp::Handle = row_for(tree::describe(), "root");
    assert tree::remove(row_for(tree::describe(), "b")).is_ok();
    assert tree::insert(held, 0 as usize, insp::Spec::of("label")) == insp::Outcome::Stale;
    assert tree::remove(held) == insp::Outcome::Stale;
    assert tree::reparent(held, held, 0 as usize) == insp::Outcome::Stale;
    return;
}

#[test]
fn the_structural_outcomes_all_describe_themselves() {
    // Every refusal a developer can provoke has to say which one it was. A
    // single "no" is what teaches people to guess.
    assert insp::Outcome::NotAContainer.describe() != "";
    assert insp::Outcome::Protected.describe() != "";
    assert insp::Outcome::UnknownKind.describe() != "";
    assert insp::Outcome::Cycle.describe() != "";
    assert insp::Outcome::NothingToUndo.describe() != "";
    assert !insp::Outcome::NotAContainer.is_ok();
    assert !insp::Outcome::Protected.is_ok();
    assert !insp::Outcome::UnknownKind.is_ok();
    assert !insp::Outcome::Cycle.is_ok();
    assert !insp::Outcome::NothingToUndo.is_ok();
    return;
}

#[test]
fn the_degraded_backend_refuses_every_structural_verb_and_crashes_nothing() {
    fresh();
    let b: insp::Backend = insp::Backend::none();
    let h: insp::Handle = insp::Handle::none();
    assert b.insert_now(h, 0 as usize, insp::Spec::of("label")) == insp::Outcome::Unsupported;
    assert b.remove_now(h) == insp::Outcome::Unsupported;
    assert b.reparent_now(h, h, 0 as usize) == insp::Outcome::Unsupported;
    assert b.undo_now() == insp::Outcome::NothingToUndo;
    return;
}

#[test]
fn the_local_backend_routes_every_structural_verb_to_the_tree() {
    fresh();
    var body: core::Builder = core::Builder::new();
    body.add(ui::label("a", key: "a"));
    var root: core::Node = ui::column(body, key: "root");
    app::open_window(#addr_of(root));

    // The panel is written against the vtable, so a row that is wired wrong is
    // a panel button that silently does nothing.
    let b: insp::Backend = tree::local_backend();
    let h: insp::Handle = row_for(b.describe_now(), "root");
    assert b.insert_now(h, 9 as usize, insp::Spec::of("label", "made", "hi")).is_ok();
    assert !row_for(b.describe_now(), "made").is_none();

    assert b.remove_now(row_for(b.describe_now(), "made")).is_ok();
    assert row_for(b.describe_now(), "made").is_none();
    assert b.undo_now().is_ok();
    assert !row_for(b.describe_now(), "made").is_none();

    let rows: vec::Vec[insp::Node] = b.describe_now();
    assert b.reparent_now(row_for(rows, "made"), row_for(rows, "root"), 0 as usize).is_ok();
    assert child_key_is(row_for(rows, "root").node, 0 as usize, "made");
    return;
}

// ==============================================================================
// the wire
// ==============================================================================
//
// The inspector as a namespace inside the agent's JSON-RPC server. Driven the
// way a socket drives it — a request line in, a response line out — through
// `agent_mcp::handle_request`, so what is under test is the whole path
// including the prefix routing and the consent gate, not just this package's
// half of it.

// The grant a DEVELOPER TOOL runs under: it rewrites the tree, which is
// `edit_tree` and is carried by nothing else. An IDE minting this is saying so
// out loud; an agent that merely drives the app never gets it.
fn dev_tool(req: aauth::Request) -> aauth::Grant {
    return aauth::operator().with(aauth::cap_edit_tree());
}

// A request line for the inspector namespace, dispatched through the agent
// bridge exactly as the socket server does.
fn rpc(line: str) -> text::Text {
    return rpc_as(dev_tool, line);
}

// The same, under a stated policy — for the tests that are about WHO is asking.
fn rpc_as(policy: fn(aauth::Request) -> aauth::Grant, line: str) -> text::Text {
    var sub: aevents::Subscriber = aevents::subscriber(aevents::everything(), 4 as usize);
    let surf: *u8 = 0 as *u8;
    return bridge::handle_request(surf, bridge::fake_backend(), sub,
                                  aauth::serve(policy), line);
}

// A window with something to address, described once so the wire indices exist.
fn wire_ready() {
    fresh();
    tree::empty_trash();
    tree::forget_journal();
    mcp::disarm();
    mcp::arm(tree::local_backend());
    return;
}

#[test]
fn describe_puts_the_tree_on_the_wire_with_indices_as_addresses() {
    wire_ready();
    var body: core::Builder = core::Builder::new();
    body.add(ui::label("hello", key: "greeting"));
    var root: core::Node = ui::column(body, key: "root");
    app::open_window(#addr_of(root));

    let r: text::Text = rpc("{\"method\":\"inspector.describe\",\"id\":1}");
    assert r.contains("\"key\":\"root\"");
    assert r.contains("\"key\":\"greeting\"");
    // The index is stated on the row, not left implicit in the array position:
    // a client that filters locally must still be able to address what it kept.
    assert r.contains("\"index\":0");
    assert r.contains("\"index\":1");
    assert r.contains("\"revision\"");
    // What a walk of the platform's view hierarchy could never say, and the
    // whole reason this listing walks facet's tree instead.
    assert r.contains("\"has_view\"");
    assert r.contains("\"kind\":\"label\"");
    assert mcp::snapshot_count() == (2 as usize);
    return;
}

#[test]
fn inspect_keeps_declared_computed_and_native_apart_on_the_wire() {
    wire_ready();
    var body: core::Builder = core::Builder::new();
    body.add(ui::label("hello", key: "greeting"));
    var root: core::Node = ui::column(body, key: "root");
    app::open_window(#addr_of(root));
    let _d: text::Text = rpc("{\"method\":\"inspector.describe\",\"id\":1}");

    let r: text::Text = rpc("{\"method\":\"inspector.inspect\",\"params\":{\"node\":1},\"id\":2}");
    assert r.contains("\"declared\"");
    assert r.contains("\"computed\"");
    assert r.contains("\"native\"");
    // Setting `width` writes a style; reading the frame reads what layout
    // decided. Two questions that share a word, so two lists.
    assert r.contains("\"frame_width\"");
    assert r.contains("\"opacity\"");
    // Every row carries its tag, so a client knows what a write will take
    // without inferring it from the value it happens to hold.
    assert r.contains("\"type\":\"number\"");
    assert r.contains("\"writable\":true");
    return;
}

#[test]
fn a_write_goes_through_the_same_setters_the_panel_uses() {
    wire_ready();
    var body: core::Builder = core::Builder::new();
    body.add(ui::label("hello", key: "greeting"));
    var root: core::Node = ui::column(body, key: "root");
    app::open_window(#addr_of(root));
    let _d: text::Text = rpc("{\"method\":\"inspector.describe\",\"id\":1}");

    // A number for a number property.
    let a: text::Text = rpc("{\"method\":\"inspector.set\",\"params\":{\"node\":0,\"property\":\"opacity\",\"value\":0.4},\"id\":2}");
    assert a.contains("\"outcome\":\"ok\"");
    assert get_num(row_for(tree::describe(), "root"), "opacity") == 0.4f64;

    // A string for a text property — tier 3, and it reaches through the key.
    let b: text::Text = rpc("{\"method\":\"inspector.set\",\"params\":{\"node\":1,\"property\":\"text\",\"value\":\"rewritten\"},\"id\":3}");
    assert b.contains("\"outcome\":\"ok\"");
    assert text_eq(row_for(tree::describe(), "greeting"), "text", "rewritten");

    // A hex string for a colour property: the panel's rule, unchanged. The
    // string is read as the tag the property already holds, which is what makes
    // `#2277ff` a colour here and seven literal characters on a text property.
    let c: text::Text = rpc("{\"method\":\"inspector.set\",\"params\":{\"node\":0,\"property\":\"background_color\",\"value\":\"#2277ff\"},\"id\":4}");
    assert c.contains("\"outcome\":\"ok\"");

    // And reset puts back what the application declared.
    let d: text::Text = rpc("{\"method\":\"inspector.reset\",\"params\":{\"node\":0,\"property\":\"opacity\"},\"id\":5}");
    assert d.contains("\"outcome\":\"ok\"");
    assert get_num(row_for(tree::describe(), "root"), "opacity") == 1.0f64;
    return;
}

#[test]
fn the_structural_verbs_are_on_the_wire_with_their_journal() {
    wire_ready();
    var body: core::Builder = core::Builder::new();
    body.add(ui::label("a", key: "a"));
    var root: core::Node = ui::column(body, key: "root");
    app::open_window(#addr_of(root));
    let _d: text::Text = rpc("{\"method\":\"inspector.describe\",\"id\":1}");

    let i: text::Text = rpc("{\"method\":\"inspector.insert\",\"params\":{\"node\":0,\"element\":\"label\",\"key\":\"made\",\"text\":\"hi\"},\"id\":2}");
    assert i.contains("\"outcome\":\"ok\"");
    assert !row_for(tree::describe(), "made").is_none();

    // Indices are re-issued by a describe. The client's own is the one it was
    // handed, so a structural edit is followed by a re-describe — which is
    // exactly what `revision` is on every answer to prompt.
    let _d2: text::Text = rpc("{\"method\":\"inspector.describe\",\"id\":3}");
    let r: text::Text = rpc("{\"method\":\"inspector.remove\",\"params\":{\"node\":1},\"id\":4}");
    assert r.contains("\"outcome\":\"ok\"");
    assert row_for(tree::describe(), "a").is_none();

    let u: text::Text = rpc("{\"method\":\"inspector.undo\",\"id\":5}");
    assert u.contains("\"outcome\":\"ok\"");
    assert !row_for(tree::describe(), "a").is_none();

    // The edits come back as the source that would make them. An agent that
    // changes a running app and cannot say what it did in the app's own
    // language has produced a change nobody can keep.
    let j: text::Text = rpc("{\"method\":\"inspector.journal\",\"id\":6}");
    assert j.contains("mount::add_child");
    assert j.contains("ui::label(\\\"hi\\\", key: \\\"made\\\")");
    assert j.contains("mount::remove(\\\"a\\\")");
    return;
}

#[test]
fn the_vocabulary_is_answered_rather_than_carried_by_the_client() {
    wire_ready();
    let r: text::Text = rpc("{\"method\":\"inspector.vocabulary\",\"id\":1}");
    // Both lists come from `tree`, so a client never holds a copy that can
    // drift from what this build actually makes and writes.
    assert r.contains("\"elements\"");
    assert r.contains("\"label\"");
    assert r.contains("\"column\"");
    assert r.contains("\"properties\"");
    assert r.contains("\"padding\"");
    assert r.contains("\"background_color\"");
    return;
}

// ---- negative ----

#[test]
fn refusals_travel_by_name_and_by_sentence() {
    wire_ready();
    var body: core::Builder = core::Builder::new();
    body.add(ui::label("a", key: "a"));
    var root: core::Node = ui::column(body, key: "root");
    app::open_window(#addr_of(root));
    let _d: text::Text = rpc("{\"method\":\"inspector.describe\",\"id\":1}");

    // A client matching on a name should not have to parse prose; a developer
    // reading a transcript should not have to look the name up. So both.
    let leaf: text::Text = rpc("{\"method\":\"inspector.insert\",\"params\":{\"node\":1,\"element\":\"label\"},\"id\":2}");
    assert leaf.contains("\"outcome\":\"not_a_container\"");
    assert leaf.contains("does not take inserted children");

    let kind: text::Text = rpc("{\"method\":\"inspector.insert\",\"params\":{\"node\":0,\"element\":\"blink\"},\"id\":3}");
    assert kind.contains("\"outcome\":\"unknown_kind\"");

    let root_rm: text::Text = rpc("{\"method\":\"inspector.remove\",\"params\":{\"node\":0},\"id\":4}");
    assert root_rm.contains("\"outcome\":\"protected\"");

    let ro: text::Text = rpc("{\"method\":\"inspector.set\",\"params\":{\"node\":0,\"property\":\"frame_width\",\"value\":10},\"id\":5}");
    assert ro.contains("\"outcome\":\"read_only\"");

    let bad_prop: text::Text = rpc("{\"method\":\"inspector.set\",\"params\":{\"node\":0,\"property\":\"colour\",\"value\":10},\"id\":6}");
    assert bad_prop.contains("\"outcome\":\"unknown_property\"");

    // An index that was never issued is "no such address", the same answer a
    // null handle gets — because that is what both are.
    let oob: text::Text = rpc("{\"method\":\"inspector.inspect\",\"params\":{\"node\":9999},\"id\":7}");
    assert oob.contains("\"outcome\":\"not_found\"");
    return;
}

#[test]
fn a_missing_parameter_is_refused_rather_than_defaulted_to_node_zero() {
    wire_ready();
    var body: core::Builder = core::Builder::new();
    var root: core::Node = ui::column(body, key: "root");
    app::open_window(#addr_of(root));
    let _d: text::Text = rpc("{\"method\":\"inspector.describe\",\"id\":1}");

    // Every reader here falls back, so an absent `node` would silently act on
    // index 0 — the window root. The agent surface learned this the expensive
    // way; the same rule applies to a namespace that can DELETE what it hits.
    let n: text::Text = rpc("{\"method\":\"inspector.remove\",\"params\":{},\"id\":2}");
    assert n.contains("-32602");
    assert n.contains("node");
    assert n.contains("\"outcome\"") == false;

    let p: text::Text = rpc("{\"method\":\"inspector.set\",\"params\":{\"node\":0,\"value\":1},\"id\":3}");
    assert p.contains("-32602");
    assert p.contains("property");

    let v: text::Text = rpc("{\"method\":\"inspector.set\",\"params\":{\"node\":0,\"property\":\"opacity\"},\"id\":4}");
    assert v.contains("-32602");
    assert v.contains("value");

    // A value of a type no property takes is refused at the edge, not turned
    // into a guess.
    let obj: text::Text = rpc("{\"method\":\"inspector.set\",\"params\":{\"node\":0,\"property\":\"opacity\",\"value\":{}},\"id\":5}");
    assert obj.contains("-32602");
    return;
}

#[test]
fn the_namespace_is_absent_until_it_is_armed_and_absent_again_after() {
    fresh();
    mcp::disarm();
    assert mcp::armed() == false;

    // Linking the module in is not exposure. A process that never armed the
    // namespace does not serve it — which is the whole gate, because this
    // namespace is strictly more powerful than the agent surface beside it.
    let off: text::Text = rpc("{\"method\":\"inspector.describe\",\"id\":1}");
    assert off.contains("-32601");
    assert off.contains("\"nodes\"") == false;

    mcp::arm(tree::local_backend());
    assert mcp::armed();
    let on: text::Text = rpc("{\"method\":\"inspector.describe\",\"id\":2}");
    assert on.contains("\"nodes\"");

    mcp::disarm();
    let after: text::Text = rpc("{\"method\":\"inspector.describe\",\"id\":3}");
    assert after.contains("-32601");
    return;
}

#[test]
fn arming_the_inspector_is_not_a_way_around_the_agents_consent_gate() {
    wire_ready();
    var body: core::Builder = core::Builder::new();
    var root: core::Node = ui::column(body, key: "root");
    app::open_window(#addr_of(root));

    // The gate runs FIRST and covers both namespaces. An inspector that could
    // be reached with consent denied would be the one hole in the whole
    // permission model — and it is the more powerful of the two surfaces.
    var sub: aevents::Subscriber = aevents::subscriber(aevents::everything(), 4 as usize);
    let denied: text::Text = bridge::handle_request(0 as *u8, bridge::fake_backend(), sub,
        aauth::deny_all(), "{\"method\":\"inspector.describe\",\"id\":1}");
    assert denied.contains("-32001");
    assert denied.contains("\"nodes\"") == false;
    return;
}

#[test]
fn a_degraded_backend_refuses_on_the_wire_without_crashing() {
    fresh();
    mcp::disarm();
    // Armed, but with the vtable that answers nothing. The namespace is open
    // and every verb declines — which is what a build with no walker installed
    // should look like from outside, rather than a null call.
    mcp::arm(insp::Backend::none());

    let d: text::Text = rpc("{\"method\":\"inspector.describe\",\"id\":1}");
    assert d.contains("\"nodes\"");
    assert mcp::snapshot_count() == (0 as usize);

    let s: text::Text = rpc("{\"method\":\"inspector.set\",\"params\":{\"node\":0,\"property\":\"opacity\",\"value\":1},\"id\":2}");
    assert s.contains("\"outcome\":\"not_found\"");

    let u: text::Text = rpc("{\"method\":\"inspector.undo\",\"id\":3}");
    assert u.contains("\"outcome\":\"nothing_to_undo\"");

    mcp::disarm();
    return;
}

// THE TRAP THIS NAMESPACE EXISTS TO WALK INTO, and it cost a debugging session.
//
// The override ledger records the property name it was given as a BORROWED
// `str`, sound because every name reaching it is a literal from
// `declared_names`. A socket parses a name into a request-scoped `Text`, and
// recording a view of that leaves the ledger pointing at freed bytes. Nothing
// crashes: `reset` compares the dangling name against the one it was asked for,
// matches nothing, and answers `Ok` having restored nothing at all.
//
// So a wire write must be reachable by a wire reset, which is what this pins.
#[test]
fn a_property_named_over_the_wire_is_still_addressable_by_a_later_reset() {
    wire_ready();
    var body: core::Builder = core::Builder::new();
    var root: core::Node = ui::column(body, key: "root");
    core::set_opacity(#addr_of(root), 0.9f64);
    app::open_window(#addr_of(root));
    let _d: text::Text = rpc("{\"method\":\"inspector.describe\",\"id\":1}");

    let _s: text::Text = rpc("{\"method\":\"inspector.set\",\"params\":{\"node\":0,\"property\":\"opacity\",\"value\":0.25},\"id\":2}");
    assert get_num(row_for(tree::describe(), "root"), "opacity") == 0.25f64;
    assert tree::override_count() == (1 as usize);

    // The ledger entry is findable — by the panel, which uses the literal, and
    // by a second request, which does not.
    assert tree::is_overridden(row_for(tree::describe(), "root").node, "opacity");

    let r: text::Text = rpc("{\"method\":\"inspector.reset\",\"params\":{\"node\":0,\"property\":\"opacity\"},\"id\":3}");
    assert r.contains("\"outcome\":\"ok\"");
    // Back to what the APPLICATION declared — 0.9, not the type default of 1.0.
    assert get_num(row_for(tree::describe(), "root"), "opacity") == 0.9f64;
    assert tree::override_count() == (0 as usize);
    return;
}

// A name in neither table is refused before it can be recorded, rather than
// stored and found to be nonsense later.
#[test]
fn canonical_prop_answers_this_packages_own_literal_or_nothing() {
    assert match tree::canonical_prop("opacity") {
        option::Option[str]::Some(n) => n == "opacity",
        option::Option[str]::None => false,
    };
    // Read-only names resolve too, so a caller naming one is told it is
    // read-only rather than that it does not exist.
    assert match tree::canonical_prop("frame_width") {
        option::Option[str]::Some(n) => n == "frame_width",
        option::Option[str]::None => false,
    };
    assert match tree::canonical_prop("colour") {
        option::Option[str]::Some(_n) => false,
        option::Option[str]::None => true,
    };
    assert match tree::canonical_prop("") {
        option::Option[str]::Some(_n) => false,
        option::Option[str]::None => true,
    };
    return;
}

#[test]
fn an_unknown_inspector_method_names_itself() {
    wire_ready();
    let r: text::Text = rpc("{\"method\":\"inspector.teleport\",\"id\":1}");
    assert r.contains("-32601");
    assert r.contains("inspector.teleport");
    return;
}

// A theme token is a NAME, not a colour. Reporting rgba for one would invent
// four numbers the application never wrote, and they would all be zero — so
// every themed colour would go out as transparent black. Both halves were live
// bugs in the panel; the wire inherits the fix, not the bug.
#[test]
fn a_theme_token_crosses_the_wire_as_a_name_and_a_literal_as_channels() {
    wire_ready();
    var body: core::Builder = core::Builder::new();
    var root: core::Node = ui::column(body, key: "root");
    core::set_background_color(#addr_of(root), vocab::Color::control_background());
    app::open_window(#addr_of(root));
    let _d: text::Text = rpc("{\"method\":\"inspector.describe\",\"id\":1}");

    let themed: text::Text = rpc("{\"method\":\"inspector.inspect\",\"params\":{\"node\":0},\"id\":2}");
    assert themed.contains("\"type\":\"color\"");
    // A role carries its token and NO channels, because there are none yet.
    assert themed.contains("\"rgba\"") == false;

    let _s: text::Text = rpc("{\"method\":\"inspector.set\",\"params\":{\"node\":0,\"property\":\"background_color\",\"value\":\"#2277ff\"},\"id\":3}");
    let literal: text::Text = rpc("{\"method\":\"inspector.inspect\",\"params\":{\"node\":0},\"id\":4}");
    assert literal.contains("\"token\":255");
    assert literal.contains("\"rgba\"");
    return;
}

fn main() -> i32 {
    return 0;
}


// ---- the inspector is not a way around the agent tiers -----------------------

// A payment form the way a developer writes one: the box declares the tier and
// the fields inherit it.
//
// Returns the root rather than opening the window itself. `open_window` keeps a
// POINTER, so a helper that opened one and then returned would leave the app
// holding the address of a node it had just dropped — which is a segfault a few
// tests later, in whatever ran next. The caller owns the root for the length of
// its own test.
fn payment_root() -> core::Node {
    var fields: core::Builder = core::Builder::new();
    fields.add(ui::text_field("4242424242424242", key: "card"));
    fields.add(ui::text_field("311", key: "cvc"));
    var box_n: core::Node = ui::column(fields, key: "payment");
    core::set_agent(#addr_of(box_n), vocab::Agent::Protected);
    var body: core::Builder = core::Builder::new();
    body.add(box_n);
    body.add(ui::text_field("ada@example.com", key: "email"));
    return ui::column(body, key: "root");
}

fn plain_agent(req: aauth::Request) -> aauth::Grant { return aauth::operator(); }
fn approved_agent(req: aauth::Request) -> aauth::Grant { return aauth::protected_operator(); }

#[test]
fn inspect_does_not_hand_over_a_gated_nodes_contents() {
    // THE BYPASS THIS CLOSES. `inspector.inspect` read a text field's live
    // value straight off the control — same value, same process, different
    // socket name — while the agent surface beside it refused the same read. A
    // second namespace is a place to put verbs, not a place to escape what
    // they cost.
    wire_ready();
    var root: core::Node = payment_root();
    app::open_window(#addr_of(root));
    let _d: text::Text = rpc("{\"method\":\"inspector.describe\",\"id\":1}");

    // 0 root, 1 payment box, 2 card, 3 cvc, 4 email.
    let card: text::Text =
        rpc_as(plain_agent, "{\"method\":\"inspector.inspect\",\"params\":{\"node\":2},\"id\":2}");
    assert card.contains("behind a tier");
    assert card.contains("4242") == false;
    // INHERITED from the box, which is the declaration a developer actually
    // writes — the field itself says nothing.
    let box_r: text::Text =
        rpc_as(plain_agent, "{\"method\":\"inspector.inspect\",\"params\":{\"node\":1},\"id\":3}");
    assert box_r.contains("behind a tier");
    return;
}

#[test]
fn the_grant_that_opens_the_field_opens_it_here_too() {
    // Not a wall: the same approval that lets an agent autofill the card
    // through the agent surface lets a tool inspect it. One capability model,
    // two namespaces — which is the point of folding this in rather than
    // bolting a second gate onto it.
    wire_ready();
    var root: core::Node = payment_root();
    app::open_window(#addr_of(root));
    let _d: text::Text = rpc("{\"method\":\"inspector.describe\",\"id\":1}");

    let allowed: text::Text =
        rpc_as(approved_agent, "{\"method\":\"inspector.inspect\",\"params\":{\"node\":2},\"id\":2}");
    assert allowed.contains("behind a tier") == false;
    assert allowed.contains("\"declared\"");
    return;
}

#[test]
fn an_ungated_neighbour_is_untouched() {
    // A tier that quietly blinds the rest of the tree is a tier nobody turns
    // on. The email field outside the box reads exactly as it always did.
    wire_ready();
    var root: core::Node = payment_root();
    app::open_window(#addr_of(root));
    let _d: text::Text = rpc("{\"method\":\"inspector.describe\",\"id\":1}");

    let email: text::Text =
        rpc_as(plain_agent, "{\"method\":\"inspector.inspect\",\"params\":{\"node\":4},\"id\":2}");
    assert email.contains("behind a tier") == false;
    assert email.contains("\"declared\"");
    return;
}

#[test]
fn rewriting_the_tree_costs_a_capability_nothing_else_carries() {
    // `edit_tree` is not a stronger `act`. An agent that may click every button
    // and read every field still may not rebuild the interface — and every
    // structural verb asks, so one added later gets the rule by being listed.
    wire_ready();
    var root: core::Node = payment_root();
    app::open_window(#addr_of(root));
    let _d: text::Text = rpc("{\"method\":\"inspector.describe\",\"id\":1}");

    let set_r: text::Text = rpc_as(plain_agent,
        "{\"method\":\"inspector.set\",\"params\":{\"node\":4,\"property\":\"opacity\",\"value\":0.5},\"id\":2}");
    assert set_r.contains("edit_tree");
    let rm: text::Text = rpc_as(plain_agent,
        "{\"method\":\"inspector.remove\",\"params\":{\"node\":4},\"id\":3}");
    assert rm.contains("edit_tree");
    let undo: text::Text = rpc_as(plain_agent, "{\"method\":\"inspector.undo\",\"id\":4}");
    assert undo.contains("edit_tree");
    // Reading the STRUCTURE is not rewriting it, and stays open.
    let d: text::Text = rpc_as(plain_agent, "{\"method\":\"inspector.describe\",\"id\":5}");
    assert d.contains("\"key\":\"payment\"");
    // The developer tool that says so out loud still works.
    let ok: text::Text = rpc(
        "{\"method\":\"inspector.set\",\"params\":{\"node\":4,\"property\":\"opacity\",\"value\":0.5},\"id\":6}");
    assert ok.contains("edit_tree") == false;
    return;
}

// ---- inspector.describe `prefix` (demo/bugs/04-describe-verbs-cannot-be-scoped)

#[test]
fn describe_prefix_matches_a_key_path_and_nothing_else() {
    // The filter that lets a client ask about one part of the tree instead of
    // receiving all of it — 80,477 characters against a real app, which an
    // agent harness refuses outright, leaving the verb answering nothing.
    assert mcp::key_matches("board:detail:3", "board:detail:");
    assert mcp::key_matches("board:detail:title", "board:detail:");
    assert mcp::key_matches("board:col:1", "board:detail:") == false;
    assert mcp::key_matches("window", "board:detail:") == false;
    // A prefix is a prefix, not a segment matcher: `board:` takes the subtree.
    assert mcp::key_matches("board:col:1", "board:");
    assert mcp::key_matches("boardroom", "board");        // deliberate, documented
}

#[test]
fn an_absent_describe_prefix_keeps_the_whole_tree() {
    // The parameter is optional, and its absence must not change the answer —
    // including for the unkeyed nodes this verb exists to show.
    assert mcp::key_matches("board:detail:3", "");
    assert mcp::key_matches("", "");                      // unkeyed node, no filter
    // ...and an unkeyed node is correctly NOT matched by a real prefix.
    assert mcp::key_matches("", "board:") == false;
}

// ---- one wire frame, two namespaces ----------------------------------------------

// BOTH NAMESPACES RIDE ONE SOCKET and one client parses both, so an envelope
// that differed between them would be a malformed frame on exactly half of a
// connection — the kind of defect where each side looks correct on its own.
//
// `inspector/mcp` had byte-identical reimplementations of eight of `agent_mcp`'s
// JSON and envelope helpers; they are forwards now. This asserts the PROPERTY
// rather than the implementation, so re-inlining a body is caught here instead
// of when a client chokes.
#[test]
fn both_namespaces_emit_the_same_envelope() {
    let a: text::Text = mcp::ok_response(7.0f64, mcp::jstr("x")).to_text();
    let b: text::Text = bridge::ok_response(7.0f64, bridge::jstr("x")).to_text();
    assert a.view() == b.view();

    let ea: text::Text = mcp::err_response(9.0f64, - 32601 as f64, "nope").to_text();
    let eb: text::Text = bridge::err_response(9.0f64, - 32601 as f64, "nope").to_text();
    assert ea.view() == eb.view();

    // Including the parameter refusal, whose exact wording a caller reads.
    let ma: text::Text = mcp::missing_param(3.0f64, "inspector.set", "node").to_text();
    let mb: text::Text = bridge::missing_param(3.0f64, "inspector.set", "node").to_text();
    assert ma.view() == mb.view();

    // ...and the scalar builders underneath them.
    assert mcp::jnum(2.5f64).to_text().view() == bridge::jnum(2.5f64).to_text().view();
    assert mcp::jbool(true).to_text().view() == bridge::jbool(true).to_text().view();
    return;
}
