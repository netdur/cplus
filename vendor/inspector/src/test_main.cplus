// inspector tests. No backend and no platform: the facet tree is facet's own
// state, so the walker, the dispatch, the override ledger and every refusal
// are exercisable headlessly.
//
// The suite is in three parts — unit, end-to-end over a mounted tree, and
// negative. The negative part is the one that matters most here: an inspector
// whose refusals are silent teaches a developer that a property does nothing,
// which is worse than teaching them nothing at all.

import "stdlib/vec" as vec;
import "stdlib/text" as text;
import "stdlib/option" as option;
import "stdlib/status" as status;
import "flex_layout/flex_layout" as flex;
import "facet/facet" as core;
import "facet/elements" as ui;
import "facet/application" as app;
import "facet/vocabulary" as vocab;
import "facet/props" as props;
import "facet/label" as label;
import "facet/button" as button;
import "facet/mount" as mount;
import "facet/tree" as ftree;
import "./inspector" as insp;
import "./tree" as tree;
import "./widget" as widget;
import "./appkit" as platform;

// ---- helpers -----------------------------------------------------------------

// The handle for the first row carrying `key`, or a null handle. By-value
// params borrow, so the listing is not consumed and the caller keeps it.
fn row_for(rows: vec::Vec[insp::Node], key: str) -> insp::Handle {
    var i: usize = 0 as usize;
    let c: usize = rows.count();
    while i < c {
        match rows.at_ptr(i) {
            option::Option[*insp::Node]::Some(p) => {
                if { (*p).key.view() } == key { return { (*p).handle }; }
            }
            option::Option[*insp::Node]::None => { }
        }
        i = i +% (1 as usize);
    }
    return insp::Handle::none();
}

// The `nth` row carrying `key`, for the duplicate-key case where "first
// match wins" is the behaviour under test.
fn nth_for(rows: vec::Vec[insp::Node], key: str, nth: usize) -> insp::Handle {
    var i: usize = 0 as usize;
    var seen: usize = 0 as usize;
    let c: usize = rows.count();
    while i < c {
        match rows.at_ptr(i) {
            option::Option[*insp::Node]::Some(p) => {
                if { (*p).key.view() } == key {
                    if seen == nth { return { (*p).handle }; }
                    seen = seen +% (1 as usize);
                }
            }
            option::Option[*insp::Node]::None => { }
        }
        i = i +% (1 as usize);
    }
    return insp::Handle::none();
}

// The first node of a given kind carrying no key — how a test reaches the
// unkeyed nodes that are the whole reason for walking facet's tree.
fn unkeyed_of_kind(rows: vec::Vec[insp::Node], kind: u32) -> insp::Handle {
    var i: usize = 0 as usize;
    let c: usize = rows.count();
    while i < c {
        match rows.at_ptr(i) {
            option::Option[*insp::Node]::Some(p) => {
                if { (*p).kind } == kind {
                    if { (*p).key.view() } == "" { return { (*p).handle }; }
                }
            }
            option::Option[*insp::Node]::None => { }
        }
        i = i +% (1 as usize);
    }
    return insp::Handle::none();
}

fn row_index(rows: vec::Vec[insp::Node], key: str) -> option::Option[usize] {
    var i: usize = 0 as usize;
    let c: usize = rows.count();
    while i < c {
        match rows.at_ptr(i) {
            option::Option[*insp::Node]::Some(p) => {
                if { (*p).key.view() } == key { return option::Option[usize]::Some(i); }
            }
            option::Option[*insp::Node]::None => { }
        }
        i = i +% (1 as usize);
    }
    return option::Option[usize]::None;
}

fn depth_of(rows: vec::Vec[insp::Node], key: str) -> usize {
    return match row_index(rows, key) {
        option::Option[usize]::Some(i) => {
            match rows.at_ptr(i) {
                option::Option[*insp::Node]::Some(p) => { (*p).depth }
                option::Option[*insp::Node]::None => 0 as usize,
            }
        }
        option::Option[usize]::None => 0 as usize,
    };
}

fn num_of_value(v: insp::Value) -> f64 {
    return match v {
        insp::Value::Num(x) => x,
        insp::Value::Int(i) => i as f64,
        _ => 0.0f64 / 0.0f64,
    };
}

fn get_num(h: insp::Handle, prop: str) -> f64 {
    return match tree::get(h, prop) {
        option::Option[insp::Value]::Some(v) => num_of_value(v),
        option::Option[insp::Value]::None => 0.0f64 / 0.0f64,
    };
}

fn get_bool(h: insp::Handle, prop: str) -> bool {
    return match tree::get(h, prop) {
        option::Option[insp::Value]::Some(v) => match v {
            insp::Value::Bool(b) => b,
            _ => false,
        },
        option::Option[insp::Value]::None => false,
    };
}

fn text_eq(h: insp::Handle, prop: str, want: str) -> bool {
    return match tree::get(h, prop) {
        option::Option[insp::Value]::Some(v) => match v {
            insp::Value::Str(s) => s.view() == want,
            _ => false,
        },
        option::Option[insp::Value]::None => false,
    };
}

fn prop_named(props_in: vec::Vec[insp::Prop], name: str) -> bool {
    var i: usize = 0 as usize;
    let c: usize = props_in.count();
    while i < c {
        match props_in.at_ptr(i) {
            option::Option[*insp::Prop]::Some(p) => {
                if { (*p).name } == name { return true; }
            }
            option::Option[*insp::Prop]::None => { }
        }
        i = i +% (1 as usize);
    }
    return false;
}

fn prop_overridden(props_in: vec::Vec[insp::Prop], name: str) -> bool {
    var i: usize = 0 as usize;
    let c: usize = props_in.count();
    while i < c {
        match props_in.at_ptr(i) {
            option::Option[*insp::Prop]::Some(p) => {
                if { (*p).name } == name { return { (*p).overridden }; }
            }
            option::Option[*insp::Prop]::None => { }
        }
        i = i +% (1 as usize);
    }
    return false;
}

fn fresh() {
    app::reset_default_for_tests();
    tree::forget_all_overrides();
    tree::clear_self();
    return;
}

// ==============================================================================
// unit
// ==============================================================================

#[test]
fn a_fresh_handle_is_live_and_a_null_one_is_not() {
    var n: core::Node = core::node_with("probe", 0u32, 0 as *u8, core::no_release);
    let h: insp::Handle = insp::Handle::of(#addr_of(n), 0 as usize);
    assert h.is_live();
    assert !h.is_none();
    let z: insp::Handle = insp::Handle::none();
    assert z.is_none();
    assert !z.is_live();
    return;
}

#[test]
fn value_tags_name_themselves() {
    assert insp::Value::Bool(true).type_name() == "bool";
    assert insp::Value::Int(1 as i64).type_name() == "int";
    assert insp::Value::Num(1.0f64).type_name() == "number";
    assert insp::Value::Str(text::from_str("x")).type_name() == "text";
    assert insp::Value::Color(vocab::Color::none()).type_name() == "color";
    assert insp::Value::Enum(text::from_str("auto")).type_name() == "enum";
    assert insp::Value::Nothing.type_name() == "nothing";
    assert insp::Value::Nothing.is_nothing();
    assert !insp::Value::Bool(false).is_nothing();
    return;
}

// The ledger hands back a duplicate, not a view: the record it copied from is
// destroyed in the same breath.
#[test]
fn cloning_a_text_value_survives_the_original() {
    var copied: insp::Value = insp::Value::Nothing;
    {
        let original: insp::Value = insp::Value::Str(text::from_str("declared"));
        copied = original.clone();
    }
    assert match copied {
        insp::Value::Str(s) => s.view() == "declared",
        _ => false,
    };
    return;
}

// Every constant the generator owns has a name here. When `gen_contract.py`
// adds a control this fails, which is the point: a tree row reading "node"
// where a date picker is would otherwise pass in silence.
#[test]
fn kind_names_cover_every_generated_control() {
    assert insp::kind_name(props::K_SPINNER) == "spinner";
    assert insp::kind_name(props::K_BORDERED) == "bordered";
    assert insp::kind_name(props::K_BOX) == "box";
    assert insp::kind_name(props::K_BUTTON) == "button";
    assert insp::kind_name(props::K_CAROUSEL) == "carousel";
    assert insp::kind_name(props::K_CHECKBOX) == "checkbox";
    assert insp::kind_name(props::K_COLLECTION) == "collection";
    assert insp::kind_name(props::K_DATE_PICKER) == "date_picker";
    assert insp::kind_name(props::K_TEXT_AREA) == "text_area";
    assert insp::kind_name(props::K_TEXT_FIELD) == "text_field";
    assert insp::kind_name(props::K_CANVAS) == "canvas";
    assert insp::kind_name(props::K_HYBRID_WEB) == "hybrid_web";
    assert insp::kind_name(props::K_IMAGE) == "image";
    assert insp::kind_name(props::K_ICON_BUTTON) == "icon_button";
    assert insp::kind_name(props::K_PAGE_DOTS) == "page_dots";
    assert insp::kind_name(props::K_LABEL) == "label";
    assert insp::kind_name(props::K_LIST) == "list";
    assert insp::kind_name(props::K_MENU) == "menu";
    assert insp::kind_name(props::K_CONTEXT_MENU) == "context_menu";
    assert insp::kind_name(props::K_CONTEXT_MENU_ITEM) == "context_menu_item";
    assert insp::kind_name(props::K_MENU_ITEM) == "menu_item";
    assert insp::kind_name(props::K_POPUP) == "popup";
    assert insp::kind_name(props::K_PROGRESS) == "progress";
    assert insp::kind_name(props::K_RADIO) == "radio";
    assert insp::kind_name(props::K_REFRESHABLE) == "refreshable";
    assert insp::kind_name(props::K_SCROLL) == "scroll";
    assert insp::kind_name(props::K_SEARCH_FIELD) == "search_field";
    assert insp::kind_name(props::K_SLIDER) == "slider";
    assert insp::kind_name(props::K_SPAN) == "span";
    assert insp::kind_name(props::K_STEPPER) == "stepper";
    assert insp::kind_name(props::K_SWIPE_ITEM) == "swipe_item";
    assert insp::kind_name(props::K_SWIPEABLE) == "swipeable";
    assert insp::kind_name(props::K_TOGGLE) == "toggle";
    assert insp::kind_name(props::K_TABS) == "tabs";
    assert insp::kind_name(props::K_TABLE) == "table";
    assert insp::kind_name(props::K_TIME_PICKER) == "time_picker";
    assert insp::kind_name(props::K_TOOLBAR_ITEM) == "toolbar_item";
    assert insp::kind_name(props::K_WEB) == "web";
    assert insp::kind_name(0u32) == "node";
    return;
}

#[test]
fn outcomes_describe_themselves_and_only_ok_is_ok() {
    assert insp::Outcome::Ok.is_ok();
    assert !insp::Outcome::Stale.is_ok();
    assert !insp::Outcome::TypeMismatch.is_ok();
    assert insp::Outcome::Stale.describe() == "stale: the tree changed, re-describe";
    return;
}

#[test]
fn the_none_backend_refuses_every_write_and_answers_nothing() {
    let b: insp::Backend = insp::Backend::none();
    let rows: vec::Vec[insp::Node] = b.describe_now();
    assert rows.count() == (0 as usize);
    let h: insp::Handle = insp::Handle::none();
    assert b.set_now(h, "opacity", insp::Value::Num(0.5f64)) == insp::Outcome::Unsupported;
    assert b.reset_now(h, "opacity") == insp::Outcome::Unsupported;
    return;
}

// ==============================================================================
// end to end, over a mounted tree
// ==============================================================================

#[test]
fn describe_lists_the_whole_tree_in_document_order_with_parents_and_depth() {
    fresh();
    var bar: core::Builder = core::Builder::new();
    bar.add(ui::button("Save", key: "save"));
    bar.add(ui::button("Cancel", key: "cancel"));
    var body: core::Builder = core::Builder::new();
    body.add(ui::row(bar, key: "toolbar"));
    body.add(ui::label("Ready", key: "status"));
    var root: core::Node = ui::column(body, key: "root");
    app::open_window(#addr_of(root));

    let rows: vec::Vec[insp::Node] = tree::describe();
    assert rows.count() == (5 as usize);
    assert depth_of(rows, "root") == (0 as usize);
    assert depth_of(rows, "toolbar") == (1 as usize);
    assert depth_of(rows, "save") == (2 as usize);
    assert depth_of(rows, "status") == (1 as usize);

    // A root's parent is nothing; a child's is the row above it that owns it.
    assert match row_index(rows, "root") {
        option::Option[usize]::Some(i) => match rows.at_ptr(i) {
            option::Option[*insp::Node]::Some(p) => match { (*p).parent } {
                option::Option[usize]::Some(_x) => false,
                option::Option[usize]::None => true,
            },
            option::Option[*insp::Node]::None => false,
        },
        option::Option[usize]::None => false,
    };
    let i_bar: usize = match row_index(rows, "toolbar") {
        option::Option[usize]::Some(i) => i,
        option::Option[usize]::None => 999 as usize,
    };
    assert match row_index(rows, "save") {
        option::Option[usize]::Some(i) => match rows.at_ptr(i) {
            option::Option[*insp::Node]::Some(p) => match { (*p).parent } {
                option::Option[usize]::Some(x) => x == i_bar,
                option::Option[usize]::None => false,
            },
            option::Option[*insp::Node]::None => false,
        },
        option::Option[usize]::None => false,
    };

    // Document order: the toolbar and its children precede the status label.
    let i_toolbar: usize = match row_index(rows, "toolbar") {
        option::Option[usize]::Some(i) => i,
        option::Option[usize]::None => 999 as usize,
    };
    let i_status: usize = match row_index(rows, "status") {
        option::Option[usize]::Some(i) => i,
        option::Option[usize]::None => 0 as usize,
    };
    assert i_toolbar < i_status;
    return;
}

// The unkeyed pure-layout node the native walk cannot see. This is the whole
// reason the inspector walks facet rather than NSView.
#[test]
fn describe_includes_unkeyed_nodes_that_a_native_walk_would_miss() {
    fresh();
    var leaf: core::Builder = core::Builder::new();
    leaf.add(ui::label("buried", key: "buried"));
    var mid: core::Builder = core::Builder::new();
    // No key: an unkeyed pure-layout container costs no native view, so it
    // carries no accessibility identifier and a walk of NSView cannot see it.
    mid.add(ui::column(leaf));
    var root: core::Node = ui::column(mid, key: "root");
    app::open_window(#addr_of(root));

    let rows: vec::Vec[insp::Node] = tree::describe();
    assert rows.count() == (3 as usize);
    assert depth_of(rows, "buried") == (2 as usize);
    // The invisible middle node is present, addressable, and has no view.
    let mid_h: insp::Handle = unkeyed_of_kind(rows, 0u32);
    assert !mid_h.is_none();
    assert tree::set(mid_h, "padding", insp::Value::Num(8.0f64)) == insp::Outcome::Ok;
    return;
}

// The `@ui` DSL hands back a wrapper node that carries no facet `Data` at all.
// The walk has to survive one: `key()`, `kind_of` and the band readers all go
// through a null data pointer.
#[test]
fn the_walk_survives_the_dataless_wrapper_the_dsl_hands_back() {
    fresh();
    var root: core::Node = @ui {
        column(key: "root") {
            label("Ready", key: "status")
        }
    };
    app::open_window(#addr_of(root));

    let rows: vec::Vec[insp::Node] = tree::describe();
    // wrapper, column, label.
    assert rows.count() == (3 as usize);
    let wrapper: insp::Handle = match rows.at_ptr(0 as usize) {
        option::Option[*insp::Node]::Some(p) => { (*p).handle }
        option::Option[*insp::Node]::None => insp::Handle::none(),
    };
    assert !wrapper.is_none();
    // It has no key and no kind, and reads as a plain node rather than
    // crashing the walk.
    assert match rows.at_ptr(0 as usize) {
        option::Option[*insp::Node]::Some(p) => ({ (*p).key.view() } == ""),
        option::Option[*insp::Node]::None => false,
    };
    // Keys inside it still resolve, and the depth accounts for the wrapper.
    assert depth_of(rows, "root") == (1 as usize);
    assert depth_of(rows, "status") == (2 as usize);
    assert !row_for(rows, "status").is_none();
    return;
}

#[test]
fn describe_spans_every_open_window() {
    fresh();
    var ba: core::Builder = core::Builder::new();
    ba.add(ui::label("A", key: "a"));
    var a: core::Node = ui::column(ba, key: "win_a");
    var bb: core::Builder = core::Builder::new();
    bb.add(ui::label("B", key: "b"));
    var b: core::Node = ui::column(bb, key: "win_b");
    app::open_window(#addr_of(a));
    app::open_window(#addr_of(b));

    let rows: vec::Vec[insp::Node] = tree::describe();
    assert rows.count() == (4 as usize);
    assert !row_for(rows, "a").is_none();
    assert !row_for(rows, "b").is_none();
    // Each row remembers which window it came from, so a keyed re-resolve is
    // scoped to the right tree. Two windows sharing a key is legal.
    assert row_for(rows, "a").window == (0 as usize);
    assert row_for(rows, "b").window == (1 as usize);
    return;
}

// The same key in two windows is legal and each write must land in its own.
#[test]
fn the_same_key_in_two_windows_writes_to_the_right_one() {
    fresh();
    var ba: core::Builder = core::Builder::new();
    ba.add(ui::label("from a", key: "shared"));
    var a: core::Node = ui::column(ba, key: "win_a");
    var bb: core::Builder = core::Builder::new();
    bb.add(ui::label("from b", key: "shared"));
    var b: core::Node = ui::column(bb, key: "win_b");
    app::open_window(#addr_of(a));
    app::open_window(#addr_of(b));

    let rows: vec::Vec[insp::Node] = tree::describe();
    let in_a: insp::Handle = nth_for(rows, "shared", 0 as usize);
    let in_b: insp::Handle = nth_for(rows, "shared", 1 as usize);
    assert in_a.window == (0 as usize);
    assert in_b.window == (1 as usize);

    assert tree::set(in_b, "text", insp::Value::Str(text::from_str("edited b")))
        == insp::Outcome::Ok;
    assert text_eq(in_b, "text", "edited b");
    // The other window's node of the same name was not touched.
    assert text_eq(in_a, "text", "from a");
    return;
}

#[test]
fn the_inspectors_own_subtree_is_marked_and_the_rest_is_not() {
    fresh();
    var root: core::Node = @ui {
        column(key: "root") {
            label("app content", key: "content")
            column(key: "panel") {
                label("inspector row", key: "panel_row")
            }
        }
    };
    app::open_window(#addr_of(root));
    match core::find_in(#addr_of(root), "panel") {
        option::Option[*core::Node]::Some(p) => { tree::mark_self(p); }
        option::Option[*core::Node]::None => { assert false; }
    }

    let rows: vec::Vec[insp::Node] = tree::describe();
    var saw_app: bool = false;
    var saw_panel_row: bool = false;
    var i: usize = 0 as usize;
    let c: usize = rows.count();
    while i < c {
        match rows.at_ptr(i) {
            option::Option[*insp::Node]::Some(p) => {
                if { (*p).key.view() } == "content" {
                    saw_app = true;
                    assert !{ (*p).is_inspector };
                }
                if { (*p).key.view() } == "panel_row" {
                    saw_panel_row = true;
                    // Marked through its ancestor, not by naming it.
                    assert { (*p).is_inspector };
                }
            }
            option::Option[*insp::Node]::None => { }
        }
        i = i +% (1 as usize);
    }
    assert saw_app;
    assert saw_panel_row;
    return;
}

// Tier 1: the common band, on a node with no control props at all.
#[test]
fn common_band_properties_round_trip_on_a_bare_container() {
    fresh();
    var root: core::Node = @ui { column(key: "root") { label("x", key: "x") } };
    app::open_window(#addr_of(root));
    let h: insp::Handle = row_for(tree::describe(), "root");
    assert !h.is_none();

    assert tree::set(h, "opacity", insp::Value::Num(0.65f64)) == insp::Outcome::Ok;
    assert get_num(h, "opacity") == 0.65f64;

    assert tree::set(h, "visible", insp::Value::Bool(false)) == insp::Outcome::Ok;
    assert !get_bool(h, "visible");

    assert tree::set(h, "enabled", insp::Value::Bool(false)) == insp::Outcome::Ok;
    assert !get_bool(h, "enabled");

    assert tree::set(h, "corner_radius", insp::Value::Num(8.0f64)) == insp::Outcome::Ok;
    assert get_num(h, "corner_radius") == 8.0f64;

    assert tree::set(h, "tooltip", insp::Value::Str(text::from_str("hi"))) == insp::Outcome::Ok;
    assert text_eq(h, "tooltip", "hi");

    assert tree::set(h, "background_color",
                     insp::Value::Color(vocab::Color::system_blue())) == insp::Outcome::Ok;
    return;
}

// Tier 2: flex style, also with no kind dispatch.
#[test]
fn layout_properties_round_trip_and_raise_only_the_layout_bit() {
    fresh();
    var root: core::Node = @ui { column(key: "root") { label("x", key: "x") } };
    app::open_window(#addr_of(root));
    let h: insp::Handle = row_for(tree::describe(), "root");
    let n: *core::Node = h.node;

    core::clear_dirty(n);
    assert tree::set(h, "width", insp::Value::Num(320.0f64)) == insp::Outcome::Ok;
    assert get_num(h, "width") == 320.0f64;
    assert ({ core::dirty_of(n) } & props::C_LAYOUT) != (0 as u64);

    assert tree::set(h, "padding", insp::Value::Num(12.0f64)) == insp::Outcome::Ok;
    assert get_num(h, "padding") == 12.0f64;

    assert tree::set(h, "grow", insp::Value::Num(1.0f64)) == insp::Outcome::Ok;
    assert get_num(h, "grow") == 1.0f64;

    assert tree::set(h, "gap", insp::Value::Num(6.0f64)) == insp::Outcome::Ok;
    assert get_num(h, "gap") == 6.0f64;
    return;
}

// An integer for a length is a kindness, not a type error.
#[test]
fn an_int_is_accepted_where_a_number_is_wanted() {
    fresh();
    var root: core::Node = @ui { column(key: "root") { label("x", key: "x") } };
    app::open_window(#addr_of(root));
    let h: insp::Handle = row_for(tree::describe(), "root");
    assert tree::set(h, "padding", insp::Value::Int(10 as i64)) == insp::Outcome::Ok;
    assert get_num(h, "padding") == 10.0f64;
    return;
}

// A padding box shows a number only when all four edges agree. Otherwise it
// is empty, so nobody sets four edges to the one that happened to be left.
#[test]
fn a_mixed_padding_reads_as_nothing_rather_than_as_one_edge() {
    fresh();
    var root: core::Node = @ui { column(key: "root") { label("x", key: "x") } };
    app::open_window(#addr_of(root));
    let h: insp::Handle = row_for(tree::describe(), "root");

    assert tree::set(h, "padding", insp::Value::Num(4.0f64)) == insp::Outcome::Ok;
    assert get_num(h, "padding") == 4.0f64;
    assert tree::set(h, "padding_left", insp::Value::Num(20.0f64)) == insp::Outcome::Ok;

    assert match tree::get(h, "padding") {
        option::Option[insp::Value]::Some(v) => v.is_nothing(),
        option::Option[insp::Value]::None => false,
    };
    assert get_num(h, "padding_left") == 20.0f64;
    assert get_num(h, "padding_top") == 4.0f64;
    return;
}

// Tier 3, on a keyed node.
#[test]
fn control_text_and_title_round_trip_on_keyed_nodes() {
    fresh();
    var root: core::Node = @ui {
        column(key: "root") {
            label("Ready", key: "status")
            button("Save", key: "save")
        }
    };
    app::open_window(#addr_of(root));
    let rows: vec::Vec[insp::Node] = tree::describe();

    let l: insp::Handle = row_for(rows, "status");
    assert text_eq(l, "text", "Ready");
    assert tree::set(l, "text", insp::Value::Str(text::from_str("Busy"))) == insp::Outcome::Ok;
    assert text_eq(l, "text", "Busy");
    // And the application's own typed read agrees — the inspector went through
    // the same setter, not around it.
    match label::find("status", within: #addr_of(root)) {
        option::Option[label::Label]::Some(hit) => { assert hit.text() == "Busy"; }
        option::Option[label::Label]::None => { assert false; }
    }

    let b: insp::Handle = row_for(rows, "save");
    assert text_eq(b, "title", "Save");
    assert tree::set(b, "title", insp::Value::Str(text::from_str("Store"))) == insp::Outcome::Ok;
    match button::find("save", within: #addr_of(root)) {
        option::Option[button::Button]::Some(hit) => { assert hit.title() == "Store"; }
        option::Option[button::Button]::None => { assert false; }
    }
    return;
}

#[test]
fn inspect_separates_declared_from_computed() {
    fresh();
    var root: core::Node = @ui { column(key: "root") { label("hi", key: "hi") } };
    app::open_window(#addr_of(root));
    let h: insp::Handle = row_for(tree::describe(), "hi");

    match tree::inspect(h) {
        option::Option[insp::Detail]::Some(d) => {
            // Declared carries what the application asked for, and is writable.
            assert prop_named(d.declared, "text");
            assert prop_named(d.declared, "opacity");
            assert prop_named(d.declared, "padding");
            // A label has no title, so no editor is offered for one.
            assert !prop_named(d.declared, "title");
            // Computed carries what layout decided, and never appears in declared.
            assert prop_named(d.computed, "frame_width");
            assert prop_named(d.computed, "attached");
            assert prop_named(d.computed, "kind");
            assert !prop_named(d.declared, "frame_width");
            // No platform module is installed in a headless suite.
            assert d.native.count() == (0 as usize);
        }
        option::Option[insp::Detail]::None => { assert false; }
    }
    return;
}

// Reset restores what the APPLICATION declared, not the type's default. An app
// that shipped 0.8 and an inspector that resets to 1.0 has started a second
// experiment rather than ending the first.
#[test]
fn reset_restores_the_declared_value_and_not_the_type_default() {
    fresh();
    var root: core::Node = @ui { column(key: "root") { label("x", key: "x") } };
    app::open_window(#addr_of(root));
    let h: insp::Handle = row_for(tree::describe(), "root");

    // What the application declared.
    core::set_opacity(h.node, 0.8f64);
    assert get_num(h, "opacity") == 0.8f64;

    assert tree::set(h, "opacity", insp::Value::Num(0.2f64)) == insp::Outcome::Ok;
    assert get_num(h, "opacity") == 0.2f64;
    assert tree::override_count() == (1 as usize);

    assert tree::reset(h, "opacity") == insp::Outcome::Ok;
    assert get_num(h, "opacity") == 0.8f64;
    assert tree::override_count() == (0 as usize);
    return;
}

// A second edit must not record the inspector's own first edit as "what the
// application declared".
#[test]
fn a_second_write_does_not_overwrite_the_recorded_original() {
    fresh();
    var root: core::Node = @ui { column(key: "root") { label("x", key: "x") } };
    app::open_window(#addr_of(root));
    let h: insp::Handle = row_for(tree::describe(), "root");

    core::set_opacity(h.node, 0.9f64);
    let _a: insp::Outcome = tree::set(h, "opacity", insp::Value::Num(0.5f64));
    let _b: insp::Outcome = tree::set(h, "opacity", insp::Value::Num(0.1f64));
    assert tree::override_count() == (1 as usize);
    assert tree::reset(h, "opacity") == insp::Outcome::Ok;
    assert get_num(h, "opacity") == 0.9f64;
    return;
}

#[test]
fn reset_restores_a_text_value_it_recorded() {
    fresh();
    var root: core::Node = @ui { column(key: "root") { label("Declared", key: "l") } };
    app::open_window(#addr_of(root));
    let h: insp::Handle = row_for(tree::describe(), "l");

    assert tree::set(h, "text", insp::Value::Str(text::from_str("Edited"))) == insp::Outcome::Ok;
    assert text_eq(h, "text", "Edited");
    assert tree::reset(h, "text") == insp::Outcome::Ok;
    assert text_eq(h, "text", "Declared");
    return;
}

#[test]
fn resetting_a_property_that_was_never_overridden_changes_nothing() {
    fresh();
    var root: core::Node = @ui { column(key: "root") { label("x", key: "x") } };
    app::open_window(#addr_of(root));
    let h: insp::Handle = row_for(tree::describe(), "root");
    core::set_opacity(h.node, 0.7f64);
    assert tree::reset(h, "opacity") == insp::Outcome::Ok;
    assert get_num(h, "opacity") == 0.7f64;
    return;
}

#[test]
fn inspect_marks_the_properties_an_override_is_currently_holding() {
    fresh();
    var root: core::Node = @ui { column(key: "root") { label("x", key: "x") } };
    app::open_window(#addr_of(root));
    let h: insp::Handle = row_for(tree::describe(), "root");

    let _a: insp::Outcome = tree::set(h, "opacity", insp::Value::Num(0.3f64));
    match tree::inspect(h) {
        option::Option[insp::Detail]::Some(d) => {
            assert prop_overridden(d.declared, "opacity");
            assert !prop_overridden(d.declared, "padding");
        }
        option::Option[insp::Detail]::None => { assert false; }
    }
