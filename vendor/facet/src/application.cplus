// facet application — who owns what. HAND-WRITTEN.
//
// The names are the ledger's, copied deliberately (Application.Current, Windows,
// OpenWindow/CloseWindow — ledger rows Application 13 + Window 30): this is
// a RECORD of ownership, not a reactive store. Nothing here re-renders;
// state lives in component fields and the tree is edited in place.
//
// The ownership hierarchy, and the rule that guards it:
//
//   process   one exe. May CONTAIN several apps (a main app and a recovery
//             mini-app in the same binary); exactly one RUNS at a time.
//             Statics are legal ONLY here, and only for what every app and
//             window genuinely shares: the backend, the platform hook slots,
//             the UI thread, and the one RUNNING pointer below.
//   app       owns its theme, its navigation state, its routes and menu,
//             and its WINDOWS. Nothing app-scoped may be a module static —
//             a second app in the exe must start clean.
//   window    many per app, all visible at once (two editor windows side by
//             side). A window owns its tree root.
//   node      owns node-scoped state in its Data — including its
//             presentation, which dies with it.
//
// `Application` is the app-scoped record. `runtime::App` embeds one; running
// the app points the process door at it, quitting clears the door. Facet
// also works with NO app (bare mounts, run_component, the headless suite):
// those run against the process-default state below — which is exactly the
// "one implicit app" the old statics hard-coded, now visible and swappable.

import "stdlib/text" as text;
import "stdlib/vec" as vec;
import "stdlib/string_map" as smap;
import "stdlib/option" as option;
import "stdlib/io" as io;
import "flex_layout/flex_layout" as flex;
import "./vocabulary" as vocab;

type Color = vocab::Color;

// ---- Theme (the struct lives here so the app record can embed it) ------------
// The API — set_theme, theme(), the resolution tables — stays in theme.cplus,
// which aliases this type. Declared low because Application owns one per app and
// theme.cplus must read the RUNNING app's; the import arrow only points down.
struct Theme {
    primary: Color,
    on_primary: Color,
    secondary: Color,
    on_secondary: Color,
    ink: Color,
    surface: Color,
    raised: Color,
    sunken: Color,
    outline: Color,
    success: Color,
    warning: Color,
    danger: Color,
    content: Color,
    toolbar: Color,
    tabstrip: Color,
    track: Color,
    chip: Color,
    recessed: Color,
}

impl Theme {
    fn new(
        primary: Color = Color::none(),
        on_primary: Color = Color::none(),
        secondary: Color = Color::none(),
        on_secondary: Color = Color::none(),
        ink: Color = Color::none(),
        surface: Color = Color::none(),
        raised: Color = Color::none(),
        sunken: Color = Color::none(),
        outline: Color = Color::none(),
        success: Color = Color::none(),
        warning: Color = Color::none(),
        danger: Color = Color::none(),
        content: Color = Color::none(),
        toolbar: Color = Color::none(),
        tabstrip: Color = Color::none(),
        track: Color = Color::none(),
        chip: Color = Color::none(),
        recessed: Color = Color::none(),
    ) -> Theme {
        return Theme {
            primary: primary,
            on_primary: on_primary,
            secondary: secondary,
            on_secondary: on_secondary,
            ink: ink,
            surface: surface,
            raised: raised,
            sunken: sunken,
            outline: outline,
            success: success,
            warning: warning,
            danger: danger,
            content: content,
            toolbar: toolbar,
            tabstrip: tabstrip,
            track: track,
            chip: chip,
            recessed: recessed,
        };
    }
}

// ---- the agent's window hook -------------------------------------------------
// "A window went in front of the user" is app state, so the hook lives here
// rather than in runtime: `dialogs` builds a sheet and must say so, and it
// cannot import runtime without a cycle (runtime_macos imports dialogs).
// `runtime::install_agent` fills this in; nothing else touches it, so
// importing facet/application still never drags the agent packages in.
static AGENT_ATTACH_FN: fn(*u8) = #zero::[fn(*u8)]();

fn set_agent_attach_fn(f: fn(*u8)) { AGENT_ATTACH_FN = f; return; }

// The agent SENSITIVITY pin: `paint` calls this for every node carrying a
// non-default `agent` prop, and it is inert in an app that never served — so
// the prop costs a stored enum and one null check, and the agent packages stay
// out of the build. Same shape as the attach hook above, for the same reason.
//
// Typed on FACET'S OWN vocabulary, not agent_core's. The alternative was a
// bare u32 for the tier, which would have put the enum-to-policy mapping in
// facet_appkit as well as facet/agent — two copies of a table whose whole job
// is deciding what a card field is worth. One translation, in the one module
// that already depends on both sides.
static AGENT_PIN_FN: fn(*u8, vocab::Agent) = #zero::[fn(*u8, vocab::Agent)]();

fn set_agent_pin_fn(f: fn(*u8, vocab::Agent)) { AGENT_PIN_FN = f; return; }

// Pin a node's declared tier onto its platform view. Inert when no agent is
// serving, which is every app that never called `agent::enable()`.
fn agent_pin(view: *u8, a: vocab::Agent) {
    let f: fn(*u8, vocab::Agent) = AGENT_PIN_FN;
    if f.is_not_null() { f(view, a); }
}

static ACTIVATE_FN: fn(*u8) = #zero::[fn(*u8)]();
fn set_activate_fn(f: fn(*u8)) { ACTIVATE_FN = f; return; }

// Point the agent surface at `win`. Inert when no agent is serving, which is
// every app that never called `agent::enable()`.
fn agent_attach(win: *u8) {
    let f: fn(*u8) = AGENT_ATTACH_FN;
    if f.is_not_null() { f(win); }
}

// ---- the agent install seam ---------------------------------------------------
// ONE install struct, ONE home (2026-08-17). This lived in the runtime
// facades — every platform variant carried its own AgentHooks + static, and
// a hook mirrored in one file but not another was a real bug (a sheet
// presented, called `agent_attach`, and found a null hook). The facades are
// now pure boot code in the facet_runtime package; the seam they used to
// carry lives here, beside the slots it always filled.
struct AgentHooks {
    attach_window: fn(*u8),
    serve_once: fn(str),
    // Pin a node's declared `agent` tier onto its platform view at mount.
    pin_policy: fn(*u8, vocab::Agent),
}

static AGENT_SERVE_FN: fn(str) = #zero::[fn(str)]();

// `agent::enable()` calls this once, before `app.run`; `agent::disable()`
// calls it with null hooks. Fans the struct out into the slots above so
// every reader (dialogs' sheets, paint's pin, the facades' boot) sees one
// truth.
fn install_agent(take h: AgentHooks) {
    AGENT_ATTACH_FN = h.attach_window;
    AGENT_PIN_FN = h.pin_policy;
    AGENT_SERVE_FN = h.serve_once;
}

// Serve one agent connection on `path`. The runtime facades call this when
// the app was launched with an agent socket; loud when the app never
// enabled the agent module, because a set path with no server is operator
// error, not a quiet no-op.
fn agent_serve_once(path: str) {
    let f: fn(str) = AGENT_SERVE_FN;
    if f.is_null() {
        io::println("facet: agent_mcp path set but the agent module is not enabled — import \"facet/agent\" and call agent::enable() before app.run");
        return;
    }
    f(path);
}

// ---- navigation state (owned by the app) -------------------------------------
// One pending intent at a time; the hooks are registered by the running
// App's loop. See nav.cplus for the verbs and semantics.
struct Navigation {
    intent: u32,
    target: text::Text,
    // The route argument channel, as NAMED values. One storage: `arg:` is the
    // unnamed one, kept under `nav::arg_key()`, so `arg()` and `param(k)` read
    // the same map and cannot disagree.
    params: smap::StringMap[text::Text],
    close_fn: fn(),
    push_fn: fn(str, str) -> bool,
    pop_fn: fn() -> bool,
}

impl Navigation {
    fn new() -> Navigation {
        return Navigation {
            intent: 0 as u32,
            target: text::new(),
            params: smap::new::[text::Text](),
            close_fn: 0 as fn(),
            push_fn: 0 as fn(str, str) -> bool,
            pop_fn: 0 as fn() -> bool,
        };
    }
}

// ---- a window (owned by the app, many at once) -------------------------------
// The neutral half: the tree it shows. The native half (the platform window
// handle) is the backend's, attached when it exists.
struct Window {
    opaque root: *flex::Node,
    opaque native: *u8,
}

// ---- the app-scoped record ---------------------------------------------------
struct Application {
    // Back-pointer to whatever embeds this record (runtime::App). 0 when
    // nothing does (the process default). Exists so the process has ONE
    // door: everything app-scoped — record fields AND the embedding App's
    // routes/menu — is reached through `current()`.
    opaque host: *u8,
    theme: Theme,
    appearance_cb: fn(*u8),
    opaque appearance_ctx: *u8,
    nav: Navigation,
    windows: vec::Vec[Window],
}

impl Application {
    fn new() -> Application {
        return Application {
            host: 0 as *u8,
            theme: Theme::new(),
            appearance_cb: 0 as fn(*u8),
            appearance_ctx: 0 as *u8,
            nav: Navigation::new(),
            windows: vec::new::[Window](),
        };
    }
}

// ---- the process door --------------------------------------------------------
// The ONE legitimately-shared pointer: which app is running. 0 = none, and
// every reader falls back to the process-default state so app-less facet
// (tests, bare mounts) keeps working.
static RUNNING: *Application = #zero::[*Application]();
static DEFAULT: Application = #zero::[Application]();

// The current app's state — the running app's, or the process default.
// Free verbs (`theme()`, `nav::go`, `find`) resolve through this, which is
// what lets them stay context-free at the call site.
// Application.Current, exactly: the running app, or the process default
// (the app-less posture tests and bare mounts run in).
fn current() -> *Application {
    if RUNNING.is_not_null() { return RUNNING; }
    return #addr_of(DEFAULT);
}

// `App::run` points the door here; quitting calls release. Not app-facing.
fn make_current(s: *Application) { RUNNING = s; return; }
fn release_current() { RUNNING = 0 as *Application; return; }
fn has_current() -> bool { return RUNNING.is_not_null(); }

// Tests: a fresh default state, so one test's app state cannot leak into
// the next. Only meaningful when nothing is running.
fn reset_default_for_tests() {
    DEFAULT = Application::new();
}

// ---- windows ----------------------------------------------------------------

// Application.OpenWindow.
fn open_window(root: *flex::Node) {
    let s: *Application = current();
    { (*s).windows.append(Window { root: root, native: 0 as *u8 }) };
}

// Application.CloseWindow.
fn close_window(root: *flex::Node) {
    let s: *Application = current();
    var i: usize = 0 as usize;
    let n: usize = { (*s).windows.count() };
    while i < n {
        let hit: bool = match { (*s).windows.at_ptr(i) } {
            option::Option[*Window]::Some(w) => ({ (*w).root } == root),
            option::Option[*Window]::None => false,
        };
        if hit {
            let _r: option::Option[Window] = { (*s).windows.swap_remove(i) };
            return;
        }
        i = i +% (1 as usize);
    }
}

// Bring a window to the front and give it the keyboard. Opening and closing
// were the only two things facet could say about a window's life, so a
// second window could be created and then never reached again — an app that
// opened an inspector twice got a new one each time rather than the one
// already on screen.
// Through a fn-pointer seam for the same reason `agent_attach` uses one: this
// half of facet is portable and knows no AppKit. The backend fills it in.
fn activate_window(root: *flex::Node) {
    let f: fn(*u8) = ACTIVATE_FN;
    if f.is_null() { return; }
    let w: *u8 = window_native(root);
    if w.is_not_null() { f(w); }
}

// The platform window behind `root`, and the backend's door to record it.
// `Window.native` was declared for exactly this and had no accessor, so a
// backend that opened an NSWindow had nowhere to put it.
//
// PER WINDOW, keyed by root — not a `CURRENT_WIN` static like the pre-regen
// facade kept. An app has many windows open at once, so a single process-wide
// "the current window" is both wrong (two editor windows side by side) and
// app-scoped state in a process static, which the statics rule forbids.
// Everything that needs to reach a window from a tree — close, frame read and
// write, the agent surface's attach — goes through these.
fn set_window_native(root: *flex::Node, p: *u8) {
    let s: *Application = current();
    var i: usize = 0 as usize;
    let n: usize = { (*s).windows.count() };
    while i < n {
        match { (*s).windows.at_ptr(i) } {
            option::Option[*Window]::Some(w) => {
                if { (*w).root } == root { { (*w).native = p }; return; }
            }
            option::Option[*Window]::None => { }
        }
        i = i +% (1 as usize);
    }
}

// 0 when the root is not an open window of the running app, or when no
// backend has recorded one — the same neutral answer every other reader gives.
fn window_native(root: *flex::Node) -> *u8 {
    let s: *Application = current();
    var i: usize = 0 as usize;
    let n: usize = { (*s).windows.count() };
    while i < n {
        match { (*s).windows.at_ptr(i) } {
            option::Option[*Window]::Some(w) => {
                if { (*w).root } == root { return { (*w).native }; }
            }
            option::Option[*Window]::None => { }
        }
        i = i +% (1 as usize);
    }
    return 0 as *u8;
}

// The window at `at` by its native handle — the reverse lookup a backend's
// delegate needs: AppKit hands back an NSWindow, and the app must find which
// of its trees that is. 0 for a handle no window carries.
fn window_root_for_native(p: *u8) -> *flex::Node {
    if p.is_null() { return 0 as *flex::Node; }
    let s: *Application = current();
    var i: usize = 0 as usize;
    let n: usize = { (*s).windows.count() };
    while i < n {
        match { (*s).windows.at_ptr(i) } {
            option::Option[*Window]::Some(w) => {
                if { (*w).native } == p { return { (*w).root }; }
            }
            option::Option[*Window]::None => { }
        }
        i = i +% (1 as usize);
    }
    return 0 as *flex::Node;
}

fn window_count() -> usize {
    let s: *Application = current();
    return { (*s).windows.count() };
}

fn window_root(at: usize) -> *flex::Node {
    let s: *Application = current();
    return match { (*s).windows.at_ptr(at) } {
        option::Option[*Window]::Some(w) => { (*w).root },
        option::Option[*Window]::None => 0 as *flex::Node,
    };
}

// The most recently opened window's root — the M7 interim answer, now
// per-app: "the mounted tree" is the newest window of the RUNNING app.
fn newest_window_root() -> *flex::Node {
    let s: *Application = current();
    let n: usize = { (*s).windows.count() };
    if n == (0 as usize) { return 0 as *flex::Node; }
    return window_root(n -% (1 as usize));
}

// ---- tests ------------------------------------------------------------------

#[test]
fn the_native_handle_is_per_window_not_per_process() {
    reset_default_for_tests();
    var a: flex::Node = flex::box();
    var b: flex::Node = flex::box();
    open_window(#addr_of(a));
    open_window(#addr_of(b));
    assert window_count() == (2 as usize);
    // Nothing recorded yet: the neutral answer, never a trap.
    assert window_native(#addr_of(a)) == (0 as *u8);
    // Two windows open at once, each carrying its OWN handle — the reason
    // this is a field and not a CURRENT_WIN static.
    set_window_native(#addr_of(a), 11 as *u8);
    set_window_native(#addr_of(b), 22 as *u8);
    assert window_native(#addr_of(a)) == (11 as *u8);
    assert window_native(#addr_of(b)) == (22 as *u8);
    // The reverse lookup a window delegate needs.
    assert window_root_for_native(22 as *u8) == #addr_of(b);
    assert window_root_for_native(11 as *u8) == #addr_of(a);
    // Re-recording replaces rather than stacks.
    set_window_native(#addr_of(a), 33 as *u8);
    assert window_native(#addr_of(a)) == (33 as *u8);
    assert window_root_for_native(11 as *u8) == (0 as *flex::Node);
    // Closing one leaves the other's handle intact.
    close_window(#addr_of(a));
    assert window_count() == (1 as usize);
    assert window_native(#addr_of(b)) == (22 as *u8);
    assert window_native(#addr_of(a)) == (0 as *u8);
    reset_default_for_tests();
}

#[test]
fn native_window_readers_are_inert_off_the_window_list() {
    reset_default_for_tests();
    var lone: flex::Node = flex::box();
    // A root that is not an open window: reads 0, and the write is dropped
    // rather than inventing an entry.
    assert window_native(#addr_of(lone)) == (0 as *u8);
    set_window_native(#addr_of(lone), 9 as *u8);
    assert window_count() == (0 as usize);
    assert window_native(#addr_of(lone)) == (0 as *u8);
    // A null handle matches nothing, even when a window has recorded none.
    open_window(#addr_of(lone));
    assert window_root_for_native(0 as *u8) == (0 as *flex::Node);
    assert window_root_for_native(404 as *u8) == (0 as *flex::Node);
    close_window(#addr_of(lone));
    reset_default_for_tests();
}
