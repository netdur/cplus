// facet application — who owns what. HAND-WRITTEN.
//
// The names are the ledger's, copied deliberately (Application.Current, Windows,
// OpenWindow/CloseWindow — ledger rows Application 13 + Window 30): this is
// a RECORD of ownership, not a reactive store. Nothing here re-renders;
// state lives in component fields and the tree is edited in place.
//
// The ownership hierarchy, and the rule that guards it:
//
//   process   one exe. May CONTAIN several apps (a main app and a recovery
//             mini-app in the same binary); exactly one RUNS at a time.
//             Statics are legal ONLY here, and only for what every app and
//             window genuinely shares: the backend, the platform hook slots,
//             the UI thread, and the one RUNNING pointer below.
//   app       owns its theme, its navigation state, its routes and menu,
//             and its WINDOWS. Nothing app-scoped may be a module static —
//             a second app in the exe must start clean.
//   window    many per app, all visible at once (two editor windows side by
//             side). A window owns its tree root.
//   node      owns node-scoped state in its Data — including its
//             presentation, which dies with it.
//
// `Application` is the app-scoped record. `runtime::App` embeds one; running
// the app points the process door at it, quitting clears the door. Facet
// also works with NO app (bare mounts, run_component, the headless suite):
// those run against the process-default state below — which is exactly the
// "one implicit app" the old statics hard-coded, now visible and swappable.

import "stdlib/text" as text;
import "stdlib/vec" as vec;
import "stdlib/string_map" as smap;
import "stdlib/option" as option;
import "stdlib/str" as str_;
import "stdlib/status" as status;
import "stdlib/io" as io;
import "stdlib/box" as box;
import "flex_layout/flex_layout" as flex;
import "./vocabulary" as vocab;

type Color = vocab::Color;

// ---- Theme (the struct lives here so the app record can embed it) ------------
// The API — set_theme, theme(), the resolution tables — stays in theme.cplus,
// which aliases this type. Declared low because Application owns one per app and
// theme.cplus must read the RUNNING app's; the import arrow only points down.
struct Theme {
    primary: Color,
    on_primary: Color,
    secondary: Color,
    on_secondary: Color,
    ink: Color,
    surface: Color,
    raised: Color,
    sunken: Color,
    outline: Color,
    success: Color,
    warning: Color,
    danger: Color,
    content: Color,
    toolbar: Color,
    tabstrip: Color,
    track: Color,
    chip: Color,
    recessed: Color,
}

impl Theme {
    fn new(
        primary: Color = Color::none(),
        on_primary: Color = Color::none(),
        secondary: Color = Color::none(),
        on_secondary: Color = Color::none(),
        ink: Color = Color::none(),
        surface: Color = Color::none(),
        raised: Color = Color::none(),
        sunken: Color = Color::none(),
        outline: Color = Color::none(),
        success: Color = Color::none(),
        warning: Color = Color::none(),
        danger: Color = Color::none(),
        content: Color = Color::none(),
        toolbar: Color = Color::none(),
        tabstrip: Color = Color::none(),
        track: Color = Color::none(),
        chip: Color = Color::none(),
        recessed: Color = Color::none(),
    ) -> Theme {
        return Theme {
            primary: primary,
            on_primary: on_primary,
            secondary: secondary,
            on_secondary: on_secondary,
            ink: ink,
            surface: surface,
            raised: raised,
            sunken: sunken,
            outline: outline,
            success: success,
            warning: warning,
            danger: danger,
            content: content,
            toolbar: toolbar,
            tabstrip: tabstrip,
            track: track,
            chip: chip,
            recessed: recessed,
        };
    }
}

// ---- the agent's window hook -------------------------------------------------
// "A window went in front of the user" is app state, so the hook lives here
// rather than in runtime: `dialogs` builds a sheet and must say so, and it
// cannot import runtime without a cycle (runtime_macos imports dialogs).
// `runtime::install_agent` fills this in; nothing else touches it, so
// importing facet/application still never drags the agent packages in.
static AGENT_ATTACH_FN: fn(*u8) = #zero::[fn(*u8)]();

fn set_agent_attach_fn(f: fn(*u8)) { AGENT_ATTACH_FN = f; return; }

// The agent SENSITIVITY pin: `paint` calls this for every node carrying a
// non-default `agent` prop, and it is inert in an app that never served — so
// the prop costs a stored enum and one null check, and the agent packages stay
// out of the build. Same shape as the attach hook above, for the same reason.
//
// Typed on FACET'S OWN vocabulary, not agent_core's. The alternative was a
// bare u32 for the tier, which would have put the enum-to-policy mapping in
// facet_appkit as well as facet/agent — two copies of a table whose whole job
// is deciding what a card field is worth. One translation, in the one module
// that already depends on both sides.
static AGENT_PIN_FN: fn(*u8, vocab::Agent) = #zero::[fn(*u8, vocab::Agent)]();

fn set_agent_pin_fn(f: fn(*u8, vocab::Agent)) { AGENT_PIN_FN = f; return; }

// Pin a node's declared tier onto its platform view. Inert when no agent is
// serving, which is every app that never called `agent::enable()`.
fn agent_pin(view: *u8, a: vocab::Agent) {
    let f: fn(*u8, vocab::Agent) = AGENT_PIN_FN;
    if f.is_not_null() { f(view, a); }
}

static ACTIVATE_FN: fn(*u8) = #zero::[fn(*u8)]();
fn set_activate_fn(f: fn(*u8)) { ACTIVATE_FN = f; return; }

// Point the agent surface at `win`. Inert when no agent is serving, which is
// every app that never called `agent::enable()`.
fn agent_attach(win: *u8) {
    let f: fn(*u8) = AGENT_ATTACH_FN;
    if f.is_not_null() { f(win); }
}

// ---- the agent install seam ---------------------------------------------------
// ONE install struct, ONE home (2026-08-17). This lived in the runtime
// facades — every platform variant carried its own AgentHooks + static, and
// a hook mirrored in one file but not another was a real bug (a sheet
// presented, called `agent_attach`, and found a null hook). The facades are
// now pure boot code in the facet_runtime package; the seam they used to
// carry lives here, beside the slots it always filled.
struct AgentHooks {
    attach_window: fn(*u8),
    serve_once: fn(str),
    // Pin a node's declared `agent` tier onto its platform view at mount.
    pin_policy: fn(*u8, vocab::Agent),
}

static AGENT_SERVE_FN: fn(str) = #zero::[fn(str)]();

// `agent::enable()` calls this once, before `app.run`; `agent::disable()`
// calls it with null hooks. Fans the struct out into the slots above so
// every reader (dialogs' sheets, paint's pin, the facades' boot) sees one
// truth.
fn install_agent(take h: AgentHooks) {
    AGENT_ATTACH_FN = h.attach_window;
    AGENT_PIN_FN = h.pin_policy;
    AGENT_SERVE_FN = h.serve_once;
}

// Serve one agent connection on `path`. The runtime facades call this when
// the app was launched with an agent socket; loud when the app never
// enabled the agent module, because a set path with no server is operator
// error, not a quiet no-op.
fn agent_serve_once(path: str) {
    let f: fn(str) = AGENT_SERVE_FN;
    if f.is_null() {
        io::println("facet: agent_mcp path set but the agent module is not enabled — import \"facet/agent\" and call agent::enable() before app.run");
        return;
    }
    f(path);
}

// ---- navigation state (owned by the app) -------------------------------------
// One pending intent at a time; the hooks are registered by the running
// App's loop. See nav.cplus for the verbs and semantics.
struct Navigation {
    intent: u32,
    target: text::Text,
    // The route argument channel, as NAMED values. One storage: `arg:` is the
    // unnamed one, kept under `nav::arg_key()`, so `arg()` and `param(k)` read
    // the same map and cannot disagree.
    params: smap::StringMap[text::Text],
    // A PUSH's arguments, held until its route resolves. `push` cannot write
    // straight into `params` because a failed push must leave the current
    // screen's arguments untouched — and only the hook knows whether the route
    // resolved. So push stages here and the hook adopts (`nav::adopt_push_args`)
    // once it has a factory in hand. `go` needs none of this: it records intent
    // and the loop resolves afterwards.
    pending: smap::StringMap[text::Text],
    // The route on top of the in-place screen stack, "" when it is empty. Kept
    // in the record rather than derived, because a USER's back gesture pops the
    // stack too and `pop_to` has to read what is actually on top.
    top: text::Text,
    close_fn: fn(),
    // route, key, arg, and the `nav::Show` code. The code is a u32 and not the
    // enum because `Show` belongs to nav.cplus — which imports THIS file — and
    // an enum cannot be re-exported across that arrow (E0341, `type X =` is
    // struct-only). nav converts at the boundary; the facades convert back.
    push_fn: fn(str, str, str, u32) -> bool,
    pop_fn: fn() -> bool,
    // Unwind to a named screen. The STACK'S OWNER answers this, not nav: only
    // it can see what is on the stack, and `pop_to` must move nothing at all
    // when the route is not there. nav popping speculatively to find out would
    // destroy the stack looking.
    pop_to_fn: fn(str) -> bool,
    // How deep the in-place screen stack is. Null answers 0, which is what an
    // app with no stack should read.
    depth_fn: fn() -> usize,
}

impl Navigation {
    fn new() -> Navigation {
        return Navigation {
            intent: 0 as u32,
            target: text::new(),
            params: smap::new::[text::Text](),
            pending: smap::new::[text::Text](),
            top: text::new(),
            close_fn: 0 as fn(),
            push_fn: 0 as fn(str, str, str, u32) -> bool,
            pop_fn: 0 as fn() -> bool,
            pop_to_fn: 0 as fn(str) -> bool,
            depth_fn: 0 as fn() -> usize,
        };
    }
}

// ---- a window (owned by the app, many at once) -------------------------------
// The neutral half: the tree it shows. The native half (the platform window
// handle) is the backend's, attached when it exists.
struct Window {
    // THE NAME AN APPLICATION ADDRESSES THIS WINDOW BY: the route it was pushed
    // with, or `route:arg` when one was given. A pointer is not an address an
    // app can hold — the whole window tier used to be reached through
    // `newest_window_root()` for want of one, which is wrong the moment a sheet
    // or a pushed screen is up (both are real mounts, so both become "newest").
    //
    // Empty for a window nothing named — a bare mount, a `run_component`, a
    // sheet. Those stay reachable through the list and through
    // `primary_window_root`; they are simply not reachable by `find`, which is
    // the honest answer for a window that has no name.
    key: text::Text,
    opaque root: *flex::Node,
    opaque native: *u8,
}

// ---- a route (owned by the app) -----------------------------------------------
// The factory is a *u8 and not `fn() -> screen::ScreenBox` for the reason every
// other cross-tier pointer in this file is: `screen.cplus` imports THIS file
// (the screen cursor reads the stack), so the arrow cannot point back. The
// facade casts on both sides — it is the one place that knows both types.
struct AppRoute {
    name: text::Text,
    opaque factory: *u8,
}

// ---- the in-place screen stack (owned by the app) -----------------------------
// One entry per PUSHED screen; the primary is not in it, so an empty stack
// means "the screen the App loop opened". The verbs are in stack.cplus, the way
// nav.cplus is the verbs over Navigation — this file holds records, not
// behaviour, and a stack is app-scoped so it may not be a module static.
struct StackEntry {
    // The window-style name this screen was pushed under, and the route it came
    // from. Both, because `pop_to` names a ROUTE while `switch_to` needs the
    // node key — and two pushes of one route are two entries.
    key: text::Text,
    route: text::Text,
    // The heap ScreenBox, as *u8 for the same reason `host` is: this file stays
    // free of the screen tier so the import arrow keeps pointing one way.
    opaque sbp: *u8,
    // The wrapper node this screen's tree lives under, inside the stack host.
    opaque root: *flex::Node,
}

// ---- the app-scoped record ---------------------------------------------------
struct Application {
    // Back-pointer to whatever embeds this record (runtime::App). 0 when
    // nothing does (the process default). Exists so the process has ONE
    // door: everything app-scoped — record fields AND the embedding App's
    // routes/menu — is reached through `current()`.
    opaque host: *u8,
    theme: Theme,
    appearance_cb: fn(*u8),
    opaque appearance_ctx: *u8,
    nav: Navigation,
    windows: vec::Vec[Window],
    // The container the primary screen and every pushed screen live under, and
    // the pushed ones themselves. Null host = no stack is possible, which is
    // every entry point that opens a bare tree rather than a screen.
    opaque stack_host: *flex::Node,
    stack: vec::Vec[StackEntry],

    // ---- what `runtime::App` used to hold ------------------------------------
    // These lived in a `struct App` DEFINED FIVE TIMES, once per runtime facade,
    // which had already drifted between them. They are app-scoped state, so
    // this record is where the file's own doctrine says they go — and putting
    // them here is what lets `App` become a handle rather than a struct the
    // caller owns and drops.
    name: text::Text,
    routes: vec::Vec[AppRoute],
    // `fn() -> AppMenu`, cast by the facade — AppMenu is screen.cplus's.
    opaque menu_fn: *u8,
    on_launch_fn: fn(*u8),
    on_quit_fn: fn(*u8),
    on_should_quit_fn: fn(*u8) -> bool,
    opaque hook_ctx: *u8,

    // THE APP'S OWN ENVIRONMENT. Facts about THIS app, living for its life,
    // written by three parties: C+ at compile time, facet at install, and the
    // application. See `env` verbs below.
    //
    // NOT `stdlib::env`, and it must never fall through to it: one is the OS
    // environment and one is the app's. OS env holds secrets, and a store that
    // silently read them would be an agent-visibility problem rather than a
    // convenience.
    envmap: smap::StringMap[text::Text],

    // The PRIMARY screen's heap ScreenBox, where the platform has no frame to
    // keep it in. macOS and GTK hold theirs in the loop's own frame; iOS and
    // Android have no such frame — the loop is the toolkit's — so the box lives
    // here rather than in a module static, which is what the statics rule at the
    // top of this file forbids for app-scoped state.
    opaque primary_sbp: *u8,
}

impl Application {
    fn new() -> Application {
        return Application {
            host: 0 as *u8,
            theme: Theme::new(),
            appearance_cb: 0 as fn(*u8),
            appearance_ctx: 0 as *u8,
            nav: Navigation::new(),
            windows: vec::new::[Window](),
            stack_host: 0 as *flex::Node,
            stack: vec::new::[StackEntry](),
            name: text::new(),
            routes: vec::new::[AppRoute](),
            menu_fn: 0 as *u8,
            on_launch_fn: 0 as fn(*u8),
            on_quit_fn: 0 as fn(*u8),
            on_should_quit_fn: 0 as fn(*u8) -> bool,
            hook_ctx: 0 as *u8,
            envmap: smap::new::[text::Text](),
            primary_sbp: 0 as *u8,
        };
    }
}

// ---- app instances ------------------------------------------------------------
// `runtime::App` is a HANDLE to one of these. The runtime owns the instance;
// the caller owns a name for it.
//
// NEVER FREED, and that is the design rather than an oversight. A process holds
// one or two apps for its whole life, and the alternative is a free that would
// have to outlive every window, screen, hook and worker the app owns — the same
// argument the facades already make for a closed screen, one tier up. An
// allocation failure answers the process default, so an app that cannot be made
// still runs against something rather than trapping.
fn new_instance(name: str) -> *Application {
    var a: Application = Application::new();
    a.name = text::from_str(name);
    let p: *Application = match box::new::[Application](a) {
        option::Option[box::Box[Application]]::Some(b) => { b.into_raw() } as *Application,
        option::Option[box::Box[Application]]::None => #addr_of(DEFAULT),
    };
    // SEEDED AT BIRTH, before the application can write anything: the `@` facts
    // are what C+ knows, and they are true before `run` is ever called.
    seed_env(p);
    return p;
}

fn instance_name(p: *Application) -> str {
    if p.is_null() { return ""; }
    return { (*p).name.view() };
}

// A route already registered is REPLACED rather than shadowed, so a registry
// cannot hold two factories under one name and answer the older one.
fn add_route(p: *Application, name: str, factory: *u8) {
    if p.is_null() { return; }
    var i: usize = 0 as usize;
    let n: usize = { (*p).routes.count() };
    while i < n {
        match { (*p).routes.at_ptr(i) } {
            option::Option[*AppRoute]::Some(r) => {
                if { (*r).name.view() } == name { { (*r).factory = factory }; return; }
            }
            option::Option[*AppRoute]::None => { }
        }
        i = i +% (1 as usize);
    }
    { (*p).routes.append(AppRoute { name: text::from_str(name), factory: factory }) };
}

// 0 for an unknown route — the caller turns that into its own refusal.
fn route_factory(p: *Application, route: str) -> *u8 {
    if p.is_null() { return 0 as *u8; }
    var i: usize = 0 as usize;
    let n: usize = { (*p).routes.count() };
    while i < n {
        match { (*p).routes.at_ptr(i) } {
            option::Option[*AppRoute]::Some(r) => {
                if { (*r).name.view() } == route { return { (*r).factory }; }
            }
            option::Option[*AppRoute]::None => { }
        }
        i = i +% (1 as usize);
    }
    return 0 as *u8;
}

fn route_count(p: *Application) -> usize {
    if p.is_null() { return 0 as usize; }
    return { (*p).routes.count() };
}

fn primary_screen() -> *u8 {
    let s: *Application = current();
    return { (*s).primary_sbp };
}

fn set_primary_screen(p: *u8) {
    let s: *Application = current();
    { (*s).primary_sbp = p };
}

// ---- the app's environment -----------------------------------------------------
// A key-value store living for the app's life. What goes in it is FACTS ABOUT
// THE APP — its platform, its version, its backend, whether it is licensed —
// and not data the UI renders. That line is what keeps it from becoming a
// second state system beside resource.cplus, and it is enforced by an omission:
//
//   THERE IS NO CHANGE CHANNEL. Nothing watches env. If the UI must update when
//   a value changes, the value belongs in a `resource`, which has the whole
//   watch/reconcile tier for exactly that.
//
// `@` MARKS A RESERVED KEY and writes to one are refused. That mark is not
// invented here — `nav::arg_key()` is `"@arg"` for the same reason. It is what
// stops an application telling an agent it is a version it is not, and it makes
// "who set this" answerable without a second field.

fn env_is_reserved(key: str) -> bool {
    if key == "" { return false; }
    return key.has_prefix("@");
}

// "" for a key nothing carries — the neutral answer every other reader in this
// file gives, never a trap.
fn env_in(p: *Application, key: str) -> str {
    // ANSWERED FROM PROCESS SCOPE, not copied into every app's map. One backend
    // is installed per process, so there is one right answer and no app can
    // hold a different one — and no ordering between "the app was made", "the
    // backend installed" and "the app became current" can make it stale. The
    // first fix copied it into the maps it knew about and missed an instance
    // built before the backend existed, which is every app.
    if key == "@backend" { return BACKEND_NAME.view(); }
    if p.is_null() { return ""; }
    return match { (*p).envmap.get_ptr(key) } {
        option::Option[*text::Text]::Some(v) => { (*v).view() },
        option::Option[*text::Text]::None => "",
    };
}

fn env(key: str) -> str { return env_in(current(), key); }

fn has_env_in(p: *Application, key: str) -> bool {
    if key == "@backend" { return BACKEND_NAME.view() != ""; }
    if p.is_null() { return false; }
    return { (*p).envmap.contains_key(key) };
}

fn has_env(key: str) -> bool { return has_env_in(current(), key); }

// False when the key is reserved. An application cannot overwrite what C+ and
// facet published about it.
fn set_env_in(p: *Application, key: str, value: str) -> bool {
    if key == "" { return false; }
    if env_is_reserved(key) { return false; }
    return env_put_in(p, key, value);
}

fn set_env(key: str, value: str) -> bool { return set_env_in(current(), key, value); }

// The door C+ and facet themselves write through — it accepts reserved keys and
// is not app-facing.
fn env_put_in(p: *Application, key: str, value: str) -> bool {
    if p.is_null() { return false; }
    let st: status::Status = { (*p).envmap.insert(text::from_str(key),
                                                  text::from_str(value)) };
    return st == status::Status::Ok;
}

fn env_put(key: str, value: str) -> bool { return env_put_in(current(), key, value); }

// A flag has ONE canonical spelling, so two readers cannot disagree about what
// "licensed" means — the same argument `nav::arg` being a param under a
// reserved key already makes. Anything other than "1" is false, including
// "true": the writer is `set_env_flag`, and a hand-written "true" is a bug this
// makes visible rather than a spelling this quietly accepts.
fn env_flag_in(p: *Application, key: str) -> bool { return env_in(p, key) == "1"; }
fn env_flag(key: str) -> bool { return env_flag_in(current(), key); }

fn set_env_flag_in(p: *Application, key: str, on: bool) -> bool {
    if on { return set_env_in(p, key, "1"); }
    return set_env_in(p, key, "0");
}
fn set_env_flag(key: str, on: bool) -> bool { return set_env_flag_in(current(), key, on); }

fn clear_env_in(p: *Application, key: str) -> bool {
    if env_is_reserved(key) { return false; }
    if p.is_null() { return false; }
    if !{ (*p).envmap.contains_key(key) } { return false; }
    let st: status::Status = { (*p).envmap.insert(text::from_str(key), text::new()) };
    return st == status::Status::Ok;
}
fn clear_env(key: str) -> bool { return clear_env_in(current(), key); }

// Every key, so an app (or an agent, or a bug report) can see what the app
// knows about itself rather than having to guess the names.
fn env_keys_in(p: *Application) -> vec::Vec[text::Text] {
    var out: vec::Vec[text::Text] = vec::new::[text::Text]();
    if p.is_null() { return out; }
    let s: *Application = p;
    let cap: usize = { (*s).envmap.slot_capacity() };
    var i: usize = 0 as usize;
    while i < cap {
        match { (*s).envmap.key_ptr_at_slot(i) } {
            option::Option[*text::Text]::Some(kp) => {
                out.append(text::from_str({ (*kp).view() }));
            }
            option::Option[*text::Text]::None => { }
        }
        i = i +% (1 as usize);
    }
    return out;
}

fn env_keys() -> vec::Vec[text::Text] { return env_keys_in(current()); }

// ---- the process door --------------------------------------------------------
// The ONE legitimately-shared pointer: which app is running. 0 = none, and
// every reader falls back to the process-default state so app-less facet
// (tests, bare mounts) keeps working.
static RUNNING: *Application = #zero::[*Application]();
static DEFAULT: Application = #zero::[Application]();

// The current app's state — the running app's, or the process default.
// Free verbs (`theme()`, `nav::go`, `find`) resolve through this, which is
// what lets them stay context-free at the call site.
// Application.Current, exactly: the running app, or the process default
// (the app-less posture tests and bare mounts run in).
fn current() -> *Application {
    if RUNNING.is_not_null() { return RUNNING; }
    return #addr_of(DEFAULT);
}

// `App::run` points the door here; quitting calls release. Not app-facing.
fn make_current(s: *Application) { RUNNING = s; return; }
fn release_current() { RUNNING = 0 as *Application; return; }
fn has_current() -> bool { return RUNNING.is_not_null(); }

// Tests: a fresh default state, so one test's app state cannot leak into
// the next. Only meaningful when nothing is running.
fn reset_default_for_tests() {
    DEFAULT = Application::new();
}

// ---- windows ----------------------------------------------------------------

// Application.OpenWindow — a ledger row `maui-map-draft.md:1089` DROPPED as
// "engine internals" and that reality put back by hand. It is the window
// tier's constructor; see plans/nav-windows.md §1 for why the whole tier's
// verbs went that way and the reads did not.
//
// `key` NAMES the window. A key already open is not opened twice: the caller
// is answered false and is expected to `activate_window` instead, which is the
// "an app that opened an inspector twice got a new one each time" failure the
// activate verb was written for. An empty key names nothing and never
// collides — many unnamed windows are legal.
fn open_window(root: *flex::Node, key: str = "") -> bool {
    let s: *Application = current();
    if key != "" && has_window(key) { return false; }
    { (*s).windows.append(Window { key: text::from_str(key), root: root,
                                   native: 0 as *u8 }) };
    return true;
}

// Application.CloseWindow.
fn close_window(root: *flex::Node) {
    let s: *Application = current();
    var i: usize = 0 as usize;
    let n: usize = { (*s).windows.count() };
    while i < n {
        let hit: bool = match { (*s).windows.at_ptr(i) } {
            option::Option[*Window]::Some(w) => ({ (*w).root } == root),
            option::Option[*Window]::None => false,
        };
        if hit {
            // `remove`, NOT `swap_remove`. The list is in OPEN order and two
            // readers depend on it — `find_node`'s documented DOM rule ("the
            // running app's windows in OPEN order, each tree in document
            // order, FIRST match wins") and `primary_window_root` below.
            // `swap_remove` moves the last window into the freed slot, which
            // silently reorders both.
            let _r: option::Option[Window] = { (*s).windows.remove(at: i) };
            WINDOW_REMOVALS = WINDOW_REMOVALS +% (1 as u64);
            return;
        }
        i = i +% (1 as usize);
    }
}

// How many windows have CLOSED in this process. `window::Window` cursors
// capture it and compare, exactly as the node cursors compare
// `flex::removal_count()` — conservative (any close invalidates every window
// cursor) and, unlike comparing the root pointer, immune to a freed tree's
// address being handed to the next window.
static WINDOW_REMOVALS: u64 = 0 as u64;

fn window_removal_count() -> u64 { return WINDOW_REMOVALS; }

// The same counter for the screen stack, and `stack::pop` bumps it. A
// `screen::Cursor` compares it for exactly the reason a window cursor compares
// the window one: a popped screen's box is freed on a deferred schedule, so a
// cursor that only checked "is something at this address" could answer live for
// a screen that has gone and been replaced.
static SCREEN_REMOVALS: u64 = 0 as u64;

fn screen_removal_count() -> u64 { return SCREEN_REMOVALS; }

// ---- reading the stack from the tier above -----------------------------------
// `screen.cplus` holds the cursor and cannot import `stack.cplus` — stack
// imports screen, so the arrow only points one way. These are the record's own
// accessors, which is the same shape `window_root(at:)` already has.

fn screen_stack_count() -> usize {
    let s: *Application = current();
    return { (*s).stack.count() };
}

fn screen_stack_key(at: usize) -> str {
    let s: *Application = current();
    return match { (*s).stack.at_ptr(at) } {
        option::Option[*StackEntry]::Some(e) => { (*e).key.view() },
        option::Option[*StackEntry]::None => "",
    };
}

fn screen_stack_route(at: usize) -> str {
    let s: *Application = current();
    return match { (*s).stack.at_ptr(at) } {
        option::Option[*StackEntry]::Some(e) => { (*e).route.view() },
        option::Option[*StackEntry]::None => "",
    };
}

fn screen_stack_sbp(at: usize) -> *u8 {
    let s: *Application = current();
    return match { (*s).stack.at_ptr(at) } {
        option::Option[*StackEntry]::Some(e) => { (*e).sbp },
        option::Option[*StackEntry]::None => 0 as *u8,
    };
}

fn screen_stack_root(at: usize) -> *flex::Node {
    let s: *Application = current();
    return match { (*s).stack.at_ptr(at) } {
        option::Option[*StackEntry]::Some(e) => { (*e).root },
        option::Option[*StackEntry]::None => 0 as *flex::Node,
    };
}

fn stack_host_root() -> *flex::Node {
    let s: *Application = current();
    return { (*s).stack_host };
}
fn note_screen_removed() { SCREEN_REMOVALS = SCREEN_REMOVALS +% (1 as u64); return; }

// Is this tree an open window of the running app? The direct question, for
// readers that hold a root rather than a name.
fn has_window_root(root: *flex::Node) -> bool {
    let s: *Application = current();
    var i: usize = 0 as usize;
    let n: usize = { (*s).windows.count() };
    while i < n {
        match { (*s).windows.at_ptr(i) } {
            option::Option[*Window]::Some(w) => {
                if { (*w).root } == root { return true; }
            }
            option::Option[*Window]::None => { }
        }
        i = i +% (1 as usize);
    }
    return false;
}

// Application.CloseWindow, addressed the way an application can actually hold
// an address. False for a key no window carries — never a trap.
fn close_window_keyed(key: str) -> bool {
    let r: *flex::Node = window_for_key(key);
    if r.is_null() { return false; }
    close_window(r);
    return true;
}

// Application.ActivateWindow — `maui-map-draft.md:1080`, DROPPED as "engine
// internals" and then needed. Bring a window to the front and give it the
// keyboard: opening and closing were the only two things facet could say about
// a window's life, so a second window could be created and never reached
// again — an app that opened an inspector twice got a new one each time rather
// than the one already on screen.
//
// Through a fn-pointer seam for the same reason `agent_attach` uses one: this
// half of facet is portable and knows no AppKit. The backend fills it in.
fn activate_window(key: str) -> bool {
    let f: fn(*u8) = ACTIVATE_FN;
    if f.is_null() { return false; }
    let r: *flex::Node = window_for_key(key);
    if r.is_null() { return false; }
    let w: *u8 = window_native(r);
    if w.is_null() { return false; }
    f(w);
    return true;
}

// ---- addressing a window by name ---------------------------------------------
// The tier's whole point. Everything above used to reach a window through
// `newest_window_root()`, which answers the SHEET while a sheet is up (a sheet
// is a real mount, so it is a real window of the app) and the pushed screen
// while one is pushed. A key is stable against both.

// 0 for a key no window carries, and for the empty key — an unnamed window is
// deliberately unreachable this way. See `Window.key`.
fn window_for_key(key: str) -> *flex::Node {
    if key == "" { return 0 as *flex::Node; }
    let s: *Application = current();
    var i: usize = 0 as usize;
    let n: usize = { (*s).windows.count() };
    while i < n {
        match { (*s).windows.at_ptr(i) } {
            option::Option[*Window]::Some(w) => {
                if { (*w).key.view() } == key { return { (*w).root }; }
            }
            option::Option[*Window]::None => { }
        }
        i = i +% (1 as usize);
    }
    return 0 as *flex::Node;
}

fn has_window(key: str) -> bool {
    return window_for_key(key) != (0 as *flex::Node);
}

// The name a tree is open under, "" when it was opened without one.
fn window_key_of(root: *flex::Node) -> str {
    let s: *Application = current();
    var i: usize = 0 as usize;
    let n: usize = { (*s).windows.count() };
    while i < n {
        match { (*s).windows.at_ptr(i) } {
            option::Option[*Window]::Some(w) => {
                if { (*w).root } == root { return { (*w).key.view() }; }
            }
            option::Option[*Window]::None => { }
        }
        i = i +% (1 as usize);
    }
    return "";
}

// Name a window after the fact. The backends open their window and mount its
// tree through paths that predate keys (`mount::mount` calls `open_window`
// with none), so the facade names it once the mount has happened rather than
// every call site growing a key parameter it would have to thread.
//
// Refuses a key another window already carries, which is what keeps
// `window_for_key` answering THE one rather than the first of several.
fn set_window_key(root: *flex::Node, key: str) -> bool {
    if key == "" { return false; }
    if has_window(key) { return false; }
    let s: *Application = current();
    var i: usize = 0 as usize;
    let n: usize = { (*s).windows.count() };
    while i < n {
        match { (*s).windows.at_ptr(i) } {
            option::Option[*Window]::Some(w) => {
                if { (*w).root } == root { { (*w).key = text::from_str(key) }; return true; }
            }
            option::Option[*Window]::None => { }
        }
        i = i +% (1 as usize);
    }
    return false;
}

// THE WINDOW THE TIER DEFAULTS TO, and the reason this exists rather than the
// tier keeping `newest_window_root`: the primary is the app's first window and
// stays the primary while sheets and pushed screens come and go on top of it.
// "Newest" changes under a screen's feet; "first" does not.
fn primary_window_root() -> *flex::Node {
    let s: *Application = current();
    if { (*s).windows.count() } == (0 as usize) { return 0 as *flex::Node; }
    return window_root(0 as usize);
}

// The platform window behind `root`, and the backend's door to record it.
// `Window.native` was declared for exactly this and had no accessor, so a
// backend that opened an NSWindow had nowhere to put it.
//
// PER WINDOW, keyed by root — not a `CURRENT_WIN` static like the pre-regen
// facade kept. An app has many windows open at once, so a single process-wide
// "the current window" is both wrong (two editor windows side by side) and
// app-scoped state in a process static, which the statics rule forbids.
// Everything that needs to reach a window from a tree — close, frame read and
// write, the agent surface's attach — goes through these.
fn set_window_native(root: *flex::Node, p: *u8) {
    let s: *Application = current();
    var i: usize = 0 as usize;
    let n: usize = { (*s).windows.count() };
    while i < n {
        match { (*s).windows.at_ptr(i) } {
            option::Option[*Window]::Some(w) => {
                if { (*w).root } == root { { (*w).native = p }; return; }
            }
            option::Option[*Window]::None => { }
        }
        i = i +% (1 as usize);
    }
}

// 0 when the root is not an open window of the running app, or when no
// backend has recorded one — the same neutral answer every other reader gives.
fn window_native(root: *flex::Node) -> *u8 {
    let s: *Application = current();
    var i: usize = 0 as usize;
    let n: usize = { (*s).windows.count() };
    while i < n {
        match { (*s).windows.at_ptr(i) } {
            option::Option[*Window]::Some(w) => {
                if { (*w).root } == root { return { (*w).native }; }
            }
            option::Option[*Window]::None => { }
        }
        i = i +% (1 as usize);
    }
    return 0 as *u8;
}

// The window at `at` by its native handle — the reverse lookup a backend's
// delegate needs: AppKit hands back an NSWindow, and the app must find which
// of its trees that is. 0 for a handle no window carries.
fn window_root_for_native(p: *u8) -> *flex::Node {
    if p.is_null() { return 0 as *flex::Node; }
    let s: *Application = current();
    var i: usize = 0 as usize;
    let n: usize = { (*s).windows.count() };
    while i < n {
        match { (*s).windows.at_ptr(i) } {
            option::Option[*Window]::Some(w) => {
                if { (*w).native } == p { return { (*w).root }; }
            }
            option::Option[*Window]::None => { }
        }
        i = i +% (1 as usize);
    }
    return 0 as *flex::Node;
}

// EVERY root shown in one native window, oldest first.
//
// `window_root_for_native` answers the FIRST, which is right when a platform
// gives each screen its own window — macOS does, so a pushed screen is a window
// and has its own record. iOS does not: `nav::push` puts the pushed tree into a
// view controller inside the SAME UIWindow, so one handle legitimately carries
// several roots and a reader that stops at the first goes blind the moment a
// screen is pushed or a sheet comes up.
//
// The agent surface is the caller that needs all of them: it describes what is
// on screen, and a pushed screen is on screen.
fn window_roots_for_native(p: *u8) -> vec::Vec[*flex::Node] {
    var out: vec::Vec[*flex::Node] = vec::new::[*flex::Node]();
    if p.is_null() { return out; }
    let s: *Application = current();
    var i: usize = 0 as usize;
    let n: usize = { (*s).windows.count() };
    while i < n {
        match { (*s).windows.at_ptr(i) } {
            option::Option[*Window]::Some(w) => {
                if { (*w).native } == p { out.append({ (*w).root }); }
            }
            option::Option[*Window]::None => { }
        }
        i = i +% (1 as usize);
    }
    return out;
}

fn window_count() -> usize {
    let s: *Application = current();
    return { (*s).windows.count() };
}

fn window_root(at: usize) -> *flex::Node {
    let s: *Application = current();
    return match { (*s).windows.at_ptr(at) } {
        option::Option[*Window]::Some(w) => { (*w).root },
        option::Option[*Window]::None => 0 as *flex::Node,
    };
}

// The most recently opened window's root — the M7 interim answer, now
// per-app: "the mounted tree" is the newest window of the RUNNING app.
fn newest_window_root() -> *flex::Node {
    let s: *Application = current();
    let n: usize = { (*s).windows.count() };
    if n == (0 as usize) { return 0 as *flex::Node; }
    return window_root(n -% (1 as usize));
}

// ---- tests ------------------------------------------------------------------

#[test]
fn the_native_handle_is_per_window_not_per_process() {
    reset_default_for_tests();
    var a: flex::Node = flex::box();
    var b: flex::Node = flex::box();
    open_window(#addr_of(a));
    open_window(#addr_of(b));
    assert window_count() == (2 as usize);
    // Nothing recorded yet: the neutral answer, never a trap.
    assert window_native(#addr_of(a)) == (0 as *u8);
    // Two windows open at once, each carrying its OWN handle — the reason
    // this is a field and not a CURRENT_WIN static.
    set_window_native(#addr_of(a), 11 as *u8);
    set_window_native(#addr_of(b), 22 as *u8);
    assert window_native(#addr_of(a)) == (11 as *u8);
    assert window_native(#addr_of(b)) == (22 as *u8);
    // The reverse lookup a window delegate needs.
    assert window_root_for_native(22 as *u8) == #addr_of(b);
    assert window_root_for_native(11 as *u8) == #addr_of(a);
    // Re-recording replaces rather than stacks.
    set_window_native(#addr_of(a), 33 as *u8);
    assert window_native(#addr_of(a)) == (33 as *u8);
    assert window_root_for_native(11 as *u8) == (0 as *flex::Node);
    // Closing one leaves the other's handle intact.
    close_window(#addr_of(a));
    assert window_count() == (1 as usize);
    assert window_native(#addr_of(b)) == (22 as *u8);
    assert window_native(#addr_of(a)) == (0 as *u8);
    reset_default_for_tests();
}

#[test]
fn native_window_readers_are_inert_off_the_window_list() {
    reset_default_for_tests();
    var lone: flex::Node = flex::box();
    // A root that is not an open window: reads 0, and the write is dropped
    // rather than inventing an entry.
    assert window_native(#addr_of(lone)) == (0 as *u8);
    set_window_native(#addr_of(lone), 9 as *u8);
    assert window_count() == (0 as usize);
    assert window_native(#addr_of(lone)) == (0 as *u8);
    // A null handle matches nothing, even when a window has recorded none.
    open_window(#addr_of(lone));
    assert window_root_for_native(0 as *u8) == (0 as *flex::Node);
    assert window_root_for_native(404 as *u8) == (0 as *flex::Node);
    close_window(#addr_of(lone));
    reset_default_for_tests();
}

// ---- addressing a window by name ----------------------------------------------

#[test]
fn a_window_is_addressed_by_key() {
    reset_default_for_tests();
    var dash: flex::Node = flex::box();
    var cam: flex::Node = flex::box();
    assert open_window(#addr_of(dash), key: "dashboard");
    assert open_window(#addr_of(cam), key: "camera:front");
    assert window_for_key("dashboard") == #addr_of(dash);
    assert window_for_key("camera:front") == #addr_of(cam);
    assert window_key_of(#addr_of(cam)) == "camera:front";
    assert has_window("camera:front");
    // A key nothing carries answers neutrally rather than trapping.
    assert window_for_key("camera:back") == (0 as *flex::Node);
    assert !has_window("camera:back");
    // The keyed close reaches it without the caller holding a pointer, which
    // is the whole point of the key.
    assert close_window_keyed("camera:front");
    assert !has_window("camera:front");
    assert close_window_keyed("camera:front") == false;
    reset_default_for_tests();
}

#[test]
fn a_key_already_open_is_refused_rather_than_duplicated() {
    // The "opened the inspector twice and got a new one each time" failure.
    // A second open of a live key is refused so the caller activates instead.
    reset_default_for_tests();
    var first: flex::Node = flex::box();
    var second: flex::Node = flex::box();
    assert open_window(#addr_of(first), key: "inspector");
    assert open_window(#addr_of(second), key: "inspector") == false;
    assert window_count() == (1 as usize);
    assert window_for_key("inspector") == #addr_of(first);
    // Once it closes the name is free again.
    assert close_window_keyed("inspector");
    assert open_window(#addr_of(second), key: "inspector");
    assert window_for_key("inspector") == #addr_of(second);
    reset_default_for_tests();
}

#[test]
fn the_primary_is_the_first_window_and_a_sheet_does_not_become_it() {
    // THE BUG THIS TIER EXISTS TO KILL. A sheet and a pushed screen are real
    // mounts, so both join the window list — and the tier used to read
    // `newest_window_root()`, which answers whichever of them went up last.
    // A screen reading its own frame got the sheet's.
    reset_default_for_tests();
    var primary: flex::Node = flex::box();
    var sheet: flex::Node = flex::box();
    let _p: bool = open_window(#addr_of(primary), key: "workspace");
    assert primary_window_root() == #addr_of(primary);
    let _s: bool = open_window(#addr_of(sheet));          // a sheet names nothing
    assert newest_window_root() == #addr_of(sheet);       // the old answer
    assert primary_window_root() == #addr_of(primary);    // the new one
    // And the sheet going away leaves the primary exactly where it was.
    close_window(#addr_of(sheet));
    assert primary_window_root() == #addr_of(primary);
    reset_default_for_tests();
}

#[test]
fn unnamed_windows_are_unreachable_by_key_and_never_collide() {
    // A bare mount, a run_component and a sheet all open without a name. Many
    // of them are legal — an empty key is not an identity — and none is
    // reachable by `find`, which is the honest answer for a window that has
    // no name rather than handing back an arbitrary one.
    reset_default_for_tests();
    var a: flex::Node = flex::box();
    var b: flex::Node = flex::box();
    assert open_window(#addr_of(a));
    assert open_window(#addr_of(b));
    assert window_count() == (2 as usize);
    assert window_for_key("") == (0 as *flex::Node);
    assert !has_window("");
    assert window_key_of(#addr_of(a)) == "";
    // Naming one after the fact is how the facades key a tree the mount path
    // opened for them.
    assert set_window_key(#addr_of(b), "workspace");
    assert window_for_key("workspace") == #addr_of(b);
    // and a name another window holds is refused
    assert set_window_key(#addr_of(a), "workspace") == false;
    assert window_key_of(#addr_of(a)) == "";
    // as is naming a tree that is not an open window
    var stray: flex::Node = flex::box();
    assert set_window_key(#addr_of(stray), "nowhere") == false;
    reset_default_for_tests();
}

#[test]
fn closing_a_window_preserves_open_order() {
    // `find_node`'s DOM rule and `primary_window_root` both read the list in
    // OPEN order. `swap_remove` moved the last window into the freed slot and
    // silently reordered both.
    reset_default_for_tests();
    var a: flex::Node = flex::box();
    var b: flex::Node = flex::box();
    var c: flex::Node = flex::box();
    let _a: bool = open_window(#addr_of(a), key: "a");
    let _b: bool = open_window(#addr_of(b), key: "b");
    let _c: bool = open_window(#addr_of(c), key: "c");
    assert close_window_keyed("b");
    assert window_count() == (2 as usize);
    assert window_root(0 as usize) == #addr_of(a);
    assert window_root(1 as usize) == #addr_of(c);   // was `a, c` -> `a, c`, not `a, c` reversed
    assert primary_window_root() == #addr_of(a);
    reset_default_for_tests();
}

#[test]
fn activate_is_inert_without_a_backend_and_off_the_list() {
    // No ACTIVATE_FN is installed in a headless suite, so every answer here is
    // the neutral one — and a key nothing carries is false even once one is.
    reset_default_for_tests();
    var w: flex::Node = flex::box();
    let _o: bool = open_window(#addr_of(w), key: "main");
    assert activate_window("main") == false;      // no backend seam
    assert activate_window("nowhere") == false;
    reset_default_for_tests();
}

// ---- what C+ knows at compile time --------------------------------------------
// Seeded once per app instance, before anything else can write. These are the
// `@` keys: reserved, and refused to `set_env`, so an application cannot tell
// an agent it is running somewhere it is not.
//
// `#platform()` / `#arch()` / `#target()` are constants the compiler folds at
// the call site — see `check_intrinsic_target_fact` in cplus-core. The package
// name and version are NOT available yet: nothing injects them into the build,
// so `@app.version` is absent rather than wrong. Adding `#pkg_version()` is the
// same shape as `#platform()` and is recorded in plans/nav-windows.md §8.
fn seed_env(p: *Application) {
    if p.is_null() { return; }
    let _a: bool = env_put_in(p, "@platform", #platform());
    let _b: bool = env_put_in(p, "@arch", #arch());
    let _c: bool = env_put_in(p, "@target", #target());
    let _d: bool = env_put_in(p, "@app.name", { (*p).name.view() });
}

// WHICH BACKEND IS DRAWING, and it is a PROCESS fact rather than app-scoped
// state: one backend is installed per process and two apps in the same binary
// cannot disagree about it. Statics are legal here for exactly this — the file
// header lists "the backend" as the first thing every app and window genuinely
// shares.
//
// It lived in the app record first and read back EMPTY on every platform,
// because `App::run` installs the backend BEFORE it makes the app current — so
// `env_put` wrote it into the process default and the instance never had it.
// Reported from an Android device, 2026-09-06, after the same was noticed on an
// iPad. The scope was the bug; the ordering only exposed it.
static BACKEND_NAME: text::Text = #zero::[text::Text]();

fn set_backend_name(name: str) { BACKEND_NAME = text::from_str(name); return; }

fn backend_name() -> str { return BACKEND_NAME.view(); }

// ---- tests ---------------------------------------------------------------------

#[test]
fn env_answers_neutrally_and_round_trips() {
    reset_default_for_tests();
    assert env("nothing") == "";
    assert has_env("nothing") == false;
    assert set_env("last_project", "/tmp/proj");
    assert env("last_project") == "/tmp/proj";
    assert has_env("last_project");
    // A flag has ONE spelling, so two readers cannot disagree.
    assert set_env_flag("licensed", true);
    assert env_flag("licensed");
    assert env("licensed") == "1";
    assert set_env_flag("licensed", false);
    assert env_flag("licensed") == false;
    // and a value nobody wrote is not a flag
    assert env_flag("never_set") == false;
    reset_default_for_tests();
}

#[test]
fn a_reserved_key_cannot_be_written_by_an_application() {
    // THE POINT OF THE `@` MARK: an app must not be able to tell an agent it is
    // a version, platform or build it is not. Same reservation nav::arg_key
    // already uses.
    reset_default_for_tests();
    assert env_is_reserved("@platform");
    assert env_is_reserved("platform") == false;
    assert env_is_reserved("") == false;
    // facet's own door writes it
    assert env_put("@platform", "macos");
    assert env("@platform") == "macos";
    // the application's door does not
    assert set_env("@platform", "windows") == false;
    assert env("@platform") == "macos";
    assert clear_env("@platform") == false;
    assert env("@platform") == "macos";
    reset_default_for_tests();
}

#[test]
fn seeding_publishes_what_the_compiler_knows() {
    reset_default_for_tests();
    let p: *Application = #addr_of(DEFAULT);
    { (*p).name = text::from_str("probe") };
    seed_env(p);
    // The values are the target's, so the assertion is that they are PRESENT
    // and non-empty rather than any particular string — this suite runs on more
    // than one platform.
    assert has_env("@platform");
    assert env("@platform") != "";
    assert has_env("@arch");
    assert env("@arch") != "";
    assert env("@app.name") == "probe";
    // and seeding does not leave the door pointing anywhere
    assert has_current() == false;
    reset_default_for_tests();
}

#[test]
fn env_keys_lists_what_the_app_knows() {
    reset_default_for_tests();
    assert set_env("a", "1");
    assert set_env("b", "2");
    assert env_put("@platform", "macos");
    let ks: vec::Vec[text::Text] = env_keys();
    assert ks.count() == (3 as usize);
    reset_default_for_tests();
    assert env_keys().count() == (0 as usize);
}

#[test]
fn env_is_per_app_not_per_process() {
    // App-scoped, like everything else in this record: a second app in the exe
    // starts clean rather than inheriting the first one's facts.
    reset_default_for_tests();
    assert set_env("licensed", "1");
    let other: *Application = new_instance("recovery");
    make_current(other);
    assert env("licensed") == "";
    assert set_env("licensed", "0");
    release_current();
    // and the first app's value is exactly where it was
    assert env("licensed") == "1";
    reset_default_for_tests();
}

#[test]
fn the_backend_name_reaches_an_app_made_before_it_was_installed() {
    // THE ORDERING THAT BROKE IT. `App::run` installs the backend BEFORE it
    // makes the app current, and an app instance is built before either — so a
    // backend name written into "the current app" landed in the process default
    // and the instance read back EMPTY. Measured on an iPad and an Android
    // device, 2026-09-06, through `runtime::app().env("@backend")`.
    //
    // The scope was the wrong half of the bug: one backend is installed per
    // process, so this is a process fact and belongs in a process static. The
    // ordering only exposed it.
    reset_default_for_tests();
    // An instance made BEFORE any backend exists — which is every app, since
    // `App::new` runs before `App::run`.
    let early: *Application = new_instance("early");
    assert env_in(early, "@backend") == "";

    // The backend installs. Everything that already exists learns about it.
    set_backend_name("facet_probe");
    assert env_in(early, "@backend") == "facet_probe";
    assert env("@backend") == "facet_probe";        // the process default too

    // And an app made AFTER is seeded at birth.
    let late: *Application = new_instance("late");
    assert env_in(late, "@backend") == "facet_probe";
    assert backend_name() == "facet_probe";

    // It is a RESERVED key, so an application still cannot claim to be running
    // on a backend it is not.
    make_current(late);
    assert set_env("@backend", "facet_lies") == false;
    assert env("@backend") == "facet_probe";
    release_current();
    set_backend_name("");
    reset_default_for_tests();
}
