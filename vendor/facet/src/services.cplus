// facet services — work off the UI thread, results back on it. HAND-WRITTEN.
//
// The platform-free half of the service pattern (Stage 3 port from the
// pre-regen facet, unchanged except where noted): `run_on_main` is the hop
// every result rides home on; `after` is the one time-driven verb, with
// `Cancellable` owning the pending-callback lifetime; `spawn_ui` drives
// async tasks on the UI thread; `on_worker` bridges CPU-blocking work;
// `Job`/`run_job` is the one-screen-one-job pattern iris uses.
// The backend installs the primitives (`set_run_on_main_fn`, `set_after_fn`,
// ...); with none installed every verb is the portable no-op — work is
// dropped, timers never fire and return already-cancelled handles.
//
// One reseam vs the old facet: `observe_size` takes a `*core::Node` (the
// new tree's stable cursor), not the retired generic `Handle`.

import "stdlib/text" as text;
import "stdlib/vec" as vec;
import "stdlib/option" as option;
import "stdlib/box" as box;
import "stdlib/thread" as thread;
import "stdlib/future" as future;
import "stdlib/executor" as executor;
import "stdlib/net" as net;
import "stdlib/atomic" as atomic;
import "stdlib/io" as io;
import "stdlib/status" as status;
import "flex_layout/flex_layout" as flex;
import "./facet" as core;

// Main-thread dispatcher: run `work(ctx)` on the UI thread, where touching
// views (or state the UI reads) is safe. Non-blocking — the caller returns
// immediately and the main run loop picks the work up on its next turn. The
// workhorse of the service pattern: a background read finishes, boxes its
// result as the ctx, and hops here to deliver it. The backend installs the
// primitive; until then run_on_main silently DROPS the work (the portable
// no-backend default, like `find`) — so a ctx that carries ownership must be
// reclaimed by `work` itself, never by the scheduling side.
// ---- the Scheduler -----------------------------------------------------------
// The platform's scheduling primitives, one struct filled by the backend at
// startup — the same shape as mount's Renderer, for the same reason: one
// install, impossible to half-fill, one thing to grep. Every field keeps the
// portable no-backend default when zero.
struct Scheduler {
    run_on_main: fn(fn(*u8), *u8),
    after: fn(f64, fn(*u8), *u8) -> u64,
    cancel_after: fn(u64),
    observe_size: fn(*core::Node, fn(*u8), *u8) -> u64,
    cancel_observe_size: fn(u64),
}

fn scheduler_none() -> Scheduler {
    return Scheduler {
        run_on_main: 0 as fn(fn(*u8), *u8),
        after: 0 as fn(f64, fn(*u8), *u8) -> u64,
        cancel_after: 0 as fn(u64),
        observe_size: 0 as fn(*core::Node, fn(*u8), *u8) -> u64,
        cancel_observe_size: 0 as fn(u64),
    };
}

static SCHEDULER: Scheduler = #zero::[Scheduler]();

fn install_scheduler(take s: Scheduler) { SCHEDULER = s; return; }
fn uninstall_scheduler() { SCHEDULER = scheduler_none(); return; }

// `ctx` is DEFAULTED, like `after`'s and `observe_size`'s beside it, and that is
// load-bearing rather than tidy: the compiler fills a handler's context slot
// with the receiver when a caller passes a bound method (`this.publish`), but
// only when that slot has a default — a REQUIRED one is rejected by the arity
// check before the fill happens (E0308, though E0824 shows the fill was
// intended). This verb was the only one of the three without it, so
// `run_on_main(this.publish)` did not compile while `after(1.0, this.tick)` did.
fn run_on_main(work: fn(*u8), ctx: *u8 = 0 as *u8) {
    let f: fn(fn(*u8), *u8) = SCHEDULER.run_on_main;
    if f.is_not_null() { f(work, ctx); }
}

// Is a main-thread hop installed? The resource tier gates its verbs on this
// BEFORE spawning anything: with no backend a verb is the portable no-op —
// nothing runs, nothing queues, nothing leaks — rather than a flight whose
// apply can never land.
fn has_main_hop() -> bool {
    return SCHEDULER.run_on_main.is_not_null();
}

// ---- after: do something LATER, and be able to call it off --------------------
//
// `run_on_main` above is the only way to hand work to the UI thread and it has
// no delay — next turn of the queue, not later. The async surface beside it is
// event-driven, not time-driven: `spawn_ui`, `run_job` and the kqueue
// reactor all wait for a future or an fd, and `fswatch` waits for the
// filesystem. Nothing waited for a clock, so four kinds of ordinary UI work —
// a debounce, a countdown label, a watchdog, deferred layout — had to reach
// past facet into raw platform messaging.
//
// Two things make that worth a verb rather than a snippet each app copies:
//
//   SILENCE. A wrong send inside a delayed callback is swallowed by the
//   platform's timer loop — no crash, no log, the tick simply stops. That is a
//   bad failure to hand to every app.
//
//   LIFETIME. A pending callback holds a raw `this`, so every site needs a
//   `drop` that cancels it, and getting that wrong is a use-after-free inside a
//   run-loop callback. `Cancellable` owns that: cancel() is idempotent, and the
//   drop cancels, so the correct thing is what happens when you do nothing.
//
// One-shot on purpose. Three of the four sites that wanted this re-arm by hand
// on each keystroke — that is a debounce, not a repeating timer — so a repeating
// sibling waits for a caller that actually wants one.
//
//     var t: facet::Cancellable = facet::after(1.0f64, save_now, ctx);
//     ...
//     t.cancel();          // superseded by another keystroke
//
// The backend installs the primitive; with none, `after` never fires and
// returns an already-cancelled handle — the same no-backend default as `find`.

// A pending revocable registration — an `after` timer, an `observe_size`
// observation. Cancel it explicitly, or let it drop — a dropped handle
// cancels, because the common mistake is forgetting to.
struct Cancellable {
    _id: u64,          // 0 = nothing pending (never armed, already fired, or cancelled)
    _cancel: fn(u64),  // the revoke slot `_id` came from; zero falls back to the timer slot
}

impl Cancellable {
    // The inert handle: nothing pending, cancel is a no-op. For a struct field
    // that a later call arms — the drop still cancels whatever was last armed.
    fn none() -> Cancellable { return Cancellable { _id: 0 as u64, _cancel: #zero::[fn(u64)]() }; }

    // Mint a live handle over a backend registration: `id` from the arming
    // call, `cancel` the slot that revokes it. For runtime facades and
    // backends — the fields are file-private, so this is their only door.
    fn of(id: u64, cancel: fn(u64)) -> Cancellable { return Cancellable { _id: id, _cancel: cancel }; }

    // Idempotent, and safe after the callback has already run.
    fn cancel(ref this) {
        if this._id == (0 as u64) { return; }
        var f: fn(u64) = this._cancel;
        if f.is_null() { f = SCHEDULER.cancel_after; }
        if f.is_not_null() { f(this._id); }
        this._id = 0 as u64;
    }

    // Does this handle still hold a registration — i.e. is cancel() still
    // meaningful? False after cancel (including drop). A fired ONE-SHOT
    // cannot reach back into this handle to clear it, so a timer that has
    // already run still reads true here: treat this as "not yet cancelled",
    // never as "the callback has not run" (review finding, 2026-08-04 —
    // observing the fire needs the callback itself to record it).
    fn pending(this) -> bool { return this._id != (0 as u64); }

    fn drop(ref this) {
        this.cancel();
    }
}

// Run `cb(ctx)` on the UI thread after `seconds`. Cancel through the returned
// handle — including by letting it drop.
fn after(seconds: f64, cb: fn(*u8), ctx: *u8 = 0 as *u8) -> Cancellable {
    let f: fn(f64, fn(*u8), *u8) -> u64 = SCHEDULER.after;
    if f.is_null() { return Cancellable { _id: 0 as u64, _cancel: #zero::[fn(u64)]() }; }
    return Cancellable { _id: f(seconds, cb, ctx), _cancel: SCHEDULER.cancel_after };
}
// ---- element geometry -------------------------------------------------------
// The laid-out size a node actually got — and a way to hear when it changes.
// The read half is the node's `frame()`; the event half is `observe_size`,
// whose callback fires on the UI thread after every resize of that element —
// divider drag, window resize, relayout. (Reseam vs the old facet: the
// subject is a `*core::Node`, the retired `Handle` is gone.)


// Run `cb(ctx)` on the UI thread whenever `n`'s element changes size. Cancel
// through the returned handle — including by letting it drop — and cancel
// BEFORE the observed element leaves the tree; an observation must not outlive
// its subject. No backend, or a missing node: an already-cancelled handle,
// the same posture as `after`.
fn observe_size(n: *core::Node, cb: fn(*u8), ctx: *u8 = 0 as *u8) -> Cancellable {
    let f: fn(*core::Node, fn(*u8), *u8) -> u64 = SCHEDULER.observe_size;
    if f.is_null() { return Cancellable { _id: 0 as u64, _cancel: #zero::[fn(u64)]() }; }
    return Cancellable { _id: f(n, cb, ctx), _cancel: SCHEDULER.cancel_observe_size };
}

// ---- async tasks on the UI thread -------------------------------------------
// `spawn_ui` hands an async task to the UI: calling the async fn already ran
// its body to the first suspension (eagerly, on the caller's thread); the rest
// resumes on the main thread as its awaits complete. Timers and async I/O wake
// the task through the backend's reactor watch (see facet_appkit); awaiting
// another async fn resumes through the executor's pending queue. After any
// await the tree may have changed — the usual discipline applies (namespaced
// keys miss harmlessly; `attached(this)` / `found()` to know).
//
//     fn on_click(ref this, sender: *u8) { spawn_ui(this.refresh()); }
//     async fn refresh(ref this) {
//         await time::sleep(milliseconds: 150 as u64);
//         if !attached(this) { return; }
//         find("list").add_child(...);
//     }
//
// A spawned task runs to completion or not at all past a suspension the
// backend cannot wake (no backend installed = the portable no-op posture).
// There is no cancellation; a task in flight at teardown finds its keys gone.

extern fn stdlib_reactor_drain_pending_v1() -> i32;
extern fn stdlib_reactor_poll_one_event_nb_v1() -> i32;

fn spawn_ui[T: Send](take f: future::Future[T]) {
    executor::spawn_local::[T](f);
    run_on_main(pump_async, 0 as *u8);
}

// Drive every parked async task as far as it can go WITHOUT blocking: resume
// the pending queue, consume every already-fired reactor event, repeat until
// neither makes progress. The backend calls this whenever the reactor's
// kqueue reads ready (fd/timer fired) and after spawn_ui. Signature is
// fn(*u8) so it rides run_on_main and the dispatch source directly.
fn pump_async(ctx: *u8) {
    loop {
        let drained: i32 = { stdlib_reactor_drain_pending_v1() };
        var fired: i32 = 0;
        while { stdlib_reactor_poll_one_event_nb_v1() } == 1 {
            fired = fired + 1;
        }
        if drained == 0 {
            if fired == 0 { break; }
        }
    }
}

// ---- awaitable worker (blocking work off the UI thread) ---------------------
// The reactor wakes on fds and timers, not on computation — a CPU-blocking
// read gains nothing from `await` alone. `on_worker` bridges: it runs
// `f(input)` on a worker thread and suspends the CALLING task until the
// result is back, via a pipe the reactor can wait on (the worker writes the
// boxed result's address; the awaiting side reads it and reclaims). So an
// async task can hold a straight line through blocking work:
//
//     async fn refresh(ref this) {
//         let rows: vec::Vec[text::Text] = await on_worker(job, read_rows);
//         if !attached(this) { return; }
//         // fill by key
//     }
//
// `input` moves to the worker (I: Send); the result moves back (O: Send).
extern fn pipe(fds: *i32) -> i32;
extern fn close(fd: i32) -> i32;
extern fn write(fd: i32, buf: *u8, count: usize) -> isize;

// The handoff crossing to the worker thread is a CONCRETE struct: the typed
// input and fn ride as boxed raw pointers, reclaimed by the run_worker[I, O]
// trampoline (value-turbofish) on the far side.
struct WorkerHandoff {
    input_raw: usize,
    f_raw: usize,
    write_fd: i32,
}

fn run_worker[I: Send, O: Send](take h: WorkerHandoff) -> i32 {
    let input: I = box::from_raw::[I]((h.input_raw) as *u8).unwrap();
    let f: fn(take I) -> O = box::from_raw::[fn(take I) -> O]((h.f_raw) as *u8).unwrap();
    let out: O = f(input);
    match box::new::[O](out) {
        option::Option[box::Box[O]]::Some(b) => {
            var slot: *u8 = b.into_raw();
            let _w: isize = { write(h.write_fd, #addr_of(slot) as *u8, 8 as usize) };
        }
        option::Option[box::Box[O]]::None => { }
    }
    let _c: i32 = { close(h.write_fd) };
    return 0;
}

// The sync half: open the pipe, move the work to a thread, return the read
// end. Separate from the async fn so the coroutine body holds only concrete
// types.
fn worker_start[I: Send, O: Send](take input: I, f: fn(take I) -> O) -> i32 {
    var fds: [i32; 2] = [0, 0];
    let _p: i32 = { pipe(#addr_of(fds) as *i32) };
    let input_raw: usize = match box::new::[I](input) {
        option::Option[box::Box[I]]::Some(b) => { b.into_raw() } as usize,
        option::Option[box::Box[I]]::None => 0 as usize,
    };
    let f_raw: usize = match box::new::[fn(take I) -> O](f) {
        option::Option[box::Box[fn(take I) -> O]]::Some(b) => { b.into_raw() } as usize,
        option::Option[box::Box[fn(take I) -> O]]::None => 0 as usize,
    };
    let h: WorkerHandoff = WorkerHandoff { input_raw: input_raw, f_raw: f_raw, write_fd: fds[1] };
    let tramp: fn(take WorkerHandoff) -> i32 = run_worker::[I, O];
    let _bg: thread::JoinHandle[i32] = thread::spawn_with::[WorkerHandoff, i32](h, tramp);
    return fds[0];
}

async fn run_on_worker[I: Send, O: Send](take input: I, f: fn(take I) -> O) -> O {
    let rfd: i32 = worker_start::[I, O](input, f);
    var slot: *u8 = 0 as *u8;
    let _n: isize = await net::read_fd_async(rfd, #addr_of(slot) as *u8, 8 as usize);
    let _c: i32 = { close(rfd) };
    return box::from_raw::[O](slot).unwrap();
}

// ---- jobs -------------------------------------------------------------------
// A data owner whose slow work must never block the UI. Renamed on the way
// in (stages/3: "nothing is loaded and nothing is a service"). The interface
// IS the threading contract:
//   run   — the slow work (db / fs / net / scaffolding). run_job runs it on
//           a worker thread; it must not touch anything the UI reads.
//   apply — install what run prepared. run_job runs it on the main thread,
//           so the UI never observes a half-written result.
// A type conforms once and gets the whole async pipeline from run_job; no
// per-job structs, boxing, or thread code.
interface Job {
    fn run(ref this);
    fn apply(ref this);
}

// Run the job's `run` OFF the main thread, then its `apply` and `then(ctx)`
// back ON it. Returns immediately. The job must outlive the flight (it is
// reached through its address). Needs a backend for the main-thread hop
// (run_on_main): without one the prepared result is never applied.
fn run_job[J: Job](ref job_v: J, then: fn(*u8) = job_done_noop, ctx: *u8 = 0 as *u8) -> bool {
    let addr: usize = { #addr_of(job_v) as *u8 } as usize;
    // ONE FLIGHT PER JOB. A second worker inside the same `run()` assigns the
    // same fields as the first, and where those fields are `Text` or `Vec` —
    // which is most of them, because a job exists to fetch things — the second
    // assignment frees what the first is writing. See `claim_job` below for
    // what that cost.
    if !claim_job(addr as u64) { return false; }
    jobs_inflight_add(1 as u64);
    let job: JobFlight = JobFlight {
        job_addr: addr,
        run: job_run_tramp::[J],
        apply: job_apply_tramp::[J],
        then: then,
        ctx_addr: ctx as usize,
    };
    let _bg: thread::JoinHandle[i32] = thread::spawn_with::[JobFlight, i32](job, run_job_flight);
    return true;
}

// ---- one flight per job ------------------------------------------------------
//
// `run_job` spawns a worker on the job's ADDRESS. Called twice on the same job
// object, two workers are inside the same `run()`, assigning the same fields,
// and the main thread paints from them. It is not a hypothesis: iris,
// 2026-08-23, in a `Text.clone` on the main thread —
//
//     x1 = 0x402c000000000000   the double 14.0, read as a string pointer
//     x2 = 0x0000000c81c61800   ~53 GB, read as its length
//
// EVERY SERVICE HAND-ROLLED THE GUARD, which is the tell that the default was
// in the wrong place. Three of iris's five carried a `kicked: i8` set before
// `run_job` and checked on entry; two did not, and those two are the two that
// crashed. Five copies of one flag, each depending on an author remembering.
//
// The teardown contract (`wait_for_jobs` / `applies_pending`) is sound and is
// not what failed. It answers "is a worker still in this job" along the
// LIFETIME axis. This is the other axis — "is a worker in it ALREADY" — and
// nothing was asking.
//
// A slot is held from the claim until the flight is completely finished: after
// `apply` and `then` on the main thread, or when the flight is dropped with no
// main-thread hop to deliver it. Not when `run` returns — an `apply` still
// queued is still writing the job's fields.

const JOB_SLOT_COUNT: usize = 64 as usize;

// Addresses currently flying. Zero means free; an address can appear once.
static JOB_ADDRS: [u64; 64] = [0 as u64; 64];

// A spin lock over the table. The table is scanned and mutated in one step, and
// a lock-free scan-then-claim would let two threads pass the scan for the same
// address and both claim. Contention is a handful of jobs across a session, so
// the simplest thing that is exactly right is the right one.
static JOB_TABLE_LOCK: u64 = 0 as u64;

fn job_table_lock() {
    let p: *u64 = { #addr_of(JOB_TABLE_LOCK) };
    while atomic::compare_exchange_u64(p, 0 as u64, 1 as u64, atomic::Ordering::AcqRel)
          != (0 as u64) {
        sched_yield_once();
    }
}

fn job_table_unlock() {
    let p: *u64 = { #addr_of(JOB_TABLE_LOCK) };
    atomic::store_u64(p, 0 as u64, atomic::Ordering::Release);
}

// Take a slot for `addr`, or answer false because it is already flying.
//
// A FULL TABLE FAILS OPEN. Refusing would mean a pane that never loads because
// 64 other jobs happen to be in the air, which is a worse failure than the race
// this guards — and the scan has just proved this address is NOT flying, so
// running it is safe. Only a LATER duplicate of this one would go uncaught, and
// the line on stderr says so.
fn claim_job(addr: u64) -> bool {
    if addr == (0 as u64) { return true; }
    job_table_lock();
    let base: *u64 = { #addr_of(JOB_ADDRS[0]) };
    var free: i64 = -1 as i64;
    var i: usize = 0 as usize;
    while i < JOB_SLOT_COUNT {
        let v: u64 = atomic::load_u64({ base + i }, atomic::Ordering::Acquire);
        if v == addr {
            job_table_unlock();
            return false;
        }
        if v == (0 as u64) && free < (0 as i64) { free = i as i64; }
        i = i +% (1 as usize);
    }
    if free >= (0 as i64) {
        atomic::store_u64({ base + (free as usize) }, addr, atomic::Ordering::Release);
    } else {
        io::eprintln("facet: job table full; a second flight on this job cannot be refused");
    }
    job_table_unlock();
    return true;
}

// Give the slot back. Called when the flight is completely finished.
fn release_job(addr: u64) {
    if addr == (0 as u64) { return; }
    job_table_lock();
    let base: *u64 = { #addr_of(JOB_ADDRS[0]) };
    var i: usize = 0 as usize;
    while i < JOB_SLOT_COUNT {
        if atomic::load_u64({ base + i }, atomic::Ordering::Acquire) == addr {
            atomic::store_u64({ base + i }, 0 as u64, atomic::Ordering::Release);
            job_table_unlock();
            return;
        }
        i = i +% (1 as usize);
    }
    job_table_unlock();
}

// Is a worker or a queued apply still inside this job? The question a caller
// asks before deciding whether to kick, and the one every service used to
// answer with its own flag.
fn job_in_flight(addr: usize) -> bool {
    if addr == (0 as usize) { return false; }
    job_table_lock();
    let base: *u64 = { #addr_of(JOB_ADDRS[0]) };
    var i: usize = 0 as usize;
    while i < JOB_SLOT_COUNT {
        if atomic::load_u64({ base + i }, atomic::Ordering::Acquire) == (addr as u64) {
            job_table_unlock();
            return true;
        }
        i = i +% (1 as usize);
    }
    job_table_unlock();
    return false;
}

// ---- in-flight jobs ----------------------------------------------------------
//
// `run_job` states "the job must outlive the flight" and, until 2026-07-30,
// handed the caller nothing to honour it with: the JoinHandle was discarded and
// `JoinHandle::drop` DETACHES by design ("true fire-and-forget"). So a screen
// that started a service and was then torn down freed memory a live worker was
// still writing. Found by ASan on iris at quit — `Text.drop` on a worker thread
// reading a `Welcome` already freed by `Box[Welcome].drop` in main.
//
// The count is what makes the contract keepable. `wait_for_jobs` blocks
// until every worker has finished touching its service, and the runtime calls
// it before dropping screens, so an app gets the guarantee without writing
// anything. A caller tearing a component down early can call it directly.
//
// Counted rather than joined: the JoinHandle is consumed by `join` and there is
// nowhere to keep one per flight without a registry that outlives the caller —
// the count needs no ownership at all.
//
// It is decremented when RUN returns, not after `apply`. Apply runs on the
// main thread, which is the thread that owns the data, so it is not part of
// the WORKER race being waited out — and waiting for it here would deadlock,
// since the main thread cannot deliver a `run_on_main` hop while it is
// blocked in the wait. bugs/load-service-worker-outlives-its-service.md
//
// WHAT THE WAIT DOES NOT COVER (review finding, 2026-08-04): an apply that
// is already QUEUED on the main loop. `wait_for_jobs` returning means "no
// worker touches the job"; a queued `finish_job_flight` still holds the
// job's address and will run when the loop next turns. The second counter
// (`applies_pending`) makes that state observable: a teardown path must see
// `jobs_settled()` — both counters zero — before dropping a job, and the
// facade's teardown drains its loop to get there. Headless (no scheduler),
// nothing is ever queued: the flight is dropped instead of leaked, and
// `apply` simply never runs — the portable posture.
#[link_name = "sched_yield"]
extern fn sched_yield_raw() -> i32;

// Give a worker its turn rather than burning the core. The wait is a teardown
// step, not a poll loop.
fn sched_yield_once() { let _r: i32 = { sched_yield_raw() }; return; }

static JOBS_IN_FLIGHT: u64 = 0 as u64;

fn jobs_inflight_add(d: u64) {
    let p: *u64 = { #addr_of(JOBS_IN_FLIGHT) };
    let _prev: u64 = atomic::fetch_add_u64(p, d, atomic::Ordering::AcqRel);
}

fn jobs_inflight_sub(d: u64) {
    let p: *u64 = { #addr_of(JOBS_IN_FLIGHT) };
    let _prev: u64 = atomic::fetch_sub_u64(p, d, atomic::Ordering::AcqRel);
}

// How many service workers may still be touching their service.
fn jobs_in_flight() -> u64 {
    let p: *u64 = { #addr_of(JOBS_IN_FLIGHT) };
    return atomic::load_u64(p, atomic::Ordering::Acquire);
}

// Applies handed to the main loop and not yet finished. Separate from the
// worker count on purpose: waiting on THIS from the main thread would
// deadlock (the wait blocks the loop that must run the apply).
static APPLIES_PENDING: u64 = 0 as u64;

fn applies_pending_add(d: u64) {
    let p: *u64 = { #addr_of(APPLIES_PENDING) };
    let _prev: u64 = atomic::fetch_add_u64(p, d, atomic::Ordering::AcqRel);
}

fn applies_pending_sub(d: u64) {
    let p: *u64 = { #addr_of(APPLIES_PENDING) };
    let _prev: u64 = atomic::fetch_sub_u64(p, d, atomic::Ordering::AcqRel);
}

fn applies_pending() -> u64 {
    let p: *u64 = { #addr_of(APPLIES_PENDING) };
    return atomic::load_u64(p, atomic::Ordering::Acquire);
}

// The full teardown check: no worker in a job AND no apply queued. A facade
// drains its loop between wait_for_jobs() and dropping job owners until
// this reads true.
fn jobs_settled() -> bool {
    return jobs_in_flight() == (0 as u64) && applies_pending() == (0 as u64);
}

// Block until no worker is touching a service. Call before dropping anything a
// service was given — the runtime does this for screens at teardown.
fn wait_for_jobs() {
    while jobs_in_flight() != (0 as u64) { sched_yield_once(); }
}

// ---- deferring a free until nothing can be pointing at it -------------------
//
// `wait_for_jobs` is the right answer in one place and the wrong one in
// another, and the difference is which thread is asking.
//
// A screen that started a service and is then torn down must not be freed
// while a worker is inside a job that points into it — the worker keeps
// writing, the next screen is allocated into that memory, and something
// unrelated crashes reading its own fields. Three separate iris crashes were
// this: a `Text.clone` in one subsystem, a `Text.drop` in another, and a
// malloc abort in a third, because the fault lands wherever the freed memory
// was REUSED, never where it was freed.
//
// The runtime's own teardown (`settle_and_teardown`, after the run loop has
// returned) can simply wait. A WINDOW-CLOSE CALLBACK CANNOT. It runs on the
// main thread inside the toolkit's `windowWillClose:`, and the workers it
// would be waiting for are trying to reach that same main thread to land their
// applies. Waiting there froze the app for as long as a child process took,
// and froze it for good when a worker needed the main thread — which is
// exactly what happened, was reported by a person using it, and got the first
// attempt at this reverted.
//
// So the free is DEFERRED rather than waited for. `free_when_settled` frees
// immediately when nothing is in flight — the ordinary case, and the same
// timing as before — and otherwise parks the pointer and retries on a timer,
// off the close callback, until `jobs_settled()` says nothing can reach it.
//
// WHAT THIS TRADES. A worker that never finishes leaks one screen instead of
// corrupting the next one. That is the right way round: a leak is visible to
// `leaks` and costs a screen's memory, while the use-after-free is a crash in
// a subsystem that has nothing to do with the screen that caused it. The loud
// line below is what says a wait has gone on too long.
//
// THE COUNTERS ARE GLOBAL, so a deferred free waits for every job and not just
// the ones its own screen started. Stronger than necessary and therefore safe;
// `run_job` has no notion of an owning screen to make it narrower.

// One parked pointer and the function that reclaims it — a fn-ptr rather than
// a kind tag, because the two callers free different types (a `ScreenBox` and
// a tree `Node`) and a third would otherwise have to touch this file.
struct PendingFree {
    free: fn(*u8),
    // The subject. `opaque` because `free` is its owner: this struct carries
    // the address, it does not own it.
    opaque p: *u8,
    // Retries so far, for the loud line only.
    turns: i64,
}

static PENDING_FREES: vec::Vec[PendingFree] = #zero::[vec::Vec[PendingFree]]();
static RECLAIM_ARMED: bool = false;

// How often to re-ask. Short enough that a screen closed between two service
// calls is reclaimed before the user notices, long enough that the run loop
// still sleeps. A timer, not a `run_on_main` re-post: re-posting would spin
// the main thread hot for as long as a service shells out, which is the
// problem this exists to avoid.
const RECLAIM_INTERVAL: f64 = 0.05f64;

// ~10 seconds of retries. Not a bailout — nothing is freed early — just the
// point at which a wait stops being ordinary and should be visible.
const RECLAIM_LOUD_AFTER: i64 = 200 as i64;

// Free `p` by calling `f(p)` as soon as no job can still be pointing at it.
//
// Frees SYNCHRONOUSLY when nothing is in flight, which is almost always, so
// the common path keeps the timing it had. Otherwise it returns at once and
// the free happens later, on the main thread, from a timer.
fn free_when_settled(f: fn(*u8), p: *u8) {
    if f.is_null() { return; }
    if p.is_null() { return; }
    if jobs_settled() { f(p); return; }
    // No timer primitive — headless, or a backend that installed none. Nothing
    // will ever turn a loop to retry on, and there is no main thread to freeze
    // either, so the honest answer here is the old one: wait, then free.
    // (Headless also means no apply is ever queued, so this terminates as soon
    // as the worker leaves `run`.)
    let arm: fn(f64, fn(*u8), *u8) -> u64 = SCHEDULER.after;
    if arm.is_null() {
        wait_for_jobs();
        f(p);
        return;
    }
    let list: *vec::Vec[PendingFree] = { #addr_of(PENDING_FREES) };
    let _a: status::Status =
        { (*list).append(PendingFree { free: f, p: p, turns: 0 as i64 }) };
    arm_reclaim();
}

// Free everything parked, if and only if nothing is in flight. Answers how
// many are still parked, so a caller can say whether it drained.
//
// Called from the retry timer, and by the runtime's own `settle_and_teardown`
// once it has waited — so a quit reclaims whatever a close left behind.
fn reclaim_settled() -> usize {
    let list: *vec::Vec[PendingFree] = { #addr_of(PENDING_FREES) };
    let n: usize = { (*list).count() };
    if n == (0 as usize) { return 0 as usize; }
    if !jobs_settled() { return n; }
    // Take the entries out BEFORE running any of them: a `free` may drop a
    // screen whose own teardown parks something new, and appending to a vector
    // being iterated is how that becomes a missed entry or a moved buffer.
    var taken: vec::Vec[PendingFree] = vec::new::[PendingFree]();
    var i: usize = 0 as usize;
    while i < n {
        match { (*list).at(i) } {
            option::Option[PendingFree]::Some(e) => { let _a: status::Status = taken.append(e); }
            option::Option[PendingFree]::None => { }
        }
        i = i +% (1 as usize);
    }
    { (*list).remove_all() };
    // Nothing is waiting, so nothing is armed. A timer already scheduled will
    // still fire once, find the list empty and return — but the FLAG must not
    // outlive the list, or the next parked free sees `RECLAIM_ARMED` already
    // true, arms nothing, and waits for a tick that is never coming.
    //
    // That is not hypothetical: `settle_and_teardown` calls this after its own
    // wait, so any process that closes a screen, settles, and closes another
    // would leak the second one silently. `a_drain_rearms_for_the_next_close`
    // is the assertion; it found this.
    RECLAIM_ARMED = false;
    var k: usize = 0 as usize;
    let c: usize = taken.count();
    while k < c {
        match taken.at(k) {
            option::Option[PendingFree]::Some(e) => {
                let f: fn(*u8) = e.free;
                if f.is_not_null() { f(e.p); }
            }
            option::Option[PendingFree]::None => { }
        }
        k = k +% (1 as usize);
    }
    return { (*list).count() };
}

// How many frees are parked. For tests, and for anyone measuring whether a
// close actually reclaimed.
fn pending_frees() -> usize {
    let list: *vec::Vec[PendingFree] = { #addr_of(PENDING_FREES) };
    return { (*list).count() };
}

fn arm_reclaim() {
    if RECLAIM_ARMED { return; }
    let arm: fn(f64, fn(*u8), *u8) -> u64 = SCHEDULER.after;
    if arm.is_null() { return; }
    RECLAIM_ARMED = true;
    let _id: u64 = arm(RECLAIM_INTERVAL, reclaim_tick, 0 as *u8);
}

fn reclaim_tick(ctx: *u8) {
    RECLAIM_ARMED = false;
    let left: usize = reclaim_settled();
    if left == (0 as usize) { return; }
    // Still held. Age each entry and say so once, at the point where a wait
    // stops looking like a slow service and starts looking like a hung one.
    let list: *vec::Vec[PendingFree] = { #addr_of(PENDING_FREES) };
    var i: usize = 0 as usize;
    while i < left {
        match { (*list).at_ptr(i) } {
            option::Option[*PendingFree]::Some(e) => {
                let t: i64 = { (*e).turns } +% (1 as i64);
                { (*e).turns = t };
                if t == RECLAIM_LOUD_AFTER {
                    io::eprintln("facet: a closed screen has been waiting 10s to be freed — a service worker is still inside it. Nothing is freed while it is; this is a leak, not a crash, and a worker that never returns is the thing to look at.");
                }
            }
            option::Option[*PendingFree]::None => { }
        }
        i = i +% (1 as usize);
    }
    arm_reclaim();
}

fn job_done_noop(ctx: *u8) { return; }

// Type-erasing trampolines (value-turbofish): plain fn(*u8)s that call S's
// interface methods on the job at `p`.
fn job_run_tramp[J: Job](p: *u8) {
    let q: *J = p as *J;
    { (*q).run() };
}

fn job_apply_tramp[J: Job](p: *u8) {
    let q: *J = p as *J;
    { (*q).apply() };
}

// Raw pointers are !Send, so the job and ctx addresses ride as integers —
// sound under run_job's outlive-the-flight contract.
struct JobFlight {
    job_addr: usize,
    run: fn(*u8),
    apply: fn(*u8),
    then: fn(*u8),
    ctx_addr: usize,
}

fn run_job_flight(take job: JobFlight) -> i32 {
    let run: fn(*u8) = job.run;
    run(job.job_addr as *u8);       // the slow read, OFF the main thread
    // Queue the apply ONLY when a main-thread hop exists. Boxing first and
    // letting a no-op run_on_main swallow the pointer leaked the flight
    // headless — the review's confirming find. ORDER MATTERS: the apply is
    // counted BEFORE the worker count drops, so `jobs_settled()` can never
    // observe the gap between the two.
    let hop: fn(fn(*u8), *u8) = SCHEDULER.run_on_main;
    if hop.is_null() {
        // Headless: nothing will ever apply, so the flight ends HERE and the
        // slot goes back here too.
        //
        // ORDER MATTERS, the same way it does for the apply count below: the
        // slot is released BEFORE the worker count drops, so a caller that
        // returns from `wait_for_jobs` can never see a job still holding a slot
        // it will never give back. Written the other way round, this suite went
        // flaky under load within an hour — `wait_for_jobs` returned in the gap
        // between the two lines, and the next `run_job` was refused for a
        // flight that had already finished.
        release_job(job.job_addr as u64);
        jobs_inflight_sub(1 as u64);
        return 0;
    }
    match box::new::[JobFlight](job) {
        option::Option[box::Box[JobFlight]]::Some(b) => {
            applies_pending_add(1 as u64);
            jobs_inflight_sub(1 as u64);
            run_on_main(finish_job_flight, b.into_raw());
        }
        option::Option[box::Box[JobFlight]]::None => {
            release_job(job.job_addr as u64);
            jobs_inflight_sub(1 as u64);
        }
    }
    return 0;
}

fn finish_job_flight(raw: *u8) {
    let job: JobFlight = box::from_raw::[JobFlight](raw).unwrap();
    let apply: fn(*u8) = job.apply;
    apply(job.job_addr as *u8);     // install ON the main thread
    let cb: fn(*u8) = job.then;
    cb(job.ctx_addr as *u8);
    // The flight is over HERE, not when `run` returned: an apply still queued
    // is still writing the job's fields, so releasing earlier would let a
    // second flight in beside it. And released BEFORE the count drops, so
    // `jobs_settled()` never reports settled while a slot is still held.
    release_job(job.job_addr as u64);
    applies_pending_sub(1 as u64);
}


// ---- tests ------------------------------------------------------------------

// ---- run_job lifetime ---------------------------------------------------

struct SlowJob {
    label: text::Text,
    done: i32,
}

impl SlowJob: Job {
    fn run(ref this) {
        // Long enough that the caller's frame is gone before this runs.
        let _s: i32 = job_spin(40000000 as i64);
        this.label = text::from_str("ran");
        this.done = this.done + 1;
    }
    fn apply(ref this) { return; }
}

fn job_spin(n: i64) -> i32 {
    var i: i64 = 0 as i64;
    var acc: i32 = 0;
    while i < n { acc = acc + (1 as i32); i = i +% (1 as i64); }
    return acc;
}

// `run_job` documents "the job must outlive the flight" and gives the caller
// NOTHING to honour it with: the JoinHandle is discarded, and its drop DETACHES
// (fire-and-forget, by design). So a screen that starts a service and is then
// torn down frees memory a live worker thread is still writing.
//
// Found by ASan on iris at quit: `Text.drop` on a worker thread reading a
// `Welcome` freed by `Box[Welcome].drop` in main.
// bugs/load-service-worker-outlives-its-service.md
// `wait_for_jobs` is what makes "the job must outlive the flight" TRUE rather
// than merely documented — the subject cannot die while a worker is in it.
fn arm_and_wait() {
    var j: SlowJob = SlowJob { label: text::from_str("start"), done: 0 };
    run_job::[SlowJob](j);
    assert jobs_in_flight() >= (1 as u64) || j.done > (0 as i32);
    wait_for_jobs();
    return;   // safe: no worker is touching `j` any more
}

// ---- one flight per job -----------------------------------------------------

// A job that stays in `run` until it is told to stop, so a second flight can be
// attempted while the first is genuinely still inside it. Spinning on a flag is
// what makes the race REPRODUCIBLE rather than timing-dependent — the whole
// difficulty of the crash this guards was that it needed two workers to overlap.
struct HeldJob {
    hold: u64,
    runs: i32,
}

impl HeldJob: Job {
    fn run(ref this) {
        let p: *u64 = { #addr_of(this.hold) };
        while atomic::load_u64(p, atomic::Ordering::Acquire) != (0 as u64) {
            sched_yield_once();
        }
        this.runs = this.runs + 1;
    }
    fn apply(ref this) { return; }
}

#[test]
fn a_second_flight_on_a_live_job_is_refused() {
    var j: HeldJob = HeldJob { hold: 1 as u64, runs: 0 };
    let addr: usize = { #addr_of(j) as *u8 } as usize;

    // The first flight starts.
    assert run_job::[HeldJob](j);
    assert job_in_flight(addr);
    // The one that used to crash iris: two workers inside one `run`, assigning
    // the same fields, while the main thread paints from them.
    // Refused, not queued.
    assert run_job::[HeldJob](j) == false;
    assert run_job::[HeldJob](j) == false;

    // Let the first finish, then the job is free again — refusing is about
    // OVERLAP, not a one-shot latch, which is the difference between this and
    // the `kicked` flags it replaces.
    atomic::store_u64({ #addr_of(j.hold) }, 0 as u64, atomic::Ordering::Release);
    wait_for_jobs();
    // The slot went back.
    assert job_in_flight(addr) == false;
    // Exactly one worker ran it.
    assert j.runs == 1;

    // A later flight is allowed.
    assert run_job::[HeldJob](j);
    wait_for_jobs();
    assert j.runs == 2;
}

#[test]
fn two_different_jobs_do_not_block_each_other() {
    // The guard is per JOB, not a global one-at-a-time — a screen with three
    // services must be able to load all three at once.
    var a: HeldJob = HeldJob { hold: 1 as u64, runs: 0 };
    var b: HeldJob = HeldJob { hold: 1 as u64, runs: 0 };
    assert run_job::[HeldJob](a);
    // A different job is not the same job.
    assert run_job::[HeldJob](b);
    atomic::store_u64({ #addr_of(a.hold) }, 0 as u64, atomic::Ordering::Release);
    atomic::store_u64({ #addr_of(b.hold) }, 0 as u64, atomic::Ordering::Release);
    wait_for_jobs();
    assert a.runs == 1;
    assert b.runs == 1;
}

#[test]
fn a_job_that_never_flew_is_not_in_flight() {
    var j: HeldJob = HeldJob { hold: 0 as u64, runs: 0 };
    assert job_in_flight({ #addr_of(j) as *u8 } as usize) == false;
    assert job_in_flight(0 as usize) == false;
}

#[test]
fn waiting_for_jobs_keeps_the_subject_alive() {
    arm_and_wait();
    // Nothing a worker writes can land in the dead frame. Without the wait this
    // was a stack-use-after-return in Text.drop — the same function ASan named
    // on iris at quit.
    let _w: i32 = job_spin(200000000 as i64);
    assert true;
}

// ...and the wait really waited: run has finished and its result is visible.
#[test]
fn wait_for_jobs_blocks_until_run_finishes() {
    var j: SlowJob = SlowJob { label: text::from_str("start"), done: 0 };
    run_job::[SlowJob](j);
    wait_for_jobs();
    assert jobs_in_flight() == (0 as u64);
    assert j.done == (1 as i32);
    assert j.label.view() == "ran";
}

// ---- deferring a free until nothing can be pointing at it -------------------

// The subject of a deferred free: a heap thing a "screen" owns, standing in for
// a ScreenBox. `FREED` records that its reclaim ran, so the tests can assert
// WHEN rather than merely that.
static FREED: i32 = 0;
static FREED_MARK: i32 = 0;

fn free_marker(p: *u8) {
    if p.is_null() { return; }
    let m: *i32 = p as *i32;
    FREED_MARK = { (*m) };
    FREED = FREED + 1;
}

// A timer fake that RECORDS instead of firing, so a test can decide when the
// retry lands — the whole point being that the retry is off the caller's stack.
static ARMED_CB: fn(*u8) = #zero::[fn(*u8)]();
static ARMED_COUNT: i32 = 0;
fn tmr_record(s: f64, cb: fn(*u8), ctx: *u8) -> u64 {
    ARMED_CB = cb;
    ARMED_COUNT = ARMED_COUNT + 1;
    return 21 as u64;
}
fn fire_armed() {
    let cb: fn(*u8) = ARMED_CB;
    ARMED_CB = #zero::[fn(*u8)]();
    if cb.is_not_null() { cb(0 as *u8); }
}

// The ordinary close: nothing in flight, so the free is SYNCHRONOUS and the
// timing is what it was before deferral existed. Worth pinning on its own —
// if this ever became "always deferred" every close would grow a 50ms tail and
// a `leaks` run right after one would report a screen that is merely parked.
#[test]
fn a_free_with_nothing_in_flight_happens_immediately() {
    uninstall_scheduler();
    FREED = 0;
    FREED_MARK = 0;
    var subject: i32 = 77;
    assert jobs_settled();
    free_when_settled(free_marker, #addr_of(subject) as *u8);
    assert FREED == 1;
    assert FREED_MARK == 77;
    assert pending_frees() == (0 as usize);
}

// THE ONE THAT MATTERS. A worker is genuinely inside `run()` — held there from
// this thread, not merely likely to be — and the free must do two things that
// pull in opposite directions: NOT happen, and NOT block.
//
// Not happening is the use-after-free (the screen's memory is what the worker
// is writing into). Not blocking is the freeze: this call stands in for a
// window-close callback on the main thread, and the worker is trying to reach
// that same thread to land its apply. The first attempt at this bug waited
// here and shipped an app that went unresponsive on Close Workspace.
//
// A blocking implementation cannot reach the line after the call at all: the
// hold is only released further down, from this thread. So the reverted fix
// shows up here as a HANG rather than a failure, and that hang is the bug
// report — the app froze for the same reason, on the same thread.
//
// Freeing eagerly, which is what `pushed_closed` did before deferral, fails on
// `FREED == 0` immediately. Both directions are covered; only one of them is
// polite about it.
#[test]
fn a_free_with_a_worker_in_flight_neither_frees_nor_blocks() {
    var sch: Scheduler = scheduler_none();
    sch.after = tmr_record;
    install_scheduler(sch);
    FREED = 0;
    ARMED_COUNT = 0;
    ARMED_CB = #zero::[fn(*u8)]();

    var j: HeldJob = HeldJob { hold: 1 as u64, runs: 0 };
    assert run_job::[HeldJob](j);
    while jobs_in_flight() == (0 as u64) { sched_yield_once(); }

    var subject: i32 = 88;
    free_when_settled(free_marker, #addr_of(subject) as *u8);
    // Returned — with the worker still held. That is the freeze half.
    assert jobs_in_flight() >= (1 as u64);
    // And nothing was freed. That is the use-after-free half.
    assert FREED == 0;
    assert pending_frees() == (1 as usize);
    // A retry is armed, once, off this stack.
    assert ARMED_COUNT == 1;

    // A retry while the worker is STILL inside must not free either, and must
    // arm again rather than give up — a bailout here would be the crash by
    // another route, which is what the `spins > 100000` line in
    // `settle_and_teardown` is warned about for.
    fire_armed();
    assert FREED == 0;
    assert pending_frees() == (1 as usize);
    assert ARMED_COUNT == 2;

    // Let the worker out. Headless (no `run_on_main`), so the flight ends on
    // the worker and the counters reach zero with no apply queued.
    atomic::store_u64({ #addr_of(j.hold) }, 0 as u64, atomic::Ordering::Release);
    wait_for_jobs();
    assert jobs_settled();

    // NOW the retry reclaims it, and stops arming.
    fire_armed();
    assert FREED == 1;
    assert FREED_MARK == 88;
    assert pending_frees() == (0 as usize);
    assert ARMED_COUNT == 2;

    uninstall_scheduler();
}

// `settle_and_teardown` calls this on the way out, when the run loop has
// stopped and the retry timer will never fire again. Without it a screen
// closed moments before a quit would be leaked rather than deferred.
#[test]
fn reclaim_settled_drains_what_a_close_parked() {
    var sch: Scheduler = scheduler_none();
    sch.after = tmr_record;
    install_scheduler(sch);
    FREED = 0;
    ARMED_CB = #zero::[fn(*u8)]();

    var j: HeldJob = HeldJob { hold: 1 as u64, runs: 0 };
    assert run_job::[HeldJob](j);
    while jobs_in_flight() == (0 as u64) { sched_yield_once(); }
    var subject: i32 = 99;
    free_when_settled(free_marker, #addr_of(subject) as *u8);
    // Held: a reclaim now answers "still one parked" and frees nothing.
    assert reclaim_settled() == (1 as usize);
    assert FREED == 0;

    atomic::store_u64({ #addr_of(j.hold) }, 0 as u64, atomic::Ordering::Release);
    wait_for_jobs();
    assert reclaim_settled() == (0 as usize);
    assert FREED == 1;
    assert FREED_MARK == 99;

    ARMED_CB = #zero::[fn(*u8)]();
    uninstall_scheduler();
}

// A SECOND close after a drain must arm again. Found by a test that never
// fired its fake timer: `reclaim_settled` emptied the list but left
// `RECLAIM_ARMED` true, so the next parked free armed nothing and waited for a
// tick that was never coming — a silent permanent leak, and only of the SECOND
// screen, which is the kind of thing that survives a suite.
//
// `settle_and_teardown` calls `reclaim_settled` on every quit, so this is the
// ordinary sequence in any process that closes a screen more than once.
#[test]
fn a_drain_rearms_for_the_next_close() {
    var sch: Scheduler = scheduler_none();
    sch.after = tmr_record;
    install_scheduler(sch);
    FREED = 0;
    ARMED_COUNT = 0;
    ARMED_CB = #zero::[fn(*u8)]();

    // First close, parked and drained WITHOUT the timer ever firing — which is
    // what `settle_and_teardown` does.
    var j: HeldJob = HeldJob { hold: 1 as u64, runs: 0 };
    assert run_job::[HeldJob](j);
    while jobs_in_flight() == (0 as u64) { sched_yield_once(); }
    var first: i32 = 1;
    free_when_settled(free_marker, #addr_of(first) as *u8);
    assert ARMED_COUNT == 1;
    atomic::store_u64({ #addr_of(j.hold) }, 0 as u64, atomic::Ordering::Release);
    wait_for_jobs();
    assert reclaim_settled() == (0 as usize);
    assert FREED == 1;

    // Second close, same shape. It must arm its own retry.
    var j2: HeldJob = HeldJob { hold: 1 as u64, runs: 0 };
    assert run_job::[HeldJob](j2);
    while jobs_in_flight() == (0 as u64) { sched_yield_once(); }
    var second: i32 = 2;
    free_when_settled(free_marker, #addr_of(second) as *u8);
    assert pending_frees() == (1 as usize);
    assert ARMED_COUNT == 2;

    atomic::store_u64({ #addr_of(j2.hold) }, 0 as u64, atomic::Ordering::Release);
    wait_for_jobs();
    fire_armed();
    assert FREED == 2;
    assert FREED_MARK == 2;
    assert pending_frees() == (0 as usize);

    ARMED_CB = #zero::[fn(*u8)]();
    uninstall_scheduler();
}

// No timer primitive at all — a headless build, or a backend that installed
// none. There is no loop to retry on AND no main thread to freeze, so the
// honest answer is the old one: wait, then free. Pinned because the reverted
// fix's failure mode was exactly "waited on a thread that could not afford
// it", and the rule is about WHICH thread, not about waiting being wrong.
#[test]
fn with_no_timer_the_free_waits_rather_than_leaking() {
    uninstall_scheduler();
    FREED = 0;
    ARMED_CB = #zero::[fn(*u8)]();

    var j: HeldJob = HeldJob { hold: 1 as u64, runs: 0 };
    assert run_job::[HeldJob](j);
    while jobs_in_flight() == (0 as u64) { sched_yield_once(); }
    // Released from another thread, so the wait below is a real wait.
    var rel: Releaser = Releaser { hold: { #addr_of(j.hold) } as usize };
    let h: thread::JoinHandle[i32] = thread::spawn_with::[Releaser, i32](rel, release_after_a_moment);

    var subject: i32 = 55;
    free_when_settled(free_marker, #addr_of(subject) as *u8);
    // It waited, and then freed — nothing parked, nothing leaked.
    assert FREED == 1;
    assert FREED_MARK == 55;
    assert pending_frees() == (0 as usize);
    let _r: i32 = h.join();
}

struct Releaser { hold: usize }

fn release_after_a_moment(take r: Releaser) -> i32 {
    let _s: i32 = job_spin(2000000 as i64);
    atomic::store_u64(r.hold as *u64, 0 as u64, atomic::Ordering::Release);
    return 0;
}

// ---- observe_size / after slot discipline -----------------------------------

fn geo_noop(ctx: *u8) { return; }

static OBS_CANCELLED: u64 = 0 as u64;
static TMR_CANCELLED: u64 = 0 as u64;
fn obs_arm_fake(n: *core::Node, cb: fn(*u8), ctx: *u8) -> u64 { return 7 as u64; }
fn obs_cancel_fake(id: u64) { OBS_CANCELLED = id; return; }
fn tmr_arm_fake(s: f64, cb: fn(*u8), ctx: *u8) -> u64 { return 9 as u64; }
fn tmr_cancel_fake(id: u64) { TMR_CANCELLED = id; return; }

#[test]
fn observe_size_cancels_through_its_own_slot_not_the_timer_slot() {
    OBS_CANCELLED = 0 as u64;
    TMR_CANCELLED = 0 as u64;
    // No backend: an already-cancelled handle, the same posture as `after`.
    uninstall_scheduler();
    var none: Cancellable = observe_size(0 as *core::Node, geo_noop);
    assert none.pending() == false;
    // A full Scheduler installed: each Cancellable revokes through the slot
    // family that armed it — an observation must never cancel a timer's id.
    install_scheduler(Scheduler {
        run_on_main: 0 as fn(fn(*u8), *u8),
        after: tmr_arm_fake,
        cancel_after: tmr_cancel_fake,
        observe_size: obs_arm_fake,
        cancel_observe_size: obs_cancel_fake,
    });
    var o: Cancellable = observe_size(0 as *core::Node, geo_noop);
    assert o.pending();
    o.cancel();
    assert OBS_CANCELLED == (7 as u64);
    assert TMR_CANCELLED == (0 as u64);
    assert o.pending() == false;
    o.cancel();                                    // idempotent
    assert OBS_CANCELLED == (7 as u64);
    var t: Cancellable = after(1.0f64, geo_noop);
    t.cancel();
    assert TMR_CANCELLED == (9 as u64);
    // Put the no-backend posture back for the tests that follow.
    uninstall_scheduler();
}

// ---- a scheduler callback IS a bound method ---------------------------------

struct Ticker { ticks: i32 }
impl Ticker {
    fn tick(ref this) { this.ticks = this.ticks + 1; return; }
}

// Fakes that FIRE the callback with the ctx they were handed, so the test
// observes the receiver arriving rather than merely compiling.
fn tmr_fire_now(s: f64, cb: fn(*u8), ctx: *u8) -> u64 { cb(ctx); return 11 as u64; }
fn obs_fire_now(n: *core::Node, cb: fn(*u8), ctx: *u8) -> u64 { cb(ctx); return 12 as u64; }

#[test]
fn a_scheduler_callback_can_be_a_bound_method() {
    // This tier's handler is `fn(*u8)`, and a single parameter is both the
    // first and the LAST — which is where a bound reference reads the
    // receiver from. The `ctx:` slot beside it is adjacent and `*u8`, so the
    // pairing the binding looks for is already there, and `after(t, this.m)`
    // needs no trampoline.
    //
    // Worth pinning: the shape reads like it has "nowhere for the receiver to
    // go", and a screen that believes that writes a top-level fn whose whole
    // body is an unchecked `*u8` cast — for every debounce it has.
    var sch: Scheduler = scheduler_none();
    sch.after = tmr_fire_now;
    sch.observe_size = obs_fire_now;
    install_scheduler(sch);

    var t: Ticker = Ticker { ticks: 0 };
    var a: Cancellable = after(0.0f64, t.tick);
    assert t.ticks == 1;
    var o: Cancellable = observe_size(0 as *core::Node, t.tick);
    assert t.ticks == 2;

    // A free function with an explicit ctx still works — the binding is an
    // addition, not a replacement.
    var u: Ticker = Ticker { ticks: 0 };
    var b: Cancellable = after(0.0f64, tick_free, #addr_of(u) as *u8);
    assert u.ticks == 1;

    uninstall_scheduler();
}

fn tick_free(ctx: *u8) {
    if ctx.is_null() { return; }
    let t: *Ticker = ctx as *Ticker;
    { (*t).tick() };
}

// ---- the apply half of the flight -------------------------------------------

struct ApplyJob {
    ran: i32,
    applied: i32,
}

impl ApplyJob: Job {
    fn run(ref this) { this.ran = this.ran + 1; return; }
    fn apply(ref this) { this.applied = this.applied + 1; return; }
}

fn sj_inline_hop(work: fn(*u8), ctx: *u8) { work(ctx); return; }

#[test]
fn queued_apply_is_counted_and_settles() {
    // With a hop installed, the apply is queued, counted, run, and settles.
    var sch: Scheduler = scheduler_none();
    sch.run_on_main = sj_inline_hop;
    install_scheduler(sch);
    var j: ApplyJob = ApplyJob { ran: 0, applied: 0 };
    run_job::[ApplyJob](j);
    wait_for_jobs();                       // worker done touching `j`...
    while !jobs_settled() { job_spin(1000 as i64); }
    assert j.ran == 1;
    assert j.applied == 1;                 // ...and the apply landed too
    uninstall_scheduler();
    // Headless: no hop, so nothing queues, nothing leaks, apply never runs
    // — and the process still settles.
    var j2: ApplyJob = ApplyJob { ran: 0, applied: 0 };
    run_job::[ApplyJob](j2);
    wait_for_jobs();
    assert jobs_settled();
    assert j2.ran == 1;
    assert j2.applied == 0;
}
