// symbol — a glyph. HAND-WRITTEN: facet's own word, no MAUI row behind it.
//
// MAUI has no glyph vocabulary at all, so this is the first control facet
// declares on its own account. It is recorded as a facet-origin row in
// tools/maui_map.py's FACET_ORIGIN, not left to appear by accident.
//
// Why a control and not `image` with a different source: the styling that
// applies is text-shaped, not box-shaped. A symbol takes a size and a colour;
// an image takes a fit and an alignment. One control carrying both would leave
// half its parameters dead in each case. Flutter reached the same conclusion —
// `Icon` and `Image` are separate widgets — and it is the right call here for
// the same reason.
//
// ---- the three tiers -------------------------------------------------------
//
//   symbol(icons::home)                     the bundled font. PORTABLE, and the
//                                           name is checked at COMPILE time.
//   system_symbol("house.fill")             the platform's own set. macOS reads
//                                           SF Symbols, Linux the freedesktop
//                                           theme, Windows Segoe Fluent. The
//                                           names differ per platform, so this
//                                           is a deliberate, visible choice to
//                                           write platform-specific code — the
//                                           one INTENT blesses.
//   symbol(0xE9B2u32, font: "My Icons")     an application's own icon font.
//                                           Portable, but unchecked: facet has
//                                           no table for a font it never saw.
//
// Only the first can be verified before the program runs, which is why it is
// the recommended one. The other two fail the same way any unresolved glyph
// does — a blank square — and that is stated rather than hidden.
//
// ---- the font ---------------------------------------------------------------
//
// assets/MaterialSymbolsOutlined.ttf: 4,268 icons, Apache 2.0, 927 KB. One
// variable font with the FILL axis kept (0 outline .. 1 filled) and wght, opsz
// and GRAD pinned. Keeping FILL costs ~175 KB and is what carries the filled
// variants an application actually asks for; keeping wght would cost ~750 KB
// and opsz ~1 MB, for differences invisible at the sizes a UI draws.
//
// A backend registers the font once at startup and renders the codepoint
// through its ordinary text stack, so `size` is font size and `color` is the
// foreground colour, both for free. Proved end to end in
// examples/symbol_spike.

import "flex_layout/flex_layout" as flex;
import "stdlib/text" as text;
import "stdlib/option" as option;
import "stdlib/box" as box;
import "./facet" as core;
import "./mount" as mount;
import "./props" as props;
import "./vocabulary" as vocab;

// facet-origin controls take their kind tag from 1000 up. The 38 MAUI-derived
// modules take 1..38 from the generator, so a regeneration can never collide
// with a control facet declared for itself.
const K_SYMBOL: u32 = 1000u32;

const P_ICON: u64 = 1u64;
const P_SIZE: u64 = 2u64;
const P_FILL: u64 = 4u64;
const P_COLOR: u64 = 8u64;
const P_NAME: u64 = 16u64;
const P_FONT: u64 = 32u64;

// Which glyph set resolves the symbol.
enum IconSet {
    // facet's bundled font, or the one named in `font`. Portable.
    Bundled,
    // The platform's own set. Names differ per platform; unchecked.
    System,
}

struct SymbolProps {
    icon: u32,               // codepoint, when the set is Bundled
    name: text::Text,        // the OS's name, when the set is System
    font: text::Text,        // "" = facet's bundled font
    set: IconSet,
    size: f64,
    fill: f64,               // 0 outline .. 1 filled; between the two animates
    color: vocab::Color,
}

impl SymbolProps {
    fn new() -> SymbolProps {
        return SymbolProps {
            icon: 0u32,
            name: text::new(),
            font: text::new(),
            set: IconSet::Bundled,
            size: 16.0f64,
            fill: 0.0f64,
            color: vocab::Color::clear(),   // clear = inherit the text colour
        };
    }
}

fn release_symbol_props(p: *u8) {
    if p == (0 as *u8) { return; }
    let _b: box::Box[SymbolProps] = box::from_raw::[SymbolProps](p);
    return;
}

fn _node(take p: SymbolProps, key: str) -> core::Node {
    return match box::new::[SymbolProps](p) {
        option::Option[box::Box[SymbolProps]]::Some(b) =>
            core::node_with(key, K_SYMBOL, b.into_raw(), release_symbol_props),
        option::Option[box::Box[SymbolProps]]::None =>
            core::node_with(key, K_SYMBOL, 0 as *u8, release_symbol_props),
    };
}

// ---- build -------------------------------------------------------------------

// A glyph from the bundled font. Pass a constant from `icons`, never a literal:
// `symbol(icons::home)`. That is what makes an unknown icon a compile error.
//
// `font` names an application's own icon font, registered by the application;
// leave it empty for facet's. A codepoint in a font facet never saw cannot be
// checked, which is the price of bringing your own.
fn symbol(
    icon: u32,
    key: str = "",
    size: f64 = 16.0f64,
    fill: f64 = 0.0f64,
    color: vocab::Color = vocab::Color::clear(),
    font: str = "",
) -> core::Node {
    var p: SymbolProps = SymbolProps::new();
    p.icon = icon;
    p.size = size;
    p.fill = fill;
    p.color = color;
    p.font = text::from_str(font);
    p.set = IconSet::Bundled;
    return _node(p, key);
}

// A glyph from the PLATFORM's set, named the way that platform names it. macOS
// resolves against SF Symbols, Linux the freedesktop icon theme, Windows Segoe
// Fluent — so the name is only meaningful on the platform it was written for.
//
// A separate verb rather than a parameter, so every platform-specific icon in
// an application is findable with one search.
fn system_symbol(
    name: str,
    key: str = "",
    size: f64 = 16.0f64,
    fill: f64 = 0.0f64,
    color: vocab::Color = vocab::Color::clear(),
) -> core::Node {
    var p: SymbolProps = SymbolProps::new();
    p.name = text::from_str(name);
    p.size = size;
    p.fill = fill;
    p.color = color;
    p.set = IconSet::System;
    return _node(p, key);
}

// ---- live --------------------------------------------------------------------

struct Symbol {
    opaque _p: *core::Node,
    _seen: u64,
}

impl Symbol {
    // Unchecked, so module-private. `from` is the public door.
    fn _of(p: *core::Node) -> Symbol { return Symbol { _p: p, _seen: flex::removal_count() }; }
    fn is_live(this) -> bool { return this._seen == flex::removal_count(); }

    fn _props(this) -> *SymbolProps {
        let d: *core::Data = { (*this._p).data() };
        if d == (0 as *core::Data) { return 0 as *SymbolProps; }
        if { (*d).kind } != K_SYMBOL { return 0 as *SymbolProps; }
        return { (*d).props } as *SymbolProps;
    }

    fn set_icon(this, v: u32) -> Symbol {
        let p: *SymbolProps = this._props();
        if p == (0 as *SymbolProps) { return this; }
        { (*p).icon = v };
        { (*p).set = IconSet::Bundled };
        core::touch(this._p, P_ICON);
        return this;
    }

    fn icon(this) -> u32 {
        let p: *SymbolProps = this._props();
        if p == (0 as *SymbolProps) { return 0u32; }
        return { (*p).icon };
    }

    fn set_name(this, v: str) -> Symbol {
        let p: *SymbolProps = this._props();
        if p == (0 as *SymbolProps) { return this; }
        { (*p).name = text::from_str(v) };
        { (*p).set = IconSet::System };
        core::touch(this._p, P_NAME);
        return this;
    }

    fn name(this) -> str {
        let p: *SymbolProps = this._props();
        if p == (0 as *SymbolProps) { return ""; }
        return { (*p).name.view() };
    }

    fn set_size(this, v: f64) -> Symbol {
        let p: *SymbolProps = this._props();
        if p == (0 as *SymbolProps) { return this; }
        { (*p).size = v };
        core::touch(this._p, P_SIZE);
        return this;
    }

    fn size(this) -> f64 {
        let p: *SymbolProps = this._props();
        if p == (0 as *SymbolProps) { return 0.0f64; }
        return { (*p).size };
    }

    // 0 outline, 1 filled. Between the two is a real position on the font's
    // FILL axis, so a backend may animate it rather than snap.
    fn set_fill(this, v: f64) -> Symbol {
        let p: *SymbolProps = this._props();
        if p == (0 as *SymbolProps) { return this; }
        { (*p).fill = v };
        core::touch(this._p, P_FILL);
        return this;
    }

    fn fill(this) -> f64 {
        let p: *SymbolProps = this._props();
        if p == (0 as *SymbolProps) { return 0.0f64; }
        return { (*p).fill };
    }

    fn is_filled(this) -> bool { return this.fill() >= 0.5f64; }

    fn set_color(this, v: vocab::Color) -> Symbol {
        let p: *SymbolProps = this._props();
        if p == (0 as *SymbolProps) { return this; }
        { (*p).color = v };
        core::touch(this._p, P_COLOR);
        return this;
    }

    fn color(this) -> vocab::Color {
        let p: *SymbolProps = this._props();
        if p == (0 as *SymbolProps) { return vocab::Color::clear(); }
        return { (*p).color };
    }

    fn set_font(this, v: str) -> Symbol {
        let p: *SymbolProps = this._props();
        if p == (0 as *SymbolProps) { return this; }
        { (*p).font = text::from_str(v) };
        core::touch(this._p, P_FONT);
        return this;
    }

    fn font(this) -> str {
        let p: *SymbolProps = this._props();
        if p == (0 as *SymbolProps) { return ""; }
        return { (*p).font.view() };
    }

    // Which set resolves this symbol. `is_portable` is the question worth
    // asking: a System symbol only means something on the platform it names.
    fn is_system(this) -> bool {
        let p: *SymbolProps = this._props();
        if p == (0 as *SymbolProps) { return false; }
        return match { (*p).set } { IconSet::System => true, IconSet::Bundled => false };
    }

    fn is_portable(this) -> bool { return !this.is_system(); }

    fn node(this) -> *core::Node { return this._p; }

    // --- live layout: flex's own names, reachable after mount ---
    fn set_grow(this, v: f64) -> Symbol { core::set_grow(this._p, v); return this; }
    fn set_shrink(this, v: f64) -> Symbol { core::set_shrink(this._p, v); return this; }
    fn set_width(this, v: f64) -> Symbol { core::set_width(this._p, v); return this; }
    fn set_height(this, v: f64) -> Symbol { core::set_height(this._p, v); return this; }
    fn set_width_percent(this, v: f64) -> Symbol { core::set_width_percent(this._p, v); return this; }
    fn set_height_percent(this, v: f64) -> Symbol { core::set_height_percent(this._p, v); return this; }
    fn set_padding(this, v: f64) -> Symbol { core::set_padding(this._p, v); return this; }
    fn set_margin(this, v: f64) -> Symbol { core::set_margin(this._p, v); return this; }
    fn set_gap(this, v: f64) -> Symbol { core::set_gap(this._p, v); return this; }
    fn set_justify(this, v: flex::Justify) -> Symbol { core::set_justify(this._p, v); return this; }
    fn set_align(this, v: flex::Align) -> Symbol { core::set_align(this._p, v); return this; }
    fn set_wrap(this, v: flex::Wrap) -> Symbol { core::set_wrap(this._p, v); return this; }

    // --- the shared band: one-line forwards, no generic element type ---
    fn set_opacity(this, v: f64) -> Symbol { core::set_opacity(this._p, v); return this; }
    fn opacity(this) -> f64 { return core::opacity(this._p); }
    fn set_enabled(this, v: bool) -> Symbol { core::set_enabled(this._p, v); return this; }
    fn is_enabled(this) -> bool { return core::is_enabled(this._p); }
    fn set_visible(this, v: bool) -> Symbol { core::set_visible(this._p, v); return this; }
    fn is_visible(this) -> bool { return core::is_visible(this._p); }
    fn set_background_color(this, v: vocab::Color) -> Symbol { core::set_background_color(this._p, v); return this; }
    fn background_color(this) -> vocab::Color { return core::background_color(this._p); }
    fn set_rotation(this, v: f64) -> Symbol { core::set_rotation(this._p, v); return this; }
    fn rotation(this) -> f64 { return core::rotation(this._p); }
    fn set_scale(this, v: f64) -> Symbol { core::set_scale(this._p, v); return this; }
    fn scale(this) -> f64 { return core::scale(this._p); }
    fn width(this) -> f64 { return core::width_of(this._p); }
    fn height(this) -> f64 { return core::height_of(this._p); }
    fn x(this) -> f64 { return core::x_of(this._p); }
    fn y(this) -> f64 { return core::y_of(this._p); }
    fn bounds(this) -> vocab::Rect { return core::bounds_of(this._p); }
    fn native(this) -> *u8 { return core::native(this._p); }
    fn is_attached(this) -> bool { return core::is_attached(this._p); }
    fn relayout(this) -> Symbol { core::relayout(this._p); return this; }
    fn frame(this) -> core::Frame { return core::frame_of(this._p); }
}

// ---- lookup ------------------------------------------------------------------

// Narrow a node to this control, the DOM step: a node carries what EVERY
// node has, and a checked cast adds what only this control has.
fn from(p: *core::Node) -> option::Option[Symbol] {
    if p == (0 as *core::Node) { return option::Option[Symbol]::None; }
    let d: *core::Data = { (*p).data() };
    if d == (0 as *core::Data) { return option::Option[Symbol]::None; }
    if { (*d).kind } != K_SYMBOL { return option::Option[Symbol]::None; }
    return option::Option[Symbol]::Some(Symbol::_of(p));
}

fn find(key: str, within: *core::Node = 0 as *core::Node) -> option::Option[Symbol] {
    if within != (0 as *core::Node) {
        return match core::find_in(within, key) {
            option::Option[*core::Node]::Some(p) => from(p),
            option::Option[*core::Node]::None => option::Option[Symbol]::None,
        };
    }
    return match mount::find_node(key) {
        option::Option[*core::Node]::Some(p) => from(p),
        option::Option[*core::Node]::None => option::Option[Symbol]::None,
    };
}
