    fn blur(this) -> TextArea { core::blur(this._p); return this; }
    fn relayout(this) -> TextArea { core::relayout(this._p); return this; }
    fn measure(this, width: f64, height: f64) -> vocab::Size { return core::measure(this._p, width, height); }
    fn begin_updates(this) -> TextArea { core::begin_updates(this._p); return this; }
    fn end_updates(this) -> TextArea { core::end_updates(this._p); return this; }
    fn on_focus(this, f: fn(*u8, *u8), ctx: *u8 = 0 as *u8) -> TextArea { core::set_on_focus(this._p, f, ctx); return this; }
    fn on_blur(this, f: fn(*u8, *u8), ctx: *u8 = 0 as *u8) -> TextArea { core::set_on_blur(this._p, f, ctx); return this; }
    fn on_attach(this, f: fn(*u8, *u8), ctx: *u8 = 0 as *u8) -> TextArea { core::set_on_attach(this._p, f, ctx); return this; }
    fn on_detach(this, f: fn(*u8, *u8), ctx: *u8 = 0 as *u8) -> TextArea { core::set_on_detach(this._p, f, ctx); return this; }
    fn frame(this) -> core::Frame { return core::frame_of(this._p); }
}

// ---- lookup ------------------------------------------------------------
// `from` narrows a node to this control, the DOM step: a node carries what
// EVERY node has, and a checked cast adds what only a text_area has. `None` on
// a wrong kind — never a cursor whose every verb silently does nothing.

fn from(p: *core::Node) -> option::Option[TextArea] {
    if p == (0 as *core::Node) { return option::Option[TextArea]::None; }
    let d: *core::Data = { (*p).data() };
    if d == (0 as *core::Data) { return option::Option[TextArea]::None; }
    if { (*d).kind } != props::K_TEXT_AREA { return option::Option[TextArea]::None; }
    return option::Option[TextArea]::Some(TextArea::_of(p));
}

// Resolve a key, then narrow through the same checked door.

// `within:` and not `in:` — `in` is a C+ keyword. Defaults to the
// mounted tree, so an agent holding only a key can address it; pass a
// subtree to scope the search (stages/3, the global find).
fn find(key: str, within: *core::Node = mount::mounted_root()) -> option::Option[TextArea] {
    if within == (0 as *core::Node) { return option::Option[TextArea]::None; }
    return match core::find_in(within, key) {
        option::Option[*core::Node]::Some(p) => from(p),
        option::Option[*core::Node]::None => option::Option[TextArea]::None,
    };
}
