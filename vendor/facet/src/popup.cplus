    fn animate_rotation(this, to: f64, duration: vocab::Duration = vocab::Duration::animation(), easing: vocab::Easing = vocab::Easing::SinInOut) -> Popup { core::animate_rotation(this._p, to, duration, easing); return this; }
    fn animate_rotation_x(this, to: f64, duration: vocab::Duration = vocab::Duration::animation(), easing: vocab::Easing = vocab::Easing::SinInOut) -> Popup { core::animate_rotation_x(this._p, to, duration, easing); return this; }
    fn animate_rotation_y(this, to: f64, duration: vocab::Duration = vocab::Duration::animation(), easing: vocab::Easing = vocab::Easing::SinInOut) -> Popup { core::animate_rotation_y(this._p, to, duration, easing); return this; }
    fn animate_translation(this, x: f64, y: f64, duration: vocab::Duration = vocab::Duration::animation(), easing: vocab::Easing = vocab::Easing::SinInOut) -> Popup { core::animate_translation(this._p, x, y, duration, easing); return this; }
    fn cancel_animations(this) -> Popup { core::cancel_animations(this._p); return this; }
    fn relayout(this) -> Popup { core::relayout(this._p); return this; }
    fn measure(this, width: f64, height: f64) -> vocab::Size { return core::measure(this._p, width, height); }
    fn begin_updates(this) -> Popup { core::begin_updates(this._p); return this; }
    fn end_updates(this) -> Popup { core::end_updates(this._p); return this; }
    fn on_focus(this, f: fn(*u8, *u8), ctx: *u8 = 0 as *u8) -> Popup { core::set_on_focus(this._p, f, ctx); return this; }
    fn on_blur(this, f: fn(*u8, *u8), ctx: *u8 = 0 as *u8) -> Popup { core::set_on_blur(this._p, f, ctx); return this; }
    fn on_attach(this, f: fn(*u8, *u8), ctx: *u8 = 0 as *u8) -> Popup { core::set_on_attach(this._p, f, ctx); return this; }
    fn on_detach(this, f: fn(*u8, *u8), ctx: *u8 = 0 as *u8) -> Popup { core::set_on_detach(this._p, f, ctx); return this; }
    fn frame(this) -> core::Frame { return core::frame_of(this._p); }
}

// ---- lookup ------------------------------------------------------------
// `from` narrows a node to this control, the DOM step: a node carries what
// EVERY node has, and a checked cast adds what only a popup has. `None` on
// a wrong kind — never a cursor whose every verb silently does nothing.

fn from(p: *core::Node) -> option::Option[Popup] {
    if p == (0 as *core::Node) { return option::Option[Popup]::None; }
    let d: *core::Data = { (*p).data() };
    if d == (0 as *core::Data) { return option::Option[Popup]::None; }
    if { (*d).kind } != props::K_POPUP { return option::Option[Popup]::None; }
    return option::Option[Popup]::Some(Popup::_of(p));
}

// Resolve a key, then narrow through the same checked door.

// `within:` and not `in:` — `in` is a C+ keyword. Bare `find` is the
// DOM rule: the running app's windows in open order, first match wins;
// pass `within:` to scope a subtree (or disambiguate across windows).
fn find(key: str, within: *core::Node = 0 as *core::Node) -> option::Option[Popup] {
    if within != (0 as *core::Node) {
        return match core::find_in(within, key) {
            option::Option[*core::Node]::Some(p) => { _report_kind(key, p); from(p) }
            option::Option[*core::Node]::None => option::Option[Popup]::None,
        };
    }
    return match mount::find_node(key) {
        option::Option[*core::Node]::Some(p) => { _report_kind(key, p); from(p) }
        option::Option[*core::Node]::None => option::Option[Popup]::None,
    };
}

// The debug posture's third distinction (FACET_DEBUG_FIND=1): the key
// RESOLVED, and `from` is about to answer None anyway because the node is
// another control. `_`-private; costs one flag read when the posture is off.
fn _report_kind(key: str, p: *core::Node) {
    if !mount::find_debugging() { return; }
    if p == (0 as *core::Node) { return; }
    let d: *core::Data = { (*p).data() };
    if d == (0 as *core::Data) || { (*d).kind } != props::K_POPUP {
        mount::debug_find_wrong_kind(key, "popup");
    }
    return;
}
