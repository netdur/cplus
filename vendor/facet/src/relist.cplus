// relist — a recycled list over an observable collection.
//
// `list` is a count and a builder the application keeps in step by hand:
// append to your Vec, then remember to say `set_count`. `relist` is handed the
// collection itself, so there is nothing to keep in step — the app appends and
// the list already knows.
//
//     relist(this.rows, key: "inbox", builder: this.build_row).grow(1.0f64)
//
// THE COLLECTION IS PASSED AS A BARE PLACE. `T` is inferred from it and the
// element keeps its address for the life of the tree; the application writes
// nothing that starts with `#`. Both halves are measured, not assumed — see
// `plans/facet/relist.md`.
//
// WHAT IS NOT HERE, on purpose: selection, sections, headers, an empty state,
// pagination, reorder, delete. Each is either the app's own state plus a
// gesture on the row (selection), or a row the builder chooses to build (a
// header, a loading footer), or a wrapper around the list (`refreshable`).
// `list` grew all of them as props and that is why it has three height
// mechanisms and no precedence rule between them. This element stays a
// collection, a builder and a key.
//
// ---- how `T` gets out of the way -------------------------------------------
//
// A node's props are `*u8`, so the collection has to be erased — and reading a
// count back out of it needs `T` again. The seam is a MONOMORPHIZED FREE FN
// whose address is stored beside the erased pointer: `relist[T]` fills
// `count_of` with `_count_of::[T]`, and the backend calls it knowing no `T` at
// all. Verified before this file was written; two instantiations do not
// collide.

import "stdlib/option" as option;
import "stdlib/status" as status;
import "stdlib/box" as box;
import "flex_layout/flex_layout" as flex;
import "events/events" as events;
import "./facet" as core;
import "./mount" as mount;
import "./obs_vec" as obs_vec;

// The next free hand-written kind. symbol 1000, tree 1001, split 1002,
// window_buttons 1003, text_button 1004.
const K_RELIST: u32 = 1005u32;

// THE SEQUENCE CHANGED — rows appeared, went away, or hold different values.
// One bit, because the detail rides in the pending change below rather than in
// the bit: a bit per kind would still have to carry `at` somewhere.
const P_ROWS: u64 = 1u64;
// The builder was replaced. Every row has to be built again.
const P_BUILDER: u64 = 2u64;

fn no_builder(index: usize, ctx: *u8) -> flex::Node { return flex::Node::new(); }

fn no_count(rows: *u8) -> usize { return 0 as usize; }

struct RelistProps {
    // The application's collection, erased. `opaque`: the APP owns it, this is
    // a borrow that must not outlive it — which is the contract the element
    // makes by taking a bare place, and the one an app breaks by dropping its
    // collection while the tree is still up.
    opaque rows: *u8,
    // `T` put back, exactly where it is needed and nowhere else.
    count_of: fn(*u8) -> usize,
    builder: fn(usize, *u8) -> flex::Node,
    opaque builder_ctx: *u8,
    // THE NODE THIS ELEMENT IS, re-read on every apply by the backend the way
    // `apply_recycling_tree` has always re-read its own. The change handler
    // needs it to raise a dirty bit, and it cannot be captured at construction:
    // the node is returned BY VALUE and moved into the tree, so its address
    // here is not its address there.
    opaque node: *core::Node,
    // The change that has not been applied yet. A handler cannot walk the tree
    // — it runs on whatever stack the app's `append` was called from — so it
    // records what happened and raises the bit; the sync walk does the work.
    //
    // COALESCED TOWARDS `Reload`: two precise changes between one pair of
    // applies cannot be described by one `Change`, and guessing is how a
    // spliced sequence ends up one row out. Precision is the fast path for the
    // common case of one edit per frame, not a promise to track every case.
    pending: obs_vec::Change,
    has_pending: bool,
    // DO THIS LIST'S ROWS DIFFER IN HEIGHT?
    //
    // `false` — they are all the same — is the default and the fast path, and
    // it is the same default `list` has under the name `has_uneven_rows`. It
    // matters more here than it does there, because a row with no stated
    // height is measured by REALISING it: uniform means one realise for the
    // whole list, uneven means one per row.
    //
    // Measured on 5000 rows: 46 realises to show a uniform list against 646
    // for an uneven one, and under a hard flick no dropped frames against
    // three in sixty.
    //
    // Saying `true` when rows are the same costs speed. Saying `false` when
    // they are NOT gives every row the first row's height, so it is a claim
    // about the model rather than a hint — which is why it is stated rather
    // than guessed.
    uneven_rows: bool,
    // The subscription, owned. Dropping the props cancels it — which is why it
    // is stored rather than detached: a listener that outlives the props reads
    // `ctx` as a freed pointer on the next append.
    sub: events::SignalSubscription[obs_vec::Change],
}

impl RelistProps {
    fn new() -> RelistProps {
        return RelistProps {
            rows: 0 as *u8,
            count_of: no_count,
            builder: no_builder,
            builder_ctx: 0 as *u8,
            node: 0 as *core::Node,
            pending: obs_vec::Change::reload(),
            has_pending: false,
            uneven_rows: false,
            sub: events::SignalSubscription[obs_vec::Change]::none(),
        };
    }
}

fn release_relist_props(p: *u8) {
    if p.is_null() { return; }
    // The subscription goes with them: `SignalSubscription`'s own drop cancels,
    // so this is the whole unsubscribe. It has to happen, and this is the only
    // place it can — a listener that outlived these props would hand the
    // handler a freed `ctx` on the app's next append.
    let _b: box::Box[RelistProps] = box::from_raw::[RelistProps](p);
}

// `T` PUT BACK. Two monomorphized readers, whose addresses are what erasure
// actually means here.
fn _count_of[T](rows: *u8) -> usize {
    let o: *obs_vec::ObsVec[T] = { rows as *obs_vec::ObsVec[T] };
    if o.is_null() { return 0 as usize; }
    return { (*o).count() };
}

fn _signal_of[T](rows: *u8) -> *events::Signal[obs_vec::Change] {
    let o: *obs_vec::ObsVec[T] = { rows as *obs_vec::ObsVec[T] };
    if o.is_null() { return 0 as *events::Signal[obs_vec::Change]; }
    return #addr_of((*o).changed);
}

// The collection said something. Record it and raise the bit.
//
// `ctx` is the PROPS, which are boxed and therefore have an address that is
// stable from the moment they exist — unlike the node, which is still a value
// on the caller's stack when this subscription is made.
fn _on_change(c: obs_vec::Change, ctx: *u8) {
    let p: *RelistProps = { ctx as *RelistProps };
    if p.is_null() { return; }
    if { (*p).has_pending } {
        // A SECOND CHANGE BEFORE THE FIRST WAS APPLIED. Two precise changes do
        // not compose into one, so the pair becomes a reload rather than a
        // guess — an insert at 2 followed by a remove at 5 describes neither.
        { (*p).pending = obs_vec::Change::reload() };
    } else {
        { (*p).pending = c };
        { (*p).has_pending = true };
    }
    // RECORD FIRST, RAISE SECOND, and never the other way round. Before the
    // backend has said which node this is, `node` is null — `core::touch`
    // null-guards, so the raise is simply a no-op — but the change must still
    // be RECORDED, because the first apply is what will read it. Returning
    // early on a null node would drop every edit made between construction and
    // mount, which is exactly where an app fills a list it just described.
    core::touch({ (*p).node }, P_ROWS);
    return;
}

// ---- the element -------------------------------------------------------------

fn relist[T](
    ref rows: obs_vec::ObsVec[T],
    key: str = "",
    builder: fn(usize, *u8) -> flex::Node = no_builder,
    builder_ctx: *u8 = 0 as *u8,
    uneven_rows: bool = false,
) -> core::Node {
    var p: RelistProps = RelistProps::new();
    p.rows = { #addr_of(rows) as *u8 };
    p.count_of = _count_of::[T];
    p.builder = builder;
    p.builder_ctx = builder_ctx;
    p.uneven_rows = uneven_rows;
    return match box::new::[RelistProps](p) {
        option::Option[box::Box[RelistProps]]::Some(b) => {
            let pp: *RelistProps = { b.into_raw() } as *RelistProps;
            // SUBSCRIBE ONLY NOW. The props have a stable address from the
            // moment they are boxed, and that address is what the handler is
            // handed back — so the subscription is made here rather than above,
            // where `p` is still a local about to be moved.
            let sig: *events::Signal[obs_vec::Change] =
                _signal_of::[T]({ #addr_of(rows) as *u8 });
            if sig.is_not_null() {
                { (*pp).sub = { (*sig).on(_on_change, pp as *u8) } };
            }
            core::node_with(key, K_RELIST, pp as *u8, release_relist_props)
        }
        option::Option[box::Box[RelistProps]]::None =>
            core::node_with(key, K_RELIST, 0 as *u8, release_relist_props),
    };
}

// The change kind as a number, for a backend that wants to switch on it
// without re-deriving the mapping. Kept HERE so the numbering has one owner —
// a backend that wrote its own would drift the moment a kind is added.
fn change_kind_num(k: obs_vec::ChangeKind) -> i64 {
    return match k {
        obs_vec::ChangeKind::Reload => 0 as i64,
        obs_vec::ChangeKind::Inserted => 1 as i64,
        obs_vec::ChangeKind::Removed => 2 as i64,
        obs_vec::ChangeKind::Changed => 3 as i64,
    };
}

// ---- the cursor --------------------------------------------------------------

struct Relist {
    opaque _p: *core::Node,
}

impl Relist {
    fn _of(p: *core::Node) -> Relist { return Relist { _p: p }; }

    fn _props(this) -> *RelistProps {
        return props_of(this._p);
    }

    fn node(this) -> *core::Node { return this._p; }

    // How many rows the collection holds RIGHT NOW, asked through the erased
    // reader. Not a stored count: a stored one is the thing an application has
    // to remember to update, which is the whole reason this element exists.
    fn count(this) -> usize {
        let p: *RelistProps = this._props();
        if p.is_null() { return 0 as usize; }
        let f: fn(*u8) -> usize = { (*p).count_of };
        return f({ (*p).rows });
    }

    // Build row `at`, reading the model as it is now.
    fn build_row(this, at: usize) -> core::Node {
        let p: *RelistProps = this._props();
        if p.is_null() { return flex::Node::new(); }
        let f: fn(usize, *u8) -> flex::Node = { (*p).builder };
        return f(at, { (*p).builder_ctx });
    }

    // Replace the builder. Every row is built again — the shape changed, not
    // the data.
    fn set_builder(this, f: fn(usize, *u8) -> flex::Node, ctx: *u8 = 0 as *u8) -> Relist {
        let p: *RelistProps = this._props();
        if p.is_null() { return this; }
        { (*p).builder = f };
        { (*p).builder_ctx = ctx };
        core::touch(this._p, P_BUILDER);
        return this;
    }

    fn set_uneven_rows(this, v: bool) -> Relist {
        let p: *RelistProps = this._props();
        if p.is_null() { return this; }
        { (*p).uneven_rows = v };
        // THE ROW BAND: it changes what a row measures, which is part of
        // describing what a row IS.
        core::touch(this._p, P_ROWS);
        return this;
    }

    fn uneven_rows(this) -> bool {
        let p: *RelistProps = this._props();
        if p.is_null() { return false; }
        return { (*p).uneven_rows };
    }

    // The change waiting to be applied, and whether there is one. The backend's
    // two questions; `take_pending` clears it, because a change applied twice
    // is a sequence spliced twice.
    fn has_pending(this) -> bool {
        let p: *RelistProps = this._props();
        if p.is_null() { return false; }
        return { (*p).has_pending };
    }

    fn take_pending(this) -> obs_vec::Change {
        let p: *RelistProps = this._props();
        if p.is_null() { return obs_vec::Change::reload(); }
        let c: obs_vec::Change = { (*p).pending };
        { (*p).has_pending = false };
        return c;
    }

    // The backend says which node it is applying, every pass — the discipline
    // `apply_recycling_tree` has always had and the list did not, which cost a
    // SEGV (`bugs/closed/a-table-row-callback-reads-a-node-that-is-gone.md`).
    fn bind_node(this) -> Relist {
        let p: *RelistProps = this._props();
        if p.is_null() { return this; }
        { (*p).node = this._p };
        return this;
    }
}

fn props_of(p: *core::Node) -> *RelistProps {
    if p.is_null() { return 0 as *RelistProps; }
    let d: *core::Data = { (*p).data() };
    if d.is_null() { return 0 as *RelistProps; }
    if { (*d).kind } != K_RELIST { return 0 as *RelistProps; }
    return { (*d).props } as *RelistProps;
}

fn from(p: *core::Node) -> option::Option[Relist] {
    if p.is_null() { return option::Option[Relist]::None; }
    let d: *core::Data = { (*p).data() };
    if d.is_null() { return option::Option[Relist]::None; }
    if { (*d).kind } != K_RELIST { return option::Option[Relist]::None; }
    return option::Option[Relist]::Some(Relist::_of(p));
}

fn find(key: str, within: *core::Node = 0 as *core::Node) -> option::Option[Relist] {
    if within.is_not_null() {
        return match core::find_in(within, key) {
            option::Option[*core::Node]::Some(p) => from(p),
            option::Option[*core::Node]::None => option::Option[Relist]::None,
        };
    }
    return match mount::find_node(key) {
        option::Option[*core::Node]::Some(p) => from(p),
        option::Option[*core::Node]::None => option::Option[Relist]::None,
    };
}

// ───────────────────────────── tests ─────────────────────────────

struct _Entry { n: i32 }

static RL_BUILT: i64 = 0 as i64;

fn _row(index: usize, ctx: *u8) -> flex::Node {
    RL_BUILT = RL_BUILT + (1 as i64);
    return flex::Node::new();
}

#[test]
fn a_relist_counts_the_collection_it_was_handed() {
    // The element holds no count of its own. That is the whole difference from
    // `list`: a stored count is the thing an application has to remember to
    // update, and forgetting is silent.
    var rows: obs_vec::ObsVec[_Entry] = obs_vec::ObsVec[_Entry]::new();
    let _a: status::Status = rows.append(_Entry { n: 1 });
    let _b: status::Status = rows.append(_Entry { n: 2 });

    var n: core::Node = relist(rows, key: "inbox", builder: _row);
    let np: *core::Node = #addr_of(n);
    match from(np) {
        option::Option[Relist]::Some(h) => {
            assert h.count() == (2 as usize);
            // ...and the app appends WITHOUT telling the list anything.
            let _c: status::Status = rows.append(_Entry { n: 3 });
            assert h.count() == (3 as usize);
        }
        option::Option[Relist]::None => { assert false; }
    }
}

#[test]
fn a_relist_builds_a_row_only_when_asked() {
    // Ten thousand rows must not cost ten thousand builds — the promise every
    // recycling list makes, and the one `relist` keeps by holding a builder
    // rather than children.
    RL_BUILT = 0 as i64;
    var rows: obs_vec::ObsVec[_Entry] = obs_vec::ObsVec[_Entry]::new();
    var i: i32 = 0;
    while i < 100 {
        let _a: status::Status = rows.append(_Entry { n: i });
        i = i +% 1;
    }
    var n: core::Node = relist(rows, key: "big", builder: _row);
    let np: *core::Node = #addr_of(n);
    match from(np) {
        option::Option[Relist]::Some(h) => {
            assert h.count() == (100 as usize);
            assert RL_BUILT == (0 as i64);          // nothing built yet
            let _r: core::Node = h.build_row(7 as usize);
            assert RL_BUILT == (1 as i64);          // exactly the one asked for
        }
        option::Option[Relist]::None => { assert false; }
    }
}

#[test]
fn an_append_reaches_the_element_as_a_pending_change() {
    // The app writes to its own collection and the element learns about it,
    // which is the entire point. The handler records rather than acts: it runs
    // on whatever stack `append` was called from, and walking a tree from
    // there is how a bind re-enters its own list.
    var rows: obs_vec::ObsVec[_Entry] = obs_vec::ObsVec[_Entry]::new();
    let _a: status::Status = rows.append(_Entry { n: 1 });
    var n: core::Node = relist(rows, key: "p", builder: _row);
    let np: *core::Node = #addr_of(n);
    match from(np) {
        option::Option[Relist]::Some(h) => {
            assert h.has_pending() == false;
            let _b: status::Status = rows.append(_Entry { n: 2 });
            assert h.has_pending();
            let c: obs_vec::Change = h.take_pending();
            assert change_kind_num(c.kind) == (1 as i64);     // Inserted
            assert c.at == (1 as usize);                // ...at the end, which was 1
            // TAKEN, not peeked: a change applied twice splices a sequence twice.
            assert h.has_pending() == false;
        }
        option::Option[Relist]::None => { assert false; }
    }
}

#[test]
fn two_changes_before_one_apply_become_a_reload() {
    // Two precise changes do not compose into one. An insert at 2 followed by a
    // remove at 5 describes neither, and a backend that spliced the second
    // against the first sequence would be one row out from then on. Coalescing
    // TOWARDS reload is the answer that cannot be wrong.
    var rows: obs_vec::ObsVec[_Entry] = obs_vec::ObsVec[_Entry]::new();
    let _a: status::Status = rows.append(_Entry { n: 1 });
    var n: core::Node = relist(rows, key: "c", builder: _row);
    let np: *core::Node = #addr_of(n);
    match from(np) {
        option::Option[Relist]::Some(h) => {
            let _b: status::Status = rows.append(_Entry { n: 2 });
            let _c: status::Status = rows.append(_Entry { n: 3 });
            assert h.has_pending();
            let c: obs_vec::Change = h.take_pending();
            assert change_kind_num(c.kind) == (0 as i64);     // Reload, not Inserted
        }
        option::Option[Relist]::None => { assert false; }
    }
}

#[test]
fn a_change_before_the_first_apply_is_still_recorded() {
    // THE NEGATIVE HALF OF THE NODE POINTER, and the claim is about RECORDING,
    // not about the guard: `core::touch` already null-guards, so raising the
    // bit on an unmounted element is a no-op either way. What matters is that
    // the change is still written down — an app fills a list right after
    // describing it, before anything has mounted, and a handler that returned
    // early on a null node would drop every one of those edits.
    var rows: obs_vec::ObsVec[_Entry] = obs_vec::ObsVec[_Entry]::new();
    var n: core::Node = relist(rows, key: "nb", builder: _row);
    let np: *core::Node = #addr_of(n);
    match from(np) {
        option::Option[Relist]::Some(h) => {
            // `bind_node` has not been called, so `node` is null.
            let _a: status::Status = rows.append(_Entry { n: 1 });
            assert h.has_pending();                     // recorded...
            assert h.count() == (1 as usize);           // ...and readable
        }
        option::Option[Relist]::None => { assert false; }
    }
}

#[test]
fn binding_the_node_lets_a_change_raise_the_dirty_bit() {
    var rows: obs_vec::ObsVec[_Entry] = obs_vec::ObsVec[_Entry]::new();
    var n: core::Node = relist(rows, key: "db", builder: _row);
    let np: *core::Node = #addr_of(n);
    match from(np) {
        option::Option[Relist]::Some(h) => {
            let _b: Relist = h.bind_node();
            core::clear_dirty(np);
            assert core::dirty_of(np) == (0 as u64);
            let _a: status::Status = rows.append(_Entry { n: 1 });
            assert (core::dirty_of(np) & P_ROWS) != (0 as u64);
        }
        option::Option[Relist]::None => { assert false; }
    }
}

#[test]
fn a_relist_with_no_builder_answers_an_empty_row() {
    // The negative half of the builder: absent is not an error, it is an empty
    // row — the same answer `no_row` gives on `list`.
    var rows: obs_vec::ObsVec[_Entry] = obs_vec::ObsVec[_Entry]::new();
    let _a: status::Status = rows.append(_Entry { n: 1 });
    var n: core::Node = relist(rows, key: "nb2");
    let np: *core::Node = #addr_of(n);
    match from(np) {
        option::Option[Relist]::Some(h) => {
            assert h.count() == (1 as usize);
            let _r: core::Node = h.build_row(0 as usize);
        }
        option::Option[Relist]::None => { assert false; }
    }
}

#[test]
fn a_node_that_is_not_a_relist_is_not_narrowed() {
    // The checked cast, which is what makes `find` safe to call on any key.
    var b: core::Builder = core::Builder::new();
    var col: core::Node = core::column(b, key: "plain");
    match from(#addr_of(col)) {
        option::Option[Relist]::Some(_h) => { assert false; }
        option::Option[Relist]::None => { }
    }
}
