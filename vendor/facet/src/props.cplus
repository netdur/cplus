// Per-control state. One struct per control plus the tagged union the tree
// carries: C+ has no inheritance and no dynamic dispatch, so a tree of mixed
// widgets is a tree of ONE concrete node type, and the widget's own state
// travels in a variant.

import "stdlib/text" as text;
import "./vocabulary" as vocab;
import "stdlib/box" as box;

// The 21 write rows every element carries (MAUI VisualElement), minus the
// ones flex already owns (z_index is style.z_index) and the ones only the
// platform knows (focus, native, is_attached). Inline in Data, not boxed:
// every node has exactly one, so there is no allocation and no cast.
struct CommonProps {
    opacity: f64,                       // VisualElement.Opacity
    background_color: vocab::Color,     // VisualElement.BackgroundColor
    is_enabled: bool,                   // VisualElement.IsEnabled
    is_visible: bool,                   // VisualElement.IsVisible
    input_transparent: bool,            // VisualElement.InputTransparent
    flow_direction: vocab::FlowDirection, // VisualElement.FlowDirection
    rotation: f64,                      // VisualElement.Rotation
    rotation_x: f64,                    // VisualElement.RotationX
    rotation_y: f64,                    // VisualElement.RotationY
    scale: f64,                         // VisualElement.Scale
    scale_x: f64,                       // VisualElement.ScaleX
    scale_y: f64,                       // VisualElement.ScaleY
    translation_x: f64,                 // VisualElement.TranslationX
    translation_y: f64,                 // VisualElement.TranslationY
    anchor_x: f64,                      // VisualElement.AnchorX
    anchor_y: f64,                      // VisualElement.AnchorY
}

impl CommonProps {
    fn new() -> CommonProps {
        return CommonProps {
            opacity: 1.0f64,
            background_color: vocab::Color::clear(),
            is_enabled: true,
            is_visible: true,
            input_transparent: false,
            flow_direction: vocab::FlowDirection::MatchParent,
            rotation: 0.0f64, rotation_x: 0.0f64, rotation_y: 0.0f64,
            scale: 1.0f64, scale_x: 1.0f64, scale_y: 1.0f64,
            translation_x: 0.0f64, translation_y: 0.0f64,
            anchor_x: 0.5f64, anchor_y: 0.5f64,
        };
    }
}

// Dirty bits for the common band. Control bits start at C_NEXT.
const C_OPACITY: u64 = 281474976710656u64;
const C_BACKGROUND_COLOR: u64 = 562949953421312u64;
const C_IS_ENABLED: u64 = 1125899906842624u64;
const C_IS_VISIBLE: u64 = 2251799813685248u64;
const C_INPUT_TRANSPARENT: u64 = 4503599627370496u64;
const C_FLOW_DIRECTION: u64 = 9007199254740992u64;
const C_TRANSFORM: u64 = 18014398509481984u64;   // rotation/scale/translation/anchor

// Button — 14 write rows, 1 read row, 3 event rows.
struct ButtonProps {
    label: text::Text,                  // Button.Text
    text_color: vocab::Color,           // Button.TextColor
    border_color: vocab::Color,         // Button.BorderColor
    border_width: f64,                  // Button.BorderWidth
    corner_radius: vocab::Corners,      // Button.CornerRadius
    character_spacing: f64,             // Button.CharacterSpacing
