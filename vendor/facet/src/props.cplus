    is_italic: bool,    // Button.FontAttributes (italic axis)
    font_scales: bool,    // Button.FontAutoScalingEnabled
    font_family: text::Text,    // Button.FontFamily
    font_size: f64,    // Button.FontSize
    image: text::Text,    // Button.ImageSource
    line_break: vocab::LineBreak,    // Button.LineBreakMode
    title: text::Text,    // Button.Text
    text_color: vocab::Color,    // Button.TextColor
    text_transform: vocab::TextTransform,    // Button.TextTransform
    is_pressed: bool,    // Button.IsPressed
    on_click: fn(*u8, *u8),    // Button.Clicked
    opaque on_click_ctx: *u8,
    on_pressed: fn(*u8, *u8),    // Button.Pressed
