// The control kind a node carries. Data holds this tag plus a pointer to the
// matching *Props struct — NOT a tagged union: an enum payload cannot be
// reached through a raw pointer (E0509, the attachment hands us one), and a
// union would also size every node by its largest variant.
const K_BUTTON: u32 = 1u32;

fn release_button_props(p: *u8) {
    if p == (0 as *u8) { return; }
    let _b: box::Box[ButtonProps] = box::from_raw::[ButtonProps](p);
    return;
}
