    style: vocab::TableStyle,    // TableView.Intent
    row_height: i64,    // TableView.RowHeight
}

impl TableProps {
    fn new() -> TableProps {
        return TableProps {
            has_uneven_rows: false,
            style: vocab::TableStyle::Data,
            row_height: 0 as i64,
        };
    }
}

const K_TABLE: u32 = 35u32;

fn release_table_props(p: *u8) {
    if p == (0 as *u8) { return; }
    let _b: box::Box[TableProps] = box::from_raw::[TableProps](p);
    return;
}

// ---- time_picker — the ledger TimePicker -------------------------

struct TimePickerProps {
    character_spacing: f64,    // TimePicker.CharacterSpacing
    font_weight: vocab::FontWeight,    // TimePicker.FontAttributes
    is_italic: bool,    // TimePicker.FontAttributes (italic axis)
    font_scales: bool,    // TimePicker.FontAutoScalingEnabled
    font_family: text::Text,    // TimePicker.FontFamily
    font_size: f64,    // TimePicker.FontSize
    format: text::Text,    // TimePicker.Format
    is_open: bool,    // TimePicker.IsOpen
    text_color: vocab::Color,    // TimePicker.TextColor
    time: vocab::Duration,    // TimePicker.Time
    on_closed: fn(*u8, *u8),    // TimePicker.Closed
    opaque on_closed_ctx: *u8,
    on_opened: fn(*u8, *u8),    // TimePicker.Opened
    opaque on_opened_ctx: *u8,
    on_time_selected: fn(*u8, *u8),    // TimePicker.TimeSelected
    opaque on_time_selected_ctx: *u8,
}

impl TimePickerProps {
    fn new() -> TimePickerProps {
        return TimePickerProps {
            character_spacing: 0.0f64,
            font_weight: vocab::FontWeight::Default,
            is_italic: false,
            font_scales: true,
            font_family: text::new(),
            font_size: 0.0f64,
            format: text::new(),
            is_open: false,
            text_color: vocab::Color::clear(),
            time: vocab::Duration::zero(),
            on_closed: no_handler,
            on_closed_ctx: 0 as *u8,
            on_opened: no_handler,
            on_opened_ctx: 0 as *u8,
            on_time_selected: no_handler,
            on_time_selected_ctx: 0 as *u8,
        };
    }
}

const K_TIME_PICKER: u32 = 36u32;

fn release_time_picker_props(p: *u8) {
    if p == (0 as *u8) { return; }
    let _b: box::Box[TimePickerProps] = box::from_raw::[TimePickerProps](p);
    return;
}

// ---- toolbar_item — the ledger ToolbarItem -----------------------

struct ToolbarItemProps {
    menu_item: MenuItemProps,    // embedded, not restated
    placement: vocab::ToolbarPlacement,    // ToolbarItem.Order
    priority: i64,    // ToolbarItem.Priority
}

impl ToolbarItemProps {
    fn new() -> ToolbarItemProps {
        return ToolbarItemProps {
            menu_item: MenuItemProps::new(),
            placement: vocab::ToolbarPlacement::Default,
            priority: 0 as i64,
        };
    }
}

const K_TOOLBAR_ITEM: u32 = 37u32;

fn release_toolbar_item_props(p: *u8) {
    if p == (0 as *u8) { return; }
    let _b: box::Box[ToolbarItemProps] = box::from_raw::[ToolbarItemProps](p);
    return;
}

// ---- web — the ledger WebView ------------------------------------

struct WebProps {
    source: text::Text,    // WebView.Source
    user_agent: text::Text,    // WebView.UserAgent
    can_go_back: bool,    // WebView.CanGoBack
    can_go_forward: bool,    // WebView.CanGoForward
    on_navigated: fn(*u8, *u8),    // WebView.Navigated
    opaque on_navigated_ctx: *u8,
    on_navigating: fn(*u8, *u8),    // WebView.Navigating
    opaque on_navigating_ctx: *u8,
    on_process_terminated: fn(*u8, *u8),    // WebView.ProcessTerminated
    opaque on_process_terminated_ctx: *u8,
    eval_script: text::Text,    // WebView.Eval, the argument of eval()
}

impl WebProps {
    fn new() -> WebProps {
        return WebProps {
            source: text::new(),
            user_agent: text::new(),
            can_go_back: false,
            can_go_forward: false,
            on_navigated: no_handler,
            on_navigated_ctx: 0 as *u8,
            on_navigating: no_handler,
            on_navigating_ctx: 0 as *u8,
            on_process_terminated: no_handler,
            on_process_terminated_ctx: 0 as *u8,
            eval_script: text::new(),
        };
    }
}

const K_WEB: u32 = 38u32;

fn release_web_props(p: *u8) {
    if p == (0 as *u8) { return; }
    let _b: box::Box[WebProps] = box::from_raw::[WebProps](p);
    return;
}
