    bind: fn(usize, *flex::Node, *u8),    // facet — writes row `i` INTO an existing row, for recycling
    row_height_of: fn(usize, *u8) -> f64,    // facet — the height of row `i`, answered WITHOUT building it
    opaque row_height_of_ctx: *u8,
    row_kind: fn(usize, *u8) -> usize,    // facet — which SHAPE row `i` has, so cells pool per shape
    opaque row_kind_ctx: *u8,
    group_count: i64,    // facet — how many groups, when is_grouped
    group_size: fn(usize, *u8) -> usize,    // facet — how many rows group `g` holds
    opaque group_size_ctx: *u8,
    group_header: fn(usize, *u8) -> flex::Node,    // facet — builds the header row for group `g`
    opaque group_header_ctx: *u8,
    selected_index: i64,    // facet — which row is selected, or -1 for none
    reorder_from: i64,    // facet — the row a completed reorder moved, or -1
    reorder_to: i64,    // facet — where it moved to, or -1
    invalidate_lo: i64,    // facet — first data row of the pending invalidation, or -1
    invalidate_hi: i64,    // facet — last data row of the pending invalidation, or -1
    splice_at: i64,    // facet — first data row of the pending insert/remove, or -1
    splice_count: i64,    // facet — rows inserted (positive) or removed (negative) at `splice_at`
}

impl ListProps {
    fn new() -> ListProps {
        return ListProps {
            has_uneven_rows: false,
            horizontal_scroll_bars: vocab::ScrollBars::Default,
            is_grouped: false,
            is_refreshable: false,
            is_refreshing: false,
            can_refresh: true,
            refresh_color: vocab::Color::clear(),
            row_height: 0 as i64,
            selection_mode: vocab::SelectionMode::None,
            separator_color: vocab::Color::clear(),
            separator: vocab::Separator::Default,
            vertical_scroll_bars: vocab::ScrollBars::Default,
            on_item_appearing: no_handler,
            on_item_appearing_ctx: 0 as *u8,
            on_item_disappearing: no_handler,
            on_item_disappearing_ctx: 0 as *u8,
            on_item_selected: no_handler,
            on_item_selected_ctx: 0 as *u8,
            on_item_tapped: no_handler,
            on_item_tapped_ctx: 0 as *u8,
            on_refreshing: no_handler,
            on_refreshing_ctx: 0 as *u8,
            observe_scrolled: no_handler,
            observe_scrolled_ctx: 0 as *u8,
            scroll_to_index: 0 as i64,
            count: 0 as i64,
            row: no_row,
            row_ctx: 0 as *u8,
            bind: no_bind,
            row_height_of: no_row_height_of,
            row_height_of_ctx: 0 as *u8,
            row_kind: no_row_kind,
            row_kind_ctx: 0 as *u8,
            group_count: 0 as i64,
            group_size: no_group_size,
            group_size_ctx: 0 as *u8,
            group_header: no_group_header,
            group_header_ctx: 0 as *u8,
            selected_index: -1 as i64,
            reorder_from: -1 as i64,
            reorder_to: -1 as i64,
            invalidate_lo: -1 as i64,
            invalidate_hi: -1 as i64,
            splice_at: -1 as i64,
            splice_count: 0 as i64,
        };
    }
}

