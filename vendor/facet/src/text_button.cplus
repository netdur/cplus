// text_button — a button that is only its text. HAND-WRITTEN: facet's own
// word, no ledger row behind it.
//
// The ledger has ONE Button and expresses the flat posture by clearing three
// properties — BackgroundColor, BorderColor, BorderWidth — which is why facet
// inherited a `button` that always draws its bezel and no way to ask it not
// to. Clearing facet's `background_color` does not help: that verb clears a
// CALayer facet adds, and the bezel is drawn by NSButton's cell underneath it.
//
// So this is a control facet declares on its own account, recorded as a
// facet-origin row in tools/ledger_map.py's FACET_ORIGIN rather than left to
// appear by accident.
//
// ---- why a control and not a flag on `button` --------------------------------
//
// Flutter reached this shape too — TextButton, ElevatedButton and
// OutlinedButton are separate widgets, not one button with a style enum — and
// the reason applies here unchanged: HALF THE PARAMETERS WOULD BE DEAD.
// `border_color`, `border_width` and `corner_radius` mean nothing on a control
// whose whole point is having none of them, and a flag would leave them
// present, settable, and silently ignored. facet already makes that call once:
// `icon_button` is its own control rather than `button(image:)`, and its own
// comment says "borderless, because an app reaching for this wants the icon
// and not a bezel around it".
//
// What it keeps is the part that matters and that a label-plus-gesture throws
// away: it is a REAL NSButton, so its action fires from the keyboard when
// focused and from VoiceOver, and it reports as `role=button` to the agent
// surface. A `label(...).gesture(on_click:)` renders the same pixels and is
// reachable by a pointer and nothing else.
//
// ---- what it does NOT have ---------------------------------------------------
//
// No background, no border, no corner radius — not "defaulted to none", ABSENT.
// A text button that wants a filled or outlined posture is a `button`, and the
// two are one search apart. The shared band still applies, so opacity, hidden,
// transforms and layout are all there as usual.

import "flex_layout/flex_layout" as flex;
import "stdlib/text" as text;
import "stdlib/option" as option;
import "stdlib/box" as box;
import "./facet" as core;
import "./mount" as mount;
import "./props" as props;
import "./vocabulary" as vocab;

// facet-origin controls take their kind tag from 1000 up, so a regeneration of
// the 38 ledger-derived modules can never collide with one facet declared for
// itself. Taken so far: 1000 symbol, 1001 tree, 1002 split, 1003 window_buttons.
const K_TEXT_BUTTON: u32 = 1004u32;

const P_TITLE: u64 = 1u64;
const P_TEXT_COLOR: u64 = 2u64;
const P_FONT_SIZE: u64 = 4u64;
const P_FONT_WEIGHT: u64 = 8u64;
const P_FONT_FAMILY: u64 = 16u64;
const P_IS_ITALIC: u64 = 32u64;
const P_FONT_SCALES: u64 = 64u64;
const P_CHARACTER_SPACING: u64 = 128u64;
const P_TEXT_TRANSFORM: u64 = 256u64;
const P_LINE_BREAK: u64 = 512u64;
const P_TEXT_DECORATION: u64 = 1024u64;
const P_ON: u64 = 2048u64;
const P_TOGGLES: u64 = 4096u64;
const P_BORDERED: u64 = 8192u64;
const P_BORDER_COLOR: u64 = 16384u64;
const P_BORDER_WIDTH: u64 = 32768u64;
const P_CORNER_RADIUS: u64 = 65536u64;
const P_TEXT_ALIGN: u64 = 131072u64;

struct TextButtonProps {
    title: text::Text,
    text_color: vocab::Color,        // clear = the platform's own control colour
    font_size: f64,                  // 0 = the platform's default
    font_weight: vocab::FontWeight,
    font_family: text::Text,
    is_italic: bool,
    font_scales: bool,
    character_spacing: f64,
    text_transform: vocab::TextTransform,
    line_break: vocab::LineBreak,
    // Underline is the point of the link posture, so it is a first-class
    // parameter here rather than something to reach for a label to get.
    text_decoration: vocab::TextDecoration,
    // Horizontal title alignment inside the control bounds. Default Center
    // matches NSButton; a full-width sidebar row wants Start.
    text_align: vocab::TextAlign,
    // ---- toggling -----------------------------------------------------------
    // `toggles` makes a click FLIP rather than fire-and-forget: AppKit's own
    // PushOnPushOff type holds the state, so `is_on` is read off the control
    // and nothing has to be kept in step by hand. The handler still runs, and
    // reads `is_on()` to see where it landed.
    toggles: bool,
    on: bool,
    // ---- the border ---------------------------------------------------------
    // A text button HAS no border and can be GIVEN one, which is the point of
    // the pair: `border_color` / `border_width` / `corner_radius` describe the
    // border, and `bordered` says whether it is drawn. Describing it once and
    // switching it on and off is what a chip or a filter button does — and a
    // width of 0 would have meant redescribing it every time it came back.
    bordered: bool,
    border_color: vocab::Color,
    border_width: f64,
    corner_radius: vocab::Corners,
    on_click: fn(*u8, *u8),
    opaque on_click_ctx: *u8,
}

impl TextButtonProps {
    fn new() -> TextButtonProps {
        return TextButtonProps {
            title: text::new(),
            text_color: vocab::Color::clear(),
            font_size: 0.0f64,
            font_weight: vocab::FontWeight::Default,
            font_family: text::new(),
            is_italic: false,
            font_scales: true,
            character_spacing: 0.0f64,
            text_transform: vocab::TextTransform::None,
            line_break: vocab::LineBreak::TailTruncation,
            text_decoration: vocab::TextDecoration::None,
            text_align: vocab::TextAlign::Center,
            toggles: false,
            on: false,
            bordered: false,
            border_color: vocab::Color::clear(),
            border_width: 1.0f64,
            corner_radius: vocab::Corners::none(),
            on_click: props::no_handler,
            on_click_ctx: 0 as *u8,
        };
    }
}

fn release_text_button_props(p: *u8) {
    if p == (0 as *u8) { return; }
    let _b: box::Box[TextButtonProps] = box::from_raw::[TextButtonProps](p);
    return;
}

// ---- build -------------------------------------------------------------------

fn text_button(
    title: str,
    key: str = "",
    text_color: vocab::Color = vocab::Color::clear(),
    font_size: f64 = 0.0f64,
    font_weight: vocab::FontWeight = vocab::FontWeight::Default,
    font_family: str = "",
    italic: bool = false,
    font_scales: bool = true,
    character_spacing: f64 = 0.0f64,
    text_transform: vocab::TextTransform = vocab::TextTransform::None,
    line_break: vocab::LineBreak = vocab::LineBreak::TailTruncation,
    text_decoration: vocab::TextDecoration = vocab::TextDecoration::None,
    text_align: vocab::TextAlign = vocab::TextAlign::Center,
    toggles: bool = false,
    on: bool = false,
    bordered: bool = false,
    border_color: vocab::Color = vocab::Color::clear(),
    border_width: f64 = 1.0f64,
    corner_radius: vocab::Corners = vocab::Corners::none(),
    on_click: fn(*u8, *u8) = props::no_handler,
    on_click_ctx: *u8 = 0 as *u8,
) -> core::Node {
    var p: TextButtonProps = TextButtonProps::new();
    p.title = text::from_str(title);
    p.text_color = text_color;
    p.font_size = font_size;
    p.font_weight = font_weight;
    p.font_family = text::from_str(font_family);
    p.is_italic = italic;
    p.font_scales = font_scales;
    p.character_spacing = character_spacing;
    p.text_transform = text_transform;
    p.line_break = line_break;
    p.text_decoration = text_decoration;
    p.text_align = text_align;
    p.toggles = toggles;
    p.on = on;
    p.bordered = bordered;
    p.border_color = border_color;
    p.border_width = border_width;
    p.corner_radius = corner_radius;
    p.on_click = on_click;
    p.on_click_ctx = on_click_ctx;
    return match box::new::[TextButtonProps](p) {
        option::Option[box::Box[TextButtonProps]]::Some(b) =>
            core::node_with(key, K_TEXT_BUTTON, b.into_raw(), release_text_button_props),
        option::Option[box::Box[TextButtonProps]]::None =>
            core::node_with(key, K_TEXT_BUTTON, 0 as *u8, release_text_button_props),
    };
}

// ---- live --------------------------------------------------------------------

struct TextButton {
    opaque _p: *core::Node,
    _seen: u64,
}

impl TextButton {
    // Unchecked, so module-private. `from` is the public door.
    fn _of(p: *core::Node) -> TextButton { return TextButton { _p: p, _seen: flex::removal_count() }; }
    fn is_live(this) -> bool { return this._seen == flex::removal_count(); }

    fn _props(this) -> *TextButtonProps {
        let d: *core::Data = { (*this._p).data() };
        if d == (0 as *core::Data) { return 0 as *TextButtonProps; }
        if { (*d).kind } != K_TEXT_BUTTON { return 0 as *TextButtonProps; }
        return { (*d).props } as *TextButtonProps;
    }

    fn set_title(this, v: str) -> TextButton {
        let p: *TextButtonProps = this._props();
        if p == (0 as *TextButtonProps) { return this; }
        { (*p).title = text::from_str(v) };
        core::touch(this._p, P_TITLE);
        return this;
    }

    fn title(this) -> str {
        let p: *TextButtonProps = this._props();
        if p == (0 as *TextButtonProps) { return ""; }
        return { (*p).title.view() };
    }

    fn set_text_color(this, v: vocab::Color) -> TextButton {
        let p: *TextButtonProps = this._props();
        if p == (0 as *TextButtonProps) { return this; }
        { (*p).text_color = v };
        core::touch(this._p, P_TEXT_COLOR);
        return this;
    }

    fn text_color(this) -> vocab::Color {
        let p: *TextButtonProps = this._props();
        if p == (0 as *TextButtonProps) { return vocab::Color::clear(); }
        return { (*p).text_color };
    }

    fn set_font_size(this, v: f64) -> TextButton {
        let p: *TextButtonProps = this._props();
        if p == (0 as *TextButtonProps) { return this; }
        { (*p).font_size = v };
        core::touch(this._p, P_FONT_SIZE);
        return this;
    }

    fn font_size(this) -> f64 {
        let p: *TextButtonProps = this._props();
        if p == (0 as *TextButtonProps) { return 0.0f64; }
        return { (*p).font_size };
    }

    fn set_font_weight(this, v: vocab::FontWeight) -> TextButton {
        let p: *TextButtonProps = this._props();
        if p == (0 as *TextButtonProps) { return this; }
        { (*p).font_weight = v };
        core::touch(this._p, P_FONT_WEIGHT);
        return this;
    }

    fn font_weight(this) -> vocab::FontWeight {
        let p: *TextButtonProps = this._props();
        if p == (0 as *TextButtonProps) { return vocab::FontWeight::Default; }
        return { (*p).font_weight };
    }

    fn set_text_decoration(this, v: vocab::TextDecoration) -> TextButton {
        let p: *TextButtonProps = this._props();
        if p == (0 as *TextButtonProps) { return this; }
        { (*p).text_decoration = v };
        core::touch(this._p, P_TEXT_DECORATION);
        return this;
    }

    fn text_decoration(this) -> vocab::TextDecoration {
        let p: *TextButtonProps = this._props();
        if p == (0 as *TextButtonProps) { return vocab::TextDecoration::None; }
        return { (*p).text_decoration };
    }

    fn set_text_align(this, v: vocab::TextAlign) -> TextButton {
        let p: *TextButtonProps = this._props();
        if p == (0 as *TextButtonProps) { return this; }
        { (*p).text_align = v };
        core::touch(this._p, P_TEXT_ALIGN);
        return this;
    }

    fn text_align(this) -> vocab::TextAlign {
        let p: *TextButtonProps = this._props();
        if p == (0 as *TextButtonProps) { return vocab::TextAlign::Center; }
        return { (*p).text_align };
    }

    fn set_text_transform(this, v: vocab::TextTransform) -> TextButton {
        let p: *TextButtonProps = this._props();
        if p == (0 as *TextButtonProps) { return this; }
        { (*p).text_transform = v };
        core::touch(this._p, P_TEXT_TRANSFORM);
        return this;
    }

    fn text_transform(this) -> vocab::TextTransform {
        let p: *TextButtonProps = this._props();
        if p == (0 as *TextButtonProps) { return vocab::TextTransform::None; }
        return { (*p).text_transform };
    }

    // ---- toggling -------------------------------------------------------------

    // Read where the last click left it. Answers the CONTROL, not a copy: with
    // `toggles` the platform holds the state, so this cannot drift from what
    // the user sees.
    fn is_on(this) -> bool {
        let p: *TextButtonProps = this._props();
        if p == (0 as *TextButtonProps) { return false; }
        return { (*p).on };
    }

    fn set_on(this, v: bool) -> TextButton {
        let p: *TextButtonProps = this._props();
        if p == (0 as *TextButtonProps) { return this; }
        { (*p).on = v };
        core::touch(this._p, P_ON);
        return this;
    }

    fn set_toggles(this, v: bool) -> TextButton {
        let p: *TextButtonProps = this._props();
        if p == (0 as *TextButtonProps) { return this; }
        { (*p).toggles = v };
        core::touch(this._p, P_TOGGLES);
        return this;
    }

    fn toggles(this) -> bool {
        let p: *TextButtonProps = this._props();
        if p == (0 as *TextButtonProps) { return false; }
        return { (*p).toggles };
    }

    // ---- the border -----------------------------------------------------------

    // On or off, without redescribing it. The colour, width and radius stay
    // where they were, so a chip can show its border on selection and hide it
    // again with one call.
    fn set_bordered(this, v: bool) -> TextButton {
        let p: *TextButtonProps = this._props();
        if p == (0 as *TextButtonProps) { return this; }
        { (*p).bordered = v };
        core::touch(this._p, P_BORDERED);
        return this;
    }

    fn is_bordered(this) -> bool {
        let p: *TextButtonProps = this._props();
        if p == (0 as *TextButtonProps) { return false; }
        return { (*p).bordered };
    }

    fn set_border_color(this, v: vocab::Color) -> TextButton {
        let p: *TextButtonProps = this._props();
        if p == (0 as *TextButtonProps) { return this; }
        { (*p).border_color = v };
        core::touch(this._p, P_BORDER_COLOR);
        return this;
    }

    fn border_color(this) -> vocab::Color {
        let p: *TextButtonProps = this._props();
        if p == (0 as *TextButtonProps) { return vocab::Color::clear(); }
        return { (*p).border_color };
    }

    fn set_border_width(this, v: f64) -> TextButton {
        let p: *TextButtonProps = this._props();
        if p == (0 as *TextButtonProps) { return this; }
        { (*p).border_width = v };
        core::touch(this._p, P_BORDER_WIDTH);
        return this;
    }

    fn border_width(this) -> f64 {
        let p: *TextButtonProps = this._props();
        if p == (0 as *TextButtonProps) { return 0.0f64; }
        return { (*p).border_width };
    }

    fn set_corner_radius(this, v: vocab::Corners) -> TextButton {
        let p: *TextButtonProps = this._props();
        if p == (0 as *TextButtonProps) { return this; }
        { (*p).corner_radius = v };
        core::touch(this._p, P_CORNER_RADIUS);
        return this;
    }

    fn corner_radius(this) -> vocab::Corners {
        let p: *TextButtonProps = this._props();
        if p == (0 as *TextButtonProps) { return vocab::Corners::none(); }
        return { (*p).corner_radius };
    }

    fn on_click(this, f: fn(*u8, *u8), ctx: *u8 = 0 as *u8) -> TextButton {
        let p: *TextButtonProps = this._props();
        if p == (0 as *TextButtonProps) { return this; }
        { (*p).on_click = f };
        { (*p).on_click_ctx = ctx };
        core::touch(this._p, props::C_HANDLERS);
        return this;
    }

    // The flex node this cursor points at — the same escape hatch every other
    // cursor offers, so ALL of flex is reachable without a second vocabulary.
    fn node(this) -> *core::Node { return this._p; }

    // ---- the shared band ------------------------------------------------------
    fn set_opacity(this, v: f64) -> TextButton { core::set_opacity(this._p, v); return this; }
    fn opacity(this) -> f64 { return core::opacity(this._p); }
    fn set_enabled(this, v: bool) -> TextButton { core::set_enabled(this._p, v); return this; }
    fn is_enabled(this) -> bool { return core::is_enabled(this._p); }
    fn set_visible(this, v: bool) -> TextButton { core::set_visible(this._p, v); return this; }
    fn is_visible(this) -> bool { return core::is_visible(this._p); }
    fn set_shown(this, v: bool) -> TextButton { core::set_shown(this._p, v); return this; }
    fn is_hidden(this) -> bool { return core::is_hidden(this._p); }
    fn set_grow(this, v: f64) -> TextButton { core::set_grow(this._p, v); return this; }
    fn set_shrink(this, v: f64) -> TextButton { core::set_shrink(this._p, v); return this; }
    fn set_width(this, v: f64) -> TextButton { core::set_width(this._p, v); return this; }
    fn set_height(this, v: f64) -> TextButton { core::set_height(this._p, v); return this; }
    fn set_padding(this, v: f64) -> TextButton { core::set_padding(this._p, v); return this; }
    fn set_padding_edge(this, e: flex::Edge, v: f64) -> TextButton { core::set_padding_edge(this._p, e, v); return this; }
    fn set_margin_edge(this, e: flex::Edge, v: f64) -> TextButton { core::set_margin_edge(this._p, e, v); return this; }
    fn focus(this) -> TextButton { core::focus(this._p); return this; }
    fn width(this) -> f64 { return core::width_of(this._p); }
    fn height(this) -> f64 { return core::height_of(this._p); }
    fn bounds(this) -> vocab::Rect { return core::bounds_of(this._p); }
    fn native(this) -> *u8 { return core::native(this._p); }
    fn is_attached(this) -> bool { return core::is_attached(this._p); }
    fn relayout(this) -> TextButton { core::relayout(this._p); return this; }
    fn frame(this) -> core::Frame { return core::frame_of(this._p); }
}

// ---- lookup ------------------------------------------------------------------

// Narrow a node to this control, the DOM step: a node carries what EVERY node
// has, and a checked cast adds what only this control has.
fn from(p: *core::Node) -> option::Option[TextButton] {
    if p == (0 as *core::Node) { return option::Option[TextButton]::None; }
    let d: *core::Data = { (*p).data() };
    if d == (0 as *core::Data) { return option::Option[TextButton]::None; }
    if { (*d).kind } != K_TEXT_BUTTON { return option::Option[TextButton]::None; }
    return option::Option[TextButton]::Some(TextButton::_of(p));
}

fn find(key: str, within: *core::Node = 0 as *core::Node) -> option::Option[TextButton] {
    if within != (0 as *core::Node) {
        return match core::find_in(within, key) {
            option::Option[*core::Node]::Some(p) => from(p),
            option::Option[*core::Node]::None => option::Option[TextButton]::None,
        };
    }
    return match mount::find_node(key) {
        option::Option[*core::Node]::Some(p) => from(p),
        option::Option[*core::Node]::None => option::Option[TextButton]::None,
    };
}
