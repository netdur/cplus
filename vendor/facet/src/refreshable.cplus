// ---- lookup ------------------------------------------------------------
// `from` narrows a node to this control, the DOM step: a node carries what
// EVERY node has, and a checked cast adds what only a refreshable has. `None` on
// a wrong kind — never a cursor whose every verb silently does nothing.

fn from(p: *core::Node) -> option::Option[Refreshable] {
    if p == (0 as *core::Node) { return option::Option[Refreshable]::None; }
    let d: *core::Data = { (*p).data() };
    if d == (0 as *core::Data) { return option::Option[Refreshable]::None; }
    if { (*d).kind } != props::K_REFRESHABLE { return option::Option[Refreshable]::None; }
    return option::Option[Refreshable]::Some(Refreshable::_of(p));
}

// Resolve a key, then narrow through the same checked door.

// `within:` and not `in:` — `in` is a C+ keyword. Bare `find` is the
// DOM rule: the running app's windows in open order, first match wins;
// pass `within:` to scope a subtree (or disambiguate across windows).
fn find(key: str, within: *core::Node = 0 as *core::Node) -> option::Option[Refreshable] {
    if within != (0 as *core::Node) {
        return match core::find_in(within, key) {
            option::Option[*core::Node]::Some(p) => { _report_kind(key, p); from(p) }
            option::Option[*core::Node]::None => option::Option[Refreshable]::None,
        };
    }
    return match mount::find_node(key) {
        option::Option[*core::Node]::Some(p) => { _report_kind(key, p); from(p) }
        option::Option[*core::Node]::None => option::Option[Refreshable]::None,
    };
}

// The debug posture's third distinction (FACET_DEBUG_FIND=1): the key
// RESOLVED, and `from` is about to answer None anyway because the node is
// another control. `_`-private; costs one flag read when the posture is off.
fn _report_kind(key: str, p: *core::Node) {
    if !mount::find_debugging() { return; }
    if p == (0 as *core::Node) { return; }
    let d: *core::Data = { (*p).data() };
    if d == (0 as *core::Data) || { (*d).kind } != props::K_REFRESHABLE {
        mount::debug_find_wrong_kind(key, "refreshable");
    }
    return;
}
