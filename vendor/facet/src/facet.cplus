    return;
}

fn set_padding(n: *Node, v: f64) {
    if n == (0 as *Node) { return; }
    { (*n).set_padding(flex::Edge::All, flex::StyleLength::points(v)) };
    touch(n, props::C_LAYOUT);
    return;
}

fn set_margin(n: *Node, v: f64) {
    if n == (0 as *Node) { return; }
    { (*n).set_margin(flex::Edge::All, flex::StyleLength::points(v)) };
    touch(n, props::C_LAYOUT);
    return;
}

// Per-EDGE padding and margin. `set_padding(v)` writes all four, which is the
// common case and stays; asymmetric insets were three imperative
// `{ (*n).set_padding(Edge::Top, StyleLength::points(v)) }` calls after the
// @ui block, each of them a write past the dirty-bit seam.
fn set_padding_edge(n: *Node, edge: flex::Edge, v: f64) {
    if n == (0 as *Node) { return; }
    { (*n).set_padding(edge, flex::StyleLength::points(v)) };
    touch(n, props::C_LAYOUT);
    return;
}

fn set_margin_edge(n: *Node, edge: flex::Edge, v: f64) {
    if n == (0 as *Node) { return; }
