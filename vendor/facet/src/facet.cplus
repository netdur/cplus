    assert approx(n._gap_col, 8.0f64);
    assert n._has_display;
    assert n._has_overflow;
    assert n._has_align_content;
    assert n._has_direction;
}

#[test]
fn mount_applies_percent_width() {
    // A child with width_pct(50) inside a 200-wide row resolves to 100pt.
    var inner: Builder = Builder::new();
    inner.add(label("half").width_pct(50.0f64).height(20.0f64));
    var b: Builder = Builder::new();
    b.add(row(inner).frame(200.0f64, 40.0f64));
    let root: Node = b.finish();
    var tree: flex::Node = mount(#addr_of(root), fake_renderer());
    tree.calculate_layout(200.0f64, 40.0f64, flex::Direction::LTR);
    match tree.children.at_ptr(0 as usize) {
        option::Option[*flex::Node]::Some(rp) => {
            let c0: flex::Layout = must_layout({ (*rp).child_layout(0 as usize) });
            assert approx(c0.width, 100.0f64);   // 50% of 200
        }
        option::Option[*flex::Node]::None => { assert false; }
    };
}

#[test]
fn mount_applies_absolute_position_and_inset() {
    // A 200x200 column with one position:absolute child, inset top/left 10:
    // the child leaves flow and pins to (10,10) regardless of its own size.
    var inner: Builder = Builder::new();
    inner.add(button("x")
        .position_absolute()
        .inset(flex::Edge::Top, 10.0f64)
        .inset(flex::Edge::Left, 10.0f64)
        .frame(30.0f64, 30.0f64));
    var b: Builder = Builder::new();
    b.add(column(inner).frame(200.0f64, 200.0f64));
    let root: Node = b.finish();

    var tree: flex::Node = mount(#addr_of(root), fake_renderer());
    tree.calculate_layout(200.0f64, 200.0f64, flex::Direction::LTR);
    match tree.children.at_ptr(0 as usize) {
        option::Option[*flex::Node]::Some(cp) => {
            let bf: flex::Layout = must_layout({ (*cp).child_layout(0 as usize) });
            assert approx(bf.left, 10.0f64);
            assert approx(bf.top, 10.0f64);
        }
        option::Option[*flex::Node]::None => { assert false; }
    };
}

#[test]
fn mount_zstack_overlays_children() {
    // child0 (100x50) sizes the stack; child1 (20x20) overlays at (0,0) instead
    // of stacking below it (which flow would put at top=50).
    var inner: Builder = Builder::new();
    inner.add(button("base").frame(100.0f64, 50.0f64));
    inner.add(label("badge").frame(20.0f64, 20.0f64));
    var b: Builder = Builder::new();
    b.add(zstack(inner));
    let root: Node = b.finish();

    var tree: flex::Node = mount(#addr_of(root), fake_renderer());
    tree.calculate_layout(200.0f64, 200.0f64, flex::Direction::LTR);
    match tree.children.at_ptr(0 as usize) {
        option::Option[*flex::Node]::Some(zp) => {
            let c0: flex::Layout = must_layout({ (*zp).child_layout(0 as usize) });
            let c1: flex::Layout = must_layout({ (*zp).child_layout(1 as usize) });
            assert approx(c0.width, 100.0f64);   // in-flow child sizes the stack
            assert approx(c0.height, 50.0f64);
            assert approx(c1.left, 0.0f64);      // overlay pinned to the corner
            assert approx(c1.top, 0.0f64);       // NOT 50 (would be below in flow)
        }
        option::Option[*flex::Node]::None => { assert false; }
    };
}

#[test]
fn mount_grid_flows_children_into_columns() {
    reset_fake_counts();
    var inner: Builder = Builder::new();
    inner.add(label("a"));
    inner.add(label("b"));
    inner.add(label("c"));
    inner.add(label("d"));
    var b: Builder = Builder::new();
    b.add(grid(inner, columns: 2 as i32).frame(200.0f64, 200.0f64));
    let root: Node = b.finish();
    var tree: flex::Node = mount(#addr_of(root), fake_renderer());
    tree.calculate_layout(200.0f64, 200.0f64, flex::Direction::LTR);
    match tree.children.at_ptr(0 as usize) {
        option::Option[*flex::Node]::Some(gp) => {
            let c0: flex::Layout = must_layout({ (*gp).child_layout(0 as usize) });
            let c1: flex::Layout = must_layout({ (*gp).child_layout(1 as usize) });
            let c2: flex::Layout = must_layout({ (*gp).child_layout(2 as usize) });
            assert approx(c0.left, 0.0f64);      // col 0
            assert approx(c1.left, 100.0f64);    // col 1 (2 × 100 in 200)
            assert approx(c2.left, 0.0f64);      // wraps to row 2, col 0
        }
        option::Option[*flex::Node]::None => { assert false; }
    };
    assert FAKE_LABELS == 4;
}

#[test]
fn facet_p3_layout_modifiers_set_fields() {
    let n: Node = label("x")
        .box_sizing(flex::BoxSizing::ContentBox)
        .flex_direction(flex::FlexDirection::RowReverse)
        .grid_span(2 as i32, 1 as i32)
        .grid_pos(1 as i32, 2 as i32);
    assert n._has_box_sizing;
    assert n._has_flex_dir;
    assert n._grid_col_span == (2 as i32);
    assert n._grid_col_start == (1 as i32);
    assert n._grid_row_start == (2 as i32);

    let m: Node = label("y")
        .border_inset(flex::Edge::All, 2.0f64)
        .padding_start(8.0f64).padding_end(4.0f64)
        .margin_start(6.0f64).margin_end(3.0f64)
        .grid_subgrid(true, false);
    assert approx(m._bdr_l, 2.0f64);
    assert approx(m._bdr_b, 2.0f64);
    assert approx(m._pad_start, 8.0f64);
    assert approx(m._mrg_end, 3.0f64);
    assert m._grid_cols_subgrid;
    assert m._grid_rows_subgrid == false;
}

#[test]
fn mount_logical_padding_resolves_by_direction() {
    // padding_start(20) on a 200-wide row: LTR → the child insets from the left.
    var inner: Builder = Builder::new();
    inner.add(label("x").width(40.0f64).height(20.0f64));
    var b: Builder = Builder::new();
    b.add(row(inner).frame(200.0f64, 40.0f64).padding_start(20.0f64));
    let root: Node = b.finish();
    var tree: flex::Node = mount(#addr_of(root), fake_renderer());
    tree.calculate_layout(200.0f64, 40.0f64, flex::Direction::LTR);
    match tree.children.at_ptr(0 as usize) {
        option::Option[*flex::Node]::Some(rp) => {
            let c0: flex::Layout = must_layout({ (*rp).child_layout(0 as usize) });
            assert approx(c0.left, 20.0f64);   // LTR: start edge = left
        }
        option::Option[*flex::Node]::None => { assert false; }
    };
}

#[test]
fn mount_grid_child_spans_columns() {
    // 3-col grid at 300 wide → each col 100; first child spans 2 → 200 wide.
    reset_fake_counts();
    var inner: Builder = Builder::new();
    inner.add(label("wide").grid_span(2 as i32, 1 as i32));
    inner.add(label("b"));
    inner.add(label("c"));
    var b: Builder = Builder::new();
    b.add(grid(inner, columns: 3 as i32).frame(300.0f64, 100.0f64));
    let root: Node = b.finish();
    var tree: flex::Node = mount(#addr_of(root), fake_renderer());
    tree.calculate_layout(300.0f64, 100.0f64, flex::Direction::LTR);
    match tree.children.at_ptr(0 as usize) {
        option::Option[*flex::Node]::Some(gp) => {
            // Child 0 spans cols 0-1, so child 1 flows to col 2 (x=200) — not col 1
            // (x=100) as it would without the span. (Child 0 itself has a fixed
            // fake width, so we assert via the sibling's placement.)
            let c1: flex::Layout = must_layout({ (*gp).child_layout(1 as usize) });
            assert approx(c1.left, 200.0f64);
        }
        option::Option[*flex::Node]::None => { assert false; }
    };
}

#[test]
fn mount_dispatches_box() {
    reset_fake_counts();
    var b: Builder = Builder::new();
    b.add(box()
        .background(Color::system_blue())
        .corner_radius(6.0f64)
        .frame(40.0f64, 40.0f64));
    let root: Node = b.finish();
    let _t: flex::Node = mount(#addr_of(root), fake_renderer());
    assert FAKE_BOXES == 1;
    assert FAKE_IDENTITIES == 1;
}

#[test]
fn mount_applies_preset_gap_and_padding() {
    var cb: Builder = Builder::new();
    cb.add(label("a"));
    cb.add(label("b"));
    var b: Builder = Builder::new();
    b.add(card(cb));
    let root: Node = b.finish();

    var tree: flex::Node = mount(#addr_of(root), fake_renderer());
    tree.calculate_layout(200.0f64, flex::undefined(), flex::Direction::LTR);
    match tree.child_layout(0 as usize) {
        option::Option[flex::Layout]::Some(f) => {
            // 16 pad + 10 + 8 gap + 10 + 16 pad = 60 tall.
            assert approx(f.height, 60.0f64);
        }
        option::Option[flex::Layout]::None => { assert false; }
    };
}

fn must_layout(o: option::Option[flex::Layout]) -> flex::Layout {
    return match o {
        option::Option[flex::Layout]::Some(l) => l,
        option::Option[flex::Layout]::None => flex::Layout { left: -999.0f64, top: -999.0f64, width: 0.0f64, height: 0.0f64 },
    };
}

// ---- screen tests ------------------------------------------------------------
// A minimal screen: counters in module statics record every erased call so the
// tests can assert the trampolines reach the real methods and the box drops
// the instance exactly once.

static SBT_BUILDS: i32 = 0;
static SBT_ATTACHES: i32 = 0;
static SBT_DETACHES: i32 = 0;
static SBT_DROPS: i32 = 0;

fn sbt_reset() {
    SBT_BUILDS = 0;
    SBT_ATTACHES = 0;
    SBT_DETACHES = 0;
    SBT_DROPS = 0;
    return;
}

struct SbtScreen {
    n: i32,
}

impl SbtScreen {
    fn drop(ref this) {
        SBT_DROPS = SBT_DROPS + 1;
        return;
    }
}

impl SbtScreen: Component {
    fn build(ref this) -> Node {
        SBT_BUILDS = SBT_BUILDS + 1;
        var b: Builder = Builder::new();
        b.add(label("sbt"));
        return column(b);
    }
}

impl SbtScreen: Lifecycle {
    fn on_attach(ref this) {
        SBT_ATTACHES = SBT_ATTACHES + 1;
        return;
    }
    fn on_detach(ref this) {
        SBT_DETACHES = SBT_DETACHES + 1;
        return;
    }
}

impl SbtScreen: Screen {
    fn chrome(this) -> Chrome {
        return Chrome::new(title: "sbt", width: 300.0f64, height: 200.0f64, zoomable: true, max_zoom: 3.0f64);
    }
    fn menu_items(this) -> vec::Vec[MenuItem] { return vec::new::[MenuItem](); }
}

#[test]
fn chrome_defaults_and_overrides() {
    let d: Chrome = Chrome::new();
    assert d.title() == "facet";
    assert approx(d.width, 480.0f64);
    assert approx(d.height, 360.0f64);
    assert approx(d.min_width, 0.0f64);
    assert d.clean_titlebar == false;
    assert d.close_button_only == false;
    assert d.custom_chrome == false;
    assert d.native_buttons == false;
    assert d.unified_toolbar == false;
    assert d.hide_title == false;
    assert d.zoomable == false;
    assert approx(d.min_zoom, 1.0f64);
    assert approx(d.max_zoom, 4.0f64);

    let c: Chrome = Chrome::new(title: "Iris", width: 800.0f64, min_width: 640.0f64, clean_titlebar: true);
    assert c.title() == "Iris";
    assert approx(c.width, 800.0f64);
    assert approx(c.min_width, 640.0f64);
    assert c.clean_titlebar;
    assert c.zoomable == false;
}

#[test]
fn screen_box_drives_the_erased_screen() {
    sbt_reset();
    {
        var sb: ScreenBox = screen_box(SbtScreen { n: 7 });
        assert sb.valid();
        assert sb.instance() != (0 as *u8);

        // chrome reaches the real conformance through the trampoline.
        let c: Chrome = sb.chrome();
        assert c.title() == "sbt";
        assert approx(c.width, 300.0f64);
        assert c.zoomable;
        assert approx(c.max_zoom, 3.0f64);

        // build / lifecycle reach the real methods.
        let root: Node = sb.build();
        assert root.kind == kind_column();
        sb.on_attach();
        sb.on_detach();
        assert SBT_BUILDS == 1;
        assert SBT_ATTACHES == 1;
        assert SBT_DETACHES == 1;
        // The instance lives while the box lives.
        assert SBT_DROPS == 0;
    }
    // Scope exit dropped the box -> the boxed screen dropped exactly once.
    assert SBT_DROPS == 1;
}

#[test]
fn screen_box_invalid_noops() {
    sbt_reset();
    {
        var sb: ScreenBox = ScreenBox::invalid();
        assert sb.valid() == false;
        assert sb.instance() == (0 as *u8);
        // Every verb no-ops instead of trapping; chrome yields the defaults.
        let root: Node = sb.build();
        assert root.kind == kind_column();
        sb.on_attach();
        sb.on_detach();
        let c: Chrome = sb.chrome();
        assert c.title() == "facet";
    }
    assert SBT_BUILDS == 0;
    assert SBT_ATTACHES == 0;
    assert SBT_DETACHES == 0;
    assert SBT_DROPS == 0;
}

// ---- theme tests --------------------------------------------------------------

static THT_CHANGES: i32 = 0;
fn tht_changed() { THT_CHANGES = THT_CHANGES + 1; return; }

#[test]
fn color_tokens_two_tiers_and_predicates() {
    // Tier 1 keeps its numeric identities (backend mapping stability).
    assert Color::text().token == (1 as u32);
    assert Color::text_secondary().token == (2 as u32);
    assert Color::text_tertiary().token == (9 as u32);
    assert Color::accent().token == (3 as u32);
    assert Color::separator().token == (10 as u32);
    assert Color::placeholder().token == (15 as u32);
    assert Color::link().token == (16 as u32);
    assert Color::selected_content_background().token == (17 as u32);
    assert Color::fill_secondary().token == (19 as u32);
    assert Color::system_indigo().token == (24 as u32);
    // Tier 2 lives in the 100s.
    assert Color::primary().token == (100 as u32);
    assert Color::danger().token == (111 as u32);
    assert Color::content().token == (112 as u32);
    assert Color::recessed().token == (117 as u32);
    assert Color::recessed().is_theme_role();
    // Predicates: every named token is dynamic; literals and none are not.
    assert Color::primary().is_theme_role();
    assert Color::accent().is_theme_role() == false;
    assert Color::surface().is_dynamic();
    assert Color::window_background().is_dynamic();
    assert Color::rgba(0.1f64, 0.2f64, 0.3f64, 1.0f64).is_dynamic() == false;
    assert Color::none().is_dynamic() == false;
    assert Color::none().is_set() == false;
}

#[test]
fn color_adaptive_packs_both_sides_and_ink_carries_alpha() {
    let c: Color = Color::adaptive(
        light: Color::rgba(0.9f64, 0.8f64, 0.7f64, 1.0f64),
        dark: Color::rgba(0.1f64, 0.2f64, 0.3f64, 0.5f64),
    );
    assert c.is_adaptive();
    assert approx(c.r, 0.9f64);
    assert approx(c.g, 0.8f64);
    assert approx(c.b, 0.7f64);
    assert approx(c.a, 1.0f64);
    assert approx(c.r2, 0.1f64);
    assert approx(c.g2, 0.2f64);
    assert approx(c.b2, 0.3f64);
    assert approx(c.a2, 0.5f64);

    let i: Color = Color::ink(0.55f64);
    assert i.token == (104 as u32);
    assert approx(i.a, 0.55f64);
    assert approx(Color::ink().a, 1.0f64);   // full-strength default
}

#[test]
fn theme_defaults_chain_to_platform_tokens() {
    set_theme(Theme::new());   // all roles unset
    // Unset role: the slot reads none, the fallback names the Tier-1 color.
    assert theme_slot(100 as u32).is_set() == false;
    assert theme_fallback(100 as u32).token == Color::accent().token;
    assert theme_fallback(104 as u32).token == Color::text().token;
    assert theme_fallback(105 as u32).token == Color::window_background().token;
    assert theme_fallback(106 as u32).token == Color::control_background().token;
    assert theme_fallback(107 as u32).token == Color::under_page_background().token;
    assert theme_fallback(108 as u32).token == Color::separator().token;
    assert theme_fallback(109 as u32).token == Color::system_green().token;
    assert theme_fallback(111 as u32).token == Color::system_red().token;
    // on_primary falls back to a white literal.
    assert theme_fallback(101 as u32).token == (255 as u32);
    // The extended surface tiers chain to platform colors too.
    assert theme_fallback(112 as u32).token == Color::control_background().token;
    assert theme_fallback(113 as u32).token == Color::window_background().token;
    assert theme_fallback(114 as u32).token == Color::under_page_background().token;
    assert theme_fallback(115 as u32).token == Color::fill().token;
    assert theme_fallback(116 as u32).token == Color::fill_secondary().token;
    assert theme_fallback(117 as u32).token == Color::fill().token;
    assert theme_slot(112 as u32).is_set() == false;
    // Non-role tokens answer none from both.
    assert theme_slot(1 as u32).is_set() == false;
    assert theme_fallback(1 as u32).is_set() == false;
}

#[test]
fn set_theme_stores_roles_and_fires_the_hook() {
    THT_CHANGES = 0;
    set_theme_changed_fn(tht_changed);
    set_theme(Theme::new(
        primary: Color::rgba(0.35f64, 0.42f64, 0.95f64, 1.0f64),
        surface: Color::adaptive(
            light: Color::rgba(0.92f64, 0.92f64, 0.94f64, 1.0f64),
            dark: Color::rgba(0.09f64, 0.09f64, 0.11f64, 1.0f64),
        ),
    ));
    assert THT_CHANGES == 1;
    let p: Color = theme_slot(100 as u32);
    assert p.token == (255 as u32);
    assert approx(p.r, 0.35f64);
    let s: Color = theme_slot(105 as u32);
    assert s.is_adaptive();
    assert approx(s.r2, 0.09f64);
    // Roles not named stay unset (the chain still applies to them).
    assert theme_slot(106 as u32).is_set() == false;
    // The extended tiers store like the base ones.
    set_theme(Theme::new(chip: Color::rgba(0.5f64, 0.5f64, 0.5f64, 1.0f64)));
    assert theme_slot(116 as u32).token == (255 as u32);
    // Reset for other tests: hook cleared, palette back to defaults.
    set_theme_changed_fn(0 as fn());
    set_theme(Theme::new());
}

#[test]
fn styled_or_keyed_containers_get_backing_views() {
    // A styled container must get a backing view (its background paints ON
    // it); a keyed one must too (find(key) addresses it); a plain one stays
    // pure layout. Regression for the silent `.background()`-on-column no-op.
    FAKE_CONTAINERS = 0;
    var plain: Builder = Builder::new();
    plain.add(label("x"));
    var proot: Node = column(plain);
    let _p: flex::Node = mount(#addr_of(proot), fake_renderer());
    assert FAKE_CONTAINERS == 0;

    var styled: Builder = Builder::new();
    styled.add(label("x"));
    var sroot: Node = column(styled).background(Color::surface());
    let _s: flex::Node = mount(#addr_of(sroot), fake_renderer());
    assert FAKE_CONTAINERS == 1;

    var keyed: Builder = Builder::new();
    keyed.add(label("x"));
    var kroot: Node = column(keyed).key("kc:root");
    let _k: flex::Node = mount(#addr_of(kroot), fake_renderer());
    assert FAKE_CONTAINERS == 2;

    // Every view-operating style field forces the backing, not just bg.
    var hid: Builder = Builder::new();
    hid.add(label("x"));
    var hroot: Node = column(hid).opacity(0.5f64);
    let _h: flex::Node = mount(#addr_of(hroot), fake_renderer());
    assert FAKE_CONTAINERS == 3;
}
