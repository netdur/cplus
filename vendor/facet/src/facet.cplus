// ---- Span styling for a text surface ---------------------------------------
// A styled run over an element's text: syntax highlighting, search hits, diff
// marks. Hand-authored rather than generated — no cross-platform framework
// exposes span styling on an EDITABLE surface, so this slot has no counterpart
// in the imported spec.
//
// OFFSETS ARE UTF-8 BYTE OFFSETS into the element's current text — not
// characters, not UTF-16 code units. A lexer naturally counts bytes; a platform
// string usually does not, and that conversion is platform knowledge, so the
// backend performs it. Runs must be ordered by `start` and must not overlap.
struct TextSpan {
    start: usize,      // byte offset of the run's first byte
    len: usize,        // run length, in bytes
    color: Color,      // the run's foreground
}

impl TextSpan {
    // Built through this constructor, never a bare literal, so the run can gain
    // fields (background, weight, decorations) without breaking every call site.
    fn new(start: usize, len: usize, color: Color) -> TextSpan {
        return TextSpan { start: start, len: len, color: color };
    }
}

// ---- raw key input ----------------------------------------------------------
// A key event delivered to whichever registered element currently holds focus.
// The handler is `fn(event, ctx)` — `event` is an opaque platform event read
// through the accessors below, so an app never touches a native type.
//
// Handling: a handler that wants the key STOPPED calls `consume_key()`, and the
// event does not fall through to the responder chain (so Ctrl-C reaches a
// terminal instead of beeping). Anything not consumed behaves exactly as before.
static KEY_CODE_FN: fn(*u8) -> i64 = #zero::[fn(*u8) -> i64]();
fn set_key_code_fn(f: fn(*u8) -> i64) { KEY_CODE_FN = f; return; }
static KEY_CHARS_FN: fn(*u8) -> text::Text = #zero::[fn(*u8) -> text::Text]();
fn set_key_chars_fn(f: fn(*u8) -> text::Text) { KEY_CHARS_FN = f; return; }
static KEY_MODS_FN: fn(*u8) -> u64 = #zero::[fn(*u8) -> u64]();
fn set_key_mods_fn(f: fn(*u8) -> u64) { KEY_MODS_FN = f; return; }

// Read a key event. `code` is the platform key code; `chars` the text it would
// produce (empty for a bare modifier or a function key); `modifiers` a bit set
// tested with the mod_* helpers.
fn key_code(event: *u8) -> i64 {
    let f: fn(*u8) -> i64 = KEY_CODE_FN;
    if f == (0 as fn(*u8) -> i64) { return -1 as i64; }
    return f(event);
}
fn key_chars(event: *u8) -> text::Text {
    let f: fn(*u8) -> text::Text = KEY_CHARS_FN;
    if f == (0 as fn(*u8) -> text::Text) { return text::from_str(""); }
    return f(event);
}
fn key_modifiers(event: *u8) -> u64 {
    let f: fn(*u8) -> u64 = KEY_MODS_FN;
    if f == (0 as fn(*u8) -> u64) { return 0 as u64; }
    return f(event);
}

// Portable modifier bits (the backend maps its own flags onto these, so an app
// never sees a platform constant).
fn mod_shift() -> u64 { return 1 as u64; }
fn mod_control() -> u64 { return 2 as u64; }
fn mod_option() -> u64 { return 4 as u64; }
fn mod_command() -> u64 { return 8 as u64; }
fn has_modifier(mods: u64, which: u64) -> bool { return (mods & which) != (0 as u64); }

// Set while a key handler runs: the handler calls consume_key() to stop the
// event, and the backend reads (and clears) the flag when the handler returns.
static KEY_CONSUMED: bool = false;
fn consume_key() { KEY_CONSUMED = true; return; }
fn take_key_consumed() -> bool { let c: bool = KEY_CONSUMED; KEY_CONSUMED = false; return c; }

// ---- split divider position -------------------------------------------------
// The write counterpart to Handle.value(), which already READS a split's divider
// position. `set_value` cannot serve: it drives an NSControl-style value, and a
// split is not one, so it would no-op silently.
//
// `fraction` is the portable form: an absolute point position has to be chosen
// blind at build time, before the container's size is known, whereas a fraction
// of the split's own length is meaningful whenever it is applied.
static SET_SPLIT_POSITION_FN: fn(Handle, f64, i64) -> bool = #zero::[fn(Handle, f64, i64) -> bool]();
fn set_split_position_fn(f: fn(Handle, f64, i64) -> bool) { SET_SPLIT_POSITION_FN = f; return; }
static SET_SPLIT_FRACTION_FN: fn(Handle, f64, i64) -> bool = #zero::[fn(Handle, f64, i64) -> bool]();
fn set_split_fraction_fn(f: fn(Handle, f64, i64) -> bool) { SET_SPLIT_FRACTION_FN = f; return; }

static SET_TEXT_SPANS_FN: fn(Handle, *vec::Vec[TextSpan]) -> bool = #zero::[fn(Handle, *vec::Vec[TextSpan]) -> bool]();
fn set_text_spans_fn(f: fn(Handle, *vec::Vec[TextSpan]) -> bool) { SET_TEXT_SPANS_FN = f; return; }
static CLEAR_TEXT_SPANS_FN: fn(Handle) -> bool = #zero::[fn(Handle) -> bool]();
fn clear_text_spans_fn(f: fn(Handle) -> bool) { CLEAR_TEXT_SPANS_FN = f; return; }

