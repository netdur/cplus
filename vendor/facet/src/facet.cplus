// facet — the tree. HAND-WRITTEN; the generator never touches this file.
//
// facet's tree IS flex_layout's tree. A node's geometry, style and children
// are flex's; facet's per-node data rides in the owned attachment slot flex
// already releases for us. Nothing is stored twice.

import "flex_layout/flex_layout" as flex;
import "stdlib/text" as text;
import "stdlib/str" as _;
import "stdlib/option" as option;
import "stdlib/status" as status;
import "stdlib/box" as box;
import "stdlib/vec" as vec;
import "stdlib/io" as io;
import "./props" as props;
import "./vocabulary" as vocab;

type Node = flex::Node;
type Frame = flex::Frame;
// What facet hangs off each flex node.
struct Data {
    // OWNED, not a `str` view. There are two kinds of key and they have
    // different lifetimes:
    //
    //   an ADDRESS — what `find("save")` resolves. The web calls this an id.
    //     Usually a literal, but not always: iris builds 25 of them by
    //     interpolation ("board:card:${id}").
    //   an IDENTITY — which row is which across insert, remove and reorder.
    //     ALWAYS computed, because it is derived from the data. `TreeNode.id`
    //     is one. When `list` and `collection` get theirs it is `id` too —
    //     NEVER `key`.
    //
    // The two look swapped if you come from the web, where `id` addresses and
    // `key` identifies a list row. The web is the outlier: SwiftUI has
    // `Identifiable.id`, UIKit has `ItemIdentifier`, RecyclerView has
    // `getItemId`. facet targets native, so identity is `id`.
    //
    // And `key` is not only facet's: a mounted node's key becomes the agent
    // surface's address AND the platform's accessibilityIdentifier. One token,
    // three jobs, one name.
    //
    // This is the address. It was `str`, which is a borrowed `{ptr, len}` —
    // sound for a literal, a use-after-free for anything computed, and the
    // borrow checker does not catch the escape across a call boundary
    // (verified: a `str` stored from a Text that then drops compiles, runs and
    // reads freed bytes). Interning was considered and rejected: it buys a
    // pointer-compare `find` at the cost of a global table, hashing, thread
    // safety and an eviction policy, none of which a correctness fix needs.
    key: text::Text,
    // Empty unless this node fills a parent's named slot. Owned for the same
    // reason `key` is: `set_slot` takes an arbitrary `str`, and a `str` field
    // outliving the bytes it views is a use-after-free the checker cannot see
    // through the raw-pointer store that writes it.
    slot: text::Text,
    kind: u32,              // which control — the tag the cast is checked against
    opaque props: *u8,      // owned *<Control>Props
    release: fn(*u8),       // frees `props` with the right type
    common: props::CommonProps,  // the band every node carries — inline
    opaque view: *u8,       // native view; 0 until a backend mounts it
    // M1: who releases the native view. `props` frees through `release`,
    // `gestures` through `gestures_release`; the view gets the same pair.
    // The backend sets both when it mounts (Renderer.view_release rides in
    // with the created view); node teardown then cannot leak the view.
    view_release: fn(*u8),
    // Did the APPLICATION supply this view, rather than the backend creating
    // one? `adopt_native` is the only thing that sets it, and the mount walk
    // reads it to leave such a view alone.
    //
    // Without the flag the walk cannot tell "the view a previous mount put
    // here" from "the view the caller brought", and it has to overwrite the
    // first — so it overwrote both, and every adopted native widget was
    // replaced by an empty container the instant it was mounted.
    view_adopted: bool,
    // HOW to build the adopted view, for a caller that has a recipe rather
    // than an object. 0 means "the caller brought the view itself", which is
    // `adopt_native`'s eager form and stays the terminal widget's case.
    //
    // A recipe is not a convenience — on Android it is the only correct form.
    // An Activity can be destroyed and recreated under a live tree: C+ state
    // survives, every jobject does not, and recreation re-runs the mount walk
    // to rebuild the views. facet's own controls are fine because the walk
    // calls the backend's `create` unconditionally; an EAGER adopted view is
    // not, because the walk reuses the one already on the node — which after
    // recreation is a global ref to a view belonging to a dead Activity.
    // Reusing it is a use of a dead object, not a leak, and it fails silently.
    //
    // So a factory-adopted node is re-made on every mount, exactly like a
    // backend-created one, and `native_release` fires on the outgoing view
    // first — one live view per node at all times.
    native_create: fn(*u8) -> *u8,
    opaque native_create_ctx: *u8,
    // Intrinsic size for an adopted leaf, in flex's own shape. 0 = the leaf
    // is sized by its box (a map fills what it is given); non-zero = it
    // measures itself (an ad banner, a platform login button).
    //
    // flex already has this hook and facet's own controls ride it — this
    // field exists only to defer INSTALLING it until the view exists, since
    // the ctx flex passes is the view, the same convention the backends use
    // (`set_context(v)` at create). A factory node has no view until mount.
    native_measure: fn(*u8, f64, flex::MeasureMode, f64, flex::MeasureMode) -> flex::Size,
    // The presentation this node (an outlet) is showing: the component's
    // address and its typed detach trampoline. NODE-scoped by design — the
    // record dies with its owner, evicts naturally on teardown, and cannot
    // collide across windows. 0 = nothing presented here.
    opaque presented: *u8,
    presented_detach: fn(*u8),
    // What `display` was before switch_to parked this node — so a Grid pane
    // is restored as Grid, not silently as Flex (review finding).
    parked_display: flex::Display,
    dirty: u64,             // props changed since the backend last synced
    // What the platform learns first. facet declares the reads; a backend
    // writes them through set_focused / set_attached / set_window.
    is_focused: bool,
    is_attached: bool,
    window: vocab::WindowRef,
    batch: i64,             // begin_updates depth; 0 means "flush on write"
    // Raw input, owned, NULL until a node asks for it — see gestures.cplus.
    // One pointer rather than 17 handlers inline, so a tree that uses no
    // gestures pays 16 bytes a node and never allocates.
    opaque gestures: *u8,
    gestures_release: fn(*u8),
    // WHERE A CHARACTER IS, asked of the text system that laid it out.
    //
    // A text surface can say which character the caret is ON (`cursor_position`
    // is an offset); nothing could say where that offset SITS, and that is the
    // one number needed to put anything beside the caret — a completion list, a
    // signature hint, an inline error, a colour swatch on a hex literal.
    //
    // NOT A PROP, and that is the whole design. A prop would be pushed by the
    // backend when it changed, and it changes on selection, on edit, on scroll,
    // on resize, on a font change and on a wrap — miss one and the popup is a
    // few points off, silently, which is the failure mode nobody can diagnose.
    // A PROBE is asked at the moment the answer is used, so it cannot be stale.
    //
    // The same shape flex already uses for intrinsic size (`set_measure`): the
    // backend installs a function on the node it backs, and the portable side
    // calls it. It does NOT go on `mount::Renderer`, whose five verbs are
    // deliberately universal — this belongs to the three nodes that have text
    // systems under them, not to every node in the tree.
    //
    // `(*d).view` is the argument, so the backend gets what it created. The
    // bool is "could the platform answer": 0 for a node nothing installed one
    // on, false for a surface that cannot answer right now (an AppKit field
    // borrows its field editor and only has one while focused).
    caret_probe: fn(*u8, i64, *vocab::Rect) -> bool,
    // What this node STANDS FOR, from the application's side: the row's record,
    // the card's model, whatever a handler shared across many nodes needs to
    // tell them apart. BORROWED — the application owns it and outlives the
    // node — so facet never frees it and never dereferences it.
    //
    // `component::item_of(sender)` is the read, and it existed before this
    // field did: the SenderReaders row was declared against a `.item(p)` verb
    // that was never built, so it could only ever answer null (Stage 4 item 4).
    opaque item: *u8,
}

// A gesture set changed. In the common band because gestures ride on Node,
// not on any one control. Bit 63 — the top of the word: bit 61 is the
// generated band's C_HANDLERS, and sharing it meant a backend could not tell
// "the gesture set was replaced" from "a focus/blur/attach/detach handler was
// swapped". The generator owns props.cplus, so the hand-written constant is
// the one that moves.
const C_GESTURES: u64 = 9223372036854775808u64;

// Keys beginning with `@` are facet's own: a named slot is a child under one.
// An application's key never starts with `@`, so the two spaces never meet.
const SLOT_PREFIX: str = "@";

fn no_release(p: *u8) { return; }

// flex calls this on node drop, on detach, and when an attach replaces it.
fn release_data(p: *u8) {
    if p.is_null() { return; }
    let d: *Data = p as *Data;
    let f: fn(*u8) = { (*d).release };
    if f.is_not_null() { f({ (*d).props }); }
    // The presented component (if any) learns its presentation ended.
    let pa: *u8 = { (*d).presented };
    if pa.is_not_null() {
        let pd: fn(*u8) = { (*d).presented_detach };
        if pd.is_not_null() { pd(pa); }
    }
    // M1: the native view, through the release the backend paired with it.
    let vp: *u8 = { (*d).view };
    if vp.is_not_null() {
        let vr: fn(*u8) = { (*d).view_release };
        if vr.is_not_null() { vr(vp); }
    }
    let gp: *u8 = { (*d).gestures };
    if gp.is_not_null() {
        let gr: fn(*u8) = { (*d).gestures_release };
        if gr.is_not_null() { gr(gp); }
    }
    let _b: box::Box[Data] = box::from_raw::[Data](p);
}

// A node with no control behind it: a container, a spacer, anything flex built.
// facet still needs Data on it — the shared band and gestures live there — so
// the kind says "no props" rather than the node having no Data at all.
const K_NODE: u32 = 0u32;

// Give `n` facet Data if it has none, and hand it back either way.
//
// Without this, every container was a silent no-op: `flex::column(b)` builds a
// node with nothing attached, so `set_opacity`, `set_visible` and `.gesture()`
// all found a null Data and returned. They reported success and did nothing.
fn ensure_data(n: *Node) -> *Data {
    if n.is_null() { return 0 as *Data; }
    let d: *Data = { (*n).data() };
    if d.is_not_null() { return d; }
    let fresh: Data = Data { key: text::new(), slot: text::new(), kind: K_NODE, props: 0 as *u8,
                             release: no_release, common: props::CommonProps::new(),
                             view: 0 as *u8, view_release: no_release,
                             view_adopted: false,
                             native_create: 0 as fn(*u8) -> *u8,
                             native_create_ctx: 0 as *u8,
                             native_measure: 0 as fn(*u8, f64, flex::MeasureMode, f64, flex::MeasureMode) -> flex::Size,
                             presented: 0 as *u8, presented_detach: no_release,
                             parked_display: flex::Display::Flex, dirty: 0u64,
                             is_focused: false, is_attached: false,
                             window: vocab::WindowRef::none(), batch: 0 as i64,
                             gestures: 0 as *u8, gestures_release: no_release,
                             caret_probe: 0 as fn(*u8, i64, *vocab::Rect) -> bool,
                             item: 0 as *u8 };
    match box::new::[Data](fresh) {
        option::Option[box::Box[Data]]::Some(b) => { { (*n).attach(b.into_raw(), release_data) }; }
        option::Option[box::Box[Data]]::None => { }
    }
    return { (*n).data() };
}

// Build a node carrying `props` under `key`. The one place Data is created.
fn node_with(key: str, kind: u32, props_ptr: *u8, release: fn(*u8)) -> Node {
    var n: Node = flex::Node::new();
    let d: Data = Data { key: text::from_str(key), slot: text::new(), kind: kind, props: props_ptr,
                         release: release, common: props::CommonProps::new(),
                         view: 0 as *u8, view_release: no_release,
                         view_adopted: false,
                         native_create: 0 as fn(*u8) -> *u8,
                         native_create_ctx: 0 as *u8,
                         native_measure: 0 as fn(*u8, f64, flex::MeasureMode, f64, flex::MeasureMode) -> flex::Size,
                         presented: 0 as *u8, presented_detach: no_release,
                         parked_display: flex::Display::Flex, dirty: 0u64,
                         is_focused: false, is_attached: false,
                         window: vocab::WindowRef::none(), batch: 0 as i64,
                         gestures: 0 as *u8, gestures_release: no_release,
                         caret_probe: 0 as fn(*u8, i64, *vocab::Rect) -> bool,
                         item: 0 as *u8 };
    match box::new::[Data](d) {
        option::Option[box::Box[Data]]::Some(b) => { n.attach(b.into_raw(), release_data); }
        option::Option[box::Box[Data]]::None => { }
    }
    return n;
}

impl flex::Node {
    // facet's data for this node, or null when it carries none.
    fn data(this) -> *Data {
        return match this.attachment() {
            option::Option[*u8]::Some(p) => p as *Data,
            option::Option[*u8]::None => 0 as *Data,
        };
    }

    // A view of the node's OWN bytes, so it lives exactly as long as the node.
    fn key(this) -> str {
        let d: *Data = this.data();
        if d.is_null() { return ""; }
        return { (*d).key.view() };
    }
}

// Mark a prop changed. The ONE seam from a setter to the backend: no
// per-verb function pointer, no registrar.
//
// M5: a write outside a batch requests a sync through the hook the mount
// module installs (the backend coalesces requests on its run loop); writes
// inside begin_updates/end_updates stay silent until the closing C_FLUSH
// touch lands at depth zero. M6: the tree is main-thread-owned — when a
// renderer is installed the write asserts it is on the thread that
// installed it, because a worker writing the tree is a data race that
// otherwise surfaces as a distant, unattributable crash.
static SYNC_REQUEST_FN: fn() = #zero::[fn()]();
fn set_sync_request_fn(f: fn()) { SYNC_REQUEST_FN = f; return; }

static MAIN_THREAD_ID: u64 = 0 as u64;
fn set_main_thread_id(id: u64) { MAIN_THREAD_ID = id; return; }

#[link_name = "pthread_self"]
extern fn pthread_self_raw() -> u64;

fn on_ui_thread() -> bool {
    if MAIN_THREAD_ID == (0 as u64) { return true; }
    return { pthread_self_raw() } == MAIN_THREAD_ID;
}

fn touch(n: *Node, bit: u64) {
    if n.is_null() { return; }
    let d: *Data = { (*n).data() };
    if d.is_null() { return; }
    assert on_ui_thread();
    { (*d).dirty = { (*d).dirty } | bit };
    if { (*d).batch } == (0 as i64) {
        let f: fn() = SYNC_REQUEST_FN;
        if f.is_not_null() { f(); }
    }
}

// Every FACT at once: "re-read this node whole". The sync walk raises it on a
// host whose viewless child changed, because there is no bit for "a run
// changed" and the host is the only thing that can draw one. Not a setter's
// tool — a setter names the verb it wrote.
//
// Every fact, and no VERB. `C_FOCUS` / `C_BLUR` / `C_FLUSH` are commands the
// backend performs and clears, and this used to raise them too: a label whose
// span changed took first responder and handed it straight back to the window,
// because `apply_common` honours focus and blur in that order. The caret
// disappeared from whatever the user was typing into, on the keystroke that
// updated the count — a write to one node stealing focus from another.
//
// Re-reading state and re-issuing verbs are different operations and only the
// first one is what "whole" ever meant.
fn touch_all(n: *Node) {
    touch(n, props::C_ALL_STATE);
}

// Backend/mount door: pair the native view with its release. Symmetric with
// `attach`'s (payload, release) — see M1 on the struct.
fn set_view(n: *Node, v: *u8, release: fn(*u8)) {
    let d: *Data = ensure_data(n);
    if d.is_null() { return; }
    { (*d).view = v };
    { (*d).view_release = release };
}

// Is this node's view one the APPLICATION brought? The mount walk asks before
// it creates anything, because an adopted view must survive being mounted.
fn view_is_adopted(n: *Node) -> bool {
    if n.is_null() { return false; }
    let d: *Data = { (*n).data() };
    if d.is_null() { return false; }
    return { (*d).view_adopted };
}

fn view_of(n: *Node) -> *u8 {
    if n.is_null() { return 0 as *u8; }
    let d: *Data = { (*n).data() };
    if d.is_null() { return 0 as *u8; }
    return { (*d).view };
}

// ---- shared-band handlers (Stage 3) -----------------------------------------
// The four handler pairs every node carries. Focus/blur are fired by the
// backend when the platform's focus moves; attach/detach are fired by the
// mount walk, post-walk (M4). Setters are live: a swap touches C_HANDLERS so
// a mounted backend re-reads.

// What this node stands for. Shared handlers are the whole point: one
// `on_click` over two hundred rows, each answering `component::item_of(sender)`
// with the record it was given.
//
// BORROWED, and the borrow is the application's to honour: facet stores the
// pointer, never frees it and never reads through it. Pass something that
// outlives the node — an element of a Vec the app owns, not a local.
//
// It rides C_HANDLERS rather than a bit of its own, and that is the honest
// place for it: the shared band is full at bits 48..63, and an item IS the
// payload half of a handler. A backend that re-reads its handlers on that bit
// re-reads the item with them.
fn set_item(n: *Node, p: *u8) {
    let d: *Data = ensure_data(n);
    if d.is_null() { return; }
    { (*d).item = p };
    touch(n, props::C_HANDLERS);
}

fn item_of(n: *Node) -> *u8 {
    let d: *Data = node_data(n);
    if d.is_null() { return 0 as *u8; }
    return { (*d).item };
}

// An INDEX in the item slot, for the commonest thing an app puts there: which
// row this node is. The slot is a borrowed `*u8` and an unset one reads null,
// so an index of 0 is indistinguishable from "nothing here" — every caller was
// storing `i + 1` and subtracting it back, an off-by-one written out in the
// application. The bias belongs here, once, behind a typed pair.
//
//     core::set_item_index(row, i);
//     match core::item_index_of(sender_node) {
//         option::Option[usize]::Some(i) => { ... }
//         option::Option[usize]::None => { }        // nothing was stored
//     }
//
// It is the same slot: a node carries an index or a record pointer, never
// both, and mixing them is a cast the reader cannot check.
fn set_item_index(n: *Node, at: usize) {
    set_item(n, { (at +% (1 as usize)) as *u8 });
}

fn item_index_of(n: *Node) -> option::Option[usize] {
    let raw: usize = item_of(n) as usize;
    if raw == (0 as usize) { return option::Option[usize]::None; }
    return option::Option[usize]::Some(raw -% (1 as usize));
}

fn set_on_focus(n: *Node, f: fn(*u8, *u8), ctx: *u8) {
    let d: *Data = ensure_data(n);
    if d.is_null() { return; }
    { (*d).common.on_focus = f };
    { (*d).common.on_focus_ctx = ctx };
    touch(n, props::C_HANDLERS);
}

fn set_on_blur(n: *Node, f: fn(*u8, *u8), ctx: *u8) {
    let d: *Data = ensure_data(n);
    if d.is_null() { return; }
    { (*d).common.on_blur = f };
    { (*d).common.on_blur_ctx = ctx };
    touch(n, props::C_HANDLERS);
}

fn set_on_attach(n: *Node, f: fn(*u8, *u8), ctx: *u8) {
    let d: *Data = ensure_data(n);
    if d.is_null() { return; }
    { (*d).common.on_attach = f };
    { (*d).common.on_attach_ctx = ctx };
    touch(n, props::C_HANDLERS);
}

fn set_on_detach(n: *Node, f: fn(*u8, *u8), ctx: *u8) {
    let d: *Data = ensure_data(n);
    if d.is_null() { return; }
    { (*d).common.on_detach = f };
    { (*d).common.on_detach_ctx = ctx };
    touch(n, props::C_HANDLERS);
}

// Fire helpers: sender is the node's native view (0 headless), ctx is what
// the handler bound. The mount walk uses attach/detach; a backend uses
// focus/blur from its first-responder observers.
fn fire_attach_handler(n: *Node) {
    let d: *Data = { (*n).data() };
    if d.is_null() { return; }
    let f: fn(*u8, *u8) = { (*d).common.on_attach };
    if f.is_not_null() && f != props::no_handler { f({ (*d).view }, { (*d).common.on_attach_ctx }); }
}

fn fire_detach_handler(n: *Node) {
    let d: *Data = { (*n).data() };
    if d.is_null() { return; }
    let f: fn(*u8, *u8) = { (*d).common.on_detach };
    if f.is_not_null() && f != props::no_handler { f({ (*d).view }, { (*d).common.on_detach_ctx }); }
}

// Does this node want to be told about focus changes? The backend asks before
// it decides whether to arm a view: a node with only an `on_focus` and no
// gestures still needs the class that reports one.
fn wants_focus_events(n: *Node) -> bool {
    let d: *Data = { (*n).data() };
    if d.is_null() { return false; }
    let f: fn(*u8, *u8) = { (*d).common.on_focus };
    let b: fn(*u8, *u8) = { (*d).common.on_blur };
    if f.is_not_null() && f != props::no_handler { return true; }
    if b.is_not_null() && b != props::no_handler { return true; }
    return false;
}

fn fire_focus_handler(n: *Node) {
    let d: *Data = { (*n).data() };
    if d.is_null() { return; }
    let f: fn(*u8, *u8) = { (*d).common.on_focus };
    if f.is_not_null() && f != props::no_handler { f({ (*d).view }, { (*d).common.on_focus_ctx }); }
}

fn fire_blur_handler(n: *Node) {
    let d: *Data = { (*n).data() };
    if d.is_null() { return; }
    let f: fn(*u8, *u8) = { (*d).common.on_blur };
    if f.is_not_null() && f != props::no_handler { f({ (*d).view }, { (*d).common.on_blur_ctx }); }
}

// The control kind tag — what a backend's create/apply dispatch on.
// K_NODE (0) is a bare container.
fn kind_of(n: *Node) -> u32 {
    if n.is_null() { return K_NODE; }
    let d: *Data = { (*n).data() };
    if d.is_null() { return K_NODE; }
    return { (*d).kind };
}

// The presentation pair (see the Data field): the presenting verb writes it,
// component_at reads it, teardown and eviction fire the trampoline.
fn set_presented(n: *Node, addr: *u8, detach: fn(*u8)) {
    let d: *Data = ensure_data(n);
    if d.is_null() { return; }
    { (*d).presented = addr };
    { (*d).presented_detach = detach };
}

fn presented_of(n: *Node) -> *u8 {
    if n.is_null() { return 0 as *u8; }
    let d: *Data = { (*n).data() };
    if d.is_null() { return 0 as *u8; }
    return { (*d).presented };
}

// Evict: notify through the trampoline, clear the record. True when
// something was presented.
fn evict_presented(n: *Node) -> bool {
    if n.is_null() { return false; }
    let d: *Data = { (*n).data() };
    if d.is_null() { return false; }
    let pa: *u8 = { (*d).presented };
    if pa.is_null() { return false; }
    let pd: fn(*u8) = { (*d).presented_detach };
    if pd.is_not_null() { pd(pa); }
    { (*d).presented = 0 as *u8 };
    { (*d).presented_detach = no_release };
    return true;
}

// switch_to's memory of a parked pane's display mode.
fn set_parked_display(n: *Node, d: flex::Display) {
    let dp: *Data = ensure_data(n);
    if dp.is_null() { return; }
    { (*dp).parked_display = d };
}

fn parked_display_of(n: *Node) -> flex::Display {
    if n.is_null() { return flex::Display::Flex; }
    let dp: *Data = { (*n).data() };
    if dp.is_null() { return flex::Display::Flex; }
    return { (*dp).parked_display };
}

// Take the node out of layout, or put it back. `set_visible` is the other half
// and they mean different things: visible hides the view and KEEPS its space
// (NSView.setHidden — the only thing facet could do before this), display
// removes the node from the layout pass entirely.
//
// It exists because `display` is the one layout property an application
// changes at runtime, and it was the only one with no facet verb: an app had
// to reach past facet into flex, where a setter raises no dirty bit, and then
// remember `relayout()` by hand. Every other runtime layout write —
// set_width, set_padding, set_grow — asks for the pass for you.
// Conditional visibility: hide or show this node while the box it sits in
// falls in a named band. The runtime half of the fluent `hide`/`show` used at
// build time — same rules, same store, reachable after mount.
//
// The rule is resolved against the node's nearest CONTAINED ancestor during
// the layout pass, so unlike `set_display` there is nothing to re-evaluate by
// hand on resize: the pass that already runs does it. `facet/bands` holds the
// vocabulary and ships six bands whether or not an app configures any.
fn hide_in(n: *Node, band: str) {
    if n.is_null() { return; }
    { (*n).add_rule(band, hide: true) };
    touch(n, props::C_LAYOUT);
}

fn show_in(n: *Node, band: str) {
    if n.is_null() { return; }
    { (*n).add_rule(band, hide: false) };
    touch(n, props::C_LAYOUT);
}

// Drop every rule on this node. Its display stops being governed by bands and
// keeps whatever it had — an explicit `set_display` still works either way.
fn clear_rules(n: *Node) {
    if n.is_null() { return; }
    { (*n).clear_rules() };
    touch(n, props::C_LAYOUT);
}

fn rule_count_of(n: *Node) -> usize {
    if n.is_null() { return 0 as usize; }
    return { (*n).rule_count() };
}

fn set_display(n: *Node, v: flex::Display) {
    if n.is_null() { return; }
    { (*n).set_display(v) };
    // The parked value follows a deliberate write, so `switch_to` re-attaching
    // a screen restores what the app last asked for rather than Flex.
    match v {
        flex::Display::None => { }
        _ => { set_parked_display(n, v); }
    }
    touch(n, props::C_LAYOUT);
}

// Is this node off screen? The OR of the two verbs that mean it: `set_visible`
// hides a node that KEEPS its space, `Display::None` removes it from layout.
// One rule, in the model, so two backends cannot disagree and two writers of
// the same platform flag cannot race each other.
fn is_hidden(n: *Node) -> bool {
    if n.is_null() { return false; }
    if is_visible(n) == false { return true; }
    return match { (*n).display() } {
        flex::Display::None => true,
        _ => false,
    };
}

fn display_of(n: *Node) -> flex::Display {
    if n.is_null() { return flex::Display::Flex; }
    return { (*n).display() };
}

// Show or hide in ONE verb, because an application that wants a panel gone
// almost always wants both halves: the view hidden and its space released.
// Restores whatever display the node last carried, so hiding a grid and
// showing it again does not silently turn it into a flex box.
fn set_shown(n: *Node, on: bool) {
    if n.is_null() { return; }
    set_visible(n, on);
    if on { set_display(n, parked_display_of(n)); }
    else { set_display(n, flex::Display::None); }
}

// The dirty word, read and cleared by the sync walk.
fn dirty_of(n: *Node) -> u64 {
    if n.is_null() { return 0 as u64; }
    let d: *Data = { (*n).data() };
    if d.is_null() { return 0 as u64; }
    return { (*d).dirty };
}

fn clear_dirty(n: *Node) {
    if n.is_null() { return; }
    let d: *Data = { (*n).data() };
    if d.is_null() { return; }
    { (*d).dirty = 0 as u64 };
    // The node has been applied, so any `set_*` recorded on it has reached the
    // view: it is no longer a dead snap for the next `animate_*` to name.
    { (*d).common.animate_channels = { (*d).common.animate_channels } & ~props::SNAP_ANY };
}

// ---- the shared band --------------------------------------------------------
// The verbs every element carries live HERE, once, operating on Data.common.
// Each control cursor gets a generated one-line forward, so a call site is
// always typed (`b.set_opacity(...)` returns Button) and no generic element
// type exists anywhere in the package.
//
// The ledger's shared band is 41 rows; 36 are below and the 5 that are not are
// recorded in gen_contract.DEFERRED_SHARED with the reason. tools/gen_contract
// fails the run on a row that is in neither list.

// ---- the band writes through `ensure_data`, never past it --------------------
// A node built by the `@ui` DSL, or a raw `flex::Node`, carries no facet Data
// until something gives it one. Writers used to read `node_data` and return
// quietly on null, so `set_safe_area` on an @ui-rooted tree did nothing, said
// nothing, and cost two debugging rounds to find. `.gesture()` already refused
// to fail that way — "a modifier that does nothing is the exact failure this
// package is built against" — and the band now follows it.
//
// Readers still take `node_data`: a read has a right answer for a node with no
// Data (the default), and answering it should not allocate.

fn set_opacity(n: *Node, v: f64) {
    let d: *Data = ensure_data(n);
    if d.is_null() { return; }
    { (*d).common.opacity = v };
    // A snap cancels the channel's pending interpolate so apply does not
    // animate a write that asked to set.
    _snap_channel(d, n, props::ANIM_OPACITY, props::SNAP_OPACITY);
    touch(n, props::C_OPACITY);
}

fn opacity(n: *Node) -> f64 {
    let d: *Data = node_data(n);
    if d.is_null() { return 1.0f64; }
    return { (*d).common.opacity };
}

// A background IMAGE, the third thing that can be behind a node after a Color
// and a Brush. The ledger carries it on Page; facet carries it on every node,
// because a background belongs to whatever has one.
//
// It rides C_BACKGROUND rather than taking a bit of its own: "what is behind
// this node" is one question, and the backend re-reads the answer whole.
fn set_background_image(n: *Node, v: str) {
    let d: *Data = ensure_data(n);
    if d.is_null() { return; }
    { (*d).common.background_image = text::from_str(v) };
    touch(n, props::C_BACKGROUND);
}

fn background_image(n: *Node) -> str {
    let d: *Data = node_data(n);
    if d.is_null() { return ""; }
    return { (*d).common.background_image.view() };
}

// Whether this node keeps its content clear of the window's own chrome.
//
// `scroll` has carried one of these since Stage 2 and nothing else could,
// which is what left the ledger's three Page rows — ContainerArea,
// IgnoresContainerArea and ContentPage.SafeAreaEdges — with no carrier and no
// backend able to answer them. One node in a tree is the one that has to
// answer it, and the shared band is the only place that does not have to
// guess which.
//
// The write raises C_LAYOUT as well as its own bit: a safe-area inset is
// geometry, so the layout pass has to run again for it to mean anything.
fn set_safe_area(n: *Node, v: vocab::SafeArea) {
    let d: *Data = ensure_data(n);
    if d.is_null() { return; }
    { (*d).common.safe_area = v };
    touch(n, props::C_SAFE_AREA | props::C_LAYOUT);
}

fn safe_area(n: *Node) -> vocab::SafeArea {
    let d: *Data = node_data(n);
    if d.is_null() { return vocab::SafeArea::Default; }
    return { (*d).common.safe_area };
}

// Does this node's safe-area setting mean "keep clear"? `None` is the only
// answer that does not — the same reduction `scroll` makes, in one place so
// the two cannot disagree.
fn honours_safe_area(n: *Node) -> bool {
    return match safe_area(n) {
        vocab::SafeArea::None => false,
        vocab::SafeArea::Default => true,
        vocab::SafeArea::Container => true,
        vocab::SafeArea::Content => true,
        vocab::SafeArea::All => true,
    };
}

fn set_enabled(n: *Node, v: bool) {
    let d: *Data = ensure_data(n);
    if d.is_null() { return; }
    { (*d).common.is_enabled = v };
    touch(n, props::C_IS_ENABLED);
}

fn is_enabled(n: *Node) -> bool {
    let d: *Data = node_data(n);
    if d.is_null() { return true; }
    return { (*d).common.is_enabled };
}

fn set_visible(n: *Node, v: bool) {
    let d: *Data = ensure_data(n);
    if d.is_null() { return; }
    { (*d).common.is_visible = v };
    touch(n, props::C_IS_VISIBLE);
}

fn is_visible(n: *Node) -> bool {
    let d: *Data = node_data(n);
    if d.is_null() { return true; }
    return { (*d).common.is_visible };
}

// Rounded corners on ANY node, not just the four controls that carried their
// own. A `card` is a container, and a container could not be rounded — so the
// one shape every card design asks for was the shape the vocabulary could not
// say, and an app had to fake it with a box behind a stack.
fn set_corner_radius(n: *Node, v: vocab::Corners) {
    let d: *Data = ensure_data(n);
    if d.is_null() { return; }
    { (*d).common.corner_radius = v };
    touch(n, props::C_CORNER_RADIUS);
}

fn corner_radius(n: *Node) -> vocab::Corners {
    let d: *Data = node_data(n);
    if d.is_null() { return vocab::Corners::none(); }
    return { (*d).common.corner_radius };
}

fn set_background_color(n: *Node, v: vocab::Color) {
    let d: *Data = ensure_data(n);
    if d.is_null() { return; }
    { (*d).common.background_color = v };
    touch(n, props::C_BACKGROUND_COLOR);
}

fn background_color(n: *Node) -> vocab::Color {
    let d: *Data = node_data(n);
    if d.is_null() { return vocab::Color::clear(); }
    return { (*d).common.background_color };
}

fn set_background(n: *Node, v: vocab::Brush) {
    let d: *Data = ensure_data(n);
    if d.is_null() { return; }
    { (*d).common.background = v };
    touch(n, props::C_BACKGROUND);
}

fn background(n: *Node) -> vocab::Brush {
    let d: *Data = node_data(n);
    if d.is_null() { return vocab::Brush::none(); }
    return { (*d).common.background };
}

fn set_shadow(n: *Node, v: vocab::Shadow) {
    let d: *Data = ensure_data(n);
    if d.is_null() { return; }
    { (*d).common.shadow = v };
    touch(n, props::C_SHADOW);
}

fn shadow(n: *Node) -> vocab::Shadow {
    let d: *Data = node_data(n);
    if d.is_null() { return vocab::Shadow::none(); }
    return { (*d).common.shadow };
}

fn set_clip(n: *Node, v: vocab::Shape) {
    let d: *Data = ensure_data(n);
    if d.is_null() { return; }
    { (*d).common.clip = v };
    touch(n, props::C_CLIP);
}

fn clip(n: *Node) -> vocab::Shape {
    let d: *Data = node_data(n);
    if d.is_null() { return vocab::Shape::none(); }
    return { (*d).common.clip };
}

fn set_input_transparent(n: *Node, v: bool) {
    let d: *Data = ensure_data(n);
    if d.is_null() { return; }
    { (*d).common.input_transparent = v };
    touch(n, props::C_INPUT_TRANSPARENT);
}

fn input_transparent(n: *Node) -> bool {
    let d: *Data = node_data(n);
    if d.is_null() { return false; }
    return { (*d).common.input_transparent };
}

fn set_flow_direction(n: *Node, v: vocab::FlowDirection) {
    let d: *Data = ensure_data(n);
    if d.is_null() { return; }
    { (*d).common.flow_direction = v };
    // AND THE LAYOUT ENGINE, which is the half that was missing. The backend
    // flipped the VIEW — AppKit's userInterfaceLayoutDirection — and nothing
    // ever told flex, so an app in an RTL locale drew right-to-left text inside
    // a tree still laid out left-to-right: the sidebar stayed on the left and
    // every `Start` alignment pointed the wrong way.
    //
    // flex has had `Direction` since the beginning and facet simply never
    // spoke it. `MatchParent` is `Inherit`, which is what a node that has not
    // chosen means.
    { (*n).set_direction(flex_direction_of(v)) };
    touch(n, props::C_LAYOUT);
    touch(n, props::C_FLOW_DIRECTION);
}

fn flex_direction_of(v: vocab::FlowDirection) -> flex::Direction {
    return match v {
        vocab::FlowDirection::LeftToRight => flex::Direction::LTR,
        vocab::FlowDirection::RightToLeft => flex::Direction::RTL,
        vocab::FlowDirection::MatchParent => flex::Direction::Inherit,
    };
}

fn flow_direction(n: *Node) -> vocab::FlowDirection {
    let d: *Data = node_data(n);
    if d.is_null() { return vocab::FlowDirection::MatchParent; }
    return { (*d).common.flow_direction };
}

// ---- the transform band -----------------------------------------------------
// One dirty bit for the lot: a backend rebuilds the whole transform from these
// nine numbers anyway, so nine bits would buy it nothing.

fn set_rotation(n: *Node, v: f64) {
    let d: *Data = ensure_data(n);
    if d.is_null() { return; }
    { (*d).common.rotation = v };
    _snap_channel(d, n, props::ANIM_TRANSFORM, props::SNAP_TRANSFORM);
    touch(n, props::C_TRANSFORM);
}

fn rotation(n: *Node) -> f64 {
    let d: *Data = node_data(n);
    if d.is_null() { return 0.0f64; }
    return { (*d).common.rotation };
}

fn set_rotation_x(n: *Node, v: f64) {
    let d: *Data = ensure_data(n);
    if d.is_null() { return; }
    { (*d).common.rotation_x = v };
    _snap_channel(d, n, props::ANIM_TRANSFORM, props::SNAP_TRANSFORM);
    touch(n, props::C_TRANSFORM);
}

fn rotation_x(n: *Node) -> f64 {
    let d: *Data = node_data(n);
    if d.is_null() { return 0.0f64; }
    return { (*d).common.rotation_x };
}

fn set_rotation_y(n: *Node, v: f64) {
    let d: *Data = ensure_data(n);
    if d.is_null() { return; }
    { (*d).common.rotation_y = v };
    _snap_channel(d, n, props::ANIM_TRANSFORM, props::SNAP_TRANSFORM);
    touch(n, props::C_TRANSFORM);
}

fn rotation_y(n: *Node) -> f64 {
    let d: *Data = node_data(n);
    if d.is_null() { return 0.0f64; }
    return { (*d).common.rotation_y };
}

fn set_scale(n: *Node, v: f64) {
    let d: *Data = ensure_data(n);
    if d.is_null() { return; }
    { (*d).common.scale = v };
    _snap_channel(d, n, props::ANIM_TRANSFORM, props::SNAP_TRANSFORM);
    touch(n, props::C_TRANSFORM);
}

fn scale(n: *Node) -> f64 {
    let d: *Data = node_data(n);
    if d.is_null() { return 1.0f64; }
    return { (*d).common.scale };
}

fn set_scale_x(n: *Node, v: f64) {
    let d: *Data = ensure_data(n);
    if d.is_null() { return; }
    { (*d).common.scale_x = v };
    _snap_channel(d, n, props::ANIM_TRANSFORM, props::SNAP_TRANSFORM);
    touch(n, props::C_TRANSFORM);
}

fn scale_x(n: *Node) -> f64 {
    let d: *Data = node_data(n);
    if d.is_null() { return 1.0f64; }
    return { (*d).common.scale_x };
}

fn set_scale_y(n: *Node, v: f64) {
    let d: *Data = ensure_data(n);
    if d.is_null() { return; }
    { (*d).common.scale_y = v };
    _snap_channel(d, n, props::ANIM_TRANSFORM, props::SNAP_TRANSFORM);
    touch(n, props::C_TRANSFORM);
}

fn scale_y(n: *Node) -> f64 {
    let d: *Data = node_data(n);
    if d.is_null() { return 1.0f64; }
    return { (*d).common.scale_y };
}

fn set_translation_x(n: *Node, v: f64) {
    let d: *Data = ensure_data(n);
    if d.is_null() { return; }
    { (*d).common.translation_x = v };
    _snap_channel(d, n, props::ANIM_TRANSFORM, props::SNAP_TRANSFORM);
    touch(n, props::C_TRANSFORM);
}

fn translation_x(n: *Node) -> f64 {
    let d: *Data = node_data(n);
    if d.is_null() { return 0.0f64; }
    return { (*d).common.translation_x };
}

fn set_translation_y(n: *Node, v: f64) {
    let d: *Data = ensure_data(n);
    if d.is_null() { return; }
    { (*d).common.translation_y = v };
    _snap_channel(d, n, props::ANIM_TRANSFORM, props::SNAP_TRANSFORM);
    touch(n, props::C_TRANSFORM);
}

fn translation_y(n: *Node) -> f64 {
    let d: *Data = node_data(n);
    if d.is_null() { return 0.0f64; }
    return { (*d).common.translation_y };
}

fn set_anchor_x(n: *Node, v: f64) {
    let d: *Data = ensure_data(n);
    if d.is_null() { return; }
    { (*d).common.anchor_x = v };
    touch(n, props::C_TRANSFORM);
}

fn anchor_x(n: *Node) -> f64 {
    let d: *Data = node_data(n);
    if d.is_null() { return 0.5f64; }
    return { (*d).common.anchor_x };
}

fn set_anchor_y(n: *Node, v: f64) {
    let d: *Data = ensure_data(n);
    if d.is_null() { return; }
    { (*d).common.anchor_y = v };
    touch(n, props::C_TRANSFORM);
}

fn anchor_y(n: *Node) -> f64 {
    let d: *Data = node_data(n);
    if d.is_null() { return 0.5f64; }
    return { (*d).common.anchor_y };
}

// z order is flex's style field. Forward to it rather than keep a second copy
// that the layout engine would then have to be told about.
//
// C_LAYOUT, not a bit of its own: z is paint ORDER, and the walk that answers
// it is the same walk that answers geometry — a backend orders native
// siblings while it is placing them. It had the same hole as the size verbs
// (write the value, tell nobody).
fn set_z_index(n: *Node, v: i64) {
    if n.is_null() { return; }
    { (*n).set_z_index(v as i32) };
    touch(n, props::C_LAYOUT);
}

fn z_index(n: *Node) -> i64 {
    if n.is_null() { return 0 as i64; }
    return { (*n).z_index() } as i64;
}

// ---- live layout ------------------------------------------------------------
// flex's own fluent modifiers (`.width(120.0)`, `.padding(8.0)`) take `this`
// BY VALUE, so they belong to the description and cannot be called through a
// cursor's pointer. These are the same words as live setters.
//
// The names are flex's, deliberately: this is not a second layout vocabulary,
// it is the same one reachable after mount. Anything not here — per-edge
// padding, grid, position type, breakpoints — is reached with `node()`, which
// every cursor has.
//
// ONE TRAP, and it is the same one the DOM has with `style.width` versus
// `offsetWidth`: `set_width` writes the STYLE, `width()` reads the LAID-OUT
// frame. They agree only after a layout pass.
//
// Every one of these touches props::C_LAYOUT. They did not, and that was the
// hole: a prop setter marks its node dirty, the dirty mark wakes the backend
// through M5, and the backend applies it — but a size write did neither, so
// `sidebar.set_width(300.0)` in a click handler updated flex's style and
// reached no screen. The bit says GEOMETRY, not props: the backend answers it
// with one layout pass per window and a frame walk, never with a re-read of
// this node's props.
//
// This is what the retained-relayout work (9a54a0b) is built on and it costs
// nothing when nothing moved: flex's incremental cache skips unchanged
// subtrees, and the frame walk prunes itself on `Node::layout_changed()`.
// Waking on the write is the point — polling a layout pass every idle turn
// would pay that cost forever instead of only when something actually moved.

fn set_grow(n: *Node, v: f64) {
    if n.is_null() { return; }
    { (*n).set_flex_grow(v) };
    touch(n, props::C_LAYOUT);
}

fn set_shrink(n: *Node, v: f64) {
    if n.is_null() { return; }
    { (*n).set_flex_shrink(v) };
    touch(n, props::C_LAYOUT);
}

// The size a node starts from BEFORE grow and shrink divide the free space.
// Zero is the useful value: it takes the node's own content out of the
// calculation, so its size is purely its share of what the parent offers.
// `spacer` is built on it, and a split needs it for the same reason — a
// container whose job is to divide space must not be sized by what it holds.
// PERCENT, which is the half that makes a layout responsive. `set_min_width`
// above takes points, and points do not adapt — a sidebar that must never fall
// below a fifth of the window is saying something about the WINDOW, and there
// was no way to say it. flex's StyleLength carried percent all along; facet
// exposed it for width and height only.
fn set_min_width_percent(n: *Node, v: f64) {
    if n.is_null() { return; }
    { (*n).set_min_width(flex::StyleLength::percent(v)) };
    touch(n, props::C_LAYOUT);
}

fn set_min_height_percent(n: *Node, v: f64) {
    if n.is_null() { return; }
    { (*n).set_min_height(flex::StyleLength::percent(v)) };
    touch(n, props::C_LAYOUT);
}

fn set_max_width_percent(n: *Node, v: f64) {
    if n.is_null() { return; }
    { (*n).set_max_width(flex::StyleLength::percent(v)) };
    touch(n, props::C_LAYOUT);
}

fn set_max_height_percent(n: *Node, v: f64) {
    if n.is_null() { return; }
    { (*n).set_max_height(flex::StyleLength::percent(v)) };
    touch(n, props::C_LAYOUT);
}

// An overlay placed as a FRACTION of its parent — centred cards, sheets that
// take half the window, a toast a tenth from the bottom.
fn set_left_percent(n: *Node, v: f64) {
    if n.is_null() { return; }
    { (*n).set_position(flex::Edge::Left, flex::StyleLength::percent(v)) };
    touch(n, props::C_LAYOUT);
}

fn set_top_percent(n: *Node, v: f64) {
    if n.is_null() { return; }
    { (*n).set_position(flex::Edge::Top, flex::StyleLength::percent(v)) };
    touch(n, props::C_LAYOUT);
}

fn set_right_percent(n: *Node, v: f64) {
    if n.is_null() { return; }
    { (*n).set_position(flex::Edge::Right, flex::StyleLength::percent(v)) };
    touch(n, props::C_LAYOUT);
}

fn set_bottom_percent(n: *Node, v: f64) {
    if n.is_null() { return; }
    { (*n).set_position(flex::Edge::Bottom, flex::StyleLength::percent(v)) };
    touch(n, props::C_LAYOUT);
}

// Does a width MEAN the content box or the whole box including padding and
// border? CSS's `border-box` is what almost every author assumes, and a fixed
// width that padding then widened is the classic surprise.
fn set_box_sizing(n: *Node, v: flex::BoxSizing) {
    if n.is_null() { return; }
    { (*n).set_box_sizing(v) };
    touch(n, props::C_LAYOUT);
}

// ---- the grid engine flex already had ---------------------------------------
//
// Seven setters, none of them reachable. `collection.set_columns` was built out
// of wrap plus a width share before anyone noticed a real grid was sitting
// underneath — that still works and is right for a materialised sequence, but a
// hand-built layout wanting a cell two columns wide had nothing.
//
// The span and start verbs belong to an ITEM, `dense` and the subgrid pair to
// the CONTAINER. Named as flex names them, because a grid is one of the few
// places where the web's vocabulary is the one everybody already knows.

// Item: how many tracks this cell covers.
fn set_grid_column_span(n: *Node, v: i32) {
    if n.is_null() { return; }
    { (*n).set_grid_column_span(v) };
    touch(n, props::C_LAYOUT);
}

fn set_grid_row_span(n: *Node, v: i32) {
    if n.is_null() { return; }
    { (*n).set_grid_row_span(v) };
    touch(n, props::C_LAYOUT);
}

// Item: which line it starts on, for a cell that must sit somewhere exact.
fn set_grid_column_start(n: *Node, v: i32) {
    if n.is_null() { return; }
    { (*n).set_grid_column_start(v) };
    touch(n, props::C_LAYOUT);
}

fn set_grid_row_start(n: *Node, v: i32) {
    if n.is_null() { return; }
    { (*n).set_grid_row_start(v) };
    touch(n, props::C_LAYOUT);
}

// Container: backfill holes left by spans instead of leaving them.
fn set_grid_dense(n: *Node, on: bool) {
    if n.is_null() { return; }
    { (*n).set_grid_dense(on) };
    touch(n, props::C_LAYOUT);
}

// Container: adopt the parent grid's tracks rather than starting new ones, so
// a nested section stays aligned with the rows around it.
fn set_grid_columns_subgrid(n: *Node, on: bool) {
    if n.is_null() { return; }
    { (*n).set_grid_columns_subgrid(on) };
    touch(n, props::C_LAYOUT);
}

fn set_grid_rows_subgrid(n: *Node, on: bool) {
    if n.is_null() { return; }
    { (*n).set_grid_rows_subgrid(on) };
    touch(n, props::C_LAYOUT);
}

// ---- what this node is, for anyone not looking at it ------------------------
//
// The agent surface has carried a name and a description per node since it
// existed, and nothing ever filled them: `identity::NodeView` declares both and
// the only writer was a key. VoiceOver reads the same two facts. So these are
// one set of verbs serving two readers, and the absence cost both — an agent
// guessing a control's purpose from its key, and a screen reader with nothing
// to say about it at all.
//
// The heading level is what makes a window SKIMMABLE. Without it a screen
// reader can only read start to finish.

fn set_accessibility_label(n: *Node, v: str) {
    let d: *Data = ensure_data(n);
    if d.is_null() { return; }
    { (*d).common.accessibility_label = text::from_str(v) };
    touch(n, props::C_SEMANTICS);
}

fn accessibility_label(n: *Node) -> str {
    if n.is_null() { return ""; }
    let d: *Data = { (*n).data() };
    if d.is_null() { return ""; }
    return { (*d).common.accessibility_label.view() };
}

// ---- what an agent may do with this node's content ---------------------------
//
// The other half of "what this node is, for anyone not looking at it", and the
// half with a security boundary on it. A node's EXISTENCE and its CONTENT are
// separate grants: `Protected` and `Private` both stay in the agent's tree,
// named, navigable and reported as present — and hand over no value without a
// grant carrying the matching capability. `Hidden` takes the subtree out of the
// agent's world altogether.
//
// Declared here and INHERITED downward by agent_core, strictest-wins, so the
// thing a developer marks is usually the box rather than each field. The leak
// is never the field you remembered; it is the "Card ending 4242" label beside
// it, which is a plain label nobody thinks to mark.
//
// This writes a FACT on the node. The pin that carries it to the platform
// happens at mount, through the same install seam every other agent hookup
// uses — see `runtime::AgentHooks`. An app that never serves an agent pays a
// stored enum and nothing else.
fn set_agent(n: *Node, v: vocab::Agent) {
    let d: *Data = ensure_data(n);
    if d.is_null() { return; }
    { (*d).common.agent = v };
    touch(n, props::C_AGENT);
}

fn agent(n: *Node) -> vocab::Agent {
    if n.is_null() { return vocab::Agent::Open; }
    let d: *Data = { (*n).data() };
    if d.is_null() { return vocab::Agent::Open; }
    return { (*d).common.agent };
}

fn set_accessibility_hint(n: *Node, v: str) {
    let d: *Data = ensure_data(n);
    if d.is_null() { return; }
    { (*d).common.accessibility_hint = text::from_str(v) };
    touch(n, props::C_SEMANTICS);
}

fn accessibility_hint(n: *Node) -> str {
    if n.is_null() { return ""; }
    let d: *Data = { (*n).data() };
    if d.is_null() { return ""; }
    return { (*d).common.accessibility_hint.view() };
}

// 1 is the most important heading on the screen, as on the web. 0 means this
// node is not a heading, which is what almost every node is.
fn set_heading_level(n: *Node, v: i64) {
    let d: *Data = ensure_data(n);
    if d.is_null() { return; }
    { (*d).common.heading_level = v };
    touch(n, props::C_SEMANTICS);
}

fn heading_level(n: *Node) -> i64 {
    if n.is_null() { return 0 as i64; }
    let d: *Data = { (*n).data() };
    if d.is_null() { return 0 as i64; }
    return { (*d).common.heading_level };
}

// The hover text. Any node can want one, which is why the ledger models it as
// an attached property and why it belongs to the band rather than to a control.
fn set_tooltip(n: *Node, v: str) {
    let d: *Data = ensure_data(n);
    if d.is_null() { return; }
    { (*d).common.tooltip = text::from_str(v) };
    touch(n, props::C_TOOLTIP);
}

fn tooltip(n: *Node) -> str {
    if n.is_null() { return ""; }
    let d: *Data = { (*n).data() };
    if d.is_null() { return ""; }
    return { (*d).common.tooltip.view() };
}

// ---- what flex could always do and facet never said -------------------------
//
// facet's band forwarded 14 of flex_layout's 38 style setters. The other 24 were
// not decisions — nobody had counted. An application that needed a minimum
// width, a card with a fixed aspect, an absolutely-placed overlay or a runtime
// direction change found the tree simply had no word for it, and the layout
// engine underneath had had one all along.
//
// None of these need a backend. flex computes the frames and the frame walk
// applies them, so a verb here is live the moment it is written — which is also
// why their absence was so cheap to keep.
//
// UNREACHABLE IS TOO STRONG, and the compiler said so: `Node` IS `flex::Node`,
// so `n.set_min_width(flex::StyleLength::points(12.0f64))` always worked. Eight
// of these names already exist on flex's Node taking a StyleLength, and a
// same-named f64 forward in `impl Node` collides with it (no overloading) —
// which is why those eight are FREE FUNCTIONS here and not cursor methods.
//
// So what was missing is facet's SHAPE, not the capability: points as a plain
// f64, a dirty bit raised so the tree actually relayouts, and a name in the band
// an author reads. `set_position_type` + `Edge` + `StyleLength` is the same
// sentence with the grammar showing, and nobody was writing it.

// ABSOLUTE PLACEMENT — the answer to "where does a toast live". A node taken out
// of flow is positioned against its parent's box by the four edges below, so an
// overlay is an ordinary node that says where it sits, not a new layer with a
// registry of its own.
fn set_absolute(n: *Node, on: bool) {
    if n.is_null() { return; }
    let t: flex::PositionType = if on { flex::PositionType::Absolute }
                                else { flex::PositionType::Relative };
    { (*n).set_position_type(t) };
    touch(n, props::C_LAYOUT);
}

fn is_absolute(n: *Node) -> bool {
    if n.is_null() { return false; }
    return match { (*n).position_type() } {
        flex::PositionType::Absolute => true,
        _ => false,
    };
}

// The four edges, named rather than passed as an enum, because `set_left(n, 12)`
// is what an author means and `set_position(n, Edge::Left, points(12))` is the
// same sentence with the grammar showing.
fn set_left(n: *Node, v: f64) {
    if n.is_null() { return; }
    { (*n).set_position(flex::Edge::Left, flex::StyleLength::points(v)) };
    touch(n, props::C_LAYOUT);
}

fn set_top(n: *Node, v: f64) {
    if n.is_null() { return; }
    { (*n).set_position(flex::Edge::Top, flex::StyleLength::points(v)) };
    touch(n, props::C_LAYOUT);
}

fn set_right(n: *Node, v: f64) {
    if n.is_null() { return; }
    { (*n).set_position(flex::Edge::Right, flex::StyleLength::points(v)) };
    touch(n, props::C_LAYOUT);
}

fn set_bottom(n: *Node, v: f64) {
    if n.is_null() { return; }
    { (*n).set_position(flex::Edge::Bottom, flex::StyleLength::points(v)) };
    touch(n, props::C_LAYOUT);
}

// CONSTRAINTS. A growing node with no floor collapses under pressure and one
// with no ceiling eats the window; both are ordinary things to want and neither
// could be said.
fn set_min_width(n: *Node, v: f64) {
    if n.is_null() { return; }
    { (*n).set_min_width(flex::StyleLength::points(v)) };
    touch(n, props::C_LAYOUT);
}

fn set_min_height(n: *Node, v: f64) {
    if n.is_null() { return; }
    { (*n).set_min_height(flex::StyleLength::points(v)) };
    touch(n, props::C_LAYOUT);
}

fn set_max_width(n: *Node, v: f64) {
    if n.is_null() { return; }
    { (*n).set_max_width(flex::StyleLength::points(v)) };
    touch(n, props::C_LAYOUT);
}

fn set_max_height(n: *Node, v: f64) {
    if n.is_null() { return; }
    { (*n).set_max_height(flex::StyleLength::points(v)) };
    touch(n, props::C_LAYOUT);
}

// One child disagreeing with its siblings' alignment, without a wrapper row
// built to hold the disagreement.
fn set_align_self(n: *Node, v: flex::Align) {
    if n.is_null() { return; }
    { (*n).set_align_self(v) };
    touch(n, props::C_LAYOUT);
}

// How WRAPPED LINES sit against each other — which `set_columns` on a
// collection made reachable and then had no way to control.
fn set_align_content(n: *Node, v: flex::Align) {
    if n.is_null() { return; }
    { (*n).set_align_content(v) };
    touch(n, props::C_LAYOUT);
}

// A card that stays 16:9 whatever width it is given.
fn set_aspect_ratio(n: *Node, v: f64) {
    if n.is_null() { return; }
    { (*n).set_aspect_ratio(v) };
    touch(n, props::C_LAYOUT);
}

// `row` and `column` are CONSTRUCTORS, so a container built one way stayed that
// way for life. A responsive layout that stacks when narrow needs to say it.
//
// Named `set_flow` and not `set_direction`, because flex::Node already has a
// `set_direction` and it means something else entirely — LTR versus RTL. Two
// verbs one letter apart that change different things is worse than a new word.
fn set_flow(n: *Node, v: flex::FlexDirection) {
    if n.is_null() { return; }
    { (*n).set_flex_direction(v) };
    touch(n, props::C_LAYOUT);
}

// Clip or spill. A pane whose content overflows had no way to say which.
fn set_overflow(n: *Node, v: flex::Overflow) {
    if n.is_null() { return; }
    { (*n).set_overflow(v) };
    touch(n, props::C_LAYOUT);
}

fn set_basis(n: *Node, v: f64) {
    if n.is_null() { return; }
    { (*n).set_flex_basis(flex::StyleLength::points(v)) };
    touch(n, props::C_LAYOUT);
}

fn set_width(n: *Node, v: f64) {
    if n.is_null() { return; }
    { (*n).set_width(flex::StyleLength::points(v)) };
    touch(n, props::C_LAYOUT);
}

fn set_height(n: *Node, v: f64) {
    if n.is_null() { return; }
    { (*n).set_height(flex::StyleLength::points(v)) };
    touch(n, props::C_LAYOUT);
}

fn set_width_percent(n: *Node, v: f64) {
    if n.is_null() { return; }
    { (*n).set_width(flex::StyleLength::percent(v)) };
    touch(n, props::C_LAYOUT);
}

fn set_height_percent(n: *Node, v: f64) {
    if n.is_null() { return; }
    { (*n).set_height(flex::StyleLength::percent(v)) };
    touch(n, props::C_LAYOUT);
}

fn set_padding(n: *Node, v: f64) {
    if n.is_null() { return; }
    { (*n).set_padding(flex::Edge::All, flex::StyleLength::points(v)) };
    touch(n, props::C_LAYOUT);
}

fn set_margin(n: *Node, v: f64) {
    if n.is_null() { return; }
    { (*n).set_margin(flex::Edge::All, flex::StyleLength::points(v)) };
    touch(n, props::C_LAYOUT);
}

// Per-EDGE padding and margin. `set_padding(v)` writes all four, which is the
// common case and stays; asymmetric insets were three imperative
// `{ (*n).set_padding(Edge::Top, StyleLength::points(v)) }` calls after the
// @ui block, each of them a write past the dirty-bit seam.
fn set_padding_edge(n: *Node, edge: flex::Edge, v: f64) {
    if n.is_null() { return; }
    { (*n).set_padding(edge, flex::StyleLength::points(v)) };
    touch(n, props::C_LAYOUT);
}

fn set_margin_edge(n: *Node, edge: flex::Edge, v: f64) {
    if n.is_null() { return; }
    { (*n).set_margin(edge, flex::StyleLength::points(v)) };
    touch(n, props::C_LAYOUT);
}

fn set_gap(n: *Node, v: f64) {
    if n.is_null() { return; }
    { (*n).set_gap(flex::Gutter::All, flex::StyleLength::points(v)) };
    touch(n, props::C_LAYOUT);
}

fn set_justify(n: *Node, v: flex::Justify) {
    if n.is_null() { return; }
    { (*n).set_justify_content(v) };
    touch(n, props::C_LAYOUT);
}

fn set_align(n: *Node, v: flex::Align) {
    if n.is_null() { return; }
    { (*n).set_align_items(v) };
    touch(n, props::C_LAYOUT);
}

fn set_wrap(n: *Node, v: flex::Wrap) {
    if n.is_null() { return; }
    { (*n).set_flex_wrap(v) };
    touch(n, props::C_LAYOUT);
}

// ---- reads flex already owns: forward, store nothing -------------------------
fn frame_of(n: *Node) -> Frame { return { (*n).frame() }; }
fn width_of(n: *Node) -> f64 { return { (*n).frame() }.width; }
fn height_of(n: *Node) -> f64 { return { (*n).frame() }.height; }
fn x_of(n: *Node) -> f64 { return { (*n).frame() }.left; }
fn y_of(n: *Node) -> f64 { return { (*n).frame() }.top; }
fn child_count_of(n: *Node) -> usize { return { (*n).child_count() }; }

fn bounds_of(n: *Node) -> vocab::Rect {
    let f: Frame = { (*n).frame() };
    return vocab::Rect { x: f.left, y: f.top, width: f.width, height: f.height };
}

fn child_of(n: *Node, at: usize) -> option::Option[*Node] {
    if n.is_null() { return option::Option[*Node]::None; }
    return { (*n).child_ptr(at) };
}

// ---- what the platform learns first -----------------------------------------
// facet declares the read; a backend writes it. These three setters are the
// write path back into a node's state, and the only ones a backend needs.

fn is_focused(n: *Node) -> bool {
    let d: *Data = node_data(n);
    if d.is_null() { return false; }
    return { (*d).is_focused };
}

fn set_focused(n: *Node, v: bool) {
    let d: *Data = ensure_data(n);
    if d.is_null() { return; }
    { (*d).is_focused = v };
}

fn is_attached(n: *Node) -> bool {
    let d: *Data = node_data(n);
    if d.is_null() { return false; }
    return { (*d).is_attached };
}

fn set_attached(n: *Node, v: bool) {
    let d: *Data = ensure_data(n);
    if d.is_null() { return; }
    { (*d).is_attached = v };
}

fn window_of(n: *Node) -> vocab::WindowRef {
    let d: *Data = node_data(n);
    if d.is_null() { return vocab::WindowRef::none(); }
    return { (*d).window };
}

fn set_window(n: *Node, w: vocab::WindowRef) {
    let d: *Data = ensure_data(n);
    if d.is_null() { return; }
    { (*d).window = w };
}

// ---- where a character is -----------------------------------------------------
// The fourth thing a backend writes back, and the only one that is a function
// rather than a value. See `Data.caret_probe` for why it is a probe.

fn set_caret_probe(n: *Node, f: fn(*u8, i64, *vocab::Rect) -> bool) {
    let d: *Data = ensure_data(n);
    if d.is_null() { return; }
    { (*d).caret_probe = f };
}

fn has_caret_probe(n: *Node) -> bool {
    let d: *Data = node_data(n);
    if d.is_null() { return false; }
    return { (*d).caret_probe } != (0 as fn(*u8, i64, *vocab::Rect) -> bool);
}

// The box of the character at `offset`, in THIS NODE'S own coordinate space —
// the same space `frame()` reports the node's children in, top-left origin, so
// a popup is positioned against it with the ordinary absolute-placement verbs
// and no further conversion.
//
// A ZERO-LENGTH box at the offset is the caret; a text surface answers the
// insertion point's box there, which is what an input method is shown and
// therefore what the platform is best at. Past the end of the text the answer
// is the box the next character WOULD occupy — that is where a caret sits, and
// an editor asks for it constantly.
//
// None, and it means one of three things, all of them honest: this node is not
// a text surface, it is not mounted, or its backend cannot answer right now.
// It is never a guess. Application-side arithmetic over a font's advance is
// wrong for the first proportional face, the first ligature and the first
// astral character, and wrong silently.
fn rect_for_offset(n: *Node, offset: i64) -> option::Option[vocab::Rect] {
    let d: *Data = node_data(n);
    if d.is_null() { return option::Option[vocab::Rect]::None; }
    let f: fn(*u8, i64, *vocab::Rect) -> bool = { (*d).caret_probe };
    if f.is_null() {
        return option::Option[vocab::Rect]::None;
    }
    let v: *u8 = { (*d).view };
    if v.is_null() { return option::Option[vocab::Rect]::None; }
    var out: vocab::Rect = vocab::Rect::zero();
    if !f(v, offset, #addr_of(out)) { return option::Option[vocab::Rect]::None; }
    return option::some(out);
}

// The escape hatch INTENT blesses: the platform's own view, or 0 while the
// node is unmounted. The one verb in facet that names a backend.
fn native(n: *Node) -> *u8 {
    let d: *Data = node_data(n);
    if d.is_null() { return 0 as *u8; }
    return { (*d).view };
}

// ADOPT a platform view as a node — the other direction from `native`, which
// reads the view a mounted node already has.
//
// A widget built entirely outside facet (vendor/terminal's NSTextView in its
// scroller) has a view and no node, and needs to sit in a facet tree as a leaf.
// Nothing could express that: `set_native` writes a view onto an EXISTING node
// and `native` reads one off, so `native(handle)` — which is what terminal
// wrote — had the argument and the return type backwards, and there was no
// third verb to reach for.
//
// The node owns the retain. `release` is how it gives it back, and it fires on
// drop, on detach, and when a later view replaces this one — the same contract
// `set_view` states for a backend-created view, because this IS that pairing
// with the view supplied from outside.
//
// A LEAF: it has no children and no props, so the mount walk inserts the view
// and stops. Layout is flex's as usual — size it with the ordinary verbs.
// `measure` is flex's own intrinsic-size hook, and it is optional because the
// two cases are genuinely different: a map view fills the box it is given and
// wants no measure, while an ad banner or a platform sign-in button has a size
// of its own. The ctx flex passes it is THE VIEW — the same convention every
// backend uses for its controls — so one measure fn serves every node it is
// installed on without the caller threading a context through.
fn adopt_native(v: *u8, release: fn(*u8), key: str = "",
                measure: fn(*u8, f64, flex::MeasureMode, f64, flex::MeasureMode) -> flex::Size
                    = 0 as fn(*u8, f64, flex::MeasureMode, f64, flex::MeasureMode) -> flex::Size) -> Node {
    var n: Node = flex::Node::new();
    let d: *Data = ensure_data(#addr_of(n));
    if d.is_null() { return n; }
    { (*d).key = text::from_str(key) };
    { (*d).view = v };
    { (*d).view_release = release };
    { (*d).view_adopted = true };
    { (*d).native_measure = measure };
    // The view is already here, so the hook can go on now.
    install_native_measure(#addr_of(n), v);
    return n;
}

// The FACTORY form: a recipe for the view rather than the view.
//
// Everything `adopt_native` says holds — a leaf, the node owns the retain,
// `release` is how it gives it back — with one difference, and it is the
// reason this exists: the view is built at MOUNT time, once per mount, and the
// previous one is released first. See `Data.native_create` for why Android
// makes that mandatory rather than merely tidier.
//
// `create` runs on the UI thread, inside the mount walk, and must return a
// view at +1 — the same contract a backend's `create` has, because this IS
// that contract with the application supplying the implementation.
// `create_ctx` is REQUIRED rather than defaulted, and that is the handler
// convention paying rather than an oversight: a caller writing
// `create: this.build_map` passes two things — the method and its receiver —
// and the `*u8` immediately after the handler is where the receiver goes
// (W0824). A default there would push `release` behind it, and a required
// parameter cannot follow a defaulted one (E1007). Callers with a free
// function pass `0 as *u8`, which is also the honest spelling: the ctx must
// outlive the node, and naming it at every call site is where that is noticed.
fn adopt_native_with(create: fn(*u8) -> *u8, create_ctx: *u8, release: fn(*u8), key: str = "",
                     measure: fn(*u8, f64, flex::MeasureMode, f64, flex::MeasureMode) -> flex::Size
                         = 0 as fn(*u8, f64, flex::MeasureMode, f64, flex::MeasureMode) -> flex::Size) -> Node {
    var n: Node = flex::Node::new();
    let d: *Data = ensure_data(#addr_of(n));
    if d.is_null() { return n; }
    { (*d).key = text::from_str(key) };
    { (*d).view = 0 as *u8 };
    { (*d).view_release = release };
    { (*d).view_adopted = true };
    { (*d).native_create = create };
    { (*d).native_create_ctx = create_ctx };
    { (*d).native_measure = measure };
    return n;
}

// Put the measure hook on the node, now that there is a view to measure.
// Private: the two adopt verbs and `make_native` are the callers, and each
// calls it at the one moment the view becomes known.
fn install_native_measure(n: *Node, v: *u8) {
    if n.is_null() || v.is_null() { return; }
    let d: *Data = { (*n).data() };
    if d.is_null() { return; }
    let m: fn(*u8, f64, flex::MeasureMode, f64, flex::MeasureMode) -> flex::Size = { (*d).native_measure };
    if m.is_null() { return; }
    // flex's spare slot. facet's Data rides the ATTACHMENT, and the backends
    // put the view here for exactly this reason — nothing else wants it.
    { (*n).set_context(v) };
    { (*n).set_measure(m) };
}

// Does this node build its own view on mount? The mount walk's question.
fn has_native_factory(n: *Node) -> bool {
    if n.is_null() { return false; }
    let d: *Data = { (*n).data() };
    if d.is_null() { return false; }
    return { (*d).native_create } != (0 as fn(*u8) -> *u8);
}

// Run the factory: release the outgoing view, build the replacement, install
// it with the release the caller paired, and hand it back.
//
// The release comes FIRST and that ordering is deliberate. A backend view is
// a scarce, retained platform object; holding two while the new one is being
// built buys nothing and, on a surface that registers itself somewhere global
// (a map view with a location subscription), means both are live and both are
// listening for the moment in between.
fn make_native(n: *Node) -> *u8 {
    if n.is_null() { return 0 as *u8; }
    let d: *Data = { (*n).data() };
    if d.is_null() { return 0 as *u8; }
    let f: fn(*u8) -> *u8 = { (*d).native_create };
    if f.is_null() { return { (*d).view }; }
    let old: *u8 = { (*d).view };
    if old.is_not_null() {
        let r: fn(*u8) = { (*d).view_release };
        { (*d).view = 0 as *u8 };
        if r.is_not_null() { r(old); }
    }
    let v: *u8 = f({ (*d).native_create_ctx });
    { (*d).view = v };
    install_native_measure(n, v);
    return v;
}

fn set_native(n: *Node, v: *u8) {
    let d: *Data = ensure_data(n);
    if d.is_null() { return; }
    { (*d).view = v };
}

// ---- commands ---------------------------------------------------------------
// Same shape as a setter: write, set a bit, let the backend act on it. No
// verb-indexed table, no registrar.

fn focus(n: *Node) { touch(n, props::C_FOCUS); return; }
fn blur(n: *Node) { touch(n, props::C_BLUR); return; }

// ---- animate_* --------------------------------------------------------------
// MAUI ViewExtensions.*To: end values land in the real shared-band fields so
// reads/agent/find stay true; C_ANIMATE asks the backend to interpolate rather
// than snap. Timing is one pair (duration, easing) for the channels OR'd into
// animate_channels — concurrent animate_* before the next tick share the last
// timing write, which is the same rule as stacking animator calls.
//
// TWO CHANNELS: opacity, and the transform AS A UNIT. `props::ANIM_TRANSFORM`
// says why the nine transform numbers cannot have nine of their own.
//
// ONE FIELD, ONE APPLY. `set_opacity(0); animate_opacity(1)` in the SAME tick
// is not a fade-in: both write `opacity`, the second wins, and the backend
// interpolates from wherever the view already was to a value it is already at.
// The start value has to reach the view in an EARLIER apply — set it at build
// time, or from `on_attach`, and animate after. `_arm_animate` says so out
// loud rather than leaving it a silent no-op.

// A `set_*` on an animatable band does two things beyond the write: it cancels
// any pending animation of that band, and — only when the node is already
// BACKED — records that the view has a value coming which it has not seen yet.
//
// The backed gate is the whole accuracy of the record. A set at BUILD time
// lands on a node with no view, and `create` reads the current field values on
// its way past, so that set IS applied — it is the entrance pattern, not a
// mistake, and warning about it would fire on the one spelling that works.
fn _snap_channel(d: *Data, n: *Node, anim: u32, snap: u32) {
    var ch: u32 = { (*d).common.animate_channels } & ~anim;
    if view_of(n) != (0 as *u8) { ch = ch | snap; }
    { (*d).common.animate_channels = ch };
}

fn _arm_animate(n: *Node, channel: u32, duration: vocab::Duration, easing: vocab::Easing) {
    let d: *Data = ensure_data(n);
    if d.is_null() { return; }
    warn_if_snap_is_dead(n, channel);
    { (*d).common.animate_duration = duration };
    { (*d).common.animate_easing = easing };
    { (*d).common.animate_channels = { (*d).common.animate_channels } | channel };
    touch(n, props::C_ANIMATE);
}

// A `set_*` on this channel is still pending in this tick, so the value it
// wrote is about to be overwritten by the animate's end value and will never
// reach the view. There is no legitimate spelling of that pair — the set is
// unconditionally dead — so it is named rather than dropped. Silent was the
// worst part: the app writes the obvious fade-in, sees nothing move, and has
// nothing to go on.
fn warn_if_snap_is_dead(n: *Node, channel: u32) {
    let d: *Data = node_data(n);
    if d.is_null() { return; }
    // The SNAP bits, not the dirty word: `touch_all` raises C_OPACITY and
    // C_TRANSFORM on a node nobody set, and warning there would be a lie.
    let pending: u32 = { (*d).common.animate_channels };
    if channel == props::ANIM_OPACITY && (pending & props::SNAP_OPACITY) != (0u32) {
        io::eprintln("facet animate_opacity: a set_opacity in this same tick is dead — both write `opacity`, and the animation starts from what the view already shows. Set the start value a tick earlier (at build, or from on_attach) and animate after.");
        return;
    }
    if channel == props::ANIM_TRANSFORM && (pending & props::SNAP_TRANSFORM) != (0u32) {
        io::eprintln("facet animate_*: a set_scale/rotation/translation in this same tick is dead — both write the transform, and the animation starts from what the view already shows. Set the start value a tick earlier (at build, or from on_attach) and animate after.");
        return;
    }
}

fn animate_opacity(n: *Node, to: f64, duration: vocab::Duration, easing: vocab::Easing) {
    let d: *Data = ensure_data(n);
    if d.is_null() { return; }
    { (*d).common.opacity = to };
    _arm_animate(n, props::ANIM_OPACITY, duration, easing);
}

fn animate_scale(n: *Node, to: f64, duration: vocab::Duration, easing: vocab::Easing) {
    let d: *Data = ensure_data(n);
    if d.is_null() { return; }
    { (*d).common.scale = to };
    _arm_animate(n, props::ANIM_TRANSFORM, duration, easing);
}

fn animate_scale_x(n: *Node, to: f64, duration: vocab::Duration, easing: vocab::Easing) {
    let d: *Data = ensure_data(n);
    if d.is_null() { return; }
    { (*d).common.scale_x = to };
    _arm_animate(n, props::ANIM_TRANSFORM, duration, easing);
}

fn animate_scale_y(n: *Node, to: f64, duration: vocab::Duration, easing: vocab::Easing) {
    let d: *Data = ensure_data(n);
    if d.is_null() { return; }
    { (*d).common.scale_y = to };
    _arm_animate(n, props::ANIM_TRANSFORM, duration, easing);
}

fn animate_rotation(n: *Node, to: f64, duration: vocab::Duration, easing: vocab::Easing) {
    let d: *Data = ensure_data(n);
    if d.is_null() { return; }
    { (*d).common.rotation = to };
    _arm_animate(n, props::ANIM_TRANSFORM, duration, easing);
}

fn animate_rotation_x(n: *Node, to: f64, duration: vocab::Duration, easing: vocab::Easing) {
    let d: *Data = ensure_data(n);
    if d.is_null() { return; }
    { (*d).common.rotation_x = to };
    _arm_animate(n, props::ANIM_TRANSFORM, duration, easing);
}

fn animate_rotation_y(n: *Node, to: f64, duration: vocab::Duration, easing: vocab::Easing) {
    let d: *Data = ensure_data(n);
    if d.is_null() { return; }
    { (*d).common.rotation_y = to };
    _arm_animate(n, props::ANIM_TRANSFORM, duration, easing);
}

fn animate_translation(n: *Node, x: f64, y: f64, duration: vocab::Duration, easing: vocab::Easing) {
    let d: *Data = ensure_data(n);
    if d.is_null() { return; }
    { (*d).common.translation_x = x };
    { (*d).common.translation_y = y };
    _arm_animate(n, props::ANIM_TRANSFORM, duration, easing);
}

// Abort in-flight motion. End values stay in the model; the backend snaps
// presentation to them (freeze-at-presentation is not v1).
fn cancel_animations(n: *Node) {
    let d: *Data = ensure_data(n);
    if d.is_null() { return; }
    { (*d).common.animate_channels = 0u32 };
    touch(n, props::C_CANCEL_ANIMATIONS);
}

fn animate_duration_of(n: *Node) -> vocab::Duration {
    let d: *Data = node_data(n);
    if d.is_null() { return vocab::Duration::animation(); }
    return { (*d).common.animate_duration };
}

fn animate_easing_of(n: *Node) -> vocab::Easing {
    let d: *Data = node_data(n);
    if d.is_null() { return vocab::Easing::SinInOut; }
    return { (*d).common.animate_easing };
}

fn animate_channels_of(n: *Node) -> u32 {
    let d: *Data = node_data(n);
    if d.is_null() { return 0u32; }
    return { (*d).common.animate_channels };
}

fn clear_animate_channels(n: *Node) {
    let d: *Data = node_data(n);
    if d.is_null() { return; }
    { (*d).common.animate_channels = 0u32 };
}

// Invalidate this subtree's cached layout. flex recomputes on the next pass,
// and C_LAYOUT is what asks for that pass to happen — without it the
// invalidation sat in the tree until some unrelated write woke the backend.
fn relayout(n: *Node) {
    if n.is_null() { return; }
    { (*n).mark_content_changed() };
    touch(n, props::C_LAYOUT);
}

// Lay the subtree out under these constraints and report the size it wants.
// This IS a layout pass, so the frames it leaves behind are the measurement's:
// the next real pass overwrites them.
fn measure(n: *Node, width: f64, height: f64) -> vocab::Size {
    if n.is_null() { return vocab::Size::zero(); }
    { (*n).calculate_layout(width: width, height: height) };
    let f: Frame = { (*n).frame() };
    return vocab::Size { width: f.width, height: f.height };
}

// Coalesce writes. The backend syncs when the depth returns to zero.
fn begin_updates(n: *Node) {
    let d: *Data = ensure_data(n);
    if d.is_null() { return; }
    { (*d).batch = { (*d).batch } +% (1 as i64) };
}

fn end_updates(n: *Node) {
    let d: *Data = ensure_data(n);
    if d.is_null() { return; }
    let depth: i64 = { (*d).batch };
    if depth <= (0 as i64) { { (*d).batch = 0 as i64 }; return; }
    { (*d).batch = depth -% (1 as i64) };
    if { (*d).batch } == (0 as i64) { touch(n, props::C_FLUSH); }
}

fn is_batching(n: *Node) -> bool {
    let d: *Data = node_data(n);
    if d.is_null() { return false; }
    return { (*d).batch } > (0 as i64);
}

// ---- the band, as methods on a bare node -------------------------------------
// The free fns above take `*Node` because that is the cursor every seam
// passes. A node you just BUILT is a value, though, and `set_background_color(
// #addr_of(n), bg)` is the wrong shape for the commonest thing an app does.
// These forward one-for-one, so a value reads the same as a cursor:
//
//   var n: Node = column(b, key: "body");
//   n.set_background_color(bg);
//
// Setters take `ref this` — a `var` node, the same binding a builder returns.
// Ten band names are absent because flex::Node already declares them
// (set_width/height/padding/margin/gap, set_z_index, width, height, z_index,
// child_count): those are flex's own words and calling them on a node reaches
// flex directly. That is sound while BUILDING; after mount, write geometry
// through a cursor or follow it with `relayout()`, because flex's setters do
// not raise C_LAYOUT and the change would never reach the screen.
//
// gen_contract.py::check() fails the run if this block and SHARED_FORWARDS
// disagree, so the two cannot drift.
impl flex::Node {
    fn set_opacity(ref this, v: f64) { set_opacity(#addr_of(this), v); return; }
    fn opacity(this) -> f64 { return opacity(#addr_of(this)); }
    fn set_background_color(ref this, v: vocab::Color) { set_background_color(#addr_of(this), v); return; }
    fn background_color(this) -> vocab::Color { return background_color(#addr_of(this)); }
    fn set_corner_radius(ref this, v: vocab::Corners) { set_corner_radius(#addr_of(this), v); return; }
    fn corner_radius(this) -> vocab::Corners { return corner_radius(#addr_of(this)); }
    // Chainable, like the layout verbs: `ui::column(b).rounded(8.0)`.
    fn rounded(take this, v: f64) -> flex::Node {
        var n: flex::Node = this;
        set_corner_radius(#addr_of(n), vocab::Corners::all(v));
        return n;
    }
    fn set_background(ref this, v: vocab::Brush) { set_background(#addr_of(this), v); return; }
    fn background(this) -> vocab::Brush { return background(#addr_of(this)); }
    fn set_background_image(ref this, v: str) { set_background_image(#addr_of(this), v); return; }
    fn background_image(this) -> str { return background_image(#addr_of(this)); }
    fn set_safe_area(ref this, v: vocab::SafeArea) { set_safe_area(#addr_of(this), v); return; }
    fn safe_area(this) -> vocab::SafeArea { return safe_area(#addr_of(this)); }
    fn set_shadow(ref this, v: vocab::Shadow) { set_shadow(#addr_of(this), v); return; }
    fn shadow(this) -> vocab::Shadow { return shadow(#addr_of(this)); }
    fn set_clip(ref this, v: vocab::Shape) { set_clip(#addr_of(this), v); return; }
    fn clip(this) -> vocab::Shape { return clip(#addr_of(this)); }
    fn set_enabled(ref this, v: bool) { set_enabled(#addr_of(this), v); return; }
    fn is_enabled(this) -> bool { return is_enabled(#addr_of(this)); }
    fn set_visible(ref this, v: bool) { set_visible(#addr_of(this), v); return; }
    fn set_shown(ref this, v: bool) { set_shown(#addr_of(this), v); return; }
    // The band pair. `flex::Node` has fluent `hide`/`show` of its own for
    // the build-time chain; these are the mutating spelling, and they raise
    // the layout bit the fluent ones cannot (a node being built is not yet
    // mounted, so there is nothing to touch).
    fn hide_in(ref this, band: str) { hide_in(#addr_of(this), band); return; }
    fn show_in(ref this, band: str) { show_in(#addr_of(this), band); return; }
    fn set_padding_edge(ref this, edge: flex::Edge, v: f64) { set_padding_edge(#addr_of(this), edge, v); return; }
    fn set_margin_edge(ref this, edge: flex::Edge, v: f64) { set_margin_edge(#addr_of(this), edge, v); return; }
    fn is_hidden(this) -> bool { return is_hidden(#addr_of(this)); }
    fn is_visible(this) -> bool { return is_visible(#addr_of(this)); }
    fn set_input_transparent(ref this, v: bool) { set_input_transparent(#addr_of(this), v); return; }
    fn input_transparent(this) -> bool { return input_transparent(#addr_of(this)); }
    fn set_flow_direction(ref this, v: vocab::FlowDirection) { set_flow_direction(#addr_of(this), v); return; }
    fn flow_direction(this) -> vocab::FlowDirection { return flow_direction(#addr_of(this)); }
    fn set_rotation(ref this, v: f64) { set_rotation(#addr_of(this), v); return; }
    fn rotation(this) -> f64 { return rotation(#addr_of(this)); }
    fn set_rotation_x(ref this, v: f64) { set_rotation_x(#addr_of(this), v); return; }
    fn rotation_x(this) -> f64 { return rotation_x(#addr_of(this)); }
    fn set_rotation_y(ref this, v: f64) { set_rotation_y(#addr_of(this), v); return; }
    fn rotation_y(this) -> f64 { return rotation_y(#addr_of(this)); }
    fn set_scale(ref this, v: f64) { set_scale(#addr_of(this), v); return; }
    fn scale(this) -> f64 { return scale(#addr_of(this)); }
    fn set_scale_x(ref this, v: f64) { set_scale_x(#addr_of(this), v); return; }
    fn scale_x(this) -> f64 { return scale_x(#addr_of(this)); }
    fn set_scale_y(ref this, v: f64) { set_scale_y(#addr_of(this), v); return; }
    fn scale_y(this) -> f64 { return scale_y(#addr_of(this)); }
    fn set_translation_x(ref this, v: f64) { set_translation_x(#addr_of(this), v); return; }
    fn translation_x(this) -> f64 { return translation_x(#addr_of(this)); }
    fn set_translation_y(ref this, v: f64) { set_translation_y(#addr_of(this), v); return; }
    fn translation_y(this) -> f64 { return translation_y(#addr_of(this)); }
    fn set_anchor_x(ref this, v: f64) { set_anchor_x(#addr_of(this), v); return; }
    fn anchor_x(this) -> f64 { return anchor_x(#addr_of(this)); }
    fn set_anchor_y(ref this, v: f64) { set_anchor_y(#addr_of(this), v); return; }
    fn anchor_y(this) -> f64 { return anchor_y(#addr_of(this)); }
    fn x(this) -> f64 { return x_of(#addr_of(this)); }
    fn y(this) -> f64 { return y_of(#addr_of(this)); }
    fn bounds(this) -> vocab::Rect { return bounds_of(#addr_of(this)); }
    fn is_focused(this) -> bool { return is_focused(#addr_of(this)); }
    fn is_attached(this) -> bool { return is_attached(#addr_of(this)); }
    fn window(this) -> vocab::WindowRef { return window_of(#addr_of(this)); }
    fn native(this) -> *u8 { return native(#addr_of(this)); }
    fn child(this, at: usize) -> option::Option[*Node] { return child_of(#addr_of(this), at); }
    fn set_grow(ref this, v: f64) { set_grow(#addr_of(this), v); return; }
    fn set_shrink(ref this, v: f64) { set_shrink(#addr_of(this), v); return; }
    fn set_basis(ref this, v: f64) { set_basis(#addr_of(this), v); return; }
    fn set_accessibility_label(ref this, v: str) { set_accessibility_label(#addr_of(this), v); return; }
    fn accessibility_label(this) -> str { return accessibility_label(#addr_of(this)); }
    fn set_accessibility_hint(ref this, v: str) { set_accessibility_hint(#addr_of(this), v); return; }
    fn accessibility_hint(this) -> str { return accessibility_hint(#addr_of(this)); }
    fn set_agent(ref this, v: vocab::Agent) { set_agent(#addr_of(this), v); return; }
    fn agent(this) -> vocab::Agent { return agent(#addr_of(this)); }
    fn set_heading_level(ref this, v: i64) { set_heading_level(#addr_of(this), v); return; }
    fn heading_level(this) -> i64 { return heading_level(#addr_of(this)); }
    fn set_tooltip(ref this, v: str) { set_tooltip(#addr_of(this), v); return; }
    fn tooltip(this) -> str { return tooltip(#addr_of(this)); }
    fn set_min_width_percent(ref this, v: f64) { set_min_width_percent(#addr_of(this), v); return; }
    fn set_min_height_percent(ref this, v: f64) { set_min_height_percent(#addr_of(this), v); return; }
    fn set_max_width_percent(ref this, v: f64) { set_max_width_percent(#addr_of(this), v); return; }
    fn set_max_height_percent(ref this, v: f64) { set_max_height_percent(#addr_of(this), v); return; }
    fn set_left_percent(ref this, v: f64) { set_left_percent(#addr_of(this), v); return; }
    fn set_top_percent(ref this, v: f64) { set_top_percent(#addr_of(this), v); return; }
    fn set_right_percent(ref this, v: f64) { set_right_percent(#addr_of(this), v); return; }
    fn set_bottom_percent(ref this, v: f64) { set_bottom_percent(#addr_of(this), v); return; }
    fn set_absolute(ref this, on: bool) { set_absolute(#addr_of(this), on); return; }
    fn is_absolute(this) -> bool { return is_absolute(#addr_of(this)); }
    fn set_left(ref this, v: f64) { set_left(#addr_of(this), v); return; }
    fn set_top(ref this, v: f64) { set_top(#addr_of(this), v); return; }
    fn set_right(ref this, v: f64) { set_right(#addr_of(this), v); return; }
    fn set_bottom(ref this, v: f64) { set_bottom(#addr_of(this), v); return; }
    fn set_width_percent(ref this, v: f64) { set_width_percent(#addr_of(this), v); return; }
    fn set_height_percent(ref this, v: f64) { set_height_percent(#addr_of(this), v); return; }
    fn set_justify(ref this, v: flex::Justify) { set_justify(#addr_of(this), v); return; }
    fn set_align(ref this, v: flex::Align) { set_align(#addr_of(this), v); return; }
    fn set_wrap(ref this, v: flex::Wrap) { set_wrap(#addr_of(this), v); return; }
    fn focus(ref this) { focus(#addr_of(this)); return; }
    fn blur(ref this) { blur(#addr_of(this)); return; }
    fn animate_opacity(ref this, to: f64,
                       duration: vocab::Duration = vocab::Duration::animation(),
                       easing: vocab::Easing = vocab::Easing::SinInOut) {
        animate_opacity(#addr_of(this), to, duration, easing);
        return;
    }
    fn animate_scale(ref this, to: f64,
                     duration: vocab::Duration = vocab::Duration::animation(),
                     easing: vocab::Easing = vocab::Easing::SinInOut) {
        animate_scale(#addr_of(this), to, duration, easing);
        return;
    }
    fn animate_scale_x(ref this, to: f64,
                       duration: vocab::Duration = vocab::Duration::animation(),
                       easing: vocab::Easing = vocab::Easing::SinInOut) {
        animate_scale_x(#addr_of(this), to, duration, easing);
        return;
    }
    fn animate_scale_y(ref this, to: f64,
                       duration: vocab::Duration = vocab::Duration::animation(),
                       easing: vocab::Easing = vocab::Easing::SinInOut) {
        animate_scale_y(#addr_of(this), to, duration, easing);
        return;
    }
    fn animate_rotation(ref this, to: f64,
                        duration: vocab::Duration = vocab::Duration::animation(),
                        easing: vocab::Easing = vocab::Easing::SinInOut) {
        animate_rotation(#addr_of(this), to, duration, easing);
        return;
    }
    fn animate_rotation_x(ref this, to: f64,
                          duration: vocab::Duration = vocab::Duration::animation(),
                          easing: vocab::Easing = vocab::Easing::SinInOut) {
        animate_rotation_x(#addr_of(this), to, duration, easing);
        return;
    }
    fn animate_rotation_y(ref this, to: f64,
                          duration: vocab::Duration = vocab::Duration::animation(),
                          easing: vocab::Easing = vocab::Easing::SinInOut) {
        animate_rotation_y(#addr_of(this), to, duration, easing);
        return;
    }
    fn animate_translation(ref this, x: f64, y: f64,
                           duration: vocab::Duration = vocab::Duration::animation(),
                           easing: vocab::Easing = vocab::Easing::SinInOut) {
        animate_translation(#addr_of(this), x, y, duration, easing);
        return;
    }
    fn cancel_animations(ref this) { cancel_animations(#addr_of(this)); return; }
    fn relayout(ref this) { relayout(#addr_of(this)); return; }
    fn measure(this, width: f64, height: f64) -> vocab::Size { return measure(#addr_of(this), width, height); }
    fn begin_updates(ref this) { begin_updates(#addr_of(this)); return; }
    fn end_updates(ref this) { end_updates(#addr_of(this)); return; }
    fn on_focus(ref this, f: fn(*u8, *u8), ctx: *u8 = 0 as *u8) { set_on_focus(#addr_of(this), f, ctx); return; }
    fn on_blur(ref this, f: fn(*u8, *u8), ctx: *u8 = 0 as *u8) { set_on_blur(#addr_of(this), f, ctx); return; }
    fn on_attach(ref this, f: fn(*u8, *u8), ctx: *u8 = 0 as *u8) { set_on_attach(#addr_of(this), f, ctx); return; }
    fn on_detach(ref this, f: fn(*u8, *u8), ctx: *u8 = 0 as *u8) { set_on_detach(#addr_of(this), f, ctx); return; }
}

// ---- slots ------------------------------------------------------------------
// A subtree is a CHILD, not a property. The ledger models a named subtree as a
// bindable property because binding is how it fills one; facet describes a
// tree, so a header IS a child — under a reserved `@` key, so the slot can be
// replaced in place without disturbing its siblings.

// A slot is recorded on the CHILD, in its own field, not by overwriting the
// key: the application named that node and must keep being able to find it.
fn slot_of(n: *Node) -> str {
    let d: *Data = node_data(n);
    if d.is_null() { return ""; }
    return { (*d).slot.view() };
}

fn _mark_slot(n: *Node, name: str) {
    let d: *Data = node_data(n);
    if d.is_null() { return; }
    { (*d).slot = text::from_str(name) };
}

// Index of the child in `name`'s slot, or child_count() when the slot is empty.
fn _slot_index(n: *Node, name: str) -> usize {
    let count: usize = { (*n).child_count() };
    var i: usize = 0 as usize;
    while i < count {
        match { (*n).child_ptr(i) } {
            option::Option[*Node]::Some(c) => {
                if slot_of(c) == name { return i; }
            }
            option::Option[*Node]::None => { }
        }
        i = i +% (1 as usize);
    }
    return count;
}

fn set_slot(n: *Node, name: str, take child: Node) {
    if n.is_null() { return; }
    let count: usize = { (*n).child_count() };
    let at: usize = _slot_index(n, name);
    // An allocation can fail. Only mark the slot when the child really landed
    // at `at` — otherwise the node already there would answer to a name that
    // is not its own.
    var placed: bool = false;
    if at < count {
        let _old: option::Option[Node] = { (*n).remove_child(at) };
        placed = { (*n).insert_child(child, at: at) }.is_ok();
    } else {
        placed = { (*n).add_child(child) }.is_ok();
    }
    if !placed { return; }
    match { (*n).child_ptr(at) } {
        option::Option[*Node]::Some(c) => { _mark_slot(c, name); }
        option::Option[*Node]::None => { }
    }
}

fn slot(n: *Node, name: str) -> option::Option[*Node] {
    if n.is_null() { return option::Option[*Node]::None; }
    let at: usize = _slot_index(n, name);
    if at >= { (*n).child_count() } { return option::Option[*Node]::None; }
    return { (*n).child_ptr(at) };
}

// Detach the child in a slot and hand the subtree back.
fn take_slot(n: *Node, name: str) -> option::Option[Node] {
    if n.is_null() { return option::Option[Node]::None; }
    let at: usize = _slot_index(n, name);
    if at >= { (*n).child_count() } { return option::Option[Node]::None; }
    return { (*n).remove_child(at) };
}

// Does this name belong to facet rather than to the application?
fn is_slot_name(name: str) -> bool { return name.has_prefix(SLOT_PREFIX); }

// A free-fn twin of Node::data, callable where a method on *Node is not.
fn node_data(n: *Node) -> *Data {
    if n.is_null() { return 0 as *Data; }
    return { (*n).data() };
}

// Depth-first search for a key. Returns a cursor: flex node addresses are
// stable, so this stays valid until its node or an ancestor is removed.
fn find_in(n: *Node, key: str) -> option::Option[*Node] {
    if n.is_null() { return option::Option[*Node]::None; }
    if { (*n).key() } == key { return option::Option[*Node]::Some(n); }
    let count: usize = { (*n).child_count() };
    var i: usize = 0 as usize;
    while i < count {
        match { (*n).child_ptr(i) } {
            option::Option[*Node]::Some(c) => {
                match find_in(c, key) {
                    option::Option[*Node]::Some(hit) => { return option::Option[*Node]::Some(hit); }
                    option::Option[*Node]::None => { }
                }
            }
            option::Option[*Node]::None => { }
        }
        i = i +% (1 as usize);
    }
    return option::Option[*Node]::None;
}

// ---- containers -------------------------------------------------------------
// flex already owns these: Builder, column, row, hstack, vstack, screen, card,
// box, and the HIG spacing constants. facet does not reimplement them, it
// re-exports them so an application imports facet alone.

type Builder = flex::Builder;

// flex builds the node; facet attaches its Data. Both halves are required: a
// container that carries no Data answers no shared-band verb and takes no
// gesture, and does so in silence.
fn _own(take n: Node, key: str) -> Node {
    var m: Node = n;
    let d: *Data = ensure_data(#addr_of(m));
    if d.is_not_null() { { (*d).key = text::from_str(key) }; }
    return m;
}

fn column(take b: Builder, key: str = "") -> Node { return _own(flex::column(b), key); }
fn row(take b: Builder, key: str = "") -> Node { return _own(flex::row(b), key); }
fn hstack(take b: Builder, key: str = "") -> Node { return _own(flex::hstack(b), key); }
fn vstack(take b: Builder, key: str = "") -> Node { return _own(flex::vstack(b), key); }
fn screen(take b: Builder, key: str = "") -> Node { return _own(flex::screen(b), key); }
fn card(take b: Builder, key: str = "") -> Node { return _own(flex::card(b), key); }

fn spacer(key: str = "") -> Node { return _own(flex::spacer(), key); }
fn zstack(take b: Builder, key: str = "") -> Node { return _own(flex::zstack(b), key); }

#[test]
fn touch_all_re_reads_every_fact_and_issues_no_verb() {
    // `touch_all` means "re-read this node whole", and the sync walk raises it
    // on a backed host whenever a VIEWLESS child (a span, a menu_item) changed.
    // Commands must not ride along: C_FOCUS and C_BLUR are performed in that
    // order by the backend, so a blanket touch focused the host and immediately
    // handed first responder back to the window — the caret vanished from
    // whatever the user was typing into, one keystroke after a span updated.
    var n: Node = node_with("", props::K_LABEL, 0 as *u8, no_release);
    let p: *Node = #addr_of(n);
    clear_dirty(p);
    touch_all(p);
    let d: u64 = dirty_of(p);

    // No verb.
    assert (d & props::C_FOCUS) == (0 as u64);
    assert (d & props::C_BLUR) == (0 as u64);
    assert (d & props::C_FLUSH) == (0 as u64);
    assert (d & props::C_ANIMATE) == (0 as u64);
    assert (d & props::C_CANCEL_ANIMATIONS) == (0 as u64);
    assert (d & props::C_COMMANDS) == (0 as u64);

    // Every fact — the point of the verb is still to re-read everything else.
    assert (d & props::C_BACKGROUND_COLOR) != (0 as u64);
    assert (d & props::C_IS_VISIBLE) != (0 as u64);
    assert (d & props::C_LAYOUT) != (0 as u64);
    assert (d & props::C_SEMANTICS) != (0 as u64);
    assert (d & props::C_TOOLTIP) != (0 as u64);
    assert (d & props::C_HANDLERS) != (0 as u64);
    // ...including the per-control bits, which start at 0.
    assert (d & (1 as u64)) != (0 as u64);

    // The two masks partition the word: no bit is both, none is neither.
    assert (props::C_COMMANDS & props::C_ALL_STATE) == (0 as u64);
    assert (props::C_COMMANDS | props::C_ALL_STATE) == 18446744073709551615u64;
}
