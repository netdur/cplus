        if f != (0 as fn(Handle, f64) -> bool) { let _ok: bool = f(this, v); }
        return this;
    }
    fn set_z_index(this, v: i64) -> Handle {
        let f: fn(Handle, i64) -> bool = SET_Z_INDEX_FN;
        if f != (0 as fn(Handle, i64) -> bool) { let _ok: bool = f(this, v); }
        return this;
    }
// GEN:METHODS:END

    // Paint `spans` over this element's text (byte offsets, ordered,
    // non-overlapping — see TextSpan). The runs survive a theme flip, a
    // restyle, and a re-mount: the backend stores them and repaints them after
    // any whole-element colour sweep, which would otherwise erase them.
    //
    // Re-apply after every edit. A span list is measured against the text it
    // was lexed from, so a backend that finds the text changed underneath drops
    // the stale list rather than colour the wrong glyphs.
    fn set_text_spans(this, spans: *vec::Vec[TextSpan]) -> Handle {
        let f: fn(Handle, *vec::Vec[TextSpan]) -> bool = SET_TEXT_SPANS_FN;
        if f != (0 as fn(Handle, *vec::Vec[TextSpan]) -> bool) { let _ok: bool = f(this, spans); }
        return this;
    }

    // Move a split's divider to `position` points from its leading edge.
    // `divider` is 0 for the usual two-pane split; the parameter exists so a
    // three-pane split needs no new method. Reads back through `value()`.
    fn set_split_position(this, position: f64, divider: i64 = 0 as i64) -> Handle {
        let f: fn(Handle, f64, i64) -> bool = SET_SPLIT_POSITION_FN;
        if f != (0 as fn(Handle, f64, i64) -> bool) { let _ok: bool = f(this, position, divider); }
        return this;
    }

    // Move a split's divider to `fraction` (0.0-1.0) of the split's own length —
    // its width when the panes sit side by side, its height when stacked. Unlike
    // an absolute position this needs no knowledge of the window size, so it is
    // the form to prefer for "the drawer takes a third".
    fn set_split_fraction(this, fraction: f64, divider: i64 = 0 as i64) -> Handle {
        let f: fn(Handle, f64, i64) -> bool = SET_SPLIT_FRACTION_FN;
        if f != (0 as fn(Handle, f64, i64) -> bool) { let _ok: bool = f(this, fraction, divider); }
        return this;
    }

    // Drop every run, returning the element to its single style colour.
    fn clear_text_spans(this) -> Handle {
        let f: fn(Handle) -> bool = CLEAR_TEXT_SPANS_FN;
        if f != (0 as fn(Handle) -> bool) { let _ok: bool = f(this); }
        return this;
    }

    // The not-found handle: every mutator on it is a no-op.
    fn missing() -> Handle { return Handle::of(0 as *u8, 0 as *u8, 0 as *u8, 0 as u32); }

    // Did the key resolve to a live element?
    fn found(this) -> bool { return this._view != (0 as *u8); }

    // Backend accessors (the mutator hook reads the handle through these).
    // `view()` is ALSO the native escape hatch: when the four portable mutators
    // (set_text/value/on/hidden) aren't enough, wrap the raw view in its backend
    // type for the full native API —
    //   AppKit:  let b: ak::Button = ak::Button::from_raw(find(cp, key).view());
    // (A generic `find_as[T]` returning the typed widget isn't expressible: the
    // core can't name a backend type, and there is no generic method dispatch to
    // call `T::from_raw`. Guard with `found()` first; on a miss `view()` is 0.)
    fn view(this) -> *u8 { return this._view; }
    fn flex(this) -> *u8 { return this._flex; }
    fn cp(this) -> *u8 { return this._cp; }
    fn kind(this) -> u32 { return this._kind; }

    // Set the element's text — label / button title / field value — IN PLACE.
    // Chainable; a no-op on a missing handle. No re-render.
    fn set_text(this, s: str) -> Handle {
        let f: fn(Handle, str) -> bool = SET_TEXT_FN;
        if f != (0 as fn(Handle, str) -> bool) { let _ok: bool = f(this, s); }
        return this;
    }

    // Set a value control's number — slider / stepper / progress. In place.
    fn set_value(this, v: f64) -> Handle {
        let f: fn(Handle, f64) -> bool = SET_VALUE_FN;
        if f != (0 as fn(Handle, f64) -> bool) { let _ok: bool = f(this, v); }
        return this;
    }

    // Read the element's natural value: a `split`'s divider position (the leading
    // pane's trailing edge, in points), or a value control's number (slider /
    // stepper / progress / gauge). 0 on a miss or a kind with no value. The
    // portable read-back counterpart to `set_value` — no backend reach-through.
    fn value(this) -> f64 {
        let f: fn(Handle) -> f64 = GET_VALUE_FN;
        if f == (0 as fn(Handle) -> f64) { return 0.0f64; }
        return f(this);
    }

    // Read the element's text: a `text_field`'s value, a `text_area`'s content,
    // a label's string, or a button's title. Empty on a miss or a kind with no
    // text. The portable read-back counterpart to `set_text` — no backend
    // reach-through, so an app never touches `ak`/`ui` to read an input.
    fn text(this) -> text::Text {
        let f: fn(Handle) -> text::Text = GET_TEXT_FN;
        if f == (0 as fn(Handle) -> text::Text) { return text::from_str(""); }
        return f(this);
    }

    // Read a `popup`'s chosen row (0-based), or -1 on a miss or a kind with no
    // selection. The portable read-back for a dropdown selection.
    fn selected_index(this) -> i64 {
        let f: fn(Handle) -> i64 = GET_INDEX_FN;
        if f == (0 as fn(Handle) -> i64) { return -1 as i64; }
        return f(this);
    }

    // Set a toggle / checkbox / switch on or off. In place.
    fn set_on(this, on: bool) -> Handle {
        let f: fn(Handle, bool) -> bool = SET_ON_FN;
        if f != (0 as fn(Handle, bool) -> bool) { let _ok: bool = f(this, on); }
        return this;
    }

    // Show or hide the element. In place.
    fn set_hidden(this, hidden: bool) -> Handle {
        let f: fn(Handle, bool) -> bool = SET_HIDDEN_FN;
        if f != (0 as fn(Handle, bool) -> bool) { let _ok: bool = f(this, hidden); }
        return this;
    }

    // Reveal / conceal the element — the readable pair over `set_hidden`. Chainable.
    fn show(this) -> Handle { return this.set_hidden(false); }
    fn hide(this) -> Handle { return this.set_hidden(true); }

    // Restyle a MOUNTED element IN PLACE — the live-time counterpart to the
    // build-time `.background(...)` / `.foreground_color(...)` / `.font(...)`
    // modifiers. Push a partial `Style` (unset fields skipped, exactly like the
    // mount-time apply) onto the located native view; no rebuild, no re-render.
    // Colors / corner / border are non-metric (no relayout); a FONT change is
    // metric, so the backend re-measures that leaf and reflows its owner — the
    // same as `set_text`. Chainable; a no-op on a missing handle. Backends honor
    // the color / border / corner_radius / font fields today; other `Style`
    // fields take effect as a backend gains live support for them.
    fn set_style(this, s: Style) -> Handle {
        let f: fn(Handle, Style) -> bool = SET_STYLE_FN;
        if f != (0 as fn(Handle, Style) -> bool) { let _ok: bool = f(this, s); }
        return this;
    }

    // Sugar over `set_style` for the common single-field restyles — the same
    // names as the build-time modifiers, `set_`-prefixed per the mutator
    // convention. Each recolors the live view in place. Chainable.
    fn set_background(this, c: Color) -> Handle {
        var s: Style = style_none();
        s.bg = c;
        return this.set_style(s);
    }
    fn set_foreground_color(this, c: Color) -> Handle {
        var s: Style = style_none();
        s.fg = c;
        return this.set_style(s);
    }
    fn set_corner_radius(this, r: f64) -> Handle {
        var s: Style = style_none();
        s.corner_radius = r;
        return this.set_style(s);
    }
    fn set_border(this, c: Color, width: f64) -> Handle {
        var s: Style = style_none();
        s.border_color = c;
        s.border_width = width;
        return this.set_style(s);
    }
    // Font restyles. `set_font` changes point size while keeping the current
    // weight / family; `set_weight` changes weight while keeping the current
    // size — each converts only the axis it names (see the backend). Metric:
    // the leaf re-measures and its owner reflows. Chainable.
    fn set_font(this, size: f64) -> Handle {
        var s: Style = style_none();
        s.font_size = size;
        return this.set_style(s);
    }
    fn set_weight(this, w: u32) -> Handle {
        var s: Style = style_none();
        s.weight = w;
        return this.set_style(s);
    }
    // The bold-weight shortcut — the live mirror of the build-time `.strong()`.
    fn set_strong(this) -> Handle { return this.set_weight(weight_bold()); }

    // Append a freshly-built child to this (multi-child) container, in place:
    // the child mounts, attaches under the container's view, and the layout
    // reflows. `this` must resolve a KEYED container. Chainable.
    fn add_child(this, take child: Node) -> Handle {
        let f: fn(Handle, take Node) -> bool = ADD_CHILD_FN;
        if f != (0 as fn(Handle, take Node) -> bool) {
            let _ok: bool = f(this, child);
        }
        // No backend installed: `child` was not moved out, so it drops here (RAII).
        return this;
    }

    // Remove the direct child addressed by `key` from this container, in place
    // (its views tear down, the layout reflows). Returns whether one was removed.
    fn remove_child(this, key: str) -> bool {
        let f: fn(Handle, str) -> bool = REMOVE_CHILD_FN;
        if f != (0 as fn(Handle, str) -> bool) { return f(this, key); }
        return false;
    }

    // Insert a freshly-built child at position `at` among this container's direct
    // children (`at` past the end appends). Like `add_child`, but ordered. The
    // layout reflows. `this` must resolve a KEYED container. Chainable.
    fn insert_child(this, take child: Node, at: usize) -> Handle {
        let f: fn(Handle, take Node, usize) -> bool = INSERT_CHILD_FN;
        if f != (0 as fn(Handle, take Node, usize) -> bool) {
            let _ok: bool = f(this, child, at);
        }
        // No backend installed: `child` was not moved out, so it drops here (RAII).
        return this;
    }

    // Replace the direct child addressed by `key` with a freshly-built one, in
    // place at the same position (old views tear down, new mount, layout reflows).
    // Returns whether a child was replaced.
    fn replace_child(this, key: str, take child: Node) -> bool {
        let f: fn(Handle, str, take Node) -> bool = REPLACE_CHILD_FN;
        if f != (0 as fn(Handle, str, take Node) -> bool) { return f(this, key, child); }
        // No backend / no match: `child` drops here (RAII).
        return false;
    }

    // Make this container hold exactly one child: clear its current children, then
    // mount `child`. The single-slot swap (a content area / router outlet showing
    // one thing at a time). `this` must resolve a KEYED container. Chainable.
    fn set_child(this, take child: Node) -> Handle {
        let f: fn(Handle, take Node) -> bool = SET_CHILD_FN;
        if f != (0 as fn(Handle, take Node) -> bool) {
            let _ok: bool = f(this, child);
        }
        // No backend installed: `child` was not moved out, so it drops here (RAII).
        return this;
    }

    // Attach a STAGED component into this (keyed) container, in place: its parked
    // views move into the tree, the layout reflows, and its `on_attach` fires. The
    // component is NOT rebuilt — its views + state survive from when it was staged.
    // `this` must resolve a KEYED container. Returns whether it attached.
    fn attach(this, s: Staged) -> bool {
        let f: fn(Handle, Staged) -> bool = ATTACH_FN;
        if f != (0 as fn(Handle, Staged) -> bool) { return f(this, s); }
        return false;
    }

    // ---- component-aware structural verb ------------------------------------
    // The typed mirror of `set_child`. The call site knows the component (this
    // is ordinary generic code — no erasure), so the verb can both notify it
    // (on_attach once its tree is live) and leave behind an ERASED detach for
    // whoever evicts it later: set_child fires the previous occupant's
    // on_detach through the backend registry, mounts `c`, registers `c`'s own
    // detach trampoline, then fires c.on_attach. Lifecycle is never the app's
    // concern — showing a component through any structural verb notifies the
    // one it replaces. Fires nothing on a missing handle.
    //
    // `c` must outlive its presentation (the registry holds its address).
    fn present[C: Component + Lifecycle](this, ref c: C) -> Handle {
        if !this.found() { return this; }
        // The presented tree FILLS the container: present is the single-slot
        // "show this screen here" verb, so the root stretches to the slot and
        // the component's own layout governs everything inside it. (Without
        // this, the `@facet` block wrapper — a plain column — content-sizes
        // and swallows the root's grow.)
        let n: Node = c.build();
        let h: Handle = this.set_child(n.grow(1.0f64).shrink(1.0f64));
        lc_register(this, lc_detach_tramp::[C], #addr_of(c) as *u8);
        c.on_attach();
        return h;
    }

    // Show sibling `c` in this (keyed) outlet, PARKING whatever it showed
    // before — the switching mirror of `present` for siblings the user returns
    // to (tabs, inspector panes). `c` is staged on its first visit and its
    // view tree survives every switch after that; `present` would rebuild it.
    // See the outlet section below for the full contract (lifecycle, eviction,
    // theme changes). Showing the already-attached sibling is a no-op.
    // Chainable; does nothing on a missing handle.
    fn switch_to[C: Component + Lifecycle](this, ref c: C) -> Handle {
        if !this.found() { return this; }
        let container: *u8 = this.view();
        if container == (0 as *u8) { return this; }
        let cp: *u8 = #addr_of(c) as *u8;
        let cur: *u8 = router_attached_cp(container);
        if cur == cp { return this; }
        // Park the current occupant (its on_detach fires as it leaves).
        if cur != (0 as *u8) { let _d: bool = router_staged_of(cur).detach(); }
        // Stage this sibling on its first visit.
        var s: Staged = router_staged_of(cp);
        if !s.valid() {
            s = stage(router_build_tramp::[C], ctx: cp,
                on_attach: router_attach_tramp::[C], on_attach_ctx: cp,
                on_detach: lc_detach_tramp::[C], on_detach_ctx: cp);
            if !s.valid() { return this; }   // no backend installed
            let reg: *vec::Vec[RouterStaged] = #addr_of(ROUTER_STAGED);
            (*reg).append(RouterStaged { _container: container, _cp: cp, _staged: s });
        }
        // Cross-outlet reuse is a TRANSFER, and ownership has to move with the
        // view. `router_staged_of` matches on the component alone, so showing
        // one instance through a second outlet reuses the first outlet's
        // staging and physically reparents its root — while the staged record,
        // and the old outlet's slot, both still claimed it. Evicting the old
        // outlet then detached and unstaged a tree the new one was displaying.
        // Hand the old outlet's bookkeeping over before attaching: clear its
        // "showing" record, then repoint the staged record at the new owner.
        // `attach` itself pays the on_detach for leaving the old container.
        let prev_owner: *u8 = router_staged_owner(cp);
        if prev_owner != (0 as *u8) {
            if prev_owner != container {
                router_clear_attached(prev_owner);
                router_restage_owner(cp, container);
            }
        }
        // Only claim the outlet if the attachment actually happened: on failure
        // the registries must not record a presentation that is not on screen.
        if !this.attach(s) { return this; }
        router_set_attached(container, cp);
        // Arm the outlet's eviction hook (idempotent: the registry keeps one
        // entry per container).
        lc_register(this, router_evict, container);
        return this;
    }

    // The COMPONENT INSTANCE this container is presenting — the address
    // `present` registered — or 0 when nothing presented is here. The
    // instance-level analog of the view this Handle already is: `find`
    // reaches a sibling's VIEW by key; this reaches the component behind a
    // presented slot, so a bare-fn callback (a native widget's, a service's)
    // can invoke a component METHOD without a module static. Valid while the
    // presentation lasts (every eviction path clears the registry entry):
    // resolve, call, don't store. Prefer the typed `component_at`.
    fn component(this) -> *u8 {
        if !this.found() { return 0 as *u8; }
        let f: fn(Handle) -> *u8 = COMPONENT_AT_FN;
        if f == (0 as fn(Handle) -> *u8) { return 0 as *u8; }
        return f(this);
    }
}

// The typed reader over `Handle.component`: the component instance presented
// in the container at `key`, or None. The turbofish names the type the app
// KNOWS it presented there (present is typed; the cast recovers what it
// erased):
//
//     match facet::component_at::[EditorTabs]("code:body") {
//         option::Option[*EditorTabs]::Some(et) => { { (*et).open(path) }; }
//         option::Option[*EditorTabs]::None => { }
//     }
fn component_at[C](key: str) -> option::Option[*C] {
    let p: *u8 = find(key).component();
    if p == (0 as *u8) { return option::Option[*C]::None; }
    return option::Option[*C]::Some(p as *C);
}

// The type-erasing detach trampoline: `lc_detach_tramp::[C]` (a value-turbofish
// fn-pointer) fires C's on_detach on the component at `p`. `present` registers
// one per shown component; the structural verbs fire it right before they
// remove or replace that component's tree — notify, don't wait.
fn lc_detach_tramp[C: Lifecycle](p: *u8) {
    let q: *C = p as *C;
    { (*q).on_detach() };
    return;
}

// Backend hook: remember (container → detach fn + component address) for the
// component a container is showing. Every structural removal path fires and
// clears the entry (see facet_appkit); the component must outlive its
// presentation. Not app-facing — `present` is the only writer.
static LC_REGISTER_FN: fn(Handle, fn(*u8), *u8) = #zero::[fn(Handle, fn(*u8), *u8)]();
fn set_lc_register_fn(f: fn(Handle, fn(*u8), *u8)) { LC_REGISTER_FN = f; return; }

// Backend hook: read the component address `present` registered for a
// container (the reader half of the registry above). 0 when the container
// shows nothing presented. Installed with the others.
static COMPONENT_AT_FN: fn(Handle) -> *u8 = #zero::[fn(Handle) -> *u8]();
fn set_component_at_fn(f: fn(Handle) -> *u8) { COMPONENT_AT_FN = f; return; }
fn lc_register(h: Handle, detach: fn(*u8), ctx: *u8) {
    let f: fn(Handle, fn(*u8), *u8) = LC_REGISTER_FN;
    if f != (0 as fn(Handle, fn(*u8), *u8)) { f(h, detach, ctx); }
    return;
}

// Main-thread dispatcher: run `work(ctx)` on the UI thread, where touching
// views (or state the UI reads) is safe. Non-blocking — the caller returns
// immediately and the main run loop picks the work up on its next turn. The
// workhorse of the service pattern: a background read finishes, boxes its
// result as the ctx, and hops here to deliver it. The backend installs the
// primitive; until then run_on_main silently DROPS the work (the portable
// no-backend default, like `find`) — so a ctx that carries ownership must be
// reclaimed by `work` itself, never by the scheduling side.
static RUN_ON_MAIN_FN: fn(fn(*u8), *u8) = #zero::[fn(fn(*u8), *u8)]();
fn set_run_on_main_fn(f: fn(fn(*u8), *u8)) { RUN_ON_MAIN_FN = f; return; }
fn run_on_main(work: fn(*u8), ctx: *u8) {
    let f: fn(fn(*u8), *u8) = RUN_ON_MAIN_FN;
    if f != (0 as fn(fn(*u8), *u8)) { f(work, ctx); }
    return;
}

// ---- async tasks on the UI thread -------------------------------------------
// `spawn_ui` hands an async task to the UI: calling the async fn already ran
// its body to the first suspension (eagerly, on the caller's thread); the rest
// resumes on the main thread as its awaits complete. Timers and async I/O wake
// the task through the backend's reactor watch (see facet_appkit); awaiting
// another async fn resumes through the executor's pending queue. After any
// await the tree may have changed — the usual discipline applies (namespaced
// keys miss harmlessly; `attached(this)` / `found()` to know).
//
//     fn on_click(ref this, sender: *u8) { spawn_ui(this.refresh()); }
//     async fn refresh(ref this) {
//         await time::sleep(milliseconds: 150 as u64);
//         if !attached(this) { return; }
//         find("list").add_child(...);
//     }
//
// A spawned task runs to completion or not at all past a suspension the
// backend cannot wake (no backend installed = the portable no-op posture).
// There is no cancellation; a task in flight at teardown finds its keys gone.

extern fn stdlib_reactor_drain_pending_v1() -> i32;
extern fn stdlib_reactor_poll_one_event_nb_v1() -> i32;

fn spawn_ui[T: Send](take f: future::Future[T]) {
    executor::spawn_local::[T](f);
    run_on_main(pump_async, 0 as *u8);
}

// Drive every parked async task as far as it can go WITHOUT blocking: resume
// the pending queue, consume every already-fired reactor event, repeat until
// neither makes progress. The backend calls this whenever the reactor's
// kqueue reads ready (fd/timer fired) and after spawn_ui. Signature is
// fn(*u8) so it rides run_on_main and the dispatch source directly.
fn pump_async(ctx: *u8) {
    loop {
        let drained: i32 = { stdlib_reactor_drain_pending_v1() };
        var fired: i32 = 0;
        while { stdlib_reactor_poll_one_event_nb_v1() } == 1 {
            fired = fired + 1;
        }
        if drained == 0 {
            if fired == 0 { break; }
        }
    }
    return;
}

// ---- awaitable worker (blocking work off the UI thread) ---------------------
// The reactor wakes on fds and timers, not on computation — a CPU-blocking
// read gains nothing from `await` alone. `on_worker` bridges: it runs
// `f(input)` on a worker thread and suspends the CALLING task until the
// result is back, via a pipe the reactor can wait on (the worker writes the
// boxed result's address; the awaiting side reads it and reclaims). So an
// async task can hold a straight line through blocking work:
//
//     async fn refresh(ref this) {
//         let rows: vec::Vec[text::Text] = await on_worker(job, read_rows);
//         if !attached(this) { return; }
//         // fill by key
//     }
//
// `input` moves to the worker (I: Send); the result moves back (O: Send).
extern fn pipe(fds: *i32) -> i32;
extern fn close(fd: i32) -> i32;
extern fn write(fd: i32, buf: *u8, count: usize) -> isize;

// The handoff crossing to the worker thread is a CONCRETE struct: the typed
// input and fn ride as boxed raw pointers, reclaimed by the run_worker[I, O]
// trampoline (value-turbofish) on the far side.
struct WorkerHandoff {
    input_raw: usize,
    f_raw: usize,
    write_fd: i32,
}

fn run_worker[I: Send, O: Send](take h: WorkerHandoff) -> i32 {
    let input: I = box::from_raw::[I]((h.input_raw) as *u8).unwrap();
    let f: fn(take I) -> O = box::from_raw::[fn(take I) -> O]((h.f_raw) as *u8).unwrap();
    let out: O = f(input);
    match box::new::[O](out) {
        option::Option[box::Box[O]]::Some(b) => {
            var slot: *u8 = b.into_raw();
            let _w: isize = { write(h.write_fd, #addr_of(slot) as *u8, 8 as usize) };
        }
        option::Option[box::Box[O]]::None => { }
    }
    let _c: i32 = { close(h.write_fd) };
    return 0;
}

// The sync half: open the pipe, move the work to a thread, return the read
// end. Separate from the async fn so the coroutine body holds only concrete
// types.
fn worker_start[I: Send, O: Send](take input: I, f: fn(take I) -> O) -> i32 {
    var fds: [i32; 2] = [0, 0];
    let _p: i32 = { pipe(#addr_of(fds) as *i32) };
    let input_raw: usize = match box::new::[I](input) {
        option::Option[box::Box[I]]::Some(b) => { b.into_raw() } as usize,
        option::Option[box::Box[I]]::None => 0 as usize,
    };
    let f_raw: usize = match box::new::[fn(take I) -> O](f) {
        option::Option[box::Box[fn(take I) -> O]]::Some(b) => { b.into_raw() } as usize,
        option::Option[box::Box[fn(take I) -> O]]::None => 0 as usize,
    };
    let h: WorkerHandoff = WorkerHandoff { input_raw: input_raw, f_raw: f_raw, write_fd: fds[1] };
    let tramp: fn(take WorkerHandoff) -> i32 = run_worker::[I, O];
    let _bg: thread::JoinHandle[i32] = thread::spawn_with::[WorkerHandoff, i32](h, tramp);
    return fds[0];
}

async fn on_worker[I: Send, O: Send](take input: I, f: fn(take I) -> O) -> O {
    let rfd: i32 = worker_start::[I, O](input, f);
    var slot: *u8 = 0 as *u8;
    let _n: isize = await net::read_fd_async(rfd, #addr_of(slot) as *u8, 8 as usize);
    let _c: i32 = { close(rfd) };
    return box::from_raw::[O](slot).unwrap();
}

// ---- services ---------------------------------------------------------------
// A data owner whose slow read must never block the UI. The interface IS the
// threading contract:
//   produce — the slow read (db / fs / net). load_service runs it on a worker
//             thread; it must not touch anything the UI reads.
//   apply   — install what produce prepared. load_service runs it on the main
//             thread, so the UI never observes a half-written service.
// A service conforms once and gets the whole async pipeline from load_service;
// no per-service job structs, boxing, or thread code.
interface Service {
    fn produce(ref this);
    fn apply(ref this);
}

// Run `svc`'s produce OFF the main thread, then its apply and `on_ready(ctx)`
// back ON it. Returns immediately. `svc` must outlive the flight (it is
// reached through its address). Needs a backend for the main-thread hop
// (run_on_main): without one the produced result is never applied.
fn load_service[S: Service](ref svc: S, on_ready: fn(*u8) = service_ready_noop, ctx: *u8 = 0 as *u8) {
    let job: ServiceJob = ServiceJob {
        svc_addr: { #addr_of(svc) as *u8 } as usize,
        produce: service_produce_tramp::[S],
        apply: service_apply_tramp::[S],
        on_ready: on_ready,
        ctx_addr: ctx as usize,
    };
    let _bg: thread::JoinHandle[i32] = thread::spawn_with::[ServiceJob, i32](job, run_service_job);
    return;
}

fn service_ready_noop(ctx: *u8) { return; }

// Type-erasing trampolines (value-turbofish): plain fn(*u8)s that call S's
// interface methods on the service at `p`.
fn service_produce_tramp[S: Service](p: *u8) {
    let q: *S = p as *S;
    { (*q).produce() };
    return;
}

fn service_apply_tramp[S: Service](p: *u8) {
    let q: *S = p as *S;
    { (*q).apply() };
    return;
}

// Raw pointers are !Send, so the service and ctx addresses ride as integers —
// sound under load_service's outlive-the-flight contract.
struct ServiceJob {
    svc_addr: usize,
    produce: fn(*u8),
    apply: fn(*u8),
    on_ready: fn(*u8),
    ctx_addr: usize,
}

fn run_service_job(take job: ServiceJob) -> i32 {
    let produce: fn(*u8) = job.produce;
    produce(job.svc_addr as *u8);   // the slow read, OFF the main thread
    match box::new::[ServiceJob](job) {
        option::Option[box::Box[ServiceJob]]::Some(b) => {
            run_on_main(finish_service_job, b.into_raw());
        }
        option::Option[box::Box[ServiceJob]]::None => { }
    }
    return 0;
}

fn finish_service_job(raw: *u8) {
    let job: ServiceJob = box::from_raw::[ServiceJob](raw).unwrap();
    let apply: fn(*u8) = job.apply;
    apply(job.svc_addr as *u8);     // install ON the main thread
    let cb: fn(*u8) = job.on_ready;
    cb(job.ctx_addr as *u8);
    return;
}

// Address a mounted element by its `key` — its agent id / accessibilityIdentifier,
// the SAME handle an external/MCP agent uses through the ACI surface. The search
// is GLOBAL across the app's mounted components, so in-app code addresses the UI
// exactly as an agent does: `find("save").set_text(...)` — no component context
// to thread.
//
// There is deliberately no per-component scoped form. It existed until
// 2026-07-26 as `find(key, cp)`, and it earned nothing: facet's own
// implementation never used it, real apps used the global form ~5:1, and every
// key that was passed with a scope was ALREADY namespaced (`terminal:host`,
// `chat:composer`), so the naming convention — not the scope — was doing the
// disambiguation. Against that it cost a whole bug class: `present`ed and inline
// children have no mounted slot, so a scoped lookup from inside one missed
// every time, silently, because a missing handle no-ops every mutator. Make keys
// window-unique by namespacing them; that is what apps already do.
fn find(key: str) -> Handle {
    let f: fn(*u8, str) -> Handle = FIND_FN;
    if f == (0 as fn(*u8, str) -> Handle) { return Handle::missing(); }
    // The backend hook keeps its `cp` slot (0 = global) so the ABI is unchanged;
    // there is simply no longer a surface way to pass anything else.
    return f(0 as *u8, key);
}

// ---- component lifecycle: stage / attach / detach --------------------------
// You can construct a component OFF-CANVAS and hold it, then attach it into the
// live tree at the right moment and detach it later — WITHOUT rebuilding it. Its
// views and state survive being parked, so re-attaching restores it exactly
// (scroll position, half-typed input, selection). This is the router / nav-stack
// shape: one nav owns every screen and attaches one at a time; navigating back
// shows the screen as you left it, for free, because the view object never died.
//
// attach / detach do NOTHING to your logic — they only NOTIFY the component that
// it happened (`on_attach` / `on_detach`), and `is_attached(cp)` lets it check at
// any later point — an async completion, say — whether it is still live before it
// touches the UI. What to do on detach (cancel an in-flight request, let it run
// but drop the result, keep streaming) is the app's policy, never facet's. This
// is the imperative, non-reactive mirror of Web Components (connectedCallback /
// disconnectedCallback / isConnected): no re-render, no diff.
//
//     impl Feed: facet::Component { fn build(this) -> facet::Node { ... } }
//     impl Feed: facet::Lifecycle {
//         fn on_attach(ref this) { this.reload(); }    // came on screen
//         fn on_detach(ref this) { /* your policy */ }
//     }
//     var feed: facet::Staged = facet::stage(Feed.build, ctx: #addr_of(FEED) as *u8,
//                                 on_attach: Feed.on_attach, on_detach: Feed.on_detach);
//     facet::find(NAV, "outlet").attach(feed);         // on_attach fires; is_attached -> true
//     feed.detach();                                   // parked (kept); on_detach fires
//
//     // an async completion, possibly long after navigating away:
//     fn feed_loaded(cp: *u8) {
//         if !facet::is_attached(cp) { return; }        // parked -> don't touch a dead view
//         facet::find(cp, "list").set_text(...);        // live -> normal keyed-direct update
//     }
interface Lifecycle {
    fn on_attach(ref this);
    fn on_detach(ref this);
}

// A handle to a STAGED component: its address (identity) and its facet-owned root
// view. Copy + non-owning — facet's registry owns the parked view tree.
struct Staged {
    opaque _cp: *u8,
    opaque _root: *u8,
}

// The default lifecycle callback: a component that opts out of a hook gets this.
fn lifecycle_noop(cp: *u8) { return; }

// Backend hooks, installed with the others (see facet_appkit `install`). Until a
// backend registers them, `stage` returns an invalid handle and the verbs no-op.
// STAGE_FN carries each callback with its own bound-reference context slot (the
// receiver's address, auto-filled at the call site — same shape mount_component
// uses for `build`).
static STAGE_FN: fn(fn(*u8) -> Node, *u8, fn(*u8), *u8, fn(*u8), *u8) -> Staged = #zero::[fn(fn(*u8) -> Node, *u8, fn(*u8), *u8, fn(*u8), *u8) -> Staged]();
static ATTACH_FN: fn(Handle, Staged) -> bool = #zero::[fn(Handle, Staged) -> bool]();
static DETACH_FN: fn(Staged) -> bool = #zero::[fn(Staged) -> bool]();
static IS_ATTACHED_FN: fn(*u8) -> bool = #zero::[fn(*u8) -> bool]();
static UNSTAGE_FN: fn(Staged) -> bool = #zero::[fn(Staged) -> bool]();

fn set_stage_fn(f: fn(fn(*u8) -> Node, *u8, fn(*u8), *u8, fn(*u8), *u8) -> Staged) { STAGE_FN = f; return; }
fn set_attach_fn(f: fn(Handle, Staged) -> bool) { ATTACH_FN = f; return; }
fn set_detach_fn(f: fn(Staged) -> bool) { DETACH_FN = f; return; }
fn set_is_attached_fn(f: fn(*u8) -> bool) { IS_ATTACHED_FN = f; return; }
fn set_unstage_fn(f: fn(Staged) -> bool) { UNSTAGE_FN = f; return; }

impl Staged {
    fn of(cp: *u8, root: *u8) -> Staged { return Staged { _cp: cp, _root: root }; }
    // The invalid handle (no backend, or a failed stage): every verb no-ops.
    fn none() -> Staged { return Staged::of(0 as *u8, 0 as *u8); }

    fn cp(this) -> *u8 { return this._cp; }
    fn root(this) -> *u8 { return this._root; }
    fn valid(this) -> bool { return this._cp != (0 as *u8); }

    // Am I in the live tree right now? The guard a handler checks at an async
    // completion before it touches the UI.
    fn is_attached(this) -> bool { return is_attached(this._cp); }

    // Pull this component out of the tree, KEEPING it parked (views + state
    // survive for a later re-attach). Fires `on_detach`. Returns whether it was
    // attached to begin with.
    fn detach(this) -> bool {
        let f: fn(Staged) -> bool = DETACH_FN;
        if f != (0 as fn(Staged) -> bool) { return f(this); }
        return false;
    }

    // Tear this staged component down for good: drop its parked views and its
    // registration. After this the handle is dead. Returns whether one was found.
    fn unstage(this) -> bool {
        let f: fn(Staged) -> bool = UNSTAGE_FN;
        if f != (0 as fn(Staged) -> bool) { return f(this); }
        return false;
    }
}

// Build a component OFF-CANVAS: its `build` runs once into a facet-owned parked
// root, its views + state held ready. Attach it later with
// `find(container, key).attach(staged)`. `on_attach` / `on_detach` are optional
// (default no-op). Backend-installed; returns an invalid Staged until registered.
fn stage(build: fn(*u8) -> Node, ctx: *u8 = 0 as *u8, on_attach: fn(*u8) = lifecycle_noop, on_attach_ctx: *u8 = 0 as *u8, on_detach: fn(*u8) = lifecycle_noop, on_detach_ctx: *u8 = 0 as *u8) -> Staged {
    let f: fn(fn(*u8) -> Node, *u8, fn(*u8), *u8, fn(*u8), *u8) -> Staged = STAGE_FN;
    if f == (0 as fn(fn(*u8) -> Node, *u8, fn(*u8), *u8, fn(*u8), *u8) -> Staged) { return Staged::none(); }
    return f(build, ctx, on_attach, on_attach_ctx, on_detach, on_detach_ctx);
}

// Is the component at `cp` currently attached to the live tree? A parked (staged
// but detached) or unknown component reads false. Backend-installed.
fn is_attached(cp: *u8) -> bool {
    let f: fn(*u8) -> bool = IS_ATTACHED_FN;
    if f == (0 as fn(*u8) -> bool) { return false; }
    return f(cp);
}

// Self-liveness for component code: is `c` currently mounted / attached?
// `ref` receives the caller's own place, so inside a `ref this` method the
// component asks `facet::attached(this)` — its address IS its identity (cp).
// Sugar it into a method if you like:
//     impl ScreenY { fn is_attached(ref this) -> bool { return facet::attached(this); } }
fn attached[C](ref c: C) -> bool {
    return is_attached(#addr_of(c) as *u8);
}

// ---- the outlet: switching among long-lived siblings ------------------------
// `present` REBUILDS: the right verb when a screen's appearance derives fully
// from surviving data (fields, services) — forward navigation, one-shot
// screens. For siblings the user RETURNS to (tab panels, inspector panes),
// rebuilding discards the view state that lives only in the native tree: a
// list's scroll offset, half-typed input, measured row heights. `switch_to`
// is the verb for that shape: each sibling is staged ONCE (built off-canvas)
// on its first visit, and switching moves the parked view trees in and out of
// the outlet — the views survive, so a sibling comes back exactly as it was
// left.
//
// The rule of thumb: tabs or panes you switch back and forth between ->
// `switch_to`; showing a new screen -> `present`. Don't mix the two verbs on
// one outlet.
//
//     fn show(ref this, idx: i32) {
//         let out: facet::Handle = facet::find("panels:outlet");
//         if idx == (0 as i32) { let _h: facet::Handle = out.switch_to(this.chat); }
//         else                 { let _h: facet::Handle = out.switch_to(this.files); }
//         return;
//     }
//
// Lifecycle matches `present`: the incoming sibling's `on_attach` fires on
// EVERY switch-in (guarded loads / keyed-slot populates keep data fresh), and
// the outgoing sibling's `on_detach` fires as it parks. Like `present`, a
// switched sibling must outlive its outlet (the registry holds its address).
//
// Two things the outlet manages so the app never has to:
//   - EVICTION: when the outlet itself leaves the tree (a body swap, a window
//     teardown), the attached sibling detaches (its on_detach fires) and every
//     parked tree of that outlet is dropped; the next switch_to re-stages.
//   - THEME changes: parked trees bake build-time colors, so `set_theme` drops
//     them (the ATTACHED sibling stays — the app's own theme path repaints or
//     rebuilds what is on screen); the next switch_to re-stages with the new
//     palette.

// One record per staged sibling: which outlet it belongs to, its identity
// (the component address), and its parked-tree handle.
struct RouterStaged {
    opaque _container: *u8,
    opaque _cp: *u8,
    _staged: Staged,
}

// One record per outlet: which sibling is attached right now (0 = none).
struct RouterSlot {
    opaque _container: *u8,
    opaque _cp: *u8,
}

static ROUTER_STAGED: vec::Vec[RouterStaged] = #zero::[vec::Vec[RouterStaged]]();
static ROUTER_SLOTS: vec::Vec[RouterSlot] = #zero::[vec::Vec[RouterSlot]]();

fn router_slot_index(container: *u8) -> i64 {
    let reg: *vec::Vec[RouterSlot] = #addr_of(ROUTER_SLOTS);
    let n: usize = { (*reg).count() };
    var i: usize = 0 as usize;
    while i < n {
        match (*reg).at_ptr(i) {
            option::Option[*RouterSlot]::Some(sp) => {
                if { (*sp)._container } == container { return i as i64; }
            }
            option::Option[*RouterSlot]::None => { }
        }
        i = i +% (1 as usize);
    }
    return -1;
}

// The attached sibling of `container` (0 when none / unknown outlet).
fn router_attached_cp(container: *u8) -> *u8 {
    let si: i64 = router_slot_index(container);
    if si < (0 as i64) { return 0 as *u8; }
    let reg: *vec::Vec[RouterSlot] = #addr_of(ROUTER_SLOTS);
    match (*reg).at_ptr(si as usize) {
        option::Option[*RouterSlot]::Some(sp) => { return { (*sp)._cp }; }
        option::Option[*RouterSlot]::None => { return 0 as *u8; }
    }
}

fn router_staged_of(cp: *u8) -> Staged {
    let reg: *vec::Vec[RouterStaged] = #addr_of(ROUTER_STAGED);
    let n: usize = { (*reg).count() };
    var i: usize = 0 as usize;
    while i < n {
        match (*reg).at_ptr(i) {
            option::Option[*RouterStaged]::Some(rp) => {
                if { (*rp)._cp } == cp { return { (*rp)._staged }; }
            }
            option::Option[*RouterStaged]::None => { }
        }
        i = i +% (1 as usize);
    }
    return Staged::none();
}

// The outlet that currently OWNS `cp`'s staging, or 0 when `cp` is not staged.
// `router_staged_of` deliberately ignores `_container` (a component has at most
// one parked tree), so this is the reader that tells cross-outlet reuse apart
// from a first visit.
fn router_staged_owner(cp: *u8) -> *u8 {
    let reg: *vec::Vec[RouterStaged] = #addr_of(ROUTER_STAGED);
    let n: usize = { (*reg).count() };
    var i: usize = 0 as usize;
    while i < n {
        match (*reg).at_ptr(i) {
            option::Option[*RouterStaged]::Some(rp) => {
                if { (*rp)._cp } == cp { return { (*rp)._container }; }
            }
            option::Option[*RouterStaged]::None => { }
        }
        i = i +% (1 as usize);
    }
    return 0 as *u8;
}

// Move `cp`'s staging record to a new owning outlet. Without this the staged
// record kept naming the outlet that first showed the component, so evicting
// THAT outlet later detached and unstaged a tree another outlet was displaying
// — see bugs/facet-switch-to-cross-outlet-staging-alias.md.
fn router_restage_owner(cp: *u8, container: *u8) {
    let reg: *vec::Vec[RouterStaged] = #addr_of(ROUTER_STAGED);
    let n: usize = { (*reg).count() };
    var i: usize = 0 as usize;
    while i < n {
        match (*reg).at_ptr(i) {
            option::Option[*RouterStaged]::Some(rp) => {
                if { (*rp)._cp } == cp { { (*rp)._container = container; } return; }
            }
            option::Option[*RouterStaged]::None => { }
        }
        i = i +% (1 as usize);
    }
    return;
}

// Clear an outlet's "currently showing" record without evicting its parked
// trees — the outlet still exists, it just shows nothing now.
fn router_clear_attached(container: *u8) {
    let reg: *vec::Vec[RouterSlot] = #addr_of(ROUTER_SLOTS);
    let si: i64 = router_slot_index(container);
    if si < (0 as i64) { return; }
    match (*reg).at_ptr(si as usize) {
        option::Option[*RouterSlot]::Some(sp) => { { (*sp)._cp = 0 as *u8; } }
        option::Option[*RouterSlot]::None => { }
    }
    return;
}

// Record `cp` as the attached sibling of `container`.
fn router_set_attached(container: *u8, cp: *u8) {
    let reg: *vec::Vec[RouterSlot] = #addr_of(ROUTER_SLOTS);
    let si: i64 = router_slot_index(container);
    if si < (0 as i64) {
        (*reg).append(RouterSlot { _container: container, _cp: cp });
        return;
    }
    match (*reg).at_ptr(si as usize) {
        option::Option[*RouterSlot]::Some(sp) => { { (*sp)._cp = cp; } }
        option::Option[*RouterSlot]::None => { }
    }
    return;
}

// The outlet's eviction hook (registered through the same container registry
// `present` uses, so every structural removal path fires it): park the
// attached sibling, then drop every parked tree that belongs to this outlet.
fn router_evict(container: *u8) {
    let cur: *u8 = router_attached_cp(container);
    if cur != (0 as *u8) { let _d: bool = router_staged_of(cur).detach(); }
    let slots: *vec::Vec[RouterSlot] = #addr_of(ROUTER_SLOTS);
    let si: i64 = router_slot_index(container);
    if si >= (0 as i64) { let _s: option::Option[RouterSlot] = { (*slots).remove(si as usize) }; }
    let reg: *vec::Vec[RouterStaged] = #addr_of(ROUTER_STAGED);
    var i: usize = { (*reg).count() };
    while i > (0 as usize) {
        i = i -% (1 as usize);
        var stale: bool = false;
        match (*reg).at_ptr(i) {
            option::Option[*RouterStaged]::Some(rp) => {
                if { (*rp)._container } == container {
                    let _u: bool = { (*rp)._staged }.unstage();
                    stale = true;
                }
            }
            option::Option[*RouterStaged]::None => { }
        }
        if stale { let _r: option::Option[RouterStaged] = { (*reg).remove(i) }; }
    }
    return;
}

// Theme change: drop every PARKED sibling (baked colors went stale); keep the
// attached ones — what is on screen is the app's own theme path's concern.
fn router_theme_invalidate() {
    let reg: *vec::Vec[RouterStaged] = #addr_of(ROUTER_STAGED);
    var i: usize = { (*reg).count() };
    while i > (0 as usize) {
        i = i -% (1 as usize);
        var stale: bool = false;
        match (*reg).at_ptr(i) {
            option::Option[*RouterStaged]::Some(rp) => {
                let on_screen: bool = router_attached_cp({ (*rp)._container }) == { (*rp)._cp };
                if !on_screen {
                    let _u: bool = { (*rp)._staged }.unstage();
                    stale = true;
                }
            }
            option::Option[*RouterStaged]::None => { }
        }
        if stale { let _r: option::Option[RouterStaged] = { (*reg).remove(i) }; }
    }
    return;
}

// Type-erasing trampolines for the outlet's staged wiring (the `switch_to`
// analogs of `lc_detach_tramp`).
fn router_build_tramp[C: Component](p: *u8) -> Node {
    let q: *C = p as *C;
    return { (*q).build() };
}

fn router_attach_tramp[C: Lifecycle](p: *u8) {
    let q: *C = p as *C;
    { (*q).on_attach() };
    return;
}

// ---- screens: Chrome + Screen + ScreenBox -----------------------------------
// A SCREEN is the unit of presentation. On desktop a screen shown at the top
// level is a window; shown into a keyed container it is a pane. On a mobile
// backend it is a page. A screen is an ordinary component — state in fields,
// handlers in the inherent impl, `build` in the Component block, lifecycle in
// the Lifecycle block — plus one more conformance, `chrome`: the presentation
// metadata its host reads when it shows the screen.
//
//     impl Settings: facet::Screen {
//         fn chrome(this) -> facet::Chrome {
//             return facet::Chrome::new(title: "Settings", width: 420.0f64);
//         }
//     }
//
// Run one directly with `runtime::run_screen(Settings::new())`, or register it
// under a route name on an `App` and navigate with `nav::go` / `nav::push`.

// One screen's presentation metadata: how the host window should look. A plain
// record — construct with `Chrome::new`, naming only what differs from the
// defaults. On a backend without windows most fields are ignored and `title`
// names the page. `hide_title` is honored together with `unified_toolbar`.
struct Chrome {
    title_text: text::Text,
    width: f64,
    height: f64,
    min_width: f64,
    min_height: f64,
    clean_titlebar: bool,
    close_button_only: bool,
    custom_chrome: bool,
    native_buttons: bool,
    unified_toolbar: bool,
    hide_title: bool,
    zoomable: bool,
    min_zoom: f64,
    max_zoom: f64,
}

impl Chrome {
    fn new(
        title: str = "facet",
        width: f64 = 480.0f64,
        height: f64 = 360.0f64,
        min_width: f64 = 0.0f64,
        min_height: f64 = 0.0f64,
        clean_titlebar: bool = false,
        close_button_only: bool = false,
        custom_chrome: bool = false,
        native_buttons: bool = false,
        unified_toolbar: bool = false,
        hide_title: bool = false,
        zoomable: bool = false,
        min_zoom: f64 = 1.0f64,
        max_zoom: f64 = 4.0f64,
    ) -> Chrome {
        return Chrome {
            title_text: text::from_str(title),
            width: width,
            height: height,
            min_width: min_width,
            min_height: min_height,
            clean_titlebar: clean_titlebar,
            close_button_only: close_button_only,
            custom_chrome: custom_chrome,
            native_buttons: native_buttons,
            unified_toolbar: unified_toolbar,
            hide_title: hide_title,
            zoomable: zoomable,
            min_zoom: min_zoom,
            max_zoom: max_zoom,
        };
    }

    fn title(this) -> str { return this.title_text.view(); }
}

// The screen conformance: presentation metadata, read by the host each time it
// shows the screen. A screen also conforms to Component and Lifecycle; the
// hosts (`run_screen`, `App`) bound all three.
interface Screen {
    fn chrome(this) -> Chrome;
    // The items this screen contributes to the app menu, merged additively by
    // the runtime each time the screen is shown (see AppMenu::extend). A screen
    // with nothing to add returns an empty Vec — C+ interfaces carry no default
    // bodies, so the empty case is written out rather than inherited.
    fn menu_items(this) -> vec::Vec[MenuItem];
}

// A type-erased, heap-owned screen — what a route factory returns, so an `App`
// holds screens of DIFFERENT types in one registry. `screen_box` moves the
// screen to the heap and pairs its address with value-turbofish trampolines
// for the three conformances. The box owns the instance: dropping the
// ScreenBox drops the screen (its own `drop` included) and frees the slot.
// The instance address is stable for the box's life, so it serves as the mount
// slot key — inside a handler, `facet::find(key, #addr_of(this) as *u8)`
// addresses the boxed screen's own subtree, exactly as under `run_component`.
struct ScreenBox {
    opaque _p: *u8,
    _build: fn(*u8) -> Node,
    _attach: fn(*u8),
    _detach: fn(*u8),
    _chrome: fn(*u8) -> Chrome,
    _menu_items: fn(*u8) -> vec::Vec[MenuItem],
    _drop: fn(*u8),
}

fn screen_box[S: Component + Lifecycle + Screen](take s: S) -> ScreenBox {
    return match box::new::[S](s) {
        option::Option[box::Box[S]]::Some(b) => ScreenBox {
            _p: b.into_raw(),
            _build: sb_build_tramp::[S],
            _attach: sb_attach_tramp::[S],
            _detach: sb_detach_tramp::[S],
            _chrome: sb_chrome_tramp::[S],
            _menu_items: sb_menu_items_tramp::[S],
            _drop: sb_drop_tramp::[S],
        },
        // Allocation failed: `s` dropped inside box::new. The invalid box —
        // every verb no-ops (the Handle::missing convention, not a trap).
        option::Option[box::Box[S]]::None => ScreenBox::invalid(),
    };
}

// Type-erasing trampolines (value-turbofish): plain fn(*u8)s that call S's
// conformance methods on the boxed screen at `p`.
fn sb_build_tramp[S: Component](p: *u8) -> Node {
    let q: *S = p as *S;
    return { (*q).build() };
}

fn sb_attach_tramp[S: Lifecycle](p: *u8) {
    let q: *S = p as *S;
    { (*q).on_attach() };
    return;
}

fn sb_detach_tramp[S: Lifecycle](p: *u8) {
    let q: *S = p as *S;
    { (*q).on_detach() };
    return;
}

fn sb_chrome_tramp[S: Screen](p: *u8) -> Chrome {
    let q: *S = p as *S;
    return { (*q).chrome() };
}

fn sb_menu_items_tramp[S: Screen](p: *u8) -> vec::Vec[MenuItem] {
    let q: *S = p as *S;
    return { (*q).menu_items() };
}

// Reclaim the heap slot: the box drops the screen (drop_in_place) and frees.
fn sb_drop_tramp[S](p: *u8) {
    let _b: box::Box[S] = box::from_raw::[S](p);
    return;
}

impl ScreenBox {
    // The no-screen box (failed allocation, or an unknown route): every verb
    // no-ops, `valid` reads false.
    fn invalid() -> ScreenBox {
        return ScreenBox {
            _p: 0 as *u8,
            _build: 0 as fn(*u8) -> Node,
            _attach: 0 as fn(*u8),
            _detach: 0 as fn(*u8),
            _chrome: 0 as fn(*u8) -> Chrome,
            _menu_items: 0 as fn(*u8) -> vec::Vec[MenuItem],
            _drop: 0 as fn(*u8),
        };
    }

    fn valid(this) -> bool { return this._p != (0 as *u8); }

    // The boxed instance's address — the mount slot key (cp) its handlers
    // self-locate against.
    fn instance(this) -> *u8 { return this._p; }

    fn build(this) -> Node {
        if !this.valid() { return column(Builder::new()); }
        let f: fn(*u8) -> Node = this._build;
        return f(this._p);
    }

    fn on_attach(this) {
        if !this.valid() { return; }
        let f: fn(*u8) = this._attach;
        f(this._p);
        return;
    }

    fn on_detach(this) {
        if !this.valid() { return; }
        let f: fn(*u8) = this._detach;
        f(this._p);
        return;
    }

    fn chrome(this) -> Chrome {
        if !this.valid() { return Chrome::new(); }
        let f: fn(*u8) -> Chrome = this._chrome;
        return f(this._p);
    }

    // The boxed screen's menu contribution. Empty for an invalid box, so the
    // host merges nothing rather than special-casing.
    fn menu_items(this) -> vec::Vec[MenuItem] {
        if !this.valid() { return vec::new::[MenuItem](); }
        let f: fn(*u8) -> vec::Vec[MenuItem] = this._menu_items;
        if f == (0 as fn(*u8) -> vec::Vec[MenuItem]) { return vec::new::[MenuItem](); }
        return f(this._p);
    }

    fn drop(ref this) {
        if this._p == (0 as *u8) { return; }
        let f: fn(*u8) = this._drop;
        f(this._p);
        this._p = 0 as *u8;
        return;
    }
}

// ---- modifiers -------------------------------------------------------------
// Fluent (chain on the item line) + `set_*` (own leading-dot line), the same
// two-form convention as flex_layout.

impl Node {
    fn grow(take this, v: f64) -> Node { var n: Node = this; n._grow = v; return n; }
    fn gap(take this, v: f64) -> Node { var n: Node = this; n._gap = v; return n; }
    fn padding(take this, v: f64) -> Node { var n: Node = this; n._padding = v; return n; }
    fn width(take this, v: f64) -> Node { var n: Node = this; n._width = v; return n; }
    fn height(take this, v: f64) -> Node { var n: Node = this; n._height = v; return n; }
    fn on_click(take this, cb: fn(*u8, *u8), ctx: *u8 = 0 as *u8) -> Node {
        var n: Node = this;
        n.click = cb;
        n.click_ctx = ctx;
        return n;
    }
    // Attach a second app-owned pointer, recovered in a handler via
    // `facet::item_of(sender)`. The bound-method `this` fills `click_ctx`; use
    // this for per-item data (a stable `&this.rows[i]` or an int-as-*u8 id) so
    // per-row identity need not be baked into `.key()` and re-parsed. The app
    // owns the pointee — same lifetime rule as `click_ctx`.
    fn item(take this, p: *u8) -> Node { var n: Node = this; n.item = p; return n; }
    // `key` is the app-facing name for a node's stable addressing id — the same
    // channel `find(key)` and the agent surface use (alias of agent_id).
    fn key(take this, id: str) -> Node {
        var n: Node = this;
        n.agent_id = text::from_str(id);
        return n;
    }
    fn agent_id(take this, id: str) -> Node {
        var n: Node = this;
        n.agent_id = text::from_str(id);
        return n;
    }
    fn tooltip(take this, s: str) -> Node { var n: Node = this; n.tooltip = text::from_str(s); return n; }
    fn accessibility_label(take this, s: str) -> Node { var n: Node = this; n.a11y_label = text::from_str(s); return n; }
    fn accessibility_hint(take this, s: str) -> Node { var n: Node = this; n.a11y_hint = text::from_str(s); return n; }
    // Keyboard shortcut (SwiftUI .keyboardShortcut) — the button's key equivalent.
    fn keyboard_shortcut(take this, key: str) -> Node { var n: Node = this; n.key_equiv = text::from_str(key); return n; }
    // Right-click context menu: `on_select` fires with the picked item's index.
    fn context_menu(take this, take items: vec::Vec[text::Text], on_select: fn(*u8, *u8)) -> Node {
        var n: Node = this;
        n.ctx_menu_items = items;
        n.ctx_menu_action = on_select;
        return n;
    }

    // Style modifiers (SwiftUI-shaped, C+-named). Each sets one `Style` field;
    // the backend's `apply_style` applies only the fields the author set.
    fn font(take this, size: f64) -> Node { var n: Node = this; n.style.font_size = size; return n; }
    fn weight(take this, w: u32) -> Node { var n: Node = this; n.style.weight = w; return n; }
    // `.bold()` is sugar for the bold weight token (SwiftUI's `.bold()`).
    fn strong(take this) -> Node { var n: Node = this; n.style.weight = weight_bold(); return n; }
    fn monospaced(take this) -> Node { var n: Node = this; n.style.family = family_monospace(); return n; }
    fn foreground_color(take this, c: Color) -> Node { var n: Node = this; n.style.fg = c; return n; }
    fn background(take this, c: Color) -> Node { var n: Node = this; n.style.bg = c; return n; }
    fn corner_radius(take this, r: f64) -> Node { var n: Node = this; n.style.corner_radius = r; return n; }
    fn border(take this, w: f64, c: Color) -> Node { var n: Node = this; n.style.border_width = w; n.style.border_color = c; return n; }
    fn opacity(take this, v: f64) -> Node { var n: Node = this; n.style.opacity = v; return n; }
    fn shadow(take this, radius: f64) -> Node { var n: Node = this; n.style.shadow_radius = radius; return n; }
    fn line_limit(take this, n_lines: i32) -> Node { var n: Node = this; n.style.line_limit = n_lines; return n; }
    // `.truncate()` — a single-line label that ends in an ellipsis when it
    // overflows, instead of clipping the last glyph (SwiftUI `.truncationMode(.tail)`).
    fn truncate(take this) -> Node { var n: Node = this; n.style.truncate = true; return n; }
    fn text_align(take this, a: i32) -> Node { var n: Node = this; n.style.text_align = a; return n; }
    fn hidden(take this) -> Node { var n: Node = this; n.style.hidden = true; return n; }
    fn italic(take this) -> Node { var n: Node = this; n.style.italic = true; return n; }
    fn clip(take this) -> Node { var n: Node = this; n.style.clip = true; return n; }
    fn underline(take this) -> Node { var n: Node = this; n.style.underline = true; return n; }
    fn strikethrough(take this) -> Node { var n: Node = this; n.style.strikethrough = true; return n; }
    // A two-color linear gradient fill. `dir` sets the start→end direction
    // (default Vertical, top→bottom); Horizontal / the two diagonals map to the
    // backend's gradient start/end points.
    fn gradient(take this, from: Color, to: Color, dir: GradientDir = GradientDir::Vertical) -> Node { var n: Node = this; n.style.grad_from = from; n.style.grad_to = to; n.style.grad_dir = dir; return n; }
    // Rotate (degrees) / scale about the element's center.
    fn rotation(take this, degrees: f64) -> Node { var n: Node = this; n.style.rotation = degrees; return n; }
    fn scale(take this, factor: f64) -> Node { var n: Node = this; n.style.scale = factor; return n; }
    // `.fade_in(duration)` — entrance fade (opacity 0→1) played on mount.
    // SwiftUI `.transition(.opacity)`; a one-shot appear animation.
    fn fade_in(take this, duration: f64) -> Node { var n: Node = this; n.style.fade_in = duration; return n; }
    // Path builders — append one segment each (SwiftUI Path's move/addLine/
    // addQuadCurve/addCurve/closeSubpath). Local top-left coordinates.
    fn move_to(take this, x: f64, y: f64) -> Node {
        var n: Node = this;
        n.path_cmds.append(PathCmd { op: path_op_move(), ax: x, ay: y, bx: 0.0f64, by: 0.0f64, cx: 0.0f64, cy: 0.0f64 });
        return n;
    }
    fn line_to(take this, x: f64, y: f64) -> Node {
        var n: Node = this;
        n.path_cmds.append(PathCmd { op: path_op_line(), ax: x, ay: y, bx: 0.0f64, by: 0.0f64, cx: 0.0f64, cy: 0.0f64 });
        return n;
    }
    fn quad_to(take this, cx: f64, cy: f64, x: f64, y: f64) -> Node {
        var n: Node = this;
        n.path_cmds.append(PathCmd { op: path_op_quad(), ax: x, ay: y, bx: cx, by: cy, cx: 0.0f64, cy: 0.0f64 });
        return n;
    }
    fn curve_to(take this, c1x: f64, c1y: f64, c2x: f64, c2y: f64, x: f64, y: f64) -> Node {
        var n: Node = this;
        n.path_cmds.append(PathCmd { op: path_op_cubic(), ax: x, ay: y, bx: c1x, by: c1y, cx: c2x, cy: c2y });
        return n;
    }
    fn close_path(take this) -> Node {
        var n: Node = this;
        n.path_cmds.append(PathCmd { op: path_op_close(), ax: 0.0f64, ay: 0.0f64, bx: 0.0f64, by: 0.0f64, cx: 0.0f64, cy: 0.0f64 });
        return n;
    }
    // `.on_drop(handler, ctx)` — make a `box` a text drop target (SwiftUI
    // `.dropDestination`). The handler fires with the drop-zone view as sender;
    // read the dropped string with `facet::dropped_text(sender)`.
    fn on_drop(take this, handler: fn(*u8, *u8), ctx: *u8 = 0 as *u8) -> Node {
        var n: Node = this;
        n.drop_handler = handler;
        n.drop_ctx = ctx;
        return n;
    }
    // Feedback while a drag is OVER this node. ONE handler for both edges, with
    // the state read from the sender:
    //
    //     fn lane_targeted(ref this, sender: *u8) {
    //         let on: bool = facet::drag_targeted(sender);
    //         let _h = facet::find("lane").set_background(if on { hot } else { cold });
    //     }
    //     ...column(b).on_drag_target(this.lane_targeted).on_drop(this.dropped)
    //
    // This is SwiftUI's `.dropDestination(isTargeted:)` shape rather than a
    // pair of enter/exit callbacks, and the reason is a bug the pair invites: a
    // drop fires no further dragging callback, so a highlight lit on enter and
    // cleared only on exit stays lit forever. With one handler the framework
    // owns the falling edge and calls it on drop too, so the app cannot
    // desync — it just paints whatever `drag_targeted` says.
    //
    // Ordinary hover cannot stand in: the platform SUPPRESSES mouse-tracking
    // for the duration of a drag, so `.on_hover_in` never fires with a card in
    // hand. Restyle by key from the handler — the live style setters already
    // exist, so this needs no painting surface of its own.
    fn on_drag_target(take this, handler: fn(*u8, *u8), ctx: *u8 = 0 as *u8) -> Node {
        var n: Node = this;
        n.drag_target_handler = handler;
        n.drag_over_ctx = ctx;
        return n;
    }

    // Receive raw key events while this element (or something inside it) holds
    // focus. `handler(event, ctx)` reads the event with key_code / key_chars /
    // key_modifiers, and calls consume_key() to stop it reaching the responder
    // chain. This is the primitive behind shortcut-driven surfaces — arrows,
    // function keys, Escape and Ctrl chords are otherwise unreachable, because
    // a text field only reports change and submit.
    //
    // SCOPE. `key_chars` and `key_modifiers` are portable; `key_code` is NOT —
    // it is the platform's own value, so branching on it is backend-specific
    // code wherever it is written. That is the line between what this covers
    // and what it does not:
    //
    //   yes — "Escape closes the sheet", "Cmd-Shift-P opens the palette",
    //         "arrow keys move the selection": read `key_chars` for printable
    //         input and `key_modifiers` for the chord.
    //   no  — anything that must map a full keyboard onto a byte protocol
    //         (a terminal emulator's Return/Tab/Delete/arrow/Home/PageUp →
    //         escape sequences). That is a table of platform key codes; it
    //         belongs to a native widget, and building it here would only move
    //         the platform constants into the handler body. The terminal
    //         package does exactly that, deliberately — see the note on
    //         `key_down_imp` in terminal/src/appkit.cplus.
    //
    // Delivery is a process-wide event filter matched by view (see
    // `register_key_target` in the AppKit backend), NOT a first-responder
    // override — a widget that needs true responder-chain participation wants
    // a native view, not this.
    fn on_key(take this, handler: fn(*u8, *u8), ctx: *u8 = 0 as *u8) -> Node {
        var n: Node = this;
        n.key_handler = handler;
        n.key_ctx = ctx;
        return n;
    }

    // `.draggable(text)` — make a `box` a drag SOURCE that carries `text` on the
    // pasteboard (SwiftUI `.draggable`). A box is either draggable OR a drop
    // target, not both (they need distinct backing views).
    fn draggable(take this, text: str) -> Node {
        var n: Node = this;
        n.drag_text = text::from_str(text);
        return n;
    }
    // `.toolbar(items)` — attach a window toolbar to the root node (SwiftUI
    // `.toolbar`). `items` is a Vec of button Nodes; the host (`run`) reads them
    // and builds the platform toolbar. Window chrome, so honored only on the tree
    // handed to `run`. (A `{ }` block isn't used — the DSL takes `(args)` on
    // modifiers, not a trailing builder block.)
    fn toolbar(take this, take items: vec::Vec[Node]) -> Node {
        var n: Node = this;
        n.toolbar_items = items;
        return n;
    }
    // `.frame(width:height:)` — set both fixed dimensions at once.
    fn frame(take this, w: f64, h: f64) -> Node { var n: Node = this; n._width = w; n._height = h; return n; }
    // `.plain()` — borderless button (the link/plain-button fold). Pair with
    // `.foreground_color(.accent)` for a link.
    fn plain(take this) -> Node { var n: Node = this; n.plain = true; return n; }

    fn set_grow(ref this, v: f64) { this._grow = v; return; }
    fn set_gap(ref this, v: f64) { this._gap = v; return; }
    fn set_padding(ref this, v: f64) { this._padding = v; return; }
    fn set_width(ref this, v: f64) { this._width = v; return; }
    fn set_height(ref this, v: f64) { this._height = v; return; }
    fn layout_width(this) -> f64 { return this._width; }
    fn layout_width_pct(this) -> f64 { return this._width_pct; }
    fn set_on_click(ref this, cb: fn(*u8, *u8), ctx: *u8 = 0 as *u8) {
        this.click = cb;
        this.click_ctx = ctx;
        return;
    }
    fn set_agent_id(ref this, id: str) {
        this.agent_id = text::from_str(id);
        return;
    }
    fn set_tooltip(ref this, s: str) { this.tooltip = text::from_str(s); return; }
    fn set_accessibility_label(ref this, s: str) { this.a11y_label = text::from_str(s); return; }
    fn set_accessibility_hint(ref this, s: str) { this.a11y_hint = text::from_str(s); return; }
    fn set_keyboard_shortcut(ref this, key: str) { this.key_equiv = text::from_str(key); return; }

    fn set_font(ref this, size: f64) { this.style.font_size = size; return; }
    fn set_weight(ref this, w: u32) { this.style.weight = w; return; }
    fn set_strong(ref this) { this.style.weight = weight_bold(); return; }
    fn set_monospaced(ref this) { this.style.family = family_monospace(); return; }
    fn set_foreground_color(ref this, c: Color) { this.style.fg = c; return; }
    fn set_background(ref this, c: Color) { this.style.bg = c; return; }
    fn set_corner_radius(ref this, r: f64) { this.style.corner_radius = r; return; }
    fn set_border(ref this, w: f64, c: Color) { this.style.border_width = w; this.style.border_color = c; return; }
    fn set_opacity(ref this, v: f64) { this.style.opacity = v; return; }
    fn set_shadow(ref this, radius: f64) { this.style.shadow_radius = radius; return; }
    fn set_line_limit(ref this, n_lines: i32) { this.style.line_limit = n_lines; return; }
    fn set_truncate(ref this, v: bool) { this.style.truncate = v; return; }
    fn set_text_align(ref this, a: i32) { this.style.text_align = a; return; }
    fn set_hidden(ref this, v: bool) { this.style.hidden = v; return; }
    fn set_italic(ref this, v: bool) { this.style.italic = v; return; }
    fn set_clip(ref this, v: bool) { this.style.clip = v; return; }
    fn set_underline(ref this, v: bool) { this.style.underline = v; return; }
    fn set_strikethrough(ref this, v: bool) { this.style.strikethrough = v; return; }
    fn set_gradient(ref this, from: Color, to: Color, dir: GradientDir = GradientDir::Vertical) { this.style.grad_from = from; this.style.grad_to = to; this.style.grad_dir = dir; return; }
    fn set_rotation(ref this, degrees: f64) { this.style.rotation = degrees; return; }
    fn set_scale(ref this, factor: f64) { this.style.scale = factor; return; }
    fn set_frame(ref this, w: f64, h: f64) { this._width = w; this._height = h; return; }
    fn set_plain(ref this) { this.plain = true; return; }

    // ---- extended flexbox layout (flex vocabulary; thin pass-through) --------
    // Fluent (same-line chain) + set_ (leading-dot line), the same two-form rule
    // as the rest. Enums are flex_layout's own — the layout substrate is shared,
    // so facet does not reskin it.
    fn align_items(take this, a: flex::Align) -> Node { var n: Node = this; n._align_items = a; n._has_align_items = true; return n; }
    fn align_self(take this, a: flex::Align) -> Node { var n: Node = this; n._align_self = a; n._has_align_self = true; return n; }
    fn justify_content(take this, j: flex::Justify) -> Node { var n: Node = this; n._justify = j; n._has_justify = true; return n; }
    fn shrink(take this, v: f64) -> Node { var n: Node = this; n._shrink = v; return n; }
    fn min_width(take this, v: f64) -> Node { var n: Node = this; n._min_w = v; return n; }
    fn min_height(take this, v: f64) -> Node { var n: Node = this; n._min_h = v; return n; }
    fn max_width(take this, v: f64) -> Node { var n: Node = this; n._max_w = v; return n; }
    fn max_height(take this, v: f64) -> Node { var n: Node = this; n._max_h = v; return n; }
    fn padding_edge(take this, e: flex::Edge, v: f64) -> Node { var n: Node = this; n.pad_edge_into(e, v); return n; }

    fn set_align_items(ref this, a: flex::Align) { this._align_items = a; this._has_align_items = true; return; }
    fn set_align_self(ref this, a: flex::Align) { this._align_self = a; this._has_align_self = true; return; }
    fn set_justify_content(ref this, j: flex::Justify) { this._justify = j; this._has_justify = true; return; }
    fn set_shrink(ref this, v: f64) { this._shrink = v; return; }
    fn set_min_width(ref this, v: f64) { this._min_w = v; return; }
    fn set_min_height(ref this, v: f64) { this._min_h = v; return; }
    fn set_max_width(ref this, v: f64) { this._max_w = v; return; }
    fn set_max_height(ref this, v: f64) { this._max_h = v; return; }
    fn set_padding_edge(ref this, e: flex::Edge, v: f64) { this.pad_edge_into(e, v); return; }

    // Route one flex::Edge onto the per-edge padding fields (Start/End = LTR).
    fn pad_edge_into(ref this, e: flex::Edge, v: f64) {
        match e {
            flex::Edge::Left => { this._pad_l = v; }
            flex::Edge::Right => { this._pad_r = v; }
            flex::Edge::Top => { this._pad_t = v; }
            flex::Edge::Bottom => { this._pad_b = v; }
            flex::Edge::Start => { this._pad_l = v; }
            flex::Edge::End => { this._pad_r = v; }
            flex::Edge::Horizontal => { this._pad_l = v; this._pad_r = v; }
            flex::Edge::Vertical => { this._pad_t = v; this._pad_b = v; }
            flex::Edge::All => { this._pad_l = v; this._pad_t = v; this._pad_r = v; this._pad_b = v; }
        }
        return;
    }

    // ---- more flexbox layout (P1 pass-throughs) ------------------------------
    fn flex_basis(take this, v: f64) -> Node { var n: Node = this; n._basis = v; return n; }
    fn aspect_ratio(take this, v: f64) -> Node { var n: Node = this; n._aspect = v; return n; }
    fn flex_wrap(take this, w: flex::Wrap) -> Node { var n: Node = this; n._wrap = w; n._has_wrap = true; return n; }
    fn position_absolute(take this) -> Node { var n: Node = this; n._position_type = flex::PositionType::Absolute; n._has_position_type = true; return n; }
    fn position_relative(take this) -> Node { var n: Node = this; n._position_type = flex::PositionType::Relative; n._has_position_type = true; return n; }
    fn margin(take this, v: f64) -> Node { var n: Node = this; n._mrg_l = v; n._mrg_t = v; n._mrg_r = v; n._mrg_b = v; return n; }
    fn margin_edge(take this, e: flex::Edge, v: f64) -> Node { var n: Node = this; n.mrg_edge_into(e, v); return n; }
    fn inset(take this, e: flex::Edge, v: f64) -> Node { var n: Node = this; n.inset_into(e, v); return n; }

    // Percent sizing, per-gutter gap, and container display/overflow/content/dir.
    fn width_pct(take this, v: f64) -> Node { var n: Node = this; n._width_pct = v; return n; }
    fn height_pct(take this, v: f64) -> Node { var n: Node = this; n._height_pct = v; return n; }
    fn gap_row(take this, v: f64) -> Node { var n: Node = this; n._gap_row = v; return n; }
    fn gap_col(take this, v: f64) -> Node { var n: Node = this; n._gap_col = v; return n; }
    fn display(take this, d: flex::Display) -> Node { var n: Node = this; n._display = d; n._has_display = true; return n; }
    // Paint/stacking order among overlapping siblings — higher `z` draws on top,
    // WHERE they overlap; layout position/size is unaffected (CSS z-index).
    fn z_index(take this, z: i32) -> Node { var n: Node = this; n._z_index = z; n._has_z_index = true; return n; }
    fn overflow(take this, o: flex::Overflow) -> Node { var n: Node = this; n._overflow = o; n._has_overflow = true; return n; }
    fn align_content(take this, a: flex::Align) -> Node { var n: Node = this; n._align_content = a; n._has_align_content = true; return n; }
    fn direction(take this, d: flex::Direction) -> Node { var n: Node = this; n._direction = d; n._has_direction = true; return n; }
    fn box_sizing(take this, b: flex::BoxSizing) -> Node { var n: Node = this; n._box_sizing = b; n._has_box_sizing = true; return n; }
    fn flex_direction(take this, d: flex::FlexDirection) -> Node { var n: Node = this; n._flex_dir = d; n._has_flex_dir = true; return n; }
    fn grid_span(take this, cols: i32, rows: i32) -> Node { var n: Node = this; n._grid_col_span = cols; n._grid_row_span = rows; return n; }
    fn grid_pos(take this, col: i32, row: i32) -> Node { var n: Node = this; n._grid_col_start = col; n._grid_row_start = row; return n; }
    fn grid_subgrid(take this, cols: bool, rows: bool) -> Node { var n: Node = this; n._grid_cols_subgrid = cols; n._grid_rows_subgrid = rows; return n; }
    // Border as a layout inset (reserves space, like padding — distinct from the
    // Style border paint).
    fn border_inset(take this, e: flex::Edge, v: f64) -> Node { var n: Node = this; n.bdr_edge_into(e, v); return n; }
    // Logical (direction-relative) padding/margin: start = leading edge (left in
    // LTR, right in RTL). Physical edges win if also set (flex rule).
    fn padding_start(take this, v: f64) -> Node { var n: Node = this; n._pad_start = v; return n; }
    fn padding_end(take this, v: f64) -> Node { var n: Node = this; n._pad_end = v; return n; }
    fn margin_start(take this, v: f64) -> Node { var n: Node = this; n._mrg_start = v; return n; }
    fn margin_end(take this, v: f64) -> Node { var n: Node = this; n._mrg_end = v; return n; }

    fn set_grid_subgrid(ref this, cols: bool, rows: bool) { this._grid_cols_subgrid = cols; this._grid_rows_subgrid = rows; return; }
    fn set_border_inset(ref this, e: flex::Edge, v: f64) { this.bdr_edge_into(e, v); return; }
    fn set_padding_start(ref this, v: f64) { this._pad_start = v; return; }
    fn set_padding_end(ref this, v: f64) { this._pad_end = v; return; }
    fn set_margin_start(ref this, v: f64) { this._mrg_start = v; return; }
    fn set_margin_end(ref this, v: f64) { this._mrg_end = v; return; }

    fn bdr_edge_into(ref this, e: flex::Edge, v: f64) {
        match e {
            flex::Edge::Left => { this._bdr_l = v; }
            flex::Edge::Right => { this._bdr_r = v; }
            flex::Edge::Top => { this._bdr_t = v; }
            flex::Edge::Bottom => { this._bdr_b = v; }
            flex::Edge::Start => { this._bdr_l = v; }
            flex::Edge::End => { this._bdr_r = v; }
            flex::Edge::Horizontal => { this._bdr_l = v; this._bdr_r = v; }
            flex::Edge::Vertical => { this._bdr_t = v; this._bdr_b = v; }
            flex::Edge::All => { this._bdr_l = v; this._bdr_t = v; this._bdr_r = v; this._bdr_b = v; }
        }
        return;
    }

    fn set_width_pct(ref this, v: f64) { this._width_pct = v; return; }
    fn set_height_pct(ref this, v: f64) { this._height_pct = v; return; }
    fn set_gap_row(ref this, v: f64) { this._gap_row = v; return; }
    fn set_gap_col(ref this, v: f64) { this._gap_col = v; return; }
    fn set_display(ref this, d: flex::Display) { this._display = d; this._has_display = true; return; }
    fn set_overflow(ref this, o: flex::Overflow) { this._overflow = o; this._has_overflow = true; return; }
    fn set_align_content(ref this, a: flex::Align) { this._align_content = a; this._has_align_content = true; return; }
    fn set_direction(ref this, d: flex::Direction) { this._direction = d; this._has_direction = true; return; }
    fn set_box_sizing(ref this, b: flex::BoxSizing) { this._box_sizing = b; this._has_box_sizing = true; return; }
    fn set_flex_direction(ref this, d: flex::FlexDirection) { this._flex_dir = d; this._has_flex_dir = true; return; }
    fn set_grid_span(ref this, cols: i32, rows: i32) { this._grid_col_span = cols; this._grid_row_span = rows; return; }
    fn set_grid_pos(ref this, col: i32, row: i32) { this._grid_col_start = col; this._grid_row_start = row; return; }

    fn set_flex_basis(ref this, v: f64) { this._basis = v; return; }
    fn set_aspect_ratio(ref this, v: f64) { this._aspect = v; return; }
    fn set_flex_wrap(ref this, w: flex::Wrap) { this._wrap = w; this._has_wrap = true; return; }
    fn set_position_absolute(ref this) { this._position_type = flex::PositionType::Absolute; this._has_position_type = true; return; }
    fn set_margin(ref this, v: f64) { this._mrg_l = v; this._mrg_t = v; this._mrg_r = v; this._mrg_b = v; return; }
    fn set_margin_edge(ref this, e: flex::Edge, v: f64) { this.mrg_edge_into(e, v); return; }
    fn set_inset(ref this, e: flex::Edge, v: f64) { this.inset_into(e, v); return; }

    fn mrg_edge_into(ref this, e: flex::Edge, v: f64) {
        match e {
            flex::Edge::Left => { this._mrg_l = v; }
            flex::Edge::Right => { this._mrg_r = v; }
            flex::Edge::Top => { this._mrg_t = v; }
            flex::Edge::Bottom => { this._mrg_b = v; }
            flex::Edge::Start => { this._mrg_l = v; }
            flex::Edge::End => { this._mrg_r = v; }
            flex::Edge::Horizontal => { this._mrg_l = v; this._mrg_r = v; }
            flex::Edge::Vertical => { this._mrg_t = v; this._mrg_b = v; }
            flex::Edge::All => { this._mrg_l = v; this._mrg_t = v; this._mrg_r = v; this._mrg_b = v; }
        }
        return;
    }

    // Set an absolute inset edge + mark its mask bit (0 is a valid inset).
    fn inset_into(ref this, e: flex::Edge, v: f64) {
        match e {
            flex::Edge::Left => { this._ins_l = v; this._inset_mask = this._inset_mask | (1 as u32); }
            flex::Edge::Right => { this._ins_r = v; this._inset_mask = this._inset_mask | (4 as u32); }
            flex::Edge::Top => { this._ins_t = v; this._inset_mask = this._inset_mask | (2 as u32); }
            flex::Edge::Bottom => { this._ins_b = v; this._inset_mask = this._inset_mask | (8 as u32); }
            flex::Edge::Start => { this._ins_l = v; this._inset_mask = this._inset_mask | (1 as u32); }
            flex::Edge::End => { this._ins_r = v; this._inset_mask = this._inset_mask | (4 as u32); }
            flex::Edge::Horizontal => { this._ins_l = v; this._ins_r = v; this._inset_mask = this._inset_mask | (5 as u32); }
            flex::Edge::Vertical => { this._ins_t = v; this._ins_b = v; this._inset_mask = this._inset_mask | (10 as u32); }
            flex::Edge::All => { this._ins_l = v; this._ins_t = v; this._ins_r = v; this._ins_b = v; this._inset_mask = 15 as u32; }
        }
        return;
    }
}

// ---- the DSL builder contract ----------------------------------------------

struct Builder {
    children: vec::Vec[Node],
}

impl Builder {
    fn new() -> Builder {
        return Builder { children: vec::new::[Node]() };
    }

    fn add(ref this, take item: Node) {
        this.children.append(item);
        return;
    }

    // The block's value: a plain column of its top-level items.
    fn finish(take this) -> Node {
        let Builder { children } = this;
        var n: Node = blank(kind_column());
        n.children = children;
        return n;
    }
}

// ---- containers --------------------------------------------------------------
// The HIG presets mirror flex_layout's: 8pt between related items, 16pt card
// padding, 20pt screen margins.

fn column(take b: Builder) -> Node {
    let Builder { children } = b;
    var n: Node = blank(kind_column());
    n.children = children;
    return n;
}

fn row(take b: Builder) -> Node {
    let Builder { children } = b;
    var n: Node = blank(kind_row());
    n.children = children;
    return n;
}

fn vstack(take b: Builder) -> Node {
    var n: Node = column(b);
    n._gap = flex::HIG_SPACE_S;
    return n;
}

fn hstack(take b: Builder) -> Node {
    var n: Node = row(b);
    n._gap = flex::HIG_SPACE_S;
    return n;
}

// Overlay stack. The first child stays in flow and sizes the stack; the rest
// are taken out of flow and pinned to the leading corner (top-left), so they
// overlay without shifting layout. An overlay child can position itself
// (`.inset(...)` / `.position_absolute()`) — e.g. a badge at the top-right —
// and mount honors that instead of the default corner.
//
// When the stack itself is STRETCHED past the first child — an overlay
// filling a fixed-height row, say — that child keeps its natural size (normal
// flex) and an `.inset(All, 0)` overlay fills the whole stack, so the two no
// longer coincide. Give the first child `.grow(1)` to keep them covering each
// other exactly (a content-sized stack is unaffected: grow only distributes
// extra space).
fn zstack(take b: Builder) -> Node {
    let Builder { children } = b;
    var n: Node = blank(kind_zstack());
    n.children = children;
    return n;
}

fn screen(take b: Builder) -> Node {
    var n: Node = column(b);
    n._gap = flex::HIG_SPACE_S;
    n._padding = flex::HIG_SPACE_L;
    return n;
}

fn card(take b: Builder) -> Node {
    var n: Node = column(b);
    n._gap = flex::HIG_SPACE_S;
    n._padding = flex::HIG_SPACE_M;
    return n;
}

// Wrapper kinds — content lives in `children`; mount recurses then hands the
// mounted flex nodes to the backend op.

// Bordered box around one (or more) children. Prefer a single child; multiple
// children are mounted as a column by the backend adapter if needed — the
// description stores them as-is and mount passes children[0] for the one-content
// vtable op (compose with column{} when wrapping several).
fn bordered(take b: Builder, radius: f64 = 6.0f64) -> Node {
    let Builder { children } = b;
    var n: Node = blank(kind_bordered());
    n.children = children;
    n.radius = radius;
    return n;
}

// A translucent vibrancy panel (macOS material). Wraps its content in a
// VisualEffectView backing; other backends fall back to a plain container.
fn material(take b: Builder) -> Node {
    let Builder { children } = b;
    var n: Node = blank(kind_material());
    n.children = children;
    return n;
}

// A window-drag surface (custom-titlebar affordance): wrap a content row so the
// backend makes its bare regions drag the host window and zoom on double-click.
// Pair with a custom_chrome window (hidden standard buttons) + `window_close` /
// `window_minimize` / `window_zoom` on the app's own controls. Content controls
// keep their own clicks — only the empty surface drags. On backends without a
// native equivalent, the content passes through unchanged (the honest fallback).
fn window_drag(take b: Builder) -> Node {
    let Builder { children } = b;
    var n: Node = blank(kind_window_drag());
    n.children = children;
    return n;
}

// The app's real window controls: a native leaf that re-parents the standard
// close / miniaturize / zoom buttons into itself, so a content toolbar shows the
// GENUINE traffic lights (native zoom-toggle + green hover/tiling menu), not
// fakes. Pair with a `wants_native_buttons` window (keeps the buttons visible
// under a full-size, hidden-title chrome). Measures to the buttons' natural
// extent. On a backend with no equivalent it is an empty leaf.
fn window_buttons() -> Node {
    return blank(kind_window_buttons());
}

// Clickable wrapper: gesture handlers on the node, content in children[0].
// Primary click lands in `click` (same field as button); optional gestures
// use the null-fn sentinel when unset.
fn clickable(
    take b: Builder,
    on_click: fn(*u8, *u8) = 0 as fn(*u8, *u8),
    on_double_click: fn(*u8, *u8) = 0 as fn(*u8, *u8),
    on_right_click: fn(*u8, *u8) = 0 as fn(*u8, *u8),
    on_long_press: fn(*u8, *u8) = 0 as fn(*u8, *u8),
    long_press_seconds: f64 = 0.0f64,
    on_drag: fn(*u8, *u8) = 0 as fn(*u8, *u8),
    on_pinch: fn(*u8, *u8) = 0 as fn(*u8, *u8),
    on_rotate: fn(*u8, *u8) = 0 as fn(*u8, *u8),
    on_hover_in: fn(*u8, *u8) = 0 as fn(*u8, *u8),
    on_hover_out: fn(*u8, *u8) = 0 as fn(*u8, *u8),
    on_scroll: fn(*u8, *u8) = 0 as fn(*u8, *u8),
    ctx: *u8 = 0 as *u8,
) -> Node {
    let Builder { children } = b;
    var n: Node = blank(kind_clickable());
    n.children = children;
    // Only overwrite `click` when a handler was supplied (null-fn → leave noop).
    if on_click != null_fn() {
        n.click = on_click;
    }
    n.on_double_click = on_double_click;
    n.on_right_click = on_right_click;
    n.on_long_press = on_long_press;
    n.long_press_seconds = long_press_seconds;
    n.on_drag = on_drag;
    n.on_pinch = on_pinch;
    n.on_rotate = on_rotate;
    n.on_hover_in = on_hover_in;
    n.on_hover_out = on_hover_out;
    n.on_scroll = on_scroll;
    n.click_ctx = ctx;
    return n;
}

// A scrolling container. Children are laid out (as a column) and hosted in the
// backend's scroll view; content taller than the viewport scrolls. The backend
// sizes content two-phase (at the viewport width, after the outer layout).
// A scrolling container. `horizontal: false` (default) is the usual vertical
// scroll — content is laid at the viewport width and scrolls down. `horizontal:
// true` scrolls SIDEWAYS instead: content keeps its natural width and the
// viewport gains a horizontal scroller (a code block that must not wrap, say).
// A horizontal scroll is opaque to the layout on its cross axis, so give it a
// definite `.height(...)`. Reuses the `soft_wrap` slot (false = horizontal),
// the same "no wrap = scroll sideways" meaning it has for text_area/code.
fn scroll(take b: Builder, horizontal: bool = false) -> Node {
    let Builder { children } = b;
    var n: Node = blank(kind_scroll());
    n.children = children;
    n.soft_wrap = !horizontal;
    return n;
}

// Two-pane split. Expects exactly two children (first / second pane).
fn split(
    take b: Builder,
    vertical: bool = true,
    position: f64 = 220.0f64,
    min_first: f64 = 150.0f64,
    min_second: f64 = 240.0f64,
) -> Node {
    let Builder { children } = b;
    var n: Node = blank(kind_split());
    n.children = children;
    n.vertical = vertical;
    n.position = position;
    n.min_first = min_first;
    n.min_second = min_second;
    return n;
}

// ---- the Renderer vtable + mount ---------------------------------------------
// Write-once walk: containers and layout props are pure flex_layout, built
// here; widget kinds dispatch through the vtable. Each leaf op receives the
// backend context and the node (for its text/config/handlers) and returns a
// flex node whose payload is the native widget. Wrapper ops additionally take
// already-mounted content (`take` ownership marker is part of the fn-ptr type).
// After every widget-producing op, mount calls set_identity — the single choke
// point for agent id + role (backends pin native metadata there).
//
// ============================================================================
// THE CONTRACT (frozen). This struct + `Style`/`Color` (weight/family tokens)
// ARE the cross-backend contract. A backend is portable-by-construction: it
// fills this typed struct or it does not compile — the compiler is the parity
// check, not a doc. To add a backend (facet_gtk4 / facet_win32 / facet_uikit):
//
//   1. one op per field below — leaf ops build a native widget into a flex
//      payload; wrapper ops (bordered/clickable/split) take mounted content.
//   2. `apply_style(view, kind, Style)` — map the portable Style onto the
//      native widget (per-kind; only set fields; tokens → native colors/fonts).
//   3. `set_identity(ctx, handle, id, role)` — pin the agent id + record the
//      (role, drive) affordance for the matching agent_* reader.
//   4. the `native` op — adopt an app-owned handle (the escape hatch).
//   5. a small host — a window + a relayout/re-mount primitive.
//
// `fake_renderer` (in the tests) is the PORTABLE CONFORMANCE TEST: it fills the
// same struct with pure-C+ stubs, so the whole description→flex pipeline is
// exercised with no platform. facet_appkit is the reference implementation;
// facet_gtk is a second, type-checked-only backend proving the shape is not
// AppKit-specific. `symbol` is PROVISIONAL — an SF-Symbol Apple-ism with no
// portable meaning yet; don't freeze it as portable (a backend maps a themed
// icon set). Growing the API = +1 kind constant, +1 field here, +1 constructor;
// every backend then fails to compile until it supplies the op — the honest,
// localized gap.
// ============================================================================

struct Renderer {
    opaque ctx: *u8,
    // leaves
    label:       fn(*u8, *Node) -> flex::Node,
    wrap_label:  fn(*u8, *Node) -> flex::Node,
    button:      fn(*u8, *Node) -> flex::Node,
    text_area:   fn(*u8, *Node) -> flex::Node,
    composer:    fn(*u8, *Node) -> flex::Node,
    // Tier-2 leaves (Phase 2)
    image:       fn(*u8, *Node) -> flex::Node,
    symbol:      fn(*u8, *Node) -> flex::Node,
    text_field:  fn(*u8, *Node) -> flex::Node,
    popup:       fn(*u8, *Node) -> flex::Node,
    divider:     fn(*u8, *Node) -> flex::Node,
    // Form controls (matrix §2)
    toggle:      fn(*u8, *Node) -> flex::Node,
    slider:      fn(*u8, *Node) -> flex::Node,
    progress:    fn(*u8, *Node) -> flex::Node,
    stepper:     fn(*u8, *Node) -> flex::Node,
    secure_field: fn(*u8, *Node) -> flex::Node,
    segmented:   fn(*u8, *Node) -> flex::Node,
    color_picker: fn(*u8, *Node) -> flex::Node,
    date_picker: fn(*u8, *Node) -> flex::Node,
    search_field: fn(*u8, *Node) -> flex::Node,
    combo_box:   fn(*u8, *Node) -> flex::Node,
    token_field: fn(*u8, *Node) -> flex::Node,
    box:         fn(*u8, *Node) -> flex::Node,
    gauge:       fn(*u8, *Node) -> flex::Node,
    path:        fn(*u8, *Node) -> flex::Node,
    // The escape hatch (Phase 3)
    native:      fn(*u8, *Node) -> flex::Node,
    // window_buttons: re-parent the native window controls into a host view (the
    // real traffic lights for a custom titlebar). A backend with no equivalent
    // returns an empty leaf.
    window_buttons: fn(*u8, *Node) -> flex::Node,
    // wrappers — mount recurses children first, then hands them over
    bordered:    fn(*u8, *Node, take flex::Node) -> flex::Node,
    clickable:   fn(*u8, *Node, take flex::Node) -> flex::Node,
    scroll:      fn(*u8, *Node, take flex::Node) -> flex::Node,
    material:    fn(*u8, *Node, take flex::Node) -> flex::Node,
    // window_drag: wrap content in a surface that drags (and double-click-zooms)
    // the host window — the custom-titlebar affordance. A backend with no native
    // equivalent returns the content unchanged.
    window_drag: fn(*u8, *Node, take flex::Node) -> flex::Node,
    split:       fn(*u8, *Node, take flex::Node, take flex::Node) -> flex::Node,
    // Keyed containers: give a column/row/zstack/grid a backing view AT MOUNT and
    // set it as the (already-built) flex node's payload, so `find(key)` can address
    // the container. `apply` synthesizes an identical backing view for unkeyed
    // containers anyway — this just creates the keyed one early enough to tag it.
    container:   fn(*u8, *Node, *flex::Node),
    // called by mount after every widget-producing op
    set_identity: fn(*u8, *u8, str, u32),  // (ctx, handle, id, role)
}

// The container kinds that lay out children directly (no vtable widget op). A
// keyed one gets a backing view via `Renderer.container` so it is addressable.
fn is_container_kind(k: u32) -> bool {
    return k == kind_column() || k == kind_row() || k == kind_zstack() || k == kind_grid();
}

// Whether a container's Style operates on a VIEW (paint, visibility,
// transform) — such a container needs a backing view too, or the style is a
// silent no-op (there is nothing to paint a background ON). Text-only fields
// (fg, font) don't count: a container has no text of its own.
// Drag and drop are the third reason a container needs a real backing view —
// the platform resolves a drop destination by walking UP from the view under
// the pointer, so an unkeyed, unstyled `column(b).on_drop(...)` still has to
// become a view or it is not on that walk at all. Portable: the backend decides
// WHAT kind of view, this only decides THAT there must be one.
fn node_wants_drag_view(np: *Node) -> bool {
    if { (*np).drop_handler } != null_fn() { return true; }
    if { (*np).drag_text.view() } != "" { return true; }
    // Feedback alone is enough: a lane that only highlights is still a dragging
    // DESTINATION, and a destination has to be a real view.
    if { (*np).drag_target_handler } != null_fn() { return true; }
    return false;
}

fn style_wants_view(np: *Node) -> bool {
    let s: Style = { (*np).style };
    if s.bg.is_set() { return true; }
    if s.grad_from.is_set() && s.grad_to.is_set() { return true; }
    if s.border_width > 0.0f64 { return true; }
    if s.corner_radius > 0.0f64 { return true; }
    if s.clip { return true; }
    if s.hidden { return true; }
    if s.opacity >= 0.0f64 { return true; }
    if s.shadow_radius > 0.0f64 { return true; }
    if s.rotation != 0.0f64 { return true; }
    if s.scale != 1.0f64 { return true; }
    if s.fade_in > 0.0f64 { return true; }
    return false;
}

// Pin agent id + role after a widget op. Handle is the op's nominated identity
// surface — by default the returned flex node's payload. Backends where the
// drive target differs from the layout payload (composer/text_area inner
// text view vs outer scroll) resolve that inside set_identity itself.
fn call_set_identity(np: *Node, r: Renderer, handle: *u8, kind: u32) {
    let f: fn(*u8, *u8, str, u32) = r.set_identity;
    let id: str = { (*np).agent_id.view() };
    // The native hatch wraps a widget its own op already identified; pass
    // role_none so the backend re-pins an explicit agent_id (if any) but leaves
    // the recorded affordance intact (see role_none). Every other kind records
    // its declared role.
    var role: u32 = role_for_kind(kind);
    if kind == kind_native() { role = role_none(); }
    f(r.ctx, handle, id, role);
    return;
}

fn mount_child_at(np: *Node, r: Renderer, idx: usize) -> flex::Node {
    match { (*np).children.at_ptr(idx) } {
        option::Option[*Node]::Some(cp) => { return mount(cp, r); }
        option::Option[*Node]::None => { return flex::Node::new(); }
    }
}

// Wrapper content: 0 kids → empty; 1 kid → that child; 2+ kids → portable
// column of all children (so bordered/clickable never silently drop extras).
fn mount_wrapper_content(np: *Node, r: Renderer) -> flex::Node {
    let cnt: usize = { (*np).children.count() };
    if cnt == (0 as usize) { return flex::Node::new(); }
    if cnt == (1 as usize) { return mount_child_at(np, r, 0 as usize); }
    var col: flex::Node = flex::Node::new();
    var i: usize = 0 as usize;
    while i < cnt {
        col.add_child(mount_child_at(np, r, i));
        i = i +% (1 as usize);
    }
    return col;
}

fn mount(np: *Node, r: Renderer) -> flex::Node {
    let k: u32 = { (*np).kind };
    var n: flex::Node = flex::Node::new();
    var is_widget: bool = false;
    if k == kind_label() {
        let f: fn(*u8, *Node) -> flex::Node = r.label;
        n = f(r.ctx, np);
        is_widget = true;
    } else if k == kind_wrap_label() {
        let f: fn(*u8, *Node) -> flex::Node = r.wrap_label;
        n = f(r.ctx, np);
        is_widget = true;
    } else if k == kind_button() {
        let f: fn(*u8, *Node) -> flex::Node = r.button;
        n = f(r.ctx, np);
        is_widget = true;
    } else if k == kind_text_area() {
        let f: fn(*u8, *Node) -> flex::Node = r.text_area;
        n = f(r.ctx, np);
        is_widget = true;
    } else if k == kind_composer() {
        let f: fn(*u8, *Node) -> flex::Node = r.composer;
        n = f(r.ctx, np);
        is_widget = true;
    } else if k == kind_image() {
        let f: fn(*u8, *Node) -> flex::Node = r.image;
        n = f(r.ctx, np);
        is_widget = true;
    } else if k == kind_symbol() {
        let f: fn(*u8, *Node) -> flex::Node = r.symbol;
        n = f(r.ctx, np);
        is_widget = true;
    } else if k == kind_text_field() {
        let f: fn(*u8, *Node) -> flex::Node = r.text_field;
        n = f(r.ctx, np);
        is_widget = true;
    } else if k == kind_popup() {
        let f: fn(*u8, *Node) -> flex::Node = r.popup;
        n = f(r.ctx, np);
        is_widget = true;
    } else if k == kind_divider() {
        let f: fn(*u8, *Node) -> flex::Node = r.divider;
        n = f(r.ctx, np);
        is_widget = true;
    } else if k == kind_toggle() {
        let f: fn(*u8, *Node) -> flex::Node = r.toggle;
        n = f(r.ctx, np);
        is_widget = true;
    } else if k == kind_slider() {
        let f: fn(*u8, *Node) -> flex::Node = r.slider;
        n = f(r.ctx, np);
        is_widget = true;
    } else if k == kind_progress() {
        let f: fn(*u8, *Node) -> flex::Node = r.progress;
        n = f(r.ctx, np);
        is_widget = true;
    } else if k == kind_stepper() {
        let f: fn(*u8, *Node) -> flex::Node = r.stepper;
        n = f(r.ctx, np);
        is_widget = true;
    } else if k == kind_secure_field() {
        let f: fn(*u8, *Node) -> flex::Node = r.secure_field;
        n = f(r.ctx, np);
        is_widget = true;
    } else if k == kind_segmented() {
        let f: fn(*u8, *Node) -> flex::Node = r.segmented;
        n = f(r.ctx, np);
        is_widget = true;
    } else if k == kind_color_picker() {
        let f: fn(*u8, *Node) -> flex::Node = r.color_picker;
        n = f(r.ctx, np);
        is_widget = true;
    } else if k == kind_date_picker() {
        let f: fn(*u8, *Node) -> flex::Node = r.date_picker;
        n = f(r.ctx, np);
        is_widget = true;
    } else if k == kind_search_field() {
        let f: fn(*u8, *Node) -> flex::Node = r.search_field;
        n = f(r.ctx, np);
        is_widget = true;
    } else if k == kind_combo_box() {
        let f: fn(*u8, *Node) -> flex::Node = r.combo_box;
        n = f(r.ctx, np);
        is_widget = true;
    } else if k == kind_token_field() {
        let f: fn(*u8, *Node) -> flex::Node = r.token_field;
        n = f(r.ctx, np);
        is_widget = true;
    } else if k == kind_box() {
        let f: fn(*u8, *Node) -> flex::Node = r.box;
        n = f(r.ctx, np);
        is_widget = true;
    } else if k == kind_gauge() {
        let f: fn(*u8, *Node) -> flex::Node = r.gauge;
        n = f(r.ctx, np);
        is_widget = true;
    } else if k == kind_path() {
        let f: fn(*u8, *Node) -> flex::Node = r.path;
        n = f(r.ctx, np);
        is_widget = true;
    } else if k == kind_native() {
        let f: fn(*u8, *Node) -> flex::Node = r.native;
        n = f(r.ctx, np);
        is_widget = true;
    } else if k == kind_window_buttons() {
        let f: fn(*u8, *Node) -> flex::Node = r.window_buttons;
        n = f(r.ctx, np);
        is_widget = true;
    } else if k == kind_bordered() {
        let content: flex::Node = mount_wrapper_content(np, r);
        let f: fn(*u8, *Node, take flex::Node) -> flex::Node = r.bordered;
        n = f(r.ctx, np, content);
        is_widget = true;
    } else if k == kind_clickable() {
        let content: flex::Node = mount_wrapper_content(np, r);
        let f: fn(*u8, *Node, take flex::Node) -> flex::Node = r.clickable;
        n = f(r.ctx, np, content);
        is_widget = true;
    } else if k == kind_scroll() {
        let content: flex::Node = mount_wrapper_content(np, r);
        let f: fn(*u8, *Node, take flex::Node) -> flex::Node = r.scroll;
        n = f(r.ctx, np, content);
        is_widget = true;
    } else if k == kind_material() {
        let content: flex::Node = mount_wrapper_content(np, r);
        let f: fn(*u8, *Node, take flex::Node) -> flex::Node = r.material;
        n = f(r.ctx, np, content);
        is_widget = true;
    } else if k == kind_window_drag() {
        let content: flex::Node = mount_wrapper_content(np, r);
        let f: fn(*u8, *Node, take flex::Node) -> flex::Node = r.window_drag;
        n = f(r.ctx, np, content);
        is_widget = true;
    } else if k == kind_split() {
        let first: flex::Node = mount_child_at(np, r, 0 as usize);
        let second: flex::Node = mount_child_at(np, r, 1 as usize);
        let f: fn(*u8, *Node, take flex::Node, take flex::Node) -> flex::Node = r.split;
        n = f(r.ctx, np, first, second);
        is_widget = true;
    } else if k == kind_spacer() {
        // pure layout; `_grow = 1` from the constructor applies below.
    } else if k == kind_zstack() {
        // Overlay: child 0 stays in flow (sizes the stack); children 1+ are
        // taken out of flow and pinned to the leading corner unless they
        // positioned themselves.
        let cnt: usize = { (*np).children.count() };
        for i in 0..(cnt as i32) {
            match { (*np).children.at_ptr(i as usize) } {
                option::Option[*Node]::Some(cp) => {
                    var cf: flex::Node = mount(cp, r);
                    if i >= (1 as i32) {
                        if { (*cp)._has_position_type } == false {
                            cf.set_position_type(flex::PositionType::Absolute);
                            if { (*cp)._inset_mask } == (0 as u32) {
                                cf.set_position(flex::Edge::Left, flex::StyleLength::points(0.0f64));
                                cf.set_position(flex::Edge::Top, flex::StyleLength::points(0.0f64));
                            }
                        }
                    }
                    n.add_child(cf);
                }
                option::Option[*Node]::None => { }
            }
        }
    } else if k == kind_grid() {
        // CSS grid: N equal (1fr) columns; children auto-flow into cells.
        n.set_display(flex::Display::Grid);
        var gc: i32 = { (*np).grid_cols };
        if gc < (1 as i32) { gc = 1 as i32; }
        var c: i32 = 0 as i32;
        while c < gc {
            n.add_grid_column(flex::GridTrack::fr(1.0f64));
            c = c + 1;
        }
        let cnt: usize = { (*np).children.count() };
        for i in 0..(cnt as i32) {
            match { (*np).children.at_ptr(i as usize) } {
                option::Option[*Node]::Some(cp) => { n.add_child(mount(cp, r)); }
                option::Option[*Node]::None => { }
            }
        }
    } else {
        if k == kind_row() { n.set_flex_direction(flex::FlexDirection::Row); }
        let cnt: usize = { (*np).children.count() };
        for i in 0..(cnt as i32) {
            match { (*np).children.at_ptr(i as usize) } {
                option::Option[*Node]::Some(cp) => { n.add_child(mount(cp, r)); }
                option::Option[*Node]::None => { }
            }
        }
    }
    if is_widget {
        call_set_identity(np, r, n.payload(), k);
    } else if is_container_kind(k) {
        // A container needs a backing view when it is KEYED (find(key) must
        // address it), when its Style operates on a view (a background has to
        // be painted ON something), or when it takes part in DRAG AND DROP —
        // a drop destination has to be a real view for the platform to find it,
        // and it has to be the CONTAINER so the search from a child reaches it.
        // The backend's container op applies the style to the view it creates.
        if { (*np).agent_id.view() } != "" || style_wants_view(np) || node_wants_drag_view(np) {
            let cf: fn(*u8, *Node, *flex::Node) = r.container;
            cf(r.ctx, np, #addr_of(n));
            if n.payload() != (0 as *u8) && { (*np).agent_id.view() } != "" {
                call_set_identity(np, r, n.payload(), k);
            }
        }
    }
    apply_layout_props(np, #addr_of(n));
    return n;
}

// Layout props — applied uniformly to the flex node at mount, whatever built
// it. Standalone so a retained-tree edit (a keyed-direct mutator) can re-apply
// a node's props onto the RETAINED flex node (the engine's snapshot cache
// detects which writes actually changed anything). Note: a prop that was set
// and becomes UNSET is not cleared here — the description model treats unset
// as "no opinion".
fn apply_layout_props(np: *Node, fp: *flex::Node) {
    if { (*np)._grow } > 0.0f64 { (*fp).set_flex_grow({ (*np)._grow }); }
    if { (*np)._gap } > 0.0f64 { (*fp).set_gap(flex::Gutter::All, { (*np)._gap }); }
    if { (*np)._padding } > 0.0f64 {
        (*fp).set_padding(flex::Edge::All, flex::StyleLength::points({ (*np)._padding }));
    }
    if { (*np)._width } >= 0.0f64 { (*fp).set_width(flex::StyleLength::points({ (*np)._width })); }
    if { (*np)._height } >= 0.0f64 { (*fp).set_height(flex::StyleLength::points({ (*np)._height })); }
    // Extended flexbox props (pass-through). Per-edge padding runs AFTER the
    // uniform `_padding` above, so a specific edge overrides it.
    if { (*np)._has_align_items } { (*fp).set_align_items({ (*np)._align_items }); }
    if { (*np)._has_align_self } { (*fp).set_align_self({ (*np)._align_self }); }
    if { (*np)._has_justify } { (*fp).set_justify_content({ (*np)._justify }); }
    if { (*np)._shrink } >= 0.0f64 { (*fp).set_flex_shrink({ (*np)._shrink }); }
    if { (*np)._min_w } >= 0.0f64 { (*fp).set_min_width(flex::StyleLength::points({ (*np)._min_w })); }
    if { (*np)._min_h } >= 0.0f64 { (*fp).set_min_height(flex::StyleLength::points({ (*np)._min_h })); }
    if { (*np)._max_w } >= 0.0f64 { (*fp).set_max_width(flex::StyleLength::points({ (*np)._max_w })); }
    if { (*np)._max_h } >= 0.0f64 { (*fp).set_max_height(flex::StyleLength::points({ (*np)._max_h })); }
    if { (*np)._pad_l } > 0.0f64 { (*fp).set_padding(flex::Edge::Left, flex::StyleLength::points({ (*np)._pad_l })); }
    if { (*np)._pad_t } > 0.0f64 { (*fp).set_padding(flex::Edge::Top, flex::StyleLength::points({ (*np)._pad_t })); }
    if { (*np)._pad_r } > 0.0f64 { (*fp).set_padding(flex::Edge::Right, flex::StyleLength::points({ (*np)._pad_r })); }
    if { (*np)._pad_b } > 0.0f64 { (*fp).set_padding(flex::Edge::Bottom, flex::StyleLength::points({ (*np)._pad_b })); }
    if { (*np)._basis } >= 0.0f64 { (*fp).set_flex_basis(flex::StyleLength::points({ (*np)._basis })); }
    if { (*np)._aspect } >= 0.0f64 { (*fp).set_aspect_ratio({ (*np)._aspect }); }
    if { (*np)._has_wrap } { (*fp).set_flex_wrap({ (*np)._wrap }); }
    if { (*np)._has_position_type } { (*fp).set_position_type({ (*np)._position_type }); }
    if { (*np)._mrg_l } > 0.0f64 { (*fp).set_margin(flex::Edge::Left, flex::StyleLength::points({ (*np)._mrg_l })); }
    if { (*np)._mrg_t } > 0.0f64 { (*fp).set_margin(flex::Edge::Top, flex::StyleLength::points({ (*np)._mrg_t })); }
    if { (*np)._mrg_r } > 0.0f64 { (*fp).set_margin(flex::Edge::Right, flex::StyleLength::points({ (*np)._mrg_r })); }
    if { (*np)._mrg_b } > 0.0f64 { (*fp).set_margin(flex::Edge::Bottom, flex::StyleLength::points({ (*np)._mrg_b })); }
    // Absolute insets — apply each masked edge (0 is a valid inset value).
    let im: u32 = { (*np)._inset_mask };
    if (im & (1 as u32)) != (0 as u32) { (*fp).set_position(flex::Edge::Left, flex::StyleLength::points({ (*np)._ins_l })); }
    if (im & (2 as u32)) != (0 as u32) { (*fp).set_position(flex::Edge::Top, flex::StyleLength::points({ (*np)._ins_t })); }
    if (im & (4 as u32)) != (0 as u32) { (*fp).set_position(flex::Edge::Right, flex::StyleLength::points({ (*np)._ins_r })); }
    if (im & (8 as u32)) != (0 as u32) { (*fp).set_position(flex::Edge::Bottom, flex::StyleLength::points({ (*np)._ins_b })); }
    // Percent size overrides the point size when set.
    if { (*np)._width_pct } >= 0.0f64 { (*fp).set_width(flex::StyleLength::percent({ (*np)._width_pct })); }
    if { (*np)._height_pct } >= 0.0f64 { (*fp).set_height(flex::StyleLength::percent({ (*np)._height_pct })); }
    // Per-gutter gap (distinct row/column) — overrides uniform gap for that axis.
    if { (*np)._gap_row } > 0.0f64 { (*fp).set_gap(flex::Gutter::Row, { (*np)._gap_row }); }
    if { (*np)._gap_col } > 0.0f64 { (*fp).set_gap(flex::Gutter::Column, { (*np)._gap_col }); }
    // Container props.
    if { (*np)._has_display } { (*fp).set_display({ (*np)._display }); }
    if { (*np)._has_z_index } { (*fp).set_z_index({ (*np)._z_index }); }
    if { (*np)._has_overflow } { (*fp).set_overflow({ (*np)._overflow }); }
    if { (*np)._has_align_content } { (*fp).set_align_content({ (*np)._align_content }); }
    if { (*np)._has_direction } { (*fp).set_direction({ (*np)._direction }); }
    if { (*np)._has_box_sizing } { (*fp).set_box_sizing({ (*np)._box_sizing }); }
    // Explicit flex-direction (e.g. RowReverse/ColumnReverse) overrides the kind.
    if { (*np)._has_flex_dir } { (*fp).set_flex_direction({ (*np)._flex_dir }); }
    // Grid child placement (set on the item; the grid container flows the rest).
    if { (*np)._grid_col_span } > (0 as i32) { (*fp).set_grid_column_span({ (*np)._grid_col_span }); }
    if { (*np)._grid_row_span } > (0 as i32) { (*fp).set_grid_row_span({ (*np)._grid_row_span }); }
    if { (*np)._grid_col_start } > (0 as i32) { (*fp).set_grid_column_start({ (*np)._grid_col_start }); }
    if { (*np)._grid_row_start } > (0 as i32) { (*fp).set_grid_row_start({ (*np)._grid_row_start }); }
    if { (*np)._grid_cols_subgrid } { (*fp).set_grid_columns_subgrid(true); }
    if { (*np)._grid_rows_subgrid } { (*fp).set_grid_rows_subgrid(true); }
    // Border-as-inset (reserves layout space, per edge).
    if { (*np)._bdr_l } > 0.0f64 { (*fp).set_border(flex::Edge::Left, flex::StyleLength::points({ (*np)._bdr_l })); }
    if { (*np)._bdr_t } > 0.0f64 { (*fp).set_border(flex::Edge::Top, flex::StyleLength::points({ (*np)._bdr_t })); }
    if { (*np)._bdr_r } > 0.0f64 { (*fp).set_border(flex::Edge::Right, flex::StyleLength::points({ (*np)._bdr_r })); }
    if { (*np)._bdr_b } > 0.0f64 { (*fp).set_border(flex::Edge::Bottom, flex::StyleLength::points({ (*np)._bdr_b })); }
    // Logical (direction-relative) padding/margin — flex resolves Start/End.
    if { (*np)._pad_start } > 0.0f64 { (*fp).set_padding(flex::Edge::Start, flex::StyleLength::points({ (*np)._pad_start })); }
    if { (*np)._pad_end } > 0.0f64 { (*fp).set_padding(flex::Edge::End, flex::StyleLength::points({ (*np)._pad_end })); }
    if { (*np)._mrg_start } > 0.0f64 { (*fp).set_margin(flex::Edge::Start, flex::StyleLength::points({ (*np)._mrg_start })); }
    if { (*np)._mrg_end } > 0.0f64 { (*fp).set_margin(flex::Edge::End, flex::StyleLength::points({ (*np)._mrg_end })); }
    return;
}

// ---- tests -------------------------------------------------------------------
// Pure C+ throughout — a fake Renderer stands in for a platform, so the whole
// description -> flex pipeline is testable everywhere. The literal `@facet`
// surface runs in src/test_main.cplus (a module cannot be its own context).

fn approx(a: f64, b: f64) -> bool {
    let d: f64 = a - b;
    if d < 0.0f64 { return (0.0f64 - d) < 0.01f64; }
    return d < 0.01f64;
}

#[test]
fn facet_leaf_ctors_set_kind_and_config() {
    let l: Node = label("Hello", size: 28.0f64, bold: true);
    assert l.kind == kind_label();
    assert approx(l.font_size, 28.0f64);
    assert l.bold;
    assert l.secondary == false;

    let b: Node = button("OK", primary: true);
    assert b.kind == kind_button();
    assert b.primary;

    let s: Node = spacer();
    assert s.kind == kind_spacer();
    assert approx(s._grow, 1.0f64);

    let ta: Node = text_area(value: "hi");
    assert ta.kind == kind_text_area();
    assert ta.value.view() == "hi";

}

#[test]
fn facet_presets_carry_hig_props() {
    var b: Builder = Builder::new();
    b.add(label("x"));
    let v: Node = vstack(b);
    assert v.kind == kind_column();
    assert approx(v._gap, 8.0f64);

    var cb: Builder = Builder::new();
    cb.add(label("y"));
    let c: Node = card(cb);
    assert approx(c._gap, 8.0f64);
    assert approx(c._padding, 16.0f64);

    var sb: Builder = Builder::new();
    sb.add(label("z"));
    let s: Node = screen(sb);
    assert approx(s._padding, 20.0f64);
}

#[test]
fn facet_builder_accumulates_and_finishes_as_column() {
    var b: Builder = Builder::new();
    b.add(label("A"));
    b.add(button("B"));
    let root: Node = b.finish();
    assert root.kind == kind_column();
    assert root.children.count() == (2 as usize);
}

fn click_a(sender: *u8, ctx: *u8) { return; }

#[test]
fn facet_modifiers_fluent_and_set_agree() {
    let f: Node = label("x").grow(2.0f64).padding(4.0f64).width(50.0f64);
    assert approx(f._grow, 2.0f64);
    assert approx(f._padding, 4.0f64);
    assert approx(f._width, 50.0f64);

    var m: Node = label("y");
    m.set_grow(2.0f64);
    m.set_padding(4.0f64);
    m.set_width(50.0f64);
    assert approx(m._grow, f._grow);
    assert approx(m._padding, f._padding);
    assert approx(m._width, f._width);
}

#[test]
fn facet_on_click_carries_identity() {
    let n: Node = button("del").on_click(click_a, ctx: 7 as *u8);
    assert n.click != noop;
    assert (n.click_ctx as i64) == (7 as i64);
    // ctx defaults to null when omitted.
    let m: Node = button("ok").on_click(click_a);
    assert (m.click_ctx as i64) == (0 as i64);
}

// The bound-method thunk ABI: a `composer(on_submit: X.method)` callsite emits
// a (sender, ctx) thunk with the receiver in the TRAILING ctx slot — the same
// order every control action and the composer delegate use. This test is the
// contract: if the thunk order ever flips, receivers arrive as garbage.
struct SubmitProbe { hits: i64, opaque seen: *u8 }
static SUBMIT_PROBE: SubmitProbe = #zero::[SubmitProbe]();
impl SubmitProbe {
    fn poke(ref this, sender: *u8) {
        this.hits = this.hits +% (1 as i64);
        this.seen = sender;
        return;
    }
}

#[test]
fn bound_submit_thunk_takes_sender_then_receiver() {
    SUBMIT_PROBE.hits = 0 as i64;
    let n: Node = composer(on_submit: SUBMIT_PROBE.poke);
    assert n.click_ctx == { #addr_of(SUBMIT_PROBE) as *u8 };   // ctx = the receiver
    let f: fn(*u8, *u8) = n.on_submit;
    f(5 as *u8, n.click_ctx);                                  // backend order: (sender, ctx)
    assert SUBMIT_PROBE.hits == (1 as i64);
    assert SUBMIT_PROBE.seen == (5 as *u8);
}

#[test]
fn facet_tooltip_and_a11y_label() {
    let n: Node = label("Save").tooltip("Save the file").accessibility_label("Save button");
    assert n.tooltip.view() == "Save the file";
    assert n.a11y_label.view() == "Save button";
    let plain: Node = label("x");
    assert plain.tooltip.view() == "";        // default none
    assert plain.a11y_label.view() == "";
}

#[test]
fn facet_new_kind_ctors_and_wrappers() {
    let c: Node = composer(on_submit: click_a, value: "draft", show_border: false);
    assert c.kind == kind_composer();
    assert c.on_submit != null_fn();
    assert c.value.view() == "draft";
    assert c.show_border == false;
    assert c.draws_background;  // default

    var bb: Builder = Builder::new();
    bb.add(label("in-box"));
    let br: Node = bordered(bb, radius: 8.0f64);
    assert br.kind == kind_bordered();
    assert approx(br.radius, 8.0f64);
    assert br.children.count() == (1 as usize);

    var cb: Builder = Builder::new();
    cb.add(label("row"));
    let cl: Node = clickable(cb, on_click: click_a, ctx: 3 as *u8);
    assert cl.kind == kind_clickable();
    assert cl.click != noop;
    assert (cl.click_ctx as i64) == (3 as i64);

    var sb: Builder = Builder::new();
    sb.add(label("left"));
    sb.add(label("right"));
    let sp: Node = split(sb, position: 180.0f64);
    assert sp.kind == kind_split();
    assert approx(sp.position, 180.0f64);
    assert sp.children.count() == (2 as usize);
}

#[test]
fn facet_role_for_kind_table() {
    assert role_for_kind(kind_button()) == role_button();
    assert role_for_kind(kind_clickable()) == role_button();
    assert role_for_kind(kind_label()) == role_text();
    assert role_for_kind(kind_wrap_label()) == role_text();
    assert role_for_kind(kind_composer()) == role_input();
    assert role_for_kind(kind_text_area()) == role_input();
    assert role_for_kind(kind_bordered()) == role_group();
    assert role_for_kind(kind_split()) == role_group();
}

#[test]
fn facet_text_area_code_editing_knobs() {
    // Defaults: wrapping, substitutions on, no gutter.
    let d: Node = text_area(value: "x");
    assert d.soft_wrap;
    assert d.smart_subs;
    assert d.line_numbers == false;
    // The code-editor configuration (a code editor is this text_area configured).
    let c: Node = text_area(value: "x", wrap: false, smart_substitutions: false, line_numbers: true);
    assert c.soft_wrap == false;
    assert c.smart_subs == false;
    assert c.line_numbers;
}

fn fake_key_of(sender: *u8) -> text::Text {
    if sender == (7 as *u8) { return text::from_str("tabs:tab:42"); }
    return text::new();
}

#[test]
fn key_of_defaults_empty_and_routes_through_backend() {
    // No backend installed: an owned empty Text, never a trap.
    let empty: text::Text = key_of(7 as *u8);
    assert empty.count() == (0 as usize);
    // Installed: the sender routes through; the handler gets an owned key.
    set_key_of_fn(fake_key_of);
    let k: text::Text = key_of(7 as *u8);
    assert k.equals("tabs:tab:42");
    let miss: text::Text = key_of(9 as *u8);
    assert miss.count() == (0 as usize);
    // Restore the uninstalled default so test order never matters.
    set_key_of_fn(0 as fn(*u8) -> text::Text);
}

fn fake_dropped_text(sender: *u8) -> text::Text {
    if sender == (7 as *u8) { return text::from_str("card:42"); }
    return text::new();
}

#[test]
fn dropped_text_defaults_empty_and_routes_through_backend() {
    let empty: text::Text = dropped_text(7 as *u8);
    assert empty.count() == (0 as usize);
    set_dropped_text_fn(fake_dropped_text);
    let payload: text::Text = dropped_text(7 as *u8);
    assert payload.equals("card:42");
    set_dropped_text_fn(0 as fn(*u8) -> text::Text);   // restore
}

fn fake_is_dark() -> bool { return true; }

#[test]
fn is_dark_defaults_false_and_routes_through_backend() {
    assert is_dark() == false;   // uninstalled: light is the neutral default
    set_is_dark_fn(fake_is_dark);
    assert is_dark();
    set_is_dark_fn(0 as fn() -> bool);   // restore
}

fn appearance_probe(ctx: *u8) {
    let c: *i64 = ctx as *i64;
    { *c = *c + (1 as i64); }
    return;
}

#[test]
fn appearance_change_notifies_the_registered_handler() {
    var fired: i64 = 0 as i64;
    notify_appearance_changed();                 // nothing registered: no-op
    assert fired == (0 as i64);
    on_appearance_change(appearance_probe, ctx: #addr_of(fired) as *u8);
    notify_appearance_changed();
    notify_appearance_changed();
    assert fired == (2 as i64);
    on_appearance_change(0 as fn(*u8));          // restore
}

#[test]
fn adaptive_color_tokens_are_distinct_and_set() {
    assert Color::text_tertiary().token == (9 as u32);
    assert Color::separator().token == (10 as u32);
    assert Color::window_background().token == (11 as u32);
    assert Color::under_page_background().token == (12 as u32);
    assert Color::control_background().token == (13 as u32);
    assert Color::fill().token == (14 as u32);
    assert Color::fill().is_set();
}

#[test]
fn facet_style_modifiers_set_only_their_field() {
    // blank starts fully unset — apply_style must skip everything.
    let plain: Node = label("x");
    assert plain.style.fg.is_set() == false;
    assert plain.style.bg.is_set() == false;
    assert approx(plain.style.corner_radius, 0.0f64);
    assert plain.style.weight == (0 as u32);

    // each modifier sets exactly its field, leaves the rest unset.
    let styled: Node = label("x")
        .foreground_color(Color::text_secondary())
        .background(Color::rgba(0.1f64, 0.2f64, 0.3f64, 1.0f64))
        .corner_radius(8.0f64);
    assert styled.style.fg.is_set();
    assert styled.style.fg.token == (2 as u32);      // secondary token
    assert styled.style.bg.token == (255 as u32);    // rgba token
    assert approx(styled.style.bg.b, 0.3f64);
    assert approx(styled.style.corner_radius, 8.0f64);
    assert styled.style.border_width < 0.001f64;     // untouched
    assert styled.style.weight == (0 as u32);        // untouched
}

#[test]
fn facet_font_and_frame_modifiers() {
    // .font/.weight/.strong/.monospaced ride the Style font channel.
    let a: Node = label("x").font(20.0f64).weight(weight_semibold());
    assert approx(a.style.font_size, 20.0f64);
    assert a.style.weight == weight_semibold();

    let b: Node = label("x").strong();
    assert b.style.weight == weight_bold();

    let c: Node = text_area(value: "y").monospaced();
    assert c.style.family == family_monospace();

    // .frame sets both fixed dimensions; fluent and set_* agree.
    let f: Node = label("x").frame(120.0f64, 44.0f64);
    assert approx(f._width, 120.0f64);
    assert approx(f._height, 44.0f64);
    var m: Node = label("x");
    m.set_frame(120.0f64, 44.0f64);
    assert approx(m._width, f._width);
    assert approx(m._height, f._height);
}

#[test]
fn facet_tier2_ctors_set_kind_and_config() {
    let im: Node = image("/tmp/logo.png");
    assert im.kind == kind_image();
    assert im.value.view() == "/tmp/logo.png";

    let sy: Node = symbol("folder", size: 20.0f64);
    assert sy.kind == kind_symbol();
    assert sy.value.view() == "folder";
    assert approx(sy.font_size, 20.0f64);

    let tf: Node = text_field(placeholder: "name", value: "iris");
    assert tf.kind == kind_text_field();
    assert tf.placeholder.view() == "name";
    assert tf.value.view() == "iris";

    var items: vec::Vec[text::Text] = vec::new::[text::Text]();
    items.append(text::from_str("One"));
    items.append(text::from_str("Two"));
    let pu: Node = popup(items, selected: 1 as i64);
    assert pu.kind == kind_popup();
    assert pu.popup_items.count() == (2 as usize);
    assert pu.popup_selected == (1 as i64);

    let dv: Node = divider();
    assert dv.kind == kind_divider();

    // menu is a pull-down popup (same kind, a variant — no new contract slot).
    var mitems: vec::Vec[text::Text] = vec::new::[text::Text]();
    mitems.append(text::from_str("Cut"));
    mitems.append(text::from_str("Copy"));
    let mn: Node = menu("Edit", mitems, on_change: click_a);
    assert mn.kind == kind_popup();
    assert mn.pull_down;
    assert mn.text.view() == "Edit";
    assert mn.on_change != null_fn();

    // Button folds: .plain() marks the borderless variant.
    let lb: Node = button("Docs").plain().foreground_color(Color::accent());
    assert lb.plain;
    assert lb.style.fg.token == (3 as u32);   // accent
}

#[test]
fn facet_tier2_roles() {
    assert role_for_kind(kind_text_field()) == role_input();
    assert role_for_kind(kind_popup()) == role_input();
    assert role_for_kind(kind_image()) == role_group();
    assert role_for_kind(kind_symbol()) == role_group();
    assert role_for_kind(kind_divider()) == role_group();
}

#[test]
fn on_key_rides_the_node_and_consume_is_one_shot() {
    let h: fn(*u8, *u8) = click_a;
    let n: Node = box().on_key(h, 0 as *u8);
    assert n.key_handler != null_fn();

    // consume_key() is read-and-cleared by the backend, so a handler that
    // consumes one event does not silently swallow the next.
    assert !take_key_consumed();
    consume_key();
    assert take_key_consumed();
    assert !take_key_consumed();

    // Modifier bits are distinct and testable through has_modifier.
    let both: u64 = mod_control() | mod_shift();
    assert has_modifier(both, mod_control());
    assert has_modifier(both, mod_shift());
    assert !has_modifier(both, mod_command());

    // With no backend installed the readers answer safely rather than trap.
    assert key_code(0 as *u8) == (-1 as i64);
    assert key_modifiers(0 as *u8) == (0 as u64);
    return;
}

#[test]
fn menu_extend_is_additive_and_screen_wins_on_key() {
    // The base app menu: what main declares for every screen.
    var base: AppMenu = empty_app_menu();
    base.add_item("Edit", "Undo", "z", menu_action_undo());
    base.add_item("Edit", "Copy", "c", menu_action_copy());
    base.add_command("File", "Close Window", "w", click_a);

    // A screen's contribution: one new item, one separator, and one item whose
    // key collides with the base's Close Window.
    var mine: vec::Vec[MenuItem] = vec::new::[MenuItem]();
    mine.append(MenuItem::new("File", "New File", key: "n", on_click: click_a));
    mine.append(MenuItem::separator("File"));
    mine.append(MenuItem::new("File", "Close Tab", key: "w", on_click: click_a));

    base.extend(mine);

    // ADDITIVE: the base's Edit family survives untouched.
    var undo: bool = false;
    var copy: bool = false;
    var new_file: bool = false;
    var sep: bool = false;
    var close_window: bool = false;
    var close_tab: bool = false;
    var i: usize = 0 as usize;
    while i < base.items.count() {
        match base.items.at_ptr(i) {
            option::Option[*MenuItem]::Some(p) => {
                if { (*p).title.equals("Undo") } { undo = true; }
                if { (*p).title.equals("Copy") } { copy = true; }
                if { (*p).title.equals("New File") } { new_file = true; }
                if { (*p).title.equals("Close Window") } { close_window = true; }
                if { (*p).title.equals("Close Tab") } { close_tab = true; }
                if { (*p).is_separator } { sep = true; }
            }
            option::Option[*MenuItem]::None => { }
        }
        i = i +% (1 as usize);
    }
    assert undo;
    assert copy;
    assert new_file;
    assert sep;                 // the rule came through
    assert close_tab;           // the screen's item is present
    assert !close_window;       // and it EVICTED the base item sharing ⌘W
    return;
}

#[test]
fn screen_box_without_a_contribution_merges_nothing() {
    // An invalid box (unknown route / failed allocation) must answer empty
    // rather than trap, so the host can merge unconditionally.
    let sb: ScreenBox = ScreenBox::invalid();
    assert sb.menu_items().count() == (0 as usize);

    var base: AppMenu = empty_app_menu();
    base.add_item("Edit", "Undo", "z", menu_action_undo());
    base.extend(sb.menu_items());
    assert base.items.count() == (1 as usize);
    return;
}

#[test]
fn facet_search_and_combo_ctors_set_kind_and_config() {
    let sf: Node = search_field(placeholder: "Filter", value: "main", on_search: click_a);
    assert sf.kind == kind_search_field();
    assert sf.placeholder.view() == "Filter";
    assert sf.value.view() == "main";
    assert sf.on_change != null_fn();

    var items: vec::Vec[text::Text] = vec::new::[text::Text]();
    items.append(text::from_str("Red"));
    items.append(text::from_str("Green"));
    items.append(text::from_str("Blue"));
    let cb: Node = combo_box(items, value: "Violet", on_change: click_a);
    assert cb.kind == kind_combo_box();
    assert cb.popup_items.count() == (3 as usize);
    // A combo box keeps a free value that is not one of its listed rows.
    assert cb.value.view() == "Violet";
    assert cb.on_change != null_fn();

    // Both are readable input affordances.
    assert role_for_kind(kind_search_field()) == role_input();
    assert role_for_kind(kind_combo_box()) == role_input();

    var toks: vec::Vec[text::Text] = vec::new::[text::Text]();
    toks.append(text::from_str("tag1"));
    toks.append(text::from_str("tag2"));
    let tk: Node = token_field(toks, on_change: click_a);
    assert tk.kind == kind_token_field();
    assert tk.popup_items.count() == (2 as usize);
    assert tk.on_change != null_fn();
    assert role_for_kind(kind_token_field()) == role_input();
}

#[test]
fn facet_native_hatch_carries_handle() {
    let n: Node = native(0xBEEF as *u8).frame(200.0f64, 120.0f64);
    assert n.kind == kind_native();
    assert (n.native_handle as i64) == (0xBEEF as i64);
    assert approx(n._width, 200.0f64);
    assert approx(n._height, 120.0f64);
    // A native leaf is observe-only for the agent surface.
    assert role_for_kind(kind_native()) == role_group();
}

#[test]
fn facet_flexbox_modifiers_set_fields() {
    let n: Node = label("x")
        .align_items(flex::Align::Center)
        .justify_content(flex::Justify::Center)
        .align_self(flex::Align::Stretch)
        .shrink(1.0f64)
        .min_width(0.0f64)
        .max_width(300.0f64)
        .padding_edge(flex::Edge::Right, 16.0f64);
    assert n._has_align_items;
    assert n._has_justify;
    assert n._has_align_self;
    assert approx(n._shrink, 1.0f64);
    assert approx(n._min_w, 0.0f64);     // 0 is a real value, not "unset"
    assert approx(n._max_w, 300.0f64);
    assert approx(n._pad_r, 16.0f64);
    // untouched fields stay at their sentinels / defaults.
    assert approx(n._min_h, -1.0f64);
    let plain: Node = label("y");
    assert plain._has_align_items == false;
    assert approx(plain._shrink, -1.0f64);

    // Edge::Horizontal sets both left and right; Vertical both top and bottom.
    let h: Node = label("z").padding_edge(flex::Edge::Horizontal, 8.0f64);
    assert approx(h._pad_l, 8.0f64);
    assert approx(h._pad_r, 8.0f64);
    assert approx(h._pad_t, 0.0f64);
}

