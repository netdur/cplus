// facet — the tree. HAND-WRITTEN; the generator never touches this file.
//
// facet's tree IS flex_layout's tree. A node's geometry, style and children
// are flex's; facet's per-node data rides in the owned attachment slot flex
// already releases for us. Nothing is stored twice.

import "flex_layout/flex_layout" as flex;
import "stdlib/text" as text;
import "stdlib/str" as _;
import "stdlib/option" as option;
import "stdlib/status" as status;
import "stdlib/box" as box;
import "stdlib/vec" as vec;
import "./props" as props;
import "./vocabulary" as vocab;

type Node = flex::Node;
type Frame = flex::Frame;
// What facet hangs off each flex node.
struct Data {
    // OWNED, not a `str` view. There are two kinds of key and they have
    // different lifetimes:
    //
    //   an ADDRESS — what `find("save")` resolves. The web calls this an id.
    //     Usually a literal, but not always: iris builds 25 of them by
    //     interpolation ("board:card:${id}").
    //   an IDENTITY — which row is which across insert, remove and reorder.
    //     ALWAYS computed, because it is derived from the data. `TreeNode.id`
    //     is one. When `list` and `collection` get theirs it is `id` too —
    //     NEVER `key`.
    //
    // The two look swapped if you come from the web, where `id` addresses and
    // `key` identifies a list row. The web is the outlier: SwiftUI has
    // `Identifiable.id`, UIKit has `ItemIdentifier`, RecyclerView has
    // `getItemId`. facet targets native, so identity is `id`.
    //
    // And `key` is not only facet's: a mounted node's key becomes the agent
    // surface's address AND the platform's accessibilityIdentifier. One token,
    // three jobs, one name.
    //
    // This is the address. It was `str`, which is a borrowed `{ptr, len}` —
    // sound for a literal, a use-after-free for anything computed, and the
    // borrow checker does not catch the escape across a call boundary
    // (verified: a `str` stored from a Text that then drops compiles, runs and
    // reads freed bytes). Interning was considered and rejected: it buys a
    // pointer-compare `find` at the cost of a global table, hashing, thread
    // safety and an eviction policy, none of which a correctness fix needs.
    key: text::Text,
    // Empty unless this node fills a parent's named slot. Owned for the same
    // reason `key` is: `set_slot` takes an arbitrary `str`, and a `str` field
    // outliving the bytes it views is a use-after-free the checker cannot see
    // through the raw-pointer store that writes it.
    slot: text::Text,
    kind: u32,              // which control — the tag the cast is checked against
    opaque props: *u8,      // owned *<Control>Props
    release: fn(*u8),       // frees `props` with the right type
    common: props::CommonProps,  // the band every node carries — inline
    opaque view: *u8,       // native view; 0 until a backend mounts it
    // M1: who releases the native view. `props` frees through `release`,
    // `gestures` through `gestures_release`; the view gets the same pair.
    // The backend sets both when it mounts (Renderer.view_release rides in
    // with the created view); node teardown then cannot leak the view.
    view_release: fn(*u8),
    // Did the APPLICATION supply this view, rather than the backend creating
    // one? `adopt_native` is the only thing that sets it, and the mount walk
    // reads it to leave such a view alone.
    //
    // Without the flag the walk cannot tell "the view a previous mount put
    // here" from "the view the caller brought", and it has to overwrite the
    // first — so it overwrote both, and every adopted native widget was
    // replaced by an empty container the instant it was mounted.
    view_adopted: bool,
    // The presentation this node (an outlet) is showing: the component's
    // address and its typed detach trampoline. NODE-scoped by design — the
    // record dies with its owner, evicts naturally on teardown, and cannot
    // collide across windows. 0 = nothing presented here.
    opaque presented: *u8,
    presented_detach: fn(*u8),
    // What `display` was before switch_to parked this node — so a Grid pane
    // is restored as Grid, not silently as Flex (review finding).
    parked_display: flex::Display,
    dirty: u64,             // props changed since the backend last synced
    // What the platform learns first. facet declares the reads; a backend
    // writes them through set_focused / set_attached / set_window.
    is_focused: bool,
    is_attached: bool,
    window: vocab::WindowRef,
    batch: i64,             // begin_updates depth; 0 means "flush on write"
    // Raw input, owned, NULL until a node asks for it — see gestures.cplus.
    // One pointer rather than 17 handlers inline, so a tree that uses no
    // gestures pays 16 bytes a node and never allocates.
    opaque gestures: *u8,
    gestures_release: fn(*u8),
    // What this node STANDS FOR, from the application's side: the row's record,
    // the card's model, whatever a handler shared across many nodes needs to
    // tell them apart. BORROWED — the application owns it and outlives the
    // node — so facet never frees it and never dereferences it.
    //
    // `component::item_of(sender)` is the read, and it existed before this
    // field did: the SenderReaders row was declared against a `.item(p)` verb
    // that was never built, so it could only ever answer null (Stage 4 item 4).
    opaque item: *u8,
}

// A gesture set changed. In the common band because gestures ride on Node,
// not on any one control. Bit 63 — the top of the word: bit 61 is the
// generated band's C_HANDLERS, and sharing it meant a backend could not tell
// "the gesture set was replaced" from "a focus/blur/attach/detach handler was
// swapped". The generator owns props.cplus, so the hand-written constant is
// the one that moves.
const C_GESTURES: u64 = 9223372036854775808u64;

// Keys beginning with `@` are facet's own: a named slot is a child under one.
// An application's key never starts with `@`, so the two spaces never meet.
const SLOT_PREFIX: str = "@";

fn no_release(p: *u8) { return; }

// flex calls this on node drop, on detach, and when an attach replaces it.
fn release_data(p: *u8) {
    if p == (0 as *u8) { return; }
    let d: *Data = p as *Data;
    let f: fn(*u8) = { (*d).release };
    if f != (0 as fn(*u8)) { f({ (*d).props }); }
    // The presented component (if any) learns its presentation ended.
    let pa: *u8 = { (*d).presented };
    if pa != (0 as *u8) {
        let pd: fn(*u8) = { (*d).presented_detach };
        if pd != (0 as fn(*u8)) { pd(pa); }
    }
    // M1: the native view, through the release the backend paired with it.
    let vp: *u8 = { (*d).view };
    if vp != (0 as *u8) {
        let vr: fn(*u8) = { (*d).view_release };
        if vr != (0 as fn(*u8)) { vr(vp); }
    }
    let gp: *u8 = { (*d).gestures };
    if gp != (0 as *u8) {
        let gr: fn(*u8) = { (*d).gestures_release };
        if gr != (0 as fn(*u8)) { gr(gp); }
    }
    let _b: box::Box[Data] = box::from_raw::[Data](p);
    return;
}

// A node with no control behind it: a container, a spacer, anything flex built.
// facet still needs Data on it — the shared band and gestures live there — so
// the kind says "no props" rather than the node having no Data at all.
const K_NODE: u32 = 0u32;

// Give `n` facet Data if it has none, and hand it back either way.
//
// Without this, every container was a silent no-op: `flex::column(b)` builds a
// node with nothing attached, so `set_opacity`, `set_visible` and `.gesture()`
// all found a null Data and returned. They reported success and did nothing.
fn ensure_data(n: *Node) -> *Data {
    if n == (0 as *Node) { return 0 as *Data; }
    let d: *Data = { (*n).data() };
    if d != (0 as *Data) { return d; }
    let fresh: Data = Data { key: text::new(), slot: text::new(), kind: K_NODE, props: 0 as *u8,
                             release: no_release, common: props::CommonProps::new(),
                             view: 0 as *u8, view_release: no_release,
                             view_adopted: false,
                             presented: 0 as *u8, presented_detach: no_release,
                             parked_display: flex::Display::Flex, dirty: 0u64,
                             is_focused: false, is_attached: false,
                             window: vocab::WindowRef::none(), batch: 0 as i64,
                             gestures: 0 as *u8, gestures_release: no_release,
                             item: 0 as *u8 };
    match box::new::[Data](fresh) {
        option::Option[box::Box[Data]]::Some(b) => { { (*n).attach(b.into_raw(), release_data) }; }
        option::Option[box::Box[Data]]::None => { }
    }
    return { (*n).data() };
}

// Build a node carrying `props` under `key`. The one place Data is created.
fn node_with(key: str, kind: u32, props_ptr: *u8, release: fn(*u8)) -> Node {
    var n: Node = flex::Node::new();
    let d: Data = Data { key: text::from_str(key), slot: text::new(), kind: kind, props: props_ptr,
                         release: release, common: props::CommonProps::new(),
                         view: 0 as *u8, view_release: no_release,
                         view_adopted: false,
                         presented: 0 as *u8, presented_detach: no_release,
                         parked_display: flex::Display::Flex, dirty: 0u64,
                         is_focused: false, is_attached: false,
                         window: vocab::WindowRef::none(), batch: 0 as i64,
                         gestures: 0 as *u8, gestures_release: no_release,
                         item: 0 as *u8 };
    match box::new::[Data](d) {
        option::Option[box::Box[Data]]::Some(b) => { n.attach(b.into_raw(), release_data); }
        option::Option[box::Box[Data]]::None => { }
    }
    return n;
}

impl flex::Node {
    // facet's data for this node, or null when it carries none.
    fn data(this) -> *Data {
        return match this.attachment() {
            option::Option[*u8]::Some(p) => p as *Data,
            option::Option[*u8]::None => 0 as *Data,
        };
    }

    // A view of the node's OWN bytes, so it lives exactly as long as the node.
    fn key(this) -> str {
        let d: *Data = this.data();
        if d == (0 as *Data) { return ""; }
        return { (*d).key.view() };
    }
}

// Mark a prop changed. The ONE seam from a setter to the backend: no
// per-verb function pointer, no registrar.
//
// M5: a write outside a batch requests a sync through the hook the mount
// module installs (the backend coalesces requests on its run loop); writes
// inside begin_updates/end_updates stay silent until the closing C_FLUSH
// touch lands at depth zero. M6: the tree is main-thread-owned — when a
// renderer is installed the write asserts it is on the thread that
// installed it, because a worker writing the tree is a data race that
// otherwise surfaces as a distant, unattributable crash.
static SYNC_REQUEST_FN: fn() = #zero::[fn()]();
fn set_sync_request_fn(f: fn()) { SYNC_REQUEST_FN = f; return; }

static MAIN_THREAD_ID: u64 = 0 as u64;
fn set_main_thread_id(id: u64) { MAIN_THREAD_ID = id; return; }

#[link_name = "pthread_self"]
extern fn pthread_self_raw() -> u64;

fn on_ui_thread() -> bool {
    if MAIN_THREAD_ID == (0 as u64) { return true; }
    return { pthread_self_raw() } == MAIN_THREAD_ID;
}

fn touch(n: *Node, bit: u64) {
    if n == (0 as *Node) { return; }
    let d: *Data = { (*n).data() };
    if d == (0 as *Data) { return; }
    assert on_ui_thread();
    { (*d).dirty = { (*d).dirty } | bit };
    if { (*d).batch } == (0 as i64) {
        let f: fn() = SYNC_REQUEST_FN;
        if f != (0 as fn()) { f(); }
    }
    return;
}

// Every bit at once: "re-read this node whole". The sync walk raises it on a
// host whose viewless child changed, because there is no bit for "a run
// changed" and the host is the only thing that can draw one. Not a setter's
// tool — a setter names the verb it wrote.
fn touch_all(n: *Node) {
    touch(n, 18446744073709551615u64);
    return;
}

// Backend/mount door: pair the native view with its release. Symmetric with
// `attach`'s (payload, release) — see M1 on the struct.
fn set_view(n: *Node, v: *u8, release: fn(*u8)) {
    let d: *Data = ensure_data(n);
    if d == (0 as *Data) { return; }
    { (*d).view = v };
    { (*d).view_release = release };
    return;
}

// Is this node's view one the APPLICATION brought? The mount walk asks before
// it creates anything, because an adopted view must survive being mounted.
fn view_is_adopted(n: *Node) -> bool {
    if n == (0 as *Node) { return false; }
    let d: *Data = { (*n).data() };
    if d == (0 as *Data) { return false; }
    return { (*d).view_adopted };
}

fn view_of(n: *Node) -> *u8 {
    if n == (0 as *Node) { return 0 as *u8; }
    let d: *Data = { (*n).data() };
    if d == (0 as *Data) { return 0 as *u8; }
    return { (*d).view };
}

// ---- shared-band handlers (Stage 3) -----------------------------------------
// The four handler pairs every node carries. Focus/blur are fired by the
// backend when the platform's focus moves; attach/detach are fired by the
// mount walk, post-walk (M4). Setters are live: a swap touches C_HANDLERS so
// a mounted backend re-reads.

// What this node stands for. Shared handlers are the whole point: one
// `on_click` over two hundred rows, each answering `component::item_of(sender)`
// with the record it was given.
//
// BORROWED, and the borrow is the application's to honour: facet stores the
// pointer, never frees it and never reads through it. Pass something that
// outlives the node — an element of a Vec the app owns, not a local.
//
// It rides C_HANDLERS rather than a bit of its own, and that is the honest
// place for it: the shared band is full at bits 48..63, and an item IS the
// payload half of a handler. A backend that re-reads its handlers on that bit
// re-reads the item with them.
fn set_item(n: *Node, p: *u8) {
    let d: *Data = ensure_data(n);
    if d == (0 as *Data) { return; }
    { (*d).item = p };
    touch(n, props::C_HANDLERS);
    return;
}

fn item_of(n: *Node) -> *u8 {
    let d: *Data = node_data(n);
    if d == (0 as *Data) { return 0 as *u8; }
    return { (*d).item };
}

// An INDEX in the item slot, for the commonest thing an app puts there: which
// row this node is. The slot is a borrowed `*u8` and an unset one reads null,
// so an index of 0 is indistinguishable from "nothing here" — every caller was
// storing `i + 1` and subtracting it back, an off-by-one written out in the
// application. The bias belongs here, once, behind a typed pair.
//
//     core::set_item_index(row, i);
//     match core::item_index_of(sender_node) {
//         option::Option[usize]::Some(i) => { ... }
//         option::Option[usize]::None => { }        // nothing was stored
//     }
//
// It is the same slot: a node carries an index or a record pointer, never
// both, and mixing them is a cast the reader cannot check.
fn set_item_index(n: *Node, at: usize) {
    set_item(n, { (at +% (1 as usize)) as *u8 });
    return;
}

fn item_index_of(n: *Node) -> option::Option[usize] {
    let raw: usize = item_of(n) as usize;
    if raw == (0 as usize) { return option::Option[usize]::None; }
    return option::Option[usize]::Some(raw -% (1 as usize));
}

fn set_on_focus(n: *Node, f: fn(*u8, *u8), ctx: *u8) {
    let d: *Data = ensure_data(n);
    if d == (0 as *Data) { return; }
    { (*d).common.on_focus = f };
    { (*d).common.on_focus_ctx = ctx };
    touch(n, props::C_HANDLERS);
    return;
}

fn set_on_blur(n: *Node, f: fn(*u8, *u8), ctx: *u8) {
    let d: *Data = ensure_data(n);
    if d == (0 as *Data) { return; }
    { (*d).common.on_blur = f };
    { (*d).common.on_blur_ctx = ctx };
    touch(n, props::C_HANDLERS);
    return;
}

fn set_on_attach(n: *Node, f: fn(*u8, *u8), ctx: *u8) {
    let d: *Data = ensure_data(n);
    if d == (0 as *Data) { return; }
    { (*d).common.on_attach = f };
    { (*d).common.on_attach_ctx = ctx };
    touch(n, props::C_HANDLERS);
    return;
}

fn set_on_detach(n: *Node, f: fn(*u8, *u8), ctx: *u8) {
    let d: *Data = ensure_data(n);
    if d == (0 as *Data) { return; }
    { (*d).common.on_detach = f };
    { (*d).common.on_detach_ctx = ctx };
    touch(n, props::C_HANDLERS);
    return;
}

// Fire helpers: sender is the node's native view (0 headless), ctx is what
// the handler bound. The mount walk uses attach/detach; a backend uses
// focus/blur from its first-responder observers.
fn fire_attach_handler(n: *Node) {
    let d: *Data = { (*n).data() };
    if d == (0 as *Data) { return; }
    let f: fn(*u8, *u8) = { (*d).common.on_attach };
    if f != (0 as fn(*u8, *u8)) && f != props::no_handler { f({ (*d).view }, { (*d).common.on_attach_ctx }); }
    return;
}

fn fire_detach_handler(n: *Node) {
    let d: *Data = { (*n).data() };
    if d == (0 as *Data) { return; }
    let f: fn(*u8, *u8) = { (*d).common.on_detach };
    if f != (0 as fn(*u8, *u8)) && f != props::no_handler { f({ (*d).view }, { (*d).common.on_detach_ctx }); }
    return;
}

// Does this node want to be told about focus changes? The backend asks before
// it decides whether to arm a view: a node with only an `on_focus` and no
// gestures still needs the class that reports one.
fn wants_focus_events(n: *Node) -> bool {
    let d: *Data = { (*n).data() };
    if d == (0 as *Data) { return false; }
    let f: fn(*u8, *u8) = { (*d).common.on_focus };
    let b: fn(*u8, *u8) = { (*d).common.on_blur };
    if f != (0 as fn(*u8, *u8)) && f != props::no_handler { return true; }
    if b != (0 as fn(*u8, *u8)) && b != props::no_handler { return true; }
    return false;
}

fn fire_focus_handler(n: *Node) {
    let d: *Data = { (*n).data() };
    if d == (0 as *Data) { return; }
    let f: fn(*u8, *u8) = { (*d).common.on_focus };
    if f != (0 as fn(*u8, *u8)) && f != props::no_handler { f({ (*d).view }, { (*d).common.on_focus_ctx }); }
    return;
}

fn fire_blur_handler(n: *Node) {
    let d: *Data = { (*n).data() };
    if d == (0 as *Data) { return; }
    let f: fn(*u8, *u8) = { (*d).common.on_blur };
    if f != (0 as fn(*u8, *u8)) && f != props::no_handler { f({ (*d).view }, { (*d).common.on_blur_ctx }); }
    return;
}

// The control kind tag — what a backend's create/apply dispatch on.
// K_NODE (0) is a bare container.
fn kind_of(n: *Node) -> u32 {
    if n == (0 as *Node) { return K_NODE; }
    let d: *Data = { (*n).data() };
    if d == (0 as *Data) { return K_NODE; }
    return { (*d).kind };
}

// The presentation pair (see the Data field): the presenting verb writes it,
// component_at reads it, teardown and eviction fire the trampoline.
fn set_presented(n: *Node, addr: *u8, detach: fn(*u8)) {
    let d: *Data = ensure_data(n);
    if d == (0 as *Data) { return; }
    { (*d).presented = addr };
    { (*d).presented_detach = detach };
    return;
}

fn presented_of(n: *Node) -> *u8 {
    if n == (0 as *Node) { return 0 as *u8; }
    let d: *Data = { (*n).data() };
    if d == (0 as *Data) { return 0 as *u8; }
    return { (*d).presented };
}

// Evict: notify through the trampoline, clear the record. True when
// something was presented.
fn evict_presented(n: *Node) -> bool {
    if n == (0 as *Node) { return false; }
    let d: *Data = { (*n).data() };
    if d == (0 as *Data) { return false; }
    let pa: *u8 = { (*d).presented };
    if pa == (0 as *u8) { return false; }
    let pd: fn(*u8) = { (*d).presented_detach };
    if pd != (0 as fn(*u8)) { pd(pa); }
    { (*d).presented = 0 as *u8 };
    { (*d).presented_detach = no_release };
    return true;
}

// switch_to's memory of a parked pane's display mode.
fn set_parked_display(n: *Node, d: flex::Display) {
    let dp: *Data = ensure_data(n);
    if dp == (0 as *Data) { return; }
    { (*dp).parked_display = d };
    return;
}

fn parked_display_of(n: *Node) -> flex::Display {
    if n == (0 as *Node) { return flex::Display::Flex; }
    let dp: *Data = { (*n).data() };
    if dp == (0 as *Data) { return flex::Display::Flex; }
    return { (*dp).parked_display };
}

// Take the node out of layout, or put it back. `set_visible` is the other half
// and they mean different things: visible hides the view and KEEPS its space
// (NSView.setHidden — the only thing facet could do before this), display
// removes the node from the layout pass entirely.
//
// It exists because `display` is the one layout property an application
// changes at runtime, and it was the only one with no facet verb: an app had
// to reach past facet into flex, where a setter raises no dirty bit, and then
// remember `relayout()` by hand. Every other runtime layout write —
// set_width, set_padding, set_grow — asks for the pass for you.
fn set_display(n: *Node, v: flex::Display) {
    if n == (0 as *Node) { return; }
    { (*n).set_display(v) };
    // The parked value follows a deliberate write, so `switch_to` re-attaching
    // a screen restores what the app last asked for rather than Flex.
    match v {
        flex::Display::None => { }
        _ => { set_parked_display(n, v); }
    }
    touch(n, props::C_LAYOUT);
    return;
}

// Is this node off screen? The OR of the two verbs that mean it: `set_visible`
// hides a node that KEEPS its space, `Display::None` removes it from layout.
// One rule, in the model, so two backends cannot disagree and two writers of
// the same platform flag cannot race each other.
fn is_hidden(n: *Node) -> bool {
    if n == (0 as *Node) { return false; }
    if is_visible(n) == false { return true; }
    return match { (*n).display() } {
        flex::Display::None => true,
        _ => false,
    };
}

fn display_of(n: *Node) -> flex::Display {
    if n == (0 as *Node) { return flex::Display::Flex; }
    return { (*n).display() };
}

// Show or hide in ONE verb, because an application that wants a panel gone
// almost always wants both halves: the view hidden and its space released.
// Restores whatever display the node last carried, so hiding a grid and
// showing it again does not silently turn it into a flex box.
fn set_shown(n: *Node, on: bool) {
    if n == (0 as *Node) { return; }
    set_visible(n, on);
    if on { set_display(n, parked_display_of(n)); }
    else { set_display(n, flex::Display::None); }
    return;
}

// The dirty word, read and cleared by the sync walk.
fn dirty_of(n: *Node) -> u64 {
    if n == (0 as *Node) { return 0 as u64; }
    let d: *Data = { (*n).data() };
    if d == (0 as *Data) { return 0 as u64; }
    return { (*d).dirty };
}

fn clear_dirty(n: *Node) {
    if n == (0 as *Node) { return; }
    let d: *Data = { (*n).data() };
    if d == (0 as *Data) { return; }
    { (*d).dirty = 0 as u64 };
    return;
}

// ---- the shared band --------------------------------------------------------
// The verbs every element carries live HERE, once, operating on Data.common.
// Each control cursor gets a generated one-line forward, so a call site is
// always typed (`b.set_opacity(...)` returns Button) and no generic element
// type exists anywhere in the package.
//
// The ledger's shared band is 41 rows; 36 are below and the 5 that are not are
// recorded in gen_contract.DEFERRED_SHARED with the reason. tools/gen_contract
// fails the run on a row that is in neither list.

// ---- the band writes through `ensure_data`, never past it --------------------
// A node built by the `@ui` DSL, or a raw `flex::Node`, carries no facet Data
// until something gives it one. Writers used to read `node_data` and return
// quietly on null, so `set_safe_area` on an @ui-rooted tree did nothing, said
// nothing, and cost two debugging rounds to find. `.gesture()` already refused
// to fail that way — "a modifier that does nothing is the exact failure this
// package is built against" — and the band now follows it.
//
// Readers still take `node_data`: a read has a right answer for a node with no
// Data (the default), and answering it should not allocate.

fn set_opacity(n: *Node, v: f64) {
    let d: *Data = ensure_data(n);
    if d == (0 as *Data) { return; }
    { (*d).common.opacity = v };
    touch(n, props::C_OPACITY);
    return;
}

fn opacity(n: *Node) -> f64 {
    let d: *Data = node_data(n);
    if d == (0 as *Data) { return 1.0f64; }
    return { (*d).common.opacity };
}

// A background IMAGE, the third thing that can be behind a node after a Color
// and a Brush. The ledger carries it on Page; facet carries it on every node,
// because a background belongs to whatever has one.
//
// It rides C_BACKGROUND rather than taking a bit of its own: "what is behind
// this node" is one question, and the backend re-reads the answer whole.
fn set_background_image(n: *Node, v: str) {
    let d: *Data = ensure_data(n);
    if d == (0 as *Data) { return; }
    { (*d).common.background_image = text::from_str(v) };
    touch(n, props::C_BACKGROUND);
    return;
}

fn background_image(n: *Node) -> str {
    let d: *Data = node_data(n);
    if d == (0 as *Data) { return ""; }
    return { (*d).common.background_image.view() };
}

// Whether this node keeps its content clear of the window's own chrome.
//
// `scroll` has carried one of these since Stage 2 and nothing else could,
// which is what left the ledger's three Page rows — ContainerArea,
// IgnoresContainerArea and ContentPage.SafeAreaEdges — with no carrier and no
// backend able to answer them. One node in a tree is the one that has to
// answer it, and the shared band is the only place that does not have to
// guess which.
//
// The write raises C_LAYOUT as well as its own bit: a safe-area inset is
// geometry, so the layout pass has to run again for it to mean anything.
fn set_safe_area(n: *Node, v: vocab::SafeArea) {
    let d: *Data = ensure_data(n);
    if d == (0 as *Data) { return; }
    { (*d).common.safe_area = v };
    touch(n, props::C_SAFE_AREA | props::C_LAYOUT);
    return;
}

fn safe_area(n: *Node) -> vocab::SafeArea {
    let d: *Data = node_data(n);
    if d == (0 as *Data) { return vocab::SafeArea::Default; }
    return { (*d).common.safe_area };
}

// Does this node's safe-area setting mean "keep clear"? `None` is the only
// answer that does not — the same reduction `scroll` makes, in one place so
// the two cannot disagree.
fn honours_safe_area(n: *Node) -> bool {
    return match safe_area(n) {
        vocab::SafeArea::None => false,
        vocab::SafeArea::Default => true,
        vocab::SafeArea::Container => true,
        vocab::SafeArea::Content => true,
        vocab::SafeArea::All => true,
    };
}

fn set_enabled(n: *Node, v: bool) {
    let d: *Data = ensure_data(n);
    if d == (0 as *Data) { return; }
    { (*d).common.is_enabled = v };
