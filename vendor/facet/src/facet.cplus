    FAKE_DATE_PICKERS = FAKE_DATE_PICKERS + 1;
    return flex::Node::new().width(120.0f64).height(24.0f64);
}

fn fake_box(ctx: *u8, np: *Node) -> flex::Node {
    FAKE_BOXES = FAKE_BOXES + 1;
    return flex::Node::new();
}

fn fake_gauge(ctx: *u8, np: *Node) -> flex::Node {
    FAKE_GAUGES = FAKE_GAUGES + 1;
    return flex::Node::new().width(100.0f64).height(20.0f64);
}

fn fake_path(ctx: *u8, np: *Node) -> flex::Node {
    FAKE_PATHS = FAKE_PATHS + 1;
    let w: f64 = { (*np)._width };
    let h: f64 = { (*np)._height };
    return flex::Node::new().width(w).height(h);
}

fn fake_native(ctx: *u8, np: *Node) -> flex::Node {
    FAKE_NATIVES = FAKE_NATIVES + 1;
    FAKE_LAST_NATIVE_HANDLE = { (*np).native_handle } as i64;
    return flex::Node::new().width(50.0f64).height(50.0f64);
}

fn fake_bordered(ctx: *u8, np: *Node, take content: flex::Node) -> flex::Node {
    FAKE_BORDEREDS = FAKE_BORDEREDS + 1;
    var n: flex::Node = flex::Node::new();
    n.add_child(content);
    return n;
}

fn fake_clickable(ctx: *u8, np: *Node, take content: flex::Node) -> flex::Node {
    FAKE_CLICKABLES = FAKE_CLICKABLES + 1;
    FAKE_LAST_CTX = { (*np).click_ctx } as i64;
    var n: flex::Node = flex::Node::new();
    n.add_child(content);
    return n;
}

fn fake_scroll(ctx: *u8, np: *Node, take content: flex::Node) -> flex::Node {
    FAKE_SCROLLS = FAKE_SCROLLS + 1;
    var n: flex::Node = flex::Node::new();
    n.add_child(content);
    return n;
}

fn fake_material(ctx: *u8, np: *Node, take content: flex::Node) -> flex::Node {
    FAKE_MATERIALS = FAKE_MATERIALS + 1;
    var n: flex::Node = flex::Node::new();
    n.add_child(content);
    return n;
}

fn fake_split(ctx: *u8, np: *Node, take first: flex::Node, take second: flex::Node) -> flex::Node {
    FAKE_SPLITS = FAKE_SPLITS + 1;
    var n: flex::Node = flex::Node::new();
    n.set_flex_direction(flex::FlexDirection::Row);
    n.add_child(first);
    n.add_child(second);
    return n;
}

fn fake_set_identity(ctx: *u8, handle: *u8, id: str, role: u32) {
    FAKE_IDENTITIES = FAKE_IDENTITIES + 1;
    FAKE_LAST_ROLE = role;
    // str has no .count in all contexts — compare empty by equality.
    if id != "" {
        FAKE_TAGGED_IDENTITIES = FAKE_TAGGED_IDENTITIES + 1;
        FAKE_LAST_ID_LEN = 1;  // non-empty marker
    }
    return;
}

fn fake_renderer() -> Renderer {
    return Renderer {
        ctx: 0 as *u8,
        label: fake_label,
        wrap_label: fake_label,
        button: fake_button,
        text_area: fake_text_area,
        composer: fake_composer,
        code_editor: fake_code_editor,
        image: fake_image,
        symbol: fake_symbol,
        text_field: fake_text_field,
        popup: fake_popup,
        divider: fake_divider,
        toggle: fake_toggle,
        slider: fake_slider,
        progress: fake_progress,
        stepper: fake_stepper,
        secure_field: fake_secure_field,
        segmented: fake_segmented,
        color_picker: fake_color_picker,
        date_picker: fake_date_picker,
        box: fake_box,
        gauge: fake_gauge,
        path: fake_path,
        native: fake_native,
        bordered: fake_bordered,
        clickable: fake_clickable,
        scroll: fake_scroll,
        material: fake_material,
        split: fake_split,
        set_identity: fake_set_identity,
    };
}

fn reset_fake_counts() {
    FAKE_LABELS = 0;
    FAKE_BUTTONS = 0;
    FAKE_TEXT_AREAS = 0;
    FAKE_COMPOSERS = 0;
    FAKE_CODE_EDITORS = 0;
    FAKE_IMAGES = 0;
    FAKE_SYMBOLS = 0;
    FAKE_TEXT_FIELDS = 0;
    FAKE_POPUPS = 0;
    FAKE_DIVIDERS = 0;
    FAKE_TOGGLES = 0;
    FAKE_SLIDERS = 0;
    FAKE_PROGRESSES = 0;
    FAKE_STEPPERS = 0;
    FAKE_SECURE_FIELDS = 0;
    FAKE_SEGMENTEDS = 0;
    FAKE_COLOR_PICKERS = 0;
    FAKE_DATE_PICKERS = 0;
    FAKE_BOXES = 0;
    FAKE_GAUGES = 0;
    FAKE_PATHS = 0;
    FAKE_NATIVES = 0;
    FAKE_LAST_NATIVE_HANDLE = 0;
    FAKE_BORDEREDS = 0;
    FAKE_CLICKABLES = 0;
    FAKE_SCROLLS = 0;
    FAKE_MATERIALS = 0;
    FAKE_SPLITS = 0;
    FAKE_IDENTITIES = 0;
    FAKE_TAGGED_IDENTITIES = 0;
    FAKE_LAST_CTX = 0;
    FAKE_LAST_ROLE = 0;
    FAKE_LAST_ID_LEN = 0;
    return;
}

#[test]
fn mount_dispatches_leaves_and_builds_containers() {
    reset_fake_counts();
    var b: Builder = Builder::new();
    b.add(label("t"));
    var inner: Builder = Builder::new();
    inner.add(button("ok").on_click(click_a, ctx: 9 as *u8));
    inner.add(spacer());
    inner.add(label("r"));
    b.add(hstack(inner));
    let root: Node = b.finish();

    var tree: flex::Node = mount(#addr_of(root), fake_renderer());
    assert FAKE_LABELS == 2;
    assert FAKE_BUTTONS == 1;
    assert FAKE_LAST_CTX == (9 as i64);   // the button op sees the identity
    assert tree.child_count() == (2 as usize);
    // 3 widget-producing nodes (2 labels + 1 button) each get set_identity.
    assert FAKE_IDENTITIES == 3;
}

#[test]
fn mount_dispatches_new_kinds_and_wrappers() {
    reset_fake_counts();
    var b: Builder = Builder::new();
    b.add(composer(on_submit: click_a, value: "x"));
    b.add(text_area(value: "y"));
    b.add(code_editor(value: "z"));
    var bb: Builder = Builder::new();
    bb.add(label("boxed"));
    b.add(bordered(bb));
    var cb: Builder = Builder::new();
    cb.add(button("go"));
    b.add(clickable(cb, on_click: click_a, ctx: 4 as *u8));
    var sb: Builder = Builder::new();
    sb.add(label("L"));
    sb.add(label("R"));
    b.add(split(sb));
    let root: Node = b.finish();

    var tree: flex::Node = mount(#addr_of(root), fake_renderer());
    assert FAKE_COMPOSERS == 1;
    assert FAKE_TEXT_AREAS == 1;
    assert FAKE_CODE_EDITORS == 1;
    assert FAKE_BORDEREDS == 1;
    assert FAKE_CLICKABLES == 1;
    assert FAKE_SPLITS == 1;
    assert FAKE_LAST_CTX == (4 as i64);
    // labels inside wrappers: boxed + L + R = 3; button inside clickable = 1
    assert FAKE_LABELS == 3;
    assert FAKE_BUTTONS == 1;
    // widget ops: composer, text_area, code_editor, bordered, clickable, split,
    // + 3 labels + 1 button = 10 set_identity calls
    assert FAKE_IDENTITIES == 10;
    assert tree.child_count() == (6 as usize);
}

#[test]
fn mount_dispatches_tier2_leaves() {
    reset_fake_counts();
    var items: vec::Vec[text::Text] = vec::new::[text::Text]();
    items.append(text::from_str("A"));
    items.append(text::from_str("B"));
    var b: Builder = Builder::new();
    b.add(image("/x.png"));
    b.add(symbol("gear"));
    b.add(text_field(placeholder: "search"));
    b.add(popup(items));
    b.add(divider());
    let root: Node = b.finish();

    let _tree: flex::Node = mount(#addr_of(root), fake_renderer());
    assert FAKE_IMAGES == 1;
    assert FAKE_SYMBOLS == 1;
    assert FAKE_TEXT_FIELDS == 1;
    assert FAKE_POPUPS == 1;
    assert FAKE_DIVIDERS == 1;
    // Each Tier-2 leaf is a widget → set_identity fires once per leaf.
    assert FAKE_IDENTITIES == 5;
}

#[test]
fn mount_dispatches_controls() {
