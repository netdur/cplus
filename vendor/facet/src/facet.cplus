#[test]
fn mount_dispatches_native_hatch() {
    reset_fake_counts();
    var b: Builder = Builder::new();
    b.add(label("header"));
    b.add(native(0xCAFE as *u8).grow(1.0f64));
    let root: Node = b.finish();

    let _tree: flex::Node = mount(#addr_of(root), fake_renderer());
    assert FAKE_NATIVES == 1;
    assert FAKE_LAST_NATIVE_HANDLE == (0xCAFE as i64);   // op saw the handle
    // label + native = 2 widget ops → 2 set_identity calls.
    assert FAKE_IDENTITIES == 2;
}

#[test]
fn mount_native_pins_id_but_not_affordance() {
    // The native hatch re-embeds an already-identified widget: set_identity is
    // still called (so an explicit agent_id is pinned) but with role_none, so the
    // backend leaves the widget's own affordance intact instead of stamping
    // group/none over it every re-render.
    reset_fake_counts();
    let n: Node = native(0xBEEF as *u8).agent_id("raw");
    let _tree: flex::Node = mount(#addr_of(n), fake_renderer());
    assert FAKE_IDENTITIES == 1;
    assert FAKE_TAGGED_IDENTITIES == 1;          // the id was pinned
    assert FAKE_LAST_ROLE == role_none();        // but no affordance recorded

    // Contrast: a real widget still records its declared role.
    reset_fake_counts();
    let lbl: Node = label("x");
    let _t2: flex::Node = mount(#addr_of(lbl), fake_renderer());
    assert FAKE_LAST_ROLE == role_text();
}

#[test]
fn mount_dispatches_scroll_wrapper() {
