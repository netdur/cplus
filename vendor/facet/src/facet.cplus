fn scale_y(n: *Node) -> f64 {
    let d: *Data = node_data(n);
    if d == (0 as *Data) { return 1.0f64; }
    return { (*d).common.scale_y };
}

fn set_translation_x(n: *Node, v: f64) {
    let d: *Data = node_data(n);
    if d == (0 as *Data) { return; }
    { (*d).common.translation_x = v };
    touch(n, props::C_TRANSFORM);
    return;
}

fn translation_x(n: *Node) -> f64 {
    let d: *Data = node_data(n);
    if d == (0 as *Data) { return 0.0f64; }
    return { (*d).common.translation_x };
}

fn set_translation_y(n: *Node, v: f64) {
    let d: *Data = node_data(n);
    if d == (0 as *Data) { return; }
    { (*d).common.translation_y = v };
    touch(n, props::C_TRANSFORM);
    return;
}

fn translation_y(n: *Node) -> f64 {
    let d: *Data = node_data(n);
    if d == (0 as *Data) { return 0.0f64; }
    return { (*d).common.translation_y };
}

fn set_anchor_x(n: *Node, v: f64) {
    let d: *Data = node_data(n);
    if d == (0 as *Data) { return; }
    { (*d).common.anchor_x = v };
    touch(n, props::C_TRANSFORM);
    return;
}

fn anchor_x(n: *Node) -> f64 {
    let d: *Data = node_data(n);
    if d == (0 as *Data) { return 0.5f64; }
    return { (*d).common.anchor_x };
}

fn set_anchor_y(n: *Node, v: f64) {
    let d: *Data = node_data(n);
    if d == (0 as *Data) { return; }
    { (*d).common.anchor_y = v };
    touch(n, props::C_TRANSFORM);
    return;
}

fn anchor_y(n: *Node) -> f64 {
    let d: *Data = node_data(n);
    if d == (0 as *Data) { return 0.5f64; }
    return { (*d).common.anchor_y };
}

// z order is flex's style field. Forward to it rather than keep a second copy
// that the layout engine would then have to be told about.
//
// C_LAYOUT, not a bit of its own: z is paint ORDER, and the walk that answers
// it is the same walk that answers geometry — a backend orders native
// siblings while it is placing them. It had the same hole as the size verbs
// (write the value, tell nobody).
fn set_z_index(n: *Node, v: i64) {
    if n == (0 as *Node) { return; }
    { (*n).set_z_index(v as i32) };
    touch(n, props::C_LAYOUT);
    return;
}

fn z_index(n: *Node) -> i64 {
    if n == (0 as *Node) { return 0 as i64; }
    return { (*n).z_index() } as i64;
}

// ---- live layout ------------------------------------------------------------
// flex's own fluent modifiers (`.width(120.0)`, `.padding(8.0)`) take `this`
// BY VALUE, so they belong to the description and cannot be called through a
// cursor's pointer. These are the same words as live setters.
//
// The names are flex's, deliberately: this is not a second layout vocabulary,
// it is the same one reachable after mount. Anything not here — per-edge
// padding, grid, position type, breakpoints — is reached with `node()`, which
// every cursor has.
//
// ONE TRAP, and it is the same one the DOM has with `style.width` versus
// `offsetWidth`: `set_width` writes the STYLE, `width()` reads the LAID-OUT
// frame. They agree only after a layout pass.
//
// Every one of these touches props::C_LAYOUT. They did not, and that was the
// hole: a prop setter marks its node dirty, the dirty mark wakes the backend
// through M5, and the backend applies it — but a size write did neither, so
// `sidebar.set_width(300.0)` in a click handler updated flex's style and
// reached no screen. The bit says GEOMETRY, not props: the backend answers it
// with one layout pass per window and a frame walk, never with a re-read of
// this node's props.
//
// This is what the retained-relayout work (9a54a0b) is built on and it costs
// nothing when nothing moved: flex's incremental cache skips unchanged
// subtrees, and the frame walk prunes itself on `Node::layout_changed()`.
// Waking on the write is the point — polling a layout pass every idle turn
// would pay that cost forever instead of only when something actually moved.

fn set_grow(n: *Node, v: f64) {
    if n == (0 as *Node) { return; }
    { (*n).set_flex_grow(v) };
    touch(n, props::C_LAYOUT);
    return;
}

fn set_shrink(n: *Node, v: f64) {
    if n == (0 as *Node) { return; }
    { (*n).set_flex_shrink(v) };
    touch(n, props::C_LAYOUT);
    return;
}

fn set_width(n: *Node, v: f64) {
    if n == (0 as *Node) { return; }
    { (*n).set_width(flex::StyleLength::points(v)) };
    touch(n, props::C_LAYOUT);
    return;
}

fn set_height(n: *Node, v: f64) {
    if n == (0 as *Node) { return; }
    { (*n).set_height(flex::StyleLength::points(v)) };
    touch(n, props::C_LAYOUT);
    return;
}

fn set_width_percent(n: *Node, v: f64) {
    if n == (0 as *Node) { return; }
    { (*n).set_width(flex::StyleLength::percent(v)) };
    touch(n, props::C_LAYOUT);
    return;
}

fn set_height_percent(n: *Node, v: f64) {
    if n == (0 as *Node) { return; }
    { (*n).set_height(flex::StyleLength::percent(v)) };
    touch(n, props::C_LAYOUT);
    return;
}

fn set_padding(n: *Node, v: f64) {
    if n == (0 as *Node) { return; }
    { (*n).set_padding(flex::Edge::All, flex::StyleLength::points(v)) };
    touch(n, props::C_LAYOUT);
    return;
}

fn set_margin(n: *Node, v: f64) {
    if n == (0 as *Node) { return; }
    { (*n).set_margin(flex::Edge::All, flex::StyleLength::points(v)) };
    touch(n, props::C_LAYOUT);
    return;
}

fn set_gap(n: *Node, v: f64) {
    if n == (0 as *Node) { return; }
    { (*n).set_gap(flex::Gutter::All, flex::StyleLength::points(v)) };
    touch(n, props::C_LAYOUT);
    return;
}

fn set_justify(n: *Node, v: flex::Justify) {
    if n == (0 as *Node) { return; }
    { (*n).set_justify_content(v) };
    touch(n, props::C_LAYOUT);
    return;
}

fn set_align(n: *Node, v: flex::Align) {
    if n == (0 as *Node) { return; }
    { (*n).set_align_items(v) };
    touch(n, props::C_LAYOUT);
    return;
}

fn set_wrap(n: *Node, v: flex::Wrap) {
    if n == (0 as *Node) { return; }
    { (*n).set_flex_wrap(v) };
    touch(n, props::C_LAYOUT);
    return;
}

// ---- reads flex already owns: forward, store nothing -------------------------
fn frame_of(n: *Node) -> Frame { return { (*n).frame() }; }
fn width_of(n: *Node) -> f64 { return { (*n).frame() }.width; }
fn height_of(n: *Node) -> f64 { return { (*n).frame() }.height; }
fn x_of(n: *Node) -> f64 { return { (*n).frame() }.left; }
fn y_of(n: *Node) -> f64 { return { (*n).frame() }.top; }
fn child_count_of(n: *Node) -> usize { return { (*n).child_count() }; }

fn bounds_of(n: *Node) -> vocab::Rect {
    let f: Frame = { (*n).frame() };
    return vocab::Rect { x: f.left, y: f.top, width: f.width, height: f.height };
}

fn child_of(n: *Node, at: usize) -> option::Option[*Node] {
    if n == (0 as *Node) { return option::Option[*Node]::None; }
    return { (*n).child_ptr(at) };
}

// ---- what the platform learns first -----------------------------------------
// facet declares the read; a backend writes it. These three setters are the
// write path back into a node's state, and the only ones a backend needs.

fn is_focused(n: *Node) -> bool {
    let d: *Data = node_data(n);
    if d == (0 as *Data) { return false; }
    return { (*d).is_focused };
}

fn set_focused(n: *Node, v: bool) {
    let d: *Data = node_data(n);
    if d == (0 as *Data) { return; }
    { (*d).is_focused = v };
    return;
}

fn is_attached(n: *Node) -> bool {
    let d: *Data = node_data(n);
    if d == (0 as *Data) { return false; }
    return { (*d).is_attached };
}

fn set_attached(n: *Node, v: bool) {
    let d: *Data = node_data(n);
    if d == (0 as *Data) { return; }
    { (*d).is_attached = v };
    return;
}

fn window_of(n: *Node) -> vocab::WindowRef {
    let d: *Data = node_data(n);
    if d == (0 as *Data) { return vocab::WindowRef::none(); }
    return { (*d).window };
}

fn set_window(n: *Node, w: vocab::WindowRef) {
    let d: *Data = node_data(n);
    if d == (0 as *Data) { return; }
    { (*d).window = w };
    return;
}

// The escape hatch INTENT blesses: the platform's own view, or 0 while the
// node is unmounted. The one verb in facet that names a backend.
fn native(n: *Node) -> *u8 {
    let d: *Data = node_data(n);
    if d == (0 as *Data) { return 0 as *u8; }
    return { (*d).view };
}

fn set_native(n: *Node, v: *u8) {
    let d: *Data = node_data(n);
    if d == (0 as *Data) { return; }
    { (*d).view = v };
    return;
}

// ---- commands ---------------------------------------------------------------
// Same shape as a setter: write, set a bit, let the backend act on it. No
// verb-indexed table, no registrar.

fn focus(n: *Node) { touch(n, props::C_FOCUS); return; }
fn blur(n: *Node) { touch(n, props::C_BLUR); return; }

// Invalidate this subtree's cached layout. flex recomputes on the next pass,
// and C_LAYOUT is what asks for that pass to happen — without it the
// invalidation sat in the tree until some unrelated write woke the backend.
fn relayout(n: *Node) {
    if n == (0 as *Node) { return; }
    { (*n).mark_content_changed() };
    touch(n, props::C_LAYOUT);
    return;
}

// Lay the subtree out under these constraints and report the size it wants.
// This IS a layout pass, so the frames it leaves behind are the measurement's:
// the next real pass overwrites them.
fn measure(n: *Node, width: f64, height: f64) -> vocab::Size {
    if n == (0 as *Node) { return vocab::Size::zero(); }
    { (*n).calculate_layout(width: width, height: height) };
    let f: Frame = { (*n).frame() };
    return vocab::Size { width: f.width, height: f.height };
}

// Coalesce writes. The backend syncs when the depth returns to zero.
fn begin_updates(n: *Node) {
    let d: *Data = node_data(n);
    if d == (0 as *Data) { return; }
    { (*d).batch = { (*d).batch } +% (1 as i64) };
    return;
}

fn end_updates(n: *Node) {
    let d: *Data = node_data(n);
    if d == (0 as *Data) { return; }
    let depth: i64 = { (*d).batch };
    if depth <= (0 as i64) { { (*d).batch = 0 as i64 }; return; }
    { (*d).batch = depth -% (1 as i64) };
    if { (*d).batch } == (0 as i64) { touch(n, props::C_FLUSH); }
    return;
}

fn is_batching(n: *Node) -> bool {
    let d: *Data = node_data(n);
    if d == (0 as *Data) { return false; }
    return { (*d).batch } > (0 as i64);
}

// ---- slots ------------------------------------------------------------------
// A subtree is a CHILD, not a property. MAUI models a named subtree as a
// bindable property because binding is how it fills one; facet describes a
// tree, so a header IS a child — under a reserved `@` key, so the slot can be
// replaced in place without disturbing its siblings.

// A slot is recorded on the CHILD, in its own field, not by overwriting the
// key: the application named that node and must keep being able to find it.
fn slot_of(n: *Node) -> str {
    let d: *Data = node_data(n);
    if d == (0 as *Data) { return ""; }
    return { (*d).slot.view() };
}

fn _mark_slot(n: *Node, name: str) {
    let d: *Data = node_data(n);
    if d == (0 as *Data) { return; }
    { (*d).slot = text::from_str(name) };
    return;
}

// Index of the child in `name`'s slot, or child_count() when the slot is empty.
fn _slot_index(n: *Node, name: str) -> usize {
    let count: usize = { (*n).child_count() };
    var i: usize = 0 as usize;
    while i < count {
        match { (*n).child_ptr(i) } {
            option::Option[*Node]::Some(c) => {
                if slot_of(c) == name { return i; }
            }
            option::Option[*Node]::None => { }
        }
        i = i +% (1 as usize);
    }
    return count;
}

fn set_slot(n: *Node, name: str, take child: Node) {
    if n == (0 as *Node) { return; }
    let count: usize = { (*n).child_count() };
    let at: usize = _slot_index(n, name);
    // An allocation can fail. Only mark the slot when the child really landed
    // at `at` — otherwise the node already there would answer to a name that
    // is not its own.
    var placed: bool = false;
    if at < count {
        let _old: option::Option[Node] = { (*n).remove_child(at) };
        placed = { (*n).insert_child(child, at: at) }.is_ok();
    } else {
        placed = { (*n).add_child(child) }.is_ok();
    }
    if !placed { return; }
    match { (*n).child_ptr(at) } {
        option::Option[*Node]::Some(c) => { _mark_slot(c, name); }
        option::Option[*Node]::None => { }
    }
    return;
}

fn slot(n: *Node, name: str) -> option::Option[*Node] {
    if n == (0 as *Node) { return option::Option[*Node]::None; }
    let at: usize = _slot_index(n, name);
    if at >= { (*n).child_count() } { return option::Option[*Node]::None; }
    return { (*n).child_ptr(at) };
}

// Detach the child in a slot and hand the subtree back.
fn take_slot(n: *Node, name: str) -> option::Option[Node] {
    if n == (0 as *Node) { return option::Option[Node]::None; }
    let at: usize = _slot_index(n, name);
    if at >= { (*n).child_count() } { return option::Option[Node]::None; }
    return { (*n).remove_child(at) };
}

// Does this name belong to facet rather than to the application?
fn is_slot_name(name: str) -> bool { return name.has_prefix(SLOT_PREFIX); }

// A free-fn twin of Node::data, callable where a method on *Node is not.
fn node_data(n: *Node) -> *Data {
    if n == (0 as *Node) { return 0 as *Data; }
    return { (*n).data() };
}

// Depth-first search for a key. Returns a cursor: flex node addresses are
// stable, so this stays valid until its node or an ancestor is removed.
fn find_in(n: *Node, key: str) -> option::Option[*Node] {
    if n == (0 as *Node) { return option::Option[*Node]::None; }
    if { (*n).key() } == key { return option::Option[*Node]::Some(n); }
    let count: usize = { (*n).child_count() };
    var i: usize = 0 as usize;
    while i < count {
        match { (*n).child_ptr(i) } {
            option::Option[*Node]::Some(c) => {
                match find_in(c, key) {
                    option::Option[*Node]::Some(hit) => { return option::Option[*Node]::Some(hit); }
                    option::Option[*Node]::None => { }
                }
            }
            option::Option[*Node]::None => { }
        }
        i = i +% (1 as usize);
    }
    return option::Option[*Node]::None;
}

// ---- containers -------------------------------------------------------------
// flex already owns these: Builder, column, row, hstack, vstack, screen, card,
// box, and the HIG spacing constants. facet does not reimplement them, it
// re-exports them so an application imports facet alone.

type Builder = flex::Builder;

// flex builds the node; facet attaches its Data. Both halves are required: a
// container that carries no Data answers no shared-band verb and takes no
// gesture, and does so in silence.
fn _own(take n: Node, key: str) -> Node {
    var m: Node = n;
    let d: *Data = ensure_data(#addr_of(m));
    if d != (0 as *Data) { { (*d).key = text::from_str(key) }; }
    return m;
}

fn column(take b: Builder, key: str = "") -> Node { return _own(flex::column(b), key); }
fn row(take b: Builder, key: str = "") -> Node { return _own(flex::row(b), key); }
fn hstack(take b: Builder, key: str = "") -> Node { return _own(flex::hstack(b), key); }
fn vstack(take b: Builder, key: str = "") -> Node { return _own(flex::vstack(b), key); }
fn screen(take b: Builder, key: str = "") -> Node { return _own(flex::screen(b), key); }
fn card(take b: Builder, key: str = "") -> Node { return _own(flex::card(b), key); }

fn spacer(key: str = "") -> Node { return _own(flex::spacer(), key); }
fn zstack(take b: Builder, key: str = "") -> Node { return _own(flex::zstack(b), key); }
