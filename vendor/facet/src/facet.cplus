#[test]
fn mount_set_identity_fires_once_per_tagged_widget() {
    reset_fake_counts();
    var b: Builder = Builder::new();
    b.add(label("untagged"));
    b.add(button("save").agent_id("save-btn"));
    b.add(composer(on_submit: click_a).agent_id("chat-input"));
    let root: Node = b.finish();

    let _tree: flex::Node = mount(#addr_of(root), fake_renderer());
    // All three widgets get set_identity; two carry a non-empty agent_id.
    assert FAKE_IDENTITIES == 3;
    assert FAKE_TAGGED_IDENTITIES == 2;
    // Last tagged widget is the composer → role_input.
    assert FAKE_LAST_ROLE == role_input();
    assert FAKE_LAST_ID_LEN == 1;
}

#[test]
fn mount_applies_layout_props_and_lays_out() {
    // row [ label 40x10, spacer, button 60x20 ] in 200pt: the spacer absorbs
    // 100pt, the button ends at the right edge.
    var inner: Builder = Builder::new();
    inner.add(label("t"));
    inner.add(spacer());
    inner.add(button("ok"));
    var b: Builder = Builder::new();
    b.add(row(inner));
    let root: Node = b.finish();

    var tree: flex::Node = mount(#addr_of(root), fake_renderer());
    tree.calculate_layout(200.0f64, 40.0f64, flex::Direction::LTR);
    match tree.children.at_ptr(0 as usize) {
        option::Option[*flex::Node]::Some(rp) => {
            let bf: flex::Layout = must_layout({ (*rp).child_layout(2 as usize) });
            assert approx(bf.left, 140.0f64);   // 200 - 60
            assert approx(bf.width, 60.0f64);
            let sf: flex::Layout = must_layout({ (*rp).child_layout(1 as usize) });
            assert approx(sf.width, 100.0f64);  // spacer absorbed the slack
        }
        option::Option[*flex::Node]::None => { assert false; }
    };
}

#[test]
fn mount_applies_flexbox_align_and_edge_padding() {
    // A 100-tall row with align_items Center + padding-left 20, holding one
    // 60x20 button: the button centers on the cross (vertical) axis → top 40,
    // and the edge padding pushes its left to 20. Proves the new pass-throughs
    // reach flex_layout and compute.
    var inner: Builder = Builder::new();
    inner.add(button("ok"));   // fake_button = 60x20
    var b: Builder = Builder::new();
    b.add(row(inner)
        .height(100.0f64)
        .align_items(flex::Align::Center)
        .padding_edge(flex::Edge::Left, 20.0f64));
    let root: Node = b.finish();

    var tree: flex::Node = mount(#addr_of(root), fake_renderer());
    tree.calculate_layout(200.0f64, flex::undefined(), flex::Direction::LTR);
    match tree.children.at_ptr(0 as usize) {
        option::Option[*flex::Node]::Some(rp) => {
            let bf: flex::Layout = must_layout({ (*rp).child_layout(0 as usize) });
            assert approx(bf.top, 40.0f64);    // (100 - 20) / 2, centered
            assert approx(bf.left, 20.0f64);   // padding-left inset
        }
        option::Option[*flex::Node]::None => { assert false; }
    };
}

#[test]
fn facet_p1_layout_modifiers_set_fields() {
    let n: Node = label("x")
        .flex_basis(50.0f64)
        .aspect_ratio(1.5f64)
        .flex_wrap(flex::Wrap::Wrap)
        .margin(8.0f64)
        .position_absolute()
        .inset(flex::Edge::Top, 0.0f64);
    assert approx(n._basis, 50.0f64);
    assert approx(n._aspect, 1.5f64);
    assert n._has_wrap;
    assert approx(n._mrg_l, 8.0f64);
    assert approx(n._mrg_b, 8.0f64);
    assert n._has_position_type;
    // inset(Top, 0) must register even though the value is 0 (mask bit set).
    assert (n._inset_mask & (2 as u32)) != (0 as u32);
    assert approx(n._ins_t, 0.0f64);
}

#[test]
fn facet_paint_modifiers_set_fields() {
    let n: Node = label("x").opacity(0.5f64).shadow(6.0f64).line_limit(2 as i32).text_align(text_center());
    assert approx(n.style.opacity, 0.5f64);
    assert approx(n.style.shadow_radius, 6.0f64);
    assert n.style.line_limit == (2 as i32);
    assert n.style.text_align == text_center();
    assert approx(label("z").fade_in(0.3f64).style.fade_in, 0.3f64);
    assert approx(label("z").style.fade_in, 0.0f64);   // default: no entrance
    // Path builder records one segment per call, in order, and carries fill/stroke.
    let pth: Node = path(100.0f64, 80.0f64)
        .move_to(0.0f64, 0.0f64)
        .line_to(100.0f64, 0.0f64)
        .quad_to(100.0f64, 80.0f64, 0.0f64, 80.0f64)
        .curve_to(10.0f64, 10.0f64, 20.0f64, 20.0f64, 0.0f64, 40.0f64)
        .close_path()
        .background(Color::accent())
        .border(2.0f64, Color::text());
    assert pth.kind == kind_path();
    assert pth.path_cmds.count() == (5 as usize);
    assert approx(fixed_width(#addr_of(pth)), 100.0f64);
    assert approx(fixed_height(#addr_of(pth)), 80.0f64);
    assert pth.style.bg.token == Color::accent().token;
    assert approx(pth.style.border_width, 2.0f64);
    assert label("z").hidden().style.hidden;
    assert label("z").style.hidden == false;   // default visible
    assert label("z").italic().style.italic;
    assert label("z").style.italic == false;    // default upright
    assert label("z").clip().style.clip;
    assert label("z").style.clip == false;      // default unclipped
    assert label("z").underline().style.underline;
    assert label("z").style.underline == false;  // default no underline
    assert label("z").truncate().style.truncate;
    assert label("z").style.truncate == false;   // default: clip, don't ellipsize
    { var m: Node = label("z"); m.set_truncate(true); assert m.style.truncate; }
    let g: Node = box().gradient(Color::system_blue(), Color::system_green());
    assert g.style.grad_from.is_set();
    assert g.style.grad_to.token == (5 as u32);   // system_green
    assert box().style.grad_from.is_set() == false;   // default no gradient
    // gradient direction: default Vertical; an explicit diagonal is recorded.
    match g.style.grad_dir { GradientDir::Vertical => { } _ => { assert false; } }
    let gd: Node = box().gradient(Color::system_blue(), Color::system_green(), GradientDir::DiagonalTLBR);
    match gd.style.grad_dir { GradientDir::DiagonalTLBR => { } _ => { assert false; } }
    let tr: Node = box().rotation(45.0f64).scale(1.5f64);
    assert approx(tr.style.rotation, 45.0f64);
    assert approx(tr.style.scale, 1.5f64);
    assert approx(box().style.scale, 1.0f64);   // default identity
    // defaults untouched on a plain node.
    let p: Node = label("y");
    assert approx(p.style.opacity, -1.0f64);   // unset
    assert approx(p.style.shadow_radius, 0.0f64);
    assert p.style.line_limit == (0 as i32);
}

#[test]
fn facet_icon_button_and_readonly_text_area() {
    // icon_button: a button kind whose SF Symbol name rides in `value` (empty
    // title); a titled button leaves `value` empty (so ak_button can branch).
    let ib: Node = icon_button("xmark.circle");
    assert ib.kind == kind_button();
    assert ib.value.view() == "xmark.circle";
    assert ib.text.view() == "";
    assert button("Save").value.view() == "";
    // text_area editable flag: default true; `false` = a read-only viewer.
    assert text_area(value: "log").editable;
    assert text_area(value: "log", editable: false).editable == false;
}

#[test]
fn facet_control_ctors_and_roles() {
    let t: Node = toggle(on: true, label: "Wifi");
    assert t.kind == kind_toggle();
    assert t.bool_value;
    assert t.text.view() == "Wifi";
    assert role_for_kind(kind_toggle()) == role_button();

    let s: Node = slider(value: 0.3f64, min: 0.0f64, max: 1.0f64);
    assert s.kind == kind_slider();
    assert approx(s.value_f, 0.3f64);
    assert approx(s.max_val, 1.0f64);
    assert role_for_kind(kind_slider()) == role_input();

    let pr: Node = progress(value: 0.5f64);
    assert pr.kind == kind_progress();
    assert approx(pr.value_f, 0.5f64);
    assert pr.indeterminate == false;
    assert role_for_kind(kind_progress()) == role_group();

    let st: Node = stepper(value: 3.0f64, min: 0.0f64, max: 10.0f64, step: 2.0f64);
    assert st.kind == kind_stepper();
    assert approx(st.value_f, 3.0f64);
    assert approx(st.step_val, 2.0f64);
    assert role_for_kind(kind_stepper()) == role_input();

    let sf: Node = secure_field(placeholder: "Password", value: "hunter2");
    assert sf.kind == kind_secure_field();
    assert sf.value.view() == "hunter2";
    assert role_for_kind(kind_secure_field()) == role_input();

    var segs: vec::Vec[text::Text] = vec::new::[text::Text]();
    segs.append(text::from_str("Day"));
    segs.append(text::from_str("Night"));
    let sg: Node = segmented(segs, selected: 1 as i64);
    assert sg.kind == kind_segmented();
    assert sg.popup_items.count() == (2 as usize);
    assert sg.popup_selected == (1 as i64);
    assert role_for_kind(kind_segmented()) == role_input();
}

#[test]
fn facet_batch3_control_ctors() {
    // checkbox / radio are toggle variants (a toggle_style, no new kind/slot).
    let cb: Node = checkbox("Agree", on: true);
    assert cb.kind == kind_toggle();
    assert cb.toggle_style == (1 as i32);
    assert cb.bool_value;

    let rb: Node = radio("Opt A");
    assert rb.kind == kind_toggle();
    assert rb.toggle_style == (2 as i32);

    let cp: Node = color_picker();
    assert cp.kind == kind_color_picker();
    assert role_for_kind(kind_color_picker()) == role_input();

    let dp: Node = date_picker();
    assert dp.kind == kind_date_picker();
    assert role_for_kind(kind_date_picker()) == role_input();
}

#[test]
fn mount_dispatches_batch3_controls() {
    reset_fake_counts();
    var b: Builder = Builder::new();
    b.add(checkbox("a", on: true));   // kind_toggle
    b.add(radio("b"));                // kind_toggle
    b.add(color_picker());
    b.add(date_picker());
    let root: Node = b.finish();
    let _t: flex::Node = mount(#addr_of(root), fake_renderer());
    assert FAKE_TOGGLES == 2;         // checkbox + radio dispatch as toggle
    assert FAKE_COLOR_PICKERS == 1;
    assert FAKE_DATE_PICKERS == 1;
    assert FAKE_IDENTITIES == 4;
}

#[test]
fn facet_p2_layout_modifiers_set_fields() {
    let n: Node = label("x")
        .width_pct(50.0f64).height_pct(25.0f64)
        .gap_row(4.0f64).gap_col(8.0f64)
        .display(flex::Display::None)
        .overflow(flex::Overflow::Hidden)
