fn flow_direction(n: *Node) -> vocab::FlowDirection {
    let d: *Data = node_data(n);
    if d == (0 as *Data) { return vocab::FlowDirection::MatchParent; }
    return { (*d).common.flow_direction };
}

// ---- the transform band -----------------------------------------------------
// One dirty bit for the lot: a backend rebuilds the whole transform from these
// nine numbers anyway, so nine bits would buy it nothing.

fn set_rotation(n: *Node, v: f64) {
    let d: *Data = node_data(n);
    if d == (0 as *Data) { return; }
    { (*d).common.rotation = v };
