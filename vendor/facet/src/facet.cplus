// facet — platform-free UI description + the `@facet { }` builder context.
//
// A `@facet { ... }` block (the compiler's contextual-builder DSL) desugars
// to `facet::Builder::new()` + `.add(item)` + `.finish()`. Bare leaf names
// resolve against this package (`label` -> `facet::label`), a bare container
// (`vstack { ... }`) calls the container fn, and modifiers follow the
// flex_layout line rule: same line = fluent chain (`take this -> Node`),
// own leading-dot line = in-place `set_*`.
//
// The result is a `Node` tree — pure data, no native types. `mount` turns it
// into a `flex_layout` node tree through a per-platform `Renderer` vtable
// (one op per kind). Containers, spacing, and every layout prop are applied
// HERE, write-once; widget kinds dispatch through the vtable. After every
// widget-producing op, `mount` calls `set_identity` so agent id + role are
// pinned once, not re-remembered inside each op. A platform package
// (facet_appkit, ...) supplies those fns over its typed binding, then lays
// the flex tree out and applies the frames.
//
// The leaf/container value IS a `Node` (no wrapper): the DSL's `add` moves a
// whole owned value into the accumulator, and `finish`/containers hand the
// accumulated `Vec` back out by destructuring the `Builder` — a zero-copy
// whole-value move.

import "stdlib/vec" as vec;
import "stdlib/text" as text;
import "stdlib/option" as option;
import "flex_layout/flex_layout" as flex;

// ---- the component contract ---------------------------------------------
// A component is a plain struct: fields are the state, handlers are
// `ref this` methods in the INHERENT impl, and this interface is the
// checked conformance block (`impl Foo: facet::Component`) holding
// `render`. Interface-impl blocks are closed (E0503/E0504 typo interlock),
// so `render` here is verified against this declaration both ways.
//
// `render` returns the platform tier's node — a `flex_layout` tree whose
// leaves carry native views in their payload slots (the `@ui` tier on
// AppKit; a future gtk/win32 tier produces the same shape). The runtime
// that mounts and re-renders components is erased and lives with the
// platform package (facet_appkit/ui: `mount`, `invalidate`); wiring is a
// bound method reference (`button("+1", on: counter.on_inc)`), which
// carries the component's address as the handler ctx — the ONE update
// rule "after a component's handler runs, that component re-renders" is
// keyed on that address.
interface Component {
    fn render(this) -> flex::Node;
}

// ---- node kinds --------------------------------------------------------

fn kind_label() -> u32 { return 0 as u32; }
fn kind_wrap_label() -> u32 { return 1 as u32; }
fn kind_button() -> u32 { return 2 as u32; }
fn kind_spacer() -> u32 { return 3 as u32; }
fn kind_column() -> u32 { return 4 as u32; }
fn kind_row() -> u32 { return 5 as u32; }
fn kind_text_area() -> u32 { return 6 as u32; }
fn kind_composer() -> u32 { return 7 as u32; }
fn kind_code_editor() -> u32 { return 8 as u32; }
fn kind_bordered() -> u32 { return 9 as u32; }
fn kind_clickable() -> u32 { return 10 as u32; }
fn kind_split() -> u32 { return 11 as u32; }
// Tier-2 leaves (Phase 2) — promoted from the AppKit-only `@ui` layer so the
// portable model covers everything a real app needs.
fn kind_image() -> u32 { return 12 as u32; }
fn kind_symbol() -> u32 { return 13 as u32; }       // SF Symbol / themed icon — PROVISIONAL (no portable meaning yet)
fn kind_text_field() -> u32 { return 14 as u32; }
fn kind_popup() -> u32 { return 15 as u32; }
fn kind_divider() -> u32 { return 16 as u32; }
// The escape hatch (Phase 3): an opaque native view facet does not abstract.
// The backend adopts the handle into a flex payload; the app owns the base view
// (e.g. a component field) and re-wraps it each render. This is the valve that
// carries structured widgets (list/tree/file_tree) until a portable kind earns
// its place (contract doc §8).
fn kind_native() -> u32 { return 17 as u32; }
// Overlay container (Phase / matrix §2): children stack. Pure layout — no vtable
// op, handled entirely in `mount` via absolute positioning (like column/row).
fn kind_zstack() -> u32 { return 18 as u32; }
// Form controls (matrix §2) — each a leaf with a vtable op per backend.
fn kind_toggle() -> u32 { return 19 as u32; }
fn kind_slider() -> u32 { return 20 as u32; }
fn kind_progress() -> u32 { return 21 as u32; }
fn kind_stepper() -> u32 { return 22 as u32; }
fn kind_secure_field() -> u32 { return 23 as u32; }
fn kind_segmented() -> u32 { return 24 as u32; }
// Scroll container (matrix §4): a wrapper op — the backend hosts the mounted
// content in a scroll view. Two-phase content sizing is the backend's concern.
fn kind_scroll() -> u32 { return 25 as u32; }
fn kind_color_picker() -> u32 { return 26 as u32; }
fn kind_date_picker() -> u32 { return 27 as u32; }
// Grid container (matrix §1): pure CSS-grid layout — no vtable op (like zstack).
fn kind_grid() -> u32 { return 28 as u32; }
// A plain styled rectangle leaf (Shapes: Rectangle/RoundedRectangle/Circle via
// background + corner_radius). One backend op.
fn kind_box() -> u32 { return 29 as u32; }
// A translucent vibrancy wrapper (macOS material / sidebar). Wrapper op.
fn kind_material() -> u32 { return 30 as u32; }
// A read-only value gauge (SwiftUI Gauge → NSLevelIndicator). Leaf op.
fn kind_gauge() -> u32 { return 31 as u32; }
// A custom vector shape (SwiftUI Path → CAShapeLayer). Leaf op.
fn kind_path() -> u32 { return 32 as u32; }

// Agent-affordance roles — numeric indices aligned with agent_core::Role so
// Phase 2 can pass them through without a translation table.
fn role_button() -> u32 { return 0 as u32; }
fn role_text() -> u32 { return 1 as u32; }
fn role_input() -> u32 { return 2 as u32; }
fn role_list() -> u32 { return 3 as u32; }
fn role_group() -> u32 { return 4 as u32; }
fn role_window() -> u32 { return 5 as u32; }

// Core-owned kind → role table. Used by `mount` when calling `set_identity`.
fn role_for_kind(k: u32) -> u32 {
    if k == kind_button() { return role_button(); }
    if k == kind_clickable() { return role_button(); }
    if k == kind_label() { return role_text(); }
    if k == kind_wrap_label() { return role_text(); }
    if k == kind_text_area() { return role_input(); }
    if k == kind_composer() { return role_input(); }
    if k == kind_code_editor() { return role_input(); }
    if k == kind_bordered() { return role_group(); }
    if k == kind_split() { return role_group(); }
    if k == kind_text_field() { return role_input(); }
    // popup holds a readable selection; precise index-drive is a future agent
    // verb (the model has click/text/none) — role_input keeps it observable.
    if k == kind_popup() { return role_input(); }
    if k == kind_toggle() { return role_button(); }   // click flips it
    if k == kind_slider() { return role_input(); }    // has a readable value
    if k == kind_stepper() { return role_input(); }
    if k == kind_secure_field() { return role_input(); }
    if k == kind_segmented() { return role_input(); }
    if k == kind_color_picker() { return role_input(); }
    if k == kind_date_picker() { return role_input(); }
    // image / symbol / divider / progress are non-interactive display.
    return role_group();
}

// Default click handler — a no-op, so `Node.click` is never a null fn-pointer.
// (Button always wires a target; optional gesture/composer handlers use the
// null-fn sentinel `0 as fn(*u8,*u8)` instead, so backends know whether to
// install a recognizer at all.)
fn noop(sender: *u8, ctx: *u8) { return; }

// Null-fn sentinel for optional handlers (composer/clickable gestures).
// Installing 11 gesture recognizers unconditionally is waste; backends wire
// only when the field is non-null.
fn null_fn() -> fn(*u8, *u8) { return 0 as fn(*u8, *u8); }

// ---- Style: portable visual style ------------------------------------------
// Every field has an explicit UNSET state so a backend's `apply_style` touches
// ONLY what the author set — it must never stomp a control's size-specific font
// or a dark-mode-adaptive semantic color. Unset = `0.0` (numerics),
// `weight_unset()`/`family_unset()`, a `Color` with token 0 (`Color::none`).

// Font weight tokens (0 = unset — keep the widget's native weight).
fn weight_unset() -> u32 { return 0 as u32; }
fn weight_regular() -> u32 { return 1 as u32; }
fn weight_medium() -> u32 { return 2 as u32; }
fn weight_semibold() -> u32 { return 3 as u32; }
fn weight_bold() -> u32 { return 4 as u32; }

// Font family tokens (0 = unset).
fn family_unset() -> u32 { return 0 as u32; }
fn family_system() -> u32 { return 1 as u32; }
fn family_monospace() -> u32 { return 2 as u32; }

// A color: a semantic token (mapped to the platform's native color) or explicit
// RGBA. token 0 = none/unset; token 255 = Rgba (use r/g/b/a, 0..1). Flat + Copy.
struct Color {
    token: u32,
    r: f64,
    g: f64,
    b: f64,
    a: f64,
}

impl Color {
    fn none() -> Color { return Color { token: 0 as u32, r: 0.0f64, g: 0.0f64, b: 0.0f64, a: 0.0f64 }; }
    fn primary() -> Color { return Color { token: 1 as u32, r: 0.0f64, g: 0.0f64, b: 0.0f64, a: 0.0f64 }; }
    fn secondary() -> Color { return Color { token: 2 as u32, r: 0.0f64, g: 0.0f64, b: 0.0f64, a: 0.0f64 }; }
    fn accent() -> Color { return Color { token: 3 as u32, r: 0.0f64, g: 0.0f64, b: 0.0f64, a: 0.0f64 }; }
    fn system_red() -> Color { return Color { token: 4 as u32, r: 0.0f64, g: 0.0f64, b: 0.0f64, a: 0.0f64 }; }
    fn system_green() -> Color { return Color { token: 5 as u32, r: 0.0f64, g: 0.0f64, b: 0.0f64, a: 0.0f64 }; }
    fn system_blue() -> Color { return Color { token: 6 as u32, r: 0.0f64, g: 0.0f64, b: 0.0f64, a: 0.0f64 }; }
    fn system_orange() -> Color { return Color { token: 7 as u32, r: 0.0f64, g: 0.0f64, b: 0.0f64, a: 0.0f64 }; }
    fn system_gray() -> Color { return Color { token: 8 as u32, r: 0.0f64, g: 0.0f64, b: 0.0f64, a: 0.0f64 }; }
    fn rgba(r: f64, g: f64, b: f64, a: f64) -> Color { return Color { token: 255 as u32, r: r, g: g, b: b, a: a }; }
    fn is_set(this) -> bool { return this.token != (0 as u32); }
}

// A widget's visual style. Rides on every `Node`; each backend's `apply_style`
// reads it and applies only the set fields. Paint props (fg/bg/corner/border)
// are the Phase-0 surface; font/weight/family are present but folded in later.
struct Style {
    font_size: f64,        // 0 = unset
    weight: u32,           // 0 = unset
    family: u32,           // 0 = unset
    fg: Color,             // token 0 = unset
    bg: Color,             // token 0 = unset
    corner_radius: f64,    // 0 = unset (also = square, same visual)
    border_width: f64,     // 0 = unset
    border_color: Color,   // token 0 = unset
    opacity: f64,          // -1 = unset (0..1)
    shadow_radius: f64,    // 0 = unset (drop-shadow blur radius)
    line_limit: i32,       // 0 = unset / unlimited (max text lines)
    text_align: i32,       // 0 = unset; 1 = leading, 2 = center, 3 = trailing
    hidden: bool,          // invisible but keeps its layout space (vs display:none)
    italic: bool,          // italicize the font
    clip: bool,            // clip content to the (rounded) bounds
    underline: bool,       // underline the text
    strikethrough: bool,   // strike through the text
    grad_from: Color,      // gradient top color (token 0 = no gradient)
    grad_to: Color,        // gradient bottom color
    rotation: f64,         // rotation in degrees (0 = none)
    scale: f64,            // uniform scale (1.0 = none)
    fade_in: f64,          // entrance fade duration in seconds (0 = none). The
                           // node fades opacity 0→1 when it mounts. SwiftUI's
                           // `.transition(.opacity)` — a one-shot appear animation
                           // that fits the component re-render model (each mount
                           // is a fresh view, so it plays its own entrance).
}

// Text-alignment tokens (0 = unset — keep the widget's natural alignment).
fn text_leading() -> i32 { return 1 as i32; }
fn text_center() -> i32 { return 2 as i32; }
fn text_trailing() -> i32 { return 3 as i32; }

fn style_none() -> Style {
    return Style {
        font_size: 0.0f64,
        weight: 0 as u32,
        family: 0 as u32,
        fg: Color::none(),
        bg: Color::none(),
        corner_radius: 0.0f64,
        border_width: 0.0f64,
        border_color: Color::none(),
        opacity: -1.0f64,
        shadow_radius: 0.0f64,
        line_limit: 0 as i32,
        text_align: 0 as i32,
        hidden: false,
        italic: false,
        clip: false,
        underline: false,
        strikethrough: false,
        grad_from: Color::none(),
        grad_to: Color::none(),
        rotation: 0.0f64,
        scale: 1.0f64,
        fade_in: 0.0f64,
    };
}

// ---- the description tree ----------------------------------------------

// One node. Widget config is read by the platform's per-kind ops; the
// `_`-prefixed layout props are applied by `mount` and never cross the
// package boundary. Config is a flat union-of-fields (closed kind set —
// no generic prop channel). Per-node memory is irrelevant at UI scale.
struct Node {
    kind: u32,
    text: text::Text,
    click: fn(*u8, *u8),    // (sender, ctx) — wired by the backend's button op
    opaque click_ctx: *u8,  // borrowed identity value; the app owns it
    agent_id: text::Text,   // "" = untagged. A developer-curated stable id the
                            // backend pins on the created widget at every mount
                            // (via set_identity), so it survives re-renders.
    tooltip: text::Text,    // "" = none. Hover help text (backend applies in apply_style).
    a11y_label: text::Text, // "" = none. VoiceOver / accessibility label.
    a11y_hint: text::Text,  // "" = none. VoiceOver hint (SwiftUI .accessibilityHint).
    key_equiv: text::Text,  // "" = none. Keyboard shortcut key for a button.
    ctx_menu_items: vec::Vec[text::Text],   // right-click menu items (empty = none)
    ctx_menu_action: fn(*u8, *u8),          // fires (item, index) on a menu pick
    font_size: f64,         // 0 = platform default
    bold: bool,
    secondary: bool,
    primary: bool,
    plain: bool,            // button: borderless/plain variant (link/plain button fold)
    style: Style,           // portable visual style; backend applies set fields
    // --- kind-specific config (union-of-fields; unused kinds leave defaults) ---
    value: text::Text,          // composer / code_editor / text_area initial text; image path; symbol name
    placeholder: text::Text,    // text_area / text_field
    popup_items: vec::Vec[text::Text],  // popup / segmented: the rows/segments
    popup_selected: i64,        // popup / segmented: initially-selected index
    opaque native_handle: *u8,  // native escape hatch: a borrowed native view; the app owns it
    bool_value: bool,           // toggle: on/off state
    value_f: f64,               // slider / stepper / progress: current value
    min_val: f64,               // slider / stepper: minimum (default 0)
    max_val: f64,               // slider / stepper: maximum (default 1)
    step_val: f64,              // stepper: increment (default 1)
    indeterminate: bool,        // progress: spinner mode (ignore value)
    pull_down: bool,            // popup: pull-down menu mode (Menu) vs selector
    toggle_style: i32,          // toggle: 0 = switch, 1 = checkbox, 2 = radio
    grid_cols: i32,             // grid: number of equal columns
    editable: bool,             // code_editor (default true)
    show_border: bool,          // composer (default true)
    draws_background: bool,     // composer (default true)
    radius: f64,                // bordered corner radius
    vertical: bool,             // split: true = side-by-side
    position: f64,              // split: initial divider offset
    min_first: f64,             // split: first-pane minimum
    min_second: f64,            // split: second-pane minimum
    inset_w: f64,               // code_editor text-container inset
    inset_h: f64,
    long_press_seconds: f64,    // clickable long-press threshold (0 = platform default)
    // Optional handlers — null-fn sentinel when unset (see null_fn).
    // Clickable's primary click reuses `click` (avoids shadowing the fluent
    // `.on_click` method); remaining gestures are null-fn when unset.
    on_submit: fn(*u8, *u8),    // composer
    on_change: fn(*u8, *u8),    // composer / text_area
    on_double_click: fn(*u8, *u8),
    on_right_click: fn(*u8, *u8),
    on_long_press: fn(*u8, *u8),
    on_drag: fn(*u8, *u8),
    on_pinch: fn(*u8, *u8),
    on_rotate: fn(*u8, *u8),
    on_hover_in: fn(*u8, *u8),
    on_hover_out: fn(*u8, *u8),
    on_scroll: fn(*u8, *u8),
    // layout
    _grow: f64,
    _gap: f64,
    _padding: f64,
    _width: f64,            // -1 = auto
    _height: f64,           // -1 = auto
    // extended flexbox layout — thin pass-through to flex_layout (the shared
    // engine); mount replays each set field onto the flex node. Uses flex's own
    // CSS vocabulary + enums (not SwiftUI). Unset = a `_has_*` flag (enums) or a
    // -1 sentinel (sizes, where 0 is a valid value). Per-edge padding composes
    // OVER the uniform `_padding` (edges win).
    _align_items: flex::Align,   _has_align_items: bool,
    _align_self: flex::Align,    _has_align_self: bool,
    _justify: flex::Justify,     _has_justify: bool,
    _shrink: f64,           // -1 = unset (0 is valid)
    _min_w: f64,            // -1 = unset
    _min_h: f64,            // -1 = unset
    _max_w: f64,            // -1 = unset
    _max_h: f64,            // -1 = unset
    _basis: f64,            // -1 = unset (flex-basis, points)
    _aspect: f64,           // -1 = unset (width/height)
    _wrap: flex::Wrap,           _has_wrap: bool,
    _position_type: flex::PositionType, _has_position_type: bool,   // absolute → ZStack/overlay
    _pad_l: f64, _pad_t: f64, _pad_r: f64, _pad_b: f64,   // 0 = unset (per-edge padding)
    _mrg_l: f64, _mrg_t: f64, _mrg_r: f64, _mrg_b: f64,   // 0 = unset (per-edge margin)
    _ins_l: f64, _ins_t: f64, _ins_r: f64, _ins_b: f64,   // absolute inset values
    _inset_mask: u32,       // bit per set inset edge: 1=L 2=T 4=R 8=B (0 is a valid inset)
    _width_pct: f64,        // -1 = unset (percent width, overrides points)
    _height_pct: f64,       // -1 = unset (percent height)
    _gap_row: f64,          // 0 = unset (vertical gutter)
    _gap_col: f64,          // 0 = unset (horizontal gutter)
    _display: flex::Display,       _has_display: bool,
    _overflow: flex::Overflow,     _has_overflow: bool,
    _align_content: flex::Align,   _has_align_content: bool,
    _direction: flex::Direction,   _has_direction: bool,
    _box_sizing: flex::BoxSizing,  _has_box_sizing: bool,
    _flex_dir: flex::FlexDirection, _has_flex_dir: bool,   // override kind dir (reverse)
    _grid_col_span: i32,           // 0 = unset (grid child)
    _grid_row_span: i32,           // 0 = unset
    _grid_col_start: i32,          // 0 = unset (1-based line)
    _grid_row_start: i32,          // 0 = unset
    _grid_cols_subgrid: bool,      // grid: inherit parent's column tracks
    _grid_rows_subgrid: bool,      // grid: inherit parent's row tracks
    _bdr_l: f64, _bdr_t: f64, _bdr_r: f64, _bdr_b: f64,   // 0 = unset (border-as-inset)
    _pad_start: f64, _pad_end: f64,   // 0 = unset (logical, direction-relative padding)
    _mrg_start: f64, _mrg_end: f64,   // 0 = unset (logical margin)
    path_cmds: vec::Vec[PathCmd],     // path kind: the vector segments (empty = none)
    children: vec::Vec[Node],
}

// One segment of a vector `path`. `op` selects which points are read:
// 1 move / 2 line use (ax,ay); 3 quad adds control (bx,by); 4 cubic adds a
// second control (cx,cy); 5 close ignores all points. Local top-left coords.
struct PathCmd {
    op: u32,
    ax: f64, ay: f64,   // end point
    bx: f64, by: f64,   // control 1 (quad control; cubic control 1)
    cx: f64, cy: f64,   // control 2 (cubic only)
}

fn path_op_move() -> u32 { return 1 as u32; }
fn path_op_line() -> u32 { return 2 as u32; }
fn path_op_quad() -> u32 { return 3 as u32; }
fn path_op_cubic() -> u32 { return 4 as u32; }
fn path_op_close() -> u32 { return 5 as u32; }

fn blank(kind: u32) -> Node {
    let none: fn(*u8, *u8) = null_fn();
    return Node {
        kind: kind,
        text: text::from_str(""),
        click: noop,
        click_ctx: 0 as *u8,
        agent_id: text::from_str(""),
        tooltip: text::from_str(""),
        a11y_label: text::from_str(""),
        a11y_hint: text::from_str(""),
        key_equiv: text::from_str(""),
        ctx_menu_items: vec::new::[text::Text](),
        ctx_menu_action: null_fn(),
        font_size: 0.0f64,
        bold: false,
        secondary: false,
        primary: false,
        plain: false,
        style: style_none(),
        value: text::from_str(""),
        placeholder: text::from_str(""),
        popup_items: vec::new::[text::Text](),
        popup_selected: 0 as i64,
        native_handle: 0 as *u8,
        bool_value: false,
        value_f: 0.0f64,
        min_val: 0.0f64,
        max_val: 1.0f64,
        step_val: 1.0f64,
        indeterminate: false,
        pull_down: false,
        toggle_style: 0 as i32,
        grid_cols: 0 as i32,
        editable: true,
        show_border: true,
        draws_background: true,
        radius: 6.0f64,
        vertical: true,
        position: 220.0f64,
        min_first: 150.0f64,
        min_second: 240.0f64,
        inset_w: 0.0f64,
        inset_h: 0.0f64,
        long_press_seconds: 0.0f64,
        on_submit: none,
        on_change: none,
        on_double_click: none,
        on_right_click: none,
        on_long_press: none,
        on_drag: none,
        on_pinch: none,
        on_rotate: none,
        on_hover_in: none,
        on_hover_out: none,
        on_scroll: none,
        _grow: 0.0f64,
        _gap: 0.0f64,
        _padding: 0.0f64,
        _width: -1.0f64,
        _height: -1.0f64,
        _align_items: flex::Align::Auto,    _has_align_items: false,
        _align_self: flex::Align::Auto,     _has_align_self: false,
        _justify: flex::Justify::FlexStart, _has_justify: false,
        _shrink: -1.0f64,
        _min_w: -1.0f64,
        _min_h: -1.0f64,
        _max_w: -1.0f64,
        _max_h: -1.0f64,
        _basis: -1.0f64,
        _aspect: -1.0f64,
        _wrap: flex::Wrap::NoWrap,               _has_wrap: false,
        _position_type: flex::PositionType::Static, _has_position_type: false,
        _pad_l: 0.0f64, _pad_t: 0.0f64, _pad_r: 0.0f64, _pad_b: 0.0f64,
        _mrg_l: 0.0f64, _mrg_t: 0.0f64, _mrg_r: 0.0f64, _mrg_b: 0.0f64,
        _ins_l: 0.0f64, _ins_t: 0.0f64, _ins_r: 0.0f64, _ins_b: 0.0f64,
        _inset_mask: 0 as u32,
        _width_pct: -1.0f64,
        _height_pct: -1.0f64,
        _gap_row: 0.0f64,
        _gap_col: 0.0f64,
        _display: flex::Display::Flex,          _has_display: false,
        _overflow: flex::Overflow::Visible,     _has_overflow: false,
        _align_content: flex::Align::Auto,      _has_align_content: false,
        _direction: flex::Direction::Inherit,   _has_direction: false,
        _box_sizing: flex::BoxSizing::BorderBox, _has_box_sizing: false,
        _flex_dir: flex::FlexDirection::Column,  _has_flex_dir: false,
        _grid_col_span: 0 as i32,
        _grid_row_span: 0 as i32,
        _grid_col_start: 0 as i32,
        _grid_row_start: 0 as i32,
        _grid_cols_subgrid: false,
        _grid_rows_subgrid: false,
        _bdr_l: 0.0f64, _bdr_t: 0.0f64, _bdr_r: 0.0f64, _bdr_b: 0.0f64,
        _pad_start: 0.0f64, _pad_end: 0.0f64,
        _mrg_start: 0.0f64, _mrg_end: 0.0f64,
        path_cmds: vec::new::[PathCmd](),
        children: vec::new::[Node](),
    };
}

// ---- leaves --------------------------------------------------------------

fn label(s: str, size: f64 = 0.0f64, bold: bool = false, secondary: bool = false) -> Node {
    var n: Node = blank(kind_label());
    n.text = text::from_str(s);
    n.font_size = size;
    n.bold = bold;
    n.secondary = secondary;
    return n;
}

// A multi-line label that wraps to its flexed width.
fn wrap_label(s: str, size: f64 = 0.0f64, secondary: bool = false) -> Node {
    var n: Node = blank(kind_wrap_label());
    n.text = text::from_str(s);
    n.font_size = size;
    n.secondary = secondary;
    return n;
}

fn button(s: str, primary: bool = false) -> Node {
    var n: Node = blank(kind_button());
    n.text = text::from_str(s);
    n.primary = primary;
    return n;
}

// Flexible empty space.
fn spacer() -> Node {
    var n: Node = blank(kind_spacer());
    n._grow = 1.0f64;
    return n;
}

// Multi-line editable text area. Optional `on_change` uses the null-fn sentinel
// when unset (same convention as composer).
fn text_area(
    placeholder: str = "",
    value: str = "",
    on_change: fn(*u8, *u8) = 0 as fn(*u8, *u8),
    ctx: *u8 = 0 as *u8,
) -> Node {
    var n: Node = blank(kind_text_area());
    n.placeholder = text::from_str(placeholder);
    n.value = text::from_str(value);
    n.on_change = on_change;
    n.click_ctx = ctx;
    return n;
}

// Chat-style composer: submit on Enter, newline on Shift+Enter.
// Optional handlers use the null-fn sentinel when unset.
fn composer(
    on_submit: fn(*u8, *u8) = 0 as fn(*u8, *u8),
    on_change: fn(*u8, *u8) = 0 as fn(*u8, *u8),
    ctx: *u8 = 0 as *u8,
    value: str = "",
    show_border: bool = true,
    draws_background: bool = true,
) -> Node {
    var n: Node = blank(kind_composer());
    n.on_submit = on_submit;
    n.on_change = on_change;
    n.click_ctx = ctx;
    n.value = text::from_str(value);
    n.show_border = show_border;
    n.draws_background = draws_background;
    return n;
}

// Monospaced code editor / viewer. `editable: false` is a read-only viewer.
fn code_editor(
    value: str = "",
    editable: bool = true,
    size: f64 = 12.0f64,
    inset_w: f64 = 0.0f64,
    inset_h: f64 = 0.0f64,
) -> Node {
    var n: Node = blank(kind_code_editor());
    n.value = text::from_str(value);
    n.editable = editable;
    n.font_size = size;
    n.inset_w = inset_w;
    n.inset_h = inset_h;
    return n;
}

// ---- Tier-2 leaves (Phase 2) -----------------------------------------------
// Promoted from the AppKit-only `@ui` layer. Each is a portable kind + op; the
// backend adapts its existing widget. `colored_label` folds into `label` +
// `.foreground_color`, and `icon_button`/`link_button`/`plain_button` fold into
// `button` + `.plain()`/`.foreground_color` or `clickable { symbol(...) }`.

// A bitmap image loaded from a file path.
fn image(path: str) -> Node {
    var n: Node = blank(kind_image());
    n.value = text::from_str(path);
    return n;
}

// An SF Symbol / themed icon by name. PROVISIONAL — SF Symbols are an Apple-ism
// with no portable meaning yet; a non-Apple backend maps a themed icon set.
fn symbol(name: str, size: f64 = 16.0f64, secondary: bool = false) -> Node {
    var n: Node = blank(kind_symbol());
    n.value = text::from_str(name);
    n.font_size = size;
    n.secondary = secondary;
    return n;
}

// A single-line editable text field (agent-drivable via set_text).
fn text_field(placeholder: str = "", value: str = "") -> Node {
    var n: Node = blank(kind_text_field());
    n.placeholder = text::from_str(placeholder);
    n.value = text::from_str(value);
    return n;
}

// A dropdown selector. `items` are the rows; `selected` the initial index.
// `on_change` fires on a new selection (read the index with the backend reader).
fn popup(
    take items: vec::Vec[text::Text],
    selected: i64 = 0 as i64,
    on_change: fn(*u8, *u8) = 0 as fn(*u8, *u8),
    ctx: *u8 = 0 as *u8,
) -> Node {
    var n: Node = blank(kind_popup());
    n.popup_items = items;
    n.popup_selected = selected;
    n.on_change = on_change;
    n.click_ctx = ctx;
    return n;
}

// A pull-down actions menu (SwiftUI `Menu`): a fixed `title` button that drops a
// list of action `items`; `on_change` fires with the chosen item. Same kind as
// `popup` (a pull-down NSPopUpButton) — a variant, not a new contract slot.
fn menu(
    title: str,
    take items: vec::Vec[text::Text],
    on_change: fn(*u8, *u8) = 0 as fn(*u8, *u8),
    ctx: *u8 = 0 as *u8,
) -> Node {
    var n: Node = blank(kind_popup());
    n.text = text::from_str(title);
    n.popup_items = items;
    n.on_change = on_change;
    n.click_ctx = ctx;
    n.pull_down = true;
    return n;
}

// A thin separator line.
fn divider() -> Node {
    return blank(kind_divider());
}

// A styled rectangle (Shapes). Paint it with `.background(...)`; round it with
// `.corner_radius(...)` (a full-radius square is a circle). Size with `.frame`.
fn box() -> Node {
    return blank(kind_box());
}

// A CSS-grid container: `columns` equal tracks; children auto-flow into cells,
// wrapping to new rows. Pure layout (like vstack/zstack) — no backend op.
fn grid(take b: Builder, columns: i32 = 2) -> Node {
    let Builder { children } = b;
    var n: Node = blank(kind_grid());
    n.children = children;
    n.grid_cols = columns;
    return n;
}

// A boolean on/off switch. `on` is the initial state; `on_change` fires when the
// user flips it (read the new state in the handler).
fn toggle(
    on: bool = false,
    label: str = "",
    on_change: fn(*u8, *u8) = 0 as fn(*u8, *u8),
    ctx: *u8 = 0 as *u8,
) -> Node {
    var n: Node = blank(kind_toggle());
    n.bool_value = on;
    n.text = text::from_str(label);
    n.on_change = on_change;
    n.click_ctx = ctx;
    return n;
}

// A checkbox (a labeled on/off tick) — a toggle rendered as a checkbox.
fn checkbox(
    label: str = "",
    on: bool = false,
    on_change: fn(*u8, *u8) = 0 as fn(*u8, *u8),
    ctx: *u8 = 0 as *u8,
) -> Node {
    var n: Node = blank(kind_toggle());
    n.toggle_style = 1 as i32;
    n.bool_value = on;
    n.text = text::from_str(label);
    n.on_change = on_change;
    n.click_ctx = ctx;
    return n;
}

// A radio button (one of a mutually-exclusive set — grouping is the app's job).
fn radio(
    label: str = "",
    on: bool = false,
    on_change: fn(*u8, *u8) = 0 as fn(*u8, *u8),
    ctx: *u8 = 0 as *u8,
) -> Node {
    var n: Node = blank(kind_toggle());
    n.toggle_style = 2 as i32;
    n.bool_value = on;
    n.text = text::from_str(label);
    n.on_change = on_change;
    n.click_ctx = ctx;
    return n;
}

// A color well (opens the system color picker).
fn color_picker(on_change: fn(*u8, *u8) = 0 as fn(*u8, *u8), ctx: *u8 = 0 as *u8) -> Node {
    var n: Node = blank(kind_color_picker());
    n.on_change = on_change;
    n.click_ctx = ctx;
    return n;
}

// A date picker (defaults to the current date).
fn date_picker(on_change: fn(*u8, *u8) = 0 as fn(*u8, *u8), ctx: *u8 = 0 as *u8) -> Node {
    var n: Node = blank(kind_date_picker());
    n.on_change = on_change;
    n.click_ctx = ctx;
    return n;
}

// A continuous value slider over [min, max].
fn slider(
    value: f64 = 0.0f64,
    min: f64 = 0.0f64,
    max: f64 = 1.0f64,
    on_change: fn(*u8, *u8) = 0 as fn(*u8, *u8),
    ctx: *u8 = 0 as *u8,
) -> Node {
    var n: Node = blank(kind_slider());
    n.value_f = value;
    n.min_val = min;
    n.max_val = max;
    n.on_change = on_change;
    n.click_ctx = ctx;
    return n;
}

// A progress indicator. `value` in [0,1] when determinate; `indeterminate: true`
// spins (barber-pole / activity) and ignores value.
fn progress(value: f64 = 0.0f64, indeterminate: bool = false) -> Node {
    var n: Node = blank(kind_progress());
    n.value_f = value;
    n.indeterminate = indeterminate;
    return n;
}

// A read-only value gauge over [min, max] (SwiftUI `Gauge(value:in:)`).
fn gauge(value: f64 = 0.0f64, min: f64 = 0.0f64, max: f64 = 1.0f64) -> Node {
    var n: Node = blank(kind_gauge());
    n.value_f = value;
    n.min_val = min;
    n.max_val = max;
    return n;
}

// A custom vector shape drawn into a width×height box (SwiftUI `Path`). Build
// the outline with `.move_to`/`.line_to`/`.quad_to`/`.curve_to`/`.close_path`,
// then fill with `.background(color)` and/or stroke with `.border(w, color)`.
// Coordinates are local, top-left origin.
fn path(width: f64, height: f64) -> Node {
    var n: Node = blank(kind_path());
    n._width = width;
    n._height = height;
    return n;
}

// Read the fixed layout box (backends need it to size a path's drawing surface;
// `_width`/`_height` are module-private, so expose them through the package). -1
// means auto/unset.
fn fixed_width(np: *Node) -> f64 { return { (*np)._width }; }
fn fixed_height(np: *Node) -> f64 { return { (*np)._height }; }

// A +/- numeric stepper over [min, max] by `step`.
fn stepper(
    value: f64 = 0.0f64,
    min: f64 = 0.0f64,
    max: f64 = 100.0f64,
    step: f64 = 1.0f64,
    on_change: fn(*u8, *u8) = 0 as fn(*u8, *u8),
    ctx: *u8 = 0 as *u8,
) -> Node {
    var n: Node = blank(kind_stepper());
    n.value_f = value;
    n.min_val = min;
    n.max_val = max;
    n.step_val = step;
    n.on_change = on_change;
    n.click_ctx = ctx;
    return n;
}

// A masked single-line field for passwords/secrets.
fn secure_field(placeholder: str = "", value: str = "") -> Node {
    var n: Node = blank(kind_secure_field());
    n.placeholder = text::from_str(placeholder);
    n.value = text::from_str(value);
    return n;
}

// A horizontal segmented selector (mutually-exclusive segments).
fn segmented(
    take items: vec::Vec[text::Text],
    selected: i64 = 0 as i64,
    on_change: fn(*u8, *u8) = 0 as fn(*u8, *u8),
    ctx: *u8 = 0 as *u8,
) -> Node {
    var n: Node = blank(kind_segmented());
    n.popup_items = items;
    n.popup_selected = selected;
    n.on_change = on_change;
    n.click_ctx = ctx;
    return n;
}

// The native escape hatch: place a platform view facet does not abstract into a
// `@facet` tree. `handle` is a borrowed native view pointer; the app owns the
// underlying view (typically a component field) and produces this node fresh on
// each render (the backend adopts a retained reference into the flex payload).
// Size it with `.frame(w,h)` / `.grow(...)` — facet does not measure an opaque
// view. Platform code that BUILDS handles lives in per-OS files (§5b) — this
// core constructor only carries the pointer.
fn native(handle: *u8) -> Node {
    var n: Node = blank(kind_native());
    n.native_handle = handle;
    return n;
}

// ---- modifiers -------------------------------------------------------------
// Fluent (chain on the item line) + `set_*` (own leading-dot line), the same
// two-form convention as flex_layout.

impl Node {
    fn grow(take this, v: f64) -> Node { var n: Node = this; n._grow = v; return n; }
    fn gap(take this, v: f64) -> Node { var n: Node = this; n._gap = v; return n; }
    fn padding(take this, v: f64) -> Node { var n: Node = this; n._padding = v; return n; }
    fn width(take this, v: f64) -> Node { var n: Node = this; n._width = v; return n; }
    fn height(take this, v: f64) -> Node { var n: Node = this; n._height = v; return n; }
    fn on_click(take this, cb: fn(*u8, *u8), ctx: *u8 = 0 as *u8) -> Node {
        var n: Node = this;
        n.click = cb;
        n.click_ctx = ctx;
        return n;
    }
    fn agent_id(take this, id: str) -> Node {
        var n: Node = this;
        n.agent_id = text::from_str(id);
        return n;
    }
    fn tooltip(take this, s: str) -> Node { var n: Node = this; n.tooltip = text::from_str(s); return n; }
    fn accessibility_label(take this, s: str) -> Node { var n: Node = this; n.a11y_label = text::from_str(s); return n; }
    fn accessibility_hint(take this, s: str) -> Node { var n: Node = this; n.a11y_hint = text::from_str(s); return n; }
    // Keyboard shortcut (SwiftUI .keyboardShortcut) — the button's key equivalent.
    fn keyboard_shortcut(take this, key: str) -> Node { var n: Node = this; n.key_equiv = text::from_str(key); return n; }
    // Right-click context menu: `on_select` fires with the picked item's index.
    fn context_menu(take this, take items: vec::Vec[text::Text], on_select: fn(*u8, *u8)) -> Node {
        var n: Node = this;
        n.ctx_menu_items = items;
        n.ctx_menu_action = on_select;
        return n;
    }

    // Style modifiers (SwiftUI-shaped, C+-named). Each sets one `Style` field;
    // the backend's `apply_style` applies only the fields the author set.
    fn font(take this, size: f64) -> Node { var n: Node = this; n.style.font_size = size; return n; }
    fn weight(take this, w: u32) -> Node { var n: Node = this; n.style.weight = w; return n; }
    // `.bold()` is sugar for the bold weight token (SwiftUI's `.bold()`).
    fn strong(take this) -> Node { var n: Node = this; n.style.weight = weight_bold(); return n; }
    fn monospaced(take this) -> Node { var n: Node = this; n.style.family = family_monospace(); return n; }
    fn foreground_color(take this, c: Color) -> Node { var n: Node = this; n.style.fg = c; return n; }
    fn background(take this, c: Color) -> Node { var n: Node = this; n.style.bg = c; return n; }
    fn corner_radius(take this, r: f64) -> Node { var n: Node = this; n.style.corner_radius = r; return n; }
    fn border(take this, w: f64, c: Color) -> Node { var n: Node = this; n.style.border_width = w; n.style.border_color = c; return n; }
    fn opacity(take this, v: f64) -> Node { var n: Node = this; n.style.opacity = v; return n; }
    fn shadow(take this, radius: f64) -> Node { var n: Node = this; n.style.shadow_radius = radius; return n; }
    fn line_limit(take this, n_lines: i32) -> Node { var n: Node = this; n.style.line_limit = n_lines; return n; }
    fn text_align(take this, a: i32) -> Node { var n: Node = this; n.style.text_align = a; return n; }
    fn hidden(take this) -> Node { var n: Node = this; n.style.hidden = true; return n; }
    fn italic(take this) -> Node { var n: Node = this; n.style.italic = true; return n; }
    fn clip(take this) -> Node { var n: Node = this; n.style.clip = true; return n; }
    fn underline(take this) -> Node { var n: Node = this; n.style.underline = true; return n; }
    fn strikethrough(take this) -> Node { var n: Node = this; n.style.strikethrough = true; return n; }
    // A vertical (top→bottom) two-color gradient fill.
    fn gradient(take this, from: Color, to: Color) -> Node { var n: Node = this; n.style.grad_from = from; n.style.grad_to = to; return n; }
    // Rotate (degrees) / scale about the element's center.
    fn rotation(take this, degrees: f64) -> Node { var n: Node = this; n.style.rotation = degrees; return n; }
    fn scale(take this, factor: f64) -> Node { var n: Node = this; n.style.scale = factor; return n; }
    // `.fade_in(duration)` — entrance fade (opacity 0→1) played on mount.
    // SwiftUI `.transition(.opacity)`; a one-shot appear animation.
    fn fade_in(take this, duration: f64) -> Node { var n: Node = this; n.style.fade_in = duration; return n; }
    // Path builders — append one segment each (SwiftUI Path's move/addLine/
    // addQuadCurve/addCurve/closeSubpath). Local top-left coordinates.
    fn move_to(take this, x: f64, y: f64) -> Node {
        var n: Node = this;
        n.path_cmds.append(PathCmd { op: path_op_move(), ax: x, ay: y, bx: 0.0f64, by: 0.0f64, cx: 0.0f64, cy: 0.0f64 });
        return n;
    }
    fn line_to(take this, x: f64, y: f64) -> Node {
        var n: Node = this;
        n.path_cmds.append(PathCmd { op: path_op_line(), ax: x, ay: y, bx: 0.0f64, by: 0.0f64, cx: 0.0f64, cy: 0.0f64 });
        return n;
    }
    fn quad_to(take this, cx: f64, cy: f64, x: f64, y: f64) -> Node {
        var n: Node = this;
        n.path_cmds.append(PathCmd { op: path_op_quad(), ax: x, ay: y, bx: cx, by: cy, cx: 0.0f64, cy: 0.0f64 });
        return n;
    }
    fn curve_to(take this, c1x: f64, c1y: f64, c2x: f64, c2y: f64, x: f64, y: f64) -> Node {
        var n: Node = this;
        n.path_cmds.append(PathCmd { op: path_op_cubic(), ax: x, ay: y, bx: c1x, by: c1y, cx: c2x, cy: c2y });
        return n;
    }
    fn close_path(take this) -> Node {
        var n: Node = this;
        n.path_cmds.append(PathCmd { op: path_op_close(), ax: 0.0f64, ay: 0.0f64, bx: 0.0f64, by: 0.0f64, cx: 0.0f64, cy: 0.0f64 });
        return n;
    }
    // `.frame(width:height:)` — set both fixed dimensions at once.
    fn frame(take this, w: f64, h: f64) -> Node { var n: Node = this; n._width = w; n._height = h; return n; }
    // `.plain()` — borderless button (the link/plain-button fold). Pair with
    // `.foreground_color(.accent)` for a link.
    fn plain(take this) -> Node { var n: Node = this; n.plain = true; return n; }

    fn set_grow(ref this, v: f64) { this._grow = v; return; }
    fn set_gap(ref this, v: f64) { this._gap = v; return; }
    fn set_padding(ref this, v: f64) { this._padding = v; return; }
    fn set_width(ref this, v: f64) { this._width = v; return; }
    fn set_height(ref this, v: f64) { this._height = v; return; }
    fn set_on_click(ref this, cb: fn(*u8, *u8), ctx: *u8 = 0 as *u8) {
        this.click = cb;
        this.click_ctx = ctx;
        return;
    }
    fn set_agent_id(ref this, id: str) {
        this.agent_id = text::from_str(id);
        return;
    }
    fn set_tooltip(ref this, s: str) { this.tooltip = text::from_str(s); return; }
    fn set_accessibility_label(ref this, s: str) { this.a11y_label = text::from_str(s); return; }
    fn set_accessibility_hint(ref this, s: str) { this.a11y_hint = text::from_str(s); return; }
    fn set_keyboard_shortcut(ref this, key: str) { this.key_equiv = text::from_str(key); return; }

    fn set_font(ref this, size: f64) { this.style.font_size = size; return; }
    fn set_weight(ref this, w: u32) { this.style.weight = w; return; }
    fn set_strong(ref this) { this.style.weight = weight_bold(); return; }
    fn set_monospaced(ref this) { this.style.family = family_monospace(); return; }
    fn set_foreground_color(ref this, c: Color) { this.style.fg = c; return; }
    fn set_background(ref this, c: Color) { this.style.bg = c; return; }
    fn set_corner_radius(ref this, r: f64) { this.style.corner_radius = r; return; }
    fn set_border(ref this, w: f64, c: Color) { this.style.border_width = w; this.style.border_color = c; return; }
    fn set_opacity(ref this, v: f64) { this.style.opacity = v; return; }
    fn set_shadow(ref this, radius: f64) { this.style.shadow_radius = radius; return; }
    fn set_line_limit(ref this, n_lines: i32) { this.style.line_limit = n_lines; return; }
    fn set_text_align(ref this, a: i32) { this.style.text_align = a; return; }
    fn set_hidden(ref this, v: bool) { this.style.hidden = v; return; }
    fn set_italic(ref this, v: bool) { this.style.italic = v; return; }
    fn set_clip(ref this, v: bool) { this.style.clip = v; return; }
    fn set_underline(ref this, v: bool) { this.style.underline = v; return; }
    fn set_strikethrough(ref this, v: bool) { this.style.strikethrough = v; return; }
    fn set_gradient(ref this, from: Color, to: Color) { this.style.grad_from = from; this.style.grad_to = to; return; }
    fn set_rotation(ref this, degrees: f64) { this.style.rotation = degrees; return; }
    fn set_scale(ref this, factor: f64) { this.style.scale = factor; return; }
    fn set_frame(ref this, w: f64, h: f64) { this._width = w; this._height = h; return; }
    fn set_plain(ref this) { this.plain = true; return; }

    // ---- extended flexbox layout (flex vocabulary; thin pass-through) --------
    // Fluent (same-line chain) + set_ (leading-dot line), the same two-form rule
    // as the rest. Enums are flex_layout's own — the layout substrate is shared,
    // so facet does not reskin it.
    fn align_items(take this, a: flex::Align) -> Node { var n: Node = this; n._align_items = a; n._has_align_items = true; return n; }
    fn align_self(take this, a: flex::Align) -> Node { var n: Node = this; n._align_self = a; n._has_align_self = true; return n; }
    fn justify_content(take this, j: flex::Justify) -> Node { var n: Node = this; n._justify = j; n._has_justify = true; return n; }
    fn shrink(take this, v: f64) -> Node { var n: Node = this; n._shrink = v; return n; }
    fn min_width(take this, v: f64) -> Node { var n: Node = this; n._min_w = v; return n; }
    fn min_height(take this, v: f64) -> Node { var n: Node = this; n._min_h = v; return n; }
    fn max_width(take this, v: f64) -> Node { var n: Node = this; n._max_w = v; return n; }
    fn max_height(take this, v: f64) -> Node { var n: Node = this; n._max_h = v; return n; }
    fn padding_edge(take this, e: flex::Edge, v: f64) -> Node { var n: Node = this; n.pad_edge_into(e, v); return n; }

    fn set_align_items(ref this, a: flex::Align) { this._align_items = a; this._has_align_items = true; return; }
    fn set_align_self(ref this, a: flex::Align) { this._align_self = a; this._has_align_self = true; return; }
    fn set_justify_content(ref this, j: flex::Justify) { this._justify = j; this._has_justify = true; return; }
    fn set_shrink(ref this, v: f64) { this._shrink = v; return; }
    fn set_min_width(ref this, v: f64) { this._min_w = v; return; }
    fn set_min_height(ref this, v: f64) { this._min_h = v; return; }
    fn set_max_width(ref this, v: f64) { this._max_w = v; return; }
    fn set_max_height(ref this, v: f64) { this._max_h = v; return; }
    fn set_padding_edge(ref this, e: flex::Edge, v: f64) { this.pad_edge_into(e, v); return; }

    // Route one flex::Edge onto the per-edge padding fields (Start/End = LTR).
    fn pad_edge_into(ref this, e: flex::Edge, v: f64) {
        match e {
            flex::Edge::Left => { this._pad_l = v; }
            flex::Edge::Right => { this._pad_r = v; }
            flex::Edge::Top => { this._pad_t = v; }
            flex::Edge::Bottom => { this._pad_b = v; }
            flex::Edge::Start => { this._pad_l = v; }
            flex::Edge::End => { this._pad_r = v; }
            flex::Edge::Horizontal => { this._pad_l = v; this._pad_r = v; }
            flex::Edge::Vertical => { this._pad_t = v; this._pad_b = v; }
            flex::Edge::All => { this._pad_l = v; this._pad_t = v; this._pad_r = v; this._pad_b = v; }
        }
        return;
    }

    // ---- more flexbox layout (P1 pass-throughs) ------------------------------
    fn flex_basis(take this, v: f64) -> Node { var n: Node = this; n._basis = v; return n; }
    fn aspect_ratio(take this, v: f64) -> Node { var n: Node = this; n._aspect = v; return n; }
    fn flex_wrap(take this, w: flex::Wrap) -> Node { var n: Node = this; n._wrap = w; n._has_wrap = true; return n; }
    fn position_absolute(take this) -> Node { var n: Node = this; n._position_type = flex::PositionType::Absolute; n._has_position_type = true; return n; }
    fn position_relative(take this) -> Node { var n: Node = this; n._position_type = flex::PositionType::Relative; n._has_position_type = true; return n; }
    fn margin(take this, v: f64) -> Node { var n: Node = this; n._mrg_l = v; n._mrg_t = v; n._mrg_r = v; n._mrg_b = v; return n; }
    fn margin_edge(take this, e: flex::Edge, v: f64) -> Node { var n: Node = this; n.mrg_edge_into(e, v); return n; }
    fn inset(take this, e: flex::Edge, v: f64) -> Node { var n: Node = this; n.inset_into(e, v); return n; }

    // Percent sizing, per-gutter gap, and container display/overflow/content/dir.
    fn width_pct(take this, v: f64) -> Node { var n: Node = this; n._width_pct = v; return n; }
    fn height_pct(take this, v: f64) -> Node { var n: Node = this; n._height_pct = v; return n; }
    fn gap_row(take this, v: f64) -> Node { var n: Node = this; n._gap_row = v; return n; }
    fn gap_col(take this, v: f64) -> Node { var n: Node = this; n._gap_col = v; return n; }
    fn display(take this, d: flex::Display) -> Node { var n: Node = this; n._display = d; n._has_display = true; return n; }
    fn overflow(take this, o: flex::Overflow) -> Node { var n: Node = this; n._overflow = o; n._has_overflow = true; return n; }
    fn align_content(take this, a: flex::Align) -> Node { var n: Node = this; n._align_content = a; n._has_align_content = true; return n; }
    fn direction(take this, d: flex::Direction) -> Node { var n: Node = this; n._direction = d; n._has_direction = true; return n; }
    fn box_sizing(take this, b: flex::BoxSizing) -> Node { var n: Node = this; n._box_sizing = b; n._has_box_sizing = true; return n; }
    fn flex_direction(take this, d: flex::FlexDirection) -> Node { var n: Node = this; n._flex_dir = d; n._has_flex_dir = true; return n; }
    fn grid_span(take this, cols: i32, rows: i32) -> Node { var n: Node = this; n._grid_col_span = cols; n._grid_row_span = rows; return n; }
    fn grid_pos(take this, col: i32, row: i32) -> Node { var n: Node = this; n._grid_col_start = col; n._grid_row_start = row; return n; }
    fn grid_subgrid(take this, cols: bool, rows: bool) -> Node { var n: Node = this; n._grid_cols_subgrid = cols; n._grid_rows_subgrid = rows; return n; }
    // Border as a layout inset (reserves space, like padding — distinct from the
    // Style border paint).
    fn border_inset(take this, e: flex::Edge, v: f64) -> Node { var n: Node = this; n.bdr_edge_into(e, v); return n; }
    // Logical (direction-relative) padding/margin: start = leading edge (left in
    // LTR, right in RTL). Physical edges win if also set (flex rule).
    fn padding_start(take this, v: f64) -> Node { var n: Node = this; n._pad_start = v; return n; }
    fn padding_end(take this, v: f64) -> Node { var n: Node = this; n._pad_end = v; return n; }
    fn margin_start(take this, v: f64) -> Node { var n: Node = this; n._mrg_start = v; return n; }
    fn margin_end(take this, v: f64) -> Node { var n: Node = this; n._mrg_end = v; return n; }

    fn set_grid_subgrid(ref this, cols: bool, rows: bool) { this._grid_cols_subgrid = cols; this._grid_rows_subgrid = rows; return; }
    fn set_border_inset(ref this, e: flex::Edge, v: f64) { this.bdr_edge_into(e, v); return; }
    fn set_padding_start(ref this, v: f64) { this._pad_start = v; return; }
    fn set_padding_end(ref this, v: f64) { this._pad_end = v; return; }
    fn set_margin_start(ref this, v: f64) { this._mrg_start = v; return; }
    fn set_margin_end(ref this, v: f64) { this._mrg_end = v; return; }

    fn bdr_edge_into(ref this, e: flex::Edge, v: f64) {
        match e {
            flex::Edge::Left => { this._bdr_l = v; }
            flex::Edge::Right => { this._bdr_r = v; }
            flex::Edge::Top => { this._bdr_t = v; }
            flex::Edge::Bottom => { this._bdr_b = v; }
            flex::Edge::Start => { this._bdr_l = v; }
            flex::Edge::End => { this._bdr_r = v; }
            flex::Edge::Horizontal => { this._bdr_l = v; this._bdr_r = v; }
            flex::Edge::Vertical => { this._bdr_t = v; this._bdr_b = v; }
            flex::Edge::All => { this._bdr_l = v; this._bdr_t = v; this._bdr_r = v; this._bdr_b = v; }
        }
        return;
    }

    fn set_width_pct(ref this, v: f64) { this._width_pct = v; return; }
    fn set_height_pct(ref this, v: f64) { this._height_pct = v; return; }
    fn set_gap_row(ref this, v: f64) { this._gap_row = v; return; }
    fn set_gap_col(ref this, v: f64) { this._gap_col = v; return; }
    fn set_display(ref this, d: flex::Display) { this._display = d; this._has_display = true; return; }
    fn set_overflow(ref this, o: flex::Overflow) { this._overflow = o; this._has_overflow = true; return; }
    fn set_align_content(ref this, a: flex::Align) { this._align_content = a; this._has_align_content = true; return; }
    fn set_direction(ref this, d: flex::Direction) { this._direction = d; this._has_direction = true; return; }
    fn set_box_sizing(ref this, b: flex::BoxSizing) { this._box_sizing = b; this._has_box_sizing = true; return; }
    fn set_flex_direction(ref this, d: flex::FlexDirection) { this._flex_dir = d; this._has_flex_dir = true; return; }
    fn set_grid_span(ref this, cols: i32, rows: i32) { this._grid_col_span = cols; this._grid_row_span = rows; return; }
    fn set_grid_pos(ref this, col: i32, row: i32) { this._grid_col_start = col; this._grid_row_start = row; return; }

    fn set_flex_basis(ref this, v: f64) { this._basis = v; return; }
    fn set_aspect_ratio(ref this, v: f64) { this._aspect = v; return; }
    fn set_flex_wrap(ref this, w: flex::Wrap) { this._wrap = w; this._has_wrap = true; return; }
    fn set_position_absolute(ref this) { this._position_type = flex::PositionType::Absolute; this._has_position_type = true; return; }
    fn set_margin(ref this, v: f64) { this._mrg_l = v; this._mrg_t = v; this._mrg_r = v; this._mrg_b = v; return; }
    fn set_margin_edge(ref this, e: flex::Edge, v: f64) { this.mrg_edge_into(e, v); return; }
    fn set_inset(ref this, e: flex::Edge, v: f64) { this.inset_into(e, v); return; }

    fn mrg_edge_into(ref this, e: flex::Edge, v: f64) {
        match e {
            flex::Edge::Left => { this._mrg_l = v; }
            flex::Edge::Right => { this._mrg_r = v; }
            flex::Edge::Top => { this._mrg_t = v; }
            flex::Edge::Bottom => { this._mrg_b = v; }
            flex::Edge::Start => { this._mrg_l = v; }
            flex::Edge::End => { this._mrg_r = v; }
            flex::Edge::Horizontal => { this._mrg_l = v; this._mrg_r = v; }
            flex::Edge::Vertical => { this._mrg_t = v; this._mrg_b = v; }
            flex::Edge::All => { this._mrg_l = v; this._mrg_t = v; this._mrg_r = v; this._mrg_b = v; }
        }
        return;
    }

    // Set an absolute inset edge + mark its mask bit (0 is a valid inset).
    fn inset_into(ref this, e: flex::Edge, v: f64) {
        match e {
            flex::Edge::Left => { this._ins_l = v; this._inset_mask = this._inset_mask | (1 as u32); }
            flex::Edge::Right => { this._ins_r = v; this._inset_mask = this._inset_mask | (4 as u32); }
            flex::Edge::Top => { this._ins_t = v; this._inset_mask = this._inset_mask | (2 as u32); }
            flex::Edge::Bottom => { this._ins_b = v; this._inset_mask = this._inset_mask | (8 as u32); }
            flex::Edge::Start => { this._ins_l = v; this._inset_mask = this._inset_mask | (1 as u32); }
            flex::Edge::End => { this._ins_r = v; this._inset_mask = this._inset_mask | (4 as u32); }
            flex::Edge::Horizontal => { this._ins_l = v; this._ins_r = v; this._inset_mask = this._inset_mask | (5 as u32); }
            flex::Edge::Vertical => { this._ins_t = v; this._ins_b = v; this._inset_mask = this._inset_mask | (10 as u32); }
            flex::Edge::All => { this._ins_l = v; this._ins_t = v; this._ins_r = v; this._ins_b = v; this._inset_mask = 15 as u32; }
        }
        return;
    }
}

// ---- the DSL builder contract ----------------------------------------------

struct Builder {
    children: vec::Vec[Node],
}

impl Builder {
    fn new() -> Builder {
        return Builder { children: vec::new::[Node]() };
    }

    fn add(ref this, take item: Node) {
        this.children.append(item);
        return;
    }

    // The block's value: a plain column of its top-level items.
    fn finish(take this) -> Node {
        let Builder { children } = this;
        var n: Node = blank(kind_column());
        n.children = children;
        return n;
    }
}

// ---- containers --------------------------------------------------------------
// The HIG presets mirror flex_layout's: 8pt between related items, 16pt card
// padding, 20pt screen margins.

fn column(take b: Builder) -> Node {
    let Builder { children } = b;
    var n: Node = blank(kind_column());
    n.children = children;
    return n;
}

fn row(take b: Builder) -> Node {
    let Builder { children } = b;
    var n: Node = blank(kind_row());
    n.children = children;
    return n;
}

fn vstack(take b: Builder) -> Node {
    var n: Node = column(b);
    n._gap = flex::HIG_SPACE_S;
    return n;
}

fn hstack(take b: Builder) -> Node {
    var n: Node = row(b);
    n._gap = flex::HIG_SPACE_S;
    return n;
}

// Overlay stack. The first child stays in flow and sizes the stack; the rest
// are taken out of flow and pinned to the leading corner (top-left), so they
// overlay without shifting layout. An overlay child can position itself
// (`.inset(...)` / `.position_absolute()`) — e.g. a badge at the top-right —
// and mount honors that instead of the default corner.
fn zstack(take b: Builder) -> Node {
    let Builder { children } = b;
    var n: Node = blank(kind_zstack());
    n.children = children;
    return n;
}

fn screen(take b: Builder) -> Node {
    var n: Node = column(b);
    n._gap = flex::HIG_SPACE_S;
    n._padding = flex::HIG_SPACE_L;
    return n;
}

fn card(take b: Builder) -> Node {
    var n: Node = column(b);
    n._gap = flex::HIG_SPACE_S;
    n._padding = flex::HIG_SPACE_M;
    return n;
}

// Wrapper kinds — content lives in `children`; mount recurses then hands the
// mounted flex nodes to the backend op.

// Bordered box around one (or more) children. Prefer a single child; multiple
// children are mounted as a column by the backend adapter if needed — the
// description stores them as-is and mount passes children[0] for the one-content
// vtable op (compose with column{} when wrapping several).
fn bordered(take b: Builder, radius: f64 = 6.0f64) -> Node {
    let Builder { children } = b;
    var n: Node = blank(kind_bordered());
    n.children = children;
    n.radius = radius;
    return n;
}

// A translucent vibrancy panel (macOS material). Wraps its content in a
// VisualEffectView backing; other backends fall back to a plain container.
fn material(take b: Builder) -> Node {
    let Builder { children } = b;
    var n: Node = blank(kind_material());
    n.children = children;
    return n;
}

// Clickable wrapper: gesture handlers on the node, content in children[0].
// Primary click lands in `click` (same field as button); optional gestures
// use the null-fn sentinel when unset.
fn clickable(
    take b: Builder,
    on_click: fn(*u8, *u8) = 0 as fn(*u8, *u8),
    on_double_click: fn(*u8, *u8) = 0 as fn(*u8, *u8),
    on_right_click: fn(*u8, *u8) = 0 as fn(*u8, *u8),
    on_long_press: fn(*u8, *u8) = 0 as fn(*u8, *u8),
    long_press_seconds: f64 = 0.0f64,
    on_drag: fn(*u8, *u8) = 0 as fn(*u8, *u8),
    on_pinch: fn(*u8, *u8) = 0 as fn(*u8, *u8),
    on_rotate: fn(*u8, *u8) = 0 as fn(*u8, *u8),
    on_hover_in: fn(*u8, *u8) = 0 as fn(*u8, *u8),
    on_hover_out: fn(*u8, *u8) = 0 as fn(*u8, *u8),
    on_scroll: fn(*u8, *u8) = 0 as fn(*u8, *u8),
    ctx: *u8 = 0 as *u8,
) -> Node {
    let Builder { children } = b;
    var n: Node = blank(kind_clickable());
    n.children = children;
    // Only overwrite `click` when a handler was supplied (null-fn → leave noop).
    if on_click != null_fn() {
        n.click = on_click;
    }
    n.on_double_click = on_double_click;
    n.on_right_click = on_right_click;
    n.on_long_press = on_long_press;
    n.long_press_seconds = long_press_seconds;
    n.on_drag = on_drag;
    n.on_pinch = on_pinch;
    n.on_rotate = on_rotate;
    n.on_hover_in = on_hover_in;
    n.on_hover_out = on_hover_out;
    n.on_scroll = on_scroll;
    n.click_ctx = ctx;
    return n;
}

// A scrolling container. Children are laid out (as a column) and hosted in the
// backend's scroll view; content taller than the viewport scrolls. The backend
// sizes content two-phase (at the viewport width, after the outer layout).
fn scroll(take b: Builder) -> Node {
    let Builder { children } = b;
    var n: Node = blank(kind_scroll());
    n.children = children;
    return n;
}

// Two-pane split. Expects exactly two children (first / second pane).
fn split(
    take b: Builder,
    vertical: bool = true,
    position: f64 = 220.0f64,
    min_first: f64 = 150.0f64,
    min_second: f64 = 240.0f64,
) -> Node {
    let Builder { children } = b;
    var n: Node = blank(kind_split());
    n.children = children;
    n.vertical = vertical;
    n.position = position;
    n.min_first = min_first;
    n.min_second = min_second;
    return n;
}

// ---- the Renderer vtable + mount ---------------------------------------------
// Write-once walk: containers and layout props are pure flex_layout, built
// here; widget kinds dispatch through the vtable. Each leaf op receives the
// backend context and the node (for its text/config/handlers) and returns a
// flex node whose payload is the native widget. Wrapper ops additionally take
// already-mounted content (`take` ownership marker is part of the fn-ptr type).
// After every widget-producing op, mount calls set_identity — the single choke
// point for agent id + role (backends pin native metadata there).
//
// ============================================================================
// THE CONTRACT (frozen). This struct + `Style`/`Color` (weight/family tokens)
// ARE the cross-backend contract. A backend is portable-by-construction: it
// fills this typed struct or it does not compile — the compiler is the parity
// check, not a doc. To add a backend (facet_gtk4 / facet_win32 / facet_uikit):
//
//   1. one op per field below — leaf ops build a native widget into a flex
//      payload; wrapper ops (bordered/clickable/split) take mounted content.
//   2. `apply_style(view, kind, Style)` — map the portable Style onto the
//      native widget (per-kind; only set fields; tokens → native colors/fonts).
//   3. `set_identity(ctx, handle, id, role)` — pin the agent id + record the
//      (role, drive) affordance for the matching agent_* reader.
//   4. the `native` op — adopt an app-owned handle (the escape hatch).
//   5. a small host — a window + an invalidate/re-mount primitive.
//
// `fake_renderer` (in the tests) is the PORTABLE CONFORMANCE TEST: it fills the
// same struct with pure-C+ stubs, so the whole description→flex pipeline is
// exercised with no platform. facet_appkit is the reference implementation;
// facet_gtk is a second, type-checked-only backend proving the shape is not
// AppKit-specific. `symbol` is PROVISIONAL — an SF-Symbol Apple-ism with no
// portable meaning yet; don't freeze it as portable (a backend maps a themed
// icon set). Growing the API = +1 kind constant, +1 field here, +1 constructor;
// every backend then fails to compile until it supplies the op — the honest,
// localized gap.
// ============================================================================

struct Renderer {
    opaque ctx: *u8,
    // leaves
    label:       fn(*u8, *Node) -> flex::Node,
    wrap_label:  fn(*u8, *Node) -> flex::Node,
    button:      fn(*u8, *Node) -> flex::Node,
    text_area:   fn(*u8, *Node) -> flex::Node,
    composer:    fn(*u8, *Node) -> flex::Node,
    code_editor: fn(*u8, *Node) -> flex::Node,
    // Tier-2 leaves (Phase 2)
    image:       fn(*u8, *Node) -> flex::Node,
    symbol:      fn(*u8, *Node) -> flex::Node,
    text_field:  fn(*u8, *Node) -> flex::Node,
    popup:       fn(*u8, *Node) -> flex::Node,
    divider:     fn(*u8, *Node) -> flex::Node,
    // Form controls (matrix §2)
    toggle:      fn(*u8, *Node) -> flex::Node,
    slider:      fn(*u8, *Node) -> flex::Node,
    progress:    fn(*u8, *Node) -> flex::Node,
    stepper:     fn(*u8, *Node) -> flex::Node,
    secure_field: fn(*u8, *Node) -> flex::Node,
    segmented:   fn(*u8, *Node) -> flex::Node,
    color_picker: fn(*u8, *Node) -> flex::Node,
    date_picker: fn(*u8, *Node) -> flex::Node,
    box:         fn(*u8, *Node) -> flex::Node,
    gauge:       fn(*u8, *Node) -> flex::Node,
    path:        fn(*u8, *Node) -> flex::Node,
    // The escape hatch (Phase 3)
    native:      fn(*u8, *Node) -> flex::Node,
    // wrappers — mount recurses children first, then hands them over
    bordered:    fn(*u8, *Node, take flex::Node) -> flex::Node,
    clickable:   fn(*u8, *Node, take flex::Node) -> flex::Node,
    scroll:      fn(*u8, *Node, take flex::Node) -> flex::Node,
    material:    fn(*u8, *Node, take flex::Node) -> flex::Node,
    split:       fn(*u8, *Node, take flex::Node, take flex::Node) -> flex::Node,
    // called by mount after every widget-producing op
    set_identity: fn(*u8, *u8, str, u32),  // (ctx, handle, id, role)
}

// Pin agent id + role after a widget op. Handle is the op's nominated identity
// surface — by default the returned flex node's payload. Backends where the
// drive target differs from the layout payload (composer/code_editor inner
// text view vs outer scroll) resolve that inside set_identity itself.
fn call_set_identity(np: *Node, r: Renderer, handle: *u8, kind: u32) {
    let f: fn(*u8, *u8, str, u32) = r.set_identity;
    let id: str = { (*np).agent_id.view() };
    f(r.ctx, handle, id, role_for_kind(kind));
    return;
}

fn mount_child_at(np: *Node, r: Renderer, idx: usize) -> flex::Node {
    match { (*np).children.at_ptr(idx) } {
        option::Option[*Node]::Some(cp) => { return mount(cp, r); }
        option::Option[*Node]::None => { return flex::Node::new(); }
    }
}

// Wrapper content: 0 kids → empty; 1 kid → that child; 2+ kids → portable
// column of all children (so bordered/clickable never silently drop extras).
fn mount_wrapper_content(np: *Node, r: Renderer) -> flex::Node {
    let cnt: usize = { (*np).children.count() };
    if cnt == (0 as usize) { return flex::Node::new(); }
    if cnt == (1 as usize) { return mount_child_at(np, r, 0 as usize); }
    var col: flex::Node = flex::Node::new();
    var i: usize = 0 as usize;
    while i < cnt {
        col.add_child(mount_child_at(np, r, i));
        i = i +% (1 as usize);
    }
    return col;
}

fn mount(np: *Node, r: Renderer) -> flex::Node {
    let k: u32 = { (*np).kind };
    var n: flex::Node = flex::Node::new();
    var is_widget: bool = false;
    if k == kind_label() {
        let f: fn(*u8, *Node) -> flex::Node = r.label;
        n = f(r.ctx, np);
        is_widget = true;
    } else if k == kind_wrap_label() {
        let f: fn(*u8, *Node) -> flex::Node = r.wrap_label;
        n = f(r.ctx, np);
        is_widget = true;
    } else if k == kind_button() {
        let f: fn(*u8, *Node) -> flex::Node = r.button;
        n = f(r.ctx, np);
        is_widget = true;
    } else if k == kind_text_area() {
        let f: fn(*u8, *Node) -> flex::Node = r.text_area;
        n = f(r.ctx, np);
        is_widget = true;
    } else if k == kind_composer() {
        let f: fn(*u8, *Node) -> flex::Node = r.composer;
        n = f(r.ctx, np);
        is_widget = true;
    } else if k == kind_code_editor() {
        let f: fn(*u8, *Node) -> flex::Node = r.code_editor;
        n = f(r.ctx, np);
        is_widget = true;
    } else if k == kind_image() {
        let f: fn(*u8, *Node) -> flex::Node = r.image;
        n = f(r.ctx, np);
        is_widget = true;
    } else if k == kind_symbol() {
        let f: fn(*u8, *Node) -> flex::Node = r.symbol;
        n = f(r.ctx, np);
        is_widget = true;
    } else if k == kind_text_field() {
        let f: fn(*u8, *Node) -> flex::Node = r.text_field;
        n = f(r.ctx, np);
        is_widget = true;
    } else if k == kind_popup() {
        let f: fn(*u8, *Node) -> flex::Node = r.popup;
        n = f(r.ctx, np);
        is_widget = true;
    } else if k == kind_divider() {
        let f: fn(*u8, *Node) -> flex::Node = r.divider;
        n = f(r.ctx, np);
        is_widget = true;
    } else if k == kind_toggle() {
        let f: fn(*u8, *Node) -> flex::Node = r.toggle;
        n = f(r.ctx, np);
        is_widget = true;
    } else if k == kind_slider() {
        let f: fn(*u8, *Node) -> flex::Node = r.slider;
        n = f(r.ctx, np);
        is_widget = true;
    } else if k == kind_progress() {
        let f: fn(*u8, *Node) -> flex::Node = r.progress;
        n = f(r.ctx, np);
        is_widget = true;
    } else if k == kind_stepper() {
        let f: fn(*u8, *Node) -> flex::Node = r.stepper;
        n = f(r.ctx, np);
        is_widget = true;
    } else if k == kind_secure_field() {
        let f: fn(*u8, *Node) -> flex::Node = r.secure_field;
        n = f(r.ctx, np);
        is_widget = true;
    } else if k == kind_segmented() {
        let f: fn(*u8, *Node) -> flex::Node = r.segmented;
        n = f(r.ctx, np);
        is_widget = true;
    } else if k == kind_color_picker() {
        let f: fn(*u8, *Node) -> flex::Node = r.color_picker;
        n = f(r.ctx, np);
        is_widget = true;
    } else if k == kind_date_picker() {
        let f: fn(*u8, *Node) -> flex::Node = r.date_picker;
        n = f(r.ctx, np);
        is_widget = true;
    } else if k == kind_box() {
        let f: fn(*u8, *Node) -> flex::Node = r.box;
        n = f(r.ctx, np);
        is_widget = true;
    } else if k == kind_gauge() {
        let f: fn(*u8, *Node) -> flex::Node = r.gauge;
        n = f(r.ctx, np);
        is_widget = true;
    } else if k == kind_path() {
        let f: fn(*u8, *Node) -> flex::Node = r.path;
        n = f(r.ctx, np);
        is_widget = true;
    } else if k == kind_native() {
        let f: fn(*u8, *Node) -> flex::Node = r.native;
        n = f(r.ctx, np);
        is_widget = true;
    } else if k == kind_bordered() {
        let content: flex::Node = mount_wrapper_content(np, r);
        let f: fn(*u8, *Node, take flex::Node) -> flex::Node = r.bordered;
        n = f(r.ctx, np, content);
        is_widget = true;
    } else if k == kind_clickable() {
        let content: flex::Node = mount_wrapper_content(np, r);
        let f: fn(*u8, *Node, take flex::Node) -> flex::Node = r.clickable;
        n = f(r.ctx, np, content);
        is_widget = true;
    } else if k == kind_scroll() {
        let content: flex::Node = mount_wrapper_content(np, r);
        let f: fn(*u8, *Node, take flex::Node) -> flex::Node = r.scroll;
        n = f(r.ctx, np, content);
        is_widget = true;
    } else if k == kind_material() {
        let content: flex::Node = mount_wrapper_content(np, r);
        let f: fn(*u8, *Node, take flex::Node) -> flex::Node = r.material;
        n = f(r.ctx, np, content);
        is_widget = true;
    } else if k == kind_split() {
        let first: flex::Node = mount_child_at(np, r, 0 as usize);
        let second: flex::Node = mount_child_at(np, r, 1 as usize);
        let f: fn(*u8, *Node, take flex::Node, take flex::Node) -> flex::Node = r.split;
        n = f(r.ctx, np, first, second);
        is_widget = true;
    } else if k == kind_spacer() {
        // pure layout; `_grow = 1` from the constructor applies below.
    } else if k == kind_zstack() {
        // Overlay: child 0 stays in flow (sizes the stack); children 1+ are
        // taken out of flow and pinned to the leading corner unless they
        // positioned themselves.
        let cnt: usize = { (*np).children.count() };
        for i in 0..(cnt as i32) {
            match { (*np).children.at_ptr(i as usize) } {
                option::Option[*Node]::Some(cp) => {
                    var cf: flex::Node = mount(cp, r);
                    if i >= (1 as i32) {
                        if { (*cp)._has_position_type } == false {
                            cf.set_position_type(flex::PositionType::Absolute);
                            if { (*cp)._inset_mask } == (0 as u32) {
                                cf.set_position(flex::Edge::Left, flex::StyleLength::points(0.0f64));
                                cf.set_position(flex::Edge::Top, flex::StyleLength::points(0.0f64));
                            }
                        }
                    }
                    n.add_child(cf);
                }
                option::Option[*Node]::None => { }
            }
        }
    } else if k == kind_grid() {
        // CSS grid: N equal (1fr) columns; children auto-flow into cells.
        n.set_display(flex::Display::Grid);
        var gc: i32 = { (*np).grid_cols };
        if gc < (1 as i32) { gc = 1 as i32; }
        var c: i32 = 0 as i32;
        while c < gc {
            n.add_grid_column(flex::GridTrack::fr(1.0f64));
            c = c + 1;
        }
        let cnt: usize = { (*np).children.count() };
        for i in 0..(cnt as i32) {
            match { (*np).children.at_ptr(i as usize) } {
                option::Option[*Node]::Some(cp) => { n.add_child(mount(cp, r)); }
                option::Option[*Node]::None => { }
            }
        }
    } else {
        if k == kind_row() { n.set_flex_direction(flex::FlexDirection::Row); }
        let cnt: usize = { (*np).children.count() };
        for i in 0..(cnt as i32) {
            match { (*np).children.at_ptr(i as usize) } {
                option::Option[*Node]::Some(cp) => { n.add_child(mount(cp, r)); }
                option::Option[*Node]::None => { }
            }
        }
    }
    if is_widget {
        call_set_identity(np, r, n.payload(), k);
    }
    // Layout props — applied uniformly, whatever built the node.
    if { (*np)._grow } > 0.0f64 { n.set_flex_grow({ (*np)._grow }); }
    if { (*np)._gap } > 0.0f64 { n.set_gap(flex::Gutter::All, { (*np)._gap }); }
    if { (*np)._padding } > 0.0f64 {
        n.set_padding(flex::Edge::All, flex::StyleLength::points({ (*np)._padding }));
    }
    if { (*np)._width } >= 0.0f64 { n.set_width(flex::StyleLength::points({ (*np)._width })); }
    if { (*np)._height } >= 0.0f64 { n.set_height(flex::StyleLength::points({ (*np)._height })); }
    // Extended flexbox props (pass-through). Per-edge padding runs AFTER the
    // uniform `_padding` above, so a specific edge overrides it.
    if { (*np)._has_align_items } { n.set_align_items({ (*np)._align_items }); }
    if { (*np)._has_align_self } { n.set_align_self({ (*np)._align_self }); }
    if { (*np)._has_justify } { n.set_justify_content({ (*np)._justify }); }
    if { (*np)._shrink } >= 0.0f64 { n.set_flex_shrink({ (*np)._shrink }); }
    if { (*np)._min_w } >= 0.0f64 { n.set_min_width(flex::StyleLength::points({ (*np)._min_w })); }
    if { (*np)._min_h } >= 0.0f64 { n.set_min_height(flex::StyleLength::points({ (*np)._min_h })); }
    if { (*np)._max_w } >= 0.0f64 { n.set_max_width(flex::StyleLength::points({ (*np)._max_w })); }
    if { (*np)._max_h } >= 0.0f64 { n.set_max_height(flex::StyleLength::points({ (*np)._max_h })); }
    if { (*np)._pad_l } > 0.0f64 { n.set_padding(flex::Edge::Left, flex::StyleLength::points({ (*np)._pad_l })); }
    if { (*np)._pad_t } > 0.0f64 { n.set_padding(flex::Edge::Top, flex::StyleLength::points({ (*np)._pad_t })); }
    if { (*np)._pad_r } > 0.0f64 { n.set_padding(flex::Edge::Right, flex::StyleLength::points({ (*np)._pad_r })); }
    if { (*np)._pad_b } > 0.0f64 { n.set_padding(flex::Edge::Bottom, flex::StyleLength::points({ (*np)._pad_b })); }
    if { (*np)._basis } >= 0.0f64 { n.set_flex_basis(flex::StyleLength::points({ (*np)._basis })); }
    if { (*np)._aspect } >= 0.0f64 { n.set_aspect_ratio({ (*np)._aspect }); }
    if { (*np)._has_wrap } { n.set_flex_wrap({ (*np)._wrap }); }
    if { (*np)._has_position_type } { n.set_position_type({ (*np)._position_type }); }
    if { (*np)._mrg_l } > 0.0f64 { n.set_margin(flex::Edge::Left, flex::StyleLength::points({ (*np)._mrg_l })); }
    if { (*np)._mrg_t } > 0.0f64 { n.set_margin(flex::Edge::Top, flex::StyleLength::points({ (*np)._mrg_t })); }
    if { (*np)._mrg_r } > 0.0f64 { n.set_margin(flex::Edge::Right, flex::StyleLength::points({ (*np)._mrg_r })); }
    if { (*np)._mrg_b } > 0.0f64 { n.set_margin(flex::Edge::Bottom, flex::StyleLength::points({ (*np)._mrg_b })); }
    // Absolute insets — apply each masked edge (0 is a valid inset value).
    let im: u32 = { (*np)._inset_mask };
    if (im & (1 as u32)) != (0 as u32) { n.set_position(flex::Edge::Left, flex::StyleLength::points({ (*np)._ins_l })); }
    if (im & (2 as u32)) != (0 as u32) { n.set_position(flex::Edge::Top, flex::StyleLength::points({ (*np)._ins_t })); }
    if (im & (4 as u32)) != (0 as u32) { n.set_position(flex::Edge::Right, flex::StyleLength::points({ (*np)._ins_r })); }
    if (im & (8 as u32)) != (0 as u32) { n.set_position(flex::Edge::Bottom, flex::StyleLength::points({ (*np)._ins_b })); }
    // Percent size overrides the point size when set.
    if { (*np)._width_pct } >= 0.0f64 { n.set_width(flex::StyleLength::percent({ (*np)._width_pct })); }
    if { (*np)._height_pct } >= 0.0f64 { n.set_height(flex::StyleLength::percent({ (*np)._height_pct })); }
    // Per-gutter gap (distinct row/column) — overrides uniform gap for that axis.
    if { (*np)._gap_row } > 0.0f64 { n.set_gap(flex::Gutter::Row, { (*np)._gap_row }); }
    if { (*np)._gap_col } > 0.0f64 { n.set_gap(flex::Gutter::Column, { (*np)._gap_col }); }
    // Container props.
    if { (*np)._has_display } { n.set_display({ (*np)._display }); }
    if { (*np)._has_overflow } { n.set_overflow({ (*np)._overflow }); }
    if { (*np)._has_align_content } { n.set_align_content({ (*np)._align_content }); }
    if { (*np)._has_direction } { n.set_direction({ (*np)._direction }); }
    if { (*np)._has_box_sizing } { n.set_box_sizing({ (*np)._box_sizing }); }
    // Explicit flex-direction (e.g. RowReverse/ColumnReverse) overrides the kind.
    if { (*np)._has_flex_dir } { n.set_flex_direction({ (*np)._flex_dir }); }
    // Grid child placement (set on the item; the grid container flows the rest).
    if { (*np)._grid_col_span } > (0 as i32) { n.set_grid_column_span({ (*np)._grid_col_span }); }
    if { (*np)._grid_row_span } > (0 as i32) { n.set_grid_row_span({ (*np)._grid_row_span }); }
    if { (*np)._grid_col_start } > (0 as i32) { n.set_grid_column_start({ (*np)._grid_col_start }); }
    if { (*np)._grid_row_start } > (0 as i32) { n.set_grid_row_start({ (*np)._grid_row_start }); }
    if { (*np)._grid_cols_subgrid } { n.set_grid_columns_subgrid(true); }
    if { (*np)._grid_rows_subgrid } { n.set_grid_rows_subgrid(true); }
    // Border-as-inset (reserves layout space, per edge).
    if { (*np)._bdr_l } > 0.0f64 { n.set_border(flex::Edge::Left, flex::StyleLength::points({ (*np)._bdr_l })); }
    if { (*np)._bdr_t } > 0.0f64 { n.set_border(flex::Edge::Top, flex::StyleLength::points({ (*np)._bdr_t })); }
    if { (*np)._bdr_r } > 0.0f64 { n.set_border(flex::Edge::Right, flex::StyleLength::points({ (*np)._bdr_r })); }
    if { (*np)._bdr_b } > 0.0f64 { n.set_border(flex::Edge::Bottom, flex::StyleLength::points({ (*np)._bdr_b })); }
    // Logical (direction-relative) padding/margin — flex resolves Start/End.
    if { (*np)._pad_start } > 0.0f64 { n.set_padding(flex::Edge::Start, flex::StyleLength::points({ (*np)._pad_start })); }
    if { (*np)._pad_end } > 0.0f64 { n.set_padding(flex::Edge::End, flex::StyleLength::points({ (*np)._pad_end })); }
    if { (*np)._mrg_start } > 0.0f64 { n.set_margin(flex::Edge::Start, flex::StyleLength::points({ (*np)._mrg_start })); }
    if { (*np)._mrg_end } > 0.0f64 { n.set_margin(flex::Edge::End, flex::StyleLength::points({ (*np)._mrg_end })); }
    return n;
}

// ---- tests -------------------------------------------------------------------
// Pure C+ throughout — a fake Renderer stands in for a platform, so the whole
// description -> flex pipeline is testable everywhere. The literal `@facet`
// surface runs in src/test_main.cplus (a module cannot be its own context).

fn approx(a: f64, b: f64) -> bool {
    let d: f64 = a - b;
    if d < 0.0f64 { return (0.0f64 - d) < 0.01f64; }
    return d < 0.01f64;
}

#[test]
fn facet_leaf_ctors_set_kind_and_config() {
    let l: Node = label("Hello", size: 28.0f64, bold: true);
    assert l.kind == kind_label();
    assert approx(l.font_size, 28.0f64);
    assert l.bold;
    assert l.secondary == false;

    let b: Node = button("OK", primary: true);
    assert b.kind == kind_button();
    assert b.primary;

    let s: Node = spacer();
    assert s.kind == kind_spacer();
    assert approx(s._grow, 1.0f64);

    let ta: Node = text_area(placeholder: "hint", value: "hi");
    assert ta.kind == kind_text_area();
    assert ta.placeholder.view() == "hint";
    assert ta.value.view() == "hi";

    let ce: Node = code_editor(value: "fn main() {}", editable: false, size: 14.0f64);
    assert ce.kind == kind_code_editor();
    assert ce.editable == false;
    assert approx(ce.font_size, 14.0f64);
}

#[test]
fn facet_presets_carry_hig_props() {
    var b: Builder = Builder::new();
    b.add(label("x"));
    let v: Node = vstack(b);
    assert v.kind == kind_column();
    assert approx(v._gap, 8.0f64);

    var cb: Builder = Builder::new();
    cb.add(label("y"));
    let c: Node = card(cb);
    assert approx(c._gap, 8.0f64);
    assert approx(c._padding, 16.0f64);

    var sb: Builder = Builder::new();
    sb.add(label("z"));
    let s: Node = screen(sb);
    assert approx(s._padding, 20.0f64);
}

#[test]
fn facet_builder_accumulates_and_finishes_as_column() {
    var b: Builder = Builder::new();
    b.add(label("A"));
    b.add(button("B"));
    let root: Node = b.finish();
    assert root.kind == kind_column();
    assert root.children.count() == (2 as usize);
}

fn click_a(sender: *u8, ctx: *u8) { return; }

#[test]
fn facet_modifiers_fluent_and_set_agree() {
    let f: Node = label("x").grow(2.0f64).padding(4.0f64).width(50.0f64);
    assert approx(f._grow, 2.0f64);
    assert approx(f._padding, 4.0f64);
    assert approx(f._width, 50.0f64);

    var m: Node = label("y");
    m.set_grow(2.0f64);
    m.set_padding(4.0f64);
    m.set_width(50.0f64);
    assert approx(m._grow, f._grow);
    assert approx(m._padding, f._padding);
    assert approx(m._width, f._width);
}

#[test]
fn facet_on_click_carries_identity() {
    let n: Node = button("del").on_click(click_a, ctx: 7 as *u8);
    assert n.click != noop;
    assert (n.click_ctx as i64) == (7 as i64);
    // ctx defaults to null when omitted.
    let m: Node = button("ok").on_click(click_a);
    assert (m.click_ctx as i64) == (0 as i64);
}

#[test]
fn facet_tooltip_and_a11y_label() {
    let n: Node = label("Save").tooltip("Save the file").accessibility_label("Save button");
    assert n.tooltip.view() == "Save the file";
    assert n.a11y_label.view() == "Save button";
    let plain: Node = label("x");
    assert plain.tooltip.view() == "";        // default none
    assert plain.a11y_label.view() == "";
}

#[test]
fn facet_new_kind_ctors_and_wrappers() {
    let c: Node = composer(on_submit: click_a, value: "draft", show_border: false);
    assert c.kind == kind_composer();
    assert c.on_submit != null_fn();
    assert c.value.view() == "draft";
    assert c.show_border == false;
    assert c.draws_background;  // default

    var bb: Builder = Builder::new();
    bb.add(label("in-box"));
    let br: Node = bordered(bb, radius: 8.0f64);
    assert br.kind == kind_bordered();
    assert approx(br.radius, 8.0f64);
    assert br.children.count() == (1 as usize);

    var cb: Builder = Builder::new();
    cb.add(label("row"));
    let cl: Node = clickable(cb, on_click: click_a, ctx: 3 as *u8);
    assert cl.kind == kind_clickable();
    assert cl.click != noop;
    assert (cl.click_ctx as i64) == (3 as i64);

    var sb: Builder = Builder::new();
    sb.add(label("left"));
    sb.add(label("right"));
    let sp: Node = split(sb, position: 180.0f64);
    assert sp.kind == kind_split();
    assert approx(sp.position, 180.0f64);
    assert sp.children.count() == (2 as usize);
}

#[test]
fn facet_role_for_kind_table() {
    assert role_for_kind(kind_button()) == role_button();
    assert role_for_kind(kind_clickable()) == role_button();
    assert role_for_kind(kind_label()) == role_text();
    assert role_for_kind(kind_wrap_label()) == role_text();
    assert role_for_kind(kind_composer()) == role_input();
    assert role_for_kind(kind_text_area()) == role_input();
    assert role_for_kind(kind_code_editor()) == role_input();
    assert role_for_kind(kind_bordered()) == role_group();
    assert role_for_kind(kind_split()) == role_group();
}

#[test]
fn facet_style_modifiers_set_only_their_field() {
    // blank starts fully unset — apply_style must skip everything.
    let plain: Node = label("x");
    assert plain.style.fg.is_set() == false;
    assert plain.style.bg.is_set() == false;
    assert approx(plain.style.corner_radius, 0.0f64);
    assert plain.style.weight == (0 as u32);

    // each modifier sets exactly its field, leaves the rest unset.
    let styled: Node = label("x")
        .foreground_color(Color::secondary())
        .background(Color::rgba(0.1f64, 0.2f64, 0.3f64, 1.0f64))
        .corner_radius(8.0f64);
    assert styled.style.fg.is_set();
    assert styled.style.fg.token == (2 as u32);      // secondary token
    assert styled.style.bg.token == (255 as u32);    // rgba token
    assert approx(styled.style.bg.b, 0.3f64);
    assert approx(styled.style.corner_radius, 8.0f64);
    assert styled.style.border_width < 0.001f64;     // untouched
    assert styled.style.weight == (0 as u32);        // untouched
}

#[test]
fn facet_font_and_frame_modifiers() {
    // .font/.weight/.strong/.monospaced ride the Style font channel.
    let a: Node = label("x").font(20.0f64).weight(weight_semibold());
    assert approx(a.style.font_size, 20.0f64);
    assert a.style.weight == weight_semibold();

    let b: Node = label("x").strong();
    assert b.style.weight == weight_bold();

    let c: Node = code_editor(value: "y").monospaced();
    assert c.style.family == family_monospace();

    // .frame sets both fixed dimensions; fluent and set_* agree.
    let f: Node = label("x").frame(120.0f64, 44.0f64);
    assert approx(f._width, 120.0f64);
    assert approx(f._height, 44.0f64);
    var m: Node = label("x");
    m.set_frame(120.0f64, 44.0f64);
    assert approx(m._width, f._width);
    assert approx(m._height, f._height);
}

#[test]
fn facet_tier2_ctors_set_kind_and_config() {
    let im: Node = image("/tmp/logo.png");
    assert im.kind == kind_image();
    assert im.value.view() == "/tmp/logo.png";

    let sy: Node = symbol("folder", size: 20.0f64);
    assert sy.kind == kind_symbol();
    assert sy.value.view() == "folder";
    assert approx(sy.font_size, 20.0f64);

    let tf: Node = text_field(placeholder: "name", value: "iris");
    assert tf.kind == kind_text_field();
    assert tf.placeholder.view() == "name";
    assert tf.value.view() == "iris";

    var items: vec::Vec[text::Text] = vec::new::[text::Text]();
    items.append(text::from_str("One"));
    items.append(text::from_str("Two"));
    let pu: Node = popup(items, selected: 1 as i64);
    assert pu.kind == kind_popup();
    assert pu.popup_items.count() == (2 as usize);
    assert pu.popup_selected == (1 as i64);

    let dv: Node = divider();
    assert dv.kind == kind_divider();

    // menu is a pull-down popup (same kind, a variant — no new contract slot).
    var mitems: vec::Vec[text::Text] = vec::new::[text::Text]();
    mitems.append(text::from_str("Cut"));
    mitems.append(text::from_str("Copy"));
    let mn: Node = menu("Edit", mitems, on_change: click_a);
    assert mn.kind == kind_popup();
    assert mn.pull_down;
    assert mn.text.view() == "Edit";
    assert mn.on_change != null_fn();

    // Button folds: .plain() marks the borderless variant.
    let lb: Node = button("Docs").plain().foreground_color(Color::accent());
    assert lb.plain;
    assert lb.style.fg.token == (3 as u32);   // accent
}

#[test]
fn facet_tier2_roles() {
    assert role_for_kind(kind_text_field()) == role_input();
    assert role_for_kind(kind_popup()) == role_input();
    assert role_for_kind(kind_image()) == role_group();
    assert role_for_kind(kind_symbol()) == role_group();
    assert role_for_kind(kind_divider()) == role_group();
}

#[test]
fn facet_native_hatch_carries_handle() {
    let n: Node = native(0xBEEF as *u8).frame(200.0f64, 120.0f64);
    assert n.kind == kind_native();
    assert (n.native_handle as i64) == (0xBEEF as i64);
    assert approx(n._width, 200.0f64);
    assert approx(n._height, 120.0f64);
    // A native leaf is observe-only for the agent surface.
    assert role_for_kind(kind_native()) == role_group();
}

#[test]
fn facet_flexbox_modifiers_set_fields() {
    let n: Node = label("x")
        .align_items(flex::Align::Center)
        .justify_content(flex::Justify::Center)
        .align_self(flex::Align::Stretch)
        .shrink(1.0f64)
        .min_width(0.0f64)
        .max_width(300.0f64)
        .padding_edge(flex::Edge::Right, 16.0f64);
    assert n._has_align_items;
    assert n._has_justify;
    assert n._has_align_self;
    assert approx(n._shrink, 1.0f64);
    assert approx(n._min_w, 0.0f64);     // 0 is a real value, not "unset"
    assert approx(n._max_w, 300.0f64);
    assert approx(n._pad_r, 16.0f64);
    // untouched fields stay at their sentinels / defaults.
    assert approx(n._min_h, -1.0f64);
    let plain: Node = label("y");
    assert plain._has_align_items == false;
    assert approx(plain._shrink, -1.0f64);

    // Edge::Horizontal sets both left and right; Vertical both top and bottom.
    let h: Node = label("z").padding_edge(flex::Edge::Horizontal, 8.0f64);
    assert approx(h._pad_l, 8.0f64);
    assert approx(h._pad_r, 8.0f64);
    assert approx(h._pad_t, 0.0f64);
}

// -- mount, against a fake renderer --

static FAKE_LABELS: i32 = 0;
static FAKE_BUTTONS: i32 = 0;
static FAKE_TEXT_AREAS: i32 = 0;
static FAKE_COMPOSERS: i32 = 0;
static FAKE_CODE_EDITORS: i32 = 0;
static FAKE_IMAGES: i32 = 0;
static FAKE_SYMBOLS: i32 = 0;
static FAKE_TEXT_FIELDS: i32 = 0;
static FAKE_POPUPS: i32 = 0;
static FAKE_DIVIDERS: i32 = 0;
static FAKE_TOGGLES: i32 = 0;
static FAKE_SLIDERS: i32 = 0;
static FAKE_PROGRESSES: i32 = 0;
static FAKE_STEPPERS: i32 = 0;
static FAKE_SECURE_FIELDS: i32 = 0;
static FAKE_SEGMENTEDS: i32 = 0;
static FAKE_COLOR_PICKERS: i32 = 0;
static FAKE_DATE_PICKERS: i32 = 0;
static FAKE_BOXES: i32 = 0;
static FAKE_GAUGES: i32 = 0;
static FAKE_PATHS: i32 = 0;
static FAKE_NATIVES: i32 = 0;
static FAKE_LAST_NATIVE_HANDLE: i64 = 0;
static FAKE_BORDEREDS: i32 = 0;
static FAKE_CLICKABLES: i32 = 0;
static FAKE_SCROLLS: i32 = 0;
static FAKE_MATERIALS: i32 = 0;
static FAKE_SPLITS: i32 = 0;
static FAKE_IDENTITIES: i32 = 0;
static FAKE_TAGGED_IDENTITIES: i32 = 0;
static FAKE_LAST_CTX: i64 = 0;
static FAKE_LAST_ROLE: u32 = 0;
static FAKE_LAST_ID_LEN: i32 = 0;

fn fake_label(ctx: *u8, np: *Node) -> flex::Node {
    FAKE_LABELS = FAKE_LABELS + 1;
    // A fixed intrinsic size stands in for text measurement.
    return flex::Node::new().width(40.0f64).height(10.0f64);
}

fn fake_button(ctx: *u8, np: *Node) -> flex::Node {
    FAKE_BUTTONS = FAKE_BUTTONS + 1;
    FAKE_LAST_CTX = { (*np).click_ctx } as i64;
    return flex::Node::new().width(60.0f64).height(20.0f64);
}

fn fake_text_area(ctx: *u8, np: *Node) -> flex::Node {
    FAKE_TEXT_AREAS = FAKE_TEXT_AREAS + 1;
    return flex::Node::new().width(100.0f64).height(40.0f64);
}

fn fake_composer(ctx: *u8, np: *Node) -> flex::Node {
    FAKE_COMPOSERS = FAKE_COMPOSERS + 1;
    return flex::Node::new().width(100.0f64).height(40.0f64);
}

fn fake_code_editor(ctx: *u8, np: *Node) -> flex::Node {
    FAKE_CODE_EDITORS = FAKE_CODE_EDITORS + 1;
    return flex::Node::new().width(100.0f64).height(40.0f64);
}

fn fake_image(ctx: *u8, np: *Node) -> flex::Node {
    FAKE_IMAGES = FAKE_IMAGES + 1;
    return flex::Node::new().width(24.0f64).height(24.0f64);
}

fn fake_symbol(ctx: *u8, np: *Node) -> flex::Node {
    FAKE_SYMBOLS = FAKE_SYMBOLS + 1;
    return flex::Node::new().width(16.0f64).height(16.0f64);
}

fn fake_text_field(ctx: *u8, np: *Node) -> flex::Node {
    FAKE_TEXT_FIELDS = FAKE_TEXT_FIELDS + 1;
    return flex::Node::new().width(120.0f64).height(22.0f64);
}

fn fake_popup(ctx: *u8, np: *Node) -> flex::Node {
    FAKE_POPUPS = FAKE_POPUPS + 1;
    return flex::Node::new().width(100.0f64).height(24.0f64);
}

fn fake_divider(ctx: *u8, np: *Node) -> flex::Node {
    FAKE_DIVIDERS = FAKE_DIVIDERS + 1;
    return flex::Node::new().width(100.0f64).height(1.0f64);
}

fn fake_toggle(ctx: *u8, np: *Node) -> flex::Node {
    FAKE_TOGGLES = FAKE_TOGGLES + 1;
    return flex::Node::new().width(40.0f64).height(22.0f64);
}

fn fake_slider(ctx: *u8, np: *Node) -> flex::Node {
    FAKE_SLIDERS = FAKE_SLIDERS + 1;
    return flex::Node::new().width(120.0f64).height(20.0f64);
