    return n;
}

fn fake_set_identity(ctx: *u8, handle: *u8, id: str, role: u32) {
    FAKE_IDENTITIES = FAKE_IDENTITIES + 1;
    FAKE_LAST_ROLE = role;
    // str has no .count in all contexts — compare empty by equality.
    if id != "" {
        FAKE_TAGGED_IDENTITIES = FAKE_TAGGED_IDENTITIES + 1;
        FAKE_LAST_ID_LEN = 1;  // non-empty marker
    }
    return;
}

// The fake backend has no real views, so a keyed container gets no backing
// payload here — mount then skips its set_identity. (The AppKit backend supplies
// a real view; this stub keeps the conformance renderer complete.) The counter
// records that mount ASKED for a backing view (keyed or styled container).
static FAKE_CONTAINERS: i32 = 0;
fn fake_container(ctx: *u8, np: *Node, node: *flex::Node) {
    FAKE_CONTAINERS = FAKE_CONTAINERS + 1;
    return;
}

fn fake_renderer() -> Renderer {
    return Renderer {
        ctx: 0 as *u8,
        label: fake_label,
        wrap_label: fake_label,
        button: fake_button,
        text_area: fake_text_area,
        composer: fake_composer,
        image: fake_image,
        symbol: fake_symbol,
        text_field: fake_text_field,
        popup: fake_popup,
        divider: fake_divider,
        toggle: fake_toggle,
        slider: fake_slider,
        progress: fake_progress,
        stepper: fake_stepper,
        secure_field: fake_secure_field,
        segmented: fake_segmented,
        color_picker: fake_color_picker,
        date_picker: fake_date_picker,
        search_field: fake_text_field,
        combo_box: fake_popup,
        token_field: fake_text_field,
        box: fake_box,
        gauge: fake_gauge,
        path: fake_path,
        native: fake_native,
        window_buttons: fake_window_buttons,
        bordered: fake_bordered,
        clickable: fake_clickable,
        scroll: fake_scroll,
        material: fake_material,
        window_drag: fake_window_drag,
        split: fake_split,
        container: fake_container,
        set_identity: fake_set_identity,
    };
}

fn reset_fake_counts() {
    FAKE_LABELS = 0;
    FAKE_BUTTONS = 0;
    FAKE_TEXT_AREAS = 0;
    FAKE_COMPOSERS = 0;
    FAKE_IMAGES = 0;
    FAKE_SYMBOLS = 0;
    FAKE_TEXT_FIELDS = 0;
    FAKE_POPUPS = 0;
    FAKE_DIVIDERS = 0;
    FAKE_TOGGLES = 0;
    FAKE_SLIDERS = 0;
    FAKE_PROGRESSES = 0;
    FAKE_STEPPERS = 0;
    FAKE_SECURE_FIELDS = 0;
    FAKE_SEGMENTEDS = 0;
    FAKE_COLOR_PICKERS = 0;
    FAKE_DATE_PICKERS = 0;
    FAKE_BOXES = 0;
    FAKE_GAUGES = 0;
    FAKE_PATHS = 0;
    FAKE_NATIVES = 0;
    FAKE_LAST_NATIVE_HANDLE = 0;
    FAKE_BORDEREDS = 0;
    FAKE_CLICKABLES = 0;
    FAKE_SCROLLS = 0;
    FAKE_MATERIALS = 0;
    FAKE_WINDOW_DRAGS = 0;
    FAKE_WINDOW_BUTTONS = 0;
    FAKE_SPLITS = 0;
    FAKE_IDENTITIES = 0;
    FAKE_TAGGED_IDENTITIES = 0;
    FAKE_LAST_CTX = 0;
    FAKE_LAST_ROLE = 0;
    FAKE_LAST_ID_LEN = 0;
    return;
}

#[test]
fn mount_dispatches_leaves_and_builds_containers() {
    reset_fake_counts();
    var b: Builder = Builder::new();
    b.add(label("t"));
    var inner: Builder = Builder::new();
    inner.add(button("ok").on_click(click_a, ctx: 9 as *u8));
    inner.add(spacer());
    inner.add(label("r"));
    b.add(hstack(inner));
    let root: Node = b.finish();

    var tree: flex::Node = mount(#addr_of(root), fake_renderer());
    assert FAKE_LABELS == 2;
    assert FAKE_BUTTONS == 1;
    assert FAKE_LAST_CTX == (9 as i64);   // the button op sees the identity
    assert tree.child_count() == (2 as usize);
    // 3 widget-producing nodes (2 labels + 1 button) each get set_identity.
    assert FAKE_IDENTITIES == 3;
}

#[test]
fn mount_dispatches_new_kinds_and_wrappers() {
    reset_fake_counts();
    var b: Builder = Builder::new();
    b.add(composer(on_submit: click_a, value: "x"));
    b.add(text_area(value: "y"));
    var bb: Builder = Builder::new();
    bb.add(label("boxed"));
    b.add(bordered(bb));
    var cb: Builder = Builder::new();
    cb.add(button("go"));
    b.add(clickable(cb, on_click: click_a, ctx: 4 as *u8));
    var sb: Builder = Builder::new();
    sb.add(label("L"));
    sb.add(label("R"));
    b.add(split(sb));
    let root: Node = b.finish();

    var tree: flex::Node = mount(#addr_of(root), fake_renderer());
    assert FAKE_COMPOSERS == 1;
    assert FAKE_TEXT_AREAS == 1;
    assert FAKE_BORDEREDS == 1;
    assert FAKE_CLICKABLES == 1;
    assert FAKE_SPLITS == 1;
    assert FAKE_LAST_CTX == (4 as i64);
    // labels inside wrappers: boxed + L + R = 3; button inside clickable = 1
    assert FAKE_LABELS == 3;
    assert FAKE_BUTTONS == 1;
    // widget ops: composer, text_area, bordered, clickable, split,
    // + 3 labels + 1 button = 9 set_identity calls
    assert FAKE_IDENTITIES == 9;
    assert tree.child_count() == (5 as usize);
}

#[test]
fn mount_dispatches_window_buttons_leaf() {
    // window_buttons is a native leaf: it routes through r.window_buttons and gets
    // a set_identity call like every widget leaf.
    reset_fake_counts();
    var b: Builder = Builder::new();
    b.add(window_buttons());
    let root: Node = b.finish();

    var tree: flex::Node = mount(#addr_of(root), fake_renderer());
    assert FAKE_WINDOW_BUTTONS == 1;    // the leaf op ran
    assert FAKE_IDENTITIES == 1;        // the leaf was identified
    assert tree.child_count() == (1 as usize);
}

#[test]
fn mount_dispatches_window_drag_wrapper() {
    // window_drag is a wrapper: it routes through r.window_drag and passes its
    // content through (the drag surface wraps the toolbar row).
    reset_fake_counts();
    var inner: Builder = Builder::new();
    inner.add(label("titlebar"));
    var b: Builder = Builder::new();
    b.add(window_drag(inner));
    let root: Node = b.finish();

    var tree: flex::Node = mount(#addr_of(root), fake_renderer());
    assert FAKE_WINDOW_DRAGS == 1;      // the wrapper op ran
    assert FAKE_LABELS == 1;            // its content mounted through
    // the wrapper itself + its label each get set_identity
    assert FAKE_IDENTITIES == 2;
    // root column → the window_drag node → the label
    assert tree.child_count() == (1 as usize);
}

