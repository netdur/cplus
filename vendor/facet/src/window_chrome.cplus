// window_chrome — the titlebar an application draws itself. HAND-WRITTEN.
//
// MAUI has no rows here: its window is not a described tree, so there was
// never anything to adopt. Two words, and they are different shapes:
//
//   window_buttons()      a CONTROL. It draws something — the close /
//                         minimise / zoom group, in whatever form the platform
//                         has one.
//   .window_drag()        a MODIFIER. It draws nothing; it says that pointer
//                         input on this region moves the window. Same reason
//                         gestures are a modifier: it is a behaviour on a
//                         region, not a thing in the tree.
//
// Both are platform chrome, and a backend without a window manager to speak of
// records that in its own manifest. facet still declares them: that is the
// rule, and it is why the contract is readable as a whole.

import "flex_layout/flex_layout" as flex;
import "stdlib/option" as option;
import "stdlib/box" as box;
import "./facet" as core;
import "./mount" as mount;
import "./gestures" as gestures;
import "./vocabulary" as vocab;

const K_WINDOW_BUTTONS: u32 = 1003u32;

const P_STYLE: u64 = 1u64;
const P_SPACING: u64 = 2u64;

// How the group is drawn. Not a list of which buttons: every platform ships
// the set it ships, and picking them individually is how you end up with a
// window that cannot be closed on someone else's desktop.
enum ButtonStyle {
    // The platform's own group, in its own order and spacing.
    Native,
    // The group, but only when the pointer is over the titlebar.
    OnHover,
}

struct WindowButtonsProps {
    style: ButtonStyle,
    // Extra points between the buttons and whatever follows. 0 = the
    // platform's own metric, which is what an application usually wants.
    spacing: f64,
}

impl WindowButtonsProps {
    fn new() -> WindowButtonsProps {
        return WindowButtonsProps { style: ButtonStyle::Native, spacing: 0.0f64 };
    }
}

fn release_window_buttons_props(p: *u8) {
    if p == (0 as *u8) { return; }
    let _b: box::Box[WindowButtonsProps] = box::from_raw::[WindowButtonsProps](p);
    return;
}

// The close / minimise / zoom group, wherever the platform puts them.
fn window_buttons(
    key: str = "",
    style: ButtonStyle = ButtonStyle::Native,
    spacing: f64 = 0.0f64,
) -> core::Node {
    var p: WindowButtonsProps = WindowButtonsProps::new();
    p.style = style;
    p.spacing = spacing;
    return match box::new::[WindowButtonsProps](p) {
        option::Option[box::Box[WindowButtonsProps]]::Some(b) =>
            core::node_with(key, K_WINDOW_BUTTONS, b.into_raw(), release_window_buttons_props),
        option::Option[box::Box[WindowButtonsProps]]::None =>
            core::node_with(key, K_WINDOW_BUTTONS, 0 as *u8, release_window_buttons_props),
    };
}

struct WindowButtons {
    opaque _p: *core::Node,
    _seen: u64,
}

impl WindowButtons {
    // Unchecked, so module-private. `from` is the public door.
    fn _of(p: *core::Node) -> WindowButtons {
        return WindowButtons { _p: p, _seen: flex::removal_count() };
    }
    fn is_live(this) -> bool { return this._seen == flex::removal_count(); }

    fn _props(this) -> *WindowButtonsProps {
        let d: *core::Data = { (*this._p).data() };
        if d == (0 as *core::Data) { return 0 as *WindowButtonsProps; }
        if { (*d).kind } != K_WINDOW_BUTTONS { return 0 as *WindowButtonsProps; }
        return { (*d).props } as *WindowButtonsProps;
    }

    fn set_style(this, v: ButtonStyle) -> WindowButtons {
        let p: *WindowButtonsProps = this._props();
        if p == (0 as *WindowButtonsProps) { return this; }
        { (*p).style = v };
        core::touch(this._p, P_STYLE);
        return this;
    }

    fn style(this) -> ButtonStyle {
        let p: *WindowButtonsProps = this._props();
        if p == (0 as *WindowButtonsProps) { return ButtonStyle::Native; }
        return { (*p).style };
    }

    fn set_spacing(this, v: f64) -> WindowButtons {
        let p: *WindowButtonsProps = this._props();
        if p == (0 as *WindowButtonsProps) { return this; }
        { (*p).spacing = v };
        core::touch(this._p, P_SPACING);
        return this;
    }

    fn spacing(this) -> f64 {
        let p: *WindowButtonsProps = this._props();
        if p == (0 as *WindowButtonsProps) { return 0.0f64; }
        return { (*p).spacing };
    }

    // The flex node this cursor points at: layout comes from flex, not from
    // a second vocabulary here. See the note on the generated cursors.
    fn node(this) -> *core::Node { return this._p; }

    // --- live layout: flex's own names, reachable after mount ---
    fn set_grow(this, v: f64) -> WindowButtons { core::set_grow(this._p, v); return this; }
    fn set_shrink(this, v: f64) -> WindowButtons { core::set_shrink(this._p, v); return this; }
    fn set_width(this, v: f64) -> WindowButtons { core::set_width(this._p, v); return this; }
    fn set_height(this, v: f64) -> WindowButtons { core::set_height(this._p, v); return this; }
    fn set_width_percent(this, v: f64) -> WindowButtons { core::set_width_percent(this._p, v); return this; }
    fn set_height_percent(this, v: f64) -> WindowButtons { core::set_height_percent(this._p, v); return this; }
    fn set_padding(this, v: f64) -> WindowButtons { core::set_padding(this._p, v); return this; }
    fn set_margin(this, v: f64) -> WindowButtons { core::set_margin(this._p, v); return this; }
    fn set_gap(this, v: f64) -> WindowButtons { core::set_gap(this._p, v); return this; }
    fn set_justify(this, v: flex::Justify) -> WindowButtons { core::set_justify(this._p, v); return this; }
    fn set_align(this, v: flex::Align) -> WindowButtons { core::set_align(this._p, v); return this; }
    fn set_wrap(this, v: flex::Wrap) -> WindowButtons { core::set_wrap(this._p, v); return this; }

    // --- the shared band ---
    fn set_visible(this, v: bool) -> WindowButtons { core::set_visible(this._p, v); return this; }
    fn is_visible(this) -> bool { return core::is_visible(this._p); }
    fn set_enabled(this, v: bool) -> WindowButtons { core::set_enabled(this._p, v); return this; }
    fn is_enabled(this) -> bool { return core::is_enabled(this._p); }
    fn set_opacity(this, v: f64) -> WindowButtons { core::set_opacity(this._p, v); return this; }
    fn opacity(this) -> f64 { return core::opacity(this._p); }
    fn width(this) -> f64 { return core::width_of(this._p); }
    fn height(this) -> f64 { return core::height_of(this._p); }
    fn x(this) -> f64 { return core::x_of(this._p); }
    fn y(this) -> f64 { return core::y_of(this._p); }
    fn bounds(this) -> vocab::Rect { return core::bounds_of(this._p); }
    fn native(this) -> *u8 { return core::native(this._p); }
    fn is_attached(this) -> bool { return core::is_attached(this._p); }
    fn frame(this) -> core::Frame { return core::frame_of(this._p); }
}

// Narrow a node to this control, the DOM step: a node carries what EVERY
// node has, and a checked cast adds what only this control has.
fn from(p: *core::Node) -> option::Option[WindowButtons] {
    if p == (0 as *core::Node) { return option::Option[WindowButtons]::None; }
    let d: *core::Data = { (*p).data() };
    if d == (0 as *core::Data) { return option::Option[WindowButtons]::None; }
    if { (*d).kind } != K_WINDOW_BUTTONS { return option::Option[WindowButtons]::None; }
    return option::Option[WindowButtons]::Some(WindowButtons::_of(p));
}

fn find(key: str, within: *core::Node = mount::mounted_root()) -> option::Option[WindowButtons] {
    if within == (0 as *core::Node) { return option::Option[WindowButtons]::None; }
    return match core::find_in(within, key) {
        option::Option[*core::Node]::Some(p) => from(p),
        option::Option[*core::Node]::None => option::Option[WindowButtons]::None,
    };
}

// ---- window_drag: a modifier, because it draws nothing -----------------------
// Dragging the window is what pointer input on this region DOES, so it lives
// with the other things pointer input does — in the gesture set, behind the
// same one pointer, allocated only when asked for.
//
//     hstack(b).window_drag()
//
impl flex::Node {
    fn window_drag(take this, drags: bool = true) -> flex::Node {
        var n: flex::Node = this;
        let p: *core::Node = #addr_of(n);
        // Keep whatever handlers the node already had: `.gesture(...)` and
        // `.window_drag()` compose in either order, which they would not if
        // this replaced the set.
        var g: gestures::Gestures = gestures::Gestures::new();
        let existing: *gestures::Gestures = gestures::gestures_of(p);
        if existing != (0 as *gestures::Gestures) { g = { (*existing) }; }
        g.drags_window = drags;
        gestures::attach(p, g);
        return n;
    }
}

fn drags_window(n: *core::Node) -> bool {
    let g: *gestures::Gestures = gestures::gestures_of(n);
    if g == (0 as *gestures::Gestures) { return false; }
    return { (*g).drags_window };
}
