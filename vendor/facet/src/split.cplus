// split — a draggable divider between two panes. HAND-WRITTEN: facet's own.
//
// The ledger has none, and this is not layout, so it is not flex's either: flex
// arranges what it is told, and a divider is a control the USER drags. That is
// the line — `spacer` and `zstack` went to flex_layout because they are pure
// arrangement; a split has a grab handle and a position an application saves
// and restores.
//
// The children come from a Builder, first pane then second. A third child is
// ignored rather than stacked: two panes is what a divider divides.

import "flex_layout/flex_layout" as flex;
import "stdlib/text" as text;
import "stdlib/option" as option;
import "stdlib/box" as box;
import "./facet" as core;
import "./mount" as mount;
import "./vocabulary" as vocab;

// facet-origin controls take their kind tag from 1000 up.
const K_SPLIT: u32 = 1002u32;

const P_POSITION: u64 = 1u64;
const P_AXIS: u64 = 2u64;
const P_MIN_LEADING: u64 = 4u64;
const P_MIN_TRAILING: u64 = 8u64;
const P_COLLAPSED: u64 = 16u64;
const P_DIVIDER: u64 = 32u64;

// Which way the panes sit. Named for the RESULT, not for the divider: a
// boolean `vertical` reads as a question about the wrong object every time.
enum SplitAxis {
    // Side by side, divider running top to bottom.
    Columns,
    // Stacked, divider running left to right.
    Rows,
}

// Which pane a verb means. `leading`/`trailing` rather than first/second, to
// match Insets and to stay right under a right-to-left flow direction.
enum Pane {
    Leading,
    Trailing,
}

struct SplitProps {
    axis: SplitAxis,
    // Distance from the leading edge to the divider, in points.
    position: f64,
    min_leading: f64,
    min_trailing: f64,
    // A pane collapsed to nothing. The position is remembered, so restoring
    // puts the divider back where the user left it.
    //
    // `saved_position` is what remembers it, and it is the field that sentence
    // promised and did not have. Without it `collapse` wrote position 0, the
    // divider's own resize notification wrote that 0 back into `position`, and
    // `expand` then restored 0 — a pane that collapsed could not come back.
    collapsed_leading: bool,
    collapsed_trailing: bool,
    saved_position: f64,
    // How the divider LOOKS. AppKit's own is a hairline in the platform's
    // separator colour, which disappears between two panes that share a
    // background — and a divider a user cannot find is one they cannot drag.
    // Both are settable because the two are independent: a thicker divider is
    // easier to grab, a stronger colour is easier to see, and an application
    // wanting a seam rather than a bar needs the second without the first.
    divider_color: vocab::Color,
    divider_thickness: f64,
    on_move: fn(*u8, *u8),
    opaque ctx: *u8,
}

fn no_move(sender: *u8, ctx: *u8) { return; }

impl SplitProps {
    fn new() -> SplitProps {
        return SplitProps {
            axis: SplitAxis::Columns,
            position: 220.0f64,
            min_leading: 150.0f64,
            min_trailing: 240.0f64,
            divider_color: vocab::Color::separator(),
            divider_thickness: 1.0f64,
            collapsed_leading: false,
            collapsed_trailing: false,
            saved_position: 0.0f64,
            on_move: no_move,
            ctx: 0 as *u8,
        };
    }
}

fn release_split_props(p: *u8) {
    if p.is_null() { return; }
    let _b: box::Box[SplitProps] = box::from_raw::[SplitProps](p);
}

fn split(
    take b: core::Builder,
    key: str = "",
    axis: SplitAxis = SplitAxis::Columns,
    position: f64 = 220.0f64,
    min_leading: f64 = 150.0f64,
    min_trailing: f64 = 240.0f64,
    divider_color: vocab::Color = vocab::Color::separator(),
    divider_thickness: f64 = 1.0f64,
    on_move: fn(*u8, *u8) = no_move,
    ctx: *u8 = 0 as *u8,
) -> core::Node {
    var p: SplitProps = SplitProps::new();
    p.axis = axis;
    p.position = position;
    p.min_leading = min_leading;
    p.min_trailing = min_trailing;
    p.divider_color = divider_color;
    p.divider_thickness = divider_thickness;
    p.on_move = on_move;
    p.ctx = ctx;

    // flex builds the container and holds the panes; facet's Data rides on it,
    // exactly as it does for column and row.
    var n: core::Node = match axis {
        SplitAxis::Columns => flex::row(b),
        SplitAxis::Rows => flex::column(b),
    };
    let d: *core::Data = core::ensure_data(#addr_of(n));
    if d.is_not_null() {
        { (*d).key = text::from_str(key) };
        { (*d).kind = K_SPLIT };
        match box::new::[SplitProps](p) {
            option::Option[box::Box[SplitProps]]::Some(bx) => {
                { (*d).props = bx.into_raw() };
                { (*d).release = release_split_props };
            }
            option::Option[box::Box[SplitProps]]::None => { }
        }
    }
    return n;
}

// ---- live --------------------------------------------------------------------

struct Split {
    opaque _p: *core::Node,
    _seen: u64,
}

impl Split {
    // Unchecked, so module-private. `from` is the public door.
    fn _of(p: *core::Node) -> Split { return Split { _p: p, _seen: flex::removal_count() }; }
    fn is_live(this) -> bool { return this._seen == flex::removal_count(); }

    fn _props(this) -> *SplitProps {
        let d: *core::Data = { (*this._p).data() };
        if d.is_null() { return 0 as *SplitProps; }
        if { (*d).kind } != K_SPLIT { return 0 as *SplitProps; }
        return { (*d).props } as *SplitProps;
    }

    // Where the divider sits, clamped to the minimums. Clamping HERE and not
    // in the backend is deliberate: an application that saves and restores a
    // position must read back what was actually applied, not what it asked for.
    fn set_position(this, v: f64) -> Split {
        let p: *SplitProps = this._props();
        if p.is_null() { return this; }
        var want: f64 = v;
        let lo: f64 = { (*p).min_leading };
        if want < lo { want = lo; }
        { (*p).position = want };
        core::touch(this._p, P_POSITION);
        return this;
    }

    fn position(this) -> f64 {
        let p: *SplitProps = this._props();
        if p.is_null() { return 0.0f64; }
        return { (*p).position };
    }

    fn set_divider_color(this, v: vocab::Color) -> Split {
        let p: *SplitProps = this._props();
        if p.is_null() { return this; }
        { (*p).divider_color = v };
        core::touch(this._p, P_DIVIDER);
        return this;
    }

    fn divider_color(this) -> vocab::Color {
        let p: *SplitProps = this._props();
        if p.is_null() { return vocab::Color::separator(); }
        return { (*p).divider_color };
    }

    // Changing this moves the panes, so it raises the LAYOUT bit as well as its
    // own: the divider is part of the geometry it sits in.
    fn set_divider_thickness(this, v: f64) -> Split {
        let p: *SplitProps = this._props();
        if p.is_null() { return this; }
        { (*p).divider_thickness = v };
        core::touch(this._p, P_DIVIDER);
        core::relayout(this._p);
        return this;
    }

    fn divider_thickness(this) -> f64 {
        let p: *SplitProps = this._props();
        if p.is_null() { return 1.0f64; }
        return { (*p).divider_thickness };
    }

    fn set_axis(this, v: SplitAxis) -> Split {
        let p: *SplitProps = this._props();
        if p.is_null() { return this; }
        { (*p).axis = v };
        core::touch(this._p, P_AXIS);
        return this;
    }

    fn axis(this) -> SplitAxis {
        let p: *SplitProps = this._props();
        if p.is_null() { return SplitAxis::Columns; }
        return { (*p).axis };
    }

    fn is_columns(this) -> bool {
        return match this.axis() { SplitAxis::Columns => true, SplitAxis::Rows => false };
    }

    fn set_min(this, pane: Pane, v: f64) -> Split {
        let p: *SplitProps = this._props();
        if p.is_null() { return this; }
        match pane {
            Pane::Leading => { { (*p).min_leading = v }; core::touch(this._p, P_MIN_LEADING); }
            Pane::Trailing => { { (*p).min_trailing = v }; core::touch(this._p, P_MIN_TRAILING); }
        }
        return this;
    }

    fn min(this, pane: Pane) -> f64 {
        let p: *SplitProps = this._props();
        if p.is_null() { return 0.0f64; }
        return match pane {
            Pane::Leading => { (*p).min_leading },
            Pane::Trailing => { (*p).min_trailing },
        };
    }

    // Collapse a pane to nothing. The position is REMEMBERED, so uncollapsing
    // puts the divider back where the user left it rather than at a default.
    fn collapse(this, pane: Pane) -> Split { return this._set_collapsed(pane, true); }
    fn expand(this, pane: Pane) -> Split { return this._set_collapsed(pane, false); }

    fn _set_collapsed(this, pane: Pane, v: bool) -> Split {
        let p: *SplitProps = this._props();
        if p.is_null() { return this; }
        // Remember where the divider was BEFORE it goes to the edge, and put
        // it back on the way out. Only on the transition — collapsing an
        // already-collapsed pane must not overwrite the saved position with
        // the collapsed one.
        let was: bool = match pane {
            Pane::Leading => { (*p).collapsed_leading }
            Pane::Trailing => { (*p).collapsed_trailing }
        };
        if v && !was {
            { (*p).saved_position = { (*p).position } };
        }
        if !v && was {
            let back: f64 = { (*p).saved_position };
            if back > 0.0f64 { { (*p).position = back }; }
            core::touch(this._p, P_POSITION);
        }
        match pane {
            Pane::Leading => { { (*p).collapsed_leading = v }; }
            Pane::Trailing => { { (*p).collapsed_trailing = v }; }
        }
        core::touch(this._p, P_COLLAPSED);
        return this;
    }

    fn is_collapsed(this, pane: Pane) -> bool {
        let p: *SplitProps = this._props();
        if p.is_null() { return false; }
        return match pane {
            Pane::Leading => { (*p).collapsed_leading },
            Pane::Trailing => { (*p).collapsed_trailing },
        };
    }

    fn toggle(this, pane: Pane) -> Split {
        return this._set_collapsed(pane, !this.is_collapsed(pane));
    }

    fn set_on_move(this, f: fn(*u8, *u8), ctx: *u8 = 0 as *u8) -> Split {
        let p: *SplitProps = this._props();
        if p.is_null() { return this; }
        { (*p).on_move = f };
        { (*p).ctx = ctx };
        return this;
    }

    // The backend calls this when the user finishes a drag, so an application
    // that persists the position hears about it in one place.
    fn moved(this, to: f64) -> Split {
        let _a: Split = this.set_position(to);
        let p: *SplitProps = this._props();
        if p.is_null() { return this; }
        let f: fn(*u8, *u8) = { (*p).on_move };
        if f != no_move { f(this._p as *u8, { (*p).ctx }); }
        return this;
    }

    fn pane(this, which: Pane) -> option::Option[*core::Node] {
        return match which {
            Pane::Leading => core::child_of(this._p, 0 as usize),
            Pane::Trailing => core::child_of(this._p, 1 as usize),
        };
    }

    // The flex node this cursor points at: layout comes from flex, not from
    // a second vocabulary here. See the note on the generated cursors.
    fn node(this) -> *core::Node { return this._p; }

    // --- live layout: flex's own names, reachable after mount ---
    fn set_grow(this, v: f64) -> Split { core::set_grow(this._p, v); return this; }
    fn set_shrink(this, v: f64) -> Split { core::set_shrink(this._p, v); return this; }
    fn set_width(this, v: f64) -> Split { core::set_width(this._p, v); return this; }
    fn set_height(this, v: f64) -> Split { core::set_height(this._p, v); return this; }
    fn set_width_percent(this, v: f64) -> Split { core::set_width_percent(this._p, v); return this; }
    fn set_height_percent(this, v: f64) -> Split { core::set_height_percent(this._p, v); return this; }
    fn set_padding(this, v: f64) -> Split { core::set_padding(this._p, v); return this; }
    fn set_margin(this, v: f64) -> Split { core::set_margin(this._p, v); return this; }
    fn set_gap(this, v: f64) -> Split { core::set_gap(this._p, v); return this; }
    fn set_justify(this, v: flex::Justify) -> Split { core::set_justify(this._p, v); return this; }
    fn set_align(this, v: flex::Align) -> Split { core::set_align(this._p, v); return this; }
    fn set_wrap(this, v: flex::Wrap) -> Split { core::set_wrap(this._p, v); return this; }

    // --- the shared band ---
    fn set_opacity(this, v: f64) -> Split { core::set_opacity(this._p, v); return this; }
    fn opacity(this) -> f64 { return core::opacity(this._p); }
    fn set_enabled(this, v: bool) -> Split { core::set_enabled(this._p, v); return this; }
    fn is_enabled(this) -> bool { return core::is_enabled(this._p); }
    fn set_visible(this, v: bool) -> Split { core::set_visible(this._p, v); return this; }
    fn is_visible(this) -> bool { return core::is_visible(this._p); }
    fn set_background_color(this, v: vocab::Color) -> Split { core::set_background_color(this._p, v); return this; }
    fn background_color(this) -> vocab::Color { return core::background_color(this._p); }
    fn width(this) -> f64 { return core::width_of(this._p); }
    fn height(this) -> f64 { return core::height_of(this._p); }
    fn x(this) -> f64 { return core::x_of(this._p); }
    fn y(this) -> f64 { return core::y_of(this._p); }
    fn bounds(this) -> vocab::Rect { return core::bounds_of(this._p); }
    fn child_count(this) -> usize { return core::child_count_of(this._p); }
    fn native(this) -> *u8 { return core::native(this._p); }
    fn is_attached(this) -> bool { return core::is_attached(this._p); }
    fn relayout(this) -> Split { core::relayout(this._p); return this; }
    fn frame(this) -> core::Frame { return core::frame_of(this._p); }
}

// Narrow a node to this control, the DOM step: a node carries what EVERY
// node has, and a checked cast adds what only this control has.
fn from(p: *core::Node) -> option::Option[Split] {
    if p.is_null() { return option::Option[Split]::None; }
    let d: *core::Data = { (*p).data() };
    if d.is_null() { return option::Option[Split]::None; }
    if { (*d).kind } != K_SPLIT { return option::Option[Split]::None; }
    return option::Option[Split]::Some(Split::_of(p));
}

fn find(key: str, within: *core::Node = 0 as *core::Node) -> option::Option[Split] {
    if within.is_not_null() {
        return match core::find_in(within, key) {
            option::Option[*core::Node]::Some(p) => from(p),
            option::Option[*core::Node]::None => option::Option[Split]::None,
        };
    }
    return match mount::find_node(key) {
        option::Option[*core::Node]::Some(p) => from(p),
        option::Option[*core::Node]::None => option::Option[Split]::None,
    };
}
