// app_events — the process's own callbacks, fanned out to more than one
// listener. HAND-WRITTEN; the generator never touches this file.
//
// WHY THIS EXISTS, and it is one sentence: a backend owns exactly one
// application delegate or Activity, and a third-party SDK needs a share of it.
//
// Firebase Messaging wants the push token. Google Sign-In wants the OAuth
// callback URL on Apple and the activity result on Android. An analytics SDK
// wants foreground and background. Today each of those is a method on the ONE
// delegate the backend implements, so the second SDK to want it has nowhere to
// put itself — and an application that wires it by hand has taken the delegate
// away from facet, which is worse.
//
// So the delegate stays the backend's and the callbacks become a LIST. That is
// the whole difference from `mount::install` and `services::install_scheduler`,
// which are single-slot on purpose: there is one renderer and one scheduler,
// and there are many SDKs.
//
//   the backend      fire(...) from the delegate method it already implements
//   an SDK package   on_app_event(...) from its own `init`
//   the application  the same door, when it wants a callback for itself
//
// A CLOSED KIND SET. A registry that lets a package invent event kinds is a
// second vocabulary that can disagree with the first — the same reason the
// control kinds are closed (see plans/third-party-sdks.md). A kind that a
// platform cannot deliver is simply never fired there, and `MANIFEST.md` in
// each backend is where that is recorded, exactly like an absent control.
//
// THE UI THREAD, always. A subscriber's usual next move is to write the tree,
// and `core::touch` asserts the UI thread — so a fan-out that could arrive on
// a worker would turn every subscriber into a latent data race. Some platform
// callbacks genuinely arrive elsewhere (Android's `onNewToken` is called on a
// background thread), and hopping them is the BACKEND's job through
// `services::run_on_main`, not each subscriber's. The assert below is what
// keeps that from being a promise nobody checks.

import "stdlib/status" as status;
import "stdlib/text" as text;
import "./facet" as core;

// ---- the kinds ---------------------------------------------------------------
// Portable where the concept is portable, and named for what the application
// means rather than what any one platform calls it. The right-hand column of
// the table in plans/third-party-sdks.md maps each to its four delegate
// methods; the comments here carry the payload contract, which is the part a
// subscriber has to get right.

// The process is up and the first window can be shown. No payload.
const E_LAUNCHED: u32 = 1u32;
// The app came to the front. No payload. (macOS: didBecomeActive; iOS:
// didBecomeActive; Android: onResume.)
const E_FOREGROUND: u32 = 2u32;
// The app went behind. No payload. The last safe moment to persist — on
// Android and iOS the process can be killed after this without another word.
const E_BACKGROUND: u32 = 3u32;
// The process is going down cleanly. No payload. NOT guaranteed on mobile.
const E_TERMINATING: u32 = 4u32;
// A URL was handed to the app: `text` is it. THE OAuth CALLBACK — a sign-in
// SDK subscribes here and matches its own scheme, so two SDKs can both watch
// without either one owning the door.
const E_OPEN_URL: u32 = 5u32;
// Memory is short. `code` is the platform's level where it has one (Android's
// `onTrimMemory` argument), 0 where it does not (iOS has no level).
const E_LOW_MEMORY: u32 = 6u32;
// Remote notifications registered: `text` is the token, lowercase hex, no
// separators — one spelling on every platform, because the alternative is
// every subscriber re-deriving it from `native` differently.
const E_PUSH_TOKEN: u32 = 7u32;
// A push arrived. `native` is the platform payload (an NSDictionary userInfo,
// an Android RemoteMessage) — opaque here by necessity; the SDK that
// subscribes is the one with the binding to read it.
const E_PUSH_MESSAGE: u32 = 8u32;
// A foreign UI flow the platform took over has returned. `code` is the request
// code, `result` the result code, `native` the platform's data object.
//
// ANDROID'S, and said so rather than dressed up as portable: this is
// `onActivityResult`, which the Apple platforms have no equivalent of — they
// return through E_OPEN_URL instead. It is here because Google Sign-In on
// Android has no other door, and a kind that exists on one platform is honest
// in a way an invented portable name would not be.
const E_NATIVE_RESULT: u32 = 9u32;
// A permission request was answered. `code` is the request code the batch was
// sent with, `text` the platform's permission string, `result` 0 granted /
// -1 denied. Fired ONCE PER PERMISSION, so a batch of three arrives as three
// events — which is what fits `AppEvent`'s four payload fields without an
// array, and what lets a subscriber count its own batch home.
//
// ANDROID'S, and said so rather than dressed up as portable, the same way
// `E_NATIVE_RESULT` is. `onRequestPermissionsResult` has no Apple equivalent:
// there, the request carries its own completion block and the answer comes back
// through that. A kind that exists on one platform is honest in a way an
// invented portable name would not be.
const E_PERMISSION_RESULT: u32 = 10u32;
// A notification was tapped. `text` is the payload the notification carried —
// opaque to facet, meaningful to whoever scheduled it. THE DEEP LINK.
//
// Both platforms, unlike the two kinds above it: Apple delivers through
// `UNUserNotificationCenterDelegate`, Android through the Activity's intent.
// The two arrive at different moments and the LATCH below is what makes that
// invisible to a subscriber.
const E_NOTIFICATION_TAP: u32 = 11u32;

// The highest kind this build knows. A subscriber that switches on `kind`
// should ignore what it does not recognise rather than assert — a newer facet
// firing a newer kind must not break an older SDK package.
const E_MAX: u32 = 11u32;

// ---- the payload -------------------------------------------------------------

struct AppEvent {
    kind: u32,
    // The event's text, BORROWED for the duration of the dispatch and not one
    // instant longer: the URL for E_OPEN_URL, the hex token for E_PUSH_TOKEN,
    // "" for the events that carry none. A subscriber that needs to keep it
    // copies it (`text::from_str`) — storing the `str` is the use-after-free
    // the borrow checker cannot see through a raw-pointer store, the same trap
    // `Data.key` records.
    text: str,
    // The platform object, borrowed the same way. 0 when the event has none.
    opaque native: *u8,
    // E_NATIVE_RESULT's request code, E_LOW_MEMORY's level. 0 otherwise.
    code: i64,
    // E_NATIVE_RESULT's result code. 0 otherwise.
    result: i64,
}

impl AppEvent {
    fn new(kind: u32) -> AppEvent {
        return AppEvent { kind: kind, text: "", native: 0 as *u8,
                          code: 0 as i64, result: 0 as i64 };
    }
}

// ---- the list ----------------------------------------------------------------
// A fixed sixteen slots, and a null slot is a free one. Fixed because the
// subscribers are package singletons that register at init and live for the
// process — a growable vector in a static would buy nothing and cost an
// allocation on a path that must work before main has done anything.
//
// NULLING rather than compacting on `off`, so a slot's index never moves.
// `fire` walks indices, and a handler that unsubscribes itself mid-dispatch —
// a one-shot sign-in listener does exactly that — would otherwise shift the
// slot the loop is about to read and skip its neighbour.

const MAX_SUBSCRIBERS: usize = 16 as usize;

static HANDLERS: [fn(*AppEvent, *u8); 16] = #zero::[[fn(*AppEvent, *u8); 16]]();
static CTXS: [*u8; 16] = #zero::[[*u8; 16]]();

fn no_handler(e: *AppEvent, ctx: *u8) { return; }

// Subscribe. `Ok`, or `OutOfBounds` when all sixteen slots are taken — which
// is a wiring bug (an init running in a loop), not a condition to handle.
//
// Registering the SAME (f, ctx) twice is a no-op that answers `Ok`. A package
// whose `init` is called once per screen would otherwise fan its handler out
// as many times as it was initialised, and the symptom — one push handled
// four times — reads as a platform problem rather than a registration one.
fn on_app_event(f: fn(*AppEvent, *u8), ctx: *u8 = 0 as *u8) -> status::Status {
    if f.is_null() { return status::Status::InvalidInput; }
    var i: usize = 0 as usize;
    while i < MAX_SUBSCRIBERS {
        // A DUPLICATE DOES NOT REPLAY. It is already subscribed and has already
        // been handed whatever was latched; replaying would deliver one launch
        // twice to an `init` that runs once per screen.
        if HANDLERS[i] == f && CTXS[i] == ctx { return status::Status::Ok; }
        i = i +% (1 as usize);
    }
    i = 0 as usize;
    while i < MAX_SUBSCRIBERS {
        if HANDLERS[i] == (0 as fn(*AppEvent, *u8)) {
            HANDLERS[i] = f;
            CTXS[i] = ctx;
            // THE LATCH IS DELIVERED HERE, to this handler only. A cold-start
            // tap or launch URL fired before any package had subscribed, and
            // this is the moment the subscriber can be told. Registered FIRST
            // so a handler that unsubscribes itself from inside the replay
            // finds its own slot live.
            replay_to(f, ctx);
            return status::Status::Ok;
        }
        i = i +% (1 as usize);
    }
    return status::Status::OutOfBounds;
}

// Unsubscribe the exact pair. `InvalidInput` when it was never registered —
// worth reporting rather than swallowing, because the usual cause is a ctx
// that does not match the one registered, and a silent no-op there leaves a
// handler pointing at memory the caller is about to free.
fn off_app_event(f: fn(*AppEvent, *u8), ctx: *u8 = 0 as *u8) -> status::Status {
    var i: usize = 0 as usize;
    while i < MAX_SUBSCRIBERS {
        if HANDLERS[i] == f && CTXS[i] == ctx {
            HANDLERS[i] = 0 as fn(*AppEvent, *u8);
            CTXS[i] = 0 as *u8;
            return status::Status::Ok;
        }
        i = i +% (1 as usize);
    }
    return status::Status::InvalidInput;
}

fn subscriber_count() -> usize {
    var n: usize = 0 as usize;
    var i: usize = 0 as usize;
    while i < MAX_SUBSCRIBERS {
        if HANDLERS[i] != (0 as fn(*AppEvent, *u8)) { n = n +% (1 as usize); }
        i = i +% (1 as usize);
    }
    return n;
}

// Drop every subscriber. For tests and for a backend tearing a process-level
// fixture down — an application does not call this, because unsubscribing
// somebody else's SDK is not its business.
fn clear_app_events() {
    var i: usize = 0 as usize;
    while i < MAX_SUBSCRIBERS {
        HANDLERS[i] = 0 as fn(*AppEvent, *u8);
        CTXS[i] = 0 as *u8;
        i = i +% (1 as usize);
    }
}

// ---- the host object ---------------------------------------------------------
//
// THE ONE PLATFORM OBJECT THE PROCESS HAS: the Activity on Android, the
// UIApplication on iOS, the NSApplication on macOS. Set by the backend at
// install; read by any package that needs to talk to it.
//
// SINGLE-SLOT, not a list, and that is the difference from the handlers above.
// There are many SDKs wanting a callback and there is exactly one Activity, so
// this is `mount::install`'s shape rather than `on_app_event`'s.
//
// WHY IT IS HERE AND NOT IN THE BACKEND that owns it: a services package must
// not depend on a UI backend to reach it. `vendor/permissions` needs the
// Activity for `requestPermissions`, which is an Activity method, and taking a
// dependency on `facet_android` to get it would invert the layering the moment
// a backend wanted a permission. This module is the one both halves may depend
// on, and handing over the host is the same job as handing over the callbacks.
//
// NEVER CACHE WHAT `host()` RETURNS. On Android the Activity is destroyed and
// recreated under a live tree — facet_android's manifest lists that as its
// third structural consequence — and the backend replaces this slot each time.
// A jobject held across a rotation is a dead one, and it does not fail loudly.
static HOST: *u8 = 0 as *u8;

fn set_host(native: *u8) { HOST = native; return; }
fn host() -> *u8 { return HOST; }
fn has_host() -> bool { return HOST.is_not_null(); }

// THE PROCESS'S MANAGED-RUNTIME HANDLE, where the platform has one: Android's
// `JavaVM`. Zero on the Apple platforms and on GTK, which have no such thing.
//
// SEPARATE FROM `host()` because they have different lifetimes and different
// thread rules. The Activity is replaced on every recreation and belongs to the
// UI thread; the VM is process-wide, outlives every thread, and is the ONLY
// handle from which a thread the JVM never called into can get an env of its
// own. A package that cached the Activity would hold a dead jobject after a
// rotation; a package that cached a JNIEnv would hold one belonging to another
// thread. The VM is the one of the three that is safe to keep.
//
// WHY IT IS IN PORTABLE CORE. Same reason as `host()`, and it is the second
// half of the same problem: `vendor/permissions` needs an env to call
// `checkSelfPermission` and cannot depend on `facet_android` to get one.
// `vendor/http` solved it by defining `JNI_OnLoad`, which works and which a
// shared library gets exactly ONE of — so the second package to try it is a
// duplicate-symbol error at link. This slot is how the backend that already
// has the VM hands it over instead, and it costs a package nothing to ignore.
static HOST_RUNTIME: *u8 = 0 as *u8;

fn set_host_runtime(vm: *u8) { HOST_RUNTIME = vm; return; }
fn host_runtime() -> *u8 { return HOST_RUNTIME; }
fn has_host_runtime() -> bool { return HOST_RUNTIME.is_not_null(); }

// ---- the latch ---------------------------------------------------------------
//
// THREE KINDS ARE FACTS, NOT EDGES, and delivering them only forward loses them.
//
// A notification tapped while the app is dead LAUNCHES it: the payload is in
// the launch intent on Android and arrives at the delegate on Apple, in both
// cases around the moment the process starts and before any package's `init`
// has subscribed to anything. Same for the URL that opened a cold app, and for
// the launch itself. A subscriber registering a millisecond later has no way to
// learn any of them, and the symptom — deep links work on a warm app and
// silently do nothing on a cold one — is among the most-reported bugs in every
// mobile framework there is, precisely because it only reproduces from a killed
// process.
//
// So those three LATCH: the last one fired is remembered, and a handler
// registering afterwards is handed it immediately.
//
// EDGES DO NOT LATCH. `E_FOREGROUND` replayed at registration would tell a
// subscriber the app just came to the front when it has been there for an hour.
// The test for "is this latchable" is whether the event describes a STATE OF
// THE WORLD that is still true, rather than a transition that has passed.
//
// THE TEXT IS INTERNED, not borrowed. `AppEvent.text` is valid for its dispatch
// and not one instant longer; a latch that stored the view would hand a
// subscriber a dangling pointer minutes later. `text::intern` copies into a
// process-lifetime table, which is exactly the lifetime a latch needs.

const LATCH_COUNT: usize = 3 as usize;

struct Latch {
    kind: u32,
    text: str,
    code: i64,
    result: i64,
    held: bool,
}

static LATCHES: [Latch; 3] = #zero::[[Latch; 3]]();

// Which slot a kind latches into, or `LATCH_COUNT` for a kind that does not.
fn latch_slot(kind: u32) -> usize {
    if kind == E_LAUNCHED { return 0 as usize; }
    if kind == E_OPEN_URL { return 1 as usize; }
    if kind == E_NOTIFICATION_TAP { return 2 as usize; }
    return LATCH_COUNT;
}

fn is_latchable(kind: u32) -> bool { return latch_slot(kind) < LATCH_COUNT; }

// Remember the last one of a latchable kind.
fn latch(e: *AppEvent) {
    let slot: usize = latch_slot({ (*e).kind });
    if slot >= LATCH_COUNT { return; }
    LATCHES[slot].kind = { (*e).kind };
    LATCHES[slot].text = text::intern({ (*e).text });
    LATCHES[slot].code = { (*e).code };
    LATCHES[slot].result = { (*e).result };
    LATCHES[slot].held = true;
    return;
}

// Hand every held latch to one handler, in kind order. Called from
// `on_app_event` for the handler that just registered and nobody else — a
// broadcast would re-deliver a launch to subscribers that already saw it.
fn replay_to(f: fn(*AppEvent, *u8), ctx: *u8) {
    var i: usize = 0 as usize;
    while i < LATCH_COUNT {
        if LATCHES[i].held {
            var e: AppEvent = AppEvent::new(LATCHES[i].kind);
            e.text = LATCHES[i].text;
            e.code = LATCHES[i].code;
            e.result = LATCHES[i].result;
            f(#addr_of(e), ctx);
        }
        i = i +% (1 as usize);
    }
    return;
}

// Forget everything latched. For tests, and for a backend tearing a
// process-level fixture down — an application does not call this.
fn clear_latches() {
    var i: usize = 0 as usize;
    while i < LATCH_COUNT {
        LATCHES[i].held = false;
        LATCHES[i].text = "";
        i = i +% (1 as usize);
    }
    return;
}

fn latched(kind: u32) -> bool {
    let slot: usize = latch_slot(kind);
    if slot >= LATCH_COUNT { return false; }
    return LATCHES[slot].held;
}

// ---- the fan-out -------------------------------------------------------------

// The backend's door. Every subscriber sees the event; none of them can stop
// it reaching the others, and that is deliberate — "handled" is a concept that
// only makes sense when one listener owns the callback, which is the situation
// this module exists to end.
fn fire(e: *AppEvent) {
    if e.is_null() { return; }
    assert core::on_ui_thread();
    // LATCHED BEFORE DISPATCH, so a handler that subscribes another handler
    // from inside its own callback sees the event it is currently handling.
    latch(e);
    var i: usize = 0 as usize;
    while i < MAX_SUBSCRIBERS {
        let f: fn(*AppEvent, *u8) = HANDLERS[i];
        if f.is_not_null() { f(e, CTXS[i]); }
        i = i +% (1 as usize);
    }
}

// The three shapes a backend actually has, so a delegate method is one line
// and cannot get the payload fields wrong.
fn fire_plain(kind: u32) {
    var e: AppEvent = AppEvent::new(kind);
    fire(#addr_of(e));
}

fn fire_text(kind: u32, text: str, native: *u8 = 0 as *u8) {
    var e: AppEvent = AppEvent::new(kind);
    e.text = text;
    e.native = native;
    fire(#addr_of(e));
}

fn fire_result(kind: u32, code: i64, result: i64, native: *u8 = 0 as *u8) {
    var e: AppEvent = AppEvent::new(kind);
    e.code = code;
    e.result = result;
    e.native = native;
    fire(#addr_of(e));
}

// ---- tests -------------------------------------------------------------------

static SEEN_KIND: u32 = 0u32;
static SEEN_COUNT: i32 = 0;
static SEEN_TEXT_OK: bool = false;
static SEEN_CTX: *u8 = 0 as *u8;

fn t_record(e: *AppEvent, ctx: *u8) {
    SEEN_KIND = { (*e).kind };
    SEEN_COUNT = SEEN_COUNT + 1;
    SEEN_CTX = ctx;
}

fn t_count_only(e: *AppEvent, ctx: *u8) { SEEN_COUNT = SEEN_COUNT + 1; return; }

fn t_read_text(e: *AppEvent, ctx: *u8) {
    SEEN_TEXT_OK = { (*e).text } == "myapp://auth?code=42";
}

fn t_reset() {
    clear_app_events();
    // THE LATCH IS PROCESS STATE and it outlives a test. Without this, a test
    // that registers a subscriber is handed whatever an earlier test latched,
    // and eight of them started counting one event too many the moment the
    // latch landed. That is the fixture's job, not each test's.
    clear_latches();
    SEEN_KIND = 0u32;
    SEEN_COUNT = 0;
    SEEN_TEXT_OK = false;
    SEEN_CTX = 0 as *u8;
}

#[test]
fn a_subscriber_receives_the_event() {
    t_reset();
    assert on_app_event(t_record).is_ok();
    assert subscriber_count() == (1 as usize);
    fire_plain(E_LAUNCHED);
    assert SEEN_COUNT == 1;
    assert SEEN_KIND == E_LAUNCHED;
    t_reset();
}

// THE POINT OF THE MODULE: two SDKs want the same callback and both get it.
// The single-slot `install` shape every other seam uses would have let the
// second registration silently replace the first.
#[test]
fn every_subscriber_sees_every_event() {
    t_reset();
    assert on_app_event(t_record).is_ok();
    assert on_app_event(t_count_only).is_ok();
    assert subscriber_count() == (2 as usize);
    fire_plain(E_FOREGROUND);
    assert SEEN_COUNT == 2;         // one from each
    assert SEEN_KIND == E_FOREGROUND;
    t_reset();
}

#[test]
fn the_ctx_comes_back_to_its_own_handler() {
    t_reset();
    var marker: i64 = 7 as i64;
    assert on_app_event(t_record, #addr_of(marker) as *u8).is_ok();
    fire_plain(E_BACKGROUND);
    assert SEEN_CTX == (#addr_of(marker) as *u8);
    t_reset();
}

#[test]
fn text_rides_the_event() {
    t_reset();
    assert on_app_event(t_read_text).is_ok();
    fire_text(E_OPEN_URL, "myapp://auth?code=42");
    assert SEEN_TEXT_OK;
    t_reset();
}

#[test]
fn a_result_carries_both_codes() {
    t_reset();
    var e: AppEvent = AppEvent::new(E_NATIVE_RESULT);
    e.code = 9001 as i64;
    e.result = -1 as i64;
    assert e.code == (9001 as i64);
    assert e.result == (-1 as i64);
    assert e.text == "";
    assert e.native.is_null();
    t_reset();
}

// Registering the same pair twice fans out ONCE. An SDK `init` called per
// screen is the case, and four-times-handled push is the symptom.
#[test]
fn a_duplicate_registration_is_a_no_op() {
    t_reset();
    assert on_app_event(t_count_only).is_ok();
    assert on_app_event(t_count_only).is_ok();
    assert subscriber_count() == (1 as usize);
    fire_plain(E_LAUNCHED);
    assert SEEN_COUNT == 1;
    t_reset();
}

// Same fn, different ctx, is a DIFFERENT subscriber — two instances of one SDK
// type, which is what a ctx is for.
#[test]
fn the_same_fn_with_two_contexts_is_two_subscribers() {
    t_reset();
    var a: i64 = 1 as i64;
    var b: i64 = 2 as i64;
    assert on_app_event(t_count_only, #addr_of(a) as *u8).is_ok();
    assert on_app_event(t_count_only, #addr_of(b) as *u8).is_ok();
    assert subscriber_count() == (2 as usize);
    fire_plain(E_LAUNCHED);
    assert SEEN_COUNT == 2;
    t_reset();
}

#[test]
fn off_stops_delivery_and_frees_the_slot() {
    t_reset();
    assert on_app_event(t_count_only).is_ok();
    assert off_app_event(t_count_only).is_ok();
    assert subscriber_count() == (0 as usize);
    fire_plain(E_LAUNCHED);
    assert SEEN_COUNT == 0;
    t_reset();
}

// ---- negative ----------------------------------------------------------------

#[test]
fn a_null_handler_is_refused() {
    t_reset();
    assert on_app_event(0 as fn(*AppEvent, *u8)) == status::Status::InvalidInput;
    assert subscriber_count() == (0 as usize);
    t_reset();
}

// A ctx that does not match the registration is NOT the same subscriber, and
// saying so is what stops a caller freeing a ctx it believes it unhooked.
#[test]
fn off_with_the_wrong_ctx_reports_rather_than_swallows() {
    t_reset();
    var a: i64 = 1 as i64;
    assert on_app_event(t_count_only, #addr_of(a) as *u8).is_ok();
    assert off_app_event(t_count_only) == status::Status::InvalidInput;
    assert off_app_event(t_count_only, 0 as *u8) == status::Status::InvalidInput;
    assert subscriber_count() == (1 as usize);
    assert off_app_event(t_count_only, #addr_of(a) as *u8).is_ok();
    assert subscriber_count() == (0 as usize);
    t_reset();
}

#[test]
fn a_seventeenth_subscriber_is_refused_not_dropped_silently() {
    t_reset();
    var slots: [i64; 17] = #zero::[[i64; 17]]();
    var i: usize = 0 as usize;
    while i < MAX_SUBSCRIBERS {
        assert on_app_event(t_count_only, #addr_of(slots[i]) as *u8).is_ok();
        i = i +% (1 as usize);
    }
    assert subscriber_count() == MAX_SUBSCRIBERS;
    assert on_app_event(t_count_only, #addr_of(slots[16 as usize]) as *u8)
        == status::Status::OutOfBounds;
    assert subscriber_count() == MAX_SUBSCRIBERS;
    t_reset();
}

#[test]
fn firing_with_no_subscribers_is_silent() {
    t_reset();
    fire_plain(E_LAUNCHED);
    fire_text(E_OPEN_URL, "x://y");
    fire_result(E_NATIVE_RESULT, 1 as i64, 0 as i64);
    assert SEEN_COUNT == 0;
}

#[test]
fn firing_a_null_event_is_inert() {
    t_reset();
    assert on_app_event(t_count_only).is_ok();
    fire(0 as *AppEvent);
    assert SEEN_COUNT == 0;
    t_reset();
}

// A handler that unsubscribes itself mid-dispatch — a one-shot sign-in
// listener — must not shift the slot the loop is about to read. This is why
// `off` nulls rather than compacts.
static ONESHOT_RAN: i32 = 0;
fn t_oneshot(e: *AppEvent, ctx: *u8) {
    ONESHOT_RAN = ONESHOT_RAN + 1;
    let _s: status::Status = off_app_event(t_oneshot);
}

#[test]
fn a_handler_that_unsubscribes_itself_does_not_skip_its_neighbour() {
    t_reset();
    ONESHOT_RAN = 0;
    assert on_app_event(t_oneshot).is_ok();
    assert on_app_event(t_count_only).is_ok();
    fire_plain(E_OPEN_URL);
    assert ONESHOT_RAN == 1;
    assert SEEN_COUNT == 1;         // the neighbour still ran
    assert subscriber_count() == (1 as usize);
    fire_plain(E_OPEN_URL);
    assert ONESHOT_RAN == 1;        // and stayed gone
    assert SEEN_COUNT == 2;
    t_reset();
}

#[test]
fn the_permission_result_kind_is_inside_the_known_range() {
    // A subscriber switching on `kind` ignores what it does not recognise, so a
    // kind above E_MAX would be silently dropped by every well-written handler
    // — which is the failure mode furthest from its cause.
    assert E_PERMISSION_RESULT <= E_MAX;
    assert E_PERMISSION_RESULT != E_NATIVE_RESULT;
}

#[test]
fn a_permission_result_carries_the_name_and_both_codes() {
    t_reset();
    let _s: status::Status = on_app_event(t_record, 0 as *u8);
    // One event per permission in the batch: request code 7, granted.
    var e: AppEvent = AppEvent::new(E_PERMISSION_RESULT);
    e.text = "android.permission.CAMERA";
    e.code = 7 as i64;
    e.result = 0 as i64;
    fire(#addr_of(e));
    assert SEEN_KIND == E_PERMISSION_RESULT;
    assert SEEN_COUNT == 1;
    let _o: status::Status = off_app_event(t_record, 0 as *u8);
}

#[test]
fn the_host_slot_starts_empty_and_round_trips() {
    let before: *u8 = host();
    set_host(0 as *u8);
    assert has_host() == false;
    assert host().is_null();
    // A stand-in pointer: the slot is opaque to this module and only the
    // backend knows what it means.
    let sentinel: *u8 = { #addr_of(HOST) as *u8 };
    set_host(sentinel);
    assert has_host();
    assert host() == sentinel;
    set_host(before);
}

#[test]
fn the_host_slot_is_replaced_not_appended() {
    // An Activity recreated under a live tree sets this again, and the OLD
    // jobject must not survive anywhere — which is why this is a slot and not
    // a list, and why nothing here retains.
    let before: *u8 = host();
    let a: *u8 = { #addr_of(HOST) as *u8 };
    let b: *u8 = { #addr_of(HANDLERS) as *u8 };
    set_host(a);
    set_host(b);
    assert host() == b;
    assert host() != a;
    set_host(before);
}

// ---- latch tests -------------------------------------------------------------

#[test]
fn the_tap_kind_is_inside_the_known_range() {
    assert E_NOTIFICATION_TAP <= E_MAX;
    assert E_NOTIFICATION_TAP != E_PERMISSION_RESULT;
    // NOT `E_OPEN_URL`. A notification payload is not a URL, and sharing the
    // kind would make an applinks subscriber and a notifications subscriber
    // see each other's traffic.
    assert E_NOTIFICATION_TAP != E_OPEN_URL;
}

#[test]
fn facts_latch_and_edges_do_not() {
    // The test for latchability is whether the event describes a state of the
    // world that is still true, rather than a transition that has passed.
    assert is_latchable(E_LAUNCHED);
    assert is_latchable(E_OPEN_URL);
    assert is_latchable(E_NOTIFICATION_TAP);
    // Replaying these at registration would tell a subscriber the app just
    // came to the front when it has been there for an hour.
    assert is_latchable(E_FOREGROUND) == false;
    assert is_latchable(E_BACKGROUND) == false;
    assert is_latchable(E_TERMINATING) == false;
    assert is_latchable(E_LOW_MEMORY) == false;
    assert is_latchable(E_PUSH_TOKEN) == false;
    assert is_latchable(E_PUSH_MESSAGE) == false;
    assert is_latchable(E_NATIVE_RESULT) == false;
    assert is_latchable(E_PERMISSION_RESULT) == false;
}

#[test]
fn a_tap_fired_before_anyone_subscribed_still_reaches_the_subscriber() {
    // THE COLD-START CASE, which is the whole reason the latch exists: the
    // payload arrives around process start, before any package's init has run.
    t_reset();
    fire_text(E_NOTIFICATION_TAP, "order:1234");
    assert SEEN_COUNT == 0;                 // nobody was listening
    let _s: status::Status = on_app_event(t_record, 0 as *u8);
    assert SEEN_KIND == E_NOTIFICATION_TAP; // and yet it arrived
    assert SEEN_COUNT == 1;
    let _o: status::Status = off_app_event(t_record, 0 as *u8);
    clear_latches();
}

#[test]
fn an_edge_fired_before_anyone_subscribed_is_gone() {
    t_reset();
    fire_plain(E_FOREGROUND);
    let _s: status::Status = on_app_event(t_record, 0 as *u8);
    // Nothing replayed: a foregrounding that already happened is not news.
    assert SEEN_COUNT == 0;
    let _o: status::Status = off_app_event(t_record, 0 as *u8);
}

#[test]
fn a_duplicate_registration_does_not_replay_the_latch_again() {
    // An `init` that runs once per screen would otherwise handle one launch
    // tap four times.
    t_reset();
    fire_text(E_NOTIFICATION_TAP, "once");
    let _a: status::Status = on_app_event(t_record, 0 as *u8);
    assert SEEN_COUNT == 1;
    let _b: status::Status = on_app_event(t_record, 0 as *u8);
    assert SEEN_COUNT == 1;
    let _o: status::Status = off_app_event(t_record, 0 as *u8);
    clear_latches();
}

#[test]
fn the_latch_keeps_the_last_of_its_kind() {
    t_reset();
    fire_text(E_NOTIFICATION_TAP, "first");
    fire_text(E_NOTIFICATION_TAP, "second");
    let _s: status::Status = on_app_event(t_record, 0 as *u8);
    // ONE replay, not two: the slot holds the last of its kind rather than a
    // queue. A queue would deliver a stale deep link behind the current one.
    assert SEEN_COUNT == 1;
    assert SEEN_KIND == E_NOTIFICATION_TAP;
    let _o: status::Status = off_app_event(t_record, 0 as *u8);
    clear_latches();
}

#[test]
fn latched_text_outlives_the_dispatch_that_carried_it() {
    // `AppEvent.text` is borrowed for its dispatch. The latch interns, so a
    // subscriber arriving later gets a copy rather than a dangling view — the
    // trap `Data.key` records, one level up.
    // `t_reset` FIRST: it clears the latch, so firing after it is the only
    // order that leaves anything to replay.
    t_reset();
    var scratch: text::Text = text::from_str("deep:link:99");
    fire_text(E_NOTIFICATION_TAP, { scratch.view() });
    // The Text that carried it is gone; the latch interned a copy.
    scratch = text::from_str("overwritten");
    let _s: status::Status = on_app_event(t_record, 0 as *u8);
    assert SEEN_COUNT == 1;
    assert SEEN_KIND == E_NOTIFICATION_TAP;
    let _o: status::Status = off_app_event(t_record, 0 as *u8);
    clear_latches();
}

#[test]
fn clearing_the_latches_stops_the_replay() {
    t_reset();
    fire_text(E_NOTIFICATION_TAP, "gone");
    assert latched(E_NOTIFICATION_TAP);
    clear_latches();
    assert latched(E_NOTIFICATION_TAP) == false;
    let _s: status::Status = on_app_event(t_record, 0 as *u8);
    assert SEEN_COUNT == 0;
    let _o: status::Status = off_app_event(t_record, 0 as *u8);
}
