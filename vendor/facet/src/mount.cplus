// facet mount — the seam between the description and a backend. HAND-WRITTEN.
//
// facet has a tree, 42 controls and a dirty word per node; nothing appears
// anywhere until something walks that tree and hands it to a backend. This
// module is that something, and it is platform-free: the walk is the same
// everywhere, only what it calls into differs.
//
// The seam is SMALL by design. Stage 2's rule — a setter writes one field and
// sets one bit, never a per-verb registrar — means the backend needs exactly
// five verbs and a scheduler, not a vtable of ops per control. The ~37
// per-kind apply functions exist, but they live INSIDE the backend's `create`
// and `apply`, dispatching on `Data.kind`; facet never sees them.
//
// The seven decisions from stages/3.md, answered here:
//
//   M1  Who releases the native view: `Data.view_release`, set with the view
//       (facet.cplus — the third (payload, release) pair on Data).
//   M2  Where the Renderer lives: ONE static value, set at startup by
//       `install`. One backend per process is the truth; a static is honest.
//   M3  Creation order: TOP-DOWN, insert-as-created. Geometry is flex's —
//       layout never depends on native sizing — so bottom-up buys nothing,
//       and a child's insert needs its host view to exist.
//   M4  Re-entrancy: the walk is NOT re-entrant. Attach state is set during
//       the walk; anything that mounts more (set_content, when it ports)
//       enters through `mount` again AFTER the current walk returned —
//       lifecycle notifications fire post-walk, so a handler can never
//       observe a half-mounted tree.
//   M5  What schedules a sync: `core::touch` requests through the hook
//       `install` registers; the backend coalesces requests on its run loop
//       and calls `sync()`. Batched writes stay silent until the closing
//       C_FLUSH lands at depth zero. Headless tests call `sync()` directly.
//   M6  Thread discipline: `install` records the installing thread;
//       `core::touch` asserts every write is on it (facet.cplus).
//   M7  "The mounted tree": a registry of mounted roots; `mounted_root()`
//       answers the MOST RECENTLY mounted — the newest window is the active
//       one until the multi-window runtime decides otherwise. Interim,
//       recorded as such.

import "stdlib/vec" as vec;
import "stdlib/text" as text;
import "stdlib/option" as option;
import "flex_layout/flex_layout" as flex;
import "./facet" as core;
import "./props" as props;
import "./component" as component;

type Node = flex::Node;

// ---- the Renderer ------------------------------------------------------------
// What a backend fills. `create` builds a FULLY CONFIGURED native view for the
// node (reading kind, props and the shared band itself) or returns 0 for a
// node that needs no backing view (a pure-layout container); `apply` re-reads
// a node whose dirty word is non-zero and applies only what the bits name.
// `insert`/`remove` manage native children under a host view, in facet's
// child order. `schedule` asks the backend to run `mount::sync()` on the next
// turn of its loop — coalescing is the backend's job.
struct Renderer {
    opaque ctx: *u8,
    create: fn(*u8, *core::Node) -> *u8,
    view_release: fn(*u8),
    apply: fn(*u8, *core::Node),
    insert: fn(*u8, *u8, *u8, usize),   // (ctx, host view, child view, slot)
    remove: fn(*u8, *u8, *u8),          // (ctx, host view, child view)
    schedule: fn(*u8),
}

fn no_view_release(p: *u8) { return; }

fn renderer_none() -> Renderer {
    return Renderer {
        ctx: 0 as *u8,
        create: 0 as fn(*u8, *core::Node) -> *u8,
        view_release: no_view_release,
        apply: 0 as fn(*u8, *core::Node),
        insert: 0 as fn(*u8, *u8, *u8, usize),
        remove: 0 as fn(*u8, *u8, *u8),
        schedule: 0 as fn(*u8),
    };
}

// M2: the one renderer, and the flag that says a real one arrived.
static RENDERER: Renderer = #zero::[Renderer]();
static INSTALLED: bool = false;

fn installed() -> bool { return INSTALLED; }

// Install the process's backend. Also arms M5 (touch's sync request routes
// to the renderer's scheduler) and M6 (this thread becomes THE UI thread).
fn install(take r: Renderer) {
    RENDERER = r;
    INSTALLED = true;
    core::set_main_thread_id(ui_thread_id());
    core::set_sync_request_fn(request_sync);
    return;
}

// Tests and teardown: back to the portable no-backend posture.
fn uninstall() {
    RENDERER = renderer_none();
    INSTALLED = false;
    core::set_main_thread_id(0 as u64);
    core::set_sync_request_fn(0 as fn());
    MOUNTED.truncate(0 as usize);
    return;
}

#[link_name = "pthread_self"]
extern fn ui_thread_id() -> u64;

fn request_sync() {
    if !INSTALLED { return; }
    let f: fn(*u8) = RENDERER.schedule;
    if f != (0 as fn(*u8)) { f(RENDERER.ctx); }
    return;
}

// ---- mounted roots (M7) ------------------------------------------------------

static MOUNTED: vec::Vec[*core::Node] = #zero::[vec::Vec[*core::Node]]();

fn mounted_count() -> usize { return MOUNTED.count(); }

// The most recently mounted root — the interim answer to "which tree is THE
// mounted tree" until the multi-window runtime decides. 0 when nothing is up.
fn mounted_root() -> *core::Node {
    let n: usize = MOUNTED.count();
    if n == (0 as usize) { return 0 as *core::Node; }
    return match MOUNTED.at(n -% (1 as usize)) {
        option::Option[*core::Node]::Some(p) => p,
        option::Option[*core::Node]::None => 0 as *core::Node,
    };
}

// The post-walk notification queue (M4): nodes whose on_attach/on_detach
// handler must fire AFTER the walk completes, so no handler ever observes a
// half-mounted tree.
static NOTIFY_Q: vec::Vec[*core::Node] = #zero::[vec::Vec[*core::Node]]();

fn drain_attach_queue() {
    var i: usize = 0 as usize;
    let n: usize = NOTIFY_Q.count();
    while i < n {
        match NOTIFY_Q.at(i) {
            option::Option[*core::Node]::Some(p) => { core::fire_attach_handler(p); }
            option::Option[*core::Node]::None => { }
        }
        i = i +% (1 as usize);
    }
    NOTIFY_Q.truncate(0 as usize);
    return;
}

fn drain_detach_queue() {
    var i: usize = 0 as usize;
    let n: usize = NOTIFY_Q.count();
    while i < n {
        match NOTIFY_Q.at(i) {
            option::Option[*core::Node]::Some(p) => { core::fire_detach_handler(p); }
            option::Option[*core::Node]::None => { }
        }
        i = i +% (1 as usize);
    }
    NOTIFY_Q.truncate(0 as usize);
    return;
}

// ---- the mount walk (M3, M4) -------------------------------------------------

// Mount `root`: create views top-down, insert each into the nearest ancestor
// view, mark every node attached. False (and nothing happens) with no
// renderer — the portable posture. The root's own view (if any) is inserted
// nowhere; the caller (a runtime facade) puts it into a window.
fn mount(root: *core::Node) -> bool {
    if !INSTALLED { return false; }
    if root == (0 as *core::Node) { return false; }
    let _slots: usize = mount_walk(root, 0 as *u8, 0 as usize);
    MOUNTED.append(root);
    drain_attach_queue();
    return true;
}

// Unmount: out of the registry, attach state cleared. Views are torn down by
// node teardown (`release_data` fires `view_release`), not here — parking a
// subtree must not destroy what re-attaching needs.
fn unmount(root: *core::Node) {
    var i: usize = 0 as usize;
    let n: usize = MOUNTED.count();
    while i < n {
        let hit: bool = match MOUNTED.at(i) {
            option::Option[*core::Node]::Some(p) => p == root,
            option::Option[*core::Node]::None => false,
        };
        if hit {
            let _r: option::Option[*core::Node] = MOUNTED.swap_remove(i);
            detach_walk(root);
            drain_detach_queue();
            return;
        }
        i = i +% (1 as usize);
    }
    return;
}

// One node: create + insert + recurse. Returns the next free slot in `host`.
// A node WITH a view becomes the host for its subtree (children restart at
// slot 0 inside it); a node WITHOUT one passes its children through to the
// enclosing host, consuming their slots — which is exactly how a pure-layout
// column sits inside a real scroll view.
fn mount_walk(n: *core::Node, host: *u8, slot: usize) -> usize {
    let create: fn(*u8, *core::Node) -> *u8 = RENDERER.create;
    var v: *u8 = 0 as *u8;
    if create != (0 as fn(*u8, *core::Node) -> *u8) { v = create(RENDERER.ctx, n); }
    core::set_attached(n, true);
    NOTIFY_Q.append(n);
    if v != (0 as *u8) {
        core::set_view(n, v, RENDERER.view_release);
        if host != (0 as *u8) {
            let ins: fn(*u8, *u8, *u8, usize) = RENDERER.insert;
            if ins != (0 as fn(*u8, *u8, *u8, usize)) { ins(RENDERER.ctx, host, v, slot); }
        }
        var child_slot: usize = 0 as usize;
        var i: usize = 0 as usize;
        let count: usize = core::child_count_of(n);
        while i < count {
            match core::child_of(n, i) {
                option::Option[*core::Node]::Some(c) => { child_slot = mount_walk(c, v, child_slot); }
                option::Option[*core::Node]::None => { }
            }
            i = i +% (1 as usize);
        }
        return slot +% (1 as usize);
    }
    var s: usize = slot;
    var j: usize = 0 as usize;
    let jcount: usize = core::child_count_of(n);
    while j < jcount {
        match core::child_of(n, j) {
            option::Option[*core::Node]::Some(cj) => { s = mount_walk(cj, host, s); }
            option::Option[*core::Node]::None => { }
        }
        j = j +% (1 as usize);
    }
    return s;
}

fn detach_walk(n: *core::Node) {
    core::set_attached(n, false);
    NOTIFY_Q.append(n);
    var i: usize = 0 as usize;
    let count: usize = core::child_count_of(n);
    while i < count {
        match core::child_of(n, i) {
            option::Option[*core::Node]::Some(c) => { detach_walk(c); }
            option::Option[*core::Node]::None => { }
        }
        i = i +% (1 as usize);
    }
    return;
}

// ---- the sync walk (M5) ------------------------------------------------------

// Apply every dirty node across every mounted root, clear the bits. The
// backend calls this from the scheduler `install` gave it; headless tests
// call it directly.
fn sync() {
    if !INSTALLED { return; }
    var i: usize = 0 as usize;
    let n: usize = MOUNTED.count();
    while i < n {
        match MOUNTED.at(i) {
            option::Option[*core::Node]::Some(p) => { sync_walk(p); }
            option::Option[*core::Node]::None => { }
        }
        i = i +% (1 as usize);
    }
    return;
}

fn sync_walk(n: *core::Node) {
    let d: u64 = core::dirty_of(n);
    if d != (0 as u64) {
        // A dirty node with no view has nothing to apply ONTO; the bits
        // clear either way, or the walk revisits it forever.
        if core::view_of(n) != (0 as *u8) {
            let ap: fn(*u8, *core::Node) = RENDERER.apply;
            if ap != (0 as fn(*u8, *core::Node)) { ap(RENDERER.ctx, n); }
        }
        core::clear_dirty(n);
    }
    var i: usize = 0 as usize;
    let count: usize = core::child_count_of(n);
    while i < count {
        match core::child_of(n, i) {
            option::Option[*core::Node]::Some(c) => { sync_walk(c); }
            option::Option[*core::Node]::None => { }
        }
        i = i +% (1 as usize);
    }
    return;
}

// ---- tests ------------------------------------------------------------------
// The fake renderer is the portable conformance test: pure-C+ stubs behind
// the same struct a real backend fills, so the whole description→views
// pipeline runs headlessly. It backs every node that is a control (kind != 0)
// or carries a key — the same rule a real backend starts from.

static FR_NEXT: u64 = 100 as u64;
static FR_CREATES: i32 = 0;
static FR_APPLIES: i32 = 0;
static FR_RELEASES: i32 = 0;
static FR_SCHEDULES: i32 = 0;
static FR_INS_HOSTS: vec::Vec[u64] = #zero::[vec::Vec[u64]]();
static FR_INS_SLOTS: vec::Vec[u64] = #zero::[vec::Vec[u64]]();

fn fr_reset() {
    FR_NEXT = 100 as u64;
    FR_CREATES = 0;
    FR_APPLIES = 0;
    FR_RELEASES = 0;
    FR_SCHEDULES = 0;
    FR_INS_HOSTS.truncate(0 as usize);
    FR_INS_SLOTS.truncate(0 as usize);
    return;
}

fn fr_create(ctx: *u8, n: *core::Node) -> *u8 {
    let kind: u32 = core::kind_of(n);
    let keyed: bool = { (*n).key() } != "";
    if kind == (0 as u32) && !keyed { return 0 as *u8; }
    FR_CREATES = FR_CREATES + 1;
    FR_NEXT = FR_NEXT +% (1 as u64);
    return FR_NEXT as *u8;
}

fn fr_release(v: *u8) { FR_RELEASES = FR_RELEASES + 1; return; }
fn fr_apply(ctx: *u8, n: *core::Node) { FR_APPLIES = FR_APPLIES + 1; return; }

fn fr_insert(ctx: *u8, host: *u8, child: *u8, slot: usize) {
    FR_INS_HOSTS.append(host as u64);
    FR_INS_SLOTS.append(slot as u64);
    return;
}

fn fr_remove(ctx: *u8, host: *u8, child: *u8) { return; }
fn fr_schedule(ctx: *u8) { FR_SCHEDULES = FR_SCHEDULES + 1; return; }

fn fr_renderer() -> Renderer {
    return Renderer {
        ctx: 0 as *u8,
        create: fr_create,
        view_release: fr_release,
        apply: fr_apply,
        insert: fr_insert,
        remove: fr_remove,
        schedule: fr_schedule,
    };
}

fn fr_leaf(key: str) -> core::Node {
    return core::node_with(key, 7 as u32, 0 as *u8, core::no_release);
}

#[test]
fn mount_without_a_renderer_is_inert() {
    uninstall();
    var root: core::Node = core::column(core::Builder::new(), key: "r");
    assert mount(#addr_of(root)) == false;
    assert mounted_count() == (0 as usize);
    assert core::is_attached(#addr_of(root)) == false;
    return;
}

#[test]
fn mount_creates_topdown_and_inserts_into_the_nearest_host() {
    fr_reset();
    install(fr_renderer());
    // column(key:"root") { leaf(a), column{ leaf(h) }, leaf(b) } — the inner
    // column is unkeyed and kind 0, so the fake declines it: its child must
    // flow through into the ROOT's view at the next slot.
    var b: core::Builder = core::Builder::new();
    b.add(fr_leaf("a"));
    var ib: core::Builder = core::Builder::new();
    ib.add(fr_leaf("h"));
    b.add(core::column(ib));
    b.add(fr_leaf("b"));
    var root: core::Node = core::column(b, key: "root");
    assert mount(#addr_of(root));
    assert mounted_count() == (1 as usize);
    // Root backed (keyed), three leaves backed, inner column passed through.
    assert FR_CREATES == 4;
    let rv: *u8 = core::view_of(#addr_of(root));
    assert rv != (0 as *u8);
    // Every insert landed in the root's view, slots 0,1,2 in walk order.
    assert FR_INS_HOSTS.count() == (3 as usize);
    var i: usize = 0 as usize;
    while i < (3 as usize) {
        match FR_INS_HOSTS.at(i) {
            option::Option[u64]::Some(h) => { assert h == (rv as u64); }
            option::Option[u64]::None => { assert false; }
        }
        match FR_INS_SLOTS.at(i) {
            option::Option[u64]::Some(sl) => { assert sl == (i as u64); }
            option::Option[u64]::None => { assert false; }
        }
        i = i +% (1 as usize);
    }
    // The whole tree is attached, passthrough container included.
    match core::find_in(#addr_of(root), "h") {
        option::Option[*core::Node]::Some(hp) => { assert core::is_attached(hp); }
        option::Option[*core::Node]::None => { assert false; }
    }
    uninstall();
    return;
}

#[test]
fn touch_requests_sync_and_sync_applies_only_dirty() {
    fr_reset();
    install(fr_renderer());
    var b: core::Builder = core::Builder::new();
    b.add(fr_leaf("a"));
    b.add(fr_leaf("z"));
    var root: core::Node = core::column(b, key: "root");
    assert mount(#addr_of(root));
    // M5: an unbatched write requests a sync through the scheduler.
    let before: i32 = FR_SCHEDULES;
    match core::find_in(#addr_of(root), "a") {
        option::Option[*core::Node]::Some(ap) => {
            core::touch(ap, 1 as u64);
            assert FR_SCHEDULES == before + 1;
            // The sync walk applies exactly the dirty node and clears it.
            FR_APPLIES = 0;
            sync();
            assert FR_APPLIES == 1;
            assert core::dirty_of(ap) == (0 as u64);
            sync();
            assert FR_APPLIES == 1;
        }
        option::Option[*core::Node]::None => { assert false; }
    }
    uninstall();
    return;
}

#[test]
fn batched_writes_request_once_at_flush() {
    fr_reset();
    install(fr_renderer());
    var b: core::Builder = core::Builder::new();
    b.add(fr_leaf("a"));
    var root: core::Node = core::column(b, key: "root");
    assert mount(#addr_of(root));
    match core::find_in(#addr_of(root), "a") {
        option::Option[*core::Node]::Some(ap) => {
            let before: i32 = FR_SCHEDULES;
            core::begin_updates(ap);
            core::touch(ap, 1 as u64);
            core::touch(ap, 2 as u64);
            assert FR_SCHEDULES == before;          // silent inside the batch
            core::end_updates(ap);
            assert FR_SCHEDULES == before + 1;      // one request at C_FLUSH
        }
        option::Option[*core::Node]::None => { assert false; }
    }
    uninstall();
    return;
}

#[test]
fn mounted_root_is_the_most_recent_and_unmount_detaches() {
    fr_reset();
    install(fr_renderer());
    var first: core::Node = core::column(core::Builder::new(), key: "one");
    var second: core::Node = core::column(core::Builder::new(), key: "two");
    assert mount(#addr_of(first));
    assert mount(#addr_of(second));
    assert mounted_count() == (2 as usize);
    assert mounted_root() == #addr_of(second);      // M7 interim answer
    unmount(#addr_of(second));
    assert mounted_count() == (1 as usize);
    assert mounted_root() == #addr_of(first);
    assert core::is_attached(#addr_of(second)) == false;
    assert core::is_attached(#addr_of(first));
    uninstall();
    return;
}

#[test]
fn view_release_fires_on_node_teardown() {
    // M1 end to end: the views a mount created are released when the tree
    // drops — through the release the renderer paired with them.
    fr_reset();
    install(fr_renderer());
    {
        var b: core::Builder = core::Builder::new();
        b.add(fr_leaf("a"));
        b.add(fr_leaf("z"));
        var root: core::Node = core::column(b, key: "root");
        assert mount(#addr_of(root));
        assert FR_CREATES == 3;
        assert FR_RELEASES == 0;
        unmount(#addr_of(root));
    }
    // Scope exit dropped the tree: every created view released exactly once.
    assert FR_RELEASES == 3;
    uninstall();
    return;
}

// ---- lifecycle handler tests -------------------------------------------------

static LC_ATTACHES: i32 = 0;
static LC_DETACHES: i32 = 0;
static LC_SAW_SIBLING_ATTACHED: bool = false;
static LC_SIBLING: *core::Node = 0 as *core::Node;

fn lc_on_attach(sender: *u8, ctx: *u8) {
    LC_ATTACHES = LC_ATTACHES + 1;
    // M4: by the time any handler fires the WHOLE tree is attached — even a
    // sibling mounted after this node in walk order.
    if LC_SIBLING != (0 as *core::Node) {
        LC_SAW_SIBLING_ATTACHED = core::is_attached(LC_SIBLING);
    }
    return;
}

fn lc_on_detach(sender: *u8, ctx: *u8) { LC_DETACHES = LC_DETACHES + 1; return; }

#[test]
fn mount_fires_on_attach_after_the_whole_walk() {
    fr_reset();
    LC_ATTACHES = 0;
    LC_DETACHES = 0;
    LC_SAW_SIBLING_ATTACHED = false;
    LC_SIBLING = 0 as *core::Node;
    install(fr_renderer());
    var b: core::Builder = core::Builder::new();
    b.add(fr_leaf("first"));
    b.add(fr_leaf("last"));
    var root: core::Node = core::column(b, key: "root");
    match core::find_in(#addr_of(root), "first") {
        option::Option[*core::Node]::Some(fp) => {
            match core::find_in(#addr_of(root), "last") {
                option::Option[*core::Node]::Some(lp) => {
                    LC_SIBLING = lp;
                    core::set_on_attach(fp, lc_on_attach, 0 as *u8);
                    core::set_on_detach(fp, lc_on_detach, 0 as *u8);
                }
                option::Option[*core::Node]::None => { assert false; }
            }
        }
        option::Option[*core::Node]::None => { assert false; }
    }
    assert mount(#addr_of(root));
    assert LC_ATTACHES == 1;
    // "first" mounts before "last", but its handler fired POST-walk and saw
    // the later sibling already attached.
    assert LC_SAW_SIBLING_ATTACHED;
    unmount(#addr_of(root));
    assert LC_DETACHES == 1;
    LC_SIBLING = 0 as *core::Node;
    uninstall();
    return;
}

// ---- composition: set_content and switch_to ----------------------------------
// The three verbs at three levels (stages/3.md §7):
//
//   set_content(outlet, component)   fill one slot — rebuilds on repeat
//   switch_to(outlet, key)           siblings in an outlet — parks and restores
//   nav::go / push / pop / quit      whole screens, by route name
//
// `set_content` is the composition verb the old facet called `present` — a
// false friend (UIKit's present is MODAL; this is containment, UIKit's
// addChild + addSubview), renamed per the naming lint's own rule. Four
// load-bearing things, each kept from the old verb: build the component,
// make its tree the outlet's ONLY child, force it to fill (without
// `.grow(1).shrink(1)` a plain-column root content-sizes and swallows the
// grow), register the typed detach trampoline, and fire `on_attach`.
//
// `switch_to` is flex parking over `Display::None` — strictly better than
// the old remove/re-insert router: `remove_child` bumps `removal_count()`
// and invalidates every cursor in the application, and a backend's
// removeFromSuperview throws away scroll position, selection and first
// responder — exactly what parking exists to preserve (verified by
// `parking_keeps_cursors_live_and_state_intact`).

// The presentation registry: outlet key -> (component address, typed detach
// trampoline). `set_content` is the only writer; `component_at` reads it
// through the hook the first `set_content` installs.
struct Presented {
    key: text::Text,
    opaque addr: *u8,
    detach: fn(*u8),
}

static PRESENTED: vec::Vec[Presented] = #zero::[vec::Vec[Presented]]();
static PRESENTED_HOOKED: bool = false;

fn presented_component(key: str) -> *u8 {
    var i: usize = 0 as usize;
    let n: usize = PRESENTED.count();
    while i < n {
        match PRESENTED.at_ptr(i) {
            option::Option[*Presented]::Some(p) => {
                if { (*p).key.view() } == key { return { (*p).addr }; }
            }
            option::Option[*Presented]::None => { }
        }
        i = i +% (1 as usize);
    }
    return 0 as *u8;
}

// Evict `key`'s entry: notify the component through its trampoline, drop the
// registration. Every replacement path runs through here.
fn evict_presented(key: str) {
    var i: usize = 0 as usize;
    let n: usize = PRESENTED.count();
    while i < n {
        let hit: bool = match PRESENTED.at_ptr(i) {
            option::Option[*Presented]::Some(p) => ({ (*p).key.view() } == key),
            option::Option[*Presented]::None => false,
        };
        if hit {
            match PRESENTED.at_ptr(i) {
                option::Option[*Presented]::Some(p) => {
                    let f: fn(*u8) = { (*p).detach };
                    let a: *u8 = { (*p).addr };
                    if f != (0 as fn(*u8)) && a != (0 as *u8) { f(a); }
                }
                option::Option[*Presented]::None => { }
            }
            let _r: option::Option[Presented] = PRESENTED.swap_remove(i);
            return;
        }
        i = i +% (1 as usize);
    }
    return;
}

// Fill `outlet` with `c`'s tree. Rebuilds on repeat: the previous occupant is
// notified through its detach trampoline and its subtree is removed. The
// component must outlive the presentation (it is registered by address);
// `component_at::[C](key)` resolves it while the presentation lasts.
fn set_content[C: component::Component + component::Lifecycle](outlet: *core::Node, ref c: C) -> bool {
    if outlet == (0 as *core::Node) { return false; }
    if !PRESENTED_HOOKED {
        component::set_component_at_fn(presented_component);
        PRESENTED_HOOKED = true;
    }
    let okey: str = { (*outlet).key() };
    // Out with the previous occupant — notify first, then remove. Removal is
    // correct here (set_content REBUILDS); parking is switch_to's job.
    evict_presented(okey);
    while { (*outlet).child_count() } > (0 as usize) {
        let _old: option::Option[core::Node] = { (*outlet).remove_child(0 as usize) };
    }
    // Build, force fill, adopt.
    var tree: core::Node = c.build();
    tree = tree.grow(1.0f64).shrink(1.0f64);
    { (*outlet).add_child(tree) };
    // Register the typed detach trampoline under the outlet's key.
    PRESENTED.append(Presented {
        key: text::from_str(okey),
        addr: #addr_of(c) as *u8,
        detach: component::lc_detach_tramp::[C],
    });
    // Mount the new subtree when the outlet is live under a renderer; attach
    // flags and node-level handlers ride the M4 queue either way.
    if core::is_attached(outlet) {
        let host: *u8 = nearest_host(outlet);
        match core::child_of(outlet, 0 as usize) {
            option::Option[*core::Node]::Some(cp) => {
                if INSTALLED {
                    let _s: usize = mount_walk(cp, host, 0 as usize);
                } else {
                    attach_flags_walk(cp);
                }
                drain_attach_queue();
            }
            option::Option[*core::Node]::None => { }
        }
    }
    // The component-level lifecycle, exactly as the old verb fired it.
    c.on_attach();
    core::touch(outlet, props::C_FLUSH);
    return true;
}

// The nearest enclosing view for `n` — where a freshly built subtree's views
// insert. The outlet's own view when it is backed (keyed outlets are); else a
// search down from the mounted roots carrying the last backed ancestor.
// flex nodes carry no parent pointer, so the walk goes down, not up.
static HS_RESULT: *u8 = 0 as *u8;
static HS_FOUND: bool = false;

fn nearest_host(n: *core::Node) -> *u8 {
    let own: *u8 = core::view_of(n);
    if own != (0 as *u8) { return own; }
    HS_RESULT = 0 as *u8;
    HS_FOUND = false;
    var i: usize = 0 as usize;
    let count: usize = MOUNTED.count();
    while i < count {
        if !HS_FOUND {
            match MOUNTED.at(i) {
                option::Option[*core::Node]::Some(r) => { host_search(r, 0 as *u8, n); }
                option::Option[*core::Node]::None => { }
            }
        }
        i = i +% (1 as usize);
    }
    return HS_RESULT;
}

fn host_search(cur: *core::Node, host: *u8, target: *core::Node) {
    if HS_FOUND { return; }
    var h: *u8 = host;
    let v: *u8 = core::view_of(cur);
    if v != (0 as *u8) { h = v; }
    if cur == target {
        HS_RESULT = h;
        HS_FOUND = true;
        return;
    }
    var i: usize = 0 as usize;
    let count: usize = core::child_count_of(cur);
    while i < count {
        match core::child_of(cur, i) {
            option::Option[*core::Node]::Some(c) => { host_search(c, h, target); }
            option::Option[*core::Node]::None => { }
        }
        i = i +% (1 as usize);
    }
    return;
}

// Headless attach: flags + M4 queue, no views.
fn attach_flags_walk(n: *core::Node) {
    core::set_attached(n, true);
    NOTIFY_Q.append(n);
    var i: usize = 0 as usize;
    let count: usize = core::child_count_of(n);
    while i < count {
        match core::child_of(n, i) {
            option::Option[*core::Node]::Some(c) => { attach_flags_walk(c); }
            option::Option[*core::Node]::None => { }
        }
        i = i +% (1 as usize);
    }
    return;
}

// Show exactly the child of `outlet` keyed `key`; park every other child
// under `Display::None`. Views, scroll positions, selection and cursors all
// survive the park — nothing is removed. Node-level lifecycle handlers fire
// on the children whose state changed, post-swap. False when no child
// carries the key (and nothing changes).
fn switch_to(outlet: *core::Node, key: str) -> bool {
    if outlet == (0 as *core::Node) { return false; }
    // First pass: the key must exist, or this is a typo and a no-op.
    var found: bool = false;
    var i: usize = 0 as usize;
    let n: usize = core::child_count_of(outlet);
    while i < n {
        match core::child_of(outlet, i) {
            option::Option[*core::Node]::Some(c) => {
                if { (*c).key() } == key { found = true; }
            }
            option::Option[*core::Node]::None => { }
        }
        i = i +% (1 as usize);
    }
    if !found { return false; }
    var j: usize = 0 as usize;
    while j < n {
        match core::child_of(outlet, j) {
            option::Option[*core::Node]::Some(c) => {
                let show: bool = { (*c).key() } == key;
                let shown: bool = match { (*c).display() } {
                    flex::Display::None => false,
                    flex::Display::Flex => true,
                    flex::Display::Grid => true,
                };
                if show && !shown {
                    { (*c).set_display(flex::Display::Flex) };
                    core::set_attached(c, true);
                    NOTIFY_Q.append(c);
                    drain_attach_queue();
                }
                if !show && shown {
                    { (*c).set_display(flex::Display::None) };
                    core::set_attached(c, false);
                    NOTIFY_Q.append(c);
                    drain_detach_queue();
                }
            }
            option::Option[*core::Node]::None => { }
        }
        j = j +% (1 as usize);
    }
    core::touch(outlet, props::C_FLUSH);
    return true;
}

// ---- composition tests -------------------------------------------------------

struct ScComp {
    n: i32,
    attaches: i32,
    detaches: i32,
}

impl ScComp: component::Component {
    fn build(ref this) -> core::Node {
        var b: core::Builder = core::Builder::new();
        b.add(core::node_with("inner", 7 as u32, 0 as *u8, core::no_release));
        return core::column(b);
    }
}

impl ScComp: component::Lifecycle {
    fn on_attach(ref this) { this.attaches = this.attaches + 1; return; }
    fn on_detach(ref this) { this.detaches = this.detaches + 1; return; }
}

#[test]
fn set_content_fills_registers_and_rebuilds_on_repeat() {
    uninstall();                     // headless: the tree is the whole truth
    var outlet: core::Node = core::column(core::Builder::new(), key: "slot");
    core::set_attached(#addr_of(outlet), true);
    var c: ScComp = ScComp { n: 1, attaches: 0, detaches: 0 };
    assert set_content(#addr_of(outlet), c);
    assert outlet.child_count() == (1 as usize);
    assert c.attaches == 1;
    // The typed reader resolves the presented instance while it lasts.
    match component::component_at::[ScComp]("slot") {
        option::Option[*ScComp]::Some(p) => { assert p == #addr_of(c); }
        option::Option[*ScComp]::None => { assert false; }
    }
    // The built subtree is attached and findable.
    match core::find_in(#addr_of(outlet), "inner") {
        option::Option[*core::Node]::Some(ip) => { assert core::is_attached(ip); }
        option::Option[*core::Node]::None => { assert false; }
    }
    // Repeat REBUILDS: previous occupant notified, replaced, still one child.
    var c2: ScComp = ScComp { n: 2, attaches: 0, detaches: 0 };
    assert set_content(#addr_of(outlet), c2);
    assert c.detaches == 1;
    assert c2.attaches == 1;
    assert outlet.child_count() == (1 as usize);
    match component::component_at::[ScComp]("slot") {
        option::Option[*ScComp]::Some(p2) => { assert p2 == #addr_of(c2); }
        option::Option[*ScComp]::None => { assert false; }
    }
    evict_presented("slot");
    return;
}

#[test]
fn switch_to_parks_under_display_none_and_restores() {
    uninstall();
    LC_DETACHES = 0;
    LC_ATTACHES = 0;
    LC_SIBLING = 0 as *core::Node;
    var b: core::Builder = core::Builder::new();
    b.add(fr_leaf("a"));
    b.add(fr_leaf("z"));
    var outlet: core::Node = core::column(b, key: "panes");
    core::set_attached(#addr_of(outlet), true);
    match core::find_in(#addr_of(outlet), "a") {
        option::Option[*core::Node]::Some(ap) => {
            core::set_on_detach(ap, lc_on_detach, 0 as *u8);
            core::set_on_attach(ap, lc_on_attach, 0 as *u8);
            // Show "z": "a" parks — display None, detached, notified — and
            // NOTHING is removed (the cursor-invalidating router is gone).
            assert switch_to(#addr_of(outlet), "z");
            assert outlet.child_count() == (2 as usize);
            let parked: bool = match { (*ap).display() } {
                flex::Display::None => true,
                flex::Display::Flex => false,
                flex::Display::Grid => false,
            };
            assert parked;
            assert core::is_attached(ap) == false;
            assert LC_DETACHES == 1;
            // Back to "a": restored, re-attached, notified.
            assert switch_to(#addr_of(outlet), "a");
            let shown: bool = match { (*ap).display() } {
                flex::Display::Flex => true,
                flex::Display::None => false,
                flex::Display::Grid => false,
            };
            assert shown;
            assert core::is_attached(ap);
            assert LC_ATTACHES == 1;
        }
        option::Option[*core::Node]::None => { assert false; }
    }
    // A key no child carries: false, and nothing moves.
    assert switch_to(#addr_of(outlet), "nope") == false;
    return;
}
