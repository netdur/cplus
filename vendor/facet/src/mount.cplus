// facet mount — the seam between the description and a backend. HAND-WRITTEN.
//
// facet has a tree, 42 controls and a dirty word per node; nothing appears
// anywhere until something walks that tree and hands it to a backend. This
// module is that something, and it is platform-free: the walk is the same
// everywhere, only what it calls into differs.
//
// The seam is SMALL by design. Stage 2's rule — a setter writes one field and
// sets one bit, never a per-verb registrar — means the backend needs exactly
// five verbs and a scheduler, not a vtable of ops per control. The ~37
// per-kind apply functions exist, but they live INSIDE the backend's `create`
// and `apply`, dispatching on `Data.kind`; facet never sees them.
//
// The seven decisions from stages/3.md, answered here:
//
//   M1  Who releases the native view: `Data.view_release`, set with the view
//       (facet.cplus — the third (payload, release) pair on Data).
//   M2  Where the Renderer lives: ONE static value, set at startup by
//       `install`. One backend per process is the truth; a static is honest.
//   M3  Creation order: TOP-DOWN, insert-as-created. Geometry is flex's —
//       layout never depends on native sizing — so bottom-up buys nothing,
//       and a child's insert needs its host view to exist.
//   M4  Re-entrancy: the walk is NOT re-entrant. Attach state is set during
//       the walk; anything that mounts more (set_content, when it ports)
//       enters through `mount` again AFTER the current walk returned —
//       lifecycle notifications fire post-walk, so a handler can never
//       observe a half-mounted tree.
//   M5  What schedules a sync: `core::touch` requests through the hook
//       `install` registers; the backend coalesces requests on its run loop
//       and calls `sync()`. Batched writes stay silent until the closing
//       C_FLUSH lands at depth zero. Headless tests call `sync()` directly.
//   M6  Thread discipline: `install` records the installing thread;
//       `core::touch` asserts every write is on it (facet.cplus).
//   M7  "The mounted tree": the RUNNING app's windows (application.cplus). One exe
//       may contain several apps (one runs at a time); an app has many
//       windows shown at once; `mounted_root()` answers the newest window's
//       root. Nothing here is a module static — mounting into app B after
//       app A quits starts from B's own clean window list.

import "stdlib/vec" as vec;
import "stdlib/text" as text;
import "stdlib/option" as option;
import "flex_layout/flex_layout" as flex;
import "./facet" as core;
import "./props" as props;
import "./component" as component;
import "./application" as app;

type Node = flex::Node;

// ---- the Renderer ------------------------------------------------------------
// What a backend fills. `create` builds a FULLY CONFIGURED native view for the
// node (reading kind, props and the shared band itself) or returns 0 for a
// node that needs no backing view (a pure-layout container); `apply` re-reads
// a node whose dirty word is non-zero and applies only what the bits name.
// `insert`/`remove` manage native children under a host view, in facet's
// child order. `schedule` asks the backend to run `mount::sync()` on the next
// turn of its loop — coalescing is the backend's job.
struct Renderer {
    opaque ctx: *u8,
    create: fn(*u8, *core::Node) -> *u8,
    view_release: fn(*u8),
    apply: fn(*u8, *core::Node),
    insert: fn(*u8, *u8, *u8, usize),   // (ctx, host view, child view, slot)
    remove: fn(*u8, *u8, *u8),          // (ctx, host view, child view)
    schedule: fn(*u8),
}

fn no_view_release(p: *u8) { return; }

fn renderer_none() -> Renderer {
    return Renderer {
        ctx: 0 as *u8,
        create: 0 as fn(*u8, *core::Node) -> *u8,
        view_release: no_view_release,
        apply: 0 as fn(*u8, *core::Node),
        insert: 0 as fn(*u8, *u8, *u8, usize),
        remove: 0 as fn(*u8, *u8, *u8),
        schedule: 0 as fn(*u8),
    };
}

// M2: the one renderer. "Installed" is DERIVED — a backend without a
// `create` hook is no backend, and a separate flag could disagree.
static RENDERER: Renderer = #zero::[Renderer]();

fn installed() -> bool { return RENDERER.create != (0 as fn(*u8, *core::Node) -> *u8); }

// Install the process's backend. Also arms M5 (touch's sync request routes
// to the renderer's scheduler) and M6 (this thread becomes THE UI thread).
fn install(take r: Renderer) {
    RENDERER = r;
    core::set_main_thread_id(ui_thread_id());
    core::set_sync_request_fn(request_sync);
    return;
}

// Tests and teardown: back to the portable no-backend posture.
fn uninstall() {
    RENDERER = renderer_none();
    core::set_main_thread_id(0 as u64);
    core::set_sync_request_fn(0 as fn());
    return;
}

#[link_name = "pthread_self"]
extern fn ui_thread_id() -> u64;

fn request_sync() {
    if !installed() { return; }
    let f: fn(*u8) = RENDERER.schedule;
    if f != (0 as fn(*u8)) { f(RENDERER.ctx); }
    return;
}

// ---- mounted windows (M7) ----------------------------------------------------
// Owned by the RUNNING app (application.cplus), never by this module: a mount opens
// a window of the current app, an unmount closes it.

fn mounted_count() -> usize { return app::window_count(); }

// The newest window's root of the RUNNING app. Facades use it for "the
// active window"; bare `find` does NOT — see find_node below.
fn mounted_root() -> *core::Node {
    return app::newest_window_root();
}

// The DOM rule (user decision, 2026-08-04): a bare `find(key)` resolves like
// getElementById — the running app's windows in OPEN order, each tree in
// document order, FIRST match wins. Two windows sharing a key is legal;
// callers that mean the other one say `within:`.
fn find_node(key: str) -> option::Option[*core::Node] {
    var i: usize = 0 as usize;
    let n: usize = app::window_count();
    while i < n {
        let r: *core::Node = app::window_root(i);
        if r != (0 as *core::Node) {
            match core::find_in(r, key) {
                option::Option[*core::Node]::Some(p) => { return option::Option[*core::Node]::Some(p); }
                option::Option[*core::Node]::None => { }
            }
        }
        i = i +% (1 as usize);
    }
    return option::Option[*core::Node]::None;
}

// `find` is the word an app writes; `find_node` is the resolver the 42 typed
// finds share. Same rule, same answer — this one hands back the node itself,
// for the places where there is no control to narrow to (an outlet is a keyed
// column, and `set_content` wants the node, not a cursor).
//
// `within:` matches the typed finds exactly, so the signature reads the same
// whether you are asking for a Button or for a bare node.
fn find(key: str, within: *core::Node = 0 as *core::Node) -> option::Option[*core::Node] {
    if within != (0 as *core::Node) { return core::find_in(within, key); }
    return find_node(key);
}

// The post-walk notification queue (M4): nodes whose on_attach/on_detach
// handler must fire AFTER the walk completes, so no handler ever observes a
// half-mounted tree. A LOCAL of each walk's caller, threaded by `ref` — the
// queue's lifetime is one walk, so nothing about it is process state.

fn drain_attach_queue(ref q: vec::Vec[*core::Node]) {
    var i: usize = 0 as usize;
    let n: usize = q.count();
    while i < n {
        match q.at(i) {
            option::Option[*core::Node]::Some(p) => { core::fire_attach_handler(p); }
            option::Option[*core::Node]::None => { }
        }
        i = i +% (1 as usize);
    }
    q.truncate(0 as usize);
    return;
}

fn drain_detach_queue(ref q: vec::Vec[*core::Node]) {
    var i: usize = 0 as usize;
    let n: usize = q.count();
    while i < n {
        match q.at(i) {
            option::Option[*core::Node]::Some(p) => { core::fire_detach_handler(p); }
            option::Option[*core::Node]::None => { }
        }
        i = i +% (1 as usize);
    }
    q.truncate(0 as usize);
    return;
}

// ---- the mount walk (M3, M4) -------------------------------------------------

// Mount `root`: create views top-down, insert each into the nearest ancestor
// view, mark every node attached. False (and nothing happens) with no
// renderer — the portable posture. The root's own view (if any) is inserted
// nowhere; the caller (a runtime facade) puts it into a window.
fn mount(root: *core::Node) -> bool {
    if !installed() { return false; }
    if root == (0 as *core::Node) { return false; }
    var q: vec::Vec[*core::Node] = vec::new::[*core::Node]();
    let _slots: usize = mount_walk(root, 0 as *u8, 0 as usize, q);
    app::open_window(root);
    drain_attach_queue(q);
    return true;
}

// ---- the second mount path: a detached subtree --------------------------------
//
// `mount` opens a WINDOW. `add_child` / `insert_child` put a node into a tree
// that is already mounted. Neither is what a RECYCLING list needs, and that is
// the whole reason this pair exists.
//
// A recycled row is a subtree that is not in facet's tree at all: the platform
// owns it, builds it when the row scrolls in, and destroys it when the row
// scrolls out. It never has a facet parent, so it can never be reached by a
// walk from a window root — and a backend that re-implemented the walk to
// realise one itself would be duplicating M3, which is drift.
//
// So the seam says it out loud. `realise` runs exactly the same walk `mount`
// does, minus the window and minus the insert (the caller has its own host and
// will place the view itself); `unrealise` is the matching teardown.
//
// The caller OWNS the node: it must outlive the view, and dropping it is what
// releases the view (through the same `view_release` pairing every other node
// uses — M1 holds here too).
// `host` is the caller's own view, and passing it matters for the ordinary
// case rather than the exotic one: a row's root is usually a bare container,
// which is not backed (nothing keys it, nothing gives it gestures), so its
// children have to land somewhere. That somewhere is the host — the same
// pass-through rule a layout-only column follows inside a real scroll view.
//
// Answers the root's view when it has one, so a caller that placed a backed
// root can find it; with a host, the placing has already happened.
fn realise(n: *core::Node, host: *u8 = 0 as *u8) -> *u8 {
    if !installed() { return 0 as *u8; }
    if n == (0 as *core::Node) { return 0 as *u8; }
    var q: vec::Vec[*core::Node] = vec::new::[*core::Node]();
    let _slots: usize = mount_walk(n, host, 0 as usize, q);
    drain_attach_queue(q);
    return core::view_of(n);
}

// The matching teardown: on_detach fires, attach state clears. Views go the
// same way they always do — with the node.
fn unrealise(n: *core::Node) {
    if n == (0 as *core::Node) { return; }
    var q: vec::Vec[*core::Node] = vec::new::[*core::Node]();
    detach_walk(n, q);
    drain_detach_queue(q);
    return;
}

// Apply the dirty bits over a subtree that is NOT in a window.
//
// `sync` walks the running app's windows, which is every tree facet owns — and
// a realised row is not one of them. So a write into a realised subtree (the
// bind step of a recycling list, say) marks its nodes dirty and nothing ever
// carries them across. This is the door for that: the same walk `sync` uses,
// rooted where the caller says.
//
// The caller is the one that knows the subtree changed, and it is the same
// caller that realised it — so no coalescing happens here. A backend that binds
// a row applies it immediately, because the row is about to be shown.
fn sync_from(n: *core::Node) {
    if !installed() { return; }
    if n == (0 as *core::Node) { return; }
    sync_walk(n);
    return;
}

// Unmount: out of the registry, attach state cleared. Views are torn down by
// node teardown (`release_data` fires `view_release`), not here — parking a
// subtree must not destroy what re-attaching needs.
fn unmount(root: *core::Node) {
    app::close_window(root);
    var q: vec::Vec[*core::Node] = vec::new::[*core::Node]();
    detach_walk(root, q);
    drain_detach_queue(q);
    return;
}

// One node: create + insert + recurse. Returns the next free slot in `host`.
// A node WITH a view becomes the host for its subtree (children restart at
// slot 0 inside it); a node WITHOUT one passes its children through to the
// enclosing host, consuming their slots — which is exactly how a pure-layout
// column sits inside a real scroll view.
fn mount_walk(n: *core::Node, host: *u8, slot: usize, ref q: vec::Vec[*core::Node]) -> usize {
    let create: fn(*u8, *core::Node) -> *u8 = RENDERER.create;
    var v: *u8 = 0 as *u8;
    if create != (0 as fn(*u8, *core::Node) -> *u8) { v = create(RENDERER.ctx, n); }
    core::set_attached(n, true);
    q.append(n);
    if v != (0 as *u8) {
        core::set_view(n, v, RENDERER.view_release);
        if host != (0 as *u8) {
            let ins: fn(*u8, *u8, *u8, usize) = RENDERER.insert;
            if ins != (0 as fn(*u8, *u8, *u8, usize)) { ins(RENDERER.ctx, host, v, slot); }
        }
        var child_slot: usize = 0 as usize;
        var i: usize = 0 as usize;
        let count: usize = core::child_count_of(n);
        while i < count {
            match core::child_of(n, i) {
                option::Option[*core::Node]::Some(c) => { child_slot = mount_walk(c, v, child_slot, q); }
                option::Option[*core::Node]::None => { }
            }
            i = i +% (1 as usize);
        }
        return slot +% (1 as usize);
    }
    var s: usize = slot;
    var j: usize = 0 as usize;
    let jcount: usize = core::child_count_of(n);
    while j < jcount {
        match core::child_of(n, j) {
            option::Option[*core::Node]::Some(cj) => { s = mount_walk(cj, host, s, q); }
            option::Option[*core::Node]::None => { }
        }
        j = j +% (1 as usize);
    }
    return s;
}

fn detach_walk(n: *core::Node, ref q: vec::Vec[*core::Node]) {
    core::set_attached(n, false);
    q.append(n);
    var i: usize = 0 as usize;
    let count: usize = core::child_count_of(n);
    while i < count {
        match core::child_of(n, i) {
            option::Option[*core::Node]::Some(c) => { detach_walk(c, q); }
            option::Option[*core::Node]::None => { }
        }
        i = i +% (1 as usize);
    }
    return;
}

// ---- the sync walk (M5) ------------------------------------------------------

// Apply every dirty node across every mounted root, clear the bits. The
// backend calls this from the scheduler `install` gave it; headless tests
// call it directly.
fn sync() {
    if !installed() { return; }
    var i: usize = 0 as usize;
    let n: usize = app::window_count();
    while i < n {
        let r: *core::Node = app::window_root(i);
        if r != (0 as *core::Node) { sync_walk(r); }
        i = i +% (1 as usize);
    }
    return;
}

fn sync_walk(n: *core::Node) {
    let _absorbed: bool = sync_subtree(n);
    return;
}

// Apply every dirty node, and route the ones that have no view of their own.
//
// A viewless node is not a node without an answer — it is a node whose answer
// is DRAWN BY AN ANCESTOR. A `span` is a run inside its label's attributed
// string; a `menu_item` is a row in its menu's NSMenu. Both are real, both are
// settable, and the walk used to clear their bits and apply nothing, so
// `span.set_text("x")` after mount reached the tree and never the screen —
// silently, because a cleared bit looks exactly like a delivered one.
//
// The rule: a dirty node with a view applies itself; a dirty node WITHOUT one
// makes its nearest backed ancestor re-apply. The ancestor re-applies WHOLE
// (`core::touch_all`) because it cannot be told which of its own verbs the
// child's change affects — a label reads its spans while rendering its text,
// and there is no bit for "a run changed".
//
// Returns whether a viewless descendant changed and has not yet been absorbed
// by a backed ancestor. The root absorbing nothing is correct: a viewless root
// has no one to draw it, so there is nothing to re-apply.
fn sync_subtree(n: *core::Node) -> bool {
    let backed: bool = core::view_of(n) != (0 as *u8);
    let d: u64 = core::dirty_of(n);
    var pending: bool = false;
    if d != (0 as u64) {
        if backed { apply_now(n); } else { pending = true; }
        core::clear_dirty(n);
    }
    var i: usize = 0 as usize;
    let count: usize = core::child_count_of(n);
    while i < count {
        match core::child_of(n, i) {
            // A BACKED child absorbs its own subtree's viewless changes, so
            // this only ever carries what belongs to THIS host.
            option::Option[*core::Node]::Some(c) => { if sync_subtree(c) { pending = true; } }
            option::Option[*core::Node]::None => { }
        }
        i = i +% (1 as usize);
    }
    if backed && pending {
        // Once per host per sync, however many of its runs changed.
        core::touch_all(n);
        apply_now(n);
        core::clear_dirty(n);
        return false;
    }
    return pending;
}

fn apply_now(n: *core::Node) {
    let ap: fn(*u8, *core::Node) = RENDERER.apply;
    if ap != (0 as fn(*u8, *core::Node)) { ap(RENDERER.ctx, n); }
    return;
}

// ---- tests ------------------------------------------------------------------
// The fake renderer is the portable conformance test: pure-C+ stubs behind
// the same struct a real backend fills, so the whole description→views
// pipeline runs headlessly. It backs every node that is a control (kind != 0)
// or carries a key — the same rule a real backend starts from.

static FR_NEXT: u64 = 100 as u64;
static FR_CREATES: i32 = 0;
static FR_APPLIES: i32 = 0;
static FR_RELEASES: i32 = 0;
static FR_SCHEDULES: i32 = 0;
static FR_INS_HOSTS: vec::Vec[u64] = #zero::[vec::Vec[u64]]();
static FR_INS_SLOTS: vec::Vec[u64] = #zero::[vec::Vec[u64]]();
static FR_REMOVES: i32 = 0;

fn fr_reset() {
    app::reset_default_for_tests();
    FR_NEXT = 100 as u64;
    FR_CREATES = 0;
    FR_APPLIES = 0;
    FR_RELEASES = 0;
    FR_SCHEDULES = 0;
    FR_INS_HOSTS.truncate(0 as usize);
    FR_INS_SLOTS.truncate(0 as usize);
    FR_REMOVES = 0;
    return;
}

fn fr_create(ctx: *u8, n: *core::Node) -> *u8 {
    let kind: u32 = core::kind_of(n);
    let keyed: bool = { (*n).key() } != "";
    if kind == (0 as u32) && !keyed { return 0 as *u8; }
    FR_CREATES = FR_CREATES + 1;
    FR_NEXT = FR_NEXT +% (1 as u64);
    return FR_NEXT as *u8;
}

fn fr_release(v: *u8) { FR_RELEASES = FR_RELEASES + 1; return; }
fn fr_apply(ctx: *u8, n: *core::Node) { FR_APPLIES = FR_APPLIES + 1; return; }

fn fr_insert(ctx: *u8, host: *u8, child: *u8, slot: usize) {
    FR_INS_HOSTS.append(host as u64);
    FR_INS_SLOTS.append(slot as u64);
    return;
}

fn fr_remove(ctx: *u8, host: *u8, child: *u8) { FR_REMOVES = FR_REMOVES + 1; return; }
fn fr_schedule(ctx: *u8) { FR_SCHEDULES = FR_SCHEDULES + 1; return; }

fn fr_renderer() -> Renderer {
    return Renderer {
        ctx: 0 as *u8,
        create: fr_create,
        view_release: fr_release,
        apply: fr_apply,
        insert: fr_insert,
        remove: fr_remove,
        schedule: fr_schedule,
    };
}

fn fr_leaf(key: str) -> core::Node {
    return core::node_with(key, 7 as u32, 0 as *u8, core::no_release);
}

#[test]
fn mount_without_a_renderer_is_inert() {
    app::reset_default_for_tests();
    uninstall();
    var root: core::Node = core::column(core::Builder::new(), key: "r");
    assert mount(#addr_of(root)) == false;
    assert mounted_count() == (0 as usize);
    assert core::is_attached(#addr_of(root)) == false;
    return;
}

#[test]
fn mount_creates_topdown_and_inserts_into_the_nearest_host() {
    fr_reset();
    install(fr_renderer());
    // column(key:"root") { leaf(a), column{ leaf(h) }, leaf(b) } — the inner
    // column is unkeyed and kind 0, so the fake declines it: its child must
    // flow through into the ROOT's view at the next slot.
    var b: core::Builder = core::Builder::new();
    b.add(fr_leaf("a"));
    var ib: core::Builder = core::Builder::new();
    ib.add(fr_leaf("h"));
    b.add(core::column(ib));
    b.add(fr_leaf("b"));
    var root: core::Node = core::column(b, key: "root");
    assert mount(#addr_of(root));
    assert mounted_count() == (1 as usize);
    // Root backed (keyed), three leaves backed, inner column passed through.
    assert FR_CREATES == 4;
    let rv: *u8 = core::view_of(#addr_of(root));
    assert rv != (0 as *u8);
    // Every insert landed in the root's view, slots 0,1,2 in walk order.
    assert FR_INS_HOSTS.count() == (3 as usize);
    var i: usize = 0 as usize;
    while i < (3 as usize) {
        match FR_INS_HOSTS.at(i) {
            option::Option[u64]::Some(h) => { assert h == (rv as u64); }
            option::Option[u64]::None => { assert false; }
        }
        match FR_INS_SLOTS.at(i) {
            option::Option[u64]::Some(sl) => { assert sl == (i as u64); }
            option::Option[u64]::None => { assert false; }
        }
        i = i +% (1 as usize);
    }
    // The whole tree is attached, passthrough container included.
    match core::find_in(#addr_of(root), "h") {
        option::Option[*core::Node]::Some(hp) => { assert core::is_attached(hp); }
        option::Option[*core::Node]::None => { assert false; }
    }
    uninstall();
    return;
}

#[test]
fn touch_requests_sync_and_sync_applies_only_dirty() {
    fr_reset();
    install(fr_renderer());
    var b: core::Builder = core::Builder::new();
    b.add(fr_leaf("a"));
    b.add(fr_leaf("z"));
    var root: core::Node = core::column(b, key: "root");
    assert mount(#addr_of(root));
    // M5: an unbatched write requests a sync through the scheduler.
    let before: i32 = FR_SCHEDULES;
    match core::find_in(#addr_of(root), "a") {
        option::Option[*core::Node]::Some(ap) => {
            core::touch(ap, 1 as u64);
            assert FR_SCHEDULES == before + 1;
            // The sync walk applies exactly the dirty node and clears it.
            FR_APPLIES = 0;
            sync();
            assert FR_APPLIES == 1;
            assert core::dirty_of(ap) == (0 as u64);
            sync();
            assert FR_APPLIES == 1;
        }
        option::Option[*core::Node]::None => { assert false; }
    }
    uninstall();
    return;
}

#[test]
fn batched_writes_request_once_at_flush() {
    fr_reset();
    install(fr_renderer());
    var b: core::Builder = core::Builder::new();
    b.add(fr_leaf("a"));
    var root: core::Node = core::column(b, key: "root");
    assert mount(#addr_of(root));
    match core::find_in(#addr_of(root), "a") {
        option::Option[*core::Node]::Some(ap) => {
            let before: i32 = FR_SCHEDULES;
            core::begin_updates(ap);
            core::touch(ap, 1 as u64);
            core::touch(ap, 2 as u64);
            assert FR_SCHEDULES == before;          // silent inside the batch
            core::end_updates(ap);
            assert FR_SCHEDULES == before + 1;      // one request at C_FLUSH
        }
        option::Option[*core::Node]::None => { assert false; }
    }
    uninstall();
    return;
}

// ---- geometry writes are on the dirty path too --------------------------------
// The size verbs used to write flex's style and set NO bit, so a runtime
// `set_width` reached the tree and never the screen. They mark C_LAYOUT now,
// which requests a sync exactly like a prop write.

#[test]
fn a_size_write_requests_a_sync_and_marks_layout() {
    fr_reset();
    install(fr_renderer());
    var b: core::Builder = core::Builder::new();
    b.add(fr_leaf("side"));
    var root: core::Node = core::column(b, key: "root");
    assert mount(#addr_of(root));
    match core::find_in(#addr_of(root), "side") {
        option::Option[*core::Node]::Some(sp) => {
            let before: i32 = FR_SCHEDULES;
            core::set_width(sp, 300.0f64);
            // M5: the write woke the backend...
            assert FR_SCHEDULES == before + 1;
            // ...and said GEOMETRY, not props.
            assert (core::dirty_of(sp) & props::C_LAYOUT) != (0 as u64);
            // The sync walk clears it like any other bit.
            sync();
            assert core::dirty_of(sp) == (0 as u64);
            // Every sibling verb in the band does the same.
            core::set_grow(sp, 1.0f64);
            assert (core::dirty_of(sp) & props::C_LAYOUT) != (0 as u64);
            core::clear_dirty(sp);
            core::set_padding(sp, 8.0f64);
            assert (core::dirty_of(sp) & props::C_LAYOUT) != (0 as u64);
            core::clear_dirty(sp);
            core::set_gap(sp, 4.0f64);
            assert (core::dirty_of(sp) & props::C_LAYOUT) != (0 as u64);
            core::clear_dirty(sp);
            core::set_align(sp, flex::Align::Center);
            assert (core::dirty_of(sp) & props::C_LAYOUT) != (0 as u64);
            core::clear_dirty(sp);
            core::set_z_index(sp, 3 as i64);
            assert (core::dirty_of(sp) & props::C_LAYOUT) != (0 as u64);
            core::clear_dirty(sp);
            // relayout() asks for the pass its invalidation needs.
            core::relayout(sp);
            assert (core::dirty_of(sp) & props::C_LAYOUT) != (0 as u64);
        }
        option::Option[*core::Node]::None => { assert false; }
    }
    uninstall();
    return;
}

#[test]
fn geometry_writes_batch_and_stay_off_dataless_nodes() {
    fr_reset();
    install(fr_renderer());
    var root: core::Node = core::column(core::Builder::new(), key: "root");
    assert mount(#addr_of(root));
    let rp: *core::Node = #addr_of(root);
    // Batched: silent until the closing flush, like every other write.
    let before: i32 = FR_SCHEDULES;
    core::begin_updates(rp);
    core::set_width(rp, 100.0f64);
    core::set_height(rp, 50.0f64);
    assert FR_SCHEDULES == before;
    core::end_updates(rp);
    assert FR_SCHEDULES == before + 1;
    uninstall();
    // Negative: a raw flex node carries no Data, so there is nothing to mark
    // — the write still lands in flex's style and nothing traps.
    var bare: flex::Node = flex::box();
    core::set_width(#addr_of(bare), 42.0f64);
    assert core::dirty_of(#addr_of(bare)) == (0 as u64);
    // And a null cursor is inert, the standing convention.
    core::set_width(0 as *core::Node, 10.0f64);
    core::relayout(0 as *core::Node);
    return;
}

#[test]
fn mounted_root_is_the_most_recent_and_unmount_detaches() {
    fr_reset();
    install(fr_renderer());
    var first: core::Node = core::column(core::Builder::new(), key: "one");
    var second: core::Node = core::column(core::Builder::new(), key: "two");
    assert mount(#addr_of(first));
    assert mount(#addr_of(second));
    assert mounted_count() == (2 as usize);
    assert mounted_root() == #addr_of(second);      // M7 interim answer
    unmount(#addr_of(second));
    assert mounted_count() == (1 as usize);
    assert mounted_root() == #addr_of(first);
    assert core::is_attached(#addr_of(second)) == false;
    assert core::is_attached(#addr_of(first));
    uninstall();
    return;
}

#[test]
fn view_release_fires_on_node_teardown() {
    // M1 end to end: the views a mount created are released when the tree
    // drops — through the release the renderer paired with them.
    fr_reset();
    install(fr_renderer());
    {
        var b: core::Builder = core::Builder::new();
        b.add(fr_leaf("a"));
        b.add(fr_leaf("z"));
        var root: core::Node = core::column(b, key: "root");
        assert mount(#addr_of(root));
        assert FR_CREATES == 3;
        assert FR_RELEASES == 0;
        unmount(#addr_of(root));
    }
    // Scope exit dropped the tree: every created view released exactly once.
    assert FR_RELEASES == 3;
    uninstall();
    return;
}

// ---- lifecycle handler tests -------------------------------------------------

static LC_ATTACHES: i32 = 0;
static LC_DETACHES: i32 = 0;
static LC_SAW_SIBLING_ATTACHED: bool = false;
static LC_SIBLING: *core::Node = 0 as *core::Node;

fn lc_on_attach(sender: *u8, ctx: *u8) {
    LC_ATTACHES = LC_ATTACHES + 1;
    // M4: by the time any handler fires the WHOLE tree is attached — even a
    // sibling mounted after this node in walk order.
    if LC_SIBLING != (0 as *core::Node) {
        LC_SAW_SIBLING_ATTACHED = core::is_attached(LC_SIBLING);
    }
    return;
}

fn lc_on_detach(sender: *u8, ctx: *u8) { LC_DETACHES = LC_DETACHES + 1; return; }

#[test]
fn mount_fires_on_attach_after_the_whole_walk() {
    fr_reset();
    LC_ATTACHES = 0;
    LC_DETACHES = 0;
    LC_SAW_SIBLING_ATTACHED = false;
    LC_SIBLING = 0 as *core::Node;
    install(fr_renderer());
    var b: core::Builder = core::Builder::new();
    b.add(fr_leaf("first"));
    b.add(fr_leaf("last"));
    var root: core::Node = core::column(b, key: "root");
    match core::find_in(#addr_of(root), "first") {
        option::Option[*core::Node]::Some(fp) => {
            match core::find_in(#addr_of(root), "last") {
                option::Option[*core::Node]::Some(lp) => {
                    LC_SIBLING = lp;
                    core::set_on_attach(fp, lc_on_attach, 0 as *u8);
                    core::set_on_detach(fp, lc_on_detach, 0 as *u8);
                }
                option::Option[*core::Node]::None => { assert false; }
            }
        }
        option::Option[*core::Node]::None => { assert false; }
    }
    assert mount(#addr_of(root));
    assert LC_ATTACHES == 1;
    // "first" mounts before "last", but its handler fired POST-walk and saw
    // the later sibling already attached.
    assert LC_SAW_SIBLING_ATTACHED;
    unmount(#addr_of(root));
    assert LC_DETACHES == 1;
    LC_SIBLING = 0 as *core::Node;
    uninstall();
    return;
}

// ---- composition: set_content and switch_to ----------------------------------
// The three verbs at three levels (stages/3.md §7):
//
//   set_content(outlet, component)   fill one slot — rebuilds on repeat
//   switch_to(outlet, key)           siblings in an outlet — parks and restores
//   nav::go / push / pop / quit      whole screens, by route name
//
// `set_content` is the composition verb the old facet called `present` — a
// false friend (UIKit's present is MODAL; this is containment, UIKit's
// addChild + addSubview), renamed per the naming lint's own rule. Four
// load-bearing things, each kept from the old verb: build the component,
// make its tree the outlet's ONLY child, force it to fill (without
// `.grow(1).shrink(1)` a plain-column root content-sizes and swallows the
// grow), register the typed detach trampoline, and fire `on_attach`.
//
// `switch_to` is flex parking over `Display::None` — strictly better than
// the old remove/re-insert router: `remove_child` bumps `removal_count()`
// and invalidates every cursor in the application, and a backend's
// removeFromSuperview throws away scroll position, selection and first
// responder — exactly what parking exists to preserve (verified by
// `parking_keeps_cursors_live_and_state_intact`).

// The presentation record is NODE-resident (`Data.presented` +
// `Data.presented_detach`, see facet.cplus): it dies with its outlet, evicts
// naturally on teardown, and cannot collide across windows or apps. There is
// no registry — `component_at` resolves keys through the running app's
// windows (component.cplus).

// Detach the top-level native views of `n`'s subtree from `host` through the
// renderer — the seam Renderer.remove exists for. A node WITH a view is a
// native subtree root here: its descendants detach with it, so the walk does
// not descend past it (their view_release still fires on node drop).
fn remove_native_views(n: *core::Node, host: *u8) {
    if !installed() { return; }
    if host == (0 as *u8) { return; }
    let v: *u8 = core::view_of(n);
    if v != (0 as *u8) {
        let rm: fn(*u8, *u8, *u8) = RENDERER.remove;
        if rm != (0 as fn(*u8, *u8, *u8)) { rm(RENDERER.ctx, host, v); }
        return;
    }
    var i: usize = 0 as usize;
    let count: usize = core::child_count_of(n);
    while i < count {
        match core::child_of(n, i) {
            option::Option[*core::Node]::Some(c) => { remove_native_views(c, host); }
            option::Option[*core::Node]::None => { }
        }
        i = i +% (1 as usize);
    }
    return;
}

// Fill `outlet` with `c`'s tree. Rebuilds on repeat: the previous occupant is
// notified through its detach trampoline, its native views are removed from
// the host, and its subtree is dropped. The component must outlive the
// presentation (it is registered by address); `component_at::[C](key)`
// resolves it while the presentation lasts.
//
// CONTRACT: an outlet that accepts set_content should be KEYED. A keyed
// outlet gets a backing view, so the host is the outlet's own view and the
// native slot accounting is exact; an unbacked outlet shares an ancestor
// host, where slot positions among foreign siblings are not tracked.
fn set_content[C: component::Component + component::Lifecycle](outlet: *core::Node, ref c: C) -> bool {
    if outlet == (0 as *core::Node) { return false; }
    // Out with the previous occupant — notify, detach its native views from
    // the host, then remove. Removal is correct here (set_content REBUILDS);
    // parking is switch_to's job.
    let _had: bool = core::evict_presented(outlet);
    let host_for_removal: *u8 = nearest_host(outlet);
    while { (*outlet).child_count() } > (0 as usize) {
        match core::child_of(outlet, 0 as usize) {
            option::Option[*core::Node]::Some(oldc) => { remove_native_views(oldc, host_for_removal); }
            option::Option[*core::Node]::None => { }
        }
        let _old: option::Option[core::Node] = { (*outlet).remove_child(0 as usize) };
    }
    // Build, force fill, adopt.
    var tree: core::Node = c.build();
    tree = tree.grow(1.0f64).shrink(1.0f64);
    { (*outlet).add_child(tree) };
    // The record rides on the outlet itself.
    core::set_presented(outlet, #addr_of(c) as *u8, component::lc_detach_tramp::[C]);
    // Mount the new subtree when the outlet is live under a renderer; attach
    // flags and node-level handlers ride the M4 queue either way.
    if core::is_attached(outlet) {
        let host: *u8 = nearest_host(outlet);
        var q: vec::Vec[*core::Node] = vec::new::[*core::Node]();
        match core::child_of(outlet, 0 as usize) {
            option::Option[*core::Node]::Some(cp) => {
                if installed() {
                    let _s: usize = mount_walk(cp, host, 0 as usize, q);
                } else {
                    attach_flags_walk(cp, q);
                }
                drain_attach_queue(q);
            }
            option::Option[*core::Node]::None => { }
        }
    }
    // The component-level lifecycle, exactly as the old verb fired it.
    c.on_attach();
    core::touch(outlet, props::C_FLUSH);
    return true;
}

// The nearest enclosing view for `n` — where a freshly built subtree's views
// insert. The outlet's own view when it is backed (keyed outlets are); else a
// search down from the running app's windows carrying the last backed
// ancestor. flex nodes carry no parent pointer, so the walk goes down, not
// up. `Some(h)` = target found under host `h` (0 = hostless); `None` = not
// in this subtree.
fn nearest_host(n: *core::Node) -> *u8 {
    let own: *u8 = core::view_of(n);
    if own != (0 as *u8) { return own; }
    var i: usize = 0 as usize;
    let count: usize = app::window_count();
    while i < count {
        let r: *core::Node = app::window_root(i);
        if r != (0 as *core::Node) {
            match host_search(r, 0 as *u8, n) {
                option::Option[*u8]::Some(h) => { return h; }
                option::Option[*u8]::None => { }
            }
        }
        i = i +% (1 as usize);
    }
    return 0 as *u8;
}

fn host_search(cur: *core::Node, host: *u8, target: *core::Node) -> option::Option[*u8] {
    var h: *u8 = host;
    let v: *u8 = core::view_of(cur);
    if v != (0 as *u8) { h = v; }
    if cur == target { return option::Option[*u8]::Some(h); }
    var i: usize = 0 as usize;
    let count: usize = core::child_count_of(cur);
    while i < count {
        match core::child_of(cur, i) {
            option::Option[*core::Node]::Some(c) => {
                match host_search(c, h, target) {
                    option::Option[*u8]::Some(hit) => { return option::Option[*u8]::Some(hit); }
                    option::Option[*u8]::None => { }
                }
            }
            option::Option[*core::Node]::None => { }
        }
        i = i +% (1 as usize);
    }
    return option::Option[*u8]::None;
}

// Headless attach: flags + M4 queue, no views.
fn attach_flags_walk(n: *core::Node, ref q: vec::Vec[*core::Node]) {
    core::set_attached(n, true);
    q.append(n);
    var i: usize = 0 as usize;
    let count: usize = core::child_count_of(n);
    while i < count {
        match core::child_of(n, i) {
            option::Option[*core::Node]::Some(c) => { attach_flags_walk(c, q); }
            option::Option[*core::Node]::None => { }
        }
        i = i +% (1 as usize);
    }
    return;
}

// Show exactly the child of `outlet` keyed `key`; park every other child
// under `Display::None`. Views, scroll positions, selection and cursors all
// survive the park — nothing is removed. Node-level lifecycle handlers fire
// on the children whose state changed, post-swap. False when no child
// carries the key (and nothing changes).
fn switch_to(outlet: *core::Node, key: str) -> bool {
    if outlet == (0 as *core::Node) { return false; }
    // First pass: the key must exist, or this is a typo and a no-op.
    var found: bool = false;
    var i: usize = 0 as usize;
    let n: usize = core::child_count_of(outlet);
    while i < n {
        match core::child_of(outlet, i) {
            option::Option[*core::Node]::Some(c) => {
                if { (*c).key() } == key { found = true; }
            }
            option::Option[*core::Node]::None => { }
        }
        i = i +% (1 as usize);
    }
    if !found { return false; }
    var j: usize = 0 as usize;
    while j < n {
        match core::child_of(outlet, j) {
            option::Option[*core::Node]::Some(c) => {
                let show: bool = ({ (*c).key() } == key);
                let shown: bool = match { (*c).display() } {
                    flex::Display::None => false,
                    flex::Display::Flex => true,
                    flex::Display::Grid => true,
                };
                if show && !shown {
                    // Restore the display mode the pane was parked with —
                    // a Grid pane comes back as Grid.
                    { (*c).set_display(core::parked_display_of(c)) };
                    // The WHOLE subtree re-attaches (guarded by the outlet
                    // itself being live) and every handler in it hears.
                    if core::is_attached(outlet) {
                        var qa: vec::Vec[*core::Node] = vec::new::[*core::Node]();
                        attach_flags_walk(c, qa);
                        drain_attach_queue(qa);
                    }
                }
                if !show && shown {
                    core::set_parked_display(c, { (*c).display() });
                    { (*c).set_display(flex::Display::None) };
                    // The WHOLE subtree parks: descendants read detached and
                    // their handlers fire, exactly like an unmount.
                    var qd: vec::Vec[*core::Node] = vec::new::[*core::Node]();
                    detach_walk(c, qd);
                    drain_detach_queue(qd);
                }
            }
            option::Option[*core::Node]::None => { }
        }
        j = j +% (1 as usize);
    }
    core::touch(outlet, props::C_FLUSH);
    return true;
}

// ---- structural verbs (Stage 4) ----------------------------------------------
// Editing a LIVE tree's shape. facet is not reactive, so filling a list is a
// tree edit, not a rebuild — but flex's own `add_child` only puts a node in
// the tree. Nothing then creates its native view: `mount` ran once at startup,
// and `sync_walk` applies only to nodes that have a dirty word AND a view, so
// a fresh child (neither) is walked straight past. It laid out, took up space,
// and was invisible.
//
// These are the door. They do the flex edit AND the mount/unmount, so the
// shape of a live tree only ever changes through the Renderer. The old facet
// had five backend registrars for this (add/remove/insert/replace/set_child);
// this is the same guarantee with none of the vtable — the seam already has
// `insert` and `remove`.
//
// Each verb also touches C_LAYOUT: a shape change is a geometry change, and
// the backend answers it with the same layout pass a size write asks for.
//
// The bare flex verbs still exist and are correct for DESCRIPTION time (inside
// `build`, before anything is mounted). After mount, use these.

// The number of top-level native views `n`'s subtree contributes to its
// enclosing host. A backed node is exactly one (its descendants live INSIDE
// its view); an unbacked one contributes whatever its children do — which is
// how a pure-layout column inside a scroll view passes through.
fn native_span(n: *core::Node) -> usize {
    if n == (0 as *core::Node) { return 0 as usize; }
    if core::view_of(n) != (0 as *u8) { return 1 as usize; }
    var total: usize = 0 as usize;
    var i: usize = 0 as usize;
    let count: usize = core::child_count_of(n);
    while i < count {
        match core::child_of(n, i) {
            option::Option[*core::Node]::Some(c) => { total = total +% native_span(c); }
            option::Option[*core::Node]::None => { }
        }
        i = i +% (1 as usize);
    }
    return total;
}

// The running total of a slot scan, and whether the insertion point was
// reached. A struct rather than a `ref` out-param so the recursion reads as
// one value per node.
struct SlotScan {
    count: usize,
    found: bool,
}

// Native views under `cur` that PRECEDE inserting at (`parent`, `at`), counted
// in the host `cur` contributes to. Mirrors mount_walk's slot arithmetic: a
// backed node that is not the parent is one slot and is not descended into
// (its subtree hangs inside its own view, not in this host); an unbacked one
// passes its children through.
fn scan_slots_before(cur: *core::Node, parent: *core::Node, at: usize) -> SlotScan {
    if cur == parent {
        var c: usize = 0 as usize;
        var i: usize = 0 as usize;
        let count: usize = core::child_count_of(cur);
        while i < at && i < count {
            match core::child_of(cur, i) {
                option::Option[*core::Node]::Some(ch) => { c = c +% native_span(ch); }
                option::Option[*core::Node]::None => { }
            }
            i = i +% (1 as usize);
        }
        return SlotScan { count: c, found: true };
    }
    if core::view_of(cur) != (0 as *u8) {
        // Backed and not the parent: the parent cannot be contributing to THIS
        // host from inside it — it would contribute to this node's view.
        return SlotScan { count: 1 as usize, found: false };
    }
    var c: usize = 0 as usize;
    var i: usize = 0 as usize;
    let count: usize = core::child_count_of(cur);
    while i < count {
        match core::child_of(cur, i) {
            option::Option[*core::Node]::Some(ch) => {
                let r: SlotScan = scan_slots_before(ch, parent, at);
                c = c +% r.count;
                if r.found { return SlotScan { count: c, found: true }; }
            }
            option::Option[*core::Node]::None => { }
        }
        i = i +% (1 as usize);
    }
    return SlotScan { count: c, found: false };
}

// The host NODE for `n` — itself when backed, else the nearest backed
// ancestor. flex nodes carry no parent pointer, so the search goes DOWN from
// the running app's windows, exactly like nearest_host.
fn host_node_of(n: *core::Node) -> *core::Node {
    if n == (0 as *core::Node) { return 0 as *core::Node; }
    if core::view_of(n) != (0 as *u8) { return n; }
    var i: usize = 0 as usize;
    let count: usize = app::window_count();
    while i < count {
        let r: *core::Node = app::window_root(i);
        if r != (0 as *core::Node) {
            match host_node_search(r, 0 as *core::Node, n) {
                option::Option[*core::Node]::Some(h) => { return h; }
                option::Option[*core::Node]::None => { }
            }
        }
        i = i +% (1 as usize);
    }
    return 0 as *core::Node;
}

fn host_node_search(cur: *core::Node, host: *core::Node, target: *core::Node) -> option::Option[*core::Node] {
    var h: *core::Node = host;
    if core::view_of(cur) != (0 as *u8) { h = cur; }
    if cur == target { return option::Option[*core::Node]::Some(h); }
    var i: usize = 0 as usize;
    let count: usize = core::child_count_of(cur);
    while i < count {
        match core::child_of(cur, i) {
            option::Option[*core::Node]::Some(c) => {
                match host_node_search(c, h, target) {
                    option::Option[*core::Node]::Some(hit) => { return option::Option[*core::Node]::Some(hit); }
                    option::Option[*core::Node]::None => { }
                }
            }
            option::Option[*core::Node]::None => { }
        }
        i = i +% (1 as usize);
    }
    return option::Option[*core::Node]::None;
}

// The native slot a child inserted at (`parent`, `at`) takes in its host.
// A BACKED parent is its own host, so the answer is just what its earlier
// children contribute — no search. An unbacked parent shares an ancestor's
// host, so the count runs from that ancestor in document order.
fn native_slot_for(parent: *core::Node, at: usize) -> usize {
    if core::view_of(parent) != (0 as *u8) {
        return scan_slots_before(parent, parent, at).count;
    }
    let h: *core::Node = host_node_of(parent);
    if h == (0 as *core::Node) { return 0 as usize; }
    var i: usize = 0 as usize;
    var c: usize = 0 as usize;
    let count: usize = core::child_count_of(h);
    while i < count {
        match core::child_of(h, i) {
            option::Option[*core::Node]::Some(ch) => {
                let r: SlotScan = scan_slots_before(ch, parent, at);
                c = c +% r.count;
                if r.found { return c; }
            }
            option::Option[*core::Node]::None => { }
        }
        i = i +% (1 as usize);
    }
    return c;
}

// Put `child` in `parent` at `at` (clamped to the end) and mount it if the
// parent is live. False when the parent is null or the tree edit failed —
// and then nothing was mounted either.
fn insert_child(parent: *core::Node, take child: core::Node, at: usize) -> bool {
    if parent == (0 as *core::Node) { return false; }
    let n: usize = core::child_count_of(parent);
    var index: usize = at;
    if index > n { index = n; }
    var placed: bool = false;
    if index == n {
        placed = { (*parent).add_child(child) }.is_ok();
    } else {
        placed = { (*parent).insert_child(child, at: index) }.is_ok();
    }
    if !placed { return false; }
    // Live parent: create the views and put them in the host at the right
    // native slot. Headless (or an unmounted parent) still sets attach flags
    // and rides the M4 queue, exactly like set_content.
    if core::is_attached(parent) {
        match core::child_of(parent, index) {
            option::Option[*core::Node]::Some(cp) => {
                var q: vec::Vec[*core::Node] = vec::new::[*core::Node]();
                if installed() {
                    let host: *u8 = nearest_host(parent);
                    let slot: usize = native_slot_for(parent, index);
                    let _s: usize = mount_walk(cp, host, slot, q);
                } else {
                    attach_flags_walk(cp, q);
                }
                drain_attach_queue(q);
            }
            option::Option[*core::Node]::None => { }
        }
    }
    core::touch(parent, props::C_LAYOUT);
    return true;
}

// Append. The everyday verb — filling a list is this in a loop.
fn add_child(parent: *core::Node, take child: core::Node) -> bool {
    if parent == (0 as *core::Node) { return false; }
    return insert_child(parent, child, core::child_count_of(parent));
}

// Take the child at `at` out of `parent`, native views and all. The subtree
// is handed back so the caller can re-attach it elsewhere; DROPPING it is
// what releases its views (through the release the renderer paired with them).
// None when there is no such child, and then nothing changed.
fn remove_child(parent: *core::Node, at: usize) -> option::Option[core::Node] {
    if parent == (0 as *core::Node) { return option::Option[core::Node]::None; }
    if at >= core::child_count_of(parent) { return option::Option[core::Node]::None; }
    match core::child_of(parent, at) {
        option::Option[*core::Node]::Some(cp) => {
            // Notify first, while the subtree is still whole and its views
            // are alive — the order unmount uses.
            var q: vec::Vec[*core::Node] = vec::new::[*core::Node]();
            detach_walk(cp, q);
            drain_detach_queue(q);
            remove_native_views(cp, nearest_host(parent));
        }
        option::Option[*core::Node]::None => { }
    }
    let gone: option::Option[core::Node] = { (*parent).remove_child(at) };
    core::touch(parent, props::C_LAYOUT);
    return gone;
}

// ---- delete, addressed the way create and update are -------------------------
// `find` is keyed, the cursors are keyed, and `remove_child` was not: it wanted
// the parent AND the child's index in it. That mismatch is what made a data
// list expensive — an app that could address any row directly still had to
// tear the whole list down to delete one, because indices shift and the parent
// is not reachable from the child.
//
// `remove(key)` closes it. A node carries no parent pointer (a link to keep
// correct on every add, remove and move), so the parent is found by walking
// the mounted windows — the same walk `find_node` already does, one level up.

// The node that has `target` as a direct child, searching `n`'s subtree.
fn _parent_in(n: *core::Node, target: *core::Node) -> option::Option[*core::Node] {
    if n == (0 as *core::Node) { return option::Option[*core::Node]::None; }
    match { (*n).child_index(target) } {
        option::Option[usize]::Some(_at) => { return option::Option[*core::Node]::Some(n); }
        option::Option[usize]::None => { }
    }
    let count: usize = { (*n).child_count() };
    var i: usize = 0 as usize;
    while i < count {
        match { (*n).child_ptr(i) } {
            option::Option[*core::Node]::Some(c) => {
                match _parent_in(c, target) {
                    option::Option[*core::Node]::Some(hit) => { return option::Option[*core::Node]::Some(hit); }
                    option::Option[*core::Node]::None => { }
                }
            }
            option::Option[*core::Node]::None => { }
        }
        i = i +% (1 as usize);
    }
    return option::Option[*core::Node]::None;
}

// The mounted parent of `target`, or None when it is a window root (or not in
// any open window). Same order as `find_node`: windows as they were opened.
fn parent_of(target: *core::Node) -> option::Option[*core::Node] {
    if target == (0 as *core::Node) { return option::Option[*core::Node]::None; }
    var i: usize = 0 as usize;
    let n: usize = app::window_count();
    while i < n {
        let r: *core::Node = app::window_root(i);
        if r != (0 as *core::Node) {
            match _parent_in(r, target) {
                option::Option[*core::Node]::Some(p) => { return option::Option[*core::Node]::Some(p); }
                option::Option[*core::Node]::None => { }
            }
        }
        i = i +% (1 as usize);
    }
    return option::Option[*core::Node]::None;
}

// Take the node out of the tree and DROP it — views detached, handlers
// notified, subtree freed. `remove_child` is the other half of the pair and
// hands the subtree back instead, for a caller that means to re-attach it.
//
// False when the node is not in an open window, or is a window root: a root is
// closed with `app::close_window`, not deleted out from under itself.
fn remove_node(target: *core::Node) -> bool {
    return match parent_of(target) {
        option::Option[*core::Node]::Some(parent) => match { (*parent).child_index(target) } {
            option::Option[usize]::Some(at) => match remove_child(parent, at) {
                option::Option[core::Node]::Some(_gone) => true,
                option::Option[core::Node]::None => false,
            },
            option::Option[usize]::None => false,
        },
        option::Option[*core::Node]::None => false,
    };
}

// Delete by key — the D that `find`, the cursors and `add_child` already had
// keyed. False when no mounted node carries the key.
//
//     mount::add_child(rows, this.row(rec));      // C
//     m_label::find("recent:${path}:name")        // R / U
//     mount::remove("recent:${path}");            // D
fn remove(key: str) -> bool {
    return match find_node(key) {
        option::Option[*core::Node]::Some(p) => remove_node(p),
        option::Option[*core::Node]::None => false,
    };
}

// ---- structural verb tests ---------------------------------------------------

// The last slot the fake renderer was asked to insert at.
fn fr_last_slot() -> u64 {
    let n: usize = FR_INS_SLOTS.count();
    if n == (0 as usize) { return 9999 as u64; }
    return match FR_INS_SLOTS.at(n -% (1 as usize)) {
        option::Option[u64]::Some(s) => s,
        option::Option[u64]::None => 9999 as u64,
    };
}

fn fr_last_host() -> u64 {
    let n: usize = FR_INS_HOSTS.count();
    if n == (0 as usize) { return 0 as u64; }
    return match FR_INS_HOSTS.at(n -% (1 as usize)) {
        option::Option[u64]::Some(h) => h,
        option::Option[u64]::None => 0 as u64,
    };
}

#[test]
fn add_child_mounts_into_the_live_tree() {
    // The hole this closes: flex's own add_child put the node in the tree and
    // nothing ever created its view — mount ran once at startup, and the sync
    // walk skips a node with no dirty word and no view.
    fr_reset();
    install(fr_renderer());
    var b: core::Builder = core::Builder::new();
    b.add(fr_leaf("a"));
    b.add(fr_leaf("c"));
    var root: core::Node = core::column(b, key: "root");
    assert mount(#addr_of(root));
    let rv: u64 = core::view_of(#addr_of(root)) as u64;
    let creates: i32 = FR_CREATES;
    let inserts: usize = FR_INS_SLOTS.count();

    // Append: created, inserted into the ROOT's view at the next free slot.
    assert add_child(#addr_of(root), fr_leaf("d"));
    assert FR_CREATES == creates + 1;
    assert FR_INS_SLOTS.count() == inserts +% (1 as usize);
    assert fr_last_slot() == (2 as u64);
    assert fr_last_host() == rv;
    assert root.child_count() == (3 as usize);
    match core::find_in(#addr_of(root), "d") {
        option::Option[*core::Node]::Some(dp) => {
            assert core::is_attached(dp);
            assert core::view_of(dp) != (0 as *u8);
        }
        option::Option[*core::Node]::None => { assert false; }
    }
    // A shape change is a geometry change: the layout bit is set on the parent.
    assert (core::dirty_of(#addr_of(root)) & props::C_LAYOUT) != (0 as u64);

    // Insert in the MIDDLE: the native slot is the one its earlier siblings
    // leave free, not the end.
    assert insert_child(#addr_of(root), fr_leaf("b"), 1 as usize);
    assert fr_last_slot() == (1 as u64);
    assert root.child_count() == (4 as usize);
    match core::child_of(#addr_of(root), 1 as usize) {
        option::Option[*core::Node]::Some(cp) => { assert { (*cp).key() } == "b"; }
        option::Option[*core::Node]::None => { assert false; }
    }
    // Past the end clamps to append rather than failing.
    assert insert_child(#addr_of(root), fr_leaf("z"), 99 as usize);
    assert fr_last_slot() == (4 as u64);
    unmount(#addr_of(root));
    uninstall();
    return;
}

#[test]
fn insert_under_a_passthrough_container_counts_document_order() {
    // The parent has NO view (unkeyed, kind 0), so its children hang from the
    // nearest backed ancestor — and the slot must count what precedes them
    // across the whole host, not just within the parent.
    fr_reset();
    install(fr_renderer());
    var ib: core::Builder = core::Builder::new();
    ib.add(fr_leaf("h"));
    var b: core::Builder = core::Builder::new();
    b.add(fr_leaf("a"));
    b.add(core::column(ib));          // unkeyed: the fake declines it
    b.add(fr_leaf("z"));
    var root: core::Node = core::column(b, key: "root");
    assert mount(#addr_of(root));
    let rv: u64 = core::view_of(#addr_of(root)) as u64;
    // Root's view holds [a, h, z] at 0,1,2 — the inner column passed through.
    match core::child_of(#addr_of(root), 1 as usize) {
        option::Option[*core::Node]::Some(inner) => {
            assert core::view_of(inner) == (0 as *u8);
            // Appending inside the passthrough lands AFTER h, i.e. slot 2 of
            // the root's view — not slot 1 of a view the container hasn't got.
            assert add_child(inner, fr_leaf("h2"));
            assert fr_last_slot() == (2 as u64);
            assert fr_last_host() == rv;
            // And at the FRONT of the passthrough: after a, before h.
            assert insert_child(inner, fr_leaf("h0"), 0 as usize);
            assert fr_last_slot() == (1 as u64);
            assert fr_last_host() == rv;
        }
        option::Option[*core::Node]::None => { assert false; }
    }
    unmount(#addr_of(root));
    uninstall();
    return;
}

#[test]
fn remove_by_key_deletes_the_row_and_leaves_its_siblings() {
    // The D of keyed CRUD: create, read and update were all addressed by key
    // and delete wanted a parent plus an index. A list that can address any
    // row directly should not have to rebuild itself to lose one.
    fr_reset();
    LC_DETACHES = 0;
    app::reset_default_for_tests();
    install(fr_renderer());
    var rows: core::Builder = core::Builder::new();
    rows.add(fr_leaf("recent:/a"));
    rows.add(fr_leaf("recent:/b"));
    rows.add(fr_leaf("recent:/c"));
    var outer: core::Builder = core::Builder::new();
    outer.add(core::column(rows, key: "recent:rows"));
    var root: core::Node = core::column(outer, key: "root");
    app::open_window(#addr_of(root));
    assert mount(#addr_of(root));
    match core::find_in(#addr_of(root), "recent:/b") {
        option::Option[*core::Node]::Some(bp) => { core::set_on_detach(bp, lc_on_detach, 0 as *u8); }
        option::Option[*core::Node]::None => { assert false; }
    }
    let releases: i32 = FR_RELEASES;

    assert remove("recent:/b");

    // Notified, native view out, and the subtree DROPPED (remove_child hands
    // it back instead; this one deletes).
    assert LC_DETACHES == 1;
    assert FR_RELEASES == releases + 1;
    // The siblings are untouched and still addressable by their own keys —
    // no index shifted out from under anyone.
    match find_node("recent:/a") {
        option::Option[*core::Node]::Some(p) => { assert core::is_attached(p); }
        option::Option[*core::Node]::None => { assert false; }
    }
    match find_node("recent:/c") {
        option::Option[*core::Node]::Some(p) => { assert core::is_attached(p); }
        option::Option[*core::Node]::None => { assert false; }
    }
    // ...and the deleted one is gone from the tree, not merely detached.
    match find_node("recent:/b") {
        option::Option[*core::Node]::Some(_p) => { assert false; }
        option::Option[*core::Node]::None => { assert true; }
    }
    match core::find_in(#addr_of(root), "recent:rows") {
        option::Option[*core::Node]::Some(o) => { assert core::child_count_of(o) == (2 as usize); }
        option::Option[*core::Node]::None => { assert false; }
    }
    // An unknown key is false, never a trap.
    assert !remove("recent:/nope");
    // A window ROOT is not deletable — it is closed, not removed.
    assert !remove("root");

    app::close_window(#addr_of(root));
    uninstall();
    return;
}

#[test]
fn parent_of_answers_the_mounted_parent_and_none_for_a_root() {
    fr_reset();
    app::reset_default_for_tests();
    uninstall();
    var inner: core::Builder = core::Builder::new();
    inner.add(fr_leaf("leaf"));
    var outer: core::Builder = core::Builder::new();
    outer.add(core::column(inner, key: "mid"));
    var root: core::Node = core::column(outer, key: "root");
    app::open_window(#addr_of(root));

    match core::find_in(#addr_of(root), "leaf") {
        option::Option[*core::Node]::Some(leaf) => {
            match parent_of(leaf) {
                option::Option[*core::Node]::Some(p) => { assert { (*p).key() } == "mid"; }
                option::Option[*core::Node]::None => { assert false; }
            }
        }
        option::Option[*core::Node]::None => { assert false; }
    }
    // A root has no parent, and an unmounted node is in no window.
    match parent_of(#addr_of(root)) {
        option::Option[*core::Node]::Some(_p) => { assert false; }
        option::Option[*core::Node]::None => { assert true; }
    }
    var lone: core::Node = core::column(core::Builder::new(), key: "lone");
    match parent_of(#addr_of(lone)) {
        option::Option[*core::Node]::Some(_p) => { assert false; }
        option::Option[*core::Node]::None => { assert true; }
    }
    app::close_window(#addr_of(root));
    return;
}

#[test]
fn remove_child_notifies_detaches_and_takes_the_views_out() {
    fr_reset();
    LC_DETACHES = 0;
    LC_ATTACHES = 0;
    LC_SIBLING = 0 as *core::Node;
    install(fr_renderer());
    var b: core::Builder = core::Builder::new();
    b.add(fr_leaf("a"));
    b.add(fr_leaf("z"));
    var root: core::Node = core::column(b, key: "root");
    assert mount(#addr_of(root));
    match core::find_in(#addr_of(root), "a") {
        option::Option[*core::Node]::Some(ap) => { core::set_on_detach(ap, lc_on_detach, 0 as *u8); }
        option::Option[*core::Node]::None => { assert false; }
    }
    let releases: i32 = FR_RELEASES;
    {
        let gone: option::Option[core::Node] = remove_child(#addr_of(root), 0 as usize);
        // Notified while whole, native views out through Renderer.remove.
        assert LC_DETACHES == 1;
        assert FR_REMOVES >= 1;
        assert root.child_count() == (1 as usize);
        assert (core::dirty_of(#addr_of(root)) & props::C_LAYOUT) != (0 as u64);
        // The subtree came back to the caller, so it is NOT released yet —
        // it could be re-attached somewhere else.
        assert FR_RELEASES == releases;
        let handed_back: bool = match gone {
            option::Option[core::Node]::Some(_n) => true,
            option::Option[core::Node]::None => false,
        };
        assert handed_back;
    }
    // Dropping it is what releases its view.
    assert FR_RELEASES == releases + 1;
    // The survivor is untouched and still findable.
    match core::find_in(#addr_of(root), "z") {
        option::Option[*core::Node]::Some(zp) => { assert core::is_attached(zp); }
        option::Option[*core::Node]::None => { assert false; }
    }
    unmount(#addr_of(root));
    uninstall();
    return;
}

#[test]
fn structural_verbs_negatives_and_the_headless_posture() {
    fr_reset();
    install(fr_renderer());
    var root: core::Node = core::column(core::Builder::new(), key: "root");
    assert mount(#addr_of(root));
    // A null parent takes the child and reports failure — never a trap.
    assert add_child(0 as *core::Node, fr_leaf("nowhere")) == false;
    assert insert_child(0 as *core::Node, fr_leaf("nowhere"), 0 as usize) == false;
    // Out of range removes nothing and says so.
    let none: option::Option[core::Node] = remove_child(#addr_of(root), 7 as usize);
    let absent: bool = match none {
        option::Option[core::Node]::Some(_n) => false,
        option::Option[core::Node]::None => true,
    };
    assert absent;
    let missing: option::Option[core::Node] = remove_child(0 as *core::Node, 0 as usize);
    let absent2: bool = match missing {
        option::Option[core::Node]::Some(_n) => false,
        option::Option[core::Node]::None => true,
    };
    assert absent2;
    unmount(#addr_of(root));
    uninstall();

    // Headless: no renderer, so no views — but the attach flags and the M4
    // queue still run, exactly like set_content's portable posture.
    app::reset_default_for_tests();
    var h: core::Node = core::column(core::Builder::new(), key: "host");
    app::open_window(#addr_of(h));
    core::set_attached(#addr_of(h), true);
    assert add_child(#addr_of(h), fr_leaf("only"));
    match core::find_in(#addr_of(h), "only") {
        option::Option[*core::Node]::Some(op) => {
            assert core::is_attached(op);
            assert core::view_of(op) == (0 as *u8);
        }
        option::Option[*core::Node]::None => { assert false; }
    }
    app::close_window(#addr_of(h));
    return;
}

// ---- composition tests -------------------------------------------------------

struct ScComp {
    n: i32,
    attaches: i32,
    detaches: i32,
}

impl ScComp: component::Component {
    fn build(ref this) -> core::Node {
        var b: core::Builder = core::Builder::new();
        b.add(core::node_with("inner", 7 as u32, 0 as *u8, core::no_release));
        return core::column(b);
    }
}

impl ScComp: component::Lifecycle {
    fn on_attach(ref this) { this.attaches = this.attaches + 1; return; }
    fn on_detach(ref this) { this.detaches = this.detaches + 1; return; }
}

// `find` answers what `find_node` answers, and `within:` scopes it the same
// way the typed finds do. The shape an app actually writes: resolve an outlet
// by key, hand the node to set_content.
#[test]
fn find_is_find_node_and_takes_within() {
    app::reset_default_for_tests();
    uninstall();
    var b: core::Builder = core::Builder::new();
    b.add(core::column(core::Builder::new(), key: "slot"));
    var root: core::Node = core::column(b, key: "root");
    app::open_window(#addr_of(root));

    let viaFind: option::Option[*core::Node] = find("slot");
    let viaNode: option::Option[*core::Node] = find_node("slot");
    assert match viaFind {
        option::Option[*core::Node]::Some(a) => match viaNode {
            option::Option[*core::Node]::Some(b2) => a == b2,
            option::Option[*core::Node]::None => false,
        },
        option::Option[*core::Node]::None => false,
    };

    // within: scopes to a subtree — and answers None for a key outside it
    assert match find("root", within: #addr_of(root)) {
        option::Option[*core::Node]::Some(_p) => true,
        option::Option[*core::Node]::None => false,
    };
    var lone: core::Node = core::column(core::Builder::new(), key: "lone");
    assert match find("slot", within: #addr_of(lone)) {
        option::Option[*core::Node]::Some(_p) => false,
        option::Option[*core::Node]::None => true,
    };
    app::close_window(#addr_of(root));
    return;
}

#[test]
fn set_content_fills_registers_and_rebuilds_on_repeat() {
    app::reset_default_for_tests();
    uninstall();                     // headless: the tree is the whole truth
    var outlet: core::Node = core::column(core::Builder::new(), key: "slot");
    // The outlet lives in a WINDOW of the (default) app — component_at
    // resolves through the app's windows, exactly like a real screen.
    app::open_window(#addr_of(outlet));
    core::set_attached(#addr_of(outlet), true);
    var c: ScComp = ScComp { n: 1, attaches: 0, detaches: 0 };
    assert set_content(#addr_of(outlet), c);
    assert outlet.child_count() == (1 as usize);
    assert c.attaches == 1;
    // The typed reader resolves the presented instance while it lasts.
    match component::component_at::[ScComp]("slot") {
        option::Option[*ScComp]::Some(p) => { assert p == #addr_of(c); }
        option::Option[*ScComp]::None => { assert false; }
    }
    // The built subtree is attached and findable.
    match core::find_in(#addr_of(outlet), "inner") {
        option::Option[*core::Node]::Some(ip) => { assert core::is_attached(ip); }
        option::Option[*core::Node]::None => { assert false; }
    }
    // Repeat REBUILDS: previous occupant notified, replaced, still one child.
    var c2: ScComp = ScComp { n: 2, attaches: 0, detaches: 0 };
    assert set_content(#addr_of(outlet), c2);
    assert c.detaches == 1;
    assert c2.attaches == 1;
    assert outlet.child_count() == (1 as usize);
    match component::component_at::[ScComp]("slot") {
        option::Option[*ScComp]::Some(p2) => { assert p2 == #addr_of(c2); }
        option::Option[*ScComp]::None => { assert false; }
    }
    let _e: bool = core::evict_presented(#addr_of(outlet));
    app::close_window(#addr_of(outlet));
    return;
}

#[test]
fn switch_to_parks_under_display_none_and_restores() {
    app::reset_default_for_tests();
    uninstall();
    LC_DETACHES = 0;
    LC_ATTACHES = 0;
    LC_SIBLING = 0 as *core::Node;
    var b: core::Builder = core::Builder::new();
    b.add(fr_leaf("a"));
    b.add(fr_leaf("z"));
    var outlet: core::Node = core::column(b, key: "panes");
    core::set_attached(#addr_of(outlet), true);
    match core::find_in(#addr_of(outlet), "a") {
        option::Option[*core::Node]::Some(ap) => {
            core::set_on_detach(ap, lc_on_detach, 0 as *u8);
            core::set_on_attach(ap, lc_on_attach, 0 as *u8);
            // Show "z": "a" parks — display None, detached, notified — and
            // NOTHING is removed (the cursor-invalidating router is gone).
            assert switch_to(#addr_of(outlet), "z");
            assert outlet.child_count() == (2 as usize);
            let parked: bool = match { (*ap).display() } {
                flex::Display::None => true,
                flex::Display::Flex => false,
                flex::Display::Grid => false,
            };
            assert parked;
            assert core::is_attached(ap) == false;
            assert LC_DETACHES == 1;
            // Back to "a": restored, re-attached, notified.
            assert switch_to(#addr_of(outlet), "a");
            let shown: bool = match { (*ap).display() } {
                flex::Display::Flex => true,
                flex::Display::None => false,
                flex::Display::Grid => false,
            };
            assert shown;
            assert core::is_attached(ap);
            assert LC_ATTACHES == 1;
        }
        option::Option[*core::Node]::None => { assert false; }
    }
    // A key no child carries: false, and nothing moves.
    assert switch_to(#addr_of(outlet), "nope") == false;
    return;
}

#[test]
fn switch_to_walks_the_whole_subtree_and_keeps_grid() {
    app::reset_default_for_tests();
    uninstall();
    // Pane "a" is a GRID container with a nested leaf; pane "z" is a leaf.
    var ab: core::Builder = core::Builder::new();
    ab.add(fr_leaf("a:inner"));
    var pane_a: core::Node = core::column(ab, key: "a");
    pane_a.set_display(flex::Display::Grid);
    var b: core::Builder = core::Builder::new();
    b.add(pane_a);
    b.add(fr_leaf("z"));
    var outlet: core::Node = core::column(b, key: "panes");
    core::set_attached(#addr_of(outlet), true);
    match core::find_in(#addr_of(outlet), "a:inner") {
        option::Option[*core::Node]::Some(ip) => {
            core::set_attached(ip, true);
            // Park "a": the DESCENDANT reads detached too.
            assert switch_to(#addr_of(outlet), "z");
            assert core::is_attached(ip) == false;
            // Restore "a": the descendant re-attaches, and the pane comes
            // back as GRID, not Flex.
            assert switch_to(#addr_of(outlet), "a");
            assert core::is_attached(ip);
        }
        option::Option[*core::Node]::None => { assert false; }
    }
    match core::find_in(#addr_of(outlet), "a") {
        option::Option[*core::Node]::Some(ap) => {
            let is_grid: bool = match { (*ap).display() } {
                flex::Display::Grid => true,
                flex::Display::Flex => false,
                flex::Display::None => false,
            };
            assert is_grid;
        }
        option::Option[*core::Node]::None => { assert false; }
    }
    return;
}

#[test]
fn set_content_under_a_renderer_removes_old_views_and_mounts_new() {
    fr_reset();
    install(fr_renderer());
    // A keyed (= backed) outlet mounted as a window root — the set_content
    // contract's happy path: host IS the outlet's view.
    var outlet: core::Node = core::column(core::Builder::new(), key: "slot");
    assert mount(#addr_of(outlet));
    let ov: *u8 = core::view_of(#addr_of(outlet));
    assert ov != (0 as *u8);
    var c: ScComp = ScComp { n: 1, attaches: 0, detaches: 0 };
    assert set_content(#addr_of(outlet), c);
    // First fill: nothing to remove; the built leaf mounted into the outlet.
    assert FR_REMOVES == 0;
    let creates_after_first: i32 = FR_CREATES;
    assert creates_after_first > 1;          // outlet + the subtree's views
    // Rebuild: the old subtree's top-level native views leave the host
    // through Renderer.remove, then the replacement mounts.
    var c2: ScComp = ScComp { n: 2, attaches: 0, detaches: 0 };
    assert set_content(#addr_of(outlet), c2);
    assert FR_REMOVES >= 1;
    assert c.detaches == 1;
    assert c2.attaches == 1;
    assert FR_CREATES > creates_after_first;
    unmount(#addr_of(outlet));
    uninstall();
    return;
}

#[test]
fn a_realised_subtree_is_whole_but_has_no_window() {
    // The second mount path. A recycled row is a subtree the PLATFORM owns:
    // built when it scrolls in, destroyed when it scrolls out, never part of
    // facet's tree — so no walk from a window root can ever reach it.
    install(fr_renderer());
    fr_reset();
    let windows_before: usize = mounted_count();

    var inner: core::Builder = core::Builder::new();
    inner.add(core::node_with("a", props::K_LABEL, 0 as *u8, core::no_release));
    inner.add(core::node_with("b", props::K_LABEL, 0 as *u8, core::no_release));
    var row: core::Node = core::column(inner, key: "row");
    let p: *core::Node = #addr_of(row);

    let v: *u8 = realise(p);
    // Whole: the root and both children were created...
    assert v != (0 as *u8);
    assert FR_CREATES == 3;
    // ...and the children were inserted into their own parent. Only the ROOT
    // is left unplaced, because the caller has its own host for it.
    assert FR_INS_HOSTS.count() == (2 as usize);
    // With a host, the root is placed too — and an UNBACKED root passes its
    // children straight through to it, which is the ordinary case for a
    // recycled row (a bare container nothing keyed).
    fr_reset();
    var bare_kids: core::Builder = core::Builder::new();
    bare_kids.add(core::node_with("c", props::K_LABEL, 0 as *u8, core::no_release));
    var bare: core::Node = core::column(bare_kids);
    let host: *u8 = { 77 as *u8 };
    let bv: *u8 = realise(#addr_of(bare), host);
    assert bv == (0 as *u8);                        // the root itself is not backed
    assert FR_INS_HOSTS.count() == (1 as usize);    // ...and its child went to the host
    match FR_INS_HOSTS.at(0 as usize) {
        option::Option[u64]::Some(h) => { assert h == (77 as u64); }
        option::Option[u64]::None => { assert false; }
    }
    unrealise(#addr_of(bare));
    assert core::is_attached(p);
    // No window: this is not a mount.
    assert mounted_count() == windows_before;

    unrealise(p);
    assert core::is_attached(p) == false;
    assert mounted_count() == windows_before;
    uninstall();
    return;
}

#[test]
fn realise_is_inert_with_no_backend() {
    // Same rule as every other seam verb: no renderer, no realisation, and no
    // trap — a headless test that builds a row gets a node and no view.
    uninstall();
    var n: core::Node = core::node_with("x", props::K_LABEL, 0 as *u8, core::no_release);
    assert realise(#addr_of(n)) == (0 as *u8);
    assert realise(0 as *core::Node) == (0 as *u8);
    unrealise(0 as *core::Node);
    return;
}
