// facet component — the component contract and its event-context verbs.
// HAND-WRITTEN. Stage 3 port from the pre-regen facet: bodies unchanged;
// the lifecycle registry is keyed by KEY (str) instead of the retired
// generic `Handle`, and the docs teach per-control `find`.

import "stdlib/text" as text;
import "stdlib/option" as option;
import "flex_layout/flex_layout" as flex;
import "./facet" as core;
import "./vocabulary" as vocab;
import "./application" as app;
import "./app_events" as ev;
import "stdlib/status" as status;
import "stdlib/box" as box;

type Node = flex::Node;

// ---- the component contract ---------------------------------------------
// A component is a plain struct: its FIELDS are the state, its handlers are
// methods in the INHERENT impl, and this interface is the checked conformance
// block (`impl Foo: component::Component`) holding `build`. Interface-impl
// blocks are closed (E0503/E0504 typo interlock), so `build` is verified
// against this declaration both ways.
//
// `build` returns the PORTABLE DESCRIPTION — a facet `Node` tree, pure data,
// no platform types — and is called ONCE. The backend mounts that description
// into native views and RETAINS the tree; from then on the tree is live and
// you edit it IN PLACE.
//
// facet is NOT reactive. There is no re-render and no diff: `build` is never
// called again, so there is no fresh tree to reconcile against the old one. You
// already hold the element's key, so there is no delta to rediscover. (Contrast
// React/Flutter: mutate state, rebuild, diff the tree, patch. facet skips all of
// that — it addresses the exact element and sets it.)
//
// Two ways to update, never a third:
//   1. by key    — `button::find(key, within: root)` resolves the one keyed element
//                  of that kind in the live tree and hands back its typed
//                  cursor; the cursor's setters mutate in place.
//   2. by method — call a method on the component; internally it updates its
//                  own UI by key. Same mechanism, wrapped behind a named action.
//
// State lives in the struct's fields — the component is retained, so they persist
// for the life of the tree. A handler writes a field, then pushes that value to
// the element that shows it. Nothing is recomputed.
//
// The React trap to avoid: re-calling `build` when state changes, holding the
// tree to "render it top-down each frame," or minting a fresh child inside a
// parent's `build` on every call. `build` runs ONCE and returns already-owned
// children; after that, you `find` and mutate.
interface Component {
    // `build` takes `ref this` so a component can bind its own handlers directly
    // — `button(..., on_click: ...)` — where the bound method's receiver
    // is the component itself. The receiver is a writable place at the real
    // address, so a handler can also self-locate through `#addr_of(this)`.
    // No module static, no stored `cp`. (build still runs ONCE and should only
    // read state to produce the tree; the writable receiver is for binding.)
    fn build(ref this) -> Node;
}

// ---- component lifecycle: attach / detach -----------------------------------
// A component can be constructed OFF-CANVAS and held, then attached into the
// live tree at the right moment and detached later — WITHOUT rebuilding it. Its
// views and state survive being parked, so re-attaching restores it exactly
// (scroll position, half-typed input, selection). This is the router / nav-stack
// shape: one nav owns every screen and attaches one at a time; navigating back
// shows the screen as you left it, for free, because the view object never died.
//
// attach / detach do NOTHING to your logic — they only NOTIFY the component that
// it happened (`on_attach` / `on_detach`). What to do on detach (cancel an
// in-flight request, let it run but drop the result, keep streaming) is the
// app's policy, never facet's. This is the imperative, non-reactive mirror of
// Web Components (connectedCallback / disconnectedCallback): no re-render,
// no diff.
// WHY a component is being attached or detached, because the same two hooks
// carry two different kinds of event and only the reason tells them apart.
//
// There is ONE axis — you have the component's world, or you do not — and the
// reason says what moved. A component holding an exclusive device (camera,
// microphone, location) wants the SAME code on every edge: take it on the way
// in, give it back on the way out. Splitting that across four methods made
// every such component write its body twice.
//
// TWO ENUMS rather than one, so the impossible values do not exist. `on_attach`
// can never mean "backgrounded" and `on_detach` can never mean "mounted"; one
// shared enum would put both in reach of both and force a `_` arm on every
// match that means nothing.
//
// The reason is LOAD-BEARING, not informational, and this is the trap it makes
// visible: building views belongs to `Mount` alone, while acquiring a device
// belongs to every attach. Code written for the first and run for the second
// mounts a second copy of everything it built — measured as a camera preview
// that gained one dead, frozen band per task switch.
enum Attach {
    // The component just entered the live tree. Fires ONCE per attachment and
    // is the only moment `mount::find` and `mount::add_child` are meaningful:
    // this is where views are built.
    //
    // NOT the place to acquire an exclusive device. On Android this runs
    // inside `onCreate`, where the process may still be BACKGROUND as far as
    // the camera service is concerned — `openCamera` then throws
    // CAMERA_DISABLED. `Active` always follows, and is where devices belong.
    Mount,
    // VISIBLE again after being fully gone. Fires many times over one Mount
    // and NEVER at launch — a cold start is Mount then Active, on all three
    // platforms.
    Foreground,
    // FRONTMOST and taking input. Fires at launch and every time focus
    // returns. May arrive with NO preceding `Inactive` — a dialog dismissing
    // is one way.
    Active,
}

enum Detach {
    // Lost FOCUS but possibly still VISIBLE. A dialog, a notification shade,
    // the other pane of a split screen taking over.
    //
    // NOT A RELEASE SIGNAL, and this is the reason the two levels exist. On a
    // desktop it fires whenever the user clicks another window; in split-screen
    // it fires while the app is fully on screen. An app that released its
    // camera here would stop working in front of the person watching it.
    // Measured on a Fold: focus moved four times in split-screen and the app
    // kept streaming at 30fps throughout.
    Inactive,
    // The app is no longer frontmost. The component is STILL ATTACHED and its
    // views are still live; what is gone is the platform's willingness to let
    // it hold exclusive devices. Android revokes the camera outright within a
    // second of this, so releasing here is the difference between handing a
    // device back and having it taken.
    Background,
    // The component is leaving the tree. Its views are alive as this runs and
    // will not be afterwards.
    Unmount,
    // The app is closing. Flush anything unsaved.
    //
    // Raised on all three: `NSApplicationWillTerminateNotification` on macOS,
    // `willTerminate` on iOS, and `onDestroy` guarded by `isFinishing` on
    // Android — the guard matters there because a rotation or a fold also
    // destroys the Activity while the process lives on.
    //
    // NOT GUARANTEED, and never the only place work is saved. A process killed
    // for memory, or swiped out of the task switcher, reaches none of them.
    Terminate,
}

interface Lifecycle {
    fn on_attach(ref this, why: Attach);
    fn on_detach(ref this, why: Detach);
}

// ---- the reasons the TREE can raise -------------------------------------------
// `facet` carries these as an opaque `u32` on the presented record, because it
// cannot import this module. This is the one place they mean anything.
//
// Only four, and the omissions are the point. `Active` and `Inactive` are
// FOCUS, which no tree walk knows about — they arrive on the app event stream
// (`app_lifecycle_tramp`) and reach a screen through the navigator. What a
// walk does know is whether a subtree is in the live tree at all, and whether
// it is the SHOWN one of its outlet's children.
// No reason: the caller is notifying the records itself and the drain must
// not double-fire. `switch_to` is the one that does this — parking is a
// different question from attachment and the two walks do not line up.
const LC_NONE: u32 = 0u32;
const LC_MOUNT: u32 = 1u32;
// A parked pane is fully gone: out of layout, space given away, the backends'
// `visibility_of` reads `Display::None` as GONE rather than invisible. That is
// the visibility level, not the focus level, so a component may release an
// exclusive device here — which `Inactive` explicitly must not do.
const LC_BACKGROUND: u32 = 2u32;
// Shown again after a park. "VISIBLE again after being fully gone. Fires many
// times over one Mount and NEVER at launch" — the enum's own words, and the
// exact shape of a `switch_to` restore.
const LC_FOREGROUND: u32 = 3u32;
// Leaving the tree. Carried for completeness of the vocabulary; the boxed
// tramp below deliberately does NOT answer it — see there.
const LC_UNMOUNT: u32 = 4u32;

// ---- binding a component to the app's lifecycle -------------------------------
// The runtime calls this once, with the component's address, right where it
// registers the attach trampoline. Everything below is the (fn_ptr, ctx) pair
// rule applied to a monomorphised dispatcher: `app_events` speaks a C-ABI
// handler, `Lifecycle` speaks methods, and this is the one place that
// translates.
//
// The address must OUTLIVE the subscription, which is why this takes a pointer
// and not a value — every runtime either boxes the component or holds it in a
// frame that outlives the loop, and neither is freed while bound.
fn app_lifecycle_tramp[C: Lifecycle](e: *ev::AppEvent, ctx: *u8) {
    if e.is_null() { return; }
    if ctx.is_null() { return; }
    let p: *C = ctx as *C;
    let kind: u32 = { (*e).kind };
    if kind == ev::E_ACTIVE { { (*p).on_attach(Attach::Active) }; return; }
    if kind == ev::E_FOREGROUND { { (*p).on_attach(Attach::Foreground) }; return; }
    if kind == ev::E_INACTIVE { { (*p).on_detach(Detach::Inactive) }; return; }
    if kind == ev::E_BACKGROUND { { (*p).on_detach(Detach::Background) }; return; }
    if kind == ev::E_TERMINATING { { (*p).on_detach(Detach::Terminate) }; return; }
    return;
}

fn bind_app_lifecycle[C: Lifecycle](p: *C) -> status::Status {
    if p.is_null() { return status::Status::InvalidInput; }
    return ev::on_app_event(app_lifecycle_tramp::[C], { p as *u8 });
}

// The mirror, and NOT optional on a host that keeps the component on its
// STACK. macOS and Linux hold `owned` in the frame that runs the loop, so the
// subscription must come off before that frame unwinds — an event delivered
// afterwards would call a method on a dead stack slot. Android and iOS box the
// component and never free it, so unbinding there is only tidiness.
fn unbind_app_lifecycle[C: Lifecycle](p: *C) -> status::Status {
    if p.is_null() { return status::Status::InvalidInput; }
    return ev::off_app_event(app_lifecycle_tramp::[C], { p as *u8 });
}

// ---- the sender readers ------------------------------------------------------
// The platform's event-context readers, one struct filled by the backend —
// the Renderer/Scheduler shape. A handler holds only its opaque `sender`;
// these recover what fired (key_of), what it carries (item_of), and what a
// drag delivered (dropped_text / drag_targeted). `raise` is the one WRITE:
// bring a keyed sibling to the front, in place. Zero fields keep the
// portable defaults (empty / 0 / false / no-op).
struct SenderReaders {
    raise: fn(*u8, str),
    key_of: fn(*u8) -> text::Text,
    item_of: fn(*u8) -> *u8,
    dropped_text: fn(*u8) -> text::Text,
    // WHERE the drop landed, in the receiving node's own coordinate space.
    drop_position: fn(*u8) -> option::Option[vocab::Point],
    drag_targeted: fn(*u8) -> bool,
}

fn sender_readers_none() -> SenderReaders {
    return SenderReaders {
        raise: 0 as fn(*u8, str),
        key_of: 0 as fn(*u8) -> text::Text,
        item_of: 0 as fn(*u8) -> *u8,
        dropped_text: 0 as fn(*u8) -> text::Text,
        drop_position: 0 as fn(*u8) -> option::Option[vocab::Point],
        drag_targeted: 0 as fn(*u8) -> bool,
    };
}

static SENDER_READERS: SenderReaders = #zero::[SenderReaders]();

fn install_sender_readers(take r: SenderReaders) { SENDER_READERS = r; return; }
fn uninstall_sender_readers() { SENDER_READERS = sender_readers_none(); return; }

// Bring the keyed element to the front of its siblings, in place — facet is
// not reactive, so you address the element rather than rebuild.
fn raise(sender: *u8, key: str) {
    let f: fn(*u8, str) = SENDER_READERS.raise;
    if f.is_null() { return; }
    f(sender, key);
}

// The sender's key (its agent id) as an owned Text — empty when untagged.
fn key_of(sender: *u8) -> text::Text {
    let f: fn(*u8) -> text::Text = SENDER_READERS.key_of;
    if f.is_null() { return text::new(); }
    return f(sender);
}

// The per-node app pointer set by `.item(p)`, recovered from the sender.
fn item_of(sender: *u8) -> *u8 {
    let f: fn(*u8) -> *u8 = SENDER_READERS.item_of;
    if f.is_null() { return 0 as *u8; }
    return f(sender);
}

// The index a row was given, read from the SENDER. The pair to
// `core::set_item_index` — a handler shared by every row asks this one
// question, and `None` means the node carries no index rather than row zero.
fn item_index_of(sender: *u8) -> option::Option[usize] {
    let raw: usize = item_of(sender) as usize;
    if raw == (0 as usize) { return option::Option[usize]::None; }
    return option::Option[usize]::Some(raw -% (1 as usize));
}

// The text a drop delivered — empty when nothing has been dropped.
fn dropped_text(sender: *u8) -> text::Text {
    let f: fn(*u8) -> text::Text = SENDER_READERS.dropped_text;
    if f.is_null() { return text::new(); }
    return f(sender);
}

// WHERE in this node the drop landed, in its own coordinate space. `None` when
// nothing has been dropped on it — which is also what a caller gets mid-teardown,
// and is the right answer both times.
//
// The drop handler is told WHICH node was dropped on and WHAT was carried, and
// that is not enough to place the thing: dropping a card on another card's top
// half means before it, the bottom half after it. Without the position an
// application can only append, so a card dropped into a lane lands at the end
// of it however carefully it was aimed.
fn drop_position(sender: *u8) -> option::Option[vocab::Point] {
    let f: fn(*u8) -> option::Option[vocab::Point] = SENDER_READERS.drop_position;
    if f.is_null() {
        return option::Option[vocab::Point]::None;
    }
    return f(sender);
}

// Is a drag over this drop zone right now?
fn drag_targeted(sender: *u8) -> bool {
    let f: fn(*u8) -> bool = SENDER_READERS.drag_targeted;
    if f.is_null() { return false; }
    return f(sender);
}

// ---- component_at: the typed reader over presentations -----------------------
// The component instance presented under `key`, or None. The turbofish names
// the type the app KNOWS it presented there (presentation is typed; the cast
// recovers what it erased):
//
//     match component::component_at::[EditorTabs]("code:body") {
//         option::Option[*EditorTabs]::Some(et) => { { (*et).open(path) }; }
//         option::Option[*EditorTabs]::None => { }
//     }
//
// Resolution walks the RUNNING app's windows to the outlet node and reads
// the record the node itself carries (`Data.presented`) — no registry, no
// backend hook, and it works headlessly. Valid while the presentation
// lasts: resolve, call, don't store.
fn component_at[C](key: str) -> option::Option[*C] {
    var i: usize = 0 as usize;
    let count: usize = app::window_count();
    while i < count {
        let r: *core::Node = app::window_root(i);
        if r.is_not_null() {
            match core::find_in(r, key) {
                option::Option[*core::Node]::Some(outlet) => {
                    let p: *u8 = core::presented_of(outlet);
                    if p.is_not_null() { return option::Option[*C]::Some(p as *C); }
                }
                option::Option[*core::Node]::None => { }
            }
        }
        i = i +% (1 as usize);
    }
    return option::Option[*C]::None;
}

// The type-erasing detach trampoline: `lc_detach_tramp::[C]` (a value-turbofish
// fn-pointer) fires C's on_detach on the component at `p`. The presenting verb
// stores one per shown component (`Data.presented_detach`); eviction and node
// teardown fire it — notify, don't wait.
fn lc_detach_tramp[C: Lifecycle](p: *u8) {
    let q: *C = p as *C;
    { (*q).on_detach(Detach::Unmount) };
}

// The reasoned half of the same record. A presented component whose outlet is
// inside a pane hears the pane being parked and restored, exactly as a boxed
// child does.
fn lc_lifecycle_tramp[C: Lifecycle](p: *u8, why: u32) {
    let q: *C = p as *C;
    if why == LC_FOREGROUND { { (*q).on_attach(Attach::Foreground) }; return; }
    if why == LC_BACKGROUND { { (*q).on_detach(Detach::Background) }; return; }
    return;
}

// ---- a component as an item in `@ui` ----------------------------------------
// `child` is what lets a STATEFUL component be written inline in a container,
// beside plain elements:
//
//     @ui { column { label("hi") switch_row(key: "sound", title: "Sound") } }
//
// The problem it solves is ownership. `build` binds handlers by taking the
// ADDRESS of the receiver, so a factory that builds from a component it does
// not outlive hands back a node pointing at freed stack — which is why
// `SwitchRow::new(..).build()` is rejected (E0365) rather than miscompiled.
// Here the component is TAKEN, boxed, and the returned node owns the box: the
// instance lives exactly as long as the node that shows it.
//
// A component reaches `@ui` by naming this from its own `IntoNode`:
//
//     impl SwitchRow: core::IntoNode {
//         fn into_node(take this) -> core::Node {
//             return component::child(this, key: this.key);
//         }
//     }
fn child[C: Component + Lifecycle](take c: C, key: str = "") -> Node {
    match box::new::[C](c) {
        option::Option[box::Box[C]]::Some(b) => {
            // The box surrenders its pointer; from here the NODE owns it and
            // `child_detach_tramp` is the only thing that frees it.
            let p: *u8 = b.into_raw();
            let q: *C = { p as *C };
            var tree: Node = { (*q).build() };
            // Only when asked. `build` usually keys its own root, and a
            // default `key: ""` must not blank it.
            let d: *core::Data = core::ensure_data(#addr_of(tree));
            if d.is_not_null() && #str_len(key) > (0 as usize) {
                { (*d).key = text::from_str(key) };
            }
            // WHICH node carries the record matters. `@ui { x }` finishes as a
            // WRAPPER whose only child is `x`, so a component whose build is
            // `@ui { column(key: "sidebar") { .. } }` returns an UNKEYED root
            // with the author's keyed node inside it. Recording on the root
            // there makes `component_at("sidebar")` answer None — it resolves
            // the key, lands on the child, and finds no component. So the
            // record goes on the node that actually carries the key. The tree
            // is left alone: unwrapping instead would silently drop anything
            // applied to the block's own value (`@ui { .. }.grow(1.0)`).
            let holder: *core::Node = record_holder(#addr_of(tree));
            // Node teardown and eviction both fire the first; the walks fire
            // the second with a reason. NEITHER is called here: a mutator
            // during `mount`'s tree walk reflows a tree the backend has not
            // stored yet, and the notification queue drains AFTER the walk,
            // which is the one safe moment.
            //
            // The node's own `on_attach` slot is deliberately LEFT ALONE. It
            // was where this used to live, and it cost two things: the slot
            // can only say one word, so a `switch_to` restore arrived as a
            // second `Mount` and a park as silence; and the application could
            // not put its own handler on a component's root without silently
            // taking the component's lifecycle away.
            core::set_presented(holder, p, child_detach_tramp::[C],
                                lifecycle: child_lifecycle_tramp::[C]);
            return tree;
        }
        option::Option[box::Box[C]]::None => {
            // Allocation failed: an empty container keeps the tree shaped and
            // the key addressable rather than returning a null node.
            return core::column(core::Builder::new(), key: key);
        }
    }
}

// The node a component's record belongs on: `n` itself when it is keyed, and
// otherwise the single child of a bare `@ui` wrapper when THAT is keyed. Falls
// back to `n`, so a component that keys nothing is recorded on its root and
// simply is not addressable by key — which is what it asked for.
fn record_holder(n: *core::Node) -> *core::Node {
    let d: *core::Data = { (*n).data() };
    if d.is_null() { return n; }
    if #str_len({ (*d).key.view() }) > (0 as usize) { return n; }
    if core::child_count_of(n) != (1 as usize) { return n; }
    guard let option::Option[*core::Node]::Some(c) = core::child_of(n, 0 as usize) else {
        return n;
    };
    let cd: *core::Data = { (*c).data() };
    if cd.is_null() { return n; }
    if #str_len({ (*cd).key.view() }) == (0 as usize) { return n; }
    return c;
}

// A boxed child's reason, fired off the walks' notification queue. The
// component is the record's own address — no ctx slot needed.
//
// `LC_UNMOUNT` is NOT answered here, and that is not an omission: the detach
// trampoline below both notifies and FREES, and it is the one the teardown
// path fires. Answering unmount in both places would deliver `on_detach`
// twice to a component that is about to stop existing.
fn child_lifecycle_tramp[C: Lifecycle](p: *u8, why: u32) {
    let q: *C = { p as *C };
    if why == LC_MOUNT { { (*q).on_attach(Attach::Mount) }; return; }
    if why == LC_FOREGROUND { { (*q).on_attach(Attach::Foreground) }; return; }
    if why == LC_BACKGROUND { { (*q).on_detach(Detach::Background) }; return; }
    return;
}

// Detach AND free — the half that makes the node the owner. Reclaiming the box
// and letting it fall out of scope runs Drop once; calling `.drop()` explicitly
// would free twice, because `Box::drop` does not null its pointer.
fn child_detach_tramp[C: Lifecycle](p: *u8) {
    let q: *C = { p as *C };
    { (*q).on_detach(Detach::Unmount) };
    let _b: box::Box[C] = box::from_raw::[C](p);
}

// ---- tests ------------------------------------------------------------------

// Counts detaches from a FREED component — `child_detach_tramp` frees the box,
// so the struct cannot be read after it fires. A static is the only channel
// that outlives the instance.
static CH_DETACHED: i32 = 0;
// Proves the BOX was reclaimed: a leak fires on_detach just the same, so the
// free needs its own witness. A destructor is a plain inherent `drop`.
static CH_DROPPED: i32 = 0;
// Which REASON arrived, counted apart — the whole point of the record's
// reasoned half is that a component can tell these four situations apart.
static CH_MOUNTS: i32 = 0;
static CH_FOREGROUNDS: i32 = 0;
static CH_BACKGROUNDS: i32 = 0;

struct ChTestComp {
    tag: i32,
    attached: i32,
}

impl ChTestComp {
    fn drop(ref this) { CH_DROPPED = CH_DROPPED + 1; return; }
}

impl ChTestComp: Component {
    fn build(ref this) -> Node {
        var b: core::Builder = core::Builder::new();
        b.add(core::column(core::Builder::new(), key: "ch:inner"));
        return core::column(b, key: "ch:built");
    }
}

// `Builder::finish()` IS what `@ui { x }` lowers to: an unkeyed wrapper whose
// only child is `x`. Built by hand here so the test needs no `elements` import.
struct ChWrapComp {
    tag: i32
}

impl ChWrapComp: Component {
    fn build(ref this) -> Node {
        var outer: core::Builder = core::Builder::new();
        outer.add(core::column(core::Builder::new(), key: "ch:wrapped"));
        return outer.finish();
    }
}

impl ChWrapComp: Lifecycle {
    fn on_attach(ref this, why: Attach) { return; }
    fn on_detach(ref this, why: Detach) { return; }
}

impl ChTestComp: Lifecycle {
    fn on_attach(ref this, why: Attach) {
        this.attached = this.attached + 1;
        match why {
            Attach::Mount => { CH_MOUNTS = CH_MOUNTS + 1; }
            Attach::Foreground => { CH_FOREGROUNDS = CH_FOREGROUNDS + 1; }
            Attach::Active => { }
        }
        return;
    }
    fn on_detach(ref this, why: Detach) {
        CH_DETACHED = CH_DETACHED + 1;
        match why {
            Detach::Background => { CH_BACKGROUNDS = CH_BACKGROUNDS + 1; }
            Detach::Inactive => { }
            Detach::Unmount => { }
            Detach::Terminate => { }
        }
        return;
    }
}

#[test]
fn child_returns_the_components_own_tree() {
    // The node `child` hands back is what `build` made, not a wrapper: the
    // child it added is there, and the root keeps the key `build` gave it.
    var n: Node = child::[ChTestComp](ChTestComp { tag: 7, attached: 0 });
    assert core::child_count_of(#addr_of(n)) == (1 as usize);
    let k: str = { (*core::ensure_data(#addr_of(n))).key.view() };
    assert k == "ch:built";
}

#[test]
fn child_key_overrides_the_built_key_only_when_given() {
    // A stated key addresses the component's root; the default must not blank
    // the key `build` set.
    var named: Node = child::[ChTestComp](ChTestComp { tag: 1, attached: 0 },
                                          key: "ch:asked");
    let a: str = { (*core::ensure_data(#addr_of(named))).key.view() };
    assert a == "ch:asked";
    var bare: Node = child::[ChTestComp](ChTestComp { tag: 1, attached: 0 });
    let b: str = { (*core::ensure_data(#addr_of(bare))).key.view() };
    assert b == "ch:built";
}

#[test]
fn child_boxes_the_component_so_it_outlives_the_call() {
    // The whole point. `build` binds handlers by taking the receiver's ADDRESS,
    // so the instance must outlive the function that built it. The box is
    // reachable through the node's presented slot, and its state is intact —
    // a stack temporary would read as garbage or fault here.
    var n: Node = child::[ChTestComp](ChTestComp { tag: 42, attached: 0 });
    let p: *u8 = core::presented_of(#addr_of(n));
    assert p.is_not_null();
    let q: *ChTestComp = { p as *ChTestComp };
    assert { (*q).tag } == 42;
}

#[test]
fn child_records_on_the_keyed_node_the_author_wrote() {
    // `@ui { x }` answers `x` ITSELF — the builder's container is scaffolding
    // and is not returned. So a component whose `build` is a one-item block IS
    // the author's keyed node, and the record belongs on it.
    //
    // This test guarded the WRAPPER until 2026-09-15: `component_at(key)`
    // resolves the KEY and reads the record off whatever it lands on, so when
    // the block answered a wrapper the record had to be pushed one level down
    // to the keyed child or every lookup answered None while the component was
    // plainly mounted. With no wrapper there is no level to push past, which is
    // the whole point of the change — but the assertion it was protecting is
    // the same one: the record is where the KEY is.
    var n: Node = child::[ChWrapComp](ChWrapComp { tag: 5 });
    let p: *core::Node = #addr_of(n);
    let d: *core::Data = { (*p).data() };
    assert { (*d).key.view() } == "ch:wrapped";
    assert core::presented_of(p).is_not_null();
}

#[test]
fn child_defers_on_attach_until_the_node_attaches() {
    // Two halves, and the second is the one that matters. A mutator during
    // the mount walk reflows a tree the backend has not stored yet, so `child`
    // fires nothing while building — but "nothing happened" is also what a
    // MISSING registration looks like. So drive the hook the walk drives and
    // assert the attach actually lands.
    CH_MOUNTS = 0;
    var n: Node = child::[ChTestComp](ChTestComp { tag: 0, attached: 0 });
    let p: *u8 = core::presented_of(#addr_of(n));
    let q: *ChTestComp = { p as *ChTestComp };
    assert { (*q).attached } == 0;
    core::fire_presented_lifecycle(#addr_of(n), LC_MOUNT);
    assert { (*q).attached } == 1;
    assert CH_MOUNTS == 1;
    // The node's OWN attach slot is not where this lives any more, and that
    // is load-bearing: an application putting a handler on a component's root
    // used to take the component's lifecycle away without saying so.
    core::fire_attach_handler(#addr_of(n));
    assert { (*q).attached } == 1;
}

#[test]
fn a_boxed_child_hears_each_reason_as_itself() {
    // The four words the tree can raise, at the one carrier that can say
    // them. MOUNT is the only one that means "build" — the rest arrive at a
    // component that already built, and answering them the same way is the
    // bug this pair of trampolines exists to prevent.
    CH_MOUNTS = 0;
    CH_FOREGROUNDS = 0;
    CH_BACKGROUNDS = 0;
    CH_DETACHED = 0;
    var n: Node = child::[ChTestComp](ChTestComp { tag: 0, attached: 0 });
    let root: *core::Node = #addr_of(n);
    core::fire_presented_lifecycle(root, LC_MOUNT);
    core::fire_presented_lifecycle(root, LC_BACKGROUND);
    core::fire_presented_lifecycle(root, LC_FOREGROUND);
    assert CH_MOUNTS == 1;
    assert CH_BACKGROUNDS == 1;
    assert CH_FOREGROUNDS == 1;
    assert CH_DETACHED == 1;
    // UNMOUNT belongs to the trampoline that also FREES the box. Answering it
    // here as well would deliver on_detach twice for one teardown.
    core::fire_presented_lifecycle(root, LC_UNMOUNT);
    assert CH_DETACHED == 1;
}

#[test]
fn child_detach_fires_on_detach_and_frees_the_box() {
    // Eviction is the node saying it no longer shows this component: the
    // typed on_detach runs, then the box is reclaimed. Counted in a static
    // because the instance is gone by the time the assert runs.
    CH_DETACHED = 0;
    CH_DROPPED = 0;
    var n: Node = child::[ChTestComp](ChTestComp { tag: 3, attached: 0 });
    assert core::presented_of(#addr_of(n)).is_not_null();
    assert CH_DROPPED == 0;
    let _e: bool = core::evict_presented(#addr_of(n));
    assert CH_DETACHED == 1;
    // The box was RECLAIMED, not merely forgotten — a leak would fire
    // on_detach identically and never run the destructor.
    assert CH_DROPPED == 1;
    // Evicted means no second free when the node itself drops.
    assert core::presented_of(#addr_of(n)).is_null();
}


// Each reason counted separately, so a test can tell which arrived.
struct AlTestComp {
    mount: i32, fg: i32, active: i32,
    inactive: i32, bg: i32, unmount: i32, term: i32,
}
impl AlTestComp: Lifecycle {
    fn on_attach(ref this, why: Attach) {
        match why {
            Attach::Mount => { this.mount = this.mount + 1; }
            Attach::Foreground => { this.fg = this.fg + 1; }
            Attach::Active => { this.active = this.active + 1; }
        }
        return;
    }
    fn on_detach(ref this, why: Detach) {
        match why {
            Detach::Inactive => { this.inactive = this.inactive + 1; }
            Detach::Background => { this.bg = this.bg + 1; }
            Detach::Unmount => { this.unmount = this.unmount + 1; }
            Detach::Terminate => { this.term = this.term + 1; }
        }
        return;
    }
}

fn al_new() -> AlTestComp {
    return AlTestComp { mount: 0, fg: 0, active: 0,
                        inactive: 0, bg: 0, unmount: 0, term: 0 };
}

#[test]
fn the_app_lifecycle_arrives_as_attach_and_detach_with_a_reason() {
    ev::clear_app_events();
    ev::clear_latches();
    var c: AlTestComp = al_new();
    assert bind_app_lifecycle::[AlTestComp](#addr_of(c)) == status::Status::Ok;

    ev::fire_plain(ev::E_FOREGROUND);
    assert c.fg == 1;
    assert c.bg == 0;
    // FOREGROUND IS NOT A MOUNT. A component that builds its views in
    // `on_attach` without reading the reason would build them a second time
    // here, which is the doubled camera preview this enum exists to prevent.
    assert c.mount == 0;

    ev::fire_plain(ev::E_BACKGROUND);
    assert c.bg == 1;
    assert c.unmount == 0;
    assert c.term == 0;

    // Repeats are repeats: an app crosses this edge many times over one mount.
    ev::fire_plain(ev::E_FOREGROUND);
    ev::fire_plain(ev::E_BACKGROUND);
    assert c.fg == 2;
    assert c.bg == 2;
    assert c.mount == 0;

    let _u: status::Status = unbind_app_lifecycle::[AlTestComp](#addr_of(c));
    ev::clear_app_events();
}

#[test]
fn the_two_levels_are_separate_reasons() {
    ev::clear_app_events();
    ev::clear_latches();
    var c: AlTestComp = al_new();
    assert bind_app_lifecycle::[AlTestComp](#addr_of(c)) == status::Status::Ok;

    // FOCUS ALONE. A dialog opens over a still-visible app: the app must hear
    // Inactive and NOT Background, or it releases devices it still owns and
    // stops working in front of the person watching it.
    ev::fire_plain(ev::E_INACTIVE);
    assert c.inactive == 1;
    assert c.bg == 0;

    ev::fire_plain(ev::E_ACTIVE);
    assert c.active == 1;
    assert c.fg == 0;

    // VISIBILITY. Now the app really leaves, and both levels fire in order.
    ev::fire_plain(ev::E_INACTIVE);
    ev::fire_plain(ev::E_BACKGROUND);
    assert c.inactive == 2;
    assert c.bg == 1;

    ev::fire_plain(ev::E_FOREGROUND);
    ev::fire_plain(ev::E_ACTIVE);
    assert c.fg == 1;
    assert c.active == 2;

    // NEITHER is a mount. Views are built once; this axis repeats forever.
    assert c.mount == 0;
    assert c.unmount == 0;

    let _u: status::Status = unbind_app_lifecycle::[AlTestComp](#addr_of(c));
    ev::clear_app_events();
}

#[test]
fn active_can_arrive_without_a_preceding_inactive() {
    ev::clear_app_events();
    ev::clear_latches();
    var c: AlTestComp = al_new();
    assert bind_app_lifecycle::[AlTestComp](#addr_of(c)) == status::Status::Ok;
    // MEASURED on iOS and macOS: `didBecomeActive` fires at launch and after a
    // dialog that never raised `willResignActive`. A component that treats the
    // pair as balanced would double-acquire.
    ev::fire_plain(ev::E_ACTIVE);
    ev::fire_plain(ev::E_ACTIVE);
    assert c.active == 2;
    assert c.inactive == 0;
    let _u: status::Status = unbind_app_lifecycle::[AlTestComp](#addr_of(c));
    ev::clear_app_events();
}

#[test]
fn terminating_is_a_detach_with_its_own_reason() {
    ev::clear_app_events();
    ev::clear_latches();
    var c: AlTestComp = al_new();
    assert bind_app_lifecycle::[AlTestComp](#addr_of(c)) == status::Status::Ok;
    ev::fire_plain(ev::E_TERMINATING);
    assert c.term == 1;
    // NOT conflated with backgrounding. An app that flushes on Terminate and
    // merely releases on Background needs them apart.
    assert c.bg == 0;
    assert c.unmount == 0;
    let _u: status::Status = unbind_app_lifecycle::[AlTestComp](#addr_of(c));
    ev::clear_app_events();
}

#[test]
fn an_unrelated_app_event_reaches_neither_hook() {
    ev::clear_app_events();
    ev::clear_latches();
    var c: AlTestComp = al_new();
    assert bind_app_lifecycle::[AlTestComp](#addr_of(c)) == status::Status::Ok;
    ev::fire_plain(ev::E_LAUNCHED);
    ev::fire_plain(ev::E_LOW_MEMORY);
    ev::fire_text(ev::E_OPEN_URL, "cplus://x");
    assert c.mount == 0;
    assert c.fg == 0;
    assert c.bg == 0;
    assert c.unmount == 0;
    assert c.term == 0;
    let _u: status::Status = unbind_app_lifecycle::[AlTestComp](#addr_of(c));
    ev::clear_app_events();
}

#[test]
fn unbinding_stops_delivery() {
    ev::clear_app_events();
    ev::clear_latches();
    var c: AlTestComp = al_new();
    assert bind_app_lifecycle::[AlTestComp](#addr_of(c)) == status::Status::Ok;
    ev::fire_plain(ev::E_FOREGROUND);
    assert c.fg == 1;

    assert unbind_app_lifecycle::[AlTestComp](#addr_of(c)) == status::Status::Ok;
    ev::fire_plain(ev::E_FOREGROUND);
    // THE POINT. macOS and Linux keep the component in the frame that runs the
    // loop, so a delivery after the unbind would be a call into a dead stack
    // slot — this assert is that use-after-free, caught where it is cheap.
    assert c.fg == 1;
    ev::clear_app_events();
}

#[test]
fn binding_a_null_component_is_refused_rather_than_dispatched_into() {
    ev::clear_app_events();
    assert bind_app_lifecycle::[AlTestComp](0 as *AlTestComp) == status::Status::InvalidInput;
    assert unbind_app_lifecycle::[AlTestComp](0 as *AlTestComp) == status::Status::InvalidInput;
    ev::fire_plain(ev::E_FOREGROUND);
    assert ev::subscriber_count() == (0 as usize);
    ev::clear_app_events();
}

#[test]
fn two_components_on_the_same_axis_are_two_subscribers() {
    ev::clear_app_events();
    ev::clear_latches();
    var a: AlTestComp = al_new();
    var b: AlTestComp = al_new();
    // SAME fn-pointer, different ctx — the case app_events documents as two
    // subscribers rather than a duplicate registration. A nav stack holding
    // several screens is exactly this.
    assert bind_app_lifecycle::[AlTestComp](#addr_of(a)) == status::Status::Ok;
    assert bind_app_lifecycle::[AlTestComp](#addr_of(b)) == status::Status::Ok;
    assert ev::subscriber_count() == (2 as usize);
    ev::fire_plain(ev::E_BACKGROUND);
    assert a.bg == 1;
    assert b.bg == 1;

    assert unbind_app_lifecycle::[AlTestComp](#addr_of(a)) == status::Status::Ok;
    ev::fire_plain(ev::E_BACKGROUND);
    assert a.bg == 1;
    assert b.bg == 2;
    let _u: status::Status = unbind_app_lifecycle::[AlTestComp](#addr_of(b));
    ev::clear_app_events();
}

struct CaTestComp { hits: i32 }
impl CaTestComp: Lifecycle {
    fn on_attach(ref this, why: Attach) {
        if why != Attach::Mount { return; } this.hits = this.hits + 1; return; }
    fn on_detach(ref this, why: Detach) {
        if why != Detach::Unmount { return; } this.hits = this.hits + 100; return; }
}

#[test]
fn component_at_resolves_through_the_running_apps_windows() {
    app::reset_default_for_tests();
    // Nothing mounted: None, never a trap.
    match component_at::[CaTestComp]("outlet") {
        option::Option[*CaTestComp]::Some(_p) => { assert false; }
        option::Option[*CaTestComp]::None => { }
    }
    // A window whose tree carries the keyed outlet, with a presentation
    // recorded ON the node.
    var root: core::Node = core::column(core::Builder::new(), key: "outlet");
    var c: CaTestComp = CaTestComp { hits: 0 };
    core::set_presented(#addr_of(root), #addr_of(c) as *u8, lc_detach_tramp::[CaTestComp]);
    app::open_window(#addr_of(root));
    match component_at::[CaTestComp]("outlet") {
        option::Option[*CaTestComp]::Some(p) => { assert p == #addr_of(c); }
        option::Option[*CaTestComp]::None => { assert false; }
    }
    // A key nothing presents resolves to None even with a window up.
    match component_at::[CaTestComp]("elsewhere") {
        option::Option[*CaTestComp]::Some(_q) => { assert false; }
        option::Option[*CaTestComp]::None => { }
    }
    // Node teardown fires the recorded detach: clear it first here since the
    // node outlives this test's interest.
    let _e: bool = core::evict_presented(#addr_of(root));
    assert c.hits == 100;
    app::reset_default_for_tests();
}

#[test]
fn lc_detach_tramp_fires_the_typed_on_detach() {
    var c: CaTestComp = CaTestComp { hits: 0 };
    let t: fn(*u8) = lc_detach_tramp::[CaTestComp];
    t(#addr_of(c) as *u8);
    assert c.hits == 100;
}

#[test]
fn sender_verbs_default_to_the_no_backend_posture() {
    // Every sender verb answers the neutral value with no backend installed.
    uninstall_sender_readers();
    raise(0 as *u8, "k");
    let k: text::Text = key_of(0 as *u8);
    assert k.view() == "";
    assert item_of(0 as *u8) == (0 as *u8);
    let d: text::Text = dropped_text(0 as *u8);
    assert d.view() == "";
    assert drag_targeted(0 as *u8) == false;
}

// A PARTLY-FILLED BAND IS A SUPPORTED SHAPE, and facet_android is the backend
// that depends on it: it can answer `key_of` and `item_of` off a view's node
// tag, and it has no drag and drop at all, so the three drop readers have no
// state to report and are deliberately left unset. Filling them would mean
// inventing an answer.
//
// The property is that an unset field keeps the PORTABLE DEFAULT rather than
// being called as a null function pointer — which would be a crash, and the
// reason every reader here guards on `is_null` before dispatching.

fn probe_key_of(sender: *u8) -> text::Text { return text::from_str("probe:key"); }

#[test]
fn an_unset_reader_keeps_the_portable_default_beside_a_filled_one() {
    uninstall_sender_readers();
    var r: SenderReaders = sender_readers_none();
    r.key_of = probe_key_of;
    install_sender_readers(r);

    // The one that was filled answers the backend.
    let k: text::Text = key_of(0 as *u8);
    assert k.view() == "probe:key";

    // ...and every one that was not still answers the neutral value rather
    // than dispatching through a null.
    assert item_of(0 as *u8) == (0 as *u8);
    let d: text::Text = dropped_text(0 as *u8);
    assert d.view() == "";
    assert drag_targeted(0 as *u8) == false;
    match drop_position(0 as *u8) {
        option::Option[vocab::Point]::Some(_p) => { assert false; }
        option::Option[vocab::Point]::None => { }
    }
    // `raise` is the band's one WRITE, and an unset one has to be a no-op
    // rather than a call through null.
    raise(0 as *u8, "k");

    uninstall_sender_readers();
}

// ---- a component reached from the live tree, the way an application writes it -

struct CfSide { n: i32 }

impl CfSide {
    fn new() -> CfSide { return CfSide { n: 7 }; }
    fn bump(ref this) { this.n = this.n + 1; return; }
    // THE SPELLING AN APPLICATION WANTS, and it needs nothing from facet: an
    // associated fn delegating to `component_at`, which is where the turbofish
    // goes so the call site does not carry one. Three lines per component, and
    // they are the three lines that make the type the caller's own word.
    fn find(key: str) -> option::Option[*CfSide] {
        return component_at::[CfSide](key);
    }
}

impl CfSide: Component {
    // The shape `@ui { .. }` produces: an unkeyed wrapper around the author's
    // keyed node. `record_holder` is what puts the record on the inner one.
    fn build(ref this) -> Node {
        var b: core::Builder = core::Builder::new();
        b.add(core::column(core::Builder::new(), key: "cf:inner"));
        var inner: core::Node = core::column(b, key: "cf:side");
        var outer: core::Builder = core::Builder::new();
        outer.add(inner);
        return core::column(outer, key: "");
    }
}

impl CfSide: Lifecycle {
    fn on_attach(ref this, why: Attach) { return; }
    fn on_detach(ref this, why: Detach) { return; }
}

impl CfSide: core::IntoNode {
    fn into_node(take this) -> core::Node {
        return child::[CfSide](this).grow(1.0f64);
    }
}

#[test]
fn a_component_is_reachable_from_the_live_tree_by_its_own_key() {
    // END TO END, the way `examples/app_shell` writes it: an `@ui` wrapper
    // around a keyed root, reached through `IntoNode`, with a modifier applied
    // to the block's value. Each of those three could have lost the record and
    // none of them does — the pieces are tested apart, this is them together.
    app::reset_default_for_tests();
    var host: core::Builder = core::Builder::new();
    host.add(CfSide::new());
    var root: core::Node = core::column(host, key: "cf:root");
    app::open_window(#addr_of(root));

    // The instance is LIVE, not a copy: writing through it is the point.
    match component_at::[CfSide]("cf:side") {
        option::Option[*CfSide]::Some(p) => {
            assert { (*p).n } == 7;
            { (*p).bump() };
        }
        option::Option[*CfSide]::None => { assert false; }
    }
    match CfSide::find("cf:side") {
        option::Option[*CfSide]::Some(p) => { assert { (*p).n } == 8; }
        option::Option[*CfSide]::None => { assert false; }
    }
    // A key INSIDE the component's tree is not the component. The record sits
    // on the node the component keyed, and nowhere else.
    match CfSide::find("cf:inner") {
        option::Option[*CfSide]::Some(_q) => { assert false; }
        option::Option[*CfSide]::None => { }
    }
    // And a key nothing presents is None rather than a trap.
    match CfSide::find("cf:absent") {
        option::Option[*CfSide]::Some(_q) => { assert false; }
        option::Option[*CfSide]::None => { }
    }
    app::reset_default_for_tests();
}
