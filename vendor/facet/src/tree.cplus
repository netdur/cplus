// tree — a hierarchical list. HAND-WRITTEN: facet's own word.
//
// MAUI has no tree control at all, so there is no row behind this. It is
// recorded as a facet-origin row in tools/maui_map.py's FACET_ORIGIN.
//
// ---- generic, not a file browser ---------------------------------------------
//
// The model this replaces came out of iris's file pane and was named for it:
// `path` and `is_dir`. Those are file words in a control that is not about
// files. A tree is a label, an identity, and whether a row can open:
//
//     path   -> id          the stable identity. Selection, expansion and row
//                           reuse are all keyed on it, so it must be unique
//                           and must survive a rebuild of the model.
//     is_dir -> is_branch   the row draws a disclosure control. TRUE BEFORE
//                           THE CHILDREN EXIST, which is what makes lazy
//                           loading expressible: a branch says "there may be
//                           more here", not "there are N here".
//
// A file browser passes the path as the id and `is_dir` as `is_branch`, and
// reads exactly as it did. Anything else — an outline, a scene graph, a JSON
// viewer — now reads properly too.
//
// ---- it recycles, but it is not `list` ---------------------------------------
//
// Underneath, every platform's tree is a recycling view: NSOutlineView is a
// subclass of NSTableView. But `list` is count + index and a tree is
// parent -> children plus expansion state plus stable identity, and neither
// protocol reaches the other. Two controls, one implementation technique.
//
// ---- who owns the model ------------------------------------------------------
//
// The tree does. Children are `Vec[Box[TreeNode]]`, the same idiom flex uses
// for its own children: every node's address is stable from insertion until
// it is removed, so a `*TreeNode` handed to a row builder stays valid, and
// dropping the root frees the whole model. The predecessor malloc'd nodes and
// leaked them for the life of the application.

import "flex_layout/flex_layout" as flex;
import "stdlib/text" as text;
import "stdlib/option" as option;
import "stdlib/status" as status;
import "stdlib/box" as box;
import "stdlib/vec" as vec;
import "./facet" as core;
import "./mount" as mount;
import "./vocabulary" as vocab;

// facet-origin controls take their kind tag from 1000 up.
const K_TREE: u32 = 1001u32;

const P_ROOT: u64 = 1u64;
const P_ROW: u64 = 2u64;
const P_ROW_HEIGHT: u64 = 4u64;
const P_SELECTED: u64 = 8u64;
const P_EXPANDED: u64 = 16u64;

// ---- the model ---------------------------------------------------------------

struct TreeNode {
    // What the row shows when no row builder is given.
    label: text::Text,
    // Stable identity. Selection, expansion and row reuse all key on it, so
    // it must be unique within the tree and must SURVIVE A MODEL REBUILD.
    //
    // Derive it from the ITEM, never from where the item sits:
    //
    //     "/people/alice"        a path
    //     "commit:3f9a2c"        a content hash
    //     "user:8814"            a record id
    //
    //     "row_0", "row_${i}"    NO. Positional.
    //
    // A positional identity renames every row after any insert, removal or
    // sort, so selection and expansion follow the SLOT and not the item — the
    // bug that reads as "selection jumps to the wrong row". Both halves are in
    // the suite: `a_positional_identity_follows_the_slot_not_the_item` and
    // `a_content_identity_survives_the_same_edit`.
    //
    // Owned `Text`, not `str`, because an identity is ALWAYS computed. A `str`
    // is a borrowed {ptr, len}; storing a view of a temporary is the fault in
    // bugs/str-field-outliving-its-text-is-not-caught.md. Interning would make
    // a computed identity a permanent `str`, and is the wrong trade here: row
    // identities churn with the data, so the table would grow without bound.
    // That trade is only sound for ADDRESSES, which are few and repeat.
    id: text::Text,
    // Draws a disclosure control. May be true before any child exists — that
    // is how a lazily-loaded branch says "there may be more here".
    is_branch: bool,
    // The application's own payload, untouched and NEVER freed by facet.
    // Present so a row builder does not have to look its data up by id on
    // every row of a tree that may have thousands.
    opaque data: *u8,
    _children: vec::Vec[box::Box[TreeNode]],
    // The backend's per-node cache slot. Applications never touch it.
    opaque backend: *u8,
}

impl TreeNode {
    // `id` must be stable across model rebuilds — a path, a hash, a record id.
    // Never a position: see the note on the field.
    fn new(label: str, id: str, is_branch: bool = false, data: *u8 = 0 as *u8) -> TreeNode {
        return TreeNode {
            label: text::from_str(label),
            id: text::from_str(id),
            is_branch: is_branch,
            data: data,
            _children: vec::new::[box::Box[TreeNode]](),
            backend: 0 as *u8,
        };
    }

    fn add_child(ref this, take child: TreeNode) -> status::Status {
        return this.insert_child(child, at: this._children.count());
    }

    fn insert_child(ref this, take child: TreeNode, at: usize) -> status::Status {
        if at > this._children.count() { return status::Status::OutOfBounds; }
        return match box::new(child) {
            option::Option[box::Box[TreeNode]]::Some(b) => this._children.insert(b, at),
            option::Option[box::Box[TreeNode]]::None => status::Status::OutOfMemory,
        };
    }

    // Detach and return the subtree at `at`. It owns everything under it:
    // drop it, or add it somewhere else to move it.
    fn remove_child(ref this, at: usize) -> option::Option[TreeNode] {
        return match this._children.remove(at) {
            option::Option[box::Box[TreeNode]]::Some(b) => option::Option[TreeNode]::Some(b.unwrap()),
            option::Option[box::Box[TreeNode]]::None => option::Option[TreeNode]::None,
        };
    }

    fn child_count(this) -> usize { return this._children.count(); }

    fn child_ptr(this, at: usize) -> option::Option[*TreeNode] {
        return match this._children.at_ptr(at) {
            option::Option[*box::Box[TreeNode]]::Some(bp) => option::Option[*TreeNode]::Some({ (*bp).ptr() }),
            option::Option[*box::Box[TreeNode]]::None => option::Option[*TreeNode]::None,
        };
    }

    fn label_of(this) -> str { return this.label.view(); }
    fn id_of(this) -> str { return this.id.view(); }

    // A branch with nothing under it yet: the disclosure control shows, and
    // opening it is the application's cue to fill it in.
    fn is_unloaded(this) -> bool {
        return this.is_branch && this._children.count() == (0 as usize);
    }
}

// Depth-first search by id. The one lookup selection and expansion need.
fn find_id(n: *TreeNode, id: str) -> option::Option[*TreeNode] {
    if n == (0 as *TreeNode) { return option::Option[*TreeNode]::None; }
    if { (*n).id_of() } == id { return option::Option[*TreeNode]::Some(n); }
    let count: usize = { (*n).child_count() };
    var i: usize = 0 as usize;
    while i < count {
        match { (*n).child_ptr(i) } {
            option::Option[*TreeNode]::Some(c) => {
                match find_id(c, id) {
                    option::Option[*TreeNode]::Some(hit) => { return option::Option[*TreeNode]::Some(hit); }
                    option::Option[*TreeNode]::None => { }
                }
            }
            option::Option[*TreeNode]::None => { }
        }
        i = i +% (1 as usize);
    }
    return option::Option[*TreeNode]::None;
}

// ---- the control -------------------------------------------------------------

fn no_row(node: *TreeNode, ctx: *u8) -> flex::Node { return flex::Node::new(); }
// The absent bind. Compared against BY NAME, not against null: the default has
// to be a real function, so a null check would never be false — the mistake
// that made `row`'s own fallback dead code until 2026-08-04.
fn no_bind(node: *TreeNode, ctx: *u8, row: *flex::Node) { return; }
fn no_select(node: *TreeNode, ctx: *u8) { return; }

struct TreeProps {
    root: TreeNode,
    row: fn(*TreeNode, *u8) -> flex::Node,
    // The recycling half: `row` describes the SHAPE once per cell and `bind`
    // writes one item's data into it. See list's `set_row_bind` — the same
    // idea, with the item in place of the index.
    bind: fn(*TreeNode, *u8, *flex::Node),
    on_select: fn(*TreeNode, *u8),
    opaque ctx: *u8,
    row_height: f64,             // 0 = let the backend measure
    selected: text::Text,        // "" = nothing selected
    expanded: vocab::TextList,
}

impl TreeProps {
    fn new() -> TreeProps {
        return TreeProps {
            root: TreeNode::new("", ""),
            row: no_row,
            bind: no_bind,
            on_select: no_select,
            ctx: 0 as *u8,
            row_height: 0.0f64,
            selected: text::new(),
            expanded: vocab::TextList::new(),
        };
    }
}

fn release_tree_props(p: *u8) {
    if p == (0 as *u8) { return; }
    let _b: box::Box[TreeProps] = box::from_raw::[TreeProps](p);
    return;
}

// The tree takes ownership of its model. Hand it a root and it frees the whole
// thing when the node goes; hand it a new one with `set_root` to replace.
fn tree(
    take root: TreeNode,
    key: str = "",
    row: fn(*TreeNode, *u8) -> flex::Node = no_row,
    on_select: fn(*TreeNode, *u8) = no_select,
    ctx: *u8 = 0 as *u8,
    row_height: f64 = 0.0f64,
) -> core::Node {
    var p: TreeProps = TreeProps::new();
    p.root = root;
    p.row = row;
    p.on_select = on_select;
    p.ctx = ctx;
    p.row_height = row_height;
    return match box::new::[TreeProps](p) {
        option::Option[box::Box[TreeProps]]::Some(b) =>
            core::node_with(key, K_TREE, b.into_raw(), release_tree_props),
        option::Option[box::Box[TreeProps]]::None =>
            core::node_with(key, K_TREE, 0 as *u8, release_tree_props),
    };
}

// ---- live --------------------------------------------------------------------

struct Tree {
    opaque _p: *core::Node,
    _seen: u64,
}

impl Tree {
    // Unchecked, so module-private. `from` is the public door.
    fn _of(p: *core::Node) -> Tree { return Tree { _p: p, _seen: flex::removal_count() }; }
    fn is_live(this) -> bool { return this._seen == flex::removal_count(); }

    fn _props(this) -> *TreeProps {
        let d: *core::Data = { (*this._p).data() };
        if d == (0 as *core::Data) { return 0 as *TreeProps; }
        if { (*d).kind } != K_TREE { return 0 as *TreeProps; }
        return { (*d).props } as *TreeProps;
    }

    // The model, to walk or mutate in place. Owned by the tree; do not free it.
    // `root` is the first field of TreeProps, so its address is the struct's —
    // taken through the field rather than a temporary, which is not a place.
    fn root(this) -> *TreeNode {
        let p: *TreeProps = this._props();
        if p == (0 as *TreeProps) { return 0 as *TreeNode; }
        return #addr_of((*p).root);
    }

    // Replace the whole model. The old one is dropped with everything under it.
    fn set_root(this, take root: TreeNode) -> Tree {
        let p: *TreeProps = this._props();
        if p == (0 as *TreeProps) { return this; }
        { (*p).root = root };
        core::touch(this._p, P_ROOT);
        return this;
    }

    // A row of the MODEL, by id. Named `item` and not `node` because a cursor
    // also has `node()`, which is the flex node the tree itself sits on —
    // two different things one word away from each other.
    fn item(this, id: str) -> option::Option[*TreeNode] {
        return find_id(this.root(), id);
    }

    fn set_row(this, f: fn(*TreeNode, *u8) -> flex::Node, ctx: *u8 = 0 as *u8) -> Tree {
        let p: *TreeProps = this._props();
        if p == (0 as *TreeProps) { return this; }
        { (*p).row = f };
        { (*p).ctx = ctx };
        core::touch(this._p, P_ROW);
        return this;
    }

    fn build_row(this, node: *TreeNode) -> flex::Node {
        let p: *TreeProps = this._props();
        if p == (0 as *TreeProps) { return flex::Node::new(); }
        let f: fn(*TreeNode, *u8) -> flex::Node = { (*p).row };
        return f(node, { (*p).ctx });
    }

    // Write an item's data into an EXISTING row. Optional, and its absence is
    // not an error: without it a backend rebuilds each row, which is what every
    // backend did before this existed. Setting it is a promise that every row
    // has the same shape — which recycling assumes anyway, said out loud.
    fn set_row_bind(this, f: fn(*TreeNode, *u8, *flex::Node), ctx: *u8 = 0 as *u8) -> Tree {
        let p: *TreeProps = this._props();
        if p == (0 as *TreeProps) { return this; }
        { (*p).bind = f };
        { (*p).ctx = ctx };
        core::touch(this._p, P_ROW);
        return this;
    }

    fn set_row_height(this, v: f64) -> Tree {
        let p: *TreeProps = this._props();
        if p == (0 as *TreeProps) { return this; }
        { (*p).row_height = v };
        core::touch(this._p, P_ROW_HEIGHT);
        return this;
    }

    fn row_height(this) -> f64 {
        let p: *TreeProps = this._props();
        if p == (0 as *TreeProps) { return 0.0f64; }
        return { (*p).row_height };
    }

    // ---- selection -----------------------------------------------------------

    fn select(this, id: str) -> Tree {
        let p: *TreeProps = this._props();
        if p == (0 as *TreeProps) { return this; }
        { (*p).selected = text::from_str(id) };
        core::touch(this._p, P_SELECTED);
        return this;
    }

    fn deselect(this) -> Tree { return this.select(""); }

    fn selected(this) -> str {
        let p: *TreeProps = this._props();
        if p == (0 as *TreeProps) { return ""; }
        return { (*p).selected.view() };
    }

    fn has_selection(this) -> bool { return this.selected() != ""; }

    // ---- expansion -----------------------------------------------------------

    fn is_expanded(this, id: str) -> bool {
        let p: *TreeProps = this._props();
        if p == (0 as *TreeProps) { return false; }
        let n: usize = { (*p).expanded.count() };
        var i: usize = 0 as usize;
        while i < n {
            if { (*p).expanded.at(i) } == id { return true; }
            i = i +% (1 as usize);
        }
        return false;
    }

    fn expand(this, id: str) -> Tree {
        let p: *TreeProps = this._props();
        if p == (0 as *TreeProps) { return this; }
        if this.is_expanded(id) { return this; }
        let _s: status::Status = { (*p).expanded.add(id) };
        core::touch(this._p, P_EXPANDED);
        return this;
    }

    fn collapse(this, id: str) -> Tree {
        let p: *TreeProps = this._props();
        if p == (0 as *TreeProps) { return this; }
        var kept: vocab::TextList = vocab::TextList::new();
        let n: usize = { (*p).expanded.count() };
        var i: usize = 0 as usize;
        while i < n {
            let e: str = { (*p).expanded.at(i) };
            if e != id { let _s: status::Status = kept.add(e); }
            i = i +% (1 as usize);
        }
        { (*p).expanded = kept };
        core::touch(this._p, P_EXPANDED);
        return this;
    }

    fn expanded_count(this) -> usize {
        let p: *TreeProps = this._props();
        if p == (0 as *TreeProps) { return 0 as usize; }
        return { (*p).expanded.count() };
    }

    fn expanded(this, at: usize) -> str {
        let p: *TreeProps = this._props();
        if p == (0 as *TreeProps) { return ""; }
        return { (*p).expanded.at(at) };
    }

    fn set_expanded(this, take ids: vocab::TextList) -> Tree {
        let p: *TreeProps = this._props();
        if p == (0 as *TreeProps) { return this; }
        { (*p).expanded = ids };
        core::touch(this._p, P_EXPANDED);
        return this;
    }

    // Restore a tree's state after its model was rebuilt.
    //
    // EXPANSION FIRST, THEN SELECTION — always, and that is why this verb
    // exists rather than leaving an application to call the two in order. A
    // selected row inside a collapsed branch is not visible, so selecting
    // before expanding either scrolls to nothing or is dropped by the platform
    // outright. Doing it in one verb makes the ordering impossible to get
    // wrong; it was got wrong once, and the bug reads as "selection randomly
    // does not stick".
    fn restore(this, take expanded: vocab::TextList, selected: str = "") -> Tree {
        let _a: Tree = this.set_expanded(expanded);
        if selected != "" { let _b: Tree = this.select(selected); }
        return this;
    }

    // The flex node this cursor points at: layout comes from flex, not from
    // a second vocabulary here. See the note on the generated cursors.
    fn node(this) -> *core::Node { return this._p; }

    // --- live layout: flex's own names, reachable after mount ---
    fn set_grow(this, v: f64) -> Tree { core::set_grow(this._p, v); return this; }
    fn set_shrink(this, v: f64) -> Tree { core::set_shrink(this._p, v); return this; }
    fn set_width(this, v: f64) -> Tree { core::set_width(this._p, v); return this; }
    fn set_height(this, v: f64) -> Tree { core::set_height(this._p, v); return this; }
    fn set_width_percent(this, v: f64) -> Tree { core::set_width_percent(this._p, v); return this; }
    fn set_height_percent(this, v: f64) -> Tree { core::set_height_percent(this._p, v); return this; }
    fn set_padding(this, v: f64) -> Tree { core::set_padding(this._p, v); return this; }
    fn set_margin(this, v: f64) -> Tree { core::set_margin(this._p, v); return this; }
    fn set_gap(this, v: f64) -> Tree { core::set_gap(this._p, v); return this; }
    fn set_justify(this, v: flex::Justify) -> Tree { core::set_justify(this._p, v); return this; }
    fn set_align(this, v: flex::Align) -> Tree { core::set_align(this._p, v); return this; }
    fn set_wrap(this, v: flex::Wrap) -> Tree { core::set_wrap(this._p, v); return this; }

    // --- the shared band ---
    fn set_opacity(this, v: f64) -> Tree { core::set_opacity(this._p, v); return this; }
    fn opacity(this) -> f64 { return core::opacity(this._p); }
    fn set_enabled(this, v: bool) -> Tree { core::set_enabled(this._p, v); return this; }
    fn is_enabled(this) -> bool { return core::is_enabled(this._p); }
    fn set_visible(this, v: bool) -> Tree { core::set_visible(this._p, v); return this; }
    fn is_visible(this) -> bool { return core::is_visible(this._p); }
    fn set_background_color(this, v: vocab::Color) -> Tree { core::set_background_color(this._p, v); return this; }
    fn background_color(this) -> vocab::Color { return core::background_color(this._p); }
    fn width(this) -> f64 { return core::width_of(this._p); }
    fn height(this) -> f64 { return core::height_of(this._p); }
    fn x(this) -> f64 { return core::x_of(this._p); }
    fn y(this) -> f64 { return core::y_of(this._p); }
    fn bounds(this) -> vocab::Rect { return core::bounds_of(this._p); }
    fn native(this) -> *u8 { return core::native(this._p); }
    fn is_attached(this) -> bool { return core::is_attached(this._p); }
    fn focus(this) -> Tree { core::focus(this._p); return this; }
    fn relayout(this) -> Tree { core::relayout(this._p); return this; }
    fn frame(this) -> core::Frame { return core::frame_of(this._p); }
}

// Narrow a node to this control, the DOM step: a node carries what EVERY
// node has, and a checked cast adds what only this control has.
fn from(p: *core::Node) -> option::Option[Tree] {
    if p == (0 as *core::Node) { return option::Option[Tree]::None; }
    let d: *core::Data = { (*p).data() };
    if d == (0 as *core::Data) { return option::Option[Tree]::None; }
    if { (*d).kind } != K_TREE { return option::Option[Tree]::None; }
    return option::Option[Tree]::Some(Tree::_of(p));
}

fn find(key: str, within: *core::Node = 0 as *core::Node) -> option::Option[Tree] {
    if within != (0 as *core::Node) {
        return match core::find_in(within, key) {
            option::Option[*core::Node]::Some(p) => from(p),
            option::Option[*core::Node]::None => option::Option[Tree]::None,
        };
    }
    return match mount::find_node(key) {
        option::Option[*core::Node]::Some(p) => from(p),
        option::Option[*core::Node]::None => option::Option[Tree]::None,
    };
}
