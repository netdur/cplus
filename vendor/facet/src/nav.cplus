// Content navigation is reached through a window's Navigator. It never opens
// or closes a window. Screen contexts carry instance-specific arguments.
import "./nav_model" as model;
import "./application" as app;

type Navigator = model::Navigator;
type Context = model::Context;
type State = model::State;
type Params = model::Params;
fn params_new() -> Params { return model::params_new(); }

// Native Android Back dispatch. The runtime binds its single window here;
// application content navigation uses an instance Navigator above.
fn set_pop_fn(f: fn() -> bool) { (*app::current()).nav.pop_fn = f; }
fn pop() -> bool {
    let f = (*app::current()).nav.pop_fn;
    if f.is_null() { return false; }
    return f();
}
