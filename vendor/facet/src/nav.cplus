// facet nav — screen navigation verbs.
//
// A screen's handler navigates by NAMED ROUTE: `nav::go("workspace")` replaces
// the current screen with the one registered under "workspace";
// `nav::push("settings")` shows one ALONGSIDE it; `nav::pop()` dismisses the
// pushed screen again; `nav::quit()` ends the app. The verbs are explicit
// requests recorded here — no diffing, no hidden re-render — and the running
// `App` (facet/runtime) maps them to the platform: on desktop `go` closes the
// current window and opens the next screen's, `push` opens a secondary window,
// `pop` closes it. On a mobile backend the same verbs drive the nav stack.
//
// `go` and `quit` also unwind a `run_screen` / `run_component` window (the
// runtime registers the close hook while one is up) — the caller reads the
// pending intent after the return, the way an App loop does. `push`/`pop`
// need a running App's route registry and report false otherwise. With no
// runtime window at all (`present`, plain mounts) the verbs record intent
// but close nothing. Main-thread only, like every facet verb.

import "stdlib/str" as str_;
import "stdlib/text" as text;
import "stdlib/string_map" as map;
import "stdlib/option" as option;
import "stdlib/status" as status;
import "./application" as app;

// A route's arguments: named values the target screen reads by key. The
// stdlib map, not a facet type — a bag of owned strings is not a UI concept,
// and a second one would only differ in name.
type Params = map::StringMap[text::Text];

fn params_new() -> Params { return map::new::[text::Text](); }

// Where `arg:` lives. The unnamed argument is a NAMED one under a reserved
// key, so there is a single storage: `arg()` is `param(arg_key())`, and a
// route cannot be handed an `arg` and a params entry that disagree.
fn arg_key() -> str { return "@arg"; }

// ---- how a route is shown ------------------------------------------------------
// ONE INTENT, TWO RENDERINGS. `push` means "show this next, with whatever room
// this platform has": a peer window on a desktop, a stack push on a phone. That
// is not two meanings — it is one, rendered as each platform renders it, and an
// app that says nothing gets the right shape on both without asking which it is
// running on.
//
// `Screen` narrows it to "in place, no new window", which is a drill-down and
// is the same everywhere. It is what a wizard or a master-detail wants on a
// desktop, and it is what EVERY push is on a phone.
//
// The alternative — one verb whose meaning flips per platform, patched apart
// later with a second verb — is the trap both large frameworks that reached
// this tier fell into, and neither could remove the first verb afterwards. See
// plans/nav-windows.md §7.
enum Show {
    Window,
    Screen,
}

// The hook channel is a u32: `Navigation` lives in application.cplus, which
// this file imports, and an enum cannot cross back the other way (E0341).
fn show_code(s: Show) -> u32 {
    return match s {
        Show::Window => 0 as u32,
        Show::Screen => 1 as u32,
    };
}

fn show_of_code(c: u32) -> Show {
    if c == (1 as u32) { return Show::Screen; }
    return Show::Window;
}

// THE NAME A PUSHED WINDOW IS ADDRESSED BY: the route, or `route:arg` when an
// argument was given. What makes two windows of one route different is the
// argument they were pushed with — two cameras, two documents — so the identity
// derives from it rather than being invented by the caller.
//
//     push("camera", arg: "front")   ->  "camera:front"
//     push("camera")                 ->  "camera"
//
// `params:` does NOT feed the key. Only `arg` does, which is consistent with
// `arg` already being the privileged unnamed argument above: a route's identity
// is what it is showing, not every value it was handed.
fn key_for(route: str, key: str, arg: str) -> text::Text {
    if key != "" { return text::from_str(key); }
    if arg == "" { return text::from_str(route); }
    return text::from_str(route).appending(":").appending(arg);
}

// THE INVERSE OF `key_for`, and it lives here because that is what makes the
// pair checkable: a key is written by one function and read back by another,
// and if they disagree a restored window resolves to the wrong screen or to
// none. The round trip is pinned by a test below.
//
// A platform that persists windows across launches (iPadOS restores scene
// sessions) gets the KEY back and nothing else — the process is new, so there
// is no pending route to consult. Splitting the key is how a restored window
// finds its screen again.
//
// `route_of_key("camera:front")` -> "camera"
// `arg_of_key("camera:front")`   -> "front"
// `route_of_key("camera")`       -> "camera",  arg ""
//
// A key that came from an explicit `key:` override is NOT recoverable, and
// deliberately so: it was never built from a route, so there is nothing in it
// to find. The caller's fallback is to refuse the window rather than guess.
fn route_of_key(key: str) -> str {
    return match key.find(":") {
        option::Option[usize]::Some(at) => match key.slice(0 as usize, at) {
            option::Option[str]::Some(r) => r,
            option::Option[str]::None => key,
        },
        option::Option[usize]::None => key,
    };
}

fn arg_of_key(key: str) -> str {
    return match key.find(":") {
        option::Option[usize]::Some(at) => match key.slice(at +% (1 as usize), key.count()) {
            option::Option[str]::Some(a) => a,
            option::Option[str]::None => "",
        },
        option::Option[usize]::None => "",
    };
}

// ---- intent codes -----------------------------------------------------------

fn intent_none() -> u32 { return 0 as u32; }
fn intent_go() -> u32 { return 1 as u32; }
fn intent_quit() -> u32 { return 2 as u32; }

// ---- the recorded intent ----------------------------------------------------
// One pending intent at a time: the LAST verb before the window unwinds wins
// (go then quit = quit). TARGET names the route `go` asked for; ARG rides
// along and stays readable through `arg()` while the target screen runs — the
// route-argument channel (`nav::go("workspace", arg: path)` -> the workspace
// factory or its on_attach reads `nav::arg()`).

// Navigation state is APP-scoped (app::Navigation): a second app in the
// same exe starts with no pending intent, and the hooks below die with the
// loop that registered them. This module is the verbs over the RUNNING
// app's record.

// ---- App-registered hooks ---------------------------------------------------
// close unwinds the current primary screen's window (go / quit fire it).
// push / pop open and dismiss a pushed screen immediately (no unwind).
// Registered by App for the life of its loop; null otherwise.

fn set_close_fn(f: fn()) {
    let s: *app::Application = app::current();
    { (*s).nav.close_fn = f };
}
fn set_push_fn(f: fn(str, str, str, u32) -> bool) {
    let s: *app::Application = app::current();
    { (*s).nav.push_fn = f };
}
fn set_pop_fn(f: fn() -> bool) {
    let s: *app::Application = app::current();
    { (*s).nav.pop_fn = f };
}

// How deep the in-place stack is. Registered by the running App alongside the
// others; null answers 0.
fn set_depth_fn(f: fn() -> usize) {
    let s: *app::Application = app::current();
    { (*s).nav.depth_fn = f };
}

fn set_pop_to_fn(f: fn(str) -> bool) {
    let s: *app::Application = app::current();
    { (*s).nav.pop_to_fn = f };
}

fn clear_hooks() {
    let s: *app::Application = app::current();
    { (*s).nav.close_fn = 0 as fn() };
    { (*s).nav.push_fn = 0 as fn(str, str, str, u32) -> bool };
    { (*s).nav.pop_fn = 0 as fn() -> bool };
    { (*s).nav.pop_to_fn = 0 as fn(str) -> bool };
    { (*s).nav.depth_fn = 0 as fn() -> usize };
}

fn fire_close() {
    let s: *app::Application = app::current();
    let f: fn() = { (*s).nav.close_fn };
    if f.is_not_null() { f(); }
}

// ---- verbs ------------------------------------------------------------------

// Replace the current screen: record the route, close the current window. The
// App loop reads the intent once the window unwinds and opens the target.
// `params:` carries NAMED arguments; `arg:` is the unnamed one and lands in
// the same map under `arg_key()`. Passing both is legal and they do not
// collide — the target reads `nav::arg()` for the one and `nav::param(k)` for
// the others.
//
//     nav::go("workspace", arg: path)
//
//     var p: nav::Params = nav::params_new();
//     let _s: status::Status = p.insert(text::from_str("path"), path.to_text());
//     nav::go("workspace", params: p);
fn go(route: str, arg: str = "", take params: Params = params_new()) {
    var p: Params = params;
    if arg != "" { let _s: status::Status = p.insert(text::from_str(arg_key()), arg.to_text()); }
    let s: *app::Application = app::current();
    { (*s).nav.intent = intent_go() };
    // No explicit `.drop()` before these overwrites: a field assignment
    // through a raw pointer pre-drops the old value like the direct
    // spelling does (fixed 2026-08-08 — bugs/assignment-through-a-raw-
    // pointer-does-not-drop-the-old-value.md; the workaround this replaces
    // WOULD now be a double free).
    { (*s).nav.target = text::from_str(route) };
    { (*s).nav.params = p };
    fire_close();
}

// End the app: close the current window with nothing pending after it.
fn quit() {
    let s: *app::Application = app::current();
    { (*s).nav.intent = intent_quit() };
    fire_close();
}

// SHOW THIS NEXT, with whatever room the platform has. `show: Show::Window`
// (the default) is a peer window on a desktop and a stack push on a phone;
// `show: Show::Screen` is a drill-down in the current window everywhere. See
// the `Show` comment above for why that is one intent and not two.
//
// `key:` names the window a `Show::Window` push opens, and defaults to the
// route — or `route:arg` when an argument was given, so two cameras get two
// addresses without the caller inventing them. A key already open is not
// opened twice: the platform activates the one that is up.
//
// Immediate — nothing unwinds. False when no App is running or the route is
// unknown.
//
//     nav::push("settings");
//     nav::push("camera", arg: "front");                 // window "camera:front"
//     nav::push("step2", show: nav::Show::Screen);       // in place, with a back path
fn push(route: str, key: str = "", arg: str = "",
        take params: Params = params_new(),
        show: Show = Show::Window) -> bool {
    // AN EMPTY ROUTE IS REFUSED HERE, before any backend sees it. There is no
    // factory to find under "", so this could only ever answer false — but the
    // reason it is refused HERE is that `key_for("", "", "")` is the one input
    // that yields an EMPTY KEY, and a key is a window's name all the way down
    // to the platform. iPadOS builds an `NSUserActivity` from it, and
    // `-[NSUserActivity initWithActivityType:]` RAISES on an empty type — an
    // ObjC exception, which is an abort, from a bad argument to a facade verb.
    // Refusing at the top keeps every backend's answer the same.
    if route == "" { return false; }
    let s: *app::Application = app::current();
    let f: fn(str, str, str, u32) -> bool = { (*s).nav.push_fn };
    if f.is_null() { return false; }
    // STAGED, not written. A failed push must leave the current screen's
    // arguments exactly as they were, and only the hook can tell whether the
    // route resolved — so the hook adopts these once it has a factory.
    { (*s).nav.pending = params };
    let k: text::Text = key_for(route, key, arg);
    return f(route, k.view(), arg, show_code(show));
}

// Dismiss the most recently pushed screen. STACK ONLY — this never closes a
// window, which is the whole reason `pop` is a stack word: a peer window is
// not a stack and is closed by name (`window::find(k).close()`), not popped.
//
// False when the stack is empty, and that answer is load-bearing: each backend
// decides what its platform does with it. Android falls through to
// `super.onBackPressed()`, which backgrounds the app — back from the first
// screen leaving the app IS the Android behaviour. iOS does nothing, which is
// what a swipe-back at the root of a nav stack does there.
fn pop() -> bool {
    let s: *app::Application = app::current();
    let f: fn() -> bool = { (*s).nav.pop_fn };
    if f.is_null() { return false; }
    return f();
}

// Unwind the in-place stack until `route` is on top. False when it is not on
// the stack at all, and NOTHING MOVES in that case.
//
// The hook answers rather than this file, and the reason is worth keeping: nav
// can only see `depth()` and what is on top, so an implementation here would
// have to pop speculatively to discover whether the route was ever down there —
// destroying the stack to find out it should not have. The stack's owner can
// look before it moves.
fn pop_to(route: str) -> bool {
    let s: *app::Application = app::current();
    let f: fn(str) -> bool = { (*s).nav.pop_to_fn };
    if f.is_null() { return false; }
    return f(route);
}

// How deep the in-place screen stack is — 0 at the root screen, which is what
// an app with no stack reads. `can_pop` is the question a back button asks.
fn depth() -> usize {
    let s: *app::Application = app::current();
    let f: fn() -> usize = { (*s).nav.depth_fn };
    if f.is_null() { return 0 as usize; }
    return f();
}

fn can_pop() -> bool { return depth() > (0 as usize); }

// The route on top of the in-place stack, "" when it is empty. Read from the
// live record the App keeps, so it follows a user's back gesture as well as a
// programmatic pop.
fn top_route() -> str {
    let s: *app::Application = app::current();
    return { (*s).nav.top.view() };
}

fn set_top_route(route: str) {
    let s: *app::Application = app::current();
    { (*s).nav.top = text::from_str(route) };
}

// ---- reads (screen + App side) ----------------------------------------------

// The argument the intent that showed the CURRENT screen carried. Empty when
// none was given. Stable until the next navigation verb.
fn arg() -> str { return param(arg_key()); }

// One named argument, or "" when the route was not given it. The view is into
// the app's own storage, so it is stable for as long as `arg()` is — until the
// next navigation verb.
fn param(key: str) -> str {
    let s: *app::Application = app::current();
    return match { (*s).nav.params.get_ptr(key) } {
        option::Option[*text::Text]::Some(v) => { (*v).view() },
        option::Option[*text::Text]::None => "",
    };
}

fn has_param(key: str) -> bool {
    let s: *app::Application = app::current();
    return { (*s).nav.params.contains_key(key) };
}

// The App hook's channel for a pushed screen's argument: the hook sets it
// right before the route factory runs, so the pushed screen's `arg()` reads
// its own argument — and a FAILED push (unknown route) leaves the current
// arg untouched. App-side plumbing, not an app-facing verb.
fn set_arg(arg: str) {
    let s: *app::Application = app::current();
    let _s: status::Status = { (*s).nav.params.insert(text::from_str(arg_key()),
                                                      text::from_str(arg)) };
}

// What a push hook calls once its route has RESOLVED and before it runs the
// factory: adopt the whole staged argument set, replacing the current screen's
// the way `go` does. `set_arg` alone was enough while `push` carried only the
// unnamed argument; it now carries `params:` as well, and both have to land
// together or a pushed screen would see its `arg()` and not its `param()`.
//
// A push that never gets here — an unknown route — leaves the live arguments
// untouched, which is the invariant this staging exists for.
fn adopt_push_args(arg: str) {
    let s: *app::Application = app::current();
    // COPIED slot by slot rather than moved. `Navigation` has a destructor, so
    // a field cannot be moved out of it (E0509) — the staged map stays owned by
    // the record and is emptied once its contents are safely elsewhere.
    var out: Params = params_new();
    let cap: usize = { (*s).nav.pending.slot_capacity() };
    var i: usize = 0 as usize;
    while i < cap {
        match { (*s).nav.pending.key_ptr_at_slot(i) } {
            option::Option[*text::Text]::Some(kp) => {
                match { (*s).nav.pending.value_ptr_at_slot(i) } {
                    option::Option[*text::Text]::Some(vp) => {
                        let _e: status::Status =
                            out.insert(text::from_str({ (*kp).view() }),
                                       text::from_str({ (*vp).view() }));
                    }
                    option::Option[*text::Text]::None => { }
                }
            }
            option::Option[*text::Text]::None => { }
        }
        i = i +% (1 as usize);
    }
    { (*s).nav.pending = params_new() };
    if arg != "" {
        let _a: status::Status = out.insert(text::from_str(arg_key()),
                                            text::from_str(arg));
    }
    { (*s).nav.params = out };
}

// The pending intent code, without consuming it.
fn pending() -> u32 {
    let s: *app::Application = app::current();
    return { (*s).nav.intent };
}

// The route `go` asked for. Valid while the intent is pending and until the
// next verb overwrites it.
fn target() -> str {
    let s: *app::Application = app::current();
    return { (*s).nav.target.view() };
}

// Consume the pending intent: returns it and rearms to none. TARGET / ARG stay
// readable (the App resolves the route from TARGET right after taking).
fn take() -> u32 {
    let s: *app::Application = app::current();
    let i: u32 = { (*s).nav.intent };
    { (*s).nav.intent = intent_none() };
    return i;
}

// Fresh state for a new App loop: no intent, empty route, the given initial
// argument (so the FIRST screen's `arg()` works like every later one's).
fn reset(arg: str = "") {
    let s: *app::Application = app::current();
    { (*s).nav.intent = intent_none() };
    // The overwrite pre-drops the old value now (2026-08-08 fix); an
    // explicit `.drop()` here would be a double free.
    { (*s).nav.target = text::new() };
    // A FRESH map, not an insert: reset means the next screen inherits nothing
    // the last one was given.
    var p: Params = params_new();
    if arg != "" { let _s: status::Status = p.insert(text::from_str(arg_key()), text::from_str(arg)); }
    { (*s).nav.params = p };
    // A fresh loop inherits no half-staged push and no stack.
    { (*s).nav.pending = params_new() };
    { (*s).nav.top = text::new() };
}

// ---- tests -------------------------------------------------------------------

static NAVT_CLOSES: i32 = 0;
static NAVT_PUSHES: i32 = 0;
static NAVT_POPS: i32 = 0;
static NAVT_LAST_KEY: text::Text = #zero::[text::Text]();
static NAVT_LAST_SHOW: u32 = 0 as u32;
static NAVT_DEPTH: usize = 0 as usize;

fn navt_close() { NAVT_CLOSES = NAVT_CLOSES + 1; return; }
fn navt_push(route: str, key: str, arg: str, show: u32) -> bool {
    NAVT_PUSHES = NAVT_PUSHES + 1;
    NAVT_LAST_KEY = text::from_str(key);
    NAVT_LAST_SHOW = show;
    if route != "settings" { return false; }
    // A real hook adopts the staged arguments only once its route resolved.
    adopt_push_args(arg);
    return true;
}
fn navt_pop() -> bool { NAVT_POPS = NAVT_POPS + 1; return true; }

#[test]
fn nav_go_records_route_arg_and_fires_close() {
    reset();
    NAVT_CLOSES = 0;
    set_close_fn(navt_close);
    go("workspace", arg: "/tmp/proj");
    assert pending() == intent_go();
    assert target() == "workspace";
    assert arg() == "/tmp/proj";
    assert NAVT_CLOSES == 1;
    // take consumes the intent; target/arg stay readable for resolution.
    assert take() == intent_go();
    assert pending() == intent_none();
    assert target() == "workspace";
    assert arg() == "/tmp/proj";
    clear_hooks();
}

#[test]
fn nav_go_carries_named_params() {
    reset();
    NAVT_CLOSES = 0;
    set_close_fn(navt_close);
    var p: Params = params_new();
    let _a: status::Status = p.insert(text::from_str("path"), text::from_str("/tmp/proj"));
    let _b: status::Status = p.insert(text::from_str("mode"), text::from_str("edit"));
    go("workspace", params: p);
    assert target() == "workspace";
    assert param("path") == "/tmp/proj";
    assert param("mode") == "edit";
    assert has_param("path");
    // absent reads "" rather than trapping, the way arg() always has
    assert param("nope") == "";
    assert !has_param("nope");
    assert NAVT_CLOSES == 1;
    clear_hooks();
}

#[test]
fn nav_arg_is_a_param_under_a_reserved_key() {
    // ONE storage: the unnamed argument is a named one, so the two readers
    // cannot disagree about what the route was given.
    reset();
    set_close_fn(navt_close);
    go("workspace", arg: "/tmp/proj");
    assert arg() == "/tmp/proj";
    assert param(arg_key()) == "/tmp/proj";
    assert has_param(arg_key());
    clear_hooks();
}

#[test]
fn nav_go_takes_arg_and_params_together() {
    reset();
    set_close_fn(navt_close);
    var p: Params = params_new();
    let _a: status::Status = p.insert(text::from_str("path"), text::from_str("/tmp/proj"));
    go("workspace", arg: "legacy", params: p);
    assert arg() == "legacy";
    assert param("path") == "/tmp/proj";
    clear_hooks();
}

#[test]
fn a_second_go_replaces_the_whole_param_set() {
    // Not a merge: a route is given what THIS navigation passed, never a
    // leftover from the screen before it.
    reset();
    set_close_fn(navt_close);
    var first: Params = params_new();
    let _a: status::Status = first.insert(text::from_str("path"), text::from_str("/one"));
    go("a", params: first);
    assert param("path") == "/one";

    var second: Params = params_new();
    let _b: status::Status = second.insert(text::from_str("mode"), text::from_str("edit"));
    go("b", params: second);
    assert param("mode") == "edit";
    assert param("path") == "";
    assert !has_param("path");

    // and a bare go clears them
    go("c");
    assert param("mode") == "";
    assert arg() == "";
    clear_hooks();
}

#[test]
fn nav_quit_wins_as_the_last_verb() {
    reset();
    NAVT_CLOSES = 0;
    set_close_fn(navt_close);
    go("workspace");
    quit();
    assert take() == intent_quit();
    assert NAVT_CLOSES == 2;
    clear_hooks();
}

#[test]
fn nav_push_pop_route_through_the_hooks() {
    reset();
    NAVT_PUSHES = 0;
    NAVT_POPS = 0;
    set_push_fn(navt_push);
    set_pop_fn(navt_pop);
    assert push("settings", arg: "tab2");
    assert push("unknown") == false;   // the hook adjudicates the route
    assert pop();
    assert NAVT_PUSHES == 2;
    assert NAVT_POPS == 1;
    clear_hooks();
}

#[test]
fn nav_verbs_without_an_app_are_inert() {
    reset();
    clear_hooks();
    // go/quit record but close nothing; push/pop report false (negative path).
    go("anywhere");
    assert pending() == intent_go();
    quit();
    assert pending() == intent_quit();
    assert push("x") == false;
    assert pop() == false;
    reset();
    assert pending() == intent_none();
    assert target() == "";
    assert arg() == "";
}

#[test]
fn nav_reset_seeds_the_initial_arg() {
    reset("first-arg");
    assert pending() == intent_none();
    assert arg() == "first-arg";
    reset();
    assert arg() == "";
}

#[test]
fn nav_set_arg_is_the_push_hook_channel() {
    reset("primary-arg");
    set_arg("pushed-arg");
    assert arg() == "pushed-arg";
    reset();
}

// ---- push: the key, the shape, and the staged arguments ------------------------

fn navt_depth() -> usize { return NAVT_DEPTH; }

// A pop that models a real stack: it shortens, and it republishes what is now
// on top the way a backend does after a pop completes (programmatic or swiped).
fn navt_stack_pop() -> bool {
    if NAVT_DEPTH == (0 as usize) { return false; }
    NAVT_DEPTH = NAVT_DEPTH -% (1 as usize);
    if NAVT_DEPTH == (2 as usize) { set_top_route("b"); }
    if NAVT_DEPTH == (1 as usize) { set_top_route("a"); }
    if NAVT_DEPTH == (0 as usize) { set_top_route(""); }
    return true;
}

#[test]
fn a_pushed_window_is_keyed_by_route_and_arg() {
    // What makes two windows of one route different is the argument they were
    // pushed with, so the address derives from it rather than being invented.
    reset();
    set_push_fn(navt_push);
    assert push("settings");
    assert NAVT_LAST_KEY.view() == "settings";
    assert push("settings", arg: "front");
    assert NAVT_LAST_KEY.view() == "settings:front";
    // An explicit key wins over both.
    assert push("settings", key: "the-one", arg: "front");
    assert NAVT_LAST_KEY.view() == "the-one";
    clear_hooks();
}

#[test]
fn push_defaults_to_the_platforms_own_shape() {
    // ONE INTENT: an app that says nothing gets a peer window where there is
    // room and a stack push where there is not. Saying `Screen` narrows it to
    // a drill-down, which is the same everywhere.
    reset();
    set_push_fn(navt_push);
    assert push("settings");
    assert NAVT_LAST_SHOW == show_code(Show::Window);
    assert push("settings", show: Show::Screen);
    assert NAVT_LAST_SHOW == show_code(Show::Screen);
    // The code survives the round trip through the hook channel.
    assert match show_of_code(1 as u32) { Show::Screen => true, Show::Window => false };
    assert match show_of_code(0 as u32) { Show::Window => true, Show::Screen => false };
    clear_hooks();
}

#[test]
fn a_push_carries_named_params_as_well_as_its_arg() {
    reset();
    set_push_fn(navt_push);
    var p: Params = params_new();
    let _a: status::Status = p.insert(text::from_str("lens"), text::from_str("wide"));
    let _b: status::Status = p.insert(text::from_str("fps"), text::from_str("60"));
    assert push("settings", arg: "front", params: p);
    // Both halves land together — a pushed screen that saw its arg() and not
    // its param() would be the bug this staging exists to prevent.
    assert arg() == "front";
    assert param("lens") == "wide";
    assert param("fps") == "60";
    clear_hooks();
}

#[test]
fn a_failed_push_leaves_the_current_screens_arguments_untouched() {
    // THE INVARIANT the staging exists for. The hook adjudicates the route, so
    // only it knows whether the push happened; a push that never resolves must
    // not have overwritten what the screen already had.
    reset();
    set_push_fn(navt_push);
    var first: Params = params_new();
    let _a: status::Status = first.insert(text::from_str("lens"), text::from_str("wide"));
    assert push("settings", arg: "front", params: first);
    assert arg() == "front";
    assert param("lens") == "wide";

    var doomed: Params = params_new();
    let _b: status::Status = doomed.insert(text::from_str("lens"), text::from_str("tele"));
    assert push("nowhere", arg: "back", params: doomed) == false;
    assert arg() == "front";          // unchanged
    assert param("lens") == "wide";   // unchanged
    clear_hooks();
}

#[test]
fn depth_is_zero_without_a_stack_and_a_back_button_can_ask() {
    reset();
    assert depth() == (0 as usize);
    assert can_pop() == false;
    set_depth_fn(navt_depth);
    NAVT_DEPTH = 2 as usize;
    assert depth() == (2 as usize);
    assert can_pop();
    NAVT_DEPTH = 0 as usize;
    assert can_pop() == false;
    clear_hooks();
    // and the hooks going away takes the answer back to the neutral one
    NAVT_DEPTH = 5 as usize;
    assert depth() == (0 as usize);
}

// The stack is "a", "b", "c" bottom to top, however deep NAVT_DEPTH says.
fn navt_route_at(d: usize) -> str {
    if d == (3 as usize) { return "c"; }
    if d == (2 as usize) { return "b"; }
    if d == (1 as usize) { return "a"; }
    return "";
}

// LOOKS BEFORE IT MOVES, which is the whole contract this hook exists for.
fn navt_pop_to(route: str) -> bool {
    var d: usize = NAVT_DEPTH;
    var found: bool = false;
    while d > (0 as usize) {
        if navt_route_at(d) == route { found = true; }
        d = d -% (1 as usize);
    }
    if !found { return false; }
    loop {
        if NAVT_DEPTH == (0 as usize) { return false; }
        if navt_route_at(NAVT_DEPTH) == route { set_top_route(route); return true; }
        if !navt_stack_pop() { return false; }
    }
}

#[test]
fn pop_to_unwinds_to_a_named_screen_and_refuses_one_that_is_not_there() {
    reset();
    set_depth_fn(navt_depth);
    set_pop_fn(navt_stack_pop);
    set_pop_to_fn(navt_pop_to);

    // a, b, c on the stack with c on top
    NAVT_DEPTH = 3 as usize;
    set_top_route("c");
    assert top_route() == "c";
    assert pop_to("a");
    assert top_route() == "a";
    assert depth() == (1 as usize);

    // A route that is not on the stack moves NOTHING — not one pop. The
    // speculative version destroyed the stack to discover this.
    NAVT_DEPTH = 3 as usize;
    set_top_route("c");
    assert pop_to("nowhere") == false;
    assert depth() == (3 as usize);
    assert top_route() == "c";

    // Already on top is success with nothing moved.
    NAVT_DEPTH = 2 as usize;
    set_top_route("b");
    assert pop_to("b");
    assert depth() == (2 as usize);
    clear_hooks();
    // and with no stack owner registered it is false, never a trap
    assert pop_to("a") == false;
}

#[test]
fn pop_is_stack_only_and_reports_an_empty_stack() {
    // The answer each backend turns into its platform's own behaviour: Android
    // falls through to super.onBackPressed(), iOS does nothing. `pop` never
    // closes a window — a peer window is closed by name, not popped.
    reset();
    set_depth_fn(navt_depth);
    set_pop_fn(navt_stack_pop);
    NAVT_DEPTH = 0 as usize;
    assert pop() == false;
    assert can_pop() == false;
    clear_hooks();
}

// ---- a key survives a round trip ------------------------------------------------

#[test]
fn a_key_splits_back_into_the_route_and_arg_it_was_built_from() {
    // THE PAIR HAS TO AGREE. `key_for` writes the name a window is opened
    // under; `route_of_key` / `arg_of_key` read it back when a platform hands
    // the key back and nothing else — iPadOS restoring a scene session across a
    // launch. A disagreement here is a restored window showing the wrong screen
    // or none, and neither says anything at the time.
    let k1: text::Text = key_for("camera", "", "front");
    assert k1.view() == "camera:front";
    assert route_of_key(k1.view()) == "camera";
    assert arg_of_key(k1.view()) == "front";

    // No argument: the key IS the route and there is nothing to recover.
    let k2: text::Text = key_for("settings", "", "");
    assert k2.view() == "settings";
    assert route_of_key(k2.view()) == "settings";
    assert arg_of_key(k2.view()) == "";
}

#[test]
fn an_explicit_key_is_not_recoverable_and_that_is_the_point() {
    // An override was never built from a route, so there is nothing in it to
    // find. `route_of_key` answers the whole key, which will not resolve — and
    // the caller's contract is to REFUSE the window rather than guess, because
    // a window showing the wrong screen is worse than one that never opened.
    let k: text::Text = key_for("camera", "the-one", "front");
    assert k.view() == "the-one";
    assert route_of_key(k.view()) == "the-one";
    assert arg_of_key(k.view()) == "";
}

#[test]
fn an_empty_route_is_refused_and_never_names_a_window() {
    // THE WRITE SIDE of the pair above, which was pinned only on the read side.
    // `key_for` synthesises the key from the route when the caller gave none,
    // so an empty route is the one input that yields an EMPTY key — and a key
    // travels to the platform as a window's name. On iPadOS it becomes an
    // `NSUserActivity` type, and `-[NSUserActivity initWithActivityType:]`
    // RAISES on an empty string, which aborts the app. Measured 2026-09-08:
    // `FacetUIKitTests` died in `-[UAUserActivity initWithTypeIdentifier:...]`.
    assert key_for("", "", "").view() == "";
    reset();
    NAVT_PUSHES = 0;
    set_push_fn(navt_push);
    // Refused ABOVE the hook: the count is the proof, because it means no
    // backend was ever handed the empty key. A hook that merely answered false
    // would leave the count at 1 and the platform call already made.
    assert push("") == false;
    assert NAVT_PUSHES == 0;
    // Not the machinery being cold — the same hook accepts a named route.
    assert push("settings") == true;
    assert NAVT_PUSHES == 1;
    // An explicit key cannot smuggle an empty route past it either.
    assert push("", key: "settings") == false;
    assert NAVT_PUSHES == 1;
    clear_hooks();
}

#[test]
fn key_splitting_negatives_never_trap() {
    // Every degenerate shape a key can arrive in, including from a persisted
    // session written by an older build of the app.
    assert route_of_key("") == "";
    assert arg_of_key("") == "";
    // A leading colon: no route. The caller refuses, which is right.
    assert route_of_key(":front") == "";
    assert arg_of_key(":front") == "front";
    // A trailing colon: a route and an empty argument.
    assert route_of_key("camera:") == "camera";
    assert arg_of_key("camera:") == "";
    // TWO colons split at the FIRST, so an argument may contain one — a path,
    // a URL, a timestamp. `key_for` does not escape and does not need to.
    assert route_of_key("open:file:///tmp/a") == "open";
    assert arg_of_key("open:file:///tmp/a") == "file:///tmp/a";
    // And that shape round-trips, which is the case that would have bitten.
    let k: text::Text = key_for("open", "", "file:///tmp/a");
    assert route_of_key(k.view()) == "open";
    assert arg_of_key(k.view()) == "file:///tmp/a";
}
