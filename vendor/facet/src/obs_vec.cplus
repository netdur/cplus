// ObsVec[T] — a Vec that says when it changed.
//
// THE POINT IS THAT THE APPLICATION TELLS THE LIST NOTHING. `relist` is handed
// the collection and a row builder; the app appends, edits and removes through
// the ordinary verbs, and the list learns about it because the collection
// carries a change signal it subscribed to. There is no `set_count`, no
// `invalidate_row`, no `splice` on the element — the one that exists on `list`
// is the application repeating itself, and the repetition is where the two
// drift apart.
//
// It OWNS its `Vec[T]` rather than borrowing one, for the same reason `tree`
// owns its model: a collection the application also holds a second handle to is
// a collection that can change without the signal firing, which is the whole
// bug this is built to prevent.
//
// WHAT THE SIGNAL CARRIES is `Change` — a kind, a position and a run length —
// rather than a bare "something happened". A list that knows a single row was
// inserted at 40 can keep every measurement above it and every vended cell;
// one that only knows "changed" must reload, which re-measures the whole model.
// The backend already has both paths (`apply_splice` against `reloadData`), so
// answering precisely costs three fields and buys the difference between them.
//
// `Reload` is always a legal answer. Anything that cannot describe itself
// precisely says so and takes the slow path — the same contract
// `row_height_of` makes by answering 0.

import "stdlib/vec" as vec;
import "stdlib/option" as option;
import "stdlib/status" as status;
import "events/events" as events;
import "stdlib/text" as text;

// WHAT happened. A position and a run length mean different things per kind,
// and `Reload` ignores both.
enum ChangeKind {
    // The whole sequence is new. `at` and `count` mean nothing.
    Reload,
    // `count` rows appeared at `at`; everything from `at` on moved down.
    Inserted,
    // `count` rows went away at `at`; everything after moved up.
    Removed,
    // `count` rows at `at` hold different values. The sequence did not move,
    // so nothing above or below needs re-measuring.
    Changed,
}

// One change, as the collection describes it to whoever is listening.
//
// A PLAIN COPY STRUCT on purpose: `Signal[T]::emit` takes its payload by value
// and hands the same value to every listener, so a change that owned anything
// would have to be cloned per listener or moved to exactly one of them.
struct Change {
    kind: ChangeKind,
    at: usize,
    count: usize,
}

impl Change {
    fn reload() -> Change {
        return Change { kind: ChangeKind::Reload, at: 0 as usize, count: 0 as usize };
    }
}

struct ObsVec[T] {
    _v: vec::Vec[T],
    // PUBLIC BY NAME, private by convention like every other `_` field: the
    // list subscribes with `obs.changed.on(...)`, which is `events`' own idiom
    // and keeps the subscription an RAII handle the subscriber owns.
    //
    // Not `_changed`, because `_` is PRIVACY in this language and a subscriber
    // in another module could not reach it.
    changed: events::Signal[Change],
}

impl ObsVec[T] {
    fn new() -> ObsVec[T] {
        return ObsVec[T] { _v: vec::new::[T](), changed: events::Signal[Change]::new() };
    }

    // ---- reads, forwarded unchanged ------------------------------------------
    //
    // No signal: a read cannot change anything, and a `ref this` read that
    // emitted would re-enter the list from inside its own row builder.

    fn count(ref this) -> usize { return this._v.count(); }

    fn at(ref this, index: usize) -> option::Option[T] { return this._v.at(index); }

    fn at_ptr(ref this, index: usize) -> option::Option[*T] { return this._v.at_ptr(index); }

    fn is_empty(ref this) -> bool { return this._v.count() == (0 as usize); }

    // The Vec underneath, for a caller that needs a verb this does not forward.
    //
    // READ-ONLY BY INTENT and not by enforcement — there is no way to say that
    // here. Writing through this pointer changes the collection without firing
    // the signal, which is exactly the drift `ObsVec` exists to prevent, so a
    // caller that writes through it owes the collection a `note_reload()`.
    fn as_vec_ptr(ref this) -> *vec::Vec[T] { return #addr_of(this._v); }

    // ---- writes, each of which says what it did ------------------------------
    //
    // The signal fires AFTER the write lands, so a listener that reads the
    // collection back sees the state the change describes. Firing before would
    // hand the list a position that does not exist yet.

    fn append(ref this, take value: T) -> status::Status {
        let at: usize = this._v.count();
        let s: status::Status = this._v.append(value);
        // A FAILED WRITE IS NOT A CHANGE. `append` answers a Status because
        // growth can fail, and emitting anyway would tell the list about a row
        // that is not there — which it would then ask the builder for.
        match s {
            status::Status::Ok => {
                this.changed.emit(Change { kind: ChangeKind::Inserted,
                                           at: at, count: 1 as usize });
            }
            _other => { }
        }
        return s;
    }

    fn insert(ref this, take value: T, at: usize) -> status::Status {
        let s: status::Status = this._v.insert(value, at: at);
        match s {
            status::Status::Ok => {
                this.changed.emit(Change { kind: ChangeKind::Inserted,
                                           at: at, count: 1 as usize });
            }
            _other => { }
        }
        return s;
    }

    fn remove(ref this, at: usize) -> option::Option[T] {
        // ASK THE COUNT, NOT THE OPTION. This used to be
        // `match gone { Some(_v) => emit }`, which MOVES the payload out of
        // the option to bind it — so the arm's binding dropped the element and
        // the caller dropped it again. For an element with a destructor that
        // is a double free: `EXC_BREAKPOINT` in `mfm_free` under `Text::drop`,
        // found by the first real app to hold anything but an integer, because
        // every test here used `ObsVec[i32]` and a Copy element cannot show it.
        //
        // The count answers the same question — did a row go away — without
        // touching what came back.
        let before: usize = this._v.count();
        let gone: option::Option[T] = this._v.remove(at);
        if this._v.count() < before {
            this.changed.emit(Change { kind: ChangeKind::Removed,
                                       at: at, count: 1 as usize });
        }
        return gone;
    }

    // A row REPLACED in place. The sequence did not move, so this is the one
    // write that costs a single row rather than everything below it.
    fn set(ref this, take value: T, at: usize) -> status::Status {
        let s: status::Status = this._v.set(value, at: at);
        match s {
            status::Status::Ok => {
                this.changed.emit(Change { kind: ChangeKind::Changed,
                                           at: at, count: 1 as usize });
            }
            _other => { }
        }
        return s;
    }

    fn remove_all(ref this) {
        this._v.remove_all();
        this.changed.emit(Change::reload());
    }

    // ---- saying so by hand ---------------------------------------------------

    // "I changed row `at` through a pointer." The escape hatch for an app that
    // edits an entry in place via `at_ptr` — which is the ordinary way to touch
    // one field of a row without copying the whole entry out and back.
    fn note_changed(ref this, at: usize, count: usize = 1 as usize) {
        this.changed.emit(Change { kind: ChangeKind::Changed, at: at, count: count });
    }

    // "I changed something and cannot describe it." Always legal, always
    // correct, and always the slow path.
    fn note_reload(ref this) {
        this.changed.emit(Change::reload());
    }
}

// ───────────────────────────── tests ─────────────────────────────

struct _Seen {
    n: i64,
    last_kind: i64,
    last_at: usize,
    last_count: usize,
}

static SEEN: _Seen = _Seen { n: 0 as i64, last_kind: -1 as i64,
                             last_at: 0 as usize, last_count: 0 as usize };

fn _kind_num(k: ChangeKind) -> i64 {
    return match k {
        ChangeKind::Reload => 0 as i64,
        ChangeKind::Inserted => 1 as i64,
        ChangeKind::Removed => 2 as i64,
        ChangeKind::Changed => 3 as i64,
    };
}

fn _watch(c: Change, ctx: *u8) {
    SEEN.n = SEEN.n + (1 as i64);
    SEEN.last_kind = _kind_num(c.kind);
    SEEN.last_at = c.at;
    SEEN.last_count = c.count;
    return;
}

fn _reset() {
    SEEN.n = 0 as i64;
    SEEN.last_kind = -1 as i64;
    SEEN.last_at = 0 as usize;
    SEEN.last_count = 0 as usize;
    return;
}

#[test]
fn an_append_says_where_the_row_landed() {
    // The whole point of carrying a position: a list told "one row appeared at
    // 2" keeps every measurement above it. Told only "something changed", it
    // re-measures the model.
    _reset();
    var o: ObsVec[i32] = ObsVec[i32]::new();
    let _s: events::SignalSubscription[Change] = o.changed.on(_watch);
    let _a: status::Status = o.append(10);
    let _b: status::Status = o.append(20);
    let _c: status::Status = o.append(30);
    assert SEEN.n == (3 as i64);
    assert SEEN.last_kind == (1 as i64);          // Inserted
    assert SEEN.last_at == (2 as usize);          // ...at the end, which was 2
    assert SEEN.last_count == (1 as usize);
    assert o.count() == (3 as usize);
}

#[test]
fn an_insert_and_a_remove_name_the_same_position() {
    _reset();
    var o: ObsVec[i32] = ObsVec[i32]::new();
    let _a: status::Status = o.append(1);
    let _b: status::Status = o.append(3);
    let _s: events::SignalSubscription[Change] = o.changed.on(_watch);

    let _i: status::Status = o.insert(2, at: 1 as usize);
    assert SEEN.last_kind == (1 as i64);
    assert SEEN.last_at == (1 as usize);
    assert o.count() == (3 as usize);

    let _r: option::Option[i32] = o.remove(1 as usize);
    assert SEEN.last_kind == (2 as i64);          // Removed
    assert SEEN.last_at == (1 as usize);
    assert o.count() == (2 as usize);
}

#[test]
fn a_replacement_is_not_a_move() {
    // `Changed` is the one write that costs a single row: the sequence did not
    // move, so nothing above or below needs re-measuring. A `set` that reported
    // `Inserted` would make every list below it re-measure for nothing.
    _reset();
    var o: ObsVec[i32] = ObsVec[i32]::new();
    let _a: status::Status = o.append(1);
    let _b: status::Status = o.append(2);
    let _s: events::SignalSubscription[Change] = o.changed.on(_watch);
    let _t: status::Status = o.set(99, at: 0 as usize);
    assert SEEN.last_kind == (3 as i64);          // Changed, not Inserted
    assert SEEN.last_at == (0 as usize);
    assert o.count() == (2 as usize);             // ...and the count did not move
}

#[test]
fn clearing_is_a_reload_because_it_cannot_be_anything_else() {
    _reset();
    var o: ObsVec[i32] = ObsVec[i32]::new();
    let _a: status::Status = o.append(1);
    let _b: status::Status = o.append(2);
    let _s: events::SignalSubscription[Change] = o.changed.on(_watch);
    o.remove_all();
    assert SEEN.last_kind == (0 as i64);          // Reload
    assert o.is_empty();
}

#[test]
fn a_write_that_did_not_land_is_not_a_change() {
    // THE NEGATIVE HALF THAT MATTERS. `remove` answers None for an index that
    // is not there, and emitting anyway would tell the list a row went away
    // that never existed — it would then splice a row out of a sequence that
    // still has it, and every row below would show its neighbour's data.
    _reset();
    var o: ObsVec[i32] = ObsVec[i32]::new();
    let _a: status::Status = o.append(1);
    let _s: events::SignalSubscription[Change] = o.changed.on(_watch);
    let gone: option::Option[i32] = o.remove(7 as usize);
    match gone {
        option::Option[i32]::Some(_v) => { assert false; }
        option::Option[i32]::None => { }
    }
    assert SEEN.n == (0 as i64);                  // nothing was emitted
    assert o.count() == (1 as usize);
}

#[test]
fn a_read_never_emits() {
    // A `ref this` read that emitted would re-enter the list from inside its
    // own row builder — the builder reads the collection, the read fires the
    // signal, the signal reloads the list, and the reload calls the builder.
    _reset();
    var o: ObsVec[i32] = ObsVec[i32]::new();
    let _a: status::Status = o.append(1);
    let _s: events::SignalSubscription[Change] = o.changed.on(_watch);
    let _c: usize = o.count();
    let _v: option::Option[i32] = o.at(0 as usize);
    let _p: option::Option[*i32] = o.at_ptr(0 as usize);
    let _e: bool = o.is_empty();
    assert SEEN.n == (0 as i64);
}

#[test]
fn an_edit_through_a_pointer_is_announced_by_hand() {
    // `at_ptr` is the ordinary way to touch one field without copying the entry
    // out and back, and nothing can observe it — so the collection cannot
    // announce it and the app owes it `note_changed`. The escape hatch is
    // named rather than pretended away.
    _reset();
    var o: ObsVec[i32] = ObsVec[i32]::new();
    let _a: status::Status = o.append(1);
    let _s: events::SignalSubscription[Change] = o.changed.on(_watch);
    match o.at_ptr(0 as usize) {
        option::Option[*i32]::Some(p) => { { (*p) = 42 }; }
        option::Option[*i32]::None => { assert false; }
    }
    assert SEEN.n == (0 as i64);                  // the write was invisible...
    o.note_changed(0 as usize);
    assert SEEN.n == (1 as i64);                  // ...until it was said
    assert SEEN.last_kind == (3 as i64);
}

#[test]
fn a_collection_with_no_listener_still_works() {
    // The negative half of the signal itself: `relist` subscribes, but an
    // ObsVec used as a plain collection must not depend on anyone listening.
    var o: ObsVec[i32] = ObsVec[i32]::new();
    let _a: status::Status = o.append(1);
    let _b: status::Status = o.append(2);
    assert o.count() == (2 as usize);
    match o.at(1 as usize) {
        option::Option[i32]::Some(v) => { assert v == 2; }
        option::Option[i32]::None => { assert false; }
    }
}

#[test]
fn removing_an_element_that_OWNS_something_frees_it_once() {
    // REDUCED FROM A CRASH in a real app: `EXC_BREAKPOINT` in `mfm_free`, via
    // `Text::drop` under `ObsVec::remove`. Every test above uses `ObsVec[i32]`,
    // which is Copy and has no destructor — so a double free was invisible to
    // all of them. The first element type with a destructor found it in
    // seconds.
    _reset();
    var o: ObsVec[text::Text] = ObsVec[text::Text]::new();
    let _a: status::Status = o.append("alpha".to_text());
    let _b: status::Status = o.append("beta".to_text());
    let _s: events::SignalSubscription[Change] = o.changed.on(_watch);

    let gone: option::Option[text::Text] = o.remove(0 as usize);
    match gone {
        option::Option[text::Text]::Some(t) => { assert t.view() == "alpha"; }
        option::Option[text::Text]::None => { assert false; }
    }
    assert o.count() == (1 as usize);
    assert SEEN.last_kind == (2 as i64);
}
