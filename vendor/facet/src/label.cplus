    fn end_updates(this) -> Label { core::end_updates(this._p); return this; }
    fn on_focus(this, f: fn(*u8, *u8), ctx: *u8 = 0 as *u8) -> Label { core::set_on_focus(this._p, f, ctx); return this; }
    fn on_blur(this, f: fn(*u8, *u8), ctx: *u8 = 0 as *u8) -> Label { core::set_on_blur(this._p, f, ctx); return this; }
    fn on_attach(this, f: fn(*u8, *u8), ctx: *u8 = 0 as *u8) -> Label { core::set_on_attach(this._p, f, ctx); return this; }
    fn on_detach(this, f: fn(*u8, *u8), ctx: *u8 = 0 as *u8) -> Label { core::set_on_detach(this._p, f, ctx); return this; }
    fn frame(this) -> core::Frame { return core::frame_of(this._p); }
}

// ---- lookup ------------------------------------------------------------
// `from` narrows a node to this control, the DOM step: a node carries what
// EVERY node has, and a checked cast adds what only a label has. `None` on
// a wrong kind — never a cursor whose every verb silently does nothing.

fn from(p: *core::Node) -> option::Option[Label] {
    if p == (0 as *core::Node) { return option::Option[Label]::None; }
    let d: *core::Data = { (*p).data() };
    if d == (0 as *core::Data) { return option::Option[Label]::None; }
    if { (*d).kind } != props::K_LABEL { return option::Option[Label]::None; }
    return option::Option[Label]::Some(Label::_of(p));
}

// Resolve a key, then narrow through the same checked door.

// `within:` and not `in:` — `in` is a C+ keyword. Bare `find` is the
// DOM rule: the running app's windows in open order, first match wins;
// pass `within:` to scope a subtree (or disambiguate across windows).
fn find(key: str, within: *core::Node = 0 as *core::Node) -> option::Option[Label] {
    if within != (0 as *core::Node) {
        return match core::find_in(within, key) {
            option::Option[*core::Node]::Some(p) => { _report_kind(key, p); from(p) }
            option::Option[*core::Node]::None => option::Option[Label]::None,
        };
    }
    return match mount::find_node(key) {
        option::Option[*core::Node]::Some(p) => { _report_kind(key, p); from(p) }
        option::Option[*core::Node]::None => option::Option[Label]::None,
    };
}

// The debug posture's third distinction (FACET_DEBUG_FIND=1): the key
// RESOLVED, and `from` is about to answer None anyway because the node is
// another control. `_`-private; costs one flag read when the posture is off.
fn _report_kind(key: str, p: *core::Node) {
    if !mount::find_debugging() { return; }
    if p == (0 as *core::Node) { return; }
    let d: *core::Data = { (*p).data() };
    if d == (0 as *core::Data) || { (*d).kind } != props::K_LABEL {
        mount::debug_find_wrong_kind(key, "label");
    }
    return;
}
