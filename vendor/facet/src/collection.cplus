    // binds a list of lists and Stage 1 dropped it as MODEL, so the
    // imperative replacement follows `count` + `row`: how many groups,
    // how big each one is, and what its header looks like.
    //
    // `row` is UNCHANGED and that is the point — a group is a run of
    // the same flat sequence, so `row(i)` still means row `i` of the
    // whole and an application that groups an existing list adds a
    // description rather than rewriting one.
    fn set_group_count(this, v: usize) -> Collection {
        let p: *props::CollectionProps = this._props();
        if p == (0 as *props::CollectionProps) { return this; }
        { (*p).group_count = v as i64 };
        core::touch(this._p, P_GROUP_COUNT);
        return this;
    }

    fn group_count(this) -> usize {
        let p: *props::CollectionProps = this._props();
        if p == (0 as *props::CollectionProps) { return 0 as usize; }
        return { (*p).group_count } as usize;
    }

    // TWO CALLS, one per half, each with its own context slot.
    //
    // They were one call — `set_group(size:header:ctx:)` — on the
    // argument that naming half of a group is a description that cannot
    // render. That argument did not hold: `set_group_count` was always
    // its own call, so a half-named group was already reachable, and the
    // defaults answer it cleanly (no size means no rows, which renders as
    // an ungrouped sequence).
    //
    // What it cost was real. A bound method is a function AND a receiver,
    // and the receiver goes in the `*u8` IMMEDIATELY AFTER its handler —
    // so one shared slot meant only the handler adjacent to it could ever
    // be one. `header` bound, `size` did not, and which one was an
    // accident of parameter order. An application grouping a list had to
    // write half of one description as a component method and the other
    // half as a free function.
    //
    // The ledger separates them for a reason of its own: a group's SIZE
    // is intrinsic to the grouped ItemsSource (a group is a collection;
    // its count is its own), while the header is a GroupHeaderTemplate.
    // One is data and one is presentation. Bundling them into a single
    // call is what merged the two contexts in the first place.
    fn set_group_size(this, size: fn(usize, *u8) -> usize,
                      size_ctx: *u8 = 0 as *u8) -> Collection {
        let p: *props::CollectionProps = this._props();
        if p == (0 as *props::CollectionProps) { return this; }
        { (*p).group_size = size };
        { (*p).group_size_ctx = size_ctx };
        core::touch(this._p, P_GROUP);
        return this;
    }

    fn set_group_header(this, header: fn(usize, *u8) -> core::Node,
                        header_ctx: *u8 = 0 as *u8) -> Collection {
        let p: *props::CollectionProps = this._props();
        if p == (0 as *props::CollectionProps) { return this; }
        { (*p).group_header = header };
        { (*p).group_header_ctx = header_ctx };
        core::touch(this._p, P_GROUP);
        return this;
    }

    // How many rows group `at` holds. 0 until a size is named.
    fn group_size(this, at: usize) -> usize {
        let p: *props::CollectionProps = this._props();
        if p == (0 as *props::CollectionProps) { return 0 as usize; }
        let f: fn(usize, *u8) -> usize = { (*p).group_size };
        return f(at, { (*p).group_size_ctx });
    }

    // The header row for group `at`. Empty until one is named.
    fn build_group_header(this, at: usize) -> core::Node {
        let p: *props::CollectionProps = this._props();
        if p == (0 as *props::CollectionProps) { return flex::Node::new(); }
        let f: fn(usize, *u8) -> core::Node = { (*p).group_header };
        return f(at, { (*p).group_header_ctx });
    }

    // ---- the selection -------------------------------------------
    // `selection_mode` says whether a row CAN be picked; this says
    // which one was. The ledger carries SelectedItem and Stage 1 dropped it
    // as MODEL — "the selection is an index" — and then no index was
    // declared, so the switch had nothing to switch. -1 is none.
    fn set_selected_index(this, v: i64) -> Collection {
        let p: *props::CollectionProps = this._props();
        if p == (0 as *props::CollectionProps) { return this; }
        { (*p).selected_index = v };
        core::touch(this._p, P_SELECTED_INDEX);
        return this;
    }

    fn selected_index(this) -> i64 {
        let p: *props::CollectionProps = this._props();
        if p == (0 as *props::CollectionProps) { return -1 as i64; }
        return { (*p).selected_index };
    }

    // ---- what a completed reorder moved --------------------------
    // the ledger's ReorderCompleted mutates the bound ItemsSource and the
    // application reads the answer off its own data. facet's sequence
    // is a count plus a builder — the application's ORDER is its own
    // and the backend cannot touch it — so the move is reported here,
    // or the handler is a notification with nothing in it.
    //
    // READ-ONLY on purpose. Writing them would be describing a move
    // that did not happen; to reorder from code, reorder the data and
    // write `count` or `row`.
    fn reorder_from(this) -> i64 {
        let p: *props::CollectionProps = this._props();
        if p == (0 as *props::CollectionProps) { return -1 as i64; }
        return { (*p).reorder_from };
    }

    fn reorder_to(this) -> i64 {
        let p: *props::CollectionProps = this._props();
        if p == (0 as *props::CollectionProps) { return -1 as i64; }
        return { (*p).reorder_to };
    }

    // Build row `at`. Empty until set_row names a builder.
    fn build_row(this, at: usize) -> core::Node {
        let p: *props::CollectionProps = this._props();
        if p == (0 as *props::CollectionProps) { return flex::Node::new(); }
        let f: fn(usize, *u8) -> core::Node = { (*p).row };
        return f(at, { (*p).row_ctx });
    }

    // The flex node this cursor points at. The DOM division, and the
    // reason facet declares no layout verb of its own:
    //
    //   the control's own   b.set_title("Saving…")     this module
    //   the shared band     b.set_opacity(0.5)         facet.cplus, once
    //   layout              { (*b.node()).set_width(…) }  ALL of flex
    //
    // Reaching flex through the node rather than forwarding its ~40 verbs
    // onto 42 cursors is what keeps facet from growing a second layout
    // vocabulary that can disagree with the first.
    fn node(this) -> *core::Node { return this._p; }

    // --- the shared band: one-line forwards, no generic element type ---
    fn set_opacity(this, v: f64) -> Collection { core::set_opacity(this._p, v); return this; }
    fn opacity(this) -> f64 { return core::opacity(this._p); }
    fn set_background_color(this, v: vocab::Color) -> Collection { core::set_background_color(this._p, v); return this; }
    fn background_color(this) -> vocab::Color { return core::background_color(this._p); }
    fn set_background(this, v: vocab::Brush) -> Collection { core::set_background(this._p, v); return this; }
    fn background(this) -> vocab::Brush { return core::background(this._p); }
    fn set_background_image(this, v: str) -> Collection { core::set_background_image(this._p, v); return this; }
    fn background_image(this) -> str { return core::background_image(this._p); }
    fn set_safe_area(this, v: vocab::SafeArea) -> Collection { core::set_safe_area(this._p, v); return this; }
    fn safe_area(this) -> vocab::SafeArea { return core::safe_area(this._p); }
    fn set_shadow(this, v: vocab::Shadow) -> Collection { core::set_shadow(this._p, v); return this; }
    fn shadow(this) -> vocab::Shadow { return core::shadow(this._p); }
    fn set_clip(this, v: vocab::Shape) -> Collection { core::set_clip(this._p, v); return this; }
    fn clip(this) -> vocab::Shape { return core::clip(this._p); }
    fn set_enabled(this, v: bool) -> Collection { core::set_enabled(this._p, v); return this; }
    fn is_enabled(this) -> bool { return core::is_enabled(this._p); }
    fn set_visible(this, v: bool) -> Collection { core::set_visible(this._p, v); return this; }
    fn is_visible(this) -> bool { return core::is_visible(this._p); }
    fn set_display(this, v: flex::Display) -> Collection { core::set_display(this._p, v); return this; }
    fn display(this) -> flex::Display { return core::display_of(this._p); }
    fn set_shown(this, v: bool) -> Collection { core::set_shown(this._p, v); return this; }
    fn is_hidden(this) -> bool { return core::is_hidden(this._p); }
    fn set_input_transparent(this, v: bool) -> Collection { core::set_input_transparent(this._p, v); return this; }
    fn input_transparent(this) -> bool { return core::input_transparent(this._p); }
    fn set_flow_direction(this, v: vocab::FlowDirection) -> Collection { core::set_flow_direction(this._p, v); return this; }
    fn flow_direction(this) -> vocab::FlowDirection { return core::flow_direction(this._p); }
    fn set_agent(this, v: vocab::Agent) -> Collection { core::set_agent(this._p, v); return this; }
    fn agent(this) -> vocab::Agent { return core::agent(this._p); }
    fn set_rotation(this, v: f64) -> Collection { core::set_rotation(this._p, v); return this; }
    fn rotation(this) -> f64 { return core::rotation(this._p); }
    fn set_rotation_x(this, v: f64) -> Collection { core::set_rotation_x(this._p, v); return this; }
    fn rotation_x(this) -> f64 { return core::rotation_x(this._p); }
    fn set_rotation_y(this, v: f64) -> Collection { core::set_rotation_y(this._p, v); return this; }
    fn rotation_y(this) -> f64 { return core::rotation_y(this._p); }
    fn set_scale(this, v: f64) -> Collection { core::set_scale(this._p, v); return this; }
    fn scale(this) -> f64 { return core::scale(this._p); }
    fn set_scale_x(this, v: f64) -> Collection { core::set_scale_x(this._p, v); return this; }
    fn scale_x(this) -> f64 { return core::scale_x(this._p); }
    fn set_scale_y(this, v: f64) -> Collection { core::set_scale_y(this._p, v); return this; }
    fn scale_y(this) -> f64 { return core::scale_y(this._p); }
    fn set_translation_x(this, v: f64) -> Collection { core::set_translation_x(this._p, v); return this; }
    fn translation_x(this) -> f64 { return core::translation_x(this._p); }
    fn set_translation_y(this, v: f64) -> Collection { core::set_translation_y(this._p, v); return this; }
    fn translation_y(this) -> f64 { return core::translation_y(this._p); }
    fn set_anchor_x(this, v: f64) -> Collection { core::set_anchor_x(this._p, v); return this; }
    fn anchor_x(this) -> f64 { return core::anchor_x(this._p); }
    fn set_anchor_y(this, v: f64) -> Collection { core::set_anchor_y(this._p, v); return this; }
    fn anchor_y(this) -> f64 { return core::anchor_y(this._p); }
    fn set_z_index(this, v: i64) -> Collection { core::set_z_index(this._p, v); return this; }
    fn z_index(this) -> i64 { return core::z_index(this._p); }
    fn width(this) -> f64 { return core::width_of(this._p); }
    fn height(this) -> f64 { return core::height_of(this._p); }
    fn x(this) -> f64 { return core::x_of(this._p); }
    fn y(this) -> f64 { return core::y_of(this._p); }
    fn bounds(this) -> vocab::Rect { return core::bounds_of(this._p); }
    fn is_focused(this) -> bool { return core::is_focused(this._p); }
    fn is_attached(this) -> bool { return core::is_attached(this._p); }
    fn window(this) -> vocab::WindowRef { return core::window_of(this._p); }
    fn native(this) -> *u8 { return core::native(this._p); }
    fn child_count(this) -> usize { return core::child_count_of(this._p); }
    fn child(this, at: usize) -> option::Option[*core::Node] { return core::child_of(this._p, at); }
    fn set_grow(this, v: f64) -> Collection { core::set_grow(this._p, v); return this; }
    fn set_shrink(this, v: f64) -> Collection { core::set_shrink(this._p, v); return this; }
    fn set_width(this, v: f64) -> Collection { core::set_width(this._p, v); return this; }
    fn set_height(this, v: f64) -> Collection { core::set_height(this._p, v); return this; }
    fn set_width_percent(this, v: f64) -> Collection { core::set_width_percent(this._p, v); return this; }
    fn set_height_percent(this, v: f64) -> Collection { core::set_height_percent(this._p, v); return this; }
    fn set_padding(this, v: f64) -> Collection { core::set_padding(this._p, v); return this; }
    fn set_margin(this, v: f64) -> Collection { core::set_margin(this._p, v); return this; }
    fn set_padding_edge(this, edge: flex::Edge, v: f64) -> Collection { core::set_padding_edge(this._p, edge, v); return this; }
    fn set_margin_edge(this, edge: flex::Edge, v: f64) -> Collection { core::set_margin_edge(this._p, edge, v); return this; }
    fn set_gap(this, v: f64) -> Collection { core::set_gap(this._p, v); return this; }
    fn set_justify(this, v: flex::Justify) -> Collection { core::set_justify(this._p, v); return this; }
    fn set_align(this, v: flex::Align) -> Collection { core::set_align(this._p, v); return this; }
    fn set_wrap(this, v: flex::Wrap) -> Collection { core::set_wrap(this._p, v); return this; }
    fn focus(this) -> Collection { core::focus(this._p); return this; }
    fn blur(this) -> Collection { core::blur(this._p); return this; }
    fn animate_opacity(this, to: f64, duration: vocab::Duration = vocab::Duration::animation(), easing: vocab::Easing = vocab::Easing::SinInOut) -> Collection { core::animate_opacity(this._p, to, duration, easing); return this; }
    fn animate_scale(this, to: f64, duration: vocab::Duration = vocab::Duration::animation(), easing: vocab::Easing = vocab::Easing::SinInOut) -> Collection { core::animate_scale(this._p, to, duration, easing); return this; }
    fn animate_scale_x(this, to: f64, duration: vocab::Duration = vocab::Duration::animation(), easing: vocab::Easing = vocab::Easing::SinInOut) -> Collection { core::animate_scale_x(this._p, to, duration, easing); return this; }
    fn animate_scale_y(this, to: f64, duration: vocab::Duration = vocab::Duration::animation(), easing: vocab::Easing = vocab::Easing::SinInOut) -> Collection { core::animate_scale_y(this._p, to, duration, easing); return this; }
    fn animate_rotation(this, to: f64, duration: vocab::Duration = vocab::Duration::animation(), easing: vocab::Easing = vocab::Easing::SinInOut) -> Collection { core::animate_rotation(this._p, to, duration, easing); return this; }
    fn animate_rotation_x(this, to: f64, duration: vocab::Duration = vocab::Duration::animation(), easing: vocab::Easing = vocab::Easing::SinInOut) -> Collection { core::animate_rotation_x(this._p, to, duration, easing); return this; }
    fn animate_rotation_y(this, to: f64, duration: vocab::Duration = vocab::Duration::animation(), easing: vocab::Easing = vocab::Easing::SinInOut) -> Collection { core::animate_rotation_y(this._p, to, duration, easing); return this; }
    fn animate_translation(this, x: f64, y: f64, duration: vocab::Duration = vocab::Duration::animation(), easing: vocab::Easing = vocab::Easing::SinInOut) -> Collection { core::animate_translation(this._p, x, y, duration, easing); return this; }
    fn cancel_animations(this) -> Collection { core::cancel_animations(this._p); return this; }
    fn relayout(this) -> Collection { core::relayout(this._p); return this; }
    fn measure(this, width: f64, height: f64) -> vocab::Size { return core::measure(this._p, width, height); }
    fn begin_updates(this) -> Collection { core::begin_updates(this._p); return this; }
    fn end_updates(this) -> Collection { core::end_updates(this._p); return this; }
    fn on_focus(this, f: fn(*u8, *u8), ctx: *u8 = 0 as *u8) -> Collection { core::set_on_focus(this._p, f, ctx); return this; }
    fn on_blur(this, f: fn(*u8, *u8), ctx: *u8 = 0 as *u8) -> Collection { core::set_on_blur(this._p, f, ctx); return this; }
    fn on_attach(this, f: fn(*u8, *u8), ctx: *u8 = 0 as *u8) -> Collection { core::set_on_attach(this._p, f, ctx); return this; }
    fn on_detach(this, f: fn(*u8, *u8), ctx: *u8 = 0 as *u8) -> Collection { core::set_on_detach(this._p, f, ctx); return this; }
    fn frame(this) -> core::Frame { return core::frame_of(this._p); }
}

// ---- lookup ------------------------------------------------------------
// `from` narrows a node to this control, the DOM step: a node carries what
// EVERY node has, and a checked cast adds what only a collection has. `None` on
// a wrong kind — never a cursor whose every verb silently does nothing.

fn from(p: *core::Node) -> option::Option[Collection] {
    if p == (0 as *core::Node) { return option::Option[Collection]::None; }
    let d: *core::Data = { (*p).data() };
    if d == (0 as *core::Data) { return option::Option[Collection]::None; }
    if { (*d).kind } != props::K_COLLECTION { return option::Option[Collection]::None; }
    return option::Option[Collection]::Some(Collection::_of(p));
}

// Resolve a key, then narrow through the same checked door.

// `within:` and not `in:` — `in` is a C+ keyword. Bare `find` is the
// DOM rule: the running app's windows in open order, first match wins;
// pass `within:` to scope a subtree (or disambiguate across windows).
fn find(key: str, within: *core::Node = 0 as *core::Node) -> option::Option[Collection] {
    if within != (0 as *core::Node) {
        return match core::find_in(within, key) {
            option::Option[*core::Node]::Some(p) => { _report_kind(key, p); from(p) }
            option::Option[*core::Node]::None => option::Option[Collection]::None,
        };
    }
    return match mount::find_node(key) {
        option::Option[*core::Node]::Some(p) => { _report_kind(key, p); from(p) }
        option::Option[*core::Node]::None => option::Option[Collection]::None,
    };
}

// The debug posture's third distinction (FACET_DEBUG_FIND=1): the key
// RESOLVED, and `from` is about to answer None anyway because the node is
// another control. `_`-private; costs one flag read when the posture is off.
fn _report_kind(key: str, p: *core::Node) {
    if !mount::find_debugging() { return; }
    if p == (0 as *core::Node) { return; }
    let d: *core::Data = { (*p).data() };
    if d == (0 as *core::Data) || { (*d).kind } != props::K_COLLECTION {
        mount::debug_find_wrong_kind(key, "collection");
    }
    return;
}
