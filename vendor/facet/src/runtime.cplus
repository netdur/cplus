// facet runtime facade for the host platform.
//
// Keep this separate from facet.cplus so the core description model stays
// backend-neutral. On macOS the base module selects AppKit; Linux shadows this
// file with runtime_linux.cplus via the resolver's platform override.

import "./facet" as core;
import "facet_appkit/facet_appkit" as backend;

type Node = core::Node;
type Builder = core::Builder;
type AppMenu = core::AppMenu;
type MenuItem = core::MenuItem;

interface Window {
    fn root(ref this) -> Node;
    fn title(this) -> str;
    fn width(this) -> f64;
    fn height(this) -> f64;
    fn wants_clean_titlebar(this) -> bool;
    fn wants_close_button_only(this) -> bool;
    fn wants_unified_toolbar(this) -> bool;
    fn wants_hidden_title(this) -> bool;
    // Custom chrome: hide ALL standard window buttons + full-size content, so the
    // app draws its own titlebar controls (traffic lights via window_close /
    // window_minimize / window_zoom) and a window_drag surface.
    fn wants_custom_chrome(this) -> bool;
    // Native buttons: KEEP the standard window buttons visible under full-size
    // content + hidden transparent title, so a `window_buttons()` node can
    // re-parent the REAL traffic lights into a content toolbar (native zoom
    // toggle + green hover/tiling menu preserved). Distinct from custom_chrome.
    fn wants_native_buttons(this) -> bool;
    // Minimum window size floor (content size, points). 0 = no floor; a floor
    // applies only when BOTH are > 0. Stops the window shrinking below its usable
    // layout. Threaded to the backend's set_content_min_size.
    fn min_width(this) -> f64;
    fn min_height(this) -> f64;
    // Pinch zoom: let the end user magnify the window content with the trackpad
    // pinch gesture, browser-style — the content rewraps and re-renders crisp at
    // the new scale. min/max clamp the gesture's range (1.0 = natural size).
    fn wants_pinch_zoom(this) -> bool;
    fn min_zoom(this) -> f64;
    fn max_zoom(this) -> f64;
    fn has_app_menu(this) -> bool;
    fn app_menu(ref this) -> AppMenu;
    fn should_close(this) -> bool;
    fn will_close(this);
    fn should_close_callback(this) -> fn(*u8) -> bool;
    fn will_close_callback(this) -> fn(*u8);
    fn lifecycle_context(this) -> *u8;
    // Component address for the window's root mount slot. The keyed-direct verbs
    // resolve keys against a mounted slot's cp, so an app that wants to call
    // `facet::find(cp, key)` from its handlers supplies a stable address here
    // (typically `#addr_of(WORKSPACE) as *u8` for a module-static root component).
    // 0 keeps the runtime's internal key (find is then unreachable from app code).
    fn component_context(this) -> *u8;
}

fn label(s: str, size: f64 = 0.0f64, bold: bool = false, secondary: bool = false) -> Node {
    return core::label(s, size: size, bold: bold, secondary: secondary);
}

fn app_menu(title: str) -> AppMenu { return core::app_menu(title); }
fn menu_action_none() -> u32 { return core::menu_action_none(); }
fn menu_action_quit() -> u32 { return core::menu_action_quit(); }
fn menu_action_close_window() -> u32 { return core::menu_action_close_window(); }

fn run[W: Window](take window: W) {
    backend::install();   // register this backend's facet verbs (list, raise) before any render uses them
    var owned_window: W = window;
    let root: Node = owned_window.root();
    var app_menu: AppMenu = core::empty_app_menu();
    if owned_window.has_app_menu() {
        app_menu = owned_window.app_menu();
    }
    backend::run_window(
        root,
        title: owned_window.title(),
        width: owned_window.width(),
        height: owned_window.height(),
        clean_titlebar: owned_window.wants_clean_titlebar(),
        close_button_only: owned_window.wants_close_button_only(),
        unified_toolbar: owned_window.wants_unified_toolbar(),
        hide_title: owned_window.wants_hidden_title(),
        custom_chrome: owned_window.wants_custom_chrome(),
        native_buttons: owned_window.wants_native_buttons(),
        min_width: owned_window.min_width(),
        min_height: owned_window.min_height(),
        zoomable: owned_window.wants_pinch_zoom(),
        min_zoom: owned_window.min_zoom(),
        max_zoom: owned_window.max_zoom(),
        app_menu_enabled: owned_window.has_app_menu(),
        app_menu: app_menu,
        ctx: owned_window.lifecycle_context(),
        should_close: owned_window.should_close_callback(),
        will_close: owned_window.will_close_callback(),
        component_ctx: owned_window.component_context(),
    );
    return;
}

// A blocking modal alert. Returns the 0-based index of the clicked button
// (0 = `primary`, 1 = `secondary`).
fn alert(title: str, message: str, primary: str, secondary: str = "") -> i32 {
    return backend::alert(title, message, primary, secondary);
}

// Open a non-modal secondary window (settings / inspector / tool) with facet
// content, alongside the running app. Returns immediately.
fn present_window(take root: Node, title: str, width: f64, height: f64) {
    backend::present_window(root, title, width, height);
    return;
}

// Window-button actions for a custom titlebar — a control's handler calls these
// with its `sender` to drive the enclosing window (the button-driven equivalents
// of the standard traffic lights). Pair with a `wants_custom_chrome` window.
fn window_close(sender: *u8) { backend::window_close(sender); return; }
fn window_minimize(sender: *u8) { backend::window_minimize(sender); return; }
fn window_zoom(sender: *u8) { backend::window_zoom(sender); return; }
