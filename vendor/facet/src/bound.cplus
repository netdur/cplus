// facet — BOUND components.
//
// A bound component declares, AT THE NODE, that one property of one element is
// computed from its state. After that, writing a field updates the screen: the
// compiler's `#[watch]` write barrier calls `on_value`, `on_value` calls
// `changed`, and `changed` re-runs that component's thunks and pushes the
// values that actually moved.
//
//     #[watch]
//     struct Counter { n: i32, note: text::Text, busy: bool }
//
//     impl Counter {
//         // A thunk is an ORDINARY method. It computes one property; the
//         // `item` slot carries the node's `.item()` pointer for a per-item
//         // binding, and is ignored otherwise.
//         fn n_text(ref this, item: *u8) -> text::Text { return "count: ${this.n}"; }
//         fn busy_now(ref this, item: *u8) -> bool { return this.busy; }
//         // A handler writes state and NOTHING else. The label moves because of
//         // the binding, not because of a line in here.
//         fn inc(ref this, sender: *u8) { this.n = this.n + 1; return; }
//     }
//
//     impl Counter: facet::Component {
//         fn build(ref this) -> facet::Node {
//             return @facet {
//                 label("").key("n").bind_text(this.n_text)
//                 spinner().key("spinner").bind_shown(this.busy_now)
//                 button("+").on_click(this.inc)
//             };
//         }
//     }
//
//     impl Counter: bound::Bound {
//         // The required wiring, always this line.
//         fn on_value(ref this, field: str) { bound::changed(this); return; }
//     }
//
// Then `run_component(Counter { ... })` as usual. There is no `bind` call, no
// binding list, and no `Lifecycle` impl: `mount` registers each link against
// the view it just created, so a binding is made with the view in hand and
// cannot fail to resolve. The key is not in the update path at all — it stays
// what it is for, addressing (`find`, agents, MCP).
//
// ---- what this is ----------------------------------------------------------
// A declarative repaint list: five property sinks, a thunk each, and a cache of
// what was last pushed. `build` runs exactly once, the tree is retained, and an
// update is the same in-place native write a handler would have made by hand.
// All that moved is WHO makes it — a declaration at the node instead of a line
// in every handler.
//
// It is not reactive: no dependency graph, no recompute of anything larger than
// one property, no vdom, no diff of a tree. A thunk reads state and returns a
// value; it never reads another thunk's output. That depth-1 rule is the whole
// of what keeps this from being a graph, and it is not negotiable.
//
// A thunk computes a PROPERTY, never CHILDREN. Re-evaluating structure from a
// data comparison is reconciliation, which this framework does not do —
// collections stay `ui::list`, `add_child`, `switch_to`.
//
// It is ONE-WAY, state -> view. The element is a PROJECTION of the field:
// nothing reads it back, so a control's own edits arrive as handlers, as
// always. A handler that wants a field to track an input writes the field, and
// the binding closes the loop.
//
// ---- what a bound property costs you ---------------------------------------
// A bound property belongs to its binding. Every OTHER property of the same
// element stays hand-driven — `find("n").set_style(...)` alongside a bound
// `text` is fine, because the two never touch the same thing. What does not
// work is `find("n").set_text(...)` on a bound `text`: the element changes
// without telling the row, and the row's belief about the screen is now false
// in the "already correct" direction, so it suppresses its own correction. Call
// `invalidate(this)` if you have to do it.
//
// Opting in is per STRUCT, not per field: `#[watch]` is a struct attribute, so
// once it is on, every field write in that component runs one pass over its
// rows — including fields nothing is bound to.

import "./facet" as core;
import "stdlib/vec" as vec;
import "stdlib/text" as text;
import "stdlib/option" as option;

// ---- the conformance -------------------------------------------------------

// The bound tier. Additive to `facet::Component`: a bound component still
// implements `Component` for `build`, so nothing about the normal tier changes
// and a component is converted by ADDING — the attribute, this one method, and
// a `bind_*` modifier on whichever nodes you choose. Partial conversion is
// fine; bind two labels and leave the other six imperative.
//
// `on_value` is here rather than in the inherent impl on purpose. `#[watch]`
// looks the hook up by name on the type and does not care which impl block
// supplies it, so putting it in the conformance block makes the interlock
// two-sided: forget it and the interface reports a missing method (E0503) as
// well as `#[watch]` reporting a hookless struct (E0361). The reverse hole —
// a hook with no `#[watch]` — is `W0004`.
//
// Only the PLAIN hook shape is part of this contract. The snapshot shape
// (`old`/`new`) exists for coalescing a high-rate writer down to a repaint
// tick, which is a different job and carries a `Copy` + pointer-free
// restriction (E0363) that a component holding a `Text` cannot meet anyway.
// `suspend` / `resume` are this tier's answer to the same problem.
interface Bound {
    // The write barrier's landing point. Always `bound::changed(this);`.
    fn on_value(ref this, field: str);
}

// ---- the verbs -------------------------------------------------------------
// Each takes `ref c` and recovers the component's address itself — `ref` is a
// place at the component's real address, which IS its identity (`cp`), so a
// component never spells its own address. The `_at` forms in `facet` are for an
// erased callback that holds a bare `cp` and not the component.

// Re-run this component's thunks and push what moved. The body of every bound
// component's `on_value`, and the manual escape after a write the barrier does
// not see: a store INSIDE a field (`this.rows[i] = x`) or through a raw pointer
// does not fire `on_value`, so a component doing either calls `changed(this)`.
fn changed[C: Bound](ref c: C) {
    core::sync_bindings(#addr_of(c) as *u8);
    return;
}

// Forget what this component's rows believe is on screen, so the next sync
// repaints unconditionally. The escape after a direct write to a bound
// property.
fn invalidate[C](ref c: C) {
    core::invalidate_bindings(#addr_of(c) as *u8);
    return;
}

// Hold this component's pushes until `resume`. For a writer that touches a
// field in a loop: without it, a thousand iterations are a thousand native
// writes; with it, `resume` paints the net result once, and the caches make
// that exact.
fn suspend[C](ref c: C) {
    core::suspend_bindings(#addr_of(c) as *u8);
    return;
}

fn resume[C](ref c: C) {
    core::resume_bindings(#addr_of(c) as *u8);
    return;
}

// How many bindings are registered for this component. Diagnostic — and what a
// test asserts to prove registration happened at all, which is the one-line
// check that a component is really wired.
fn count[C](ref c: C) -> i64 {
    return core::binding_count(#addr_of(c) as *u8);
}

// ---- tests -----------------------------------------------------------------
// A recording stub backend stands in for a mounted tree. Views are fake
// pointers (1..N, never 0 — `Handle::found()` reads 0 as a miss); every mutator
// records what it received against the view it was given, and a push counter
// proves the change detection actually suppresses redundant writes.
//
// Registration is driven by calling `register_binds` directly rather than by
// running `mount`, which would need a whole `Renderer`. That `mount` really
// calls it is what the facet_appkit end-to-end tests hold.

static _PTEXT: vec::Vec[text::Text] = #zero::[vec::Vec[text::Text]]();
static _PNUM: vec::Vec[f64] = #zero::[vec::Vec[f64]]();
static _PON: vec::Vec[bool] = #zero::[vec::Vec[bool]]();
static _PHID: vec::Vec[bool] = #zero::[vec::Vec[bool]]();
static _PUSHES: i64 = 0 as i64;

// Slot i is the fake view `i + 1`.
fn _slots() -> usize { return 8 as usize; }
fn _view(i: i64) -> *u8 { return (i + (1 as i64)) as *u8; }
fn _slot(h: core::Handle) -> i64 { return (h.view() as i64) - (1 as i64); }

fn _probe_set_text(h: core::Handle, s: str) -> bool {
    let i: i64 = _slot(h);
    if i < (0 as i64) { return false; }
    let tr: *vec::Vec[text::Text] = #addr_of(_PTEXT);
    match (*tr).at_ptr(i as usize) {
        option::Option[*text::Text]::Some(tp) => {
            { (*tp).remove_all(); }
            { (*tp).append(s) };
        }
        option::Option[*text::Text]::None => { return false; }
    }
    _PUSHES = _PUSHES + (1 as i64);
    return true;
}

fn _probe_set_value(h: core::Handle, v: f64) -> bool {
    let i: i64 = _slot(h);
    if i < (0 as i64) { return false; }
    let nr: *vec::Vec[f64] = #addr_of(_PNUM);
    (*nr).set(v, i as usize);
    _PUSHES = _PUSHES + (1 as i64);
    return true;
}

fn _probe_set_on(h: core::Handle, v: bool) -> bool {
    let i: i64 = _slot(h);
    if i < (0 as i64) { return false; }
    let orr: *vec::Vec[bool] = #addr_of(_PON);
    (*orr).set(v, i as usize);
    _PUSHES = _PUSHES + (1 as i64);
    return true;
}

fn _probe_set_hidden(h: core::Handle, v: bool) -> bool {
    let i: i64 = _slot(h);
    if i < (0 as i64) { return false; }
    let hr: *vec::Vec[bool] = #addr_of(_PHID);
    (*hr).set(v, i as usize);
    _PUSHES = _PUSHES + (1 as i64);
    return true;
}

fn _text_at(i: i64) -> text::Text {
    let tr: *vec::Vec[text::Text] = #addr_of(_PTEXT);
    match (*tr).at_ptr(i as usize) {
        option::Option[*text::Text]::Some(tp) => { return { (*tp).clone() }; }
        option::Option[*text::Text]::None => { return text::from_str("<gone>"); }
    }
}

fn _num_at(i: i64) -> f64 {
    let nr: *vec::Vec[f64] = #addr_of(_PNUM);
    match (*nr).at_ptr(i as usize) {
        option::Option[*f64]::Some(p) => { return { *p }; }
        option::Option[*f64]::None => { return -1.0f64; }
    }
}

fn _on_at(i: i64) -> bool {
    let orr: *vec::Vec[bool] = #addr_of(_PON);
    match (*orr).at_ptr(i as usize) {
        option::Option[*bool]::Some(p) => { return { *p }; }
        option::Option[*bool]::None => { return false; }
    }
}

fn _hidden_at(i: i64) -> bool {
    let hr: *vec::Vec[bool] = #addr_of(_PHID);
    match (*hr).at_ptr(i as usize) {
        option::Option[*bool]::Some(p) => { return { *p }; }
        option::Option[*bool]::None => { return false; }
    }
}

fn _probe_install() {
    let tr: *vec::Vec[text::Text] = #addr_of(_PTEXT);
    (*tr).remove_all();
    let nr: *vec::Vec[f64] = #addr_of(_PNUM);
    (*nr).remove_all();
    let orr: *vec::Vec[bool] = #addr_of(_PON);
    (*orr).remove_all();
    let hr: *vec::Vec[bool] = #addr_of(_PHID);
    (*hr).remove_all();
    var i: usize = 0 as usize;
    while i < _slots() {
        (*tr).append(text::from_str(""));
        (*nr).append(0.0f64);
        (*orr).append(false);
        (*hr).append(false);
        i = i +% (1 as usize);
    }
    _PUSHES = 0 as i64;
    core::set_set_text_fn(_probe_set_text);
    core::set_set_value_fn(_probe_set_value);
    core::set_set_on_fn(_probe_set_on);
    core::set_set_hidden_fn(_probe_set_hidden);
    return;
}

fn _probe_remove() {
    core::set_set_text_fn(0 as fn(core::Handle, str) -> bool);
    core::set_set_value_fn(0 as fn(core::Handle, f64) -> bool);
    core::set_set_on_fn(0 as fn(core::Handle, bool) -> bool);
    core::set_set_hidden_fn(0 as fn(core::Handle, bool) -> bool);
    var i: i64 = 0 as i64;
    while i < (_slots() as i64) {
        core::forget_view_bindings(_view(i));
        i = i + (1 as i64);
    }
    return;
}

// A bound component that ALSO implements `facet::Component`, to hold the claim
// that the two conformances coexist on one struct: `build` lives in the
// `Component` block, `on_value` in the `Bound` block, and neither knows about
// the other.
#[watch]
struct _Probe {
    n: i32,
    total: i64,
    first: text::Text,
    last: text::Text,
    ratio: f64,
    busy: bool,
    ready: bool,
    checked: bool,
}

impl _Probe {
    fn fresh() -> _Probe {
        return _Probe {
            n: 0, total: 0 as i64,
            first: text::from_str("Ada"), last: text::from_str("Lovelace"),
            ratio: 0.0f64, busy: false, ready: true, checked: false,
        };
    }

    // Thunks. Ordinary methods — which is the point: each is a plain expression
    // over state, unit-testable on its own, and free to compute anything. The
    // old binding kinds could express none of these except by keeping a
    // pre-formatted field in sync by hand.
    fn n_text(ref this, item: *u8) -> text::Text { return "count: ${this.n}"; }
    fn total_text(ref this, item: *u8) -> text::Text { return "${this.total} items"; }
    fn full_name(ref this, item: *u8) -> text::Text {
        return "${this.first.view()} ${this.last.view()}";
    }
    fn ratio_now(ref this, item: *u8) -> f64 { return this.ratio; }
    fn busy_now(ref this, item: *u8) -> bool { return this.busy; }
    fn ready_now(ref this, item: *u8) -> bool { return this.ready; }
    fn checked_now(ref this, item: *u8) -> bool { return this.checked; }
    // A per-item thunk: the node's `.item()` pointer selects what to render, so
    // one method serves every cell.
    fn cell_text(ref this, item: *u8) -> text::Text {
        return "cell ${(item as i64) + this.n as i64}";
    }

    // An ordinary handler: it writes state and NOTHING else.
    fn inc(ref this, sender: *u8) { this.n = this.n + 1; return; }
}

impl _Probe: core::Component {
    fn build(ref this) -> core::Node {
        var b: core::Builder = core::Builder::new();
        b.add(core::label("").key("n").bind_text(this.n_text));
        return core::vstack(b);
    }
}

impl _Probe: Bound {
    fn on_value(ref this, field: str) { changed(this); return; }
}

// Register the component's bindings against fake views 1..7, one property per
// view, mirroring what `mount` does node by node.
fn _wire(ref p: _Probe) {
    var n0: core::Node = core::label("").bind_text(p.n_text);
    core::register_binds(#addr_of(n0), _view(0 as i64));
    var n1: core::Node = core::label("").bind_text(p.total_text);
    core::register_binds(#addr_of(n1), _view(1 as i64));
    var n2: core::Node = core::label("").bind_text(p.full_name);
    core::register_binds(#addr_of(n2), _view(2 as i64));
    var n3: core::Node = core::progress().bind_value(p.ratio_now);
    core::register_binds(#addr_of(n3), _view(3 as i64));
    var n4: core::Node = core::label("").bind_shown(p.busy_now);
    core::register_binds(#addr_of(n4), _view(4 as i64));
    var n5: core::Node = core::label("").bind_hidden(p.ready_now);
    core::register_binds(#addr_of(n5), _view(5 as i64));
    var n6: core::Node = core::toggle(label: "t").bind_on(p.checked_now);
    core::register_binds(#addr_of(n6), _view(6 as i64));
    // What the end of a real mount pass does: registration links the rows, the
    // first paint happens once the tree is whole.
    core::paint_new_bindings();
    return;
}

#[test]
fn bound_registration_paints_every_binding() {
    _probe_install();
    var p: _Probe = _Probe::fresh();
    _wire(p);
    assert count(p) == (7 as i64);
    // `build` mounted empty content; registration is what put real state on
    // screen, so a bound element never spells its value twice.
    assert _text_at(0 as i64).equals("count: 0");
    assert _text_at(1 as i64).equals("0 items");
    assert _text_at(2 as i64).equals("Ada Lovelace");
    assert _num_at(3 as i64) == 0.0f64;
    _probe_remove();
}

#[test]
fn bound_field_write_updates_the_element() {
    _probe_install();
    var p: _Probe = _Probe::fresh();
    _wire(p);
    p.n = 41;
    assert _text_at(0 as i64).equals("count: 41");
    p.n = p.n + 1;
    assert _text_at(0 as i64).equals("count: 42");
    _probe_remove();
}

#[test]
fn bound_handler_writing_state_only_still_updates() {
    // The point of the tier: `inc` touches no view code at all.
    _probe_install();
    var p: _Probe = _Probe::fresh();
    _wire(p);
    p.inc(0 as *u8);
    p.inc(0 as *u8);
    assert _text_at(0 as i64).equals("count: 2");
    _probe_remove();
}

#[test]
fn bound_thunk_computes_across_two_fields() {
    // What the old fixed kinds could not do: a property derived from more than
    // one field, with no derivation concept and no dependency graph — the thunk
    // is just an expression, re-run on demand.
    _probe_install();
    var p: _Probe = _Probe::fresh();
    _wire(p);
    p.first = text::from_str("Grace");
    assert _text_at(2 as i64).equals("Grace Lovelace");
    p.last = text::from_str("Hopper");
    assert _text_at(2 as i64).equals("Grace Hopper");
    _probe_remove();
}

#[test]
fn bound_write_pushes_only_the_property_that_moved() {
    _probe_install();
    var p: _Probe = _Probe::fresh();
    _wire(p);
    _PUSHES = 0 as i64;          // ignore the 7 priming pushes
    p.n = 5;
    // One write, one push — the other six thunks recomputed equal.
    assert _PUSHES == (1 as i64);
    _probe_remove();
}

#[test]
fn bound_rewriting_the_same_value_pushes_nothing() {
    _probe_install();
    var p: _Probe = _Probe::fresh();
    _wire(p);
    p.n = 5;
    _PUSHES = 0 as i64;
    p.n = 5;
    p.n = 5;
    assert _PUSHES == (0 as i64);
    assert _text_at(0 as i64).equals("count: 5");
    _probe_remove();
}

#[test]
fn bound_whole_struct_assign_pushes_only_the_movers() {
    // A whole-struct assign fires the barrier ONCE with field == "*". Because
    // the rows compare recomputed values rather than dispatching on the field
    // name, that single notification still lands on exactly what changed.
    _probe_install();
    var p: _Probe = _Probe::fresh();
    _wire(p);
    _PUSHES = 0 as i64;
    p = _Probe {
        n: 9, total: 0 as i64,
        first: text::from_str("Ada"), last: text::from_str("Lovelace"),
        ratio: 0.0f64, busy: false, ready: true, checked: false,
    };
    assert _PUSHES == (1 as i64);
    assert _text_at(0 as i64).equals("count: 9");
    _probe_remove();
}

#[test]
fn bound_value_and_bool_polarities() {
    _probe_install();
    var p: _Probe = _Probe::fresh();
    _wire(p);
    p.total = -17 as i64;
    assert _text_at(1 as i64).equals("-17 items");
    p.ratio = 0.75f64;
    assert _num_at(3 as i64) == 0.75f64;
    // `shown` inverts: busy == false -> hidden == true.
    assert _hidden_at(4 as i64);
    p.busy = true;
    assert !_hidden_at(4 as i64);
    // `hidden` does not invert: ready == true -> hidden == true.
    assert _hidden_at(5 as i64);
    p.ready = false;
    assert !_hidden_at(5 as i64);
    assert !_on_at(6 as i64);
    p.checked = true;
    assert _on_at(6 as i64);
    _probe_remove();
}

#[test]
fn bound_per_item_thunk_reads_the_node_item_pointer() {
    // One method, three cells: `.item()` is the second app-owned pointer that
    // handlers already use for per-row identity, and a thunk gets the same slot.
    _probe_install();
    var p: _Probe = _Probe::fresh();
    var a: core::Node = core::label("").bind_text(p.cell_text).item(10 as *u8);
    core::register_binds(#addr_of(a), _view(0 as i64));
    var b: core::Node = core::label("").bind_text(p.cell_text).item(20 as *u8);
    core::register_binds(#addr_of(b), _view(1 as i64));
    core::paint_new_bindings();
    assert _text_at(0 as i64).equals("cell 10");
    assert _text_at(1 as i64).equals("cell 20");
    p.n = 5;
    assert _text_at(0 as i64).equals("cell 15");
    assert _text_at(1 as i64).equals("cell 25");
    _probe_remove();
}

#[test]
fn bound_releasing_the_view_stops_every_push() {
    // The lifetime invariant: a row is dropped by the same call that releases
    // the view it paints, so it cannot outlive it.
    _probe_install();
    var p: _Probe = _Probe::fresh();
    _wire(p);
    core::forget_view_bindings(_view(0 as i64));
    assert count(p) == (6 as i64);
    _PUSHES = 0 as i64;
    p.n = 100;                          // barrier still fires; that row is gone
    assert _PUSHES == (0 as i64);
    assert _text_at(0 as i64).equals("count: 0");
    _probe_remove();
}

#[test]
fn bound_two_instances_paint_their_own_elements() {
    // Two components of the same type share the registry, so `cp` is what keeps
    // them apart — and because a row addresses a VIEW rather than a key, two
    // instances of one component type paint DIFFERENT elements. That is the
    // thing a global-key lookup could not express.
    _probe_install();
    var a: _Probe = _Probe::fresh();
    var b: _Probe = _Probe::fresh();
    var na: core::Node = core::label("").bind_text(a.n_text);
    core::register_binds(#addr_of(na), _view(0 as i64));
    var nb: core::Node = core::label("").bind_text(b.n_text);
    core::register_binds(#addr_of(nb), _view(1 as i64));
    core::paint_new_bindings();
    assert count(a) == (1 as i64);
    assert count(b) == (1 as i64);
    _PUSHES = 0 as i64;
    a.n = 11;
    assert _PUSHES == (1 as i64);       // only a's row pushed
    assert _text_at(0 as i64).equals("count: 11");
    assert _text_at(1 as i64).equals("count: 0");
    b.n = 22;
    assert _text_at(0 as i64).equals("count: 11");
    assert _text_at(1 as i64).equals("count: 22");
    _probe_remove();
}

#[test]
fn bound_manual_changed_covers_writes_the_barrier_misses() {
    // The barrier stops at whole-field stores, so a write INSIDE a field never
    // reaches `on_value`. `changed` is the documented escape.
    _probe_install();
    var p: _Probe = _Probe::fresh();
    _wire(p);
    let fp: *text::Text = #addr_of(p.first);
    { (*fp).remove_all(); }
    { (*fp).append("Radia") };
    assert _text_at(2 as i64).equals("Ada Lovelace");   // no barrier, no push
    changed(p);
    assert _text_at(2 as i64).equals("Radia Lovelace");
    _probe_remove();
}

#[test]
fn bound_invalidate_repaints_after_an_out_of_band_write() {
    // A direct write to a BOUND property leaves the row believing something
    // false, and a false belief in the "already correct" direction suppresses
    // its own correction. `invalidate` is the escape.
    _probe_install();
    var p: _Probe = _Probe::fresh();
    _wire(p);
    let _bogus: bool = _probe_set_text(core::Handle::of(_view(0 as i64), 0 as *u8, 0 as *u8, 0 as u32), "3");
    assert _text_at(0 as i64).equals("3");
    p.n = 0;                              // same value: the cache suppresses
    assert _text_at(0 as i64).equals("3");
    invalidate(p);
    changed(p);
    assert _text_at(0 as i64).equals("count: 0");
    _probe_remove();
}

#[test]
fn bound_suspend_coalesces_a_write_loop() {
    _probe_install();
    var p: _Probe = _Probe::fresh();
    _wire(p);
    _PUSHES = 0 as i64;
    suspend(p);
    var i: i32 = 0;
    while i < 100 {
        p.n = i;
        i = i + 1;
    }
    assert _PUSHES == (0 as i64);         // held
    resume(p);
    assert _PUSHES == (1 as i64);         // one push for the net result
    assert _text_at(0 as i64).equals("count: 99");
    _probe_remove();
}

#[test]
fn bound_conflict_check_counts_a_direct_write_to_a_bound_property() {
    // The rule "a bound property belongs to its binding" is otherwise
    // invisible. With the check on, the registry reports the collision.
    _probe_install();
    core::set_binding_conflict_check(true);
    core::reset_binding_conflicts();
    var p: _Probe = _Probe::fresh();
    _wire(p);
    // The bindings' own pushes must not report themselves.
    assert core::binding_conflicts() == (0 as i64);
    p.n = 3;
    assert core::binding_conflicts() == (0 as i64);

    // A direct write to a BOUND property: view 0 carries `n`'s text.
    let _bad: bool = _probe_set_text(core::Handle::of(_view(0 as i64), 0 as *u8, 0 as *u8, 0 as u32), "x");
    assert core::binding_conflicts() == (0 as i64);   // the stub bypasses Handle
    let _via: core::Handle = core::Handle::of(_view(0 as i64), 0 as *u8, 0 as *u8, 0 as u32).set_text("x");
    assert core::binding_conflicts() == (1 as i64);

    // `shown` and `hidden` drive one native property, so a direct set_hidden
    // collides with either polarity — view 4 is bound via `shown`.
    let _h: core::Handle = core::Handle::of(_view(4 as i64), 0 as *u8, 0 as *u8, 0 as u32).set_hidden(true);
    assert core::binding_conflicts() == (2 as i64);

    // A DIFFERENT property of a bound element is not the binding's business:
    // view 0 binds text, so writing its `on` is legitimate.
    let _ok: core::Handle = core::Handle::of(_view(0 as i64), 0 as *u8, 0 as *u8, 0 as u32).set_on(true);
    assert core::binding_conflicts() == (2 as i64);

    // An UNBOUND element is never reported.
    let _free: core::Handle = core::Handle::of(_view(7 as i64), 0 as *u8, 0 as *u8, 0 as u32).set_text("free");
    assert core::binding_conflicts() == (2 as i64);

    core::set_binding_conflict_check(false);
    core::reset_binding_conflicts();
    _probe_remove();
}

#[test]
fn bound_conflict_check_is_off_by_default() {
    // Off, the keyed-direct path pays one bool load and nothing is counted —
    // the reason this is opt-in rather than always on.
    _probe_install();
    core::reset_binding_conflicts();
    var p: _Probe = _Probe::fresh();
    _wire(p);
    let _via: core::Handle = core::Handle::of(_view(0 as i64), 0 as *u8, 0 as *u8, 0 as u32).set_text("x");
    assert core::binding_conflicts() == (0 as i64);
    _probe_remove();
}

#[test]
fn bound_a_node_that_declares_nothing_registers_nothing() {
    // The tier is inert unless a node opts in: an ordinary component pays one
    // null compare per mounted node and nothing else.
    _probe_install();
    var p: _Probe = _Probe::fresh();
    var plain: core::Node = core::label("hello").key("greeting");
    core::register_binds(#addr_of(plain), _view(0 as i64));
    core::paint_new_bindings();
    assert count(p) == (0 as i64);
    assert _text_at(0 as i64).equals("");
    _probe_remove();
}

#[test]
fn bound_missing_backend_is_a_silent_noop_not_a_crash() {
    // No mutator hooks installed at all: every push no-ops and the registry
    // still tracks correctly.
    _probe_remove();
    var p: _Probe = _Probe::fresh();
    _wire(p);
    assert count(p) == (7 as i64);
    p.n = 1;
    var i: i64 = 0 as i64;
    while i < (_slots() as i64) {
        core::forget_view_bindings(_view(i));
        i = i + (1 as i64);
    }
    assert count(p) == (0 as i64);
}
