// ---- lookup ------------------------------------------------------------
// `from` narrows a node to this control, the DOM step: a node carries what
// EVERY node has, and a checked cast adds what only a context_menu_item has. `None` on
// a wrong kind — never a cursor whose every verb silently does nothing.

fn from(p: *core::Node) -> option::Option[ContextMenuItem] {
    if p == (0 as *core::Node) { return option::Option[ContextMenuItem]::None; }
    let d: *core::Data = { (*p).data() };
    if d == (0 as *core::Data) { return option::Option[ContextMenuItem]::None; }
    if { (*d).kind } != props::K_CONTEXT_MENU_ITEM { return option::Option[ContextMenuItem]::None; }
    return option::Option[ContextMenuItem]::Some(ContextMenuItem::_of(p));
}

// Resolve a key, then narrow through the same checked door.

// `within:` and not `in:` — `in` is a C+ keyword. Bare `find` is the
// DOM rule: the running app's windows in open order, first match wins;
// pass `within:` to scope a subtree (or disambiguate across windows).
fn find(key: str, within: *core::Node = 0 as *core::Node) -> option::Option[ContextMenuItem] {
    if within != (0 as *core::Node) {
        return match core::find_in(within, key) {
            option::Option[*core::Node]::Some(p) => from(p),
            option::Option[*core::Node]::None => option::Option[ContextMenuItem]::None,
        };
    }
    return match mount::find_node(key) {
        option::Option[*core::Node]::Some(p) => from(p),
        option::Option[*core::Node]::None => option::Option[ContextMenuItem]::None,
    };
}
