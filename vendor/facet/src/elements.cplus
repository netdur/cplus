    shortcut: vocab::Shortcut = vocab::Shortcut::none(),
    icon: str = "",
    destructive: bool = false,
    on_clicked: fn(*u8, *u8) = props::no_handler,
    on_clicked_ctx: *u8 = 0 as *u8,
) -> core::Node {
    return m_context_menu_item::context_menu_item(
        text,
        key: key,
        shortcut: shortcut,
        icon: icon,
        destructive: destructive,
        on_clicked: on_clicked,
        on_clicked_ctx: on_clicked_ctx,
    );
}

fn toolbar_item(
    text: str,
    key: str = "",
    placement: vocab::ToolbarPlacement = vocab::ToolbarPlacement::Default,
    priority: i64 = 0 as i64,
    icon: str = "",
    destructive: bool = false,
    on_clicked: fn(*u8, *u8) = props::no_handler,
    on_clicked_ctx: *u8 = 0 as *u8,
) -> core::Node {
    return m_toolbar_item::toolbar_item(
        text,
        key: key,
        placement: placement,
        priority: priority,
        icon: icon,
        destructive: destructive,
        on_clicked: on_clicked,
        on_clicked_ctx: on_clicked_ctx,
    );
}

