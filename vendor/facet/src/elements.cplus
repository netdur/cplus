// GENERATED by tools/gen_contract.py — DO NOT EDIT.
// elements — every element name in one module, for the `@` builder
// DSL's contextual lookup: `import "facet/elements" as ui;` then
// `@ui { vstack(key: "body") { button("Save", key: "save") } }`.
// Forwards only. A control LIVES in its own module (find/cursors
// resolve there); this module exists so a bare element name inside
// an `@` block resolves in one context.

