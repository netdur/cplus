    fn translation_y(this) -> f64 { return core::translation_y(this._p); }
    fn set_anchor_x(this, v: f64) -> SearchField { core::set_anchor_x(this._p, v); return this; }
    fn anchor_x(this) -> f64 { return core::anchor_x(this._p); }
    fn set_anchor_y(this, v: f64) -> SearchField { core::set_anchor_y(this._p, v); return this; }
    fn anchor_y(this) -> f64 { return core::anchor_y(this._p); }
    fn set_z_index(this, v: i64) -> SearchField { core::set_z_index(this._p, v); return this; }
    fn z_index(this) -> i64 { return core::z_index(this._p); }
    fn width(this) -> f64 { return core::width_of(this._p); }
    fn height(this) -> f64 { return core::height_of(this._p); }
    fn x(this) -> f64 { return core::x_of(this._p); }
    fn y(this) -> f64 { return core::y_of(this._p); }
    fn bounds(this) -> vocab::Rect { return core::bounds_of(this._p); }
    fn is_focused(this) -> bool { return core::is_focused(this._p); }
    fn is_attached(this) -> bool { return core::is_attached(this._p); }
    fn window(this) -> vocab::WindowRef { return core::window_of(this._p); }
    fn native(this) -> *u8 { return core::native(this._p); }
    fn child_count(this) -> usize { return core::child_count_of(this._p); }
    fn child(this, at: usize) -> option::Option[*core::Node] { return core::child_of(this._p, at); }
    fn set_grow(this, v: f64) -> SearchField { core::set_grow(this._p, v); return this; }
    fn set_shrink(this, v: f64) -> SearchField { core::set_shrink(this._p, v); return this; }
    fn set_width(this, v: f64) -> SearchField { core::set_width(this._p, v); return this; }
    fn set_height(this, v: f64) -> SearchField { core::set_height(this._p, v); return this; }
    fn set_width_percent(this, v: f64) -> SearchField { core::set_width_percent(this._p, v); return this; }
    fn set_height_percent(this, v: f64) -> SearchField { core::set_height_percent(this._p, v); return this; }
    fn set_padding(this, v: f64) -> SearchField { core::set_padding(this._p, v); return this; }
    fn set_margin(this, v: f64) -> SearchField { core::set_margin(this._p, v); return this; }
    fn set_padding_edge(this, edge: flex::Edge, v: f64) -> SearchField { core::set_padding_edge(this._p, edge, v); return this; }
    fn set_margin_edge(this, edge: flex::Edge, v: f64) -> SearchField { core::set_margin_edge(this._p, edge, v); return this; }
    fn set_gap(this, v: f64) -> SearchField { core::set_gap(this._p, v); return this; }
    fn set_justify(this, v: flex::Justify) -> SearchField { core::set_justify(this._p, v); return this; }
    fn set_align(this, v: flex::Align) -> SearchField { core::set_align(this._p, v); return this; }
    fn set_wrap(this, v: flex::Wrap) -> SearchField { core::set_wrap(this._p, v); return this; }
    fn focus(this) -> SearchField { core::focus(this._p); return this; }
    fn blur(this) -> SearchField { core::blur(this._p); return this; }
    fn animate_opacity(this, to: f64, duration: vocab::Duration = vocab::Duration::animation(), easing: vocab::Easing = vocab::Easing::SinInOut) -> SearchField { core::animate_opacity(this._p, to, duration, easing); return this; }
    fn animate_scale(this, to: f64, duration: vocab::Duration = vocab::Duration::animation(), easing: vocab::Easing = vocab::Easing::SinInOut) -> SearchField { core::animate_scale(this._p, to, duration, easing); return this; }
    fn animate_scale_x(this, to: f64, duration: vocab::Duration = vocab::Duration::animation(), easing: vocab::Easing = vocab::Easing::SinInOut) -> SearchField { core::animate_scale_x(this._p, to, duration, easing); return this; }
    fn animate_scale_y(this, to: f64, duration: vocab::Duration = vocab::Duration::animation(), easing: vocab::Easing = vocab::Easing::SinInOut) -> SearchField { core::animate_scale_y(this._p, to, duration, easing); return this; }
    fn animate_rotation(this, to: f64, duration: vocab::Duration = vocab::Duration::animation(), easing: vocab::Easing = vocab::Easing::SinInOut) -> SearchField { core::animate_rotation(this._p, to, duration, easing); return this; }
    fn animate_rotation_x(this, to: f64, duration: vocab::Duration = vocab::Duration::animation(), easing: vocab::Easing = vocab::Easing::SinInOut) -> SearchField { core::animate_rotation_x(this._p, to, duration, easing); return this; }
    fn animate_rotation_y(this, to: f64, duration: vocab::Duration = vocab::Duration::animation(), easing: vocab::Easing = vocab::Easing::SinInOut) -> SearchField { core::animate_rotation_y(this._p, to, duration, easing); return this; }
    fn animate_translation(this, x: f64, y: f64, duration: vocab::Duration = vocab::Duration::animation(), easing: vocab::Easing = vocab::Easing::SinInOut) -> SearchField { core::animate_translation(this._p, x, y, duration, easing); return this; }
    fn cancel_animations(this) -> SearchField { core::cancel_animations(this._p); return this; }
    fn relayout(this) -> SearchField { core::relayout(this._p); return this; }
    fn measure(this, width: f64, height: f64) -> vocab::Size { return core::measure(this._p, width, height); }
    fn begin_updates(this) -> SearchField { core::begin_updates(this._p); return this; }
    fn end_updates(this) -> SearchField { core::end_updates(this._p); return this; }
    fn on_focus(this, f: fn(*u8, *u8), ctx: *u8 = 0 as *u8) -> SearchField { core::set_on_focus(this._p, f, ctx); return this; }
    fn on_blur(this, f: fn(*u8, *u8), ctx: *u8 = 0 as *u8) -> SearchField { core::set_on_blur(this._p, f, ctx); return this; }
    fn on_attach(this, f: fn(*u8, *u8), ctx: *u8 = 0 as *u8) -> SearchField { core::set_on_attach(this._p, f, ctx); return this; }
    fn on_detach(this, f: fn(*u8, *u8), ctx: *u8 = 0 as *u8) -> SearchField { core::set_on_detach(this._p, f, ctx); return this; }
    fn frame(this) -> core::Frame { return core::frame_of(this._p); }
}

// ---- lookup ------------------------------------------------------------
// `from` narrows a node to this control, the DOM step: a node carries what
// EVERY node has, and a checked cast adds what only a search_field has. `None` on
// a wrong kind — never a cursor whose every verb silently does nothing.

fn from(p: *core::Node) -> option::Option[SearchField] {
    if p == (0 as *core::Node) { return option::Option[SearchField]::None; }
    let d: *core::Data = { (*p).data() };
    if d == (0 as *core::Data) { return option::Option[SearchField]::None; }
    if { (*d).kind } != props::K_SEARCH_FIELD { return option::Option[SearchField]::None; }
    return option::Option[SearchField]::Some(SearchField::_of(p));
}

// Resolve a key, then narrow through the same checked door.

// `within:` and not `in:` — `in` is a C+ keyword. Bare `find` is the
// DOM rule: the running app's windows in open order, first match wins;
// pass `within:` to scope a subtree (or disambiguate across windows).
fn find(key: str, within: *core::Node = 0 as *core::Node) -> option::Option[SearchField] {
    if within != (0 as *core::Node) {
        return match core::find_in(within, key) {
            option::Option[*core::Node]::Some(p) => { _report_kind(key, p); from(p) }
            option::Option[*core::Node]::None => option::Option[SearchField]::None,
        };
    }
    return match mount::find_node(key) {
        option::Option[*core::Node]::Some(p) => { _report_kind(key, p); from(p) }
        option::Option[*core::Node]::None => option::Option[SearchField]::None,
    };
}

// The debug posture's third distinction (FACET_DEBUG_FIND=1): the key
// RESOLVED, and `from` is about to answer None anyway because the node is
// another control. `_`-private; costs one flag read when the posture is off.
fn _report_kind(key: str, p: *core::Node) {
    if !mount::find_debugging() { return; }
    if p == (0 as *core::Node) { return; }
    let d: *core::Data = { (*p).data() };
    if d == (0 as *core::Data) || { (*d).kind } != props::K_SEARCH_FIELD {
        mount::debug_find_wrong_kind(key, "search_field");
    }
    return;
}
