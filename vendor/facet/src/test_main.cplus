// facet tests — Stage 2 slice. No backend: the tree is facet's own state, so
// everything below is exercised headlessly.

import "flex_layout/flex_layout" as flex;
import "stdlib/text" as text;
import "stdlib/option" as option;
import "stdlib/status" as status;
import "./facet" as facet;
import "./props" as props;
import "./vocabulary" as vocab;
import "./button" as button;
import "./label" as label;
import "./slider" as slider;
import "./toggle" as toggle;
import "./text_field" as text_field;
import "./image" as image;

fn approx(a: f64, b: f64) -> bool {
    let d: f64 = a - b;
    if d < 0.0f64 { return (0.0f64 - d) < 0.0001f64; }
    return d < 0.0001f64;
}

fn clicked(sender: *u8, ctx: *u8) { return; }

// ---- build ------------------------------------------------------------------

#[test]
fn constructor_stores_named_params() {
    var root: facet::Node = button::button("Save", key: "save", font_size: 13.0f64);
    match button::find(#addr_of(root), "save") {
        option::Option[button::Button]::Some(b) => {
            assert b.title() == "Save";
            assert approx(b.font_size(), 13.0f64);
        }
        option::Option[button::Button]::None => { assert false; }
    }
    return;
}

#[test]
fn defaults_apply_when_omitted() {
    var root: facet::Node = button::button("Ok", key: "ok");
    match button::find(#addr_of(root), "ok") {
        option::Option[button::Button]::Some(b) => {
            assert approx(b.font_size(), 0.0f64);
            assert b.is_pressed() == false;
        }
        option::Option[button::Button]::None => { assert false; }
    }
    return;
}

// ---- find -------------------------------------------------------------------

#[test]
fn find_locates_a_nested_key() {
    var b: facet::Builder = facet::Builder::new();
    b.add(button::button("A", key: "a"));
    b.add(button::button("B", key: "b"));
    var root: facet::Node = facet::column(b);

    match button::find(#addr_of(root), "b") {
        option::Option[button::Button]::Some(hit) => { assert hit.title() == "B"; }
        option::Option[button::Button]::None => { assert false; }
    }
    return;
}

#[test]
fn find_misses_an_unknown_key() {
    var root: facet::Node = button::button("A", key: "a");
    match button::find(#addr_of(root), "nope") {
        option::Option[button::Button]::Some(_) => { assert false; }
        option::Option[button::Button]::None => { assert true; }
    }
    return;
}

// ---- mutate -----------------------------------------------------------------

#[test]
fn setter_writes_state_and_marks_dirty() {
    var root: facet::Node = button::button("Save", key: "save");
    match button::find(#addr_of(root), "save") {
        option::Option[button::Button]::Some(b) => {
            let _c: button::Button = b.set_title("Saving…");
            assert b.title() == "Saving…";
        }
        option::Option[button::Button]::None => { assert false; }
    }
    let d: *facet::Data = root.data();
    assert ({ (*d).dirty } & props::C_OPACITY) == 0u64;   // no common bits set
}

#[test]
fn setters_chain_and_accumulate_bits() {
    var root: facet::Node = button::button("Save", key: "save");
    match button::find(#addr_of(root), "save") {
        option::Option[button::Button]::Some(b) => {
            let _c: button::Button = b.set_title("x").set_font_size(11.0f64)
                                      .set_corner_radius(vocab::Corners::all(6.0f64));
            assert approx(b.font_size(), 11.0f64);
        }
        option::Option[button::Button]::None => { assert false; }
    }
    let d: *facet::Data = root.data();
    assert { (*d).dirty } != 0u64;                       // several control bits
}

// ---- layout -----------------------------------------------------------------

#[test]
fn layout_frames_come_from_flex() {
    var b: facet::Builder = facet::Builder::new();
    b.add(button::button("A", key: "a"));
    b.add(button::button("B", key: "b"));
    var root: facet::Node = facet::column(b);

    root.style.width = flex::StyleLength::points(200.0f64);
    root.style.height = flex::StyleLength::points(100.0f64);
    root.calculate_layout();

    let f: flex::Frame = root.frame();
    assert approx(f.width, 200.0f64);
    assert approx(f.height, 100.0f64);
}

// ---- cursor staleness -------------------------------------------------------

#[test]
fn cursor_is_live_until_a_removal() {
    var b: facet::Builder = facet::Builder::new();
    b.add(button::button("A", key: "a"));
    b.add(button::button("B", key: "b"));
    var root: facet::Node = facet::column(b);

    match button::find(#addr_of(root), "a") {
        option::Option[button::Button]::Some(hit) => {
            assert hit.is_live();
            let _gone: option::Option[facet::Node] = root.remove_child(at: 1 as usize);
            assert hit.is_live() == false;      // a removal happened; re-derive
        }
        option::Option[button::Button]::None => { assert false; }
    }
    return;
}

// ---- the shared band --------------------------------------------------------

#[test]
fn shared_verbs_are_on_the_typed_cursor() {
    var root: facet::Node = button::button("Save", key: "save");
    match button::find(#addr_of(root), "save") {
        option::Option[button::Button]::Some(b) => {
            // chains with the button-specific setters, returns Button
            let _c: button::Button = b.set_title("Go").set_opacity(0.5f64)
                                      .set_enabled(false).set_font_size(12.0f64);
            assert approx(b.opacity(), 0.5f64);
            assert b.is_enabled() == false;
            assert b.title() == "Go";
        }
        option::Option[button::Button]::None => { assert false; }
    }
    return;
}

#[test]
fn shared_defaults_are_sane() {
    var root: facet::Node = button::button("A", key: "a");
    match button::find(#addr_of(root), "a") {
        option::Option[button::Button]::Some(b) => {
            assert approx(b.opacity(), 1.0f64);
            assert b.is_enabled();
            assert b.is_visible();
        }
        option::Option[button::Button]::None => { assert false; }
    }
    return;
}

#[test]
fn common_and_control_bits_do_not_collide() {
    var root: facet::Node = button::button("A", key: "a");
    match button::find(#addr_of(root), "a") {
        option::Option[button::Button]::Some(b) => {
            let _c: button::Button = b.set_title("x").set_opacity(0.5f64);
        }
        option::Option[button::Button]::None => { assert false; }
    }
    let d: *facet::Data = root.data();
    assert ({ (*d).dirty } & props::C_OPACITY) == props::C_OPACITY;
    return;
}

// ---- the other 37 -----------------------------------------------------------

#[test]
fn label_carries_its_own_rows() {
    var root: facet::Node = label::label("Hello", key: "l", font_size: 14.0f64);
    match label::find(#addr_of(root), "l") {
        option::Option[label::Label]::Some(x) => {
            assert x.text() == "Hello";
            assert approx(x.font_size(), 14.0f64);
            let _c: label::Label = x.set_text("Bye").set_opacity(0.25f64);
            assert x.text() == "Bye";
            assert approx(x.opacity(), 0.25f64);
        }
        option::Option[label::Label]::None => { assert false; }
    }
    return;
}

#[test]
fn slider_has_value_minimum_maximum() {
    var root: facet::Node = slider::slider(0.5f64, key: "s",
                                           minimum: 0.0f64, maximum: 10.0f64);
    match slider::find(#addr_of(root), "s") {
        option::Option[slider::Slider]::Some(x) => {
            assert approx(x.value(), 0.5f64);
            assert approx(x.maximum(), 10.0f64);
            let _c: slider::Slider = x.set_value(7.5f64);
            assert approx(x.value(), 7.5f64);
        }
        option::Option[slider::Slider]::None => { assert false; }
    }
    return;
}

#[test]
fn toggle_and_text_field_and_image() {
    var b: facet::Builder = facet::Builder::new();
    b.add(toggle::toggle(true, key: "t"));
    b.add(text_field::text_field("hi", key: "tf"));
    b.add(image::image("logo.png", key: "img"));
    var root: facet::Node = facet::column(b);

    match toggle::find(#addr_of(root), "t") {
        option::Option[toggle::Toggle]::Some(x) => { assert x.on(); }
        option::Option[toggle::Toggle]::None => { assert false; }
    }
    match text_field::find(#addr_of(root), "tf") {
        option::Option[text_field::TextField]::Some(x) => { assert x.text() == "hi"; }
        option::Option[text_field::TextField]::None => { assert false; }
    }
    match image::find(#addr_of(root), "img") {
        option::Option[image::Image]::Some(x) => { assert x.source() == "logo.png"; }
        option::Option[image::Image]::None => { assert false; }
    }
    return;
}

// The property the one-Handle model could never give: a wrong-kind lookup is
// None, and the verb that does not belong is not on the type at all.
#[test]
fn wrong_kind_lookup_is_none() {
    var root: facet::Node = button::button("Save", key: "save");
    match slider::find(#addr_of(root), "save") {
        option::Option[slider::Slider]::Some(_) => { assert false; }
        option::Option[slider::Slider]::None => { assert true; }
    }
    return;
}

#[test]
fn mixed_tree_keeps_each_kind_addressable() {
    var b: facet::Builder = facet::Builder::new();
    b.add(button::button("Go", key: "go"));
    b.add(label::label("Status", key: "st"));
    b.add(slider::slider(1.0f64, key: "sl"));
    var root: facet::Node = facet::column(b);
    assert root.child_count() == (3 as usize);

    match button::find(#addr_of(root), "go") {
        option::Option[button::Button]::Some(x) => { assert x.title() == "Go"; }
        option::Option[button::Button]::None => { assert false; }
    }
    match label::find(#addr_of(root), "st") {
        option::Option[label::Label]::Some(x) => { assert x.text() == "Status"; }
        option::Option[label::Label]::None => { assert false; }
    }
    match slider::find(#addr_of(root), "sl") {
        option::Option[slider::Slider]::Some(x) => { assert approx(x.value(), 1.0f64); }
        option::Option[slider::Slider]::None => { assert false; }
    }
    return;
}

// ---- containers come from flex, not from a facet reimplementation ----------

#[test]
fn hstack_lays_out_horizontally() {
    var b: facet::Builder = facet::Builder::new();
    b.add(button::button("A", key: "a").width(50.0f64).height(20.0f64));
    b.add(button::button("B", key: "b").width(50.0f64).height(20.0f64));
    var root: facet::Node = facet::hstack(b);
    root.calculate_layout(width: 300.0f64, height: 100.0f64);
    match button::find(#addr_of(root), "b") {
        option::Option[button::Button]::Some(x) => {
            assert x.x() > 50.0f64;
            assert approx(x.y(), 0.0f64);
        }
        option::Option[button::Button]::None => { assert false; }
    }
    return;
}

#[test]
fn spacer_eats_the_leftover_space() {
    var b: facet::Builder = facet::Builder::new();
    b.add(button::button("A", key: "a").width(40.0f64).height(20.0f64));
    b.add(facet::spacer());
    b.add(button::button("B", key: "b").width(40.0f64).height(20.0f64));
    var root: facet::Node = facet::row(b);
    root.calculate_layout(width: 200.0f64, height: 40.0f64);
    match button::find(#addr_of(root), "b") {
        option::Option[button::Button]::Some(x) => { assert approx(x.x(), 160.0f64); }
        option::Option[button::Button]::None => { assert false; }
    }
    return;
}

#[test]
fn zstack_overlaps_its_children() {
    var b: facet::Builder = facet::Builder::new();
    b.add(button::button("A", key: "a").width(30.0f64).height(30.0f64));
    b.add(button::button("B", key: "b").width(30.0f64).height(30.0f64));
    var root: facet::Node = facet::zstack(b);
    root.calculate_layout(width: 100.0f64, height: 100.0f64);
    match button::find(#addr_of(root), "a") {
        option::Option[button::Button]::Some(a) => {
            match button::find(#addr_of(root), "b") {
                option::Option[button::Button]::Some(bb) => {
                    assert approx(a.x(), bb.x());
                    assert approx(a.y(), bb.y());
                }
                option::Option[button::Button]::None => { assert false; }
            }
        }
        option::Option[button::Button]::None => { assert false; }
    }
    return;
}
