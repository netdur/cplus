// facet test root. `cpc test` uses this [[bin]] entry so the literal
// `@facet { }` surface runs here — a module cannot be its own `@`-context.
// The protocol- and mount-level tests live in facet.cplus.

import "stdlib/option" as option;
import "flex_layout/flex_layout" as flex;
import "./facet" as facet;

fn main() -> i32 { return 0; }

fn noop2(sender: *u8, ctx: *u8) { return; }

#[test]
fn dsl_block_builds_description_tree() {
    let show = true;
    var root: facet::Node = @facet {
        vstack {
            label("Iris", size: 28.0f64, bold: true)
            hstack {
                button("New", primary: true)
                button("Open")
            }
            for i in 0..3 {
                label("row")
            }
            if show {
                label("footer", secondary: true)
            }
        }
    };
    // The block finishes as a column holding the vstack.
    assert root.kind == facet::kind_column();
    assert root.children.count() == (1 as usize);
    match root.children.at_ptr(0 as usize) {
        option::Option[*facet::Node]::Some(v) => {
            // 1 label + hstack + 3 rows + footer = 6.
            assert { (*v).kind } == facet::kind_column();
            assert { (*v).children.count() } == (6 as usize);
        }
        option::Option[*facet::Node]::None => { assert false; }
    };
}

#[test]
fn dsl_fluent_chain_and_modifier_lines() {
    var root: facet::Node = @facet {
        hstack {
            label("x")
            spacer()
            button("del").on_click(noop2, ctx: 3 as *u8)
        }.padding(4.0f64)
            .set_gap(2.0f64)
    };
    match root.children.at_ptr(0 as usize) {
        option::Option[*facet::Node]::Some(h) => {
            assert { (*h).kind } == facet::kind_row();
            assert { (*h).children.count() } == (3 as usize);
        }
        option::Option[*facet::Node]::None => { assert false; }
    };
}

#[test]
fn dsl_tree_mounts_to_flex() {
    var root: facet::Node = @facet {
        row {
            label("a")
            spacer()
            label("b")
        }
    };
    var tree: flex::Node = facet::mount(#addr_of(root), facet::fake_renderer());
    assert tree.child_count() == (1 as usize);
    tree.calculate_layout(300.0f64, 50.0f64, flex::Direction::LTR);
    match tree.children.at_ptr(0 as usize) {
        option::Option[*flex::Node]::Some(rp) => {
            assert { (*rp).child_count() } == (3 as usize);
        }
        option::Option[*flex::Node]::None => { assert false; }
    };
}

#[test]
fn agent_id_rides_the_description() {
    // Fluent form tags a leaf; untouched nodes stay untagged (empty).
    var root: facet::Node = @facet {
        vstack {
            label("count")
            button("+1").agent_id("inc-btn")
        }
    };
    match root.children.at_ptr(0 as usize) {
        option::Option[*facet::Node]::Some(v) => {
            match { (*v).children.at_ptr(0 as usize) } {
                option::Option[*facet::Node]::Some(l) => {
                    assert { (*l).agent_id.count() } == (0 as usize);
                }
                option::Option[*facet::Node]::None => { assert false; }
            };
            match { (*v).children.at_ptr(1 as usize) } {
                option::Option[*facet::Node]::Some(b) => {
                    assert { (*b).agent_id.view() } == "inc-btn";
                }
                option::Option[*facet::Node]::None => { assert false; }
            };
        }
        option::Option[*facet::Node]::None => { assert false; }
    };

    // set_ form rewrites in place.
    var n: facet::Node = facet::button("Save");
    n.set_agent_id("save-btn");
    assert n.agent_id.view() == "save-btn";
}

// ---- run_on_main hook --------------------------------------------------------

static ROM_HITS: i32 = 0;
static ROM_CTX_OK: i32 = 0;
fn rom_probe(ctx: *u8) {
    ROM_HITS = ROM_HITS + 1;
    if ctx == (7 as *u8) { ROM_CTX_OK = 1; }
    return;
}
fn rom_sync(work: fn(*u8), ctx: *u8) { work(ctx); return; }

#[test]
fn run_on_main_drops_without_backend_and_fires_through_hook() {
    // Reset to the no-backend state so the test is order-independent.
    facet::set_run_on_main_fn(0 as fn(fn(*u8), *u8));
    ROM_HITS = 0; ROM_CTX_OK = 0;
    facet::run_on_main(rom_probe, 7 as *u8);   // no backend: dropped, no crash
    assert ROM_HITS == 0;
    facet::set_run_on_main_fn(rom_sync);
    facet::run_on_main(rom_probe, 7 as *u8);   // dispatched, ctx intact
    assert ROM_HITS == 1;
    assert ROM_CTX_OK == 1;
    facet::set_run_on_main_fn(0 as fn(fn(*u8), *u8));
}

// ---- Service / load_service --------------------------------------------------

static SVC_ORDER: i32 = 0;

struct ProbeService { }

impl ProbeService: facet::Service {
    fn produce(ref this) { SVC_ORDER = SVC_ORDER * 10 + 1; return; }
    fn apply(ref this) { SVC_ORDER = SVC_ORDER * 10 + 2; return; }
}

fn svc_ready(ctx: *u8) {
    if ctx == (9 as *u8) { SVC_ORDER = SVC_ORDER * 10 + 3; }
    return;
}

#[test]
fn service_job_runs_produce_then_apply_then_ready() {
    // Drive the pipeline synchronously (no worker, no sleep): a passthrough
    // run_on_main and a hand-built job. Order must be produce, apply, ready,
    // with the ctx intact end to end.
    facet::set_run_on_main_fn(rom_sync);
    SVC_ORDER = 0;
    var svc: ProbeService = ProbeService { };
    let job: facet::ServiceJob = facet::ServiceJob {
        svc_addr: { #addr_of(svc) as *u8 } as usize,
        produce: facet::service_produce_tramp::[ProbeService],
        apply: facet::service_apply_tramp::[ProbeService],
        on_ready: svc_ready,
        ctx_addr: (9 as *u8) as usize,
    };
    let _rc: i32 = facet::run_service_job(job);
    assert SVC_ORDER == 123;
    facet::set_run_on_main_fn(0 as fn(fn(*u8), *u8));
}
