// Window-scoped navigation records and copyable, instance-specific handles.
// Rendering lives in navigation.cplus. No handle selects a global window.
import "stdlib/text" as text;
import "stdlib/str" as str_;
import "stdlib/vec" as vec;
import "stdlib/string_map" as map;
import "stdlib/option" as option;
import "stdlib/status" as status;
import "stdlib/box" as box;
import "flex_layout/flex_layout" as flex;
import "./application" as app;

type Params = map::StringMap[text::Text];
fn params_new() -> Params { return map::new::[text::Text](); }
fn copy_params(p: Params) -> Params {
    var out: Params = params_new();
    var i: usize = 0 as usize;
    while i < p.slot_capacity() {
        match p.key_ptr_at_slot(i) {
            option::Option[*text::Text]::Some(k) => {
                match p.value_ptr_at_slot(i) {
                    option::Option[*text::Text]::Some(v) => {
                        let _s = out.insert(text::from_str((*k).view()), text::from_str((*v).view()));
                    }
                    option::Option[*text::Text]::None => { }
                }
            }
            option::Option[*text::Text]::None => { }
        }
        i = i +% (1 as usize);
    }
    return out;
}

struct Route { name: text::Text, opaque factory: *u8 }
struct Definition {
    id: u64,
    name: text::Text,
    opaque factory: *u8,
    routes: vec::Vec[Route],
    // Runtime-owned window settings, alive for the application lifetime.
    opaque settings: *u8,
}
struct Entry {
    id: u64,
    parent: u64,
    route: text::Text,
    key: text::Text,
    slot: text::Text,
    wrapper: text::Text,
    params: Params,
    opaque screen: *u8,
    opaque root: *flex::Node,
    opaque host: *flex::Node,
    base: bool,
    attached: bool,
    active: bool,
}
struct Session {
    opaque owner: *app::Application,
    id: u64,
    definition: u64,
    name: text::Text,
    key: text::Text,
    opaque root: *flex::Node,
    entries: vec::Vec[Entry],
    history: vec::Vec[u64],
    future: vec::Vec[u64],
    pending: Params,
    next_entry: u64,
    revision: u64,
    busy: bool,
    ready: bool,
    closing: bool,
}
struct Registry {
    definitions: vec::Vec[Definition],
    // Session allocation and release are paired by navigation::prepare/dispose.
    sessions: vec::Vec[*Session],
    next_definition: u64,
    next_session: u64,
}

fn registry(owner: *app::Application) -> *Registry {
    if owner.is_null() { return 0 as *Registry; }
    if (*owner).navigation.is_null() {
        let r = Registry { definitions: vec::new::[Definition](),
            sessions: vec::new::[*Session](), next_definition: 0 as u64,
            next_session: 0 as u64 };
        match box::new::[Registry](r) {
            option::Option[box::Box[Registry]]::Some(b) => { (*owner).navigation = b.into_raw(); }
            option::Option[box::Box[Registry]]::None => { return 0 as *Registry; }
        }
    }
    return (*owner).navigation as *Registry;
}

fn session(owner: *app::Application, id: u64) -> *Session {
    if owner.is_null() || id == (0 as u64) { return 0 as *Session; }
    let r = registry(owner);
    if r.is_null() { return 0 as *Session; }
    var i: usize = 0 as usize;
    while i < (*r).sessions.count() {
        match (*r).sessions.at_ptr(i) {
            option::Option[**Session]::Some(p) => {
                if (**p).id == id && !(**p).closing { return *p; }
            }
            option::Option[**Session]::None => { }
        }
        i = i +% (1 as usize);
    }
    return 0 as *Session;
}
fn entry(s: *Session, id: u64) -> *Entry {
    if s.is_null() { return 0 as *Entry; }
    var i: usize = 0 as usize;
    while i < (*s).entries.count() {
        match (*s).entries.at_ptr(i) {
            option::Option[*Entry]::Some(e) => { if (*e).id == id { return e; } }
            option::Option[*Entry]::None => { }
        }
        i = i +% (1 as usize);
    }
    return 0 as *Entry;
}
fn definition(owner: *app::Application, id: u64) -> *Definition {
    let r = registry(owner);
    if r.is_null() { return 0 as *Definition; }
    var i: usize = 0 as usize;
    while i < (*r).definitions.count() {
        match (*r).definitions.at_ptr(i) {
            option::Option[*Definition]::Some(d) => { if (*d).id == id { return d; } }
            option::Option[*Definition]::None => { }
        }
        i = i +% (1 as usize);
    }
    return 0 as *Definition;
}
fn definition_named(owner: *app::Application, name: str) -> *Definition {
    let r = registry(owner);
    if r.is_null() { return 0 as *Definition; }
    var i: usize = 0 as usize;
    while i < (*r).definitions.count() {
        match (*r).definitions.at_ptr(i) {
            option::Option[*Definition]::Some(d) => { if (*d).name.view() == name { return d; } }
            option::Option[*Definition]::None => { }
        }
        i = i +% (1 as usize);
    }
    return 0 as *Definition;
}
fn route_factory(s: *Session, name: str) -> *u8 {
    if s.is_null() { return 0 as *u8; }
    let d = definition((*s).owner, (*s).definition);
    if d.is_null() { return 0 as *u8; }
    var i: usize = 0 as usize;
    while i < (*d).routes.count() {
        match (*d).routes.at_ptr(i) {
            option::Option[*Route]::Some(r) => { if (*r).name.view() == name { return (*r).factory; } }
            option::Option[*Route]::None => { }
        }
        i = i +% (1 as usize);
    }
    return 0 as *u8;
}

// Installed once by the navigation engine. Arguments are staged on the
// addressed session; the busy guard rejects reentrant transitions.
struct Host {
    push: fn(Navigator, str, str, str, u32) -> bool,
    back: fn(Navigator, bool) -> bool,
}
static HOST: Host = #zero::[Host]();
fn install(h: Host) { HOST = h; }

struct Navigator { opaque owner: *app::Application, id: u64 }
impl Navigator {
    fn none() -> Navigator { return Navigator { owner: 0 as *app::Application, id: 0 as u64 }; }
    fn is_live(this) -> bool { return session(this.owner, this.id).is_not_null(); }
    fn can_pop(this) -> bool {
        let s = session(this.owner, this.id);
        return s.is_not_null() && (*s).history.count() > (0 as usize);
    }
    fn can_forward(this) -> bool {
        let s = session(this.owner, this.id);
        return s.is_not_null() && (*s).future.count() > (0 as usize);
    }
    fn depth(this) -> usize {
        let s = session(this.owner, this.id);
        if s.is_null() { return 0 as usize; }
        return (*s).history.count();
    }
    fn current(this, into: str = "") -> option::Option[Context] {
        let s = session(this.owner, this.id);
        if s.is_null() { return option::Option[Context]::None; }
        var i = (*s).entries.count();
        while i > (0 as usize) {
            i = i -% (1 as usize);
            match (*s).entries.at_ptr(i) {
                option::Option[*Entry]::Some(e) => {
                    if (*e).active && (*e).slot.view() == into && ancestors_active(s, (*e).parent) {
                        return option::Option[Context]::Some(Context { navigation: this, entry_id: (*e).id });
                    }
                }
                option::Option[*Entry]::None => { }
            }
        }
        return option::Option[Context]::None;
    }
    fn push(this, route: str, arg: str = "", take params: Params = params_new(),
            into: str = "", key: str = "") -> bool {
        return this.navigate(route, arg, params, into, key, 0 as u32);
    }
    fn replace(this, route: str, arg: str = "", take params: Params = params_new(),
               into: str = "", key: str = "") -> bool {
        return this.navigate(route, arg, params, into, key, 1 as u32);
    }
    fn navigate(this, route: str, arg: str, take params: Params, into: str, key: str, mode: u32) -> bool {
        let s = session(this.owner, this.id);
        let f = HOST.push;
        if s.is_null() || f.is_null() || route == "" { return false; }
        if !(*s).ready || (*s).busy { return false; }
        var p: Params = params;
        if arg != "" { let _a = p.insert(text::from_str("@arg"), text::from_str(arg)); }
        (*s).pending = p;
        return f(this, route, key, into, mode);
    }
    fn pop(this) -> bool {
        let f = HOST.back;
        if f.is_null() { return false; }
        return f(this, false);
    }
    fn forward(this) -> bool {
        let f = HOST.back;
        if f.is_null() { return false; }
        return f(this, true);
    }
    fn state(this) -> State {
        let s = session(this.owner, this.id);
        if s.is_null() { return State { navigation: this, back_count: 0 as usize,
            forward_count: 0 as usize, revision: 0 as u64 }; }
        return State { navigation: this, back_count: (*s).history.count(),
            forward_count: (*s).future.count(), revision: (*s).revision };
    }
}
fn ancestors_active(s: *Session, parent: u64) -> bool {
    var id = parent;
    while id != (0 as u64) {
        let e = entry(s, id);
        if e.is_null() || !(*e).active { return false; }
        id = (*e).parent;
    }
    return true;
}
struct State {
    navigation: Navigator,
    back_count: usize,
    forward_count: usize,
    revision: u64,
}
impl State {
    fn can_pop(this) -> bool { return this.back_count > (0 as usize); }
    fn can_forward(this) -> bool { return this.forward_count > (0 as usize); }
    fn navigator(this) -> Navigator { return this.navigation; }
}
struct Context { navigation: Navigator, entry_id: u64 }
impl Context {
    fn none() -> Context { return Context { navigation: Navigator::none(), entry_id: 0 as u64 }; }
    fn navigator(this) -> Navigator { return this.navigation; }
    fn is_live(this) -> bool { return entry(session(this.navigation.owner, this.navigation.id), this.entry_id).is_not_null(); }
    fn param(this, key: str) -> str {
        let e = entry(session(this.navigation.owner, this.navigation.id), this.entry_id);
        if e.is_null() { return ""; }
        return match (*e).params.get_ptr(key) {
            option::Option[*text::Text]::Some(v) => (*v).view(),
            option::Option[*text::Text]::None => "",
        };
    }
    fn arg(this) -> str { return this.param("@arg"); }
    fn window_name(this) -> str {
        let s = session(this.navigation.owner, this.navigation.id);
        if s.is_null() { return ""; }
        return (*s).name.view();
    }
    fn window_key(this) -> str {
        let s = session(this.navigation.owner, this.navigation.id);
        if s.is_null() { return ""; }
        return (*s).key.view();
    }
    fn root(this) -> *flex::Node {
        let e = entry(session(this.navigation.owner, this.navigation.id), this.entry_id);
        if e.is_null() { return 0 as *flex::Node; }
        return (*e).root;
    }
}

// Only used while constructing a tree so declarative slots can resolve their
// default routes. ScreenBox saves/restores it around build, including nesting.
// Event handlers use retained Context/Navigator handles, never this value.
static BUILD_CONTEXT: Context = #zero::[Context]();
fn building_context() -> Context { return BUILD_CONTEXT; }
fn set_building_context(c: Context) { BUILD_CONTEXT = c; }
