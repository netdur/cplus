// LocalAuthentication. macOS and iOS — one backend, because `LAContext` is the
// same class on both and the only difference is which sensor answers.
//
// ---- a context is single-use ------------------------------------------------
//
// `LAContext` caches its result: evaluating the same policy twice on one
// context can succeed the second time WITHOUT ASKING, which is the whole point
// of `touchIDAuthenticationAllowableReuseDuration` and a security hole when it
// is not what you meant. So a fresh context is built per call and released
// after, and reuse is not offered.
//
// ---- the error codes are the interesting part --------------------------------
//
// `canEvaluatePolicy:error:` answers false for three unrelated reasons and the
// error code is the only way to tell them apart. Collapsing them would tell a
// person with no enrolled finger that their device has no sensor.

import "stdlib/option" as option;
import "stdlib/box" as box;
import "objc/runtime" as rt;
import "objc/bridge" as bridge;
import "localauthentication/localauthentication" as la;
import "./biometrics" as bio;

// LAPolicy
const _POLICY_BIOMETRICS: i64 = 1 as i64;
const _POLICY_BIOMETRICS_OR_WATCH: i64 = 2 as i64;

// LAError, negative on Apple.
const _E_AUTH_FAILED: i64 = -1 as i64;
const _E_USER_CANCEL: i64 = -2 as i64;
const _E_SYSTEM_CANCEL: i64 = -4 as i64;
const _E_PASSCODE_NOT_SET: i64 = -5 as i64;
const _E_NOT_AVAILABLE: i64 = -6 as i64;
const _E_NOT_ENROLLED: i64 = -7 as i64;
const _E_LOCKOUT: i64 = -8 as i64;
const _E_APP_CANCEL: i64 = -9 as i64;

// The (fn, ctx) pair, kept alive across the prompt. The reply block runs
// seconds later on a queue of LocalAuthentication's choosing, and a pair on
// this frame would be gone by then.
struct _Pending {
    on_result: fn(bio::Outcome, *u8),
    opaque ctx: *u8,
    opaque context: *u8,
}

fn _new_context() -> *u8 {
    let cls: *u8 = rt::get_class(#str_ptr("LAContext\0"));
    if cls.is_null() { return 0 as *u8; }
    return rt::msg_id(rt::msg_id(cls, rt::sel(#str_ptr("alloc\0"))),
                      rt::sel(#str_ptr("init\0")));
}

export extern fn _c_kind() -> i32 {
    let c: *u8 = _new_context();
    if c.is_null() { return 0; }
    // `biometryType` is only populated AFTER canEvaluatePolicy has run — it
    // answers None on a fresh context, which reads as "no hardware" and is
    // not. This is the one ordering rule in the whole API.
    let ctxobj: la::Context = la::Context::from_raw(c);
    let _ = ctxobj.can_evaluate_policy(la::policy_from_raw(_POLICY_BIOMETRICS), 0 as *u8);
    let t: i64 = la::biometry_type_raw(ctxobj.biometry_type());
    rt::release(c);
    // LABiometryType: 0 none, 1 TouchID, 2 FaceID, 4 OpticID.
    if t == (1 as i64) { return 1; }
    if t == (2 as i64) { return 2; }
    if t == (4 as i64) { return 3; }
    return 0;
}

export extern fn _c_available() -> i32 {
    let c: *u8 = _new_context();
    if c.is_null() { return 0; }
    let ok: bool = la::Context::from_raw(c)
        .can_evaluate_policy(la::policy_from_raw(_POLICY_BIOMETRICS), 0 as *u8);
    rt::release(c);
    if ok { return 1; }
    return 0;
}

fn _outcome_of_error(err: *u8) -> i32 {
    if err.is_null() { return 7; }
    let code: i64 = rt::msg_i64(err, rt::sel(#str_ptr("code\0")));
    if code == _E_AUTH_FAILED { return 4; }
    if code == _E_USER_CANCEL { return 5; }
    if code == _E_SYSTEM_CANCEL { return 5; }
    if code == _E_APP_CANCEL { return 5; }
    if code == _E_NOT_ENROLLED { return 3; }
    if code == _E_PASSCODE_NOT_SET { return 3; }
    if code == _E_NOT_AVAILABLE { return 2; }
    if code == _E_LOCKOUT { return 6; }
    return 7;
}

// The reply, seconds later. LocalAuthentication does NOT promise the main
// thread — it calls on a private queue — so a handler that touches the UI has
// to hop, and the facade says so rather than hopping on the caller's behalf.
fn _reply(ctx: *u8, success: i8, error: *u8) {
    if ctx.is_null() { return; }
    let p: *_Pending = ctx as *_Pending;
    let f: fn(bio::Outcome, *u8) = { (*p).on_result };
    var code: i32 = 0;
    if success == (0 as i8) { code = _outcome_of_error(error); }

    let c: *u8 = { (*p).context };
    if c.is_not_null() {
        // INVALIDATE, then release. A context still holding a live evaluation
        // keeps the prompt's resources; `invalidate` is how LocalAuthentication
        // is told the app is done with it.
        rt::msg_void(c, rt::sel(#str_ptr("invalidate\0")));
        rt::release(c);
    }
    if f.is_not_null() { f(bio::Outcome::from_code(code), { (*p).ctx }); }
    return;
}

export extern fn _c_authenticate(reason: *u8, reason_len: usize,
                                 on_result: fn(bio::Outcome, *u8), ctx: *u8,
                                 allow_passcode: i32) -> i32 {
    let c: *u8 = _new_context();
    if c.is_null() { return 1; }

    // POLICY 2 FALLS BACK to the device passcode (and a paired Watch on macOS);
    // policy 1 is biometrics only. The default is 2 because the alternative
    // locks a person out of their own data over a wet finger.
    var policy: i64 = _POLICY_BIOMETRICS;
    if allow_passcode != 0 { policy = _POLICY_BIOMETRICS_OR_WATCH; }

    let can: bool = la::Context::from_raw(c)
        .can_evaluate_policy(la::policy_from_raw(policy), 0 as *u8);
    if !can {
        rt::release(c);
        return 2;
    }

    var blank: _Pending = _Pending { on_result: on_result, ctx: ctx, context: c };
    var p: *_Pending = match box::new::[_Pending](blank) {
        option::Option[box::Box[_Pending]]::Some(b) => { b.into_raw() as *_Pending },
        option::Option[box::Box[_Pending]]::None => { 0 as *_Pending },
    };
    if p.is_null() {
        rt::release(c);
        return 7;
    }

    let ctxobj: la::Context = la::Context::from_raw(c);
    ctxobj.evaluate_policy(la::policy_from_raw(policy),
                           { #str_from_raw_parts(reason, reason_len) },
                           _reply, { p as *u8 });
    return 0;
}
