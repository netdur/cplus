// Target/action -> typed `fn(*u8)` callback (shared, one per module).
#[link_name = "class_addMethod"]
extern fn cplus_action_add_method(cls: *u8, sel: *u8, imp: fn(*u8, *u8, *u8), types: *u8) -> i8;

fn cplus_action_handler_key() -> *u8 { return { 28672 as *u8 }; }
fn cplus_action_pin_key() -> *u8 { return { 28673 as *u8 }; }

fn cplus_action_imp(self_obj: *u8, cmd: *u8, sender: *u8) {
    let f: fn(*u8) = { synth::get_associated(self_obj, cplus_action_handler_key()) as fn(*u8) };
    f(sender);
    return;
}

fn cplus_make_action_target(handler: fn(*u8)) -> *u8 {
    let name: *u8 = #str_ptr("Cplus_ActionTarget\0");
    var cls: *u8 = rt::get_class(name);
    if cls == { 0 as *u8 } {
        cls = synth::allocate_class_pair(rt::get_class(#str_ptr("NSObject\0")), name, 0 as usize);
        let added: i8 = cplus_action_add_method(cls, rt::sel(#str_ptr("cplusAction:\0")), cplus_action_imp, #str_ptr("v@:@\0"));
        synth::register_class_pair(cls);
    }
    let t: *u8 = synth::alloc_init_class(cls);
    synth::set_associated(t, cplus_action_handler_key(), { handler as *u8 });
    return t;
}

