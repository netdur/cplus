// notifications — the portable facade.
//
// Build a notification, schedule it, cancel it, list what is pending. Taps
// arrive through `on_tap` once that tier lands; everything platform-shaped is
// behind the seam at the bottom of this file.
//
// WHAT THIS PACKAGE IS NOT: a push-token package. A token is a device
// credential and a round trip to a server you own — an `aps-environment`
// entitlement and a provisioning profile on Apple, the Firebase AAR pipeline on
// Android — and none of it is needed to build, show or handle a notification. A
// remote one that arrives is presented and routed exactly like a local one,
// which is the whole promise here. See plans/notifications.md §6.
//
// THE PERMISSION IS A HARD PREREQUISITE, and this package checks it rather than
// letting the platform swallow the request. Neither Apple nor Android reports an
// error for a notification posted without permission — it is accepted and never
// shown — so `schedule` reads the gate first and answers `Denied` instead.

import "stdlib/option" as option;
import "stdlib/status" as status;
import "stdlib/text" as text;
import "stdlib/vec" as vec;
import "permissions/permissions" as permissions;
import "facet/app_events" as ev;

// ---- what happened ------------------------------------------------------------
//
// THIS PACKAGE'S OWN VOCABULARY, and not `stdlib::Status`, for the reason
// `permissions::open_settings` records: `Status` has no arm meaning "the person
// has not allowed this" and none meaning "this platform cannot". Mapping either
// onto `InvalidInput` would blame the caller for a fact about the device, and
// the two are exactly what a caller needs to tell apart — one is answered by
// asking for the permission, the other by hiding the feature.
enum Outcome {
    Ok,
    // An empty id or an empty title. The caller's bug.
    InvalidInput,
    // The notification permission is not held. Ask for it — `permissions` is
    // this package's dependency precisely so the caller has somewhere to go.
    NotPermitted,
    // No notification backend on this platform.
    Unsupported,
    // The platform accepted the call and refused the notification. Rare, and
    // kept distinct from the three above because there is nothing to do about
    // it but report.
    Failed,
}

impl Outcome {
    // The wire form the seam speaks, and its inverse — one round trip, one pair.
    fn to_code(this) -> i32 {
        return match this {
            Outcome::Ok => 0 as i32,
            Outcome::InvalidInput => 1 as i32,
            Outcome::NotPermitted => 2 as i32,
            Outcome::Unsupported => 3 as i32,
            Outcome::Failed => 4 as i32,
        };
    }

    // An unrecognised code is `Failed`: the seam is a version boundary, and a
    // newer backend answering something this build has never heard of has
    // plainly not succeeded.
    fn from_code(c: i32) -> Outcome {
        if c == (0 as i32) { return Outcome::Ok; }
        if c == (1 as i32) { return Outcome::InvalidInput; }
        if c == (2 as i32) { return Outcome::NotPermitted; }
        if c == (3 as i32) { return Outcome::Unsupported; }
        return Outcome::Failed;
    }
}

// ---- when ---------------------------------------------------------------------
//
// Three shapes, and no more: an application that wants a calendar rule can
// compute the instant itself and use `At`. Repeating triggers are deliberately
// absent from this pass — they are a different lifetime problem (a repeat
// survives reinstalls on one platform and not the other) and belong with the
// tier that also handles actions and grouping.
enum When {
    // As soon as the platform will take it. NOT a promise of instantaneous:
    // both platforms may coalesce.
    Now,
    // Seconds from now. Apple's minimum interval is 60 for a repeating trigger
    // and 1 for a one-shot; below 1 this degrades to `Now` rather than being
    // refused, because a caller asking for "half a second" means "now".
    After(f64),
    // An absolute Unix timestamp in seconds. Past instants degrade to `Now` for
    // the same reason: a reminder whose moment has gone is still worth showing.
    At(f64),
}

// ---- what to show -------------------------------------------------------------

struct Notification {
    // THE HANDLE, caller-chosen rather than returned, because both platforms key
    // REPLACEMENT on it: scheduling twice with one id updates in place instead
    // of stacking a duplicate, which is what an "N unread" notification wants.
    // An empty id is refused — a notification nothing can cancel is a leak.
    id: str,
    title: str,
    body: str,
    when: When,
    // Opaque to this package and handed back verbatim on tap. THE DEEP LINK,
    // and a `str` rather than a URL on purpose: an application that wants a URL
    // puts one in, and one that wants "order:1234" is not made to invent a
    // scheme.
    payload: str,
    // ANDROID ONLY, and the earlier comment here claimed otherwise — it said
    // "Android channel id / Apple category id", which conflates two unrelated
    // things and would have shaped the actions tier wrongly.
    //
    // An Android CHANNEL is importance, sound and vibration: the per-app list a
    // person toggles in Settings. It is created once and says nothing about
    // content. An Apple CATEGORY is the ACTION SET — registered up front with
    // `setNotificationCategories:` and named by a notification that wants
    // buttons. They are orthogonal, and an application will eventually want to
    // set both, so `category` becomes its own field when actions land rather
    // than being squeezed in here. plans/notifications.md §10.
    //
    // `""` takes the package default, created lazily on first use. A channel
    // that does not exist makes Android drop the notification SILENTLY, which
    // is why it is never passed through unchecked.
    //
    // Ignored on Apple today.
    channel: str,
    // THE ACTION SET, and the other half of what `channel` used to pretend to
    // be. Names a set registered with `register_action`; `""` means a
    // notification with no buttons.
    //
    // Apple requires the set to exist BEFORE the notification is posted —
    // categories are registered with the centre up front and a notification
    // names one — so registering late means a notification with no buttons and
    // no error. Android has no such rule and this package remembers the set for
    // it, so one call order works on both.
    category: str,
    // CANNOT BE SWIPED AWAY. **ANDROID ONLY**, and named that way rather than
    // quietly ignored on Apple.
    //
    // iOS notifications are always dismissible and there is no API for this
    // there; `UNNotificationInterruptionLevel` decides whether a notification
    // pierces Focus and Live Activities are ActivityKit, a widget extension —
    // neither is "make this one stay".
    //
    // MACOS IS DIFFERENT, and an earlier version of this comment said it was
    // not. macOS has an ALERT style that stays on screen until somebody
    // interacts with it, and an app asks for it with an Info.plist key:
    //
    //     <key>NSUserNotificationAlertStyle</key><string>alert</string>
    //
    // That is APP-WIDE rather than per-notification — a plist key, not an API —
    // which is why this field stays Android-only rather than becoming portable.
    // A person can override it in System Settings, and their choice wins.
    // `examples/notifications_demo/bundle.sh` sets it.
    //
    // WHAT IT ACTUALLY BUYS, measured on an emulator rather than assumed:
    //
    //   the shade's Clear all   GONE while an ongoing notification is present
    //   swipe right             resists
    //   swipe left              dismisses it
    //   the app's own `cancel`  removes it, as it should
    //
    // Android 14 made ongoing notifications user-dismissible for an app with no
    // foreground service, and the shade implements that as a DIRECTIONAL
    // gesture. So this is "hard to get rid of", not "impossible" — an
    // application that needs one to truly persist needs a foreground service,
    // which is a different feature in a different package.
    //
    // Implies auto-cancel off: a notification meant to stay should not vanish
    // because somebody tapped it.
    sticky: bool,
    // RENDER THE ACTIONS AS AN ICON ROW rather than as text labels.
    // **ANDROID ONLY**, and measured rather than assumed: Android's ordinary
    // notification template shows action TITLES and ignores their icons, while
    // `Notification.MediaStyle` shows the icons as a compact row. MediaStyle
    // with no `MediaSession` token renders exactly that and nothing else — no
    // media area, no seek bar, no hardware keys, all of which come from the
    // session — so this buys the LOOK of a player's controls without pretending
    // to be one.
    //
    // Ignored on Apple, which has one action presentation and no choice in it.
    compact: bool,
    // A FULL-WIDTH IMAGE INSIDE THE NOTIFICATION — the shape a photo app or a
    // messaging app uses. An absolute path to a file this app can read.
    //
    // Both platforms have it and neither calls it the same thing: Android's
    // `BigPictureStyle` decodes a bitmap, Apple's `UNNotificationAttachment`
    // takes a file URL. Empty means an ordinary notification.
    //
    // MUTUALLY EXCLUSIVE WITH `compact`, and refused rather than silently
    // resolved: a notification has exactly ONE style on Android, so an icon row
    // and a photo cannot both be shown. Asking for both is a caller bug and
    // gets `InvalidInput`.
    picture: str,
}

impl Notification {
    // Content-taking constructor with the rest defaulted, per
    // `naming_guideline.md`: one signature instead of a family of overloads.
    fn new(id: str, title: str, body: str = "", when: When = When::Now,
           payload: str = "", channel: str = "",
           category: str = "", sticky: bool = false,
           compact: bool = false, picture: str = "") -> Notification {
        return Notification { id: id, title: title, body: body, when: when,
                              payload: payload, channel: channel,
                              category: category, sticky: sticky,
                              compact: compact, picture: picture };
    }
}

// ---- the verbs ----------------------------------------------------------------

// Post or schedule. Scheduling an id that is already pending REPLACES it.
//
// `NotPermitted` is checked HERE rather than left to the platform, which accepts
// a notification it will never show and reports nothing — the silent failure
// this package exists to prevent. It answers that only for a DEFINITE refusal;
// see `allowed`.
fn schedule(n: Notification) -> Outcome {
    if n.id == "" { return Outcome::InvalidInput; }
    if n.title == "" { return Outcome::InvalidInput; }
    // ONE STYLE PER NOTIFICATION. Android cannot show an icon row and a photo
    // at once, and quietly dropping one of them would make a caller debug the
    // platform instead of their own call.
    if n.compact && n.picture != "" { return Outcome::InvalidInput; }
    if !allowed() { return Outcome::NotPermitted; }
    let secs: f64 = delay_of(n.when);
    let rc: i32 = { cplus_notifications_schedule_v1(
        #str_ptr(n.id), #str_len(n.id),
        #str_ptr(n.title), #str_len(n.title),
        #str_ptr(n.body), #str_len(n.body),
        #str_ptr(n.payload), #str_len(n.payload),
        #str_ptr(n.channel), #str_len(n.channel),
        #str_ptr(n.category), #str_len(n.category),
        n.sticky, n.compact,
        #str_ptr(n.picture), #str_len(n.picture),
        secs) };
    return Outcome::from_code(rc);
}

// Would the platform show what this package posts? The permissions package owns
// the question; this is the one place its answer becomes a decision.
//
// IT REFUSES ONLY ON A DEFINITE NO. See the note on `Unknown` below — the first
// version refused on that too and broke the first post of every process.
fn allowed() -> bool {
    return match permissions::state(of: permissions::NOTIFICATIONS) {
        permissions::State::Granted => true,
        // A provisional authorisation on iOS delivers quietly to the
        // notification centre — that is showing, just not loudly — and refusing
        // there would be this package overruling a choice the person made.
        permissions::State::Limited => true,
        // `Unknown` MEANS "NOT KNOWN", AND REFUSING ON IGNORANCE IS WRONG.
        //
        // This used to return false, and it made the FIRST `schedule` of every
        // process fail on Apple even for an app whose permission was granted —
        // measured, with a probe that posted nothing and reported
        // `NotPermitted`. The cause is structural: Apple has no synchronous
        // read of the notification permission, so `permissions` answers from a
        // cache that is cold on the first call of a process and refreshes
        // asynchronously behind it. A gate that refuses on a cold cache refuses
        // on its own latency.
        //
        // The trade is between two failures, and they are not equal. Refusing
        // when the app is actually allowed BREAKS something the platform would
        // have done — that is a bug this package invented. Attempting when it is
        // not allowed reproduces exactly what the platform does on its own: the
        // notification is accepted and never shown. So `Unknown` attempts, and
        // the gate keeps its value for the states that are definitely refusals.
        permissions::State::Unknown => true,
        permissions::State::Denied => false,
        permissions::State::Blocked => false,
        permissions::State::Unsupported => false,
    };
}

// Seconds from now, whatever shape the caller used. Negative and sub-second
// delays collapse to 0, which every backend reads as "post immediately".
fn delay_of(w: When) -> f64 {
    return match w {
        When::Now => 0.0f64,
        When::After(s) => { if s < 1.0f64 { 0.0f64 } else { s } }
        When::At(t) => {
            let d: f64 = t - _now_seconds();
            if d < 1.0f64 { 0.0f64 } else { d }
        }
    };
}

// Cancel a pending notification by id. `Ok` whether or not one was pending —
// cancelling something already delivered or never scheduled is not an error,
// and making it one would force every caller to track state this package
// already tracks.
fn cancel(id: str) -> Outcome {
    if id == "" { return Outcome::InvalidInput; }
    return Outcome::from_code({ cplus_notifications_cancel_v1(#str_ptr(id), #str_len(id)) });
}

// Cancel everything this application scheduled. Does not touch notifications
// already shown and sitting in the shade — see `clear_shown`.
fn cancel_all() -> Outcome {
    return Outcome::from_code({ cplus_notifications_cancel_all_v1() });
}

// Remove this application's already-delivered notifications from the shade.
// Separate from `cancel_all` because they are different questions: one is about
// the future, one about the past, and an app that clears a badge on launch
// wants exactly this one.
fn clear_shown() -> Outcome {
    return Outcome::from_code({ cplus_notifications_clear_shown_v1() });
}

// Append the ids this package believes are still pending.
//
// APPENDS to a Vec the caller owns, so this package never hands back a
// collection whose lifetime it would then have to explain. The pointer form is
// the tree's idiom for an out-collection (`facet_gtk/chrome.cplus`,
// `facet_android/recycler.cplus`) and it is what crosses the seam unchanged.
//
// THE ANSWER IS THIS PACKAGE'S RECORD, not the platform's, and the two can
// disagree. Apple can be asked and Android cannot — `NotificationManager` has
// no listing API at all — so the record is kept here and persisted, and it is
// the only answer that can be given on both. It goes stale in one direction
// only: an entry may survive a notification the system already delivered.
fn pending(out: *vec::Vec[str]) -> Outcome {
    if out.is_null() { return Outcome::InvalidInput; }
    return Outcome::from_code({ cplus_notifications_pending_v1({ out as *u8 }) });
}

// ---- actions -------------------------------------------------------------------
//
// A notification can carry buttons. Both platforms have them and neither
// declares them the same way, which is why this is a VERB rather than a field:
//
//   Apple    a `UNNotificationCategory` holding `UNNotificationAction`s, set on
//            the centre UP FRONT. A notification names the category, and one
//            registered after the notification was posted does nothing.
//   Android  `addAction` per notification, built at post time, no registry.
//
// So actions are registered into a named set here, once, and the backend uses
// that set however its platform wants. Register at startup and the same code
// works on both; register late and Apple silently drops the buttons, which is
// the one ordering rule this package cannot paper over.
//
// AT MOST FOUR PER CATEGORY. Apple shows two on a banner and up to four when
// expanded; Android shows three. Beyond that the platform decides what to drop,
// which is a worse answer than refusing.

const MAX_ACTIONS: usize = 4 as usize;
const MAX_CATEGORIES: usize = 8 as usize;

struct Action { id: str, title: str, icon: str }
struct Category { name: str, actions: [Action; 4], count: usize, live: bool }

static CATEGORIES: [Category; 8] = #zero::[[Category; 8]]();

// Add a button to a named set. `Ok`, or:
//
//   InvalidInput  an empty category, id or title, or an id containing the
//                 separator this package uses to carry it — see `_ENCODE_SEP`
//   OutOfBounds   more than four actions in one set, or more than eight sets
//
// Registering the same (category, id) twice UPDATES the title rather than
// adding a second button.
// `icon` names a PLATFORM drawable — `"ic_media_play"`, `"ic_media_next"`,
// `"ic_menu_delete"` — resolved out of `android.R$drawable` at post time. A
// package has no resources of its own and an application's `R` class is not
// ours to read, so platform names are the one icon vocabulary that needs
// nothing from the caller's build. Empty takes a default.
//
// Ignored on Apple: `UNNotificationAction` has no icon.
fn register_action(category: str, id: str, title: str, icon: str = "") -> Outcome {
    if category == "" { return Outcome::InvalidInput; }
    if id == "" { return Outcome::InvalidInput; }
    if title == "" { return Outcome::InvalidInput; }
    // The id travels back inside one string alongside the payload, and the
    // split is on the FIRST separator. An id carrying one would move the seam.
    if id.count_of(SEP) > (0 as usize) { return Outcome::InvalidInput; }

    var slot: usize = MAX_CATEGORIES;
    var i: usize = 0 as usize;
    while i < MAX_CATEGORIES {
        if CATEGORIES[i].live && CATEGORIES[i].name == category { slot = i; break; }
        i = i +% (1 as usize);
    }
    if slot == MAX_CATEGORIES {
        i = 0 as usize;
        while i < MAX_CATEGORIES {
            if !CATEGORIES[i].live {
                CATEGORIES[i].live = true;
                CATEGORIES[i].name = text::intern(category);
                CATEGORIES[i].count = 0 as usize;
                slot = i;
                break;
            }
            i = i +% (1 as usize);
        }
    }
    if slot == MAX_CATEGORIES { return Outcome::Failed; }

    // Same id twice updates rather than duplicating.
    var a: usize = 0 as usize;
    while a < CATEGORIES[slot].count {
        if CATEGORIES[slot].actions[a].id == id {
            CATEGORIES[slot].actions[a].title = text::intern(title);
            CATEGORIES[slot].actions[a].icon = text::intern(icon);
            { cplus_notifications_publish_categories_v1() };
            return Outcome::Ok;
        }
        a = a +% (1 as usize);
    }
    if CATEGORIES[slot].count >= MAX_ACTIONS { return Outcome::Failed; }
    let n: usize = CATEGORIES[slot].count;
    CATEGORIES[slot].actions[n].id = text::intern(id);
    CATEGORIES[slot].actions[n].title = text::intern(title);
    CATEGORIES[slot].actions[n].icon = text::intern(icon);
    CATEGORIES[slot].count = n +% (1 as usize);
    // Apple needs the centre told; Android reads the table at post time. The
    // backend decides which, and this is the one call that says "it changed".
    { cplus_notifications_publish_categories_v1() };
    return Outcome::Ok;
}

// Forget every registered set. For tests, and for an application rebuilding its
// action sets from scratch.
fn clear_actions() -> Outcome {
    var i: usize = 0 as usize;
    while i < MAX_CATEGORIES {
        CATEGORIES[i].live = false;
        CATEGORIES[i].count = 0 as usize;
        i = i +% (1 as usize);
    }
    { cplus_notifications_publish_categories_v1() };
    return Outcome::Ok;
}

// How many actions a set holds. `0` for one that was never registered.
fn action_count(category: str) -> usize {
    let slot: usize = _category_slot(category);
    if slot >= MAX_CATEGORIES { return 0 as usize; }
    return CATEGORIES[slot].count;
}

fn _category_slot(category: str) -> usize {
    var i: usize = 0 as usize;
    while i < MAX_CATEGORIES {
        if CATEGORIES[i].live && CATEGORIES[i].name == category { return i; }
        i = i +% (1 as usize);
    }
    return MAX_CATEGORIES;
}

// ---- the backend's window on the table ---------------------------------------
//
// NOT APPLICATION API, and public only because C+ privacy is module-scoped:
// there is no package-private, and the per-platform half is a different module.
// A `_` prefix would be honest about the intent and would not compile.
//
// They are absent from `docs/ref.md` for that reason — an application has
// `register_action`, `clear_actions` and `action_count`, and nothing here.
fn action_id(category: str, index: usize) -> str {
    let slot: usize = _category_slot(category);
    if slot >= MAX_CATEGORIES { return ""; }
    if index >= CATEGORIES[slot].count { return ""; }
    return CATEGORIES[slot].actions[index].id;
}

fn action_icon(category: str, index: usize) -> str {
    let slot: usize = _category_slot(category);
    if slot >= MAX_CATEGORIES { return ""; }
    if index >= CATEGORIES[slot].count { return ""; }
    return CATEGORIES[slot].actions[index].icon;
}

fn action_title(category: str, index: usize) -> str {
    let slot: usize = _category_slot(category);
    if slot >= MAX_CATEGORIES { return ""; }
    if index >= CATEGORIES[slot].count { return ""; }
    return CATEGORIES[slot].actions[index].title;
}

fn category_name(index: usize) -> str {
    if index >= MAX_CATEGORIES { return ""; }
    if !CATEGORIES[index].live { return ""; }
    return CATEGORIES[index].name;
}

// THE SEPARATOR that carries an action id back alongside the payload.
//
// A tap has to say WHICH BUTTON, and the road home is a single opaque string:
// `AppEvent.text` on both platforms, an Intent extra on Android. Rather than
// widen facet's event for one package, the two are packed here and split on the
// FIRST occurrence — so an action id may not contain it (checked at
// registration) and a payload may contain anything at all.
//
// ASCII 0x1F, "unit separator", which exists for exactly this and cannot appear
// in a sane identifier.
const SEP: str = "";

fn encode_tap(action: str, payload: str) -> text::Text {
    var t: text::Text = text::from_str(action);
    let _a: status::Status = t.append(SEP);
    let _b: status::Status = t.append(payload);
    return t;
}

// ---- taps ----------------------------------------------------------------------
//
// A tap hands back the notification's `payload` and nothing else. The tap is a
// ROUTING EVENT — an application that needs more than a string puts more in the
// string — and keeping it to one argument is what lets both platforms deliver
// through the same door despite arriving by completely different roads:
// `UNUserNotificationCenterDelegate` on Apple, the Activity's intent on Android.
//
// THE COLD-START CASE IS HANDLED, and it is the reason this rides
// `facet/app_events` rather than a callback of its own. A tap on a notification
// while the app is DEAD launches it, and the payload arrives around process
// start — before this package, or the application, has subscribed to anything.
// `app_events` LATCHES that kind, so a handler registered later is still handed
// it. Without the latch, taps would work on a warm app and silently do nothing
// on a cold one, which only reproduces from a killed process.
//
// So `on_tap` is safe to call whenever: at startup, from a screen's
// `on_attach`, or after a route change.

// The application's handler slot. ONE, not a list: a tap is a routing decision
// and two routers disagreeing about one payload is a bug, not a feature. An
// application that wants to fan out does it on its own side, where it can say
// which wins.
static TAP: fn(str, str, *u8) = 0 as fn(str, str, *u8);
static TAP_CTX: *u8 = 0 as *u8;
static SUBSCRIBED: bool = false;

// Route taps to `f`. `InvalidInput` for a null handler; `Ok` otherwise, and a
// second call REPLACES the first.
//
// If a tap already happened — including the one that launched the app — the
// handler is called before this returns.
fn on_tap(f: fn(str, str, *u8), ctx: *u8 = 0 as *u8) -> Outcome {
    if f == (0 as fn(str, str, *u8)) { return Outcome::InvalidInput; }
    TAP = f;
    TAP_CTX = ctx;
    if !SUBSCRIBED {
        SUBSCRIBED = true;
        // Subscribing REPLAYS whatever `app_events` has latched, so a launch
        // tap reaches `_on_app_event` here and then the handler above.
        let _s: status::Status = ev::on_app_event(_on_app_event, 0 as *u8);
        return Outcome::Ok;
    }
    // Already subscribed, so the replay has been and gone. Hand the last tap
    // over directly, so swapping handlers mid-run does not lose a payload that
    // arrived before the swap.
    if LAST_TAP != "" { f(LAST_TAP, LAST_ACTION, ctx); }
    return Outcome::Ok;
}

// Stop routing taps. The subscription stays: it is one slot in a sixteen-slot
// list, costs nothing idle, and taking it out would drop the latch replay for a
// handler installed later.
fn off_tap() -> Outcome {
    TAP = 0 as fn(str, str, *u8);
    TAP_CTX = 0 as *u8;
    return Outcome::Ok;
}

// The last payload seen, interned. Held so a handler installed after a tap —
// or swapped for another — is not the one call that misses it.
static LAST_TAP: str = "";
// Which button, or `""` for a tap on the notification body itself.
static LAST_ACTION: str = "";

// The index of the first separator byte, or the string's length when there is
// none. Byte-wise on purpose: the separator is ASCII 0x1F and cannot be part of
// a multi-byte sequence, so this cannot cut a character in half.
// `str::slice` answers an Option; a range this code computed itself is always
// in bounds, and the interned copy is what the latch and the handler share.
fn _slice_or_empty(s: str, from: usize, to: usize) -> str {
    match s.slice(from: from, to: to) {
        option::Option[str]::Some(v) => { return text::intern(v); }
        option::Option[str]::None => { return ""; }
    }
}

fn _first_sep(s: str) -> usize {
    let n: usize = #str_len(s);
    let p: *u8 = #str_ptr(s);
    var i: usize = 0 as usize;
    while i < n {
        if { *(p + i) } == (31 as u8) { return i; }
        i = i +% (1 as usize);
    }
    return n;
}

fn _on_app_event(e: *ev::AppEvent, ctx: *u8) {
    if { (*e).kind } != ev::E_NOTIFICATION_TAP { return; }
    // SPLIT ON THE FIRST SEPARATOR, then intern both halves: `AppEvent.text` is
    // borrowed for this dispatch and not one instant longer. An action id
    // cannot contain the separator (checked at registration) and a payload can
    // contain anything, which is why the split is first-occurrence and not last.
    let raw: str = { (*e).text };
    let cut: usize = _first_sep(raw);
    if cut == #str_len(raw) {
        // No separator: an older backend, or a tap this package did not encode.
        // The whole string is the payload and no button was pressed.
        LAST_ACTION = "";
        LAST_TAP = text::intern(raw);
    } else {
        LAST_ACTION = _slice_or_empty(raw, 0 as usize, cut);
        LAST_TAP = _slice_or_empty(raw, cut +% (1 as usize), #str_len(raw));
    }
    let f: fn(str, str, *u8) = TAP;
    if f != (0 as fn(str, str, *u8)) { f(LAST_TAP, LAST_ACTION, TAP_CTX); }
    return;
}

// ---- the seam -----------------------------------------------------------------
//
// Implemented by whichever `notifications_backend*.cplus` this platform
// compiled. Stable symbols rather than an import, because the backend imports
// this module for `Notification` and a cycle back is rejected (E0404) — the same
// one-way arrangement `http.cplus` and `permissions.cplus` document.
//
// Every string crosses as `(*u8, usize)`: a `str` is a fat pointer with no
// C-ABI counterpart and cannot be an `export extern fn` parameter (E0410). The
// backend rebuilds each view with `#str_from_raw_parts`.

extern fn cplus_notifications_schedule_v1(
    id_ptr: *u8, id_len: usize,
    title_ptr: *u8, title_len: usize,
    body_ptr: *u8, body_len: usize,
    payload_ptr: *u8, payload_len: usize,
    channel_ptr: *u8, channel_len: usize,
    category_ptr: *u8, category_len: usize,
    sticky: bool,
    compact: bool,
    picture_ptr: *u8, picture_len: usize,
    delay_seconds: f64) -> i32;

extern fn cplus_notifications_cancel_v1(id_ptr: *u8, id_len: usize) -> i32;
extern fn cplus_notifications_cancel_all_v1() -> i32;

// Tell the backend the action sets changed. Apple registers categories with the
// centre up front; Android reads the table at post time and does nothing here.
extern fn cplus_notifications_publish_categories_v1();
extern fn cplus_notifications_clear_shown_v1() -> i32;

// `out` is a `*vec::Vec[str]` the backend appends interned ids to. Opaque
// across the seam for the same fat-pointer reason as everything else.
extern fn cplus_notifications_pending_v1(out: *u8) -> i32;

#[link_name = "time"]
extern fn c_time(t: *u8) -> i64;

// This process's wall clock, for `When::At`'s arithmetic. Module-private: an
// application building an `At` uses `stdlib/time::now()`, which is the clock
// the rest of the tree already reads.
fn _now_seconds() -> f64 {
    return { c_time(0 as *u8) } as f64;
}

// ---- tests --------------------------------------------------------------------
// The portable half only: the `When` arithmetic, the guards, and the code map.
// Anything that reaches a platform lives next to the backend that reaches it.

#[test]
fn now_and_sub_second_delays_collapse_to_zero() {
    assert delay_of(When::Now) == 0.0f64;
    // "Half a second" means now; refusing it would make a caller round.
    assert delay_of(When::After(0.5f64)) == 0.0f64;
    assert delay_of(When::After(0.0f64)) == 0.0f64;
}

#[test]
fn an_interval_survives_intact() {
    assert delay_of(When::After(60.0f64)) == 60.0f64;
    assert delay_of(When::After(3600.0f64)) == 3600.0f64;
}

#[test]
fn a_past_instant_degrades_to_now_rather_than_being_refused() {
    // A reminder whose moment has gone is still worth showing.
    assert delay_of(When::At(1.0f64)) == 0.0f64;
    assert delay_of(When::At(_now_seconds() - 500.0f64)) == 0.0f64;
}

#[test]
fn a_future_instant_becomes_a_delay() {
    let d: f64 = delay_of(When::At(_now_seconds() + 120.0f64));
    // Within a second of 120: `_now_seconds` is read twice and the clock moves.
    assert d > 118.0f64 && d <= 120.0f64;
}

#[test]
fn an_empty_id_or_title_is_refused_before_the_permission_is_read() {
    // Ordered deliberately: a caller with a malformed notification should be
    // told that, not told the permission is missing.
    assert schedule(Notification::new("", "Title")) == Outcome::InvalidInput;
    assert schedule(Notification::new("id", "")) == Outcome::InvalidInput;
    assert cancel("") == Outcome::InvalidInput;
}

#[test]
fn the_constructor_defaults_everything_but_id_and_title() {
    let n: Notification = Notification::new("a", "Hello");
    assert n.id == "a";
    assert n.title == "Hello";
    assert n.body == "";
    assert n.payload == "";
    assert n.channel == "";
    assert delay_of(n.when) == 0.0f64;
}

#[test]
fn every_outcome_round_trips_and_an_unknown_code_is_failed() {
    assert Outcome::from_code(Outcome::Ok.to_code()) == Outcome::Ok;
    assert Outcome::from_code(Outcome::InvalidInput.to_code()) == Outcome::InvalidInput;
    assert Outcome::from_code(Outcome::NotPermitted.to_code()) == Outcome::NotPermitted;
    assert Outcome::from_code(Outcome::Unsupported.to_code()) == Outcome::Unsupported;
    assert Outcome::from_code(Outcome::Failed.to_code()) == Outcome::Failed;
    // A newer backend answering a code this build does not know has plainly
    // not succeeded.
    assert Outcome::from_code(99 as i32) == Outcome::Failed;
    // NotPermitted and InvalidInput must never collapse: one is answered by
    // asking for the permission, the other by fixing the call.
    assert Outcome::NotPermitted.to_code() != Outcome::InvalidInput.to_code();
}

// ---- action tests --------------------------------------------------------------

#[test]
fn an_action_needs_a_category_an_id_and_a_title() {
    let _c: Outcome = clear_actions();
    assert register_action("", "id", "Title") == Outcome::InvalidInput;
    assert register_action("cat", "", "Title") == Outcome::InvalidInput;
    assert register_action("cat", "id", "") == Outcome::InvalidInput;
    assert action_count("cat") == (0 as usize);
}

#[test]
fn an_id_carrying_the_separator_is_refused() {
    // The id travels home packed in front of the payload and the split is on
    // the FIRST separator, so an id containing one would move the seam and
    // hand the caller half its own payload as an action name.
    let _c: Outcome = clear_actions();
    assert register_action("cat", "a\x1fb", "Title") == Outcome::InvalidInput;
    assert action_count("cat") == (0 as usize);
}

#[test]
fn actions_accumulate_into_a_named_set() {
    let _c: Outcome = clear_actions();
    assert register_action("mail", "reply", "Reply") == Outcome::Ok;
    assert register_action("mail", "archive", "Archive") == Outcome::Ok;
    assert action_count("mail") == (2 as usize);
    assert action_id("mail", 0 as usize) == "reply";
    assert action_title("mail", 1 as usize) == "Archive";
    // A set nobody registered is empty rather than an error: naming one is the
    // same as naming none, on both platforms.
    assert action_count("nobody") == (0 as usize);
    assert action_id("mail", 9 as usize) == "";
}

#[test]
fn registering_the_same_id_updates_rather_than_duplicating() {
    let _c: Outcome = clear_actions();
    let _a: Outcome = register_action("mail", "reply", "Reply");
    let _b: Outcome = register_action("mail", "reply", "Reply now");
    assert action_count("mail") == (1 as usize);
    assert action_title("mail", 0 as usize) == "Reply now";
}

#[test]
fn a_fifth_action_is_refused_rather_than_silently_dropped() {
    // Apple shows two on a banner and four expanded; Android shows three.
    // Past that the platform decides what to drop, which is a worse answer
    // than refusing.
    let _c: Outcome = clear_actions();
    let _1: Outcome = register_action("many", "a", "A");
    let _2: Outcome = register_action("many", "b", "B");
    let _3: Outcome = register_action("many", "c", "C");
    let _4: Outcome = register_action("many", "d", "D");
    assert action_count("many") == (4 as usize);
    assert register_action("many", "e", "E") == Outcome::Failed;
    assert action_count("many") == (4 as usize);
}

#[test]
fn clearing_forgets_every_set() {
    let _c: Outcome = clear_actions();
    let _a: Outcome = register_action("one", "x", "X");
    let _b: Outcome = register_action("two", "y", "Y");
    assert action_count("one") == (1 as usize);
    let _d: Outcome = clear_actions();
    assert action_count("one") == (0 as usize);
    assert action_count("two") == (0 as usize);
    assert category_name(0 as usize) == "";
}

#[test]
fn an_action_and_a_payload_pack_and_split_on_the_first_separator() {
    // The payload may contain anything, including the separator; the action
    // may not. That asymmetry is why the split is first-occurrence.
    var e: text::Text = encode_tap("reply", "order:1234");
    assert { e.view() } == "reply\x1forder:1234";
    assert _first_sep({ e.view() }) == (5 as usize);

    var body: text::Text = encode_tap("", "order:1234");
    assert _first_sep({ body.view() }) == (0 as usize);

    // A payload with its own separator still splits in the right place.
    var odd: text::Text = encode_tap("go", "a\x1fb");
    assert _first_sep({ odd.view() }) == (2 as usize);
}

#[test]
fn a_string_with_no_separator_is_all_payload() {
    // An older backend, or a tap this package did not encode. The whole string
    // is the payload and no button was pressed — never the other way round,
    // which would invent an action out of a deep link.
    let raw: str = "order:1234";
    assert _first_sep(raw) == #str_len(raw);
}

#[test]
fn a_notification_can_name_a_category() {
    let n: Notification = Notification::new("id", "Title", category: "mail");
    assert n.category == "mail";
    // And defaults to none, which is a notification with no buttons.
    let plain: Notification = Notification::new("id", "Title");
    assert plain.category == "";
}

#[test]
fn sticky_is_off_by_default_and_settable() {
    let plain: Notification = Notification::new("id", "Title");
    assert plain.sticky == false;
    let stuck: Notification = Notification::new("id", "Title", sticky: true);
    assert stuck.sticky;
}

#[test]
fn sticky_is_independent_of_every_other_field() {
    // It is a one-platform flag and must not be entangled with the portable
    // ones — an Apple build reads the same struct and ignores this field.
    let n: Notification = Notification::new("id", "Title", body: "b",
                                            when: When::After(5.0f64),
                                            payload: "p", channel: "c",
                                            category: "cat", sticky: true);
    assert n.sticky;
    assert n.category == "cat";
    assert n.channel == "c";
    assert n.payload == "p";
    assert delay_of(n.when) == 5.0f64;
}

#[test]
fn a_picture_and_a_compact_row_cannot_both_be_asked_for() {
    // Android has exactly ONE style per notification, so an icon row and a
    // photo are mutually exclusive. Refused rather than silently resolved —
    // picking a winner here would make a caller debug the platform instead of
    // their own call.
    assert schedule(Notification::new("id", "T", compact: true, picture: "/tmp/a.png"))
        == Outcome::InvalidInput;
    // Either alone is fine as far as this guard is concerned.
    assert schedule(Notification::new("id", "T", compact: true))
        != Outcome::InvalidInput;
    assert schedule(Notification::new("id", "T", picture: "/tmp/a.png"))
        != Outcome::InvalidInput;
}

#[test]
fn a_picture_defaults_to_none() {
    assert Notification::new("id", "T").picture == "";
    assert Notification::new("id", "T", picture: "/x.png").picture == "/x.png";
}

#[test]
fn the_gate_refuses_only_a_definite_no() {
    // `Unknown` attempts. Apple has no synchronous read of the notification
    // permission, so a cold cache answers `Unknown` on the first call of a
    // process — and refusing there made the first `schedule` of every run fail
    // for an app that was actually allowed. Measured with a probe before this
    // was written.
    assert gate(permissions::State::Granted);
    assert gate(permissions::State::Limited);
    assert gate(permissions::State::Unknown);
    assert gate(permissions::State::Denied) == false;
    assert gate(permissions::State::Blocked) == false;
    assert gate(permissions::State::Unsupported) == false;
}

// The decision `allowed` makes, split from the platform read so it can be
// tested without one.
fn gate(s: permissions::State) -> bool {
    return match s {
        permissions::State::Granted => true,
        permissions::State::Limited => true,
        permissions::State::Unknown => true,
        permissions::State::Denied => false,
        permissions::State::Blocked => false,
        permissions::State::Unsupported => false,
    };
}
