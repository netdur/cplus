    fn bounding_circle_for_contour(contour: Contour, error: *u8) -> option::Option[Circle] {
        let obj: *u8 = rt::msg_id_id_id(rt::get_class(#str_ptr("VNGeometryUtils\0")), rt::sel(#str_ptr("boundingCircleForContour:error:\0")), contour.raw(), error);
        if obj == { 0 as *u8 } {
            return option::Option[Circle]::None;
        }
        return option::some(Circle::from_raw(obj));
    }

    fn bounding_circle_for_points(points: vec::Vec[Point], error: *u8) -> option::Option[Circle] {
        let arr_points: *u8 = rt::msg_id(rt::get_class(#str_ptr("NSMutableArray\0")), rt::sel(#str_ptr("array\0")));
        let add_sel_points: *u8 = rt::sel(#str_ptr("addObject:\0"));
        let n_points: usize = points.count();
        var i_points: usize = 0 as usize;
        while i_points < n_points {
            match points.at_ptr(i_points) {
                option::Option[*Point]::Some(e_points) => { rt::msg_void_id(arr_points, add_sel_points, (*e_points).raw()); }
                option::Option[*Point]::None => {}
            }
            i_points = i_points +% (1 as usize);
        }
        let obj: *u8 = rt::msg_id_id_id(rt::get_class(#str_ptr("VNGeometryUtils\0")), rt::sel(#str_ptr("boundingCircleForPoints:error:\0")), arr_points, error);
        if obj == { 0 as *u8 } {
            return option::Option[Circle]::None;
        }
        return option::some(Circle::from_raw(obj));
    }

    fn bounding_circle_for_simd_points(points: *u8, point_count: i64, error: *u8) -> option::Option[Circle] {
        let obj: *u8 = rt::msg_id_id_i64_id(rt::get_class(#str_ptr("VNGeometryUtils\0")), rt::sel(#str_ptr("boundingCircleForSIMDPoints:pointCount:error:\0")), points, point_count, error);
