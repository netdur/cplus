        return objc_msg_i8_id_id_i8_id(rt::get_class(#str_ptr("VNGeometryUtils\0")), rt::sel(#str_ptr("calculateArea:forContour:orientedArea:error:\0")), area, for_contour.raw(), oriented_area as i8, error) != (0 as i8);
