// facet_appkit scrolling — `observe_scrolled`, for every kind that scrolls.
//
// Four controls declare it — `scroll`, `list`, `collection`, `carousel` — and
// on AppKit all four are an NSScrollView, so this is one mechanism rather than
// four. None of them had it.
//
// ---- why a notification and not a subclass -----------------------------------
//
// `input.cplus` answers the pointer band by moving a view's isa onto a runtime
// subclass, because a gesture has to be able to DECLINE and a recognizer
// cannot. Scrolling is the opposite case: there is nothing to decline, the
// scroll has already happened, and `scrollWheel:` would miss every scroll that
// did not come from a wheel — a scroller drag, a `scrollRowToVisible:`, a
// keyboard page-down, an accessibility client.
//
// What is true for all of those is that the CLIP VIEW's bounds moved. AppKit
// posts that as `NSViewBoundsDidChangeNotification` once
// `postsBoundsChangedNotifications` is on, and it is the only place that sees
// every scroll however it was caused.
//
// ---- lifetime ----------------------------------------------------------------
//
// The observer is an object pinned to the scroll view, so it dies with it, and
// it removes itself from the notification centre on the way out — a centre
// holds its observers UNRETAINED, so one that outlives its object is a dangling
// pointer the next notification walks into.

import "stdlib/option" as option;
import "facet/facet" as core;
import "facet/props" as props;
import "facet/scroll" as scroll;
import "facet/list" as list;
import "facet/collection" as collection;
import "facet/carousel" as carousel;
import "objc/runtime" as rt;
import "objc/synthesis" as synth;
import "objc/bridge" as bridge;
import "appkit/appkit" as ak;
import "appkit/appkit_ext" as akx;
import "flex_layout/flex_layout" as flex;

fn node_key() -> *u8 { return { 29060 as *u8 }; }
fn observer_pin_key() -> *u8 { return { 29061 as *u8 }; }

fn node_of(obj: *u8) -> *core::Node {
    if obj == (0 as *u8) { return 0 as *core::Node; }
    return { synth::get_associated(obj, node_key()) as *core::Node };
}

// The handler is read out of the props at fire time, per kind — the same rule
// the text and list delegates follow, so a handler swapped after mount is
// answered by the new one with nothing re-installed.
fn scrolled_handler(n: *core::Node) -> fn(*u8, *u8) {
    let d: *core::Data = core::node_data(n);
    if d == (0 as *core::Data) { return props::no_handler; }
    let raw: *u8 = { (*d).props };
    if raw == (0 as *u8) { return props::no_handler; }
    let kind: u32 = { (*d).kind };
    if kind == props::K_SCROLL { return { (*(raw as *props::ScrollProps)).observe_scrolled }; }
    if kind == props::K_LIST { return { (*(raw as *props::ListProps)).observe_scrolled }; }
    // `collection` and `carousel` inherit it from the ledger's ItemsView, so the
    // handler lives in the embedded band rather than on the control.
    if kind == props::K_COLLECTION {
        let iv: *props::ItemsViewProps = { #addr_of((*(raw as *props::CollectionProps)).items_view) };
        return { (*iv).observe_scrolled };
    }
    if kind == props::K_CAROUSEL {
        let iv: *props::ItemsViewProps = { #addr_of((*(raw as *props::CarouselProps)).items_view) };
        return { (*iv).observe_scrolled };
    }
    return props::no_handler;
}

fn scrolled_ctx(n: *core::Node) -> *u8 {
    let d: *core::Data = core::node_data(n);
    if d == (0 as *core::Data) { return 0 as *u8; }
    let raw: *u8 = { (*d).props };
    if raw == (0 as *u8) { return 0 as *u8; }
    let kind: u32 = { (*d).kind };
    if kind == props::K_SCROLL { return { (*(raw as *props::ScrollProps)).observe_scrolled_ctx }; }
    if kind == props::K_LIST { return { (*(raw as *props::ListProps)).observe_scrolled_ctx }; }
    if kind == props::K_COLLECTION {
        let iv: *props::ItemsViewProps = { #addr_of((*(raw as *props::CollectionProps)).items_view) };
        return { (*iv).observe_scrolled_ctx };
    }
    if kind == props::K_CAROUSEL {
        let iv: *props::ItemsViewProps = { #addr_of((*(raw as *props::CarouselProps)).items_view) };
        return { (*iv).observe_scrolled_ctx };
    }
    return 0 as *u8;
}

fn scrolls(kind: u32) -> bool {
    return kind == props::K_SCROLL || kind == props::K_LIST
        || kind == props::K_COLLECTION || kind == props::K_CAROUSEL;
}

fn bounds_changed_imp(self_obj: *u8, cmd: *u8, note: *u8) {
    let n: *core::Node = node_of(self_obj);
    if n == (0 as *core::Node) { return; }
    let view: *u8 = core::view_of(n);
    // Everything below is DERIVED from a scroll rather than reported by
    // AppKit, and this is the only place that sees one — which is why they
    // live here and not in the control's apply body.
    carousel_position(n, view);
    remaining_threshold(n, view);
    record_offset(n, view);
    let h: fn(*u8, *u8) = scrolled_handler(n);
    if h == props::no_handler { return; }
    // The sender is the node's own view, not the clip view: every other
    // handler in this package hands back the thing the application named, and
    // `component::key_of` is written against that.
    h(view, scrolled_ctx(n));
    return;
}

// Where the scroll IS, written back into the props.
//
// `scroll_x()` and `scroll_y()` read the props, so the props have to be true —
// the same contract the text controls keep for `text()`. Nothing kept it: the
// two fields existed and no code on either side of the boundary ever touched
// them, so the reads answered 0 for the life of the program and the offset was
// unreadable as well as unwritable.
//
// The clip view's bounds origin IS the offset. The document view is flipped, so
// y grows downward and matches what `set_scroll_y` means.
fn record_offset(n: *core::Node, view: *u8) {
    if view == (0 as *u8) { return; }
    let d: *core::Data = core::node_data(n);
    if d == (0 as *core::Data) { return; }
    if { (*d).kind } != props::K_SCROLL { return; }
    let p: *props::ScrollProps = { (*d).props } as *props::ScrollProps;
    if p == (0 as *props::ScrollProps) { return; }
    let clip: *u8 = { rt::msg_id(view, rt::sel(#str_ptr("contentView\0"))) };
    if clip == (0 as *u8) { return; }
    let b: rt::Rect = ak::View::from_raw(clip).bounds();
    { (*p).scroll_x = { b.x } };
    { (*p).scroll_y = { b.y } };
    return;
}

// ---- what a scroll implies ---------------------------------------------------

fn items_view_of(n: *core::Node) -> *props::ItemsViewProps {
    let d: *core::Data = core::node_data(n);
    if d == (0 as *core::Data) { return 0 as *props::ItemsViewProps; }
    let raw: *u8 = { (*d).props };
    if raw == (0 as *u8) { return 0 as *props::ItemsViewProps; }
    let kind: u32 = { (*d).kind };
    if kind == props::K_COLLECTION {
        return { #addr_of((*(raw as *props::CollectionProps)).items_view) };
    }
    if kind == props::K_CAROUSEL {
        return { #addr_of((*(raw as *props::CarouselProps)).items_view) };
    }
    return 0 as *props::ItemsViewProps;
}

// Which child sits at the scroll's leading edge. A carousel's `position` is an
// INDEX and a scroll view's truth is an offset, so the index is the child whose
// frame contains the offset — read off flex, which already laid them out, so
// this measures nothing of its own.
fn index_at_offset(n: *core::Node, view: *u8) -> i64 {
    let clip: *u8 = { rt::msg_id(view, rt::sel(#str_ptr("contentView\0"))) };
    if clip == (0 as *u8) { return 0 as i64; }
    let b: rt::Rect = ak::View::from_raw(clip).bounds();
    let x: f64 = { b.x };
    let y: f64 = { b.y };
    var i: usize = 0 as usize;
    let count: usize = core::child_count_of(n);
    while i < count {
        match core::child_of(n, i) {
            option::Option[*core::Node]::Some(c) => {
                let f: flex::Frame = { (*c).frame() };
                // BOTH spans, not either: a carousel may page along x or along
                // y, and a child whose horizontal span contains the offset is
                // every child of a vertical stack. Requiring both makes one
                // answer serve either orientation.
                let in_x: bool = x >= { f.left } && x < { f.left } + { f.width };
                let in_y: bool = y >= { f.top } && y < { f.top } + { f.height };
                if in_x && in_y { return i as i64; }
            }
            option::Option[*core::Node]::None => { }
        }
        i = i +% (1 as usize);
    }
    return 0 as i64;
}

// `position`, `is_scrolling`, and the two handlers that ride them. All three
// are contract READS or events with no AppKit source: a scroll view reports an
// offset and nothing else, so facet's answer is derived here and written back
// so the cursor reads it like any other prop.
fn carousel_position(n: *core::Node, view: *u8) {
    if core::kind_of(n) != props::K_CAROUSEL { return; }
    let d: *core::Data = core::node_data(n);
    if d == (0 as *core::Data) { return; }
    let p: *props::CarouselProps = { (*d).props } as *props::CarouselProps;
    if p == (0 as *props::CarouselProps) { return; }
    // A scroll is in progress by definition: this fires FROM one. It is
    // cleared when the scroll settles, which is the `after` below.
    { (*p).is_scrolling = true };
    let want: i64 = index_at_offset(n, view);
    if want != { (*p).position } {
        { (*p).position = want };
        fire_h({ (*p).on_position_changed }, { (*p).on_position_changed_ctx }, view);
        // The ledger reports the ITEM and the POSITION separately, and on this
        // backend a position change is always an item change — the items are
        // the children and the position indexes them.
        fire_h({ (*p).on_current_item_changed }, { (*p).on_current_item_changed_ctx }, view);
    }
    settle_scrolling(n, view);
    return;
}

fn fire_h(h: fn(*u8, *u8), ctx: *u8, sender: *u8) {
    if h == props::no_handler { return; }
    h(sender, ctx);
    return;
}

// `is_scrolling` has no "stopped" event on AppKit — a scroll simply stops
// arriving. So the flag is cleared on a timer that each scroll pushes forward,
// and the token is kept so a scroll in progress cancels the pending clear
// rather than stacking one per frame.
fn settle_key() -> *u8 { return { 29062 as *u8 }; }

fn scroll_settled(ctx: *u8) {
    let n: *core::Node = ctx as *core::Node;
    if n == (0 as *core::Node) { return; }
    let d: *core::Data = core::node_data(n);
    if d == (0 as *core::Data) { return; }
    if { (*d).kind } != props::K_CAROUSEL { return; }
    let p: *props::CarouselProps = { (*d).props } as *props::CarouselProps;
    if p == (0 as *props::CarouselProps) { return; }
    { (*p).is_scrolling = false };
    return;
}

fn settle_scrolling(n: *core::Node, view: *u8) {
    let pending: u64 = { synth::get_associated(view, settle_key()) as u64 };
    if pending != (0 as u64) { akx::cancel_after(pending); }
    let f: fn(*u8) = scroll_settled;
    let id: u64 = akx::after(0.15f64, f, n as *u8);
    synth::set_associated(view, settle_key(), id as *u8);
    return;
}

// `RemainingItemsThreshold`: fire once when the tail comes within N items of
// the end, and not again until the scroll leaves and comes back — a handler
// that loads the next page must not be asked for it on every scrolled pixel.
fn threshold_key() -> *u8 { return { 29063 as *u8 }; }

fn remaining_threshold(n: *core::Node, view: *u8) {
    let iv: *props::ItemsViewProps = items_view_of(n);
    if iv == (0 as *props::ItemsViewProps) { return; }
    let threshold: i64 = { (*iv).remaining_threshold };
    if threshold <= (0 as i64) { return; }
    let count: i64 = core::child_count_of(n) as i64;
    if count <= (0 as i64) { return; }
    let at: i64 = index_at_offset(n, view);
    let armed: bool = { synth::get_associated(view, threshold_key()) } != (0 as *u8);
    let inside: bool = (count - at) <= threshold;
    if inside == armed { return; }
    if inside {
        synth::set_associated(view, threshold_key(), 1 as *u8);
        fire_h({ (*iv).on_remaining_items_threshold_reached },
               { (*iv).on_remaining_items_threshold_reached_ctx }, view);
    } else {
        synth::set_associated(view, threshold_key(), 0 as *u8);
    }
    return;
}

fn observer_class() -> *u8 {
    let existing: *u8 = rt::get_class(#str_ptr("FacetScrollObserver\0"));
    if existing != (0 as *u8) { return existing; }
    let cls: *u8 = synth::allocate_class_pair(rt::get_class(#str_ptr("NSObject\0")),
                                              #str_ptr("FacetScrollObserver\0"), 0 as usize);
    synth::add_method_v_1id(cls, rt::sel(#str_ptr("facetBoundsChanged:\0")),
                            bounds_changed_imp, #str_ptr("v@:@\0"));
    synth::register_class_pair(cls);
    return cls;
}

fn notification_center() -> *u8 {
    return { rt::msg_id(rt::get_class(#str_ptr("NSNotificationCenter\0")),
                        rt::sel(#str_ptr("defaultCenter\0"))) };
}

// Install once per scroll view, from `create`. Idempotent: a second call finds
// the pin and leaves the first observer in place, so a re-apply cannot stack
// two observers and fire twice.
fn install(view: *u8, n: *core::Node) {
    if view == (0 as *u8) || n == (0 as *core::Node) { return; }
    if { synth::get_associated(view, observer_pin_key()) } != (0 as *u8) { return; }
    let sv: ak::ScrollView = ak::ScrollView::from_raw(view);
    let clip: *u8 = { rt::msg_id(view, rt::sel(#str_ptr("contentView\0"))) };
    if clip == (0 as *u8) { return; }
    // Off by default, because it costs a notification per scrolled pixel.
    { rt::msg_void_i8(clip, rt::sel(#str_ptr("setPostsBoundsChangedNotifications:\0")),
                      true as i8) };
    let o: *u8 = synth::alloc_init_class(observer_class());
    if o == (0 as *u8) { return; }
    synth::set_associated(o, node_key(), n as *u8);
    { msg_void_4id_decl(notification_center(),
                       rt::sel(#str_ptr("addObserver:selector:name:object:\0")),
                       o, rt::sel(#str_ptr("facetBoundsChanged:\0")),
                       bridge::nsstring("NSViewBoundsDidChangeNotification"), clip) };
    synth::retain_associated(view, observer_pin_key(), o);
    rt::release(o);
    return;
}

// Called from the node's view release. A notification centre holds observers
// UNRETAINED, so an observer that outlives its registration is a dangling
// pointer the next scroll walks into — this is not optional cleanup.
fn uninstall(view: *u8) {
    if view == (0 as *u8) { return; }
    let o: *u8 = { synth::get_associated(view, observer_pin_key()) };
    if o == (0 as *u8) { return; }
    { rt::msg_void_id(notification_center(), rt::sel(#str_ptr("removeObserver:\0")), o) };
    synth::set_associated(view, observer_pin_key(), 0 as *u8);
    return;
}

#[link_name = "objc_msgSend"]
extern fn msg_void_4id_decl(recv: *u8, sel: *u8, a: *u8, b: *u8, c: *u8, d: *u8);
