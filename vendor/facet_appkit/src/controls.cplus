// facet_appkit controls — the per-kind bodies.
//
// Stage 2's rule: facet never grows a verb table. A setter writes one field
// and sets one bit; the per-kind work lives here, dispatching on `Data.kind`,
// and facet never sees it. So this is where the 42 controls become AppKit.
//
// Each kind is a pair:
//   create_<kind>  build the view and configure it WHOLE (create passes
//                  all-ones as the dirty word, so one body serves both).
//   apply_<kind>   re-read only what the bits name.
// They are the same function. A kind whose create and apply disagree is how a
// control ends up correct on mount and wrong on the first update, so there is
// one body and `dirty` is the only difference.
//
// The dirty-bit constants belong to the generated control modules, which is
// why each is imported: `label::P_TEXT` is not the same bit as
// `text_field::P_TEXT`, and the MAP is the authority for both.
//
// STATUS: 30 of 42 — label, button, text_field, image, scroll, box, checkbox,
// radio, toggle, slider, progress, spinner, stepper, icon_button, symbol,
// text_area, search_field, popup, bordered, split, page_dots, date_picker,
// time_picker, tabs, context_menu, context_menu_item, span, and the three
// decided-absent (refreshable, swipeable, swipe_item), plus
// the container backing. Until a kind lands, `views::create` says
// so on stderr rather than rendering a silent blank rectangle.

import "stdlib/option" as option;
import "stdlib/text" as text;
import "stdlib/vec" as vec;
import "stdlib/status" as status;
import "flex_layout/flex_layout" as flex;
import "facet/facet" as core;
import "facet/props" as props;
import "facet/vocabulary" as vocab;
import "facet/application" as app;
import "facet/label" as label;
import "facet/button" as button;
import "facet/text_field" as text_field;
import "facet/image" as image;
import "facet/scroll" as scroll;
import "facet/box" as box_view;
import "facet/checkbox" as checkbox;
import "facet/radio" as radio;
import "facet/toggle" as toggle;
import "facet/slider" as slider;
import "facet/progress" as progress;
import "facet/spinner" as spinner;
import "facet/stepper" as stepper;
import "facet/icon_button" as icon_button;
import "facet/symbol" as symbol;
import "facet/text_area" as text_area;
import "facet/search_field" as search_field;
import "facet/popup" as popup;
import "facet/bordered" as bordered;
import "facet/split" as split;
import "facet/text_button" as text_button;
import "facet/page_dots" as page_dots;
import "facet/date_picker" as date_picker;
import "facet/time_picker" as time_picker;
import "facet/tabs" as tabs;
import "facet/span" as span;
import "facet/collection" as collection;
import "facet/carousel" as carousel;
import "facet/tree" as tree;
import "facet/mount" as mount;
import "facet/window_chrome" as chrome;
import "facet/canvas" as canvas;
import "facet/refreshable" as refreshable;
import "facet/table" as table;
import "facet/swipeable" as swipeable;
import "objc/runtime" as rt;
import "objc/bridge" as bridge;
import "objc/synthesis" as synth;
import "appkit/appkit" as ak;
import "appkit/appkit_ext" as akx;
import "quartzcore/quartzcore" as quartz;
import "stdlib/io" as io;
import "./paint" as paint;
import "./text_input" as text_input;
import "./drawing" as drawing;
import "./input" as input;
import "./compose" as compose;
import "./scheduler" as scheduler;

// ---- reaching a node's props -------------------------------------------------
// The generated cursors' `_props()` is module-private, so a backend reads the
// pointer off Data itself — checking `kind` first, exactly as those cursors do.
// A null answer means the node is not what the dispatch thought it was, and
// every body treats that as "do nothing" rather than trusting the cast.

fn props_of(n: *core::Node, kind: u32) -> *u8 {
    let d: *core::Data = core::node_data(n);
    if d == (0 as *core::Data) { return 0 as *u8; }
    if { (*d).kind } != kind { return 0 as *u8; }
    return { (*d).props };
}

// ---- label -------------------------------------------------------------------
// NSTextField in its label posture: not editable, not bezeled, no background.
// AppKit has no separate label class, and `labelWithString:` is the factory
// that sets that posture in one call.

fn create_label(n: *core::Node) -> *u8 {
    let f: ak::TextField = ak::TextField::label_with_string("");
    return rt::retain(f.as_view().raw());
}

fn apply_label(v: *u8, n: *core::Node, dirty: u64) {
    let p: *props::LabelProps = props_of(n, props::K_LABEL) as *props::LabelProps;
    if p == (0 as *props::LabelProps) { return; }
    let f: ak::TextField = ak::TextField::from_raw(v);
    // The text and the transform that displays it are one write: a transform
    // change with unchanged text still has to re-render the string.
    //
    // A label with SPAN children renders those instead: a formatted label's
    // text IS its runs, so its own `text` would be a second, contradictory
    // answer to the same question.
    let rich: u64 = label::P_TEXT | label::P_TEXT_TRANSFORM | label::P_CHARACTER_SPACING
        | label::P_LINE_HEIGHT | label::P_TEXT_DECORATION | label::P_IS_ITALIC
        | label::P_FONT_SIZE | label::P_FONT_WEIGHT | label::P_FONT_FAMILY
        | label::P_FONT_SCALES | span::P_FONT_SCALES
        | label::P_TEXT_COLOR | label::P_TEXT_ALIGN | label::P_TEXT_FORMAT
        | label::P_FORMATTED_TEXT;
    if (dirty & rich) != (0 as u64) {
        if has_spans(n) {
            let runs: *u8 = build_runs(n);
            if runs != (0 as *u8) {
                { rt::msg_void_id(v, rt::sel(#str_ptr("setAttributedStringValue:\0")), runs) };
                { rt::release(runs) };
            }
        } else if is_html(p) {
            // `TextType.Html` means the string IS markup. NSAttributedString
            // parses it, which is the whole feature — a backend that stripped
            // the tags would be answering a different question.
            let a: *u8 = html_string({ (*p).text.view() });
            if a != (0 as *u8) {
                { rt::msg_void_id(v, rt::sel(#str_ptr("setAttributedStringValue:\0")), a) };
                { rt::release(a) };
            }
        } else if formatted_count(p) > (0 as usize) {
            // `formatted_text` is the VALUE-carried run list, the second way a
            // label can describe runs. Child spans win when both are present:
            // a tree is more specific than a value on the node.
            let runs: *u8 = build_value_runs(p);
            if runs != (0 as *u8) {
                { rt::msg_void_id(v, rt::sel(#str_ptr("setAttributedStringValue:\0")), runs) };
                { rt::release(runs) };
            }
        } else if label_wants_rich(p) {
            // kern, line height and decoration have no plain-string form, so a
            // label that asks for one is written attributed. One that does not
            // keeps the plain path — see paint::wants_rich.
            let shown: text::Text = paint::transformed({ (*p).text.view() }, { (*p).text_transform });
            let a: *u8 = paint::attributed(shown.view(), label_attributes(p));
            if a != (0 as *u8) {
                { rt::msg_void_id(v, rt::sel(#str_ptr("setAttributedStringValue:\0")), a) };
                { rt::release(a) };
            }
        } else {
            f.as_control().set_string_value(paint::transformed({ (*p).text.view() }, { (*p).text_transform }).view());
        }
    }
    if (dirty & label::P_TEXT_COLOR) != (0 as u64) {
        let c: vocab::Color = { (*p).text_color };
        if c.is_set() { f.set_text_color(paint::ns_color(c)); }
    }
    if (dirty & (label::P_FONT_SIZE | label::P_FONT_WEIGHT | label::P_FONT_FAMILY
                 | label::P_IS_ITALIC | label::P_FONT_SCALES)) != (0 as u64) {
        match paint::ns_font_scaled({ (*p).font_size }, { (*p).font_weight },
                                    { (*p).font_family.view() }, { (*p).is_italic },
                                    { (*p).font_scales }) {
            option::Option[ak::Font]::Some(font) => { f.as_control().set_font(font); }
            option::Option[ak::Font]::None => { }
        }
    }
    if (dirty & label::P_TEXT_ALIGN) != (0 as u64) {
        f.as_control().set_alignment(paint::ns_text_align({ (*p).text_align }));
    }
    // The VERTICAL half. NSTextFieldCell has no property for it and centres in
    // the rect it is given — so the rect is what changes; see compose.cplus.
    if (dirty & label::P_VERTICAL_ALIGN) != (0 as u64) {
        compose::apply_field_vertical_align(v, { (*p).vertical_align });
    }
    if (dirty & (label::P_MAX_LINES | label::P_LINE_BREAK)) != (0 as u64) {
        let lines: i64 = { (*p).max_lines };
        // 0 = unbounded, which is NSTextField's own spelling too.
        if lines > (0 as i64) { f.set_maximum_number_of_lines(lines); }
        match f.as_control().cell() {
            option::Option[ak::Cell]::Some(c) => {
                c.set_uses_single_line_mode(lines == (1 as i64));
                c.set_line_break_mode(paint::ns_line_break({ (*p).line_break }));
            }
            option::Option[ak::Cell]::None => { }
        }
    }
    return;
}

// ---- button ------------------------------------------------------------------

fn create_button(n: *core::Node) -> *u8 {
    let b: ak::Button = ak::Button::from_raw(rt::alloc_init(#str_ptr("NSButton\0")));
    b.set_button_type(ak::ButtonType::MomentaryPushIn);
    b.set_bezel_style(ak::BezelStyle::Rounded);
    return rt::retain(b.as_view().raw());
}

fn apply_button(v: *u8, n: *core::Node, dirty: u64) {
    let p: *props::ButtonProps = props_of(n, props::K_BUTTON) as *props::ButtonProps;
    if p == (0 as *props::ButtonProps) { return; }
    let b: ak::Button = ak::Button::from_raw(v);
    // The title band. `character_spacing` and `is_italic` have no plain-title
    // form, so a button that asks for either — or for a text colour, which
    // NSButton also has no plain setter for — is given an attributed title.
    let title_bits: u64 = button::P_TITLE | button::P_TEXT_TRANSFORM
        | button::P_CHARACTER_SPACING | button::P_TEXT_COLOR | button::P_IS_ITALIC
        | button::P_FONT_SIZE | button::P_FONT_WEIGHT | button::P_FONT_FAMILY
        | button::P_FONT_SCALES;
    if (dirty & title_bits) != (0 as u64) {
        let shown: text::Text = paint::transformed({ (*p).title.view() }, { (*p).text_transform });
        if button_wants_rich(p) {
            let a: *u8 = paint::attributed(shown.view(), button_attributes(p));
            if a != (0 as *u8) {
                { rt::msg_void_id(v, rt::sel(#str_ptr("setAttributedTitle:\0")), a) };
                { rt::release(a) };
            }
        } else {
            b.set_title(shown.view());
        }
    }
    if (dirty & (button::P_FONT_SIZE | button::P_FONT_WEIGHT | button::P_FONT_FAMILY
                 | button::P_IS_ITALIC | button::P_FONT_SCALES)) != (0 as u64) {
        match paint::ns_font_scaled({ (*p).font_size }, { (*p).font_weight },
                                    { (*p).font_family.view() }, { (*p).is_italic },
                                    { (*p).font_scales }) {
            option::Option[ak::Font]::Some(font) => { b.as_control().set_font(font); }
            option::Option[ak::Font]::None => { }
        }
    }
    if (dirty & button::P_IMAGE) != (0 as u64) {
        apply_control_image(b, { (*p).image.view() });
    }
    if (dirty & (button::P_CONTENT_LAYOUT | button::P_IMAGE)) != (0 as u64) {
        b.set_image_position(ns_image_position({ (*p).content_layout }));
    }
    if (dirty & button::P_LINE_BREAK) != (0 as u64) {
        match b.as_control().cell() {
            option::Option[ak::Cell]::Some(c) => { c.set_line_break_mode(paint::ns_line_break({ (*p).line_break })); }
            option::Option[ak::Cell]::None => { }
        }
    }
    // A click FLIPS when the button toggles, and AppKit's PushOnPushOff holds
    // that state — no second copy to keep in step.
    if (dirty & button::P_TOGGLES) != (0 as u64) || dirty == paint::all_bits() {
        if { (*p).toggles } { b.set_button_type(ak::ButtonType::PushOnPushOff); }
        else { b.set_button_type(ak::ButtonType::MomentaryPushIn); }
        b.set_bezel_style(ak::BezelStyle::Rounded);
        b.set_bordered({ (*p).bordered });
    }
    if (dirty & button::P_ON) != (0 as u64) || dirty == paint::all_bits() {
        b.set_state(state_of({ (*p).on }));
    }
    // `bordered` is the platform BEZEL, which is what a button's border
    // actually is — clearing `border_width` only clears the CALayer border
    // facet draws on top, and left the bezel underneath.
    if (dirty & button::P_BORDERED) != (0 as u64) || dirty == paint::all_bits() {
        b.set_bordered({ (*p).bordered });
    }
    if (dirty & (button::P_BORDER_COLOR | button::P_BORDER_WIDTH | button::P_CORNER_RADIUS)) != (0 as u64) {
        apply_border(v, { (*p).border_color }, { (*p).border_width }, { (*p).corner_radius },
                     (dirty & (button::P_BORDER_COLOR | button::P_BORDER_WIDTH)) != (0 as u64),
                     (dirty & button::P_CORNER_RADIUS) != (0 as u64));
    }
    // A button's action fires from the keyboard when focused and from
    // VoiceOver too — which is exactly why it is the control's own verb and
    // not a gesture (gestures see the pointer and nothing else).
    if (dirty & props::C_HANDLERS) != (0 as u64) || dirty == paint::all_bits() {
        let f: fn(*u8, *u8) = button_action;
        akx::set_control_action_ctx(b.as_control(), f, n as *u8);
    }
    // The shared band owns enabled; a control reads it through its own setter
    // because NSControl's enabled is not the view's.
    if (dirty & props::C_IS_ENABLED) != (0 as u64) || dirty == paint::all_bits() {
        b.as_control().set_enabled(core::is_enabled(n));
    }
    return;
}

fn button_wants_rich(p: *props::ButtonProps) -> bool {
    // A text colour joins the rich set here and nowhere else: NSButton draws
    // its title from the cell and has no `setTitleColor:`.
    if { (*p).text_color }.is_set() { return true; }
    return paint::wants_rich({ (*p).character_spacing }, 0.0f64, vocab::TextDecoration::None);
}

fn button_attributes(p: *props::ButtonProps) -> *u8 {
    return paint::rich_attributes(
        paint::ns_font_scaled({ (*p).font_size }, { (*p).font_weight },
                              { (*p).font_family.view() }, { (*p).is_italic },
                              { (*p).font_scales }),
        { (*p).text_color }, { (*p).character_spacing }, 0.0f64,
        option::Option[vocab::TextAlign]::None, vocab::TextDecoration::None);
}

// facet's ContentLayout names where the IMAGE goes; NSCellImagePosition is the
// same idea with AppKit's spelling.
fn ns_image_position(l: vocab::ContentLayout) -> ak::CellImagePosition {
    return match l {
        vocab::ContentLayout::ImageLeft => ak::CellImagePosition::NSImageLeft,
        vocab::ContentLayout::ImageRight => ak::CellImagePosition::NSImageRight,
        vocab::ContentLayout::ImageTop => ak::CellImagePosition::NSImageAbove,
        vocab::ContentLayout::ImageBottom => ak::CellImagePosition::NSImageBelow,
    };
}

// The same three-step resolution `image` uses — a system symbol, then a bundle
// name, then a path — so a button's image and an image's source name the same
// things.
fn apply_control_image(b: ak::Button, src: str) {
    if src == "" { b.set_image(ak::Image::from_raw(0 as *u8)); return; }
    match resolve_image(src) {
        option::Option[ak::Image]::Some(img) => { b.set_image(img); }
        option::Option[ak::Image]::None => { b.set_image(ak::Image::from_raw(0 as *u8)); }
    }
    return;
}

// ---- text_field --------------------------------------------------------------
// The editable NSTextField. `is_secure` picks NSSecureTextField instead, which
// is a different CLASS and not a property of the first — there is no message
// that turns one into the other.
//
// That used to make it create-only. It no longer is: a write builds the other
// class and `views::reclass` puts it where the old field stood, carrying the
// focus across and re-applying every prop. The ledger entry is gone with it.
// What an application must still not assume is that the native object survives
// the flip — anything holding the raw view across a change of `is_secure` is
// holding a dead one.

// The class question, asked where the props live. `views::reclass_for` compares
// this against what the field currently IS.
fn text_field_wants_secure(n: *core::Node) -> bool {
    let p: *props::TextFieldProps = props_of(n, props::K_TEXT_FIELD) as *props::TextFieldProps;
    if p == (0 as *props::TextFieldProps) { return false; }
    return { (*p).is_secure };
}

fn create_text_field(n: *core::Node) -> *u8 {
    let secure: bool = text_field_wants_secure(n);
    var f: ak::TextField = ak::TextField::from_raw(rt::alloc_init(#str_ptr("NSTextField\0")));
    if secure { f = ak::TextField::from_raw(rt::alloc_init(#str_ptr("NSSecureTextField\0"))); }
    f.set_editable(true);
    f.set_selectable(true);
    f.set_bezeled(true);
    // What the user types has to reach the props, or `text()` answers with
    // whatever was last SET and the edit is lost silently. See text_input.
    text_input::install(f.as_view().raw(), f.as_view().raw(), n);
    return rt::retain(f.as_view().raw());
}

fn apply_text_field(v: *u8, n: *core::Node, dirty: u64) {
    let p: *props::TextFieldProps = props_of(n, props::K_TEXT_FIELD) as *props::TextFieldProps;
    if p == (0 as *props::TextFieldProps) { return; }
    let f: ak::TextField = ak::TextField::from_raw(v);
    let iv: *props::InputViewProps = { #addr_of((*p).input_view) };
    // The whole InputView band is one body in text_input, shared with the
    // editor and the search field, because all three embed the same props.
    text_input::apply_field_band(f, n, iv, { (*p).text_align }, dirty,
                                 text_input::bits_of(props::K_TEXT_FIELD));
    // `return_key` is read where Return is HANDLED — `text_input::submit_imp` —
    // so nothing is written here. The bit still has to be gated: a field whose
    // return key becomes `Next` after it was built needs the delegate that
    // reads it, and installing is idempotent.
    if (dirty & text_field::P_RETURN_KEY) != (0 as u64) {
        text_input::install(v, v, n);
    }
    if (dirty & text_field::P_VERTICAL_ALIGN) != (0 as u64) {
        compose::apply_field_vertical_align(v, { (*p).vertical_align });
    }
    // NSTextField has no clear button and NSSearchField's belongs to its own
    // cell, so this one is composed: a button over the trailing edge, and the
    // cell gives back the width it covers.
    if (dirty & text_field::P_CLEAR_BUTTON) != (0 as u64) {
        compose::apply_clear_button(v, { (*p).clear_button });
    }
    // Whatever changed the text changed whether there is anything to clear.
    if (dirty & text_field::P_TEXT) != (0 as u64) { compose::refresh_clear_button(v); }
    if (dirty & props::C_IS_ENABLED) != (0 as u64) || dirty == paint::all_bits() {
        f.as_control().set_enabled(core::is_enabled(n));
    }
    return;
}

// ---- image -------------------------------------------------------------------

fn create_image(n: *core::Node) -> *u8 {
    let iv: ak::ImageView = ak::ImageView::from_raw(rt::alloc_init(#str_ptr("NSImageView\0")));
    return rt::retain(iv.as_view().raw());
}

fn apply_image(v: *u8, n: *core::Node, dirty: u64) {
    let p: *props::ImageProps = props_of(n, props::K_IMAGE) as *props::ImageProps;
    if p == (0 as *props::ImageProps) { return; }
    let iv: ak::ImageView = ak::ImageView::from_raw(v);
    if (dirty & image::P_SOURCE) != (0 as u64) {
        let src: str = { (*p).source.view() };
        if src == "" {
            iv.set_image(ak::Image::from_raw(0 as *u8));
        } else {
            // A named system symbol first, then a file path: an application
            // says `source: "gear"` far more often than it ships a bitmap, and
            // a path that is not a file would silently show nothing.
            match ak::Image::image_with_system_symbol_name(src, "") {
                option::Option[ak::Image]::Some(img) => { iv.set_image(img); }
                option::Option[ak::Image]::None => {
                    // Then a bundle-named image, then a path on disk. A name
                    // that resolves to none of the three leaves the view empty
                    // rather than substituting something the app did not ask
                    // for.
                    match ak::Image::image_named(src) {
                        option::Option[ak::Image]::Some(named) => { iv.set_image(named); }
                        option::Option[ak::Image]::None => {
                            iv.set_image(ak::Image::new_with_contents_of_file(src));
                        }
                    }
                }
            }
        }
    }
    if (dirty & image::P_FIT) != (0 as u64) {
        iv.set_image_scaling(ns_image_scaling({ (*p).fit }));
    }
    // An animated image (a GIF) plays or holds its first frame. NSImageView
    // animates by default, so this is the switch that stops it.
    if (dirty & (image::P_IS_ANIMATION_PLAYING | image::P_SOURCE)) != (0 as u64) {
        iv.set_animates({ (*p).is_animation_playing });
    }
    if (dirty & image::P_IS_OPAQUE) != (0 as u64) { apply_is_opaque(v, { (*p).is_opaque }); }
    return;
}

// facet's ImageFit is the ledger's Aspect. AppKit's scaling enum is the nearest
// thing; `Center` is the one that means "do not scale at all".
fn ns_image_scaling(f: vocab::ImageFit) -> ak::ImageScaling {
    return match f {
        vocab::ImageFit::AspectFill => ak::ImageScaling::NSImageScaleProportionallyUpOrDown,
        vocab::ImageFit::AspectFit => ak::ImageScaling::NSImageScaleProportionallyDown,
        vocab::ImageFit::Center => ak::ImageScaling::NSImageScaleNone,
        vocab::ImageFit::Fill => ak::ImageScaling::NSImageScaleAxesIndependently,
    };
}

// ---- scroll ------------------------------------------------------------------
// NSScrollView holds its content in a FLIPPED document view, so the tree below
// it keeps the same top-left coordinate space as everywhere else. facet's
// children are inserted into that document view, not into the scroll view —
// `document_host` is what `views::insert` asks for.

fn create_scroll(n: *core::Node) -> *u8 {
    // A FacetScrollView, not a plain NSScrollView — appkit_ext has carried the
    // class all along; this package simply stopped constructing it, and the
    // nested-scroll rule went with it.
    //
    // WHY A SUBCLASS AND NOT ELASTICITY. NSScrollView consumes `scrollWheel:`
    // whenever it can scroll on EITHER axis. Elasticity governs the
    // rubber-band at the limits, not whether the event is passed on — so a
    // lane with twenty cards (real vertical range) swallows every sideways
    // swipe however its horizontal elasticity is set, and the strip holding
    // the lanes never moves. Two shipped fixes learned that the hard way
    // before the class was written; this one re-learned it a third time.
    //
    // The override also forwards an axis it OWNS but has no range left on,
    // which elasticity cannot express at all.
    // ONLY A SINGLE-AXIS SCROLL TAKES THE SUBCLASS. The forwarder owns exactly
    // one axis — it is a bool — so a `Both` scroll given it would hand its
    // VERTICAL swipes away, and `Both` is the default every ordinary scroll in
    // every app is built with. A scroll that owns both axes has nothing to
    // decline except a limit, which is the platform's own rubber-band, so it
    // stays a plain NSScrollView.
    let axis: vocab::ScrollAxis = axis_of_node(n);
    let one_axis: bool = match axis {
        vocab::ScrollAxis::Horizontal => true,
        vocab::ScrollAxis::Vertical => true,
        vocab::ScrollAxis::Both => false,
        vocab::ScrollAxis::Neither => false,
    };
    let owns_h: bool = match axis {
        vocab::ScrollAxis::Horizontal => true,
        vocab::ScrollAxis::Vertical => false,
        vocab::ScrollAxis::Both => false,
        vocab::ScrollAxis::Neither => false,
    };
    let s: ak::ScrollView = if one_axis {
        akx::new_scroll_view(rt::Rect { x: 0.0f64, y: 0.0f64, w: 10.0f64, h: 10.0f64 }, owns_h)
    } else {
        ak::ScrollView::from_raw(rt::alloc_init(#str_ptr("NSScrollView\0")))
    };
    let doc: ak::View = akx::new_flipped_view(rt::Rect { x: 0.0f64, y: 0.0f64, w: 0.0f64, h: 0.0f64 });
    s.set_document_view(doc);
    s.set_draws_background(false);
    return rt::retain(s.as_view().raw());
}

// The declared axis, read straight off the props — `create_scroll` runs before
// `apply_scroll`, so it cannot wait for the prop pass to hand it over.
fn axis_of_node(n: *core::Node) -> vocab::ScrollAxis {
    let p: *props::ScrollProps = props_of(n, props::K_SCROLL) as *props::ScrollProps;
    if p == (0 as *props::ScrollProps) { return vocab::ScrollAxis::Both; }
    return { (*p).axis };
}

fn apply_scroll(v: *u8, n: *core::Node, dirty: u64) {
    let p: *props::ScrollProps = props_of(n, props::K_SCROLL) as *props::ScrollProps;
    if p == (0 as *props::ScrollProps) { return; }
    let s: ak::ScrollView = ak::ScrollView::from_raw(v);
    if (dirty & (scroll::P_AXIS | scroll::P_VERTICAL_SCROLL_BARS | scroll::P_HORIZONTAL_SCROLL_BARS)) != (0 as u64) {
        let axis: vocab::ScrollAxis = { (*p).axis };
        let scrolls_v: bool = match axis {
            vocab::ScrollAxis::Both => true,
            vocab::ScrollAxis::Vertical => true,
            vocab::ScrollAxis::Horizontal => false,
            vocab::ScrollAxis::Neither => false,
        };
        let scrolls_h: bool = match axis {
            vocab::ScrollAxis::Both => true,
            vocab::ScrollAxis::Horizontal => true,
            vocab::ScrollAxis::Vertical => false,
            vocab::ScrollAxis::Neither => false,
        };
        s.set_has_vertical_scroller(scrolls_v && shows_bars({ (*p).vertical_scroll_bars }));
        s.set_has_horizontal_scroller(scrolls_h && shows_bars({ (*p).horizontal_scroll_bars }));
        // AND THE AXIS DECLINES THE EVENTS IT DOES NOT SCROLL. Hiding a
        // scroller is not the same as refusing the gesture: an NSScrollView's
        // default elasticity is `Automatic`, and an automatic-elasticity scroll
        // view CLAIMS the wheel on that axis — rubber-banding against nothing
        // rather than passing it to an enclosing scroll view. So a vertical
        // lane swallowed every horizontal scroll, and iris's board (lanes that
        // scroll vertically inside a strip that scrolls horizontally) would not
        // move sideways with the pointer over any lane — which is most of it.
        //
        // `ScrollBars::Never` was no escape either: it rides the same
        // `shows_bars` flag, so it hid the bar and kept the claim.
        //
        // `None` on the axis that does not scroll is AppKit's own answer for
        // nested scroll views. `Both` leaves them automatic.
        // iris gap: "a scroll that cannot scroll an axis still eats that axis".
        s.set_vertical_scroll_elasticity(if scrolls_v { ak::ScrollElasticity::Automatic }
                                         else { ak::ScrollElasticity::None });
        s.set_horizontal_scroll_elasticity(if scrolls_h { ak::ScrollElasticity::Automatic }
                                           else { ak::ScrollElasticity::None });
        // ELASTICITY IS HALF THE ANSWER; the other half is that the axis must
        // have NOTHING TO SCROLL. `geometry::size_scroll_content` pins the
        // undeclared axis to the viewport exactly for that reason — a lane
        // scrollable by three stray pixels of rounding is a lane entitled to
        // keep every sideways swipe. Together they are AppKit's own nested
        // answer, and it forwards natively.
        //
        // NOT a `scrollWheel:` override, which is where this went first:
        // overriding it opts the view out of responsive scrolling, and a
        // re-dispatched flick then brakes early — smooth on a slow swipe,
        // visibly short on a fast one. The native path keeps the fast path.
    }
    // `safe_area` says whether the scroll keeps its content clear of the
    // window's own chrome. On AppKit that is exactly `automaticallyAdjusts
    // ContentInsets`, which insets for the title bar and any accessory — so
    // `Default`/`Container`/`All` let AppKit do it and `None` turns it off.
    //
    // It is read from the SHARED BAND now, not from a prop of scroll's own.
    // `scroll` was the only kind that could carry one, which is what left
    // The ledger's three Page rows with no answer; the verb moved up, and this is
    // the one place where AppKit does the insetting itself rather than facet's
    // layout pass doing it (scheduler::safe_insets).
    if (dirty & props::C_SAFE_AREA) != (0 as u64) || dirty == paint::all_bits() {
        s.set_automatically_adjusts_content_insets(core::honours_safe_area(n));
    }
    // `cascades_input` is read where it is answered — the hit test, in
    // input.cplus. Nothing to write here; the view has to be ARMED, because
    // that class is where `hitTest:` lives, and arming is idempotent.
    if (dirty & scroll::P_CASCADES_INPUT) != (0 as u64) { input::arm(v, n); }
    // The offset the application asked for. NOT on a full apply: `all_bits` is
    // what a re-attached node gets, and re-asserting a stale origin there would
    // yank a scroll the user had since moved. A position is only written when
    // the application writes one.
    if (dirty & (scroll::P_SCROLL_X | scroll::P_SCROLL_Y)) != (0 as u64) {
        scroll_to_offset(v, { (*p).scroll_x }, { (*p).scroll_y });
    }
    return;
}

// Put the scroll where it was asked to be.
//
// The clip view is what actually moves, and `reflectScrolledClipView:` is what
// makes the scrollers agree with it — without that the content moves and the
// bars keep pointing at the old place.
fn scroll_to_offset(v: *u8, x: f64, y: f64) {
    if v == (0 as *u8) { return; }
    let clip: *u8 = { rt::msg_id(v, rt::sel(#str_ptr("contentView\0"))) };
    if clip == (0 as *u8) { return; }
    { rt::msg_void_point(clip, rt::sel(#str_ptr("scrollToPoint:\0")),
                         rt::Point { x: x, y: y }) };
    { rt::msg_void_id(v, rt::sel(#str_ptr("reflectScrolledClipView:\0")), clip) };
    return;
}

// `Default` is the platform's own answer, which on macOS is the overlay
// scroller that appears while scrolling — so the scroller exists either way,
// and only `Never` takes it away.
fn shows_bars(b: vocab::ScrollBars) -> bool {
    return match b {
        vocab::ScrollBars::Always => true,
        vocab::ScrollBars::Default => true,
        vocab::ScrollBars::Never => false,
    };
}

// A scroll's children belong in its document view, not in the scroll view.
// Every other kind hosts its own children directly, so this is the one place
// the host and the view differ.
fn document_host(v: *u8) -> *u8 {
    match ak::ScrollView::from_raw(v).document_view() {
        option::Option[ak::View]::Some(d) => { return d.raw(); }
        option::Option[ak::View]::None => { return v; }
    }
    return v;
}

// ---- on / off state ----------------------------------------------------------
// NSControl's state is a tri-state i64 (off 0, on 1, mixed -1). facet's
// controls are all two-state, so the conversion is one place rather than five.

// ---- the reads that go stale -------------------------------------------------
// A contract READ answers from the props, and the props are only ever written
// by the application — so a control the USER changed answered with whatever
// was last written to it. `radio.on` was written back (the group logic needed
// it) and the text controls were (the delegate needed it) and `slider.value`
// was; every other control that a user can change was not.
//
// It is the same shape as `web.can_go_back` and `carousel.position`: the truth
// lives in the platform, so the platform's answer is written into the props
// BEFORE the handler runs. Then a handler that asks `checkbox.on()` gets the
// state that caused it rather than the state before it.
//
// One trampoline per shape, each ending in the application's own handler.

// NSSwitch and NSButton are different classes with the same `state`, so this
// asks the runtime rather than a wrapper — a toggle is not a button.
fn sync_bool_state(sender: *u8, p: *bool) {
    { (*p) = { rt::msg_i64(sender, rt::sel(#str_ptr("state\0"))) } == state_on() };
    return;
}

fn checkbox_action(sender: *u8, ctx: *u8) {
    let n: *core::Node = ctx as *core::Node;
    let p: *props::CheckboxProps = props_of(n, props::K_CHECKBOX) as *props::CheckboxProps;
    if p == (0 as *props::CheckboxProps) { return; }
    sync_bool_state(sender, #addr_of((*p).on));
    let h: fn(*u8, *u8) = { (*p).on_checked_changed };
    if h != props::no_handler { h(sender, { (*p).on_checked_changed_ctx }); }
    return;
}

// A toggling text button syncs its state into the props BEFORE the handler
// runs, for the same reason a checkbox does: `is_on()` reads the props, so the
// props have to be true by the time anyone asks. AppKit owns the flip
// (PushOnPushOff); this is what tells facet about it.
fn button_action(sender: *u8, ctx: *u8) {
    let n: *core::Node = ctx as *core::Node;
    let p: *props::ButtonProps = props_of(n, props::K_BUTTON) as *props::ButtonProps;
    if p == (0 as *props::ButtonProps) { return; }
    if { (*p).toggles } { sync_bool_state(sender, #addr_of((*p).on)); }
    let h: fn(*u8, *u8) = { (*p).on_click };
    if h != props::no_handler { h(sender, { (*p).on_click_ctx }); }
    return;
}

fn icon_button_action(sender: *u8, ctx: *u8) {
    let n: *core::Node = ctx as *core::Node;
    let p: *props::IconButtonProps = props_of(n, props::K_ICON_BUTTON) as *props::IconButtonProps;
    if p == (0 as *props::IconButtonProps) { return; }
    if { (*p).toggles } { sync_bool_state(sender, #addr_of((*p).on)); }
    let h: fn(*u8, *u8) = { (*p).on_clicked };
    if h != props::no_handler { h(sender, { (*p).on_clicked_ctx }); }
    return;
}

fn text_button_action(sender: *u8, ctx: *u8) {
    let n: *core::Node = ctx as *core::Node;
    let p: *text_button::TextButtonProps =
        props_of(n, text_button::K_TEXT_BUTTON) as *text_button::TextButtonProps;
    if p == (0 as *text_button::TextButtonProps) { return; }
    if { (*p).toggles } { sync_bool_state(sender, #addr_of((*p).on)); }
    let h: fn(*u8, *u8) = { (*p).on_click };
    if h != props::no_handler { h(sender, { (*p).on_click_ctx }); }
    return;
}

fn toggle_action(sender: *u8, ctx: *u8) {
    let n: *core::Node = ctx as *core::Node;
    let p: *props::ToggleProps = props_of(n, props::K_TOGGLE) as *props::ToggleProps;
    if p == (0 as *props::ToggleProps) { return; }
    sync_bool_state(sender, #addr_of((*p).on));
    let h: fn(*u8, *u8) = { (*p).on_toggled };
    if h != props::no_handler { h(sender, { (*p).on_toggled_ctx }); }
    return;
}

fn stepper_action(sender: *u8, ctx: *u8) {
    let n: *core::Node = ctx as *core::Node;
    let p: *props::StepperProps = props_of(n, props::K_STEPPER) as *props::StepperProps;
    if p == (0 as *props::StepperProps) { return; }
    { (*p).value = ak::Control::from_raw(sender).double_value() };
    let h: fn(*u8, *u8) = { (*p).on_value_changed };
    if h != props::no_handler { h(sender, { (*p).on_value_changed_ctx }); }
    return;
}

// The prompt took row 0, so the native index is one ahead of the
// application's — the same offset `apply_popup` adds on the way in, subtracted
// on the way out. A popup showing its prompt reads back -1: nothing chosen.
fn popup_action(sender: *u8, ctx: *u8) {
    let n: *core::Node = ctx as *core::Node;
    let p: *props::PopupProps = props_of(n, props::K_POPUP) as *props::PopupProps;
    if p == (0 as *props::PopupProps) { return; }
    let offset: i64 = compose::title_offset({ (*p).title.view() });
    let raw: i64 = ak::PopUpButton::from_raw(sender).index_of_selected_item();
    var idx: i64 = raw -% offset;
    if raw < (0 as i64) { idx = -1 as i64; }
    { (*p).selected_index = idx };
    let h: fn(*u8, *u8) = { (*p).on_selected_index_changed };
    if h != props::no_handler { h(sender, { (*p).on_selected_index_changed_ctx }); }
    return;
}

fn state_on() -> i64 { return 1 as i64; }
fn state_off() -> i64 { return 0 as i64; }
fn state_of(on: bool) -> i64 { if on { return state_on(); } return state_off(); }

fn is_html(p: *props::LabelProps) -> bool {
    return match { (*p).text_format } {
        vocab::TextFormat::Html => true,
        vocab::TextFormat::Text => false,
    };
}

// An NSAttributedString parsed from HTML, at +1, or 0 when the markup is
// unusable — in which case the caller leaves the label alone rather than
// showing raw tags.
fn html_string(markup: str) -> *u8 {
    let data: *u8 = { rt::msg_id_u64(bridge::nsstring(markup),
                                     rt::sel(#str_ptr("dataUsingEncoding:\0")), 4 as u64) };
    if data == (0 as *u8) { return 0 as *u8; }
    let opts: *u8 = { rt::alloc_init(#str_ptr("NSMutableDictionary\0")) };
    if opts == (0 as *u8) { return 0 as *u8; }
    { rt::msg_void_id_id(opts, rt::sel(#str_ptr("setObject:forKey:\0")),
                         bridge::nsstring("NSHTML"), bridge::nsstring("DocumentType")) };
    let alloced: *u8 = { rt::msg_id(rt::get_class(#str_ptr("NSAttributedString\0")),
                                    rt::sel(#str_ptr("alloc\0"))) };
    let a: *u8 = { msg_id_html(alloced, rt::sel(#str_ptr("initWithData:options:documentAttributes:error:\0")),
                               data, opts, 0 as *u8, 0 as *u8) };
    { rt::release(opts) };
    return a;
}

#[link_name = "objc_msgSend"]
extern fn msg_id_html(recv: *u8, sel: *u8, a: *u8, b: *u8, c: *u8, d: *u8) -> *u8;

fn formatted_count(p: *props::LabelProps) -> usize {
    let f: *vocab::Spans = { #addr_of((*p).formatted_text) };
    return { (*f).count() };
}

// The attributed string a label's `formatted_text` value describes, at +1.
// Same shape as `build_runs` over child spans, and deliberately so: two ways
// to say runs must not become two renderings of them.
fn build_value_runs(p: *props::LabelProps) -> *u8 {
    let ms: *u8 = { rt::alloc_init(#str_ptr("NSMutableAttributedString\0")) };
    if ms == (0 as *u8) { return 0 as *u8; }
    let spans: *vocab::Spans = { #addr_of((*p).formatted_text) };
    var i: usize = 0 as usize;
    let count: usize = { (*spans).count() };
    while i < count {
        let r: *vocab::TextSpan = { (*spans).at(i) };
        if r != (0 as *vocab::TextSpan) { append_value_run(ms, r, p); }
        i = i +% (1 as usize);
    }
    return ms;
}

fn append_value_run(ms: *u8, r: *vocab::TextSpan, p: *props::LabelProps) {
    let attrs: *u8 = paint::rich_attributes(
        paint::ns_font_styled({ (*r).font_size }, { (*r).font_weight },
                              { (*r).font_family.view() }, { (*r).is_italic }),
        { (*r).color }, { (*p).character_spacing }, { (*p).line_height },
        option::Option[vocab::TextAlign]::None, { (*r).decoration });
    if attrs != (0 as *u8) {
        let bg: vocab::Color = { (*r).background_color };
        if bg.is_set() { paint::dict_set(attrs, "NSBackgroundColor", paint::ns_color(bg).raw()); }
        // A run with a destination is a LINK, which is what `link` means and
        // the only attribute a plain run cannot carry.
        let dest: str = { (*r).link.view() };
        if dest != "" { paint::dict_set(attrs, "NSLink", bridge::nsstring(dest)); }
    }
    let run: *u8 = paint::attributed({ (*r).text.view() }, attrs);
    if run != (0 as *u8) {
        { rt::msg_void_id(ms, rt::sel(#str_ptr("appendAttributedString:\0")), run) };
        { rt::release(run) };
    }
    return;
}

fn label_wants_rich(p: *props::LabelProps) -> bool {
    return paint::wants_rich({ (*p).character_spacing }, { (*p).line_height },
                             { (*p).text_decoration });
}

fn label_attributes(p: *props::LabelProps) -> *u8 {
    return paint::rich_attributes(
        paint::ns_font_scaled({ (*p).font_size }, { (*p).font_weight },
                              { (*p).font_family.view() }, { (*p).is_italic },
                              { (*p).font_scales }),
        { (*p).text_color }, { (*p).character_spacing }, { (*p).line_height },
        option::some({ (*p).text_align }), { (*p).text_decoration });
}

// ---- the border band ---------------------------------------------------------
// `border_color`, `border_width` and `corner_radius` are the same three verbs
// on a button, an icon button, a radio and a bordered box, and a layer answers
// all three. One body, because three copies is how three controls end up
// disagreeing about what a zero width means.

// A zero width is no border, and it must CLEAR one — a control that had a
// border and then asked for none has to lose it.
//
// But clearing is not the same as ASKING FOR A LAYER. Layer-backing an AppKit
// control costs it the material its bezel is drawn with: a push button rendered
// into a layer comes out FLAT. `create` runs this with every bit set and a
// default `border_width` of zero, so every plain button and radio was made
// layer-backed on mount to be told it had no border — and every default button
// in every facet app lost its native bezel for it.
//
// The rest of this package already knows the rule. `apply_background` and
// `apply_background_image` both say it out loud: nothing to clear unless a
// layer already exists. This is the same rule, and it was the one place missing
// it.
fn apply_border(v: *u8, color: vocab::Color, width: f64, radius: vocab::Corners,
                do_border: bool, do_corner: bool) {
    let view: ak::View = ak::View::from_raw(v);
    if do_border {
        if width > 0.0f64 {
            view.set_wants_layer(true);
            view.layer().set_border_width(width);
            if color.is_set() {
                view.layer().set_border_color(paint::ns_color(color).c_g_color());
            }
        } else if view.wants_layer() {
            view.layer().set_border_width(0.0f64);
        }
    }
    if do_corner {
        let corner: f64 = largest_corner(radius);
        if corner > 0.0f64 {
            view.set_wants_layer(true);
            view.layer().set_corner_radius(corner);
        } else if view.wants_layer() {
            view.layer().set_corner_radius(0.0f64);
        }
    }
    return;
}

// ---- box ---------------------------------------------------------------------
// A rectangle of colour. No AppKit control corresponds — NSBox is a titled
// grouping frame, which is a different thing — so it is a layer-backed view,
// which is also what makes its corner radius free.

fn create_box(n: *core::Node) -> *u8 {
    let v: ak::View = akx::new_flipped_view(rt::Rect { x: 0.0f64, y: 0.0f64, w: 0.0f64, h: 0.0f64 });
    v.set_wants_layer(true);
    return rt::retain(v.raw());
}

fn apply_box(v: *u8, n: *core::Node, dirty: u64) {
    let p: *props::BoxProps = props_of(n, props::K_BOX) as *props::BoxProps;
    if p == (0 as *props::BoxProps) { return; }
    let view: ak::View = ak::View::from_raw(v);
    if (dirty & box_view::P_COLOR) != (0 as u64) {
        view.set_wants_layer(true);
        view.layer().set_background_color(paint::ns_color({ (*p).color }).c_g_color());
    }
    if (dirty & box_view::P_CORNER_RADIUS) != (0 as u64) {
        view.set_wants_layer(true);
        // One radius per layer is all Core Animation has; facet carries four
        // corners, so the largest wins and MANIFEST.md records the deviation.
        view.layer().set_corner_radius(largest_corner({ (*p).corner_radius }));
    }
    return;
}

fn largest_corner(c: vocab::Corners) -> f64 {
    var m: f64 = c.top_leading;
    if c.top_trailing > m { m = c.top_trailing; }
    if c.bottom_leading > m { m = c.bottom_leading; }
    if c.bottom_trailing > m { m = c.bottom_trailing; }
    return m;
}

// ---- checkbox ----------------------------------------------------------------

fn create_checkbox(n: *core::Node) -> *u8 {
    let b: ak::Button = ak::Button::from_raw(rt::alloc_init(#str_ptr("NSButton\0")));
    b.set_button_type(ak::ButtonType::Switch);   // AppKit's name for a checkbox
    b.set_title("");
    return rt::retain(b.as_view().raw());
}

fn apply_checkbox(v: *u8, n: *core::Node, dirty: u64) {
    let p: *props::CheckboxProps = props_of(n, props::K_CHECKBOX) as *props::CheckboxProps;
    if p == (0 as *props::CheckboxProps) { return; }
    let b: ak::Button = ak::Button::from_raw(v);
    if (dirty & checkbox::P_ON) != (0 as u64) { b.set_state(state_of({ (*p).on })); }
    // The checked box is the one saturated part of a checkbox — the mark on it
    // is white and the unchecked border is grey — so the same hue rotation the
    // toggle and the progress bar use reaches exactly it. Swapping the ART for
    // tinted symbols was the alternative and it changes what a checkbox LOOKS
    // like, which is more than the verb asked for.
    if (dirty & checkbox::P_COLOR) != (0 as u64) {
        compose::hue_shift(v, { (*p).color });
    }
    if (dirty & props::C_HANDLERS) != (0 as u64) || dirty == paint::all_bits() {
        // Through the trampoline, always — the write-back is not conditional on
        // the application having a handler. `checkbox.on()` has to be true
        // whether or not anyone asked to be told.
        let f: fn(*u8, *u8) = checkbox_action;
        akx::set_control_action_ctx(b.as_control(), f, n as *u8);
    }
    if (dirty & props::C_IS_ENABLED) != (0 as u64) || dirty == paint::all_bits() {
        b.as_control().set_enabled(core::is_enabled(n));
    }
    return;
}

// ---- radio -------------------------------------------------------------------
// AppKit groups radios by SUPERVIEW, not by name: NSButtons of type Radio that
// share a superview deselect each other automatically. facet's `group` names
// the set instead, which is the portable model — so a group that does not
// match the tree's shape is not honoured, and MANIFEST.md records it.

fn create_radio(n: *core::Node) -> *u8 {
    let b: ak::Button = ak::Button::from_raw(rt::alloc_init(#str_ptr("NSButton\0")));
    b.set_button_type(ak::ButtonType::Radio);
    return rt::retain(b.as_view().raw());
}

// ---- radio groups ------------------------------------------------------------
// AppKit groups NSButtons of type Radio by SUPERVIEW: radios sharing a
// superview deselect each other and there is no group name. facet names the
// group instead, which is the portable model — and a portable model the
// backend declines to honour is a backend rendering the description wrong, not
// a platform limit. So the group is honoured HERE.
//
// The rule is the one AppKit's own grouping implements: turning a radio ON
// turns off every other radio naming the same group. The search is over the
// mounted roots rather than the node's siblings, because a facet group is a
// NAME and its members need not share a parent — which is the whole reason
// facet names it rather than inferring it from the tree.

fn radio_props(n: *core::Node) -> *props::RadioProps {
    let d: *core::Data = core::node_data(n);
    if d == (0 as *core::Data) { return 0 as *props::RadioProps; }
    if { (*d).kind } != props::K_RADIO { return 0 as *props::RadioProps; }
    return { (*d).props } as *props::RadioProps;
}

// Turn off every radio in `group` except `keep`. Writes the prop AND the
// control: the prop because `on()` reads it, the control because that is what
// the user sees, and updating one without the other is two answers to one
// question.
fn clear_group(n: *core::Node, group: str, keep: *core::Node) {
    if n == (0 as *core::Node) { return; }
    let p: *props::RadioProps = radio_props(n);
    if p != (0 as *props::RadioProps) && n != keep {
        if { (*p).group.view() } == group && { (*p).on } {
            { (*p).on = false };
            let v: *u8 = core::view_of(n);
            if v != (0 as *u8) { ak::Button::from_raw(v).set_state(state_off()); }
        }
    }
    var i: usize = 0 as usize;
    let count: usize = core::child_count_of(n);
    while i < count {
        match core::child_of(n, i) {
            option::Option[*core::Node]::Some(c) => { clear_group(c, group, keep); }
            option::Option[*core::Node]::None => { }
        }
        i = i +% (1 as usize);
    }
    return;
}

// The action, wrapped: the group settles first, then the application's own
// handler runs — so a handler that asks which radio is on gets the answer
// after the group settled rather than during.
fn radio_action(sender: *u8, ctx: *u8) {
    let n: *core::Node = ctx as *core::Node;
    if n == (0 as *core::Node) { return; }
    let p: *props::RadioProps = radio_props(n);
    if p == (0 as *props::RadioProps) { return; }
    let on: bool = ak::Button::from_raw(sender).state() == state_on();
    { (*p).on = on };
    let group: str = { (*p).group.view() };
    if on && group != "" {
        var w: usize = 0 as usize;
        let windows: usize = app::window_count();
        while w < windows {
            clear_group(app::window_root(w), group, n);
            w = w +% (1 as usize);
        }
    }
    let h: fn(*u8, *u8) = { (*p).on_checked_changed };
    if h != props::no_handler { h(sender, { (*p).on_checked_changed_ctx }); }
    return;
}

fn apply_radio(v: *u8, n: *core::Node, dirty: u64) {
    let p: *props::RadioProps = props_of(n, props::K_RADIO) as *props::RadioProps;
    if p == (0 as *props::RadioProps) { return; }
    let b: ak::Button = ak::Button::from_raw(v);
    if (dirty & radio::P_ON) != (0 as u64) { b.set_state(state_of({ (*p).on })); }
    // `RadioButton.Content` — ledger row types it `object` and every platform
    // handler renders it through ContentAsString, so facet types it as the
    // LABEL it is. An NSButton of type Radio draws its title beside the dot,
    // which is the composition: one control, two things drawn.
    //
    // Three verbs come with it and could not mean anything before: a text
    // colour, a transform and a kern all style a string a radio did not have.
    // NSButton has no `setTextColor:`, so any of them makes it attributed —
    // the same rule `apply_button` follows.
    let title_bits: u64 = radio::P_TEXT | radio::P_TEXT_TRANSFORM
        | radio::P_TEXT_COLOR | radio::P_CHARACTER_SPACING
        | radio::P_FONT_SIZE | radio::P_FONT_WEIGHT | radio::P_FONT_FAMILY
        | radio::P_FONT_SCALES
        | radio::P_IS_ITALIC;
    if (dirty & title_bits) != (0 as u64) {
        let shown: text::Text = paint::transformed({ (*p).text.view() }, { (*p).text_transform });
        if radio_wants_rich(p) {
            let a: *u8 = paint::attributed(shown.view(), radio_attributes(p));
            if a != (0 as *u8) {
                { rt::msg_void_id(v, rt::sel(#str_ptr("setAttributedTitle:\0")), a) };
                rt::release(a);
            }
        } else {
            b.set_title(shown.view());
        }
    }
    if (dirty & (radio::P_FONT_SCALES | radio::P_FONT_SIZE | radio::P_FONT_WEIGHT | radio::P_FONT_FAMILY
                 | radio::P_IS_ITALIC)) != (0 as u64) {
        match paint::ns_font_scaled({ (*p).font_size }, { (*p).font_weight },
                                    { (*p).font_family.view() }, { (*p).is_italic },
                                    { (*p).font_scales }) {
            option::Option[ak::Font]::Some(font) => { b.as_control().set_font(font); }
            option::Option[ak::Font]::None => { }
        }
    }
    if (dirty & (radio::P_BORDER_COLOR | radio::P_BORDER_WIDTH | radio::P_CORNER_RADIUS)) != (0 as u64) {
        apply_border(v, { (*p).border_color }, { (*p).border_width }, { (*p).corner_radius },
                     (dirty & (radio::P_BORDER_COLOR | radio::P_BORDER_WIDTH)) != (0 as u64),
                     (dirty & radio::P_CORNER_RADIUS) != (0 as u64));
    }
    if (dirty & (props::C_HANDLERS | radio::P_GROUP)) != (0 as u64) || dirty == paint::all_bits() {
        // Through the group trampoline, not straight to the handler: the group
        // has to settle before the application is told.
        let f: fn(*u8, *u8) = radio_action;
        akx::set_control_action_ctx(b.as_control(), f, n as *u8);
    }
    if (dirty & props::C_IS_ENABLED) != (0 as u64) || dirty == paint::all_bits() {
        b.as_control().set_enabled(core::is_enabled(n));
    }
    return;
}

// ---- toggle ------------------------------------------------------------------
// NSSwitch, which is the real thing rather than a checkbox wearing a label.
// Its colours are the system's: `on_color` / `off_color` / `thumb_color` have
// no AppKit equivalent, and MANIFEST.md records that rather than faking them
// with a tinted layer that would stop tracking the appearance.

// A colour or a kern has no plain-title form on NSButton, so a radio that
// asks for either is drawn attributed. One that asks for neither keeps the
// plain path — the same gate `button_wants_rich` applies.
fn radio_wants_rich(p: *props::RadioProps) -> bool {
    if { (*p).text_color }.is_set() { return true; }
    return paint::wants_rich({ (*p).character_spacing }, 0.0f64, vocab::TextDecoration::None);
}

fn radio_attributes(p: *props::RadioProps) -> *u8 {
    return paint::rich_attributes(
        paint::ns_font_scaled({ (*p).font_size }, { (*p).font_weight },
                              { (*p).font_family.view() }, { (*p).is_italic },
                              { (*p).font_scales }),
        { (*p).text_color }, { (*p).character_spacing }, 0.0f64,
        option::Option[vocab::TextAlign]::None, vocab::TextDecoration::None);
}

// A toggle that names an achromatic colour is DRAWN; one that does not stays an
// NSSwitch with everything NSSwitch has. The choice is made from the props at
// create time, so it is the application's rather than the backend's — and the
// drawn one answers `state` / `setState:`, so every caller that already speaks
// to a toggle keeps working either way.
static TOGGLE_COLORS: compose::SwitchColors = #zero::[compose::SwitchColors]();

fn create_toggle(n: *core::Node) -> *u8 {
    let p: *props::ToggleProps = props_of(n, props::K_TOGGLE) as *props::ToggleProps;
    if p != (0 as *props::ToggleProps) {
        if compose::wants_drawn_switch({ (*p).off_color }, { (*p).thumb_color }) {
            let drawn: *u8 = compose::new_drawn_switch();
            if drawn != (0 as *u8) { return rt::retain(drawn); }
        }
    }
    let s: ak::Switch = ak::Switch::from_raw(rt::alloc_init(#str_ptr("NSSwitch\0")));
    return rt::retain(s.as_view().raw());
}

fn apply_toggle(v: *u8, n: *core::Node, dirty: u64) {
    let p: *props::ToggleProps = props_of(n, props::K_TOGGLE) as *props::ToggleProps;
    if p == (0 as *props::ToggleProps) { return; }
    let s: ak::Switch = ak::Switch::from_raw(v);
    // The DRAWN posture: a toggle that named an achromatic colour. Its state,
    // its three colours and its action all go on in one call, because the
    // drawn control has no cell to hold half of them.
    if compose::wants_drawn_switch({ (*p).off_color }, { (*p).thumb_color }) {
        let band: u64 = toggle::P_ON | toggle::P_ON_COLOR | toggle::P_OFF_COLOR
            | toggle::P_THUMB_COLOR | props::C_HANDLERS;
        if (dirty & band) != (0 as u64) || dirty == paint::all_bits() {
            TOGGLE_COLORS = compose::SwitchColors {
                on: { (*p).on_color }, off: { (*p).off_color }, thumb: { (*p).thumb_color },
            };
            let f: fn(*u8, *u8) = toggle_action;
            compose::apply_drawn_switch(v, { (*p).on }, #addr_of(TOGGLE_COLORS), f, n as *u8);
        }
        if (dirty & props::C_IS_ENABLED) != (0 as u64) || dirty == paint::all_bits() {
            ak::View::from_raw(v).set_hidden(core::is_visible(n) == false);
        }
        return;
    }
    if (dirty & toggle::P_ON) != (0 as u64) { s.set_state(state_of({ (*p).on })); }
    // The ON track is the switch's one saturated part, so a hue rotation reaches
    // it and nothing else. The off track and the thumb are ACHROMATIC — grey has
    // no hue to rotate — which is why naming either draws the switch instead.
    if (dirty & toggle::P_ON_COLOR) != (0 as u64) {
        compose::hue_shift(v, { (*p).on_color });
    }
    if (dirty & props::C_HANDLERS) != (0 as u64) || dirty == paint::all_bits() {
        let f: fn(*u8, *u8) = toggle_action;
        akx::set_control_action_ctx(s.as_control(), f, n as *u8);
    }
    if (dirty & props::C_IS_ENABLED) != (0 as u64) || dirty == paint::all_bits() {
        s.as_control().set_enabled(core::is_enabled(n));
    }
    return;
}

// ---- slider ------------------------------------------------------------------

fn create_slider(n: *core::Node) -> *u8 {
    let s: ak::Slider = ak::Slider::from_raw(rt::alloc_init(#str_ptr("NSSlider\0")));
    return rt::retain(s.as_view().raw());
}

fn apply_slider(v: *u8, n: *core::Node, dirty: u64) {
    let p: *props::SliderProps = props_of(n, props::K_SLIDER) as *props::SliderProps;
    if p == (0 as *props::SliderProps) { return; }
    let s: ak::Slider = ak::Slider::from_raw(v);
    // The range goes on before the value, or a value outside the OLD range is
    // clamped away and the write is silently lost.
    if (dirty & slider::P_MINIMUM) != (0 as u64) { s.set_min_value({ (*p).minimum }); }
    if (dirty & slider::P_MAXIMUM) != (0 as u64) { s.set_max_value({ (*p).maximum }); }
    if (dirty & (slider::P_VALUE | slider::P_MINIMUM | slider::P_MAXIMUM)) != (0 as u64) {
        s.as_control().set_double_value({ (*p).value });
    }
    if (dirty & props::C_HANDLERS) != (0 as u64) || dirty == paint::all_bits() {
        akx::set_control_action_ctx(s.as_control(), { (*p).on_value_changed }, { (*p).on_value_changed_ctx });
        // `on_drag_started` / `on_drag_completed` are the EDGES of a drag, and
        // NSSlider reports them the same way it reports the value: through the
        // action, with `isTracking` saying which edge this is. A continuous
        // slider fires the action throughout, so the two edges are the first
        // action with tracking on and the first with it off.
        text_input::install_slider(v, n);
    }
    // The FILLED part of the track has had a setter since 10.12 —
    // `trackFillColor` — and it is exactly the ledger's MinimumTrackColor. The other
    // two stay in the ledger: the empty track and the knob are drawn by
    // NSSliderCell with no colour slot of their own.
    // "NSSlider's knob is cell-drawn; there is no image slot" stops one step
    // short: the cell that draws it has a METHOD for drawing it.
    if (dirty & slider::P_THUMB_IMAGE) != (0 as u64) {
        compose::apply_thumb_image(v, { (*p).thumb_image.view() });
    }
    if (dirty & slider::P_MINIMUM_TRACK_COLOR) != (0 as u64) {
        let c: vocab::Color = { (*p).minimum_track_color };
        if c.is_set() {
            { rt::msg_void_id(v, rt::sel(#str_ptr("setTrackFillColor:\0")),
                              paint::ns_color(c).raw()) };
        }
    }
    // The other two halves of the same control. `drawBarInside:flipped:` and
    // `drawKnob:` are the CELL'S OWN drawing hooks — not a layer under the
    // slider, which is what the manifest rejected and still rejects. Only a
    // slider that names a colour is drawn this way.
    if (dirty & (slider::P_MAXIMUM_TRACK_COLOR | slider::P_THUMB_COLOR)) != (0 as u64) {
        compose::apply_slider_colors(v, { (*p).maximum_track_color }, { (*p).thumb_color });
    }
    if (dirty & props::C_IS_ENABLED) != (0 as u64) || dirty == paint::all_bits() {
        s.as_control().set_enabled(core::is_enabled(n));
    }
    return;
}

// ---- is_opaque ---------------------------------------------------------------
// `-[NSView isOpaque]` is a derived getter with no setter, which is what the
// ledger said. But the STATEMENT the property makes — nothing shows through
// this — is settable one level down, on the backing layer, and that is the
// level the compositor reads it at. `image` and `icon_button` are the two
// kinds that declare it.
//
// Only an opaque node forces a layer. A view that asks for `is_opaque: false`
// and has no layer already is describing what it does anyway, and giving it
// one to say so would cost a backing store per image.
fn apply_is_opaque(v: *u8, opaque_: bool) {
    let view: ak::View = ak::View::from_raw(v);
    if opaque_ { view.set_wants_layer(true); }
    if view.wants_layer() == false { return; }
    view.layer().set_opaque(opaque_);
    return;
}

// ---- progress ----------------------------------------------------------------
// A determinate bar. facet's `progress` is 0..1; NSProgressIndicator takes a
// range, so the range is fixed at 0..1 and the value is written straight.

fn create_progress(n: *core::Node) -> *u8 {
    let pi: ak::ProgressIndicator = ak::ProgressIndicator::from_raw(rt::alloc_init(#str_ptr("NSProgressIndicator\0")));
    pi.set_style(ak::ProgressIndicatorStyle::Bar);
    pi.set_indeterminate(false);
    pi.set_min_value(0.0f64);
    pi.set_max_value(1.0f64);
    return rt::retain(pi.as_view().raw());
}

fn apply_progress(v: *u8, n: *core::Node, dirty: u64) {
    let p: *props::ProgressProps = props_of(n, props::K_PROGRESS) as *props::ProgressProps;
    if p == (0 as *props::ProgressProps) { return; }
    let pi: ak::ProgressIndicator = ak::ProgressIndicator::from_raw(v);
    if (dirty & progress::P_PROGRESS) != (0 as u64) { pi.set_double_value({ (*p).progress }); }
    // A hue rotation over the bar's OWN drawing: the fill is saturated and moves
    // to the asked-for hue, the track is grey and has no hue to rotate, so it
    // stays. That is a tint rather than a fill — it keeps the system's
    // saturation and brightness — and MANIFEST says so.
    if (dirty & progress::P_PROGRESS_COLOR) != (0 as u64) {
        compose::hue_shift(v, { (*p).progress_color });
    }
    // `animate_progress` is a COMMAND — "slide to the current progress over
    // `animate_duration`" — not a flag. NSProgressIndicator has no animated
    // setter, so the animation is the ANIMATOR PROXY's, which is AppKit's own
    // way of saying the same thing and gets the timing curve for free.
    if (dirty & progress::P_ANIMATE_PROGRESS) != (0 as u64) {
        let secs: f64 = { (*p).animate_duration.seconds };
        if secs <= 0.0f64 {
            pi.set_double_value({ (*p).progress });
        } else {
            let cls: *u8 = rt::get_class(#str_ptr("NSAnimationContext\0"));
            { rt::msg_void(cls, rt::sel(#str_ptr("beginGrouping\0"))) };
            let ctx: *u8 = { rt::msg_id(cls, rt::sel(#str_ptr("currentContext\0"))) };
            if ctx != (0 as *u8) {
                { msg_void_f64(ctx, rt::sel(#str_ptr("setDuration:\0")), secs) };
            }
            let anim: *u8 = { rt::msg_id(v, rt::sel(#str_ptr("animator\0"))) };
            if anim != (0 as *u8) {
                { msg_void_f64(anim, rt::sel(#str_ptr("setDoubleValue:\0")), { (*p).progress }) };
            }
            { rt::msg_void(cls, rt::sel(#str_ptr("endGrouping\0"))) };
        }
    }
    return;
}

#[link_name = "objc_msgSend"]
extern fn msg_void_f64(recv: *u8, sel: *u8, a: f64);

// ---- spinner -----------------------------------------------------------------
// The same class in its indeterminate posture. It must be told to ANIMATE, not
// merely shown: a stopped spinner draws nothing, which reads as a broken view.

fn create_spinner(n: *core::Node) -> *u8 {
    let pi: ak::ProgressIndicator = ak::ProgressIndicator::from_raw(rt::alloc_init(#str_ptr("NSProgressIndicator\0")));
    pi.set_style(ak::ProgressIndicatorStyle::Spinning);
    pi.set_indeterminate(true);
    return rt::retain(pi.as_view().raw());
}

fn apply_spinner(v: *u8, n: *core::Node, dirty: u64) {
    let p: *props::SpinnerProps = props_of(n, props::K_SPINNER) as *props::SpinnerProps;
    if p == (0 as *props::SpinnerProps) { return; }
    let pi: ak::ProgressIndicator = ak::ProgressIndicator::from_raw(v);
    if (dirty & spinner::P_IS_RUNNING) != (0 as u64) {
        if { (*p).is_running } { pi.start_animation(0 as *u8); } else { pi.stop_animation(0 as *u8); }
    }
    // A spinner is UNIFORM, so mapping its drawing onto one colour is exactly
    // what tinting it means — the same filter the refresh strip's spinner uses.
    if (dirty & spinner::P_COLOR) != (0 as u64) {
        compose::tint_spinner(v, { (*p).color });
    }
    return;
}

// ---- stepper -----------------------------------------------------------------

fn create_stepper(n: *core::Node) -> *u8 {
    let s: ak::Stepper = ak::Stepper::from_raw(rt::alloc_init(#str_ptr("NSStepper\0")));
    return rt::retain(s.as_view().raw());
}

fn apply_stepper(v: *u8, n: *core::Node, dirty: u64) {
    let p: *props::StepperProps = props_of(n, props::K_STEPPER) as *props::StepperProps;
    if p == (0 as *props::StepperProps) { return; }
    let s: ak::Stepper = ak::Stepper::from_raw(v);
    if (dirty & stepper::P_MINIMUM) != (0 as u64) { s.set_min_value({ (*p).minimum }); }
    if (dirty & stepper::P_MAXIMUM) != (0 as u64) { s.set_max_value({ (*p).maximum }); }
    if (dirty & stepper::P_INCREMENT) != (0 as u64) { s.set_increment({ (*p).increment }); }
    // Same ordering trap as the slider: range first, then the value.
    if (dirty & (stepper::P_VALUE | stepper::P_MINIMUM | stepper::P_MAXIMUM)) != (0 as u64) {
        s.as_control().set_double_value({ (*p).value });
    }
    if (dirty & props::C_HANDLERS) != (0 as u64) || dirty == paint::all_bits() {
        let f: fn(*u8, *u8) = stepper_action;
        akx::set_control_action_ctx(s.as_control(), f, n as *u8);
    }
    if (dirty & props::C_IS_ENABLED) != (0 as u64) || dirty == paint::all_bits() {
        s.as_control().set_enabled(core::is_enabled(n));
    }
    return;
}

// ---- text_button -------------------------------------------------------------
// A button that is only its text: no bezel, no background, no border. The
// posture the ledger expresses by clearing three properties and facet could not
// express at all, because clearing `background_color` clears a CALayer facet
// adds while the bezel is drawn by NSButton's cell underneath it.
//
// `setBordered:false` is the whole mechanism, and `icon_button` has used it
// since it was written — the same line, for the same reason.

fn create_text_button(n: *core::Node) -> *u8 {
    let b: ak::Button = ak::Button::from_raw(rt::alloc_init(#str_ptr("NSButton\0")));
    // MomentaryChange, like icon_button: MomentaryPushIn draws a pushed-in
    // BEZEL on press, which is exactly what this control exists not to have.
    // A toggling button asks for PushOnPushOff in `apply` instead, where the
    // prop is readable.
    b.set_button_type(ak::ButtonType::MomentaryChange);
    b.set_bordered(false);
    return rt::retain(b.as_view().raw());
}

fn text_button_wants_rich(p: *text_button::TextButtonProps) -> bool {
    if { (*p).text_color }.is_set() { return true; }
    if { (*p).character_spacing } != 0.0f64 { return true; }
    if { (*p).is_italic } { return true; }
    // NSButton has no plain setter for an underline either, so asking for one
    // is what makes the title attributed.
    return match { (*p).text_decoration } {
        vocab::TextDecoration::None => false,
        _ => true,
    };
}

fn text_button_attributes(p: *text_button::TextButtonProps) -> *u8 {
    return paint::rich_attributes(
        paint::ns_font_scaled({ (*p).font_size }, { (*p).font_weight },
                              { (*p).font_family.view() }, { (*p).is_italic },
                              { (*p).font_scales }),
        { (*p).text_color }, { (*p).character_spacing }, 0.0f64,
        option::Option[vocab::TextAlign]::None, { (*p).text_decoration });
}

fn apply_text_button(v: *u8, n: *core::Node, dirty: u64) {
    let p: *text_button::TextButtonProps =
        props_of(n, text_button::K_TEXT_BUTTON) as *text_button::TextButtonProps;
    if p == (0 as *text_button::TextButtonProps) { return; }
    let b: ak::Button = ak::Button::from_raw(v);
    let title_bits: u64 = text_button::P_TITLE | text_button::P_TEXT_TRANSFORM
        | text_button::P_CHARACTER_SPACING | text_button::P_TEXT_COLOR
        | text_button::P_IS_ITALIC | text_button::P_FONT_SIZE
        | text_button::P_FONT_WEIGHT | text_button::P_FONT_FAMILY
        | text_button::P_FONT_SCALES | text_button::P_TEXT_DECORATION;
    if (dirty & title_bits) != (0 as u64) || dirty == paint::all_bits() {
        let shown: text::Text = paint::transformed({ (*p).title.view() }, { (*p).text_transform });
        // NSButton has no plain setter for a title COLOUR, so a text button
        // that names one is given an attributed title — the same split
        // `apply_button` makes, and the common case here since the whole point
        // of a flat button is usually its tint.
        if text_button_wants_rich(p) {
            let a: *u8 = paint::attributed(shown.view(), text_button_attributes(p));
            if a != (0 as *u8) {
                { rt::msg_void_id(v, rt::sel(#str_ptr("setAttributedTitle:\0")), a) };
                { rt::release(a) };
            }
        } else {
            b.set_title(shown.view());
        }
    }
    if (dirty & (text_button::P_FONT_SIZE | text_button::P_FONT_WEIGHT
                 | text_button::P_FONT_FAMILY | text_button::P_IS_ITALIC
                 | text_button::P_FONT_SCALES)) != (0 as u64) || dirty == paint::all_bits() {
        match paint::ns_font_scaled({ (*p).font_size }, { (*p).font_weight },
                                    { (*p).font_family.view() }, { (*p).is_italic },
                                    { (*p).font_scales }) {
            option::Option[ak::Font]::Some(font) => { b.as_control().set_font(font); }
            option::Option[ak::Font]::None => { }
        }
    }
    // A click FLIPS when the button toggles, and AppKit's own PushOnPushOff
    // holds that state — so there is no second copy to keep in step, and the
    // pressed look a bordered control would draw is absent because the button
    // is borderless either way.
    if (dirty & text_button::P_TOGGLES) != (0 as u64) || dirty == paint::all_bits() {
        if { (*p).toggles } { b.set_button_type(ak::ButtonType::PushOnPushOff); }
        else { b.set_button_type(ak::ButtonType::MomentaryChange); }
        // set_button_type resets `bordered` on some AppKit versions; restate it.
        b.set_bordered(false);
    }
    if (dirty & text_button::P_ON) != (0 as u64) || dirty == paint::all_bits() {
        b.set_state(state_of({ (*p).on }));
    }
    // The border is DESCRIBED and SWITCHED separately: colour, width and radius
    // stay where the application put them and `bordered` says whether they are
    // drawn. A width of 0 would have meant redescribing the border every time
    // it came back, which is the whole shape a chip or a filter button needs.
    if (dirty & (text_button::P_BORDERED | text_button::P_BORDER_COLOR
                 | text_button::P_BORDER_WIDTH | text_button::P_CORNER_RADIUS))
       != (0 as u64) || dirty == paint::all_bits() {
        let w: f64 = if { (*p).bordered } { { (*p).border_width } } else { 0.0f64 };
        apply_border(v, { (*p).border_color }, w, { (*p).corner_radius }, true, true);
    }
    if (dirty & props::C_HANDLERS) != (0 as u64) || dirty == paint::all_bits() {
        let f: fn(*u8, *u8) = text_button_action;
        akx::set_control_action_ctx(b.as_control(), f, n as *u8);
    }
    if (dirty & props::C_IS_ENABLED) != (0 as u64) || dirty == paint::all_bits() {
        b.as_control().set_enabled(core::is_enabled(n));
    }
    return;
}

// ---- icon_button -------------------------------------------------------------
// A button whose content is an image rather than a title. Borderless, because
// an app reaching for this wants the icon and not a bezel around it.

fn create_icon_button(n: *core::Node) -> *u8 {
    let b: ak::Button = ak::Button::from_raw(rt::alloc_init(#str_ptr("NSButton\0")));
    b.set_button_type(ak::ButtonType::MomentaryChange);
    b.set_bordered(false);
    b.set_title("");
    return rt::retain(b.as_view().raw());
}

fn apply_icon_button(v: *u8, n: *core::Node, dirty: u64) {
    let p: *props::IconButtonProps = props_of(n, props::K_ICON_BUTTON) as *props::IconButtonProps;
    if p == (0 as *props::IconButtonProps) { return; }
    let b: ak::Button = ak::Button::from_raw(v);
    if (dirty & icon_button::P_SOURCE) != (0 as u64) {
        match resolve_image({ (*p).source.view() }) {
            option::Option[ak::Image]::Some(img) => { b.set_image(img); }
            option::Option[ak::Image]::None => { }
        }
    }
    if (dirty & icon_button::P_FIT) != (0 as u64) {
        b.set_image_scaling(ns_image_scaling({ (*p).fit }));
    }
    if (dirty & icon_button::P_IS_OPAQUE) != (0 as u64) { apply_is_opaque(v, { (*p).is_opaque }); }
    // icon_button is created borderless on purpose, so `bordered` here is the
    // CALayer border rather than a bezel: switching it on gives an icon its
    // outline back without turning it into a bezelled push button.
    if (dirty & icon_button::P_TOGGLES) != (0 as u64) || dirty == paint::all_bits() {
        if { (*p).toggles } { b.set_button_type(ak::ButtonType::PushOnPushOff); }
        else { b.set_button_type(ak::ButtonType::MomentaryChange); }
        b.set_bordered(false);
    }
    if (dirty & icon_button::P_ON) != (0 as u64) || dirty == paint::all_bits() {
        b.set_state(state_of({ (*p).on }));
    }
    if (dirty & (icon_button::P_BORDERED | icon_button::P_BORDER_COLOR
                 | icon_button::P_BORDER_WIDTH | icon_button::P_CORNER_RADIUS))
       != (0 as u64) || dirty == paint::all_bits() {
        let w: f64 = if { (*p).bordered } { { (*p).border_width } } else { 0.0f64 };
        apply_border(v, { (*p).border_color }, w, { (*p).corner_radius }, true, true);
    }
    if (dirty & props::C_HANDLERS) != (0 as u64) || dirty == paint::all_bits() {
        let f: fn(*u8, *u8) = icon_button_action;
        akx::set_control_action_ctx(b.as_control(), f, n as *u8);
    }
    if (dirty & props::C_IS_ENABLED) != (0 as u64) || dirty == paint::all_bits() {
        b.as_control().set_enabled(core::is_enabled(n));
    }
    return;
}

// ---- symbol ------------------------------------------------------------------
// An icon from a NAMED set. facet carries two: the OS's own (SF Symbols on
// macOS) and a bundled font whose glyph is a codepoint. The System set maps
// straight onto AppKit; the Bundled set is a glyph rendered as text.

fn create_symbol(n: *core::Node) -> *u8 {
    let f: ak::TextField = ak::TextField::label_with_string("");
    return rt::retain(f.as_view().raw());
}

// ---- the bundled glyph tier --------------------------------------------------
// A codepoint rendered in a font registered FOR THIS PROCESS ONLY. Nothing is
// installed on the machine: `CTFontManagerRegisterFontsForURL` with
// `kCTFontManagerScopeProcess` is the whole mechanism, and it is undone when
// the process exits.
//
// The font is found rather than assumed, in the order an application actually
// ships one: its own bundle first (a packaged .app), then the vendored asset
// (running from a source tree, which is every example today). A font that is
// found nowhere leaves the label empty and says so ONCE — a symbol that fails
// silently is indistinguishable from a symbol that is not there, and this verb
// spent its whole life indistinguishable from working.

#[link_name = "CTFontManagerRegisterFontsForURL"]
extern fn ct_register_fonts_for_url(url: *u8, scope: u32, error: *u8) -> i8;

fn ct_scope_process() -> u32 { return 1u32; }
fn bundled_family() -> str { return "Material Symbols Outlined"; }

static SYMBOL_FONT_TRIED: bool = false;
static SYMBOL_FONT_OK: bool = false;

fn register_bundled_font() -> bool {
    if SYMBOL_FONT_TRIED { return SYMBOL_FONT_OK; }
    SYMBOL_FONT_TRIED = true;
    // Already present (installed system-wide, or registered by the host app)?
    match ak::Font::font_with_name(bundled_family(), 12.0f64) {
        option::Option[ak::Font]::Some(_f) => { SYMBOL_FONT_OK = true; return true; }
        option::Option[ak::Font]::None => { }
    }
    if register_font_url(bundle_font_url()) { SYMBOL_FONT_OK = true; return true; }
    if register_font_at("vendor/facet/assets/MaterialSymbolsOutlined.ttf") { SYMBOL_FONT_OK = true; return true; }
    if register_font_at("../../vendor/facet/assets/MaterialSymbolsOutlined.ttf") { SYMBOL_FONT_OK = true; return true; }
    io::println("facet_appkit: the bundled symbol font was not found; symbol(icon:) renders nothing");
    return false;
}

// The app bundle's own copy, as an NSURL, when there is a bundle. Answers the
// URL directly rather than a path string: NSBundle hands back an NSString and
// NSURL wants one, so converting to `str` and back would be a round trip for
// nothing.
fn bundle_font_url() -> *u8 {
    let b: *u8 = { rt::msg_id(rt::get_class(#str_ptr("NSBundle\0")),
                              rt::sel(#str_ptr("mainBundle\0"))) };
    if b == (0 as *u8) { return 0 as *u8; }
    let p: *u8 = { rt::msg_id_id_id(b, rt::sel(#str_ptr("pathForResource:ofType:\0")),
                                    bridge::nsstring("MaterialSymbolsOutlined"),
                                    bridge::nsstring("ttf")) };
    if p == (0 as *u8) { return 0 as *u8; }
    return { rt::msg_id_id(rt::get_class(#str_ptr("NSURL\0")),
                           rt::sel(#str_ptr("fileURLWithPath:\0")), p) };
}

fn register_font_at(path: str) -> bool {
    if path == "" { return false; }
    return register_font_url({ rt::msg_id_id(rt::get_class(#str_ptr("NSURL\0")),
                                             rt::sel(#str_ptr("fileURLWithPath:\0")),
                                             bridge::nsstring(path)) });
}

fn register_font_url(url: *u8) -> bool {
    if url == (0 as *u8) { return false; }
    if { ct_register_fonts_for_url(url, ct_scope_process(), 0 as *u8) } == (0 as i8) { return false; }
    match ak::Font::font_with_name(bundled_family(), 12.0f64) {
        option::Option[ak::Font]::Some(_f) => { return true; }
        option::Option[ak::Font]::None => { return false; }
    }
}

// A codepoint as an NSString. UTF-8 encoded by hand because the glyphs live in
// the Private Use Area and there is no str literal for them.
fn nsstring_of_codepoint(cp: u32) -> *u8 {
    var buf: [u8; 8] = [0u8; 8];
    var n: usize = 0 as usize;
    if cp < 0x80u32 {
        buf[0 as usize] = cp as u8;
        n = 1 as usize;
    } else if cp < 0x800u32 {
        buf[0 as usize] = (0xC0u32 | (cp >> 6u32)) as u8;
        buf[1 as usize] = (0x80u32 | (cp & 0x3Fu32)) as u8;
        n = 2 as usize;
    } else if cp < 0x10000u32 {
        buf[0 as usize] = (0xE0u32 | (cp >> 12u32)) as u8;
        buf[1 as usize] = (0x80u32 | ((cp >> 6u32) & 0x3Fu32)) as u8;
        buf[2 as usize] = (0x80u32 | (cp & 0x3Fu32)) as u8;
        n = 3 as usize;
    } else {
        buf[0 as usize] = (0xF0u32 | (cp >> 18u32)) as u8;
        buf[1 as usize] = (0x80u32 | ((cp >> 12u32) & 0x3Fu32)) as u8;
        buf[2 as usize] = (0x80u32 | ((cp >> 6u32) & 0x3Fu32)) as u8;
        buf[3 as usize] = (0x80u32 | (cp & 0x3Fu32)) as u8;
        n = 4 as usize;
    }
    buf[n] = 0u8;
    return { rt::msg_id_id(rt::get_class(#str_ptr("NSString\0")),
                           rt::sel(#str_ptr("stringWithUTF8String:\0")),
                           #addr_of(buf) as *u8) };
}

// `font` names a family of the application's own when it is set; otherwise the
// bundled one. That is what makes `font` a real verb rather than a synonym.
fn apply_bundled_glyph(f: ak::TextField, p: *symbol::SymbolProps, pt: f64) {
    let cp: u32 = { (*p).icon };
    if cp == (0u32) { return; }
    let named: str = { (*p).font.view() };
    var family: str = bundled_family();
    if named != "" {
        family = named;
    } else {
        if !register_bundled_font() { return; }
    }
    var size: f64 = pt;
    if (size > 0.0f64) == false { size = 24.0f64; }
    match ak::Font::font_with_name(family, size) {
        option::Option[ak::Font]::Some(fnt) => { f.as_control().set_font(fnt); }
        // A family the machine does not have leaves the glyph unset rather
        // than drawing a tofu box in the system font.
        option::Option[ak::Font]::None => { return; }
    }
    { rt::msg_void_id(f.as_control().raw(), rt::sel(#str_ptr("setStringValue:\0")),
                      nsstring_of_codepoint(cp)) };
    return;
}

fn apply_symbol(v: *u8, n: *core::Node, dirty: u64) {
    let p: *symbol::SymbolProps = props_of(n, symbol::K_SYMBOL) as *symbol::SymbolProps;
    if p == (0 as *symbol::SymbolProps) { return; }
    let f: ak::TextField = ak::TextField::from_raw(v);
    if (dirty & (symbol::P_NAME | symbol::P_ICON | symbol::P_SIZE | symbol::P_FONT
                 | symbol::P_FILL)) != (0 as u64) {
        // The System set is a real SF Symbol; a bundled glyph is its codepoint
        // in facet's own font. Either way it lands in a label, so the shared
        // band and the frame walk treat it like any other leaf.
        let pt: f64 = { (*p).size };
        if pt > 0.0f64 { f.as_control().set_font(ak::Font::system_font_of_size(pt)); }
        // The BUNDLED tier: a codepoint in facet's own font, which is the set
        // `symbol` recommends and the one 4,268 constants in `facet/icons` are
        // written for. It had no implementation at all — this body masked on
        // P_ICON | P_FONT and then read neither field, so `symbol(icons::home)`
        // put an empty string in a label and the coverage gate scored two live
        // verbs off the mask.
        match { (*p).set } {
            symbol::IconSet::Bundled => { apply_bundled_glyph(f, p, pt); }
            symbol::IconSet::System => { }
        }
        let name: str = { (*p).name.view() };
        if name != "" {
            // SF Symbols spell the filled variant as a NAME — "house" and
            // "house.fill" are two symbols, not one symbol with a property —
            // so `fill` picks the name rather than setting an axis. Between the
            // two it rounds: a partial fill is a variable-font axis the system
            // set does not expose, and MANIFEST records that.
            var want: text::Text = text::from_str(name);
            if { (*p).fill } >= 0.5f64 { let _a: status::Status = want.append(".fill"); }
            match symbol_image(want.view(), name) {
                // The stated box, if the node has one. It is a STYLE value, not
                // a layout result, so it is readable here — no pass has run yet.
                option::Option[ak::Image]::Some(img) => {
                    set_symbol_image(f, img, pt, stated_points({ (*n).style.width }),
                                     stated_points({ (*n).style.height }));
                }
                // A name the machine does not have leaves the field empty
                // rather than showing the name as text, which would read as a
                // rendering bug rather than a missing glyph.
                option::Option[ak::Image]::None => { f.as_control().set_string_value(""); }
            }
        }
    }
    if (dirty & symbol::P_COLOR) != (0 as u64) {
        let c: vocab::Color = { (*p).color };
        if c.is_set() { f.set_text_color(paint::ns_color(c)); }
    }
    return;
}

// One place that turns a facet image name into an NSImage: a system symbol
// first, then a bundle name, then a path on disk.
fn resolve_image(src: str) -> option::Option[ak::Image] {
    if src == "" { return option::Option[ak::Image]::None; }
    match ak::Image::image_with_system_symbol_name(src, "") {
        option::Option[ak::Image]::Some(img) => { return option::some(img); }
        option::Option[ak::Image]::None => { }
    }
    match ak::Image::image_named(src) {
        option::Option[ak::Image]::Some(named) => { return option::some(named); }
        option::Option[ak::Image]::None => { }
    }
    return option::some(ak::Image::new_with_contents_of_file(src));
}

// The filled name if there is one, else the plain name — so `fill: 1.0` on a
// symbol with no filled variant shows the outline rather than nothing.
fn symbol_image(filled: str, plain: str) -> option::Option[ak::Image] {
    match ak::Image::image_with_system_symbol_name(filled, "") {
        option::Option[ak::Image]::Some(img) => { return option::some(img); }
        option::Option[ak::Image]::None => { }
    }
    return ak::Image::image_with_system_symbol_name(plain, "");
}

// SIZE HAS TO REACH THE GLYPH.
//
// `imageWithSystemSymbolName:` answers an image configured for the BODY text
// style, and nothing here was changing it — so `size:` did nothing at all to a
// System symbol. Measured: `folder` came back 18x14 whether the node asked for
// 11pt or 15pt, identical images, and the only thing `size` moved was the
// LABEL's font, which changes the box around the glyph and not the glyph.
//
// Two symptoms, both reported as something else. A row of icons at `size: 15`
// drew at whatever the body style is, so `size` looked like it worked only
// because nobody compared two. And an icon given a box for the size it ASKED
// for — the PROJECT FILES header, `size: 11` in a `.width(16)` — was cut by
// that box, because the glyph inside it was still the bigger default one.
//
// `configurationWithPointSize:weight:` is the axis that answers. Weight is
// regular (`NSFontWeightRegular` is 0.0); `symbol` has no weight prop, and
// inventing one from `fill` would be two verbs on one axis.
//
// The sizing happens HERE rather than in a `-> ak::Image` helper because a
// by-value `ak::Image` param borrows: handing the caller's image back out of
// one would be a second owner (E0337). Both images live exactly as long as this
// call, and the attachment retains whichever is used.

// A symbol lands in a LABEL, so the image is an attachment in its attributed
// string. That is what keeps the shared band and the frame walk treating it
// like any other leaf — the alternative, an NSImageView, would need its own
// case in every one of them.
fn set_symbol_image(f: ak::TextField, img: ak::Image, pt: f64,
                    box_w: f64 = 0.0f64, box_h: f64 = 0.0f64) {
    if (pt > 0.0f64) == false {
        attach_symbol_image(f, img.raw());
        return;
    }
    // A STATED BOX SCALES THE GLYPH; IT NEVER CUTS IT.
    //
    // `symbol(...).width(16)` used to mean "draw the glyph you were going to
    // draw, in a 16pt window onto it" — which is a cut, and reads on screen as
    // a rendering fault rather than as a size. iris's PROJECT FILES header is
    // exactly that shape and showed exactly that.
    //
    // The size that fits is FOUND, not calculated. A label's fitting size is
    // its glyph plus insets that come from the FONT, so the arithmetic has no
    // closed form worth trusting (measured: +2pt at 11pt, +7pt at 15pt). One
    // ratio and a re-measure converges immediately, and three passes is a
    // ceiling nothing has been seen to need — a symbol asked to fit a box it
    // cannot is left at 1pt rather than at zero, which is visible.
    var use_pt: f64 = pt;
    var pass: i64 = 0 as i64;
    while pass < (3 as i64) {
        apply_symbol_at(f, img, use_pt);
        if (box_w > 0.0f64) == false && (box_h > 0.0f64) == false { return; }
        let fit: rt::Size = { msg_size_of_field(f.raw(), rt::sel(#str_ptr("fittingSize\0"))) };
        var ratio: f64 = 1.0f64;
        if box_w > 0.0f64 && fit.w > box_w && fit.w > 0.0f64 { ratio = box_w / fit.w; }
        if box_h > 0.0f64 && fit.h > box_h && fit.h > 0.0f64 {
            let r: f64 = box_h / fit.h;
            if r < ratio { ratio = r; }
        }
        // Fits. A glyph is never grown into a box bigger than it asked for:
        // `size` is the size, and a box is a bound.
        if ratio >= 0.999f64 { return; }
        use_pt = use_pt * ratio;
        if use_pt < 1.0f64 { use_pt = 1.0f64; }
        pass = pass + (1 as i64);
    }
    return;
}

// The label, carrying `img` at `pt`: the font that sets the line box, and the
// glyph configured to the same point size.
fn apply_symbol_at(f: ak::TextField, img: ak::Image, pt: f64) {
    f.as_control().set_font(ak::Font::system_font_of_size(pt));
    match img.image_with_symbol_configuration(
              ak::ImageSymbolConfiguration::configuration_with_point_size(pt, 0.0f64)) {
        option::Option[ak::Image]::Some(sized) => { attach_symbol_image(f, sized.raw()); return; }
        // A configuration the system declines leaves the image as it came,
        // which is what every caller got before this existed.
        option::Option[ak::Image]::None => { }
    }
    attach_symbol_image(f, img.raw());
    return;
}

// A length the node STATED in points. A percent cannot be resolved without a
// parent, and Auto/Undefined is the ordinary case — both answer 0, which reads
// as "no box" everywhere this is used.
fn stated_points(v: flex::StyleLength) -> f64 {
    return match { v.unit } {
        flex::Unit::Point => { v.value }
        _ => 0.0f64
    };
}

#[link_name = "objc_msgSend"]
extern fn msg_size_of_field(recv: *u8, sel: *u8) -> rt::Size;

fn attach_symbol_image(f: ak::TextField, img: *u8) {
    let att: *u8 = { rt::alloc_init(#str_ptr("NSTextAttachment\0")) };
    if att == (0 as *u8) { return; }
    { rt::msg_void_id(att, rt::sel(#str_ptr("setImage:\0")), img) };
    let s: *u8 = { rt::msg_id_id(rt::get_class(#str_ptr("NSAttributedString\0")),
                                 rt::sel(#str_ptr("attributedStringWithAttachment:\0")), att) };
    { rt::release(att) };
    if s == (0 as *u8) { return; }
    { rt::msg_void_id(f.raw(), rt::sel(#str_ptr("setAttributedStringValue:\0")), s) };
    return;
}

// ---- text_area ---------------------------------------------------------------
// NSTextView inside an NSScrollView: the scroller is not optional on AppKit —
// a bare NSTextView does not scroll, and a multi-line editor that cannot
// scroll is not one. So the VIEW facet holds is the scroll view, and the text
// view is reached through it.

fn create_text_area(n: *core::Node) -> *u8 {
    let s: ak::ScrollView = ak::ScrollView::from_raw(rt::alloc_init(#str_ptr("NSScrollView\0")));
    let tv: ak::TextView = ak::TextView::from_raw(rt::alloc_init(#str_ptr("NSTextView\0")));
    tv.set_rich_text(false);          // facet's text is plain; styling is props
    s.set_document_view(tv.as_view());
    s.set_has_vertical_scroller(true);
    // The notifications come from the TEXT VIEW, but the node is backed by the
    // scroll view — so the delegate is pinned to the one that lives as long as
    // the node and installed on the one that talks.
    text_input::install(s.as_view().raw(), tv.as_view().raw(), n);
    return rt::retain(s.as_view().raw());
}

// The NSTextView inside a text_area's scroll view.
fn text_area_editor(v: *u8) -> option::Option[ak::TextView] {
    match ak::ScrollView::from_raw(v).document_view() {
        option::Option[ak::View]::Some(d) => { return option::some(ak::TextView::from_raw(d.raw())); }
        option::Option[ak::View]::None => { return option::Option[ak::TextView]::None; }
    }
    return option::Option[ak::TextView]::None;
}

fn apply_text_area(v: *u8, n: *core::Node, dirty: u64) {
    let p: *props::TextAreaProps = props_of(n, props::K_TEXT_AREA) as *props::TextAreaProps;
    if p == (0 as *props::TextAreaProps) { return; }
    match text_area_editor(v) {
        option::Option[ak::TextView]::Some(tv) => {
            let iv: *props::InputViewProps = { #addr_of((*p).input_view) };
            text_input::apply_editor_band(tv, n, iv, { (*p).text_align }, dirty,
                                          text_input::bits_of(props::K_TEXT_AREA));
            // NSTextView has no cell, so the vertical answer is one level
            // down: `textContainerOrigin`, which is where the laid-out text is
            // drawn from.
            if (dirty & text_area::P_VERTICAL_ALIGN) != (0 as u64) {
                compose::apply_editor_vertical_align(tv.raw(), { (*p).vertical_align });
            }
            // And no placeholder API either — so a label under the text,
            // hidden as soon as there is any.
            if (dirty & (text_area::P_PLACEHOLDER | text_area::P_PLACEHOLDER_COLOR
                         | text_area::P_FONT_SCALES
                         | text_area::P_FONT_SIZE | text_area::P_FONT_WEIGHT
                         | text_area::P_FONT_FAMILY | text_area::P_IS_ITALIC)) != (0 as u64) {
                compose::apply_editor_placeholder(tv.raw(), { (*iv).placeholder.view() },
                    { (*iv).placeholder_color },
                    paint::ns_font_scaled({ (*iv).font_size }, { (*iv).font_weight },
                                          { (*iv).font_family.view() }, { (*iv).is_italic },
                                          { (*iv).font_scales }));
            }
            if (dirty & text_area::P_TEXT) != (0 as u64) {
                compose::refresh_editor_placeholder(tv.raw());
            }
            // `auto_size` is the editor's own verb: an NSTextView that grows
            // with its text is asked to size to fit whenever the text changes.
            // Disabled is the fixed box its scroll view gives it.
            //
            // "Vertically resizable" is NOT that distinction, and tying it to
            // `auto_size` was what left a Disabled editor unable to hold more
            // text than fits: an NSTextView that may not exceed its frame does
            // not lay text out past it, so there was nothing for the scroll
            // view to scroll to. A scrollable editor is resizable BY
            // DEFINITION — the document view growing past the clip view is what
            // scrolling is — and the box the ledger promises to keep fixed is
            // the SCROLL VIEW's frame, which flex owns and neither of these
            // touch. `geometry::size_text_document` sets the matching floor
            // (`minSize` = the viewport), so the editor can grow and cannot
            // collapse below its box.
            if (dirty & (text_area::P_AUTO_SIZE | text_area::P_TEXT)) != (0 as u64)
                || dirty == paint::all_bits() {
                let grows: bool = match { (*p).auto_size } {
                    vocab::AutoSize::TextChanges => true,
                    vocab::AutoSize::Disabled => false,
                };
                tv.as_text().set_vertically_resizable(true);
                tv.as_text().set_max_size(rt::Size { w: 1000000.0f64, h: 1000000.0f64 });
                if grows { tv.as_text().size_to_fit(); }
            }
        }
        option::Option[ak::TextView]::None => { }
    }
    return;
}

// ---- search_field ------------------------------------------------------------
// NSSearchField is an NSTextField subclass, so the field half is the same
// work; what it adds is the magnifier and the clear button, which AppKit draws
// itself.

fn create_search_field(n: *core::Node) -> *u8 {
    let f: ak::SearchField = ak::SearchField::from_raw(rt::alloc_init(#str_ptr("NSSearchField\0")));
    text_input::install(f.as_view().raw(), f.as_view().raw(), n);
    return rt::retain(f.as_view().raw());
}

fn apply_search_field(v: *u8, n: *core::Node, dirty: u64) {
    let p: *props::SearchFieldProps = props_of(n, props::K_SEARCH_FIELD) as *props::SearchFieldProps;
    if p == (0 as *props::SearchFieldProps) { return; }
    let f: ak::TextField = ak::TextField::from_raw(v);
    let iv: *props::InputViewProps = { #addr_of((*p).input_view) };
    text_input::apply_field_band(f, n, iv, { (*p).text_align }, dirty,
                                 text_input::bits_of(props::K_SEARCH_FIELD));
    if (dirty & search_field::P_RETURN_KEY) != (0 as u64) {
        text_input::install(v, v, n);
    }
    if (dirty & search_field::P_VERTICAL_ALIGN) != (0 as u64) {
        compose::apply_field_vertical_align(v, { (*p).vertical_align });
    }
    // The magnifier and the cancel button are TEMPLATE images on cells of the
    // search field cell's own — which is what makes them tintable.
    if (dirty & (search_field::P_SEARCH_ICON_COLOR
                 | search_field::P_CANCEL_BUTTON_COLOR)) != (0 as u64) {
        compose::tint_search_buttons(v, { (*p).cancel_button_color }, { (*p).search_icon_color });
    }
    if (dirty & props::C_IS_ENABLED) != (0 as u64) || dirty == paint::all_bits() {
        f.as_control().set_enabled(core::is_enabled(n));
    }
    return;
}

// ---- popup -------------------------------------------------------------------
// The ledger's Picker: a closed control that opens a list. NSPopUpButton is exactly
// that, and it owns its own menu — so the items are REBUILT whenever the list
// changes rather than diffed, because a popup's item list is short and a diff
// would be more code than the rebuild it replaces.

fn create_popup(n: *core::Node) -> *u8 {
    let b: ak::PopUpButton = ak::PopUpButton::from_raw(rt::alloc_init(#str_ptr("NSPopUpButton\0")));
    return rt::retain(b.as_view().raw());
}

fn apply_popup(v: *u8, n: *core::Node, dirty: u64) {
    let p: *props::PopupProps = props_of(n, props::K_POPUP) as *props::PopupProps;
    if p == (0 as *props::PopupProps) { return; }
    let b: ak::PopUpButton = ak::PopUpButton::from_raw(v);
    // The menu is rebuilt with the items, so the delegate that carries
    // `on_opened` / `on_closed` is re-installed with it.
    if (dirty & (popup::P_ITEMS | props::C_HANDLERS)) != (0 as u64) || dirty == paint::all_bits() {
        match b.menu() {
            option::Option[ak::Menu]::Some(m) => { text_input::install_popup(v, m.raw(), n); }
            option::Option[ak::Menu]::None => { }
        }
    }
    // The prompt is rebuilt with the items because it IS one — see below.
    if (dirty & (popup::P_ITEMS | popup::P_TITLE | popup::P_TITLE_COLOR)) != (0 as u64) {
        b.remove_all_items();
        let items: *vocab::TextList = { #addr_of((*p).items) };
        var i: usize = 0 as usize;
        let count: usize = { (*items).count() };
        while i < count {
            b.add_item_with_title({ (*items).at(i) });
            i = i +% (1 as usize);
        }
        // `Picker.Title` is what shows when nothing is chosen. NSPopUpButton
        // shows the SELECTED ITEM and has no prompt slot — so the prompt is an
        // item: disabled, at the top, showing exactly while the selection is
        // empty. Which is what a prompt is on every platform that has one.
        compose::install_popup_title(b, { (*p).title.view() }, { (*p).title_color },
                                     paint::ns_font_scaled({ (*p).font_size }, { (*p).font_weight },
                                                           { (*p).font_family.view() },
                                                           { (*p).is_italic },
                                                           { (*p).font_scales }),
                                     { (*p).selected_index });
    }
    // The selection goes on AFTER the items, or it indexes a list that is not
    // there yet and AppKit quietly keeps the old one. The application's index
    // counts ITEMS; a prompt sits before them and shifts every one by a row.
    if (dirty & (popup::P_SELECTED_INDEX | popup::P_ITEMS | popup::P_TITLE)) != (0 as u64) {
        let idx: i64 = { (*p).selected_index };
        if idx >= (0 as i64) {
            b.select_item_at_index(idx + compose::title_offset({ (*p).title.view() }));
        }
    }
    if (dirty & (popup::P_FONT_SCALES | popup::P_FONT_SIZE | popup::P_FONT_WEIGHT | popup::P_FONT_FAMILY
                 | popup::P_IS_ITALIC)) != (0 as u64) {
        match paint::ns_font_scaled({ (*p).font_size }, { (*p).font_weight },
                                    { (*p).font_family.view() }, { (*p).is_italic },
                                    { (*p).font_scales }) {
            option::Option[ak::Font]::Some(font) => { b.as_control().set_font(font); }
            option::Option[ak::Font]::None => { }
        }
    }
    // A popup draws its rows from its MENU, so a colour or a kern is an
    // attributed title per item — there is no `setTextColor:` on the button.
    if (dirty & (popup::P_TEXT_COLOR | popup::P_CHARACTER_SPACING | popup::P_ITEMS
                 | popup::P_IS_ITALIC | popup::P_FONT_SCALES
                 | popup::P_FONT_SIZE | popup::P_FONT_WEIGHT
                 | popup::P_FONT_FAMILY)) != (0 as u64) {
        style_popup_items(b, p);
    }
    if (dirty & popup::P_TEXT_ALIGN) != (0 as u64) {
        b.as_control().set_alignment(paint::ns_text_align({ (*p).text_align }));
    }
    if (dirty & popup::P_VERTICAL_ALIGN) != (0 as u64) {
        compose::apply_field_vertical_align(v, { (*p).vertical_align });
    }
    // `is_open` opens the menu. Closing it is the USER's — AppKit gives no
    // dismiss message for a popup's menu — so a false is not a close, it is
    // "do not open", and MANIFEST records the asymmetry.
    if (dirty & popup::P_IS_OPEN) != (0 as u64) {
        if { (*p).is_open } { b.as_control().perform_click(0 as *u8); }
    }
    if (dirty & props::C_HANDLERS) != (0 as u64) || dirty == paint::all_bits() {
        let f: fn(*u8, *u8) = popup_action;
        akx::set_control_action_ctx(b.as_control(), f, n as *u8);
    }
    if (dirty & props::C_IS_ENABLED) != (0 as u64) || dirty == paint::all_bits() {
        b.as_control().set_enabled(core::is_enabled(n));
    }
    return;
}

// Every item's title, attributed with the popup's own text band. Rebuilt with
// the items rather than diffed, for the same reason the items are: a popup's
// list is short and a diff would be more code than the rebuild it replaces.
fn style_popup_items(b: ak::PopUpButton, p: *props::PopupProps) {
    let c: vocab::Color = { (*p).text_color };
    let kern: f64 = { (*p).character_spacing };
    if c.is_set() == false && kern == 0.0f64 { return; }
    var i: i64 = 0 as i64;
    let count: i64 = b.number_of_items();
    while i < count {
        match b.item_at_index(i) {
            option::Option[ak::MenuItem]::Some(item) => {
                let attrs: *u8 = paint::rich_attributes(
                    paint::ns_font_scaled({ (*p).font_size }, { (*p).font_weight },
                                          { (*p).font_family.view() }, { (*p).is_italic },
                                          { (*p).font_scales }),
                    c, kern, 0.0f64, option::Option[vocab::TextAlign]::None,
                    vocab::TextDecoration::None);
                let a: *u8 = paint::attributed(item.title().view(), attrs);
                if a != (0 as *u8) {
                    { rt::msg_void_id(item.raw(), rt::sel(#str_ptr("setAttributedTitle:\0")), a) };
                    { rt::release(a) };
                }
            }
            option::Option[ak::MenuItem]::None => { }
        }
        i = i + (1 as i64);
    }
    return;
}

// ---- bordered ----------------------------------------------------------------
// The ledger's Border: a stroke around its content. A layer's border is the cheap
// way and it composes with the corner radius the shared band already applies.
// The dash/cap/join/miter family is CAShapeLayer territory and is recorded in
// MANIFEST.md rather than half-done.

fn create_bordered(n: *core::Node) -> *u8 {
    let v: ak::View = akx::new_flipped_view(rt::Rect { x: 0.0f64, y: 0.0f64, w: 0.0f64, h: 0.0f64 });
    v.set_wants_layer(true);
    return rt::retain(v.raw());
}

fn apply_bordered(v: *u8, n: *core::Node, dirty: u64) {
    let p: *props::BorderedProps = props_of(n, props::K_BORDERED) as *props::BorderedProps;
    if p == (0 as *props::BorderedProps) { return; }
    let view: ak::View = ak::View::from_raw(v);
    let stroke: u64 = bordered::P_STROKE | bordered::P_STROKE_WIDTH
        | bordered::P_STROKE_DASH | bordered::P_STROKE_DASH_OFFSET
        | bordered::P_STROKE_CAP | bordered::P_STROKE_JOIN
        | bordered::P_STROKE_MITER_LIMIT | bordered::P_STROKE_SHAPE;
    if (dirty & stroke) != (0 as u64) || dirty == paint::all_bits() {
        view.set_wants_layer(true);
        // A LAYER BORDER is one solid rectangle of one width — it has no dash,
        // no cap, no join and no shape. Everything past `stroke_width` needs a
        // PATH, so a node that asks for any of them gets a CAShapeLayer and one
        // that does not keeps the cheap border.
        if wants_shape(p) {
            observe_stroke_frame(view, n);
            apply_stroke_shape(view, p);
        } else { apply_plain_border(view, p); }
    }
    return;
}

fn wants_shape(p: *props::BorderedProps) -> bool {
    if { (*p).stroke_dash.count } > (0 as usize) { return true; }
    if { (*p).stroke_shape.kind } != (0 as i64) { return true; }
    return is_shaped_cap({ (*p).stroke_cap }) || is_shaped_join({ (*p).stroke_join });
}

// `Flat` and `Miter` are Core Animation's own defaults, so asking for either is
// not asking for a path — it is what a plain border already draws.
fn is_shaped_cap(c: vocab::LineCap) -> bool {
    return match c {
        vocab::LineCap::Flat => false,
        vocab::LineCap::Round => true,
        vocab::LineCap::Square => true,
    };
}

fn is_shaped_join(j: vocab::LineJoin) -> bool {
    return match j {
        vocab::LineJoin::Miter => false,
        vocab::LineJoin::Bevel => true,
        vocab::LineJoin::Round => true,
    };
}

fn apply_plain_border(view: ak::View, p: *props::BorderedProps) {
    remove_stroke_layer(view);
    let l: quartz::Layer = view.layer();
    l.set_border_width({ (*p).stroke_width });
    // A Brush is a gradient pair; a border takes one colour, so the start is
    // the stroke. A gradient border needs a CAGradientLayer mask — MANIFEST.
    let brush: vocab::Brush = { (*p).stroke };
    l.set_border_color(paint::ns_color(brush.start).c_g_color());
    return;
}

// ---- the stroke layer --------------------------------------------------------
// One CAShapeLayer per bordered node that needs one, kept as a SUBLAYER and
// sized with the view. Created on demand and torn down when the node stops
// asking, so a plain border still costs one layer rather than two.

fn stroke_layer_key() -> *u8 { return { 29070 as *u8 }; }

fn remove_stroke_layer(view: ak::View) {
    let l: *u8 = { synth::get_associated(view.raw(), stroke_layer_key()) };
    if l == (0 as *u8) { return; }
    { rt::msg_void(l, rt::sel(#str_ptr("removeFromSuperlayer\0"))) };
    synth::set_associated(view.raw(), stroke_layer_key(), 0 as *u8);
    return;
}

// Readers the suite asks with, so a test asserts the LAYER rather than the
// props that asked for it.
fn has_stroke_layer(view: ak::View) -> bool {
    return { synth::get_associated(view.raw(), stroke_layer_key()) } != (0 as *u8);
}

fn stroke_layer_of(view: ak::View) -> *u8 {
    return { synth::get_associated(view.raw(), stroke_layer_key()) };
}

fn stroke_layer(view: ak::View) -> quartz::ShapeLayer {
    let existing: *u8 = { synth::get_associated(view.raw(), stroke_layer_key()) };
    if existing != (0 as *u8) { return quartz::ShapeLayer::from_raw(existing); }
    let l: *u8 = { rt::alloc_init(#str_ptr("CAShapeLayer\0")) };
    if l == (0 as *u8) { return quartz::ShapeLayer::from_raw(0 as *u8); }
    { rt::msg_void_id(view.layer().raw(), rt::sel(#str_ptr("addSublayer:\0")), l) };
    synth::retain_associated(view.raw(), stroke_layer_key(), l);
    rt::release(l);
    return quartz::ShapeLayer::from_raw(l);
}

// A stroked path is geometry, and geometry is not known at create: the frame
// walk sizes the view AFTER the body runs, so a path built at create would be
// empty and a path built once would be wrong at the next size. The view is
// observed and re-pathed, once per resize.
fn observed_key() -> *u8 { return { 29071 as *u8 }; }

fn stroke_resized(ctx: *u8) {
    let n: *core::Node = ctx as *core::Node;
    if n == (0 as *core::Node) { return; }
    let v: *u8 = core::view_of(n);
    if v == (0 as *u8) { return; }
    let p: *props::BorderedProps = props_of(n, props::K_BORDERED) as *props::BorderedProps;
    if p == (0 as *props::BorderedProps) { return; }
    if wants_shape(p) == false { return; }
    apply_stroke_shape(ak::View::from_raw(v), p);
    return;
}

fn observe_stroke_frame(view: ak::View, n: *core::Node) {
    if { synth::get_associated(view.raw(), observed_key()) } != (0 as *u8) { return; }
    let f: fn(*u8) = stroke_resized;
    akx::observe_frame_change(view, f, n as *u8);
    synth::set_associated(view.raw(), observed_key(), 1 as *u8);
    return;
}

fn apply_stroke_shape(view: ak::View, p: *props::BorderedProps) {
    // The plain border must go, or the node draws two.
    view.layer().set_border_width(0.0f64);
    let sl: quartz::ShapeLayer = stroke_layer(view);
    if sl.raw() == (0 as *u8) { return; }
    let b: rt::Rect = view.bounds();
    { msg_void_rect(sl.raw(), rt::sel(#str_ptr("setFrame:\0")), b) };
    let path: *u8 = stroke_path(b, { (*p).stroke_shape }, { (*p).stroke_width });
    if path != (0 as *u8) {
        sl.set_path(path);
        { CGPathRelease(path) };
    }
    sl.set_fill_color(0 as *u8);
    let brush: vocab::Brush = { (*p).stroke };
    sl.set_stroke_color(paint::ns_color(brush.start).c_g_color());
    sl.set_line_width({ (*p).stroke_width });
    sl.set_line_cap(ca_line_cap({ (*p).stroke_cap }));
    sl.set_line_join(ca_line_join({ (*p).stroke_join }));
    sl.set_miter_limit({ (*p).stroke_miter_limit });
    sl.set_line_dash_phase({ (*p).stroke_dash_offset });
    let dashes: vocab::Dashes = { (*p).stroke_dash };
    var runs: vec::Vec[f64] = vec::new::[f64]();
    var i: usize = 0 as usize;
    while i < { dashes.count } {
        let _a: status::Status = runs.append({ dashes.runs[i] });
        i = i +% (1 as usize);
    }
    sl.set_line_dash_pattern(runs);
    return;
}

// The outline a `Shape` describes, INSET by half the stroke width — a stroked
// path is centred on the line, so a path on the bounds paints half of itself
// outside the view and is clipped to a half-width border.
fn stroke_path(b: rt::Rect, shape: vocab::Shape, width: f64) -> *u8 {
    let half: f64 = width / 2.0f64;
    let r: rt::Rect = rt::Rect { x: { b.x } + half, y: { b.y } + half,
                                 w: { b.w } - width, h: { b.h } - width };
    if { r.w } <= 0.0f64 || { r.h } <= 0.0f64 { return 0 as *u8; }
    let kind: i64 = { shape.kind };
    if kind == (3 as i64) { return { CGPathCreateWithEllipseInRect(r, 0 as *u8) }; }
    if kind == (2 as i64) {
        // Core Graphics has ONE corner radius per rounded rect; facet carries
        // four, so the largest wins — the same deviation `corner_radius` makes,
        // recorded in the same place.
        let rad: f64 = largest_corner({ shape.corners });
        return { CGPathCreateWithRoundedRect(r, rad, rad, 0 as *u8) };
    }
    return { CGPathCreateWithRect(r, 0 as *u8) };
}

// kCALineCap* / kCALineJoin* are string constants and the VALUES are the words.
fn ca_line_cap(c: vocab::LineCap) -> str {
    return match c {
        vocab::LineCap::Flat => "butt",
        vocab::LineCap::Round => "round",
        vocab::LineCap::Square => "square",
    };
}

fn ca_line_join(j: vocab::LineJoin) -> str {
    return match j {
        vocab::LineJoin::Miter => "miter",
        vocab::LineJoin::Bevel => "bevel",
        vocab::LineJoin::Round => "round",
    };
}

extern fn CGPathCreateWithRect(r: rt::Rect, transform: *u8) -> *u8;
extern fn CGPathCreateWithEllipseInRect(r: rt::Rect, transform: *u8) -> *u8;
extern fn CGPathCreateWithRoundedRect(r: rt::Rect, rx: f64, ry: f64, transform: *u8) -> *u8;
extern fn CGPathRelease(p: *u8);

#[link_name = "objc_msgSend"]
extern fn msg_void_rect(recv: *u8, sel: *u8, r: rt::Rect);

// ---- split -------------------------------------------------------------------
// Two panes and a draggable divider. NSSplitView arranges its own subviews, so
// facet's children go in through `add_arranged_subview` — which is why the
// split's host is itself but its insert order matters more than elsewhere.

// The divider a user has to FIND before they can drag it.
//
// AppKit draws a hairline in the platform's separator colour, which vanishes
// between two panes that share a background — and both panes usually do, since
// facet paints them from the same theme. `dividerColor` and `dividerThickness`
// are declared read-only precisely so a subclass can answer them, which is why
// this is a synthesized class rather than a property write.
//
// Both are read from the props at DRAW time rather than captured, so a
// restyle is a repaint and needs no new view — the same rule the rest of this
// file follows for handlers.
fn split_view_node_key() -> *u8 { return { 29065 as *u8 }; }

fn split_view_props(self_obj: *u8) -> *split::SplitProps {
    if self_obj == (0 as *u8) { return 0 as *split::SplitProps; }
    let n: *core::Node = { synth::get_associated(self_obj, split_view_node_key()) as *core::Node };
    if n == (0 as *core::Node) { return 0 as *split::SplitProps; }
    return props_of(n, split::K_SPLIT) as *split::SplitProps;
}

fn divider_color_imp(self_obj: *u8, cmd: *u8) -> *u8 {
    let p: *split::SplitProps = split_view_props(self_obj);
    if p == (0 as *split::SplitProps) {
        return { rt::msg_id(rt::get_class(#str_ptr("NSColor\0")),
                            rt::sel(#str_ptr("separatorColor\0"))) };
    }
    return paint::ns_color({ (*p).divider_color }).raw();
}

fn divider_thickness_imp(self_obj: *u8, cmd: *u8) -> f64 {
    let p: *split::SplitProps = split_view_props(self_obj);
    if p == (0 as *split::SplitProps) { return 1.0f64; }
    return { (*p).divider_thickness };
}

fn split_view_class() -> *u8 {
    let existing: *u8 = rt::get_class(#str_ptr("FacetSplitView\0"));
    if existing != (0 as *u8) { return existing; }
    let cls: *u8 = synth::allocate_class_pair(rt::get_class(#str_ptr("NSSplitView\0")),
                                              #str_ptr("FacetSplitView\0"), 0 as usize);
    synth::add_method_id_0id(cls, rt::sel(#str_ptr("dividerColor\0")),
                             divider_color_imp, #str_ptr("@@:\0"));
    add_method_f64_0id(cls, rt::sel(#str_ptr("dividerThickness\0")),
                       divider_thickness_imp, #str_ptr("d@:\0"));
    synth::register_class_pair(cls);
    return cls;
}

#[link_name = "class_addMethod"]
extern fn add_method_f64_0id(cls: *u8, sel: *u8, imp: fn(*u8, *u8) -> f64, types: *u8) -> i8;

fn create_split(n: *core::Node) -> *u8 {
    let s: ak::SplitView = ak::SplitView::from_raw(synth::alloc_init_class(split_view_class()));
    s.set_divider_style(ak::SplitViewDividerStyle::Thin);
    synth::set_associated(s.as_view().raw(), split_view_node_key(), n as *u8);
    return rt::retain(s.as_view().raw());
}

fn apply_split(v: *u8, n: *core::Node, dirty: u64) {
    let p: *split::SplitProps = props_of(n, split::K_SPLIT) as *split::SplitProps;
    if p == (0 as *split::SplitProps) { return; }
    let s: ak::SplitView = ak::SplitView::from_raw(v);
    if (dirty & split::P_AXIS) != (0 as u64) {
        s.set_vertical(is_vertical_divider({ (*p).axis }));
    }
    // The delegate carries the minimums AND `on_move`: NSSplitView asks its
    // delegate where a divider may go, and tells it after one moved. Installed
    // on the first apply rather than at create, because a split with neither a
    // minimum nor a handler should not pay for a delegate at all.
    if (dirty & (split::P_MIN_LEADING | split::P_MIN_TRAILING | props::C_HANDLERS)) != (0 as u64)
        || dirty == paint::all_bits() {
        text_input::install_split(v, n);
    }
    // The divider is REGISTERED, and settled after every layout walk against
    // the props' current position — not queued once with a captured value.
    // Both halves matter, and both were measured:
    //
    //   a captured position goes stale. A user drag updates the props; a job
    //     queued at mount still holds the constructor's number and re-asserts
    //     it over the drag on the next walk.
    //   a one-shot queue misses walks it was not queued for. A window resize
    //     runs the walk with no apply before it, so nothing re-asserts.
    //
    // `settle_split` is where the number actually lands, and it writes flex
    // FIRST — the panes are ordinary facet children, so the frame walk sizes
    // them from flex, and a divider flex knew nothing about was erased on
    // every pass.
    if (dirty & (split::P_POSITION | split::P_COLLAPSED)) != (0 as u64)
       || dirty == paint::all_bits() {
        scheduler::register_split(n);
        settle_split(n);
    }
    // The divider draws itself from the props, so a restyle is a repaint. The
    // node is re-associated because a re-attached node has a new address, and
    // the drawing reads it live — the same reason `install_split` does it.
    if (dirty & split::P_DIVIDER) != (0 as u64) || dirty == paint::all_bits() {
        synth::set_associated(v, split_view_node_key(), n as *u8);
        // Thickness is geometry, not just colour: the panes have to be laid out
        // again around a divider that changed width, and AppKit only re-asks
        // for it when it arranges.
        { rt::msg_void(v, rt::sel(#str_ptr("adjustSubviews\0"))) };
        { rt::msg_void_i8(v, rt::sel(#str_ptr("setNeedsDisplay:\0")), true as i8) };
    }
    return;
}

// Settle one split against its CURRENT props position.
//
// Flex FIRST, then AppKit. The panes are ordinary facet children, so the frame
// walk sizes them from flex — which knew nothing about a divider, so the walk
// and the split view were two authorities over one number and the walk always
// spoke last. Writing the position in as the leading pane's flex size makes the
// walk REPRODUCE the divider instead of erasing it, which is what makes a user
// drag survive the next layout.
// Is this length already exactly these points?
//
// Every write below goes through `touch`, which asks for another sync, which
// runs another layout, which settles again — so a settle that writes
// unconditionally keeps the application awake forever. It measured 68,954
// settles in four idle seconds. Writing only on a real change is what lets the
// tree go quiet.
fn is_points(l: flex::StyleLength, v: f64) -> bool {
    let val: f64 = { l.value };
    return match { l.unit } {
        flex::Unit::Point => val == v,
        _ => false,
    };
}

fn settle_split(n: *core::Node) {
    if n == (0 as *core::Node) { return; }
    paint::begin_assert();
    settle_split_inner(n);
    paint::end_assert();
    return;
}

fn settle_split_inner(n: *core::Node) {
    let v: *u8 = core::view_of(n);
    if v == (0 as *u8) { return; }
    let p: *split::SplitProps = props_of(n, split::K_SPLIT) as *split::SplitProps;
    if p == (0 as *split::SplitProps) { return; }
    let s: ak::SplitView = ak::SplitView::from_raw(v);
    let f: rt::Rect = s.as_view().frame();
    let extent: f64 = if s.is_vertical() { { f.w } } else { { f.h } };
    if extent <= 0.0f64 { return; }

    // THE SPLIT'S SIZE IS ITS PARENT'S BUSINESS, NEVER ITS PANES'.
    //
    // The leading pane is given a fixed main-axis size below, and a fixed size
    // is content the container has to fit — so the split's own base size grew
    // with the position, the bigger split reported a bigger extent, the extent
    // moved the clamp, and the clamp moved the pane. A split asked to move its
    // divider RESIZED ITSELF, measured on a probe at 456 -> 547 -> 580 and into
    // six figures in an application.
    //
    // A zero basis takes the panes out of the split's own measurement, so its
    // size is purely the share its parent hands it. Only when the split is
    // space-distributed: one sized by an explicit width or height is already
    // definite, and zeroing the basis there would collapse it to nothing.
    //
    // This is also the whole reason the bug looked like it belonged to the ROWS
    // axis. In a column parent a Rows split divides along the parent's main
    // axis, so the feedback closes; a Columns split divides across it, so it
    // never did. Same defect, one geometry away from being invisible.
    if { (*n).style.flex_grow } > 0.0f64 && !is_points({ (*n).style.flex_basis }, 0.0f64) {
        core::set_basis(n, 0.0f64);
    }

    var want: f64 = { (*p).position };
    if { (*p).collapsed_leading } { want = 0.0f64; }
    else if { (*p).collapsed_trailing } { want = extent; }
    // A position past the end IS a collapse — `1e6` is how an application asks
    // for one — so clamp before it becomes a pane size.
    if want > extent { want = extent; }
    if want < 0.0f64 { want = 0.0f64; }
    // The pane minimums, applied HERE rather than left to AppKit. The delegate
    // enforces them on a drag, and it would clamp this write too — but then the
    // landed value differs from the asked one for two different reasons, and
    // the check below could not tell "the minimums bound it" from "the extent
    // was not final yet". Clamping first makes any remaining disagreement mean
    // exactly one thing.
    if !{ (*p).collapsed_leading } && !{ (*p).collapsed_trailing } {
        let ceiling: f64 = extent - { (*p).min_trailing };
        if ceiling > 0.0f64 && want > ceiling { want = ceiling; }
        let floor: f64 = { (*p).min_leading };
        if floor < extent && want < floor { want = floor; }
    }

    match core::child_of(n, 0 as usize) {
        option::Option[*core::Node]::Some(lead) => {
            if s.is_vertical() {
                if !is_points({ (*lead).style.width }, want) { core::set_width(lead, want); }
            } else {
                if !is_points({ (*lead).style.height }, want) { core::set_height(lead, want); }
            }
            if { (*lead).style.flex_grow } != 0.0f64 { core::set_grow(lead, 0.0f64); }
            // SHRINKABLE, and this is load-bearing. A fixed main-axis size the
            // pane cannot give back becomes the split's min-content, and flex
            // shrink defaults to 0, so a split asked for more than its parent
            // offers grows PAST the parent instead of being squeezed back. The
            // inflated frame is then what the next settle reads as `extent`, so
            // the error compounds every pass — measured at 456 -> 547 -> 580 on
            // a probe, and into six figures in an application.
            //
            // Nothing shrinks while the split has room, so the position still
            // lands on the number; the pane only gives way when the alternative
            // is overflowing. The reason this looked like an AXIS bug is that a
            // wide window swallows every horizontal ask and a short one cannot.
            if { (*lead).style.flex_shrink } != 1.0f64 { core::set_shrink(lead, 1.0f64); }
        }
        option::Option[*core::Node]::None => { return; }
    }
    // The trailing pane takes the rest, which is what a split means — and
    // takes it from a base of ZERO, which is what makes that true.
    //
    // Grow alone was not enough. A flex item's base size is its CONTENT, and a
    // pane that cannot shrink (flex shrink defaults to 0) makes that content a
    // floor. So a trailing pane holding 115pt of content forced the leading
    // pane to give up 85 of the points the divider had just been put at: the
    // screen showed 206/26 and the NODES said 121/115. Both are complete
    // divisions of the same space, and the application reads the second one —
    // `height_of` answered a pane height no divider was ever at, and anything
    // deciding from a measured pane decided from it.
    //
    // With a zero basis the trailing pane asks for nothing and receives the
    // remainder, so flex reproduces the division AppKit applied instead of
    // negotiating its own.
    match core::child_of(n, 1 as usize) {
        option::Option[*core::Node]::Some(trail) => {
            if { (*trail).style.flex_grow } != 1.0f64 { core::set_grow(trail, 1.0f64); }
            if !is_points({ (*trail).style.flex_basis }, 0.0f64) { core::set_basis(trail, 0.0f64); }
        }
        option::Option[*core::Node]::None => { }
    }
    // The divider occupies real points between the panes, and flex knows
    // nothing about it — so it is a GAP. Without this the two panes divide the
    // whole extent between them and every node frame is the divider's width
    // out, which is small enough to look like rounding and is not.
    let gap: f64 = { (*p).divider_thickness };
    if !is_points({ (*n).style.gap_row }, gap) || !is_points({ (*n).style.gap_column }, gap) {
        core::set_gap(n, gap);
    }

    let panes: u64 = { rt::msg_u64({ rt::msg_id(v, rt::sel(#str_ptr("subviews\0"))) },
                                   rt::sel(#str_ptr("count\0"))) };
    if panes >= (2 as u64) {
        s.set_position(want, 0 as i64);
        // The application's position has REACHED the split — but only if it
        // LANDED. Settling is what allows the resize notification to write
        // geometry back over the request, so declaring it on a pass where the
        // split had not reached its final size recorded an early clamped value
        // as though a user had chosen it: a probe asked 200 at attach and kept
        // 195.5 forever. Ask the geometry instead of assuming.
        let first: *u8 = { rt::msg_id_u64({ rt::msg_id(v, rt::sel(#str_ptr("subviews\0"))) },
                                          rt::sel(#str_ptr("objectAtIndex:\0")), 0 as u64) };
        if first != (0 as *u8) {
            let lf: rt::Rect = ak::View::from_raw(first).frame();
            let landed: f64 = if s.is_vertical() { { lf.w } } else { { lf.h } };
            var off: f64 = landed - want;
            if off < 0.0f64 { off = 0.0f64 - off; }
            if off <= 0.5f64 {
                synth::set_associated(v, text_input::split_settled_key(), 1 as *u8);
            }
        }
    }
    return;
}

fn split_extent(s: ak::SplitView) -> f64 {
    let f: rt::Rect = s.as_view().frame();
    if s.is_vertical() { return { f.w }; }
    return { f.h };
}

// facet names the ARRANGEMENT (Columns = side by side); AppKit names the
// DIVIDER (`vertical` = a vertical divider, i.e. panes side by side). They
// agree here, but the two readings are one negation apart, and getting it
// backwards silently transposes every split in an app.
fn is_vertical_divider(a: split::SplitAxis) -> bool {
    return match a {
        split::SplitAxis::Columns => true,
        split::SplitAxis::Rows => false,
    };
}

// ---- page_dots ---------------------------------------------------------------
// The ledger's IndicatorView: the row of dots under a pager. AppKit ships nothing of
// the kind — NSPageController has no indicator — so this is drawn, and it is
// drawn as SUBLAYERS rather than by overriding drawRect:.
//
// Sublayers, because a dot is a rounded rectangle and Core Animation already
// draws those: no synthesized NSView subclass, no drawRect: bridge, and the
// dots re-tint on a theme change through the same apply the rest of the band
// uses. The layer row is rebuilt when the COUNT changes and re-tinted when the
// position does — a count change is rare and a position change is every page
// turn, so the two are deliberately not the same work.

fn create_page_dots(n: *core::Node) -> *u8 {
    let v: ak::View = akx::new_flipped_view(rt::Rect { x: 0.0f64, y: 0.0f64, w: 0.0f64, h: 0.0f64 });
    v.set_wants_layer(true);
    return rt::retain(v.raw());
}

// How many dots are actually drawn: the count, clamped by `max_dots`, and
// nothing at all when a single dot is hidden by `hides_single`.
fn visible_dot_count(p: *props::PageDotsProps) -> i64 {
    var count: i64 = { (*p).count };
    if count < (0 as i64) { count = 0 as i64; }
    let cap: i64 = { (*p).max_dots };
    if cap > (0 as i64) && count > cap { count = cap; }
    if count == (1 as i64) && { (*p).hides_single } { return 0 as i64; }
    return count;
}

fn apply_page_dots(v: *u8, n: *core::Node, dirty: u64) {
    let p: *props::PageDotsProps = props_of(n, props::K_PAGE_DOTS) as *props::PageDotsProps;
    if p == (0 as *props::PageDotsProps) { return; }
    let view: ak::View = ak::View::from_raw(v);
    view.set_wants_layer(true);
    let host: quartz::Layer = view.layer();
    let want: i64 = visible_dot_count(p);
    let size: f64 = dot_size_of(p);
    let gap: f64 = size * 0.8f64;

    if (dirty & (page_dots::P_COUNT | page_dots::P_MAX_DOTS | page_dots::P_HIDES_SINGLE
                 | page_dots::P_DOT_SIZE | page_dots::P_DOT_SHAPE)) != (0 as u64) {
        rebuild_dots(host, want, size, { (*p).dot_shape }, gap);
    }
    // Re-tinting is every page turn; rebuilding is not. Kept apart on purpose.
    if (dirty & (page_dots::P_POSITION | page_dots::P_DOT_COLOR
                 | page_dots::P_SELECTED_DOT_COLOR | page_dots::P_COUNT)) != (0 as u64) {
        tint_dots(host, want, { (*p).position }, { (*p).dot_color }, { (*p).selected_dot_color });
    }
    return;
}

fn dot_size_of(p: *props::PageDotsProps) -> f64 {
    let s: f64 = { (*p).dot_size };
    if s > 0.0f64 { return s; }
    return 7.0f64;                  // the platform's own indicator metric
}

fn rebuild_dots(host: quartz::Layer, count: i64, size: f64, shape: vocab::DotShape, gap: f64) {
    // Drop what is there. A row of dots is single digits long, so a rebuild is
    // cheaper than reconciling it.
    host.set_sublayers(vec::new::[quartz::Layer]());
    let radius: f64 = match shape {
        vocab::DotShape::Circle => size / 2.0f64,
        vocab::DotShape::Square => 0.0f64,
    };
    var i: i64 = 0 as i64;
    while i < count {
        let dot: quartz::Layer = quartz::Layer::new();
        dot.set_frame(rt::Rect {
            x: (i as f64) * (size + gap),
            y: 0.0f64,
            w: size,
            h: size,
        });
        dot.set_corner_radius(radius);
        host.add_sublayer(dot);
        i = i +% (1 as i64);
    }
    return;
}

fn tint_dots(host: quartz::Layer, count: i64, position: i64,
             dot: vocab::Color, selected: vocab::Color) {
    let subs: vec::Vec[quartz::Layer] = host.sublayers();
    var i: usize = 0 as usize;
    let n: usize = subs.count();
    while i < n {
        match subs.at_ptr(i) {
            option::Option[*quartz::Layer]::Some(l) => {
                let is_current: bool = (i as i64) == position;
                var c: vocab::Color = dot;
                if is_current { c = selected; }
                // An unset colour falls to the platform's own tiers rather
                // than to black: a page indicator nobody themed should still
                // read as one.
                if c.is_set() == false {
                    if is_current { c = vocab::Color::text(); } else { c = vocab::Color::text_tertiary(); }
                }
                { (*l).set_background_color(paint::ns_color(c).c_g_color()) };
            }
            option::Option[*quartz::Layer]::None => { }
        }
        i = i +% (1 as usize);
    }
    return;
}

// ---- dates -------------------------------------------------------------------
// facet's `Date` is {year, month, day} — a CIVIL date, not an instant.
// NSDatePicker wants an NSDate, which is an instant. Bridging the two is a
// question of which calendar and whose time zone, and the answer follows from
// what facet's type actually means:
//
//   the proleptic Gregorian calendar, and the picker pinned to UTC.
//
// Pinning is the load-bearing half. A civil date has no time zone, so if the
// picker rendered it in the machine's local zone, 2026-01-01 fed in west of
// Greenwich would come back reading 2025-12-31 — the value would not survive
// its own round trip. Pinned to UTC, what goes in is what is shown and what
// comes back.
//
// The conversion is arithmetic rather than NSCalendar: days-from-civil is
// exact, total, and has no notion of a locale to disagree with.

fn seconds_per_day() -> f64 { return 86400.0f64; }

// Days from 1970-01-01 to y-m-d in the proleptic Gregorian calendar. Exact for
// every year the type can hold; the shift-the-year-to-March trick is what
// makes the leap-day case fall out instead of being special-cased.
fn days_from_civil(y_in: i64, m: i64, d: i64) -> i64 {
    var y: i64 = y_in;
    if m <= (2 as i64) { y = y -% (1 as i64); }
    var era: i64 = y / (400 as i64);
    if y < (0 as i64) { era = (y -% (399 as i64)) / (400 as i64); }
    let yoe: i64 = y -% era * (400 as i64);                       // [0, 399]
    var mp: i64 = m +% (9 as i64);
    if m > (2 as i64) { mp = m -% (3 as i64); }
    let doy: i64 = ((153 as i64) * mp +% (2 as i64)) / (5 as i64) +% d -% (1 as i64);
    let doe: i64 = yoe * (365 as i64) +% yoe / (4 as i64) -% yoe / (100 as i64) +% doy;
    return era * (146097 as i64) +% doe -% (719468 as i64);
}

// The inverse, for the write-back: a picker's own date, back into facet's.
// Howard Hinnant's civil_from_days, the pair of the one above — and the pair
// matters, because a date read back through a different calendar than it was
// written with drifts by a day at the year boundary.
fn civil_from_days(z_in: i64) -> vocab::Date {
    let z: i64 = z_in +% (719468 as i64);
    var era: i64 = z / (146097 as i64);
    if z < (0 as i64) { era = (z -% (146096 as i64)) / (146097 as i64); }
    let doe: i64 = z -% era * (146097 as i64);
    let yoe: i64 = (doe -% doe / (1460 as i64) +% doe / (36524 as i64)
                    -% doe / (146096 as i64)) / (365 as i64);
    let y: i64 = yoe +% era * (400 as i64);
    let doy: i64 = doe -% ((365 as i64) * yoe +% yoe / (4 as i64) -% yoe / (100 as i64));
    let mp: i64 = ((5 as i64) * doy +% (2 as i64)) / (153 as i64);
    let d: i64 = doy -% ((153 as i64) * mp +% (2 as i64)) / (5 as i64) +% (1 as i64);
    var m: i64 = mp -% (9 as i64);
    if mp < (10 as i64) { m = mp +% (3 as i64); }
    var year: i64 = y;
    if m <= (2 as i64) { year = y +% (1 as i64); }
    return vocab::Date { year: year, month: m, day: d };
}

fn floor_div_day(secs: f64) -> f64 {
    var days: f64 = secs / seconds_per_day();
    let t: f64 = days as i64 as f64;
    if days < t { days = t - 1.0f64; } else { days = t; }
    return days;
}

fn picker_seconds(sender: *u8) -> f64 {
    let d: *u8 = { rt::msg_id(sender, rt::sel(#str_ptr("dateValue\0"))) };
    if d == (0 as *u8) { return 0.0f64; }
    return { rt::msg_f64(d, rt::sel(#str_ptr("timeIntervalSince1970\0"))) };
}

fn date_picker_action(sender: *u8, ctx: *u8) {
    let n: *core::Node = ctx as *core::Node;
    let p: *props::DatePickerProps = props_of(n, props::K_DATE_PICKER) as *props::DatePickerProps;
    if p == (0 as *props::DatePickerProps) { return; }
    { (*p).date = civil_from_days(floor_div_day(picker_seconds(sender)) as i64) };
    let h: fn(*u8, *u8) = { (*p).on_date_selected };
    if h != props::no_handler { h(sender, { (*p).on_date_selected_ctx }); }
    return;
}

// A time of day is an OFFSET into a day, which is the reading that needs no
// calendar — so the whole days come off and what is left is the time.
fn time_picker_action(sender: *u8, ctx: *u8) {
    let n: *core::Node = ctx as *core::Node;
    let p: *props::TimePickerProps = props_of(n, props::K_TIME_PICKER) as *props::TimePickerProps;
    if p == (0 as *props::TimePickerProps) { return; }
    let secs: f64 = picker_seconds(sender);
    { (*p).time = vocab::Duration { seconds: secs - floor_div_day(secs) * seconds_per_day() } };
    let h: fn(*u8, *u8) = { (*p).on_time_selected };
    if h != props::no_handler { h(sender, { (*p).on_time_selected_ctx }); }
    return;
}

// An NSDate at UTC midnight on that civil date. A zeroed Date (year 0) means
// "unset", and answers a null NSDate so a caller can leave the picker alone.
fn ns_date(d: vocab::Date) -> *u8 {
    if d.year == (0 as i64) { return 0 as *u8; }
    let secs: f64 = (days_from_civil(d.year, d.month, d.day) as f64) * seconds_per_day();
    return { rt::msg_id_f64(rt::get_class(#str_ptr("NSDate\0")),
                            rt::sel(#str_ptr("dateWithTimeIntervalSince1970:\0")), secs) };
}

// A duration into the same space: the epoch day, offset by the time of day.
// facet's TimePicker carries a Duration because a time of day IS an offset
// into a day, which is the one reading that does not need a calendar.
fn ns_time(t: vocab::Duration) -> *u8 {
    return { rt::msg_id_f64(rt::get_class(#str_ptr("NSDate\0")),
                            rt::sel(#str_ptr("dateWithTimeIntervalSince1970:\0")), t.seconds) };
}

fn utc_time_zone() -> option::Option[ak::TimeZone] {
    let tz: *u8 = { rt::msg_id_id(rt::get_class(#str_ptr("NSTimeZone\0")),
                                  rt::sel(#str_ptr("timeZoneWithAbbreviation:\0")),
                                  bridge::nsstring("UTC")) };
    if tz == (0 as *u8) { return option::Option[ak::TimeZone]::None; }
    return option::some(ak::TimeZone::from_raw(tz));
}

fn pin_picker_to_utc(dp: ak::DatePicker) {
    match utc_time_zone() {
        option::Option[ak::TimeZone]::Some(tz) => { dp.set_time_zone(tz); }
        option::Option[ak::TimeZone]::None => { }
    }
    return;
}

// ---- date_picker -------------------------------------------------------------

// The popover's two edges. They reach the node through the picker's own view,
// which the delegate has because the popover is anchored to it — no second
// association, and nothing to keep in step with the node's lifetime.
// `sender` is the popover's DELEGATE, which is the one object both sides
// already have — so the node rides it rather than a static, and two pickers
// open at once stay told apart.
fn picker_owner(sender: *u8) -> *core::Node {
    return { compose::popover_owner_of(sender) as *core::Node };
}

fn date_opened(sender: *u8, ctx: *u8) { fire_picker(picker_owner(sender), props::K_DATE_PICKER, true); return; }
fn date_closed(sender: *u8, ctx: *u8) { fire_picker(picker_owner(sender), props::K_DATE_PICKER, false); return; }
fn time_opened(sender: *u8, ctx: *u8) { fire_picker(picker_owner(sender), props::K_TIME_PICKER, true); return; }
fn time_closed(sender: *u8, ctx: *u8) { fire_picker(picker_owner(sender), props::K_TIME_PICKER, false); return; }

fn fire_picker(n: *core::Node, kind: u32, opened: bool) {
    if n == (0 as *core::Node) { return; }
    if kind == props::K_DATE_PICKER {
        let p: *props::DatePickerProps = props_of(n, kind) as *props::DatePickerProps;
        if p == (0 as *props::DatePickerProps) { return; }
        if opened {
            let h: fn(*u8, *u8) = { (*p).on_opened };
            if h != props::no_handler { h(core::view_of(n), { (*p).on_opened_ctx }); }
        } else {
            let h: fn(*u8, *u8) = { (*p).on_closed };
            if h != props::no_handler { h(core::view_of(n), { (*p).on_closed_ctx }); }
        }
        return;
    }
    let p: *props::TimePickerProps = props_of(n, kind) as *props::TimePickerProps;
    if p == (0 as *props::TimePickerProps) { return; }
    if opened {
        let h: fn(*u8, *u8) = { (*p).on_opened };
        if h != props::no_handler { h(core::view_of(n), { (*p).on_opened_ctx }); }
    } else {
        let h: fn(*u8, *u8) = { (*p).on_closed };
        if h != props::no_handler { h(core::view_of(n), { (*p).on_closed_ctx }); }
    }
    return;
}

fn create_date_picker(n: *core::Node) -> *u8 {
    let dp: ak::DatePicker = ak::DatePicker::from_raw(rt::alloc_init(#str_ptr("NSDatePicker\0")));
    dp.set_date_picker_style(ak::DatePickerStyle::TextFieldAndStepper);
    dp.set_date_picker_elements(ak::date_picker_element_flags_n_s_date_picker_element_flag_year_month_day);
    pin_picker_to_utc(dp);
    return rt::retain(dp.as_view().raw());
}

fn apply_date_picker(v: *u8, n: *core::Node, dirty: u64) {
    let p: *props::DatePickerProps = props_of(n, props::K_DATE_PICKER) as *props::DatePickerProps;
    if p == (0 as *props::DatePickerProps) { return; }
    let dp: ak::DatePicker = ak::DatePicker::from_raw(v);
    // The bounds go on before the value, the same trap the slider has: a date
    // outside the OLD range is clamped away and the write is lost.
    if (dirty & date_picker::P_MINIMUM_DATE) != (0 as u64) {
        let lo: *u8 = ns_date({ (*p).minimum_date });
        if lo != (0 as *u8) { dp.set_min_date(ak::Date::from_raw(lo)); }
    }
    if (dirty & date_picker::P_MAXIMUM_DATE) != (0 as u64) {
        let hi: *u8 = ns_date({ (*p).maximum_date });
        if hi != (0 as *u8) { dp.set_max_date(ak::Date::from_raw(hi)); }
    }
    if (dirty & (date_picker::P_DATE | date_picker::P_MINIMUM_DATE | date_picker::P_MAXIMUM_DATE)) != (0 as u64) {
        let d: *u8 = ns_date({ (*p).date });
        if d != (0 as *u8) { dp.set_date_value(ak::Date::from_raw(d)); }
    }
    if (dirty & (date_picker::P_FONT_SCALES | date_picker::P_FONT_SIZE | date_picker::P_FONT_WEIGHT
                 | date_picker::P_FONT_FAMILY | date_picker::P_IS_ITALIC)) != (0 as u64) {
        match paint::ns_font_scaled({ (*p).font_size }, { (*p).font_weight },
                                    { (*p).font_family.view() }, { (*p).is_italic },
                                    { (*p).font_scales }) {
            option::Option[ak::Font]::Some(font) => { dp.as_control().set_font(font); }
            option::Option[ak::Font]::None => { }
        }
    }
    // `format` is a component list, not a layout. NSDatePicker has no format
    // STRING — it has an element mask — so the format is read for WHICH
    // components it names and the mask follows. That is the half of a format
    // string a date picker can honour; the ordering and the separators are the
    // locale's, which is what a date picker is for.
    if (dirty & date_picker::P_FORMAT) != (0 as u64) {
        let f: str = { (*p).format.view() };
        if f != "" { dp.set_date_picker_elements(date_elements(f)); }
    }
    // `is_open` — a calendar in a popover, bound to the same value. The field
    // stays the field: the popover is a SECOND face on one control, so a write
    // to `date` still lands in one place.
    if (dirty & date_picker::P_IS_OPEN) != (0 as u64) && dirty != paint::all_bits() {
        let o: fn(*u8, *u8) = date_opened;
        let c: fn(*u8, *u8) = date_closed;
        compose::apply_picker_popover(v, { (*p).is_open }, date_elements({ (*p).format.view() }),
                                      ns_date({ (*p).minimum_date }), ns_date({ (*p).maximum_date }),
                                      #addr_of((*p).is_open), n as *u8,
                                      on_opened: o, on_closed: c);
    }
    // `CharacterSpacing`. The picker's VALUE is an NSDate and has no attributed
    // form — but the drawing goes through a cell, and a cell puts its content in
    // `drawInteriorWithFrame:`. Only a picker that asks for a kern is drawn that
    // way; one that does not keeps AppKit's own fields entirely.
    if (dirty & (date_picker::P_CHARACTER_SPACING | date_picker::P_DATE
                 | date_picker::P_FORMAT)) != (0 as u64) {
        let shown: text::Text = shown_date(dp);
        compose::apply_picker_kern(v, { (*p).character_spacing }, shown.view(),
            paint::ns_font_scaled({ (*p).font_size }, { (*p).font_weight },
                                  { (*p).font_family.view() }, { (*p).is_italic },
                                  { (*p).font_scales }),
            { (*p).text_color });
    }
    if (dirty & date_picker::P_TEXT_COLOR) != (0 as u64) {
        let c: vocab::Color = { (*p).text_color };
        if c.is_set() { dp.set_text_color(paint::ns_color(c)); }
    }
    if (dirty & props::C_HANDLERS) != (0 as u64) || dirty == paint::all_bits() {
        let f: fn(*u8, *u8) = date_picker_action;
        akx::set_control_action_ctx(dp.as_control(), f, n as *u8);
    }
    if (dirty & props::C_IS_ENABLED) != (0 as u64) || dirty == paint::all_bits() {
        dp.as_control().set_enabled(core::is_enabled(n));
    }
    return;
}

// NSDatePickerElementFlags: YearMonth 0xc0, YearMonthDay 0xe0.
// A format naming a DAY gets all three; one naming only a month or a year gets
// the pair, which is what a "MMMM yyyy" picker means.
// What the picker is SHOWING, formatted the way the picker formats it — asked
// of the cell rather than rebuilt, so a kerned picker and a plain one never
// disagree about the text.
fn shown_date(dp: ak::DatePicker) -> text::Text {
    let cell: *u8 = { rt::msg_id(dp.as_view().raw(), rt::sel(#str_ptr("cell\0"))) };
    if cell == (0 as *u8) { return text::new(); }
    let s: *u8 = { rt::msg_id(cell, rt::sel(#str_ptr("stringValue\0"))) };
    if s == (0 as *u8) { return text::new(); }
    return bridge::to_text(s);
}

fn date_elements(f: str) -> u64 {
    let t: text::Text = text::from_str(f);
    if t.contains("d") || t.contains("D") { return 224 as u64; }
    return 192 as u64;
}

// HourMinute 0xc, HourMinuteSecond 0xe.
fn time_elements(f: str) -> u64 {
    let t: text::Text = text::from_str(f);
    if t.contains("s") || t.contains("S") { return 14 as u64; }
    return 12 as u64;
}

// ---- time_picker -------------------------------------------------------------
// The same class in its hour/minute posture.

fn create_time_picker(n: *core::Node) -> *u8 {
    let dp: ak::DatePicker = ak::DatePicker::from_raw(rt::alloc_init(#str_ptr("NSDatePicker\0")));
    dp.set_date_picker_style(ak::DatePickerStyle::TextFieldAndStepper);
    dp.set_date_picker_elements(ak::date_picker_element_flags_n_s_date_picker_element_flag_hour_minute);
    pin_picker_to_utc(dp);
    return rt::retain(dp.as_view().raw());
}

fn apply_time_picker(v: *u8, n: *core::Node, dirty: u64) {
    let p: *props::TimePickerProps = props_of(n, props::K_TIME_PICKER) as *props::TimePickerProps;
    if p == (0 as *props::TimePickerProps) { return; }
    let dp: ak::DatePicker = ak::DatePicker::from_raw(v);
    if (dirty & time_picker::P_TIME) != (0 as u64) {
        dp.set_date_value(ak::Date::from_raw(ns_time({ (*p).time })));
    }
    if (dirty & (time_picker::P_FONT_SCALES | time_picker::P_FONT_SIZE | time_picker::P_FONT_WEIGHT
                 | time_picker::P_FONT_FAMILY | time_picker::P_IS_ITALIC)) != (0 as u64) {
        match paint::ns_font_scaled({ (*p).font_size }, { (*p).font_weight },
                                    { (*p).font_family.view() }, { (*p).is_italic },
                                    { (*p).font_scales }) {
            option::Option[ak::Font]::Some(font) => { dp.as_control().set_font(font); }
            option::Option[ak::Font]::None => { }
        }
    }
    if (dirty & time_picker::P_FORMAT) != (0 as u64) {
        let f: str = { (*p).format.view() };
        if f != "" { dp.set_date_picker_elements(time_elements(f)); }
    }
    if (dirty & time_picker::P_IS_OPEN) != (0 as u64) && dirty != paint::all_bits() {
        let o: fn(*u8, *u8) = time_opened;
        let c: fn(*u8, *u8) = time_closed;
        compose::apply_picker_popover(v, { (*p).is_open }, time_elements({ (*p).format.view() }),
                                      0 as *u8, 0 as *u8, #addr_of((*p).is_open), n as *u8,
                                      on_opened: o, on_closed: c);
    }
    if (dirty & (time_picker::P_CHARACTER_SPACING | time_picker::P_TIME
                 | time_picker::P_FORMAT)) != (0 as u64) {
        let shown: text::Text = shown_date(dp);
        compose::apply_picker_kern(v, { (*p).character_spacing }, shown.view(),
            paint::ns_font_scaled({ (*p).font_size }, { (*p).font_weight },
                                  { (*p).font_family.view() }, { (*p).is_italic },
                                  { (*p).font_scales }),
            { (*p).text_color });
    }
    if (dirty & time_picker::P_TEXT_COLOR) != (0 as u64) {
        let c: vocab::Color = { (*p).text_color };
        if c.is_set() { dp.set_text_color(paint::ns_color(c)); }
    }
    if (dirty & props::C_HANDLERS) != (0 as u64) || dirty == paint::all_bits() {
        let f: fn(*u8, *u8) = time_picker_action;
        akx::set_control_action_ctx(dp.as_control(), f, n as *u8);
    }
    if (dirty & props::C_IS_ENABLED) != (0 as u64) || dirty == paint::all_bits() {
        dp.as_control().set_enabled(core::is_enabled(n));
    }
    return;
}

// ---- tabs --------------------------------------------------------------------
// NSTabView. Its children are not subviews but NSTabViewItems, each wrapping
// one view — so `views::insert` wraps a pane as it arrives rather than adding
// it as a subview, which is the same shape as the scroll's document host: the
// one place a kind's native child model differs from "add a subview".
//
// The pane's LABEL is its key. A tab needs a title, facet's tree gives every
// addressable node one, and inventing a second title prop for the same node
// would be the drift this package is written against.

// A tab strip of facet's OWN, and the reason is layout rather than colour.
//
// NSTabView's panes are NSTabViewItems it sizes itself, from its own content
// rect. facet lays every node out with flex and pushes the frames onto the
// views, so the two wrote the same frame and the walk — running last — won.
// That is not a tie facet can win: NSTabView is NOT flipped, so the walk's
// top-left arithmetic measured every pane's y from the wrong edge; and flex
// laid a pane out against the TABS node's box, which NSTabView had already
// spent part of on a strip flex knew nothing about. A pane could not be in the
// right place under either reading.
//
// So the strip is facet's: a row of buttons in the node's own PADDING, which
// is how flex is told the strip exists. `table` sets padding for its style and
// a tree sets it for indentation — same mechanism, and the panes below it are
// laid out by the ordinary walk into an ordinary flipped host.
//
// Two things follow that were not the goal and are worth as much:
//
//   - the five bar colours become ordinary drawing, because the strip is ours.
//   - a pane is an ordinary subview, so `views::insert` loses its second
//     special case and the menu tier's is the only one left.

fn strip_height() -> f64 { return 28.0f64; }
fn tab_strip_key() -> *u8 { return { 29072 as *u8 }; }
fn tab_node_key() -> *u8 { return { 29073 as *u8 }; }
fn tab_index_key() -> *u8 { return { 29074 as *u8 }; }

fn create_tabs(n: *core::Node) -> *u8 {
    let host: ak::View = akx::new_flipped_view(rt::Rect { x: 0.0f64, y: 0.0f64, w: 0.0f64, h: 0.0f64 });
    let strip: ak::View = akx::new_flipped_view(
        rt::Rect { x: 0.0f64, y: 0.0f64, w: 0.0f64, h: strip_height() });
    // Width tracks the host, top edge fixed: WidthSizable (2) | MaxYMargin (32).
    { rt::msg_void_u64(strip.raw(), rt::sel(#str_ptr("setAutoresizingMask:\0")), 34 as u64) };
    host.add_subview(strip);
    synth::set_associated(host.raw(), tab_strip_key(), strip.raw());
    return rt::retain(host.raw());
}

fn tab_strip_of(v: *u8) -> *u8 { return { synth::get_associated(v, tab_strip_key()) }; }

// A pane arrives. It is an ordinary subview now — the strip gains a button for
// it, and the LABEL is still its key, because a tab needs a title and every
// addressable node already has one.
fn tabs_add_pane(host: *u8, pane: *u8, label: str) {
    ak::View::from_raw(host).add_subview(ak::View::from_raw(pane));
    let n: *core::Node = { synth::get_associated(host, tab_node_key()) as *core::Node };
    if n != (0 as *core::Node) { rebuild_tabs(host, n); }
    return;
}

// The user picked a tab. `selected_index` is written BEFORE the handler, the
// same rule every other read follows.
fn tab_clicked(sender: *u8, ctx: *u8) {
    let n: *core::Node = ctx as *core::Node;
    let p: *props::TabsProps = props_of(n, props::K_TABS) as *props::TabsProps;
    if p == (0 as *props::TabsProps) { return; }
    let at: i64 = { synth::get_associated(sender, tab_index_key()) as i64 } - (1 as i64);
    if at < (0 as i64) { return; }
    { (*p).selected_index = at };
    let v: *u8 = core::view_of(n);
    if v != (0 as *u8) {
        show_selected_pane(n, at);
        style_tabs(v, p, at);
    }
    let h: fn(*u8, *u8) = { (*p).on_tab_changed };
    if h != props::no_handler { h(sender, { (*p).on_tab_changed_ctx }); }
    return;
}

// One button per pane, rebuilt when the panes change. A tab strip is short and
// a diff would be more code than the rebuild it replaces — the same call
// `style_popup_items` makes about a popup's menu.
fn rebuild_tabs(v: *u8, n: *core::Node) {
    let strip: *u8 = tab_strip_of(v);
    if strip == (0 as *u8) { return; }
    let subs: vec::Vec[ak::View] = ak::View::from_raw(strip).subviews();
    var i: usize = 0 as usize;
    while i < subs.count() {
        match subs.at_ptr(i) {
            option::Option[*ak::View]::Some(b) => {
                { rt::msg_void({ (*b).raw() }, rt::sel(#str_ptr("removeFromSuperview\0"))) };
            }
            option::Option[*ak::View]::None => { }
        }
        i = i +% (1 as usize);
    }
    let count: usize = core::child_count_of(n);
    if count == (0 as usize) { return; }
    var x: f64 = 0.0f64;
    let each: f64 = tab_width(v, count);
    var k: usize = 0 as usize;
    while k < count {
        match core::child_of(n, k) {
            option::Option[*core::Node]::Some(c) => {
                let b: ak::Button = ak::Button::from_raw(rt::alloc_init(#str_ptr("NSButton\0")));
                b.set_button_type(ak::ButtonType::MomentaryChange);
                b.set_bordered(false);
                b.set_title({ (*c).key() });
                let bv: ak::View = b.as_view();
                bv.set_frame(rt::Rect { x: x, y: 0.0f64, w: each, h: strip_height() });
                // One-based, so 0 can mean "no index": the slot is a pointer.
                synth::set_associated(bv.raw(), tab_index_key(), { (k +% (1 as usize)) as *u8 });
                let f: fn(*u8, *u8) = tab_clicked;
                akx::set_control_action_ctx(b.as_control(), f, n as *u8);
                ak::View::from_raw(strip).add_subview(bv);
                x = x + each;
            }
            option::Option[*core::Node]::None => { }
        }
        k = k +% (1 as usize);
    }
    let p: *props::TabsProps = props_of(n, props::K_TABS) as *props::TabsProps;
    if p != (0 as *props::TabsProps) {
        show_selected_pane(n, { (*p).selected_index });
        style_tabs(v, p, { (*p).selected_index });
    }
    return;
}

fn tab_width(v: *u8, count: usize) -> f64 {
    let box: rt::Rect = { rt::msg_rect(v, rt::sel(#str_ptr("bounds\0"))) };
    if box.w <= 0.0f64 || count == (0 as usize) { return 80.0f64; }
    return box.w / (count as f64);
}

// Only the selected pane is IN the layout. `display: none` is flex's own word
// for it, so the showing pane gets the whole box below the strip — hiding the
// others with `hidden` would leave them stacked in the layout and give the
// selected one a fraction of the space.
fn show_selected_pane(n: *core::Node, at: i64) {
    var i: usize = 0 as usize;
    let count: usize = core::child_count_of(n);
    while i < count {
        match core::child_of(n, i) {
            option::Option[*core::Node]::Some(c) => {
                if (i as i64) == at { { (*c).set_display(flex::Display::Flex) }; }
                else { { (*c).set_display(flex::Display::None) }; }
            }
            option::Option[*core::Node]::None => { }
        }
        i = i +% (1 as usize);
    }
    return;
}

// The five bar colours, which are ordinary drawing now that the strip is ours.
fn style_tabs(v: *u8, p: *props::TabsProps, at: i64) {
    let strip: *u8 = tab_strip_of(v);
    if strip == (0 as *u8) { return; }
    let back: vocab::Color = bar_color(p);
    if back.is_set() {
        let sv: ak::View = ak::View::from_raw(strip);
        sv.set_wants_layer(true);
        sv.layer().set_background_color(paint::ns_color(back).c_g_color());
    }
    let subs: vec::Vec[ak::View] = ak::View::from_raw(strip).subviews();
    var i: usize = 0 as usize;
    while i < subs.count() {
        match subs.at_ptr(i) {
            option::Option[*ak::View]::Some(bv) => {
                let raw: *u8 = { (*bv).raw() };
                let idx: i64 = { synth::get_associated(raw, tab_index_key()) as i64 } - (1 as i64);
                let fill: vocab::Color = tab_fill(p, idx == at);
                if fill.is_set() {
                    { (*bv).set_wants_layer(true) };
                    { (*bv).layer().set_background_color(paint::ns_color(fill).c_g_color()) };
                }
                let ink: vocab::Color = { (*p).bar_text_color };
                if ink.is_set() {
                    let b: ak::Button = ak::Button::from_raw(raw);
                    let a: *u8 = paint::attributed(b.title().view(),
                        paint::rich_attributes(option::Option[ak::Font]::None, ink, 0.0f64, 0.0f64,
                                               option::Option[vocab::TextAlign]::None,
                                               vocab::TextDecoration::None));
                    if a != (0 as *u8) {
                        { rt::msg_void_id(raw, rt::sel(#str_ptr("setAttributedTitle:\0")), a) };
                        rt::release(a);
                    }
                }
            }
            option::Option[*ak::View]::None => { }
        }
        i = i +% (1 as usize);
    }
    return;
}

// `BarBackground` is a Brush and `BarBackgroundColor` a Color — ledger row carries
// both and the Brush is the newer of the two, so it wins where it is set.
fn bar_color(p: *props::TabsProps) -> vocab::Color {
    let b: vocab::Brush = { (*p).bar_background };
    // A brush is a gradient or a solid, and a strip's background takes its
    // START either way: `apply_background` in paint.cplus makes the same
    // reduction, because a layer's background is one colour.
    if { b.start }.is_set() { return { b.start }; }
    return { (*p).bar_background_color };
}

fn tab_fill(p: *props::TabsProps, selected: bool) -> vocab::Color {
    if selected { return { (*p).selected_tab_color }; }
    return { (*p).unselected_tab_color };
}

fn apply_tabs(v: *u8, n: *core::Node, dirty: u64) {
    let p: *props::TabsProps = props_of(n, props::K_TABS) as *props::TabsProps;
    if p == (0 as *props::TabsProps) { return; }
    // The node pointer is re-associated every time: a node detached and
    // re-attached under the same view has a new address.
    synth::set_associated(v, tab_node_key(), n as *u8);
    // The strip lives in the node's PADDING, which is how flex is told it is
    // there. Without this a pane is laid out over the strip, which is the shape
    // of the bug NSTabView had from the other direction.
    if dirty == paint::all_bits() {
        { (*n).set_padding(flex::Edge::Top, flex::StyleLength::points(strip_height())) };
    }
    if (dirty & tabs::P_SELECTED_INDEX) != (0 as u64) {
        show_selected_pane(n, { (*p).selected_index });
    }
    let colours: u64 = tabs::P_BAR_BACKGROUND | tabs::P_BAR_BACKGROUND_COLOR
        | tabs::P_BAR_TEXT_COLOR | tabs::P_SELECTED_TAB_COLOR
        | tabs::P_UNSELECTED_TAB_COLOR | tabs::P_SELECTED_INDEX;
    if (dirty & colours) != (0 as u64) { style_tabs(v, p, { (*p).selected_index }); }
    return;
}

// ---- context_menu ------------------------------------------------------------
// The first NON-VIEW kind, and the shape is worth stating because the rest of
// the menu tier will follow it.
//
// An NSMenu is not an NSView. A `context_menu` node decorates the node it sits
// under — right-clicking the PARENT is what opens it — so it has no place of
// its own in the view tree and no frame. Its `context_menu_item` children are
// likewise not views.
//
// So both answer `wants_view` with false and `create` never runs on them. The
// menu is built instead from the NODES, at the moment the PARENT's view is
// created, and hung on that view — which is exactly what AppKit's
// `NSView.menu` is for. `views::create` calls `attach_context_menu` after it
// has a view for a node, so the walk order works out: the child nodes are
// already in the tree (build ran long before mount), even though no view
// exists for them and none ever will.
//
// This is also the macOS answer to the swipe-to-reveal actions MANIFEST.md
// records as impossible: a right-click menu IS the platform's per-row action
// affordance, and it has a keyboard path, which a swipe never does.

fn menu_kind(kind: u32) -> bool {
    return kind == props::K_CONTEXT_MENU || kind == props::K_CONTEXT_MENU_ITEM;
}

// facet's portable modifier enum onto NSEventModifierFlags.
fn ns_modifier_mask(m: vocab::KeyModifiers) -> u64 {
    return match m {
        vocab::KeyModifiers::Cmd => 1048576 as u64,       // NSEventModifierFlagCommand
        vocab::KeyModifiers::Shift => 131072 as u64,      // ...Shift
        vocab::KeyModifiers::Ctrl => 262144 as u64,       // ...Control
        vocab::KeyModifiers::Alt => 524288 as u64,        // ...Option
        // Windows has no macOS counterpart; Command is the nearest meaning and
        // is what a cross-platform app means by "the platform's own modifier".
        vocab::KeyModifiers::Windows => 1048576 as u64,
        vocab::KeyModifiers::None => 0 as u64,
    };
}

// Build the NSMenu a `context_menu` node describes. Returns 0 for a node that
// is not one, so the caller can ask unconditionally.
fn build_context_menu(n: *core::Node) -> *u8 {
    if core::kind_of(n) != props::K_CONTEXT_MENU { return 0 as *u8; }
    let menu: ak::Menu = ak::Menu::new("");
    var i: usize = 0 as usize;
    let count: usize = core::child_count_of(n);
    while i < count {
        match core::child_of(n, i) {
            option::Option[*core::Node]::Some(c) => { add_menu_item(menu, c); }
            option::Option[*core::Node]::None => { }
        }
        i = i +% (1 as usize);
    }
    return rt::retain(menu.raw());
}

// macOS marks a destructive action by WORDING and by confirming it, not by
// colouring the row — which is why this was recorded as "NSMenuItem has no
// destructive style". That is true of the API and not of the platform: a red
// title is what every app that marks one does, and a contract verb the backend
// silently drops is worse than one it answers plainly.
fn mark_destructive(item: ak::MenuItem, title: str, destructive: bool) {
    if destructive == false { return; }
    let attrs: *u8 = paint::rich_attributes(
        option::Option[ak::Font]::None, vocab::Color::rgba(0.8f64, 0.0f64, 0.0f64),
        0.0f64, 0.0f64, option::Option[vocab::TextAlign]::None,
        vocab::TextDecoration::None);
    let a: *u8 = paint::attributed(title, attrs);
    if a == (0 as *u8) { return; }
    { rt::msg_void_id(item.raw(), rt::sel(#str_ptr("setAttributedTitle:\0")), a) };
    { rt::release(a) };
    return;
}

fn add_menu_item(menu: ak::Menu, c: *core::Node) {
    let p: *props::ContextMenuItemProps =
        props_of(c, props::K_CONTEXT_MENU_ITEM) as *props::ContextMenuItemProps;
    if p == (0 as *props::ContextMenuItemProps) { return; }
    let mi: *props::MenuItemProps = { #addr_of((*p).menu_item) };
    let title: str = { (*mi).text.view() };
    // An item with no title is a separator: the ledger has no separator type, and a
    // titleless item is what every menu-building API in the world means by one.
    if title == "" {
        menu.add_item(ak::MenuItem::separator_item());
        return;
    }
    let item: ak::MenuItem = ak::MenuItem::new(title, 0 as *u8, "");
    mark_destructive(item, title, { (*mi).is_destructive });
    // The key equivalent, which is the whole reason context_menu_item declares
    // a row of its own on top of the MenuItem band.
    let key: str = { (*p).shortcut_key.view() };
    if key != "" {
        item.set_key_equivalent(key);
        item.set_key_equivalent_modifier_mask(ns_modifier_mask({ (*p).shortcut_modifiers }));
    }
    let icon: str = { (*mi).icon.view() };
    if icon != "" {
        match resolve_image(icon) {
            option::Option[ak::Image]::Some(img) => { item.set_image(img); }
            option::Option[ak::Image]::None => { }
        }
    }
    // The handler rides the same target trampoline every control action uses,
    // so a menu click and a button click arrive by one path.
    let h: fn(*u8, *u8) = { (*mi).on_clicked };
    if h != props::no_handler {
        item.set_target(akx::action_ctx_target(h, { (*mi).on_clicked_ctx }));
        item.set_action(akx::action_ctx_sel());
    }
    // is_destructive has no NSMenuItem equivalent — recorded in MANIFEST.md.
    item.set_enabled(core::is_enabled(c));
    menu.add_item(item);
    return;
}

// Hang the context menu a node's children describe on that node's view. Called
// from `views::create` once the view exists.
fn attach_context_menu(view: *u8, n: *core::Node) {
    if view == (0 as *u8) { return; }
    var i: usize = 0 as usize;
    let count: usize = core::child_count_of(n);
    while i < count {
        match core::child_of(n, i) {
            option::Option[*core::Node]::Some(c) => {
                let menu: *u8 = build_context_menu(c);
                if menu != (0 as *u8) {
                    { rt::msg_void_id(view, rt::sel(#str_ptr("setMenu:\0")), menu) };
                    return;                     // one context menu per node
                }
            }
            option::Option[*core::Node]::None => { }
        }
        i = i +% (1 as usize);
    }
    return;
}

// ---- span --------------------------------------------------------------------
// A styled RUN inside a label, not a thing of its own — so, like the menu
// kinds, it is not a view. A label with span children renders an attributed
// string built from them; a label with none renders its own `text`.
//
// This is why `span` has no create and no apply: it has nothing to apply ONTO.
// It is read as a node by the label that contains it, in `label_runs` below.

fn span_kind(kind: u32) -> bool { return kind == props::K_SPAN; }

// Does this label carry span children? A label that does uses them INSTEAD of
// its own text — a formatted label's text is the runs.
fn has_spans(n: *core::Node) -> bool {
    var i: usize = 0 as usize;
    let count: usize = core::child_count_of(n);
    while i < count {
        match core::child_of(n, i) {
            option::Option[*core::Node]::Some(c) => {
                if core::kind_of(c) == props::K_SPAN { return true; }
            }
            option::Option[*core::Node]::None => { }
        }
        i = i +% (1 as usize);
    }
    return false;
}

// The attributed string a label's span children describe, at +1.
fn build_runs(n: *core::Node) -> *u8 {
    let ms: *u8 = { rt::alloc_init(#str_ptr("NSMutableAttributedString\0")) };
    if ms == (0 as *u8) { return 0 as *u8; }
    var i: usize = 0 as usize;
    let count: usize = core::child_count_of(n);
    while i < count {
        match core::child_of(n, i) {
            option::Option[*core::Node]::Some(c) => { append_run(ms, c); }
            option::Option[*core::Node]::None => { }
        }
        i = i +% (1 as usize);
    }
    return ms;
}

fn append_run(ms: *u8, c: *core::Node) {
    let p: *props::SpanProps = props_of(c, props::K_SPAN) as *props::SpanProps;
    if p == (0 as *props::SpanProps) { return; }
    let shown: text::Text = paint::transformed({ (*p).text.view() }, { (*p).text_transform });
    // Attributes for THIS run only: a span that names nothing inherits the
    // label's own font and colour, which is what an unstyled run should do.
    // Every one of them comes from the shared builder, so a span's styling
    // band is the same band a label, a button and an input field get.
    let attrs: *u8 = paint::rich_attributes(
        paint::ns_font_scaled({ (*p).font_size }, { (*p).font_weight },
                              { (*p).font_family.view() }, { (*p).is_italic },
                              { (*p).font_scales }),
        { (*p).text_color }, { (*p).character_spacing }, { (*p).line_height },
        option::Option[vocab::TextAlign]::None, { (*p).text_decoration });
    let run: *u8 = paint::attributed(shown.view(), attrs);
    if run != (0 as *u8) {
        { rt::msg_void_id(ms, rt::sel(#str_ptr("appendAttributedString:\0")), run) };
        { rt::release(run) };
    }
    return;
}

// ---- the recorded "AppKit cannot" kinds --------------------------------------
// refreshable, swipeable and swipe_item are decided, not missing: pull-to-
// refresh and swipe-to-reveal are touch idioms with no macOS equivalent, and
// MANIFEST.md says so with what to use instead.
//
// They still get a body, and it matters that they do. A recorded decision must
// not go down the unimplemented path, because that path WARNS — and a warning
// for something already answered would train a reader to ignore the warnings
// that mean something. So: a plain backing view, silently, and the children
// inside it render exactly as they would have. A `swipeable` shows its content
// and simply reveals nothing; a `refreshable` shows its content and simply
// never pulls.

fn create_passthrough(n: *core::Node) -> *u8 {
    let v: ak::View = akx::new_flipped_view(rt::Rect { x: 0.0f64, y: 0.0f64, w: 0.0f64, h: 0.0f64 });
    return rt::retain(v.raw());
}

// `swipe_item` is still not a view — it is a ROW in the menu its swipeable
// builds, the same way a `menu_item` is a row in an NSMenu. The kind that had
// no answer at all is gone.
fn decided_absent(kind: u32) -> bool {
    return false;
}

fn swipe_kind(kind: u32) -> bool { return kind == props::K_SWIPE_ITEM; }

// ---- swipeable ---------------------------------------------------------------
// The ledger's SwipeView: content that reveals actions when swiped. The ledger said
// "swipe-to-reveal is a touch idiom; use a context menu", and the second half
// of that sentence was the answer sitting unwritten next to the first.
//
// So the actions ARE a menu, on the swipeable's own view. Every `swipe_item`
// child becomes a row: its text, its icon, its destructive marking and its two
// handlers, exactly as a `menu_item` does — because they are the same object
// and a second set of rules would be two answers to one question.
//
// Four of the five swipe handlers map onto the menu's own edges, which are the
// only edges that exist without a gesture:
//
//   menuWillOpen   on_swipe_started, on_open_requested
//   menuDidClose   on_swipe_ended, on_close_requested
//
// `observe_swipe_changing` and `reveal_threshold` describe a CONTINUOUS motion
// and stay in the ledger: there is no partial state between closed and open
// when the thing that opens it is a click.

fn create_swipeable(n: *core::Node) -> *u8 {
    let v: ak::View = akx::new_flipped_view(rt::Rect { x: 0.0f64, y: 0.0f64, w: 0.0f64, h: 0.0f64 });
    return rt::retain(v.raw());
}

// The reveal's own state, which is the backend's rather than the description's:
// a threshold to beat and the five handlers to report against.
static SWIPE_HOOKS: compose::SwipeHooks = #zero::[compose::SwipeHooks]();

fn apply_swipeable(v: *u8, n: *core::Node, dirty: u64) {
    let band: u64 = props::C_HANDLERS | props::C_LAYOUT | swipeable::P_REVEAL_THRESHOLD;
    if (dirty & band) != (0 as u64) || dirty == paint::all_bits() {
        attach_swipe_menu(v, n);
        build_swipe_reveal(v, n);
    }
    return;
}

// The DRAG path. The menu is the click path an agent has and is untouched; this
// is the same description read a second way, so a user gets both and there is
// no second place to add an action.
fn build_swipe_reveal(v: *u8, n: *core::Node) {
    let p: *props::SwipeableProps = props_of(n, props::K_SWIPEABLE) as *props::SwipeableProps;
    if p == (0 as *props::SwipeableProps) { return; }
    var count: usize = 0 as usize;
    var i: usize = 0 as usize;
    let children: usize = core::child_count_of(n);
    while i < children {
        match core::child_of(n, i) {
            option::Option[*core::Node]::Some(c) => {
                if core::kind_of(c) == props::K_SWIPE_ITEM { count = count +% (1 as usize); }
            }
            option::Option[*core::Node]::None => { }
        }
        i = i +% (1 as usize);
    }
    if count == (0 as usize) { return; }
    SWIPE_HOOKS = compose::SwipeHooks {
        threshold: { (*p).reveal_threshold },
        changing: { (*p).observe_swipe_changing }, changing_ctx: { (*p).observe_swipe_changing_ctx },
        started: { (*p).on_swipe_started }, started_ctx: { (*p).on_swipe_started_ctx },
        ended: { (*p).on_swipe_ended }, ended_ctx: { (*p).on_swipe_ended_ctx },
        opened: { (*p).on_open_requested }, opened_ctx: { (*p).on_open_requested_ctx },
        closed: { (*p).on_close_requested }, closed_ctx: { (*p).on_close_requested_ctx },
    };
    let strip: *u8 = compose::install_swipe_strip(v, count, #addr_of(SWIPE_HOOKS));
    if strip == (0 as *u8) { return; }
    compose::clear_swipe_strip(strip);
    var at: usize = 0 as usize;
    var k: usize = 0 as usize;
    while k < children {
        match core::child_of(n, k) {
            option::Option[*core::Node]::Some(c) => {
                if core::kind_of(c) == props::K_SWIPE_ITEM {
                    let sp: *props::SwipeItemProps = props_of(c, props::K_SWIPE_ITEM) as *props::SwipeItemProps;
                    if sp != (0 as *props::SwipeItemProps) {
                        let mi: *props::MenuItemProps = { #addr_of((*sp).menu_item) };
                        let f: fn(*u8, *u8) = swipe_item_clicked;
                        compose::add_swipe_action(strip, at, { (*mi).text.view() },
                                                  { (*mi).is_destructive }, f, c as *u8);
                        at = at +% (1 as usize);
                    }
                }
            }
            option::Option[*core::Node]::None => { }
        }
        k = k +% (1 as usize);
    }
    return;
}

// The menu a swipeable's `swipe_item` children describe, hung on its view. A
// swipeable with no swipe items gets none — an empty menu on a view is a
// right-click that opens nothing, which reads as broken.
fn attach_swipe_menu(view: *u8, n: *core::Node) {
    if view == (0 as *u8) { return; }
    let menu: ak::Menu = ak::Menu::new("");
    var found: bool = false;
    var i: usize = 0 as usize;
    let count: usize = core::child_count_of(n);
    while i < count {
        match core::child_of(n, i) {
            option::Option[*core::Node]::Some(c) => {
                if core::kind_of(c) == props::K_SWIPE_ITEM {
                    add_swipe_item(menu, c);
                    found = true;
                }
            }
            option::Option[*core::Node]::None => { }
        }
        i = i +% (1 as usize);
    }
    if !found { return; }
    { rt::msg_void_id(view, rt::sel(#str_ptr("setMenu:\0")), menu.raw()) };
    text_input::install_swipe(view, menu.raw(), n);
    return;
}

// A swipe item IS a menu item. `on_invoked` is the ledger's second name for the same
// moment — SwipeItem.Invoked fires alongside Clicked — so both run, in that
// order, and an application that wired either gets it.
fn add_swipe_item(menu: ak::Menu, c: *core::Node) {
    let p: *props::SwipeItemProps = props_of(c, props::K_SWIPE_ITEM) as *props::SwipeItemProps;
    if p == (0 as *props::SwipeItemProps) { return; }
    let mi: *props::MenuItemProps = { #addr_of((*p).menu_item) };
    let title: str = { (*mi).text.view() };
    if title == "" { menu.add_item(ak::MenuItem::separator_item()); return; }
    let item: ak::MenuItem = ak::MenuItem::new(title, 0 as *u8, "");
    mark_destructive(item, title, { (*mi).is_destructive });
    let icon: str = { (*mi).icon.view() };
    if icon != "" {
        match resolve_image(icon) {
            option::Option[ak::Image]::Some(img) => { item.set_image(img); }
            option::Option[ak::Image]::None => { }
        }
    }
    let f: fn(*u8, *u8) = swipe_item_clicked;
    item.set_target(akx::action_ctx_target(f, c as *u8));
    item.set_action(akx::action_ctx_sel());
    item.set_enabled(core::is_enabled(c));
    menu.add_item(item);
    return;
}

fn swipe_item_clicked(sender: *u8, ctx: *u8) {
    let c: *core::Node = ctx as *core::Node;
    let p: *props::SwipeItemProps = props_of(c, props::K_SWIPE_ITEM) as *props::SwipeItemProps;
    if p == (0 as *props::SwipeItemProps) { return; }
    let mi: *props::MenuItemProps = { #addr_of((*p).menu_item) };
    let h: fn(*u8, *u8) = { (*mi).on_clicked };
    if h != props::no_handler { h(sender, { (*mi).on_clicked_ctx }); }
    let g: fn(*u8, *u8) = { (*p).on_invoked };
    if g != props::no_handler { g(sender, { (*p).on_invoked_ctx }); }
    return;
}

// ---- refreshable -------------------------------------------------------------
// The ledger's RefreshView. The ledger said "pull-to-refresh is a touch idiom", which
// is true about the GESTURE and was read as a claim about the feature. facet's
// own rule already says what to do with a gesture-only affordance: an agent has
// no hands, so add a click path. See compose::apply_refresh — a refresh button
// at the top of the content, a spinner in its place while refreshing.

fn create_refreshable(n: *core::Node) -> *u8 {
    let v: ak::View = akx::new_flipped_view(rt::Rect { x: 0.0f64, y: 0.0f64, w: 0.0f64, h: 0.0f64 });
    return rt::retain(v.raw());
}

// The click, before the application's handler: `is_refreshing` becomes true
// the moment a refresh starts, so a handler asking for it gets the state that
// caused it. Same rule as every other write-back.
fn refreshable_clicked(sender: *u8, ctx: *u8) {
    let n: *core::Node = ctx as *core::Node;
    let p: *props::RefreshableProps = props_of(n, props::K_REFRESHABLE) as *props::RefreshableProps;
    if p == (0 as *props::RefreshableProps) { return; }
    { (*p).is_refreshing = true };
    let v: *u8 = core::view_of(n);
    if v != (0 as *u8) {
        compose::apply_refresh(v, { (*p).is_refreshable }, true, false, { (*p).refresh_color },
                               refreshable_clicked, n as *u8);
    }
    let h: fn(*u8, *u8) = { (*p).on_refreshing };
    if h != props::no_handler { h(sender, { (*p).on_refreshing_ctx }); }
    return;
}

fn apply_refreshable(v: *u8, n: *core::Node, dirty: u64) {
    let p: *props::RefreshableProps = props_of(n, props::K_REFRESHABLE) as *props::RefreshableProps;
    if p == (0 as *props::RefreshableProps) { return; }
    let band: u64 = refreshable::P_IS_REFRESHABLE | refreshable::P_IS_REFRESHING
        | refreshable::P_REFRESH_COLOR | props::C_HANDLERS;
    if (dirty & band) != (0 as u64) || dirty == paint::all_bits() {
        let f: fn(*u8, *u8) = refreshable_clicked;
        compose::apply_refresh(v, { (*p).is_refreshable }, { (*p).is_refreshing }, true,
                               { (*p).refresh_color }, f, n as *u8);
    }
    return;
}

// ---- the collection group ----------------------------------------------------
// list, collection, table, carousel, tree — every kind whose content is a
// SEQUENCE rather than a fixed set of children.
//
// The shape here is one decision, and it is worth stating because it is not
// the obvious one. AppKit's answer is NSTableView with a data source: the
// table asks for row `i` when it needs it, and recycles the views it is done
// with. That means a synthesized delegate class, a mount-within-a-mount for
// each cell, and a cache keyed by row.
//
// This does something simpler and, for facet, more honest: A LIST MATERIALISES
// ITS ROWS AS CHILDREN OF ITSELF. `row(ctx, i)` is called for each i, and the
// resulting Node is added to the list node with the ordinary structural verb.
// From there facet's own machinery does everything — mount creates the views,
// insert puts them in the scroll's document view, the frame walk places them,
// and node teardown releases them. There is no second lifetime model, no
// per-cell registry, and no path a row can take that an ordinary child cannot.
//
// The cost is that a list builds every row up front rather than the visible
// ones. That is a real limit and MANIFEST.md records it: the pre-regen
// backend's recycling NSTableView exists and is the upgrade, and it is worth
// doing when a consumer actually has ten thousand rows. It is NOT worth
// inventing a second, parallel mount path before then.
//
// Materialising happens in `apply` ONLY, and the walk order is what makes the
// first pass work: `views::create` calls `apply_<kind>` with an all-ones dirty
// word before returning, and mount_walk reads `child_count_of(n)` only AFTER
// create returns — so rows built during that first apply are mounted by the
// same walk, with no second pass and no second code path.

// Drop every row this control materialised. `remove_child` takes the native
// views out through the Renderer and fires the detach handlers, so a rebuilt
// list leaves nothing of the old one behind.
fn clear_rows(n: *core::Node) {
    while core::child_count_of(n) > (0 as usize) {
        let _gone: option::Option[core::Node] = mount::remove_child(n, 0 as usize);
    }
    return;
}

// Add one row. During `create` the node is not attached yet and the walk will
// mount what it finds; afterwards `mount::add_child` mounts it immediately.
// Both go through the same verb, so there is one code path either way.
fn add_row(n: *core::Node, take row: core::Node) {
    let _ok: bool = mount::add_child(n, row);
    return;
}

fn fill_rows(n: *core::Node, count: i64, builder: fn(usize, *u8) -> flex::Node, ctx: *u8) {
    clear_rows(n);
    if builder == (0 as fn(usize, *u8) -> flex::Node) { return; }
    var i: i64 = 0 as i64;
    while i < count {
        add_row(n, builder(i as usize, ctx));
        i = i +% (1 as i64);
    }
    return;
}

// A scroll host for a sequence: the same flipped document view a `scroll` uses,
// so `views::host_for` redirects children into it with no extra case.
fn create_sequence_host(horizontal: bool) -> *u8 {
    let s: ak::ScrollView = ak::ScrollView::from_raw(rt::alloc_init(#str_ptr("NSScrollView\0")));
    let doc: ak::View = akx::new_flipped_view(rt::Rect { x: 0.0f64, y: 0.0f64, w: 0.0f64, h: 0.0f64 });
    s.set_document_view(doc);
    s.set_draws_background(false);
    if horizontal {
        s.set_has_horizontal_scroller(true);
    } else {
        s.set_has_vertical_scroller(true);
    }
    return rt::retain(s.as_view().raw());
}

// ---- list --------------------------------------------------------------------
// `list` has NO body here. `views::create` and `views::apply` route K_LIST to
// `recycler::create_recycling_list` / `apply_recycling_list`, and an NSTableView
// that asks for the rows it needs is the whole point of the kind: a list of ten
// thousand costs what a list of three costs.
//
// A materialising `create_list` / `materialise_list` / `apply_list` trio used to
// sit here and was reachable from nothing once the recycler landed. It is gone
// rather than fenced, because a second implementation of a live kind is a thing
// a reader has to rule out before trusting the first.

// ---- collection --------------------------------------------------------------
// The ledger's CollectionView. The same sequence, and on this backend the same
// treatment — the layout differences the ledger expresses through ItemsLayout are
// flex's job here, on the rows themselves.

// NOTE the absence of a materialise call in `create_`. `views::create` calls
// `apply_<kind>` with an all-ones dirty word straight after it, so the rows are
// built exactly once, by the same code that rebuilds them later. Doing it in
// create as well built every row twice — the first set cleared by the second.
// That is the create-calls-apply rule paying for itself, and it holds for
// `table` below too.
fn create_collection(n: *core::Node) -> *u8 { return create_sequence_host(false); }

fn materialise_collection(n: *core::Node) {
    let p: *props::CollectionProps = props_of(n, props::K_COLLECTION) as *props::CollectionProps;
    if p == (0 as *props::CollectionProps) { return; }
    // A collection that named a BIND writes into the rows it already has, when
    // it still has the right number of them.
    //
    // The ledger said "collection does not recycle by design; nothing to bind
    // INTO", which is true about RECYCLING and was standing in for the whole
    // verb. A collection materialises every row, so there is always something
    // to bind into — the thing it does not do is REUSE a row for a different
    // index as it scrolls. Binding is the other half: the count is the same,
    // the data changed, and rebuilding every subtree to say so is the work the
    // bind exists to avoid. It is the same promise the recycler's bind makes —
    // that every row has the same shape — said by the same verb.
    if rebind_rows(n, p) { return; }
    // A grouped sequence is the SAME flat sequence, broken by headers — so the
    // row builder is untouched and `row(i)` still means row `i` of the whole.
    // That is what makes grouping an addition to a description rather than a
    // rewrite of one.
    if { (*p).groupable_items_view.is_grouped } && { (*p).group_count } > (0 as i64) {
        fill_groups(n, { (*p).group_count },
                    { (*p).group_size }, { (*p).group_size_ctx },
                    { (*p).group_header }, { (*p).group_header_ctx },
                    { (*p).row }, { (*p).row_ctx });
        return;
    }
    fill_rows(n, { (*p).count }, { (*p).row }, { (*p).row_ctx });
    return;
}

// Write the current data into the rows that are already there. False when it
// cannot — no bind named, or the shape changed — and the caller rebuilds.
//
// A HEADER is skipped rather than bound: `group_header` builds it and a data
// row is not what it holds. The mapping is `data_index_of`, the same one the
// selection uses, so a grouped collection binds row `i` into whichever child
// shows row `i`.
fn rebind_rows(n: *core::Node, p: *props::CollectionProps) -> bool {
    let f: fn(usize, *core::Node, *u8) = { (*p).bind };
    if f == props::no_bind { return false; }
    let children: usize = core::child_count_of(n);
    if children == (0 as usize) { return false; }
    if expected_children(n, p) != children { return false; }
    var i: usize = 0 as usize;
    while i < children {
        match core::child_of(n, i) {
            option::Option[*core::Node]::Some(c) => {
                let data: i64 = data_index_of(n, i as i64);
                if data >= (0 as i64) {
                    f(data as usize, c, { (*p).row_ctx });
                    // A bind WRITES PROPS, which marks nodes dirty and touches
                    // nothing native. `sync_from` is the walk that carries
                    // those writes across, rooted at the row — the same call
                    // the recycler makes for the same reason.
                    mount::sync_from(c);
                }
            }
            option::Option[*core::Node]::None => { }
        }
        i = i +% (1 as usize);
    }
    return true;
}

// How many children the current description asks for: rows, plus one per group
// when it is grouped. A mismatch means the SHAPE changed and a bind cannot
// express that — the sequence is rebuilt.
fn expected_children(n: *core::Node, p: *props::CollectionProps) -> usize {
    if !{ (*p).groupable_items_view.is_grouped } || { (*p).group_count } <= (0 as i64) {
        return { (*p).count } as usize;
    }
    let size: fn(usize, *u8) -> usize = { (*p).group_size };
    var total: usize = { (*p).group_count } as usize;
    var g: i64 = 0 as i64;
    while g < { (*p).group_count } {
        total = total +% size(g as usize, { (*p).group_size_ctx });
        g = g +% (1 as i64);
    }
    return total;
}

// Header, then that group's run of rows, then the next header. The flat row
// index runs THROUGH the groups: an application that groups a list it already
// had does not renumber it.
fn fill_groups(n: *core::Node, groups: i64,
               size: fn(usize, *u8) -> usize, size_ctx: *u8,
               header: fn(usize, *u8) -> flex::Node, header_ctx: *u8,
               builder: fn(usize, *u8) -> flex::Node, builder_ctx: *u8) {
    clear_rows(n);
    if builder == (0 as fn(usize, *u8) -> flex::Node) { return; }
    var flat: usize = 0 as usize;
    var g: i64 = 0 as i64;
    while g < groups {
        add_row(n, header(g as usize, header_ctx));
        let rows: usize = size(g as usize, size_ctx);
        var k: usize = 0 as usize;
        while k < rows {
            add_row(n, builder(flat, builder_ctx));
            flat = flat +% (1 as usize);
            k = k +% (1 as usize);
        }
        g = g +% (1 as i64);
    }
    return;
}

// A CHILD index back to the DATA index the application counts in: the headers
// are not rows, so a grouped collection's fifth child may be its third row.
// -1 for a header, which is not selectable.
fn data_index_of(n: *core::Node, child: i64) -> i64 {
    let p: *props::CollectionProps = props_of(n, props::K_COLLECTION) as *props::CollectionProps;
    if p == (0 as *props::CollectionProps) { return child; }
    if !{ (*p).groupable_items_view.is_grouped } || { (*p).group_count } <= (0 as i64) {
        return child;
    }
    let size: fn(usize, *u8) -> usize = { (*p).group_size };
    var at: i64 = 0 as i64;
    var flat: i64 = 0 as i64;
    var g: i64 = 0 as i64;
    while g < { (*p).group_count } {
        if at == child { return -1 as i64; }              // the header itself
        at = at +% (1 as i64);
        let rows: i64 = size(g as usize, { (*p).group_size_ctx }) as i64;
        var k: i64 = 0 as i64;
        while k < rows {
            if at == child { return flat; }
            at = at +% (1 as i64);
            flat = flat +% (1 as i64);
            k = k +% (1 as i64);
        }
        g = g +% (1 as i64);
    }
    return -1 as i64;
}

// The reverse, for painting: which CHILD shows data row `data`.
fn child_index_of(n: *core::Node, data: i64) -> i64 {
    if data < (0 as i64) { return -1 as i64; }
    var i: i64 = 0 as i64;
    let count: i64 = core::child_count_of(n) as i64;
    while i < count {
        if data_index_of(n, i) == data { return i; }
        i = i +% (1 as i64);
    }
    return -1 as i64;
}

// `MeasureAllItems` is flex's own behaviour and needs nothing said.
// `MeasureFirstItem` measures ONE row and gives every other row that size,
// which is the same optimisation the recycler spells `uniform` — and the
// observable half of it is that a ragged sequence comes out even.
fn apply_item_sizing(n: *core::Node, mode: vocab::ItemSizing) {
    let uniform: bool = match mode {
        vocab::ItemSizing::MeasureFirstItem => true,
        vocab::ItemSizing::MeasureAllItems => false,
    };
    if !uniform { return; }
    let count: usize = core::child_count_of(n);
    if count < (2 as usize) { return; }
    let box: flex::Frame = { (*n).frame() };
    if box.width > 0.0f64 { { (*n).calculate_layout(width: box.width, height: box.height) }; }
    var h: f64 = 0.0f64;
    match core::child_of(n, 0 as usize) {
        option::Option[*core::Node]::Some(first) => { h = { (*first).frame() }.height; }
        option::Option[*core::Node]::None => { }
    }
    if h <= 0.0f64 { return; }
    var i: usize = 1 as usize;
    while i < count {
        match core::child_of(n, i) {
            option::Option[*core::Node]::Some(c) => {
                { (*c).set_height(flex::StyleLength::points(h)) };
            }
            option::Option[*core::Node]::None => { }
        }
        i = i +% (1 as usize);
    }
    return;
}

// A collection that reorders but does not select still needs the class the
// selection installs, so it gets one with nothing behind it rather than a
// second arming path.
fn no_pick(doc: *u8, child: i64) { return; }
fn no_move(doc: *u8, from: i64, to: i64) { return; }

// A drop landed. The child nodes move — which is what the user sees — and the
// two indices are written so the handler can persist it. facet cannot reorder
// the application's DATA: the sequence is a count plus a builder, and the
// order is the application's own. So the move is reported rather than assumed,
// and the next write of `count` or `row` is the application's answer.
fn collection_row_moved(doc: *u8, from: i64, to: i64) {
    let n: *core::Node = { synth::get_associated(doc, compose::select_node_key()) as *core::Node };
    if n == (0 as *core::Node) { return; }
    let p: *props::CollectionProps = props_of(n, props::K_COLLECTION) as *props::CollectionProps;
    if p == (0 as *props::CollectionProps) { return; }
    if from < (0 as i64) || to < (0 as i64) || from == to { return; }
    let a: i64 = data_index_of(n, from);
    let b: i64 = data_index_of(n, to);
    // A HEADER is not an item: it cannot be dragged and nothing can be dropped
    // onto it, because a group's boundary is the group's, not a row's.
    if a < (0 as i64) || b < (0 as i64) { return; }
    // `CanMixGroups`: without it a row stays in the group it started in, which
    // is what makes a grouped sequence stay grouped.
    if !{ (*p).reorderable_items_view.can_mix_groups } {
        if group_of(n, from) != group_of(n, to) { return; }
    }
    match mount::remove_child(n, from as usize) {
        option::Option[core::Node]::Some(moved) => {
            let _ok: bool = mount::insert_child(n, moved, to as usize);
        }
        option::Option[core::Node]::None => { return; }
    }
    { (*p).reorder_from = a };
    { (*p).reorder_to = b };
    let h: fn(*u8, *u8) = { (*p).reorderable_items_view.on_reorder_completed };
    if h != props::no_handler { h(doc, { (*p).reorderable_items_view.on_reorder_completed_ctx }); }
    return;
}

// Which group a CHILD sits in, or -1 when the sequence is not grouped — which
// makes the mix-groups check pass for every row, as it should.
fn group_of(n: *core::Node, child: i64) -> i64 {
    let p: *props::CollectionProps = props_of(n, props::K_COLLECTION) as *props::CollectionProps;
    if p == (0 as *props::CollectionProps) { return -1 as i64; }
    if !{ (*p).groupable_items_view.is_grouped } || { (*p).group_count } <= (0 as i64) {
        return -1 as i64;
    }
    let size: fn(usize, *u8) -> usize = { (*p).group_size };
    var at: i64 = 0 as i64;
    var g: i64 = 0 as i64;
    while g < { (*p).group_count } {
        let rows: i64 = size(g as usize, { (*p).group_size_ctx }) as i64;
        if child >= at && child <= (at +% rows) { return g; }
        at = at +% rows +% (1 as i64);
        g = g +% (1 as i64);
    }
    return -1 as i64;
}

fn selects_rows(m: vocab::SelectionMode) -> bool {
    return match m {
        vocab::SelectionMode::None => false,
        vocab::SelectionMode::Single => true,
        vocab::SelectionMode::Multiple => true,
    };
}

// A row was clicked. The write-back comes BEFORE the handler, the same rule
// every other read follows — a handler asking `selected_index()` gets the row
// that caused it.
fn collection_row_picked(doc: *u8, child: i64) {
    let n: *core::Node = { synth::get_associated(doc, compose::select_node_key()) as *core::Node };
    if n == (0 as *core::Node) { return; }
    let p: *props::CollectionProps = props_of(n, props::K_COLLECTION) as *props::CollectionProps;
    if p == (0 as *props::CollectionProps) { return; }
    let data: i64 = data_index_of(n, child);
    if data < (0 as i64) { return; }
    { (*p).selected_index = data };
    compose::paint_selection(n, child);
    let sel: *props::SelectableItemsViewProps = { #addr_of((*p).selectable_items_view) };
    let h: fn(*u8, *u8) = { (*sel).on_selection_changed };
    if h != props::no_handler { h(doc, { (*sel).on_selection_changed_ctx }); }
    return;
}

// Arrange a materialised sequence into COLUMNS.
//
// A collection's rows are ordinary facet children inside its scroll, so a grid
// is not a second layout engine — it is flex wrap plus a width. Each item takes
// an equal fraction of the line and the container wraps when the line is full,
// which is what `NSCollectionViewFlowLayout` does and what the ledger models as
// a `GridItemsLayout` with a Span.
//
// Zero is "not asked for", the same reading the contract gives every numeric
// zero, and it means one column — a list, which is what a collection was before
// this verb existed. So an application that never mentions columns sees no
// change at all.
fn arrange_columns(n: *core::Node, columns: usize) {
    if n == (0 as *core::Node) { return; }
    let count: usize = core::child_count_of(n);
    if count == (0 as usize) { return; }
    if columns <= (1 as usize) {
        // Back to a single column: undo the wrap and let each row take the
        // width again. Written back rather than left alone, because a
        // collection can be regridded at runtime and the old fractions would
        // otherwise stay on the children.
        core::set_wrap(n, flex::Wrap::NoWrap);
        var i: usize = 0 as usize;
        while i < count {
            match core::child_of(n, i) {
                option::Option[*core::Node]::Some(c) => { core::set_width_percent(c, 100.0f64); }
                option::Option[*core::Node]::None => { }
            }
            i = i +% (1 as usize);
        }
        return;
    }
    core::set_wrap(n, flex::Wrap::Wrap);
    let share: f64 = 100.0f64 / (columns as f64);
    var i: usize = 0 as usize;
    while i < count {
        match core::child_of(n, i) {
            option::Option[*core::Node]::Some(c) => {
                core::set_width_percent(c, share);
                // A grid cell is its share of the line and no more. Without
                // this a row that grows would eat the line and the wrap would
                // never happen.
                core::set_grow(c, 0.0f64);
            }
            option::Option[*core::Node]::None => { }
        }
        i = i +% (1 as usize);
    }
}

fn apply_collection(v: *u8, n: *core::Node, dirty: u64) {
    let p: *props::CollectionProps = props_of(n, props::K_COLLECTION) as *props::CollectionProps;
    if p == (0 as *props::CollectionProps) { return; }
    let iv: *props::ItemsViewProps = { #addr_of((*p).items_view) };
    if (dirty & (collection::P_COUNT | collection::P_ROW | collection::P_GROUP_COUNT
                 | collection::P_GROUP | collection::P_IS_GROUPED)) != (0 as u64) {
        let before: f64 = kept_offset(v, { (*iv).scroll_anchor });
        materialise_collection(n);
        // The rows are new objects, so the arrangement has to be re-applied to
        // them — a grid that survived only until the next rebuild would be
        // worse than none.
        arrange_columns(n, { (*p).structured_items_view.columns });
        restore_anchor(v, n, { (*iv).scroll_anchor }, before);
    }
    if (dirty & collection::P_COLUMNS) != (0 as u64) {
        arrange_columns(n, { (*p).structured_items_view.columns });
    }
    let sel: *props::SelectableItemsViewProps = { #addr_of((*p).selectable_items_view) };
    // A collection is a scroll of ordinary children, so nothing in it reports a
    // selection — it is found the same way `carousel.position` is, from the
    // geometry flex already knows. The click is taken on the DOCUMENT VIEW: a
    // plain row does not accept mouse events, so its click walks up to here,
    // while a row containing a button keeps its own.
    if (dirty & (collection::P_SELECTION_MODE | collection::P_COUNT | collection::P_ROW
                 | props::C_HANDLERS)) != (0 as u64) || dirty == paint::all_bits() {
        let doc: *u8 = document_host(v);
        if selects_rows({ (*sel).selection_mode }) {
            let f: fn(*u8, i64) = collection_row_picked;
            compose::install_row_selection(doc, n, f);
        } else {
            compose::uninstall_row_selection(doc);
        }
    }
    // Reorder needs the same class the selection installs — a press that MOVES
    // is a reorder and one that does not is a pick, and they cannot be told
    // apart until the mouse comes up. So a collection that reorders but does
    // not select is armed for the class anyway, with no pick handler on it.
    let ro: *props::ReorderableItemsViewProps = { #addr_of((*p).reorderable_items_view) };
    if (dirty & (collection::P_CAN_REORDER_ITEMS | collection::P_CAN_MIX_GROUPS
                 | collection::P_COUNT | collection::P_ROW
                 | props::C_HANDLERS)) != (0 as u64) || dirty == paint::all_bits() {
        let doc: *u8 = document_host(v);
        if { (*ro).can_reorder_items } {
            let g: fn(*u8, i64, i64) = collection_row_moved;
            compose::install_row_selection(doc, n, no_pick);
            compose::install_row_reorder(doc, true, g);
        } else {
            compose::install_row_reorder(doc, false, no_move);
        }
    }
    if (dirty & (collection::P_SELECTED_INDEX | collection::P_COUNT
                 | collection::P_ROW)) != (0 as u64) {
        compose::paint_selection(n, child_index_of(n, { (*p).selected_index }));
    }
    // `MeasureFirstItem` is a sizing STRATEGY, and its observable half is that
    // every item comes out the size of the first. The rows have no frames yet —
    // they were built a statement ago — so the subtree is laid out at the size
    // it already occupies, exactly as the tail anchor does.
    if (dirty & (collection::P_ITEM_SIZING | collection::P_COUNT
                 | collection::P_ROW)) != (0 as u64) {
        apply_item_sizing(n, { (*p).structured_items_view.item_sizing });
    }
    if (dirty & (collection::P_VERTICAL_SCROLL_BARS | collection::P_HORIZONTAL_SCROLL_BARS)) != (0 as u64) {
        apply_sequence_scrollers(v, { (*iv).vertical_scroll_bars }, { (*iv).horizontal_scroll_bars });
    }
    if (dirty & collection::P_SCROLL_TO) != (0 as u64) {
        scroll_child_into_view(v, n, { (*iv).scroll_to_index });
    }
    return;
}

// ---- what an update does to the scroll ---------------------------------------
// `ItemsView.ItemsUpdatingScrollMode`. The ledger said this "needs an update
// event facet has none of" — facet has exactly one, and it is the only moment
// the question arises: a write to `count` or `row` re-materialises the
// sequence, so the offset is read before and answered after.
//
//   KeepItemsInView    the default. Whatever was showing keeps showing, which
//                      is what a scroll view does when nothing moves it.
//   KeepScrollOffset   the same NUMBER rather than the same items — a shorter
//                      sequence scrolls itself back into range.
//   KeepLastItemInView follow the tail, which is the one an appending log or a
//                      chat transcript wants.
fn kept_offset(v: *u8, a: vocab::ScrollAnchor) -> f64 {
    if v == (0 as *u8) { return 0.0f64; }
    let keeps: bool = match a {
        vocab::ScrollAnchor::KeepScrollOffset => true,
        vocab::ScrollAnchor::KeepItemsInView => false,
        vocab::ScrollAnchor::KeepLastItemInView => false,
    };
    if !keeps { return 0.0f64; }
    let clip: *u8 = { rt::msg_id(v, rt::sel(#str_ptr("contentView\0"))) };
    if clip == (0 as *u8) { return 0.0f64; }
    let b: rt::Rect = { rt::msg_rect(clip, rt::sel(#str_ptr("bounds\0"))) };
    return b.y;
}

fn restore_anchor(v: *u8, n: *core::Node, a: vocab::ScrollAnchor, before: f64) {
    match a {
        vocab::ScrollAnchor::KeepItemsInView => { }
        vocab::ScrollAnchor::KeepScrollOffset => {
            scroll_document_to(v, rt::Point { x: 0.0f64, y: before }, false);
        }
        vocab::ScrollAnchor::KeepLastItemInView => {
            let count: usize = core::child_count_of(n);
            if count > (0 as usize) {
                // The rows were built a statement ago and have no frames yet,
                // so the tail has no position to scroll to. Lay the subtree out
                // at the size it already occupies: the next full pass redoes
                // the same arithmetic and agrees with it.
                let box: flex::Frame = { (*n).frame() };
                if box.width > 0.0f64 {
                    { (*n).calculate_layout(width: box.width, height: box.height) };
                }
                scroll_child(v, n, (count -% (1 as usize)) as i64, false);
            }
        }
    }
    return;
}

// The scrollers on a materialising sequence. A `list` answers this on its
// table; a collection and a carousel are a plain scroll of their children, so
// the scroll view IS the node's view.
fn apply_sequence_scrollers(v: *u8, vert: vocab::ScrollBars, horiz: vocab::ScrollBars) {
    let sv: ak::ScrollView = ak::ScrollView::from_raw(v);
    sv.set_has_vertical_scroller(shows_bars(vert));
    sv.set_has_horizontal_scroller(shows_bars(horiz));
    return;
}

// `scroll_to(index)` on a materialised sequence: the child's frame is flex's
// already, so this needs no measurement of its own. Out of range is a no-op
// rather than a clamp — scrolling to a row that does not exist is a mistake,
// and pretending it meant the last one would hide it.
fn scroll_child_into_view(v: *u8, n: *core::Node, index: i64) {
    scroll_child(v, n, index, false);
    return;
}

fn scroll_child(v: *u8, n: *core::Node, index: i64, animated: bool) {
    if index < (0 as i64) { return; }
    match core::child_of(n, index as usize) {
        option::Option[*core::Node]::Some(child) => {
            let f: flex::Frame = { (*child).frame() };
            scroll_document_to(v, rt::Point { x: f.left, y: f.top }, animated);
        }
        option::Option[*core::Node]::None => { }
    }
    return;
}

// A jump, or a slide. `IsScrollAnimated` IS a per-scroll switch on AppKit —
// The ledger's claim that it was not read the animator proxy as a property of
// the scroll view, when it is a property of the CALL: the clip view's
// `boundsOrigin` animates like any other, and `reflectScrolledClipView:` is
// what tells the scroll view its scrollers moved.
fn scroll_document_to(v: *u8, p: rt::Point, animated: bool) {
    let sv: ak::ScrollView = ak::ScrollView::from_raw(v);
    if !animated {
        match sv.document_view() {
            option::Option[ak::View]::Some(doc) => { doc.scroll_point(p); }
            option::Option[ak::View]::None => { }
        }
        return;
    }
    let clip: *u8 = { rt::msg_id(v, rt::sel(#str_ptr("contentView\0"))) };
    if clip == (0 as *u8) { return; }
    let cls: *u8 = rt::get_class(#str_ptr("NSAnimationContext\0"));
    { rt::msg_void(cls, rt::sel(#str_ptr("beginGrouping\0"))) };
    let anim: *u8 = { rt::msg_id(clip, rt::sel(#str_ptr("animator\0"))) };
    if anim != (0 as *u8) {
        { rt::msg_void_point(anim, rt::sel(#str_ptr("setBoundsOrigin:\0")), p) };
    }
    { rt::msg_void_id(v, rt::sel(#str_ptr("reflectScrolledClipView:\0")), clip) };
    { rt::msg_void(cls, rt::sel(#str_ptr("endGrouping\0"))) };
    return;
}

// ---- table -------------------------------------------------------------------
// The ledger's TableView is a STATIC form, not a data-bound sequence: its rows are
// written out, so they are already this node's children and nothing needs
// materialising. It is a scroll of what it was given.

fn create_table(n: *core::Node) -> *u8 { return create_sequence_host(false); }

// The ledger's TableView is a STATIC form: its rows are its CHILDREN, so the three
// verbs it declares are all about how those children are sized and spaced —
// which is flex's vocabulary, reached through the node the same way a tree's
// indentation is. The ledger read "a table's rows are its CHILDREN; flex
// measures them" as a reason it could not be done, when it is the mechanism.
fn apply_table(v: *u8, n: *core::Node, dirty: u64) {
    let p: *props::TableProps = props_of(n, props::K_TABLE) as *props::TableProps;
    if p == (0 as *props::TableProps) { return; }
    if (dirty & (table::P_ROW_HEIGHT | table::P_HAS_UNEVEN_ROWS)) != (0 as u64)
        || dirty == paint::all_bits() {
        apply_row_heights(n, { (*p).row_height }, { (*p).has_uneven_rows });
    }
    if (dirty & table::P_STYLE) != (0 as u64) || dirty == paint::all_bits() {
        apply_table_style(n, { (*p).style });
    }
    return;
}

// `has_uneven_rows` is what DECIDES whether `row_height` applies: a table of
// uneven rows measures each one, which for a flex child is exactly `auto`.
fn apply_row_heights(n: *core::Node, height: i64, uneven: bool) {
    var i: usize = 0 as usize;
    let count: usize = core::child_count_of(n);
    while i < count {
        match core::child_of(n, i) {
            option::Option[*core::Node]::Some(c) => {
                // Only IMPOSE. A table of uneven rows measures each one, and a
                // row the application gave a height of its own is exactly that
                // measurement — overwriting it with `auto` would be this verb
                // erasing a stronger statement than its own.
                if !uneven && height > (0 as i64) {
                    { (*c).set_height(flex::StyleLength::points(height as f64)) };
                }
            }
            option::Option[*core::Node]::None => { }
        }
        i = i +% (1 as usize);
    }
    return;
}

// `TableView.Intent` names how the form READS, and on macOS the difference
// between the four is inset grouping: a Form or a Settings table is a grouped
// list with breathing room around it, Data and Menu are flush.
fn apply_table_style(n: *core::Node, style: vocab::TableStyle) {
    let inset: f64 = match style {
        vocab::TableStyle::Form => 12.0f64,
        vocab::TableStyle::Settings => 12.0f64,
        vocab::TableStyle::Data => 0.0f64,
        vocab::TableStyle::Menu => 0.0f64,
    };
    { (*n).set_padding(flex::Edge::All, flex::StyleLength::points(inset)) };
    let gap: f64 = match style {
        vocab::TableStyle::Form => 8.0f64,
        vocab::TableStyle::Settings => 8.0f64,
        vocab::TableStyle::Data => 0.0f64,
        vocab::TableStyle::Menu => 0.0f64,
    };
    { (*n).set_gap(flex::Gutter::Row, flex::StyleLength::points(gap)) };
    return;
}

// ---- carousel ----------------------------------------------------------------
// A sequence laid along the horizontal axis. The pages are its children, like
// a table's rows; `position` is which one is showing, which on a scroll view
// is a scroll offset rather than a selection.

fn create_carousel(n: *core::Node) -> *u8 { return create_sequence_host(true); }

fn apply_carousel(v: *u8, n: *core::Node, dirty: u64) {
    let p: *props::CarouselProps = props_of(n, props::K_CAROUSEL) as *props::CarouselProps;
    if p == (0 as *props::CarouselProps) { return; }
    let anchor: vocab::ScrollAnchor = { (*p).items_view.scroll_anchor };
    if (dirty & props::C_LAYOUT) != (0 as u64) {
        restore_anchor(v, n, anchor, kept_offset(v, anchor));
    }
    // `columns` arrives from the StructuredItemsView base, which a carousel
    // shares with a collection — so the verb exists here whether or not a
    // carousel is the natural place for it, and a declared verb that nothing
    // reads is the debt `verb_coverage` exists to catch. Same arrangement: N
    // items across a line, then wrap.
    if (dirty & carousel::P_COLUMNS) != (0 as u64) {
        arrange_columns(n, { (*p).structured_items_view.columns });
    }
    // `Loop` — a position that runs off either end comes back at the other.
    // The ledger said "an infinite carousel needs the touch paging it wraps",
    // which is true of the GESTURE half and was standing in for the whole verb:
    // what `wraps` means to a program is that the index arithmetic is circular,
    // and that is the half an application and an agent both use.
    if (dirty & carousel::P_POSITION) != (0 as u64) {
        // Scroll the page at `position` to the leading edge. Its frame is
        // flex's, so this needs no measurement of its own. `animates_scroll`
        // decides whether the move is a jump or a slide — AppKit animates a
        // scroll through the animator proxy, the same as a progress bar.
        scroll_child(v, n, wrapped(n, { (*p).position }, { (*p).wraps }),
                     { (*p).animates_scroll });
    }
    let iv: *props::ItemsViewProps = { #addr_of((*p).items_view) };
    if (dirty & carousel::P_BOUNCES) != (0 as u64) || dirty == paint::all_bits() {
        // Rubber-band overscroll IS per scroll view on AppKit — `elasticity` —
        // which is what `IsBounceEnabled` means. Automatic is the platform's
        // own answer and None is the switch turned off.
        let sv: ak::ScrollView = ak::ScrollView::from_raw(v);
        var e: ak::ScrollElasticity = ak::ScrollElasticity::None;
        if { (*p).bounces } { e = ak::ScrollElasticity::Automatic; }
        sv.set_horizontal_scroll_elasticity(e);
        sv.set_vertical_scroll_elasticity(e);
    }
    // `IsSwipeEnabled` is not about the gesture but about WHO may move the
    // page. macOS's answer is the same one: the wheel does nothing, and
    // `position` still works.
    if (dirty & carousel::P_IS_SWIPEABLE) != (0 as u64) || dirty == paint::all_bits() {
        compose::apply_scroll_lock(v, { (*p).is_swipeable } == false);
    }
    if (dirty & carousel::P_PEEK_INSETS) != (0 as u64) || dirty == paint::all_bits() {
        // Peeking the neighbouring page is an INSET on the content: the page
        // is narrower than the viewport by the peek, so its neighbours show at
        // the edges. AppKit spells that `contentInsets`.
        let i: vocab::Insets = { (*p).peek_insets };
        ak::ScrollView::from_raw(v).set_content_insets(
            ak::EdgeInsets { top: { i.top }, left: { i.leading },
                             bottom: { i.bottom }, right: { i.trailing } });
    }
    if (dirty & carousel::P_ITEM_SIZING) != (0 as u64) || dirty == paint::all_bits() {
        apply_item_sizing(n, { (*p).structured_items_view.item_sizing });
    }
    if (dirty & (carousel::P_VERTICAL_SCROLL_BARS | carousel::P_HORIZONTAL_SCROLL_BARS)) != (0 as u64) {
        apply_sequence_scrollers(v, { (*iv).vertical_scroll_bars }, { (*iv).horizontal_scroll_bars });
    }
    if (dirty & carousel::P_SCROLL_TO) != (0 as u64) {
        scroll_child(v, n, wrapped(n, { (*iv).scroll_to_index }, { (*p).wraps }),
                     { (*p).animates_scroll });
    }
    return;
}

// An index into a carousel that loops. Without `wraps` an out-of-range index is
// a mistake and stays one — `scroll_child` declines it — because pretending it
// meant the last page would hide the mistake. With `wraps` it is not a mistake
// at all: page `count` IS page 0, which is what a loop says.
fn wrapped(n: *core::Node, at: i64, wraps: bool) -> i64 {
    if !wraps { return at; }
    let count: i64 = core::child_count_of(n) as i64;
    if count <= (0 as i64) { return at; }
    var i: i64 = at % count;
    if i < (0 as i64) { i = i +% count; }
    return i;
}

// ---- tree --------------------------------------------------------------------
// A hierarchy rather than a sequence, and the one place the model is facet's
// own: `TreeProps.root` is a TreeNode graph with stable ids, and `expanded`
// says which of them are open.
//
// Materialised the same way, walked depth-first, and only through OPEN nodes —
// a closed branch contributes nothing, which is what makes a deep tree cheap
// even under the build-everything rule above. Depth becomes leading padding on
// the row, because indentation IS layout and layout is flex's.

fn create_tree(n: *core::Node) -> *u8 { return create_sequence_host(false); }

fn indent_step() -> f64 { return 16.0f64; }

fn materialise_tree(n: *core::Node) {
    let p: *tree::TreeProps = props_of(n, tree::K_TREE) as *tree::TreeProps;
    if p == (0 as *tree::TreeProps) { return; }
    clear_rows(n);
    let root: *tree::TreeNode = { #addr_of((*p).root) };
    // The root itself is the container, not a row: a tree shows its CHILDREN.
    emit_branch(n, root, p, 0 as i64, true);
    return;
}

// `parent_open` is what stops a closed branch costing anything: the walk does
// not descend through it at all.
fn emit_branch(host: *core::Node, node: *tree::TreeNode, p: *tree::TreeProps,
               depth: i64, is_root: bool) {
    if !is_root {
        var row: core::Node = build_tree_row(node, p);
        // Indentation IS layout, so it is flex's — a leading pad, not a
        // backend-drawn gutter.
        row.set_padding(flex::Edge::Left, flex::StyleLength::points((depth as f64) * indent_step()));
        add_row(host, row);
        if !is_expanded(p, node) { return; }
    }
    var i: usize = 0 as usize;
    let count: usize = { (*node).child_count() };
    while i < count {
        match { (*node).child_ptr(i) } {
            option::Option[*tree::TreeNode]::Some(c) => {
                var next: i64 = depth;
                if !is_root { next = depth +% (1 as i64); }
                emit_branch(host, c, p, next, false);
            }
            option::Option[*tree::TreeNode]::None => { }
        }
        i = i +% (1 as usize);
    }
    return;
}

fn is_expanded(p: *tree::TreeProps, node: *tree::TreeNode) -> bool {
    let id: str = { (*node).id.view() };
    if id == "" { return false; }
    let ex: *vocab::TextList = { #addr_of((*p).expanded) };
    var i: usize = 0 as usize;
    let n: usize = { (*ex).count() };
    while i < n {
        if { (*ex).at(i) } == id { return true; }
        i = i +% (1 as usize);
    }
    return false;
}

// The application's row builder, or a plain label of the node's own text when
// it gave none — a tree with no builder still shows its shape.
fn build_tree_row(node: *tree::TreeNode, p: *tree::TreeProps) -> core::Node {
    let f: fn(*tree::TreeNode, *u8) -> flex::Node = { (*p).row };
    // Compared against `no_row`, NOT against null. The default is a real
    // function that answers an empty node, so a null check is never false and
    // the fallback below never ran — a tree with no row builder rendered a
    // column of empty rows and the line that says otherwise was decoration.
    if f != tree::no_row { return f(node, { (*p).row_ctx }); }
    return plain_tree_row(node);
}

// A tree with no row builder still shows its shape: the node's own text, keyed
// by its identity. Shared with the recycling outline view, which asks the same
// question and must not answer it differently.
// One line of text, plus room to breathe.
//
// STATED, not left to the label's intrinsic size. An outline view asks for a
// row's height before that row has been realised, and a label's intrinsic
// height comes from the measure callback the backend installs when it creates
// the native view — so an unrealised label measures at zero, clamps to one
// point, and the whole tree renders as invisible one-pixel rows.
const DEFAULT_TREE_ROW_H: f64 = 20.0f64;

fn plain_tree_row(node: *tree::TreeNode) -> core::Node {
    return label::label({ (*node).label.view() }, key: { (*node).id.view() })
        .height(DEFAULT_TREE_ROW_H);
}

fn apply_tree(v: *u8, n: *core::Node, dirty: u64) {
    // Expansion changes WHICH rows exist, so it rebuilds like the model does.
    if (dirty & (tree::P_ROOT | tree::P_ROW | tree::P_EXPANDED)) != (0 as u64) {
        materialise_tree(n);
    }
    return;
}

// ---- window_buttons ----------------------------------------------------------
// The close / minimise / zoom group, re-parented into the application's own
// titlebar. The REAL buttons, not a drawing of them — so the green button
// keeps its hover menu and its full-screen behaviour, which a redrawn set
// would silently lose.
//
// They can only be fetched once the view is in a window, and a view is not in
// one when `create` runs. So the adoption happens in `apply`, which the sync
// tick calls after the window is up; until then the node is an empty box of
// the right size, which is what it should be.

fn create_window_buttons(n: *core::Node) -> *u8 {
    // `CplusExtWindowButtonsView` — the view answers for itself.
    //
    // Adoption and placement are driven by AppKit's own callbacks rather than
    // by facet's passes: `viewDidMoveToWindow` fires exactly when there IS a
    // window, so nothing has to guess or be guarded, and `setFrameSize:`
    // re-lays on every host resize, so pass ordering stops mattering entirely.
    // It re-attaches on the full-screen and live-resize notifications too,
    // because AppKit reclaims those buttons.
    //
    // The re-parent inside is CONDITIONAL — a button moves only if its
    // superview is not already this view — and that is what makes the whole
    // thing re-runnable. The version this replaces re-parented unconditionally,
    // so it needed a once-only flag, and that flag turned a missed first
    // attempt into a permanent failure: at `apply` the view is not in a window
    // yet, so the single attempt it got always failed.
    //
    // It was never deleted, only stopped being used (appkit_ext.cplus:1747).
    return rt::retain(akx::new_window_buttons_view().raw());
}

fn apply_window_buttons(v: *u8, n: *core::Node, dirty: u64) {
    // `style` is not WHICH buttons — every platform ships the set it ships —
    // it is WHEN they are drawn, and a tracking area answers that. The buttons
    // themselves need nothing here: the view adopts and places them off
    // AppKit's callbacks.
    let p: *chrome::WindowButtonsProps =
        props_of(n, chrome::K_WINDOW_BUTTONS) as *chrome::WindowButtonsProps;
    if p == (0 as *chrome::WindowButtonsProps) { return; }
    if (dirty & chrome::P_STYLE) != (0 as u64) || dirty == paint::all_bits() {
        let on_hover: bool = match { (*p).style } {
            chrome::ButtonStyle::OnHover => true,
            chrome::ButtonStyle::Native => false,
        };
        compose::apply_hover_reveal(v, on_hover);
    }
    return;
}

// ---- canvas ------------------------------------------------------------------
// The one control that DRAWS rather than configures a system control, so the
// one control with a view class of its own: `drawing::canvas_view_class`, an
// NSView whose `drawRect:` runs the recording facet holds.
//
// The whole body is three lines because the work is split where it belongs.
// The application records into a `vocab::Canvas`; drawing.cplus replays that
// recording into the CGContext AppKit hands `drawRect:`. Nothing about a
// drawing passes through this file.
//
// No layer, deliberately. `drawRect:` on a non-layer-backed view draws
// straight into the window's backing store, and a layer would be a second
// buffer holding a copy of the same pixels. A canvas that also sets a
// background_color gets a layer from `apply_common`, which is fine — AppKit
// draws through it either way.

fn create_canvas(n: *core::Node) -> *u8 {
    let v: ak::View = drawing::new_canvas_view();
    drawing::bind_node(v.raw(), n);
    return rt::retain(v.raw());
}

fn apply_canvas(v: *u8, n: *core::Node, dirty: u64) {
    let p: *props::CanvasProps = props_of(n, props::K_CANVAS) as *props::CanvasProps;
    if p == (0 as *props::CanvasProps) { return; }
    // A new Drawable, an explicit `redraw()`, or a new size: the drawing is
    // a function of the laid-out box, so a resize is a repaint.
    let watched: u64 = canvas::P_DRAWABLE | canvas::P_REDRAW | props::C_LAYOUT;
    if (dirty & watched) != (0 as u64) || dirty == paint::all_bits() {
        drawing::invalidate(v);
    }
    return;
}

// ---- menu, menu_item, toolbar_item -------------------------------------------
// The rest of the menu tier, and like `context_menu` none of them is a view:
// an NSMenu, an NSMenuItem and an NSToolbarItem are all objects a WINDOW or
// the APPLICATION owns, not things that occupy a rectangle in a tree.
//
// So all three answer `wants_view` false, and what they describe is built from
// the nodes by whoever owns the host:
//
//   `menu` + `menu_item`  a menu-bar submenu, built by `build_menu` below and
//                         installed on NSApplication by the window tier.
//   `toolbar_item`        an NSToolbarItem, built by `build_toolbar_item` and
//                         installed on the window's NSToolbar.
//
// The BUILDERS are here, complete, because that is this module's job — turning
// a facet node into an AppKit object. The INSTALLERS belong to the window tier
// (stages/4.md item 5, the app menu and NSToolbar), which is where the thing
// that owns them lives. Splitting it that way is why `context_menu` needed no
// installer at all: an NSView owns its own menu, so the node's parent was the
// owner and it was already in hand.

fn menu_bar_kind(kind: u32) -> bool {
    return kind == props::K_MENU || kind == props::K_MENU_ITEM
        || kind == props::K_TOOLBAR_ITEM;
}

// The NSMenu a `menu` node describes, titled and filled from its
// `menu_item` children. At +1.
fn build_menu(n: *core::Node) -> *u8 {
    if core::kind_of(n) != props::K_MENU { return 0 as *u8; }
    let p: *props::MenuProps = props_of(n, props::K_MENU) as *props::MenuProps;
    var title: str = "";
    if p != (0 as *props::MenuProps) { title = { (*p).text.view() }; }
    let menu: ak::Menu = ak::Menu::new(title);
    var i: usize = 0 as usize;
    let count: usize = core::child_count_of(n);
    while i < count {
        match core::child_of(n, i) {
            option::Option[*core::Node]::Some(c) => {
                let item: *u8 = build_menu_item(c);
                if item != (0 as *u8) { menu.add_item(ak::MenuItem::from_raw(item)); }
            }
            option::Option[*core::Node]::None => { }
        }
        i = i +% (1 as usize);
    }
    return rt::retain(menu.raw());
}

// One NSMenuItem from a `menu_item` node, or 0 for a node that is not one.
// Shares every rule with a context menu's items — a titleless item is a
// separator, the handler rides the same target trampoline — because they are
// the same object and a second set of rules would be two answers to one
// question.
fn build_menu_item(c: *core::Node) -> *u8 {
    let mi: *props::MenuItemProps = props_of(c, props::K_MENU_ITEM) as *props::MenuItemProps;
    if mi == (0 as *props::MenuItemProps) { return 0 as *u8; }
    let title: str = { (*mi).text.view() };
    if title == "" { return rt::retain(ak::MenuItem::separator_item().raw()); }
    let item: ak::MenuItem = ak::MenuItem::new(title, 0 as *u8, "");
    mark_destructive(item, title, { (*mi).is_destructive });
    let icon: str = { (*mi).icon.view() };
    if icon != "" {
        match resolve_image(icon) {
            option::Option[ak::Image]::Some(img) => { item.set_image(img); }
            option::Option[ak::Image]::None => { }
        }
    }
    let h: fn(*u8, *u8) = { (*mi).on_clicked };
    if h != props::no_handler {
        item.set_target(akx::action_ctx_target(h, { (*mi).on_clicked_ctx }));
        item.set_action(akx::action_ctx_sel());
    }
    item.set_enabled(core::is_enabled(c));
    return rt::retain(item.raw());
}

// One NSToolbarItem from a `toolbar_item` node. Its identifier is the node's
// KEY — NSToolbar addresses its items by identifier, facet addresses nodes by
// key, and they are the same need answered once.
fn build_toolbar_item(c: *core::Node) -> *u8 {
    let p: *props::ToolbarItemProps = props_of(c, props::K_TOOLBAR_ITEM) as *props::ToolbarItemProps;
    if p == (0 as *props::ToolbarItemProps) { return 0 as *u8; }
    let mi: *props::MenuItemProps = { #addr_of((*p).menu_item) };
    var ident: str = { (*c).key() };
    if ident == "" { ident = { (*mi).text.view() }; }
    let alloced: *u8 = { rt::msg_id(rt::get_class(#str_ptr("NSToolbarItem\0")), rt::sel(#str_ptr("alloc\0"))) };
    let item: *u8 = { rt::msg_id_id(alloced, rt::sel(#str_ptr("initWithItemIdentifier:\0")),
                                    bridge::nsstring(ident)) };
    if item == (0 as *u8) { return 0 as *u8; }
    { rt::msg_void_id(item, rt::sel(#str_ptr("setLabel:\0")), bridge::nsstring({ (*mi).text.view() })) };
    let icon: str = { (*mi).icon.view() };
    if icon != "" {
        match resolve_image(icon) {
            option::Option[ak::Image]::Some(img) => {
                { rt::msg_void_id(item, rt::sel(#str_ptr("setImage:\0")), img.raw()) };
            }
            option::Option[ak::Image]::None => { }
        }
    }
    let h: fn(*u8, *u8) = { (*mi).on_clicked };
    if h != props::no_handler {
        { rt::msg_void_id(item, rt::sel(#str_ptr("setTarget:\0")),
                          akx::action_ctx_target(h, { (*mi).on_clicked_ctx })) };
        { rt::msg_void_id(item, rt::sel(#str_ptr("setAction:\0")), akx::action_ctx_sel()) };
    }
    // `is_destructive`. "NSToolbarItem has no destructive style" is true of the
    // item and not of the toolbar: an item may carry a VIEW of its own, which
    // is how every app with a styled toolbar button has one. So a destructive
    // item is a button with the same red title `mark_destructive` gives a menu
    // row — one word, one colour, wherever the word appears.
    if { (*mi).is_destructive } {
        let b: ak::Button = ak::Button::from_raw(rt::alloc_init(#str_ptr("NSButton\0")));
        b.set_button_type(ak::ButtonType::MomentaryPushIn);
        b.set_bezel_style(ak::BezelStyle::TexturedRounded);
        let a: *u8 = paint::attributed({ (*mi).text.view() },
            paint::rich_attributes(option::Option[ak::Font]::None,
                                   vocab::Color::rgba(0.8f64, 0.1f64, 0.1f64), 0.0f64, 0.0f64,
                                   option::Option[vocab::TextAlign]::None,
                                   vocab::TextDecoration::None));
        if a != (0 as *u8) {
            { rt::msg_void_id(b.raw(), rt::sel(#str_ptr("setAttributedTitle:\0")), a) };
            rt::release(a);
        }
        if h != props::no_handler {
            akx::set_control_action_ctx(b.as_control(), h, { (*mi).on_clicked_ctx });
        }
        { rt::msg_void_id(item, rt::sel(#str_ptr("setView:\0")), b.as_view().raw()) };
    }
    // WHERE it sits and WHETHER it survives a narrow window are two different
    // questions, and NSToolbar answers them in two places — so they are not
    // both folded onto `visibilityPriority`:
    //
    //   placement   which GROUP it is ordered into, and how readily it
    //               collapses into the overflow menu. Secondary is the one
    //               that gives way first, which is what "secondary" means on a
    //               bar that has one row.
    //   priority    the order WITHIN the group. The ledger's rule: lower first.
    //
    // The ordering half is `window::collect_toolbar_items`, which is the only
    // place that can see all the items at once.
    { rt::msg_void_i64(item, rt::sel(#str_ptr("setVisibilityPriority:\0")),
                       visibility_priority({ (*p).placement })) };
    return item;
}

// NSToolbarItemVisibilityPriority{Low,Standard,High}.
fn visibility_priority(pl: vocab::ToolbarPlacement) -> i64 {
    return match pl {
        vocab::ToolbarPlacement::Default => 0 as i64,
        vocab::ToolbarPlacement::Primary => 1000 as i64,
        vocab::ToolbarPlacement::Secondary => -1000 as i64,
    };
}

// Primary, then Default, then Secondary. The rank an item is SORTED by; the
// number above is the one AppKit reads when the bar runs out of room.
fn placement_rank(pl: vocab::ToolbarPlacement) -> i64 {
    return match pl {
        vocab::ToolbarPlacement::Primary => 0 as i64,
        vocab::ToolbarPlacement::Default => 1 as i64,
        vocab::ToolbarPlacement::Secondary => 2 as i64,
    };
}

// The sort key for one `toolbar_item` node: its placement group, then the ledger's
// own Priority within it. Returns a rank a caller can compare directly.
fn toolbar_order_of(c: *core::Node) -> i64 {
    let p: *props::ToolbarItemProps = props_of(c, props::K_TOOLBAR_ITEM) as *props::ToolbarItemProps;
    if p == (0 as *props::ToolbarItemProps) { return 1 as i64; }
    return placement_rank({ (*p).placement });
}

fn toolbar_priority_of(c: *core::Node) -> i64 {
    let p: *props::ToolbarItemProps = props_of(c, props::K_TOOLBAR_ITEM) as *props::ToolbarItemProps;
    if p == (0 as *props::ToolbarItemProps) { return 0 as i64; }
    return { (*p).priority };
}
