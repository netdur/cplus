// facet_appkit controls — the per-kind bodies.
//
// Stage 2's rule: facet never grows a verb table. A setter writes one field
// and sets one bit; the per-kind work lives here, dispatching on `Data.kind`,
// and facet never sees it. So this is where the 42 controls become AppKit.
//
// Each kind is a pair:
//   create_<kind>  build the view and configure it WHOLE (create passes
//                  all-ones as the dirty word, so one body serves both).
//   apply_<kind>   re-read only what the bits name.
// They are the same function. A kind whose create and apply disagree is how a
// control ends up correct on mount and wrong on the first update, so there is
// one body and `dirty` is the only difference.
//
// The dirty-bit constants belong to the generated control modules, which is
// why each is imported: `label::P_TEXT` is not the same bit as
// `text_field::P_TEXT`, and the MAP is the authority for both.
//
// STATUS: 30 of 42 — label, button, text_field, image, scroll, box, checkbox,
// radio, toggle, slider, progress, spinner, stepper, icon_button, symbol,
// text_area, search_field, popup, bordered, split, page_dots, date_picker,
// time_picker, tabs, context_menu, context_menu_item, span, and the three
// decided-absent (refreshable, swipeable, swipe_item), plus
// the container backing. Until a kind lands, `views::create` says
// so on stderr rather than rendering a silent blank rectangle.

import "stdlib/option" as option;
import "stdlib/text" as text;
import "stdlib/vec" as vec;
import "stdlib/status" as status;
import "flex_layout/flex_layout" as flex;
import "facet/facet" as core;
import "facet/props" as props;
import "facet/vocabulary" as vocab;
import "facet/application" as app;
import "facet/label" as label;
import "facet/button" as button;
import "facet/text_field" as text_field;
import "facet/image" as image;
import "facet/scroll" as scroll;
import "facet/box" as box_view;
import "facet/checkbox" as checkbox;
import "facet/radio" as radio;
import "facet/toggle" as toggle;
import "facet/slider" as slider;
import "facet/progress" as progress;
import "facet/spinner" as spinner;
import "facet/stepper" as stepper;
import "facet/icon_button" as icon_button;
import "facet/symbol" as symbol;
import "facet/text_area" as text_area;
import "facet/search_field" as search_field;
import "facet/popup" as popup;
import "facet/bordered" as bordered;
import "facet/split" as split;
import "facet/page_dots" as page_dots;
import "facet/date_picker" as date_picker;
import "facet/time_picker" as time_picker;
import "facet/tabs" as tabs;
import "facet/span" as span;
import "facet/list" as list;
import "facet/collection" as collection;
import "facet/carousel" as carousel;
import "facet/tree" as tree;
import "facet/mount" as mount;
import "facet/window_chrome" as chrome;
import "facet/canvas" as canvas;
import "objc/runtime" as rt;
import "objc/bridge" as bridge;
import "objc/synthesis" as synth;
import "appkit/appkit" as ak;
import "appkit/appkit_ext" as akx;
import "quartzcore/quartzcore" as quartz;
import "./paint" as paint;
import "./text_input" as text_input;
import "./drawing" as drawing;

// ---- reaching a node's props -------------------------------------------------
// The generated cursors' `_props()` is module-private, so a backend reads the
// pointer off Data itself — checking `kind` first, exactly as those cursors do.
// A null answer means the node is not what the dispatch thought it was, and
// every body treats that as "do nothing" rather than trusting the cast.

fn props_of(n: *core::Node, kind: u32) -> *u8 {
    let d: *core::Data = core::node_data(n);
    if d == (0 as *core::Data) { return 0 as *u8; }
    if { (*d).kind } != kind { return 0 as *u8; }
    return { (*d).props };
}

// ---- label -------------------------------------------------------------------
// NSTextField in its label posture: not editable, not bezeled, no background.
// AppKit has no separate label class, and `labelWithString:` is the factory
// that sets that posture in one call.

fn create_label(n: *core::Node) -> *u8 {
    let f: ak::TextField = ak::TextField::label_with_string("");
    return rt::retain(f.as_view().raw());
}

fn apply_label(v: *u8, n: *core::Node, dirty: u64) {
    let p: *props::LabelProps = props_of(n, props::K_LABEL) as *props::LabelProps;
    if p == (0 as *props::LabelProps) { return; }
    let f: ak::TextField = ak::TextField::from_raw(v);
    // The text and the transform that displays it are one write: a transform
    // change with unchanged text still has to re-render the string.
    //
    // A label with SPAN children renders those instead: a formatted label's
    // text IS its runs, so its own `text` would be a second, contradictory
    // answer to the same question.
    let rich: u64 = label::P_TEXT | label::P_TEXT_TRANSFORM | label::P_CHARACTER_SPACING
        | label::P_LINE_HEIGHT | label::P_TEXT_DECORATION | label::P_IS_ITALIC
        | label::P_FONT_SIZE | label::P_FONT_WEIGHT | label::P_FONT_FAMILY
        | label::P_TEXT_COLOR | label::P_TEXT_ALIGN | label::P_TEXT_FORMAT
        | label::P_FORMATTED_TEXT;
    if (dirty & rich) != (0 as u64) {
        if has_spans(n) {
            let runs: *u8 = build_runs(n);
            if runs != (0 as *u8) {
                { rt::msg_void_id(v, rt::sel(#str_ptr("setAttributedStringValue:\0")), runs) };
                { rt::release(runs) };
            }
        } else if is_html(p) {
            // `TextType.Html` means the string IS markup. NSAttributedString
            // parses it, which is the whole feature — a backend that stripped
            // the tags would be answering a different question.
            let a: *u8 = html_string({ (*p).text.view() });
            if a != (0 as *u8) {
                { rt::msg_void_id(v, rt::sel(#str_ptr("setAttributedStringValue:\0")), a) };
                { rt::release(a) };
            }
        } else if formatted_count(p) > (0 as usize) {
            // `formatted_text` is the VALUE-carried run list, the second way a
            // label can describe runs. Child spans win when both are present:
            // a tree is more specific than a value on the node.
            let runs: *u8 = build_value_runs(p);
            if runs != (0 as *u8) {
                { rt::msg_void_id(v, rt::sel(#str_ptr("setAttributedStringValue:\0")), runs) };
                { rt::release(runs) };
            }
        } else if label_wants_rich(p) {
            // kern, line height and decoration have no plain-string form, so a
            // label that asks for one is written attributed. One that does not
            // keeps the plain path — see paint::wants_rich.
            let shown: text::Text = paint::transformed({ (*p).text.view() }, { (*p).text_transform });
            let a: *u8 = paint::attributed(shown.view(), label_attributes(p));
            if a != (0 as *u8) {
                { rt::msg_void_id(v, rt::sel(#str_ptr("setAttributedStringValue:\0")), a) };
                { rt::release(a) };
            }
        } else {
            f.as_control().set_string_value(paint::transformed({ (*p).text.view() }, { (*p).text_transform }).view());
        }
    }
    if (dirty & label::P_TEXT_COLOR) != (0 as u64) {
        let c: vocab::Color = { (*p).text_color };
        if c.is_set() { f.set_text_color(paint::ns_color(c)); }
    }
    if (dirty & (label::P_FONT_SIZE | label::P_FONT_WEIGHT | label::P_FONT_FAMILY | label::P_IS_ITALIC)) != (0 as u64) {
        match paint::ns_font_styled({ (*p).font_size }, { (*p).font_weight },
                                    { (*p).font_family.view() }, { (*p).is_italic }) {
            option::Option[ak::Font]::Some(font) => { f.as_control().set_font(font); }
            option::Option[ak::Font]::None => { }
        }
    }
    if (dirty & label::P_TEXT_ALIGN) != (0 as u64) {
        f.as_control().set_alignment(paint::ns_text_align({ (*p).text_align }));
    }
    if (dirty & (label::P_MAX_LINES | label::P_LINE_BREAK)) != (0 as u64) {
        let lines: i64 = { (*p).max_lines };
        // 0 = unbounded, which is NSTextField's own spelling too.
        if lines > (0 as i64) { f.set_maximum_number_of_lines(lines); }
        match f.as_control().cell() {
            option::Option[ak::Cell]::Some(c) => {
                c.set_uses_single_line_mode(lines == (1 as i64));
                c.set_line_break_mode(paint::ns_line_break({ (*p).line_break }));
            }
            option::Option[ak::Cell]::None => { }
        }
    }
    return;
}

// ---- button ------------------------------------------------------------------

fn create_button(n: *core::Node) -> *u8 {
    let b: ak::Button = ak::Button::from_raw(rt::alloc_init(#str_ptr("NSButton\0")));
    b.set_button_type(ak::ButtonType::MomentaryPushIn);
    b.set_bezel_style(ak::BezelStyle::Rounded);
    return rt::retain(b.as_view().raw());
}

fn apply_button(v: *u8, n: *core::Node, dirty: u64) {
    let p: *props::ButtonProps = props_of(n, props::K_BUTTON) as *props::ButtonProps;
    if p == (0 as *props::ButtonProps) { return; }
    let b: ak::Button = ak::Button::from_raw(v);
    // The title band. `character_spacing` and `is_italic` have no plain-title
    // form, so a button that asks for either — or for a text colour, which
    // NSButton also has no plain setter for — is given an attributed title.
    let title_bits: u64 = button::P_TITLE | button::P_TEXT_TRANSFORM
        | button::P_CHARACTER_SPACING | button::P_TEXT_COLOR | button::P_IS_ITALIC
        | button::P_FONT_SIZE | button::P_FONT_WEIGHT | button::P_FONT_FAMILY;
    if (dirty & title_bits) != (0 as u64) {
        let shown: text::Text = paint::transformed({ (*p).title.view() }, { (*p).text_transform });
        if button_wants_rich(p) {
            let a: *u8 = paint::attributed(shown.view(), button_attributes(p));
            if a != (0 as *u8) {
                { rt::msg_void_id(v, rt::sel(#str_ptr("setAttributedTitle:\0")), a) };
                { rt::release(a) };
            }
        } else {
            b.set_title(shown.view());
        }
    }
    if (dirty & (button::P_FONT_SIZE | button::P_FONT_WEIGHT | button::P_FONT_FAMILY | button::P_IS_ITALIC)) != (0 as u64) {
        match paint::ns_font_styled({ (*p).font_size }, { (*p).font_weight },
                                    { (*p).font_family.view() }, { (*p).is_italic }) {
            option::Option[ak::Font]::Some(font) => { b.as_control().set_font(font); }
            option::Option[ak::Font]::None => { }
        }
    }
    if (dirty & button::P_IMAGE) != (0 as u64) {
        apply_control_image(b, { (*p).image.view() });
    }
    if (dirty & (button::P_CONTENT_LAYOUT | button::P_IMAGE)) != (0 as u64) {
        b.set_image_position(ns_image_position({ (*p).content_layout }));
    }
    if (dirty & button::P_LINE_BREAK) != (0 as u64) {
        match b.as_control().cell() {
            option::Option[ak::Cell]::Some(c) => { c.set_line_break_mode(paint::ns_line_break({ (*p).line_break })); }
            option::Option[ak::Cell]::None => { }
        }
    }
    if (dirty & (button::P_BORDER_COLOR | button::P_BORDER_WIDTH | button::P_CORNER_RADIUS)) != (0 as u64) {
        apply_border(v, { (*p).border_color }, { (*p).border_width }, { (*p).corner_radius },
                     (dirty & (button::P_BORDER_COLOR | button::P_BORDER_WIDTH)) != (0 as u64),
                     (dirty & button::P_CORNER_RADIUS) != (0 as u64));
    }
    // A button's action fires from the keyboard when focused and from
    // VoiceOver too — which is exactly why it is the control's own verb and
    // not a gesture (gestures see the pointer and nothing else).
    if (dirty & props::C_HANDLERS) != (0 as u64) || dirty == paint::all_bits() {
        akx::set_control_action_ctx(b.as_control(), { (*p).on_click }, { (*p).on_click_ctx });
    }
    // The shared band owns enabled; a control reads it through its own setter
    // because NSControl's enabled is not the view's.
    if (dirty & props::C_IS_ENABLED) != (0 as u64) || dirty == paint::all_bits() {
        b.as_control().set_enabled(core::is_enabled(n));
    }
    return;
}

fn button_wants_rich(p: *props::ButtonProps) -> bool {
    // A text colour joins the rich set here and nowhere else: NSButton draws
    // its title from the cell and has no `setTitleColor:`.
    if { (*p).text_color }.is_set() { return true; }
    return paint::wants_rich({ (*p).character_spacing }, 0.0f64, vocab::TextDecoration::None);
}

fn button_attributes(p: *props::ButtonProps) -> *u8 {
    return paint::rich_attributes(
        paint::ns_font_styled({ (*p).font_size }, { (*p).font_weight },
                              { (*p).font_family.view() }, { (*p).is_italic }),
        { (*p).text_color }, { (*p).character_spacing }, 0.0f64,
        option::Option[vocab::TextAlign]::None, vocab::TextDecoration::None);
}

// facet's ContentLayout names where the IMAGE goes; NSCellImagePosition is the
// same idea with AppKit's spelling.
fn ns_image_position(l: vocab::ContentLayout) -> ak::CellImagePosition {
    return match l {
        vocab::ContentLayout::ImageLeft => ak::CellImagePosition::NSImageLeft,
        vocab::ContentLayout::ImageRight => ak::CellImagePosition::NSImageRight,
        vocab::ContentLayout::ImageTop => ak::CellImagePosition::NSImageAbove,
        vocab::ContentLayout::ImageBottom => ak::CellImagePosition::NSImageBelow,
    };
}

// The same three-step resolution `image` uses — a system symbol, then a bundle
// name, then a path — so a button's image and an image's source name the same
// things.
fn apply_control_image(b: ak::Button, src: str) {
    if src == "" { b.set_image(ak::Image::from_raw(0 as *u8)); return; }
    match resolve_image(src) {
        option::Option[ak::Image]::Some(img) => { b.set_image(img); }
        option::Option[ak::Image]::None => { b.set_image(ak::Image::from_raw(0 as *u8)); }
    }
    return;
}

// ---- text_field --------------------------------------------------------------
// The editable NSTextField. `is_secure` picks NSSecureTextField instead, which
// is a different class — so it is read at CREATE and a live flip is not
// honoured (an application that needs both builds two fields and shows one).

fn create_text_field(n: *core::Node) -> *u8 {
    let p: *props::TextFieldProps = props_of(n, props::K_TEXT_FIELD) as *props::TextFieldProps;
    var secure: bool = false;
    if p != (0 as *props::TextFieldProps) { secure = { (*p).is_secure }; }
    var f: ak::TextField = ak::TextField::from_raw(rt::alloc_init(#str_ptr("NSTextField\0")));
    if secure { f = ak::TextField::from_raw(rt::alloc_init(#str_ptr("NSSecureTextField\0"))); }
    f.set_editable(true);
    f.set_selectable(true);
    f.set_bezeled(true);
    // What the user types has to reach the props, or `text()` answers with
    // whatever was last SET and the edit is lost silently. See text_input.
    text_input::install(f.as_view().raw(), f.as_view().raw(), n);
    return rt::retain(f.as_view().raw());
}

fn apply_text_field(v: *u8, n: *core::Node, dirty: u64) {
    let p: *props::TextFieldProps = props_of(n, props::K_TEXT_FIELD) as *props::TextFieldProps;
    if p == (0 as *props::TextFieldProps) { return; }
    let f: ak::TextField = ak::TextField::from_raw(v);
    let iv: *props::InputViewProps = { #addr_of((*p).input_view) };
    // The whole InputView band is one body in text_input, shared with the
    // editor and the search field, because all three embed the same props.
    text_input::apply_field_band(f, n, iv, { (*p).text_align }, dirty,
                                 text_input::bits_of(props::K_TEXT_FIELD));
    if (dirty & props::C_IS_ENABLED) != (0 as u64) || dirty == paint::all_bits() {
        f.as_control().set_enabled(core::is_enabled(n));
    }
    return;
}

// ---- image -------------------------------------------------------------------

fn create_image(n: *core::Node) -> *u8 {
    let iv: ak::ImageView = ak::ImageView::from_raw(rt::alloc_init(#str_ptr("NSImageView\0")));
    return rt::retain(iv.as_view().raw());
}

fn apply_image(v: *u8, n: *core::Node, dirty: u64) {
    let p: *props::ImageProps = props_of(n, props::K_IMAGE) as *props::ImageProps;
    if p == (0 as *props::ImageProps) { return; }
    let iv: ak::ImageView = ak::ImageView::from_raw(v);
    if (dirty & image::P_SOURCE) != (0 as u64) {
        let src: str = { (*p).source.view() };
        if src == "" {
            iv.set_image(ak::Image::from_raw(0 as *u8));
        } else {
            // A named system symbol first, then a file path: an application
            // says `source: "gear"` far more often than it ships a bitmap, and
            // a path that is not a file would silently show nothing.
            match ak::Image::image_with_system_symbol_name(src, "") {
                option::Option[ak::Image]::Some(img) => { iv.set_image(img); }
                option::Option[ak::Image]::None => {
                    // Then a bundle-named image, then a path on disk. A name
                    // that resolves to none of the three leaves the view empty
                    // rather than substituting something the app did not ask
                    // for.
                    match ak::Image::image_named(src) {
                        option::Option[ak::Image]::Some(named) => { iv.set_image(named); }
                        option::Option[ak::Image]::None => {
                            iv.set_image(ak::Image::new_with_contents_of_file(src));
                        }
                    }
                }
            }
        }
    }
    if (dirty & image::P_FIT) != (0 as u64) {
        iv.set_image_scaling(ns_image_scaling({ (*p).fit }));
    }
    return;
}

// facet's ImageFit is MAUI's Aspect. AppKit's scaling enum is the nearest
// thing; `Center` is the one that means "do not scale at all".
fn ns_image_scaling(f: vocab::ImageFit) -> ak::ImageScaling {
    return match f {
        vocab::ImageFit::AspectFill => ak::ImageScaling::NSImageScaleProportionallyUpOrDown,
        vocab::ImageFit::AspectFit => ak::ImageScaling::NSImageScaleProportionallyDown,
        vocab::ImageFit::Center => ak::ImageScaling::NSImageScaleNone,
        vocab::ImageFit::Fill => ak::ImageScaling::NSImageScaleAxesIndependently,
    };
}

// ---- scroll ------------------------------------------------------------------
// NSScrollView holds its content in a FLIPPED document view, so the tree below
// it keeps the same top-left coordinate space as everywhere else. facet's
// children are inserted into that document view, not into the scroll view —
// `document_host` is what `views::insert` asks for.

fn create_scroll(n: *core::Node) -> *u8 {
    let s: ak::ScrollView = ak::ScrollView::from_raw(rt::alloc_init(#str_ptr("NSScrollView\0")));
    let doc: ak::View = akx::new_flipped_view(rt::Rect { x: 0.0f64, y: 0.0f64, w: 0.0f64, h: 0.0f64 });
    s.set_document_view(doc);
    s.set_draws_background(false);
    return rt::retain(s.as_view().raw());
}

fn apply_scroll(v: *u8, n: *core::Node, dirty: u64) {
    let p: *props::ScrollProps = props_of(n, props::K_SCROLL) as *props::ScrollProps;
    if p == (0 as *props::ScrollProps) { return; }
    let s: ak::ScrollView = ak::ScrollView::from_raw(v);
    if (dirty & (scroll::P_AXIS | scroll::P_VERTICAL_SCROLL_BARS | scroll::P_HORIZONTAL_SCROLL_BARS)) != (0 as u64) {
        let axis: vocab::ScrollAxis = { (*p).axis };
        let scrolls_v: bool = match axis {
            vocab::ScrollAxis::Both => true,
            vocab::ScrollAxis::Vertical => true,
            vocab::ScrollAxis::Horizontal => false,
            vocab::ScrollAxis::Neither => false,
        };
        let scrolls_h: bool = match axis {
            vocab::ScrollAxis::Both => true,
            vocab::ScrollAxis::Horizontal => true,
            vocab::ScrollAxis::Vertical => false,
            vocab::ScrollAxis::Neither => false,
        };
        s.set_has_vertical_scroller(scrolls_v && shows_bars({ (*p).vertical_scroll_bars }));
        s.set_has_horizontal_scroller(scrolls_h && shows_bars({ (*p).horizontal_scroll_bars }));
    }
    return;
}

// `Default` is the platform's own answer, which on macOS is the overlay
// scroller that appears while scrolling — so the scroller exists either way,
// and only `Never` takes it away.
fn shows_bars(b: vocab::ScrollBars) -> bool {
    return match b {
        vocab::ScrollBars::Always => true,
        vocab::ScrollBars::Default => true,
        vocab::ScrollBars::Never => false,
    };
}

// A scroll's children belong in its document view, not in the scroll view.
// Every other kind hosts its own children directly, so this is the one place
// the host and the view differ.
fn document_host(v: *u8) -> *u8 {
    match ak::ScrollView::from_raw(v).document_view() {
        option::Option[ak::View]::Some(d) => { return d.raw(); }
        option::Option[ak::View]::None => { return v; }
    }
    return v;
}

// ---- on / off state ----------------------------------------------------------
// NSControl's state is a tri-state i64 (off 0, on 1, mixed -1). facet's
// controls are all two-state, so the conversion is one place rather than five.

fn state_on() -> i64 { return 1 as i64; }
fn state_off() -> i64 { return 0 as i64; }
fn state_of(on: bool) -> i64 { if on { return state_on(); } return state_off(); }

fn is_html(p: *props::LabelProps) -> bool {
    return match { (*p).text_format } {
        vocab::TextFormat::Html => true,
        vocab::TextFormat::Text => false,
    };
}

// An NSAttributedString parsed from HTML, at +1, or 0 when the markup is
// unusable — in which case the caller leaves the label alone rather than
// showing raw tags.
fn html_string(markup: str) -> *u8 {
    let data: *u8 = { rt::msg_id_u64(bridge::nsstring(markup),
                                     rt::sel(#str_ptr("dataUsingEncoding:\0")), 4 as u64) };
    if data == (0 as *u8) { return 0 as *u8; }
    let opts: *u8 = { rt::alloc_init(#str_ptr("NSMutableDictionary\0")) };
    if opts == (0 as *u8) { return 0 as *u8; }
    { rt::msg_void_id_id(opts, rt::sel(#str_ptr("setObject:forKey:\0")),
                         bridge::nsstring("NSHTML"), bridge::nsstring("DocumentType")) };
    let alloced: *u8 = { rt::msg_id(rt::get_class(#str_ptr("NSAttributedString\0")),
                                    rt::sel(#str_ptr("alloc\0"))) };
    let a: *u8 = { msg_id_html(alloced, rt::sel(#str_ptr("initWithData:options:documentAttributes:error:\0")),
                               data, opts, 0 as *u8, 0 as *u8) };
    { rt::release(opts) };
    return a;
}

#[link_name = "objc_msgSend"]
extern fn msg_id_html(recv: *u8, sel: *u8, a: *u8, b: *u8, c: *u8, d: *u8) -> *u8;

fn formatted_count(p: *props::LabelProps) -> usize {
    let f: *vocab::Spans = { #addr_of((*p).formatted_text) };
    return { (*f).count() };
}

// The attributed string a label's `formatted_text` value describes, at +1.
// Same shape as `build_runs` over child spans, and deliberately so: two ways
// to say runs must not become two renderings of them.
fn build_value_runs(p: *props::LabelProps) -> *u8 {
    let ms: *u8 = { rt::alloc_init(#str_ptr("NSMutableAttributedString\0")) };
    if ms == (0 as *u8) { return 0 as *u8; }
    let spans: *vocab::Spans = { #addr_of((*p).formatted_text) };
    var i: usize = 0 as usize;
    let count: usize = { (*spans).count() };
    while i < count {
        let r: *vocab::TextSpan = { (*spans).at(i) };
        if r != (0 as *vocab::TextSpan) { append_value_run(ms, r, p); }
        i = i +% (1 as usize);
    }
    return ms;
}

fn append_value_run(ms: *u8, r: *vocab::TextSpan, p: *props::LabelProps) {
    let attrs: *u8 = paint::rich_attributes(
        paint::ns_font_styled({ (*r).font_size }, { (*r).font_weight },
                              { (*r).font_family.view() }, { (*r).is_italic }),
        { (*r).color }, { (*p).character_spacing }, { (*p).line_height },
        option::Option[vocab::TextAlign]::None, { (*r).decoration });
    if attrs != (0 as *u8) {
        let bg: vocab::Color = { (*r).background_color };
        if bg.is_set() { paint::dict_set(attrs, "NSBackgroundColor", paint::ns_color(bg).raw()); }
        // A run with a destination is a LINK, which is what `link` means and
        // the only attribute a plain run cannot carry.
        let dest: str = { (*r).link.view() };
        if dest != "" { paint::dict_set(attrs, "NSLink", bridge::nsstring(dest)); }
    }
    let run: *u8 = paint::attributed({ (*r).text.view() }, attrs);
    if run != (0 as *u8) {
        { rt::msg_void_id(ms, rt::sel(#str_ptr("appendAttributedString:\0")), run) };
        { rt::release(run) };
    }
    return;
}

fn label_wants_rich(p: *props::LabelProps) -> bool {
    return paint::wants_rich({ (*p).character_spacing }, { (*p).line_height },
                             { (*p).text_decoration });
}

fn label_attributes(p: *props::LabelProps) -> *u8 {
    return paint::rich_attributes(
        paint::ns_font_styled({ (*p).font_size }, { (*p).font_weight },
                              { (*p).font_family.view() }, { (*p).is_italic }),
        { (*p).text_color }, { (*p).character_spacing }, { (*p).line_height },
        option::some({ (*p).text_align }), { (*p).text_decoration });
}

// ---- the border band ---------------------------------------------------------
// `border_color`, `border_width` and `corner_radius` are the same three verbs
// on a button, an icon button, a radio and a bordered box, and a layer answers
// all three. One body, because three copies is how three controls end up
// disagreeing about what a zero width means.

fn apply_border(v: *u8, color: vocab::Color, width: f64, radius: vocab::Corners,
                do_border: bool, do_corner: bool) {
    let view: ak::View = ak::View::from_raw(v);
    if do_border {
        // A zero width is no border, and it must CLEAR one — a control that
        // had a border and then asked for none has to lose it.
        view.set_wants_layer(true);
        view.layer().set_border_width(width);
        if width > 0.0f64 && color.is_set() {
            view.layer().set_border_color(paint::ns_color(color).c_g_color());
        }
    }
    if do_corner {
        view.set_wants_layer(true);
        view.layer().set_corner_radius(largest_corner(radius));
    }
    return;
}

// ---- box ---------------------------------------------------------------------
// A rectangle of colour. No AppKit control corresponds — NSBox is a titled
// grouping frame, which is a different thing — so it is a layer-backed view,
// which is also what makes its corner radius free.

fn create_box(n: *core::Node) -> *u8 {
    let v: ak::View = akx::new_flipped_view(rt::Rect { x: 0.0f64, y: 0.0f64, w: 0.0f64, h: 0.0f64 });
    v.set_wants_layer(true);
    return rt::retain(v.raw());
}

fn apply_box(v: *u8, n: *core::Node, dirty: u64) {
    let p: *props::BoxProps = props_of(n, props::K_BOX) as *props::BoxProps;
    if p == (0 as *props::BoxProps) { return; }
    let view: ak::View = ak::View::from_raw(v);
    if (dirty & box_view::P_COLOR) != (0 as u64) {
        view.set_wants_layer(true);
        view.layer().set_background_color(paint::ns_color({ (*p).color }).c_g_color());
    }
    if (dirty & box_view::P_CORNER_RADIUS) != (0 as u64) {
        view.set_wants_layer(true);
        // One radius per layer is all Core Animation has; facet carries four
        // corners, so the largest wins and MANIFEST.md records the deviation.
        view.layer().set_corner_radius(largest_corner({ (*p).corner_radius }));
    }
    return;
}

fn largest_corner(c: vocab::Corners) -> f64 {
    var m: f64 = c.top_leading;
    if c.top_trailing > m { m = c.top_trailing; }
    if c.bottom_leading > m { m = c.bottom_leading; }
    if c.bottom_trailing > m { m = c.bottom_trailing; }
    return m;
}

// ---- checkbox ----------------------------------------------------------------

fn create_checkbox(n: *core::Node) -> *u8 {
    let b: ak::Button = ak::Button::from_raw(rt::alloc_init(#str_ptr("NSButton\0")));
    b.set_button_type(ak::ButtonType::Switch);   // AppKit's name for a checkbox
    b.set_title("");
    return rt::retain(b.as_view().raw());
}

fn apply_checkbox(v: *u8, n: *core::Node, dirty: u64) {
    let p: *props::CheckboxProps = props_of(n, props::K_CHECKBOX) as *props::CheckboxProps;
    if p == (0 as *props::CheckboxProps) { return; }
    let b: ak::Button = ak::Button::from_raw(v);
    if (dirty & checkbox::P_ON) != (0 as u64) { b.set_state(state_of({ (*p).on })); }
    if (dirty & props::C_HANDLERS) != (0 as u64) || dirty == paint::all_bits() {
        akx::set_control_action_ctx(b.as_control(), { (*p).on_checked_changed }, { (*p).on_checked_changed_ctx });
    }
    if (dirty & props::C_IS_ENABLED) != (0 as u64) || dirty == paint::all_bits() {
        b.as_control().set_enabled(core::is_enabled(n));
    }
    return;
}

// ---- radio -------------------------------------------------------------------
// AppKit groups radios by SUPERVIEW, not by name: NSButtons of type Radio that
// share a superview deselect each other automatically. facet's `group` names
// the set instead, which is the portable model — so a group that does not
// match the tree's shape is not honoured, and MANIFEST.md records it.

fn create_radio(n: *core::Node) -> *u8 {
    let b: ak::Button = ak::Button::from_raw(rt::alloc_init(#str_ptr("NSButton\0")));
    b.set_button_type(ak::ButtonType::Radio);
    return rt::retain(b.as_view().raw());
}

// ---- radio groups ------------------------------------------------------------
// AppKit groups NSButtons of type Radio by SUPERVIEW: radios sharing a
// superview deselect each other and there is no group name. facet names the
// group instead, which is the portable model — and a portable model the
// backend declines to honour is a backend rendering the description wrong, not
// a platform limit. So the group is honoured HERE.
//
// The rule is the one AppKit's own grouping implements: turning a radio ON
// turns off every other radio naming the same group. The search is over the
// mounted roots rather than the node's siblings, because a facet group is a
// NAME and its members need not share a parent — which is the whole reason
// facet names it rather than inferring it from the tree.

fn radio_props(n: *core::Node) -> *props::RadioProps {
    let d: *core::Data = core::node_data(n);
    if d == (0 as *core::Data) { return 0 as *props::RadioProps; }
    if { (*d).kind } != props::K_RADIO { return 0 as *props::RadioProps; }
    return { (*d).props } as *props::RadioProps;
}

// Turn off every radio in `group` except `keep`. Writes the prop AND the
// control: the prop because `on()` reads it, the control because that is what
// the user sees, and updating one without the other is two answers to one
// question.
fn clear_group(n: *core::Node, group: str, keep: *core::Node) {
    if n == (0 as *core::Node) { return; }
    let p: *props::RadioProps = radio_props(n);
    if p != (0 as *props::RadioProps) && n != keep {
        if { (*p).group.view() } == group && { (*p).on } {
            { (*p).on = false };
            let v: *u8 = core::view_of(n);
            if v != (0 as *u8) { ak::Button::from_raw(v).set_state(state_off()); }
        }
    }
    var i: usize = 0 as usize;
    let count: usize = core::child_count_of(n);
    while i < count {
        match core::child_of(n, i) {
            option::Option[*core::Node]::Some(c) => { clear_group(c, group, keep); }
            option::Option[*core::Node]::None => { }
        }
        i = i +% (1 as usize);
    }
    return;
}

// The action, wrapped: the group settles first, then the application's own
// handler runs — so a handler that asks which radio is on gets the answer
// after the group settled rather than during.
fn radio_action(sender: *u8, ctx: *u8) {
    let n: *core::Node = ctx as *core::Node;
    if n == (0 as *core::Node) { return; }
    let p: *props::RadioProps = radio_props(n);
    if p == (0 as *props::RadioProps) { return; }
    let on: bool = ak::Button::from_raw(sender).state() == state_on();
    { (*p).on = on };
    let group: str = { (*p).group.view() };
    if on && group != "" {
        var w: usize = 0 as usize;
        let windows: usize = app::window_count();
        while w < windows {
            clear_group(app::window_root(w), group, n);
            w = w +% (1 as usize);
        }
    }
    let h: fn(*u8, *u8) = { (*p).on_checked_changed };
    if h != props::no_handler { h(sender, { (*p).on_checked_changed_ctx }); }
    return;
}

fn apply_radio(v: *u8, n: *core::Node, dirty: u64) {
    let p: *props::RadioProps = props_of(n, props::K_RADIO) as *props::RadioProps;
    if p == (0 as *props::RadioProps) { return; }
    let b: ak::Button = ak::Button::from_raw(v);
    if (dirty & radio::P_ON) != (0 as u64) { b.set_state(state_of({ (*p).on })); }
    if (dirty & (radio::P_FONT_SIZE | radio::P_FONT_WEIGHT | radio::P_FONT_FAMILY
                 | radio::P_IS_ITALIC)) != (0 as u64) {
        match paint::ns_font_styled({ (*p).font_size }, { (*p).font_weight },
                                    { (*p).font_family.view() }, { (*p).is_italic }) {
            option::Option[ak::Font]::Some(font) => { b.as_control().set_font(font); }
            option::Option[ak::Font]::None => { }
        }
    }
    if (dirty & (radio::P_BORDER_COLOR | radio::P_BORDER_WIDTH | radio::P_CORNER_RADIUS)) != (0 as u64) {
        apply_border(v, { (*p).border_color }, { (*p).border_width }, { (*p).corner_radius },
                     (dirty & (radio::P_BORDER_COLOR | radio::P_BORDER_WIDTH)) != (0 as u64),
                     (dirty & radio::P_CORNER_RADIUS) != (0 as u64));
    }
    if (dirty & (props::C_HANDLERS | radio::P_GROUP)) != (0 as u64) || dirty == paint::all_bits() {
        // Through the group trampoline, not straight to the handler: the group
        // has to settle before the application is told.
        let f: fn(*u8, *u8) = radio_action;
        akx::set_control_action_ctx(b.as_control(), f, n as *u8);
    }
    if (dirty & props::C_IS_ENABLED) != (0 as u64) || dirty == paint::all_bits() {
        b.as_control().set_enabled(core::is_enabled(n));
    }
    return;
}

// ---- toggle ------------------------------------------------------------------
// NSSwitch, which is the real thing rather than a checkbox wearing a label.
// Its colours are the system's: `on_color` / `off_color` / `thumb_color` have
// no AppKit equivalent, and MANIFEST.md records that rather than faking them
// with a tinted layer that would stop tracking the appearance.

fn create_toggle(n: *core::Node) -> *u8 {
    let s: ak::Switch = ak::Switch::from_raw(rt::alloc_init(#str_ptr("NSSwitch\0")));
    return rt::retain(s.as_view().raw());
}

fn apply_toggle(v: *u8, n: *core::Node, dirty: u64) {
    let p: *props::ToggleProps = props_of(n, props::K_TOGGLE) as *props::ToggleProps;
    if p == (0 as *props::ToggleProps) { return; }
    let s: ak::Switch = ak::Switch::from_raw(v);
    if (dirty & toggle::P_ON) != (0 as u64) { s.set_state(state_of({ (*p).on })); }
    if (dirty & props::C_HANDLERS) != (0 as u64) || dirty == paint::all_bits() {
        akx::set_control_action_ctx(s.as_control(), { (*p).on_toggled }, { (*p).on_toggled_ctx });
    }
    if (dirty & props::C_IS_ENABLED) != (0 as u64) || dirty == paint::all_bits() {
        s.as_control().set_enabled(core::is_enabled(n));
    }
    return;
}

// ---- slider ------------------------------------------------------------------

fn create_slider(n: *core::Node) -> *u8 {
    let s: ak::Slider = ak::Slider::from_raw(rt::alloc_init(#str_ptr("NSSlider\0")));
    return rt::retain(s.as_view().raw());
}

fn apply_slider(v: *u8, n: *core::Node, dirty: u64) {
    let p: *props::SliderProps = props_of(n, props::K_SLIDER) as *props::SliderProps;
    if p == (0 as *props::SliderProps) { return; }
    let s: ak::Slider = ak::Slider::from_raw(v);
    // The range goes on before the value, or a value outside the OLD range is
    // clamped away and the write is silently lost.
    if (dirty & slider::P_MINIMUM) != (0 as u64) { s.set_min_value({ (*p).minimum }); }
    if (dirty & slider::P_MAXIMUM) != (0 as u64) { s.set_max_value({ (*p).maximum }); }
    if (dirty & (slider::P_VALUE | slider::P_MINIMUM | slider::P_MAXIMUM)) != (0 as u64) {
        s.as_control().set_double_value({ (*p).value });
    }
    if (dirty & props::C_HANDLERS) != (0 as u64) || dirty == paint::all_bits() {
        akx::set_control_action_ctx(s.as_control(), { (*p).on_value_changed }, { (*p).on_value_changed_ctx });
        // `on_drag_started` / `on_drag_completed` are the EDGES of a drag, and
        // NSSlider reports them the same way it reports the value: through the
        // action, with `isTracking` saying which edge this is. A continuous
        // slider fires the action throughout, so the two edges are the first
        // action with tracking on and the first with it off.
        text_input::install_slider(v, n);
    }
    if (dirty & props::C_IS_ENABLED) != (0 as u64) || dirty == paint::all_bits() {
        s.as_control().set_enabled(core::is_enabled(n));
    }
    return;
}

// ---- progress ----------------------------------------------------------------
// A determinate bar. facet's `progress` is 0..1; NSProgressIndicator takes a
// range, so the range is fixed at 0..1 and the value is written straight.

fn create_progress(n: *core::Node) -> *u8 {
    let pi: ak::ProgressIndicator = ak::ProgressIndicator::from_raw(rt::alloc_init(#str_ptr("NSProgressIndicator\0")));
    pi.set_style(ak::ProgressIndicatorStyle::Bar);
    pi.set_indeterminate(false);
    pi.set_min_value(0.0f64);
    pi.set_max_value(1.0f64);
    return rt::retain(pi.as_view().raw());
}

fn apply_progress(v: *u8, n: *core::Node, dirty: u64) {
    let p: *props::ProgressProps = props_of(n, props::K_PROGRESS) as *props::ProgressProps;
    if p == (0 as *props::ProgressProps) { return; }
    let pi: ak::ProgressIndicator = ak::ProgressIndicator::from_raw(v);
    if (dirty & progress::P_PROGRESS) != (0 as u64) { pi.set_double_value({ (*p).progress }); }
    // `animate_progress` is a COMMAND — "slide to the current progress over
    // `animate_duration`" — not a flag. NSProgressIndicator has no animated
    // setter, so the animation is the ANIMATOR PROXY's, which is AppKit's own
    // way of saying the same thing and gets the timing curve for free.
    if (dirty & progress::P_ANIMATE_PROGRESS) != (0 as u64) {
        let secs: f64 = { (*p).animate_duration.seconds };
        if secs <= 0.0f64 {
            pi.set_double_value({ (*p).progress });
        } else {
            let cls: *u8 = rt::get_class(#str_ptr("NSAnimationContext\0"));
            { rt::msg_void(cls, rt::sel(#str_ptr("beginGrouping\0"))) };
            let ctx: *u8 = { rt::msg_id(cls, rt::sel(#str_ptr("currentContext\0"))) };
            if ctx != (0 as *u8) {
                { msg_void_f64(ctx, rt::sel(#str_ptr("setDuration:\0")), secs) };
            }
            let anim: *u8 = { rt::msg_id(v, rt::sel(#str_ptr("animator\0"))) };
            if anim != (0 as *u8) {
                { msg_void_f64(anim, rt::sel(#str_ptr("setDoubleValue:\0")), { (*p).progress }) };
            }
            { rt::msg_void(cls, rt::sel(#str_ptr("endGrouping\0"))) };
        }
    }
    return;
}

#[link_name = "objc_msgSend"]
extern fn msg_void_f64(recv: *u8, sel: *u8, a: f64);

// ---- spinner -----------------------------------------------------------------
// The same class in its indeterminate posture. It must be told to ANIMATE, not
// merely shown: a stopped spinner draws nothing, which reads as a broken view.

fn create_spinner(n: *core::Node) -> *u8 {
    let pi: ak::ProgressIndicator = ak::ProgressIndicator::from_raw(rt::alloc_init(#str_ptr("NSProgressIndicator\0")));
    pi.set_style(ak::ProgressIndicatorStyle::Spinning);
    pi.set_indeterminate(true);
    return rt::retain(pi.as_view().raw());
}

fn apply_spinner(v: *u8, n: *core::Node, dirty: u64) {
    let p: *props::SpinnerProps = props_of(n, props::K_SPINNER) as *props::SpinnerProps;
    if p == (0 as *props::SpinnerProps) { return; }
    let pi: ak::ProgressIndicator = ak::ProgressIndicator::from_raw(v);
    if (dirty & spinner::P_IS_RUNNING) != (0 as u64) {
        if { (*p).is_running } { pi.start_animation(0 as *u8); } else { pi.stop_animation(0 as *u8); }
    }
    return;
}

// ---- stepper -----------------------------------------------------------------

fn create_stepper(n: *core::Node) -> *u8 {
    let s: ak::Stepper = ak::Stepper::from_raw(rt::alloc_init(#str_ptr("NSStepper\0")));
    return rt::retain(s.as_view().raw());
}

fn apply_stepper(v: *u8, n: *core::Node, dirty: u64) {
    let p: *props::StepperProps = props_of(n, props::K_STEPPER) as *props::StepperProps;
    if p == (0 as *props::StepperProps) { return; }
    let s: ak::Stepper = ak::Stepper::from_raw(v);
    if (dirty & stepper::P_MINIMUM) != (0 as u64) { s.set_min_value({ (*p).minimum }); }
    if (dirty & stepper::P_MAXIMUM) != (0 as u64) { s.set_max_value({ (*p).maximum }); }
    if (dirty & stepper::P_INCREMENT) != (0 as u64) { s.set_increment({ (*p).increment }); }
    // Same ordering trap as the slider: range first, then the value.
    if (dirty & (stepper::P_VALUE | stepper::P_MINIMUM | stepper::P_MAXIMUM)) != (0 as u64) {
        s.as_control().set_double_value({ (*p).value });
    }
    if (dirty & props::C_HANDLERS) != (0 as u64) || dirty == paint::all_bits() {
        akx::set_control_action_ctx(s.as_control(), { (*p).on_value_changed }, { (*p).on_value_changed_ctx });
    }
    if (dirty & props::C_IS_ENABLED) != (0 as u64) || dirty == paint::all_bits() {
        s.as_control().set_enabled(core::is_enabled(n));
    }
    return;
}

// ---- icon_button -------------------------------------------------------------
// A button whose content is an image rather than a title. Borderless, because
// an app reaching for this wants the icon and not a bezel around it.

fn create_icon_button(n: *core::Node) -> *u8 {
    let b: ak::Button = ak::Button::from_raw(rt::alloc_init(#str_ptr("NSButton\0")));
    b.set_button_type(ak::ButtonType::MomentaryChange);
    b.set_bordered(false);
    b.set_title("");
    return rt::retain(b.as_view().raw());
}

fn apply_icon_button(v: *u8, n: *core::Node, dirty: u64) {
    let p: *props::IconButtonProps = props_of(n, props::K_ICON_BUTTON) as *props::IconButtonProps;
    if p == (0 as *props::IconButtonProps) { return; }
    let b: ak::Button = ak::Button::from_raw(v);
    if (dirty & icon_button::P_SOURCE) != (0 as u64) {
        match resolve_image({ (*p).source.view() }) {
            option::Option[ak::Image]::Some(img) => { b.set_image(img); }
            option::Option[ak::Image]::None => { }
        }
    }
    if (dirty & icon_button::P_FIT) != (0 as u64) {
        b.set_image_scaling(ns_image_scaling({ (*p).fit }));
    }
    if (dirty & (icon_button::P_BORDER_COLOR | icon_button::P_BORDER_WIDTH
                 | icon_button::P_CORNER_RADIUS)) != (0 as u64) {
        apply_border(v, { (*p).border_color }, { (*p).border_width }, { (*p).corner_radius },
                     (dirty & (icon_button::P_BORDER_COLOR | icon_button::P_BORDER_WIDTH)) != (0 as u64),
                     (dirty & icon_button::P_CORNER_RADIUS) != (0 as u64));
    }
    if (dirty & props::C_HANDLERS) != (0 as u64) || dirty == paint::all_bits() {
        akx::set_control_action_ctx(b.as_control(), { (*p).on_clicked }, { (*p).on_clicked_ctx });
    }
    if (dirty & props::C_IS_ENABLED) != (0 as u64) || dirty == paint::all_bits() {
        b.as_control().set_enabled(core::is_enabled(n));
    }
    return;
}

// ---- symbol ------------------------------------------------------------------
// An icon from a NAMED set. facet carries two: the OS's own (SF Symbols on
// macOS) and a bundled font whose glyph is a codepoint. The System set maps
// straight onto AppKit; the Bundled set is a glyph rendered as text.

fn create_symbol(n: *core::Node) -> *u8 {
    let f: ak::TextField = ak::TextField::label_with_string("");
    return rt::retain(f.as_view().raw());
}

fn apply_symbol(v: *u8, n: *core::Node, dirty: u64) {
    let p: *symbol::SymbolProps = props_of(n, symbol::K_SYMBOL) as *symbol::SymbolProps;
    if p == (0 as *symbol::SymbolProps) { return; }
    let f: ak::TextField = ak::TextField::from_raw(v);
    if (dirty & (symbol::P_NAME | symbol::P_ICON | symbol::P_SIZE | symbol::P_FONT
                 | symbol::P_FILL)) != (0 as u64) {
        // The System set is a real SF Symbol; a bundled glyph is its codepoint
        // in facet's own font. Either way it lands in a label, so the shared
        // band and the frame walk treat it like any other leaf.
        let pt: f64 = { (*p).size };
        if pt > 0.0f64 { f.as_control().set_font(ak::Font::system_font_of_size(pt)); }
        let name: str = { (*p).name.view() };
        if name != "" {
            // SF Symbols spell the filled variant as a NAME — "house" and
            // "house.fill" are two symbols, not one symbol with a property —
            // so `fill` picks the name rather than setting an axis. Between the
            // two it rounds: a partial fill is a variable-font axis the system
            // set does not expose, and MANIFEST records that.
            var want: text::Text = text::from_str(name);
            if { (*p).fill } >= 0.5f64 { let _a: status::Status = want.append(".fill"); }
            match symbol_image(want.view(), name) {
                option::Option[ak::Image]::Some(img) => { set_symbol_image(f, img); }
                // A name the machine does not have leaves the field empty
                // rather than showing the name as text, which would read as a
                // rendering bug rather than a missing glyph.
                option::Option[ak::Image]::None => { f.as_control().set_string_value(""); }
            }
        }
    }
    if (dirty & symbol::P_COLOR) != (0 as u64) {
        let c: vocab::Color = { (*p).color };
        if c.is_set() { f.set_text_color(paint::ns_color(c)); }
    }
    return;
}

// One place that turns a facet image name into an NSImage: a system symbol
// first, then a bundle name, then a path on disk.
fn resolve_image(src: str) -> option::Option[ak::Image] {
    if src == "" { return option::Option[ak::Image]::None; }
    match ak::Image::image_with_system_symbol_name(src, "") {
        option::Option[ak::Image]::Some(img) => { return option::some(img); }
        option::Option[ak::Image]::None => { }
    }
    match ak::Image::image_named(src) {
        option::Option[ak::Image]::Some(named) => { return option::some(named); }
        option::Option[ak::Image]::None => { }
    }
    return option::some(ak::Image::new_with_contents_of_file(src));
}

// The filled name if there is one, else the plain name — so `fill: 1.0` on a
// symbol with no filled variant shows the outline rather than nothing.
fn symbol_image(filled: str, plain: str) -> option::Option[ak::Image] {
    match ak::Image::image_with_system_symbol_name(filled, "") {
        option::Option[ak::Image]::Some(img) => { return option::some(img); }
        option::Option[ak::Image]::None => { }
    }
    return ak::Image::image_with_system_symbol_name(plain, "");
}

// A symbol lands in a LABEL, so the image is an attachment in its attributed
// string. That is what keeps the shared band and the frame walk treating it
// like any other leaf — the alternative, an NSImageView, would need its own
// case in every one of them.
fn set_symbol_image(f: ak::TextField, img: ak::Image) {
    let att: *u8 = { rt::alloc_init(#str_ptr("NSTextAttachment\0")) };
    if att == (0 as *u8) { return; }
    { rt::msg_void_id(att, rt::sel(#str_ptr("setImage:\0")), img.raw()) };
    let s: *u8 = { rt::msg_id_id(rt::get_class(#str_ptr("NSAttributedString\0")),
                                 rt::sel(#str_ptr("attributedStringWithAttachment:\0")), att) };
    { rt::release(att) };
    if s == (0 as *u8) { return; }
    { rt::msg_void_id(f.raw(), rt::sel(#str_ptr("setAttributedStringValue:\0")), s) };
    return;
}

// ---- text_area ---------------------------------------------------------------
// NSTextView inside an NSScrollView: the scroller is not optional on AppKit —
// a bare NSTextView does not scroll, and a multi-line editor that cannot
// scroll is not one. So the VIEW facet holds is the scroll view, and the text
// view is reached through it.

fn create_text_area(n: *core::Node) -> *u8 {
    let s: ak::ScrollView = ak::ScrollView::from_raw(rt::alloc_init(#str_ptr("NSScrollView\0")));
    let tv: ak::TextView = ak::TextView::from_raw(rt::alloc_init(#str_ptr("NSTextView\0")));
    tv.set_rich_text(false);          // facet's text is plain; styling is props
    s.set_document_view(tv.as_view());
    s.set_has_vertical_scroller(true);
    // The notifications come from the TEXT VIEW, but the node is backed by the
    // scroll view — so the delegate is pinned to the one that lives as long as
    // the node and installed on the one that talks.
    text_input::install(s.as_view().raw(), tv.as_view().raw(), n);
    return rt::retain(s.as_view().raw());
}

// The NSTextView inside a text_area's scroll view.
fn text_area_editor(v: *u8) -> option::Option[ak::TextView] {
    match ak::ScrollView::from_raw(v).document_view() {
        option::Option[ak::View]::Some(d) => { return option::some(ak::TextView::from_raw(d.raw())); }
        option::Option[ak::View]::None => { return option::Option[ak::TextView]::None; }
    }
    return option::Option[ak::TextView]::None;
}

fn apply_text_area(v: *u8, n: *core::Node, dirty: u64) {
    let p: *props::TextAreaProps = props_of(n, props::K_TEXT_AREA) as *props::TextAreaProps;
    if p == (0 as *props::TextAreaProps) { return; }
    match text_area_editor(v) {
        option::Option[ak::TextView]::Some(tv) => {
            let iv: *props::InputViewProps = { #addr_of((*p).input_view) };
            text_input::apply_editor_band(tv, n, iv, { (*p).text_align }, dirty,
                                          text_input::bits_of(props::K_TEXT_AREA));
            // `auto_size` is the editor's own verb: an NSTextView that grows
            // with its text is vertically resizable with no ceiling, and is
            // asked to size to fit whenever the text changes. Disabled is the
            // fixed box its scroll view gives it.
            if (dirty & (text_area::P_AUTO_SIZE | text_area::P_TEXT)) != (0 as u64)
                || dirty == paint::all_bits() {
                let grows: bool = match { (*p).auto_size } {
                    vocab::AutoSize::TextChanges => true,
                    vocab::AutoSize::Disabled => false,
                };
                tv.as_text().set_vertically_resizable(grows);
                if grows {
                    tv.as_text().set_max_size(rt::Size { w: 1000000.0f64, h: 1000000.0f64 });
                    tv.as_text().size_to_fit();
                }
            }
        }
        option::Option[ak::TextView]::None => { }
    }
    return;
}

// ---- search_field ------------------------------------------------------------
// NSSearchField is an NSTextField subclass, so the field half is the same
// work; what it adds is the magnifier and the clear button, which AppKit draws
// itself.

fn create_search_field(n: *core::Node) -> *u8 {
    let f: ak::SearchField = ak::SearchField::from_raw(rt::alloc_init(#str_ptr("NSSearchField\0")));
    text_input::install(f.as_view().raw(), f.as_view().raw(), n);
    return rt::retain(f.as_view().raw());
}

fn apply_search_field(v: *u8, n: *core::Node, dirty: u64) {
    let p: *props::SearchFieldProps = props_of(n, props::K_SEARCH_FIELD) as *props::SearchFieldProps;
    if p == (0 as *props::SearchFieldProps) { return; }
    let f: ak::TextField = ak::TextField::from_raw(v);
    let iv: *props::InputViewProps = { #addr_of((*p).input_view) };
    text_input::apply_field_band(f, n, iv, { (*p).text_align }, dirty,
                                 text_input::bits_of(props::K_SEARCH_FIELD));
    if (dirty & props::C_IS_ENABLED) != (0 as u64) || dirty == paint::all_bits() {
        f.as_control().set_enabled(core::is_enabled(n));
    }
    return;
}

// ---- popup -------------------------------------------------------------------
// MAUI's Picker: a closed control that opens a list. NSPopUpButton is exactly
// that, and it owns its own menu — so the items are REBUILT whenever the list
// changes rather than diffed, because a popup's item list is short and a diff
// would be more code than the rebuild it replaces.

fn create_popup(n: *core::Node) -> *u8 {
    let b: ak::PopUpButton = ak::PopUpButton::from_raw(rt::alloc_init(#str_ptr("NSPopUpButton\0")));
    return rt::retain(b.as_view().raw());
}

fn apply_popup(v: *u8, n: *core::Node, dirty: u64) {
    let p: *props::PopupProps = props_of(n, props::K_POPUP) as *props::PopupProps;
    if p == (0 as *props::PopupProps) { return; }
    let b: ak::PopUpButton = ak::PopUpButton::from_raw(v);
    // The menu is rebuilt with the items, so the delegate that carries
    // `on_opened` / `on_closed` is re-installed with it.
    if (dirty & (popup::P_ITEMS | props::C_HANDLERS)) != (0 as u64) || dirty == paint::all_bits() {
        match b.menu() {
            option::Option[ak::Menu]::Some(m) => { text_input::install_popup(v, m.raw(), n); }
            option::Option[ak::Menu]::None => { }
        }
    }
    if (dirty & popup::P_ITEMS) != (0 as u64) {
        b.remove_all_items();
        let items: *vocab::TextList = { #addr_of((*p).items) };
        var i: usize = 0 as usize;
        let count: usize = { (*items).count() };
        while i < count {
            b.add_item_with_title({ (*items).at(i) });
            i = i +% (1 as usize);
        }
    }
    // The selection goes on AFTER the items, or it indexes a list that is not
    // there yet and AppKit quietly keeps the old one.
    if (dirty & (popup::P_SELECTED_INDEX | popup::P_ITEMS)) != (0 as u64) {
        let idx: i64 = { (*p).selected_index };
        if idx >= (0 as i64) { b.select_item_at_index(idx); }
    }
    if (dirty & (popup::P_FONT_SIZE | popup::P_FONT_WEIGHT | popup::P_FONT_FAMILY
                 | popup::P_IS_ITALIC)) != (0 as u64) {
        match paint::ns_font_styled({ (*p).font_size }, { (*p).font_weight },
                                    { (*p).font_family.view() }, { (*p).is_italic }) {
            option::Option[ak::Font]::Some(font) => { b.as_control().set_font(font); }
            option::Option[ak::Font]::None => { }
        }
    }
    // A popup draws its rows from its MENU, so a colour or a kern is an
    // attributed title per item — there is no `setTextColor:` on the button.
    if (dirty & (popup::P_TEXT_COLOR | popup::P_CHARACTER_SPACING | popup::P_ITEMS
                 | popup::P_IS_ITALIC | popup::P_FONT_SIZE | popup::P_FONT_WEIGHT
                 | popup::P_FONT_FAMILY)) != (0 as u64) {
        style_popup_items(b, p);
    }
    if (dirty & popup::P_TEXT_ALIGN) != (0 as u64) {
        b.as_control().set_alignment(paint::ns_text_align({ (*p).text_align }));
    }
    // `is_open` opens the menu. Closing it is the USER's — AppKit gives no
    // dismiss message for a popup's menu — so a false is not a close, it is
    // "do not open", and MANIFEST records the asymmetry.
    if (dirty & popup::P_IS_OPEN) != (0 as u64) {
        if { (*p).is_open } { b.as_control().perform_click(0 as *u8); }
    }
    if (dirty & props::C_HANDLERS) != (0 as u64) || dirty == paint::all_bits() {
        akx::set_control_action_ctx(b.as_control(), { (*p).on_selected_index_changed }, { (*p).on_selected_index_changed_ctx });
    }
    if (dirty & props::C_IS_ENABLED) != (0 as u64) || dirty == paint::all_bits() {
        b.as_control().set_enabled(core::is_enabled(n));
    }
    return;
}

// Every item's title, attributed with the popup's own text band. Rebuilt with
// the items rather than diffed, for the same reason the items are: a popup's
// list is short and a diff would be more code than the rebuild it replaces.
fn style_popup_items(b: ak::PopUpButton, p: *props::PopupProps) {
    let c: vocab::Color = { (*p).text_color };
    let kern: f64 = { (*p).character_spacing };
    if c.is_set() == false && kern == 0.0f64 { return; }
    var i: i64 = 0 as i64;
    let count: i64 = b.number_of_items();
    while i < count {
        match b.item_at_index(i) {
            option::Option[ak::MenuItem]::Some(item) => {
                let attrs: *u8 = paint::rich_attributes(
                    paint::ns_font_styled({ (*p).font_size }, { (*p).font_weight },
                                          { (*p).font_family.view() }, { (*p).is_italic }),
                    c, kern, 0.0f64, option::Option[vocab::TextAlign]::None,
                    vocab::TextDecoration::None);
                let a: *u8 = paint::attributed(item.title().view(), attrs);
                if a != (0 as *u8) {
                    { rt::msg_void_id(item.raw(), rt::sel(#str_ptr("setAttributedTitle:\0")), a) };
                    { rt::release(a) };
                }
            }
            option::Option[ak::MenuItem]::None => { }
        }
        i = i + (1 as i64);
    }
    return;
}

// ---- bordered ----------------------------------------------------------------
// MAUI's Border: a stroke around its content. A layer's border is the cheap
// way and it composes with the corner radius the shared band already applies.
// The dash/cap/join/miter family is CAShapeLayer territory and is recorded in
// MANIFEST.md rather than half-done.

fn create_bordered(n: *core::Node) -> *u8 {
    let v: ak::View = akx::new_flipped_view(rt::Rect { x: 0.0f64, y: 0.0f64, w: 0.0f64, h: 0.0f64 });
    v.set_wants_layer(true);
    return rt::retain(v.raw());
}

fn apply_bordered(v: *u8, n: *core::Node, dirty: u64) {
    let p: *props::BorderedProps = props_of(n, props::K_BORDERED) as *props::BorderedProps;
    if p == (0 as *props::BorderedProps) { return; }
    let view: ak::View = ak::View::from_raw(v);
    let stroke: u64 = bordered::P_STROKE | bordered::P_STROKE_WIDTH
        | bordered::P_STROKE_DASH | bordered::P_STROKE_DASH_OFFSET
        | bordered::P_STROKE_CAP | bordered::P_STROKE_JOIN
        | bordered::P_STROKE_MITER_LIMIT | bordered::P_STROKE_SHAPE;
    if (dirty & stroke) != (0 as u64) || dirty == paint::all_bits() {
        view.set_wants_layer(true);
        // A LAYER BORDER is one solid rectangle of one width — it has no dash,
        // no cap, no join and no shape. Everything past `stroke_width` needs a
        // PATH, so a node that asks for any of them gets a CAShapeLayer and one
        // that does not keeps the cheap border.
        if wants_shape(p) {
            observe_stroke_frame(view, n);
            apply_stroke_shape(view, p);
        } else { apply_plain_border(view, p); }
    }
    return;
}

fn wants_shape(p: *props::BorderedProps) -> bool {
    if { (*p).stroke_dash.count } > (0 as usize) { return true; }
    if { (*p).stroke_shape.kind } != (0 as i64) { return true; }
    return is_shaped_cap({ (*p).stroke_cap }) || is_shaped_join({ (*p).stroke_join });
}

// `Flat` and `Miter` are Core Animation's own defaults, so asking for either is
// not asking for a path — it is what a plain border already draws.
fn is_shaped_cap(c: vocab::LineCap) -> bool {
    return match c {
        vocab::LineCap::Flat => false,
        vocab::LineCap::Round => true,
        vocab::LineCap::Square => true,
    };
}

fn is_shaped_join(j: vocab::LineJoin) -> bool {
    return match j {
        vocab::LineJoin::Miter => false,
        vocab::LineJoin::Bevel => true,
        vocab::LineJoin::Round => true,
    };
}

fn apply_plain_border(view: ak::View, p: *props::BorderedProps) {
    remove_stroke_layer(view);
    let l: quartz::Layer = view.layer();
    l.set_border_width({ (*p).stroke_width });
    // A Brush is a gradient pair; a border takes one colour, so the start is
    // the stroke. A gradient border needs a CAGradientLayer mask — MANIFEST.
    let brush: vocab::Brush = { (*p).stroke };
    l.set_border_color(paint::ns_color(brush.start).c_g_color());
    return;
}

// ---- the stroke layer --------------------------------------------------------
// One CAShapeLayer per bordered node that needs one, kept as a SUBLAYER and
// sized with the view. Created on demand and torn down when the node stops
// asking, so a plain border still costs one layer rather than two.

fn stroke_layer_key() -> *u8 { return { 28760 as *u8 }; }

fn remove_stroke_layer(view: ak::View) {
    let l: *u8 = { synth::get_associated(view.raw(), stroke_layer_key()) };
    if l == (0 as *u8) { return; }
    { rt::msg_void(l, rt::sel(#str_ptr("removeFromSuperlayer\0"))) };
    synth::set_associated(view.raw(), stroke_layer_key(), 0 as *u8);
    return;
}

// Readers the suite asks with, so a test asserts the LAYER rather than the
// props that asked for it.
fn has_stroke_layer(view: ak::View) -> bool {
    return { synth::get_associated(view.raw(), stroke_layer_key()) } != (0 as *u8);
}

fn stroke_layer_of(view: ak::View) -> *u8 {
    return { synth::get_associated(view.raw(), stroke_layer_key()) };
}

fn stroke_layer(view: ak::View) -> quartz::ShapeLayer {
    let existing: *u8 = { synth::get_associated(view.raw(), stroke_layer_key()) };
    if existing != (0 as *u8) { return quartz::ShapeLayer::from_raw(existing); }
    let l: *u8 = { rt::alloc_init(#str_ptr("CAShapeLayer\0")) };
    if l == (0 as *u8) { return quartz::ShapeLayer::from_raw(0 as *u8); }
    { rt::msg_void_id(view.layer().raw(), rt::sel(#str_ptr("addSublayer:\0")), l) };
    synth::retain_associated(view.raw(), stroke_layer_key(), l);
    rt::release(l);
    return quartz::ShapeLayer::from_raw(l);
}

// A stroked path is geometry, and geometry is not known at create: the frame
// walk sizes the view AFTER the body runs, so a path built at create would be
// empty and a path built once would be wrong at the next size. The view is
// observed and re-pathed, once per resize.
fn observed_key() -> *u8 { return { 28761 as *u8 }; }

fn stroke_resized(ctx: *u8) {
    let n: *core::Node = ctx as *core::Node;
    if n == (0 as *core::Node) { return; }
    let v: *u8 = core::view_of(n);
    if v == (0 as *u8) { return; }
    let p: *props::BorderedProps = props_of(n, props::K_BORDERED) as *props::BorderedProps;
    if p == (0 as *props::BorderedProps) { return; }
    if wants_shape(p) == false { return; }
    apply_stroke_shape(ak::View::from_raw(v), p);
    return;
}

fn observe_stroke_frame(view: ak::View, n: *core::Node) {
    if { synth::get_associated(view.raw(), observed_key()) } != (0 as *u8) { return; }
    let f: fn(*u8) = stroke_resized;
    akx::observe_frame_change(view, f, n as *u8);
    synth::set_associated(view.raw(), observed_key(), 1 as *u8);
    return;
}

fn apply_stroke_shape(view: ak::View, p: *props::BorderedProps) {
    // The plain border must go, or the node draws two.
    view.layer().set_border_width(0.0f64);
    let sl: quartz::ShapeLayer = stroke_layer(view);
    if sl.raw() == (0 as *u8) { return; }
    let b: rt::Rect = view.bounds();
    { msg_void_rect(sl.raw(), rt::sel(#str_ptr("setFrame:\0")), b) };
    let path: *u8 = stroke_path(b, { (*p).stroke_shape }, { (*p).stroke_width });
    if path != (0 as *u8) {
        sl.set_path(path);
        { CGPathRelease(path) };
    }
    sl.set_fill_color(0 as *u8);
    let brush: vocab::Brush = { (*p).stroke };
    sl.set_stroke_color(paint::ns_color(brush.start).c_g_color());
    sl.set_line_width({ (*p).stroke_width });
    sl.set_line_cap(ca_line_cap({ (*p).stroke_cap }));
    sl.set_line_join(ca_line_join({ (*p).stroke_join }));
    sl.set_miter_limit({ (*p).stroke_miter_limit });
    sl.set_line_dash_phase({ (*p).stroke_dash_offset });
    let dashes: vocab::Dashes = { (*p).stroke_dash };
    var runs: vec::Vec[f64] = vec::new::[f64]();
    var i: usize = 0 as usize;
    while i < { dashes.count } {
        let _a: status::Status = runs.append({ dashes.runs[i] });
        i = i +% (1 as usize);
    }
    sl.set_line_dash_pattern(runs);
    return;
}

// The outline a `Shape` describes, INSET by half the stroke width — a stroked
// path is centred on the line, so a path on the bounds paints half of itself
// outside the view and is clipped to a half-width border.
fn stroke_path(b: rt::Rect, shape: vocab::Shape, width: f64) -> *u8 {
    let half: f64 = width / 2.0f64;
    let r: rt::Rect = rt::Rect { x: { b.x } + half, y: { b.y } + half,
                                 w: { b.w } - width, h: { b.h } - width };
    if { r.w } <= 0.0f64 || { r.h } <= 0.0f64 { return 0 as *u8; }
    let kind: i64 = { shape.kind };
    if kind == (3 as i64) { return { CGPathCreateWithEllipseInRect(r, 0 as *u8) }; }
    if kind == (2 as i64) {
        // Core Graphics has ONE corner radius per rounded rect; facet carries
        // four, so the largest wins — the same deviation `corner_radius` makes,
        // recorded in the same place.
        let rad: f64 = largest_corner({ shape.corners });
        return { CGPathCreateWithRoundedRect(r, rad, rad, 0 as *u8) };
    }
    return { CGPathCreateWithRect(r, 0 as *u8) };
}

// kCALineCap* / kCALineJoin* are string constants and the VALUES are the words.
fn ca_line_cap(c: vocab::LineCap) -> str {
    return match c {
        vocab::LineCap::Flat => "butt",
        vocab::LineCap::Round => "round",
        vocab::LineCap::Square => "square",
    };
}

fn ca_line_join(j: vocab::LineJoin) -> str {
    return match j {
        vocab::LineJoin::Miter => "miter",
        vocab::LineJoin::Bevel => "bevel",
        vocab::LineJoin::Round => "round",
    };
}

extern fn CGPathCreateWithRect(r: rt::Rect, transform: *u8) -> *u8;
extern fn CGPathCreateWithEllipseInRect(r: rt::Rect, transform: *u8) -> *u8;
extern fn CGPathCreateWithRoundedRect(r: rt::Rect, rx: f64, ry: f64, transform: *u8) -> *u8;
extern fn CGPathRelease(p: *u8);

#[link_name = "objc_msgSend"]
extern fn msg_void_rect(recv: *u8, sel: *u8, r: rt::Rect);

// ---- split -------------------------------------------------------------------
// Two panes and a draggable divider. NSSplitView arranges its own subviews, so
// facet's children go in through `add_arranged_subview` — which is why the
// split's host is itself but its insert order matters more than elsewhere.

fn create_split(n: *core::Node) -> *u8 {
    let s: ak::SplitView = ak::SplitView::from_raw(rt::alloc_init(#str_ptr("NSSplitView\0")));
    s.set_divider_style(ak::SplitViewDividerStyle::Thin);
    return rt::retain(s.as_view().raw());
}

fn apply_split(v: *u8, n: *core::Node, dirty: u64) {
    let p: *split::SplitProps = props_of(n, split::K_SPLIT) as *split::SplitProps;
    if p == (0 as *split::SplitProps) { return; }
    let s: ak::SplitView = ak::SplitView::from_raw(v);
    if (dirty & split::P_AXIS) != (0 as u64) {
        s.set_vertical(is_vertical_divider({ (*p).axis }));
    }
    // The delegate carries the minimums AND `on_move`: NSSplitView asks its
    // delegate where a divider may go, and tells it after one moved. Installed
    // on the first apply rather than at create, because a split with neither a
    // minimum nor a handler should not pay for a delegate at all.
    if (dirty & (split::P_MIN_LEADING | split::P_MIN_TRAILING | props::C_HANDLERS)) != (0 as u64)
        || dirty == paint::all_bits() {
        text_input::install_split(v, n);
    }
    // The divider position is written AFTER the minimums are known, and after
    // the panes exist: setting it on an empty split is a no-op AppKit does not
    // report. `position` is in points from the leading edge, which is exactly
    // `setPosition:ofDividerAtIndex:`.
    if (dirty & (split::P_POSITION | split::P_COLLAPSED)) != (0 as u64) {
        let panes: u64 = { rt::msg_u64({ rt::msg_id(v, rt::sel(#str_ptr("subviews\0"))) },
                                       rt::sel(#str_ptr("count\0"))) };
        if panes >= (2 as u64) {
            var want: f64 = { (*p).position };
            // A collapsed pane is a position at the very edge — AppKit has no
            // "collapse" verb, and a divider at 0 or at the far edge IS the
            // collapse it draws.
            if { (*p).collapsed_leading } { want = 0.0f64; }
            else if { (*p).collapsed_trailing } { want = split_extent(s); }
            if want > 0.0f64 || { (*p).collapsed_leading } {
                s.set_position(want, 0 as i64);
            }
        }
    }
    return;
}

// The length of the axis the divider slides along.
fn split_extent(s: ak::SplitView) -> f64 {
    let f: rt::Rect = s.as_view().frame();
    if s.is_vertical() { return { f.w }; }
    return { f.h };
}

// facet names the ARRANGEMENT (Columns = side by side); AppKit names the
// DIVIDER (`vertical` = a vertical divider, i.e. panes side by side). They
// agree here, but the two readings are one negation apart, and getting it
// backwards silently transposes every split in an app.
fn is_vertical_divider(a: split::SplitAxis) -> bool {
    return match a {
        split::SplitAxis::Columns => true,
        split::SplitAxis::Rows => false,
    };
}

// ---- page_dots ---------------------------------------------------------------
// MAUI's IndicatorView: the row of dots under a pager. AppKit ships nothing of
// the kind — NSPageController has no indicator — so this is drawn, and it is
// drawn as SUBLAYERS rather than by overriding drawRect:.
//
// Sublayers, because a dot is a rounded rectangle and Core Animation already
// draws those: no synthesized NSView subclass, no drawRect: bridge, and the
// dots re-tint on a theme change through the same apply the rest of the band
// uses. The layer row is rebuilt when the COUNT changes and re-tinted when the
// position does — a count change is rare and a position change is every page
// turn, so the two are deliberately not the same work.

fn create_page_dots(n: *core::Node) -> *u8 {
    let v: ak::View = akx::new_flipped_view(rt::Rect { x: 0.0f64, y: 0.0f64, w: 0.0f64, h: 0.0f64 });
    v.set_wants_layer(true);
    return rt::retain(v.raw());
}

// How many dots are actually drawn: the count, clamped by `max_dots`, and
// nothing at all when a single dot is hidden by `hides_single`.
fn visible_dot_count(p: *props::PageDotsProps) -> i64 {
    var count: i64 = { (*p).count };
    if count < (0 as i64) { count = 0 as i64; }
    let cap: i64 = { (*p).max_dots };
    if cap > (0 as i64) && count > cap { count = cap; }
    if count == (1 as i64) && { (*p).hides_single } { return 0 as i64; }
    return count;
}

fn apply_page_dots(v: *u8, n: *core::Node, dirty: u64) {
    let p: *props::PageDotsProps = props_of(n, props::K_PAGE_DOTS) as *props::PageDotsProps;
    if p == (0 as *props::PageDotsProps) { return; }
    let view: ak::View = ak::View::from_raw(v);
    view.set_wants_layer(true);
    let host: quartz::Layer = view.layer();
    let want: i64 = visible_dot_count(p);
    let size: f64 = dot_size_of(p);
    let gap: f64 = size * 0.8f64;

    if (dirty & (page_dots::P_COUNT | page_dots::P_MAX_DOTS | page_dots::P_HIDES_SINGLE
                 | page_dots::P_DOT_SIZE | page_dots::P_DOT_SHAPE)) != (0 as u64) {
        rebuild_dots(host, want, size, { (*p).dot_shape }, gap);
    }
    // Re-tinting is every page turn; rebuilding is not. Kept apart on purpose.
    if (dirty & (page_dots::P_POSITION | page_dots::P_DOT_COLOR
                 | page_dots::P_SELECTED_DOT_COLOR | page_dots::P_COUNT)) != (0 as u64) {
        tint_dots(host, want, { (*p).position }, { (*p).dot_color }, { (*p).selected_dot_color });
    }
    return;
}

fn dot_size_of(p: *props::PageDotsProps) -> f64 {
    let s: f64 = { (*p).dot_size };
    if s > 0.0f64 { return s; }
    return 7.0f64;                  // the platform's own indicator metric
}

fn rebuild_dots(host: quartz::Layer, count: i64, size: f64, shape: vocab::DotShape, gap: f64) {
    // Drop what is there. A row of dots is single digits long, so a rebuild is
    // cheaper than reconciling it.
    host.set_sublayers(vec::new::[quartz::Layer]());
    let radius: f64 = match shape {
        vocab::DotShape::Circle => size / 2.0f64,
        vocab::DotShape::Square => 0.0f64,
    };
    var i: i64 = 0 as i64;
    while i < count {
        let dot: quartz::Layer = quartz::Layer::new();
        dot.set_frame(rt::Rect {
            x: (i as f64) * (size + gap),
            y: 0.0f64,
            w: size,
            h: size,
        });
        dot.set_corner_radius(radius);
        host.add_sublayer(dot);
        i = i +% (1 as i64);
    }
    return;
}

fn tint_dots(host: quartz::Layer, count: i64, position: i64,
             dot: vocab::Color, selected: vocab::Color) {
    let subs: vec::Vec[quartz::Layer] = host.sublayers();
    var i: usize = 0 as usize;
    let n: usize = subs.count();
    while i < n {
        match subs.at_ptr(i) {
            option::Option[*quartz::Layer]::Some(l) => {
                let is_current: bool = (i as i64) == position;
                var c: vocab::Color = dot;
                if is_current { c = selected; }
                // An unset colour falls to the platform's own tiers rather
                // than to black: a page indicator nobody themed should still
                // read as one.
                if c.is_set() == false {
                    if is_current { c = vocab::Color::text(); } else { c = vocab::Color::text_tertiary(); }
                }
                { (*l).set_background_color(paint::ns_color(c).c_g_color()) };
            }
            option::Option[*quartz::Layer]::None => { }
        }
        i = i +% (1 as usize);
    }
    return;
}

// ---- dates -------------------------------------------------------------------
// facet's `Date` is {year, month, day} — a CIVIL date, not an instant.
// NSDatePicker wants an NSDate, which is an instant. Bridging the two is a
// question of which calendar and whose time zone, and the answer follows from
// what facet's type actually means:
//
//   the proleptic Gregorian calendar, and the picker pinned to UTC.
//
// Pinning is the load-bearing half. A civil date has no time zone, so if the
// picker rendered it in the machine's local zone, 2026-01-01 fed in west of
// Greenwich would come back reading 2025-12-31 — the value would not survive
// its own round trip. Pinned to UTC, what goes in is what is shown and what
// comes back.
//
// The conversion is arithmetic rather than NSCalendar: days-from-civil is
// exact, total, and has no notion of a locale to disagree with.

fn seconds_per_day() -> f64 { return 86400.0f64; }

// Days from 1970-01-01 to y-m-d in the proleptic Gregorian calendar. Exact for
// every year the type can hold; the shift-the-year-to-March trick is what
// makes the leap-day case fall out instead of being special-cased.
fn days_from_civil(y_in: i64, m: i64, d: i64) -> i64 {
    var y: i64 = y_in;
    if m <= (2 as i64) { y = y -% (1 as i64); }
    var era: i64 = y / (400 as i64);
    if y < (0 as i64) { era = (y -% (399 as i64)) / (400 as i64); }
    let yoe: i64 = y -% era * (400 as i64);                       // [0, 399]
    var mp: i64 = m +% (9 as i64);
    if m > (2 as i64) { mp = m -% (3 as i64); }
    let doy: i64 = ((153 as i64) * mp +% (2 as i64)) / (5 as i64) +% d -% (1 as i64);
    let doe: i64 = yoe * (365 as i64) +% yoe / (4 as i64) -% yoe / (100 as i64) +% doy;
    return era * (146097 as i64) +% doe -% (719468 as i64);
}

// An NSDate at UTC midnight on that civil date. A zeroed Date (year 0) means
// "unset", and answers a null NSDate so a caller can leave the picker alone.
fn ns_date(d: vocab::Date) -> *u8 {
    if d.year == (0 as i64) { return 0 as *u8; }
    let secs: f64 = (days_from_civil(d.year, d.month, d.day) as f64) * seconds_per_day();
    return { rt::msg_id_f64(rt::get_class(#str_ptr("NSDate\0")),
                            rt::sel(#str_ptr("dateWithTimeIntervalSince1970:\0")), secs) };
}

// A duration into the same space: the epoch day, offset by the time of day.
// facet's TimePicker carries a Duration because a time of day IS an offset
// into a day, which is the one reading that does not need a calendar.
fn ns_time(t: vocab::Duration) -> *u8 {
    return { rt::msg_id_f64(rt::get_class(#str_ptr("NSDate\0")),
                            rt::sel(#str_ptr("dateWithTimeIntervalSince1970:\0")), t.seconds) };
}

fn utc_time_zone() -> option::Option[ak::TimeZone] {
    let tz: *u8 = { rt::msg_id_id(rt::get_class(#str_ptr("NSTimeZone\0")),
                                  rt::sel(#str_ptr("timeZoneWithAbbreviation:\0")),
                                  bridge::nsstring("UTC")) };
    if tz == (0 as *u8) { return option::Option[ak::TimeZone]::None; }
    return option::some(ak::TimeZone::from_raw(tz));
}

fn pin_picker_to_utc(dp: ak::DatePicker) {
    match utc_time_zone() {
        option::Option[ak::TimeZone]::Some(tz) => { dp.set_time_zone(tz); }
        option::Option[ak::TimeZone]::None => { }
    }
    return;
}

// ---- date_picker -------------------------------------------------------------

fn create_date_picker(n: *core::Node) -> *u8 {
    let dp: ak::DatePicker = ak::DatePicker::from_raw(rt::alloc_init(#str_ptr("NSDatePicker\0")));
    dp.set_date_picker_style(ak::DatePickerStyle::TextFieldAndStepper);
    dp.set_date_picker_elements(ak::date_picker_element_flags_n_s_date_picker_element_flag_year_month_day);
    pin_picker_to_utc(dp);
    return rt::retain(dp.as_view().raw());
}

fn apply_date_picker(v: *u8, n: *core::Node, dirty: u64) {
    let p: *props::DatePickerProps = props_of(n, props::K_DATE_PICKER) as *props::DatePickerProps;
    if p == (0 as *props::DatePickerProps) { return; }
    let dp: ak::DatePicker = ak::DatePicker::from_raw(v);
    // The bounds go on before the value, the same trap the slider has: a date
    // outside the OLD range is clamped away and the write is lost.
    if (dirty & date_picker::P_MINIMUM_DATE) != (0 as u64) {
        let lo: *u8 = ns_date({ (*p).minimum_date });
        if lo != (0 as *u8) { dp.set_min_date(ak::Date::from_raw(lo)); }
    }
    if (dirty & date_picker::P_MAXIMUM_DATE) != (0 as u64) {
        let hi: *u8 = ns_date({ (*p).maximum_date });
        if hi != (0 as *u8) { dp.set_max_date(ak::Date::from_raw(hi)); }
    }
    if (dirty & (date_picker::P_DATE | date_picker::P_MINIMUM_DATE | date_picker::P_MAXIMUM_DATE)) != (0 as u64) {
        let d: *u8 = ns_date({ (*p).date });
        if d != (0 as *u8) { dp.set_date_value(ak::Date::from_raw(d)); }
    }
    if (dirty & (date_picker::P_FONT_SIZE | date_picker::P_FONT_WEIGHT
                 | date_picker::P_FONT_FAMILY | date_picker::P_IS_ITALIC)) != (0 as u64) {
        match paint::ns_font_styled({ (*p).font_size }, { (*p).font_weight },
                                    { (*p).font_family.view() }, { (*p).is_italic }) {
            option::Option[ak::Font]::Some(font) => { dp.as_control().set_font(font); }
            option::Option[ak::Font]::None => { }
        }
    }
    if (dirty & date_picker::P_TEXT_COLOR) != (0 as u64) {
        let c: vocab::Color = { (*p).text_color };
        if c.is_set() { dp.set_text_color(paint::ns_color(c)); }
    }
    if (dirty & props::C_HANDLERS) != (0 as u64) || dirty == paint::all_bits() {
        akx::set_control_action_ctx(dp.as_control(), { (*p).on_date_selected }, { (*p).on_date_selected_ctx });
    }
    if (dirty & props::C_IS_ENABLED) != (0 as u64) || dirty == paint::all_bits() {
        dp.as_control().set_enabled(core::is_enabled(n));
    }
    return;
}

// ---- time_picker -------------------------------------------------------------
// The same class in its hour/minute posture.

fn create_time_picker(n: *core::Node) -> *u8 {
    let dp: ak::DatePicker = ak::DatePicker::from_raw(rt::alloc_init(#str_ptr("NSDatePicker\0")));
    dp.set_date_picker_style(ak::DatePickerStyle::TextFieldAndStepper);
    dp.set_date_picker_elements(ak::date_picker_element_flags_n_s_date_picker_element_flag_hour_minute);
    pin_picker_to_utc(dp);
    return rt::retain(dp.as_view().raw());
}

fn apply_time_picker(v: *u8, n: *core::Node, dirty: u64) {
    let p: *props::TimePickerProps = props_of(n, props::K_TIME_PICKER) as *props::TimePickerProps;
    if p == (0 as *props::TimePickerProps) { return; }
    let dp: ak::DatePicker = ak::DatePicker::from_raw(v);
    if (dirty & time_picker::P_TIME) != (0 as u64) {
        dp.set_date_value(ak::Date::from_raw(ns_time({ (*p).time })));
    }
    if (dirty & (time_picker::P_FONT_SIZE | time_picker::P_FONT_WEIGHT
                 | time_picker::P_FONT_FAMILY | time_picker::P_IS_ITALIC)) != (0 as u64) {
        match paint::ns_font_styled({ (*p).font_size }, { (*p).font_weight },
                                    { (*p).font_family.view() }, { (*p).is_italic }) {
            option::Option[ak::Font]::Some(font) => { dp.as_control().set_font(font); }
            option::Option[ak::Font]::None => { }
        }
    }
    if (dirty & time_picker::P_TEXT_COLOR) != (0 as u64) {
        let c: vocab::Color = { (*p).text_color };
        if c.is_set() { dp.set_text_color(paint::ns_color(c)); }
    }
    if (dirty & props::C_HANDLERS) != (0 as u64) || dirty == paint::all_bits() {
        akx::set_control_action_ctx(dp.as_control(), { (*p).on_time_selected }, { (*p).on_time_selected_ctx });
    }
    if (dirty & props::C_IS_ENABLED) != (0 as u64) || dirty == paint::all_bits() {
        dp.as_control().set_enabled(core::is_enabled(n));
    }
    return;
}

// ---- tabs --------------------------------------------------------------------
// NSTabView. Its children are not subviews but NSTabViewItems, each wrapping
// one view — so `views::insert` wraps a pane as it arrives rather than adding
// it as a subview, which is the same shape as the scroll's document host: the
// one place a kind's native child model differs from "add a subview".
//
// The pane's LABEL is its key. A tab needs a title, facet's tree gives every
// addressable node one, and inventing a second title prop for the same node
// would be the drift this package is written against.

fn create_tabs(n: *core::Node) -> *u8 {
    let tv: ak::TabView = ak::TabView::from_raw(rt::alloc_init(#str_ptr("NSTabView\0")));
    return rt::retain(tv.as_view().raw());
}

fn apply_tabs(v: *u8, n: *core::Node, dirty: u64) {
    // The five bar props (bar_background, bar_background_color, bar_text_color,
    // selected_tab_color, unselected_tab_color) have no NSTabView equivalent —
    // the tab strip is system-drawn. Recorded in MANIFEST.md.
    return;
}

// Wrap `pane` as a tab of `host`, labelled `label`. Called from views::insert
// when the host is an NSTabView.
fn tabs_add_pane(host: *u8, pane: *u8, label: str) {
    let tv: ak::TabView = ak::TabView::from_raw(host);
    let item: ak::TabViewItem = ak::TabViewItem::new(0 as *u8);
    item.set_view(ak::View::from_raw(pane));
    if label != "" { item.set_label(label); }
    tv.add_tab_view_item(item);
    return;
}

// ---- context_menu ------------------------------------------------------------
// The first NON-VIEW kind, and the shape is worth stating because the rest of
// the menu tier will follow it.
//
// An NSMenu is not an NSView. A `context_menu` node decorates the node it sits
// under — right-clicking the PARENT is what opens it — so it has no place of
// its own in the view tree and no frame. Its `context_menu_item` children are
// likewise not views.
//
// So both answer `wants_view` with false and `create` never runs on them. The
// menu is built instead from the NODES, at the moment the PARENT's view is
// created, and hung on that view — which is exactly what AppKit's
// `NSView.menu` is for. `views::create` calls `attach_context_menu` after it
// has a view for a node, so the walk order works out: the child nodes are
// already in the tree (build ran long before mount), even though no view
// exists for them and none ever will.
//
// This is also the macOS answer to the swipe-to-reveal actions MANIFEST.md
// records as impossible: a right-click menu IS the platform's per-row action
// affordance, and it has a keyboard path, which a swipe never does.

fn menu_kind(kind: u32) -> bool {
    return kind == props::K_CONTEXT_MENU || kind == props::K_CONTEXT_MENU_ITEM;
}

// facet's portable modifier enum onto NSEventModifierFlags.
fn ns_modifier_mask(m: vocab::KeyModifiers) -> u64 {
    return match m {
        vocab::KeyModifiers::Cmd => 1048576 as u64,       // NSEventModifierFlagCommand
        vocab::KeyModifiers::Shift => 131072 as u64,      // ...Shift
        vocab::KeyModifiers::Ctrl => 262144 as u64,       // ...Control
        vocab::KeyModifiers::Alt => 524288 as u64,        // ...Option
        // Windows has no macOS counterpart; Command is the nearest meaning and
        // is what a cross-platform app means by "the platform's own modifier".
        vocab::KeyModifiers::Windows => 1048576 as u64,
        vocab::KeyModifiers::None => 0 as u64,
    };
}

// Build the NSMenu a `context_menu` node describes. Returns 0 for a node that
// is not one, so the caller can ask unconditionally.
fn build_context_menu(n: *core::Node) -> *u8 {
    if core::kind_of(n) != props::K_CONTEXT_MENU { return 0 as *u8; }
    let menu: ak::Menu = ak::Menu::new("");
    var i: usize = 0 as usize;
    let count: usize = core::child_count_of(n);
    while i < count {
        match core::child_of(n, i) {
            option::Option[*core::Node]::Some(c) => { add_menu_item(menu, c); }
            option::Option[*core::Node]::None => { }
        }
        i = i +% (1 as usize);
    }
    return rt::retain(menu.raw());
}

fn add_menu_item(menu: ak::Menu, c: *core::Node) {
    let p: *props::ContextMenuItemProps =
        props_of(c, props::K_CONTEXT_MENU_ITEM) as *props::ContextMenuItemProps;
    if p == (0 as *props::ContextMenuItemProps) { return; }
    let mi: *props::MenuItemProps = { #addr_of((*p).menu_item) };
    let title: str = { (*mi).text.view() };
    // An item with no title is a separator: MAUI has no separator type, and a
    // titleless item is what every menu-building API in the world means by one.
    if title == "" {
        menu.add_item(ak::MenuItem::separator_item());
        return;
    }
    let item: ak::MenuItem = ak::MenuItem::new(title, 0 as *u8, "");
    // The key equivalent, which is the whole reason context_menu_item declares
    // a row of its own on top of the MenuItem band.
    let key: str = { (*p).shortcut_key.view() };
    if key != "" {
        item.set_key_equivalent(key);
        item.set_key_equivalent_modifier_mask(ns_modifier_mask({ (*p).shortcut_modifiers }));
    }
    let icon: str = { (*mi).icon.view() };
    if icon != "" {
        match resolve_image(icon) {
            option::Option[ak::Image]::Some(img) => { item.set_image(img); }
            option::Option[ak::Image]::None => { }
        }
    }
    // The handler rides the same target trampoline every control action uses,
    // so a menu click and a button click arrive by one path.
    let h: fn(*u8, *u8) = { (*mi).on_clicked };
    if h != props::no_handler {
        item.set_target(akx::action_ctx_target(h, { (*mi).on_clicked_ctx }));
        item.set_action(akx::action_ctx_sel());
    }
    // is_destructive has no NSMenuItem equivalent — recorded in MANIFEST.md.
    item.set_enabled(core::is_enabled(c));
    menu.add_item(item);
    return;
}

// Hang the context menu a node's children describe on that node's view. Called
// from `views::create` once the view exists.
fn attach_context_menu(view: *u8, n: *core::Node) {
    if view == (0 as *u8) { return; }
    var i: usize = 0 as usize;
    let count: usize = core::child_count_of(n);
    while i < count {
        match core::child_of(n, i) {
            option::Option[*core::Node]::Some(c) => {
                let menu: *u8 = build_context_menu(c);
                if menu != (0 as *u8) {
                    { rt::msg_void_id(view, rt::sel(#str_ptr("setMenu:\0")), menu) };
                    return;                     // one context menu per node
                }
            }
            option::Option[*core::Node]::None => { }
        }
        i = i +% (1 as usize);
    }
    return;
}

// ---- span --------------------------------------------------------------------
// A styled RUN inside a label, not a thing of its own — so, like the menu
// kinds, it is not a view. A label with span children renders an attributed
// string built from them; a label with none renders its own `text`.
//
// This is why `span` has no create and no apply: it has nothing to apply ONTO.
// It is read as a node by the label that contains it, in `label_runs` below.

fn span_kind(kind: u32) -> bool { return kind == props::K_SPAN; }

// Does this label carry span children? A label that does uses them INSTEAD of
// its own text — a formatted label's text is the runs.
fn has_spans(n: *core::Node) -> bool {
    var i: usize = 0 as usize;
    let count: usize = core::child_count_of(n);
    while i < count {
        match core::child_of(n, i) {
            option::Option[*core::Node]::Some(c) => {
                if core::kind_of(c) == props::K_SPAN { return true; }
            }
            option::Option[*core::Node]::None => { }
        }
        i = i +% (1 as usize);
    }
    return false;
}

// The attributed string a label's span children describe, at +1.
fn build_runs(n: *core::Node) -> *u8 {
    let ms: *u8 = { rt::alloc_init(#str_ptr("NSMutableAttributedString\0")) };
    if ms == (0 as *u8) { return 0 as *u8; }
    var i: usize = 0 as usize;
    let count: usize = core::child_count_of(n);
    while i < count {
        match core::child_of(n, i) {
            option::Option[*core::Node]::Some(c) => { append_run(ms, c); }
            option::Option[*core::Node]::None => { }
        }
        i = i +% (1 as usize);
    }
    return ms;
}

fn append_run(ms: *u8, c: *core::Node) {
    let p: *props::SpanProps = props_of(c, props::K_SPAN) as *props::SpanProps;
    if p == (0 as *props::SpanProps) { return; }
    let shown: text::Text = paint::transformed({ (*p).text.view() }, { (*p).text_transform });
    // Attributes for THIS run only: a span that names nothing inherits the
    // label's own font and colour, which is what an unstyled run should do.
    // Every one of them comes from the shared builder, so a span's styling
    // band is the same band a label, a button and an input field get.
    let attrs: *u8 = paint::rich_attributes(
        paint::ns_font_styled({ (*p).font_size }, { (*p).font_weight },
                              { (*p).font_family.view() }, { (*p).is_italic }),
        { (*p).text_color }, { (*p).character_spacing }, { (*p).line_height },
        option::Option[vocab::TextAlign]::None, { (*p).text_decoration });
    let run: *u8 = paint::attributed(shown.view(), attrs);
    if run != (0 as *u8) {
        { rt::msg_void_id(ms, rt::sel(#str_ptr("appendAttributedString:\0")), run) };
        { rt::release(run) };
    }
    return;
}

// ---- the recorded "AppKit cannot" kinds --------------------------------------
// refreshable, swipeable and swipe_item are decided, not missing: pull-to-
// refresh and swipe-to-reveal are touch idioms with no macOS equivalent, and
// MANIFEST.md says so with what to use instead.
//
// They still get a body, and it matters that they do. A recorded decision must
// not go down the unimplemented path, because that path WARNS — and a warning
// for something already answered would train a reader to ignore the warnings
// that mean something. So: a plain backing view, silently, and the children
// inside it render exactly as they would have. A `swipeable` shows its content
// and simply reveals nothing; a `refreshable` shows its content and simply
// never pulls.

fn create_passthrough(n: *core::Node) -> *u8 {
    let v: ak::View = akx::new_flipped_view(rt::Rect { x: 0.0f64, y: 0.0f64, w: 0.0f64, h: 0.0f64 });
    return rt::retain(v.raw());
}

fn decided_absent(kind: u32) -> bool {
    return kind == props::K_REFRESHABLE || kind == props::K_SWIPEABLE
        || kind == props::K_SWIPE_ITEM;
}

// ---- the collection group ----------------------------------------------------
// list, collection, table, carousel, tree — every kind whose content is a
// SEQUENCE rather than a fixed set of children.
//
// The shape here is one decision, and it is worth stating because it is not
// the obvious one. AppKit's answer is NSTableView with a data source: the
// table asks for row `i` when it needs it, and recycles the views it is done
// with. That means a synthesized delegate class, a mount-within-a-mount for
// each cell, and a cache keyed by row.
//
// This does something simpler and, for facet, more honest: A LIST MATERIALISES
// ITS ROWS AS CHILDREN OF ITSELF. `row(ctx, i)` is called for each i, and the
// resulting Node is added to the list node with the ordinary structural verb.
// From there facet's own machinery does everything — mount creates the views,
// insert puts them in the scroll's document view, the frame walk places them,
// and node teardown releases them. There is no second lifetime model, no
// per-cell registry, and no path a row can take that an ordinary child cannot.
//
// The cost is that a list builds every row up front rather than the visible
// ones. That is a real limit and MANIFEST.md records it: the pre-regen
// backend's recycling NSTableView exists and is the upgrade, and it is worth
// doing when a consumer actually has ten thousand rows. It is NOT worth
// inventing a second, parallel mount path before then.
//
// Materialising happens in `apply` ONLY, and the walk order is what makes the
// first pass work: `views::create` calls `apply_<kind>` with an all-ones dirty
// word before returning, and mount_walk reads `child_count_of(n)` only AFTER
// create returns — so rows built during that first apply are mounted by the
// same walk, with no second pass and no second code path.

// Drop every row this control materialised. `remove_child` takes the native
// views out through the Renderer and fires the detach handlers, so a rebuilt
// list leaves nothing of the old one behind.
fn clear_rows(n: *core::Node) {
    while core::child_count_of(n) > (0 as usize) {
        let _gone: option::Option[core::Node] = mount::remove_child(n, 0 as usize);
    }
    return;
}

// Add one row. During `create` the node is not attached yet and the walk will
// mount what it finds; afterwards `mount::add_child` mounts it immediately.
// Both go through the same verb, so there is one code path either way.
fn add_row(n: *core::Node, take row: core::Node) {
    let _ok: bool = mount::add_child(n, row);
    return;
}

fn fill_rows(n: *core::Node, count: i64, builder: fn(*u8, usize) -> flex::Node, ctx: *u8) {
    clear_rows(n);
    if builder == (0 as fn(*u8, usize) -> flex::Node) { return; }
    var i: i64 = 0 as i64;
    while i < count {
        add_row(n, builder(ctx, i as usize));
        i = i +% (1 as i64);
    }
    return;
}

// A scroll host for a sequence: the same flipped document view a `scroll` uses,
// so `views::host_for` redirects children into it with no extra case.
fn create_sequence_host(horizontal: bool) -> *u8 {
    let s: ak::ScrollView = ak::ScrollView::from_raw(rt::alloc_init(#str_ptr("NSScrollView\0")));
    let doc: ak::View = akx::new_flipped_view(rt::Rect { x: 0.0f64, y: 0.0f64, w: 0.0f64, h: 0.0f64 });
    s.set_document_view(doc);
    s.set_draws_background(false);
    if horizontal {
        s.set_has_horizontal_scroller(true);
    } else {
        s.set_has_vertical_scroller(true);
    }
    return rt::retain(s.as_view().raw());
}

// ---- list --------------------------------------------------------------------

// NOTE the absence of a materialise call. `views::create` calls
// `apply_<kind>` with an all-ones dirty word straight after this, so the rows
// are built exactly once, by the same code that rebuilds them later. Doing it
// here as well built every row twice — the first set cleared by the second.
// That is the create-calls-apply rule paying for itself.
fn create_list(n: *core::Node) -> *u8 { return create_sequence_host(false); }

fn materialise_list(n: *core::Node) {
    let p: *props::ListProps = props_of(n, props::K_LIST) as *props::ListProps;
    if p == (0 as *props::ListProps) { return; }
    fill_rows(n, { (*p).count }, { (*p).row }, { (*p).row_ctx });
    return;
}

fn apply_list(v: *u8, n: *core::Node, dirty: u64) {
    // The row builder and the count are one question: either changes the whole
    // sequence, and a partial answer would leave rows from two models mixed.
    if (dirty & (list::P_COUNT | list::P_ROW)) != (0 as u64) { materialise_list(n); }
    return;
}

// ---- collection --------------------------------------------------------------
// MAUI's CollectionView. The same sequence, and on this backend the same
// treatment — the layout differences MAUI expresses through ItemsLayout are
// flex's job here, on the rows themselves.

fn create_collection(n: *core::Node) -> *u8 { return create_sequence_host(false); }

fn materialise_collection(n: *core::Node) {
    let p: *props::CollectionProps = props_of(n, props::K_COLLECTION) as *props::CollectionProps;
    if p == (0 as *props::CollectionProps) { return; }
    fill_rows(n, { (*p).count }, { (*p).row }, { (*p).row_ctx });
    return;
}

fn apply_collection(v: *u8, n: *core::Node, dirty: u64) {
    if (dirty & (collection::P_COUNT | collection::P_ROW)) != (0 as u64) { materialise_collection(n); }
    let p: *props::CollectionProps = props_of(n, props::K_COLLECTION) as *props::CollectionProps;
    if p == (0 as *props::CollectionProps) { return; }
    let iv: *props::ItemsViewProps = { #addr_of((*p).items_view) };
    if (dirty & (collection::P_VERTICAL_SCROLL_BARS | collection::P_HORIZONTAL_SCROLL_BARS)) != (0 as u64) {
        apply_sequence_scrollers(v, { (*iv).vertical_scroll_bars }, { (*iv).horizontal_scroll_bars });
    }
    if (dirty & collection::P_SCROLL_TO) != (0 as u64) {
        scroll_child_into_view(v, n, { (*iv).scroll_to_index });
    }
    return;
}

// The scrollers on a materialising sequence. A `list` answers this on its
// table; a collection and a carousel are a plain scroll of their children, so
// the scroll view IS the node's view.
fn apply_sequence_scrollers(v: *u8, vert: vocab::ScrollBars, horiz: vocab::ScrollBars) {
    let sv: ak::ScrollView = ak::ScrollView::from_raw(v);
    sv.set_has_vertical_scroller(shows_bars(vert));
    sv.set_has_horizontal_scroller(shows_bars(horiz));
    return;
}

// `scroll_to(index)` on a materialised sequence: the child's frame is flex's
// already, so this needs no measurement of its own. Out of range is a no-op
// rather than a clamp — scrolling to a row that does not exist is a mistake,
// and pretending it meant the last one would hide it.
fn scroll_child_into_view(v: *u8, n: *core::Node, index: i64) {
    if index < (0 as i64) { return; }
    match core::child_of(n, index as usize) {
        option::Option[*core::Node]::Some(child) => {
            let f: flex::Frame = { (*child).frame() };
            match ak::ScrollView::from_raw(v).document_view() {
                option::Option[ak::View]::Some(doc) => {
                    doc.scroll_point(rt::Point { x: f.left, y: f.top });
                }
                option::Option[ak::View]::None => { }
            }
        }
        option::Option[*core::Node]::None => { }
    }
    return;
}

// ---- table -------------------------------------------------------------------
// MAUI's TableView is a STATIC form, not a data-bound sequence: its rows are
// written out, so they are already this node's children and nothing needs
// materialising. It is a scroll of what it was given.

fn create_table(n: *core::Node) -> *u8 { return create_sequence_host(false); }

fn apply_table(v: *u8, n: *core::Node, dirty: u64) { return; }

// ---- carousel ----------------------------------------------------------------
// A sequence laid along the horizontal axis. The pages are its children, like
// a table's rows; `position` is which one is showing, which on a scroll view
// is a scroll offset rather than a selection.

fn create_carousel(n: *core::Node) -> *u8 { return create_sequence_host(true); }

fn apply_carousel(v: *u8, n: *core::Node, dirty: u64) {
    let p: *props::CarouselProps = props_of(n, props::K_CAROUSEL) as *props::CarouselProps;
    if p == (0 as *props::CarouselProps) { return; }
    if (dirty & carousel::P_POSITION) != (0 as u64) {
        // Scroll the page at `position` to the leading edge. Its frame is
        // flex's, so this needs no measurement of its own.
        match core::child_of(n, { (*p).position } as usize) {
            option::Option[*core::Node]::Some(page) => {
                let f: flex::Frame = { (*page).frame() };
                match ak::ScrollView::from_raw(v).document_view() {
                    option::Option[ak::View]::Some(doc) => {
                        doc.scroll_point(rt::Point { x: f.left, y: f.top });
                    }
                    option::Option[ak::View]::None => { }
                }
            }
            option::Option[*core::Node]::None => { }
        }
    }
    let iv: *props::ItemsViewProps = { #addr_of((*p).items_view) };
    if (dirty & (carousel::P_VERTICAL_SCROLL_BARS | carousel::P_HORIZONTAL_SCROLL_BARS)) != (0 as u64) {
        apply_sequence_scrollers(v, { (*iv).vertical_scroll_bars }, { (*iv).horizontal_scroll_bars });
    }
    if (dirty & carousel::P_SCROLL_TO) != (0 as u64) {
        scroll_child_into_view(v, n, { (*iv).scroll_to_index });
    }
    return;
}

// ---- tree --------------------------------------------------------------------
// A hierarchy rather than a sequence, and the one place the model is facet's
// own: `TreeProps.root` is a TreeNode graph with stable ids, and `expanded`
// says which of them are open.
//
// Materialised the same way, walked depth-first, and only through OPEN nodes —
// a closed branch contributes nothing, which is what makes a deep tree cheap
// even under the build-everything rule above. Depth becomes leading padding on
// the row, because indentation IS layout and layout is flex's.

fn create_tree(n: *core::Node) -> *u8 { return create_sequence_host(false); }

fn indent_step() -> f64 { return 16.0f64; }

fn materialise_tree(n: *core::Node) {
    let p: *tree::TreeProps = props_of(n, tree::K_TREE) as *tree::TreeProps;
    if p == (0 as *tree::TreeProps) { return; }
    clear_rows(n);
    let root: *tree::TreeNode = { #addr_of((*p).root) };
    // The root itself is the container, not a row: a tree shows its CHILDREN.
    emit_branch(n, root, p, 0 as i64, true);
    return;
}

// `parent_open` is what stops a closed branch costing anything: the walk does
// not descend through it at all.
fn emit_branch(host: *core::Node, node: *tree::TreeNode, p: *tree::TreeProps,
               depth: i64, is_root: bool) {
    if !is_root {
        var row: core::Node = build_tree_row(node, p);
        // Indentation IS layout, so it is flex's — a leading pad, not a
        // backend-drawn gutter.
        row.set_padding(flex::Edge::Left, flex::StyleLength::points((depth as f64) * indent_step()));
        add_row(host, row);
        if !is_expanded(p, node) { return; }
    }
    var i: usize = 0 as usize;
    let count: usize = { (*node).child_count() };
    while i < count {
        match { (*node).child_ptr(i) } {
            option::Option[*tree::TreeNode]::Some(c) => {
                var next: i64 = depth;
                if !is_root { next = depth +% (1 as i64); }
                emit_branch(host, c, p, next, false);
            }
            option::Option[*tree::TreeNode]::None => { }
        }
        i = i +% (1 as usize);
    }
    return;
}

fn is_expanded(p: *tree::TreeProps, node: *tree::TreeNode) -> bool {
    let id: str = { (*node).id.view() };
    if id == "" { return false; }
    let ex: *vocab::TextList = { #addr_of((*p).expanded) };
    var i: usize = 0 as usize;
    let n: usize = { (*ex).count() };
    while i < n {
        if { (*ex).at(i) } == id { return true; }
        i = i +% (1 as usize);
    }
    return false;
}

// The application's row builder, or a plain label of the node's own text when
// it gave none — a tree with no builder still shows its shape.
fn build_tree_row(node: *tree::TreeNode, p: *tree::TreeProps) -> core::Node {
    let f: fn(*tree::TreeNode, *u8) -> flex::Node = { (*p).row };
    // Compared against `no_row`, NOT against null. The default is a real
    // function that answers an empty node, so a null check is never false and
    // the fallback below never ran — a tree with no row builder rendered a
    // column of empty rows and the line that says otherwise was decoration.
    if f != tree::no_row { return f(node, { (*p).ctx }); }
    return plain_tree_row(node);
}

// A tree with no row builder still shows its shape: the node's own text, keyed
// by its identity. Shared with the recycling outline view, which asks the same
// question and must not answer it differently.
fn plain_tree_row(node: *tree::TreeNode) -> core::Node {
    return label::label({ (*node).label.view() }, key: { (*node).id.view() });
}

fn apply_tree(v: *u8, n: *core::Node, dirty: u64) {
    // Expansion changes WHICH rows exist, so it rebuilds like the model does.
    if (dirty & (tree::P_ROOT | tree::P_ROW | tree::P_EXPANDED)) != (0 as u64) {
        materialise_tree(n);
    }
    return;
}

// ---- window_buttons ----------------------------------------------------------
// The close / minimise / zoom group, re-parented into the application's own
// titlebar. The REAL buttons, not a drawing of them — so the green button
// keeps its hover menu and its full-screen behaviour, which a redrawn set
// would silently lose.
//
// They can only be fetched once the view is in a window, and a view is not in
// one when `create` runs. So the adoption happens in `apply`, which the sync
// tick calls after the window is up; until then the node is an empty box of
// the right size, which is what it should be.

fn window_buttons_key() -> *u8 { return 29011 as *u8; }

fn adopt_window_buttons(v: *u8, n: *core::Node) {
    // Once only: re-parenting an already-adopted button would take it out of
    // its own superview and put it back, losing nothing but doing work on
    // every apply forever.
    if { synth::get_associated(v, window_buttons_key()) } != (0 as *u8) { return; }
    let view: ak::View = ak::View::from_raw(v);
    match view.window() {
        option::Option[ak::Window]::Some(w) => {
            var x: f64 = 0.0f64;
            let gap: f64 = window_button_gap(n);
            adopt_one(view, w, ak::WindowButton::NSWindowCloseButton, x);
            x = x + gap;
            adopt_one(view, w, ak::WindowButton::NSWindowMiniaturizeButton, x);
            x = x + gap;
            adopt_one(view, w, ak::WindowButton::NSWindowZoomButton, x);
            { synth::set_associated(v, window_buttons_key(), 1 as *u8) };
        }
        option::Option[ak::Window]::None => { }
    }
    return;
}

// 0 means the platform's own metric, which is what an application usually
// wants — and macOS's is 20 points between traffic-light centres.
fn window_button_gap(n: *core::Node) -> f64 {
    let p: *chrome::WindowButtonsProps =
        props_of(n, chrome::K_WINDOW_BUTTONS) as *chrome::WindowButtonsProps;
    if p == (0 as *chrome::WindowButtonsProps) { return 20.0f64; }
    let s: f64 = { (*p).spacing };
    if s > 0.0f64 { return s; }
    return 20.0f64;
}

fn adopt_one(host: ak::View, w: ak::Window, which: ak::WindowButton, x: f64) {
    match w.standard_window_button(which) {
        option::Option[ak::Button]::Some(btn) => {
            let bv: ak::View = btn.as_view();
            let f: rt::Rect = bv.frame();
            bv.set_hidden(false);
            host.add_subview(bv);
            bv.set_frame(rt::Rect { x: x, y: 0.0f64, w: f.w, h: f.h });
        }
        option::Option[ak::Button]::None => { }
    }
    return;
}

fn create_window_buttons(n: *core::Node) -> *u8 {
    let v: ak::View = akx::new_flipped_view(rt::Rect { x: 0.0f64, y: 0.0f64, w: 0.0f64, h: 0.0f64 });
    return rt::retain(v.raw());
}

fn apply_window_buttons(v: *u8, n: *core::Node, dirty: u64) {
    adopt_window_buttons(v, n);
    return;
}

// ---- canvas ------------------------------------------------------------------
// The one control that DRAWS rather than configures a system control, so the
// one control with a view class of its own: `drawing::canvas_view_class`, an
// NSView whose `drawRect:` runs the recording facet holds.
//
// The whole body is three lines because the work is split where it belongs.
// The application records into a `vocab::Canvas`; drawing.cplus replays that
// recording into the CGContext AppKit hands `drawRect:`. Nothing about a
// drawing passes through this file.
//
// No layer, deliberately. `drawRect:` on a non-layer-backed view draws
// straight into the window's backing store, and a layer would be a second
// buffer holding a copy of the same pixels. A canvas that also sets a
// background_color gets a layer from `apply_common`, which is fine — AppKit
// draws through it either way.

fn create_canvas(n: *core::Node) -> *u8 {
    let v: ak::View = drawing::new_canvas_view();
    drawing::bind_node(v.raw(), n);
    return rt::retain(v.raw());
}

fn apply_canvas(v: *u8, n: *core::Node, dirty: u64) {
    let p: *props::CanvasProps = props_of(n, props::K_CANVAS) as *props::CanvasProps;
    if p == (0 as *props::CanvasProps) { return; }
    // A new Drawable, an explicit `redraw()`, or a new size: the drawing is
    // a function of the laid-out box, so a resize is a repaint.
    let watched: u64 = canvas::P_DRAWABLE | canvas::P_REDRAW | props::C_LAYOUT;
    if (dirty & watched) != (0 as u64) || dirty == paint::all_bits() {
        drawing::invalidate(v);
    }
    return;
}

// ---- menu, menu_item, toolbar_item -------------------------------------------
// The rest of the menu tier, and like `context_menu` none of them is a view:
// an NSMenu, an NSMenuItem and an NSToolbarItem are all objects a WINDOW or
// the APPLICATION owns, not things that occupy a rectangle in a tree.
//
// So all three answer `wants_view` false, and what they describe is built from
// the nodes by whoever owns the host:
//
//   `menu` + `menu_item`  a menu-bar submenu, built by `build_menu` below and
//                         installed on NSApplication by the window tier.
//   `toolbar_item`        an NSToolbarItem, built by `build_toolbar_item` and
//                         installed on the window's NSToolbar.
//
// The BUILDERS are here, complete, because that is this module's job — turning
// a facet node into an AppKit object. The INSTALLERS belong to the window tier
// (stages/4.md item 5, the app menu and NSToolbar), which is where the thing
// that owns them lives. Splitting it that way is why `context_menu` needed no
// installer at all: an NSView owns its own menu, so the node's parent was the
// owner and it was already in hand.

fn menu_bar_kind(kind: u32) -> bool {
    return kind == props::K_MENU || kind == props::K_MENU_ITEM
        || kind == props::K_TOOLBAR_ITEM;
}

// The NSMenu a `menu` node describes, titled and filled from its
// `menu_item` children. At +1.
fn build_menu(n: *core::Node) -> *u8 {
    if core::kind_of(n) != props::K_MENU { return 0 as *u8; }
    let p: *props::MenuProps = props_of(n, props::K_MENU) as *props::MenuProps;
    var title: str = "";
    if p != (0 as *props::MenuProps) { title = { (*p).text.view() }; }
    let menu: ak::Menu = ak::Menu::new(title);
    var i: usize = 0 as usize;
    let count: usize = core::child_count_of(n);
    while i < count {
        match core::child_of(n, i) {
            option::Option[*core::Node]::Some(c) => {
                let item: *u8 = build_menu_item(c);
                if item != (0 as *u8) { menu.add_item(ak::MenuItem::from_raw(item)); }
            }
            option::Option[*core::Node]::None => { }
        }
        i = i +% (1 as usize);
    }
    return rt::retain(menu.raw());
}

// One NSMenuItem from a `menu_item` node, or 0 for a node that is not one.
// Shares every rule with a context menu's items — a titleless item is a
// separator, the handler rides the same target trampoline — because they are
// the same object and a second set of rules would be two answers to one
// question.
fn build_menu_item(c: *core::Node) -> *u8 {
    let mi: *props::MenuItemProps = props_of(c, props::K_MENU_ITEM) as *props::MenuItemProps;
    if mi == (0 as *props::MenuItemProps) { return 0 as *u8; }
    let title: str = { (*mi).text.view() };
    if title == "" { return rt::retain(ak::MenuItem::separator_item().raw()); }
    let item: ak::MenuItem = ak::MenuItem::new(title, 0 as *u8, "");
    let icon: str = { (*mi).icon.view() };
    if icon != "" {
        match resolve_image(icon) {
            option::Option[ak::Image]::Some(img) => { item.set_image(img); }
            option::Option[ak::Image]::None => { }
        }
    }
    let h: fn(*u8, *u8) = { (*mi).on_clicked };
    if h != props::no_handler {
        item.set_target(akx::action_ctx_target(h, { (*mi).on_clicked_ctx }));
        item.set_action(akx::action_ctx_sel());
    }
    item.set_enabled(core::is_enabled(c));
    return rt::retain(item.raw());
}

// One NSToolbarItem from a `toolbar_item` node. Its identifier is the node's
// KEY — NSToolbar addresses its items by identifier, facet addresses nodes by
// key, and they are the same need answered once.
fn build_toolbar_item(c: *core::Node) -> *u8 {
    let p: *props::ToolbarItemProps = props_of(c, props::K_TOOLBAR_ITEM) as *props::ToolbarItemProps;
    if p == (0 as *props::ToolbarItemProps) { return 0 as *u8; }
    let mi: *props::MenuItemProps = { #addr_of((*p).menu_item) };
    var ident: str = { (*c).key() };
    if ident == "" { ident = { (*mi).text.view() }; }
    let alloced: *u8 = { rt::msg_id(rt::get_class(#str_ptr("NSToolbarItem\0")), rt::sel(#str_ptr("alloc\0"))) };
    let item: *u8 = { rt::msg_id_id(alloced, rt::sel(#str_ptr("initWithItemIdentifier:\0")),
                                    bridge::nsstring(ident)) };
    if item == (0 as *u8) { return 0 as *u8; }
    { rt::msg_void_id(item, rt::sel(#str_ptr("setLabel:\0")), bridge::nsstring({ (*mi).text.view() })) };
    let icon: str = { (*mi).icon.view() };
    if icon != "" {
        match resolve_image(icon) {
            option::Option[ak::Image]::Some(img) => {
                { rt::msg_void_id(item, rt::sel(#str_ptr("setImage:\0")), img.raw()) };
            }
            option::Option[ak::Image]::None => { }
        }
    }
    let h: fn(*u8, *u8) = { (*mi).on_clicked };
    if h != props::no_handler {
        { rt::msg_void_id(item, rt::sel(#str_ptr("setTarget:\0")),
                          akx::action_ctx_target(h, { (*mi).on_clicked_ctx })) };
        { rt::msg_void_id(item, rt::sel(#str_ptr("setAction:\0")), akx::action_ctx_sel()) };
    }
    return item;
}
