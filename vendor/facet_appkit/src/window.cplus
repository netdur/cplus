// facet_appkit window — Chrome becomes an NSWindow, and the tree becomes its
// content.
//
// The ownership model facet declares is process -> app -> window -> node, and
// this module keeps it: a window's platform handle lives on the app's own
// `Window` record (`app::set_window_native`), never in a `CURRENT_WIN` static
// like the pre-regen facade kept. An app has many windows open at once, so a
// single process-wide "the current window" is both wrong and app-scoped state
// in a process static.
//
// Each window owns its delegate. The delegate is heap-allocated per window and
// pinned to the NSWindow as an associated object, so it lives exactly as long
// as the window does and two windows never share lifecycle state.

import "stdlib/option" as option;
import "stdlib/text" as text;
import "stdlib/box" as box;
import "flex_layout/flex_layout" as flex;
import "facet/facet" as core;
import "facet/mount" as mount;
import "facet/props" as props;
import "facet/screen" as screen;
import "facet/application" as app;
import "facet/theme" as theme;
import "facet/vocabulary" as vocab;
import "objc/bridge" as bridge;
import "objc/runtime" as rt;
import "objc/synthesis" as synth;
import "appkit/appkit" as ak;
import "appkit/appkit_ext" as akx;
import "./views" as views;
import "./controls" as controls;
import "./scheduler" as scheduler;
import "./geometry" as geometry;

type Node = flex::Node;
type Chrome = screen::Chrome;
type Bar = screen::Bar;

// ---- the bar, in AppKit's terms ----------------------------------------------
// facet's `Bar` is one enum where the old facade had six booleans. Its four
// values map onto the two knobs AppKit actually has — whether content runs
// under the titlebar, and which standard buttons show.
//
//   Native   the stock titlebar. Nothing special.
//   Blended  content bleeds under a transparent, title-less titlebar — the
//            unified-toolbar / clean-titlebar look, without naming either.
//   Hidden   no visible bar; the standard buttons stay and FLOAT over the
//            content (the platform's own behaviour, which is what "if it has
//            them" in the contract means).
//   Custom   the app draws the bar: full-size content, and all three standard
//            buttons hidden so `window_buttons()` can supply its own.

fn wants_full_size_content(bar: Bar) -> bool {
    return match bar {
        screen::Bar::Native => false,
        screen::Bar::Blended => true,
        screen::Bar::Hidden => true,
        screen::Bar::Custom => true,
    };
}

fn shell_style_mask(bar: Bar) -> u64 {
    var style: u64 = ak::window_style_mask_titled
        | ak::window_style_mask_closable
        | ak::window_style_mask_miniaturizable
        | ak::window_style_mask_resizable;
    if wants_full_size_content(bar) { style = style | ak::window_style_mask_full_size_content_view; }
    return style;
}

// Hide one traffic light if the style mask has it at all; None means the mask
// does not include that button and there is nothing to hide.
fn hide_window_button(win: ak::Window, b: ak::WindowButton) {
    match win.standard_window_button(b) {
        option::Option[ak::Button]::Some(btn) => { btn.as_view().set_hidden(true); }
        option::Option[ak::Button]::None => { }
    }
    return;
}

// Create the NSWindow at +1. The caller sets the content view and orders it
// front.
fn make_shell_window(take chrome: Chrome) -> ak::Window {
    let c: Chrome = chrome;
    let win = ak::Window::new(
        rt::Rect { x: 0.0f64, y: 0.0f64, w: c.width, h: c.height },
        shell_style_mask(c.bar),
        ak::BackingStoreType::NSBackingStoreBuffered,
        false,
    );
    let _r: *u8 = rt::retain(win.raw());
    win.set_title(c.title());
    match c.bar {
        screen::Bar::Native => { }
        screen::Bar::Blended => {
            win.set_titlebar_appears_transparent(true);
            win.set_title_visibility(ak::WindowTitleVisibility::NSWindowTitleHidden);
        }
        screen::Bar::Hidden => {
            // The buttons stay: on macOS a bar-less window still floats its
            // traffic lights, and hiding them would be Bar::Custom's job.
            win.set_titlebar_appears_transparent(true);
            win.set_title_visibility(ak::WindowTitleVisibility::NSWindowTitleHidden);
        }
        screen::Bar::Custom => {
            win.set_titlebar_appears_transparent(true);
            win.set_title_visibility(ak::WindowTitleVisibility::NSWindowTitleHidden);
            hide_window_button(win, ak::WindowButton::NSWindowCloseButton);
            hide_window_button(win, ak::WindowButton::NSWindowMiniaturizeButton);
            hide_window_button(win, ak::WindowButton::NSWindowZoomButton);
            // Dragging comes from an explicit `.window_drag()` surface, NOT
            // movableByWindowBackground — that swallows a click on the app's
            // own titlebar controls as a no-movement window drag.
        }
    }
    // A separate question from the bar's style, so separate fields.
    //
    // The button is HIDDEN rather than disabled. AppKit's own answer is to
    // drop the mask bit, but the mask is what `make_shell_window` used to
    // choose the bar's style, and re-deriving it here would put the two
    // decisions in one expression. A hidden button is also what a person
    // reads as "this window does not do that".
    if !c.minimizable {
        hide_window_button(win, ak::WindowButton::NSWindowMiniaturizeButton);
    }
    if !c.maximizable {
        hide_window_button(win, ak::WindowButton::NSWindowZoomButton);
    }
    // TitleBar.Subtitle. Second line in the platform's own bar; AppKit gained
    // it in macOS 11, so the selector is checked rather than assumed — an
    // older system gets a window with no subtitle instead of no window.
    let sub: str = c.subtitle();
    if sub != "" {
        if synth::class_responds(synth::object_class(win.raw()),
                                 rt::sel(#str_ptr("setSubtitle:\0"))) != (0 as i8) {
            { rt::msg_void_id(win.raw(), rt::sel(#str_ptr("setSubtitle:\0")),
                              bridge::nsstring(sub)) };
        }
    }
    // The content-size floor, applied only when both dimensions are set.
    if c.min_width > 0.0f64 && c.min_height > 0.0f64 {
        win.set_content_min_size(rt::Size { w: c.min_width, h: c.min_height });
    }
    // ...and the ceiling. ZERO IS UNBOUNDED, so an unset maximum is not a
    // maximum of nothing: AppKit's own unbounded value is CGFLOAT_MAX, and
    // each axis is answered on its own so a window can cap one and not the
    // other.
    let unbounded: f64 = 1000000.0f64;
    var cap_w: f64 = unbounded;
    var cap_h: f64 = unbounded;
    if c.max_width > 0.0f64 { cap_w = c.max_width; }
    if c.max_height > 0.0f64 { cap_h = c.max_height; }
    if cap_w != unbounded || cap_h != unbounded {
        win.set_content_max_size(rt::Size { w: cap_w, h: cap_h });
    }
    return win;
}

// ---- per-window lifecycle ----------------------------------------------------
// One of these per open window, heap-allocated and pinned to the NSWindow.
// `root` is what ties an AppKit callback back to a facet tree.

struct WindowHost {
    opaque root: *core::Node,
    should_close: fn(*u8) -> bool,
    will_close: fn(*u8),
    opaque ctx: *u8,
    delegate: ak::WindowDelegate,
}

fn host_key() -> *u8 { return 29010 as *u8; }

fn default_should_close(ctx: *u8) -> bool { return true; }
fn default_will_close(ctx: *u8) { return; }

// How many facet windows are open. The run loop stops when the last one goes,
// which is the desktop convention a single-window app expects.
static OPEN_WINDOWS: i64 = 0 as i64;

fn open_window_count() -> i64 { return OPEN_WINDOWS; }

fn appkit_should_close(user: *u8, win_ptr: *u8) -> i8 {
    if user == (0 as *u8) { return 1 as i8; }
    let h: *WindowHost = user as *WindowHost;
    let f: fn(*u8) -> bool = { (*h).should_close };
    if f == (0 as fn(*u8) -> bool) { return 1 as i8; }
    if f({ (*h).ctx }) { return 1 as i8; }
    return 0 as i8;
}

fn appkit_will_close(user: *u8, notif: *u8) {
    if user == (0 as *u8) { return; }
    let h: *WindowHost = user as *WindowHost;
    let f: fn(*u8) = { (*h).will_close };
    if f != (0 as fn(*u8)) { f({ (*h).ctx }); }
    // Out of the app's window list, and the tree detaches — the same path an
    // explicit unmount takes, so on_detach handlers fire exactly once.
    let root: *core::Node = { (*h).root };
    if root != (0 as *core::Node) { mount::unmount(root); }
    OPEN_WINDOWS = OPEN_WINDOWS -% (1 as i64);
    if OPEN_WINDOWS <= (0 as i64) {
        OPEN_WINDOWS = 0 as i64;
        stop_loop();
    }
    return;
}

// windowDidResize: re-lay the retained tree at the new size and move the
// existing views. No render, no mount, no view churn — this is the path the
// retained-relayout work bought, and the whole reason the tree survives mount.
fn appkit_did_resize(user: *u8, notif: *u8) {
    if user == (0 as *u8) { return; }
    let h: *WindowHost = user as *WindowHost;
    let root: *core::Node = { (*h).root };
    if root != (0 as *core::Node) { scheduler::layout_window(root); }
    return;
}

fn install_window_host(win: ak::Window, root: *core::Node, ctx: *u8,
                       should_close: fn(*u8) -> bool, will_close: fn(*u8)) {
    var h: WindowHost = WindowHost {
        root: root,
        should_close: should_close,
        will_close: will_close,
        ctx: ctx,
        delegate: ak::WindowDelegate_new(0 as *u8),
    };
    match box::new::[WindowHost](h) {
        option::Option[box::Box[WindowHost]]::Some(b) => {
            let hp: *u8 = b.into_raw();
            let host: *WindowHost = hp as *WindowHost;
            // The delegate's `user` is the host itself, so every callback
            // reaches this window's own record and no other's.
            { (*host).delegate = ak::WindowDelegate_new(hp) };
            { (*host).delegate.set_window_should_close(appkit_should_close) };
            { (*host).delegate.set_window_will_close(appkit_will_close) };
            { (*host).delegate.set_window_did_resize(appkit_did_resize) };
            let obj: *u8 = ak::create_WindowDelegate(#addr_of((*host).delegate));
            win.set_delegate(obj);
            // Pin both to the window: it outlives this frame and owns them.
            { synth::set_associated(win.raw(), host_key(), obj) };
        }
        option::Option[box::Box[WindowHost]]::None => { }
    }
    return;
}

// ---- opening a window --------------------------------------------------------

// Open a window showing `root`. Returns the NSWindow pointer; the tree is
// mounted, the window is on screen, and nothing blocks.
//
// The root Node is NOT owned here — the caller (a facade, a screen loop) holds
// it for the window's life, because facet's cursors point into it.
fn open_window(root: *core::Node, take chrome: Chrome,
               ctx: *u8 = 0 as *u8,
               should_close: fn(*u8) -> bool = default_should_close,
               will_close: fn(*u8) = default_will_close) -> *u8 {
    if root == (0 as *core::Node) { return 0 as *u8; }
    let c: Chrome = chrome;
    let width: f64 = c.width;
    let height: f64 = c.height;
    let application: ak::Application = ak::Application::shared_application();
    let _ok: bool = application.set_activation_policy(ak::ApplicationActivationPolicy::Regular);

    let win: ak::Window = make_shell_window(c);

    // The content view is FLIPPED: everything below it is top-left origin, the
    // same as flex, so the frame walk carries no flip math at all.
    let content: ak::View = akx::new_flipped_view(rt::Rect { x: 0.0f64, y: 0.0f64, w: width, h: height });
    win.set_content_view(content);

    // Mount: this is what opens the window on the APP's record too
    // (mount::mount calls app::open_window), so the native handle can be
    // recorded against it immediately after.
    let mounted: bool = mount::mount(root);
    app::set_window_native(root, win.raw());
    OPEN_WINDOWS = OPEN_WINDOWS +% (1 as i64);
    install_window_host(win, root, ctx, should_close, will_close);

    // The root's own view was inserted nowhere by the walk — the facade puts
    // it in the window, which is here.
    if mounted {
        let rv: *u8 = core::view_of(root);
        if rv != (0 as *u8) { content.add_subview(ak::View::from_raw(rv)); }
    }

    // System light/dark flips reach the app through theme::on_appearance_change:
    // an invisible sentinel subview's viewDidChangeEffectiveAppearance forwards
    // the signal, which is the only hook AppKit offers.
    akx::add_appearance_observer(content, fire_appearance_change, 0 as *u8);

    // The toolbar is read from the TREE, so it can only be built once the
    // tree is mounted — and before the window is shown, or it appears empty
    // and then fills in.
    install_toolbar(win, root);

    win.center();
    win.make_key_and_order_front(0 as *u8);
    application.activate_ignoring_other_apps(true);
    // windowDidResize does not fire on first display, so lay out once here or
    // the content stays frozen at its mount-time size.
    scheduler::layout_window(root);
    return win.raw();
}

fn fire_appearance_change(ctx: *u8) {
    theme::notify_appearance_changed();
    return;
}

// Close a window by its native handle. The will_close path does the rest:
// unmount, count down, and stop the loop when the last one goes.
fn close_window(win: *u8) {
    if win == (0 as *u8) { return; }
    ak::Window::from_raw(win).close();
    return;
}

// The window showing `root`, closed.
fn close_window_of(root: *core::Node) {
    close_window(app::window_native(root));
    return;
}

// ---- the loop ----------------------------------------------------------------

fn run_loop() {
    ak::Application::shared_application().run();
    return;
}

// `NSApplication.stop` only takes effect when the loop next finishes an event,
// so a stop from inside a callout (a run_on_main step, an agent's click) needs
// a nudge to wake it. Posting a no-op app-defined event is that nudge.
fn stop_loop() {
    let application: ak::Application = ak::Application::shared_application();
    application.stop(0 as *u8);
    nudge_loop(application);
    return;
}

fn nudge_loop(application: ak::Application) {
    let e: option::Option[ak::Event] = ak::Event::other_event_with_type(
        ak::EventType::ApplicationDefined,
        rt::Point { x: 0.0f64, y: 0.0f64 },
        0 as u64,
        0.0f64,
        0 as i64,
        ak::GraphicsContext::from_raw(0 as *u8),
        0 as i16,
        0 as i64,
        0 as i64,
    );
    match e {
        option::Option[ak::Event]::Some(ev) => { application.post_event(ev, true); }
        option::Option[ak::Event]::None => { }
    }
    return;
}

// ---- is_dark -----------------------------------------------------------------
// The ONE single slot theme keeps: which system appearance is active.

fn is_dark() -> bool {
    let application: ak::Application = ak::Application::shared_application();
    let name: text::Text = application.effective_appearance().name();
    return name.view().contains("Dark");
}

// ---- the window tier's platform reads ----------------------------------------
// Stage 4 item 5. Each answers a ledger row that could not be answered without
// a native window, and each falls back to the value that keeps arithmetic
// working rather than to zero — a density of 0 would make every size
// computation collapse, and that is worse than a wrong-but-sane 1.

// Window.DisplayDensity. Points to pixels: 2.0 on a Retina display.
fn density_of(root: *core::Node) -> f64 {
    let w: *u8 = app::window_native(root);
    if w == (0 as *u8) { return 1.0f64; }
    let s: f64 = { rt::msg_f64(w, rt::sel(#str_ptr("backingScaleFactor\0"))) };
    if s <= 0.0f64 { return 1.0f64; }
    return s;
}

// Window.IsActivated. KEY, not main: a window can be main while a panel holds
// key, and "is the user typing into this" is the question an application means.
fn is_active(root: *core::Node) -> bool {
    let w: *u8 = app::window_native(root);
    if w == (0 as *u8) { return false; }
    return { rt::msg_i8(w, rt::sel(#str_ptr("isKeyWindow\0"))) } != (0 as i8);
}

// Application.UserAppTheme. NSApp's appearance override; nil is "follow the
// system", which is why Unspecified has to be expressible.
fn set_app_appearance(a: vocab::Appearance) {
    let nsapp: *u8 = { rt::msg_id(rt::get_class(#str_ptr("NSApplication\0")),
                                  rt::sel(#str_ptr("sharedApplication\0"))) };
    if nsapp == (0 as *u8) { return; }
    var name: *u8 = 0 as *u8;
    match a {
        vocab::Appearance::Light => { name = bridge::nsstring("NSAppearanceNameAqua"); }
        vocab::Appearance::Dark => { name = bridge::nsstring("NSAppearanceNameDarkAqua"); }
        vocab::Appearance::Unspecified => { name = 0 as *u8; }
    }
    var appearance: *u8 = 0 as *u8;
    if name != (0 as *u8) {
        appearance = { rt::msg_id_id(rt::get_class(#str_ptr("NSAppearance\0")),
                                     rt::sel(#str_ptr("appearanceNamed:\0")), name) };
    }
    { rt::msg_void_id(nsapp, rt::sel(#str_ptr("setAppearance:\0")), appearance) };
    // The override changes what every theme role resolves to, and colours
    // resolved at paint time do not re-resolve themselves — so this takes the
    // same repaint an appearance flip already goes through.
    theme::notify_appearance_changed();
    return;
}

// What the override currently says — NOT the effective appearance, which is
// `theme::is_dark()`. Unspecified means nothing was overridden, and a caller
// that wants to know what the system then chose asks the theme.
fn app_appearance() -> vocab::Appearance {
    let nsapp: *u8 = { rt::msg_id(rt::get_class(#str_ptr("NSApplication\0")),
                                  rt::sel(#str_ptr("sharedApplication\0"))) };
    if nsapp == (0 as *u8) { return vocab::Appearance::Unspecified; }
    let a: *u8 = { rt::msg_id(nsapp, rt::sel(#str_ptr("appearance\0"))) };
    if a == (0 as *u8) { return vocab::Appearance::Unspecified; }
    let n: *u8 = { rt::msg_id(a, rt::sel(#str_ptr("name\0"))) };
    if n == (0 as *u8) { return vocab::Appearance::Unspecified; }
    if bridge::to_text(n).view() == "NSAppearanceNameDarkAqua" { return vocab::Appearance::Dark; }
    return vocab::Appearance::Light;
}

// ---- the app menu ------------------------------------------------------------
// Stage 4 item 5. `App::build_menu()` produced an AppMenu and nothing ever
// installed it, so an application's menu bar was a description with no reader.
//
// The shape AppKit wants is not the shape facet declares. facet's AppMenu is a
// FLAT list of items, each naming the menu it belongs to; AppKit wants a tree
// of NSMenuItems whose submenus are NSMenus. So the flat list is grouped here,
// in FIRST-SEEN order — an application that writes File before Edit gets File
// before Edit, which is the only ordering it can have expressed.

fn menu_selector(action: u32) -> *u8 {
    if action == screen::menu_action_quit() { return rt::sel(#str_ptr("terminate:\0")); }
    if action == screen::menu_action_close_window() { return rt::sel(#str_ptr("performClose:\0")); }
    if action == screen::menu_action_undo() { return rt::sel(#str_ptr("undo:\0")); }
    if action == screen::menu_action_redo() { return rt::sel(#str_ptr("redo:\0")); }
    if action == screen::menu_action_cut() { return rt::sel(#str_ptr("cut:\0")); }
    if action == screen::menu_action_copy() { return rt::sel(#str_ptr("copy:\0")); }
    if action == screen::menu_action_paste() { return rt::sel(#str_ptr("paste:\0")); }
    if action == screen::menu_action_select_all() { return rt::sel(#str_ptr("selectAll:\0")); }
    if action == screen::menu_action_find() { return rt::sel(#str_ptr("performFindPanelAction:\0")); }
    return 0 as *u8;
}

fn new_menu(title: str) -> *u8 {
    let alloced: *u8 = { rt::msg_id(rt::get_class(#str_ptr("NSMenu\0")), rt::sel(#str_ptr("alloc\0"))) };
    return { rt::msg_id_id(alloced, rt::sel(#str_ptr("initWithTitle:\0")), bridge::nsstring(title)) };
}

// One item, wired the way its own fields say. An app COMMAND wins over a token
// action — the flat `action` is for the platform's own verbs, and a callback is
// the application's, so a row that has both meant the callback.
fn new_menu_item(it: *screen::MenuItem) -> *u8 {
    if { (*it).is_separator } {
        return { rt::msg_id(rt::get_class(#str_ptr("NSMenuItem\0")),
                            rt::sel(#str_ptr("separatorItem\0"))) };
    }
    let alloced: *u8 = { rt::msg_id(rt::get_class(#str_ptr("NSMenuItem\0")), rt::sel(#str_ptr("alloc\0"))) };
    let item: *u8 = { rt::msg_id_id_id_id(alloced,
        rt::sel(#str_ptr("initWithTitle:action:keyEquivalent:\0")),
        bridge::nsstring({ (*it).title.view() }), 0 as *u8,
        bridge::nsstring({ (*it).key.view() })) };
    if item == (0 as *u8) { return 0 as *u8; }
    let on_click: fn(*u8, *u8) = { (*it).on_click };
    if on_click != (0 as fn(*u8, *u8)) {
        { rt::msg_void_id(item, rt::sel(#str_ptr("setTarget:\0")),
                          akx::action_ctx_target(on_click, { (*it).click_ctx })) };
        { rt::msg_void_id(item, rt::sel(#str_ptr("setAction:\0")), akx::action_ctx_sel()) };
    } else {
        let sel: *u8 = menu_selector({ (*it).action });
        // No target: the responder chain finds whoever answers, which is what
        // makes Cut work on the focused text field and grey out elsewhere
        // without facet knowing anything about either.
        if sel != (0 as *u8) { { rt::msg_void_id(item, rt::sel(#str_ptr("setAction:\0")), sel) }; }
    }
    return item;
}

// The submenu named `group`, made on first mention. `titles` keeps the order.
fn submenu_for(menus: *u8, titles: *u8, group: str) -> *u8 {
    let key: *u8 = bridge::nsstring(group);
    let existing: *u8 = { rt::msg_id_id(menus, rt::sel(#str_ptr("objectForKey:\0")), key) };
    if existing != (0 as *u8) { return existing; }
    let made: *u8 = new_menu(group);
    if made == (0 as *u8) { return 0 as *u8; }
    { rt::msg_void_id_id(menus, rt::sel(#str_ptr("setObject:forKey:\0")), made, key) };
    { rt::msg_void_id(titles, rt::sel(#str_ptr("addObject:\0")), key) };
    return made;
}

fn install_app_menu(m: *screen::AppMenu) {
    if m == (0 as *screen::AppMenu) { return; }
    let bar: *u8 = new_menu("");
    if bar == (0 as *u8) { return; }
    let menus: *u8 = { rt::alloc_init(#str_ptr("NSMutableDictionary\0")) };
    let titles: *u8 = { rt::alloc_init(#str_ptr("NSMutableArray\0")) };
    if menus == (0 as *u8) || titles == (0 as *u8) { return; }

    var i: usize = 0 as usize;
    let count: usize = { (*m).items.count() };
    while i < count {
        match { (*m).items.at_ptr(i) } {
            option::Option[*screen::MenuItem]::Some(it) => {
                let group: str = { (*it).menu.view() };
                let sub: *u8 = submenu_for(menus, titles, group);
                let entry: *u8 = new_menu_item(it);
                if sub != (0 as *u8) && entry != (0 as *u8) {
                    { rt::msg_void_id(sub, rt::sel(#str_ptr("addItem:\0")), entry) };
                }
            }
            option::Option[*screen::MenuItem]::None => { }
        }
        i = i +% (1 as usize);
    }

    // The bar's items are TITLE-ONLY carriers for their submenus — AppKit reads
    // the submenu's own title for the bar, and the first one is always the
    // application menu whatever it is called.
    var k: u64 = 0 as u64;
    let n: u64 = { rt::msg_u64(titles, rt::sel(#str_ptr("count\0"))) };
    while k < n {
        let key: *u8 = { rt::msg_id_u64(titles, rt::sel(#str_ptr("objectAtIndex:\0")), k) };
        let sub: *u8 = { rt::msg_id_id(menus, rt::sel(#str_ptr("objectForKey:\0")), key) };
        let holder: *u8 = { rt::msg_id(rt::get_class(#str_ptr("NSMenuItem\0")),
                                       rt::sel(#str_ptr("alloc\0"))) };
        let item: *u8 = { rt::msg_id_id_id_id(holder,
            rt::sel(#str_ptr("initWithTitle:action:keyEquivalent:\0")),
            key, 0 as *u8, bridge::nsstring("")) };
        if item != (0 as *u8) && sub != (0 as *u8) {
            { rt::msg_void_id(item, rt::sel(#str_ptr("setSubmenu:\0")), sub) };
            { rt::msg_void_id(bar, rt::sel(#str_ptr("addItem:\0")), item) };
        }
        k = k + (1 as u64);
    }

    let nsapp: *u8 = { rt::msg_id(rt::get_class(#str_ptr("NSApplication\0")),
                                  rt::sel(#str_ptr("sharedApplication\0"))) };
    { rt::msg_void_id(nsapp, rt::sel(#str_ptr("setMainMenu:\0")), bar) };
    rt::release(bar);
    rt::release(menus);
    rt::release(titles);
    return;
}

// ---- the toolbar -------------------------------------------------------------
// `toolbar_item` nodes answer `wants_view` false — an NSToolbarItem is not a
// view — so they are read from the TREE when the window opens. controls.cplus
// builds each one; this collects them and hands appkit_ext the two collections
// NSToolbar's delegate protocol wants.

fn install_toolbar(win: ak::Window, root: *core::Node) {
    let ids: *u8 = { rt::alloc_init(#str_ptr("NSMutableArray\0")) };
    let map: *u8 = { rt::alloc_init(#str_ptr("NSMutableDictionary\0")) };
    if ids == (0 as *u8) || map == (0 as *u8) { return; }
    collect_toolbar_items(root, ids, map);
    if { rt::msg_u64(ids, rt::sel(#str_ptr("count\0"))) } == (0 as u64) {
        rt::release(ids);
        rt::release(map);
        return;
    }
    let tb: ak::Toolbar = akx::make_toolbar(ids, map);
    win.set_toolbar(tb);
    rt::release(ids);
    rt::release(map);
    return;
}

// Anywhere in the tree, not only at the root: a screen composes its toolbar
// where the content that owns it is described, which is rarely the top.
fn collect_toolbar_items(n: *core::Node, ids: *u8, map: *u8) {
    if n == (0 as *core::Node) { return; }
    if core::kind_of(n) == props::K_TOOLBAR_ITEM {
        let item: *u8 = controls::build_toolbar_item(n);
        if item != (0 as *u8) {
            let ident: *u8 = { rt::msg_id(item, rt::sel(#str_ptr("itemIdentifier\0"))) };
            if ident != (0 as *u8) {
                { rt::msg_void_id(ids, rt::sel(#str_ptr("addObject:\0")), ident) };
                { rt::msg_void_id_id(map, rt::sel(#str_ptr("setObject:forKey:\0")), item, ident) };
            }
        }
        return;
    }
    var i: usize = 0 as usize;
    let count: usize = core::child_count_of(n);
    while i < count {
        match core::child_of(n, i) {
            option::Option[*core::Node]::Some(c) => { collect_toolbar_items(c, ids, map); }
            option::Option[*core::Node]::None => { }
        }
        i = i +% (1 as usize);
    }
    return;
}
