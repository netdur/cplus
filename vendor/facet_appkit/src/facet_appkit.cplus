}

#[test]
fn scroll_hosts_content_two_phase() {
    // A 100-tall scroll holding ~240pt of rows: mount → apply sizes the scroll
    // viewport → drain_scroll_jobs fills the flipped document view (phase two).
    let content = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 220.0, h: 120.0 });
    var root: facet::Node = @facet {
        scroll {
            for i in 0..10 {
                label("row").height(24.0f64)
            }
        }
        .frame(200.0f64, 100.0f64)
    };
    let h: f64 = mount_into(#addr_of(root), content.raw(), 220.0f64, 120.0f64);
    assert h > 0.0f64;
    let cv: ak::View = ak::View::from_raw(content.raw());
    var subs: vec::Vec[ak::View] = cv.subviews();
    match subs.at_ptr(0 as usize) {
        option::Option[*ak::View]::Some(sp) => {
            let sv: ak::ScrollView = ak::ScrollView::from_raw({ (*sp).raw() });
            match sv.document_view() {
                option::Option[ak::View]::Some(dv) => {
                    assert dv.subviews().count() > (0 as usize);   // rows installed
                }
                option::Option[ak::View]::None => { assert false; }
            };
        }
        option::Option[*ak::View]::None => { assert false; }
    };
}

#[test]
fn menu_and_popup_mount_on_appkit() {
    let content = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 300.0, h: 160.0 });
    var mitems: vec::Vec[text::Text] = vec::new::[text::Text]();
    mitems.append(text::from_str("Cut"));
    mitems.append(text::from_str("Copy"));
    var pitems: vec::Vec[text::Text] = vec::new::[text::Text]();
    pitems.append(text::from_str("Red"));
    pitems.append(text::from_str("Green"));
    var root: facet::Node = @facet {
        vstack {
            menu("Edit", mitems).agent_id("edit-menu")
            popup(pitems, selected: 1 as i64).agent_id("color")
        }
    };
    let h: f64 = mount_into(#addr_of(root), content.raw(), 300.0f64, 160.0f64);
    assert h > 0.0f64;
    assert surface_has_id(content.raw(), "edit-menu");   // pull-down menu
    assert surface_has_id(content.raw(), "color");        // selector popup
}

#[test]
fn batch2_controls_mount_and_secure_field_drives() {
    let win = e2e_window(320.0f64, 240.0f64);
    let content = e2e_content(win);
    var items: vec::Vec[text::Text] = vec::new::[text::Text]();
    items.append(text::from_str("Day"));
    items.append(text::from_str("Night"));
    var root: facet::Node = @facet {
        vstack {
            stepper(value: 2.0f64, min: 0.0f64, max: 10.0f64).agent_id("qty")
            secure_field(placeholder: "Password").agent_id("pw")
            segmented(items, selected: 0 as i64).agent_id("mode")
        }
    };
    let _h: f64 = mount_into(#addr_of(root), content.raw(), 320.0f64, 240.0f64);
    var s: agent::Surface = agent::open(win.raw());
    assert surface_has_id(content.raw(), "qty");
    assert surface_has_id(content.raw(), "pw");
    assert surface_has_id(content.raw(), "mode");
    // secure_field is role_input → drive_text.
    assert surface::outcome_eq(
        s.set_text("pw", "s3cret", s.text_version("pw")),
        surface::Outcome::Allowed);
}

#[test]
fn paint_modifiers_mount_through_apply_style() {
    // opacity / shadow / line_limit drive apply_style without tripping the
    // pipeline (visual correctness is by eye; here: builds + alpha reads back).
    let content = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 240.0, h: 160.0 });
    var root: facet::Node = @facet {
        vstack {
            wrap_label("a long wrapping caption that the line limit clamps to two lines of height")
                .line_limit(2 as i32)
                .text_align(facet::text_center())
                .italic()
                .agent_id("cap")
            label("underlined link").underline().foreground_color(facet::Color::accent()).agent_id("link")
            bordered {
                label("card")
            }
            .background(facet::Color::secondary())
            .corner_radius(8.0f64)
            .shadow(10.0f64)
            .opacity(0.9f64)
        }
    };
    let h: f64 = mount_into(#addr_of(root), content.raw(), 240.0f64, 160.0f64);
    assert h > 0.0f64;
    assert surface_has_id(content.raw(), "cap");
}

#[test]
fn zstack_block_overlays_on_appkit() {
    // The @facet block form of the overlay container mounts to real views.
    let content = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 200.0, h: 200.0 });
    var root: facet::Node = @facet {
        zstack {
            bordered {
                label("base")
            }
            label("badge").agent_id("badge")
        }
        .frame(160.0f64, 120.0f64)
    };
    let h: f64 = mount_into(#addr_of(root), content.raw(), 200.0f64, 200.0f64);
    assert h > 0.0f64;
    assert surface_has_id(content.raw(), "badge");
}

#[test]
fn shell_style_mask_adds_full_size_content_only_when_clean() {
    let plain: u64 = shell_style_mask(false);
    let clean: u64 = shell_style_mask(true);
    // Both are a standard titled/closable/resizable/miniaturizable window.
    assert (plain & ak::window_style_mask_titled) != (0 as u64);
    assert (plain & ak::window_style_mask_resizable) != (0 as u64);
    assert (plain & ak::window_style_mask_miniaturizable) != (0 as u64);
    // Full-size-content (content under the titlebar) is only in the clean shell.
    assert (plain & ak::window_style_mask_full_size_content_view) == (0 as u64);
    assert (clean & ak::window_style_mask_full_size_content_view) != (0 as u64);
}
