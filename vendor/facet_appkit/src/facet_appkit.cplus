}

#[test]
fn tooltip_and_a11y_label_apply() {
    // A widget with a tooltip + accessibility label mounts through apply_style;
    // the a11y label reads back off the view.
    let content = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 200.0, h: 80.0 });
    var root: facet::Node = @facet {
        vstack {
            button("Save")
                .tooltip("Save the current file")
                .accessibility_label("Save")
                .agent_id("save")
        }
    };
    let _h: f64 = mount_into(#addr_of(root), content.raw(), 200.0f64, 80.0f64);
    assert surface_has_id(content.raw(), "save");
    // the accessibility label landed on the button view
    let bp: *u8 = nth_widget(content.raw(), 0 as usize);
    assert ak::Accessibility::from_raw(bp).accessibility_label().view() == "Save";
}

#[test]
fn material_wraps_content_on_appkit() {
