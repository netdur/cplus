#[test]
fn gradient_box_mounts_on_appkit() {
    // A box with a vertical gradient fill: apply_style inserts a CAGradientLayer.
    let content = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 160.0, h: 120.0 });
    var root: facet::Node = @facet {
        vstack {
            box()
                .gradient(facet::Color::system_blue(), facet::Color::system_green())
                .corner_radius(8.0f64)
                .rotation(15.0f64)
                .scale(1.2f64)
                .frame(120.0f64, 60.0f64)
                .agent_id("grad")
        }
    };
    let h: f64 = mount_into(#addr_of(root), content.raw(), 160.0f64, 120.0f64);
    assert h > 0.0f64;
    assert surface_has_id(content.raw(), "grad");
}

#[test]
fn gradient_direction_maps_to_layer_start_end_points() {
    // The portable GradientDir reaches the CAGradientLayer's start/end points.
    // Horizontal → start (0, 0.5) end (1, 0.5); the default Vertical → (0.5, 0)→(0.5, 1).
    var b: facet::Node = facet::box()
        .frame(40.0f64, 40.0f64)
        .gradient(facet::Color::system_blue(), facet::Color::system_green(), facet::GradientDir::Horizontal);
    var n: flex::Node = mount(#addr_of(b));
    let layer: *u8 = { rt::msg_id(n.payload(), rt::sel(#str_ptr("layer\0"))) };
    let subs: *u8 = { rt::msg_id(layer, rt::sel(#str_ptr("sublayers\0"))) };
    assert subs != (0 as *u8);
    let gl: *u8 = { rt::msg_id_u64(subs, rt::sel(#str_ptr("objectAtIndex:\0")), 0 as u64) };
    let sp: rt::Point = { rt::msg_point(gl, rt::sel(#str_ptr("startPoint\0"))) };
    let ep: rt::Point = { rt::msg_point(gl, rt::sel(#str_ptr("endPoint\0"))) };
    assert sp.x == (0.0f64);
    assert sp.y == (0.5f64);
    assert ep.x == (1.0f64);
    assert ep.y == (0.5f64);
    return;
}

