// facet_appkit — facet's AppKit backend.
//
// Two modules: `./ui` (the `@ui` contextual-builder layer: widgets +
// containers over flex_layout and the typed appkit binding) and this one
// (the facet `Renderer` ops and the mount/apply hosts). Import
// "facet_appkit/ui" for direct `@ui` apps; import
// "facet_appkit/facet_appkit" for the `@facet` description model.
//
// facet owns the tree walk (`facet::mount`) and all layout; this package
// supplies the per-kind ops of the `Renderer` vtable by delegating to the
// ui module's widget constructors (typed binding underneath, view owned by
// the node's payload slot, clicks wired with identity), plus `set_identity`
// (called by mount after every widget op) and `run` — a window host that
// mounts a description tree and enters the event loop.
//
// Updates follow the keyed-direct model: a component's `build` renders once at
// mount; a handler then reaches the screen by addressing a keyed element
// (facet::find(key) + set_text / add_child / ...) and mutating its live view in
// place. facet is NOT reactive — there is no diff, no re-render loop, no global
// runtime. Window resize goes through ui::relayout (geometry only).
//
// Replaces the FACET.1 spike wholesale: views no longer leak (payload
// ownership), clicks are wired (action-with-userdata companion), and layout
// is the shared flex engine instead of NSStackView.

import "objc/runtime" as rt;
import "objc/bridge" as bridge;
import "stdlib/option" as option;
import "stdlib/text" as text;
import "stdlib/vec" as vec;
import "flex_layout/flex_layout" as flex;
import "appkit/appkit" as ak;
import "appkit/appkit_ext" as akx;
import "quartzcore/quartzcore" as quartz;
import "./ui" as ui;
import "facet/facet" as facet;
import "agent_core/identity" as identity;
import "agent_core/surface" as surface;
import "agent_appkit/agent_appkit" as agent;

// libm trig for the rotation transform matrix (link_name keeps the bare symbol).
#[link_name = "cos"] extern fn c_cos(x: f64) -> f64;
#[link_name = "sin"] extern fn c_sin(x: f64) -> f64;
extern fn snprintf(str: *u8, size: usize, format: *u8, ...) -> i32;

// ---- per-kind vtable ops ----------------------------------------------------
// Each reads the node's config and returns a ui-module node (NSView in the
// payload, measure wired). The node's Text is borrowed via c_str inside the
// match arm; the widget copies it into an NSString before the borrow ends.
// Agent id pinning is NOT done here — `mount` calls `set_identity` after
// every widget-producing op (the single choke point).

// ---- style application ------------------------------------------------------
// Map a portable facet::Color (set — token != 0) to a native NSColor. Semantic
// tokens map to the platform's adaptive colors (dark-mode correct); token 255
// is explicit sRGB.
fn ns_color(c: facet::Color) -> ak::Color {
    let t: u32 = { c.token };
    if t == (1 as u32) { return ak::Color::label_color(); }
    if t == (2 as u32) { return ak::Color::secondary_label_color(); }
    if t == (3 as u32) { return ak::Color::control_accent_color(); }
    if t == (4 as u32) { return ak::Color::system_red_color(); }
    if t == (5 as u32) { return ak::Color::system_green_color(); }
    if t == (6 as u32) { return ak::Color::system_blue_color(); }
    if t == (7 as u32) { return ak::Color::system_orange_color(); }
    if t == (8 as u32) { return ak::Color::system_gray_color(); }
    if t == (9 as u32) { return ak::Color::tertiary_label_color(); }
    if t == (10 as u32) { return ak::Color::separator_color(); }
    if t == (11 as u32) { return ak::Color::window_background_color(); }
    if t == (12 as u32) { return ak::Color::under_page_background_color(); }
    if t == (13 as u32) { return ak::Color::control_background_color(); }
    if t == (14 as u32) { return ak::Color::system_fill_color(); }
    return ak::Color::color_with_red({ c.r }, { c.g }, { c.b }, { c.a });
}

// Map a portable weight token to an NSFontWeight (a bare f64: regular 0.0,
// medium 0.23, semibold 0.3, bold 0.4 — Apple's documented constants).
fn ns_weight(w: u32) -> f64 {
    if w == facet::weight_medium() { return 0.23f64; }
    if w == facet::weight_semibold() { return 0.3f64; }
    if w == facet::weight_bold() { return 0.4f64; }
    return 0.0f64;   // regular / unset
}

// Build the NSFont the Style asks for. `size <= 0` means "keep the widget's
// size" — callers only reach here when at least one font field is set, so we
// fall back to 13pt (the system default) rather than 0.
fn ns_font(size: f64, weight: u32, family: u32) -> ak::Font {
    var sz: f64 = size;
    if sz <= 0.0f64 { sz = 13.0f64; }
    if family == facet::family_monospace() {
        return ak::Font::monospaced_system_font_of_size(sz, ns_weight(weight));
    }
    if weight != facet::weight_unset() {
        return ak::Font::system_font_of_size_weight(sz, ns_weight(weight));
    }
    return ak::Font::system_font_of_size(sz);
}

// Apply the portable Style to a freshly-built native view. Per-kind, NOT one
// uniform table: text widgets take fg via text color, controls via content
// tint; font rides NSControl.setFont; background / corner / border go through
// the view's CALayer (wantsLayer first). ONLY set fields are touched — an unset
// field never stomps a control's native font or a dark-mode-adaptive semantic
// color. Called from every op; when Style is blank every guard fails (no-op).
fn apply_style(view_ptr: *u8, kind: u32, np: *facet::Node) {
    if view_ptr == (0 as *u8) { return; }
    // Re-alias the Style locally so the paint logic below is unchanged; taking
    // the whole node lets us also apply per-node attrs (tooltip, a11y label).
    let style: facet::Style = { (*np).style };
    // Tooltip + accessibility label — plain per-node strings, not Style (which
    // must stay Copy).
    let ttp: *text::Text = { #addr_of((*np).tooltip) };
    if { (*ttp).view() } != "" { ak::View::from_raw(view_ptr).set_tool_tip({ (*ttp).view() }); }
    let alp: *text::Text = { #addr_of((*np).a11y_label) };
    if { (*alp).view() } != "" {
        ak::Accessibility::from_raw(view_ptr).set_accessibility_label({ (*alp).view() });
    }
    let ahp: *text::Text = { #addr_of((*np).a11y_hint) };
    if { (*ahp).view() } != "" {
        ak::Accessibility::from_raw(view_ptr).set_accessibility_help({ (*ahp).view() });
    }
    // Keyboard shortcut — the button's key equivalent.
    let kep: *text::Text = { #addr_of((*np).key_equiv) };
    if { (*kep).view() } != "" && kind == facet::kind_button() {
        ak::Button::from_raw(view_ptr).set_key_equivalent({ (*kep).view() });
    }
    // Context menu — a right-click NSMenu; each item dispatches the shared
    // handler with its index as ctx. NSMenuItem.target is weak, so we retain
    // each target via an associated object on its item; the view retains the menu.
    let cmi: *vec::Vec[text::Text] = { #addr_of((*np).ctx_menu_items) };
    let cm_cnt: usize = { (*cmi).count() };
    let cm_action: fn(*u8, *u8) = { (*np).ctx_menu_action };
    if cm_cnt > (0 as usize) && cm_action != (0 as fn(*u8, *u8)) {
        let menu_ptr: *u8 = rt::alloc_init(#str_ptr("NSMenu\0"));
        let menu: ak::Menu = ak::Menu::from_raw(menu_ptr);
        let asel: *u8 = akx::action_ctx_sel();
        var i: usize = 0 as usize;
        while i < cm_cnt {
            match (*cmi).at_ptr(i) {
                option::Option[*text::Text]::Some(tp) => {
                    let mi: ak::MenuItem = menu.add_item_with_title({ (*tp).view() }, asel, "");
                    let tgt: *u8 = akx::action_ctx_target(cm_action, i as *u8);
                    mi.set_target(tgt);
                    rt::set_associated_object(mi.raw(), 29001 as *u8, tgt, 1 as usize);   // RETAIN
                    rt::release(tgt);   // the association holds our +1
                }
                option::Option[*text::Text]::None => { }
            }
            i = i +% (1 as usize);
        }
        rt::msg_void_id(view_ptr, rt::sel(#str_ptr("setMenu:\0")), menu.raw());
        rt::release(menu_ptr);   // the view retains its menu
    }
    let is_text: bool = kind == facet::kind_label() || kind == facet::kind_wrap_label();
    // Foreground.
    let fg: facet::Color = { style.fg };
    if fg.is_set() {
        if is_text {
            ak::TextField::from_raw(view_ptr).set_text_color(ns_color(fg));
        } else if kind == facet::kind_button() {
            ak::Button::from_raw(view_ptr).set_content_tint_color(ns_color(fg));
        } else if kind == facet::kind_symbol() {
            // An SF Symbol is an NSImageView; its color is the content tint
            // (the same knob ui::symbol_tinted uses for a green ✓ / red ✕).
            ak::ImageView::from_raw(view_ptr).set_content_tint_color(ns_color(fg));
        }
    }
    // Font (size / weight / family) — text widgets + buttons carry a font via
    // NSControl.setFont. Setting any font field replaces the whole NSFont
    // (SwiftUI `.font` semantics): pair `.font(size)` with `.strong()` for bold;
    // the legacy `bold:` constructor arg is a separate pre-Style path. Editors
    // keep their own font (Phase 3 reaches the inner text view via documentView).
    let fsz: f64 = { style.font_size };
    let wt: u32 = { style.weight };
    let fam: u32 = { style.family };
    let ital: bool = { style.italic };
    if fsz > 0.0f64 || wt != facet::weight_unset() || fam != facet::family_unset() || ital {
        var font: ak::Font = ns_font(fsz, wt, fam);
        // Italic — NSFontManager trait conversion (NSItalicFontMask = 1).
        if ital { font = ak::FontManager::shared_font_manager().convert_font_to_have_trait(font, 1 as u64); }
        if is_text {
            ak::TextField::from_raw(view_ptr).as_control().set_font(font);
        } else if kind == facet::kind_button() {
            ak::Button::from_raw(view_ptr).as_control().set_font(font);
        }
    }
    // Layer-backed: background / corner / border / clip.
    let bg: facet::Color = { style.bg };
    let corner: f64 = { style.corner_radius };
    let border_w: f64 = { style.border_width };
    let clip: bool = { style.clip };
    // A path reuses bg/border as its fill/stroke (painted on its CAShapeLayer in
    // ak_path), so skip the container background/border block for it.
    if (bg.is_set() || corner > 0.0f64 || border_w > 0.0f64 || clip) && kind != facet::kind_path() {
        let v: ak::View = ak::View::from_raw(view_ptr);
        v.set_wants_layer(true);
        let lyr: quartz::Layer = v.layer();
        if clip { lyr.set_masks_to_bounds(true); }   // clip content to the (rounded) bounds
        if bg.is_set() { lyr.set_background_color(ns_color(bg).c_g_color()); }
        if corner > 0.0f64 { lyr.set_corner_radius(corner); }
        if border_w > 0.0f64 {
            lyr.set_border_width(border_w);
            let bc: facet::Color = { style.border_color };
            if bc.is_set() { lyr.set_border_color(ns_color(bc).c_g_color()); }
        }
    }
    // Opacity — NSView.alphaValue (no layer needed).
    let op: f64 = { style.opacity };
    if op >= 0.0f64 { ak::View::from_raw(view_ptr).set_alpha_value(op); }
    // Hidden — invisible but keeps its layout space.
    if { style.hidden } { ak::View::from_raw(view_ptr).set_hidden(true); }
    // Gradient fill — a CAGradientLayer inserted behind content, sized to the
    // view and autoresizing with it (so it tracks the frame apply sets later).
    let gf: facet::Color = { style.grad_from };
    let gt: facet::Color = { style.grad_to };
    if gf.is_set() && gt.is_set() {
        let gv: ak::View = ak::View::from_raw(view_ptr);
        gv.set_wants_layer(true);
        let arr: *u8 = rt::msg_id(rt::get_class(#str_ptr("NSMutableArray\0")), rt::sel(#str_ptr("array\0")));
        rt::msg_void_id(arr, rt::sel(#str_ptr("addObject:\0")), ns_color(gf).c_g_color());
        rt::msg_void_id(arr, rt::sel(#str_ptr("addObject:\0")), ns_color(gt).c_g_color());
        let gl: quartz::GradientLayer = quartz::GradientLayer::new();
        gl.set_colors(quartz::NSArray::from_raw(arr));
        // start→end in unit space (y=0 is the top here). Vertical = top→bottom.
        var sp: rt::Point = rt::Point { x: 0.5, y: 0.0 };
        var ep: rt::Point = rt::Point { x: 0.5, y: 1.0 };
        match { style.grad_dir } {
            facet::GradientDir::Vertical => { }
            facet::GradientDir::Horizontal => { sp = rt::Point { x: 0.0, y: 0.5 }; ep = rt::Point { x: 1.0, y: 0.5 }; }
            facet::GradientDir::DiagonalTLBR => { sp = rt::Point { x: 0.0, y: 0.0 }; ep = rt::Point { x: 1.0, y: 1.0 }; }
            facet::GradientDir::DiagonalTRBL => { sp = rt::Point { x: 1.0, y: 0.0 }; ep = rt::Point { x: 0.0, y: 1.0 }; }
        }
        gl.set_start_point(sp);
        gl.set_end_point(ep);
        let gll: quartz::Layer = quartz::Layer::from_raw(gl.raw());
        gll.set_frame(gv.bounds());
        gll.set_autoresizing_mask(18 as u64);               // width|height sizable
        rt::msg_void_id_u64(gv.layer().raw(), rt::sel(#str_ptr("insertSublayer:atIndex:\0")), gl.raw(), 0 as u64);
    }
    // Transform — rotation (deg) + uniform scale as a CATransform3D on the
    // backing layer. Pivot is the layer's anchor (center for a backing layer).
    let rot: f64 = { style.rotation };
    let scl: f64 = { style.scale };
    if rot != 0.0f64 || scl != 1.0f64 {
        let tv: ak::View = ak::View::from_raw(view_ptr);
        tv.set_wants_layer(true);
        let a: f64 = rot * 0.017453292519943295f64;   // deg → rad
        let c: f64 = c_cos(a);
        let s: f64 = c_sin(a);
        let t: quartz::Transform3D = quartz::Transform3D {
            m11: c * scl, m12: s * scl, m13: 0.0f64, m14: 0.0f64,
            m21: (0.0f64 - s) * scl, m22: c * scl, m23: 0.0f64, m24: 0.0f64,
            m31: 0.0f64, m32: 0.0f64, m33: 1.0f64, m34: 0.0f64,
            m41: 0.0f64, m42: 0.0f64, m43: 0.0f64, m44: 1.0f64,
        };
        tv.layer().set_transform(t);
    }
    // Drop shadow — layer-backed; a soft black shadow at the given blur radius.
    let sr: f64 = { style.shadow_radius };
    if sr > 0.0f64 {
        let sv: ak::View = ak::View::from_raw(view_ptr);
        sv.set_wants_layer(true);
        let slyr: quartz::Layer = sv.layer();
        slyr.set_shadow_radius(sr);
        slyr.set_shadow_opacity(0.25f32);
        slyr.set_shadow_offset(rt::Size { w: 0.0, h: -2.0 });
        slyr.set_shadow_color(ak::Color::color_with_red(0.0f64, 0.0f64, 0.0f64, 1.0f64).c_g_color());
    }
    // Entrance fade — a CABasicAnimation on the backing layer's opacity (0→1)
    // that plays once when the view mounts. SwiftUI `.transition(.opacity)`.
    let fi: f64 = { style.fade_in };
    if fi > 0.0f64 {
        let fv: ak::View = ak::View::from_raw(view_ptr);
        fv.set_wants_layer(true);
        let anim_raw: *u8 = rt::msg_id(rt::msg_id(rt::get_class(#str_ptr("CABasicAnimation\0")), rt::sel(#str_ptr("alloc\0"))), rt::sel(#str_ptr("init\0")));
        let anim: quartz::BasicAnimation = quartz::BasicAnimation::from_raw(anim_raw);
        anim.as_property_animation().set_key_path("opacity");   // str → NSString
        let nn: *u8 = rt::get_class(#str_ptr("NSNumber\0"));
        anim.set_from_value(rt::msg_id_f64(nn, rt::sel(#str_ptr("numberWithDouble:\0")), 0.0f64));
        anim.set_to_value(rt::msg_id_f64(nn, rt::sel(#str_ptr("numberWithDouble:\0")), 1.0f64));
        rt::msg_void_f64(anim_raw, rt::sel(#str_ptr("setDuration:\0")), fi);
        fv.layer().add_animation(anim.as_animation(), "opacity");  // the layer copies it
        rt::release(anim_raw);   // drop our alloc/init +1
    }
    // Line limit — max text lines on labels (0 = unlimited).
    let ll: i32 = { style.line_limit };
    if ll > (0 as i32) && is_text {
        ak::TextField::from_raw(view_ptr).set_maximum_number_of_lines(ll as i64);
    }
    // Underline / strikethrough — build a mutable attributed copy of the current
    // value, add the requested attribute(s) over the whole range, set it back.
    // (NSNumber(1) = single line; keys "NSUnderline" / "NSStrikethrough".)
    if ({ style.underline } || { style.strikethrough }) && is_text {
        let ctrl: ak::Control = ak::TextField::from_raw(view_ptr).as_control();
        let len: u64 = ctrl.string_value().count() as u64;
        if len > (0 as u64) {
            let cur: ak::AttributedString = ctrl.attributed_string_value();
            let alloc: *u8 = rt::msg_id(rt::get_class(#str_ptr("NSMutableAttributedString\0")), rt::sel(#str_ptr("alloc\0")));
            let mas_ptr: *u8 = rt::msg_id_id(alloc, rt::sel(#str_ptr("initWithAttributedString:\0")), cur.raw());
            let one: *u8 = rt::msg_id_i64(rt::get_class(#str_ptr("NSNumber\0")), rt::sel(#str_ptr("numberWithInt:\0")), 1 as i64);
            let mas: ak::MutableAttributedString = ak::MutableAttributedString::from_raw(mas_ptr);
            let full: rt::Range = rt::Range { location: 0 as u64, length: len };
            if { style.underline } { mas.add_attribute("NSUnderline", one, full); }
            if { style.strikethrough } { mas.add_attribute("NSStrikethrough", one, full); }
            ctrl.set_attributed_string_value(mas.as_attributed_string());
            rt::release(mas_ptr);   // the control copied it; drop our +1
        }
    }
    // Text alignment — NSControl.setAlignment: (raw; the binding routes it via a
    // cell). NSTextAlignment: Left 0, Right 1, Center 2, Natural 4. leading→
    // natural, center→center, trailing→right.
    let ta: i32 = { style.text_align };
    if ta > (0 as i32) && is_text {
        var nsa: i64 = 4 as i64;                       // leading → natural
        if ta == (2 as i32) { nsa = 2 as i64; }        // center
        else if ta == (3 as i32) { nsa = 1 as i64; }   // trailing → right
        rt::msg_void_id(view_ptr, rt::sel(#str_ptr("setAlignment:\0")), nsa as *u8);
    }
    return;
}

fn ak_label(ctx: *u8, np: *facet::Node) -> flex::Node {
    var size: f64 = { (*np).font_size };
    if size <= 0.0f64 { size = 13.0f64; }
    var n: flex::Node = flex::Node::new();
    let tp: *text::Text = { #addr_of((*np).text) };
    let trunc: bool = { (*np).style.truncate };
    match (*tp).c_str() {
        option::Option[text::CString]::Some(cs) => {
            let sv: str = { #str_from_raw_parts(cs.as_ptr(), cs.count()) };
            n = ui::label(sv, size: size, bold: { (*np).bold }, secondary: { (*np).secondary }, truncate: trunc);
        }
        option::Option[text::CString]::None => {
            n = ui::label("", size: size, truncate: trunc);
        }
    };
    apply_style(n.payload(), facet::kind_label(), np);
    return n;
}

fn ak_wrap_label(ctx: *u8, np: *facet::Node) -> flex::Node {
    var size: f64 = { (*np).font_size };
    if size <= 0.0f64 { size = 13.0f64; }
    var n: flex::Node = flex::Node::new();
    let tp: *text::Text = { #addr_of((*np).text) };
    match (*tp).c_str() {
        option::Option[text::CString]::Some(cs) => {
            let sv: str = { #str_from_raw_parts(cs.as_ptr(), cs.count()) };
            n = ui::wrap_label(sv, size: size, secondary: { (*np).secondary });
        }
        option::Option[text::CString]::None => {
            n = ui::wrap_label("", size: size);
        }
    };
    apply_style(n.payload(), facet::kind_wrap_label(), np);
    return n;
}

fn ak_button(ctx: *u8, np: *facet::Node) -> flex::Node {
    var n: flex::Node = flex::Node::new();
    // `icon_button(name)` carries the SF Symbol name in `value`; build the
    // image-only variant instead of a titled push button.
    let vp: *text::Text = { #addr_of((*np).value) };
    let sym: str = { (*vp).view() };
    if sym != "" {
        n = ui::icon_button_view(sym);
    } else {
        let tp: *text::Text = { #addr_of((*np).text) };
        match (*tp).c_str() {
            option::Option[text::CString]::Some(cs) => {
                let sv: str = { #str_from_raw_parts(cs.as_ptr(), cs.count()) };
                n = ui::button_view(sv, primary: { (*np).primary });
            }
            option::Option[text::CString]::None => {
                n = ui::button_view("", primary: { (*np).primary });
            }
        };
    }
    // Wire the action exactly once (a replaced target strands its creation
    // reference — never rewire). click_ctx carries the component's address so
    // the handler can address its own keyed elements via facet::find(ctx, key);
    // the wire runs the handler and nothing more — facet is not reactive.
    let b: ak::Button = ak::Button::from_raw(n.payload());
    // `.plain()` → borderless button (the link/plain-button fold).
    if { (*np).plain } { b.set_bordered(false); }
    akx::set_control_action_ctx(b.as_control(), { (*np).click }, { (*np).click_ctx });
    apply_style(n.payload(), facet::kind_button(), np);
    return n;
}

// Text-level Style for a scroll-hosted editor: font (size / weight / family)
// and foreground apply to the INNER text view — the scroll host only takes the
// layer paints. The caret (insertion point) follows the foreground so it stays
// visible on a dark editor background. Only set fields are touched.
fn apply_editor_text_style(scroll_ptr: *u8, np: *facet::Node) {
    if scroll_ptr == (0 as *u8) { return; }
    let style: facet::Style = { (*np).style };
    let fsz: f64 = { style.font_size };
    let wt: u32 = { style.weight };
    let fam: u32 = { style.family };
    let ital: bool = { style.italic };
    let fg: facet::Color = { style.fg };
    let has_font: bool = fsz > 0.0f64 || wt != facet::weight_unset() || fam != facet::family_unset() || ital;
    if !has_font && !fg.is_set() { return; }
    let dv: *u8 = rt::msg_id(scroll_ptr, rt::sel(#str_ptr("documentView\0")));
    if dv == (0 as *u8) { return; }
    let tv: ak::TextView = ak::TextView::from_raw(dv);
    if has_font {
        var font: ak::Font = ns_font(fsz, wt, fam);
        if ital { font = ak::FontManager::shared_font_manager().convert_font_to_have_trait(font, 1 as u64); }
        tv.as_text().set_font(font);
    }
    if fg.is_set() {
        tv.as_text().set_text_color(ns_color(fg));
        tv.set_insertion_point_color(ns_color(fg));
    }
    return;
}

fn ak_text_area(ctx: *u8, np: *facet::Node) -> flex::Node {
    let ch: fn(*u8, *u8) = { (*np).on_change };
    let cctx: *u8 = { (*np).click_ctx };
    let ed: bool = { (*np).editable };   // `false` = read-only transcript view
    let sb: bool = { (*np).show_border };
    let db: bool = { (*np).draws_background };
    let iw: f64 = { (*np).inset_w };
    let ih: f64 = { (*np).inset_h };
    let wr: bool = { (*np).soft_wrap };
    let ss: bool = { (*np).smart_subs };
    let ln: bool = { (*np).line_numbers };
    let vp: *text::Text = { #addr_of((*np).value) };
    var n: flex::Node = flex::Node::new();
    match (*vp).c_str() {
        option::Option[text::CString]::Some(vcs) => {
            let vs: str = { #str_from_raw_parts(vcs.as_ptr(), vcs.count()) };
            n = ui::text_area(value: vs, on_change: ch, ctx: cctx, editable: ed, show_border: sb, draws_background: db, inset_w: iw, inset_h: ih, wrap: wr, smart_substitutions: ss, line_numbers: ln);
        }
        option::Option[text::CString]::None => {
            n = ui::text_area(value: "", on_change: ch, ctx: cctx, editable: ed, show_border: sb, draws_background: db, inset_w: iw, inset_h: ih, wrap: wr, smart_substitutions: ss, line_numbers: ln);
        }
    };
    // Editors take the layer paints (bg/corner/border) on their scroll host and
    // the TEXT channels (font family/size/weight, foreground + caret) on the
    // inner text view.
    apply_style(n.payload(), facet::kind_text_area(), np);
    apply_editor_text_style(n.payload(), np);
    return n;
}

fn ak_composer(ctx: *u8, np: *facet::Node) -> flex::Node {
    let sh: fn(*u8, *u8) = { (*np).on_submit };
    let sctx: *u8 = { (*np).click_ctx };
    let ch: fn(*u8, *u8) = { (*np).on_change };
    let vp: *text::Text = { #addr_of((*np).value) };
    var n: flex::Node = flex::Node::new();
    match (*vp).c_str() {
        option::Option[text::CString]::Some(cs) => {
            let sv: str = { #str_from_raw_parts(cs.as_ptr(), cs.count()) };
            n = ui::composer(
                sh,
                on_change: ch,
                ctx: sctx,
                value: sv,
                show_border: { (*np).show_border },
                draws_background: { (*np).draws_background },
            );
        }
        option::Option[text::CString]::None => {
            n = ui::composer(
                sh,
                on_change: ch,
                ctx: sctx,
                value: "",
                show_border: { (*np).show_border },
                draws_background: { (*np).draws_background },
            );
        }
    };
    apply_style(n.payload(), facet::kind_composer(), np);
    return n;
}

// ---- Tier-2 leaf ops (Phase 2) — thin adapters over the ui:: widgets --------

fn ak_image(ctx: *u8, np: *facet::Node) -> flex::Node {
    var n: flex::Node = flex::Node::new();
    let vp: *text::Text = { #addr_of((*np).value) };
    match (*vp).c_str() {
        option::Option[text::CString]::Some(cs) => {
            let sv: str = { #str_from_raw_parts(cs.as_ptr(), cs.count()) };
            n = ui::image(sv);
        }
        option::Option[text::CString]::None => { n = ui::image(""); }
    };
    apply_style(n.payload(), facet::kind_image(), np);
    return n;
}

fn ak_symbol(ctx: *u8, np: *facet::Node) -> flex::Node {
    var side: f64 = { (*np).font_size };
    if side <= 0.0f64 { side = 16.0f64; }
    var n: flex::Node = flex::Node::new();
    let vp: *text::Text = { #addr_of((*np).value) };
    match (*vp).c_str() {
        option::Option[text::CString]::Some(cs) => {
            let sv: str = { #str_from_raw_parts(cs.as_ptr(), cs.count()) };
            n = ui::symbol(sv, side, secondary: { (*np).secondary });
        }
        option::Option[text::CString]::None => { n = ui::symbol("", side); }
    };
    apply_style(n.payload(), facet::kind_symbol(), np);
    return n;
}

fn ak_text_field(ctx: *u8, np: *facet::Node) -> flex::Node {
    var n: flex::Node = flex::Node::new();
    let vp: *text::Text = { #addr_of((*np).value) };
    let pp: *text::Text = { #addr_of((*np).placeholder) };
    match (*vp).c_str() {
        option::Option[text::CString]::Some(vcs) => {
            let vs: str = { #str_from_raw_parts(vcs.as_ptr(), vcs.count()) };
            match (*pp).c_str() {
                option::Option[text::CString]::Some(pcs) => {
                    let ps: str = { #str_from_raw_parts(pcs.as_ptr(), pcs.count()) };
                    n = ui::text_field(placeholder: ps, value: vs);
                }
                option::Option[text::CString]::None => { n = ui::text_field(value: vs); }
            }
        }
        option::Option[text::CString]::None => {
            match (*pp).c_str() {
                option::Option[text::CString]::Some(pcs) => {
                    let ps: str = { #str_from_raw_parts(pcs.as_ptr(), pcs.count()) };
                    n = ui::text_field(placeholder: ps);
                }
                option::Option[text::CString]::None => { n = ui::text_field(); }
            }
        }
    };
    apply_style(n.payload(), facet::kind_text_field(), np);
    return n;
}

fn ak_popup(ctx: *u8, np: *facet::Node) -> flex::Node {
    // NSPopUpButton: selector (pulls_down false) OR pull-down menu (true). Built
    // directly so `menu(...)` (pull-down + title + on_change) shares this op.
    let pull: bool = { (*np).pull_down };
    let zero: rt::Rect = rt::Rect { x: 0.0, y: 0.0, w: 0.0, h: 0.0 };
    let p: ak::PopUpButton = ak::PopUpButton::new(zero, pull);
    // Items are added through the button's MENU, never NSPopUpButton's own
    // addItemWithTitle:, which REMOVES any existing item with the same title.
    // A pull-down whose fixed title equals one of its rows (a model switcher
    // titled with the current choice) had that row silently eaten and every
    // later index shifted — the selection landed one row off (live bug).
    // Menu-level items keep no per-item action; the control's action still
    // fires on selection. Pull-down: item 0 stays the fixed displayed title.
    let src: *vec::Vec[text::Text] = { #addr_of((*np).popup_items) };
    let cnt: usize = { (*src).count() };
    match p.menu() {
        option::Option[ak::Menu]::Some(menu) => {
            if pull {
                let tp: *text::Text = { #addr_of((*np).text) };
                let _t: ak::MenuItem = menu.add_item_with_title({ (*tp).view() }, 0 as *u8, "");
            }
            var i: usize = 0 as usize;
            while i < cnt {
                match (*src).at_ptr(i) {
                    option::Option[*text::Text]::Some(tp) => {
                        let _mi: ak::MenuItem = menu.add_item_with_title({ (*tp).view() }, 0 as *u8, "");
                    }
                    option::Option[*text::Text]::None => { }
                }
                i = i +% (1 as usize);
            }
        }
        option::Option[ak::Menu]::None => { }
    };
    if pull == false {
        let sel: i64 = { (*np).popup_selected };
        if sel >= (0 as i64) && sel < (cnt as i64) { p.select_item_at_index(sel); }
    }
    let ch: fn(*u8, *u8) = { (*np).on_change };
    if ch != (0 as fn(*u8, *u8)) {
        akx::set_control_action_ctx(p.as_control(), ch, { (*np).click_ctx });
    }
    // `.plain()` → borderless popup (the same fold as button): a quiet,
    // text-like dropdown for toolbar / composer control rows.
    if { (*np).plain } { p.as_button().set_bordered(false); }
    var n: flex::Node = ui::view(p.as_view());
    apply_style(n.payload(), facet::kind_popup(), np);
    return n;
}

fn ak_divider(ctx: *u8, np: *facet::Node) -> flex::Node {
    var n: flex::Node = ui::divider();
    apply_style(n.payload(), facet::kind_divider(), np);
    return n;
}

// ---- form controls (matrix §2) ----------------------------------------------
fn ak_toggle(ctx: *u8, np: *facet::Node) -> flex::Node {
    var st: i64 = 0 as i64;
    if { (*np).bool_value } { st = 1 as i64; }
    let ch: fn(*u8, *u8) = { (*np).on_change };
    let style: i32 = { (*np).toggle_style };
    if style == (0 as i32) {
        let sw: ak::Switch = ak::Switch::new();
        sw.set_state(st);
        if ch != (0 as fn(*u8, *u8)) {
            akx::set_control_action_ctx(sw.as_control(), ch, { (*np).click_ctx });
        }
        var n: flex::Node = ui::view(sw.as_view());
        apply_style(n.payload(), facet::kind_toggle(), np);
        return n;
    }
    // Checkbox / radio → NSButton with the matching button type + a title.
    let b: ak::Button = ak::Button::new();
    if style == (2 as i32) { b.set_button_type(ak::ButtonType::Radio); }
    else { b.set_button_type(ak::ButtonType::Switch); }   // Switch type = checkbox
    let tp: *text::Text = { #addr_of((*np).text) };
    match (*tp).c_str() {
        option::Option[text::CString]::Some(cs) => {
            b.set_title({ #str_from_raw_parts(cs.as_ptr(), cs.count()) });
        }
        option::Option[text::CString]::None => { }
    };
    b.set_state(st);
    if ch != (0 as fn(*u8, *u8)) {
        akx::set_control_action_ctx(b.as_control(), ch, { (*np).click_ctx });
    }
    var bn: flex::Node = ui::view(b.as_view());
    apply_style(bn.payload(), facet::kind_toggle(), np);
    return bn;
}

fn ak_color_picker(ctx: *u8, np: *facet::Node) -> flex::Node {
    let cw: ak::ColorWell = ak::ColorWell::new();
    let ch: fn(*u8, *u8) = { (*np).on_change };
    if ch != (0 as fn(*u8, *u8)) {
        akx::set_control_action_ctx(cw.as_control(), ch, { (*np).click_ctx });
    }
    var n: flex::Node = ui::fixed_view(cw.as_view());
    apply_style(n.payload(), facet::kind_color_picker(), np);
    return n;
}

fn ak_date_picker(ctx: *u8, np: *facet::Node) -> flex::Node {
    let dp: ak::DatePicker = ak::DatePicker::new();   // defaults to the current date
    let ch: fn(*u8, *u8) = { (*np).on_change };
    if ch != (0 as fn(*u8, *u8)) {
        akx::set_control_action_ctx(dp.as_control(), ch, { (*np).click_ctx });
    }
    var n: flex::Node = ui::fixed_view(dp.as_view());
    apply_style(n.payload(), facet::kind_date_picker(), np);
    return n;
}

// A styled rectangle (Shapes): a plain NSView; apply_style paints bg / corner /
// border (wantsLayer). A full-radius square reads as a circle. With `.on_drop`
// set it is instead a FacetDropView registered for text drops (SwiftUI
// `.dropDestination`); the handler reads the payload via `dropped_text(sender)`.
// Keyed-container backing view (approach A). facet mount calls this only for a
// keyed column/row/zstack/grid: create a real NSView and set it as the (already
// built, child-bearing) flex node's payload, so find(key) can address the
// container. `apply` then takes its payload branch and hosts the children under
// this view — identical to the view it would otherwise synthesize lazily, but
// created early enough for mount to pin the container's agent id on it.
fn fak_container(ctx: *u8, np: *facet::Node, node: *flex::Node) {
    let bv: ak::View = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 0.0, h: 0.0 });
    let bp: *u8 = rt::retain(bv.raw());
    { (*node).set_payload(bp, ui::release_view); }
    return;
}

fn ak_box(ctx: *u8, np: *facet::Node) -> flex::Node {
    let drop: fn(*u8, *u8) = { (*np).drop_handler };
    let dtp: *text::Text = { #addr_of((*np).drag_text) };
    let drag: str = { (*dtp).view() };
    var v: ak::View = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 0.0, h: 0.0 });
    if drag != "" {
        v = akx::new_drag_view(drag);              // drag SOURCE
    } else if drop != facet::null_fn() {
        v = akx::new_drop_view(drop, { (*np).drop_ctx });   // drop DESTINATION
    }
    var n: flex::Node = ui::fixed_view(v);
    apply_style(n.payload(), facet::kind_box(), np);
    return n;
}

// The text most recently dropped on a drop-zone `box` — call from an on_drop
// handler with its `sender` (SwiftUI's dropped-item payload). Empty if none.
fn dropped_text(sender: *u8) -> text::Text {
    return akx::drop_text_of(sender);
}

fn ak_gauge(ctx: *u8, np: *facet::Node) -> flex::Node {
    let li: ak::LevelIndicator = ak::LevelIndicator::new();
    li.set_min_value({ (*np).min_val });
    li.set_max_value({ (*np).max_val });
    li.as_control().set_double_value({ (*np).value_f });
    var n: flex::Node = ui::fixed_view(li.as_view());
    apply_style(n.payload(), facet::kind_gauge(), np);
    return n;
}

// A custom vector shape. The outline is built as an NSBezierPath with y flipped
// into the layer's bottom-left space (so a top-left path renders upright), then
// handed as a CGPath to a CAShapeLayer sublayer. Fill = style.bg, stroke =
// style.border (apply_style skips those for kind_path — see the guard there).
fn ak_path(ctx: *u8, np: *facet::Node) -> flex::Node {
    let w: f64 = facet::fixed_width(np);
    let h: f64 = facet::fixed_height(np);
    let container: ak::View = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: w, h: h });
    container.set_wants_layer(true);

    let bez: ak::BezierPath = ak::BezierPath::bezier_path();
    let cmds: *vec::Vec[facet::PathCmd] = { #addr_of((*np).path_cmds) };
    let count: usize = { (*cmds).count() };
    var i: usize = 0 as usize;
    while i < count {
        match { (*cmds).at(i) } {
            option::Option[facet::PathCmd]::Some(c) => {
                let op: u32 = c.op;
                if op == facet::path_op_move() {
                    bez.move_to_point(rt::Point { x: c.ax, y: h - c.ay });
                } else if op == facet::path_op_line() {
                    bez.line_to_point(rt::Point { x: c.ax, y: h - c.ay });
                } else if op == facet::path_op_quad() {
                    bez.curve_to_point(rt::Point { x: c.ax, y: h - c.ay }, rt::Point { x: c.bx, y: h - c.by });
                } else if op == facet::path_op_cubic() {
                    bez.curve_to_point_control_point1(rt::Point { x: c.ax, y: h - c.ay }, rt::Point { x: c.bx, y: h - c.by }, rt::Point { x: c.cx, y: h - c.cy });
                } else if op == facet::path_op_close() {
                    bez.close_path();
                }
            }
            option::Option[facet::PathCmd]::None => {}
        }
        i = i + (1 as usize);
    }

    // CAShapeLayer's binding is unusable (mis-bound to TextLayer), so drive it raw.
    let cg: *u8 = rt::msg_id(bez.raw(), rt::sel(#str_ptr("CGPath\0")));
    let shape: *u8 = rt::msg_id(rt::get_class(#str_ptr("CAShapeLayer\0")), rt::sel(#str_ptr("layer\0")));
    rt::msg_void_id(shape, rt::sel(#str_ptr("setPath:\0")), cg);

    let style: facet::Style = { (*np).style };
    let fill: facet::Color = style.bg;
    if fill.is_set() {
        rt::msg_void_id(shape, rt::sel(#str_ptr("setFillColor:\0")), ns_color(fill).c_g_color());
    } else {
        rt::msg_void_id(shape, rt::sel(#str_ptr("setFillColor:\0")), 0 as *u8);   // clear default black fill
    }
    let sw: f64 = style.border_width;
    let sc: facet::Color = style.border_color;
    if sw > 0.0f64 && sc.is_set() {
        rt::msg_void_id(shape, rt::sel(#str_ptr("setStrokeColor:\0")), ns_color(sc).c_g_color());
        rt::msg_void_f64(shape, rt::sel(#str_ptr("setLineWidth:\0")), sw);
    }

    let slyr: quartz::Layer = quartz::Layer::from_raw(shape);
    slyr.set_frame(container.bounds());
    slyr.set_autoresizing_mask(18 as u64);                  // width|height sizable
    rt::msg_void_id_u64(container.layer().raw(), rt::sel(#str_ptr("insertSublayer:atIndex:\0")), shape, 0 as u64);

    var n: flex::Node = ui::fixed_view(container);
    apply_style(n.payload(), facet::kind_path(), np);
    return n;
}

fn ak_slider(ctx: *u8, np: *facet::Node) -> flex::Node {
    let sl: ak::Slider = ak::Slider::new();
    sl.set_min_value({ (*np).min_val });
    sl.set_max_value({ (*np).max_val });
    sl.as_control().set_double_value({ (*np).value_f });
    let ch: fn(*u8, *u8) = { (*np).on_change };
    if ch != (0 as fn(*u8, *u8)) {
        akx::set_control_action_ctx(sl.as_control(), ch, { (*np).click_ctx });
    }
    var n: flex::Node = ui::fixed_view(sl.as_view());
    apply_style(n.payload(), facet::kind_slider(), np);
    return n;
}

fn ak_progress(ctx: *u8, np: *facet::Node) -> flex::Node {
    let pi: ak::ProgressIndicator = ak::ProgressIndicator::new();
    if { (*np).indeterminate } {
        pi.set_indeterminate(true);
        pi.start_animation(0 as *u8);
    } else {
        pi.set_indeterminate(false);
        pi.set_min_value(0.0f64);
        pi.set_max_value(1.0f64);
        pi.set_double_value({ (*np).value_f });
    }
    var n: flex::Node = ui::fixed_view(pi.as_view());
    apply_style(n.payload(), facet::kind_progress(), np);
    return n;
}

fn ak_stepper(ctx: *u8, np: *facet::Node) -> flex::Node {
    let st: ak::Stepper = ak::Stepper::new();
    st.set_min_value({ (*np).min_val });
    st.set_max_value({ (*np).max_val });
    st.set_increment({ (*np).step_val });
    st.as_control().set_double_value({ (*np).value_f });
    let ch: fn(*u8, *u8) = { (*np).on_change };
    if ch != (0 as fn(*u8, *u8)) {
        akx::set_control_action_ctx(st.as_control(), ch, { (*np).click_ctx });
    }
    var n: flex::Node = ui::fixed_view(st.as_view());
    apply_style(n.payload(), facet::kind_stepper(), np);
    return n;
}

fn ak_secure_field(ctx: *u8, np: *facet::Node) -> flex::Node {
    let vp: *text::Text = { #addr_of((*np).value) };
    let pp: *text::Text = { #addr_of((*np).placeholder) };
    var n: flex::Node = flex::Node::new();
    match (*vp).c_str() {
        option::Option[text::CString]::Some(vcs) => {
            let vs: str = { #str_from_raw_parts(vcs.as_ptr(), vcs.count()) };
            match (*pp).c_str() {
                option::Option[text::CString]::Some(pcs) => {
                    let ps: str = { #str_from_raw_parts(pcs.as_ptr(), pcs.count()) };
                    n = ui::secure_field(placeholder: ps, value: vs);
                }
                option::Option[text::CString]::None => { n = ui::secure_field(value: vs); }
            }
        }
        option::Option[text::CString]::None => {
            match (*pp).c_str() {
                option::Option[text::CString]::Some(pcs) => {
                    let ps: str = { #str_from_raw_parts(pcs.as_ptr(), pcs.count()) };
                    n = ui::secure_field(placeholder: ps);
                }
                option::Option[text::CString]::None => { n = ui::secure_field(); }
            }
        }
    };
    apply_style(n.payload(), facet::kind_secure_field(), np);
    return n;
}

fn ak_segmented(ctx: *u8, np: *facet::Node) -> flex::Node {
    let sc: ak::SegmentedControl = ak::SegmentedControl::new();
    let src: *vec::Vec[text::Text] = { #addr_of((*np).popup_items) };
    let cnt: usize = { (*src).count() };
    sc.set_segment_count(cnt as i64);
    var i: usize = 0 as usize;
    while i < cnt {
        match { (*src).at_ptr(i) } {
            option::Option[*text::Text]::Some(tp) => { sc.set_label({ (*tp).view() }, i as i64); }
            option::Option[*text::Text]::None => { }
        }
        i = i +% (1 as usize);
    }
    sc.set_selected_segment({ (*np).popup_selected });
    let ch: fn(*u8, *u8) = { (*np).on_change };
    if ch != (0 as fn(*u8, *u8)) {
        akx::set_control_action_ctx(sc.as_control(), ch, { (*np).click_ctx });
    }
    var n: flex::Node = ui::fixed_view(sc.as_view());
    apply_style(n.payload(), facet::kind_segmented(), np);
    return n;
}

// Read-back: surface the ui:: value readers through the facet layer so an app
// (Phase 5) can pull a field's text / a popup's index from the mounted view.
fn field_text(view_ptr: *u8) -> text::Text { return ui::field_text(view_ptr); }
fn popup_index(view_ptr: *u8) -> i64 { return ui::popup_index(view_ptr); }

// The escape-hatch op: adopt the retained handle the facet Node carries into a
// flex payload. `native()`/`native_widget()` below did the +1 retain; adopt_view
// takes ownership of that one reference (release_view drops it on tree drop).
fn ak_native(ctx: *u8, np: *facet::Node) -> flex::Node {
    var n: flex::Node = ui::adopt_view({ (*np).native_handle });
    apply_style(n.payload(), facet::kind_native(), np);
    return n;
}

// Wrap a native view into a `@facet` tree. Retains +1 so the view survives from
// wrap-time through mount (safe against a temporary); the mounted payload adopts
// that reference. The app owns the base view (a component field) and calls this
// FRESH each render — each render retains, each prior tree drop releases.
fn native(v: ak::View) -> facet::Node {
    let held: *u8 = rt::retain(v.raw());
    return facet::native(held);
}

// One-shot: wrap an existing ui:: leaf widget (a `flex::Node` whose payload is a
// single view — tree/file_tree/scroll_view) through the hatch. Retains the
// widget's payload, then drops the widget wrapper; the facet Node owns the +1.
// For a widget that must survive re-renders, hold it and use `native(view)`.
fn native_widget(take w: flex::Node) -> facet::Node {
    let p: *u8 = w.payload();
    var held: *u8 = 0 as *u8;
    if p != (0 as *u8) { held = rt::retain(p); }
    return facet::native(held);
}

// ---- list: bridge facet's neutral list() to the @ui recycling NSTableView ----
// facet::list hands us (count, a facet-row fn, ctx); ui::list wants a fn that
// produces an already-mounted @ui subtree per row. Box the facet row fn + user
// ctx together, and give ui::list a static bridge that MOUNTS the facet row on
// demand (renderer() is fresh per call, so this is safe any time). Installed
// into facet core by `install_list`.
extern fn malloc(n: usize) -> *u8;

struct FacetRowCtx {
    row: fn(i64, *u8) -> facet::Node,
    opaque user: *u8,
}

fn facet_list_row_bridge(ctx: *u8, i: i64) -> flex::Node {
    let c: *FacetRowCtx = { ctx as *FacetRowCtx };
    let f: fn(i64, *u8) -> facet::Node = { (*c).row };
    var node: facet::Node = f(i, { (*c).user });
    return mount(#addr_of(node));
}

fn fak_list(count: i64, row: fn(i64, *u8) -> facet::Node, ctx: *u8) -> facet::Node {
    let bx: *FacetRowCtx = { malloc(#size_of::[FacetRowCtx]()) as *FacetRowCtx };
    { *bx = FacetRowCtx { row: row, user: ctx }; }
    return native_widget(ui::list(count, facet_list_row_bridge, bx as *u8));
}

// Register this backend's implementations of facet's neutral verbs (the native
// recycling list, the by-key `raise`). Call once at startup, before the first
// render (facet/runtime `run` does this).
extern fn dlsym(handle: *u8, symbol: *u8) -> *u8;
extern fn dispatch_async_f(queue: *u8, context: *u8, work: fn(*u8));

// The main dispatch queue, via dlsym on the libdispatch global (RTLD_DEFAULT
// is -2 on Darwin) — `dispatch_get_main_queue()` is a macro over this symbol,
// so there is no function to call.
fn main_dispatch_queue() -> *u8 {
    let rtld_default: *u8 = { ((0 as usize) -% (2 as usize)) as *u8 };
    return { dlsym(rtld_default, #str_ptr("_dispatch_main_q\0")) };
}

// Backend impl of facet::run_on_main: schedule `work(ctx)` on the main thread,
// asynchronously (non-blocking — the worker returns immediately; the main run
// loop picks the work up on its next turn).
fn dispatch_to_main(work: fn(*u8), ctx: *u8) {
    { dispatch_async_f(main_dispatch_queue(), ctx, work); }
    return;
}

// ---- async pump (facet::spawn_ui's wake source) -----------------------------
// The stdlib reactor parks suspended coroutines and wakes them off a kqueue
// (timers, fd readiness). A kqueue fd itself reads as ready when it holds
// events, so a dispatch READ source on it — on the main queue — makes the
// AppKit run loop the executor: whenever a timer or fd fires inside the
// reactor, the source runs facet::pump_async on the main thread, which
// resumes every task that can make progress. Installed once.
extern fn dispatch_source_create(type_: *u8, handle: u64, mask: u64, queue: *u8) -> *u8;
extern fn dispatch_source_set_event_handler_f(source: *u8, handler: fn(*u8));
extern fn dispatch_resume(obj: *u8);
extern fn stdlib_reactor_kqfd_v1() -> i32;

static ASYNC_PUMP_SOURCE: *u8 = #zero::[*u8]();

fn install_async_pump() {
    if ASYNC_PUMP_SOURCE != (0 as *u8) { return; }
    let rtld_default: *u8 = { ((0 as usize) -% (2 as usize)) as *u8 };
    let read_type: *u8 = { dlsym(rtld_default, #str_ptr("_dispatch_source_type_read\0")) };
    if read_type == (0 as *u8) { return; }
    let kq: i32 = { stdlib_reactor_kqfd_v1() };
    let src: *u8 = { dispatch_source_create(read_type, kq as u64, 0 as u64, main_dispatch_queue()) };
    if src == (0 as *u8) { return; }
    { dispatch_source_set_event_handler_f(src, facet::pump_async); }
    { dispatch_resume(src); }
    ASYNC_PUMP_SOURCE = src;
    return;
}

fn install() {
    facet::set_list_builder(fak_list);
    facet::set_raise_fn(raise);
    facet::set_key_of_fn(key_of_impl);
    facet::set_dropped_text_fn(dropped_text);
    facet::set_is_dark_fn(is_dark_impl);
    facet::set_find_fn(find_impl);
    facet::set_set_text_fn(set_text_impl);
    facet::set_set_value_fn(set_value_impl);
    facet::set_get_value_fn(value_impl);
    facet::set_set_on_fn(set_on_impl);
    facet::set_set_hidden_fn(set_hidden_impl);
    facet::set_add_child_fn(add_child_impl);
    facet::set_remove_child_fn(remove_child_impl);
    facet::set_insert_child_fn(insert_child_impl);
    facet::set_replace_child_fn(replace_child_impl);
    facet::set_set_child_fn(set_child_impl);
    facet::set_stage_fn(stage_impl);
    facet::set_attach_fn(attach_impl);
    facet::set_detach_fn(detach_impl);
    facet::set_is_attached_fn(is_attached_impl);
    facet::set_unstage_fn(unstage_impl);
    facet::set_lc_register_fn(lc_register_impl);
    facet::set_run_on_main_fn(dispatch_to_main);
    install_async_pump();
    return;
}

fn ak_material(ctx: *u8, np: *facet::Node, take content: flex::Node) -> flex::Node {
    var n: flex::Node = ui::material(content);
    apply_style(n.payload(), facet::kind_material(), np);
    return n;
}

fn ak_bordered(ctx: *u8, np: *facet::Node, take content: flex::Node) -> flex::Node {
    var n: flex::Node = ui::bordered(content, radius: { (*np).radius });
    // A bordered box already paints a backing view; Style props (bg/corner/
    // border) layer over it when the author opts in.
    apply_style(n.payload(), facet::kind_bordered(), np);
    return n;
}

fn ak_window_drag(ctx: *u8, np: *facet::Node, take content: flex::Node) -> flex::Node {
    var n: flex::Node = ui::window_drag(content);
    apply_style(n.payload(), facet::kind_window_drag(), np);
    return n;
}

fn ak_window_buttons(ctx: *u8, np: *facet::Node) -> flex::Node {
    // A native leaf: the view re-parents the real close/miniaturize/zoom buttons
    // into itself once it enters the window (and re-attaches on fullscreen/resize).
    // MEASURED (ui::view, not fixed_view): the view's fittingSize (its natural
    // traffic-light extent) sizes the flex node. An UNMEASURED leaf defaults to
    // width 0, which clips the re-parented buttons out of their parent's bounds so
    // they stop being the hitTest target — rendered + hovered but dead to clicks.
    let v: ak::View = akx::new_window_buttons_view();
    var n: flex::Node = ui::view(v);
    apply_style(n.payload(), facet::kind_window_buttons(), np);
    return n;
}

// ---- portable scroll (matrix §4) — the two-phase bridge ---------------------
// A scroll's content can't be laid out until the OUTER pass has sized its
// viewport (content height follows the viewport width). So ak_scroll builds the
// NSScrollView, defers the content, and records a job; `mount_into` fills every
// job AFTER apply has set the scroll frames — reusing ui::fill_scroll (the same
// two-phase the AppKit-only path used, now behind the portable `scroll` kind).
struct ScrollJob {
    opaque scroll: *u8,     // the NSScrollView (borrowed; the flex payload owns it)
    content: flex::Node,    // the mounted rows, awaiting layout at the viewport width
}

static SCROLL_JOBS: vec::Vec[ScrollJob] = #zero::[vec::Vec[ScrollJob]]();

fn ak_scroll(ctx: *u8, np: *facet::Node, take content: flex::Node) -> flex::Node {
    let sv: ak::ScrollView = ak::ScrollView::new(rt::Rect { x: 0.0, y: 0.0, w: 10.0, h: 10.0 });
    sv.set_has_vertical_scroller(true);
    sv.set_draws_background(false);
    sv.set_autohides_scrollers(true);
    let jobs: *vec::Vec[ScrollJob] = { #addr_of(SCROLL_JOBS) };
    (*jobs).append(ScrollJob { scroll: sv.raw(), content: content });
    var n: flex::Node = ui::fixed_view(sv.as_view());
    apply_style(n.payload(), facet::kind_scroll(), np);
    return n;
}

// Fill every deferred scroll, parent-before-child (LIFO: a nested scroll was
// appended before its parent, so pop-from-end fills the outer first, sizing the
// inner's frame before it fills). Called by mount_into after apply.
fn drain_scroll_jobs() {
    let jobs: *vec::Vec[ScrollJob] = { #addr_of(SCROLL_JOBS) };
    while { (*jobs).count() } > (0 as usize) {
        let last: usize = { (*jobs).count() } -% (1 as usize);
        match (*jobs).swap_remove(last) {
            option::Option[ScrollJob]::Some(job) => {
                let ScrollJob { scroll, content } = job;
                let _h: f64 = ui::fill_scroll(ak::ScrollView::from_raw(scroll), content);
            }
            option::Option[ScrollJob]::None => { }
        }
    }
    return;
}

// A split records its divider position and re-asserts it AFTER apply. Setting
// the position at build time lands on a 0×0 frame, so NSSplitView re-derives it
// on the first real layout and collapses the leading pane — the same two-phase
// problem as scroll, so the same deferral fixes it.
struct SplitJob {
    opaque split: *u8,      // the NSSplitView (borrowed; the flex payload owns it)
    position: f64,          // divider offset to re-assert once the frame is real
}

static SPLIT_JOBS: vec::Vec[SplitJob] = #zero::[vec::Vec[SplitJob]]();

fn drain_split_jobs() {
    let jobs: *vec::Vec[SplitJob] = { #addr_of(SPLIT_JOBS) };
    while { (*jobs).count() } > (0 as usize) {
        let last: usize = { (*jobs).count() } -% (1 as usize);
        match (*jobs).swap_remove(last) {
            option::Option[SplitJob]::Some(job) => {
                let SplitJob { split, position } = job;
                ak::SplitView::from_raw(split).set_position(position, 0 as i64);
            }
            option::Option[SplitJob]::None => { }
        }
    }
    return;
}

// The post-apply drain: size split panes FIRST (so a scroll inside a pane sees
// the correct viewport), THEN fill scrolls. Called after apply by mount_into and
// — via the component runtime's post-render hook — after every component render.
fn drain_post_apply() {
    drain_split_jobs();
    drain_scroll_jobs();
    return;
}

fn ak_clickable(ctx: *u8, np: *facet::Node, take content: flex::Node) -> flex::Node {
    // Primary click reuses Node.click; only wire when a real handler is set
    // (noop is the blank default — ui:: treats null-fn as "don't install").
    let none: fn(*u8, *u8) = 0 as fn(*u8, *u8);
    var primary: fn(*u8, *u8) = none;
    if { (*np).click } != facet::noop {
        primary = { (*np).click };
    }
    let ph: fn(*u8, *u8) = primary;
    let pctx: *u8 = { (*np).click_ctx };
    var n: flex::Node = ui::clickable(
        content,
        ctx: pctx,
        on_click: ph,
        on_double_click: { (*np).on_double_click },
        on_right_click: { (*np).on_right_click },
        on_long_press: { (*np).on_long_press },
        long_press_seconds: { (*np).long_press_seconds },
        on_drag: { (*np).on_drag },
        on_pinch: { (*np).on_pinch },
        on_rotate: { (*np).on_rotate },
        on_hover_in: { (*np).on_hover_in },
        on_hover_out: { (*np).on_hover_out },
        on_scroll: { (*np).on_scroll },
    );
    apply_style(n.payload(), facet::kind_clickable(), np);
    return n;
}

fn ak_split(ctx: *u8, np: *facet::Node, take first: flex::Node, take second: flex::Node) -> flex::Node {
    var n: flex::Node = ui::split(
        first,
        second,
        vertical: { (*np).vertical },
        position: { (*np).position },
        min_first: { (*np).min_first },
        min_second: { (*np).min_second },
    );
    // Defer a divider re-assert to after apply — ui::split set it on a 0×0
    // frame, which NSSplitView discards on the first layout (see SplitJob).
    let jobs: *vec::Vec[SplitJob] = { #addr_of(SPLIT_JOBS) };
    (*jobs).append(SplitJob { split: n.payload(), position: { (*np).position } });
    apply_style(n.payload(), facet::kind_split(), np);
    return n;
}

// Mount calls this after every widget-producing op. Records the declared
// affordance (role + drive-method) as associated-object metadata so the agent
// surface stops re-guessing native types, and pins a non-empty agent id as
// accessibilityIdentifier. For scroll-hosted editors (composer / text_area)
// the drive target is the inner documentView, not the outer NSScrollView —
// prefer that when present.
fn ak_set_identity(ctx: *u8, handle: *u8, id: str, role: u32) {
    if handle == (0 as *u8) { return; }
    var target: *u8 = handle;
    // Prefer documentView only when the handle actually responds (NSScrollView
    // for composer/text_area). Labels/buttons are NSTextField /
    // NSButton — messaging documentView there throws NSInvalidArgumentException.
    // EXCLUDE the native hatch (role_none): it may wrap a scroll-based widget (a
    // `list`/`tree`), and its id must stay on the wrapper view the app named —
    // the one find_view_by_id / raise re-order for a panel switch — instead of
    // sinking onto the inner table/outline document view.
    if role != facet::role_none() {
        let dv_sel: *u8 = rt::sel(#str_ptr("documentView\0"));
        let responds: i8 = rt::msg_i8_id(handle, rt::sel(#str_ptr("respondsToSelector:\0")), dv_sel);
        if responds != (0 as i8) {
            let dv: *u8 = { rt::msg_id(handle, dv_sel) };
            if dv != (0 as *u8) { target = dv; }
        }
    }
    // Record affordance — even untagged widgets get a declared role so
    // describe_ui is accurate; exposure still requires a non-empty agent id.
    // EXCEPT role_none (the native hatch): leave the wrapped widget's own
    // affordance intact — recording group/none here would make an app-owned
    // Input observe-only on every re-render — and only (re)pin the id below.
    if role != facet::role_none() {
        let r: identity::Role = identity::role_from_index(role);
        let drive: u32 = identity::drive_for_role(r);
        let packed: *u8 = identity::pack_affordance(role, drive);
        // OBJC_ASSOCIATION_ASSIGN (0): packed integer disguised as a pointer.
        rt::set_associated_object(target, identity::affordance_key(), packed, 0 as usize);
    }
    if id != "" {
        ak::Accessibility::from_raw(target).set_accessibility_identifier(id);
    }
    return;
}

// The vtable value. `ctx` is an unused backend-context slot (a future backend
// context — theme, window — can ride here); the ops don't read it.
fn renderer() -> facet::Renderer {
    // A mount that fills deferred scroll/split content drains that work through
    // this up-call hook (ui::apply can't name our job queues).
    ui::set_post_render_hook(drain_post_apply);
    return facet::Renderer {
        ctx: 0 as *u8,
        label: ak_label,
        wrap_label: ak_wrap_label,
        button: ak_button,
        text_area: ak_text_area,
        composer: ak_composer,
        image: ak_image,
        symbol: ak_symbol,
        text_field: ak_text_field,
        popup: ak_popup,
        divider: ak_divider,
        toggle: ak_toggle,
        slider: ak_slider,
        progress: ak_progress,
        stepper: ak_stepper,
        secure_field: ak_secure_field,
        segmented: ak_segmented,
        color_picker: ak_color_picker,
        date_picker: ak_date_picker,
        box: ak_box,
        gauge: ak_gauge,
        path: ak_path,
        native: ak_native,
        window_buttons: ak_window_buttons,
        bordered: ak_bordered,
        clickable: ak_clickable,
        scroll: ak_scroll,
        material: ak_material,
        window_drag: ak_window_drag,
        split: ak_split,
        container: fak_container,
        set_identity: ak_set_identity,
    };
}

// Description tree -> flex tree with AppKit widgets in the payloads.
fn mount(np: *facet::Node) -> flex::Node {
    return facet::mount(np, renderer());
}

// Mount + lay out + apply into an existing view, in one step. Returns the
// content height (useful when the caller sizes the window to fit).
fn mount_into(np: *facet::Node, view_ptr: *u8, width: f64, height: f64) -> f64 {
    var tree: flex::Node = mount(np);
    tree.calculate_layout(width, height, flex::Direction::LTR);
    tree.round_to_pixel(2.0f64);
    ui::apply(#addr_of(tree), view_ptr, false);
    // Now that apply has sized every scroll's viewport and split's frame, run
    // the deferred phase-two work (fill scroll content, re-assert split
    // dividers). Any `scroll`/`split` in the tree registered a job.
    drain_post_apply();
    let f: flex::Layout = tree.layout_frame();
    return f.height;
}

// ==========================================================================
// The component mount registry — build once, update by key
// ==========================================================================
//
// facet is NOT reactive: a component's `build` renders a PORTABLE DESCRIPTION
// (facet::Component::build -> facet::Node) ONCE at mount. There is no diff, no
// re-render loop. State changes reach the screen through the keyed-direct path
// (facet::find(key) + set_text / set_value / add_child / ...), which mutates
// the live views in place, and through ui::relayout for pure geometry (window
// resize).
//
// This registry just retains each mounted component's description so the
// ui-slot bridge (comp_bridge) can mount it, and drops it on unmount. It keys
// on the component address (a handler's `ctx`); find() walks that component's
// live view subtree.

struct CompReg {
    opaque _cp: *u8,                       // the component address (identity)
    _desc: facet::Node,                    // the rendered description
}

static COMPONENTS: vec::Vec[CompReg] = #zero::[vec::Vec[CompReg]]();

fn comp_remove(cp: *u8) -> bool {
    let reg: *vec::Vec[CompReg] = #addr_of(COMPONENTS);
    let n: usize = { (*reg).count() };
    var i: usize = 0 as usize;
    while i < n {
        match (*reg).at_ptr(i) {
            option::Option[*CompReg]::Some(ep) => {
                if { (*ep)._cp } == cp {
                    let _g: option::Option[CompReg] = (*reg).swap_remove(i);
                    return true;
                }
            }
            option::Option[*CompReg]::None => { }
        }
        i = i +% (1 as usize);
    }
    return false;
}

fn comp_store(cp: *u8, take desc: facet::Node) {
    let _had: bool = comp_remove(cp);
    let reg: *vec::Vec[CompReg] = #addr_of(COMPONENTS);
    (*reg).append(CompReg { _cp: cp, _desc: desc });
    return;
}

// Borrow the retained description (pointer into registry storage: use before
// the registry next mutates).
fn comp_desc_ptr(cp: *u8) -> option::Option[*facet::Node] {
    let reg: *vec::Vec[CompReg] = #addr_of(COMPONENTS);
    let n: usize = { (*reg).count() };
    var i: usize = 0 as usize;
    while i < n {
        match (*reg).at_ptr(i) {
            option::Option[*CompReg]::Some(ep) => {
                if { (*ep)._cp } == cp {
                    return option::Option[*facet::Node]::Some(#addr_of((*ep)._desc));
                }
            }
            option::Option[*CompReg]::None => { }
        }
        i = i +% (1 as usize);
    }
    return option::Option[*facet::Node]::None;
}

// The ui-slot bridge: mounts the registry's description. The one-time mount
// lands here through ui::render_slot.
fn comp_bridge(cp: *u8) -> flex::Node {
    match comp_desc_ptr(cp) {
        option::Option[*facet::Node]::Some(dp) => { return mount(dp); }
        option::Option[*facet::Node]::None => { return flex::Node::new(); }
    }
    return flex::Node::new();
}

// ---- the public verbs --------------------------------------------------------

// Mount a component into a host view: `fak::mount_component(APP.build,
// host: v)`. The bound reference fills ctx with the component's address, which
// keys the component in the registry so find() can address it. ctx 0 (no
// identity) mounts one-shot, unregistered. Returns the content height.
fn mount_component(render: fn(*u8) -> facet::Node, ctx: *u8 = 0 as *u8, host: *u8 = 0 as *u8, flipped: bool = false) -> f64 {
    if host == (0 as *u8) { return -1.0f64; }
    if ctx == (0 as *u8) {
        var d: facet::Node = render(0 as *u8);
        let hf: rt::Rect = ak::View::from_raw(host).frame();
        return mount_into(#addr_of(d), host, hf.w, hf.h);
    }
    var d: facet::Node = render(ctx);
    comp_store(ctx, d);
    return ui::mount(comp_bridge, ctx: ctx, host: host, flipped: flipped);
}

// The scroll-hosted variant (content-sized document view).
fn mount_component_scroll(render: fn(*u8) -> facet::Node, ctx: *u8 = 0 as *u8, scroll: *u8 = 0 as *u8, agent_id: str = "") -> f64 {
    if scroll == (0 as *u8) || ctx == (0 as *u8) { return -1.0f64; }
    var d: facet::Node = render(ctx);
    comp_store(ctx, d);
    return ui::mount_scroll(comp_bridge, ctx: ctx, scroll: scroll, agent_id: agent_id);
}

// Geometry-only update (window resize): retained relayout, no render at all.
fn relayout(cp: *u8) -> bool {
    return ui::relayout(cp);
}

// Drop one component's registration (window teardown). The retained
// description and flex tree drop; the host's views are the app's to tear
// down with the window.
fn unmount(cp: *u8) -> bool {
    // Anything PRESENTED inside this component's tree leaves with it: fire its
    // registered detach (and clear the entries) while the views are alive.
    lc_fire_under(ui::slot_host(cp));
    let _c: bool = comp_remove(cp);
    return ui::unmount(cp);
}

fn unmount_all() {
    // Full teardown: every presented component gets its detach first, while
    // every view is still alive.
    lc_fire_all();
    // Unplug every staged root from any superview before its component's tree is
    // dropped, then release the facet-owned roots.
    let staged: *vec::Vec[StageReg] = #addr_of(STAGED);
    let sn: usize = { (*staged).count() };
    var si: usize = 0 as usize;
    while si < sn {
        match (*staged).at_ptr(si) {
            option::Option[*StageReg]::Some(ep) => {
                ak::View::from_raw({ (*ep)._root.raw() }).remove_from_superview();
            }
            option::Option[*StageReg]::None => { }
        }
        si = si +% (1 as usize);
    }
    let reg: *vec::Vec[CompReg] = #addr_of(COMPONENTS);
    (*reg).remove_all();
    ui::unmount_all();
    (*staged).remove_all();   // drops the retained root views (-1 each)
    let zooms: *vec::Vec[PinchZoom] = #addr_of(PINCH_ZOOMS);
    (*zooms).remove_all();    // recognizers die with their windows' views
    return;
}

// The window's style mask. `clean_titlebar` adds full-size-content so the view
// tree extends under the titlebar (the borderless look). Pure — split out so it
// can be tested without opening a window.
fn shell_style_mask(clean_titlebar: bool) -> u64 {
    var style: u64 = ak::window_style_mask_titled
        | ak::window_style_mask_closable
        | ak::window_style_mask_miniaturizable
        | ak::window_style_mask_resizable;
    if clean_titlebar { style = style | ak::window_style_mask_full_size_content_view; }
    return style;
}

// Hide one standard window button (traffic light) if present. `win.standard_window_button`
// returns None when the style mask lacks that button; nothing to hide then.
fn hide_window_button(win: ak::Window, b: ak::WindowButton) {
    match win.standard_window_button(b) {
        option::Option[ak::Button]::Some(btn) => { btn.as_view().set_hidden(true); }
        option::Option[ak::Button]::None => { }
    }
    return;
}

// Create (and retain +1) the app's NSWindow. `clean_titlebar` gives the
// borderless shell iris uses for its welcome / wizard windows: content bleeds
// under a transparent, title-less titlebar and the miniaturize + zoom traffic
// lights are hidden (close stays). `custom_chrome` goes one step further for an
// app that draws its OWN titlebar controls: full-size content + transparent,
// title-less titlebar AND all three standard buttons hidden (close included), so
// the app supplies custom traffic lights (wired via window_close/minimize/zoom)
// and a window_drag surface. The caller sets the content view and orders it front.
fn make_shell_window(title: str, width: f64, height: f64, clean_titlebar: bool, close_button_only: bool = false, custom_chrome: bool = false, native_buttons: bool = false, min_width: f64 = 0.0f64, min_height: f64 = 0.0f64) -> ak::Window {
    let full_size: bool = clean_titlebar || custom_chrome || native_buttons;
    let win = ak::Window::new(
        rt::Rect { x: 0.0, y: 0.0, w: width, h: height },
        shell_style_mask(full_size),
        ak::BackingStoreType::NSBackingStoreBuffered,
        false,
    );
    rt::retain(win.raw());
    win.set_title(title);
    if native_buttons {
        // Keep ALL THREE standard buttons VISIBLE under a full-size, hidden-title
        // chrome; a window_buttons() node re-parents them into the content toolbar
        // (native zoom toggle + green hover/tiling menu preserved). Dragging comes
        // from an explicit window_drag() surface (its hitTest claims bare regions
        // while real controls keep their clicks) — NOT movableByWindowBackground,
        // which swallows a static click on the re-parented buttons as a
        // no-movement window drag.
        win.set_titlebar_appears_transparent(true);
        win.set_title_visibility(ak::WindowTitleVisibility::NSWindowTitleHidden);
    } else if custom_chrome {
        win.set_titlebar_appears_transparent(true);
        win.set_title_visibility(ak::WindowTitleVisibility::NSWindowTitleHidden);
        hide_window_button(win, ak::WindowButton::NSWindowCloseButton);
        hide_window_button(win, ak::WindowButton::NSWindowMiniaturizeButton);
        hide_window_button(win, ak::WindowButton::NSWindowZoomButton);
        // Dragging comes from the app's window_drag() surface (its hitTest drags
        // bare regions and lets the app's own controls keep their clicks), NOT
        // movableByWindowBackground — that swallows clicks on those custom
        // controls exactly as it did the native buttons.
    } else if clean_titlebar {
        win.set_titlebar_appears_transparent(true);
        win.set_title_visibility(ak::WindowTitleVisibility::NSWindowTitleHidden);
        hide_window_button(win, ak::WindowButton::NSWindowMiniaturizeButton);
        hide_window_button(win, ak::WindowButton::NSWindowZoomButton);
    } else if close_button_only {
        hide_window_button(win, ak::WindowButton::NSWindowMiniaturizeButton);
        hide_window_button(win, ak::WindowButton::NSWindowZoomButton);
    }
    // Minimum content-size floor: keep the window from shrinking below its usable
    // layout. Applied only when both dimensions are set (> 0).
    if min_width > 0.0f64 && min_height > 0.0f64 {
        win.set_content_min_size(rt::Size { w: min_width, h: min_height });
    }
    return win;
}

// Open a window, mount the tree, run the event loop (blocks).
fn toolbar_item_label(np: *facet::Node, fallback: str) -> str {
    let tp: *text::Text = { #addr_of((*np).text) };
    if (*tp).count() != (0 as usize) { return (*tp).view(); }
    let vp: *text::Text = { #addr_of((*np).value) };
    if (*vp).count() != (0 as usize) { return (*vp).view(); }
    let ap: *text::Text = { #addr_of((*np).agent_id) };
    if (*ap).count() != (0 as usize) { return (*ap).view(); }
    return fallback;
}

fn toolbar_item_view(np: *facet::Node) -> ak::View {
    var tree: flex::Node = mount(np);
    tree.calculate_layout(flex::undefined(), flex::undefined(), flex::Direction::LTR);
    tree.round_to_pixel(2.0f64);
    let f: flex::Layout = tree.layout_frame();
    var w: f64 = f.width;
    var h: f64 = f.height;
    if w < 1.0f64 { w = 1.0f64; }
    if h < 1.0f64 { h = 1.0f64; }
    let host: ak::View = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: w, h: h });
    ui::apply(#addr_of(tree), host.raw(), false);
    drain_post_apply();
    return host;
}

fn add_toolbar_identifier(ids: *u8, ident: str) {
    rt::msg_void_id(ids, rt::sel(#str_ptr("addObject:\0")), bridge::nsstring(ident));
    return;
}

fn add_toolbar_item(ids: *u8, map: *u8, ident: str, item: ak::ToolbarItem) {
    let idns: *u8 = bridge::nsstring(ident);
    rt::msg_void_id(ids, rt::sel(#str_ptr("addObject:\0")), idns);
    rt::msg_void_id_id(map, rt::sel(#str_ptr("setObject:forKey:\0")), item.raw(), idns);
    return;
}

fn fixed_toolbar_space(ident: str, width: f64) -> ak::ToolbarItem {
    let ti: ak::ToolbarItem = ak::ToolbarItem::new(ident);
    let host: ak::View = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: width, h: 1.0f64 });
    let size: rt::Size = rt::Size { w: width, h: 1.0f64 };
    ti.set_min_size(size);
    ti.set_max_size(size);
    ti.set_view(host);
    return ti;
}

// Build and attach an NSToolbar to `win` from the root's `.toolbar(...)` items.
// Each item is a full facet subtree, so labels, buttons, symbols, toggles, and
// small grouped layouts share the same renderer as normal content.
fn install_toolbar(win: ak::Window, rp: *facet::Node) {
    let items: *vec::Vec[facet::Node] = { #addr_of((*rp).toolbar_items) };
    let n: usize = { (*items).count() };
    if n == (0 as usize) { return; }
    let ids: *u8 = rt::msg_id(rt::get_class(#str_ptr("NSMutableArray\0")), rt::sel(#str_ptr("array\0")));
    let map: *u8 = rt::msg_id(rt::get_class(#str_ptr("NSMutableDictionary\0")), rt::sel(#str_ptr("dictionary\0")));
    var i: usize = 0 as usize;
    while i < n {
        match { (*items).at_ptr(i) } {
            option::Option[*facet::Node]::Some(ip) => {
                var buf: [u8; 64] = [
                    0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
                    0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
                    0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
                    0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
                    0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
                    0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
                    0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
                    0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
                ];
                let wrote: i32 = { snprintf(#addr_of(buf) as *u8, 64 as usize, #str_ptr("facet-toolbar-%d\0"), i as i32) };
                var ident: str = "facet-toolbar-item";
                if wrote > 0 {
                    ident = { #str_from_raw_parts(#addr_of(buf) as *u8, wrote as usize) };
                }
                if { (*ip).kind } == facet::kind_divider() {
                    add_toolbar_identifier(ids, "NSToolbarSeparatorItem");
                } else if { (*ip).kind } == facet::kind_spacer() {
                    var space_width: f64 = (*ip).layout_width();
                    if (*ip).layout_width_pct() >= 0.0f64 {
                        let wf: rt::Rect = win.frame();
                        space_width = wf.w * (*ip).layout_width_pct();
                    }
                    if space_width > 0.0f64 {
                        let ti: ak::ToolbarItem = fixed_toolbar_space(ident, space_width);
                        add_toolbar_item(ids, map, ident, ti);
                    } else {
                        add_toolbar_identifier(ids, "NSToolbarFlexibleSpaceItem");
                    }
                } else {
                    let ti: ak::ToolbarItem = ak::ToolbarItem::new(ident);
                    let label: str = toolbar_item_label(ip, ident);
                    ti.set_label(label);
                    ti.set_palette_label(label);
                    let host: ak::View = toolbar_item_view(ip);
                    let frame: rt::Rect = host.frame();
                    let size: rt::Size = rt::Size { w: frame.w, h: frame.h };
                    ti.set_min_size(size);
                    ti.set_max_size(size);
                    ti.set_view(host);
                    add_toolbar_item(ids, map, ident, ti);
                }
            }
            option::Option[*facet::Node]::None => {}
        }
        i = i + (1 as usize);
    }
    let tb: ak::Toolbar = akx::make_toolbar(ids, map);
    win.set_toolbar(tb);
    return;
}

// Mount one facet subtree into a fresh view and add it to `win`'s title bar as a
// leading/trailing accessory (an NSTitlebarAccessoryViewController). The subtree
// is laid out at its natural size; the accessory view is that size. The window
// retains the controller, so the +1 from alloc/init is dropped after adding.
fn add_titlebar_accessory(win: ak::Window, np: *facet::Node, attr: ak::LayoutAttribute) {
    var tree: flex::Node = mount(np);
    tree.calculate_layout(flex::undefined(), flex::undefined(), flex::Direction::LTR);
    tree.round_to_pixel(2.0f64);
    let f: flex::Layout = tree.layout_frame();
    let host: ak::View = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: f.width, h: f.height });
    ui::apply(#addr_of(tree), host.raw(), false);
    drain_post_apply();   // fill any deferred scroll/split (rare in a title bar)
    let vc_ptr: *u8 = rt::alloc_init(#str_ptr("NSTitlebarAccessoryViewController\0"));
    let vc: ak::TitlebarAccessoryViewController = ak::TitlebarAccessoryViewController::from_raw(vc_ptr);
    vc.as_view_controller().set_view(host);   // the controller retains the view
    vc.set_layout_attribute(attr);
    win.add_titlebar_accessory_view_controller(vc);
    rt::release(vc_ptr);   // the window retains the controller
    return;
}

// Put facet-described controls in the window's NATIVE title bar (matrix §4 window
// chrome). `leading` sits right after the traffic lights, `trailing` at the far
// right; each is a facet subtree hosted in a title-bar accessory. AppKit keeps
// OWNING the title bar, so double-click-to-zoom, background drag, and
// traffic-light centering all keep working with zero app event code — unlike a
// fullSizeContentView overlay, which covers the title bar and destroys them. The
// native title text is hidden (the controls are the title-bar content). A host
// that owns its own NSWindow (not facet's `run`) calls this to get a native,
// unified-looking toolbar; the controls carry their agent ids/affordances like
// any mounted widget. Pass an empty region (e.g. `hstack { }`) to omit a side.
fn install_titlebar(win: ak::Window, take leading: facet::Node, take trailing: facet::Node) {
    win.set_title_visibility(ak::WindowTitleVisibility::NSWindowTitleHidden);
    add_titlebar_accessory(win, #addr_of(leading), ak::LayoutAttribute::Leading);
    add_titlebar_accessory(win, #addr_of(trailing), ak::LayoutAttribute::Trailing);
    return;
}

struct WindowLifecycle {
    opaque ctx: *u8,
    should_close: fn(*u8) -> bool,
    will_close: fn(*u8),
    opaque relayout_cp: *u8,          // slot key of the mounted root, for resize relayout
}

static OPEN_WINDOWS: i32 = 0;

fn window_lifecycle_key() -> *u8 { return 29002 as *u8; }

fn appkit_should_close(user: *u8, win_ptr: *u8) -> i8 {
    let lifecycle: *WindowLifecycle = user as *WindowLifecycle;
    let should_close: fn(*u8) -> bool = { (*lifecycle).should_close };
    if should_close({ (*lifecycle).ctx }) { return 1 as i8; }
    return 0 as i8;
}

fn appkit_will_close(user: *u8, win_ptr: *u8) {
    let lifecycle: *WindowLifecycle = user as *WindowLifecycle;
    let will_close: fn(*u8) = { (*lifecycle).will_close };
    will_close({ (*lifecycle).ctx });
    OPEN_WINDOWS = OPEN_WINDOWS -% 1;
    if OPEN_WINDOWS <= 0 {
        ak::Application::shared_application().stop(0 as *u8);
    }
    return;
}

// The root description run_window is about to mount. The slot ctx used to
// double as the root's address, but an app may key the slot with its OWN
// component address (run_window's component_ctx) so its handlers can call
// facet::find(cp, key) — so the root reaches the render through this static
// instead. Set immediately before ui::mount, consumed synchronously inside it;
// run_window blocks in app.run(), so there is never a second pending root.
static RUN_ROOT: *facet::Node = #zero::[*facet::Node]();

// ui::mount render for run_window's root (see run_window). Mount it to a fresh
// flex tree. Called once at the initial mount; a resize reuses the retained
// tree via relayout and never re-renders, so this runs exactly once per window.
fn run_root_render(cp: *u8) -> flex::Node {
    return mount(RUN_ROOT);
}

// windowDidResize: re-lay the retained root tree out at the content view's new
// size and reposition the existing views — geometry only, no re-render. This is
// what lets a `run` window's flex content track the window instead of staying
// frozen at its mount-time size.
fn appkit_did_resize(user: *u8, notif: *u8) {
    let lifecycle: *WindowLifecycle = user as *WindowLifecycle;
    let _r: bool = ui::relayout({ (*lifecycle).relayout_cp });
    // Any staged screen attached inside this window fills its container via
    // autoresizing, but its flex content still needs re-laying at the new size.
    relayout_attached_staged();
    return;
}

fn install_window_lifecycle(
    win: ak::Window,
    lifecycle: *WindowLifecycle,
    delegate: *ak::WindowDelegate,
) {
    (*delegate).set_window_should_close(appkit_should_close);
    (*delegate).set_window_will_close(appkit_will_close);
    (*delegate).set_window_did_resize(appkit_did_resize);
    let delegate_obj: *u8 = ak::create_WindowDelegate(delegate);
    win.set_delegate(delegate_obj);
    rt::set_associated_object(win.raw(), window_lifecycle_key(), delegate_obj, 1 as usize);
    return;
}

// ==========================================================================
// Pinch zoom — content magnification, NO reflow (dev opt-in)
// ==========================================================================
//
// `run_window(root, zoomable: true)` lets the END USER pinch the trackpad to
// magnify the window's content — read small text — the way Safari's pinch
// scales a page: the picture scales up AS LAID OUT (no reflow, no rewrap; the
// overflow clips at the window) and the point under the fingers stays put.
// ui::set_zoom does the scaling (bounds size + origin — a pure coordinate-
// space change, vector-crisp); this layer owns the gesture: compounding from
// the gesture-start base, clamping to the dev's range, and anchoring the
// visible cut at the pinch location. State is keyed by the HOST view
// (multi-window safe); the recognizer's ctx carries the host.

struct PinchZoom {
    opaque _host: *u8,   // borrowed: the window owns its content view
    _base: f64,          // zoom when the gesture began; magnification is relative to it
    _min: f64,
    _max: f64,
}

static PINCH_ZOOMS: vec::Vec[PinchZoom] = #zero::[vec::Vec[PinchZoom]]();

fn pinch_zoom_entry(host: *u8) -> option::Option[*PinchZoom] {
    let zooms: *vec::Vec[PinchZoom] = #addr_of(PINCH_ZOOMS);
    let n: usize = { (*zooms).count() };
    var i: usize = 0 as usize;
    while i < n {
        match (*zooms).at_ptr(i) {
            option::Option[*PinchZoom]::Some(zp) => {
                if { (*zp)._host } == host { return option::Option[*PinchZoom]::Some(zp); }
            }
            option::Option[*PinchZoom]::None => { }
        }
        i = i +% (1 as usize);
    }
    return option::Option[*PinchZoom]::None;
}

// The pinch target, pure math: NSMagnificationGestureRecognizer reports a
// CUMULATIVE magnification since the gesture began (0 = unchanged), so the
// target is base * (1 + m), clamped to [min_zoom, max_zoom]. A NaN
// magnification leaves the base (the sample is ignored, never amplified).
fn pinch_zoom_target(base: f64, magnification: f64, min_zoom: f64, max_zoom: f64) -> f64 {
    var target: f64 = base;
    if magnification == magnification {   // false only for NaN
        target = base * (1.0f64 + magnification);
    }
    if (target > min_zoom) == false { target = min_zoom; }   // NaN/-inf products collapse here
    if target > max_zoom { target = max_zoom; }
    return target;
}

// Where the scaled window's origin lands so the content point under the
// pinch stays fixed at the same spot in the window: the anchor keeps its
// FRACTION of the visible span across the scale change. Pure math —
// ui::set_zoom clamps the result to the content on assert.
fn pinch_zoom_origin(anchor: f64, old_origin: f64, old_visible: f64, new_visible: f64) -> f64 {
    if (old_visible > 0.0f64) == false { return 0.0f64; }
    let fraction: f64 = (anchor - old_origin) / old_visible;
    return anchor - (fraction * new_visible);
}

// Scale a host to `target`, keeping the content point (anchor_x, anchor_y)
// fixed on screen. The current bounds ARE the old visible cut (origin + span),
// so the new origin follows from the anchor's fraction of it.
fn apply_pinch_zoom(host: *u8, target: f64, anchor_x: f64, anchor_y: f64) {
    let v: ak::View = ak::View::from_raw(host);
    let hf: rt::Rect = v.frame();
    let b: rt::Rect = v.bounds();
    let _ok: bool = ui::set_zoom(
        host,
        target,
        origin_x: pinch_zoom_origin(anchor_x, b.x, b.w, hf.w / target),
        origin_y: pinch_zoom_origin(anchor_y, b.y, b.h, hf.h / target),
    );
    return;
}

// The visible cut's center — the anchor when there is no gesture location
// (programmatic zoom, a recognizer not yet attached to a view).
fn pinch_zoom_center(host: *u8) -> rt::Point {
    let b: rt::Rect = ak::View::from_raw(host).bounds();
    return rt::Point { x: b.x + (b.w / 2.0f64), y: b.y + (b.h / 2.0f64) };
}

// The magnify recognizer's action. On Began the current zoom is captured as
// the base; every sample then scales THAT, so consecutive pinches compound
// naturally instead of restarting from 1. The pinch location anchors the
// scale (locationInView: resolves through the scaled bounds, so it IS the
// content point under the fingers).
fn on_pinch_zoom(sender: *u8, ctx: *u8) {
    match pinch_zoom_entry(ctx) {
        option::Option[*PinchZoom]::Some(zp) => {
            let g: ak::MagnificationGestureRecognizer = ak::MagnificationGestureRecognizer::from_raw(sender);
            let gr: ak::GestureRecognizer = g.as_gesture_recognizer();
            match gr.state() {
                ak::GestureRecognizerState::Began => { { (*zp)._base = ui::zoom_of(ctx); } }
                _ => { }
            }
            let target: f64 = pinch_zoom_target({ (*zp)._base }, g.magnification(), { (*zp)._min }, { (*zp)._max });
            var anchor: rt::Point = pinch_zoom_center(ctx);
            match gr.view() {
                option::Option[ak::View]::Some(v) => { anchor = gr.location_in_view(v); }
                option::Option[ak::View]::None => { }
            }
            apply_pinch_zoom(ctx, target, anchor.x, anchor.y);
        }
        option::Option[*PinchZoom]::None => { }
    }
    return;
}

// Install pinch-to-zoom on a slot host. run_window calls this for a
// `zoomable:` window; a host that owns its own NSWindow calls it directly
// with its content view. A degenerate range (max below min, or non-positive
// min) is healed: min floors at 1.0-or-given, max floors at min (= zoom
// locked). Re-installing on the same host updates the range without adding a
// second recognizer.
fn install_pinch_zoom(host: *u8, min_zoom: f64 = 1.0f64, max_zoom: f64 = 4.0f64) {
    if host == { 0 as *u8 } { return; }
    var lo: f64 = min_zoom;
    if (lo > 0.0f64) == false { lo = 1.0f64; }   // 0/negative/NaN: floor at natural size
    var hi: f64 = max_zoom;
    if (hi >= lo) == false { hi = lo; }          // NaN/inverted range: locked at min
    match pinch_zoom_entry(host) {
        option::Option[*PinchZoom]::Some(zp) => {
            { (*zp)._min = lo; }
            { (*zp)._max = hi; }
            return;
        }
        option::Option[*PinchZoom]::None => { }
    }
    let zooms: *vec::Vec[PinchZoom] = #addr_of(PINCH_ZOOMS);
    (*zooms).append(PinchZoom { _host: host, _base: 1.0f64, _min: lo, _max: hi });
    // Scaled content overflows the host; clip it there (macOS 14+ defaults
    // clipsToBounds to false) so it can't bleed over the titlebar region.
    ak::View::from_raw(host).set_clips_to_bounds(true);
    akx::add_magnify_gesture(ak::View::from_raw(host), on_pinch_zoom, host);
    // The first pinch host brings the process-wide scroll filter with it
    // (pan while zoomed). Never removed: with no zoomed host it is a pure
    // pass-through, and pinch hosts can come and go for the process life.
    if PAN_FILTER == { 0 as *u8 } {
        PAN_FILTER = akx::add_local_event_filter(ak::event_mask_scroll_wheel, pan_event_filter, 0 as *u8);
    }
    return;
}

// Programmatic zoom — a dev's menu item / shortcut / test drives the same
// path the gesture does, anchored at the visible cut's center. Clamps to the
// installed range; returns the factor actually applied (1.0 when no pinch
// zoom is installed here).
fn set_pinch_zoom(host: *u8, zoom: f64) -> f64 {
    match pinch_zoom_entry(host) {
        option::Option[*PinchZoom]::Some(zp) => {
            let target: f64 = pinch_zoom_target(zoom, 0.0f64, { (*zp)._min }, { (*zp)._max });
            { (*zp)._base = target; }   // the next pinch compounds from here
            let anchor: rt::Point = pinch_zoom_center(host);
            apply_pinch_zoom(host, target, anchor.x, anchor.y);
            return target;
        }
        option::Option[*PinchZoom]::None => { return 1.0f64; }
    }
}

// The zoom currently applied to a host (1.0 = natural size).
fn pinch_zoom_level(host: *u8) -> f64 { return ui::zoom_of(host); }

// ---- pan while zoomed -------------------------------------------------------
// Safari's other half: with the content magnified, a two-finger scroll PANS
// the visible cut instead of scrolling the app. One process-wide scroll-wheel
// FILTER (installed with the first pinch-zoom host) routes each event: if its
// window's content view is a pinch host zoomed past 1, the deltas move that
// host's bounds origin (clamped by ui::set_zoom) and the event is consumed;
// otherwise it is delivered untouched, so every window and inner scroll view
// behaves stock at natural size. While zoomed the window pans as ONE surface
// — inner scrolls resume at 1x (the iOS rule: predictable over clever).

static PAN_FILTER: *u8 = 0 as *u8;

// One axis of the pan. The bounds-space step is the wheel delta over the
// zoom (window points → scaled points); the CALLER fixes the sign per axis.
// NaN samples and degenerate zooms leave the origin alone.
fn pinch_pan_origin(origin: f64, delta: f64, zoom: f64) -> f64 {
    if (delta == delta) == false { return origin; }   // false only for NaN
    if (zoom > 0.0f64) == false { return origin; }
    return origin + (delta / zoom);
}

// Pan a zoomed pinch host by wheel deltas: x subtracts (deltaX > 0 = scroll
// left = view content to the left), y adds (deltaY > 0 = scroll up = view
// the content above; AppKit's y grows upward). False when there is nothing
// to pan — not a pinch host, or at natural size — so the caller delivers
// the event instead.
fn pan_zoomed_host(host: *u8, dx: f64, dy: f64) -> bool {
    match pinch_zoom_entry(host) {
        option::Option[*PinchZoom]::Some(zp) => { }
        option::Option[*PinchZoom]::None => { return false; }
    }
    let z: f64 = ui::zoom_of(host);
    if (z > 1.0f64) == false { return false; }
    let b: rt::Rect = ak::View::from_raw(host).bounds();
    let _ok: bool = ui::set_zoom(
        host,
        z,
        origin_x: pinch_pan_origin(b.x, 0.0f64 - dx, z),
        origin_y: pinch_pan_origin(b.y, dy, z),
    );
    return true;
}

// The scroll-wheel filter: consume the event (return 0) when it panned a
// zoomed window, deliver it unchanged otherwise.
fn pan_event_filter(ctx: *u8, event_ptr: *u8) -> *u8 {
    let ev: ak::Event = ak::Event::from_raw(event_ptr);
    match ev.window() {
        option::Option[ak::Window]::Some(win) => {
            match win.content_view() {
                option::Option[ak::View]::Some(content) => {
                    if pan_zoomed_host(content.raw(), ev.scrolling_delta_x(), ev.scrolling_delta_y()) {
                        return 0 as *u8;
                    }
                }
                option::Option[ak::View]::None => { }
            }
        }
        option::Option[ak::Window]::None => { }
    }
    return event_ptr;
}

fn install_default_app_menu(app: ak::Application, title: str) {
    match app.main_menu() {
        option::Option[ak::Menu]::Some(existing) => { return; }
        option::Option[ak::Menu]::None => { }
    }

    let command: u64 = ak::event_modifier_flags_n_s_event_modifier_flag_command;

    let main_menu: ak::Menu = ak::Menu::new("");

    let app_item: ak::MenuItem = ak::MenuItem::new("", 0 as *u8, "");
    main_menu.add_item(app_item);
    let app_menu: ak::Menu = ak::Menu::new(title);
    let quit_item: ak::MenuItem = app_menu.add_item_with_title("Quit", rt::sel(#str_ptr("terminate:\0")), "q");
    quit_item.set_target(0 as *u8);
    quit_item.set_key_equivalent_modifier_mask(command);
    main_menu.set_submenu(app_menu, for_item: app_item);

    let window_item: ak::MenuItem = ak::MenuItem::new("Window", 0 as *u8, "");
    main_menu.add_item(window_item);
    let window_menu: ak::Menu = ak::Menu::new("Window");
    let close_item: ak::MenuItem = window_menu.add_item_with_title("Close Window", rt::sel(#str_ptr("performClose:\0")), "w");
    close_item.set_target(0 as *u8);
    close_item.set_key_equivalent_modifier_mask(command);
    main_menu.set_submenu(window_menu, for_item: window_item);
    app.set_windows_menu(window_menu);

    app.set_main_menu(main_menu);
    return;
}

fn menu_selector_for_action(action: u32) -> *u8 {
    if action == facet::menu_action_quit() {
        return rt::sel(#str_ptr("terminate:\0"));
    }
    if action == facet::menu_action_close_window() {
        return rt::sel(#str_ptr("performClose:\0"));
    }
    return 0 as *u8;
}

fn add_app_menu_item(menu: ak::Menu, item: *facet::MenuItem, command: u64) {
    let selector: *u8 = menu_selector_for_action({ (*item).action });
    let mi: ak::MenuItem = menu.add_item_with_title({ (*item).title.view() }, selector, { (*item).key.view() });
    mi.set_target(0 as *u8);
    if (*item).key.count() != (0 as usize) {
        mi.set_key_equivalent_modifier_mask(command);
    }
    return;
}

fn add_menu_group(
    main_menu: ak::Menu,
    group_title: str,
    items: *vec::Vec[facet::MenuItem],
    command: u64,
) -> option::Option[ak::Menu] {
    let group_menu: ak::Menu = ak::Menu::new(group_title);
    var has_items: bool = false;
    let n: usize = { (*items).count() };
    var i: usize = 0 as usize;
    while i < n {
        match { (*items).at_ptr(i) } {
            option::Option[*facet::MenuItem]::Some(item) => {
                if { (*item).menu.equals(group_title) } {
                    add_app_menu_item(group_menu, item, command);
                    has_items = true;
                }
            }
            option::Option[*facet::MenuItem]::None => { }
        }
        i = i +% (1 as usize);
    }
    if has_items == false {
        return option::Option[ak::Menu]::None;
    }

    let group_item: ak::MenuItem = ak::MenuItem::new(group_title, 0 as *u8, "");
    main_menu.add_item(group_item);
    main_menu.set_submenu(group_menu, for_item: group_item);
    return option::Option[ak::Menu]::Some(group_menu);
}

fn install_app_menu(app: ak::Application, menu: *facet::AppMenu, fallback_title: str) {
    let command: u64 = ak::event_modifier_flags_n_s_event_modifier_flag_command;
    var menu_title: str = fallback_title;
    if (*menu).title.count() != (0 as usize) {
        menu_title = (*menu).title.view();
    }

    let main_menu: ak::Menu = ak::Menu::new("");
    let items: *vec::Vec[facet::MenuItem] = { #addr_of((*menu).items) };

    let app_item: ak::MenuItem = ak::MenuItem::new("", 0 as *u8, "");
    main_menu.add_item(app_item);
    let app_menu: ak::Menu = ak::Menu::new(menu_title);
    let n: usize = { (*items).count() };
    var i: usize = 0 as usize;
    while i < n {
        match { (*items).at_ptr(i) } {
            option::Option[*facet::MenuItem]::Some(item) => {
                if { (*item).menu.equals("App") } {
                    add_app_menu_item(app_menu, item, command);
                }
            }
            option::Option[*facet::MenuItem]::None => { }
        }
        i = i +% (1 as usize);
    }
    main_menu.set_submenu(app_menu, for_item: app_item);

    let _edit_menu: option::Option[ak::Menu] = add_menu_group(main_menu, "Edit", items, command);
    let _build_menu: option::Option[ak::Menu] = add_menu_group(main_menu, "Build", items, command);
    match add_menu_group(main_menu, "Window", items, command) {
        option::Option[ak::Menu]::Some(window_menu) => {
            app.set_windows_menu(window_menu);
        }
        option::Option[ak::Menu]::None => { }
    }
    let _help_menu: option::Option[ak::Menu] = add_menu_group(main_menu, "Help", items, command);

    app.set_main_menu(main_menu);
    return;
}

fn run(take root: facet::Node, title: str = "facet", width: f64 = 480.0f64, height: f64 = 360.0f64, clean_titlebar: bool = false, zoomable: bool = false) {
    run_window(
        root,
        title: title,
        width: width,
        height: height,
        clean_titlebar: clean_titlebar,
        close_button_only: false,
        unified_toolbar: false,
        hide_title: false,
        zoomable: zoomable,
        app_menu_enabled: false,
        app_menu: facet::empty_app_menu(),
        ctx: 0 as *u8,
        should_close: default_should_close,
        will_close: default_will_close,
    );
    return;
}

fn default_should_close(ctx: *u8) -> bool { return true; }

fn default_will_close(ctx: *u8) { return; }

// Window-shell state whose ADDRESSES the run loop reads for the window's whole
// life: the delegate's user pointer (should_close / will_close / did_resize),
// the delegate method table, the mounted root description (toolbar items,
// RUN_ROOT), and the app menu items. run_window used to keep these alive on its
// blocking frame; open_window RETURNS, so they live here instead. One shell
// window at a time — the same single-window model RUN_ROOT already encodes.
static WIN_LIFECYCLE: WindowLifecycle = #zero::[WindowLifecycle]();
static WIN_DELEGATE: ak::WindowDelegate = #zero::[ak::WindowDelegate]();
static RUN_ROOT_NODE: facet::Node = #zero::[facet::Node]();
static APP_MENU: facet::AppMenu = #zero::[facet::AppMenu]();

// Open the shell window and MOUNT the root — then return, loop not yet running.
// The seam that makes lifecycle composable: a typed caller (run_component) can
// act between "the tree is live" and "the loop blocks" — fire on_attach, stage
// initial state — without the backend ever holding an erased callback into the
// component. Pair with run_loop(); run_window is exactly that composition.
fn open_window(
    take root: facet::Node,
    title: str = "facet",
    width: f64 = 480.0f64,
    height: f64 = 360.0f64,
    clean_titlebar: bool = false,
    close_button_only: bool = false,
    unified_toolbar: bool = false,
    hide_title: bool = false,
    custom_chrome: bool = false,
    native_buttons: bool = false,
    min_width: f64 = 0.0f64,
    min_height: f64 = 0.0f64,
    zoomable: bool = false,
    min_zoom: f64 = 1.0f64,
    max_zoom: f64 = 4.0f64,
    app_menu_enabled: bool = false,
    take app_menu: facet::AppMenu = facet::empty_app_menu(),
    ctx: *u8 = 0 as *u8,
    should_close: fn(*u8) -> bool = default_should_close,
    will_close: fn(*u8) = default_will_close,
    component_ctx: *u8 = 0 as *u8,
) -> ak::Window {
    let app: ak::Application = ak::Application::shared_application();
    let _ok: bool = app.set_activation_policy(ak::ApplicationActivationPolicy::Regular);
    APP_MENU = app_menu;   // keep the items alive for menu action targets
    if app_menu_enabled {
        install_app_menu(app, #addr_of(APP_MENU), title);
    } else {
        install_default_app_menu(app, title);
    }

    // The root lives in the static from here on: its address feeds RUN_ROOT and
    // the toolbar installer, and it must outlive this returning frame.
    RUN_ROOT_NODE = root;

    // The mount-slot key. By default the root description's own address; an app
    // that supplies component_ctx keys the slot with a component address IT can
    // name (its component's address), so its handlers can facet::find(cp, key)
    // and the structural verbs are reachable under facet::run.
    var slot_cp: *u8 = component_ctx;
    if slot_cp == { 0 as *u8 } { slot_cp = #addr_of(RUN_ROOT_NODE) as *u8; }

    WIN_LIFECYCLE = WindowLifecycle {
        ctx: ctx,
        should_close: should_close,
        will_close: will_close,
        relayout_cp: slot_cp,   // the slot key, for resize relayout
    };
    WIN_DELEGATE = ak::WindowDelegate_new(#addr_of(WIN_LIFECYCLE) as *u8);

    let win = make_shell_window(title, width, height, clean_titlebar, close_button_only: close_button_only, custom_chrome: custom_chrome, native_buttons: native_buttons, min_width: min_width, min_height: min_height);
    OPEN_WINDOWS = OPEN_WINDOWS +% 1;
    install_window_lifecycle(win, #addr_of(WIN_LIFECYCLE), #addr_of(WIN_DELEGATE));

    let content = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: width, h: height });
    win.set_content_view(ak::View::from_raw(content.raw()));

    // Mount the root as a RETAINED slot (keyed by slot_cp) rather than a
    // one-shot mount_into. render_slot lays it out at the host's CURRENT frame
    // and keeps the tree, so windowDidResize can relayout it at the window's real
    // size instead of leaving the content frozen at the mount-time size.
    RUN_ROOT = #addr_of(RUN_ROOT_NODE);
    let _h: f64 = ui::mount(run_root_render, ctx: slot_cp, host: content.raw());
    // System light/dark flips reach the app through facet::on_appearance_change:
    // an invisible sentinel subview's viewDidChangeEffectiveAppearance forwards
    // the signal (the override is the only hook AppKit offers).
    akx::add_appearance_observer(ak::View::from_raw(content.raw()), fire_appearance_change, 0 as *u8);
    if zoomable {
        install_pinch_zoom(content.raw(), min_zoom: min_zoom, max_zoom: max_zoom);
    }
    install_toolbar(win, #addr_of(RUN_ROOT_NODE));
    if unified_toolbar {
        win.set_toolbar_style(ak::WindowToolbarStyle::UnifiedCompact);
    }
    if hide_title {
        win.set_title_visibility(ak::WindowTitleVisibility::NSWindowTitleHidden);
    }

    win.center();
    win.make_key_and_order_front(0 as *u8);
    app.activate_ignoring_other_apps(true);
    // windowDidResize does not fire on the initial display, so lay out once more
    // at the content view's real (post-show) size to fill from the first frame.
    let _r0: bool = ui::relayout(slot_cp);
    return win;
}

// Block in the app run loop until the last shell window closes (will_close
// stops the loop). The second half of the open_window / run_loop pair.
fn run_loop() {
    ak::Application::shared_application().run();
    return;
}

fn run_window(
    take root: facet::Node,
    title: str = "facet",
    width: f64 = 480.0f64,
    height: f64 = 360.0f64,
    clean_titlebar: bool = false,
    close_button_only: bool = false,
    unified_toolbar: bool = false,
    hide_title: bool = false,
    custom_chrome: bool = false,
    native_buttons: bool = false,
    min_width: f64 = 0.0f64,
    min_height: f64 = 0.0f64,
    zoomable: bool = false,
    min_zoom: f64 = 1.0f64,
    max_zoom: f64 = 4.0f64,
    app_menu_enabled: bool = false,
    take app_menu: facet::AppMenu = facet::empty_app_menu(),
    ctx: *u8 = 0 as *u8,
    should_close: fn(*u8) -> bool = default_should_close,
    will_close: fn(*u8) = default_will_close,
    component_ctx: *u8 = 0 as *u8,
) {
    let _w: ak::Window = open_window(
        root,
        title: title,
        width: width,
        height: height,
        clean_titlebar: clean_titlebar,
        close_button_only: close_button_only,
        unified_toolbar: unified_toolbar,
        hide_title: hide_title,
        custom_chrome: custom_chrome,
        native_buttons: native_buttons,
        min_width: min_width,
        min_height: min_height,
        zoomable: zoomable,
        min_zoom: min_zoom,
        max_zoom: max_zoom,
        app_menu_enabled: app_menu_enabled,
        app_menu: app_menu,
        ctx: ctx,
        should_close: should_close,
        will_close: will_close,
        component_ctx: component_ctx,
    );
    run_loop();
    return;
}

// A modal alert (matrix §4). Imperative + app-level — a blocking modal, not a
// render-tree kind (like `run`, it can't be unit-tested headlessly). Returns
// the 0-based index of the clicked button (0 = `primary`, 1 = `secondary`).
fn alert(title: str, message: str, primary: str, secondary: str = "") -> i32 {
    let a: ak::Alert = ak::Alert::from_raw(rt::alloc_init(#str_ptr("NSAlert\0")));
    a.set_message_text(title);
    a.set_informative_text(message);
    let _b0: ak::Button = a.add_button_with_title(primary);   // → response 1000
    if secondary != "" { let _b1: ak::Button = a.add_button_with_title(secondary); }
    let resp: i64 = a.run_modal();
    return (resp -% (1000 as i64)) as i32;
}

// A modal dialog with custom facet content (matrix §4 Sheet/Modal). Mounts the
// tree in an app-modal window and runs the modal loop; returns the dismiss code.
// A handler inside `root` dismisses it with `end_modal(code)`. Imperative +
// blocking (like `run`/`alert`) — not a render kind, not headless-testable.
fn present_modal(take root: facet::Node, title: str, width: f64, height: f64) -> i64 {
    let win = make_shell_window(title, width, height, false);
    let content = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: width, h: height });
    win.set_content_view(ak::View::from_raw(content.raw()));
    let _h: f64 = mount_into(#addr_of(root), content.raw(), width, height);
    win.center();
    win.make_key_and_order_front(0 as *u8);
    return ak::Application::shared_application().run_modal_for_window(win);
}

// A non-modal secondary window with custom facet content — opens ALONGSIDE the
// main window and returns immediately; the app's existing run loop drives it
// (unlike present_modal, which blocks in its own modal loop). For settings /
// inspector / tool windows. make_shell_window retains the window, and its
// content views outlive the dropped description tree. Imperative + app-level
// (needs a running app), so not headless-testable.
fn present_window(take root: facet::Node, title: str, width: f64, height: f64) {
    let win = make_shell_window(title, width, height, false);
    let content = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: width, h: height });
    win.set_content_view(ak::View::from_raw(content.raw()));
    let _h: f64 = mount_into(#addr_of(root), content.raw(), width, height);
    win.center();
    win.make_key_and_order_front(0 as *u8);
    return;
}

// Portable file/directory pickers — front the ui-module NSOpenPanel wrappers so
// facet/runtime can expose them app-tier (the alert / present_window pattern).
// Blocking; the chosen path, or None on cancel.
fn choose_directory() -> option::Option[text::Text] { return ui::choose_directory(); }
fn choose_file() -> option::Option[text::Text] { return ui::choose_file(); }

// Dismiss the current modal (call from a button handler inside the modal tree).
fn end_modal(code: i64) {
    ak::Application::shared_application().stop_modal_with_code(code);
    return;
}

// Window-button actions for a custom titlebar: a button handler calls these with
// its `sender` (the clicked control), and they drive the enclosing window the way
// the standard traffic lights do (close respects windowShouldClose:). These pair
// with a hidden-button window (run_window custom_chrome) + custom controls.
fn window_close(sender: *u8) { akx::window_perform_close(sender); return; }
fn window_minimize(sender: *u8) { akx::window_perform_minimize(sender); return; }
fn window_zoom(sender: *u8) { akx::window_perform_zoom(sender); return; }

// The live popover — an NSPopover deallocs (and dismisses) if nothing retains it,
// so it is held here while shown (the previous one is released on the next show).
static CURRENT_POPOVER: *u8 = #zero::[*u8]();

// Show a transient popover with custom facet content, anchored below `anchor_ptr`
// (a view, e.g. found via find_view_by_id). Imperative + app-level (like alert).
fn present_popover(anchor_ptr: *u8, take root: facet::Node, width: f64, height: f64) {
    let content = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: width, h: height });
    let _h: f64 = mount_into(#addr_of(root), content.raw(), width, height);
    let vc_ptr: *u8 = rt::alloc_init(#str_ptr("NSViewController\0"));
    rt::msg_void_id(vc_ptr, rt::sel(#str_ptr("setView:\0")), content.raw());
    let pop: ak::Popover = ak::Popover::new();
    pop.set_content_view_controller(ak::ViewController::from_raw(vc_ptr));
    rt::release(vc_ptr);   // the popover retains the VC
    pop.set_content_size(rt::Size { w: width, h: height });
    pop.set_behavior(ak::PopoverBehavior::Transient);   // dismiss on outside click
    if CURRENT_POPOVER != (0 as *u8) { rt::release(CURRENT_POPOVER); }
    CURRENT_POPOVER = rt::retain(pop.raw());             // keep it alive while shown
    let anchor: ak::View = ak::View::from_raw(anchor_ptr);
    pop.show_relative_to_rect(anchor.bounds(), anchor, ak::RectEdge::MaxY);
    return;
}

// ---- tests -------------------------------------------------------------------
// The literal `@facet` surface works in this module (facet is an import), so
// the whole description -> widget pipeline is tested here; `run` itself only
// adds the window + event loop on top of `mount_into`.

fn approx(a: f64, b: f64) -> bool {
    let d: f64 = a - b;
    if d < 0.0f64 { return (0.0f64 - d) < 0.01f64; }
    return d < 0.01f64;
}

fn t_noop(sender: *u8, ctx: *u8) { return; }

// Explicit remount: clear the host's subviews, then mount a fresh tree. This is
// the app's own "re-open this screen" path (iris drives it via ui::fill_scroll /
// mount_into) — an explicit rebuild, not a reactive one; there is no global
// runtime. The tests drive it directly to exercise remount behavior.
fn remount(view: fn() -> facet::Node, content_ptr: *u8, w: f64, h: f64) {
    let content: ak::View = ak::View::from_raw(content_ptr);
    var subs: vec::Vec[ak::View] = content.subviews();
    let cnt: usize = subs.count();
    for i in 0..(cnt as i32) {
        match subs.at_ptr(i as usize) {
            option::Option[*ak::View]::Some(sp) => { { (*sp).remove_from_superview(); } }
            option::Option[*ak::View]::None => { }
        }
    }
    var root: facet::Node = view();
    let _h: f64 = mount_into(#addr_of(root), content_ptr, w, h);
    return;
}

#[test]
fn label_op_builds_textfield_with_config() {
    let d: facet::Node = facet::label("Hello", size: 28.0f64, bold: true);
    let n: flex::Node = ak_label(0 as *u8, #addr_of(d));
    assert n.has_payload();
    let tf: ak::TextField = ak::TextField::from_raw(n.payload());
    let t = tf.as_control().string_value();
    assert t.count() == (5 as usize);
}

#[test]
fn button_op_wires_title_and_click_identity() {
    CLICKS = 0;
    let d: facet::Node = facet::button("del", primary: true).on_click(t_click, ctx: 7 as *u8);
    let n: flex::Node = ak_button(0 as *u8, #addr_of(d));
    let bp: *u8 = n.payload();
    let b: ak::Button = ak::Button::from_raw(bp);
    let t = b.title();
    assert t.count() == (3 as usize);
    // Fire through the wired target/action pair, as a click would.
    let tgt: *u8 = rt::msg_id(bp, rt::sel(#str_ptr("target\0")));
    let act: *u8 = rt::msg_id(bp, rt::sel(#str_ptr("action\0")));
    assert tgt != (0 as *u8);
    rt::msg_void_id(tgt, act, bp);
    assert CLICKS == 1;
    assert CLICK_CTX == (7 as i64);
}

static CLICKS: i32 = 0;
static CLICK_CTX: i64 = 0;

fn t_click(sender: *u8, ctx: *u8) {
    CLICKS = CLICKS + 1;
    CLICK_CTX = ctx as i64;
    return;
}

#[test]
fn facet_block_mounts_into_views() {
    // The full pipeline: @facet description -> mount -> layout -> NSViews.
    let content = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 300.0, h: 200.0 });
    var root: facet::Node = @facet {
        card {
            label("Iris", size: 28.0f64, bold: true)
            hstack {
                button("New", primary: true).on_click(t_click)
                button("Open")
            }
        }
    };
    let h: f64 = mount_into(#addr_of(root), content.raw(), 300.0f64, 200.0f64);
    assert h > 0.0f64;
    // content -> card (synthesized container view) -> label + hstack.
    let subs = content.subviews();
    assert subs.count() == (1 as usize);
    match subs.at_ptr(0 as usize) {
        option::Option[*ak::View]::Some(cardv) => {
            let inner = { (*cardv).subviews() };
            assert inner.count() == (2 as usize);   // label view + hstack view
        }
        option::Option[*ak::View]::None => { assert false; }
    };
}

#[test]
fn spacer_pushes_button_to_the_edge() {
    let content = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 400.0, h: 60.0 });
    var root: facet::Node = @facet {
        row {
            label("t").width(50.0f64).height(20.0f64)
            spacer()
            button("ok").width(80.0f64).height(20.0f64)
        }
    };
    var tree: flex::Node = mount(#addr_of(root));
    tree.set_width(flex::StyleLength::points(400.0f64));
    tree.set_height(flex::StyleLength::points(60.0f64));
    tree.calculate_layout(400.0f64, 60.0f64, flex::Direction::LTR);
    // root column -> row -> [label, spacer, button]; the button hugs the right.
    match tree.children.at_ptr(0 as usize) {
        option::Option[*flex::Node]::Some(rp) => {
            let bf: flex::Layout = must_layout({ (*rp).child_layout(2 as usize) });
            assert approx(bf.left, 320.0f64);   // 400 - 80
        }
        option::Option[*flex::Node]::None => { assert false; }
    };
}

fn must_layout(o: option::Option[flex::Layout]) -> flex::Layout {
    return match o {
        option::Option[flex::Layout]::Some(l) => l,
        option::Option[flex::Layout]::None => flex::Layout { left: -999.0f64, top: -999.0f64, width: 0.0f64, height: 0.0f64 },
    };
}

// -- the counter story: explicit re-render -----------------------------------
// State in a static, a handler that mutates it, a view that reads it. The app
// re-renders explicitly after the mutation (component model — no global
// runtime). Digit-width assertions ("count 9" = 7 chars, "count 10" = 8)
// avoid depending on str equality.

static COUNT: i32 = 0;

fn count_inc(sender: *u8, ctx: *u8) {
    COUNT = COUNT + 1;
    return;
}

fn counter_view() -> facet::Node {
    let t: text::Text = "count ${COUNT}";
    return @facet {
        vstack {
            label(t.view(), size: 20.0f64)
            button("+1").on_click(count_inc)
        }
    };
}

// content -> root column view? No: the @facet root column is the mounted
// ROOT node itself, so apply hangs its children directly under content.
// content -> vstack (synthesized) -> [label view, button view].
fn nth_widget(content_ptr: *u8, i: usize) -> *u8 {
    let content: ak::View = ak::View::from_raw(content_ptr);
    var subs: vec::Vec[ak::View] = content.subviews();
    match subs.at_ptr(0 as usize) {
        option::Option[*ak::View]::Some(stackv) => {
            var inner: vec::Vec[ak::View] = { (*stackv).subviews() };
            match inner.at_ptr(i) {
                option::Option[*ak::View]::Some(w) => { return { (*w).raw() }; }
                option::Option[*ak::View]::None => { }
            }
        }
        option::Option[*ak::View]::None => { }
    }
    return 0 as *u8;
}

fn click(button_ptr: *u8) {
    let tgt: *u8 = rt::msg_id(button_ptr, rt::sel(#str_ptr("target\0")));
    let act: *u8 = rt::msg_id(button_ptr, rt::sel(#str_ptr("action\0")));
    rt::msg_void_id(tgt, act, button_ptr);
    return;
}

#[test]
fn counter_label_follows_state_on_remount() {
    COUNT = 9;
    let content = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 300.0, h: 200.0 });
    remount(counter_view, content.raw(), 300.0f64, 200.0f64);

    // Initial render: "count 9" — 7 characters.
    let l0: ak::TextField = ak::TextField::from_raw(nth_widget(content.raw(), 0 as usize));
    assert l0.as_control().string_value().count() == (7 as usize);

    // Click the button: the handler mutates state. Re-render is explicit — the
    // component model, the handler does not auto-refresh.
    click(nth_widget(content.raw(), 1 as usize));
    assert COUNT == 10;
    remount(counter_view, content.raw(), 300.0f64, 200.0f64);

    // The (rebuilt) label now reads "count 10" — 8 characters.
    let l1: ak::TextField = ak::TextField::from_raw(nth_widget(content.raw(), 0 as usize));
    assert l1.as_control().string_value().count() == (8 as usize);
}

// counter_view with agent-id tags on both leaves.
fn tagged_counter_view() -> facet::Node {
    let t: text::Text = "count ${COUNT}";
    return @facet {
        vstack {
            label(t.view(), size: 20.0f64).agent_id("count-label")
            button("+1").on_click(count_inc).agent_id("inc-btn")
        }
    };
}

// Phase 1 shared demo — a portable @facet tree meant as the shared
// multi-backend demo. Proves the portable description mounts on AppKit
// without a second backend present.
fn demo_submit_noop(ctx: *u8, tv: *u8) { return; }

fn phase1_demo_view() -> facet::Node {
    let t: text::Text = "count ${COUNT}";
    return @facet {
        vstack {
            label("facet multi-backend", size: 24.0f64, bold: true)
            label("one DSL · native backends", secondary: true)
            label(t.view(), size: 18.0f64).agent_id("count-label")
            button("+1", primary: true).on_click(count_inc).agent_id("inc-btn")
            composer(on_submit: demo_submit_noop, value: "")
                .agent_id("chat-input")
                .height(80.0f64)
                .grow(1.0f64)
        }
    };
}

#[test]
fn phase1_shared_demo_mounts_on_appkit() {
    COUNT = 0;
    let content = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 400.0, h: 300.0 });
    remount(phase1_demo_view, content.raw(), 400.0f64, 300.0f64);
    // Tags from set_identity: count label, +1 button, composer inner text view.
    // Walk by accessibility ids instead of index.
    assert surface_has_id(content.raw(), "count-label");
    assert surface_has_id(content.raw(), "inc-btn");
    assert surface_has_id(content.raw(), "chat-input");
}

// True if any descendant view carries the given accessibilityIdentifier.
// Find a descendant view by agent id (accessibilityIdentifier), or 0 (null).
// Does `view`'s accessibilityIdentifier equal `id`? Compares the NSString's UTF8
// as a borrowed `str` VIEW — it never materializes an owned `Text`. This is the
// hot path (every `find` walks the tree calling this per view), so avoiding a
// per-comparison `to_text` allocation matters; and owning no Text, it has nothing
// to drop.
fn view_id_is(view: *u8, id: str) -> bool {
    let ns: *u8 = rt::msg_id(view, rt::sel(#str_ptr("accessibilityIdentifier\0")));
    if ns == (0 as *u8) { return id == ""; }
    let utf8: *u8 = rt::msg_id(ns, rt::sel(#str_ptr("UTF8String\0")));
    if utf8 == (0 as *u8) { return id == ""; }
    let len: u64 = rt::msg_u64_u64(ns, rt::sel(#str_ptr("lengthOfBytesUsingEncoding:\0")), bridge::ns_utf8());
    let sv: str = { #str_from_raw_parts(utf8, len as usize) };
    return sv == id;
}

fn find_view_by_id(root: *u8, id: str) -> *u8 {
    if root == (0 as *u8) { return 0 as *u8; }
    if view_id_is(root, id) { return root; }
    let v: ak::View = ak::View::from_raw(root);
    var subs: vec::Vec[ak::View] = v.subviews();
    let n: usize = subs.count();
    var i: usize = 0 as usize;
    while i < n {
        match subs.at_ptr(i) {
            option::Option[*ak::View]::Some(sp) => {
                let found: *u8 = find_view_by_id({ (*sp).raw() }, id);
                if found != (0 as *u8) { return found; }
            }
            option::Option[*ak::View]::None => { }
        }
        i = i +% (1 as usize);
    }
    return 0 as *u8;
}

// Normalize a handler's `sender` to a VIEW. A control's action passes the
// control (an NSView), but a `clickable`'s handler fires from a gesture
// recognizer's target/action, so its sender is the RECOGNIZER — msgSend-ing
// view selectors (`window`, `accessibilityIdentifier`) on it would throw
// unrecognized-selector. If the sender responds to `view` (recognizers do,
// views don't), take that; otherwise the sender already is the view.
fn sender_view(sender: *u8) -> *u8 {
    if sender == (0 as *u8) { return 0 as *u8; }
    let responds: i8 = rt::msg_i8_id(sender, rt::sel(#str_ptr("respondsToSelector:\0")), rt::sel(#str_ptr("view\0")));
    if responds != (0 as i8) {
        let v: *u8 = rt::msg_id(sender, rt::sel(#str_ptr("view\0")));
        if v != (0 as *u8) { return v; }
    }
    return sender;
}

// facet::key_of hook: the sender's key (accessibilityIdentifier) as an owned
// Text. Normalizes recognizer senders to their view, then walks superviews to
// the first NON-EMPTY id — a click on an untagged inner view (an icon inside a
// tagged row) still reads the row's key. Empty when nothing up the chain is
// tagged. Read mirrors view_id_is (borrowed UTF8 view; owns a Text only on hit).
fn key_of_impl(sender: *u8) -> text::Text {
    var v: *u8 = sender_view(sender);
    while v != (0 as *u8) {
        let ns: *u8 = rt::msg_id(v, rt::sel(#str_ptr("accessibilityIdentifier\0")));
        if ns != (0 as *u8) {
            let len: u64 = rt::msg_u64_u64(ns, rt::sel(#str_ptr("lengthOfBytesUsingEncoding:\0")), bridge::ns_utf8());
            if len > (0 as u64) { return bridge::to_text(ns); }
        }
        v = rt::msg_id(v, rt::sel(#str_ptr("superview\0")));
    }
    return text::new();
}

// Is `a` the dark appearance? bestMatch resolves derived appearances (vibrant
// dark, high-contrast variants) onto the base pair.
fn appearance_is_dark(a: ak::Appearance) -> bool {
    var names: vec::Vec[text::Text] = vec::new::[text::Text]();
    names.append(text::from_str("NSAppearanceNameAqua"));
    names.append(text::from_str("NSAppearanceNameDarkAqua"));
    match a.best_match_from_appearances_with_names(names) {
        option::Option[text::Text]::Some(n) => { return n.equals("NSAppearanceNameDarkAqua"); }
        option::Option[text::Text]::None => { return false; }
    }
    return false;
}

// facet::is_dark hook: the app-wide effective appearance.
fn is_dark_impl() -> bool {
    return appearance_is_dark(ak::Application::shared_application().effective_appearance());
}

// The sentinel's callback (see run_window): forward the flip to the app's
// registered facet::on_appearance_change handler.
fn fire_appearance_change(ctx: *u8) {
    facet::notify_appearance_changed();
    return;
}

// Raise the keyed view to the front of its siblings so it paints on top — the
// no-rebuild panel switch: the runtime effect of a higher z_index, done by
// re-ordering the live views (no re-render). Reached from a handler's `sender`
// (the clicked control or a clickable's recognizer, normalized to its view):
// sender -> window -> content, find by key, re-add last.
fn raise(sender: *u8, key: str) {
    let sv: *u8 = sender_view(sender);
    if sv == (0 as *u8) { return; }
    let btn: ak::View = ak::View::from_raw(sv);
    match btn.window() {
        option::Option[ak::Window]::Some(win) => {
            match win.content_view() {
                option::Option[ak::View]::Some(content) => {
                    let v: *u8 = find_view_by_id(content.raw(), key);
                    if v != (0 as *u8) {
                        let pv: ak::View = ak::View::from_raw(v);
                        match pv.superview() {
                            option::Option[ak::View]::Some(sup) => {
                                pv.remove_from_superview();
                                sup.add_subview(pv);
                            }
                            option::Option[ak::View]::None => { }
                        }
                    }
                }
                option::Option[ak::View]::None => { }
            }
        }
        option::Option[ak::Window]::None => { }
    }
    return;
}

// ---- find: resolve a key to a live element, then mutate it in place ----------
// The backend half of `facet::find` (registered in `install`). facet core stays
// platform-neutral; this walks the component's RETAINED flex tree for the keyed
// node and hands back a Handle. No re-render, no diff — the keyed-direct path.

// Walk `fp`'s subtree for the flex node whose payload IS `view` (a pointer
// compare — no msgSend, so container payloads that are not real NSViews are
// stepped over safely). Returns the flex node (0 when absent): it is what we
// re-measure after editing the view's content.
fn flex_node_for_view(fp: *flex::Node, view: *u8) -> *flex::Node {
    if fp == (0 as *flex::Node) { return 0 as *flex::Node; }
    if { (*fp).payload() } == view { return fp; }
    let c: usize = { (*fp).child_count() };
    var i: usize = 0 as usize;
    while i < c {
        match (*fp).children.at_ptr(i) {
            option::Option[*flex::Node]::Some(cp) => {
                let r: *flex::Node = flex_node_for_view(cp, view);
                if r != (0 as *flex::Node) { return r; }
            }
            option::Option[*flex::Node]::None => { }
        }
        i = i +% (1 as usize);
    }
    return 0 as *flex::Node;
}

// Resolve `view`'s flex node: the component's slot tree first, then the
// hosted-tree registries (split panes / scroll rows — their subtrees are moved
// OUT of the slot tree at mount, see ui::hosted_flex_for_view). The structural
// verbs re-run this after mounting a child: a mount can grow a registry vec
// and move the entry a previously resolved pointer aimed into.
fn resolve_flex(cp: *u8, view: *u8) -> *flex::Node {
    match ui::tree_ptr(cp) {
        option::Option[*flex::Node]::Some(tp) => {
            let fp: *flex::Node = flex_node_for_view(tp, view);
            if fp != (0 as *flex::Node) { return fp; }
        }
        option::Option[*flex::Node]::None => { }
    }
    return ui::hosted_flex_for_view(view);
}

// facet::find hook: resolve `key` inside component `cp`'s live subtree. The view
// is found by walking the real NSView hierarchy under the component's host (safe
// accessibilityIdentifier reads); the flex node is then matched by pointer —
// in the slot tree or, for split-pane / scroll-hosted subtrees, in the owning
// registry's tree.
fn find_impl(cp: *u8, key: str) -> facet::Handle {
    // cp == 0 → GLOBAL find: walk every mounted component's host by
    // accessibilityIdentifier, exactly as an agent addresses the UI. The Handle
    // records the OWNING slot's cp (not 0) so later in-place mutation reflows the
    // right component.
    if cp == (0 as *u8) {
        let n: usize = ui::slot_count();
        var i: usize = 0 as usize;
        while i < n {
            let host_i: *u8 = ui::slot_host_at(i);
            if host_i != (0 as *u8) {
                let v: *u8 = find_view_by_id(host_i, key);
                if v != (0 as *u8) {
                    let owner: *u8 = ui::cp_of_host(host_i);
                    var fpx: *u8 = 0 as *u8;
                    let f2: *flex::Node = resolve_flex(owner, v);
                    if f2 != (0 as *flex::Node) { fpx = f2 as *u8; }
                    return facet::Handle::of(v, fpx, owner, 0 as u32);
                }
            }
            i = i +% (1 as usize);
        }
        return facet::Handle::missing();
    }
    let host: *u8 = ui::host_of(cp);
    if host == (0 as *u8) { return facet::Handle::missing(); }
    let view: *u8 = find_view_by_id(host, key);
    if view == (0 as *u8) { return facet::Handle::missing(); }
    var flexp: *u8 = 0 as *u8;
    let fp: *flex::Node = resolve_flex(cp, view);
    if fp != (0 as *flex::Node) { flexp = fp as *u8; }
    return facet::Handle::of(view, flexp, cp, 0 as u32);
}

// facet::Handle.set_text hook: edit the located view's text in place, then
// re-measure that one leaf and relayout the component (text can change size, so
// siblings reflow). This is the whole update — no re-render, no reconcile.
fn set_text_impl(h: facet::Handle, s: str) -> bool {
    let view: *u8 = h.view();
    if view == (0 as *u8) { return false; }
    // NSButton carries its text as `title`; labels / text fields as `stringValue`.
    let responds: i8 = rt::msg_i8_id(view, rt::sel(#str_ptr("respondsToSelector:\0")), rt::sel(#str_ptr("setTitle:\0")));
    if responds != (0 as i8) {
        ak::Button::from_raw(view).set_title(s);
    } else {
        ak::TextField::from_raw(view).as_control().set_string_value(s);
    }
    ui::clear_measure_caches(view);
    if h.flex() != (0 as *u8) {
        let fp: *flex::Node = h.flex() as *flex::Node;
        { (*fp).mark_content_changed(); }
    }
    let _r: bool = ui::reflow_owner(h.cp(), view);
    return true;
}

// facet::Handle.set_value hook: set a value control's number (slider / stepper /
// progress). These are fixed-size, so no re-measure or relayout is needed.
fn set_value_impl(h: facet::Handle, v: f64) -> bool {
    let view: *u8 = h.view();
    if view == (0 as *u8) { return false; }
    ak::Control::from_raw(view).set_double_value(v);
    return true;
}

// facet::Handle.value hook: read a mounted element's natural value. An
// NSSplitView reports its divider position (leading pane's trailing edge — the
// arranged_subviews walk the workspace did through ak:: by hand); a value control
// (slider / stepper / progress / gauge) reports its doubleValue. 0 otherwise.
fn value_impl(h: facet::Handle) -> f64 {
    let view: *u8 = h.view();
    if view == (0 as *u8) { return 0.0f64; }
    // NSSplitView: respondsToSelector(arrangedSubviews) → divider position.
    let is_split: i8 = rt::msg_i8_id(view, rt::sel(#str_ptr("respondsToSelector:\0")), rt::sel(#str_ptr("arrangedSubviews\0")));
    if is_split != (0 as i8) {
        var arranged: vec::Vec[ak::View] = ak::SplitView::from_raw(view).arranged_subviews();
        match arranged.at_ptr(0 as usize) {
            option::Option[*ak::View]::Some(vp) => {
                let fr: rt::Rect = { (*vp).frame() };
                return fr.x + fr.w;
            }
            option::Option[*ak::View]::None => { return 0.0f64; }
        }
    }
    // A value control: doubleValue.
    let has_dv: i8 = rt::msg_i8_id(view, rt::sel(#str_ptr("respondsToSelector:\0")), rt::sel(#str_ptr("doubleValue\0")));
    if has_dv != (0 as i8) { return ak::Control::from_raw(view).double_value(); }
    return 0.0f64;
}

// facet::Handle.set_on hook: flip a toggle / checkbox / switch. Fixed-size.
fn set_on_impl(h: facet::Handle, on: bool) -> bool {
    let view: *u8 = h.view();
    if view == (0 as *u8) { return false; }
    var st: i64 = 0 as i64;
    if on { st = 1 as i64; }
    ak::Button::from_raw(view).set_state(st);
    return true;
}

// facet::Handle.set_hidden hook: show or hide the element's view. (v1 toggles
// visibility only; collapsing the freed layout space is a later refinement.)
fn set_hidden_impl(h: facet::Handle, hidden: bool) -> bool {
    let view: *u8 = h.view();
    if view == (0 as *u8) { return false; }
    ak::View::from_raw(view).set_hidden(hidden);
    return true;
}

// facet::Handle.add_child hook: mount the child into a flex subtree, attach its
// views under the container's backing view, splice it into the container's
// children, and reflow. The container must be keyed (approach A) so its Handle
// carries a real view. The child's description drops after mount (keyed-direct
// retains the flex tree + views, not per-child descriptions).
fn add_child_impl(h: facet::Handle, take child: facet::Node) -> bool {
    let cview: *u8 = h.view();
    if cview == (0 as *u8) || h.flex() == (0 as *u8) { return false; }
    var child_flex: flex::Node = mount(#addr_of(child));
    // Re-resolve after the mount: mounting a child that itself contains a
    // hosted split/scroll appends to a registry vec, which can move the entry
    // the handle's flex pointer aimed into.
    let cfp: *flex::Node = resolve_flex(h.cp(), cview);
    if cfp == (0 as *flex::Node) { return false; }   // child_flex drops (views with it)
    ui::apply(#addr_of(child_flex), cview, false);   // add_subview; frames set by the reflow
    { (*cfp).add_child(child_flex); }                // MOVE the flex node into the container
    { (*cfp).mark_content_changed(); }               // force a re-layout that includes it
    let _r: bool = ui::reflow_owner(h.cp(), cview);
    drain_post_apply();   // size a freshly-mounted scroll/split child (deferred at mount)
    return true;
}

// facet::Handle.remove_child hook: find the direct child whose backing view
// carries `key`, detach its view subtree, drop its flex node (ordered, so
// siblings keep their order), and reflow. Returns whether one was removed.
fn remove_child_impl(h: facet::Handle, key: str) -> bool {
    let cview: *u8 = h.view();
    let cflex: *u8 = h.flex();
    if cview == (0 as *u8) || cflex == (0 as *u8) { return false; }
    let target: *u8 = find_view_by_id(cview, key);
    if target == (0 as *u8) { return false; }
    let cfp: *flex::Node = cflex as *flex::Node;
    let cc: usize = { (*cfp).child_count() };
    var i: usize = 0 as usize;
    while i < cc {
        match (*cfp).children.at_ptr(i) {
            option::Option[*flex::Node]::Some(childp) => {
                if { (*childp).payload() } == target {
                    // Removing the presented content: notify it (and anything
                    // presented inside it) before its views leave the tree.
                    lc_fire(cview);
                    lc_fire_under(target);
                    ak::View::from_raw(target).remove_from_superview();
                    let _g: option::Option[flex::Node] = { (*cfp).children.remove(i) };
                    { (*cfp).mark_content_changed(); }
                    let _r: bool = ui::reflow_owner(h.cp(), cview);
                    return true;
                }
            }
            option::Option[*flex::Node]::None => { }
        }
        i = i +% (1 as usize);
    }
    return false;
}

// facet::Handle.insert_child hook: mount a child and splice it into the
// container's children at index `at` (past the end appends), then reflow. Like
// add_child_impl but ordered.
fn insert_child_impl(h: facet::Handle, take child: facet::Node, at: usize) -> bool {
    let cview: *u8 = h.view();
    if cview == (0 as *u8) || h.flex() == (0 as *u8) { return false; }
    var child_flex: flex::Node = mount(#addr_of(child));
    let cfp: *flex::Node = resolve_flex(h.cp(), cview);       // re-resolve (see add_child_impl)
    if cfp == (0 as *flex::Node) { return false; }
    var idx: usize = at;
    let n: usize = { (*cfp).child_count() };
    if idx > n { idx = n; }
    ui::apply(#addr_of(child_flex), cview, false);            // add_subview; frames set by the reflow
    let _st = { (*cfp).children.insert(child_flex, idx) };    // MOVE the flex node in at `idx`
    { (*cfp).mark_content_changed(); }
    let _r: bool = ui::reflow_owner(h.cp(), cview);
    drain_post_apply();   // size a freshly-mounted scroll/split child (deferred at mount)
    return true;
}

// facet::Handle.replace_child hook: find the direct child carrying `key`, drop
// its view + flex node, and mount a fresh child at the SAME index, then reflow.
fn replace_child_impl(h: facet::Handle, key: str, take child: facet::Node) -> bool {
    let cview: *u8 = h.view();
    let cflex: *u8 = h.flex();
    if cview == (0 as *u8) || cflex == (0 as *u8) { return false; }
    let target: *u8 = find_view_by_id(cview, key);
    if target == (0 as *u8) { return false; }
    let cfp: *flex::Node = cflex as *flex::Node;
    let cc: usize = { (*cfp).child_count() };
    var i: usize = 0 as usize;
    while i < cc {
        match (*cfp).children.at_ptr(i) {
            option::Option[*flex::Node]::Some(childp) => {
                if { (*childp).payload() } == target {
                    // Replacing the presented content: notify it (and anything
                    // presented inside it) before its views leave the tree.
                    lc_fire(cview);
                    lc_fire_under(target);
                    ak::View::from_raw(target).remove_from_superview();
                    let _g: option::Option[flex::Node] = { (*cfp).children.remove(i) };
                    var child_flex: flex::Node = mount(#addr_of(child));
                    let cfp2: *flex::Node = resolve_flex(h.cp(), cview);   // re-resolve (see add_child_impl)
                    if cfp2 == (0 as *flex::Node) { return false; }
                    ui::apply(#addr_of(child_flex), cview, false);
                    let _st = { (*cfp2).children.insert(child_flex, i) };
                    { (*cfp2).mark_content_changed(); }
                    let _r: bool = ui::reflow_owner(h.cp(), cview);
                    drain_post_apply();   // size a freshly-mounted scroll/split child (deferred at mount)
                    return true;
                }
            }
            option::Option[*flex::Node]::None => { }
        }
        i = i +% (1 as usize);
    }
    return false;
}

// facet::Handle.set_child hook: clear this container's children (their view
// subtrees tear down, their flex nodes drop), then mount a single fresh child.
// The one-slot swap.
fn set_child_impl(h: facet::Handle, take child: facet::Node) -> bool {
    let cview: *u8 = h.view();
    let cflex: *u8 = h.flex();
    if cview == (0 as *u8) || cflex == (0 as *u8) { return false; }
    // There is something here already: tell the presented occupant (and any
    // component presented in a nested outlet) it is about to get removed —
    // fire-and-forget — BEFORE its views leave the tree.
    lc_fire(cview);
    let cfp: *flex::Node = cflex as *flex::Node;
    while { (*cfp).child_count() } > (0 as usize) {
        match (*cfp).children.at_ptr(0 as usize) {
            option::Option[*flex::Node]::Some(childp) => {
                let pv: *u8 = { (*childp).payload() };
                if pv != (0 as *u8) {
                    lc_fire_under(pv);
                    ak::View::from_raw(pv).remove_from_superview();
                }
            }
            option::Option[*flex::Node]::None => { }
        }
        let _g: option::Option[flex::Node] = { (*cfp).children.remove(0 as usize) };
    }
    var child_flex: flex::Node = mount(#addr_of(child));
    let cfp2: *flex::Node = resolve_flex(h.cp(), cview);   // re-resolve (see add_child_impl)
    if cfp2 == (0 as *flex::Node) { return false; }
    ui::apply(#addr_of(child_flex), cview, false);
    { (*cfp2).add_child(child_flex); }
    { (*cfp2).mark_content_changed(); }
    let _r: bool = ui::reflow_owner(h.cp(), cview);
    drain_post_apply();   // size a freshly-mounted scroll/split child (deferred at mount)
    return true;
}

// ==========================================================================
// Component lifecycle: stage / attach / detach (facet::Staged)
// ==========================================================================
//
// A staged component is mounted (exactly like mount_component) into a FACET-OWNED
// root view that starts with no superview — off-canvas. `attach` moves that root
// under a keyed container and fires on_attach; `detach` removes it from its
// superview (KEEPING the root and the component's retained tree — parked) and
// fires on_detach. The component stays registered the whole time, so find(cp,key)
// and relayout(cp) work identically whether it is parked or live. attach/detach
// touch nothing but the view's superview + one flag — no rebuild, no diff.

struct StageReg {
    opaque _cp: *u8,
    _root: ak::View,          // facet owns the parked root view (+1 held here)
    _on_attach: fn(*u8),
    opaque _on_attach_ctx: *u8,   // the callback's bound receiver (usually == _cp)
    _on_detach: fn(*u8),
    opaque _on_detach_ctx: *u8,
    _attached: bool,
}

static STAGED: vec::Vec[StageReg] = #zero::[vec::Vec[StageReg]]();

fn stage_index(cp: *u8) -> i64 {
    let reg: *vec::Vec[StageReg] = #addr_of(STAGED);
    let n: usize = { (*reg).count() };
    var i: usize = 0 as usize;
    while i < n {
        match (*reg).at_ptr(i) {
            option::Option[*StageReg]::Some(ep) => { if { (*ep)._cp } == cp { return i as i64; } }
            option::Option[*StageReg]::None => { }
        }
        i = i +% (1 as usize);
    }
    return -1 as i64;
}

fn stage_ptr(cp: *u8) -> *StageReg {
    let idx: i64 = stage_index(cp);
    if idx < (0 as i64) { return 0 as *StageReg; }
    match STAGED.at_ptr(idx as usize) {
        option::Option[*StageReg]::Some(ep) => { return ep; }
        option::Option[*StageReg]::None => { return 0 as *StageReg; }
    }
    return 0 as *StageReg;
}

// Full teardown of the staging at index `idx`: unplug the root, drop the mounted
// component (its retained tree + view +1s), then drop the registry entry (which
// releases the facet-owned root).
fn stage_teardown_at(idx: usize) {
    match STAGED.at_ptr(idx) {
        option::Option[*StageReg]::Some(ep) => {
            ak::View::from_raw({ (*ep)._root.raw() }).remove_from_superview();
            let _u: bool = unmount({ (*ep)._cp });
        }
        option::Option[*StageReg]::None => { return; }
    }
    let reg: *vec::Vec[StageReg] = #addr_of(STAGED);
    let _g: option::Option[StageReg] = { (*reg).remove(idx) };   // drops _root (-1)
    return;
}

// facet::stage hook: build the component into a facet-owned parked root (no
// superview) and register it. mount_component registers it in the slot/tree
// registry, so find + relayout work while it is parked or live.
fn stage_impl(build: fn(*u8) -> facet::Node, ctx: *u8, on_attach: fn(*u8), on_attach_ctx: *u8, on_detach: fn(*u8), on_detach_ctx: *u8) -> facet::Staged {
    if ctx == (0 as *u8) { return facet::Staged::none(); }
    let prior: i64 = stage_index(ctx);
    if prior >= (0 as i64) { stage_teardown_at(prior as usize); }   // re-stage replaces
    let root: ak::View = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 320.0, h: 480.0 });
    let root_raw: *u8 = root.raw();
    let _h: f64 = mount_component(build, ctx: ctx, host: root_raw);
    let reg: *vec::Vec[StageReg] = #addr_of(STAGED);
    (*reg).append(StageReg { _cp: ctx, _root: root, _on_attach: on_attach, _on_attach_ctx: on_attach_ctx, _on_detach: on_detach, _on_detach_ctx: on_detach_ctx, _attached: false });
    return facet::Staged::of(ctx, root_raw);
}

// facet::Handle.attach hook: move a staged component's parked root under this
// keyed container, size it to fill, reflow its content, and fire on_attach.
fn attach_impl(h: facet::Handle, s: facet::Staged) -> bool {
    let container: *u8 = h.view();
    if container == (0 as *u8) { return false; }
    if !s.valid() { return false; }
    let sp: *StageReg = stage_ptr(s.cp());
    if sp == (0 as *StageReg) { return false; }
    let root: *u8 = s.root();
    // One parent at a time: if already attached anywhere, unplug first (a move).
    ak::View::from_raw(root).remove_from_superview();
    let cf: rt::Rect = ak::View::from_raw(container).frame();
    ak::View::from_raw(root).set_frame(rt::Rect { x: 0.0, y: 0.0, w: cf.w, h: cf.h });
    // width + height sizable: the root tracks the container's size natively.
    let mask: u64 = ak::autoresizing_mask_options_n_s_view_width_sizable
        | ak::autoresizing_mask_options_n_s_view_height_sizable;
    rt::msg_void_u64(root, rt::sel(#str_ptr("setAutoresizingMask:\0")), mask);
    ak::View::from_raw(container).add_subview(ak::View::from_raw(root));
    let _r: bool = ui::relayout(s.cp());   // lay the content out at the container's size
    drain_post_apply();   // size any scroll/split in the attached subtree (deferred at mount)
    { (*sp)._attached = true; }
    let cb: fn(*u8) = { (*sp)._on_attach };
    cb({ (*sp)._on_attach_ctx });
    return true;
}

// facet::Staged.detach hook: unplug the root from its superview, KEEPING it and
// the component's retained tree (parked), and fire on_detach.
fn detach_impl(s: facet::Staged) -> bool {
    if !s.valid() { return false; }
    let sp: *StageReg = stage_ptr(s.cp());
    if sp == (0 as *StageReg) { return false; }
    if { (*sp)._attached } == false { return false; }
    ak::View::from_raw(s.root()).remove_from_superview();
    { (*sp)._attached = false; }
    let cb: fn(*u8) = { (*sp)._on_detach };
    cb({ (*sp)._on_detach_ctx });
    return true;
}

// facet::is_attached hook: is this staged component currently in the live tree?
// ---- container lifecycle registry (present's erased detach) ----------------
// One entry per container currently SHOWING a presented component: the erased
// on_detach (a facet::lc_detach_tramp instantiation) plus the component's
// address. The structural verbs fire it right before they remove or replace
// that content — notify, don't wait for anything — and clear the entry first,
// so a hook that itself mutates the tree cannot re-enter its own entry.
// Entries hold borrowed pointers: a presented component must outlive its
// presentation; every removal path below clears its entry, so nothing stales.
// The single-slot contract: a presented container shows exactly one tree.
struct LcEntry {
    opaque _container: *u8,
    _detach: fn(*u8),
    opaque _ctx: *u8,
}

static LC_ENTRIES: vec::Vec[LcEntry] = #zero::[vec::Vec[LcEntry]]();

fn lc_register_impl(h: facet::Handle, detach: fn(*u8), ctx: *u8) {
    let v: *u8 = h.view();
    if v == (0 as *u8) { return; }
    let reg: *vec::Vec[LcEntry] = #addr_of(LC_ENTRIES);
    let n: usize = { (*reg).count() };
    var i: usize = 0 as usize;
    while i < n {
        match (*reg).at_ptr(i) {
            option::Option[*LcEntry]::Some(ep) => {
                if { (*ep)._container } == v {
                    { (*ep)._detach = detach; }
                    { (*ep)._ctx = ctx; }
                    return;
                }
            }
            option::Option[*LcEntry]::None => { }
        }
        i = i +% (1 as usize);
    }
    (*reg).append(LcEntry { _container: v, _detach: detach, _ctx: ctx });
    return;
}

// Fire + clear the detach registered for `container`, if any.
fn lc_fire(container: *u8) {
    if container == (0 as *u8) { return; }
    let reg: *vec::Vec[LcEntry] = #addr_of(LC_ENTRIES);
    let n: usize = { (*reg).count() };
    var i: usize = 0 as usize;
    while i < n {
        match (*reg).at_ptr(i) {
            option::Option[*LcEntry]::Some(ep) => {
                if { (*ep)._container } == container {
                    let cb: fn(*u8) = { (*ep)._detach };
                    let ctx: *u8 = { (*ep)._ctx };
                    let _g: option::Option[LcEntry] = (*reg).swap_remove(i);
                    cb(ctx);
                    return;
                }
            }
            option::Option[*LcEntry]::None => { }
        }
        i = i +% (1 as usize);
    }
    return;
}

// Fire + clear every entry whose container sits under `root` (inclusive):
// removing a subtree also evicts any component presented INSIDE it (nested
// outlets), so they get told before their views die with the subtree.
fn lc_fire_under(root: *u8) {
    if root == (0 as *u8) { return; }
    let reg: *vec::Vec[LcEntry] = #addr_of(LC_ENTRIES);
    var i: usize = 0 as usize;
    while i < { (*reg).count() } {
        var hit: bool = false;
        match (*reg).at_ptr(i) {
            option::Option[*LcEntry]::Some(ep) => {
                var v: *u8 = { (*ep)._container };
                while v != (0 as *u8) {
                    if v == root {
                        hit = true;
                        v = 0 as *u8;
                    } else {
                        match ak::View::from_raw(v).superview() {
                            option::Option[ak::View]::Some(sv) => { v = sv.raw(); }
                            option::Option[ak::View]::None => { v = 0 as *u8; }
                        }
                    }
                }
            }
            option::Option[*LcEntry]::None => { }
        }
        if hit {
            match (*reg).at_ptr(i) {
                option::Option[*LcEntry]::Some(ep) => {
                    let cb: fn(*u8) = { (*ep)._detach };
                    let ctx: *u8 = { (*ep)._ctx };
                    let _g: option::Option[LcEntry] = (*reg).swap_remove(i);
                    cb(ctx);
                    // swap_remove moved a fresh entry into `i` — re-examine it.
                }
                option::Option[*LcEntry]::None => { i = i +% (1 as usize); }
            }
        } else {
            i = i +% (1 as usize);
        }
    }
    return;
}

// Fire + clear everything — full teardown (unmount_all / window-close drain).
fn lc_fire_all() {
    let reg: *vec::Vec[LcEntry] = #addr_of(LC_ENTRIES);
    while { (*reg).count() } > (0 as usize) {
        match (*reg).at_ptr(0 as usize) {
            option::Option[*LcEntry]::Some(ep) => {
                let cb: fn(*u8) = { (*ep)._detach };
                let ctx: *u8 = { (*ep)._ctx };
                let _g: option::Option[LcEntry] = (*reg).swap_remove(0 as usize);
                cb(ctx);
            }
            option::Option[*LcEntry]::None => { return; }
        }
    }
    return;
}

// Diagnostic: number of live registrations (tests assert the clear paths).
fn lc_entry_count() -> usize {
    let reg: *vec::Vec[LcEntry] = #addr_of(LC_ENTRIES);
    return { (*reg).count() };
}

fn is_attached_impl(cp: *u8) -> bool {
    // A STAGED component's liveness is its attach state — parked reads false,
    // even though its parked root keeps a mounted slot alive.
    let sp: *StageReg = stage_ptr(cp);
    if sp != (0 as *StageReg) { return { (*sp)._attached }; }
    // Otherwise mounted = attached: a run_component root or a mount_component
    // registration that has not been unmounted.
    return ui::has_slot(cp);
}

// facet::Staged.unstage hook: tear the staged component down for good.
fn unstage_impl(s: facet::Staged) -> bool {
    if !s.valid() { return false; }
    let idx: i64 = stage_index(s.cp());
    if idx < (0 as i64) { return false; }
    stage_teardown_at(idx as usize);
    return true;
}

// Relayout every ATTACHED staged component (the window-resize cascade: their
// roots autoresize to fill, but their flex content must be re-laid at the new
// size). Called from the window's resize handler after the root relayout.
fn relayout_attached_staged() {
    let reg: *vec::Vec[StageReg] = #addr_of(STAGED);
    let n: usize = { (*reg).count() };
    var i: usize = 0 as usize;
    while i < n {
        match (*reg).at_ptr(i) {
            option::Option[*StageReg]::Some(ep) => {
                if { (*ep)._attached } { let _r: bool = ui::relayout({ (*ep)._cp }); }
            }
            option::Option[*StageReg]::None => { }
        }
        i = i +% (1 as usize);
    }
    return;
}

// Focus the widget with the given agent id — make it the window's first
// responder. Call AFTER mount (the view must be in the window). Returns success.
fn focus(win_ptr: *u8, agent_id: str) -> bool {
    let content: *u8 = rt::msg_id(win_ptr, rt::sel(#str_ptr("contentView\0")));
    let v: *u8 = find_view_by_id(content, agent_id);
    if v == (0 as *u8) { return false; }
    return rt::msg_i8_id(win_ptr, rt::sel(#str_ptr("makeFirstResponder:\0")), v) != (0 as i8);
}

fn surface_has_id(root: *u8, id: str) -> bool {
    if root == (0 as *u8) { return false; }
    if view_id_is(root, id) { return true; }   // zero-alloc str-view compare (see view_id_is)
    let v: ak::View = ak::View::from_raw(root);
    var subs: vec::Vec[ak::View] = v.subviews();
    let n: usize = subs.count();
    var i: usize = 0 as usize;
    while i < n {
        match subs.at_ptr(i) {
            option::Option[*ak::View]::Some(sp) => {
                if surface_has_id({ (*sp).raw() }, id) { return true; }
            }
            option::Option[*ak::View]::None => { }
        }
        i = i +% (1 as usize);
    }
    return false;
}

#[test]
fn agent_id_pins_identifier_and_survives_rerender() {
    COUNT = 0;
    let content = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 300.0, h: 200.0 });
    remount(tagged_counter_view, content.raw(), 300.0f64, 200.0f64);

    // Fresh mount: both leaves carry their accessibilityIdentifier.
    let l0: *u8 = nth_widget(content.raw(), 0 as usize);
    let b0: *u8 = nth_widget(content.raw(), 1 as usize);
    assert ak::Accessibility::from_raw(l0).accessibility_identifier().view() == "count-label";
    assert ak::Accessibility::from_raw(b0).accessibility_identifier().view() == "inc-btn";

    // A click -> handler -> re-render cycle rebuilds every view. The ops
    // re-apply the tag at mount, so the FRESH button carries it again — the
    // property that keeps an agent surface addressable across re-renders (tags
    // used to die with the replaced views).
    click(b0);
    assert COUNT == 1;
    remount(tagged_counter_view, content.raw(), 300.0f64, 200.0f64);
    let b1: *u8 = nth_widget(content.raw(), 1 as usize);
    assert ak::Accessibility::from_raw(b1).accessibility_identifier().view() == "inc-btn";
}

#[test]
fn untagged_nodes_get_no_identifier() {
    COUNT = 0;
    let content = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 300.0, h: 200.0 });
    remount(counter_view, content.raw(), 300.0f64, 200.0f64);
    // counter_view never tags; the identifier read must come back empty
    // (nil or "" both count — messages to nil return zero).
    let l0: *u8 = nth_widget(content.raw(), 0 as usize);
    assert ak::Accessibility::from_raw(l0).accessibility_identifier().count() == (0 as usize);
}

#[test]
fn set_identity_records_affordance_metadata() {
    // Phase 2: mount always pins (role, drive) on the identity handle so the
    // agent surface can stop re-classifying by native type. Labels are Text /
    // drive none; buttons are Button / drive click. Untagged nodes still get
    // the declaration (exposure still requires an agent id).
    COUNT = 0;
    let content = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 300.0, h: 200.0 });
    remount(tagged_counter_view, content.raw(), 300.0f64, 200.0f64);

    let l0: *u8 = nth_widget(content.raw(), 0 as usize);
    let b0: *u8 = nth_widget(content.raw(), 1 as usize);
    let lp: *u8 = rt::get_associated_object(l0, identity::affordance_key());
    let bp: *u8 = rt::get_associated_object(b0, identity::affordance_key());
    assert identity::is_packed_affordance(lp);
    assert identity::is_packed_affordance(bp);
    assert identity::unpack_role(lp) == (identity::role_index(identity::Role::Text) as u32);
    assert identity::unpack_drive(lp) == identity::drive_none();
    assert identity::unpack_role(bp) == (identity::role_index(identity::Role::Button) as u32);
    assert identity::unpack_drive(bp) == identity::drive_click();

    // Survives re-render (set_identity re-runs on every mount).
    click(b0);
    remount(tagged_counter_view, content.raw(), 300.0f64, 200.0f64);
    let b1: *u8 = nth_widget(content.raw(), 1 as usize);
    let bp1: *u8 = rt::get_associated_object(b1, identity::affordance_key());
    assert identity::unpack_role(bp1) == (identity::role_index(identity::Role::Button) as u32);
}

// -- a removable list: re-render reflows --------------------------------------

static REMOVED: i64 = 0;

fn list_kept(i: i32) -> bool {
    return (REMOVED & ((1 as i64) << (i as i64))) == (0 as i64);
}

fn list_remove(sender: *u8, ctx: *u8) {
    REMOVED = REMOVED | ((1 as i64) << (ctx as i64));
    return;
}

fn list_view() -> facet::Node {
    return @facet {
        vstack {
            for i in 0..4 {
                if list_kept(i) {
                    button("x").on_click(list_remove, ctx: (i as usize) as *u8)
                }
            }
        }
    };
}

#[test]
fn app_list_reflows_on_remove() {
    REMOVED = 0;
    let content = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 300.0, h: 200.0 });
    remount(list_view, content.raw(), 300.0f64, 200.0f64);

    let content_v: ak::View = ak::View::from_raw(content.raw());
    var subs0: vec::Vec[ak::View] = content_v.subviews();
    match subs0.at_ptr(0 as usize) {
        option::Option[*ak::View]::Some(sv) => {
            assert { (*sv).subviews().count() } == (4 as usize);
        }
        option::Option[*ak::View]::None => { assert false; }
    };

    // Remove row 2: its handler flips the bit; an explicit re-render reflows.
    click(nth_widget(content.raw(), 2 as usize));
    assert list_kept(2) == false;
    remount(list_view, content.raw(), 300.0f64, 200.0f64);

    var subs1: vec::Vec[ak::View] = content_v.subviews();
    match subs1.at_ptr(0 as usize) {
        option::Option[*ak::View]::Some(sv) => {
            assert { (*sv).subviews().count() } == (3 as usize);
        }
        option::Option[*ak::View]::None => { assert false; }
    };
}

// ---- retained relayout, end to end (the iris-chat shape) --------------------
// A component whose @facet tree hosts a portable scroll of wrapping labels —
// header + transcript. ui::relayout at a new host size must keep every view
// (scroll, document, rows) and re-wrap the text to the new width — no re-render,
// no view churn.

struct ScrollPane {
    rows: i64,
}

impl ScrollPane: facet::Component {
    fn build(ref this) -> facet::Node {
        var list: facet::Builder = facet::Builder::new();
        var i: i64 = 0 as i64;
        while i < this.rows {
            list.add(facet::wrap_label("The quick brown fox jumps over the lazy dog while the lazy dog wonders why the fox keeps wrapping to the pane width."));
            i = i + (1 as i64);
        }
        var root: facet::Builder = facet::Builder::new();
        root.add(facet::label("transcript"));
        root.add(facet::scroll(list).grow(1.0f64));
        return facet::column(root);
    }
}

static SCROLL_PANE: ScrollPane = #zero::[ScrollPane]();

// ---- keyed-direct: find(key) + set_text, the non-reactive update path --------
// The update path facet actually uses. Instead of mutating a field and
// re-rendering the component, a handler ADDRESSES the keyed element and edits it
// in place. The proof: the same view survives the update — no re-render mints a
// replacement, and no diff runs to rediscover the change.
struct FindPane { n: i64 }

impl FindPane: facet::Component {
    fn build(ref this) -> facet::Node {
        return @facet {
            vstack {
                label("v0", size: 18.0f64).key("value")
                button("+1").on_click(count_inc).key("inc")
                toggle(on: false, label: "flag").key("flag")
                slider(value: 0.0f64, min: 0.0f64, max: 1.0f64).key("vol")
            }
        };
    }
}

static FIND_PANE: FindPane = #zero::[FindPane]();

#[test]
fn find_set_text_mutates_label_in_place() {
    unmount_all();
    // Register the keyed-direct hooks (install() does this at app startup).
    facet::set_find_fn(find_impl);
    facet::set_set_text_fn(set_text_impl);
    facet::set_set_value_fn(set_value_impl);
    facet::set_get_value_fn(value_impl);
    facet::set_set_on_fn(set_on_impl);
    facet::set_set_hidden_fn(set_hidden_impl);
    FIND_PANE.n = 0 as i64;
    let host = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 300.0, h: 200.0 });
    let _h: f64 = mount_component(FIND_PANE.build, host: host.raw());
    let cp: *u8 = #addr_of(FIND_PANE) as *u8;

    // The keyed label mounted with its initial text and a stable view identity.
    let before: *u8 = find_view_by_id(host.raw(), "value");
    assert before != (0 as *u8);
    assert ak::TextField::from_raw(before).as_control().string_value().equals("v0");

    // Keyed-direct update: resolve "value" in this component and set it in place.
    let hv: facet::Handle = facet::find("value", cp);
    assert hv.found();
    let _chain: facet::Handle = hv.set_text("v42");

    // SAME view, edited — not a rebuilt one. This is the no-re-render guarantee.
    let after: *u8 = find_view_by_id(host.raw(), "value");
    assert after == before;
    assert ak::TextField::from_raw(after).as_control().string_value().equals("v42");

    // A key that resolves to nothing yields a no-op handle (getElementById-null).
    assert !facet::find("nope", cp).found();

    // set_value on a slider — read it back through the control's own getter.
    let _sv: facet::Handle = facet::find("vol", cp).set_value(0.5f64);
    let volv: *u8 = find_view_by_id(host.raw(), "vol");
    assert volv != (0 as *u8);
    assert ak::Control::from_raw(volv).double_value() == 0.5f64;
    // the same number through the portable getter (Handle.value); a miss reads 0.
    assert facet::find("vol", cp).value() == 0.5f64;
    assert facet::find("nope", cp).value() == 0.0f64;

    // set_on flips a toggle in place; the target resolves and the mutator applies
    // (same plumbing as set_value, which the assertion above proves end to end).
    assert facet::find("flag", cp).found();
    let _fo: facet::Handle = facet::find("flag", cp).set_on(true);

    // set_hidden hides a resolved element without touching anything else.
    let _fh: facet::Handle = facet::find("inc", cp).set_hidden(true);
    unmount_all();
}

// Approach A: a KEYED container gets a backing view at mount, so find() can
// address it exactly like a leaf (unkeyed containers stay lazily synthesized).
struct BoxPane { n: i64 }

impl BoxPane: facet::Component {
    fn build(ref this) -> facet::Node {
        return @facet {
            vstack {
                vstack {
                    label("inner", size: 14.0f64).key("inner")
                }.key("panel")
            }
        };
    }
}

static BOX_PANE: BoxPane = #zero::[BoxPane]();

#[test]
fn find_resolves_keyed_container() {
    unmount_all();
    facet::set_find_fn(find_impl);
    let host = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 300.0, h: 200.0 });
    let _h: f64 = mount_component(BOX_PANE.build, host: host.raw());
    let cp: *u8 = #addr_of(BOX_PANE) as *u8;

    // The keyed inner container resolves — proof it carries its id on a real view.
    assert facet::find("panel", cp).found();
    // A leaf inside it still resolves too (no regression).
    assert facet::find("inner", cp).found();
    // Its view really carries the accessibilityIdentifier in the hierarchy.
    assert find_view_by_id(host.raw(), "panel") != (0 as *u8);
    unmount_all();
}

// The run_window slot under an APP-chosen component ctx (the facet::run path):
// the slot is keyed by the app's address and the root reaches the render via
// RUN_ROOT — so find(cp, key) and relayout(cp) work from app code. This is
// exactly what run_window does when the Window supplies component_context();
// only the blocking app.run() is elided.
#[test]
fn run_slot_keyed_by_app_component_ctx_resolves_find() {
    unmount_all();
    facet::set_find_fn(find_impl);
    let content = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 400.0, h: 300.0 });
    var root: facet::Node = @facet {
        vstack {
            label("tab one").key("tabs:tab:1")
        }
    };
    let app_cp: *u8 = 4242 as *u8;   // the app's stable component address
    RUN_ROOT = #addr_of(root);
    let _h: f64 = ui::mount(run_root_render, ctx: app_cp, host: content.raw());
    // The keyed-direct verbs resolve against the app-chosen cp.
    assert facet::find("tabs:tab:1", app_cp).found();
    assert !facet::find("tabs:tab:2", app_cp).found();
    // Resize relayout addresses the same cp (run_window's relayout_cp).
    assert ui::relayout(app_cp);
    RUN_ROOT = 0 as *facet::Node;
    unmount_all();
}

// find(key) with NO cp is GLOBAL — it resolves an element by id across every
// mounted component, the ACI-parity path (an agent addresses the UI the same
// way). The returned Handle carries the OWNING cp, so an in-place mutation
// reflows the right component; the scoped form still resolves the same element.
#[test]
fn global_find_by_id_resolves_without_cp() {
    unmount_all();
    facet::set_find_fn(find_impl);
    let content = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 400.0, h: 300.0 });
    var root: facet::Node = @facet {
        vstack {
            label("hello").key("greet")
        }
    };
    let app_cp: *u8 = 7777 as *u8;
    RUN_ROOT = #addr_of(root);
    let _h: f64 = ui::mount(run_root_render, ctx: app_cp, host: content.raw());
    // cp omitted -> global resolve by id
    assert facet::find("greet").found();
    assert !facet::find("nope").found();
    // mutate in place through the global handle (carries the owning cp)
    let _s: facet::Handle = facet::find("greet").set_text("hi");
    // the scoped form finds the same element
    assert facet::find("greet", app_cp).found();
    RUN_ROOT = 0 as *facet::Node;
    unmount_all();
}

// Default run_window path (no component_ctx): the slot keys on the root's own
// address; RUN_ROOT carries the same pointer, so behavior is unchanged.
#[test]
fn run_slot_defaults_to_root_address_ctx() {
    unmount_all();
    facet::set_find_fn(find_impl);
    let content = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 400.0, h: 300.0 });
    var root: facet::Node = @facet {
        vstack {
            label("hello").key("greet")
        }
    };
    RUN_ROOT = #addr_of(root);
    let _h: f64 = ui::mount(run_root_render, ctx: #addr_of(root) as *u8, host: content.raw());
    assert facet::find("greet", #addr_of(root) as *u8).found();
    assert ui::relayout(#addr_of(root) as *u8);
    RUN_ROOT = 0 as *facet::Node;
    unmount_all();
}

// A keyed container INSIDE a split's hosted pane: its subtree is moved into
// the SPLIT_PANES registry at mount, not kept in the slot tree — find() must
// still resolve its flex node (the hosted fallback) and the structural verbs
// must reflow the PANE. This is iris's editor-tabs shape: splits all the way
// down, tabs grown/shrunk by key.
struct PaneTabs { n: i64 }

impl PaneTabs: facet::Component {
    fn build(ref this) -> facet::Node {
        return @facet {
            vstack {
                split {
                    label("sidebar")
                    vstack {
                        vstack {
                            label("tab-a").key("tabs:tab:a")
                        }.key("tabs")
                        label("under")
                    }
                }.key("the-split")
            }
        };
    }
}

static PANE_TABS: PaneTabs = #zero::[PaneTabs]();

#[test]
fn find_and_structural_verbs_reach_split_pane_content() {
    unmount_all();
    install();   // find + the structural hooks (a run's startup registration)
    let host = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 500.0, h: 400.0 });
    let _h: f64 = mount_component(PANE_TABS.build, host: host.raw());
    let cp: *u8 = #addr_of(PANE_TABS) as *u8;

    // Size the hosted pane by hand (a live NSSplitView does this in a real
    // window; headless it stays 0x0) and reflow it — the resize-hook path.
    let sv_ptr: *u8 = find_view_by_id(host.raw(), "the-split");
    assert sv_ptr != (0 as *u8);
    var arranged: vec::Vec[ak::View] = ak::SplitView::from_raw(sv_ptr).arranged_subviews();
    assert arranged.count() == (2 as usize);
    match arranged.at_ptr(1 as usize) {
        option::Option[*ak::View]::Some(hp) => {
            (*hp).set_frame(rt::Rect { x: 0.0, y: 0.0, w: 280.0, h: 400.0 });
        }
        option::Option[*ak::View]::None => { assert false; }
    };
    ui::relayout_split_panes(sv_ptr);

    // find resolves BOTH halves for the pane-hosted keyed container: the view
    // (NSViews nest through the split) AND the flex node (the SPLIT_PANES
    // fallback — this was 0 before, so every structural verb no-op'd).
    let tabs: facet::Handle = facet::find("tabs", cp);
    assert tabs.found();
    assert tabs.flex() != (0 as *u8);

    // add_child grows the pane-hosted container in place...
    let _c: facet::Handle = tabs.add_child(facet::label("tab-b").key("tabs:tab:b"));
    let added: *u8 = find_view_by_id(host.raw(), "tabs:tab:b");
    assert added != (0 as *u8);
    // ...at a real frame (reflow_owner reflowed the PANE, not the slot tree).
    assert ak::View::from_raw(added).frame().w > 0.0f64;

    // portable divider read: Handle.value() on the split reports the leading
    // pane's trailing edge — the arranged_subviews walk, now backend-free.
    let split_h: facet::Handle = facet::find("the-split", cp);
    assert split_h.found();
    var arr2: vec::Vec[ak::View] = ak::SplitView::from_raw(split_h.view()).arranged_subviews();
    match arr2.at_ptr(0 as usize) {
        option::Option[*ak::View]::Some(p0) => {
            let f0: rt::Rect = { (*p0).frame() };
            assert split_h.value() == f0.x + f0.w;
        }
        option::Option[*ak::View]::None => { assert false; }
    };

    // remove_child shrinks it again.
    assert facet::find("tabs", cp).remove_child("tabs:tab:a");
    assert find_view_by_id(host.raw(), "tabs:tab:a") == (0 as *u8);
    unmount_all();
}

// The iris tab anatomy, minimal: a zstack of two states — off IN-FLOW (sizes
// the item), on ABSOLUTE overlaying it (inset 0). After an add_child + reflow
// the two states must occupy the SAME frame (the on state exactly covers the
// off state); a drift shows both ("double icon/text").
fn t3_tab_state() -> facet::Node {
    var body: facet::Builder = facet::Builder::new();
    body.add(facet::label("main.cplus").font(13.0f64));
    var col: facet::Builder = facet::Builder::new();
    col.add(facet::hstack(body).padding_edge(flex::Edge::Horizontal, 13.0f64).grow(1.0f64));
    col.add(facet::box().height(2.0f64));
    return facet::column(col);
}

fn t3_tab_item() -> facet::Node {
    var z: facet::Builder = facet::Builder::new();
    z.add(t3_tab_state().key("t:off"));
    z.add(t3_tab_state()
        .position_absolute()
        .inset(flex::Edge::All, 0.0f64)
        .key("t:on"));
    var b: facet::Builder = facet::Builder::new();
    b.add(facet::zstack(z).align_items(flex::Align::Stretch));
    return facet::hstack(b).align_items(flex::Align::Stretch).key("t:item");
}

fn t3_frame_of(host: *u8, key: str) -> rt::Rect {
    let v: *u8 = find_view_by_id(host, key);
    assert v != (0 as *u8);
    return ak::View::from_raw(v).frame();
}

#[test]
fn added_zstack_states_overlap_in_split_pane() {
    unmount_all();
    install();
    let host = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 500.0, h: 400.0 });
    let _h: f64 = mount_component(PANE_TABS.build, host: host.raw());
    let cp: *u8 = #addr_of(PANE_TABS) as *u8;
    let sv_ptr: *u8 = find_view_by_id(host.raw(), "the-split");
    var arranged: vec::Vec[ak::View] = ak::SplitView::from_raw(sv_ptr).arranged_subviews();
    match arranged.at_ptr(1 as usize) {
        option::Option[*ak::View]::Some(hp) => {
            (*hp).set_frame(rt::Rect { x: 0.0, y: 0.0, w: 280.0, h: 400.0 });
        }
        option::Option[*ak::View]::None => { assert false; }
    };
    ui::relayout_split_panes(sv_ptr);

    let _c: facet::Handle = facet::find("tabs", cp).add_child(t3_tab_item());
    let off: rt::Rect = t3_frame_of(host.raw(), "t:off");
    let on: rt::Rect = t3_frame_of(host.raw(), "t:on");
    assert off.w > 0.0f64;
    assert off.x == on.x;
    assert off.y == on.y;
    assert off.w == on.w;
    assert off.h == on.h;
    unmount_all();
}

// iris's EXACT tab anatomy (clickable click-surface + icon_button close +
// backgrounds + underline), added live then raised — the real editor-tabs
// open() sequence. The on state must exactly cover the off state.
fn t3x_noop(sender: *u8, ctx: *u8) { return; }

fn t3x_tab_state(active: bool) -> facet::Node {
    let fg: facet::Color = facet::Color::rgba(1.0f64, 1.0f64, 1.0f64, 0.90f64);
    var bg: facet::Color = facet::Color::rgba(0.118f64, 0.118f64, 0.141f64, 1.0f64);
    if active { bg = facet::Color::rgba(0.094f64, 0.094f64, 0.114f64, 1.0f64); }
    var body: facet::Builder = facet::Builder::new();
    body.add(facet::symbol("doc", 13.0f64).foreground_color(fg));
    body.add(facet::label("main.cplus").font(13.0f64).foreground_color(fg));
    var cb: facet::Builder = facet::Builder::new();
    cb.add(facet::hstack(body).align_items(flex::Align::Center).gap(9.0f64));
    let click_area: facet::Node = facet::clickable(cb)
        .on_click(t3x_noop)
        .align_items(flex::Align::Center)
        .justify_content(flex::Justify::Center);
    var row: facet::Builder = facet::Builder::new();
    row.add(click_area);
    row.add(facet::icon_button("xmark")
        .plain()
        .on_click(t3x_noop)
        .font(9.0f64)
        .frame(18.0f64, 18.0f64));
    var col: facet::Builder = facet::Builder::new();
    col.add(facet::hstack(row).align_items(flex::Align::Center).gap(9.0f64)
        .padding_edge(flex::Edge::Horizontal, 13.0f64)
        .grow(1.0f64));
    col.add(facet::box().height(2.0f64).background(fg));
    return facet::column(col).background(bg).align_items(flex::Align::Stretch);
}

fn t3x_tab_item() -> facet::Node {
    var z: facet::Builder = facet::Builder::new();
    // The stack is stretched to the 40pt strip row, so the in-flow off state
    // needs .grow(1) to keep filling it (see facet::zstack's contract) — the
    // missing grow showed BOTH states ("double icon/text", iris 2026-07-15).
    z.add(t3x_tab_state(false).grow(1.0f64).key("tt:off"));
    z.add(t3x_tab_state(true)
        .position_absolute()
        .inset(flex::Edge::All, 0.0f64)
        .key("tt:on"));
    var b: facet::Builder = facet::Builder::new();
    b.add(facet::zstack(z).align_items(flex::Align::Stretch));
    b.add(facet::box().width(1.0f64).background(facet::Color::rgba(1.0f64, 1.0f64, 1.0f64, 0.06f64)));
    return facet::hstack(b).align_items(flex::Align::Stretch).key("tt:item");
}

// The strip shape from EditorTabs::build: empty keyed tabs box + spacer on a
// 40pt row, inside a split's container pane.
struct PaneTabs2 { n: i64 }

impl PaneTabs2: facet::Component {
    fn build(ref this) -> facet::Node {
        var tb: facet::Builder = facet::Builder::new();
        let tabs_box: facet::Node = facet::hstack(tb)
            .align_items(flex::Align::Stretch)
            .gap(0.0f64)
            .key("tabs2");
        var row: facet::Builder = facet::Builder::new();
        row.add(tabs_box);
        row.add(facet::spacer());
        let strip: facet::Node = facet::hstack(row)
            .align_items(flex::Align::Stretch)
            .height(40.0f64);
        var pane: facet::Builder = facet::Builder::new();
        pane.add(strip);
        pane.add(facet::box().grow(1.0f64));
        var sb: facet::Builder = facet::Builder::new();
        sb.add(facet::label("side"));
        sb.add(facet::column(pane).grow(1.0f64));
        var b: facet::Builder = facet::Builder::new();
        b.add(facet::split(sb).key("the-split2"));
        return facet::vstack(b);
    }
}

static PANE_TABS2: PaneTabs2 = #zero::[PaneTabs2]();

#[test]
fn iris_tab_anatomy_states_overlap_after_add_and_raise() {
    unmount_all();
    install();
    let win = e2e_window(500.0f64, 400.0f64);
    let content = e2e_content(win);
    let _h: f64 = mount_component(PANE_TABS2.build, host: content.raw());
    let cp: *u8 = #addr_of(PANE_TABS2) as *u8;
    let sv_ptr: *u8 = find_view_by_id(content.raw(), "the-split2");
    assert sv_ptr != (0 as *u8);
    var arranged: vec::Vec[ak::View] = ak::SplitView::from_raw(sv_ptr).arranged_subviews();
    match arranged.at_ptr(1 as usize) {
        option::Option[*ak::View]::Some(hp) => {
            (*hp).set_frame(rt::Rect { x: 0.0, y: 0.0, w: 300.0, h: 400.0 });
        }
        option::Option[*ak::View]::None => { assert false; }
    };
    ui::relayout_split_panes(sv_ptr);

    // iris's open(): add the tab, then raise the on state from the strip view.
    let strip: facet::Handle = facet::find("tabs2", cp);
    assert strip.found();
    let _c: facet::Handle = strip.add_child(t3x_tab_item());
    facet::raise(strip.view(), "tt:on");

    let off: rt::Rect = t3_frame_of(content.raw(), "tt:off");
    let on: rt::Rect = t3_frame_of(content.raw(), "tt:on");
    assert off.w > 0.0f64;
    assert off.x == on.x;
    assert off.y == on.y;
    assert off.w == on.w;
    assert off.h == on.h;
    unmount_all();
}

// The same fallback, scroll-flavored: a keyed container inside a portable
// `scroll { }` lives in the SCROLL_CONTENT registry; edits reflow the rows at
// the viewport width and resize the document.
struct ScrollRows { n: i64 }

impl ScrollRows: facet::Component {
    fn build(ref this) -> facet::Node {
        return @facet {
            vstack {
                scroll {
                    vstack {
                        label("row-a").key("rows:a")
                    }.key("rows")
                }
                .frame(300.0f64, 200.0f64)
            }
        };
    }
}

static SCROLL_ROWS: ScrollRows = #zero::[ScrollRows]();

#[test]
fn find_and_structural_verbs_reach_scroll_hosted_content() {
    unmount_all();
    install();   // find + the structural hooks
    let host = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 400.0, h: 300.0 });
    let _h: f64 = mount_component(SCROLL_ROWS.build, host: host.raw());
    let cp: *u8 = #addr_of(SCROLL_ROWS) as *u8;

    let rows: facet::Handle = facet::find("rows", cp);
    assert rows.found();
    assert rows.flex() != (0 as *u8);          // SCROLL_CONTENT fallback

    let _c: facet::Handle = rows.add_child(facet::label("row-b").key("rows:b"));
    assert find_view_by_id(host.raw(), "rows:b") != (0 as *u8);
    assert facet::find("rows", cp).remove_child("rows:a");
    assert find_view_by_id(host.raw(), "rows:a") == (0 as *u8);
    unmount_all();
}

// Gap 2 regression: a structural verb that mounts a subtree containing a
// `scroll{}` must DRAIN the deferred post-apply queue at its tail. Mounting a
// scroll enqueues a ScrollJob (its content is sized once its frame is real); if
// the verb doesn't drain, the job lingers in SCROLL_JOBS and the scroll's content
// stays unsized until a later resize / post-render. Falsifiable: without the
// drain, SCROLL_JOBS.count() is non-zero right after add_child returns.
#[test]
fn add_child_of_a_scroll_subtree_drains_post_apply() {
    unmount_all();
    install();
    drain_post_apply();                            // start from a clean queue
    let host = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 400.0, h: 300.0 });
    let _h: f64 = mount_component(LIST_PANE.build, host: host.raw());
    let cp: *u8 = #addr_of(LIST_PANE) as *u8;
    drain_post_apply();                            // clear anything the mount queued
    assert SCROLL_JOBS.count() == (0 as usize);    // nothing pending before the add

    // add_child a subtree that CONTAINS a scroll{} — mounting it enqueues a ScrollJob
    var inner: facet::Builder = facet::Builder::new();
    inner.add(facet::label("x").key("panel:x"));
    var sc: facet::Builder = facet::Builder::new();
    sc.add(facet::column(inner).key("panel:rows"));
    let child: facet::Node = facet::scroll(sc).frame(200.0f64, 150.0f64).key("panel");
    let _c: facet::Handle = facet::find("list", cp).add_child(child);

    // the verb drained the queue at its tail: the scroll was filled, none pending.
    assert find_view_by_id(host.raw(), "panel") != (0 as *u8);
    assert SCROLL_JOBS.count() == (0 as usize);
    unmount_all();
}

// ---- appearance, adaptive tokens, drop payload (portable read hooks) --------

#[test]
fn adaptive_color_tokens_map_to_real_nscolors() {
    assert ns_color(facet::Color::tertiary()).raw() != (0 as *u8);
    assert ns_color(facet::Color::separator()).raw() != (0 as *u8);
    assert ns_color(facet::Color::window_background()).raw() != (0 as *u8);
    assert ns_color(facet::Color::under_page_background()).raw() != (0 as *u8);
    assert ns_color(facet::Color::control_background()).raw() != (0 as *u8);
    assert ns_color(facet::Color::fill()).raw() != (0 as *u8);
}

#[test]
fn appearance_is_dark_matches_the_named_pair() {
    match ak::Appearance::appearance_named("NSAppearanceNameDarkAqua") {
        option::Option[ak::Appearance]::Some(dark) => { assert appearance_is_dark(dark); }
        option::Option[ak::Appearance]::None => { assert false; }
    };
    match ak::Appearance::appearance_named("NSAppearanceNameAqua") {
        option::Option[ak::Appearance]::Some(light) => { assert appearance_is_dark(light) == false; }
        option::Option[ak::Appearance]::None => { assert false; }
    };
    // The installed hook reads the app-wide appearance — whichever it is, the
    // facade and the impl agree.
    install();
    assert facet::is_dark() == is_dark_impl();
}

static T_APPEAR_FIRED: i64 = 0;

fn t_appear_probe(ctx: *u8) {
    T_APPEAR_FIRED = T_APPEAR_FIRED + (1 as i64);
    return;
}

#[test]
fn appearance_observer_forwards_real_flips_only() {
    // The sentinel run_window plants: its viewDidChangeEffectiveAppearance
    // override forwards to facet::notify_appearance_changed -> the app's
    // registered handler — but ONLY on a real appearance change (AppKit also
    // calls the override when the view joins the hierarchy; that resolution
    // must stay quiet). Flip the sentinel's own appearance override to drive
    // a genuine change without touching the system theme.
    T_APPEAR_FIRED = 0;
    facet::on_appearance_change(t_appear_probe);
    let host = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 100.0, h: 100.0 });
    akx::add_appearance_observer(host, fire_appearance_change, 0 as *u8);
    var subs: vec::Vec[ak::View] = host.subviews();
    assert subs.count() == (1 as usize);
    assert T_APPEAR_FIRED == (0 as i64);   // attach-time resolution: no forward
    var other: str = "NSAppearanceNameDarkAqua";
    if is_dark_impl() { other = "NSAppearanceNameAqua"; }
    match subs.at_ptr(0 as usize) {
        option::Option[*ak::View]::Some(sp) => {
            let sentinel: *u8 = { (*sp).raw() };
            match ak::Appearance::appearance_named(other) {
                option::Option[ak::Appearance]::Some(ap) => {
                    rt::msg_void_id(sentinel, rt::sel(#str_ptr("setAppearance:\0")), ap.raw());
                }
                option::Option[ak::Appearance]::None => { assert false; }
            };
            // AppKit delivers the override on the change; call it too — the
            // change detector forwards exactly once per name move either way.
            rt::msg_void(sentinel, rt::sel(#str_ptr("viewDidChangeEffectiveAppearance\0")));
            assert T_APPEAR_FIRED == (1 as i64);   // the flip forwarded once
            rt::msg_void(sentinel, rt::sel(#str_ptr("viewDidChangeEffectiveAppearance\0")));
            assert T_APPEAR_FIRED == (1 as i64);   // no change: suppressed
        }
        option::Option[*ak::View]::None => { assert false; }
    };
    facet::on_appearance_change(0 as fn(*u8));   // restore
}

#[test]
fn facet_dropped_text_reads_the_drop_zone_payload() {
    install();
    // Nothing dropped yet: empty through the portable facade.
    let content = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 160.0, h: 120.0 });
    var root: facet::Node = @facet {
        vstack {
            box().frame(140.0f64, 90.0f64).on_drop(t3x_noop).agent_id("zone2")
        }
    };
    let _h: f64 = mount_into(#addr_of(root), content.raw(), 160.0f64, 120.0f64);
    let vp: *u8 = find_view_by_id(content.raw(), "zone2");
    assert vp != (0 as *u8);
    assert facet::dropped_text(vp).count() == (0 as usize);
    // A performed drop pins the payload on the zone view (what the backend's
    // perform imp does); the facade reads it back.
    akx::set_drop_text(vp, "card:42");
    assert facet::dropped_text(vp).equals("card:42");
}

// ---- sender normalization + key readback (facet::key_of) --------------------

#[test]
fn sender_view_normalizes_recognizer_to_its_view() {
    // A control/view sender passes through unchanged.
    let v = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 40.0, h: 20.0 });
    assert sender_view(v.raw()) == v.raw();
    // A gesture recognizer normalizes to the view it is attached to.
    let g: ak::ClickGestureRecognizer = ak::ClickGestureRecognizer::new();
    v.add_gesture_recognizer(g.as_gesture_recognizer());
    assert sender_view(g.raw()) == v.raw();
    // The null sender stays null (raise/key_of then no-op).
    assert sender_view(0 as *u8) == (0 as *u8);
}

#[test]
fn key_of_reads_sender_key_and_walks_superviews() {
    let row = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 200.0, h: 32.0 });
    ui::tag_agent(row.raw(), "tabs:tab:42", identity::Role::Button);
    let inner = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 16.0, h: 16.0 });
    row.add_subview(ak::View::from_raw(inner.raw()));   // untagged child
    // Direct hit on the tagged view.
    assert key_of_impl(row.raw()).equals("tabs:tab:42");
    // An untagged inner view walks up to the first tagged ancestor.
    assert key_of_impl(inner.raw()).equals("tabs:tab:42");
    // A recognizer sender (a clickable's handler) normalizes to its view first.
    let g: ak::ClickGestureRecognizer = ak::ClickGestureRecognizer::new();
    inner.add_gesture_recognizer(g.as_gesture_recognizer());
    assert key_of_impl(g.raw()).equals("tabs:tab:42");
    // Nothing tagged up the chain: an owned empty Text, never a trap.
    let lone = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 10.0, h: 10.0 });
    assert key_of_impl(lone.raw()).count() == (0 as usize);
    // And through the facade with the backend installed.
    facet::set_key_of_fn(key_of_impl);
    assert facet::key_of(g.raw()).equals("tabs:tab:42");
}

#[test]
fn e2e_raise_from_recognizer_sender_reorders_keyed_view() {
    // A clickable container's handler raises by its recognizer sender: the
    // normalize step resolves the recognizer to its view, then walks to the
    // window. (Before normalization this msgSend-ed `window` on the recognizer
    // — unrecognized selector.)
    let win = e2e_window(300.0f64, 200.0f64);
    let content = e2e_content(win);
    let pane_a = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 300.0, h: 200.0 });
    ui::tag_agent(pane_a.raw(), "pane-a", identity::Role::Group);
    let pane_b = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 300.0, h: 200.0 });
    ui::tag_agent(pane_b.raw(), "pane-b", identity::Role::Group);
    content.add_subview(ak::View::from_raw(pane_a.raw()));
    content.add_subview(ak::View::from_raw(pane_b.raw()));   // b in front
    let g: ak::ClickGestureRecognizer = ak::ClickGestureRecognizer::new();
    content.add_gesture_recognizer(g.as_gesture_recognizer());

    raise(g.raw(), "pane-a");

    // pane-a re-added last: frontmost among its siblings now.
    var subs: vec::Vec[ak::View] = content.subviews();
    assert subs.count() == (2 as usize);
    match subs.at_ptr(1 as usize) {
        option::Option[*ak::View]::Some(vp) => { assert { (*vp).raw() } == pane_a.raw(); }
        option::Option[*ak::View]::None => { assert false; }
    };
    return;
}

// Structural keyed-direct: add_child / remove_child on a keyed multi-child
// container, addressed by key — no re-render, no reconcile.
struct ListPane { n: i64 }

impl ListPane: facet::Component {
    fn build(ref this) -> facet::Node {
        return @facet {
            vstack {
                vstack {
                    label("row-a", size: 12.0f64).key("a")
                    label("row-b", size: 12.0f64).key("b")
                }.key("list")
            }
        };
    }
}

static LIST_PANE: ListPane = #zero::[ListPane]();

#[test]
fn find_add_and_remove_child() {
    unmount_all();
    facet::set_find_fn(find_impl);
    facet::set_add_child_fn(add_child_impl);
    facet::set_remove_child_fn(remove_child_impl);
    let host = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 300.0, h: 200.0 });
    let _h: f64 = mount_component(LIST_PANE.build, host: host.raw());
    let cp: *u8 = #addr_of(LIST_PANE) as *u8;

    // The keyed "list" container is addressable and hosts its 2 rows directly.
    let list_v: *u8 = find_view_by_id(host.raw(), "list");
    assert list_v != (0 as *u8);
    assert ak::View::from_raw(list_v).subviews().count() == (2 as usize);

    // add_child: append a keyed row in place -> 3 rows, the new one findable.
    let _a: facet::Handle = facet::find("list", cp).add_child(facet::label("row-c", size: 12.0f64).key("c"));
    assert ak::View::from_raw(list_v).subviews().count() == (3 as usize);
    assert facet::find("c", cp).found();

    // remove_child: drop "a" in place -> 2 rows; b and c survive (order kept).
    assert facet::find("list", cp).remove_child("a");
    assert ak::View::from_raw(list_v).subviews().count() == (2 as usize);
    assert !facet::find("a", cp).found();
    assert facet::find("b", cp).found();
    assert facet::find("c", cp).found();

    // Removing a key that is not a direct child returns false.
    assert facet::find("list", cp).remove_child("zzz") == false;
    unmount_all();
}

#[test]
fn pull_down_keeps_a_row_matching_its_title() {
    // NSPopUpButton's addItemWithTitle: REMOVES a same-titled existing item — a
    // pull-down switcher titled with its current choice ("Default (recommended)")
    // was eating that row and shifting every later index, so selecting row N
    // landed on N-1 (live bug in the iris model switcher). Items now go through
    // the menu (no dedup): title + all rows survive, and indexOfSelectedItem is
    // the full-menu index (title = 0, rows from 1) the idx-1 mapping expects.
    var rows: vec::Vec[text::Text] = vec::new::[text::Text]();
    rows.append(text::from_str("Default (recommended)"));
    rows.append(text::from_str("Sonnet"));
    rows.append(text::from_str("Haiku"));
    rows.append(text::from_str("claude-fable-5[1m]"));
    var root: facet::Node = @facet {
        vstack {
            menu(title: "Default (recommended)", items: rows).key("m")
        }
    };
    let content = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 300.0, h: 80.0 });
    let _h: f64 = mount_into(#addr_of(root), content.raw(), 300.0f64, 80.0f64);
    let v: *u8 = find_view_by_id(content.raw(), "m");
    assert v != (0 as *u8);
    let p: ak::PopUpButton = ak::PopUpButton::from_raw(v);
    match p.menu() {
        option::Option[ak::Menu]::Some(m) => { assert m.number_of_items() == (5 as i64); }
        option::Option[ak::Menu]::None => { assert false; }
    };
    // Choosing the LAST row ("claude-fable-5[1m]", menu index 4): the index the
    // change handler reads back must be 4 — with the dedup bug it was 3.
    p.select_item_at_index(4 as i64);
    assert p.index_of_selected_item() == (4 as i64);
}

