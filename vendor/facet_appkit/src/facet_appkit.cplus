            }
            .background(facet::Color::secondary())
            .corner_radius(8.0f64)
            .shadow(10.0f64)
            .opacity(0.9f64)
        }
    };
    let h: f64 = mount_into(#addr_of(root), content.raw(), 240.0f64, 160.0f64);
    assert h > 0.0f64;
    assert surface_has_id(content.raw(), "cap");
}

