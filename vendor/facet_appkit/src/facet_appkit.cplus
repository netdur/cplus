#[test]
fn shell_style_mask_adds_full_size_content_only_when_clean() {
    let plain: u64 = shell_style_mask(false);
    let clean: u64 = shell_style_mask(true);
    // Both are a standard titled/closable/resizable/miniaturizable window.
    assert (plain & ak::window_style_mask_titled) != (0 as u64);
    assert (plain & ak::window_style_mask_resizable) != (0 as u64);
    assert (plain & ak::window_style_mask_miniaturizable) != (0 as u64);
    // Full-size-content (content under the titlebar) is only in the clean shell.
    assert (plain & ak::window_style_mask_full_size_content_view) == (0 as u64);
    assert (clean & ak::window_style_mask_full_size_content_view) != (0 as u64);
}

// ---- pinch zoom: browser-style content magnification ------------------------

struct ZoomPane { n: i64 }

impl ZoomPane: facet::Component {
    fn build(ref this) -> facet::Node {
        return @facet {
            vstack {
                wrap_label("The quick brown fox jumps over the lazy dog while the lazy dog wonders why the fox keeps wrapping to the pane width.")
            }
        };
    }
}

static ZOOM_PANE: ZoomPane = #zero::[ZoomPane]();

fn zoom_first_subview(host_ptr: *u8) -> *u8 {
    var subs: vec::Vec[ak::View] = ak::View::from_raw(host_ptr).subviews();
    match subs.at_ptr(0 as usize) {
        option::Option[*ak::View]::Some(vp) => { return { (*vp).raw() }; }
        option::Option[*ak::View]::None => { return 0 as *u8; }
    }
}

#[test]
fn test_pinch_zoom_target_math() {
    // Cumulative magnification: 0 = unchanged, 0.5 = half again.
    assert pinch_zoom_target(1.0f64, 0.0f64, 1.0f64, 4.0f64) == 1.0f64;
    assert pinch_zoom_target(1.0f64, 0.5f64, 1.0f64, 4.0f64) == 1.5f64;
    // Compounds from the base zoom, not from 1.
    assert pinch_zoom_target(2.0f64, 0.5f64, 1.0f64, 4.0f64) == 3.0f64;
    // Clamps both ends of the dev's range.
    assert pinch_zoom_target(2.0f64, 5.0f64, 1.0f64, 3.0f64) == 3.0f64;
    assert pinch_zoom_target(1.0f64, -0.9f64, 1.0f64, 4.0f64) == 1.0f64;
    // A dev-allowed zoom-out range works below 1.
    assert pinch_zoom_target(1.0f64, -0.5f64, 0.25f64, 4.0f64) == 0.5f64;
    // A NaN sample is ignored: the base survives (clamped), never amplified.
    var zero: f64 = 0.0f64;
    assert pinch_zoom_target(2.0f64, zero / zero, 1.0f64, 4.0f64) == 2.0f64;
}

#[test]
fn test_pinch_zoom_origin_math() {
    // The anchor keeps its fraction of the visible span across the scale:
    // anchor 100 at fraction 1/4 of [0..400] stays at 1/4 of the new 200-span.
    assert pinch_zoom_origin(100.0f64, 0.0f64, 400.0f64, 200.0f64) == 50.0f64;
    // And scaling back out inverts it exactly.
    assert pinch_zoom_origin(100.0f64, 50.0f64, 200.0f64, 400.0f64) == 0.0f64;
    // A centered anchor stays centered.
    assert pinch_zoom_origin(200.0f64, 0.0f64, 400.0f64, 200.0f64) == 100.0f64;
    // A degenerate (zero/NaN) old span collapses to the content edge.
    var zero: f64 = 0.0f64;
    assert pinch_zoom_origin(100.0f64, 0.0f64, 0.0f64, 200.0f64) == 0.0f64;
    assert pinch_zoom_origin(100.0f64, 0.0f64, zero / zero, 200.0f64) == 0.0f64;
}

#[test]
fn e2e_pinch_zoom_gesture_and_programmatic() {
    unmount_all();
    let host = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 400.0, h: 300.0 });
    let cp: *u8 = #addr_of(ZOOM_PANE) as *u8;
    let h: f64 = mount_component(ZOOM_PANE.build, host: host.raw());
    assert h > 0.0f64;
    let row: *u8 = zoom_first_subview(host.raw());
    assert row != (0 as *u8);
    let rf1: rt::Rect = ak::View::from_raw(row).frame();
    install_pinch_zoom(host.raw(), min_zoom: 1.0f64, max_zoom: 3.0f64);

    // Programmatic zoom, center-anchored: the bounds become the middle cut
    // of the SAME layout — window frame untouched, content views untouched.
    assert set_pinch_zoom(host.raw(), 2.0f64) == 2.0f64;
    assert pinch_zoom_level(host.raw()) == 2.0f64;
    assert approx(host.bounds().w, 200.0f64);
    assert approx(host.bounds().h, 150.0f64);
    assert approx(host.bounds().x, 100.0f64);   // (400-200)/2 — centered
    assert approx(host.bounds().y, 75.0f64);
    assert approx(host.frame().w, 400.0f64);
    // No reflow: the mounted row kept its exact frame.
    let rf2: rt::Rect = ak::View::from_raw(row).frame();
    assert approx(rf2.w, rf1.w);
    assert approx(rf2.h, rf1.h);

    // Gesture-driven: the recognizer's CUMULATIVE magnification compounds the
    // base (2.0), clamping at the dev's max. A fresh recognizer's state is
    // Possible (not Began) and it has no view, so the anchor falls back to
    // the visible center — which stays centered through the scale.
    let g: ak::MagnificationGestureRecognizer = ak::MagnificationGestureRecognizer::new();
    g.set_magnification(1.0f64);            // ×2 since gesture start
    on_pinch_zoom(g.raw(), host.raw());     // 2.0 × 2 = 4 → clamped to 3
    assert pinch_zoom_level(host.raw()) == 3.0f64;
    assert approx(host.bounds().w, 400.0f64 / 3.0f64);
    assert approx(host.bounds().x, (400.0f64 - (400.0f64 / 3.0f64)) / 2.0f64);

    // Pinching in past the floor clamps at min and restores natural bounds.
    g.set_magnification(-0.9f64);           // 2.0 × 0.1 → floors at 1.0
    on_pinch_zoom(g.raw(), host.raw());
    assert pinch_zoom_level(host.raw()) == 1.0f64;
    assert approx(host.bounds().w, 400.0f64);
    assert approx(host.bounds().h, 300.0f64);
    assert approx(host.bounds().x, 0.0f64);
    assert approx(host.bounds().y, 0.0f64);

    // Re-install on the same host updates the range in place.
    install_pinch_zoom(host.raw(), min_zoom: 1.0f64, max_zoom: 2.0f64);
    assert set_pinch_zoom(host.raw(), 10.0f64) == 2.0f64;

    // A host with no installation: the gesture no-ops, the setter reports 1.
    let other = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 100.0, h: 100.0 });
    on_pinch_zoom(g.raw(), other.raw());
    assert set_pinch_zoom(other.raw(), 2.0f64) == 1.0f64;
    assert pinch_zoom_level(other.raw()) == 1.0f64;
    assert approx(other.bounds().w, 100.0f64);
    unmount_all();
}

#[test]
fn test_pinch_pan_origin_math() {
    // The bounds-space step is delta/zoom, added to the origin.
    assert pinch_pan_origin(100.0f64, 30.0f64, 2.0f64) == 115.0f64;
    assert pinch_pan_origin(100.0f64, -30.0f64, 2.0f64) == 85.0f64;
    assert pinch_pan_origin(100.0f64, 0.0f64, 2.0f64) == 100.0f64;
    // NaN samples and degenerate zooms leave the origin alone.
    var zero: f64 = 0.0f64;
    assert pinch_pan_origin(100.0f64, zero / zero, 2.0f64) == 100.0f64;
    assert pinch_pan_origin(100.0f64, 30.0f64, 0.0f64) == 100.0f64;
    assert pinch_pan_origin(100.0f64, 30.0f64, zero / zero) == 100.0f64;
}

#[test]
fn e2e_pan_while_zoomed_moves_and_clamps() {
    unmount_all();
    let host = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 400.0, h: 300.0 });
    let cp: *u8 = #addr_of(ZOOM_PANE) as *u8;
    let h: f64 = mount_component(ZOOM_PANE.build, host: host.raw());
    assert h > 0.0f64;
    install_pinch_zoom(host.raw(), min_zoom: 1.0f64, max_zoom: 3.0f64);
    // The first install brought the process-wide scroll filter with it.
    assert PAN_FILTER != (0 as *u8);

    // Zoom ×2, center cut: (100, 75) + 200×150 visible.
    assert set_pinch_zoom(host.raw(), 2.0f64) == 2.0f64;
    // Scroll right+down (dx 40, dy -30): the cut moves left in x (deltaX
    // subtracts) and down in y (negative deltaY subtracts) — half the wheel
    // points, since bounds units are scaled.
    assert pan_zoomed_host(host.raw(), 40.0f64, -30.0f64);
    assert approx(host.bounds().x, 80.0f64);
    assert approx(host.bounds().y, 60.0f64);
    assert approx(host.bounds().w, 200.0f64);   // pan never rescales
    assert pinch_zoom_level(host.raw()) == 2.0f64;

    // A huge fling clamps at the content edges — both far…
    assert pan_zoomed_host(host.raw(), -100000.0f64, 100000.0f64);
    assert approx(host.bounds().x, 200.0f64);
    assert approx(host.bounds().y, 150.0f64);
    // …and near.
    assert pan_zoomed_host(host.raw(), 100000.0f64, -100000.0f64);
    assert approx(host.bounds().x, 0.0f64);
    assert approx(host.bounds().y, 0.0f64);

    // NaN deltas are consumed (still a zoomed window) but move nothing.
    var zero: f64 = 0.0f64;
    assert pan_zoomed_host(host.raw(), zero / zero, zero / zero);
    assert approx(host.bounds().x, 0.0f64);
    assert approx(host.bounds().y, 0.0f64);

    // At natural size there is nothing to pan: the event passes through and
    // the coordinate space stays stock — inner scroll views behave normally.
    assert set_pinch_zoom(host.raw(), 1.0f64) == 1.0f64;
    assert pan_zoomed_host(host.raw(), 10.0f64, 10.0f64) == false;
    assert approx(host.bounds().x, 0.0f64);
    assert approx(host.bounds().w, 400.0f64);

    // A view that never installed pinch zoom is never panned.
    let other = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 100.0, h: 100.0 });
    assert pan_zoomed_host(other.raw(), 10.0f64, 10.0f64) == false;
    unmount_all();
}

#[test]
fn test_install_pinch_zoom_heals_degenerate_ranges() {
    unmount_all();
    let host = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 200.0, h: 100.0 });
    // Negative min floors at natural size; a max below min lifts to min —
    // the zoom is locked rather than inverted.
    install_pinch_zoom(host.raw(), min_zoom: -3.0f64, max_zoom: 0.5f64);
    assert set_pinch_zoom(host.raw(), 9.0f64) == 1.0f64;
    assert pinch_zoom_level(host.raw()) == 1.0f64;
    // A null host is refused outright.
    install_pinch_zoom(0 as *u8);
    assert set_pinch_zoom(0 as *u8, 2.0f64) == 1.0f64;
    unmount_all();
}
