static CHIPS_PANE: ChipsPane = #zero::[ChipsPane]();

#[test]
fn empty_keyed_row_accepts_runtime_chips() {
    unmount_all();
    facet::set_find_fn(find_impl);
    facet::set_add_child_fn(add_child_impl);
    facet::set_remove_child_fn(remove_child_impl);
    let host = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 320.0, h: 160.0 });
    let _h: f64 = mount_component(CHIPS_PANE.build, host: host.raw());
    let cp: *u8 = #addr_of(CHIPS_PANE) as *u8;

    // An EMPTY keyed container must still mount an addressable backing view.
    assert facet::find("chips", cp).found();

    // First chip lands, is findable, and removes by its key.
    let _a: facet::Handle = facet::find("chips", cp)
        .add_child(facet::button("notes.txt").plain().key("chip:1"));
    assert facet::find("chip:1", cp).found();
    assert facet::find("chips", cp).remove_child("chip:1");
    assert !facet::find("chip:1", cp).found();
    unmount_all();
}

// ---- keyed-direct structural verbs: insert / replace / set_child + show/hide --
struct VerbPane { n: i64 }

impl VerbPane: facet::Component {
    fn build(ref this) -> facet::Node {
        return @facet {
            vstack {
                vstack {
                    label("a", size: 12.0f64).key("a")
                    label("b", size: 12.0f64).key("b")
                }.key("list")
                button("go", primary: true).key("btn")
            }
        };
    }
}

static VERB_PANE: VerbPane = #zero::[VerbPane]();

fn verb_install() {
    facet::set_find_fn(find_impl);
    facet::set_set_hidden_fn(set_hidden_impl);
    facet::set_add_child_fn(add_child_impl);
    facet::set_remove_child_fn(remove_child_impl);
    facet::set_insert_child_fn(insert_child_impl);
    facet::set_replace_child_fn(replace_child_impl);
    facet::set_set_child_fn(set_child_impl);
    return;
}

// The first flex child of a keyed container carries `key`? (order, not just set
// membership — insert_child splices at an index; subview order differs.)
fn first_child_is(container_flex: *u8, key: str) -> bool {
    if container_flex == (0 as *u8) { return false; }
    let cfp: *flex::Node = container_flex as *flex::Node;
    match (*cfp).children.at_ptr(0 as usize) {
        option::Option[*flex::Node]::Some(c) => { return view_id_is({ (*c).payload() }, key); }
        option::Option[*flex::Node]::None => { return false; }
    }
    return false;
}

#[test]
fn keyed_direct_structural_verbs() {
    unmount_all();
    verb_install();
    let host = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 300.0, h: 200.0 });
    let _h: f64 = mount_component(VERB_PANE.build, host: host.raw());
    let cp: *u8 = #addr_of(VERB_PANE) as *u8;
    let list_v: *u8 = find_view_by_id(host.raw(), "list");
    assert list_v != (0 as *u8);
    assert ak::View::from_raw(list_v).subviews().count() == (2 as usize);   // a, b

    // insert_child at 0: "z" becomes the FIRST child (top) -> 3 rows.
    let _i: facet::Handle = facet::find("list", cp).insert_child(facet::label("z", size: 12.0f64).key("z"), 0 as usize);
    assert ak::View::from_raw(list_v).subviews().count() == (3 as usize);
    assert facet::find("z", cp).found();
    assert first_child_is(facet::find("list", cp).flex(), "z");   // ordered, not appended

    // insert_child past the end appends (clamps).
    let _i2: facet::Handle = facet::find("list", cp).insert_child(facet::label("tail", size: 12.0f64).key("tail"), 99 as usize);
    assert ak::View::from_raw(list_v).subviews().count() == (4 as usize);
    assert facet::find("tail", cp).found();
    assert first_child_is(facet::find("list", cp).flex(), "z");   // still z first

    // replace_child: swap "a" for "a2" at the same position -> count unchanged.
    assert facet::find("list", cp).replace_child("a", facet::label("a2", size: 12.0f64).key("a2"));
    assert ak::View::from_raw(list_v).subviews().count() == (4 as usize);
    assert !facet::find("a", cp).found();
    assert facet::find("a2", cp).found();
    assert facet::find("b", cp).found();
    // replacing a non-child returns false.
    assert facet::find("list", cp).replace_child("nope", facet::label("x").key("x")) == false;

    // set_child: collapse the list to ONE fresh child.
    let _s: facet::Handle = facet::find("list", cp).set_child(facet::label("only", size: 12.0f64).key("only"));
    assert ak::View::from_raw(list_v).subviews().count() == (1 as usize);
    assert facet::find("only", cp).found();
    assert !facet::find("z", cp).found();
    assert !facet::find("a2", cp).found();
    assert !facet::find("b", cp).found();
    assert !facet::find("tail", cp).found();

    // show / hide over set_hidden.
    let btn: *u8 = find_view_by_id(host.raw(), "btn");
    assert btn != (0 as *u8);
    let _hh: facet::Handle = facet::find("btn", cp).hide();
    assert rt::msg_i8(btn, rt::sel(#str_ptr("isHidden\0"))) == (1 as i8);
    let _sh: facet::Handle = facet::find("btn", cp).show();
    assert rt::msg_i8(btn, rt::sel(#str_ptr("isHidden\0"))) == (0 as i8);

    // find_as native hatch: view() IS the native NSButton — full native API.
    let btn_h: facet::Handle = facet::find("btn", cp);
    assert btn_h.view() == btn;
    let native: ak::Button = ak::Button::from_raw(btn_h.view());
    native.set_title("native!");
    let t: text::Text = native.title();
    assert t.view() == "native!";

    // structural verbs on a missing container no-op safely.
    assert facet::find("ghost", cp).remove_child("a") == false;
    let _ng: facet::Handle = facet::find("ghost", cp).insert_child(facet::label("q").key("q"), 0 as usize);
    unmount_all();
}

// ---- component lifecycle: stage / attach / detach (the router / nav pattern) --
// A NavHost with a keyed "outlet"; screens are staged off-canvas and attached one
// at a time. Attaching fires on_attach; detaching PARKS the screen (views kept)
// and fires on_detach; is_attached is the guard a handler checks before touching
// the UI from an async completion.

struct NavHost { n: i64 }

impl NavHost: facet::Component {
    fn build(ref this) -> facet::Node {
        var outlet: facet::Builder = facet::Builder::new();   // empty: attach fills it
        var root: facet::Builder = facet::Builder::new();
        root.add(facet::column(outlet).key("outlet").grow(1.0f64));
        return facet::column(root);
    }
}

static NAV_HOST: NavHost = #zero::[NavHost]();

struct RouteScreen {
    tag: text::Text,
    attaches: i32,
    detaches: i32,
}

impl RouteScreen: facet::Component {
    fn build(ref this) -> facet::Node {
        var b: facet::Builder = facet::Builder::new();
        b.add(facet::label(this.tag.view(), size: 14.0f64).key("title"));
        return facet::column(b);
    }
}

impl RouteScreen: facet::Lifecycle {
    fn on_attach(ref this) { this.attaches = this.attaches +% 1; }
    fn on_detach(ref this) { this.detaches = this.detaches +% 1; }
}

static SCREEN_A: RouteScreen = #zero::[RouteScreen]();
static SCREEN_B: RouteScreen = #zero::[RouteScreen]();

// A free build fn (not a bound reference) so the negative test can call stage_impl
// directly with a 0 ctx — a bound reference always supplies a real address.
fn dummy_screen(cp: *u8) -> facet::Node { return facet::box(); }

fn lifecycle_install() {
    facet::set_find_fn(find_impl);
    facet::set_stage_fn(stage_impl);
    facet::set_attach_fn(attach_impl);
    facet::set_detach_fn(detach_impl);
    facet::set_is_attached_fn(is_attached_impl);
    facet::set_unstage_fn(unstage_impl);
    facet::set_lc_register_fn(lc_register_impl);
    return;
}

#[test]
fn stage_attach_detach_and_reattach_keeps_views() {
    unmount_all();
    lifecycle_install();
    let host = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 300.0, h: 400.0 });
    let _h: f64 = mount_component(NAV_HOST.build, host: host.raw());
    let nav_cp: *u8 = #addr_of(NAV_HOST) as *u8;

    // Stage two screens OFF-CANVAS: built, but not attached, no callback yet.
    SCREEN_A.tag = text::from_str("A"); SCREEN_A.attaches = 0; SCREEN_A.detaches = 0;
    SCREEN_B.tag = text::from_str("B"); SCREEN_B.attaches = 0; SCREEN_B.detaches = 0;
    let a: facet::Staged = facet::stage(SCREEN_A.build, on_attach: SCREEN_A.on_attach, on_detach: SCREEN_A.on_detach);
    let b: facet::Staged = facet::stage(SCREEN_B.build, on_attach: SCREEN_B.on_attach, on_detach: SCREEN_B.on_detach);
    assert a.valid();
    assert b.valid();
    assert !facet::is_attached(a.cp());
    assert SCREEN_A.attaches == 0;

    // The outlet exists and is empty until a screen is routed in.
    let outlet_v: *u8 = find_view_by_id(host.raw(), "outlet");
    assert outlet_v != (0 as *u8);
    assert ak::View::from_raw(outlet_v).subviews().count() == (0 as usize);

    // A screen's own views exist off-canvas (built at stage), addressable off root.
    let a_title0: *u8 = find_view_by_id(a.root(), "title");
    assert a_title0 != (0 as *u8);

    // Route to A: attach fires on_attach; A is live in the outlet.
    assert facet::find("outlet", nav_cp).attach(a);
    assert facet::is_attached(a.cp());
    assert SCREEN_A.attaches == 1;
    assert SCREEN_A.detaches == 0;
    assert ak::View::from_raw(outlet_v).subviews().count() == (1 as usize);

    // Route to B: detach A (PARKED, kept), attach B.
    assert a.detach();
    assert !facet::is_attached(a.cp());
    assert SCREEN_A.detaches == 1;
    assert find_view_by_id(a.root(), "title") == a_title0;   // A's views SURVIVED parking
    assert facet::find("outlet", nav_cp).attach(b);
    assert facet::is_attached(b.cp());
    assert SCREEN_B.attaches == 1;
    assert ak::View::from_raw(outlet_v).subviews().count() == (1 as usize);   // only B now

    // Route BACK to A: detach B, re-attach A — the SAME views, restored.
    assert b.detach();
    assert facet::find("outlet", nav_cp).attach(a);
    assert facet::is_attached(a.cp());
    assert SCREEN_A.attaches == 2;                            // attached twice total
    assert find_view_by_id(a.root(), "title") == a_title0;   // ORIGINAL view, not rebuilt

    // Tear A down for good: registration gone, no longer attached.
    assert a.unstage();
    assert !facet::is_attached(a.cp());
    assert stage_index(a.cp()) < (0 as i64);
    unmount_all();
}

// The async guard: a completion that arrives after the user navigated away must
// NOT touch the UI. is_attached is that check — no framework rule, just a bool.
static GUARD_UPDATED: i32 = 0;

fn guarded_complete(cp: *u8) {
    if !facet::is_attached(cp) { return; }    // parked -> skip the UI update
    GUARD_UPDATED = GUARD_UPDATED + 1;
    let _u: facet::Handle = facet::find("title", cp).set_text("loaded");
    return;
}

#[test]
fn is_attached_guards_async_completion() {
    unmount_all();
    lifecycle_install();
    facet::set_set_text_fn(set_text_impl);
    let host = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 300.0, h: 400.0 });
    let _h: f64 = mount_component(NAV_HOST.build, host: host.raw());
    let nav_cp: *u8 = #addr_of(NAV_HOST) as *u8;

    SCREEN_A.tag = text::from_str("A"); SCREEN_A.attaches = 0; SCREEN_A.detaches = 0;
    GUARD_UPDATED = 0;
    let a: facet::Staged = facet::stage(SCREEN_A.build, on_attach: SCREEN_A.on_attach, on_detach: SCREEN_A.on_detach);

    // Attached: a completion updates the UI in place.
    assert facet::find("outlet", nav_cp).attach(a);
    guarded_complete(a.cp());
    assert GUARD_UPDATED == 1;
    assert ak::TextField::from_raw(find_view_by_id(a.root(), "title")).as_control().string_value().equals("loaded");

    // Navigate away, THEN a slow second completion arrives: it must skip.
    assert a.detach();
    guarded_complete(a.cp());
    assert GUARD_UPDATED == 1;   // unchanged — the guard held
    let _z: bool = a.unstage();
    unmount_all();
}

#[test]
fn stage_lifecycle_negatives() {
    unmount_all();
    lifecycle_install();
    // stage with a 0 ctx is invalid (guard tested via the impl directly, since a
    // bound reference always supplies a real ctx); a none Staged no-ops its verbs.
    assert !stage_impl(dummy_screen, 0 as *u8, facet::lifecycle_noop, 0 as *u8, facet::lifecycle_noop, 0 as *u8).valid();
    assert facet::Staged::none().detach() == false;
    assert facet::Staged::none().is_attached() == false;
    assert facet::Staged::none().unstage() == false;

    let host = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 300.0, h: 400.0 });
    let _h: f64 = mount_component(NAV_HOST.build, host: host.raw());
    let nav_cp: *u8 = #addr_of(NAV_HOST) as *u8;
    SCREEN_A.tag = text::from_str("A");
    let a: facet::Staged = facet::stage(SCREEN_A.build);

    // Attaching to a MISSING key returns false (nothing attached).
    assert facet::find("no-such-outlet", nav_cp).attach(a) == false;
    assert !facet::is_attached(a.cp());
    // Detaching something never attached returns false.
    assert a.detach() == false;
    let _z: bool = a.unstage();
    unmount_all();
}

// present fixtures: each hook appends a digit to LC_ORDER, so the final
// number IS the firing order. A: attach=1, detach=2; B: attach=3, detach=4.
static LC_ORDER: i32 = 0;

struct OrderScreen { base: i32 }

impl OrderScreen: facet::Component {
    fn build(ref this) -> facet::Node { return facet::box().key("order:root"); }
}

impl OrderScreen: facet::Lifecycle {
    fn on_attach(ref this) { LC_ORDER = LC_ORDER * 10 + this.base; }
    fn on_detach(ref this) { LC_ORDER = LC_ORDER * 10 + this.base + 1; }
}

static ORDER_A: OrderScreen = #zero::[OrderScreen]();
static ORDER_B: OrderScreen = #zero::[OrderScreen]();

#[test]
fn present_evicts_through_the_registry_in_order() {
    unmount_all();
    install();
    let host = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 300.0, h: 400.0 });
    let _h: f64 = mount_component(NAV_HOST.build, host: host.raw());
    let nav_cp: *u8 = #addr_of(NAV_HOST) as *u8;

    ORDER_A.base = 1; ORDER_B.base = 3; LC_ORDER = 0;
    let outlet: facet::Handle = facet::find("outlet", nav_cp);
    assert outlet.found();
    let outlet_v: *u8 = find_view_by_id(host.raw(), "outlet");

    // First show: attach only, one registration.
    let _p: facet::Handle = outlet.present(ORDER_A);
    assert LC_ORDER == 1;
    assert lc_entry_count() == (1 as usize);
    assert ak::View::from_raw(outlet_v).subviews().count() == (1 as usize);

    // Re-present: the VERB notices A is there and fires its detach (2) before
    // B mounts and attaches (3) — the app never touched a hook.
    let _p2: facet::Handle = outlet.present(ORDER_B);
    assert LC_ORDER == 123;
    assert lc_entry_count() == (1 as usize);
    assert ak::View::from_raw(outlet_v).subviews().count() == (1 as usize);

    // A PLAIN set_child evicts the presented component the same way (4):
    // eviction notification is the verb's job, whoever calls it.
    let _s: facet::Handle = outlet.set_child(facet::box());
    assert LC_ORDER == 1234;
    assert lc_entry_count() == (0 as usize);
    unmount_all();
    assert lc_entry_count() == (0 as usize);
}

#[test]
fn remove_child_and_unmount_fire_the_registered_detach() {
    unmount_all();
    install();
    let host = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 300.0, h: 400.0 });
    let _h: f64 = mount_component(NAV_HOST.build, host: host.raw());
    let nav_cp: *u8 = #addr_of(NAV_HOST) as *u8;

    ORDER_A.base = 1; LC_ORDER = 0;
    let outlet: facet::Handle = facet::find("outlet", nav_cp);

    // remove_child of the presented root notifies it (2) and clears the entry.
    let _p: facet::Handle = outlet.present(ORDER_A);
    assert facet::find("outlet", nav_cp).remove_child("order:root");
    assert LC_ORDER == 12;
    assert lc_entry_count() == (0 as usize);

    // A registration still live at full teardown is drained by unmount_all
    // (1 then 2 again), views still alive when the hook runs.
    let _p2: facet::Handle = outlet.present(ORDER_A);
    assert lc_entry_count() == (1 as usize);
    unmount_all();
    assert LC_ORDER == 1212;
    assert lc_entry_count() == (0 as usize);
}

#[test]
fn present_fires_nothing_on_a_missing_handle() {
    unmount_all();
    install();
    ORDER_A.base = 1; LC_ORDER = 0;
    // No mounted tree at all: the handle misses, so neither the structural
    // change nor any lifecycle hook may fire, and nothing registers.
    let none: facet::Handle = facet::find("no-such-outlet");
    assert !none.found();
    let _p: facet::Handle = none.present(ORDER_A);
    assert LC_ORDER == 0;
    assert lc_entry_count() == (0 as usize);
    unmount_all();
}

#[test]
fn is_attached_reads_true_for_mounted_components() {
    unmount_all();
    install();
    let host = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 300.0, h: 400.0 });
    let nav_cp: *u8 = #addr_of(NAV_HOST) as *u8;
    assert !facet::is_attached(nav_cp);
    assert !facet::attached(NAV_HOST);   // the ref-place form agrees
    let _h: f64 = mount_component(NAV_HOST.build, host: host.raw());
    assert facet::is_attached(nav_cp);
    assert facet::attached(NAV_HOST);
    let _u: bool = unmount(nav_cp);
    assert !facet::is_attached(nav_cp);
    assert !facet::attached(NAV_HOST);
    unmount_all();
}

// A stable slot key for the open_window test (any nameable address works).
static OPEN_CHECK_CP: i32 = 0;

#[test]
fn open_window_mounts_and_returns_without_blocking() {
    unmount_all();
    install();
    var b: facet::Builder = facet::Builder::new();
    b.add(facet::label("open", size: 12.0f64).key("open_check:title"));
    let cp: *u8 = #addr_of(OPEN_CHECK_CP) as *u8;
    let _w: ak::Window = open_window(facet::column(b), title: "open-check", width: 220.0f64, height: 160.0f64, component_ctx: cp);
    // REACHING here at all is the point: open_window returned instead of
    // blocking in a run loop. The tree is mounted and addressable, and the
    // component slot reads attached — the seam run_component fires on_attach in.
    assert facet::find("open_check:title", cp).found();
    assert facet::is_attached(cp);
    let _u: bool = unmount(cp);
    assert !facet::is_attached(cp);
    unmount_all();
}

// Leak-harness segment for staging: 50 cycles of stage -> attach -> detach ->
// re-attach -> unstage. Exercises the facet-owned root views' retain/release
// balance — StageReg holds +1 on each parked root; unstage (and unmount_all)
// must release it, or the harness `leaks --atExit` grows per cycle.
fn stage_leak_cycles() -> i32 {
    unmount_all();
    lifecycle_install();
    let host = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 300.0, h: 400.0 });
    let _h: f64 = mount_component(NAV_HOST.build, host: host.raw());
    let nav_cp: *u8 = #addr_of(NAV_HOST) as *u8;
    for k in 0..50 {
        SCREEN_A.tag = text::from_str("A");
        let a: facet::Staged = facet::stage(SCREEN_A.build, on_attach: SCREEN_A.on_attach, on_detach: SCREEN_A.on_detach);
        let _at: bool = facet::find("outlet", nav_cp).attach(a);
        let _dt: bool = a.detach();
        let _re: bool = facet::find("outlet", nav_cp).attach(a);
        let _us: bool = a.unstage();
    }
    unmount_all();
    return 0;
}

// Leak-harness segment for the structural verbs: 50 cycles of insert -> replace
// -> set_child on a keyed container. Each verb mounts a child (allocs views);
// replace drops the old, set_child clears all — the alloc/free must balance or
// the harness `leaks` grows per cycle. The list oscillates 1<->2 children.
fn verb_leak_cycles() -> i32 {
    unmount_all();
    verb_install();
    let host = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 300.0, h: 200.0 });
    let _h: f64 = mount_component(VERB_PANE.build, host: host.raw());
    let cp: *u8 = #addr_of(VERB_PANE) as *u8;
    for k in 0..50 {
        let _i: facet::Handle = facet::find("list", cp).insert_child(facet::label("x", size: 12.0f64).key("x"), 0 as usize);
        let _r: bool = facet::find("list", cp).replace_child("x", facet::label("y", size: 12.0f64).key("y"));
        let _s: facet::Handle = facet::find("list", cp).set_child(facet::label("only", size: 12.0f64).key("only"));
    }
    unmount_all();
    return 0;
}

// The ONE update rule: a wired handler addresses its own keyed element and
// edits it in place (facet::find(ctx, key).set_text) — the label and button
// views survive; no re-render, no diff.
struct ReconCounter {
    count: i32,
}

impl ReconCounter: facet::Component {
    fn build(ref this) -> facet::Node {
        let t: text::Text = "count ${this.count}";
        var b: facet::Builder = facet::Builder::new();
        b.add(facet::label(t.view()).key("count"));   // keyed so the handler can address it
        b.add(facet::button("+1").on_click(recon_counter_inc, ctx: #addr_of(RECON_COUNTER) as *u8));
        return facet::column(b);
    }
}

static RECON_COUNTER: ReconCounter = #zero::[ReconCounter]();

// The keyed-direct counter (PIW's reference handler): mutate the field, then push
// the new value to the keyed label. No re-render, no reconcile — the label view
// is edited in place. `ctx` is the component's own address (the wire supplies it).
fn recon_counter_inc(sender: *u8, ctx: *u8) {
    RECON_COUNTER.count = RECON_COUNTER.count + 1;
    let msg: text::Text = "count ${RECON_COUNTER.count}";
    let _u: facet::Handle = facet::find("count", ctx).set_text(msg.view());
    return;
}

#[test]
fn handler_updates_by_key_no_rerender() {
    unmount_all();
    facet::set_find_fn(find_impl);
    facet::set_set_text_fn(set_text_impl);
    let host = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 200.0, h: 80.0 });
    RECON_COUNTER.count = 0;
    let _h: f64 = mount_component(RECON_COUNTER.build, host: host.raw());
    var label0: *u8 = 0 as *u8;
    var button0: *u8 = 0 as *u8;
    var subs: vec::Vec[ak::View] = host.subviews();
    assert subs.count() == (2 as usize);
    match subs.at_ptr(0 as usize) { option::Option[*ak::View]::Some(vp) => { label0 = { (*vp).raw() }; } option::Option[*ak::View]::None => { assert false; } };
    match subs.at_ptr(1 as usize) { option::Option[*ak::View]::Some(vp) => { button0 = { (*vp).raw() }; } option::Option[*ak::View]::None => { assert false; } };
    assert ak::TextField::from_raw(label0).as_control().string_value().equals("count 0");

    // Click: the handler mutates state and pushes it to the keyed label IN PLACE.
    // The same views survive — no rebuild, no reconcile, no diff.
    click(button0);
    assert RECON_COUNTER.count == 1;
    var subs2: vec::Vec[ak::View] = host.subviews();
    assert subs2.count() == (2 as usize);
    match subs2.at_ptr(0 as usize) { option::Option[*ak::View]::Some(vp) => { assert { (*vp).raw() } == label0; } option::Option[*ak::View]::None => { assert false; } };
    match subs2.at_ptr(1 as usize) { option::Option[*ak::View]::Some(vp) => { assert { (*vp).raw() } == button0; } option::Option[*ak::View]::None => { assert false; } };
    assert ak::TextField::from_raw(label0).as_control().string_value().equals("count 1");
    unmount_all();
}

#[test]
fn e2e_component_scroll_relayout_keeps_views_and_rewraps() {
    unmount_all();
    let host = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 300.0, h: 200.0 });
    SCROLL_PANE.rows = 3 as i64;
    let _h: f64 = mount_component(SCROLL_PANE.build, host: host.raw());

    // The applied tree: [ label, scroll ] under the host; the drain filled the
    // scroll's flipped document with the three wrapped rows.
    var subs: vec::Vec[ak::View] = host.subviews();
    assert subs.count() == (2 as usize);
    var scroll_ptr: *u8 = 0 as *u8;
    match subs.at_ptr(1 as usize) {
        option::Option[*ak::View]::Some(vp) => { scroll_ptr = { (*vp).raw() }; }
        option::Option[*ak::View]::None => { assert false; }
    };
    let sv: ak::ScrollView = ak::ScrollView::from_raw(scroll_ptr);
    var doc0: *u8 = 0 as *u8;
    var row0: *u8 = 0 as *u8;
    var h0: f64 = 0.0f64;
    match sv.document_view() {
        option::Option[ak::View]::Some(doc) => {
            doc0 = doc.raw();
            h0 = doc.frame().h;
            var rows: vec::Vec[ak::View] = doc.subviews();
            assert rows.count() == (3 as usize);
            match rows.at_ptr(0 as usize) { option::Option[*ak::View]::Some(rp) => { row0 = { (*rp).raw() }; } option::Option[*ak::View]::None => { assert false; } };
        }
        option::Option[ak::View]::None => { assert false; }
    };
    assert h0 > 0.0f64;

    // Narrow the host and relayout: the SAME scroll, document, and row views
    // survive; the text re-wraps, so the content grows TALLER.
    host.set_frame(rt::Rect { x: 0.0, y: 0.0, w: 180.0, h: 200.0 });
    assert relayout(#addr_of(SCROLL_PANE) as *u8);
    var subs2: vec::Vec[ak::View] = host.subviews();
    assert subs2.count() == (2 as usize);
    match subs2.at_ptr(1 as usize) {
        option::Option[*ak::View]::Some(vp) => { assert { (*vp).raw() } == scroll_ptr; }
        option::Option[*ak::View]::None => { assert false; }
    };
    assert approx(sv.as_view().frame().w, 180.0f64);
    match sv.document_view() {
        option::Option[ak::View]::Some(doc) => {
            assert doc.raw() == doc0;                    // reused, not recreated
            assert approx(doc.frame().w, 180.0f64);
            assert doc.frame().h > h0;                   // narrower ⇒ more lines ⇒ taller
            var rows: vec::Vec[ak::View] = doc.subviews();
            assert rows.count() == (3 as usize);
            match rows.at_ptr(0 as usize) { option::Option[*ak::View]::Some(rp) => { assert { (*rp).raw() } == row0; } option::Option[*ak::View]::None => { assert false; } };
        }
        option::Option[ak::View]::None => { assert false; }
    };

    ui::unmount_all();
}

// ---- Phase 3: facet description → agent surface (AppKit only) ---------------
// Mount a @facet tree into a real window, open an agent Surface, and drive
// the declared identities. This is the closed loop: set_identity records
// role+drive; agent_appkit reads them instead of guessing native types.

static E2E_CLICKS: i32 = 0;

fn e2e_on_click(sender: *u8, ctx: *u8) {
    E2E_CLICKS = E2E_CLICKS + 1;
    return;
}

fn e2e_on_submit(ctx: *u8, tv: *u8) { return; }

fn e2e_window(w: f64, h: f64) -> ak::Window {
    let _app: ak::Application = ak::Application::shared_application();
    let win = ak::Window::new(
        rt::Rect { x: 0.0, y: 0.0, w: w, h: h },
        ak::window_style_mask_titled,
        ak::BackingStoreType::NSBackingStoreBuffered,
        false,
    );
    rt::retain(win.raw());
    let content = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: w, h: h });
    win.set_content_view(ak::View::from_raw(content.raw()));
    return win;
}

fn e2e_content(win: ak::Window) -> ak::View {
    return ak::View::from_raw(rt::msg_id(win.raw(), rt::sel(#str_ptr("contentView\0"))));
}

#[test]
fn e2e_facet_button_is_agent_clickable() {
    E2E_CLICKS = 0;
    let win = e2e_window(360.0f64, 240.0f64);
    let content = e2e_content(win);
    var root: facet::Node = @facet {
        vstack {
            label("hello", secondary: true).agent_id("title")
            button("Go", primary: true).on_click(e2e_on_click).agent_id("go-btn")
        }
    };
    let _h: f64 = mount_into(#addr_of(root), content.raw(), 360.0f64, 240.0f64);

    var s: agent::Surface = agent::open(win.raw());
    // Button: declared role Button + drive_click → click Allowed.
    assert surface::outcome_eq(s.click("go-btn"), surface::Outcome::Allowed);
    assert E2E_CLICKS == 1;
    // Label: declared Text + drive_none → observe-only, click refused.
    assert surface::outcome_eq(s.click("title"), surface::Outcome::NotActionable);
    // set_text on the button refused (drive is click, not text).
    assert surface::outcome_eq(
        s.set_text("go-btn", "x", s.text_version("go-btn")),
        surface::Outcome::NotActionable);
}

#[test]
fn e2e_facet_clickable_row_is_agent_button() {
    E2E_CLICKS = 0;
    let win = e2e_window(360.0f64, 240.0f64);
    let content = e2e_content(win);
    // Fluent `.on_click` after the block (named params + block is not a DSL form;
    // primary click reuses Node.click, which `.on_click` sets).
    var root: facet::Node = @facet {
        vstack {
            clickable {
                label("open row")
            }.on_click(e2e_on_click).agent_id("row")
        }
    };
    let _h: f64 = mount_into(#addr_of(root), content.raw(), 360.0f64, 240.0f64);

    var s: agent::Surface = agent::open(win.raw());
    // Without declared affordance a plain NSView is Group; with set_identity
    // it is Button and performClick: fires the primary handler.
    let nodes: vec::Vec[agent::AppKitNode] = s.describe();
    var found: bool = false;
    var i: usize = 0 as usize;
    while i < nodes.count() {
        match nodes.at_ptr(i) {
            option::Option[*agent::AppKitNode]::Some(n) => {
                if { (*n).id.view() } == "row" {
                    assert identity::role_eq({ (*n).role }, identity::Role::Button);
                    assert { (*n).actionable };
                    found = true;
                }
            }
            option::Option[*agent::AppKitNode]::None => { }
        }
        i = i +% (1 as usize);
    }
    assert found;
    assert surface::outcome_eq(s.click("row"), surface::Outcome::Allowed);
    assert E2E_CLICKS == 1;
}

#[test]
fn facet_path_mounts_all_remaining_kinds() {
    // wrap_label, text_area, bordered, split — facet → adapter.
    let content = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 500.0, h: 400.0 });
    var left_b: facet::Builder = facet::Builder::new();
    left_b.add(facet::label("L"));
    var right_b: facet::Builder = facet::Builder::new();
    right_b.add(facet::label("R"));
    var split_b: facet::Builder = facet::Builder::new();
    split_b.add(facet::text_area(value: "fn main() {}"));
    split_b.add(facet::text_area(value: "notes"));
    var box_b: facet::Builder = facet::Builder::new();
    box_b.add(facet::wrap_label("long wrapping text for the card", secondary: true));
    box_b.add(facet::split(split_b, position: 200.0f64));
    var root_b: facet::Builder = facet::Builder::new();
    root_b.add(facet::bordered(box_b, radius: 8.0f64));
    var root: facet::Node = facet::vstack(root_b);
    let h: f64 = mount_into(#addr_of(root), content.raw(), 500.0f64, 400.0f64);
    assert h > 0.0f64;
    // Content view received at least one subview from apply.
    assert content.subviews().count() > (0 as usize);
}

#[test]
fn e2e_facet_text_area_agent_input() {
    let win = e2e_window(400.0f64, 320.0f64);
    let content = e2e_content(win);
    var root: facet::Node = @facet {
        vstack {
            text_area(value: "ta").agent_id("notes").height(60.0f64)
            text_area(value: "ce").agent_id("src").height(60.0f64)
        }
    };
    let _h: f64 = mount_into(#addr_of(root), content.raw(), 400.0f64, 320.0f64);
    var s: agent::Surface = agent::open(win.raw());
    assert surface::outcome_eq(
        s.set_text("notes", "hello notes", s.text_version("notes")),
        surface::Outcome::Allowed);
    assert surface::outcome_eq(
        s.set_text("src", "fn x() {}", s.text_version("src")),
        surface::Outcome::Allowed);
    assert surface::outcome_eq(s.click("notes"), surface::Outcome::NotActionable);
}

#[test]
fn facet_text_area_honors_style_text_channels() {
    // .monospaced() / .font(size) / .foreground_color reach the INNER text
    // view (the "Phase 3" gap, closed): the font swaps to the monospaced face
    // at the asked size; text color AND the caret follow the foreground.
    let content = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 300.0, h: 200.0 });
    var root: facet::Node = @facet {
        vstack {
            text_area(value: "fn main() {}", editable: true, wrap: false, smart_substitutions: false)
                .monospaced()
                .font(13.0f64)
                .foreground_color(facet::Color::rgba(0.84f64, 0.86f64, 0.90f64, 1.0f64))
                .agent_id("src")
                .height(80.0f64)
        }
    };
    let _h: f64 = mount_into(#addr_of(root), content.raw(), 300.0f64, 200.0f64);
    let tvp: *u8 = find_view_by_id(content.raw(), "src");   // the tagged inner NSTextView
    assert tvp != (0 as *u8);
    let tv: ak::TextView = ak::TextView::from_raw(tvp);
    match tv.as_text().font() {
        option::Option[ak::Font]::Some(f) => {
            assert f.point_size() == (13.0f64);
            // The monospaced face, not the default system font.
            let mono_name: text::Text = ak::Font::monospaced_system_font_of_size(13.0f64, 0.0f64).font_name();
            assert f.font_name().equals(mono_name.view());
        }
        option::Option[ak::Font]::None => { assert false; }
    };
    // Caret follows the foreground: both read back as the same color.
    let caret: ak::Color = tv.insertion_point_color();
    match tv.as_text().text_color() {
        option::Option[ak::Color]::Some(tc) => {
            assert rt::msg_i8_id(caret.raw(), rt::sel(#str_ptr("isEqual:\0")), tc.raw()) != (0 as i8);
        }
        option::Option[ak::Color]::None => { assert false; }
    };
}

#[test]
fn e2e_facet_composer_is_agent_input() {
    let win = e2e_window(360.0f64, 280.0f64);
    let content = e2e_content(win);
    var root: facet::Node = @facet {
        vstack {
            composer(on_submit: e2e_on_submit, value: "draft")
                .agent_id("chat")
                .height(80.0f64)
        }
    };
    let _h: f64 = mount_into(#addr_of(root), content.raw(), 360.0f64, 280.0f64);

    var s: agent::Surface = agent::open(win.raw());
    // Identity is the inner NSTextView (set_identity prefers documentView).
    assert surface::outcome_eq(
        s.set_text("chat", "hello agent", s.text_version("chat")),
        surface::Outcome::Allowed);
    // Drive is text — click refused.
    assert surface::outcome_eq(s.click("chat"), surface::Outcome::NotActionable);

    // Read back through the agent-visible node text.
    let nodes: vec::Vec[agent::AppKitNode] = s.describe();
    var ok: bool = false;
    var i: usize = 0 as usize;
    while i < nodes.count() {
        match nodes.at_ptr(i) {
            option::Option[*agent::AppKitNode]::Some(n) => {
                if { (*n).id.view() } == "chat" {
                    assert identity::role_eq({ (*n).role }, identity::Role::Input);
                    assert { (*n).text.view() } == "hello agent";
                    ok = true;
                }
            }
            option::Option[*agent::AppKitNode]::None => { }
        }
        i = i +% (1 as usize);
    }
    assert ok;
}

#[test]
fn plain_popup_mounts_borderless() {
    // `.plain()` folds onto popup/menu the way it does onto button: the mounted
    // NSPopUpButton drops its bezel (a quiet, text-like dropdown). An unstyled
    // popup keeps the default bordered look.
    let content = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 300.0, h: 120.0 });
    var items: vec::Vec[text::Text] = vec::new::[text::Text]();
    items.append(text::from_str("One"));
    items.append(text::from_str("Two"));
    var quiet_items: vec::Vec[text::Text] = vec::new::[text::Text]();
    quiet_items.append(text::from_str("One"));
    quiet_items.append(text::from_str("Two"));
    var root: facet::Node = @facet {
        vstack {
            menu(title: "Model", items: quiet_items).plain().key("quiet")
            popup(items).key("stock")
        }
    };
    let _h: f64 = mount_into(#addr_of(root), content.raw(), 300.0f64, 120.0f64);
    let quiet: *u8 = find_view_by_id(content.raw(), "quiet");
    assert quiet != (0 as *u8);
    assert ak::Button::from_raw(quiet).is_bordered() == false;
    let stock: *u8 = find_view_by_id(content.raw(), "stock");
    assert stock != (0 as *u8);
    assert ak::Button::from_raw(stock).is_bordered();
}

#[test]
fn styled_facet_widgets_mount_through_apply_style() {
    // A styled @facet tree drives the full pipeline: description → mount →
    // apply_style → NSViews. (Visual correctness is a facet-local example, run
    // by eye; here we prove the styled path builds views without tripping.)
    let content = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 300.0, h: 200.0 });
    var root: facet::Node = @facet {
        vstack {
            label("hello").foreground_color(facet::Color::secondary())
            button("Go", primary: true)
                .background(facet::Color::rgba(0.2f64, 0.4f64, 0.9f64, 1.0f64))
                .corner_radius(8.0f64)
        }
    };
    let h: f64 = mount_into(#addr_of(root), content.raw(), 300.0f64, 200.0f64);
    assert h > 0.0f64;
    assert content.subviews().count() > (0 as usize);
}

// Phase 1 gate — the facet-local styled card. Every one of the modifiers the
// SwiftUI-shaped surface exposes (.font/.strong/.foreground_color/.background/
// .corner_radius/.border/.frame + .monospaced on the text area) drives
// apply_style across label, wrap_label, button, text_area, bordered, and split — the
// spread that proves "every op honors Style", not just label/button. This is
// the example a human renders by eye; the assertions prove it mounts clean.
fn phase1_styled_card() -> facet::Node {
    return @facet {
        card {
            label("Facet").font(28.0f64).strong().foreground_color(facet::Color::primary())
            wrap_label("styled through the portable Style model", secondary: true)
                .foreground_color(facet::Color::secondary())
            bordered {
                vstack {
                    label("boxed").foreground_color(facet::Color::accent())
                    text_area(value: "fn main() {}", editable: false).monospaced()
                }
            }
            .background(facet::Color::rgba(0.12f64, 0.12f64, 0.14f64, 1.0f64))
            .corner_radius(10.0f64)
            hstack {
                button("Primary", primary: true)
                    .background(facet::Color::accent())
                    .corner_radius(8.0f64)
                    .frame(120.0f64, 32.0f64)
                button("Danger")
                    .foreground_color(facet::Color::system_red())
                    .border(1.0f64, facet::Color::system_red())
            }
        }
        .padding(24.0f64)
    };
}

#[test]
fn phase1_styled_card_mounts_every_styled_kind() {
    let content = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 420.0, h: 340.0 });
    var root: facet::Node = phase1_styled_card();
    let h: f64 = mount_into(#addr_of(root), content.raw(), 420.0f64, 340.0f64);
    assert h > 0.0f64;
    // card → 4 children (label, wrap_label, bordered, hstack) mounted under one
    // synthesized card view.
    let subs = content.subviews();
    assert subs.count() == (1 as usize);
    match subs.at_ptr(0 as usize) {
        option::Option[*ak::View]::Some(cardv) => {
            assert { (*cardv).subviews().count() } == (4 as usize);
        }
        option::Option[*ak::View]::None => { assert false; }
    };
}

// Phase 2 gate — the promoted Tier-2 leaves render through the portable model,
// and their values read back. This is the coverage that lets a real app drop
// its AppKit-only widget calls: image / symbol / text_field / popup / divider,
// plus the button folds (.plain(), and icon-button = clickable { symbol }).
fn ak_submit_noop(ctx: *u8, tv: *u8) { return; }
fn ak_open_noop(sender: *u8, ctx: *u8) { return; }

fn phase2_leaves_view() -> facet::Node {
    var items: vec::Vec[text::Text] = vec::new::[text::Text]();
    items.append(text::from_str("Swift"));
    items.append(text::from_str("C+"));
    items.append(text::from_str("Rust"));
    return @facet {
        vstack {
            symbol("folder", size: 18.0f64).agent_id("icon")
            text_field(placeholder: "project name", value: "iris").agent_id("name")
            popup(items, selected: 1 as i64).agent_id("lang")
            divider()
            clickable {
                symbol("gearshape")
            }.on_click(ak_open_noop).agent_id("settings")
            button("Docs").plain().foreground_color(facet::Color::accent()).agent_id("docs")
        }
    };
}

#[test]
fn phase2_tier2_leaves_mount_and_read_back() {
    let win = e2e_window(360.0f64, 400.0f64);
    let content = e2e_content(win);
    var root: facet::Node = phase2_leaves_view();
    let h: f64 = mount_into(#addr_of(root), content.raw(), 360.0f64, 400.0f64);
    assert h > 0.0f64;

    // Every promoted leaf reached the surface with its agent id.
    assert surface_has_id(content.raw(), "icon");
    assert surface_has_id(content.raw(), "name");
    assert surface_has_id(content.raw(), "lang");
    assert surface_has_id(content.raw(), "settings");
    assert surface_has_id(content.raw(), "docs");

    // Read-back through the facet layer: the popup keeps its initial selection,
    // and the text_field its value.
    var s: agent::Surface = agent::open(win.raw());
    // text_field is agent-drivable (role_input → drive_text).
    assert surface::outcome_eq(
        s.set_text("name", "renamed", s.text_version("name")),
        surface::Outcome::Allowed);
}

#[test]
fn phase2_popup_index_reads_selection() {
    // Direct read-back path: mount a popup, pull its index via the facet layer.
    let content = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 200.0, h: 40.0 });
    var items: vec::Vec[text::Text] = vec::new::[text::Text]();
    items.append(text::from_str("A"));
    items.append(text::from_str("B"));
    items.append(text::from_str("C"));
    var pu: facet::Node = facet::popup(items, selected: 2 as i64);
    let n: flex::Node = ak_popup(0 as *u8, #addr_of(pu));
    assert popup_index(n.payload()) == (2 as i64);
}

// Phase 3 gate — the native escape hatch. A raw view and a real structured
// widget (an NSOutlineView tree, built by ui::) both flow through `native(...)`
// into a portable `@facet` tree, and survive a component re-render.

#[test]
fn phase3_native_hatch_mounts_raw_view() {
    let content = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 240.0, h: 160.0 });
    // A view facet doesn't abstract — the app builds it, the hatch carries it.
    let custom = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 100.0, h: 60.0 });
    var root: facet::Node = @facet {
        vstack {
            label("native below")
            native(custom).frame(100.0f64, 60.0f64).agent_id("custom")
        }
    };
    let h: f64 = mount_into(#addr_of(root), content.raw(), 240.0f64, 160.0f64);
    assert h > 0.0f64;
    // The opaque view reached the surface with its agent id (set_identity fires
    // on the hatch payload like any other widget).
    assert surface_has_id(content.raw(), "custom");
}

#[test]
fn phase3_tree_through_native_hatch() {
    let content = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 300.0, h: 400.0 });
    // Build a structured widget with the existing ui:: tree, then deliver it
    // through the hatch — the plan's "list/tree via native(...)" path.
    let root_node: *ui::TreeNode = ui::tree_node("Project", "/proj", true);
    ui::tree_add_child(root_node, ui::tree_node("main.cplus", "/proj/main.cplus", false));
    ui::tree_add_child(root_node, ui::tree_node("README.md", "/proj/README.md", false));
    var t: flex::Node = ui::tree(root_node);
    var facet_root: facet::Node = @facet {
        vstack {
            label("Files")
            native_widget(t).grow(1.0f64).agent_id("filetree")
        }
    };
    let h: f64 = mount_into(#addr_of(facet_root), content.raw(), 300.0f64, 400.0f64);
    assert h > 0.0f64;
    assert surface_has_id(content.raw(), "filetree");
}

static P3_BUILDS: i32 = 0;

fn phase3_native_screen() -> facet::Node {
    P3_BUILDS = P3_BUILDS + 1;
    let box = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 80.0, h: 40.0 });
    return @facet {
        vstack {
            label("native re-render")
            native_widget(ui::fixed_view(box)).frame(80.0f64, 40.0f64).agent_id("box")
        }
    };
}

#[test]
fn phase3_native_survives_rerender() {
    // The component contract: build produces a fresh tree each time, and the
    // native child returns on every remount (here via the explicit remount
    // helper — the app's own "re-open this screen" path).
    P3_BUILDS = 0;
    let content = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 200.0, h: 160.0 });
    remount(phase3_native_screen, content.raw(), 200.0f64, 160.0f64);
    assert P3_BUILDS == 1;
    assert surface_has_id(content.raw(), "box");

    remount(phase3_native_screen, content.raw(), 200.0f64, 160.0f64);
    assert P3_BUILDS == 2;
    assert surface_has_id(content.raw(), "box");
}

static TOGGLE_FIRES: i32 = 0;
fn on_toggle_change(sender: *u8, ctx: *u8) { TOGGLE_FIRES = TOGGLE_FIRES + 1; return; }

#[test]
fn controls_mount_and_toggle_drives() {
    TOGGLE_FIRES = 0;
    let win = e2e_window(300.0f64, 220.0f64);
    let content = e2e_content(win);
    var root: facet::Node = @facet {
        vstack {
            toggle(on: false, label: "Wifi", on_change: on_toggle_change).agent_id("wifi")
            slider(value: 0.5f64, min: 0.0f64, max: 1.0f64).agent_id("vol")
            progress(value: 0.3f64)
        }
    };
    let _h: f64 = mount_into(#addr_of(root), content.raw(), 300.0f64, 220.0f64);
    var s: agent::Surface = agent::open(win.raw());
    assert surface_has_id(content.raw(), "wifi");
    assert surface_has_id(content.raw(), "vol");
    // toggle is role_button + drive_click → the agent can flip it, firing the wire.
    assert surface::outcome_eq(s.click("wifi"), surface::Outcome::Allowed);
    assert TOGGLE_FIRES == 1;
}

#[test]
fn batch3_pickers_mount_and_checkbox_drives() {
    let win = e2e_window(320.0f64, 280.0f64);
    let content = e2e_content(win);
    var root: facet::Node = @facet {
        vstack {
            checkbox("Agree", on: true).agent_id("agree")
            radio("Option A").agent_id("optA")
            color_picker().agent_id("color")
            date_picker().agent_id("date")
        }
    };
    let _h: f64 = mount_into(#addr_of(root), content.raw(), 320.0f64, 280.0f64);
    var s: agent::Surface = agent::open(win.raw());
    assert surface_has_id(content.raw(), "agree");
    assert surface_has_id(content.raw(), "optA");
    assert surface_has_id(content.raw(), "color");
    assert surface_has_id(content.raw(), "date");
    // checkbox is a toggle → role_button → the agent can click it.
    assert surface::outcome_eq(s.click("agree"), surface::Outcome::Allowed);
}

#[test]
fn tooltip_and_a11y_label_apply() {
    // A widget with a tooltip + accessibility label mounts through apply_style;
    // the a11y label reads back off the view.
    let content = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 200.0, h: 80.0 });
    var root: facet::Node = @facet {
        vstack {
            button("Save")
                .tooltip("Save the current file")
                .accessibility_label("Save")
                .agent_id("save")
        }
    };
    let _h: f64 = mount_into(#addr_of(root), content.raw(), 200.0f64, 80.0f64);
    assert surface_has_id(content.raw(), "save");
    // the accessibility label landed on the button view
    let bp: *u8 = nth_widget(content.raw(), 0 as usize);
    assert ak::Accessibility::from_raw(bp).accessibility_label().view() == "Save";
}

#[test]
fn material_wraps_content_on_appkit() {
    // A vibrancy panel (NSVisualEffectView) hosting a labeled sidebar.
    let content = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 200.0, h: 200.0 });
    var root: facet::Node = @facet {
        material {
            vstack {
                label("Sidebar").strong()
                label("Item 1").agent_id("item1")
                label("Item 2")
            }
            .padding(12.0f64)
        }
        .frame(180.0f64, 160.0f64)
    };
    let h: f64 = mount_into(#addr_of(root), content.raw(), 200.0f64, 200.0f64);
    assert h > 0.0f64;
    assert surface_has_id(content.raw(), "item1");
}

static CTX_MENU_PICK: i64 = -1;
fn on_ctx_pick(sender: *u8, ctx: *u8) { CTX_MENU_PICK = ctx as i64; return; }

#[test]
fn context_menu_dispatches_by_index() {
    CTX_MENU_PICK = -1;
    let content = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 200.0, h: 80.0 });
    var items: vec::Vec[text::Text] = vec::new::[text::Text]();
    items.append(text::from_str("Cut"));
    items.append(text::from_str("Copy"));
    items.append(text::from_str("Paste"));
    var root: facet::Node = @facet {
        vstack {
            label("right-click me").context_menu(items, on_ctx_pick).agent_id("target")
        }
    };
    let _h: f64 = mount_into(#addr_of(root), content.raw(), 200.0f64, 80.0f64);
    let lv: *u8 = nth_widget(content.raw(), 0 as usize);
    let menu: *u8 = rt::msg_id(lv, rt::sel(#str_ptr("menu\0")));
    assert menu != (0 as *u8);
    // Fire the 3rd item (index 2 = "Paste") through its retained target.
    let item: *u8 = rt::msg_id_i64(menu, rt::sel(#str_ptr("itemAtIndex:\0")), 2 as i64);
    let tgt: *u8 = rt::msg_id(item, rt::sel(#str_ptr("target\0")));
    assert tgt != (0 as *u8);
    rt::msg_void_id(tgt, akx::action_ctx_sel(), item);
    assert CTX_MENU_PICK == (2 as i64);
}

#[test]
fn focus_makes_widget_first_responder() {
    let win = e2e_window(300.0f64, 160.0f64);
    let content = e2e_content(win);
    var root: facet::Node = @facet {
        vstack {
            text_field(placeholder: "name").agent_id("name")
            text_field(placeholder: "email").agent_id("email")
        }
    };
    let _h: f64 = mount_into(#addr_of(root), content.raw(), 300.0f64, 160.0f64);
    // find_view_by_id locates the field, and makeFirstResponder succeeds.
    assert find_view_by_id(content.raw(), "email") != (0 as *u8);
    assert focus(win.raw(), "email");
}

fn td_toolbar_click(sender: *u8, ctx: *u8) { return; }

#[test]
fn toolbar_attaches_with_items() {
    let win: ak::Window = make_shell_window("t", 400.0f64, 300.0f64, false);
    let cb: fn(*u8, *u8) = td_toolbar_click;
    var tb_items: vec::Vec[facet::Node] = vec::new::[facet::Node]();
    tb_items.append(facet::button("Save").on_click(cb, 0 as *u8));
    tb_items.append(facet::button("Share").on_click(cb, 0 as *u8));
    var root: facet::Node = @facet {
        vstack {
            label("Body")
        }
    };
    root = root.toolbar(tb_items);
    install_toolbar(win, #addr_of(root));
    var found: bool = false;
    match win.toolbar() {
        option::Option[ak::Toolbar]::Some(tb) => {
            // the delegate vends our two identifiers (queried without showing)
            let del: *u8 = rt::msg_id(tb.raw(), rt::sel(#str_ptr("delegate\0")));
            assert del != (0 as *u8);
            let dids: *u8 = rt::msg_id_id(del, rt::sel(#str_ptr("toolbarDefaultItemIdentifiers:\0")), tb.raw());
            let cnt: u64 = rt::msg_u64(dids, rt::sel(#str_ptr("count\0")));
            assert cnt == (2 as u64);
            found = true;
        }
        option::Option[ak::Toolbar]::None => {}
    }
    assert found;
}

#[test]
fn titlebar_installs_leading_and_trailing_accessories() {
    let win: ak::Window = make_shell_window("t", 500.0f64, 320.0f64, false);
    let cb: fn(*u8, *u8) = td_toolbar_click;
    // Single-control regions also exercise the lone-leaf apply fix (#11): each
    // accessory's content root is a bare widget with a payload and no children.
    let leading: facet::Node = facet::icon_button("sidebar.left").on_click(cb, 0 as *u8);
    let trailing: facet::Node = facet::button("Run").on_click(cb, 0 as *u8);
    install_titlebar(win, leading, trailing);
    // Leading + trailing accessories added; the native title text is hidden so
    // the controls are the title-bar content (title bar itself is kept).
    let vcs: vec::Vec[ak::TitlebarAccessoryViewController] = win.titlebar_accessory_view_controllers();
    assert vcs.count() == (2 as usize);
    match win.title_visibility() {
        ak::WindowTitleVisibility::NSWindowTitleHidden => { }
        _ => { assert false; }
    }
    return;
}

// True when the window's standard button `b` exists and is hidden.
fn button_is_hidden(win: ak::Window, b: ak::WindowButton) -> bool {
    match win.standard_window_button(b) {
        option::Option[ak::Button]::Some(btn) => { return btn.as_view().is_hidden(); }
        option::Option[ak::Button]::None => { return false; }
    }
    return false;
}

#[test]
fn custom_chrome_hides_all_standard_window_buttons() {
    // custom_chrome hides ALL THREE traffic lights (the app draws its own), unlike
    // clean_titlebar which keeps the native close button.
    let win: ak::Window = make_shell_window("t", 400.0f64, 300.0f64, false, custom_chrome: true);
    assert button_is_hidden(win, ak::WindowButton::NSWindowCloseButton);
    assert button_is_hidden(win, ak::WindowButton::NSWindowMiniaturizeButton);
    assert button_is_hidden(win, ak::WindowButton::NSWindowZoomButton);
    // full-size content (borderless look) is on, exactly like clean_titlebar
    assert (win.style_mask() & ak::window_style_mask_full_size_content_view) != (0 as u64);
    // NOT movableByWindowBackground: that would swallow clicks on the app's own
    // controls; dragging is the job of an explicit window_drag() surface.
    assert win.is_movable_by_window_background() == false;
    // a plain window keeps its native close button visible
    let plain: ak::Window = make_shell_window("t", 400.0f64, 300.0f64, false);
    assert button_is_hidden(plain, ak::WindowButton::NSWindowCloseButton) == false;
    assert plain.is_movable_by_window_background() == false;
}

#[test]
fn window_drag_wraps_content_in_a_drag_surface() {
    // window_drag mounts to a CplusExtWindowDragView payload that drags the window
    // (and double-click-zooms); its content mounts through as a child. Build the
    // node directly (an @facet block would wrap this lone element in a column).
    var inner: facet::Builder = facet::Builder::new();
    inner.add(facet::label("titlebar"));
    var wd: facet::Node = facet::window_drag(inner);
    var tree: flex::Node = mount(#addr_of(wd));
    assert tree.payload() != (0 as *u8);
    let cls: *u8 = akx::window_drag_view_class();
    assert rt::msg_i8_id(tree.payload(), rt::sel(#str_ptr("isKindOfClass:\0")), cls) != (0 as i8);
    // the drag surface handles mouseDown: (starts the window drag / zoom)
    assert rt::msg_i8_id(tree.payload(), rt::sel(#str_ptr("respondsToSelector:\0")), rt::sel(#str_ptr("mouseDown:\0"))) != (0 as i8);
    assert tree.child_count() == (1 as usize);
}

#[test]
fn native_buttons_mode_keeps_standard_buttons_visible() {
    // native_buttons keeps ALL THREE standard buttons VISIBLE (the opposite of
    // custom_chrome) under a full-size, hidden-title, background-drag chrome — a
    // window_buttons() node then re-parents the real controls.
    let win: ak::Window = make_shell_window("t", 400.0f64, 300.0f64, false, native_buttons: true);
    assert button_is_hidden(win, ak::WindowButton::NSWindowCloseButton) == false;
    assert button_is_hidden(win, ak::WindowButton::NSWindowMiniaturizeButton) == false;
    assert button_is_hidden(win, ak::WindowButton::NSWindowZoomButton) == false;
    assert (win.style_mask() & ak::window_style_mask_full_size_content_view) != (0 as u64);
    // NOT movableByWindowBackground: it would swallow static clicks on the
    // re-parented traffic lights; dragging is window_drag()'s job.
    assert win.is_movable_by_window_background() == false;
    match win.title_visibility() {
        ak::WindowTitleVisibility::NSWindowTitleHidden => { }
        _ => { assert false; }
    }
    return;
}

#[test]
fn window_buttons_mounts_a_reparent_view() {
    // window_buttons() mounts to a CplusExtWindowButtonsView leaf that will grab
    // the native traffic lights when it enters a window; it measures to their
    // natural extent and answers viewDidMoveToWindow (the re-parent hook).
    var wb: facet::Node = facet::window_buttons();
    var tree: flex::Node = mount(#addr_of(wb));
    assert tree.payload() != (0 as *u8);
    let cls: *u8 = akx::window_buttons_view_class();
    assert rt::msg_i8_id(tree.payload(), rt::sel(#str_ptr("isKindOfClass:\0")), cls) != (0 as i8);
    assert rt::msg_i8_id(tree.payload(), rt::sel(#str_ptr("respondsToSelector:\0")), rt::sel(#str_ptr("viewDidMoveToWindow\0"))) != (0 as i8);
}

#[test]
fn window_buttons_view_reparents_the_native_buttons() {
    // The live mechanism, headless: adding the view to a window's content view
    // fires viewDidMoveToWindow, which moves the REAL close/miniaturize/zoom
    // buttons out of the titlebar and into the view (kept visible).
    let win: ak::Window = make_shell_window("t", 400.0f64, 300.0f64, false, native_buttons: true);
    let content = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 400.0, h: 56.0 });
    win.set_content_view(ak::View::from_raw(content.raw()));
    let v: ak::View = akx::new_window_buttons_view();
    content.add_subview(v);   // → viewDidMoveToWindow → re-parent
    // each standard button now lives under our view and is visible
    match win.standard_window_button(ak::WindowButton::NSWindowCloseButton) {
        option::Option[ak::Button]::Some(btn) => {
            let sv: *u8 = rt::msg_id(btn.as_view().raw(), rt::sel(#str_ptr("superview\0")));
            assert sv == v.raw();
            assert btn.as_view().is_hidden() == false;
        }
        option::Option[ak::Button]::None => { assert false; }
    }
    match win.standard_window_button(ak::WindowButton::NSWindowZoomButton) {
        option::Option[ak::Button]::Some(btn) => {
            let sv: *u8 = rt::msg_id(btn.as_view().raw(), rt::sel(#str_ptr("superview\0")));
            assert sv == v.raw();   // the zoom button is present (native toggle preserved)
        }
        option::Option[ak::Button]::None => { assert false; }
    }
    return;
}

#[test]
fn min_size_floors_the_content_size() {
    // A min_width/min_height floor is applied as the window's contentMinSize, so
    // the window can't be dragged below its usable layout. 0 = no floor.
    let win: ak::Window = make_shell_window("t", 900.0f64, 700.0f64, false, min_width: 800.0f64, min_height: 630.0f64);
    let ms: rt::Size = win.content_min_size();
    assert ms.w == (800.0f64);
    assert ms.h == (630.0f64);
    // both must be > 0 to floor: a plain window keeps AppKit's default (no floor).
    let plain: ak::Window = make_shell_window("t", 900.0f64, 700.0f64, false);
    let pm: rt::Size = plain.content_min_size();
    assert pm.w == (0.0f64);
    assert pm.h == (0.0f64);
}

#[test]
fn window_buttons_reparented_buttons_are_hit_testable() {
    // The re-parented traffic lights must be the hitTest target at their painted
    // location — else the press falls through them (to the drag view / passive
    // chrome) and close/minimize/zoom never fire, even though they render + hover.
    let win: ak::Window = make_shell_window("t", 400.0f64, 300.0f64, false, native_buttons: true);
    let content = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 400.0, h: 56.0 });
    win.set_content_view(ak::View::from_raw(content.raw()));
    let v: ak::View = akx::new_window_buttons_view();
    content.add_subview(v);   // → viewDidMoveToWindow → re-parent + lay out
    match win.standard_window_button(ak::WindowButton::NSWindowCloseButton) {
        option::Option[ak::Button]::Some(btn) => {
            // v sits at content's origin, so a point in v's coords is also the
            // point in content's coords (hitTest's argument space).
            let bf: rt::Rect = btn.as_view().frame();
            let p: rt::Point = rt::Point { x: bf.x + bf.w / 2.0f64, y: bf.y + bf.h / 2.0f64 };
            let hit: *u8 = { rt::msg_id_point(v.raw(), rt::sel(#str_ptr("hitTest:\0")), p) };
            assert hit == btn.as_view().raw();
        }
        option::Option[ak::Button]::None => { assert false; }
    }
    return;
}

#[test]
fn window_buttons_hit_testable_through_window_drag_live_chain() {
    // Reproduce iris's exact nesting through the REAL mount+apply pipeline:
    // window_drag { hstack(background) { window_buttons() label } }. Then hitTest
    // from the window's content view at the close button's centre — the path AppKit
    // uses for a real click. It must resolve to the button (not the drag view /
    // the covering row), else the click falls through and close/min/zoom are dead.
    let win: ak::Window = make_shell_window("t", 400.0f64, 300.0f64, false, native_buttons: true);
    let content = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 400.0, h: 56.0 });
    win.set_content_view(ak::View::from_raw(content.raw()));
    var root: facet::Node = @facet {
        window_drag {
            hstack {
                window_buttons()
                label("hello")
            }
            .height(56.0f64)
            .background(facet::Color::rgba(0.13f64, 0.13f64, 0.16f64, 1.0f64))
        }
    };
    let _h: f64 = mount_into(#addr_of(root), content.raw(), 400.0f64, 56.0f64);

    match win.standard_window_button(ak::WindowButton::NSWindowCloseButton) {
        option::Option[ak::Button]::Some(btn) => {
            let bv: *u8 = btn.as_view().raw();
            let bb: rt::Rect = { rt::msg_rect(bv, rt::sel(#str_ptr("bounds\0"))) };
            let center: rt::Point = rt::Point { x: bb.w / 2.0f64, y: bb.h / 2.0f64 };
            // the button's centre, expressed in the content view's coordinate space
            let cpt: rt::Point = { rt::msg_point_point_id(bv, rt::sel(#str_ptr("convertPoint:toView:\0")), center, content.raw()) };
            let hit: *u8 = { rt::msg_id_point(content.raw(), rt::sel(#str_ptr("hitTest:\0")), cpt) };
            assert hit == bv;
        }
        option::Option[ak::Button]::None => { assert false; }
    }
    return;
}

#[test]
fn window_drag_hittest_drags_bare_regions_but_not_controls() {
    // The drag surface hosts two children: a passive filler view (left) and an
    // NSControl (right). A press over the filler returns the drag view (so the
    // window drag starts); a press over the control returns the control (so it
    // clicks). This is what lets window_drag coexist with real toolbar controls
    // without movableByWindowBackground.
    let dv: ak::View = akx::new_window_drag_view(rt::Rect { x: 0.0, y: 0.0, w: 200.0, h: 40.0 });
    let filler: ak::View = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 90.0, h: 40.0 });
    dv.add_subview(filler);
    let btn: ak::Button = ak::Button::new_with_frame(rt::Rect { x: 120.0, y: 8.0, w: 40.0, h: 24.0 });
    dv.add_subview(btn.as_view());
    // A facet `clickable` is NOT an NSControl — it's a plain view carrying a click
    // gesture recognizer. It must pass through too (else clicking it would drag).
    let clk: ak::View = akx::new_clickable_view(rt::Rect { x: 60.0, y: 0.0, w: 30.0, h: 40.0 });
    akx::add_click_gesture(clk, td_toolbar_click, 0 as *u8, 1 as i64, akx::primary_button_mask());
    dv.add_subview(clk);

    // hitTest point is in the drag view's superview space; dv sits at origin 0,0
    // (no superview), so points map straight through.
    let hit_bare: *u8 = { rt::msg_id_point(dv.raw(), rt::sel(#str_ptr("hitTest:\0")), rt::Point { x: 20.0, y: 20.0 }) };
    assert hit_bare == dv.raw();                                   // passive → drag
    let hit_ctrl: *u8 = { rt::msg_id_point(dv.raw(), rt::sel(#str_ptr("hitTest:\0")), rt::Point { x: 135.0, y: 20.0 }) };
    assert hit_ctrl == btn.as_view().raw();                        // NSControl → clicks
    let hit_clk: *u8 = { rt::msg_id_point(dv.raw(), rt::sel(#str_ptr("hitTest:\0")), rt::Point { x: 72.0, y: 20.0 }) };
    assert hit_clk == clk.raw();                                   // gesture view → clicks
    return;
}

#[test]
fn window_actions_resolve_and_are_safe_without_a_window() {
    // A control already in a window resolves that window.
    let win: ak::Window = make_shell_window("t", 200.0f64, 200.0f64, false);
    let content = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 40.0, h: 40.0 });
    win.set_content_view(ak::View::from_raw(content.raw()));
    assert akx::window_of(content.raw()) == win.raw();
    // A control with no enclosing window: every verb is a safe no-op (no crash).
    let orphan = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 10.0, h: 10.0 });
    assert akx::window_of(orphan.raw()) == (0 as *u8);
    window_close(orphan.raw());
    window_minimize(orphan.raw());
    window_zoom(orphan.raw());
    assert true;   // reached here without faulting
}

#[test]
fn draggable_box_is_drag_source() {
    let content = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 160.0, h: 120.0 });
    var root: facet::Node = @facet {
        vstack {
            box().frame(100.0f64, 40.0f64).draggable("hello").agent_id("drag")
        }
    };
    let h: f64 = mount_into(#addr_of(root), content.raw(), 160.0f64, 120.0f64);
    assert h > 0.0f64;
    assert surface_has_id(content.raw(), "drag");
    let vp: *u8 = find_view_by_id(content.raw(), "drag");
    assert vp != (0 as *u8);
    // the box is a FacetDragView: it conforms to NSDraggingSource and handles the
    // press that starts a drag (interactive drag itself is AppKit's, out of scope)
    let responds_sel: *u8 = rt::sel(#str_ptr("respondsToSelector:\0"));
    let src_sel: *u8 = rt::sel(#str_ptr("draggingSession:sourceOperationMaskForDraggingContext:\0"));
    let down_sel: *u8 = rt::sel(#str_ptr("mouseDown:\0"));
    assert rt::msg_i8_id(vp, responds_sel, src_sel) != (0 as i8);
    assert rt::msg_i8_id(vp, responds_sel, down_sel) != (0 as i8);
}

fn td_drop_handler(sender: *u8, ctx: *u8) { return; }

#[test]
fn drop_zone_box_registers_for_text() {
    let content = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 160.0, h: 120.0 });
    let dh: fn(*u8, *u8) = td_drop_handler;
    var root: facet::Node = @facet {
        vstack {
            box()
                .frame(140.0f64, 90.0f64)
                .on_drop(dh, 0 as *u8)
                .agent_id("zone")
        }
    };
    let h: f64 = mount_into(#addr_of(root), content.raw(), 160.0f64, 120.0f64);
    assert h > 0.0f64;
    assert surface_has_id(content.raw(), "zone");
    // the box became a FacetDropView registered for the text drag type
    let vp: *u8 = find_view_by_id(content.raw(), "zone");
    assert vp != (0 as *u8);
    let types: *u8 = rt::msg_id(vp, rt::sel(#str_ptr("registeredDraggedTypes\0")));
    let cnt: u64 = rt::msg_u64(types, rt::sel(#str_ptr("count\0")));
    assert cnt >= (1 as u64);
    assert dropped_text(vp).view() == "";   // nothing dropped yet
}

#[test]
fn path_shape_mounts_on_appkit() {
    let content = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 160.0, h: 120.0 });
    var root: facet::Node = @facet {
        vstack {
            path(120.0f64, 90.0f64)
                .move_to(0.0f64, 0.0f64)
                .line_to(120.0f64, 0.0f64)
                .line_to(60.0f64, 90.0f64)
                .close_path()
                .background(facet::Color::accent())
                .border(3.0f64, facet::Color::primary())
                .agent_id("tri")
        }
    };
    let h: f64 = mount_into(#addr_of(root), content.raw(), 160.0f64, 120.0f64);
    assert h > 0.0f64;
    assert surface_has_id(content.raw(), "tri");
    // the shape carries a CAShapeLayer sublayer with a non-nil path
    let vp: *u8 = nth_widget(content.raw(), 0 as usize);
    let v: ak::View = ak::View::from_raw(vp);
    let sub: *u8 = rt::msg_id(v.layer().raw(), rt::sel(#str_ptr("sublayers\0")));
    let n_sub: u64 = rt::msg_u64(sub, rt::sel(#str_ptr("count\0")));
    assert n_sub >= (1 as u64);
    let shape: *u8 = rt::msg_id_u64(sub, rt::sel(#str_ptr("objectAtIndex:\0")), 0 as u64);
    let cg: *u8 = rt::msg_id(shape, rt::sel(#str_ptr("path\0")));
    assert cg != (0 as *u8);
}

#[test]
fn fade_in_entrance_mounts() {
    let content = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 120.0, h: 60.0 });
    var root: facet::Node = @facet {
        vstack {
            label("Appears").fade_in(0.35f64).agent_id("fade")
        }
    };
