    assert h > 0.0f64;
    assert surface_has_id(content.raw(), "g");      // NSLevelIndicator
    assert surface_has_id(content.raw(), "save");
    // the key equivalent landed on the button
    let bp: *u8 = nth_widget(content.raw(), 1 as usize);
    assert ak::Button::from_raw(bp).key_equivalent().view() == "s";
}

#[test]
