    let content = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 200.0, h: 200.0 });
    var root: facet::Node = @facet {
        material {
            vstack {
                label("Sidebar").strong()
                label("Item 1").agent_id("item1")
                label("Item 2")
            }
            .padding(12.0f64)
        }
        .frame(180.0f64, 160.0f64)
    };
