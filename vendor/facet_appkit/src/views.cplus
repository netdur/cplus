// facet_appkit views — the Renderer's five verbs.
//
// This is the whole of what facet calls: `create`, `apply`, `insert`, `remove`
// and the `view_release` that pairs with a created view. The per-kind work is
// controls.cplus, the kind-independent work is paint.cplus, and neither is
// visible to facet — Stage 2's rule is that facet never grows a verb table.
//
// `create` builds a FULLY CONFIGURED view for a node, or returns 0 for a node
// that needs no backing view (a pure-layout container carrying no key).
// `apply` re-reads a node whose dirty word is non-zero and applies only what
// the bits name. They share the per-kind bodies: `create` calls the same
// `apply_<kind>` with an all-ones dirty word, so a control cannot be correct
// on mount and wrong on its first update.

import "stdlib/option" as option;
import "stdlib/text" as text;
import "stdlib/vec" as vec;
import "stdlib/io" as io;
import "flex_layout/flex_layout" as flex;
import "facet/facet" as core;
import "facet/props" as props;
import "facet/gestures" as gestures;
import "facet/vocabulary" as vocab;
import "objc/runtime" as rt;
import "objc/synthesis" as synth;
import "appkit/appkit" as ak;
import "appkit/appkit_ext" as akx;
import "./paint" as paint;
import "./input" as input;
import "./web" as web;
import "facet/symbol" as symbol;
import "facet/split" as split;
import "facet/tree" as tree;
import "facet/window_chrome" as chrome;
import "./controls" as controls;

type Node = flex::Node;

// ---- does this node get a view? ----------------------------------------------
// A control always does. A plain container does when it carries a KEY, because
// a key is an address: `find("body")` must reach something, the agent surface
// tags it, and set_content needs a host whose native slots it can count. An
// unkeyed pure-layout container gets nothing and passes its children through to
// the nearest host — which is how a column inside a scroll view costs no view.
//
// The fake renderer in facet's suite uses exactly this rule, so the headless
// conformance tests and this backend agree on the shape of the native tree.
fn wants_view(n: *core::Node) -> bool {
    let kind: u32 = core::kind_of(n);
    // The menu kinds are not views at all: an NSMenu is not an NSView, and a
    // context menu decorates the node it sits under rather than occupying a
    // place of its own. They are read as NODES when their parent's view is
    // built — see controls::attach_context_menu.
    if controls::menu_kind(kind) { return false; }
    // The menu-bar tier is not views either: an NSMenu, an NSMenuItem and an
    // NSToolbarItem are objects the application or the window owns, not
    // rectangles in a tree. controls:: builds them; the window tier installs
    // them (stages/4.md item 5).
    if controls::menu_bar_kind(kind) { return false; }
    // A span is a styled RUN inside a label, not a thing of its own — the
    // label reads its span children and renders one attributed string.
    if controls::span_kind(kind) { return false; }
    if kind != core::K_NODE { return true; }
    // A bare container with GESTURES needs one too: input arrives on a view,
    // so an unkeyed `column(b).on_click(...)` would otherwise describe a
    // handler nothing could ever deliver to.
    if gestures::has_gestures(n) { return true; }
    return { (*n).key() } != "";
}

// ---- create ------------------------------------------------------------------

fn create(ctx: *u8, n: *core::Node) -> *u8 {
    if n == (0 as *core::Node) { return 0 as *u8; }
    if !wants_view(n) { return 0 as *u8; }
    let kind: u32 = core::kind_of(n);
    let v: *u8 = create_for_kind(kind, n);
    if v == (0 as *u8) { return 0 as *u8; }
    // The key IS the accessibilityIdentifier. One token, three jobs: facet's
    // address, the agent surface's id, and the platform's a11y id.
    let k: str = { (*n).key() };
    if k != "" {
        ak::Accessibility::from_raw(v).set_accessibility_identifier(k);
    }
    // Configure it WHOLE: the shared band, then the kind's own body with every
    // bit set. One code path with apply, so the two cannot drift.
    paint::apply_common(v, n, paint::all_bits());
    apply_for_kind(kind, v, n, paint::all_bits());
    // The gesture band. AFTER the kind body, because arming moves the view's
    // class and a body that reads `object_class` would see the subclass.
    input::arm(v, n);
    input::bind_item(v, n);
    // Intrinsic size: the node measures itself through its view from here on.
    // `context` is flex's spare slot — facet's Data rides the ATTACHMENT, so
    // nothing else wants it.
    if has_intrinsic_size(kind) {
        { (*n).set_context(v) };
        { (*n).set_measure(measure_view) };
    }
    // A `context_menu` child describes a menu for THIS view; it has no view of
    // its own, so this is the moment it can be hung.
    controls::attach_context_menu(v, n);
    return v;
}

// ---- intrinsic size ----------------------------------------------------------
// The gap the gesture probe found, by showing nothing: flex sizes a LEAF from
// its measure callback, and nothing had ever installed one. So every control
// that was not given an explicit width and height measured 0x0 — a
// `label("Save")` in a column was laid out as a zero-height strip and simply
// did not appear. Everything about it was correct except its size.
//
// The measure is the platform's own answer (`fittingSize`), which is what
// makes a button as wide as its title and a label as tall as its text without
// facet knowing anything about type setting.
//
// It goes on the kinds whose size is genuinely INTRINSIC, named one by one
// rather than "everything with a view". A scroll view, a web view or a canvas
// has a fitting size too, and it means something else entirely — a surface is
// sized by its container, and asking WKWebView how big it would like to be is
// not a question with a useful answer.
fn has_intrinsic_size(kind: u32) -> bool {
    return kind == props::K_LABEL || kind == props::K_BUTTON
        || kind == props::K_TEXT_FIELD || kind == props::K_SEARCH_FIELD
        || kind == props::K_CHECKBOX || kind == props::K_RADIO
        || kind == props::K_TOGGLE || kind == props::K_SLIDER
        || kind == props::K_PROGRESS || kind == props::K_SPINNER
        || kind == props::K_STEPPER || kind == props::K_POPUP
        || kind == props::K_DATE_PICKER || kind == props::K_TIME_PICKER
        || kind == props::K_IMAGE || kind == props::K_ICON_BUTTON
        || kind == props::K_PAGE_DOTS
        || kind == symbol::K_SYMBOL || kind == chrome::K_WINDOW_BUTTONS;
}

#[link_name = "objc_msgSend"]
extern fn msg_size(recv: *u8, sel: *u8) -> rt::Size;

// The measure flex calls. `ctx` is the backing view, put there by `create`.
//
// A bounded width is handed to the view BEFORE the question, because a
// wrapping label's height depends on it: `preferredMaxLayoutWidth` is how
// AppKit is told "you have this much", and without it a two-line label
// measures as one long line and is clipped.
fn measure_view(ctx: *u8, avail_w: f64, wm: flex::MeasureMode,
                avail_h: f64, hm: flex::MeasureMode) -> flex::Size {
    if ctx == (0 as *u8) { return flex::Size { width: 0.0f64, height: 0.0f64 }; }
    if avail_w == avail_w && avail_w > 0.0f64 {
        if synth::class_responds(synth::object_class(ctx),
                                 rt::sel(#str_ptr("setPreferredMaxLayoutWidth:\0"))) != (0 as i8) {
            { rt::msg_void_f64(ctx, rt::sel(#str_ptr("setPreferredMaxLayoutWidth:\0")), avail_w) };
        }
    }
    let s: rt::Size = msg_size(ctx, rt::sel(#str_ptr("fittingSize\0")));
    return flex::Size { width: s.w, height: s.h };
}

// A plain backing view. FLIPPED, always: every view this backend creates is
// top-left origin, so the frame walk needs no flip math (see geometry.cplus).
// Returned at +1 — mount pairs it with `view_release`, which is the release.
fn backing_view() -> *u8 {
    let v: ak::View = akx::new_flipped_view(rt::Rect { x: 0.0f64, y: 0.0f64, w: 0.0f64, h: 0.0f64 });
    return rt::retain(v.raw());
}

fn create_for_kind(kind: u32, n: *core::Node) -> *u8 {
    if kind == core::K_NODE { return backing_view(); }
    if kind == props::K_LABEL { return controls::create_label(n); }
    if kind == props::K_BUTTON { return controls::create_button(n); }
    if kind == props::K_TEXT_FIELD { return controls::create_text_field(n); }
    if kind == props::K_IMAGE { return controls::create_image(n); }
    if kind == props::K_SCROLL { return controls::create_scroll(n); }
    if kind == props::K_BOX { return controls::create_box(n); }
    if kind == props::K_CHECKBOX { return controls::create_checkbox(n); }
    if kind == props::K_RADIO { return controls::create_radio(n); }
    if kind == props::K_TOGGLE { return controls::create_toggle(n); }
    if kind == props::K_SLIDER { return controls::create_slider(n); }
    if kind == props::K_PROGRESS { return controls::create_progress(n); }
    if kind == props::K_SPINNER { return controls::create_spinner(n); }
    if kind == props::K_STEPPER { return controls::create_stepper(n); }
    if kind == props::K_ICON_BUTTON { return controls::create_icon_button(n); }
    if kind == symbol::K_SYMBOL { return controls::create_symbol(n); }
    if kind == props::K_TEXT_AREA { return controls::create_text_area(n); }
    if kind == props::K_SEARCH_FIELD { return controls::create_search_field(n); }
    if kind == props::K_POPUP { return controls::create_popup(n); }
    if kind == props::K_BORDERED { return controls::create_bordered(n); }
    if kind == split::K_SPLIT { return controls::create_split(n); }
    if kind == props::K_PAGE_DOTS { return controls::create_page_dots(n); }
    if kind == props::K_DATE_PICKER { return controls::create_date_picker(n); }
    if kind == props::K_TIME_PICKER { return controls::create_time_picker(n); }
    if kind == props::K_TABS { return controls::create_tabs(n); }
    // Decided, not missing: MANIFEST.md records why these have no macOS
    // equivalent and what to use instead. They get a plain backing view so
    // their content still renders — and SILENTLY, because a warning for
    // something already answered would train a reader to ignore the warnings
    // that mean something.
    if controls::decided_absent(kind) { return controls::create_passthrough(n); }
    if kind == props::K_LIST { return controls::create_list(n); }
    if kind == props::K_COLLECTION { return controls::create_collection(n); }
    if kind == props::K_TABLE { return controls::create_table(n); }
    if kind == props::K_CAROUSEL { return controls::create_carousel(n); }
    if kind == tree::K_TREE { return controls::create_tree(n); }
    if kind == props::K_CANVAS { return controls::create_canvas(n); }
    if kind == props::K_WEB { return web::create_web(n); }
    if kind == props::K_HYBRID_WEB { return web::create_hybrid_web(n); }
    if kind == chrome::K_WINDOW_BUTTONS { return controls::create_window_buttons(n); }
    unimplemented_kind(kind, n);
    return backing_view();
}

// ---- apply -------------------------------------------------------------------

fn apply(ctx: *u8, n: *core::Node) {
    if n == (0 as *core::Node) { return; }
    let v: *u8 = core::view_of(n);
    if v == (0 as *u8) { return; }
    let d: u64 = core::dirty_of(n);
    if d == (0 as u64) { return; }
    paint::apply_common(v, n, d);
    apply_for_kind(core::kind_of(n), v, n, d);
    // `attach` / `detach` / a whole-set swap all raise C_GESTURES, and arming
    // is idempotent — the class moves once, the node pointer is refreshed
    // every time (a re-attached node has a new address).
    if (d & core::C_GESTURES) != (0 as u64) { input::arm(v, n); }
    // An item rides C_HANDLERS: it is the payload half of a handler.
    if (d & props::C_HANDLERS) != (0 as u64) { input::bind_item(v, n); }
    return;
}

fn apply_for_kind(kind: u32, v: *u8, n: *core::Node, dirty: u64) {
    if kind == props::K_LABEL { controls::apply_label(v, n, dirty); return; }
    if kind == props::K_BUTTON { controls::apply_button(v, n, dirty); return; }
    if kind == props::K_TEXT_FIELD { controls::apply_text_field(v, n, dirty); return; }
    if kind == props::K_IMAGE { controls::apply_image(v, n, dirty); return; }
    if kind == props::K_SCROLL { controls::apply_scroll(v, n, dirty); return; }
    if kind == props::K_BOX { controls::apply_box(v, n, dirty); return; }
    if kind == props::K_CHECKBOX { controls::apply_checkbox(v, n, dirty); return; }
    if kind == props::K_RADIO { controls::apply_radio(v, n, dirty); return; }
    if kind == props::K_TOGGLE { controls::apply_toggle(v, n, dirty); return; }
    if kind == props::K_SLIDER { controls::apply_slider(v, n, dirty); return; }
    if kind == props::K_PROGRESS { controls::apply_progress(v, n, dirty); return; }
    if kind == props::K_SPINNER { controls::apply_spinner(v, n, dirty); return; }
    if kind == props::K_STEPPER { controls::apply_stepper(v, n, dirty); return; }
    if kind == props::K_ICON_BUTTON { controls::apply_icon_button(v, n, dirty); return; }
    if kind == symbol::K_SYMBOL { controls::apply_symbol(v, n, dirty); return; }
    if kind == props::K_TEXT_AREA { controls::apply_text_area(v, n, dirty); return; }
    if kind == props::K_SEARCH_FIELD { controls::apply_search_field(v, n, dirty); return; }
    if kind == props::K_POPUP { controls::apply_popup(v, n, dirty); return; }
    if kind == props::K_BORDERED { controls::apply_bordered(v, n, dirty); return; }
    if kind == split::K_SPLIT { controls::apply_split(v, n, dirty); return; }
    if kind == props::K_PAGE_DOTS { controls::apply_page_dots(v, n, dirty); return; }
    if kind == props::K_DATE_PICKER { controls::apply_date_picker(v, n, dirty); return; }
    if kind == props::K_TIME_PICKER { controls::apply_time_picker(v, n, dirty); return; }
    if kind == props::K_TABS { controls::apply_tabs(v, n, dirty); return; }
    if kind == props::K_LIST { controls::apply_list(v, n, dirty); return; }
    if kind == props::K_COLLECTION { controls::apply_collection(v, n, dirty); return; }
    if kind == props::K_TABLE { controls::apply_table(v, n, dirty); return; }
    if kind == props::K_CAROUSEL { controls::apply_carousel(v, n, dirty); return; }
    if kind == tree::K_TREE { controls::apply_tree(v, n, dirty); return; }
    if kind == props::K_CANVAS { controls::apply_canvas(v, n, dirty); return; }
    if kind == props::K_WEB { web::apply_web(v, n, dirty); return; }
    if kind == props::K_HYBRID_WEB { web::apply_hybrid_web(v, n, dirty); return; }
    if kind == chrome::K_WINDOW_BUTTONS { controls::apply_window_buttons(v, n, dirty); return; }
    return;
}

// Does this kind have an answer — a body, a decided-absent pass-through, or a
// non-view builder? The sweep's own guard: a kind that reaches
// `unimplemented_kind` is a gap, and a test asserts there are none left.
fn has_body(kind: u32) -> bool {
    if kind == core::K_NODE { return true; }
    // The non-view kinds: built from nodes by controls::, never given a view.
    if controls::menu_kind(kind) { return true; }
    if controls::menu_bar_kind(kind) { return true; }
    if controls::span_kind(kind) { return true; }
    // Decided absent: a silent pass-through, recorded in MANIFEST.md.
    if controls::decided_absent(kind) { return true; }
    return kind == props::K_WEB || kind == props::K_HYBRID_WEB
        || kind == props::K_LABEL || kind == props::K_BUTTON
        || kind == props::K_TEXT_FIELD || kind == props::K_TEXT_AREA
        || kind == props::K_SEARCH_FIELD || kind == props::K_IMAGE
        || kind == props::K_ICON_BUTTON || kind == props::K_SCROLL
        || kind == props::K_BOX || kind == props::K_BORDERED
        || kind == props::K_CHECKBOX || kind == props::K_RADIO
        || kind == props::K_TOGGLE || kind == props::K_SLIDER
        || kind == props::K_PROGRESS || kind == props::K_SPINNER
        || kind == props::K_STEPPER || kind == props::K_POPUP
        || kind == props::K_DATE_PICKER || kind == props::K_TIME_PICKER
        || kind == props::K_TABS || kind == props::K_PAGE_DOTS
        || kind == props::K_LIST || kind == props::K_COLLECTION
        || kind == props::K_TABLE || kind == props::K_CAROUSEL
        || kind == props::K_CANVAS
        || kind == symbol::K_SYMBOL || kind == tree::K_TREE
        || kind == split::K_SPLIT || kind == chrome::K_WINDOW_BUTTONS;
}

// ---- the unimplemented kinds -------------------------------------------------
// Say so, once per kind, on stderr. A control that renders as an empty
// rectangle with no word said is the failure this package exists to avoid;
// until the sweep finishes, the gap is audible. MANIFEST.md lists which are
// not-yet-reached versus which AppKit genuinely cannot do — the two are never
// allowed to blur together.

static WARNED: [bool; 1100] = #zero::[[bool; 1100]]();

fn unimplemented_kind(kind: u32, n: *core::Node) {
    let idx: usize = kind as usize;
    if idx >= (1100 as usize) { return; }
    if WARNED[idx] { return; }
    WARNED[idx] = true;
    io::eprintln(text::from_str("facet_appkit: kind ")
        .appending(u32_text(kind).view())
        .appending(" has no AppKit body yet — it renders as an empty backing view. key: \"")
        .appending({ (*n).key() })
        .appending("\"").view());
    return;
}

fn digit_str(d: u32) -> str {
    if d == (0 as u32) { return "0"; }
    if d == (1 as u32) { return "1"; }
    if d == (2 as u32) { return "2"; }
    if d == (3 as u32) { return "3"; }
    if d == (4 as u32) { return "4"; }
    if d == (5 as u32) { return "5"; }
    if d == (6 as u32) { return "6"; }
    if d == (7 as u32) { return "7"; }
    if d == (8 as u32) { return "8"; }
    return "9";
}

// stdlib's Text has no integer formatter, and a diagnostic is not a reason to
// add one to a package this does not own.
fn u32_text(v: u32) -> text::Text {
    if v == (0 as u32) { return text::from_str("0"); }
    var digits: [u32; 12] = #zero::[[u32; 12]]();
    var n: u32 = v;
    var i: usize = 0 as usize;
    while n > (0 as u32) && i < (12 as usize) {
        digits[i] = n % (10 as u32);
        n = n / (10 as u32);
        i = i +% (1 as usize);
    }
    var out: text::Text = text::new();
    while i > (0 as usize) {
        i = i -% (1 as usize);
        out = out.appending(digit_str(digits[i]));
    }
    return out;
}

// ---- insert / remove ---------------------------------------------------------
// Native children under a host view, in facet's child order. `slot` is the
// index among the views facet has put in this host — the mount walk computes
// it, and `mount::insert_child` computes it for a live edit.
//
// The host facet hands over is the PARENT's view. Most kinds host their own
// children directly; a scroll does not (its children belong in the document
// view), so the host is translated here rather than anywhere facet can see.

fn is_kind_of(obj: *u8, class_name: *u8) -> bool {
    if obj == (0 as *u8) { return false; }
    return { rt::msg_i8_id(obj, rt::sel(#str_ptr("isKindOfClass:\0")), rt::get_class(class_name)) } != (0 as i8);
}

fn host_for(host: *u8) -> *u8 {
    if host == (0 as *u8) { return host; }
    if is_kind_of(host, #str_ptr("NSScrollView\0")) { return controls::document_host(host); }
    return host;
}

fn insert(ctx: *u8, host: *u8, child: *u8, slot: usize) {
    if host == (0 as *u8) { return; }
    if child == (0 as *u8) { return; }
    // NSTabView's children are NSTabViewItems, not subviews — the second (and
    // last) kind whose native child model is not "add a subview". The pane's
    // label is its key, because a tab needs a title and every addressable node
    // already has one.
    if is_kind_of(host, #str_ptr("NSTabView\0")) {
        controls::tabs_add_pane(host, child,
            ak::Accessibility::from_raw(child).accessibility_identifier().view());
        return;
    }
    let h: ak::View = ak::View::from_raw(host_for(host));
    let c: ak::View = ak::View::from_raw(child);
    let subs: vec::Vec[ak::View] = h.subviews();
    if slot >= subs.count() {
        h.add_subview(c);
        return;
    }
    // AppKit has no insertSubview:atIndex:. `positioned:Below relativeTo:` the
    // view currently occupying the slot puts it exactly there.
    match subs.at_ptr(slot) {
        option::Option[*ak::View]::Some(at) => {
            h.add_subview_positioned(c, ak::WindowOrderingMode::NSWindowBelow, ak::View::from_raw({ (*at).raw() }));
        }
        option::Option[*ak::View]::None => { h.add_subview(c); }
    }
    return;
}

fn remove(ctx: *u8, host: *u8, child: *u8) {
    if child == (0 as *u8) { return; }
    ak::View::from_raw(child).remove_from_superview();
    return;
}

// M1: the release mount pairs with every view `create` returned. Node teardown
// fires it, so a dropped tree cannot leak its views.
fn view_release(v: *u8) {
    // A web view is cut loose from its node BEFORE the release, because
    // releasing it does not necessarily deallocate it: WebKit retains a page
    // that is still loading, and a navigation callback arriving afterwards
    // would read a node that is gone.
    if web::is_web_view(v) { web::detach(v); }
    if v == (0 as *u8) { return; }
    { rt::release(v) };
    return;
}
