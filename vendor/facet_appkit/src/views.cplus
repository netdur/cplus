// facet_appkit views — what `Renderer.create` and `Renderer.apply` do.
//
// Stage 2's rule: facet never grows a verb table. A setter writes one field
// and sets one bit; the per-kind work lives HERE, dispatching on `Data.kind`,
// and facet never sees it. So this module is where the 42 controls become
// AppKit, and the only two entry points facet knows are `create` and `apply`.
//
// `create` builds a FULLY CONFIGURED view for a node — kind, props and the
// shared band, read whole — or returns 0 for a node that needs no backing view
// (a pure-layout container that carries no key). `apply` re-reads a node whose
// dirty word is non-zero and applies only what the bits name.
//
// ---- what is implemented here, and what is not -------------------------------
//
// STAGE 4 ITEM 1 (the window shell): the container backing and the whole
// shared band. That is what an empty keyed column on screen needs.
//
// STAGE 4 ITEM 2 (the walking skeleton, then the sweep to all 42): the
// per-kind bodies. `create_for_kind` currently answers every control kind with
// a plain backing view, and `unimplemented_kind` names it loudly rather than
// letting a button quietly render as a blank rectangle — a silent wrong view
// is exactly the failure INTENT is written against.

import "stdlib/option" as option;
import "stdlib/text" as text;
import "stdlib/vec" as vec;
import "stdlib/io" as io;
import "flex_layout/flex_layout" as flex;
import "facet/facet" as core;
import "facet/props" as props;
import "facet/vocabulary" as vocab;
import "facet/theme" as theme;
import "objc/runtime" as rt;
import "appkit/appkit" as ak;
import "appkit/appkit_ext" as akx;
import "quartzcore/quartzcore" as quartz;

type Node = flex::Node;

// ---- colour resolution -------------------------------------------------------
// Ported from the pre-regen backend; the Color token model is unchanged, so
// only the module qualification moved.
//
// Resolution order: a THEME role (Tier 2, tokens 100..117) first substitutes
// its stored slot from the installed theme — or its platform fallback when the
// app left the role unset. The result is then a Tier-1 platform token (mapped
// to the platform's adaptive NSColor), an `adaptive` light/dark pair (the side
// picked by the CURRENT effective appearance), or an explicit sRGB literal.
// `ink(a)` carries its alpha on the role colour and applies it to whatever the
// role resolved to.
fn ns_color(c: vocab::Color) -> ak::Color {
    var cc: vocab::Color = c;
    // ink(a): remember the mark's alpha before the role substitutes away.
    var mark_alpha: f64 = -1.0f64;
    if { cc.token } == (104 as u32) && { c.a } < 1.0f64 { mark_alpha = { c.a }; }
    if cc.is_theme_role() {
        var slot: vocab::Color = theme::theme_slot({ cc.token });
        if slot.is_set() == false { slot = theme::theme_fallback({ cc.token }); }
        cc = slot;
    }
    var out: ak::Color = ak::Color::label_color();
    let t: u32 = { cc.token };
    if t == (254 as u32) {
        // Adaptive pair: the side for the current appearance.
        if theme::is_dark() {
            out = ak::Color::color_with_red({ cc.r2 }, { cc.g2 }, { cc.b2 }, { cc.a2 });
        } else {
            out = ak::Color::color_with_red({ cc.r }, { cc.g }, { cc.b }, { cc.a });
        }
    }
    else if t == (1 as u32) { out = ak::Color::label_color(); }
    else if t == (2 as u32) { out = ak::Color::secondary_label_color(); }
    else if t == (3 as u32) { out = ak::Color::control_accent_color(); }
    else if t == (4 as u32) { out = ak::Color::system_red_color(); }
    else if t == (5 as u32) { out = ak::Color::system_green_color(); }
    else if t == (6 as u32) { out = ak::Color::system_blue_color(); }
    else if t == (7 as u32) { out = ak::Color::system_orange_color(); }
    else if t == (8 as u32) { out = ak::Color::system_gray_color(); }
    else if t == (9 as u32) { out = ak::Color::tertiary_label_color(); }
    else if t == (10 as u32) { out = ak::Color::separator_color(); }
    else if t == (11 as u32) { out = ak::Color::window_background_color(); }
    else if t == (12 as u32) { out = ak::Color::under_page_background_color(); }
    else if t == (13 as u32) { out = ak::Color::control_background_color(); }
    else if t == (14 as u32) { out = ak::Color::system_fill_color(); }
    else if t == (15 as u32) { out = ak::Color::placeholder_text_color(); }
    else if t == (16 as u32) { out = ak::Color::link_color(); }
    else if t == (17 as u32) { out = ak::Color::selected_content_background_color(); }
    else if t == (18 as u32) { out = ak::Color::selected_text_background_color(); }
    else if t == (19 as u32) { out = ak::Color::secondary_system_fill_color(); }
    else if t == (20 as u32) { out = ak::Color::system_yellow_color(); }
    else if t == (21 as u32) { out = ak::Color::system_purple_color(); }
    else if t == (22 as u32) { out = ak::Color::system_pink_color(); }
    else if t == (23 as u32) { out = ak::Color::system_teal_color(); }
    else if t == (24 as u32) { out = ak::Color::system_indigo_color(); }
    else { out = ak::Color::color_with_red({ cc.r }, { cc.g }, { cc.b }, { cc.a }); }
    if mark_alpha >= 0.0f64 { out = out.color_with_alpha_component(mark_alpha); }
    return out;
}

// ---- does this node get a view? ----------------------------------------------
// A control always does. A plain container does when it carries a KEY, because
// a key is an address: `find("body")` must reach something, the agent surface
// tags it, and set_content needs a host whose native slots it can count. An
// unkeyed pure-layout container gets nothing and passes its children through to
// the nearest host — which is how a column inside a scroll view costs no view.
//
// The fake renderer in facet's suite uses exactly this rule, so the headless
// conformance tests and this backend agree on the shape of the native tree.
fn wants_view(n: *core::Node) -> bool {
    if core::kind_of(n) != core::K_NODE { return true; }
    return { (*n).key() } != "";
}

// ---- create ------------------------------------------------------------------

fn create(ctx: *u8, n: *core::Node) -> *u8 {
    if n == (0 as *core::Node) { return 0 as *u8; }
    if !wants_view(n) { return 0 as *u8; }
    let v: *u8 = create_for_kind(core::kind_of(n), n);
    if v == (0 as *u8) { return 0 as *u8; }
    // The key IS the accessibilityIdentifier. One token, three jobs: facet's
    // address, the agent surface's id, and the platform's a11y id.
    let k: str = { (*n).key() };
    if k != "" {
        ak::Accessibility::from_raw(v).set_accessibility_identifier(k);
    }
    // The shared band applies once, on the view, for every kind.
    apply_common(v, n, 18446744073709551615u64);
    return v;
}

// A plain backing view. FLIPPED, always: every view this backend creates is
// top-left origin, so the frame walk needs no flip math (see geometry.cplus).
// Returned at +1 — mount pairs it with `view_release`, which is the release.
fn backing_view() -> *u8 {
    let v: ak::View = akx::new_flipped_view(rt::Rect { x: 0.0f64, y: 0.0f64, w: 0.0f64, h: 0.0f64 });
    return rt::retain(v.raw());
}

// Per-kind construction. Stage 4 item 2 fills the control arms; item 1 needs
// only the container, and everything else is loudly unimplemented rather than
// silently blank.
fn create_for_kind(kind: u32, n: *core::Node) -> *u8 {
    if kind == core::K_NODE { return backing_view(); }
    unimplemented_kind(kind, n);
    return backing_view();
}

// Say so, once per kind, on stderr. A control that renders as an empty
// rectangle with no word said is the failure this package exists to avoid;
// until item 2 lands, the gap is audible.
static WARNED: [bool; 1100] = #zero::[[bool; 1100]]();

fn unimplemented_kind(kind: u32, n: *core::Node) {
    let idx: usize = kind as usize;
    if idx >= (1100 as usize) { return; }
    if WARNED[idx] { return; }
    WARNED[idx] = true;
    io::eprintln(text::from_str("facet_appkit: kind ")
        .appending(u32_text(kind).view())
        .appending(" has no AppKit body yet (Stage 4 item 2) — it renders as an empty backing view. key: \"")
        .appending({ (*n).key() })
        .appending("\"").view());
    return;
}

fn digit_str(d: u32) -> str {
    if d == (0 as u32) { return "0"; }
    if d == (1 as u32) { return "1"; }
    if d == (2 as u32) { return "2"; }
    if d == (3 as u32) { return "3"; }
    if d == (4 as u32) { return "4"; }
    if d == (5 as u32) { return "5"; }
    if d == (6 as u32) { return "6"; }
    if d == (7 as u32) { return "7"; }
    if d == (8 as u32) { return "8"; }
    return "9";
}

// stdlib's Text has no integer formatter, and a diagnostic is not a reason to
// add one to a package this does not own.
fn u32_text(v: u32) -> text::Text {
    if v == (0 as u32) { return text::from_str("0"); }
    var digits: [u32; 12] = #zero::[[u32; 12]]();
    var n: u32 = v;
    var i: usize = 0 as usize;
    while n > (0 as u32) && i < (12 as usize) {
        digits[i] = n % (10 as u32);
        n = n / (10 as u32);
        i = i +% (1 as usize);
    }
    var out: text::Text = text::new();
    while i > (0 as usize) {
        i = i -% (1 as usize);
        out = out.appending(digit_str(digits[i]));
    }
    return out;
}

// ---- apply -------------------------------------------------------------------

fn apply(ctx: *u8, n: *core::Node) {
    if n == (0 as *core::Node) { return; }
    let v: *u8 = core::view_of(n);
    if v == (0 as *u8) { return; }
    let d: u64 = core::dirty_of(n);
    if d == (0 as u64) { return; }
    apply_common(v, n, d);
    apply_for_kind(core::kind_of(n), v, n, d);
    return;
}

// Stage 4 item 2 fills this; the shared band above already ran.
fn apply_for_kind(kind: u32, v: *u8, n: *core::Node, dirty: u64) {
    return;
}

// ---- the shared band ---------------------------------------------------------
// One place, every kind, on the VIEW. `dirty` names what to re-read; `create`
// passes all-ones so a fresh view is configured whole.

fn apply_common(v: *u8, n: *core::Node, dirty: u64) {
    let view: ak::View = ak::View::from_raw(v);
    // is_visible → hidden. NOT display:none — that is flex's, and it removes
    // the node from layout; this hides a node that still takes its space.
    if (dirty & props::C_IS_VISIBLE) != (0 as u64) {
        view.set_hidden(core::is_visible(n) == false);
    }
    if (dirty & props::C_OPACITY) != (0 as u64) {
        view.set_alpha_value(core::opacity(n));
    }
    if (dirty & props::C_BACKGROUND_COLOR) != (0 as u64) {
        apply_background(view, core::background_color(n));
    }
    if (dirty & props::C_TRANSFORM) != (0 as u64) {
        apply_transform(view, n);
    }
    // Focus and blur are COMMANDS, not state: act on the bit, and the sync
    // walk clears it.
    if (dirty & props::C_FOCUS) != (0 as u64) {
        match view.window() {
            option::Option[ak::Window]::Some(w) => { let _ok: bool = w.make_first_responder(view.as_responder()); }
            option::Option[ak::Window]::None => { }
        }
    }
    if (dirty & props::C_BLUR) != (0 as u64) {
        match view.window() {
            // Resign to the WINDOW, which is what "nothing is focused" is on
            // AppKit — there is no null first responder, and passing nil makes
            // the window refuse the change rather than clear it.
            option::Option[ak::Window]::Some(w) => { let _ok: bool = w.make_first_responder(w.as_responder()); }
            option::Option[ak::Window]::None => { }
        }
    }
    return;
}

// A background needs a layer. `clear()` is the unset colour — leave the view
// layer-free rather than paint it transparent, so a tree that themes nothing
// costs no layers.
fn apply_background(view: ak::View, c: vocab::Color) {
    if c.is_set() == false { return; }
    view.set_wants_layer(true);
    let l: quartz::Layer = view.layer();
    l.set_background_color(ns_color(c).c_g_color());
    return;
}

// CATransform3D is a bare by-value C struct in the binding, with the matrix
// maths living in QuartzCore's own exported functions. Declared here rather
// than grown onto the generated quartzcore module, which the bindgen owns.
extern fn CATransform3DTranslate(t: quartz::Transform3D, tx: f64, ty: f64, tz: f64) -> quartz::Transform3D;
extern fn CATransform3DRotate(t: quartz::Transform3D, angle: f64, x: f64, y: f64, z: f64) -> quartz::Transform3D;
extern fn CATransform3DScale(t: quartz::Transform3D, sx: f64, sy: f64, sz: f64) -> quartz::Transform3D;

// CATransform3DIdentity is a global constant, so it is spelled rather than
// linked: the identity matrix is the identity matrix.
fn transform_identity() -> quartz::Transform3D {
    return quartz::Transform3D {
        m11: 1.0f64, m12: 0.0f64, m13: 0.0f64, m14: 0.0f64,
        m21: 0.0f64, m22: 1.0f64, m23: 0.0f64, m24: 0.0f64,
        m31: 0.0f64, m32: 0.0f64, m33: 1.0f64, m34: 0.0f64,
        m41: 0.0f64, m42: 0.0f64, m43: 0.0f64, m44: 1.0f64,
    };
}

// The nine transform numbers become one CATransform3D on the layer. facet
// gives them one dirty bit for exactly this reason: the backend rebuilds the
// whole transform anyway, so nine bits would buy it nothing.
fn apply_transform(view: ak::View, n: *core::Node) {
    let rot: f64 = core::rotation(n);
    let rx: f64 = core::rotation_x(n);
    let ry: f64 = core::rotation_y(n);
    let sx: f64 = core::scale(n) * core::scale_x(n);
    let sy: f64 = core::scale(n) * core::scale_y(n);
    let tx: f64 = core::translation_x(n);
    let ty: f64 = core::translation_y(n);
    let is_identity: bool = rot == 0.0f64 && rx == 0.0f64 && ry == 0.0f64
        && sx == 1.0f64 && sy == 1.0f64 && tx == 0.0f64 && ty == 0.0f64;
    // An untransformed node stays layer-free: a tree that transforms nothing
    // should pay for no layers.
    if is_identity { return; }
    view.set_wants_layer(true);
    let l: quartz::Layer = view.layer();
    l.set_anchor_point(rt::Point { x: core::anchor_x(n), y: core::anchor_y(n) });
    var m: quartz::Transform3D = transform_identity();
    m = { CATransform3DTranslate(m, tx, ty, 0.0f64) };
    if rot != 0.0f64 { m = { CATransform3DRotate(m, radians(rot), 0.0f64, 0.0f64, 1.0f64) }; }
    if rx != 0.0f64 { m = { CATransform3DRotate(m, radians(rx), 1.0f64, 0.0f64, 0.0f64) }; }
    if ry != 0.0f64 { m = { CATransform3DRotate(m, radians(ry), 0.0f64, 1.0f64, 0.0f64) }; }
    m = { CATransform3DScale(m, sx, sy, 1.0f64) };
    l.set_transform(m);
    return;
}

fn radians(degrees: f64) -> f64 { return degrees * 3.14159265358979323846f64 / 180.0f64; }

// ---- insert / remove ---------------------------------------------------------
// Native children under a host view, in facet's child order. `slot` is the
// index among the views facet has put in this host — mount computes it, and
// mount::insert_child computes it for a live edit.

fn insert(ctx: *u8, host: *u8, child: *u8, slot: usize) {
    if host == (0 as *u8) { return; }
    if child == (0 as *u8) { return; }
    let h: ak::View = ak::View::from_raw(host);
    let c: ak::View = ak::View::from_raw(child);
    let subs: vec::Vec[ak::View] = h.subviews();
    if slot >= subs.count() {
        h.add_subview(c);
        return;
    }
    // AppKit has no insertSubview:atIndex:. `positioned:Below relativeTo:` the
    // view currently occupying the slot puts it exactly there.
    match subs.at_ptr(slot) {
        option::Option[*ak::View]::Some(at) => {
            h.add_subview_positioned(c, ak::WindowOrderingMode::NSWindowBelow, ak::View::from_raw({ (*at).raw() }));
        }
        option::Option[*ak::View]::None => { h.add_subview(c); }
    }
    return;
}

fn remove(ctx: *u8, host: *u8, child: *u8) {
    if child == (0 as *u8) { return; }
    ak::View::from_raw(child).remove_from_superview();
    return;
}

// M1: the release mount pairs with every view `create` returned. Node teardown
// fires it, so a dropped tree cannot leak its views.
fn view_release(v: *u8) {
    if v == (0 as *u8) { return; }
    { rt::release(v) };
    return;
}
