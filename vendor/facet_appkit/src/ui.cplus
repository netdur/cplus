#[test]
fn clickable_wraps_a_leaf_without_clobbering_its_view() {
    // A leaf owns its own view; wrapping nests it under a fresh backing view.
    var leaf: flex::Node = label("x");
    assert leaf.payload() != (0 as *u8);
    var c: flex::Node = clickable(leaf, on_click: t_clickable_handler);
    assert c.payload() != (0 as *u8);
    assert c.child_count() == (1 as usize);
}

// The agnostic tree API: build a model with tree_node/tree_add_child (no
// filesystem involved), then mount it with `tree(root)`. Also pins down that
// `tree_add_child` really mutates the heap-boxed parent through its pointer.
#[test]
fn tree_builder_adds_children_and_mounts() {
    let root: *TreeNode = tree_node("proj", "/proj", true);
    tree_add_child(root, tree_node("a.cplus", "/proj/a.cplus", false));
    tree_add_child(root, tree_node("sub", "/proj/sub", true));
    // append-through-pointer must actually mutate the node (item == nil ⇒ root).
    assert tree_num_children_imp(root as *u8, 0 as *u8, 0 as *u8) == (2 as i64);
    // child 0 is the leaf; its opaque item (a wrapper object) round-trips to the path.
    let c0: *u8 = tree_child_imp(root as *u8, 0 as *u8, 0 as i64, 0 as *u8);
    assert tree_node_path(c0).equals("/proj/a.cplus");
    // a branch is expandable, a leaf is not — items are wrappers, so unwrap-safe.
    assert tree_expandable_imp(0 as *u8, 0 as *u8, { (*root).item }) == (1 as i8);
    assert tree_expandable_imp(0 as *u8, 0 as *u8, c0) == (0 as i8);
    // mounting a caller-built tree yields a real backing view.
    let n: flex::Node = tree(root, agent_id: "proj-tree");
    assert n.payload() != (0 as *u8);
    return;
}

// Regression (bug 2026-07-13): NSOutlineView MESSAGES its items on a key-state
// change, so an item MUST be an objc object — a raw `*TreeNode` faults the moment
// the outline reads its "isa". This pins down that the item crossing the outline
// boundary is a real, STABLE wrapper object that unwraps back to the node.
#[test]
fn tree_items_are_stable_objc_wrappers() {
    let root: *TreeNode = tree_node("proj", "/proj", true);
    let leaf: *TreeNode = tree_node("a.cplus", "/proj/a.cplus", false);
    tree_add_child(root, leaf);

    // The item handed to / returned from the outline is the wrapper, NOT the raw
    // node pointer (whose first word is a `char*`, fatal to message).
    let it0: *u8 = tree_child_imp(root as *u8, 0 as *u8, 0 as i64, 0 as *u8);
    assert it0 != (0 as *u8);
    assert it0 != { leaf as *u8 };
    assert it0 == { (*leaf).item };

    // One wrapper per node, reused: identical pointer every call (the identity
    // NSOutlineView caches its items by).
    let it1: *u8 = tree_child_imp(root as *u8, 0 as *u8, 0 as i64, 0 as *u8);
    assert it0 == it1;

    // It is a genuine objc object — safe to message (this IS the crashing path):
    // it answers -isKindOfClass:NSValue and unwraps back to the node's path.
    let nsvalue_cls: *u8 = rt::get_class(#str_ptr("NSValue\0"));
    assert rt::msg_i8_id(it0, rt::sel(#str_ptr("isKindOfClass:\0")), nsvalue_cls) != (0 as i8);
    assert { tree_unwrap(it0) as *u8 } == { leaf as *u8 };
    assert tree_node_path(it0).equals("/proj/a.cplus");
    return;
}

// The live reproduction of the crash, headless. Mount a real NSOutlineView via
// `tree(...)`, then drive the EXACT path the crash stack shows: `reloadData` →
// `numberOfRows` → `itemAtRow:`. `itemAtRow:` runs `loadItemEntryLazyInfoIfNecessary`,
// which inserts each visible item into an internal map with object semantics —
// MESSAGING it (probeGC/retain/hash). With raw `*TreeNode` items this faults on
// the first row (its label `char*` read as an isa); with wrappers it is safe. We
// then message every item ourselves (as `_dirtyVisibleCellsForKeyStateChange`
// does on activation) to be doubly sure. No window/run-loop needed — expanding
// and counting rows forces the lazy item map that carried the fault.
#[test]
fn tree_live_outline_itematrow_messages_items_safely() {
    let root: *TreeNode = tree_node("proj", "/proj", true);
    tree_add_child(root, tree_node("a.cplus", "/proj/a.cplus", false));
    tree_add_child(root, tree_node("b.cplus", "/proj/b.cplus", false));
    let sub: *TreeNode = tree_node("sub", "/proj/sub", true);
    tree_add_child(sub, tree_node("c.cplus", "/proj/sub/c.cplus", false));
    tree_add_child(root, sub);

    let n: flex::Node = tree(root, agent_id: "live-tree");
    // node payload is the scroll view; its documentView is the NSOutlineView.
    let ov: *u8 = { rt::msg_id(n.payload(), rt::sel(#str_ptr("documentView\0"))) };
    assert ov != (0 as *u8);

    // Load rows, then expand the whole tree (nil + expandChildren:YES), forcing
    // the lazy row/item map that carried the fault.
    { rt::msg_void(ov, rt::sel(#str_ptr("reloadData\0"))); }
    rt::msg_void_id_i8(ov, rt::sel(#str_ptr("expandItem:expandChildren:\0")), 0 as *u8, 1 as i8);
    let rows: i64 = { rt::msg_i64(ov, rt::sel(#str_ptr("numberOfRows\0"))) };
    assert rows > (0 as i64);   // top-level rows are populated headlessly

    // Message every visible item, exactly as the key-state walk does. If any item
    // were a raw pointer, `itemAtRow:` above would already have faulted.
    let nsvalue_cls: *u8 = rt::get_class(#str_ptr("NSValue\0"));
    var r: i64 = 0 as i64;
    while r < rows {
        let it: *u8 = { rt::msg_id_i64(ov, rt::sel(#str_ptr("itemAtRow:\0")), r) };
        assert it != (0 as *u8);
        assert rt::msg_i8_id(it, rt::sel(#str_ptr("isKindOfClass:\0")), nsvalue_cls) != (0 as i8);
        assert { tree_unwrap(it) as *u8 } != (0 as *u8);              // recovers a node
        assert tree_node_path(it).count() > (0 as usize);            // node has a path
        r = r +% (1 as i64);
    }
    return;
}

#[test]
fn test_text_area_applies_inset() {
    let n: flex::Node = text_area(value: "x", inset_w: 10.0f64, inset_h: 8.0f64);
    assert n.has_payload();
    let ins: rt::Size = area_inset(n.payload());
    assert ins.w == (10.0f64);
    assert ins.h == (8.0f64);
}

#[test]
fn test_text_area_default_inset_is_zero() {
    let n: flex::Node = text_area(value: "x");
    let ins: rt::Size = area_inset(n.payload());
    assert ins.w == (0.0f64);
    assert ins.h == (0.0f64);
}

#[test]
fn image_missing_file_degrades_to_blank_view() {
    // A bad asset path used to abort the app: +[NSImageView imageViewWithImage:]
    // throws "image != nil" on the nil NSImage a missing file yields. It must now
    // degrade to a blank image view — REACHING this assert at all proves the
    // process did not abort, and the node still carries a real NSImageView payload.
    let n: flex::Node = image("/no/such/dir/definitely-missing-asset.png");
    assert n.has_payload();
    let is_iv: i8 = rt::msg_i8_id(n.payload(), rt::sel(#str_ptr("isKindOfClass:\0")), rt::get_class(#str_ptr("NSImageView\0")));
    assert is_iv != (0 as i8);
}

#[test]
fn test_bordered_wraps_content_with_backing_view() {
    // Own bordered backing view + content nested inside it.
    let n: flex::Node = bordered(label("boxed"), agent_id: "the-box");
    assert n.has_payload();
    assert n.child_count() == (1 as usize);
    assert ak::Accessibility::from_raw(n.payload()).accessibility_identifier().equals("the-box");
}

#[test]
fn test_bordered_suppresses_focus_ring() {
    // A layer-backed container must never host a focus ring: a borderless
    // focused control inside it would otherwise draw its ring on this ancestor,
    // framing the whole box. The backing view is FocusRingType::None.
    let n: flex::Node = bordered(label("boxed"));
    let got: i64 = ak::focus_ring_type_raw(ak::View::from_raw(n.payload()).focus_ring_type());
    assert got == ak::focus_ring_type_raw(ak::FocusRingType::None);
    return;
}

#[test]
fn test_material_suppresses_focus_ring() {
    // Same rule for the vibrancy container (a visual-effect view is layer-backed).
    let n: flex::Node = material(label("panel"));
    let got: i64 = ak::focus_ring_type_raw(ak::View::from_raw(n.payload()).focus_ring_type());
    assert got == ak::focus_ring_type_raw(ak::FocusRingType::None);
    return;
}

#[test]
fn test_composer_borderless_still_reads_text() {
    // The boxed-layout variant: no own bezel, but still a working input.
    let n: flex::Node = composer(on_submit: test_noop_action, value: "hi", show_border: false);
    assert n.has_payload();
    assert area_text(n.payload()).equals("hi");
}

#[test]
fn test_composer_transparent_clears_both_backgrounds() {
    // `draws_background: false` must clear the fill on BOTH layers — the
    // scroll view and its document text view — or a filled rectangle still
    // shows inside an outer bordered() box. Text keeps working.
    let n: flex::Node = composer(on_submit: test_noop_action, value: "hi", show_border: false, draws_background: false);
    assert n.has_payload();
    let sv: ak::ScrollView = ak::ScrollView::from_raw(n.payload());
    assert !sv.draws_background();
    match sv.document_view() {
        option::Option[ak::View]::Some(dv) => {
            assert !ak::TextView::from_raw(dv.raw()).draws_background();
        }
        option::Option[ak::View]::None => { assert false; }
    }
    assert area_text(n.payload()).equals("hi");
}

#[test]
fn test_composer_default_keeps_backgrounds() {
    // The knob must not regress the normal composer: by default both the
    // scroll view and the text view keep their filled background.
    let n: flex::Node = composer(on_submit: test_noop_action, value: "hi");
    let sv: ak::ScrollView = ak::ScrollView::from_raw(n.payload());
    assert sv.draws_background();
    match sv.document_view() {
        option::Option[ak::View]::Some(dv) => {
            assert ak::TextView::from_raw(dv.raw()).draws_background();
        }
        option::Option[ak::View]::None => { assert false; }
    }
    return;
}

// ---- zoom: the per-host magnification registry + zoomed slot layout ---------

static ZOOM_PANE_KEY: i32 = 0;

fn zoom_pane_render(cp: *u8) -> flex::Node {
    var b: Builder = Builder::new();
    b.add(wrap_label("The quick brown fox jumps over the lazy dog while the lazy dog wonders why the fox keeps wrapping to the pane width.", size: 12.0f64));
    return column(b);
}

fn zoom_test_subview(host_ptr: *u8) -> *u8 {
    var subs: vec::Vec[ak::View] = ak::View::from_raw(host_ptr).subviews();
    match subs.at_ptr(0 as usize) {
        option::Option[*ak::View]::Some(vp) => { return { (*vp).raw() }; }
        option::Option[*ak::View]::None => { return 0 as *u8; }
    }
}

#[test]
fn test_zoom_clamp_origin_bounds_the_pan() {
    // In range passes through; past the span clamps; negative/NaN collapse to 0.
    assert zoom_clamp_origin(50.0f64, 400.0f64, 200.0f64) == 50.0f64;
    assert zoom_clamp_origin(999.0f64, 400.0f64, 200.0f64) == 200.0f64;
    assert zoom_clamp_origin(-5.0f64, 400.0f64, 200.0f64) == 0.0f64;
    var zero: f64 = 0.0f64;
    assert zoom_clamp_origin(zero / zero, 400.0f64, 200.0f64) == 0.0f64;
    // Zoom 1 (span 0): any desire resets to exactly 0.
    assert zoom_clamp_origin(120.0f64, 400.0f64, 400.0f64) == 0.0f64;
    // Zoomed out (visible > content): centered, nothing to pan.
    assert zoom_clamp_origin(50.0f64, 400.0f64, 800.0f64) == -200.0f64;
}

#[test]
fn test_set_zoom_rejects_bad_factors() {
    unmount_all();
    let host = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 400.0, h: 300.0 });
    var zero: f64 = 0.0f64;
    assert set_zoom(host.raw(), 0.0f64) == false;
    assert set_zoom(host.raw(), -2.0f64) == false;
    assert set_zoom(host.raw(), zero / zero) == false;   // NaN
    assert set_zoom(0 as *u8, 2.0f64) == false;
    // None of the rejects registered anything: natural size, bounds untouched.
    assert zoom_of(host.raw()) == 1.0f64;
    assert approx(host.bounds().w, 400.0f64);
    // A valid factor applies on the spot — no relayout involved.
    assert set_zoom(host.raw(), 2.0f64);
    assert zoom_of(host.raw()) == 2.0f64;
    assert approx(host.bounds().w, 200.0f64);
    // A wild origin clamps into the content; a NaN origin collapses to 0.
    assert set_zoom(host.raw(), 2.0f64, origin_x: 999.0f64, origin_y: -5.0f64);
    assert approx(host.bounds().x, 200.0f64);
    assert approx(host.bounds().y, 0.0f64);
    unmount_all();   // teardown clears the zoom registry too
    assert zoom_of(host.raw()) == 1.0f64;
}

#[test]
fn e2e_zoom_scales_the_view_without_reflow() {
    unmount_all();
    let host = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 400.0, h: 300.0 });
    let cp: *u8 = #addr_of(ZOOM_PANE_KEY) as *u8;
    let h1: f64 = mount(zoom_pane_render, ctx: cp, host: host.raw());
    assert h1 > 0.0f64;
    // An unzoomed host's coordinate space is never touched.
    assert approx(host.bounds().w, 400.0f64);
    let before: *u8 = zoom_test_subview(host.raw());
    assert before != (0 as *u8);
    let f1: rt::Rect = ak::View::from_raw(before).frame();

    // Zoom ×2 with the top-left cut visible (origin_y = the top in AppKit's
    // bottom-up space): the bounds become a 200×150 window onto the SAME
    // 400-wide layout — the frame and the wrap width don't move.
    assert set_zoom(host.raw(), 2.0f64, origin_y: 150.0f64);
    assert approx(host.bounds().w, 200.0f64);
    assert approx(host.bounds().h, 150.0f64);
    assert approx(host.bounds().x, 0.0f64);
    assert approx(host.bounds().y, 150.0f64);
    assert approx(host.frame().w, 400.0f64);   // the window-facing frame is untouched
    // THE no-reflow proof: same view, bit-identical frame — no rewrap, no move.
    let after: *u8 = zoom_test_subview(host.raw());
    assert after == before;
    let f2: rt::Rect = ak::View::from_raw(after).frame();
    assert approx(f2.w, f1.w);
    assert approx(f2.h, f1.h);
    assert approx(f2.x, f1.x);
    assert approx(f2.y, f1.y);

    // The resize path (relayout) keeps the zoom: layout runs at the NATURAL
    // frame and the scaled bounds are re-asserted — still no reflow.
    assert relayout(cp);
    assert approx(host.bounds().w, 200.0f64);
    assert approx(host.bounds().y, 150.0f64);
    let f3: rt::Rect = ak::View::from_raw(after).frame();
    assert approx(f3.h, f1.h);

    // Back to natural size: the coordinate space restores exactly.
    assert set_zoom(host.raw(), 1.0f64);
    assert approx(host.bounds().w, 400.0f64);
    assert approx(host.bounds().h, 300.0f64);
    assert approx(host.bounds().x, 0.0f64);
    assert approx(host.bounds().y, 0.0f64);
    unmount_all();
}

static TREE_SEL_HITS: i32 = 0;
fn tree_sel_probe(item: *u8, ctx: *u8) { TREE_SEL_HITS = TREE_SEL_HITS + 1; return; }

#[test]
fn tree_deselect_clears_selection_without_firing_on_select() {
    let root: *TreeNode = tree_node("proj", "/proj", true);
    let child: *TreeNode = tree_node("main.cplus", "/proj/main.cplus", false);
    tree_add_child(root, child);
    TREE_SEL_HITS = 0;
    var n: flex::Node = tree(root, on_select: tree_sel_probe);
    let scroll_raw: *u8 = n.payload();
    let ov: *u8 = { rt::msg_id(scroll_raw, rt::sel(#str_ptr("documentView\0"))) };

    // Programmatic select of row 0. byExtendingSelection's BOOL rides the id
    // slot as 0 (NO) — same register, test-only send.
    let ixset: *u8 = rt::msg_id_i64(rt::get_class(#str_ptr("NSIndexSet\0")), rt::sel(#str_ptr("indexSetWithIndex:\0")), 0 as i64);
    rt::msg_void_id_id(ov, rt::sel(#str_ptr("selectRowIndexes:byExtendingSelection:\0")), ixset, 0 as *u8);
    assert { rt::msg_i64(ov, rt::sel(#str_ptr("selectedRow\0"))) } == (0 as i64);
    let hits_after_select: i32 = TREE_SEL_HITS;

    // Deselect through the SCROLL host — the view a facet handle returns.
    tree_deselect(scroll_raw);
    assert { rt::msg_i64(ov, rt::sel(#str_ptr("selectedRow\0"))) } == (-1 as i64);
    assert TREE_SEL_HITS == hits_after_select;
    return;
}

#[test]
fn tree_select_path_reveals_selects_and_stays_silent() {
    // root/proj > src (collapsed dir) > deep.cplus — the reveal must expand
    // src, select the nested row, and fire NO on_select.
    let root: *TreeNode = tree_node("proj", "/proj", true);
    let dir: *TreeNode = tree_node("src", "/proj/src", true);
    let leaf: *TreeNode = tree_node("deep.cplus", "/proj/src/deep.cplus", false);
    tree_add_child(dir, leaf);
    tree_add_child(root, dir);
    TREE_SEL_HITS = 0;
    var n: flex::Node = tree(root, on_select: tree_sel_probe);
    let scroll_raw: *u8 = n.payload();
    let ov: *u8 = { rt::msg_id(scroll_raw, rt::sel(#str_ptr("documentView\0"))) };

    // Nested leaf is not materialized yet (its folder is collapsed).
    assert { rt::msg_i64_id(ov, rt::sel(#str_ptr("rowForItem:\0")), { (*leaf).item }) } == (-1 as i64);

    tree_select_path(scroll_raw, "/proj/src/deep.cplus");
    let row: i64 = rt::msg_i64_id(ov, rt::sel(#str_ptr("rowForItem:\0")), { (*leaf).item });
    assert row >= (0 as i64);
    assert { rt::msg_i64(ov, rt::sel(#str_ptr("selectedRow\0"))) } == row;
    assert TREE_SEL_HITS == 0;   // the reveal never fired on_select

    // Unknown path and empty path: selection untouched, still silent.
    tree_select_path(scroll_raw, "/proj/nope.cplus");
    assert { rt::msg_i64(ov, rt::sel(#str_ptr("selectedRow\0"))) } == row;
    tree_select_path(scroll_raw, "");
    assert { rt::msg_i64(ov, rt::sel(#str_ptr("selectedRow\0"))) } == row;
    assert TREE_SEL_HITS == 0;

    // And the deselect pairing still works after a programmatic reveal.
    tree_deselect(scroll_raw);
    assert { rt::msg_i64(ov, rt::sel(#str_ptr("selectedRow\0"))) } == (-1 as i64);
    assert TREE_SEL_HITS == 0;
    return;
}

// --- expansion state -------------------------------------------------------

// /proj > src > nested (both dirs, nested holds a leaf), plus a top-level leaf.
// Three levels is the minimum that distinguishes "expand the target" from
// "reveal the target's ancestors" and exercises the depth-first collect order.
fn tree_expansion_fixture() -> *TreeNode {
    let root: *TreeNode = tree_node("proj", "/proj", true);
    let src: *TreeNode = tree_node("src", "/proj/src", true);
    let nested: *TreeNode = tree_node("nested", "/proj/src/nested", true);
    tree_add_child(nested, tree_node("deep.cplus", "/proj/src/nested/deep.cplus", false));
    tree_add_child(src, nested);
    tree_add_child(root, src);
    tree_add_child(root, tree_node("README.md", "/proj/README.md", false));
    return root;
}

// The wrapper item for a path, or nil. (`tree_find_chain` is the same walk the
// verbs do; this just takes its head.)
fn tree_item_for_path(root: *TreeNode, path: str) -> *u8 {
    var chain: vec::Vec[*u8] = vec::new::[*u8]();
    if tree_find_chain(root, path, #addr_of(chain)) == false { return 0 as *u8; }
    return match chain.at(0 as usize) {
        option::Option[*u8]::Some(it) => it,
        option::Option[*u8]::None => 0 as *u8,
    };
}

fn tree_paths_contains(ref paths: vec::Vec[text::Text], want: str) -> bool {
    let n: usize = paths.count();
    var i: usize = 0 as usize;
    while i < n {
        match paths.at_ptr(i) {
            option::Option[*text::Text]::Some(tp) => {
                if { (*tp).equals(want) } { return true; }
            }
            option::Option[*text::Text]::None => { }
        }
        i = i +% (1 as usize);
    }
    return false;
}

// A fresh tree reports nothing expanded, and `tree_expand_path` opens the
// target ITSELF (not merely its ancestors, which is all the reveal in
// `tree_select_path` does) — read back through the scroll host a handle returns.
#[test]
fn tree_expand_path_opens_the_target_and_is_readable() {
    let root: *TreeNode = tree_expansion_fixture();
    var n: flex::Node = tree(root);
    let scroll_raw: *u8 = n.payload();

    var none: vec::Vec[text::Text] = tree_expanded_paths(scroll_raw);
    assert none.count() == (0 as usize);

    tree_expand_path(scroll_raw, "/proj/src");
    var one: vec::Vec[text::Text] = tree_expanded_paths(scroll_raw);
    assert one.count() == (1 as usize);
    assert tree_paths_contains(one, "/proj/src");
    assert tree_paths_contains(one, "/proj/src/nested") == false;
    return;
}

// Expanding a nested branch from a fully collapsed tree opens its ancestors
// too, so the deep row materializes — the property that lets a saved list be
// replayed in any order. Reported parents-before-children.
#[test]
fn tree_expand_path_expands_ancestors_and_reports_depth_first() {
    let root: *TreeNode = tree_expansion_fixture();
    var n: flex::Node = tree(root);
    let scroll_raw: *u8 = n.payload();
    let ov: *u8 = { rt::msg_id(scroll_raw, rt::sel(#str_ptr("documentView\0"))) };

    tree_expand_path(scroll_raw, "/proj/src/nested");
    var paths: vec::Vec[text::Text] = tree_expanded_paths(scroll_raw);
    assert paths.count() == (2 as usize);
    // Parent before child: the restore replay depends on this order holding
    // even though `tree_expand_path` no longer needs it.
    match paths.at_ptr(0 as usize) {
        option::Option[*text::Text]::Some(tp) => { assert { (*tp).equals("/proj/src") }; }
        option::Option[*text::Text]::None => { assert false; }
    }
    match paths.at_ptr(1 as usize) {
        option::Option[*text::Text]::Some(tp) => { assert { (*tp).equals("/proj/src/nested") }; }
        option::Option[*text::Text]::None => { assert false; }
    }
    // Both ancestors open ⇒ the leaf two levels down has a real row.
    let leaf_row: i64 = rt::msg_i64_id(ov, rt::sel(#str_ptr("rowForItem:\0")), tree_item_for_path(root, "/proj/src/nested/deep.cplus"));
    assert leaf_row >= (0 as i64);
    return;
}

// Collapse closes the target and leaves its ancestors open; the branch's own
// children keep their state, so expanding it again restores them unchanged.
#[test]
fn tree_collapse_path_closes_one_branch_and_round_trips() {
    let root: *TreeNode = tree_expansion_fixture();
    var n: flex::Node = tree(root);
    let scroll_raw: *u8 = n.payload();

    tree_expand_path(scroll_raw, "/proj/src/nested");
    assert tree_expanded_paths(scroll_raw).count() == (2 as usize);

    // Close the CHILD: the parent stays open, so one branch remains.
    tree_collapse_path(scroll_raw, "/proj/src/nested");
    var after: vec::Vec[text::Text] = tree_expanded_paths(scroll_raw);
    assert after.count() == (1 as usize);
    assert tree_paths_contains(after, "/proj/src");

    // Reopening it brings the child's own state back — lossless round trip.
    tree_expand_path(scroll_raw, "/proj/src/nested");
    assert tree_expanded_paths(scroll_raw).count() == (2 as usize);
    return;
}

// The save/restore pairing iris needs: read the set, collapse everything (the
// "reopened app" state), replay the saved set, and land on exactly what was
// saved. Restore must also SUBTRACT — a branch opened after the save is closed
// by the restore, or the set would only ever grow.
#[test]
fn tree_set_expanded_paths_restores_exactly_the_saved_set() {
    let root: *TreeNode = tree_expansion_fixture();
    var n: flex::Node = tree(root);
    let scroll_raw: *u8 = n.payload();

    tree_expand_path(scroll_raw, "/proj/src/nested");
    var saved: vec::Vec[text::Text] = tree_expanded_paths(scroll_raw);
    assert saved.count() == (2 as usize);

    // "Reopened": nothing is expanded.
    rt::msg_void_id_i8(tree_outline(scroll_raw), rt::sel(#str_ptr("collapseItem:collapseChildren:\0")), 0 as *u8, 1 as i8);
    assert tree_expanded_paths(scroll_raw).count() == (0 as usize);

    tree_set_expanded_paths(scroll_raw, saved);
    var restored: vec::Vec[text::Text] = tree_expanded_paths(scroll_raw);
    assert restored.count() == (2 as usize);
    assert tree_paths_contains(restored, "/proj/src");
    assert tree_paths_contains(restored, "/proj/src/nested");

    // Restore SUBTRACTS: with only the parent saved, the child must close.
    var just_parent: vec::Vec[text::Text] = vec::new::[text::Text]();
    just_parent.append(text::from_str("/proj/src"));
    tree_set_expanded_paths(scroll_raw, just_parent);
    var narrowed: vec::Vec[text::Text] = tree_expanded_paths(scroll_raw);
    assert narrowed.count() == (1 as usize);
    assert tree_paths_contains(narrowed, "/proj/src");
    return;
}

// Negative cases. Every verb is a no-op on a null view, a non-tree view, an
// unknown path, "" and a LEAF — a restore replaying a list saved before files
// moved must not fault or half-apply. `tree_expanded_paths` returns empty
// rather than faulting on a view that was never a tree.
#[test]
fn tree_expansion_verbs_are_no_ops_on_bad_input() {
    let root: *TreeNode = tree_expansion_fixture();
    var n: flex::Node = tree(root);
    let scroll_raw: *u8 = n.payload();
    tree_expand_path(scroll_raw, "/proj/src");
    let baseline: usize = tree_expanded_paths(scroll_raw).count();
    assert baseline == (1 as usize);

    // Null view.
    tree_expand_path(0 as *u8, "/proj/src");
    tree_collapse_path(0 as *u8, "/proj/src");
    assert tree_expanded_paths(0 as *u8).count() == (0 as usize);

    // A real view that is not a tree — no pinned root, so no walk to do.
    let plain: ak::View = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 10.0, h: 10.0 });
    tree_expand_path(plain.raw(), "/proj/src");
    tree_collapse_path(plain.raw(), "/proj/src");
    assert tree_expanded_paths(plain.raw()).count() == (0 as usize);

    // Empty, unknown, and leaf paths against a real tree: state unchanged.
    tree_expand_path(scroll_raw, "");
    tree_expand_path(scroll_raw, "/proj/nope");
    tree_expand_path(scroll_raw, "/proj/README.md");        // leaf: not expandable
    tree_collapse_path(scroll_raw, "");
    tree_collapse_path(scroll_raw, "/proj/nope");
    tree_collapse_path(scroll_raw, "/proj/README.md");
    assert tree_expanded_paths(scroll_raw).count() == baseline;

    // A restore list of stale paths collapses everything and expands nothing —
    // it must not fault, and it must not silently keep the old set either.
    var stale: vec::Vec[text::Text] = vec::new::[text::Text]();
    stale.append(text::from_str("/proj/moved"));
    stale.append(text::from_str("/proj/src/gone"));
    tree_set_expanded_paths(scroll_raw, stale);
    assert tree_expanded_paths(scroll_raw).count() == (0 as usize);

    // Restoring an empty set onto a null / non-tree view is also a no-op.
    tree_set_expanded_paths(0 as *u8, vec::new::[text::Text]());
    tree_set_expanded_paths(plain.raw(), vec::new::[text::Text]());
    return;
}

// Expansion never touches selection, and selection never touches the reported
// expansion set: `tree_select_path` reveals ancestors (which IS expansion, and
// must show up), while `tree_expand_path` leaves the selected row alone.
#[test]
fn tree_expansion_and_selection_stay_independent() {
    let root: *TreeNode = tree_expansion_fixture();
    TREE_SEL_HITS = 0;
    var n: flex::Node = tree(root, on_select: tree_sel_probe);
    let scroll_raw: *u8 = n.payload();
    let ov: *u8 = { rt::msg_id(scroll_raw, rt::sel(#str_ptr("documentView\0"))) };

    // A reveal expands the ancestors it walked — visible to the reader.
    tree_select_path(scroll_raw, "/proj/src/nested/deep.cplus");
    let row: i64 = { rt::msg_i64(ov, rt::sel(#str_ptr("selectedRow\0"))) };
    assert row >= (0 as i64);
    var after_reveal: vec::Vec[text::Text] = tree_expanded_paths(scroll_raw);
    assert after_reveal.count() == (2 as usize);

    // Expanding and collapsing does not disturb the selection, and stays silent.
    // Collapsing a branch that CONTAINS the selection drops the selected row,
    // and NSOutlineView clears the selection rather than moving it to the
    // branch. That is native behaviour, not something these verbs choose — and
    // it is why a restore must set expansion BEFORE selection (see the note on
    // `tree_set_expanded_paths`). Still silent: `tree_selection_imp` returns on
    // `row < 0`, so the app sees no phantom "selected nothing" event.
    tree_collapse_path(scroll_raw, "/proj/src/nested");
    assert { rt::msg_i64(ov, rt::sel(#str_ptr("selectedRow\0"))) } == (-1 as i64);
    assert TREE_SEL_HITS == 0;

    // An UNRELATED branch is the real independence case: select the top-level
    // leaf, then expand a branch that does not contain it. The selected ITEM
    // survives (its row INDEX shifts as rows appear above it, which is why this
    // compares items, not indices), and nothing fires.
    tree_select_path(scroll_raw, "/proj/README.md");
    let readme: *u8 = tree_item_for_path(root, "/proj/README.md");
    tree_expand_path(scroll_raw, "/proj/src/nested");
    let sel_row: i64 = { rt::msg_i64(ov, rt::sel(#str_ptr("selectedRow\0"))) };
    assert sel_row >= (0 as i64);
    assert { rt::msg_id_i64(ov, rt::sel(#str_ptr("itemAtRow:\0")), sel_row) } == readme;
    assert TREE_SEL_HITS == 0;
    return;
}
