#[test]
fn test_text_area_editable_flag_controls_readonly() {
    // `editable: false` makes the inner NSTextView a read-only viewer.
    let ro: flex::Node = text_area(value: "log", editable: false);
    match ak::ScrollView::from_raw(ro.payload()).document_view() {
        option::Option[ak::View]::Some(dv) => { assert ak::TextView::from_raw(dv.raw()).is_editable() == false; }
        option::Option[ak::View]::None => { assert false; }
    };
    let rw: flex::Node = text_area(value: "log");   // default editable
    match ak::ScrollView::from_raw(rw.payload()).document_view() {
        option::Option[ak::View]::Some(dv) => { assert ak::TextView::from_raw(dv.raw()).is_editable(); }
        option::Option[ak::View]::None => { assert false; }
    };
}

#[test]
fn test_text_area_chrome_threads_inset() {
    // The borderless / transparent / inset transcript config; the inset reaches
    // the inner NSTextView (border+background follow the composer-proven path).
    let t: flex::Node = text_area(value: "log", editable: false, show_border: false, draws_background: false, inset_w: 8.0f64, inset_h: 8.0f64);
    let ins: rt::Size = area_inset(t.payload());
    assert approx(ins.w, 8.0f64);
    assert approx(ins.h, 8.0f64);
    let d: flex::Node = text_area(value: "x");   // default: no inset
    assert approx(area_inset(d.payload()).w, 0.0f64);
}

fn life_test_render(cp: *u8) -> flex::Node { return label("x"); }

#[test]
fn test_remount_replaces_slot_and_unmount_drops_one() {
    unmount_all();
    let a = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 100.0, h: 40.0 });
    let b = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 100.0, h: 40.0 });
    let cp: *u8 = 7 as *u8;   // a sentinel component identity
    let _h1: f64 = mount(life_test_render, ctx: cp, host: a.raw());
    let _h2: f64 = mount(life_test_render, ctx: cp, host: b.raw());   // re-mount same cp
    // Exactly one live slot for cp, targeting the SECOND host (not the stale first).
    var cnt: usize = 0 as usize;
    var host_for_cp: *u8 = 0 as *u8;
    let n: usize = SLOTS.count();
    var i: usize = 0 as usize;
    while i < n {
        match SLOTS.at_ptr(i) {
            option::Option[*Slot]::Some(sp) => {
                if { (*sp)._cp } == cp { cnt = cnt +% (1 as usize); host_for_cp = { (*sp)._host }; }
            }
            option::Option[*Slot]::None => { }
        }
        i = i +% (1 as usize);
    }
    assert cnt == (1 as usize);
    assert host_for_cp == b.raw();
    // relayout finds the fresh slot; unmount drops exactly one; the rest no-op.
    assert relayout(cp);
    assert unmount(cp);
    assert unmount(cp) == false;
    assert relayout(cp) == false;
    unmount_all();
}

