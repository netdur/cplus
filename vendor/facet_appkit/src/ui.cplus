// facet_appkit/ui — the view-bearing AppKit layer over the flex_layout engine,
// and a `@`-DSL context in which layout containers and widgets are peers:
//
//   import "facet_appkit/ui" as ui;
//
//   var tree: flex::Node = @ui {
//       screen {
//           label("Iris", size: 28.0f64, bold: true)
//           hstack {
//               button("New Project", on: cb, primary: true)
//               button("Open Project", on: cb)
//           }
//       }
//   };
//   tree.calculate_layout(800.0f64, flex::undefined(), flex::Direction::LTR);
//   ui::apply(#addr_of(tree), content.raw(), false);
//
// Every widget constructor returns a `flex::Node` that OWNS its NSView
// through the engine's payload slot (released exactly once when the node
// drops or is replaced); content sizing goes through the engine's measure
// callback. `apply` builds a real nested NSView tree from the computed
// frames, converting flex's absolute top-down coordinates into AppKit's
// superview-relative bottom-up ones. `fill_scroll` packages the two-phase
// scroll layout (outer pass sizes the viewport, second pass lays rows into
// a flipped document view).

import "objc/runtime" as rt;
import "objc/bridge" as bridge;
import "objc/synthesis" as synth;
import "stdlib/option" as option;
import "stdlib/vec" as vec;
import "stdlib/text" as text;
import "stdlib/fs" as fs;
import "flex_layout/flex_layout" as flex;
import "appkit/appkit" as ak;
import "appkit/appkit_ext" as akx;
import "quartzcore/quartzcore" as quartz;
import "agent_core/identity" as identity;

// ==========================================================================
// Payload + measure plumbing
// ==========================================================================

// The payload release: the node's owned +1 on its backing view.
fn release_view(p: *u8) { rt::release(p); return; }

// Measure a leaf through its backing view's fittingSize. `ctx` is the raw
// view pointer (borrowed; the same node's payload owns it).
//
// The answer is CACHED on the view: fittingSize of a static widget (label,
// button, chip — everything measured here is created by this package and
// never mutated after construction) does not depend on the available space,
// yet a retained-relayout resize pass re-asks for thousands of them, each a
// full text-layout. The size is packed as a 1/256-pt fixed-point (w,h) pair
// in an ASSIGN associated integer (the identity-affordance disguised-pointer
// trick); packed 0 = no cache (a genuine 0×0 view just re-measures). The
// stored (quantized) value is returned on the FIRST call too, so every pass
// sees bit-identical sizes. Wrapping text (measure_wrap) depends on the
// flexed width and stays uncached.
fn measure_cache_key() -> *u8 { return { 28710 as *u8 }; }

// The low-32 mask, derived arithmetically. NEVER write it as a literal:
// `4294967295 as u64` wraps through i32 to -1 and sign-extends to all-ones
// (masks nothing) — that bug shipped garbage 5e11-point label heights on
// every measure-cache hit. See bugs/2026-07-12-u32max-literal-cast.md.
fn low32() -> u64 { return ((1 as u64) << (32 as u64)) -% (1 as u64); }

fn measure_view(ctx: *u8, avail_w: f64, wmode: flex::MeasureMode, avail_h: f64, hmode: flex::MeasureMode) -> flex::Size {
    let cached: *u8 = rt::get_associated_object(ctx, measure_cache_key());
    if cached != (0 as *u8) {
        let bits: u64 = cached as u64;
        let wq: u64 = bits >> (32 as u64);
        let hq: u64 = bits & low32();
        return flex::Size { width: (wq as f64) / 256.0f64, height: (hq as f64) / 256.0f64 };
    }
    let s: rt::Size = ak::View::from_raw(ctx).fitting_size();
    let wq2: u64 = ((s.w * 256.0f64) + 0.5f64) as u64;
    let hq2: u64 = ((s.h * 256.0f64) + 0.5f64) as u64;
    let packed: u64 = (wq2 << (32 as u64)) | (hq2 & low32());
    if packed != (0 as u64) {
        rt::set_associated_object(ctx, measure_cache_key(), packed as *u8, 0 as usize);
    }
    return flex::Size { width: (wq2 as f64) / 256.0f64, height: (hq2 as f64) / 256.0f64 };
}

// Measure wrapping text: constrain preferredMaxLayoutWidth to the flexed
// width first, so fittingSize reports the wrapped height.
//
// One-entry cache per view, KEYED BY THE AVAILABLE WIDTH: unlike static
// leaves (measure_view) the answer depends on avail_w, but a content-sized
// tree re-measures every wrap label each pass even when the width did not
// change (the root's intrinsic pass runs before the layout cache can skip).
// Same width ⇒ cached wrap; new width ⇒ honest TextKit re-wrap. Two ASSIGN
// associated integers: the quantized key width and the packed (w,h). The
// unconstrained path (avail_w ≤ 0 or undefined) is never cached.
fn wrap_cache_avail_key() -> *u8 { return { 28711 as *u8 }; }
fn wrap_cache_size_key() -> *u8 { return { 28712 as *u8 }; }

fn measure_wrap(ctx: *u8, avail_w: f64, wmode: flex::MeasureMode, avail_h: f64, hmode: flex::MeasureMode) -> flex::Size {
    var awq: u64 = 0 as u64;
    if avail_w > 0.0f64 { awq = ((avail_w * 256.0f64) + 0.5f64) as u64; }   // NaN > 0 is false
    if awq != (0 as u64) {
        let k: *u8 = rt::get_associated_object(ctx, wrap_cache_avail_key());
        if (k as u64) == awq {
            let bits: u64 = rt::get_associated_object(ctx, wrap_cache_size_key()) as u64;
            let wq: u64 = bits >> (32 as u64);
            let hq: u64 = bits & low32();
            return flex::Size { width: (wq as f64) / 256.0f64, height: (hq as f64) / 256.0f64 };
        }
    }
    let tf: ak::TextField = ak::TextField::from_raw(ctx);
    if avail_w > 0.0f64 { tf.set_preferred_max_layout_width(avail_w); }
    let s: rt::Size = tf.as_view().fitting_size();
    if awq != (0 as u64) {
        let wq2: u64 = ((s.w * 256.0f64) + 0.5f64) as u64;
        let hq2: u64 = ((s.h * 256.0f64) + 0.5f64) as u64;
        let packed: u64 = (wq2 << (32 as u64)) | (hq2 & low32());
        rt::set_associated_object(ctx, wrap_cache_avail_key(), awq as *u8, 0 as usize);
        rt::set_associated_object(ctx, wrap_cache_size_key(), packed as *u8, 0 as usize);
        return flex::Size { width: (wq2 as f64) / 256.0f64, height: (hq2 as f64) / 256.0f64 };
    }
    return flex::Size { width: s.w, height: s.h };
}

// Pin a non-empty `agent_id` as the view's accessibilityIdentifier AND record
// the declared affordance (role + drive). The agent surface prefers the
// declaration over native classify — so @ui widgets tagged with agent_id get
// the same affordance path as facet set_identity. Empty agent_id is a no-op
// (facet ops pass "" and let mount's set_identity own the write).
fn tag_agent(view_ptr: *u8, agent_id: str, role: identity::Role) {
    if #str_len(agent_id) == (0 as usize) { return; }
    if view_ptr == (0 as *u8) { return; }
    ak::Accessibility::from_raw(view_ptr).set_accessibility_identifier(agent_id);
    let drive: u32 = identity::drive_for_role(role);
    let packed: *u8 = identity::pack_affordance(identity::role_index(role) as u32, drive);
    rt::set_associated_object(view_ptr, identity::affordance_key(), packed, 0 as usize);
    return;
}

// ---- escape hatches: wrap any NSView as a node ----
// For agent exposure of a hatch-wrapped view, tag it yourself before (or
// after) wrapping: `ak::Accessibility::from_raw(v.raw())
// .set_accessibility_identifier("field-id")` — the app owns the view here.

// A content leaf measured through the view (labels, buttons).
fn view(take v: ak::View) -> flex::Node {
    let p: *u8 = rt::retain(v.raw());
    var n: flex::Node = flex::Node::new();
    n.set_payload(p, release_view);
    n.set_context(p);
    n.set_measure(measure_view);
    return n;
}

// A wrapping-text leaf (height follows the flexed width).
fn wrap_view(take v: ak::View) -> flex::Node {
    let p: *u8 = rt::retain(v.raw());
    var n: flex::Node = flex::Node::new();
    n.set_payload(p, release_view);
    n.set_context(p);
    n.set_measure(measure_wrap);
    return n;
}

// An unmeasured leaf; size it with `.width()` / `.height()` / `.grow()`.
fn fixed_view(take v: ak::View) -> flex::Node {
    let p: *u8 = rt::retain(v.raw());
    var n: flex::Node = flex::Node::new();
    n.set_payload(p, release_view);
    return n;
}

// Like `fixed_view` but ADOPTS an already-retained handle (no extra +1): the
// caller transferred one reference, this payload owns it and release_view drops
// it. The native escape hatch (facet) uses this — the facet Node retained the
// view when it was wrapped; the op adopts that reference here.
fn adopt_view(handle: *u8) -> flex::Node {
    var n: flex::Node = flex::Node::new();
    if handle != { 0 as *u8 } { n.set_payload(handle, release_view); }
    return n;
}

// ==========================================================================
// Widgets — leaf constructors (config through named params + defaults)
// ==========================================================================

// A single-line text label. `truncate: true` clips to one line with a tail
// ellipsis when the flexed width is narrower than the text — give it a bounded
// width (a `.shrink(1)` in a row, or a fixed `.width(...)`) so there is
// something to truncate against.
fn label(text: str, size: f64 = 13.0f64, bold: bool = false, secondary: bool = false, truncate: bool = false, agent_id: str = "") -> flex::Node {
    let l = ak::TextField::label_with_string(text);
    if bold { l.as_control().set_font(ak::Font::bold_system_font_of_size(size)); }
    else    { l.as_control().set_font(ak::Font::system_font_of_size(size)); }
    if secondary { l.set_text_color(ak::Color::secondary_label_color()); }
    if truncate {
        l.set_maximum_number_of_lines(1 as i64);
        match l.as_control().cell() {
            option::Option[ak::Cell]::Some(c) => {
                c.set_uses_single_line_mode(true);
                c.set_line_break_mode(ak::LineBreakMode::NSLineBreakByTruncatingTail);
            }
            option::Option[ak::Cell]::None => { }
        };
    }
    tag_agent(l.as_view().raw(), agent_id, identity::Role::Text);
    return view(l.as_view());
}

// A label in an arbitrary color — for severity (system_red_color for a
// hard-stop, system_orange_color for a warning) or any accent. The color is
// required; use `label(..., secondary: true)` for the gray secondary tier.
fn colored_label(text: str, color: ak::Color, size: f64 = 13.0f64, bold: bool = false, truncate: bool = false, agent_id: str = "") -> flex::Node {
    let l = ak::TextField::label_with_string(text);
    if bold { l.as_control().set_font(ak::Font::bold_system_font_of_size(size)); }
    else    { l.as_control().set_font(ak::Font::system_font_of_size(size)); }
    l.set_text_color(color);
    if truncate {
        l.set_maximum_number_of_lines(1 as i64);
        match l.as_control().cell() {
            option::Option[ak::Cell]::Some(c) => {
                c.set_uses_single_line_mode(true);
                c.set_line_break_mode(ak::LineBreakMode::NSLineBreakByTruncatingTail);
            }
            option::Option[ak::Cell]::None => { }
        };
    }
    tag_agent(l.as_view().raw(), agent_id, identity::Role::Text);
    return view(l.as_view());
}

// A multi-line label that wraps to its flexed width.
fn wrap_label(text: str, size: f64 = 13.0f64, secondary: bool = false, agent_id: str = "") -> flex::Node {
    let l = ak::TextField::wrapping_label_with_string(text);
    l.as_control().set_font(ak::Font::system_font_of_size(size));
    if secondary { l.set_text_color(ak::Color::secondary_label_color()); }
    tag_agent(l.as_view().raw(), agent_id, identity::Role::Text);
    return wrap_view(l.as_view());
}

// A styled push button with NO action wired — for backends that wire their
// own target/action exactly once (a replaced target strands its creation
// reference; wire once, never rewire).
fn button_view(title: str, primary: bool = false, agent_id: str = "") -> flex::Node {
    let b = ak::Button::new();
    b.set_title(title);
    b.set_bezel_style(ak::BezelStyle::Rounded);
    if primary { b.set_tint_prominence(ak::TintProminence::Primary); }
    tag_agent(b.as_view().raw(), agent_id, identity::Role::Button);
    return view(b.as_view());
}

// An icon-only push button with NO action wired — the image-only twin of
// `button_view`, for the facet `icon_button` kind (facet_appkit wires the
// target/action itself, exactly once). Borderless, shows the named SF Symbol.
fn icon_button_view(symbol_name: str, agent_id: str = "") -> flex::Node {
    let b = ak::Button::new();
    b.set_title("");
    b.set_bordered(false);
    match ak::Image::image_with_system_symbol_name(symbol_name, "") {
        option::Option[ak::Image]::Some(img) => { b.set_image(img); }
        option::Option[ak::Image]::None => { }
    };
    b.set_image_position(ak::CellImagePosition::NSImageOnly);
    tag_agent(b.as_view().raw(), agent_id, identity::Role::Button);
    return view(b.as_view());
}

// A push button firing `on(sender, ctx)`. The defaulted `ctx` right after
// the handler is the bound-method-reference slot: `button("+1",
// on: counter.on_inc)` wires the handler AND the component's address in one
// token. The wire runs the handler and nothing more — facet is not reactive;
// the handler updates the screen itself via facet::find(ctx, key) + a mutator.
fn button(title: str, on: fn(*u8, *u8), ctx: *u8 = 0 as *u8, primary: bool = false, symbol: str = "", agent_id: str = "") -> flex::Node {
    let n: flex::Node = button_view(title, primary: primary, agent_id: agent_id);
    // A non-empty `symbol` places a leading SF Symbol before the title.
    if symbol != "" {
        match ak::Image::image_with_system_symbol_name(symbol, "") {
            option::Option[ak::Image]::Some(img) => {
                let bb = ak::Button::from_raw(n.payload());
                bb.set_image(img);
                bb.set_image_position(ak::CellImagePosition::NSImageLeading);
            }
            option::Option[ak::Image]::None => { }
        };
    }
    akx::set_control_action_ctx(ak::Button::from_raw(n.payload()).as_control(), on, ctx);
    return n;
}

// The explicit-ctx spelling of `button` — per-item identity without the
// setTag workaround (an index smuggled as a pointer needs no ownership).
// Same wire as `button`, ctx required. Kept as the desugared form.
fn button_ctx(title: str, on: fn(*u8, *u8), ctx: *u8, primary: bool = false, agent_id: str = "") -> flex::Node {
    let n: flex::Node = button_view(title, primary: primary, agent_id: agent_id);
    akx::set_control_action_ctx(ak::Button::from_raw(n.payload()).as_control(), on, ctx);
    return n;
}

// A borderless image-only button (SF Symbol by name) firing `on(sender,
// ctx)`. Defaulted ctx after the handler = the bound-reference slot:
// `icon_button("xmark", on: recents.remove_at)`.
fn icon_button(symbol_name: str, on: fn(*u8, *u8), ctx: *u8 = 0 as *u8, agent_id: str = "") -> flex::Node {
    let b = ak::Button::new();
    b.set_title("");
    b.set_bordered(false);
    match ak::Image::image_with_system_symbol_name(symbol_name, "") {
        option::Option[ak::Image]::Some(img) => { b.set_image(img); }
        option::Option[ak::Image]::None => { }
    };
    b.set_image_position(ak::CellImagePosition::NSImageOnly);
    akx::set_control_action_ctx(b.as_control(), on, ctx);
    tag_agent(b.as_view().raw(), agent_id, identity::Role::Button);
    return view(b.as_view());
}

// The ctx-carrying variant of `icon_button`.
fn icon_button_ctx(symbol_name: str, on: fn(*u8, *u8), ctx: *u8, agent_id: str = "") -> flex::Node {
    let b = ak::Button::new();
    b.set_title("");
    b.set_bordered(false);
    match ak::Image::image_with_system_symbol_name(symbol_name, "") {
        option::Option[ak::Image]::Some(img) => { b.set_image(img); }
        option::Option[ak::Image]::None => { }
    };
    b.set_image_position(ak::CellImagePosition::NSImageOnly);
    akx::set_control_action_ctx(b.as_control(), on, ctx);
    tag_agent(b.as_view().raw(), agent_id, identity::Role::Button);
    return view(b.as_view());
}

// A hyperlink-style button: borderless, accent-tinted title, action-wired.
// For the Help / Settings row and other inline text actions.
fn link_button(title: str, on: fn(*u8, *u8), ctx: *u8 = 0 as *u8, agent_id: str = "") -> flex::Node {
    let b = ak::Button::new();
    b.set_title(title);
    b.set_bordered(false);
    b.set_content_tint_color(ak::Color::link_color());
    akx::set_control_action_ctx(b.as_control(), on, ctx);
    tag_agent(b.as_view().raw(), agent_id, identity::Role::Button);
    return view(b.as_view());
}

// A borderless text button styled like a plain (or bold) label but firing an
// action — for a clickable title that should not read as a hyperlink. Title is
// left-aligned. Distinct from `link_button` (accent hyperlink) and from
// `clickable` (wraps an arbitrary laid-out node).
fn plain_button(title: str, on: fn(*u8, *u8), ctx: *u8 = 0 as *u8, bold: bool = false, agent_id: str = "") -> flex::Node {
    let b = ak::Button::new();
    b.set_title(title);
    b.set_bordered(false);
    if bold { b.as_control().set_font(ak::Font::bold_system_font_of_size(13.0f64)); }
    b.as_control().set_alignment(ak::TextAlignment::Left);
    akx::set_control_action_ctx(b.as_control(), on, ctx);
    tag_agent(b.as_view().raw(), agent_id, identity::Role::Button);
    return view(b.as_view());
}

// An SF Symbol at a fixed side length.
fn symbol(name: str, side: f64, secondary: bool = false) -> flex::Node {
    var img: ak::Image = ak::Image::new(rt::Size { w: side, h: side });
    match ak::Image::image_with_system_symbol_name(name, "") {
        option::Option[ak::Image]::Some(found) => { img = found; }
        option::Option[ak::Image]::None => { }
    };
    let iv = ak::ImageView::image_view_with_image(img);
    if secondary { iv.set_content_tint_color(ak::Color::secondary_label_color()); }
    else         { iv.set_content_tint_color(ak::Color::label_color()); }
    var n: flex::Node = fixed_view(iv.as_view());
    n.set_width(flex::StyleLength::points(side));
    n.set_height(flex::StyleLength::points(side));
    return n;
}

// An SF Symbol tinted an arbitrary color — the green ✓ (system_green_color) on a
// pass chip, a red ✕, an accent glyph. The tint is required; `symbol(...)` with
// `secondary` covers the label/secondary monochrome case.
fn symbol_tinted(name: str, side: f64, tint: ak::Color) -> flex::Node {
    var img: ak::Image = ak::Image::new(rt::Size { w: side, h: side });
    match ak::Image::image_with_system_symbol_name(name, "") {
        option::Option[ak::Image]::Some(found) => { img = found; }
        option::Option[ak::Image]::None => { }
    };
    let iv = ak::ImageView::image_view_with_image(img);
    iv.set_content_tint_color(tint);
    var n: flex::Node = fixed_view(iv.as_view());
    n.set_width(flex::StyleLength::points(side));
    n.set_height(flex::StyleLength::points(side));
    return n;
}

// An image from a file path, scaled proportionally. Size it with
// `.width()` / `.height()`.
fn image(path: str) -> flex::Node {
    let iv = ak::ImageView::image_view_with_image(ak::Image::new_with_contents_of_file(path));
    iv.set_image_scaling(ak::ImageScaling::NSImageScaleProportionallyUpOrDown);
    return fixed_view(iv.as_view());
}

// A hairline separator. Give it `.width(1.0)` in a row or `.height(1.0)`
// in a column.
fn divider() -> flex::Node {
    let b = ak::Box::new();
    b.set_box_type(ak::BoxType::NSBoxSeparator);
    return fixed_view(b.as_view());
}

// Flexible empty space (no view).
fn spacer() -> flex::Node {
    return flex::Node::new().grow(1.0f64);
}

// A bare layout box (no view); size or grow it via modifiers.
fn box() -> flex::Node {
    return flex::Node::new();
}

// A container that draws a 1px rounded border (a themed separator color) around
// its `content`. The flex engine lays `content` out inside the border, so give
// the returned node a size or `.grow(1.0)` in the outer layout. This is the
// general bordered-box primitive — box a subtree, frame a sidebar, or group an
// input with its toolbar. To put a composer + toolbar in ONE bordered box, wrap
// a column of a border-less, background-less composer and the toolbar:
//
//   bordered(column {
//       composer(on_submit: send, show_border: false, draws_background: false)
//       row { icon_button("plus", on: attach); spacer(); icon_button("arrow.up", on: send) }
//   })
//
// (`draws_background: false` keeps the input transparent so the box shows one
// uniform fill instead of a filled text rectangle inside the outline.)
// Wrap content in a translucent NSVisualEffectView (macOS vibrancy — sidebars,
// panels). Same backing-view pattern as `bordered`, with a vibrancy backing.
fn material(take content: flex::Node, agent_id: str = "") -> flex::Node {
    let zero: rt::Rect = rt::Rect { x: 0.0f64, y: 0.0f64, w: 0.0f64, h: 0.0f64 };
    let ve: ak::VisualEffectView = ak::VisualEffectView::new_with_frame(zero);
    ve.set_material(ak::VisualEffectMaterial::Sidebar);
    ve.set_blending_mode(ak::VisualEffectBlendingMode::BehindWindow);
    tag_agent(ve.as_view().raw(), agent_id, identity::Role::Group);
    var wrapper: flex::Node = flex::Node::new();
    wrapper.set_payload(rt::retain(ve.as_view().raw()), release_view);
    wrapper.add_child(content);
    return wrapper;
}

fn bordered(take content: flex::Node, radius: f64 = 6.0f64, agent_id: str = "") -> flex::Node {
    let zero: rt::Rect = rt::Rect { x: 0.0f64, y: 0.0f64, w: 0.0f64, h: 0.0f64 };
    let bv: ak::View = ak::View::new(zero);
    bv.set_wants_layer(true);
    let lyr: quartz::Layer = bv.layer();
    lyr.set_border_width(1.0f64);
    lyr.set_corner_radius(radius);
    lyr.set_border_color(ak::Color::separator_color().c_g_color());
    tag_agent(bv.raw(), agent_id, identity::Role::Group);
    var wrapper: flex::Node = flex::Node::new();
    wrapper.set_payload(rt::retain(bv.raw()), release_view);
    wrapper.add_child(content);
    return wrapper;
}

// A window-drag surface: same single-backing-view wrapper as `bordered`, but the
// backing view is a `CplusExtWindowDragView` — dragging it moves the window and a
// double-click zooms it. For a custom titlebar (a content toolbar row over a
// hidden-button window): wrap the bar so the empty regions behave like a real
// title bar. Child controls keep their own clicks (only the bare surface drags).
fn window_drag(take content: flex::Node, agent_id: str = "") -> flex::Node {
    let zero: rt::Rect = rt::Rect { x: 0.0f64, y: 0.0f64, w: 0.0f64, h: 0.0f64 };
    let dv: ak::View = akx::new_window_drag_view(zero);
    tag_agent(dv.raw(), agent_id, identity::Role::Group);
    var wrapper: flex::Node = flex::Node::new();
    wrapper.set_payload(rt::retain(dv.raw()), release_view);
    wrapper.add_child(content);
    return wrapper;
}

// The viewport leaf for an NSScrollView: place it in the outer tree (give
// it `.grow(1.0)` or a size), run the outer layout + apply, then hand the
// row content to `fill_scroll`.
fn scroll_view(s: ak::ScrollView) -> flex::Node {
    return fixed_view(s.as_view());
}

// ==========================================================================
// Form inputs — editable widgets. `@ui` shipped none of these; each was a
// hand-built raw AppKit view. Read a value back by stashing the node's
// `payload()` at construction, then passing that pointer to the matching
// reader (`field_text` / `area_text` / `popup_index`). Give each a size in
// the layout — a definite width, and for a field a height around 22.
// ==========================================================================

// An editable single-line text field. Built through the +0 `textFieldWithString`
// factory so ownership balances the way `label` does. Read the current value
// with `field_text(node.payload())`.
fn text_field(placeholder: str = "", value: str = "", agent_id: str = "") -> flex::Node {
    let tf = ak::TextField::text_field_with_string(value);
    tf.set_editable(true);
    tf.set_bezeled(true);
    tf.set_bezel_style(ak::TextFieldBezelStyle::NSTextFieldSquareBezel);
    if placeholder != "" { tf.set_placeholder_string(placeholder); }
    tag_agent(tf.as_view().raw(), agent_id, identity::Role::Input);
    return view(tf.as_view());
}

// A masked single-line field for passwords/secrets — an NSSecureTextField.
// Its cell is an NSTextField underneath, so (unlike the NSTextView editors) it
// supports a native `placeholder` as well as an initial `value`. Read the value
// back with `field_text(node.payload())`, same as `text_field`.
fn secure_field(placeholder: str = "", value: str = "", agent_id: str = "") -> flex::Node {
    let sf = ak::SecureTextField::new();
    if value != "" { sf.as_control().set_string_value(value); }
    if placeholder != "" { sf.as_text_field().set_placeholder_string(placeholder); }
    tag_agent(sf.as_view().raw(), agent_id, identity::Role::Input);
    return fixed_view(sf.as_view());
}

// The current text of a `text_field`, by its payload view pointer.
fn field_text(view_ptr: *u8) -> text::Text {
    return ak::TextField::from_raw(view_ptr).as_control().string_value();
}

// A bordered, scrollable, editable multi-line editor (an NSTextView inside an
// NSScrollView). Size it with a definite `.height(...)` or `.grow(1.0)`. Read
// the value with `area_text(node.payload())`. NSTextView has no placeholder, so
// there is no `placeholder` argument — supply a separate prompt label if you need
// one. Optional `on_change(ctx, tv)` fires on every edit (null-fn sentinel = no
// hook).
fn text_area(
    value: str = "",
    on_change: fn(*u8, *u8) = 0 as fn(*u8, *u8),
    ctx: *u8 = 0 as *u8,
    agent_id: str = "",
    editable: bool = true,
    show_border: bool = true,
    draws_background: bool = true,
    inset_w: f64 = 0.0f64,
    inset_h: f64 = 0.0f64,
) -> flex::Node {
    let zero: rt::Rect = rt::Rect { x: 0 as f64, y: 0 as f64, w: 0 as f64, h: 0 as f64 };
    let scroll = ak::ScrollView::new(zero);
    // `show_border: false` drops the bezel (e.g. sitting inside a bordered box);
    // the composer precedent.
    if show_border {
        scroll.set_border_type(ak::BorderType::NSBezelBorder);
    } else {
        scroll.set_border_type(ak::BorderType::NSNoBorder);
    }
    scroll.set_has_vertical_scroller(true);
    let tv = ak::TextView::new_with_frame(zero);
    tv.set_editable(editable);   // `false` = a read-only (still selectable) viewer
    tv.set_rich_text(false);
    tv.as_text().set_font(ak::Font::system_font_of_size(13.0f64));
    // `draws_background: false` clears BOTH layers (scroll + text view) so the
    // area is transparent over an outer box — same two-layer clear as composer.
    if !draws_background {
        scroll.set_draws_background(false);
        tv.set_draws_background(false);
    }
    // Text-container inset (left/right, top/bottom padding) — the code_editor
    // precedent; a transcript usually wants a little breathing room.
    if inset_w != 0.0f64 || inset_h != 0.0f64 {
        tv.set_text_container_inset(rt::Size { w: inset_w, h: inset_h });
    }
    if value != "" { tv.as_text().set_string(value); }
    // Track the scroll's content width as it resizes.
    tv.as_view().set_autoresizing_mask(ak::autoresizing_mask_options_n_s_view_width_sizable);
    // Reuse the composer delegate with a null on_submit — change hook only.
    let none: fn(*u8, *u8) = 0 as fn(*u8, *u8);
    if on_change != none {
        akx::attach_composer_delegate(tv, on_change, none, ctx);
    }
    scroll.set_document_view(tv.as_view());
    // Tag the inner NSTextView (the editable surface), not the scroll wrapper,
    // so the agent surface's set_text / read address the text directly:
    // set_text branches NSTextView->setString: else NSControl->setStringValue:,
    // and an NSScrollView silently ignores setStringValue: (write no-op'd).
    tag_agent(tv.as_view().raw(), agent_id, identity::Role::Input);
    return fixed_view(scroll.as_view());
}

// The current text of a `text_area`, by its (scroll-view) payload pointer.
fn area_text(view_ptr: *u8) -> text::Text {
    return match ak::ScrollView::from_raw(view_ptr).document_view() {
        option::Option[ak::View]::Some(dv) => ak::TextView::from_raw(dv.raw()).as_text().string(),
        option::Option[ak::View]::None => text::from_str(""),
    };
}

// A dropdown / popup selector. `items` are the visible titles in order;
// `selected` is the initially-chosen index. Read the chosen index with
// `popup_index(node.payload())`.
fn popup(items: vec::Vec[text::Text], selected: i64 = 0 as i64, agent_id: str = "") -> flex::Node {
    let zero: rt::Rect = rt::Rect { x: 0 as f64, y: 0 as f64, w: 0 as f64, h: 0 as f64 };
    let p = ak::PopUpButton::new(zero, false);
    var i: usize = 0 as usize;
    while i < items.count() {
        match items.at_ptr(i) {
            option::Option[*text::Text]::Some(t) => { p.add_item_with_title((*t).view()); }
            option::Option[*text::Text]::None => { }
        }
        i = i +% (1 as usize);
    }
    if selected >= (0 as i64) && selected < (items.count() as i64) { p.select_item_at_index(selected); }
    tag_agent(p.as_view().raw(), agent_id, identity::Role::List);
    return view(p.as_view());
}

// The selected index of a `popup`, by its payload pointer (-1 if none).
fn popup_index(view_ptr: *u8) -> i64 {
    return ak::PopUpButton::from_raw(view_ptr).index_of_selected_item();
}

// Run a modal folder picker and return the chosen directory path, or None if
// the user cancelled. This is a helper, not a node — call it from an action
// handler (e.g. a "Choose…" button) and feed the result into a text_field.
fn choose_directory() -> option::Option[text::Text] {
    let panel = ak::OpenPanel::open_panel();
    panel.set_can_choose_directories(true);
    panel.set_can_choose_files(false);
    panel.set_allows_multiple_selection(false);
    panel.as_save_panel().set_can_create_directories(true);
    let resp: i64 = panel.as_save_panel().run_modal();
    if resp != (1 as i64) { return option::Option[text::Text]::None; }   // NSModalResponseOK == 1
    match panel.as_save_panel().u_r_l() {
        option::Option[ak::URL]::Some(u) => {
            let ns: *u8 = rt::msg_id(u.raw(), rt::sel(#str_ptr("path\0")));
            if ns == { 0 as *u8 } { return option::Option[text::Text]::None; }
            return option::some(bridge::to_text(ns));
        }
        option::Option[ak::URL]::None => { return option::Option[text::Text]::None; }
    }
    return option::Option[text::Text]::None;
}

// A modal open-panel that picks a single FILE, returning its path (None on
// cancel). The `choose_directory` twin (files instead of directories) — for an
// attach / insert-file action. Wraps the same NSOpenPanel + URL.path raw reach
// so callers never hand-roll it.
fn choose_file() -> option::Option[text::Text] {
    let panel = ak::OpenPanel::open_panel();
    panel.set_can_choose_files(true);
    panel.set_can_choose_directories(false);
    panel.set_allows_multiple_selection(false);
    let resp: i64 = panel.as_save_panel().run_modal();
    if resp != (1 as i64) { return option::Option[text::Text]::None; }   // NSModalResponseOK == 1
    match panel.as_save_panel().u_r_l() {
        option::Option[ak::URL]::Some(u) => {
            let ns: *u8 = rt::msg_id(u.raw(), rt::sel(#str_ptr("path\0")));
            if ns == { 0 as *u8 } { return option::Option[text::Text]::None; }
            return option::some(bridge::to_text(ns));
        }
        option::Option[ak::URL]::None => { return option::Option[text::Text]::None; }
    }
    return option::Option[text::Text]::None;
}

// A chat-style composer: a bordered, scrollable, editable multi-line text view
// that submits on Enter and inserts a newline on Shift+Enter. `on_submit(ctx,
// tv)` fires on Enter; `on_change(ctx, tv)` (optional — defaults to a no-op)
// fires on every edit. Read the current text with `area_text(node.payload())`.
// Auto-grow recipe: in `on_change`, read `composer_content_height(node.payload())`,
// clamp it to your min/max, set that height on the composer's retained flex node,
// then `ui::relayout(host)` to reflow — the field grows in place, no re-render.
// Give it a definite `.height(...)` for the initial size.
// `show_border: false` drops the composer's own bezel so it can sit inside an
// outer `bordered(...)` box alongside a toolbar row — one bordered box holding
// the input and its accessory controls — without a doubled border.
// `draws_background: false` additionally makes the text area transparent (no
// filled background rectangle on the scroll view or its text view), so a
// border-less composer inside a `bordered(...)` box shows only the box's own
// outline and fill.
fn composer(on_submit: fn(*u8, *u8), on_change: fn(*u8, *u8) = 0 as fn(*u8, *u8), ctx: *u8 = 0 as *u8, value: str = "", show_border: bool = true, draws_background: bool = true, agent_id: str = "") -> flex::Node {
    let zero: rt::Rect = rt::Rect { x: 0.0, y: 0.0, w: 0.0, h: 0.0 };
    let scroll = ak::ScrollView::new(zero);
    if show_border {
        scroll.set_border_type(ak::BorderType::NSBezelBorder);
    } else {
        scroll.set_border_type(ak::BorderType::NSNoBorder);
    }
    scroll.set_has_vertical_scroller(true);
    let tv = ak::TextView::new_with_frame(zero);
    tv.set_editable(true);
    tv.set_rich_text(false);
    tv.as_text().set_font(ak::Font::system_font_of_size(13.0f64));
    if value != "" { tv.as_text().set_string(value); }
    tv.as_view().set_autoresizing_mask(ak::autoresizing_mask_options_n_s_view_width_sizable);
    if !draws_background {
        scroll.set_draws_background(false);
        tv.set_draws_background(false);
    }
    akx::attach_composer_delegate(tv, on_change, on_submit, ctx);
    scroll.set_document_view(tv.as_view());
    // Tag the inner NSTextView (the editable surface), not the scroll wrapper,
    // so the agent surface's set_text / read address the text directly:
    // set_text branches NSTextView->setString: else NSControl->setStringValue:,
    // and an NSScrollView silently ignores setStringValue: (write no-op'd).
    tag_agent(tv.as_view().raw(), agent_id, identity::Role::Input);
    return fixed_view(scroll.as_view());
}

// The laid-out height of a `composer`'s text (used-rect + vertical insets), by
// its (scroll-view) payload pointer. Clamp it to a min/max to drive auto-grow.
// Returns 0 before the text view has laid out.
fn composer_content_height(view_ptr: *u8) -> f64 {
    let dv: *u8 = { rt::msg_id(view_ptr, rt::sel(#str_ptr("documentView\0"))) };
    if dv == { 0 as *u8 } { return 0.0f64; }
    let tv: ak::TextView = ak::TextView::from_raw(dv);
    let inset: rt::Size = tv.text_container_inset();
    match tv.layout_manager() {
        option::Option[ak::LayoutManager]::Some(lm) => {
            match tv.text_container() {
                option::Option[ak::TextContainer]::Some(tc) => {
                    let used: rt::Rect = lm.used_rect_for_text_container(tc);
                    return used.h + (2.0f64 * inset.h);
                }
                option::Option[ak::TextContainer]::None => { }
            }
        }
        option::Option[ak::LayoutManager]::None => { }
    }
    return 0.0f64;
}

// ==========================================================================
// Native split view — draggable two-pane divider (file tree | editor).
// ==========================================================================

// A hosted split pane: a multi-element pane (a `column`/`row`, which has no
// single backing view) gets its own host NSView as the arranged subview, and
// its subtree is (re)laid out into that host whenever the split resizes the
// pane. A leaf pane (one view) never lands here — it goes straight in as the
// arranged subview, as NSSplitView expects. `tree` is owned here for the
// process's life (a split rarely unmounts); `applied` gates first-apply vs
// retained reposition.
struct SplitPane {
    opaque split: *u8,       // the NSSplitView this pane belongs to (registry key)
    opaque host: *u8,        // the arranged-subview host (non-owning; the split retains it)
    tree: flex::Node,        // the pane's mounted subtree, relaid on every resize
    applied: bool,           // false until the first apply installs the views
}

static SPLIT_PANES: vec::Vec[SplitPane] = #zero::[vec::Vec[SplitPane]]();

// Lay one hosted pane out at its host's CURRENT size: first pass installs the
// views (apply), later passes only reposition the existing ones (the retained
// window-resize path). A 0-sized host (not laid out yet) is skipped.
fn reflow_pane(ep: *SplitPane) {
    let host_ptr: *u8 = { (*ep).host };
    let hf: rt::Rect = ak::View::from_raw(host_ptr).frame();
    if hf.w <= 0.0f64 { return; }
    if hf.h <= 0.0f64 { return; }
    let tp: *flex::Node = { #addr_of((*ep).tree) };
    (*tp).calculate_layout(hf.w, hf.h, flex::Direction::LTR);
    (*tp).round_to_pixel(2.0f64);
    if { (*ep).applied } == false {
        apply(tp, host_ptr, false);
        { (*ep).applied = true; }
    } else {
        reposition(tp, false);
    }
    return;
}

// splitViewDidResizeSubviews: hook (via attach_split_min_widths). Reflow every
// hosted pane of the split that just resized. Leaf-only splits register no
// panes here, so this no-ops for them.
fn relayout_split_panes(sv_ptr: *u8) {
    let reg: *vec::Vec[SplitPane] = { #addr_of(SPLIT_PANES) };
    let n: usize = { (*reg).count() };
    var i: usize = 0 as usize;
    while i < n {
        match (*reg).at_ptr(i) {
            option::Option[*SplitPane]::Some(ep) => {
                if { (*ep).split } == sv_ptr { reflow_pane(ep); }
            }
            option::Option[*SplitPane]::None => { }
        }
        i = i +% (1 as usize);
    }
    return;
}

// Add one pane to the split. A leaf pane (its own view) becomes the arranged
// subview directly. A multi-element pane (a container, no single view) is
// hosted: a fresh host view is the arranged subview, the pane's subtree is
// registered against it, and reflow_pane installs/relays it once the split
// sizes the host (deferred to the resize hook, since the host is 0×0 now).
fn host_or_add_pane(sv: ak::SplitView, take pane: flex::Node) {
    if pane.payload() != (0 as *u8) {
        sv.add_arranged_subview(ak::View::from_raw(pane.payload()));
        return;
    }
    if pane.child_count() > (0 as usize) {
        let host: ak::View = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 0.0, h: 0.0 });
        let hraw: *u8 = host.raw();
        sv.add_arranged_subview(host);
        let reg: *vec::Vec[SplitPane] = { #addr_of(SPLIT_PANES) };
        (*reg).append(SplitPane { split: sv.raw(), host: hraw, tree: pane, applied: false });
        return;
    }
    return;
}

// A two-pane NSSplitView with a draggable divider: `split(sidebar, editor)`.
// Each pane can be a single view (a `scroll_view`, a native leaf, a nested
// `split`, or a `view(...)`) OR a multi-element container (`column`/`row`) —
// the latter is hosted in its own view and reflowed on divider drag/resize, so
// the caller never has to wrap it. `vertical: true` (default) places the panes
// side by side (a vertical divider); `false` stacks them. `position` is the
// initial divider offset; `min_first` / `min_second` are the pane minimums the
// delegate enforces.
fn split(take first: flex::Node, take second: flex::Node, vertical: bool = true, position: f64 = 220.0f64, min_first: f64 = 150.0f64, min_second: f64 = 240.0f64, agent_id: str = "") -> flex::Node {
    let sv = ak::SplitView::new();
    sv.set_vertical(vertical);
    sv.set_divider_style(ak::SplitViewDividerStyle::Thin);
    host_or_add_pane(sv, first);
    host_or_add_pane(sv, second);
    akx::attach_split_min_widths(sv, min_first, min_second, on_resize: relayout_split_panes, resize_user: sv.raw());
    sv.set_position(position, 0 as i64);
    tag_agent(sv.as_view().raw(), agent_id, identity::Role::Group);
    return fixed_view(sv.as_view());
}

// A monospaced code editor / viewer: an NSTextView in an NSScrollView with a
// fixed-pitch font and code-hostile auto-substitutions (smart quotes, dashes,
// text replacement) turned off. `editable: false` makes a read-only viewer.
// Read with `area_text(node.payload())`; replace the whole buffer (opening a
// file) with `set_area_text(node.payload(), src)`. Size it with `.grow(1.0)`.
//
// `inset_w` / `inset_h` set the text container inset — the left/right and
// top/bottom padding between the border and the text (NSTextView's default of
// 0 flushes the first column to the edge). A file editor usually wants a little
// breathing room, e.g. `inset_w: 10.0, inset_h: 8.0`.
fn code_editor(value: str = "", editable: bool = true, size: f64 = 12.0f64, inset_w: f64 = 0.0f64, inset_h: f64 = 0.0f64, agent_id: str = "") -> flex::Node {
    let zero: rt::Rect = rt::Rect { x: 0.0, y: 0.0, w: 0.0, h: 0.0 };
    let scroll = ak::ScrollView::new(zero);
    scroll.set_border_type(ak::BorderType::NSNoBorder);
    scroll.set_has_vertical_scroller(true);
    let tv = ak::TextView::new_with_frame(zero);
    tv.set_editable(editable);
    tv.set_rich_text(false);
    tv.set_automatic_quote_substitution_enabled(false);
    tv.set_automatic_dash_substitution_enabled(false);
    tv.set_automatic_text_replacement_enabled(false);
    tv.as_text().set_font(ak::Font::monospaced_system_font_of_size(size, 0.0f64));
    if inset_w != 0.0f64 || inset_h != 0.0f64 {
        tv.set_text_container_inset(rt::Size { w: inset_w, h: inset_h });
    }
    if value != "" { tv.as_text().set_string(value); }
    tv.as_view().set_autoresizing_mask(ak::autoresizing_mask_options_n_s_view_width_sizable);
    scroll.set_document_view(tv.as_view());
    // Tag the inner NSTextView (the editable surface), not the scroll wrapper,
    // so the agent surface's set_text / read address the text directly:
    // set_text branches NSTextView->setString: else NSControl->setStringValue:,
    // and an NSScrollView silently ignores setStringValue: (write no-op'd).
    tag_agent(tv.as_view().raw(), agent_id, identity::Role::Input);
    return fixed_view(scroll.as_view());
}

// Read the text container inset back from a code_editor / text_area / composer,
// by its scroll-view payload pointer. Mirrors `composer_content_height`'s access
// path; useful in tests and for callers that adjust padding at runtime.
fn area_inset(view_ptr: *u8) -> rt::Size {
    let dv: *u8 = { rt::msg_id(view_ptr, rt::sel(#str_ptr("documentView\0"))) };
    if dv == { 0 as *u8 } { return rt::Size { w: 0.0f64, h: 0.0f64 }; }
    return ak::TextView::from_raw(dv).text_container_inset();
}

// Replace the whole text of any scroll-hosted text view (`text_area`,
// `composer`, `code_editor`), by its scroll-view payload pointer.
fn set_area_text(view_ptr: *u8, value: str) {
    let dv: *u8 = { rt::msg_id(view_ptr, rt::sel(#str_ptr("documentView\0"))) };
    if dv == { 0 as *u8 } { return; }
    ak::TextView::from_raw(dv).as_text().set_string(value);
    return;
}

// ==========================================================================
// File tree — NSOutlineView over an in-memory directory model. The model nodes
// are heap-boxed at STABLE addresses and leaked (they live with the tree). The
// data source and selection delegate are weak properties, so they are pinned to
// the outline view; both use the already-generated OutlineViewDataSource /
// OutlineViewDelegate. The model is built eagerly from the directory on
// construction.
//
// IMPORTANT: NSOutlineView treats its items as Objective-C OBJECTS, not just
// stable pointers — on a key-state change it walks the visible rows and inserts
// each item into an internal NSMapTable with object semantics, MESSAGING the
// item (probeGC/retain/hash/isEqual:). A raw `*TreeNode` satisfies "stable
// identity" yet crashes the instant the outline messages it (its first word is
// the label's `char*`, read as an `isa` → objc_msgSend on garbage). So every
// node carries a cached objc wrapper (an NSValue over the node pointer, created
// ONCE and retained for app-lifetime), and THAT is the item handed to / accepted
// from NSOutlineView; the `*TreeNode` stays the payload behind it. One wrapper
// per node, reused, so identity is preserved and every item is a valid object.
// ==========================================================================

extern fn malloc(n: usize) -> *u8;

struct TreeNode {
    label: text::Text,                    // display name (basename)
    path: text::Text,                     // full path (for on_select)
    is_dir: bool,
    children: vec::Vec[*TreeNode],        // stable boxed child pointers
    opaque item: *u8,                    // cached objc wrapper (NSValue over this node; app-lifetime, leaked)
}

struct TreeSelCtx {
    on_select: fn(*u8, *u8),         // (caller_ctx, *TreeNode-as-*u8)
    opaque caller_ctx: *u8,
}

fn tree_ds_pin_key() -> *u8 { return { 28692 as *u8 }; }
fn tree_del_pin_key() -> *u8 { return { 28693 as *u8 }; }

// The objc wrapper for a node: `+[NSValue valueWithPointer:]` boxes the raw
// `*TreeNode` in a real Foundation object whose `-isEqual:`/`-hash` are BY the
// wrapped pointer — exactly the identity NSOutlineView caches by, and safe to
// message (probeGC/retain/hash) the way the outline does. It comes back
// autoreleased, so we retain it for app-lifetime (the node is leaked too). Call
// once per node at construction and stash on `TreeNode.item`.
fn tree_wrap_node(node: *TreeNode) -> *u8 {
    let cls: *u8 = rt::get_class(#str_ptr("NSValue\0"));
    let v: *u8 = rt::msg_id_id(cls, rt::sel(#str_ptr("valueWithPointer:\0")), node as *u8);
    return rt::retain(v);
}

// Recover the `*TreeNode` behind a wrapper item (nil-safe: nil → null node).
// `item` is always a wrapper handed back by NSOutlineView (or by `tree_child_imp`
// / `on_select`), never a raw node pointer.
fn tree_unwrap(item: *u8) -> *TreeNode {
    if item == { 0 as *u8 } { return { 0 as *TreeNode }; }
    return { rt::msg_id(item, rt::sel(#str_ptr("pointerValue\0"))) as *TreeNode };
}

// Box a node on the heap (leaked; app-lifetime). Reading `read_dir` decides
// dir-vs-file: a path that opens as a directory recurses, anything else is a leaf.
fn build_tree(path: str, label: str) -> *TreeNode {
    var kids: vec::Vec[*TreeNode] = vec::new::[*TreeNode]();
    var isdir: bool = false;
    match fs::read_dir(path) {
        option::Option[vec::Vec[text::Text]]::Some(names) => {
            isdir = true;
            var i: usize = 0 as usize;
            while i < names.count() {
                match names.at_ptr(i) {
                    option::Option[*text::Text]::Some(nm) => {
                        var cp: text::Text = text::from_str(path);
                        let _s1 = cp.append("/");
                        let _s2 = cp.append((*nm).view());
                        kids.append(build_tree(cp.view(), (*nm).view()));
                    }
                    option::Option[*text::Text]::None => { }
                }
                i = i +% (1 as usize);
            }
        }
        option::Option[vec::Vec[text::Text]]::None => { isdir = false; }
    }
    let node: *TreeNode = { malloc(#size_of::[TreeNode]()) as *TreeNode };
    { *node = TreeNode { label: text::from_str(label), path: text::from_str(path), is_dir: isdir, children: kids, item: 0 as *u8 }; }
    { (*node).item = tree_wrap_node(node); }
    return node;
}

// The full path of a tree item (the `on_select` payload). `item` is the opaque
// wrapper NSOutlineView / `on_select` hands back; unwrap it to the node. Returns
// "" for a null or unwrappable item.
fn tree_node_path(item: *u8) -> text::Text {
    if item == { 0 as *u8 } { return text::from_str(""); }
    let n: *TreeNode = tree_unwrap(item);
    if { n as *u8 } == { 0 as *u8 } { return text::from_str(""); }
    return text::from_str({ (*n).path }.view());
}

// ---- public node builders: construct a tree yourself, then mount it with
// `tree(root, ...)`. This is the agnostic path — YOU decide what nodes exist
// (apply ignore lists, prune `.git`/`target`, stop at a depth, or build children
// lazily). `file_tree(path)` below is just the eager convenience that walks the
// whole directory for you; when you need control, build the model here instead.
//
// Nodes are heap-boxed and leaked on purpose: NSOutlineView caches its items and
// MESSAGES them (they must be objc objects, not just stable pointers), so each
// node is given a retained objc wrapper at construction and outlives the widget
// (app-lifetime). See the module header above for why a raw pointer crashes.

// A new node. `is_dir` gives it a disclosure triangle (an expandable branch)
// even before it has children — set it true for a directory you fill lazily.
// `label` is the displayed name; `path` is the opaque `on_select` payload
// (recover it with `tree_node_path`). Add children with `tree_add_child`.
fn tree_node(label: str, path: str, is_dir: bool) -> *TreeNode {
    let node: *TreeNode = { malloc(#size_of::[TreeNode]()) as *TreeNode };
    { *node = TreeNode { label: text::from_str(label), path: text::from_str(path), is_dir: is_dir, children: vec::new::[*TreeNode](), item: 0 as *u8 }; }
    { (*node).item = tree_wrap_node(node); }
    return node;
}

// Append `child` to `parent`'s children, in order. `parent` should be a branch
// (`is_dir: true`); a leaf with children still renders them, but the triangle
// only shows for `is_dir` nodes.
fn tree_add_child(parent: *TreeNode, child: *TreeNode) {
    { (*parent).children.append(child); }
    return;
}

// --- data source trampolines. `item == nil` means the implicit root (whose node
// is the data source's user data). Every non-nil `item` is a wrapper object, so
// recover the node with `tree_unwrap`; `tree_child_imp` returns the child's
// wrapper, never a raw pointer. ---
fn tree_num_children_imp(user: *u8, ov: *u8, item: *u8) -> i64 {
    let node: *TreeNode = if item == { 0 as *u8 } { user as *TreeNode } else { tree_unwrap(item) };
    return { (*node).children }.count() as i64;
}
fn tree_child_imp(user: *u8, ov: *u8, index: i64, item: *u8) -> *u8 {
    let node: *TreeNode = if item == { 0 as *u8 } { user as *TreeNode } else { tree_unwrap(item) };
    match { (*node).children }.at_ptr(index as usize) {
        option::Option[**TreeNode]::Some(cpp) => { let child: *TreeNode = { *cpp }; return { (*child).item }; }
        option::Option[**TreeNode]::None => { }
    }
    return 0 as *u8;
}
fn tree_expandable_imp(user: *u8, ov: *u8, item: *u8) -> i8 {
    if item == { 0 as *u8 } { return 1 as i8; }
    if { (*tree_unwrap(item)).is_dir } { return 1 as i8; }
    return 0 as i8;
}
fn tree_object_value_imp(user: *u8, ov: *u8, col: *u8, item: *u8) -> *u8 {
    if item == { 0 as *u8 } { return 0 as *u8; }
    let n: *TreeNode = tree_unwrap(item);
    return bridge::nsstring({ (*n).label }.view());
}

// --- selection delegate ---
fn tree_selection_imp(user: *u8, notif: *u8) {
    let c: *TreeSelCtx = { user as *TreeSelCtx };
    let f: fn(*u8, *u8) = { (*c).on_select };
    if { f as *u8 } == { 0 as *u8 } { return; }
    let ov: *u8 = { rt::msg_id(notif, rt::sel(#str_ptr("object\0"))) };
    let row: i64 = { rt::msg_i64(ov, rt::sel(#str_ptr("selectedRow\0"))) };
    if row < (0 as i64) { return; }
    let item: *u8 = { rt::msg_id_i64(ov, rt::sel(#str_ptr("itemAtRow:\0")), row) };
    if item == { 0 as *u8 } { return; }
    f({ (*c).caller_ctx }, item);
    return;
}

// Mount a caller-built node tree in an NSOutlineView. This is the AGNOSTIC
// primitive: `root` is whatever you built with `tree_node`/`tree_add_child`, so
// the widget knows nothing about the filesystem — ignore lists, pruning, depth
// limits and lazy loading are all your model's concern, not the widget's.
// Clicking a row calls `on_select(ctx, item)` where `item` is opaque — pass it
// to `tree_node_path` for the selected node's path. Size it with `.grow(1.0)`.
//
//   var kids: vec::Vec[*ui::TreeNode] = vec::new::[*ui::TreeNode]();
//   kids.append(ui::tree_node("main.cplus", "/proj/main.cplus", false));
//   let root = ui::tree_node("proj", "/proj", true);
//   ui::tree_add_child(root, kids.at(0)...);   // or add nodes one by one
//   ui::tree(root, on_select: open_file);
fn tree(root: *TreeNode, on_select: fn(*u8, *u8) = 0 as fn(*u8, *u8), ctx: *u8 = 0 as *u8, agent_id: str = "") -> flex::Node {
    let ov = ak::OutlineView::new();
    let col = ak::TableColumn::new("name");
    col.set_title("Name");
    let col_raw: *u8 = col.raw();
    ov.as_table_view().add_table_column(col);
    ov.set_outline_table_column(ak::TableColumn::from_raw(col_raw));

    var ds: ak::OutlineViewDataSource = ak::OutlineViewDataSource_new(root as *u8);
    ds.set_outline_view_number_of_children_of_item(tree_num_children_imp);
    ds.set_outline_view_child_of_item(tree_child_imp);
    ds.set_outline_view_is_item_expandable(tree_expandable_imp);
    ds.set_outline_view_object_value_for_table_column_by_item(tree_object_value_imp);
    let dsbox: *ak::OutlineViewDataSource = { malloc(#size_of::[ak::OutlineViewDataSource]()) as *ak::OutlineViewDataSource };
    { *dsbox = ds; }
    let dsobj: *u8 = ak::create_OutlineViewDataSource(dsbox);
    ov.set_data_source(dsobj);
    synth::retain_associated(ov.raw(), tree_ds_pin_key(), dsobj);

    let selbox: *TreeSelCtx = { malloc(#size_of::[TreeSelCtx]()) as *TreeSelCtx };
    { *selbox = TreeSelCtx { on_select: on_select, caller_ctx: ctx }; }
    var del: ak::OutlineViewDelegate = ak::OutlineViewDelegate_new(selbox as *u8);
    del.set_outline_view_selection_did_change(tree_selection_imp);
    let delbox: *ak::OutlineViewDelegate = { malloc(#size_of::[ak::OutlineViewDelegate]()) as *ak::OutlineViewDelegate };
    { *delbox = del; }
    let delobj: *u8 = ak::create_OutlineViewDelegate(delbox);
    ov.set_delegate(delobj);
    synth::retain_associated(ov.raw(), tree_del_pin_key(), delobj);

    ov.as_table_view().reload_data();

    let scroll = ak::ScrollView::new(rt::Rect { x: 0.0, y: 0.0, w: 0.0, h: 0.0 });
    scroll.set_has_vertical_scroller(true);
    scroll.set_document_view(ov.as_view());
    tag_agent(scroll.as_view().raw(), agent_id, identity::Role::List);
    return fixed_view(scroll.as_view());
}

// The eager convenience: `file_tree("/path/to/project", on_select: open_file)`
// walks the WHOLE directory rooted at `path` and mounts it with `tree(...)`.
// It applies no excludes and reads the tree in full on construction, so it is
// meant for small, bounded directories. For a large workspace — where you must
// skip `.git`/`target`/`vendor`, cap the depth, or load children lazily — that
// policy is not the widget's job: build the model yourself with
// `tree_node`/`tree_add_child` (drive it with `fs::read_dir` + your own ignore
// list) and mount it with `tree(root, ...)`.
fn file_tree(path: str, on_select: fn(*u8, *u8) = 0 as fn(*u8, *u8), ctx: *u8 = 0 as *u8, agent_id: str = "") -> flex::Node {
    let root: *TreeNode = build_tree(path, path);
    return tree(root, on_select: on_select, ctx: ctx, agent_id: agent_id);
}

// ==========================================================================
// list — a recycling flat list (NSTableView, view-based reuse)
// ==========================================================================
// The scaling answer for long content — chat logs, search results, feeds. Only
// the rows in (and near) the viewport are instantiated; as you scroll, cell
// views that leave the viewport are RECYCLED to render incoming rows, so a
// 10,000-row list costs about a screenful of views, not 10,000. `row(ctx, i)`
// builds row i's content as a @ui node (rebuilt only when a row scrolls into
// view); `count` is the total. Each row's height is its natural (flexed) height
// at the list's width — measured on demand and cached by NSTableView. Wrap the
// result into a @facet tree with `native_widget(list(...))`.

struct ListCtx {
    row: fn(*u8, i64) -> flex::Node,
    opaque caller_ctx: *u8,
    count: i64,
    opaque table: *u8,       // the NSTableView, for reload-on-resize
    last_width: f64,         // last content width; reload only when it changes
}

fn list_ds_pin_key() -> *u8 { return { 28694 as *u8 }; }
fn list_del_pin_key() -> *u8 { return { 28695 as *u8 }; }

// The list's content width (the column fills the last-column-autoresizing table).
fn list_col_width(tv: *u8) -> f64 {
    let w: f64 = ak::TableView::from_raw(tv).as_view().frame().w;
    if w < 1.0f64 { return 1.0f64; }
    return w;
}

fn list_num_rows_imp(user: *u8, tv: *u8) -> i64 {
    let c: *ListCtx = { user as *ListCtx };
    return { (*c).count };
}

fn list_height_imp(user: *u8, tv: *u8, row: i64) -> f64 {
    let c: *ListCtx = { user as *ListCtx };
    let f: fn(*u8, i64) -> flex::Node = { (*c).row };
    var node: flex::Node = f({ (*c).caller_ctx }, row);
    node.calculate_layout(list_col_width(tv), flex::undefined(), flex::Direction::LTR);
    node.round_to_pixel(2.0f64);
    let h: f64 = node.layout_frame().height;
    if h < 1.0f64 { return 1.0f64; }
    return h;
}

// Make a cell's content stretch horizontally, so its wrapping text RE-WRAPS
// live as the column width changes during a drag (the row heights then catch up
// on the debounced reload). Width-only: content stays top-aligned at its
// natural height with fixed left/right padding (NSViewWidthSizable keeps the
// margins fixed and lets the width absorb the change).
fn list_autoresize_subtree(v: ak::View) {
    v.set_autoresizing_mask(ak::autoresizing_mask_options_n_s_view_width_sizable);
    var subs: vec::Vec[ak::View] = v.subviews();
    let n: usize = subs.count();
    var i: usize = 0 as usize;
    while i < n {
        match subs.at_ptr(i) {
            option::Option[*ak::View]::Some(sp) => { list_autoresize_subtree(ak::View::from_raw({ (*sp).raw() })); }
            option::Option[*ak::View]::None => { }
        }
        i = i +% (1 as usize);
    }
    return;
}

fn list_view_for_row_imp(user: *u8, tv: *u8, col: *u8, row: i64) -> *u8 {
    let c: *ListCtx = { user as *ListCtx };
    let tvw: ak::TableView = ak::TableView::from_raw(tv);
    let w: f64 = list_col_width(tv);
    let f: fn(*u8, i64) -> flex::Node = { (*c).row };
    var node: flex::Node = f({ (*c).caller_ctx }, row);
    node.calculate_layout(w, flex::undefined(), flex::Direction::LTR);
    node.round_to_pixel(2.0f64);
    var h: f64 = node.layout_frame().height;
    if h < 1.0f64 { h = 1.0f64; }

    // Recycle a cell view (identity "cell"); make one on the first miss.
    var cell: ak::View = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: w, h: h });
    match tvw.make_view_with_identifier("cell", 0 as *u8) {
        option::Option[ak::View]::Some(v) => {
            cell = v;
            var subs: vec::Vec[ak::View] = cell.subviews();
            let sn: usize = subs.count();
            for i in 0..(sn as i32) {
                match subs.at_ptr(i as usize) {
                    option::Option[*ak::View]::Some(vp) => { { (*vp).remove_from_superview(); } }
                    option::Option[*ak::View]::None => { }
                }
            }
        }
        option::Option[ak::View]::None => {
            ak::UserInterfaceItemIdentification::from_raw(cell.raw()).set_identifier("cell");
        }
    }
    cell.set_frame(rt::Rect { x: 0.0, y: 0.0, w: w, h: h });
    apply(#addr_of(node), cell.raw(), false);
    list_autoresize_subtree(cell);   // content re-wraps live as the column widens
    return cell.raw();
}

// NSTableView caches row heights (and cells) by width, so a width change —
// dragging a split, resizing the window — leaves wrapped-text rows measured for
// the OLD width until something forces a re-query. Reload only on an actual
// width change (height-only changes keep the heights valid), and DEBOUNCE it:
// re-measuring every row on every resize frame is O(rows) per frame and janks
// the drag. `performSelector:withObject:afterDelay:` schedules the reload in the
// DEFAULT run-loop mode, which does not run during a live drag (event-tracking
// mode) — so cancelling+rescheduling each frame collapses to ONE reloadData
// after the drag settles. reloadData re-queries heightOfRow and rebuilds the
// visible cells at the final width; it doesn't change the table width, so no
// re-trigger loop.
fn list_reload_on_resize(ctx: *u8) {
    let c: *ListCtx = { ctx as *ListCtx };
    let tbl: *u8 = { (*c).table };
    let w: f64 = ak::TableView::from_raw(tbl).as_view().frame().w;
    if w == { (*c).last_width } { return; }
    { (*c).last_width = w; }
    let reload_sel: *u8 = rt::sel(#str_ptr("reloadData\0"));
    rt::msg_void_id_id_id(rt::get_class(#str_ptr("NSObject\0")), rt::sel(#str_ptr("cancelPreviousPerformRequestsWithTarget:selector:object:\0")), tbl, reload_sel, 0 as *u8);
    rt::msg_void_id_id_f64(tbl, rt::sel(#str_ptr("performSelector:withObject:afterDelay:\0")), reload_sel, 0 as *u8, 0.05f64);
    return;
}

// A recycling flat list — see the header comment above. `row(ctx, i)` builds
// row i; `count` rows total. Returns a scroll-wrapped NSTableView as a leaf.
fn list(count: i64, row: fn(*u8, i64) -> flex::Node, ctx: *u8 = 0 as *u8, agent_id: str = "") -> flex::Node {
    let tv = ak::TableView::new(rt::Rect { x: 0.0, y: 0.0, w: 0.0, h: 0.0 });
    let col = ak::TableColumn::new("col");
    tv.add_table_column(col);
    tv.set_column_autoresizing_style(ak::TableViewColumnAutoresizingStyle::NSTableViewLastColumnOnlyAutoresizingStyle);
    tv.set_header_view(ak::TableHeaderView::from_raw(0 as *u8));            // no header
    tv.set_selection_highlight_style(ak::TableViewSelectionHighlightStyle::None);
    tv.set_intercell_spacing(rt::Size { w: 0.0f64, h: 0.0f64 });

    let lbox: *ListCtx = { malloc(#size_of::[ListCtx]()) as *ListCtx };
    { *lbox = ListCtx { row: row, caller_ctx: ctx, count: count, table: tv.raw(), last_width: 0.0f64 }; }

    var ds: ak::TableViewDataSource = ak::TableViewDataSource_new(lbox as *u8);
    ds.set_number_of_rows_in_table_view(list_num_rows_imp);
    let dsbox: *ak::TableViewDataSource = { malloc(#size_of::[ak::TableViewDataSource]()) as *ak::TableViewDataSource };
    { *dsbox = ds; }
    let dsobj: *u8 = ak::create_TableViewDataSource(dsbox);
    tv.set_data_source(dsobj);
    synth::retain_associated(tv.raw(), list_ds_pin_key(), dsobj);

    var del: ak::TableViewDelegate = ak::TableViewDelegate_new(lbox as *u8);
    del.set_table_view_view_for_table_column_row(list_view_for_row_imp);
    del.set_table_view_height_of_row(list_height_imp);
    let delbox: *ak::TableViewDelegate = { malloc(#size_of::[ak::TableViewDelegate]()) as *ak::TableViewDelegate };
    { *delbox = del; }
    let delobj: *u8 = ak::create_TableViewDelegate(delbox);
    tv.set_delegate(delobj);
    synth::retain_associated(tv.raw(), list_del_pin_key(), delobj);

    tv.reload_data();

    // Re-measure/reflow rows when the table's width changes (split drag, window
    // resize) — otherwise wrapped rows keep their old-width heights until scrolled.
    akx::observe_frame_change(tv.as_view(), list_reload_on_resize, lbox as *u8);

    let scroll = ak::ScrollView::new(rt::Rect { x: 0.0, y: 0.0, w: 0.0, h: 0.0 });
    scroll.set_has_vertical_scroller(true);
    scroll.set_document_view(tv.as_view());
    tag_agent(scroll.as_view().raw(), agent_id, identity::Role::List);
    return fixed_view(scroll.as_view());
}

// ==========================================================================
// Builder protocol + containers (the `@ui` context)
// ==========================================================================

struct Builder {
    node: flex::Node,
}

impl Builder {
    fn new() -> Builder { return Builder { node: flex::Node::new() }; }
    fn add(ref this, take item: flex::Node) { this.node.add_child(item); return; }
    fn finish(take this) -> flex::Node { let Builder { node } = this; return node; }
}

// A vertical stack (the engine's default axis).
fn column(take b: Builder) -> flex::Node { let Builder { node } = b; return node; }

// A horizontal stack.
fn row(take b: Builder) -> flex::Node {
    let Builder { node } = b;
    var n: flex::Node = node;
    n.set_flex_direction(flex::FlexDirection::Row);
    return n;
}

// HIG presets, mirroring the engine's own `@flex` containers: 8pt between
// related items, 16pt card padding, 20pt screen margins.
fn vstack(take b: Builder) -> flex::Node {
    var n: flex::Node = column(b);
    n.set_gap(flex::Gutter::Row, flex::HIG_SPACE_S);
    return n;
}

fn hstack(take b: Builder) -> flex::Node {
    var n: flex::Node = row(b);
    n.set_gap(flex::Gutter::Column, flex::HIG_SPACE_S);
    return n;
}

fn screen(take b: Builder) -> flex::Node {
    var n: flex::Node = column(b);
    n.set_padding(flex::Edge::All, flex::StyleLength::points(flex::HIG_SPACE_L));
    n.set_gap(flex::Gutter::Row, flex::HIG_SPACE_S);
    return n;
}

fn card(take b: Builder) -> flex::Node {
    var n: flex::Node = column(b);
    n.set_padding(flex::Edge::All, flex::StyleLength::points(flex::HIG_SPACE_M));
    n.set_gap(flex::Gutter::Row, flex::HIG_SPACE_S);
    return n;
}

// ==========================================================================
// Actionable container — make any laid-out node respond to events
// ==========================================================================
//
// The missing clickable-CONTAINER primitive: only buttons fire actions, so an
// arbitrary row (icon + title + subtitle) had no way to respond to a click.
// `clickable` wraps `content` in a backing NSView and attaches one gesture
// recognizer per handler you pass; the whole node's bounds is the hit target,
// and children keep their own clicks (a button inside a clickable row still
// fires the button, AppKit-style). `ctx` is delivered to every handler — use it
// to identify the row/item. Only the handlers you pass are wired.
//
// Gesture events (via NSGestureRecognizers): click, double-click, right-click,
// long-press (`long_press_seconds` = hold time, 0 = system default), drag
// (pan), pinch (magnify), and rotate. Each handler is `fn(recognizer, ctx)` —
// read the `recognizer` (via `ak::*GestureRecognizer::from_raw`) for state /
// translation / magnification when you need it.
//
// Hover (`on_hover_in` / `on_hover_out`, `fn(view, ctx)`) and scroll
// (`on_scroll`, `fn(event, ctx)` — read `ak::Event::from_raw(event)` for the
// deltas) are not gestures: they swap the backing view for a custom view with a
// tracking area and a `scrollWheel:` override. Scroll still bubbles to an
// enclosing scroll view, so `on_scroll` only observes it.

// Unset handlers default to a null fn-pointer sentinel — wired only when set.
// (A literal `0 as fn(..)` is used because a default value can't reference a
// module fn by name.) A null handler is never called: it is only compared.
fn clickable(
    take content: flex::Node,
    ctx: *u8 = 0 as *u8,
    on_click: fn(*u8, *u8) = 0 as fn(*u8, *u8),
    on_double_click: fn(*u8, *u8) = 0 as fn(*u8, *u8),
    on_right_click: fn(*u8, *u8) = 0 as fn(*u8, *u8),
    on_long_press: fn(*u8, *u8) = 0 as fn(*u8, *u8),
    long_press_seconds: f64 = 0.0f64,
    on_drag: fn(*u8, *u8) = 0 as fn(*u8, *u8),
    on_pinch: fn(*u8, *u8) = 0 as fn(*u8, *u8),
    on_rotate: fn(*u8, *u8) = 0 as fn(*u8, *u8),
    on_hover_in: fn(*u8, *u8) = 0 as fn(*u8, *u8),
    on_hover_out: fn(*u8, *u8) = 0 as fn(*u8, *u8),
    on_scroll: fn(*u8, *u8) = 0 as fn(*u8, *u8),
    agent_id: str = "",
) -> flex::Node {
    let none: fn(*u8, *u8) = 0 as fn(*u8, *u8);
    let zero: rt::Rect = rt::Rect { x: 0.0f64, y: 0.0f64, w: 0.0f64, h: 0.0f64 };
    // Hover / scroll need a custom view (tracking area + scrollWheel:); every
    // gesture event rides a plain NSView.
    let needs_custom: bool = { on_hover_in } != none || { on_hover_out } != none || { on_scroll } != none;
    // Both backing views answer `performClick:` (agent-drive): the actionable
    // subclass for hover/scroll, the clickable subclass otherwise. So a tagged
    // whole-row clickable is openable over the app MCP, not just by the mouse.
    let bv: ak::View = if needs_custom {
        akx::new_actionable_view(zero, on_hover_in, on_hover_out, on_scroll, ctx)
    } else {
        akx::new_clickable_view(zero)
    };
    if { on_click } != none {
        akx::add_click_gesture(bv, on_click, ctx, 1 as i64, akx::primary_button_mask());
        // Route the agent's `performClick:` to the same primary-click handler.
        akx::set_agent_click(bv, on_click, ctx);
    }
    if { on_double_click } != none {
        akx::add_click_gesture(bv, on_double_click, ctx, 2 as i64, akx::primary_button_mask());
    }
    if { on_right_click } != none {
        akx::add_click_gesture(bv, on_right_click, ctx, 1 as i64, akx::secondary_button_mask());
    }
    if { on_long_press } != none {
        akx::add_press_gesture(bv, on_long_press, ctx, long_press_seconds);
    }
    if { on_drag } != none {
        akx::add_pan_gesture(bv, on_drag, ctx);
    }
    if { on_pinch } != none {
        akx::add_magnify_gesture(bv, on_pinch, ctx);
    }
    if { on_rotate } != none {
        akx::add_rotate_gesture(bv, on_rotate, ctx);
    }
    tag_agent(bv.raw(), agent_id, identity::Role::Button);

    // A bare container (no backing view of its own) hosts the recognizers
    // directly — `apply` lays its children into `bv`. A leaf/view is nested so
    // its own payload isn't clobbered.
    if content.payload() == (0 as *u8) {
        var n: flex::Node = content;
        n.set_payload(rt::retain(bv.raw()), release_view);
        return n;
    }
    var wrapper: flex::Node = flex::Node::new();
    wrapper.set_payload(rt::retain(bv.raw()), release_view);
    wrapper.add_child(content);
    return wrapper;
}

// ==========================================================================
// Apply — computed frames -> a real nested NSView tree
// ==========================================================================
//
// flex yields absolute, top-down frames. A leaf node contributes its
// payload view; a view-less container gets a fresh transparent NSView so
// its children nest inside it (per-row operations like "remove this row"
// then have a real superview to act on). `root_flipped` says whether
// `root_view` has a top-left origin (a flipped scroll document) or the
// standard bottom-left one.

fn apply(root: *flex::Node, root_view: *u8, root_flipped: bool) {
    let rf: flex::Layout = (*root).layout_frame();
    let rp: *u8 = (*root).payload();
    if rp != (0 as *u8) {
        // The content ROOT is itself a leaf widget — e.g. `scroll { one label }`,
        // where mount_wrapper_content returns the lone child directly, so the
        // tree's root carries the payload and has no children. apply_nested only
        // attaches CHILDREN's payloads, so attach the root's own here (filling
        // root_view), then recurse for any children under it. Mirrors
        // apply_nested's payload branch; payload views are non-flipped.
        let v: ak::View = ak::View::from_raw(rp);
        v.set_frame(rt::Rect { x: 0.0, y: 0.0, w: rf.width, h: rf.height });
        ak::View::from_raw(root_view).add_subview(v);
        apply_nested(root, rp, rf, false);
    } else {
        apply_nested(root, root_view, rf, root_flipped);
    }
    return;
}

fn child_z(node: *flex::Node, idx: usize) -> i32 {
    match (*node).children.at_ptr(idx) {
        option::Option[*flex::Node]::Some(cn) => { return { (*cn).z_index() }; }
        option::Option[*flex::Node]::None => { return 0 as i32; }
    }
}

fn order_at(order: *vec::Vec[usize], i: usize) -> usize {
    match (*order).at(i) {
        option::Option[usize]::Some(v) => { return v; }
        option::Option[usize]::None => { return 0 as usize; }
    }
}

// Child indices in PAINT order: stable-sorted by z_index (ties keep tree order).
// All-zero z (the common case) leaves 0..kc untouched — O(n), no reordering.
fn z_paint_order(node: *flex::Node, kc: usize) -> vec::Vec[usize] {
    var order: vec::Vec[usize] = vec::new::[usize]();
    var i: usize = 0 as usize;
    while i < kc {
        let _a = order.append(i);
        i = i +% (1 as usize);
    }
    var a: usize = 1 as usize;
    while a < kc {
        let key: usize = order_at(#addr_of(order), a);
        let kz: i32 = child_z(node, key);
        var b: i32 = (a as i32) - (1 as i32);
        while b >= (0 as i32) {
            let bv: usize = order_at(#addr_of(order), b as usize);
            if child_z(node, bv) <= kz { break; }   // stop shifting on ties (stable)
            let _s = order.set(bv, (b + 1) as usize);
            b = b - (1 as i32);
        }
        let _s2 = order.set(key, (b + 1) as usize);
        a = a +% (1 as usize);
    }
    return order;
}

fn apply_nested(node: *flex::Node, parent_ptr: *u8, parent_abs: flex::Layout, parent_flipped: bool) {
    let kc: usize = (*node).child_count();
    // Add children in z_index paint order so higher-z siblings land last and
    // draw on top (AppKit paints later subviews over earlier ones).
    var order: vec::Vec[usize] = z_paint_order(node, kc);
    var oi: usize = 0 as usize;
    while oi < kc {
        let i: usize = order_at(#addr_of(order), oi);
        oi = oi +% (1 as usize);
        match (*node).children.at_ptr(i) {
            option::Option[*flex::Node]::Some(cn) => {
                let cf: flex::Layout = (*cn).layout_frame();   // absolute
                let x: f64 = cf.left - parent_abs.left;        // relative to parent
                let y: f64 = if parent_flipped { cf.top - parent_abs.top } else { parent_abs.height - (cf.top - parent_abs.top) - cf.height };
                let rect = rt::Rect { x: x, y: y, w: cf.width, h: cf.height };
                let cp: *u8 = (*cn).payload();
                if cp != (0 as *u8) {
                    let v: ak::View = ak::View::from_raw(cp);
                    v.set_frame(rect);
                    ak::View::from_raw(parent_ptr).add_subview(v);
                    apply_nested(cn, cp, cf, false);   // payload views are non-flipped
                } else if (*cn).child_count() > (0 as usize) {
                    // Synthesize the container's backing view ONCE and hand it
                    // to the node (payload-owned +1, like every widget leaf):
                    // a retained relayout can then reposition the same view
                    // instead of orphaning it and minting another. A later
                    // pass over this tree takes the payload branch above.
                    let bv: ak::View = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 0.0, h: 0.0 });
                    let bp: *u8 = rt::retain(bv.raw());
                    { (*cn).set_payload(bp, release_view); }
                    bv.set_frame(rect);
                    ak::View::from_raw(parent_ptr).add_subview(ak::View::from_raw(bp));
                    apply_nested(cn, bp, cf, false);   // fresh container, non-flipped
                }
            }
            option::Option[*flex::Node]::None => { }
        }
    }
}

// ==========================================================================
// Reposition — retained relayout's frame pass
// ==========================================================================
//
// Walk an already-applied tree and set each node's EXISTING view frame from
// the freshly computed layout. Nothing is created, added, or removed —
// `apply` must have run on this tree once (every container then owns its
// synthesized backing view). Mirrors apply's root-payload branch and its
// flip math exactly.

fn reposition(root: *flex::Node, root_flipped: bool) {
    // The engine reports whether the last pass re-laid this subtree at all;
    // a full cache hit (e.g. a vertical-only resize of a width-driven tree)
    // means every frame below is bit-identical — nothing to move.
    if (*root).layout_changed() == false { return; }
    let rf: flex::Layout = (*root).layout_frame();
    let rp: *u8 = (*root).payload();
    if rp != (0 as *u8) {
        ak::View::from_raw(rp).set_frame(rt::Rect { x: 0.0, y: 0.0, w: rf.width, h: rf.height });
        reposition_nested(root, rf, false);
    } else {
        reposition_nested(root, rf, root_flipped);
    }
    return;
}

fn reposition_nested(node: *flex::Node, parent_abs: flex::Layout, parent_flipped: bool) {
    let kc: usize = (*node).child_count();
    for i in 0..(kc as i32) {
        match (*node).children.at_ptr(i as usize) {
            option::Option[*flex::Node]::Some(cn) => {
                let cf: flex::Layout = (*cn).layout_frame();   // absolute
                let x: f64 = cf.left - parent_abs.left;        // relative to parent
                let y: f64 = if parent_flipped { cf.top - parent_abs.top } else { parent_abs.height - (cf.top - parent_abs.top) - cf.height };
                let cp: *u8 = (*cn).payload();
                if cp != (0 as *u8) {
                    // The child's OWN AppKit frame is parent-relative (the
                    // bottom-up flip reads the parent's height), so it must be
                    // re-set even when the child's absolute frame is unchanged.
                    ak::View::from_raw(cp).set_frame(rt::Rect { x: x, y: y, w: cf.width, h: cf.height });
                    // Its DESCENDANTS' frames are relative to the child only:
                    // a cache-skipped child means every absolute frame under
                    // it is unchanged — the views already sit exactly there.
                    // Descending anyway would be thousands of no-op set_frame
                    // msgsends per frame on a large tree.
                    if { (*cn).layout_changed() } {
                        reposition_nested(cn, cf, false);   // payload views are non-flipped
                    }
                }
                // A payload-less node with children cannot occur on an applied
                // tree (apply gave every such container a backing view); a
                // payload-less leaf (spacer, bare box) has no view to move.
            }
            option::Option[*flex::Node]::None => { }
        }
    }
    return;
}

// ==========================================================================
// Scroll — the two-phase pattern, packaged
// ==========================================================================
//
// A scroll document can't be laid out until the outer pass has sized the
// viewport. After the outer layout + apply, hand the row content here: it
// is laid out at the viewport width, applied into a fresh FLIPPED document
// view (rows read top-down, list opens at the top), and installed as the
// scroll's document. Returns the document height. The row tree is RETAINED
// in the scroll-content registry (keyed by the scroll view), so a retained
// relayout can re-wrap the rows at a new viewport width; its views live on
// under the document view either way.

fn fill_scroll(s: ak::ScrollView, take rows: flex::Node) -> f64 {
    let sf: rt::Rect = s.as_view().frame();
    var r: flex::Node = rows;
    r.calculate_layout(sf.w, flex::undefined(), flex::Direction::LTR);
    r.round_to_pixel(2.0f64);
    let rf: flex::Layout = r.layout_frame();
    let doc = akx::new_flipped_view(rt::Rect { x: 0.0, y: 0.0, w: sf.w, h: rf.height });
    apply(#addr_of(r), doc.raw(), true);
    s.set_document_view(ak::View::from_raw(doc.raw()));
    scroll_content_store(s.raw(), r);
    return rf.height;
}

// ==========================================================================
// Scroll-content registry — retained row trees for scroll viewports
// ==========================================================================
//
// `fill_scroll` lays a DETACHED row tree into the scroll's document view;
// without keeping that tree, a retained relayout could resize the viewport
// but never re-wrap the rows. So the tree is stored here, keyed by the
// scroll view. The entry RETAINS its scroll (+1): a component rebuild may
// drop the scroll while the entry still holds the key, and `tree_remove`
// then forgets the entry exactly (no liveness heuristics).

struct ScrollContent {
    opaque _scroll: *u8,   // +1 on the NSScrollView; released in drop
    _tree: flex::Node,     // the laid-out row tree (owns the row views' +1s)
}

impl ScrollContent {
    fn drop(ref this) {
        if this._scroll != (0 as *u8) {
            rt::release(this._scroll);
            this._scroll = 0 as *u8;
        }
        return;
    }
}

static SCROLL_CONTENT: vec::Vec[ScrollContent] = #zero::[vec::Vec[ScrollContent]]();

// Replace (or create) the retained row tree for `scroll`. The previous tree
// drops here; the applied row views live on under the document view. Each
// store also prunes entries whose scroll left the view hierarchy — the
// one-shot mount paths (mount_into / run) fill scrolls nobody unregisters,
// so without this a mount-per-frame caller would grow the registry forever.
fn scroll_content_store(scroll: *u8, take rows: flex::Node) {
    if scroll == { 0 as *u8 } { return; }
    let _had: bool = scroll_content_remove(scroll);
    prune_detached_scroll_content();
    let reg: *vec::Vec[ScrollContent] = #addr_of(SCROLL_CONTENT);
    (*reg).append(ScrollContent { _scroll: rt::retain(scroll), _tree: rows });
    return;
}

// Drop every entry whose scroll view has no superview (its owner discarded
// it). Safe to message: the entry holds its own +1 on the scroll.
fn prune_detached_scroll_content() {
    let reg: *vec::Vec[ScrollContent] = #addr_of(SCROLL_CONTENT);
    var i: usize = 0 as usize;
    while i < { (*reg).count() } {
        var detached: bool = false;
        match (*reg).at_ptr(i) {
            option::Option[*ScrollContent]::Some(ep) => {
                let sup: *u8 = { rt::msg_id({ (*ep)._scroll }, rt::sel(#str_ptr("superview\0"))) };
                if sup == { 0 as *u8 } { detached = true; }
            }
            option::Option[*ScrollContent]::None => { }
        }
        if detached {
            let _g: option::Option[ScrollContent] = (*reg).swap_remove(i);
            // swap_remove moved the tail into slot i — re-examine i.
        } else {
            i = i +% (1 as usize);
        }
    }
    return;
}

fn scroll_content_remove(scroll: *u8) -> bool {
    let reg: *vec::Vec[ScrollContent] = #addr_of(SCROLL_CONTENT);
    let n: usize = { (*reg).count() };
    var i: usize = 0 as usize;
    while i < n {
        match (*reg).at_ptr(i) {
            option::Option[*ScrollContent]::Some(ep) => {
                if { (*ep)._scroll } == scroll {
                    let _g: option::Option[ScrollContent] = (*reg).swap_remove(i);
                    return true;
                }
            }
            option::Option[*ScrollContent]::None => { }
        }
        i = i +% (1 as usize);
    }
    return false;
}

// The number of retained scroll-content trees (tests).
fn scroll_content_count() -> usize {
    return SCROLL_CONTENT.count();
}

// Borrow the stored row tree for `scroll` (None when absent). The pointer
// aims into the registry's storage: valid only while the registry does not
// mutate — use it within one relayout pass.
fn scroll_content_tree(scroll: *u8) -> option::Option[*flex::Node] {
    let reg: *vec::Vec[ScrollContent] = #addr_of(SCROLL_CONTENT);
    let n: usize = { (*reg).count() };
    var i: usize = 0 as usize;
    while i < n {
        match (*reg).at_ptr(i) {
            option::Option[*ScrollContent]::Some(ep) => {
                if { (*ep)._scroll } == scroll {
                    return option::Option[*flex::Node]::Some(#addr_of((*ep)._tree));
                }
            }
            option::Option[*ScrollContent]::None => { }
        }
        i = i +% (1 as usize);
    }
    return option::Option[*flex::Node]::None;
}

// Forget every registry entry keyed by a scroll view living in `node`'s
// payload slots — called on a tree that is about to be replaced/dropped, so
// entries die exactly when their owner does.
fn scroll_content_forget_tree(node: *flex::Node) {
    let p: *u8 = (*node).payload();
    if p != (0 as *u8) { let _r: bool = scroll_content_remove(p); }
    let kc: usize = (*node).child_count();
    for i in 0..(kc as i32) {
        match (*node).children.at_ptr(i as usize) {
            option::Option[*flex::Node]::Some(cn) => { scroll_content_forget_tree(cn); }
            option::Option[*flex::Node]::None => { }
        }
    }
    return;
}

// Re-lay a registered scroll's row tree at the viewport's CURRENT width,
// resize the (reused) document view, and reposition the existing row views —
// then recurse into scrolls nested inside those rows. The engine's cross-call
// cache makes an unchanged-width pass near-free. Returns whether `scroll`
// had registered content.
fn reflow_scroll_content(scroll: *u8) -> bool {
    match scroll_content_tree(scroll) {
        option::Option[*flex::Node]::Some(tp) => {
            let s: ak::ScrollView = ak::ScrollView::from_raw(scroll);
            let sf: rt::Rect = s.as_view().frame();
            { (*tp).calculate_layout(sf.w, flex::undefined(), flex::Direction::LTR); }
            { (*tp).round_to_pixel(2.0f64); }
            // Unchanged viewport width ⇒ full cache hit ⇒ every row frame
            // (and every nested scroll's content) is exactly as last pass.
            if { (*tp).layout_changed() } == false { return true; }
            let rf: flex::Layout = (*tp).layout_frame();
            match s.document_view() {
                option::Option[ak::View]::Some(dv) => {
                    dv.set_frame(rt::Rect { x: 0.0, y: 0.0, w: sf.w, h: rf.height });
                }
                option::Option[ak::View]::None => { return false; }
            }
            reposition(tp, true);      // flipped document, same as fill_scroll's apply
            reflow_nested_scrolls(tp);
            return true;
        }
        option::Option[*flex::Node]::None => { return false; }
    }
    return false;
}

// Walk a repositioned tree and reflow every registered scroll under it (the
// viewports' frames are final by now; their row content still needs the
// width-aware pass).
fn reflow_nested_scrolls(node: *flex::Node) {
    let p: *u8 = (*node).payload();
    if p != (0 as *u8) { let _r: bool = reflow_scroll_content(p); }
    let kc: usize = (*node).child_count();
    for i in 0..(kc as i32) {
        match (*node).children.at_ptr(i as usize) {
            option::Option[*flex::Node]::Some(cn) => { reflow_nested_scrolls(cn); }
            option::Option[*flex::Node]::None => { }
        }
    }
    return;
}

// ==========================================================================
// The component runtime
// ==========================================================================
// A component is a plain struct: fields = state, handlers = `ref this`
// methods in the inherent impl, `render` in the checked contract block
// (`impl Foo: facet::Component`, render -> flex::Node with full @ui reach).
// The runtime here is erased: it never sees the type, only
// (component address, erased render fn) — which is exactly what a bound
// method reference produces:
//
//     ui::mount(RECENTS.build, host: panel.raw());
//     ...
//     icon_button("xmark", on: recents.remove_at)
//
// The ONE update rule: facet is NOT reactive. `build` runs once at mount; an
// action wire runs its handler and nothing more. STATE reaches the screen
// through the keyed-direct path (the handler calls facet::find(ctx, key) and a
// mutator — set_text / set_value / add_child / ... — editing the live view in
// place). There is no re-render, no diff.
//
// GEOMETRY (window resize) is the one thing this tier updates:
//   relayout(cp)   — re-lay the RETAINED tree out at the host's current size
//                    and reposition the existing views. No render, no view
//                    churn; the flex engine's incremental cache does the
//                    heavy lifting. Assumes the tree's shape is stable (a pure
//                    size change gives that; keyed-direct edits mutate the
//                    retained tree, then relayout reflows it).
//
// Hosts are BORROWED plain NSViews the app owns (usually placed in its
// outer tree via `fixed_view`); a scroll document host uses flipped: true.

struct Slot {
    opaque _cp: *u8,                    // borrowed: the app owns the component
    _render: fn(*u8) -> flex::Node,
    opaque _host: *u8,                  // borrowed: the app owns the host view
    _flipped: bool,
    _scroll: bool,                      // host is an NSScrollView: content-size + reflow the doc
    _live: bool,
}

static SLOTS: vec::Vec[Slot] = #zero::[vec::Vec[Slot]]();

// The retained flex tree of a mounted component, keyed by the component
// address — what `relayout` re-lays-out and repositions without a render.
// Kept OUTSIDE Slot on purpose: a tree reached through a raw *Slot could
// never be replaced safely (E0509 — no move out of a Drop field through a
// deref), while a registry entry swaps in and out whole by value.
struct SlotTree {
    opaque _cp: *u8,
    _tree: flex::Node,
}

static TREES: vec::Vec[SlotTree] = #zero::[vec::Vec[SlotTree]]();

// Replace (or create) the retained tree for `cp`. The previous tree drops
// here — its view +1s release; the freshly applied views live on under the
// host. cp 0 (the "no component" sentinel) stores nothing: it can never be
// relaid-out, so the tree just drops.
fn tree_store(cp: *u8, take tree: flex::Node) {
    if cp == { 0 as *u8 } { return; }
    let _had: bool = tree_remove(cp);
    let trees: *vec::Vec[SlotTree] = #addr_of(TREES);
    (*trees).append(SlotTree { _cp: cp, _tree: tree });
    return;
}

// Drop the retained tree for `cp`, forgetting any scroll-content rows keyed
// by scroll views inside it (exact cleanup — entries die with their owner).
fn tree_remove(cp: *u8) -> bool {
    let trees: *vec::Vec[SlotTree] = #addr_of(TREES);
    let n: usize = { (*trees).count() };
    var i: usize = 0 as usize;
    while i < n {
        match (*trees).at_ptr(i) {
            option::Option[*SlotTree]::Some(tp) => {
                if { (*tp)._cp } == cp {
                    match (*trees).swap_remove(i) {
                        option::Option[SlotTree]::Some(entry) => {
                            scroll_content_forget_tree(#addr_of(entry._tree));
                            return true;   // entry (and its tree) drops here
                        }
                        option::Option[SlotTree]::None => { }
                    }
                    return true;
                }
            }
            option::Option[*SlotTree]::None => { }
        }
        i = i +% (1 as usize);
    }
    return false;
}

// Borrow the retained tree for `cp` (None when the component never rendered).
// The pointer aims into the registry's storage: valid only while the registry
// does not mutate — use it within one relayout pass.
fn tree_ptr(cp: *u8) -> option::Option[*flex::Node] {
    let trees: *vec::Vec[SlotTree] = #addr_of(TREES);
    let n: usize = { (*trees).count() };
    var i: usize = 0 as usize;
    while i < n {
        match (*trees).at_ptr(i) {
            option::Option[*SlotTree]::Some(tp) => {
                if { (*tp)._cp } == cp {
                    return option::Option[*flex::Node]::Some(#addr_of((*tp)._tree));
                }
            }
            option::Option[*SlotTree]::None => { }
        }
        i = i +% (1 as usize);
    }
    return option::Option[*flex::Node]::None;
}

// The host view a component was mounted into (0 if not slot-mounted). Lets the
// keyed-direct `find(key)` resolve keys against the LIVE view hierarchy (walking
// real NSViews), instead of msgSend-ing flex payloads that may not be views.
fn host_of(cp: *u8) -> *u8 {
    let slots: *vec::Vec[Slot] = #addr_of(SLOTS);
    let n: usize = { (*slots).count() };
    var i: usize = 0 as usize;
    while i < n {
        match (*slots).at_ptr(i) {
            option::Option[*Slot]::Some(sp) => {
                if { (*sp)._cp } == cp { return { (*sp)._host }; }
            }
            option::Option[*Slot]::None => { }
        }
        i = i +% (1 as usize);
    }
    return 0 as *u8;
}

// A post-render hook the upper (facet) layer installs. It runs after every
// component render's `apply`, so a component whose subtree contains a portable
// `scroll` / `split` reflows it: those kinds defer work (the two-phase fill /
// the divider re-assert) into a job queue that lives in facet_appkit, and this
// lower layer can't name that queue directly — so the backend registers a
// drain fn here. Null (no facet backend in use) = a no-op.
static POST_RENDER_HOOK: fn() = #zero::[fn()]();
fn set_post_render_hook(h: fn()) { POST_RENDER_HOOK = h; return; }
fn run_post_render_hook() {
    let h: fn() = POST_RENDER_HOOK;
    if h != (0 as fn()) { h(); }
    return;
}

// Render one slot into its host at the host's current size. The previous
// subtree is removed first; the fresh flex tree is RETAINED in the tree
// registry (replacing — and dropping — the previous one), so `relayout` can
// later reposition the applied views without re-rendering. The applied
// NSViews live on under the host, each retained by its superview.
fn render_slot(sp: *Slot) -> f64 {
    if { (*sp)._scroll } { return render_slot_scroll(sp); }
    // Copy the registration out first: the render below may mount ANOTHER
    // component, growing SLOTS and moving its storage — `sp` must not be
    // read after `r` runs.
    let cp: *u8 = { (*sp)._cp };
    let r: fn(*u8) -> flex::Node = { (*sp)._render };
    let host_ptr: *u8 = { (*sp)._host };
    let flipped: bool = { (*sp)._flipped };
    let host: ak::View = ak::View::from_raw(host_ptr);
    var subs: vec::Vec[ak::View] = host.subviews();
    let cnt: usize = subs.count();
    for i in 0..(cnt as i32) {
        match subs.at_ptr(i as usize) {
            option::Option[*ak::View]::Some(vp) => { { (*vp).remove_from_superview(); } }
            option::Option[*ak::View]::None => { }
        }
    }
    let hf: rt::Rect = host.frame();
    var tree: flex::Node = r(cp);
    tree.calculate_layout(hf.w, hf.h, flex::Direction::LTR);
    tree.round_to_pixel(2.0f64);
    apply(#addr_of(tree), host_ptr, flipped);
    let f: flex::Layout = tree.layout_frame();
    tree_store(cp, tree);     // keep for relayout; replaces (drops) the old tree
    run_post_render_hook();   // fill any deferred scroll/split in the subtree
    return f.height;
}

// Scroll-mode render: lay the component out at the scroll's viewport width with
// an unbounded height (content-sized), then reflow the FLIPPED document view.
// The document view is REUSED when it already exists — its old rows are removed,
// it is resized to the new content height, and the fresh tree is applied into it
// — so the scroll offset survives a reflow. Only the first mount creates the
// document view. Returns the content height.
fn render_slot_scroll(sp: *Slot) -> f64 {
    // Same copy-out rule as render_slot: `sp` is dead once the render runs.
    let cp: *u8 = { (*sp)._cp };
    let r: fn(*u8) -> flex::Node = { (*sp)._render };
    let host_ptr: *u8 = { (*sp)._host };
    let s: ak::ScrollView = ak::ScrollView::from_raw(host_ptr);
    let width: f64 = s.as_view().frame().w;
    var tree: flex::Node = r(cp);
    tree.calculate_layout(width, flex::undefined(), flex::Direction::LTR);
    tree.round_to_pixel(2.0f64);
    let rf: flex::Layout = tree.layout_frame();
    let doc_rect: rt::Rect = rt::Rect { x: 0.0, y: 0.0, w: width, h: rf.height };
    match s.document_view() {
        option::Option[ak::View]::Some(dv) => {
            var subs: vec::Vec[ak::View] = dv.subviews();
            let cnt: usize = subs.count();
            for i in 0..(cnt as i32) {
                match subs.at_ptr(i as usize) {
                    option::Option[*ak::View]::Some(vp) => { { (*vp).remove_from_superview(); } }
                    option::Option[*ak::View]::None => { }
                }
            }
            dv.set_frame(doc_rect);
            apply(#addr_of(tree), dv.raw(), true);
        }
        option::Option[ak::View]::None => {
            let doc = akx::new_flipped_view(doc_rect);
            apply(#addr_of(tree), doc.raw(), true);
            s.set_document_view(ak::View::from_raw(doc.raw()));
        }
    }
    tree_store(cp, tree);     // keep for relayout; replaces (drops) the old tree
    run_post_render_hook();   // fill any deferred scroll/split nested in the rows
    return rf.height;
}

// Mount a component into a host view: `ui::mount(COUNTER.build, host: v)`.
// The bound reference fills `ctx` with the component's address; `render` runs
// once at mount. The retained tree it produces is kept for relayout. Returns
// the content height (-1.0 when host is missing).
fn mount(render: fn(*u8) -> flex::Node, ctx: *u8 = 0 as *u8, host: *u8 = 0 as *u8, flipped: bool = false) -> f64 {
    if host == { 0 as *u8 } { return -1.0f64; }
    // Re-mounting the same component address replaces its prior slot, so a
    // later relayout never targets a stale (released) host. remove_slot
    // no-ops on ctx 0 / no prior registration.
    let _r: bool = remove_slot(ctx);
    let slots: *vec::Vec[Slot] = #addr_of(SLOTS);
    (*slots).append(Slot { _cp: ctx, _render: render, _host: host, _flipped: flipped, _scroll: false, _live: true });
    let n: usize = SLOTS.count();
    match SLOTS.at_ptr(n -% (1 as usize)) {
        option::Option[*Slot]::Some(sp) => { return render_slot(sp); }
        option::Option[*Slot]::None => { }
    }
    return -1.0f64;
}

// Mount a component whose host is an NSScrollView: `ui::mount_scroll(RECENTS.build,
// scroll: sv.raw())`. Unlike `mount` (fixed-frame host), the content is laid out
// at the viewport width with an UNBOUNDED height, so a growing list is not
// clipped; the flipped document view is sized to fit and REUSED, so the scroll
// position survives a keyed-direct add/remove. `relayout(cp)` reflows it at a
// new width. Call after the outer layout has sized the scroll (same two-phase
// rule as `fill_scroll`). Returns content height (-1.0 when `scroll` is
// missing).
fn mount_scroll(render: fn(*u8) -> flex::Node, ctx: *u8 = 0 as *u8, scroll: *u8 = 0 as *u8, agent_id: str = "") -> f64 {
    if scroll == { 0 as *u8 } { return -1.0f64; }
    if agent_id != "" { tag_agent(scroll, agent_id, identity::Role::Group); }
    let _r: bool = remove_slot(ctx);   // replace any prior registration (see mount)
    let slots: *vec::Vec[Slot] = #addr_of(SLOTS);
    (*slots).append(Slot { _cp: ctx, _render: render, _host: scroll, _flipped: true, _scroll: true, _live: true });
    let n: usize = SLOTS.count();
    match SLOTS.at_ptr(n -% (1 as usize)) {
        option::Option[*Slot]::Some(sp) => { return render_slot(sp); }
        option::Option[*Slot]::None => { }
    }
    return -1.0f64;
}

// Forget a view's cached measure answers (fittingSize + wrap) — the
// keyed-direct set_text mutator calls this after it edits a measured widget's
// text in place, so the next layout pass re-asks TextKit instead of serving
// the stale size.
fn clear_measure_caches(view_ptr: *u8) {
    if view_ptr == { 0 as *u8 } { return; }
    rt::set_associated_object(view_ptr, measure_cache_key(), 0 as *u8, 0 as usize);
    rt::set_associated_object(view_ptr, wrap_cache_avail_key(), 0 as *u8, 0 as usize);
    rt::set_associated_object(view_ptr, wrap_cache_size_key(), 0 as *u8, 0 as usize);
    return;
}

// ==========================================================================
// Retained relayout — the geometry-only update verb
// ==========================================================================
//
// Re-lay the ONE component registered at this address out at its host's
// CURRENT size by REUSING the tree kept from mount: recompute the flex layout
// (the engine's cross-call incremental cache skips unchanged subtrees) and
// reposition the EXISTING views. No render, no mount, no view churn — this is
// the window-resize path, and the reflow after a keyed-direct edit mutates the
// retained tree. relayout assumes the tree's shape is stable (a pure size
// change gives that; keyed-direct edits update the tree before reflowing). A
// component that has no retained tree yet falls back to a full render. Returns
// whether a mounted component was found.
fn relayout(cp: *u8) -> bool {
    if cp == { 0 as *u8 } { return false; }
    let n: usize = SLOTS.count();
    var i: usize = 0 as usize;
    while i < n {
        match SLOTS.at_ptr(i) {
            option::Option[*Slot]::Some(sp) => {
                if { (*sp)._live } {
                    if { (*sp)._cp } == cp {
                        let host_ptr: *u8 = { (*sp)._host };
                        let flipped: bool = { (*sp)._flipped };
                        let scroll: bool = { (*sp)._scroll };
                        match tree_ptr(cp) {
                            option::Option[*flex::Node]::Some(tp) => {
                                if scroll {
                                    relayout_scroll_host(host_ptr, tp);
                                } else {
                                    let hf: rt::Rect = ak::View::from_raw(host_ptr).frame();
                                    { (*tp).calculate_layout(hf.w, hf.h, flex::Direction::LTR); }
                                    { (*tp).round_to_pixel(2.0f64); }
                                    reposition(tp, flipped);
                                    reflow_nested_scrolls(tp);
                                }
                            }
                            option::Option[*flex::Node]::None => {
                                let _h: f64 = render_slot(sp);   // first render still pending
                            }
                        }
                        return true;
                    }
                }
            }
            option::Option[*Slot]::None => { }
        }
        i = i +% (1 as usize);
    }
    return false;
}

// The scroll-hosted variant (mount_scroll): content-size the retained tree at
// the viewport's current width, resize the reused document view, reposition.
fn relayout_scroll_host(host_ptr: *u8, tp: *flex::Node) {
    let s: ak::ScrollView = ak::ScrollView::from_raw(host_ptr);
    let width: f64 = s.as_view().frame().w;
    { (*tp).calculate_layout(width, flex::undefined(), flex::Direction::LTR); }
    { (*tp).round_to_pixel(2.0f64); }
    // Same viewport width ⇒ full cache hit ⇒ content-sized doc + every row
    // frame unchanged; nothing to move.
    if { (*tp).layout_changed() } == false { return; }
    let rf: flex::Layout = (*tp).layout_frame();
    match s.document_view() {
        option::Option[ak::View]::Some(dv) => {
            dv.set_frame(rt::Rect { x: 0.0, y: 0.0, w: width, h: rf.height });
        }
        option::Option[ak::View]::None => { return; }   // never applied: nothing to move
    }
    reposition(tp, true);   // flipped document, same as render_slot_scroll's apply
    reflow_nested_scrolls(tp);
    return;
}

// Drop every registration (window teardown, tests). Host views and
// components are borrowed; the retained trees (and their view +1s) drop —
// the applied views themselves live on under their superviews.
fn unmount_all() {
    let slots: *vec::Vec[Slot] = #addr_of(SLOTS);
    (*slots).remove_all();
    let trees: *vec::Vec[SlotTree] = #addr_of(TREES);
    (*trees).remove_all();
    let reg: *vec::Vec[ScrollContent] = #addr_of(SCROLL_CONTENT);
    (*reg).remove_all();
    return;
}

// Drop the (first) registration for one component address, if present.
// swap_remove keeps the vec compact; relayout scans all slots, so reordering
// is harmless. Host + component are borrowed, so nothing they own is released;
// the component's RETAINED TREE drops with the registration. No-ops on ctx 0
// (the "no component" sentinel). Returns whether a slot was removed.
fn remove_slot(cp: *u8) -> bool {
    if cp == { 0 as *u8 } { return false; }
    let slots: *vec::Vec[Slot] = #addr_of(SLOTS);
    let n: usize = { (*slots).count() };
    var i: usize = 0 as usize;
    while i < n {
        match (*slots).at_ptr(i) {
            option::Option[*Slot]::Some(sp) => {
                if { (*sp)._cp } == cp {
                    let _g: option::Option[Slot] = (*slots).swap_remove(i);
                    let _t: bool = tree_remove(cp);
                    return true;
                }
            }
            option::Option[*Slot]::None => { }
        }
        i = i +% (1 as usize);
    }
    return false;
}

// Unmount ONE component — a window closing its own components without disturbing
// another window's (vs `unmount_all`). Its slot is dropped, so a later
// relayout(cp) no-ops instead of reaching a released host. Returns whether a
// registration was found.
fn unmount(cp: *u8) -> bool {
    return remove_slot(cp);
}

// ==========================================================================
// Tests — the builder protocol, widget wiring, apply math, and scroll fill.
// These call the protocol functions directly (exactly what a `@ui` block
// desugars to); the literal `@ui` syntax runs in src/test_main.cplus, whose
// import closure pulls this module in.
// ==========================================================================

fn approx(a: f64, b: f64) -> bool {
    let d: f64 = a - b;
    if d < 0.0f64 { return (0.0f64 - d) < 0.01f64; }
    return d < 0.01f64;
}

#[test]
fn test_label_owns_view_and_measures() {
    let n: flex::Node = label("hello", size: 13.0f64);
    assert n.has_payload();
    let tf: ak::TextField = ak::TextField::from_raw(n.payload());
    let t = tf.as_control().string_value();
    assert t.count() == (5 as usize);
}

#[test]
fn test_measure_cache_hit_returns_the_same_size() {
    // The CACHE-HIT unpack path must round-trip the packed size exactly.
    // Regression: the low-32 mask was written as `4294967295 as u64`, which
    // wraps through i32 to -1 and sign-extends to ALL-ONES — every cache hit
    // then returned packed_bits/256 as the height (~5e11 points), blowing up
    // any layout that measured a label twice. The mask is now derived
    // arithmetically (low32()).
    assert low32() == (((1 as u64) << (32 as u64)) -% (1 as u64));
    var n: flex::Node = label("agent_surface.cplus", size: 11.5f64);
    n.calculate_layout(300.0f64, flex::undefined(), flex::Direction::LTR);
    let f1: flex::Layout = n.layout_frame();
    assert f1.height > 1.0f64;
    assert f1.height < 100.0f64;           // sane label height
    // Force a re-measure: the second pass serves from the assoc cache.
    n.mark_content_changed();
    n.calculate_layout(300.0f64, flex::undefined(), flex::Direction::LTR);
    let f2: flex::Layout = n.layout_frame();
    assert approx(f2.height, f1.height);   // was ~5e11 with the bad mask
    assert approx(f2.width, f1.width);

    // Same round-trip discipline for the wrap cache (width-keyed).
    var w: flex::Node = wrap_label("a wrapping label long enough to take at least two lines at this width", size: 12.0f64);
    w.calculate_layout(180.0f64, flex::undefined(), flex::Direction::LTR);
    let g1: flex::Layout = w.layout_frame();
    assert g1.height > 1.0f64;
    assert g1.height < 200.0f64;
    w.mark_content_changed();
    w.calculate_layout(180.0f64, flex::undefined(), flex::Direction::LTR);
    let g2: flex::Layout = w.layout_frame();
    assert approx(g2.height, g1.height);
    assert approx(g2.width, g1.width);
}

#[test]
fn test_button_wires_title_and_view() {
    let n: flex::Node = button("OK", on: test_noop_action);
    assert n.has_payload();
    let b: ak::Button = ak::Button::from_raw(n.payload());
    let t = b.title();
    assert t.count() == (2 as usize);
}

fn test_noop_action(sender: *u8, ctx: *u8) { return; }

static CTX_FIRES: i32 = 0;
static CTX_SEEN: i64 = 0;

fn test_ctx_action(sender: *u8, ctx: *u8) {
    CTX_FIRES = CTX_FIRES + 1;
    CTX_SEEN = ctx as i64;
    return;
}

#[test]
fn test_button_ctx_delivers_userdata() {
    CTX_FIRES = 0;
    let n: flex::Node = button_ctx("del", on: test_ctx_action, ctx: 5 as *u8);
    let bp: *u8 = n.payload();
    // Fire through the wired target/action, as a click would.
    let t: *u8 = rt::msg_id(bp, rt::sel(#str_ptr("target\0")));
    let a: *u8 = rt::msg_id(bp, rt::sel(#str_ptr("action\0")));
    assert t != (0 as *u8);
    rt::msg_void_id(t, a, bp);
    assert CTX_FIRES == 1;
    assert CTX_SEEN == (5 as i64);
}

