fn tabs_test_content(idx: i64, ctx: *u8) -> flex::Node {
    return label("pane");
}

#[test]
fn test_tabs_reflows_the_correct_pane_among_several() {
    // Multi-pane: driving one host's frame-change must reflow THAT pane (the
    // lookup keys by host), not a neighbor. Guards a mis-keyed reflow.
    var labels: vec::Vec[text::Text] = vec::new::[text::Text]();
    labels.append(text::from_str("A"));
    labels.append(text::from_str("B"));
    labels.append(text::from_str("C"));
    let n: flex::Node = tabs(#addr_of(labels), tabs_test_content, selected: 0 as i64);
    let tv = ak::TabView::from_raw(n.payload());
    // Reflow tab 2 (not the selected one) by giving its host a size.
    let host2: ak::View = match tv.tab_view_item_at_index(2 as i64).view() {
        option::Option[ak::View]::Some(v) => v,
        option::Option[ak::View]::None => { assert false; return; }
    };
    host2.set_frame(rt::Rect { x: 0.0, y: 0.0, w: 200.0, h: 140.0 });
    tab_host_resized(host2.raw());
    var subs2: vec::Vec[ak::View] = host2.subviews();
    assert subs2.count() >= (1 as usize);   // tab 2's content installed
    return;
}

#[test]
fn test_tabs_builds_items_and_reads_selection() {
    var labels: vec::Vec[text::Text] = vec::new::[text::Text]();
    labels.append(text::from_str("General"));
    labels.append(text::from_str("Editor"));
    labels.append(text::from_str("Advanced"));
    let before: usize = TAB_PANES.count();
    let n: flex::Node = tabs(#addr_of(labels), tabs_test_content, selected: 1 as i64);
    assert n.has_payload();
    let tv = ak::TabView::from_raw(n.payload());
    assert tv.number_of_tab_view_items() == (3 as i64);
    // Each tab registered one hosted pane.
    assert TAB_PANES.count() == before +% (3 as usize);
    // Selection reads back through the payload.
    assert tabs_selected_index(n.payload()) == (1 as i64);
}

#[test]
fn test_tabs_reflows_pane_content_when_host_gains_a_size() {
    // Guards the presented-at-0x0 failure mode: a tab's content must lay out
    // into its host once the host has a real frame. NSTabView sizes the host and
    // the frame-change observer reflows the pane. A bare leaf as tab content
    // (exercised here) must install too — the fill-container wrap ensures apply
    // always has a child to place.
    var labels: vec::Vec[text::Text] = vec::new::[text::Text]();
    labels.append(text::from_str("Only"));
    let n: flex::Node = tabs(#addr_of(labels), tabs_test_content);
    let tv = ak::TabView::from_raw(n.payload());
    let host: ak::View = match tv.tab_view_item_at_index(0 as i64).view() {
        option::Option[ak::View]::Some(v) => v,
        option::Option[ak::View]::None => { assert false; return; }
    };
    // Drive a reflow at a known size; the content installs and lays out to a
    // positive width (never 0x0).
    host.set_frame(rt::Rect { x: 0.0, y: 0.0, w: 240.0, h: 160.0 });
    tab_host_resized(host.raw());
    var subs: vec::Vec[ak::View] = host.subviews();
    assert subs.count() >= (1 as usize);
    match subs.at_ptr(0 as usize) {
        option::Option[*ak::View]::Some(sv) => { assert { (*sv).frame().w } > 0.0f64; }
        option::Option[*ak::View]::None => { assert false; }
    }
    return;
}

fn grid_test_cell(idx: i64, ctx: *u8) -> flex::Node {
    return label("cell");
}

#[test]
fn test_grid_counts_and_builds_a_laid_out_cell() {
    var gc: GridCtx = GridCtx { item_fn: grid_test_cell, caller_ctx: 0 as *u8, count: 7 as i64, item_w: 100.0f64, item_h: 80.0f64 };
    let up: *u8 = { #addr_of(gc) as *u8 };
    // The count callback reports the model size.
    assert grid_num_items_imp(up, 0 as *u8, 0 as i64) == (7 as i64);
    // Build cell 2 through a real NSIndexPath; the item hosts laid-out content
    // (guards the empty-cell / 0x0 failure mode, like the tab reflow test).
    let ip: *u8 = rt::msg_id_i64_i64(rt::get_class(#str_ptr("NSIndexPath\0")), rt::sel(#str_ptr("indexPathForItem:inSection:\0")), 2 as i64, 0 as i64);
    let item_raw: *u8 = grid_item_imp(up, 0 as *u8, ip);
    assert item_raw != { 0 as *u8 };
    let item: ak::CollectionViewItem = ak::CollectionViewItem::from_raw(item_raw);
    var subs: vec::Vec[ak::View] = item.as_view_controller().view().subviews();
    assert subs.count() >= (1 as usize);
    match subs.at_ptr(0 as usize) {
        option::Option[*ak::View]::Some(sv) => { assert { (*sv).frame().w } > 0.0f64; }
        option::Option[*ak::View]::None => { assert false; }
    }
    return;
}

#[test]
fn test_popover_host_mounts_and_lays_out_content() {
    // The testable core of show_popover (the show step needs a live window).
    // A leaf as popover content installs into the fixed-size host and lays out.
    var tree: flex::Node = flex::Node::new();
    let host: ak::View = popover_host(label("hello"), 280.0f64, 180.0f64, { #addr_of(tree) });
    assert host.frame().w == 280.0f64;
    var subs: vec::Vec[ak::View] = host.subviews();
    assert subs.count() >= (1 as usize);
    match subs.at_ptr(0 as usize) {
        option::Option[*ak::View]::Some(sv) => { assert { (*sv).frame().w } > 0.0f64; }
        option::Option[*ak::View]::None => { assert false; }
    }
    return;
}

#[test]
fn test_composer_builds_reads_text_and_reports_height() {
    // Construction wires the delegate (weak, so pinned); the Enter-to-send /
    // Shift+Enter behaviour itself needs a live event loop to exercise.
    let n: flex::Node = composer(on_submit: test_noop_action, value: "hello");
    assert n.has_payload();
    assert area_text(n.payload()).equals("hello");
    let h: f64 = composer_content_height(n.payload());   // callable pre-layout
    assert h >= 0.0f64;
}

static KEYED_REMOVED: i64 = -1;
fn keyed_on_remove(sender: *u8, ctx: *u8) { KEYED_REMOVED = ctx as i64; return; }

#[test]
fn test_keyed_rows_carry_distinct_stable_keys() {
    // React-list-with-keys: each row carries its OWN stable key (as ctx) and a
    // unique agent_id — not the loop index. Distinct backing views, distinct
    // pinned keys; a row's handler delivers ITS key, so remove-by-key works.
    let r1: flex::Node = clickable(label("alpha"), ctx: 101 as *u8, on_click: keyed_on_remove, agent_id: "row-alpha");
    let r2: flex::Node = clickable(label("beta"), ctx: 202 as *u8, on_click: keyed_on_remove, agent_id: "row-beta");
    assert r1.payload() != r2.payload();
    assert ak::Accessibility::from_raw(r1.payload()).accessibility_identifier().equals("row-alpha");
    assert ak::Accessibility::from_raw(r2.payload()).accessibility_identifier().equals("row-beta");
}

#[test]
fn test_split_hosts_two_arranged_panes() {
    let n: flex::Node = split(label("tree"), label("editor"), position: 200.0f64);
    assert n.has_payload();
    let sv: ak::SplitView = ak::SplitView::from_raw(n.payload());
    assert sv.is_vertical();                              // side-by-side by default
    assert sv.arranged_subviews().count() == (2 as usize);
    // Min-width dragging is a live behaviour; only construction is checked here.
}

#[test]
fn test_split_hosts_a_container_pane() {
    // A multi-element pane (a column) has no single backing view, so the split
    // gives it its OWN host as the second arranged subview — a fresh, empty view
    // (not the pane's payload, which is null). The leaf pane goes in directly.
    var cb: Builder = Builder::new();
    cb.add(box().width(10.0f64).height(10.0f64));
    cb.add(box().width(10.0f64).height(10.0f64));
    let pane: flex::Node = vstack(cb);
    assert pane.payload() == (0 as *u8);                  // a container: no single view

    let n: flex::Node = split(label("side"), pane);
    let sv: ak::SplitView = ak::SplitView::from_raw(n.payload());
    assert sv.arranged_subviews().count() == (2 as usize);   // leaf pane + hosted pane

    var subs: vec::Vec[ak::View] = sv.arranged_subviews();
    match subs.at_ptr(1 as usize) {
        option::Option[*ak::View]::Some(hp) => {
            assert { (*hp).subviews().count() } == (0 as usize);    // empty host until sized
        }
        option::Option[*ak::View]::None => { assert false; }
    }
    return;
}

#[test]
fn test_reflow_pane_lays_subtree_into_its_host() {
    // reflow_pane lays a hosted pane's subtree into its host at the host's
    // current size. A live NSSplitView owns its arranged subviews' frames (and
    // won't lay out headless), so this drives reflow_pane directly against a
    // host whose frame we control — proving the layout+install half of the path.
    let host: ak::View = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 200.0f64, h: 400.0f64 });
    var cb: Builder = Builder::new();
    cb.add(label("top"));                                 // real leaves (payload views)
    cb.add(label("bottom"));
    let pane: flex::Node = vstack(cb);
    var sp: SplitPane = SplitPane { split: host.raw(), host: host.raw(), tree: pane, applied: false };

    assert host.subviews().count() == (0 as usize);       // nothing installed yet
    reflow_pane(#addr_of(sp));
    assert host.subviews().count() > (0 as usize);        // the column's boxes installed
    assert { sp.applied };                                // first pass ran apply (not reposition)
    return;
}

fn list_test_row(i: i64, ctx: *u8) -> flex::Node {
    return wrap_label("a message row long enough to wrap across more than one line at a narrow width");
}

#[test]
fn test_list_reports_row_count() {
    let n: flex::Node = list(count: 500 as i64, row: list_test_row);
    assert n.has_payload();                               // scroll-wrapped table leaf
    var ctx: ListCtx = ListCtx { row: list_test_row, caller_ctx: 0 as *u8, count: 500 as i64, table: 0 as *u8, last_width: 0.0f64, follow_tail: false, repin_target: 0 as *u8, heights: vec::new::[f64](), heights_width: 0.0f64, fixed_height: 0.0f64 };
    assert list_num_rows_imp(#addr_of(ctx) as *u8, 0 as *u8) == (500 as i64);
    return;
}


static T_ROW_BUILDS: i32 = 0;
fn list_counting_row(i: i64, ctx: *u8) -> flex::Node {
    T_ROW_BUILDS = T_ROW_BUILDS + (1 as i32);
    return label("row");
}

#[test]
fn list_row_heights_are_measured_once_and_cached() {
    // The scroll hitch: NSTableView asks heightOfRow: for EVERY row whenever it
    // recomputes geometry, and measuring means running the app's row builder and
    // laying the subtree out. Uncached, a scroll re-built every row on every
    // pass. A measured row must be built exactly ONCE per width.
    let n: flex::Node = list(count: 50 as i64, row: list_counting_row);
    let dv: *u8 = { rt::msg_id(n.payload(), rt::sel(#str_ptr("documentView\0"))) };
    ak::TableView::from_raw(dv).as_view().set_frame(rt::Rect { x: 0.0, y: 0.0, w: 300.0, h: 200.0 });
    var ctx: ListCtx = ListCtx { row: list_counting_row, caller_ctx: 0 as *u8, count: 50 as i64, table: 0 as *u8, last_width: 0.0f64, follow_tail: false, repin_target: 0 as *u8, heights: vec::new::[f64](), heights_width: 0.0f64, fixed_height: 0.0f64 };
    let up: *u8 = { #addr_of(ctx) as *u8 };

    T_ROW_BUILDS = 0;
    let h0: f64 = list_height_imp(up, dv, 0 as i64);
    assert T_ROW_BUILDS == (1 as i32);          // measured
    assert h0 > 0.0f64;

    // Every later ask for the same row is served from the cache.
    var i: i32 = 0 as i32;
    while i < (20 as i32) {
        assert list_height_imp(up, dv, 0 as i64) == h0;
        i = i + (1 as i32);
    }
    assert T_ROW_BUILDS == (1 as i32);          // still ONE build, not 21

    // A different row measures once, then caches too.
    let h5: f64 = list_height_imp(up, dv, 5 as i64);
    assert T_ROW_BUILDS == (2 as i32);
    assert list_height_imp(up, dv, 5 as i64) == h5;
    assert T_ROW_BUILDS == (2 as i32);

    // A WIDTH change must invalidate — wrapped rows reflow, so a stale height
    // would clip the row's tail.
    var cols: vec::Vec[ak::TableColumn] = ak::TableView::from_raw(dv).table_columns();
    match cols.at_ptr(0 as usize) {
        option::Option[*ak::TableColumn]::Some(cp) => { { (*cp).set_width(120.0f64); } }
        option::Option[*ak::TableColumn]::None => { assert false; }
    }
    let _h: f64 = list_height_imp(up, dv, 0 as i64);
    assert T_ROW_BUILDS == (3 as i32);          // re-measured at the new width
    return;
}



#[test]
fn list_with_a_fixed_row_height_never_builds_a_row_to_measure() {
    // The cheapest a list can be: uniform rows answer heightOfRow: from a
    // constant, so no row is built, no layout runs, and nothing is cached.
    let n: flex::Node = list(count: 200 as i64, row: list_counting_row, row_height: 28.0f64);
    let dv: *u8 = { rt::msg_id(n.payload(), rt::sel(#str_ptr("documentView\0"))) };
    let cp: *u8 = rt::get_associated_object(dv, list_ctx_key());
    assert cp != (0 as *u8);
    T_ROW_BUILDS = 0;
    var i: i64 = 0 as i64;
    while i < (200 as i64) {
        assert list_height_imp(cp, dv, i) == 28.0f64;
        i = i + (1 as i64);
    }
    assert T_ROW_BUILDS == (0 as i32);   // 200 heights, zero row builds
    return;
}

#[test]
fn list_height_cache_is_invalidated_when_content_can_change() {
    // A cached height is only valid for the DATA it was measured from. Before
    // caching, heightOfRow: re-ran the row builder and always saw current data;
    // the cache must not turn that into a stale measurement. Asserted on the
    // cache itself — reload_data legitimately re-measures, so counting builds
    // across it would measure the harness, not the invalidation.
    let n: flex::Node = list(count: 10 as i64, row: list_counting_row);
    let scroll: *u8 = n.payload();
    let dv: *u8 = { rt::msg_id(scroll, rt::sel(#str_ptr("documentView\0"))) };
    ak::TableView::from_raw(dv).as_view().set_frame(rt::Rect { x: 0.0, y: 0.0, w: 300.0, h: 200.0 });
    let cp: *u8 = rt::get_associated_object(dv, list_ctx_key());
    assert cp != (0 as *u8);
    let c: *ListCtx = { cp as *ListCtx };
    let hp: *vec::Vec[f64] = { #addr_of((*c).heights) };

    // A measurement populates the cache.
    let _h: f64 = list_height_imp(cp, dv, 0 as i64);
    assert { (*hp).count() } > (0 as usize);

    // 1. Explicit invalidation, given the SCROLL host — an app holds the outer
    //    handle, not the inner table, so the walk must unwrap documentView.
    assert list_invalidate_heights(scroll);
    assert { (*hp).count() } == (0 as usize);

    // 2. A keyed-direct edit inside the list invalidates through reflow_owner,
    //    so set_text on a row does not leave a stale height behind.
    let _h2: f64 = list_height_imp(cp, dv, 0 as i64);
    assert { (*hp).count() } > (0 as usize);
    let _r: bool = reflow_owner(0 as *u8, dv);
    assert { (*hp).count() } == (0 as usize);

    // 3. Invalidating from an element that is NOT in a list is a no-op, not a
    //    crash — the walk probes documentView rather than assuming it.
    let outside: flex::Node = label("x");
    assert !list_invalidate_heights(outside.payload());
    return;
}

#[test]
fn test_list_measures_at_the_column_width() {
    // Heights must be measured at the width a cell actually GETS — the column
    // width. When a style/inset makes the column narrower than the table
    // frame, measuring at frame width wraps to fewer lines than rendering
    // and clips the row's tail.
    let n: flex::Node = list(count: 3 as i64, row: list_test_row);
    let dv: *u8 = { rt::msg_id(n.payload(), rt::sel(#str_ptr("documentView\0"))) };
    let tvw: ak::TableView = ak::TableView::from_raw(dv);
    tvw.as_view().set_frame(rt::Rect { x: 0.0, y: 0.0, w: 300.0, h: 200.0 });
    var cols: vec::Vec[ak::TableColumn] = tvw.table_columns();
    match cols.at_ptr(0 as usize) {
        option::Option[*ak::TableColumn]::Some(cp) => { { (*cp).set_width(260.0f64); } }
        option::Option[*ak::TableColumn]::None => { assert false; }
    }
    assert list_col_width(dv) == 260.0f64;
    // A wrapped row measured at 260 is TALLER than at 300 — the row height
    // follows the narrower, true cell width.
    var ctx: ListCtx = ListCtx { row: list_test_row, caller_ctx: 0 as *u8, count: 3 as i64, table: 0 as *u8, last_width: 0.0f64, follow_tail: false, repin_target: 0 as *u8, heights: vec::new::[f64](), heights_width: 0.0f64, fixed_height: 0.0f64 };
    let h_narrow: f64 = list_height_imp(#addr_of(ctx) as *u8, dv, 0 as i64);
    assert h_narrow > 0.0f64;
    return;
}

#[test]
fn test_list_set_count_grows_a_mounted_list() {
    // The live-transcript verb: a mounted list's count updates IN PLACE via the
    // ctx pinned on its table — the table re-queries the data source and
    // reports the new count. Works from the scroll payload (documentView reach)
    // and from the inner table alike; a non-list view is a no-op false.
    let n: flex::Node = list(count: 2 as i64, row: list_test_row);
    assert list_set_count(n.payload(), 7 as i64);
    let dv: *u8 = { rt::msg_id(n.payload(), rt::sel(#str_ptr("documentView\0"))) };
    assert ak::TableView::from_raw(dv).number_of_rows() == (7 as i64);
    assert list_set_count(dv, 3 as i64, scroll_to_end: true);   // table ptr + tail pin
    assert ak::TableView::from_raw(dv).number_of_rows() == (3 as i64);
    let plain: ak::View = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 10.0, h: 10.0 });
    assert list_set_count(plain.raw(), 5 as i64) == false;
    return;
}

#[test]
fn test_list_resize_captures_tail_follow_and_wires_repin() {
    // The resize path's SYNCHRONOUS half: a mounted list wires a repin target,
    // and a width change records the tail-follow decision + the new width (the
    // debounced reload+repin itself needs a run loop and real scroll geometry,
    // so it is verified live). Guards the wiring that would silently break the
    // "narrowing scrolls the chat up" fix.
    let n: flex::Node = list(count: 5 as i64, row: list_test_row);
    let dv: *u8 = { rt::msg_id(n.payload(), rt::sel(#str_ptr("documentView\0"))) };
    let cp: *u8 = rt::get_associated_object(dv, list_ctx_key());
    assert cp != (0 as *u8);
    let c: *ListCtx = { cp as *ListCtx };
    assert { (*c).repin_target } != (0 as *u8);          // resize pass has a target to fire on

    // A standalone table (no enclosing scroll view) reads as at-bottom — the
    // guard path that keeps a scroll-less list pinning.
    let bare: ak::TableView = ak::TableView::new(rt::Rect { x: 0.0, y: 0.0, w: 100.0f64, h: 50.0f64 });
    assert list_is_near_bottom(bare.raw());

    // A width change records BOTH the new width and the tail-follow decision
    // (whatever the geometry reads — captured before the reload changes it).
    ak::TableView::from_raw(dv).as_view().set_frame(rt::Rect { x: 0.0, y: 0.0, w: 180.0f64, h: 300.0f64 });
    let expect: bool = list_is_near_bottom(dv);
    list_reload_on_resize(cp);
    assert { (*c).last_width } == 180.0f64;
    assert { (*c).follow_tail } == expect;               // populated from near-bottom
    // A same-width call is a no-op — no spurious reschedule.
    let before: f64 = { (*c).last_width };
    list_reload_on_resize(cp);
    assert { (*c).last_width } == before;
    return;
}

#[test]
fn test_list_row_measures_and_builds_cell() {
    // Row height is the flexed content's natural height at the list width; the
    // returned cell hosts that content (this is what a recycled cell re-fills).
    let tv: ak::TableView = ak::TableView::new(rt::Rect { x: 0.0, y: 0.0, w: 200.0f64, h: 400.0f64 });
    var ctx: ListCtx = ListCtx { row: list_test_row, caller_ctx: 0 as *u8, count: 3 as i64, table: 0 as *u8, last_width: 0.0f64, follow_tail: false, repin_target: 0 as *u8, heights: vec::new::[f64](), heights_width: 0.0f64, fixed_height: 0.0f64 };
    let h: f64 = list_height_imp(#addr_of(ctx) as *u8, tv.raw(), 0 as i64);
    assert h > 0.0f64;                                    // measured a real, wrapped height
    let cell_ptr: *u8 = list_view_for_row_imp(#addr_of(ctx) as *u8, tv.raw(), 0 as *u8, 0 as i64);
    assert cell_ptr != (0 as *u8);
    assert ak::View::from_raw(cell_ptr).subviews().count() > (0 as usize);   // content installed
    return;
}

#[test]
fn change_hooked_text_area_lets_enter_through() {
    // A text_area with on_change reuses the composer delegate with a NULL
    // on_submit: plain Enter must fall through to the default newline (0 =
    // not handled), not be swallowed as a submit. A real composer (non-null
    // on_submit) still swallows it; any other command falls through.
    let none: fn(*u8, *u8) = 0 as fn(*u8, *u8);
    let ins: *u8 = rt::sel(#str_ptr("insertNewline:\0"));
    var no_submit: akx::ComposerCtx = akx::ComposerCtx { on_change: test_noop_action, on_submit: none, caller_ctx: 0 as *u8 };
    assert akx::composer_do_command_imp(#addr_of(no_submit) as *u8, 0 as *u8, ins) == (0 as i8);
    var with_submit: akx::ComposerCtx = akx::ComposerCtx { on_change: none, on_submit: test_noop_action, caller_ctx: 0 as *u8 };
    assert akx::composer_do_command_imp(#addr_of(with_submit) as *u8, 0 as *u8, ins) == (1 as i8);
    assert akx::composer_do_command_imp(#addr_of(with_submit) as *u8, 0 as *u8, rt::sel(#str_ptr("moveDown:\0"))) == (0 as i8);
}

static ORDER_SENDER: *u8 = #zero::[*u8]();
static ORDER_CTX: *u8 = #zero::[*u8]();
fn record_order(sender: *u8, ctx: *u8) { ORDER_SENDER = sender; ORDER_CTX = ctx; return; }

#[test]
fn composer_submit_delivers_sender_then_ctx() {
    // The delegate MUST call handlers as (sender, ctx) — the control-action
    // order the compiler's bound-method thunk expects (ctx = receiver, LAST).
    // ctx-first dispatched bound methods with `this` = the text view.
    let none: fn(*u8, *u8) = 0 as fn(*u8, *u8);
    var cctx: akx::ComposerCtx = akx::ComposerCtx { on_change: none, on_submit: record_order, caller_ctx: 7 as *u8 };
    let tv_fake: *u8 = 9 as *u8;
    assert akx::composer_do_command_imp(#addr_of(cctx) as *u8, tv_fake, rt::sel(#str_ptr("insertNewline:\0"))) == (1 as i8);
    assert ORDER_SENDER == (9 as *u8);
    assert ORDER_CTX == (7 as *u8);
}

#[test]
fn composer_remaps_ctrl_enter_to_real_newline() {
    // Ctrl+Enter arrives as insertLineBreak:; the delegate claims it (1 =
    // handled) and performs insertNewline: on the text view instead, so the
    // buffer gets "\n", never U+2028 — with or without a submit handler
    // (tv = nil here: the remap message is a safe ObjC no-op).
    let none: fn(*u8, *u8) = 0 as fn(*u8, *u8);
    let brk: *u8 = rt::sel(#str_ptr("insertLineBreak:\0"));
    var with_submit: akx::ComposerCtx = akx::ComposerCtx { on_change: none, on_submit: test_noop_action, caller_ctx: 0 as *u8 };
    assert akx::composer_do_command_imp(#addr_of(with_submit) as *u8, 0 as *u8, brk) == (1 as i8);
    var no_submit: akx::ComposerCtx = akx::ComposerCtx { on_change: test_noop_action, on_submit: none, caller_ctx: 0 as *u8 };
    assert akx::composer_do_command_imp(#addr_of(no_submit) as *u8, 0 as *u8, brk) == (1 as i8);
}

// The scroll-hosted inner NSTextView of a text_area node (asserting helper).
fn area_text_view(n: *flex::Node) -> ak::TextView {
    let dv: *u8 = { rt::msg_id({ (*n).payload() }, rt::sel(#str_ptr("documentView\0"))) };
    assert dv != (0 as *u8);
    return ak::TextView::from_raw(dv);
}

#[test]
fn test_text_area_editable_gets_undo() {
    var e: flex::Node = text_area(value: "x", editable: true);
    assert area_text_view(#addr_of(e)).allows_undo();
    // A read-only viewer needs no undo stack.
    var r: flex::Node = text_area(value: "x", editable: false);
    assert area_text_view(#addr_of(r)).allows_undo() == false;
}

#[test]
fn test_text_area_smart_substitutions_off() {
    // The code-editing configuration turns the auto-substitutions off.
    var n: flex::Node = text_area(value: "x", smart_substitutions: false);
    assert area_text_view(#addr_of(n)).is_automatic_quote_substitution_enabled() == false;
}

#[test]
fn test_text_area_no_wrap_scrolls_horizontally() {
    var n: flex::Node = text_area(value: "x", wrap: false);
    let sv: ak::ScrollView = ak::ScrollView::from_raw(n.payload());
    assert sv.has_horizontal_scroller();
    let tv: ak::TextView = area_text_view(#addr_of(n));
    assert tv.as_text().is_horizontally_resizable();
    match tv.text_container() {
        option::Option[ak::TextContainer]::Some(tc) => {
            assert tc.width_tracks_text_view() == false;
        }
        option::Option[ak::TextContainer]::None => { assert false; }
    };
    // The default (wrapping) area keeps the vertical-only configuration.
    var d: flex::Node = text_area(value: "x");
    assert ak::ScrollView::from_raw(d.payload()).has_horizontal_scroller() == false;
}

#[test]
fn test_text_area_line_numbers_installs_gutter_ruler() {
    var n: flex::Node = text_area(value: "one\ntwo", line_numbers: true);
    let sv: ak::ScrollView = ak::ScrollView::from_raw(n.payload());
    assert sv.has_vertical_ruler();
    match sv.vertical_ruler_view() {
        option::Option[ak::RulerView]::Some(rv) => {
            assert rv.rule_thickness() == (48.0f64);
            // Our subclass, not a stock NSRulerView.
            let cls: *u8 = rt::get_class(#str_ptr("CplusExt_LineNumberRuler\0"));
            assert rt::msg_i8_id(rv.raw(), rt::sel(#str_ptr("isKindOfClass:\0")), cls) != (0 as i8);
        }
        option::Option[ak::RulerView]::None => { assert false; }
    };
    // Default: no ruler machinery at all.
    var d: flex::Node = text_area(value: "x");
    assert ak::ScrollView::from_raw(d.payload()).has_vertical_ruler() == false;
}

#[test]
fn test_text_area_holds_and_replaces_text() {
    let n: flex::Node = text_area(value: "fn main() {}");
    assert n.has_payload();
    assert area_text(n.payload()).equals("fn main() {}");
    set_area_text(n.payload(), "let x = 1;");            // opening a different file
    assert area_text(n.payload()).equals("let x = 1;");
}

// A view-based row builder for the tree tests: a folder/doc icon by kind + the
// node's own label, laid out in a row — exercises the same accessors iris uses.
fn tree_test_row_id(item: *u8, ctx: *u8) -> text::Text {
    return "t:row:${tree_node_path(item).view()}";
}

fn tree_test_row(item: *u8, ctx: *u8) -> flex::Node {
    var b: Builder = Builder::new();
    if tree_node_is_dir(item) { b.add(symbol("folder", 14.0f64)); }
    else                      { b.add(symbol("doc", 14.0f64)); }
    b.add(label(tree_node_label(item).view(), size: 14.0f64));
    var n: flex::Node = row(b);
    n.set_align_items(flex::Align::Center);
    return n;
}

#[test]
fn test_tree_item_accessors_read_label_and_kind() {
    // The row-builder accessors recover a node's basename + dir-ness from the
    // opaque item wrapper (same wrapper on_select / viewForColumn receive).
    let dir: *TreeNode = tree_node("src", "/proj/src", true);
    let file: *TreeNode = tree_node("main.cplus", "/proj/src/main.cplus", false);
    assert tree_node_label({ (*dir).item }).equals("src");
    assert tree_node_is_dir({ (*dir).item });
    assert tree_node_label({ (*file).item }).equals("main.cplus");
    assert !tree_node_is_dir({ (*file).item });
    assert tree_node_path({ (*file).item }).equals("/proj/src/main.cplus");
    // Null-safe: a nil item yields empty / false, never a crash.
    assert tree_node_label(0 as *u8).equals("");
    assert !tree_node_is_dir(0 as *u8);
    return;
}

#[test]
fn test_tree_view_row_fixed_height_builds_cell() {
    // With a fixed row_height, heightOfRow returns it verbatim and viewForColumn
    // builds a cell hosting the row's content (this is what a recycled cell
    // re-fills). Needs an outline view + outline table column for the width.
    let ov = ak::OutlineView::new();
    let col = ak::TableColumn::new("name");
    col.set_width(180.0f64);
    let col_raw: *u8 = col.raw();
    ov.as_table_view().add_table_column(col);
    ov.set_outline_table_column(ak::TableColumn::from_raw(col_raw));

    let node: *TreeNode = tree_node("main.cplus", "/proj/main.cplus", false);
    let item: *u8 = { (*node).item };
    var dc: TreeDelCtx = TreeDelCtx { on_select: 0 as fn(*u8, *u8), caller_ctx: 0 as *u8, row: tree_test_row, row_ctx: 0 as *u8, row_id: tree_test_row_id, row_id_ctx: 0 as *u8, row_height: 34.0f64 };

    let h: f64 = tree_height_imp(#addr_of(dc) as *u8, ov.raw(), item);
    assert approx(h, 34.0f64);                               // fixed height honored verbatim

    let cell_ptr: *u8 = tree_view_for_column_imp(#addr_of(dc) as *u8, ov.raw(), col_raw, item);
    assert cell_ptr != (0 as *u8);
    assert ak::View::from_raw(cell_ptr).subviews().count() > (0 as usize);   // content installed
    // The row-id builder stamped the cell's agent identity for THIS item.
    let rid: *u8 = rt::msg_id(cell_ptr, rt::sel(#str_ptr("accessibilityIdentifier\0")));
    assert rid != (0 as *u8);
    let rid_t: text::Text = bridge::to_text(rid);
    assert rid_t.view() == "t:row:/proj/main.cplus";
    return;
}

#[test]
fn test_tree_view_row_measures_when_height_unset() {
    // row_height <= 0 means "measure": heightOfRow flexes the built node at the
    // column width and returns its natural height (> 0).
    let ov = ak::OutlineView::new();
    let col = ak::TableColumn::new("name");
    col.set_width(180.0f64);
    ov.as_table_view().add_table_column(col);
    ov.set_outline_table_column(ak::TableColumn::from_raw(col.raw()));

    let node: *TreeNode = tree_node("main.cplus", "/proj/main.cplus", false);
    var dc: TreeDelCtx = TreeDelCtx { on_select: 0 as fn(*u8, *u8), caller_ctx: 0 as *u8, row: tree_test_row, row_ctx: 0 as *u8, row_id: 0 as fn(*u8, *u8) -> text::Text, row_id_ctx: 0 as *u8, row_height: 0.0f64 };
    let h: f64 = tree_height_imp(#addr_of(dc) as *u8, ov.raw(), { (*node).item });
    assert h > 0.0f64;                                       // a real, measured height
    return;
}

#[test]
fn test_tree_default_row_has_no_view_builder() {
    // Without a row builder the delegate ctx carries the null sentinel — the
    // native object-value text cell renders the row, and viewForColumn returns
    // nil so NSOutlineView falls back to it. The widget still builds.
    let node: *TreeNode = tree_node("readme.md", "/proj/readme.md", false);
    var dc: TreeDelCtx = TreeDelCtx { on_select: 0 as fn(*u8, *u8), caller_ctx: 0 as *u8, row: 0 as fn(*u8, *u8) -> flex::Node, row_ctx: 0 as *u8, row_id: 0 as fn(*u8, *u8) -> text::Text, row_id_ctx: 0 as *u8, row_height: 0.0f64 };
    let ov = ak::OutlineView::new();
    assert tree_view_for_column_imp(#addr_of(dc) as *u8, ov.raw(), 0 as *u8, { (*node).item }) == (0 as *u8);
    // The object-value path still yields the label string (the default cell).
    assert tree_object_value_imp(0 as *u8, ov.raw(), 0 as *u8, { (*node).item }) != (0 as *u8);
    // End-to-end: a styled tree constructs with the builder + fixed height.
    let styled: flex::Node = tree(node, on_select: 0 as fn(*u8, *u8), row: tree_test_row, row_height: 34.0f64);
    assert styled.has_payload();
    return;
}

#[test]
fn test_containers_follow_hig_presets() {
    // vstack: column + 8pt row gap; card adds 16pt padding.
    var b: Builder = Builder::new();
    b.add(box().width(10.0f64).height(10.0f64));
    b.add(box().width(10.0f64).height(10.0f64));
    var v: flex::Node = vstack(b);
    v.calculate_layout(100.0f64, flex::undefined(), flex::Direction::LTR);
    let f: flex::Layout = v.layout_frame();
    assert approx(f.height, 28.0f64);   // 10 + 8 gap + 10

    var cb: Builder = Builder::new();
    cb.add(box().width(10.0f64).height(10.0f64));
    var c: flex::Node = card(cb);
    c.calculate_layout(100.0f64, flex::undefined(), flex::Direction::LTR);
    let cfr: flex::Layout = c.layout_frame();
    assert approx(cfr.height, 42.0f64);  // 16 pad + 10 + 16 pad
}

#[test]
fn test_apply_attaches_a_lone_leaf_root() {
    // A content root that is ITSELF a leaf (e.g. scroll { one label }, where
    // mount_wrapper_content returns the lone child directly): apply must attach
    // the root's own payload, not only children's. Was: root rendered empty.
    let host = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 100.0, h: 40.0 });
    let leaf_view = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 0.0, h: 0.0 });
    let lp: *u8 = leaf_view.raw();
    var leaf: flex::Node = fixed_view(leaf_view);
    leaf.set_width(flex::StyleLength::points(100.0f64));
    leaf.set_height(flex::StyleLength::points(40.0f64));
    leaf.calculate_layout(100.0f64, 40.0f64, flex::Direction::LTR);
    apply(#addr_of(leaf), host.raw(), false);
    let subs: vec::Vec[ak::View] = host.subviews();
    assert subs.count() == (1 as usize);           // the leaf was attached
    let f: rt::Rect = ak::View::from_raw(lp).frame();
    assert approx(f.w, 100.0f64);
    assert approx(f.h, 40.0f64);
}

#[test]
fn test_apply_builds_nested_views_with_flip() {
    // row [ leaf 50x20, leaf 50x20 ] inside a 100x100 root view. Flex puts
    // both at top 0; AppKit (bottom-up) puts them at y = 100 - 20 = 80.
    let content = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 100.0, h: 100.0 });
    var b: Builder = Builder::new();
    let va = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 0.0, h: 0.0 });
    let vb = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 0.0, h: 0.0 });
    let pa: *u8 = va.raw();
    let pb: *u8 = vb.raw();
    b.add(fixed_view(va).width(50.0f64).height(20.0f64));
    b.add(fixed_view(vb).width(50.0f64).height(20.0f64));
    var tree: flex::Node = row(b);
    tree.set_width(flex::StyleLength::points(100.0f64));
    tree.set_height(flex::StyleLength::points(100.0f64));
    tree.calculate_layout(100.0f64, 100.0f64, flex::Direction::LTR);
    apply(#addr_of(tree), content.raw(), false);

    let subs: vec::Vec[ak::View] = content.subviews();
    assert subs.count() == (2 as usize);
    let fa: rt::Rect = ak::View::from_raw(pa).frame();
    assert approx(fa.x, 0.0f64);
    assert approx(fa.y, 80.0f64);
    assert approx(fa.w, 50.0f64);
    assert approx(fa.h, 20.0f64);
    let fb: rt::Rect = ak::View::from_raw(pb).frame();
    assert approx(fb.x, 50.0f64);
    assert approx(fb.y, 80.0f64);
}

#[test]
fn test_apply_synthesizes_container_views() {
    // column [ row [ leaf ] ] — the row has no payload, so apply gives it
    // a fresh NSView and nests the leaf inside.
    let content = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 60.0, h: 60.0 });
    let leaf_view = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 0.0, h: 0.0 });
    let lp: *u8 = leaf_view.raw();

    var inner: Builder = Builder::new();
    inner.add(fixed_view(leaf_view).width(30.0f64).height(10.0f64));
    var outer: Builder = Builder::new();
    outer.add(row(inner));
    var tree: flex::Node = column(outer);
    tree.set_width(flex::StyleLength::points(60.0f64));
    tree.set_height(flex::StyleLength::points(60.0f64));
    tree.calculate_layout(60.0f64, 60.0f64, flex::Direction::LTR);
    apply(#addr_of(tree), content.raw(), false);

    // One synthesized container under content; the leaf under it.
    let subs: vec::Vec[ak::View] = content.subviews();
    assert subs.count() == (1 as usize);
    match ak::View::from_raw(lp).superview() {
        option::Option[ak::View]::Some(sv) => {
            assert sv.raw() != content.raw();   // nested, not flat
        }
        option::Option[ak::View]::None => { assert false; }
    };
}

#[test]
fn test_payload_views_survive_tree_drop() {
    // The node's +1 releases with the tree, but the applied superview
    // keeps the widget alive: its frame stays readable afterwards.
    let content = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 100.0, h: 40.0 });
    var lp: *u8 = 0 as *u8;
    {
        let lv = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 0.0, h: 0.0 });
        lp = lv.raw();
        var b: Builder = Builder::new();
        b.add(fixed_view(lv).width(40.0f64).height(40.0f64));
        var tree: flex::Node = row(b);
        tree.set_width(flex::StyleLength::points(100.0f64));
        tree.set_height(flex::StyleLength::points(40.0f64));
        tree.calculate_layout(100.0f64, 40.0f64, flex::Direction::LTR);
        apply(#addr_of(tree), content.raw(), false);
    }
    let f: rt::Rect = ak::View::from_raw(lp).frame();
    assert approx(f.w, 40.0f64);
    assert approx(f.h, 40.0f64);
}

#[test]
fn test_fill_scroll_installs_flipped_document() {
    let s = ak::ScrollView::new(rt::Rect { x: 0.0, y: 0.0, w: 100.0, h: 80.0 });
    var rows: Builder = Builder::new();
    rows.add(box().width(100.0f64).height(30.0f64));
    rows.add(box().width(100.0f64).height(30.0f64));
    rows.add(box().width(100.0f64).height(30.0f64));
    rows.add(box().width(100.0f64).height(30.0f64));
    rows.add(box().width(100.0f64).height(30.0f64));
    let h: f64 = fill_scroll(s, column(rows));
    assert approx(h, 150.0f64);
    match s.document_view() {
        option::Option[ak::View]::Some(doc) => {
            let flipped: i8 = rt::msg_i8(doc.raw(), rt::sel(#str_ptr("isFlipped\0")));
            assert flipped == (1 as i8);
            let df: rt::Rect = doc.frame();
            assert approx(df.h, 150.0f64);
        }
        option::Option[ak::View]::None => { assert false; }
    };
}

// A horizontal scroll must give its content a definite CROSS axis, or nothing
// inside it can size vertically. `grow(1)` in a row's cross axis and
// `align_items(Stretch)` are the two ways to ask for "as tall as the viewport";
// with both axes undefined (the old behaviour) each resolved to 0 and passed
// that zero down, mounting a complete, correctly-parented, invisible subtree.
// bugs/flex-absolute-child-and-horizontal-scroll.md
#[test]
fn horizontal_scroll_gives_content_the_viewport_height() {
    let s = ak::ScrollView::new(rt::Rect { x: 0.0, y: 0.0, w: 200.0, h: 120.0 });
    // Three fixed-width columns; each asks to fill the height by stretching.
    var cols: Builder = Builder::new();
    cols.add(box().width(150.0f64));
    cols.add(box().width(150.0f64));
    cols.add(box().width(150.0f64));
    var strip: flex::Node = row(cols);
    strip.set_align_items(flex::Align::Stretch);
    let h: f64 = fill_scroll_h(s, strip);

    // The strip is as tall as the viewport, not 0.
    assert approx(h, 120.0f64);
    match s.document_view() {
        option::Option[ak::View]::Some(doc) => {
            let df: rt::Rect = doc.frame();
            assert approx(df.h, 120.0f64);
            // The scroll axis is still natural: 3 x 150 overflows the 200pt
            // viewport, which is the whole point of scrolling sideways.
            assert approx(df.w, 450.0f64);
        }
        option::Option[ak::View]::None => { assert false; }
    };

    // The layout is what the defect corrupted, so read the laid-out tree back
    // rather than the views (a bare `box()` carries no style and so synthesizes
    // no backing NSView — which is exactly how "mounted and invisible" hides).
    // Every stretched column must have the viewport height, not a zero handed
    // down from an unresolvable parent.
    match scroll_content_tree(s.raw()) {
        option::Option[*flex::Node]::Some(tp) => {
            assert { (*tp).child_count() } == (3 as usize);
            var i: usize = 0 as usize;
            while i < (3 as usize) {
                match { (*tp).children.at_ptr(i) } {
                    option::Option[*flex::Node]::Some(cp) => {
                        let cf: flex::Layout = { (*cp).layout_frame() };
                        assert approx(cf.height, 120.0f64);
                        assert approx(cf.width, 150.0f64);
                    }
                    option::Option[*flex::Node]::None => { assert false; }
                }
                i = i +% (1 as usize);
            }
        }
        option::Option[*flex::Node]::None => { assert false; }
    };
}

// A scroll with no height yet must not resolve its children against a definite
// 0 — that would turn "not measured yet" into "measured as nothing". It keeps
// the natural-size behaviour instead.
#[test]
fn horizontal_scroll_without_a_height_falls_back_to_natural_size() {
    let s = ak::ScrollView::new(rt::Rect { x: 0.0, y: 0.0, w: 200.0, h: 0.0 });
    var cols: Builder = Builder::new();
    cols.add(box().width(150.0f64).height(44.0f64));
    cols.add(box().width(150.0f64).height(44.0f64));
    var strip: flex::Node = row(cols);
    strip.set_align_items(flex::Align::Stretch);
    let h: f64 = fill_scroll_h(s, strip);
    assert approx(h, 44.0f64);   // natural content height, not 0
    match s.document_view() {
        option::Option[ak::View]::Some(doc) => {
            let df: rt::Rect = doc.frame();
            assert approx(df.h, 44.0f64);
            assert approx(df.w, 300.0f64);
        }
        option::Option[ak::View]::None => { assert false; }
    };
}

// ---- retained relayout ------------------------------------------------------

// column [ leaf 50x10, row { leaf 40x20 } ] — the row is a payload-less
// container at build time, so apply must synthesize (and now PERSIST) its
// backing view; the column root borrows the host.
fn relayout_test_render(cp: *u8) -> flex::Node {
    let zero: rt::Rect = rt::Rect { x: 0.0, y: 0.0, w: 0.0, h: 0.0 };
    var inner: Builder = Builder::new();
    inner.add(fixed_view(ak::View::new(zero)).width(40.0f64).height(20.0f64));
    var b: Builder = Builder::new();
    b.add(fixed_view(ak::View::new(zero)).width(50.0f64).height(10.0f64));
    b.add(row(inner).grow(1.0f64));
    return column(b);
}

#[test]
fn test_relayout_repositions_existing_views_without_churn() {
    unmount_all();
    let host = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 200.0, h: 100.0 });
    let cp: *u8 = 41 as *u8;
    let _h: f64 = mount(relayout_test_render, ctx: cp, host: host.raw());

    // Capture the applied view identities: leaf, synthesized row container,
    // and the leaf nested inside the container.
    var leaf0: *u8 = 0 as *u8;
    var rowv: *u8 = 0 as *u8;
    var subs: vec::Vec[ak::View] = host.subviews();
    assert subs.count() == (2 as usize);
    match subs.at_ptr(0 as usize) { option::Option[*ak::View]::Some(vp) => { leaf0 = { (*vp).raw() }; } option::Option[*ak::View]::None => { assert false; } };
    match subs.at_ptr(1 as usize) { option::Option[*ak::View]::Some(vp) => { rowv = { (*vp).raw() }; } option::Option[*ak::View]::None => { assert false; } };
    var inner0: *u8 = 0 as *u8;
    var rsubs: vec::Vec[ak::View] = ak::View::from_raw(rowv).subviews();
    assert rsubs.count() == (1 as usize);
    match rsubs.at_ptr(0 as usize) { option::Option[*ak::View]::Some(vp) => { inner0 = { (*vp).raw() }; } option::Option[*ak::View]::None => { assert false; } };

    // The synthesized container is persisted as the row node's payload.
    match tree_ptr(cp) {
        option::Option[*flex::Node]::Some(tp) => {
            match (*tp).children.at_ptr(1 as usize) {
                option::Option[*flex::Node]::Some(rn) => { assert { (*rn).payload() } == rowv; }
                option::Option[*flex::Node]::None => { assert false; }
            }
        }
        option::Option[*flex::Node]::None => { assert false; }
    };

    // Resize the host and relayout: SAME views, new frames.
    host.set_frame(rt::Rect { x: 0.0, y: 0.0, w: 300.0, h: 150.0 });
    assert relayout(cp);
    var subs2: vec::Vec[ak::View] = host.subviews();
    assert subs2.count() == (2 as usize);
    match subs2.at_ptr(0 as usize) { option::Option[*ak::View]::Some(vp) => { assert { (*vp).raw() } == leaf0; } option::Option[*ak::View]::None => { assert false; } };
    match subs2.at_ptr(1 as usize) { option::Option[*ak::View]::Some(vp) => { assert { (*vp).raw() } == rowv; } option::Option[*ak::View]::None => { assert false; } };
    var rsubs2: vec::Vec[ak::View] = ak::View::from_raw(rowv).subviews();
    assert rsubs2.count() == (1 as usize);
    match rsubs2.at_ptr(0 as usize) { option::Option[*ak::View]::Some(vp) => { assert { (*vp).raw() } == inner0; } option::Option[*ak::View]::None => { assert false; } };

    // Frames follow the 300x150 layout (bottom-up flip: leaf at y = 150-10).
    let lf: rt::Rect = ak::View::from_raw(leaf0).frame();
    assert approx(lf.y, 140.0f64);
    assert approx(lf.h, 10.0f64);
    let rf: rt::Rect = ak::View::from_raw(rowv).frame();
    assert approx(rf.y, 0.0f64);
    assert approx(rf.w, 300.0f64);
    assert approx(rf.h, 140.0f64);

    // Unknown component → false; unmount drops the retained tree.
    assert relayout(999 as *u8) == false;
    assert unmount(cp);
    match tree_ptr(cp) {
        option::Option[*flex::Node]::Some(_tp) => { assert false; }
        option::Option[*flex::Node]::None => { }
    };
    unmount_all();
}

// Percent-width rows: the row width follows the viewport, so a relayout at a
// new scroll width must re-lay AND reposition them.
fn relayout_scroll_render(cp: *u8) -> flex::Node {
    let zero: rt::Rect = rt::Rect { x: 0.0, y: 0.0, w: 0.0, h: 0.0 };
    var b: Builder = Builder::new();
    var i: i64 = 0 as i64;
    while i < (3 as i64) {
        var n: flex::Node = fixed_view(ak::View::new(zero));
        n.set_width(flex::StyleLength::percent(100.0f64));
        n.set_height(flex::StyleLength::points(30.0f64));
        b.add(n);
        i = i + (1 as i64);
    }
    return column(b);
}

#[test]
fn test_relayout_scroll_slot_reuses_doc_and_rewraps_rows() {
    unmount_all();
    let s = ak::ScrollView::new(rt::Rect { x: 0.0, y: 0.0, w: 100.0, h: 80.0 });
    let cp: *u8 = 42 as *u8;
    let h0: f64 = mount_scroll(relayout_scroll_render, ctx: cp, scroll: s.raw());
    assert approx(h0, 90.0f64);
    var doc0: *u8 = 0 as *u8;
    var row0: *u8 = 0 as *u8;
    match s.document_view() {
        option::Option[ak::View]::Some(doc) => {
            doc0 = doc.raw();
            var rs: vec::Vec[ak::View] = doc.subviews();
            assert rs.count() == (3 as usize);
            match rs.at_ptr(0 as usize) { option::Option[*ak::View]::Some(vp) => { row0 = { (*vp).raw() }; } option::Option[*ak::View]::None => { assert false; } };
            assert approx(ak::View::from_raw(row0).frame().w, 100.0f64);
        }
        option::Option[ak::View]::None => { assert false; }
    };

    // Widen the viewport and relayout: same doc, same rows, new width.
    s.as_view().set_frame(rt::Rect { x: 0.0, y: 0.0, w: 160.0, h: 80.0 });
    assert relayout(cp);
    match s.document_view() {
        option::Option[ak::View]::Some(doc) => {
            assert doc.raw() == doc0;                       // reused, not recreated
            assert approx(doc.frame().w, 160.0f64);
            assert approx(doc.frame().h, 90.0f64);
            var rs: vec::Vec[ak::View] = doc.subviews();
            assert rs.count() == (3 as usize);
            match rs.at_ptr(0 as usize) { option::Option[*ak::View]::Some(vp) => { assert { (*vp).raw() } == row0; } option::Option[*ak::View]::None => { assert false; } };
            assert approx(ak::View::from_raw(row0).frame().w, 160.0f64);
        }
        option::Option[ak::View]::None => { assert false; }
    };
    unmount_all();
}

// A component whose tree HOLDS a scroll viewport leaf, its rows filled via
// fill_scroll (the portable-scroll shape: ak_scroll + drain does exactly
// this). relayout must reposition the viewport AND re-wrap the registered
// row content at the new width.
static RELAYOUT_SCROLL_HOST: *u8 = #zero::[*u8]();
fn relayout_viewport_render(cp: *u8) -> flex::Node {
    var b: Builder = Builder::new();
    var n: flex::Node = fixed_view(ak::View::from_raw(RELAYOUT_SCROLL_HOST));
    n.set_flex_grow(1.0f64);
    b.add(n);
    return column(b);
}

#[test]
fn test_relayout_reflows_registered_scroll_content() {
    unmount_all();
    let host = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 200.0, h: 100.0 });
    let sv = ak::ScrollView::new(rt::Rect { x: 0.0, y: 0.0, w: 10.0, h: 10.0 });
    RELAYOUT_SCROLL_HOST = sv.as_view().raw();
    let cp: *u8 = 43 as *u8;
    let _h: f64 = mount(relayout_viewport_render, ctx: cp, host: host.raw());
    // The outer apply sized the viewport to fill the host.
    assert approx(sv.as_view().frame().w, 200.0f64);

    // Fill the scroll (what drain_scroll_jobs does) — registers the row tree.
    let zero: rt::Rect = rt::Rect { x: 0.0, y: 0.0, w: 0.0, h: 0.0 };
    var rows: Builder = Builder::new();
    var r0: flex::Node = fixed_view(ak::View::new(zero));
    r0.set_width(flex::StyleLength::percent(100.0f64));
    r0.set_height(flex::StyleLength::points(30.0f64));
    rows.add(r0);
    let ch: f64 = fill_scroll(sv, column(rows));
    assert approx(ch, 30.0f64);
    assert scroll_content_count() == (1 as usize);
    var rowv: *u8 = 0 as *u8;
    match sv.document_view() {
        option::Option[ak::View]::Some(doc) => {
            var rs: vec::Vec[ak::View] = doc.subviews();
            match rs.at_ptr(0 as usize) { option::Option[*ak::View]::Some(vp) => { rowv = { (*vp).raw() }; } option::Option[*ak::View]::None => { assert false; } };
            assert approx(ak::View::from_raw(rowv).frame().w, 200.0f64);
        }
        option::Option[ak::View]::None => { assert false; }
    };

    // Widen the host: relayout repositions the viewport, then re-wraps the
    // registered rows at the viewport's new width — same row view.
    host.set_frame(rt::Rect { x: 0.0, y: 0.0, w: 320.0, h: 100.0 });
    assert relayout(cp);
    assert approx(sv.as_view().frame().w, 320.0f64);
    match sv.document_view() {
        option::Option[ak::View]::Some(doc) => {
            assert approx(doc.frame().w, 320.0f64);
            var rs: vec::Vec[ak::View] = doc.subviews();
            assert rs.count() == (1 as usize);
            match rs.at_ptr(0 as usize) { option::Option[*ak::View]::Some(vp) => { assert { (*vp).raw() } == rowv; } option::Option[*ak::View]::None => { assert false; } };
            assert approx(ak::View::from_raw(rowv).frame().w, 320.0f64);
        }
        option::Option[ak::View]::None => { assert false; }
    };

    // Unmount drops the retained tree; the forgotten tree takes its
    // scroll-content entry with it (exact cleanup, no liveness heuristics).
    assert unmount(cp);
    assert scroll_content_count() == (0 as usize);
    unmount_all();
}

fn t_clickable_handler(sender: *u8, ctx: *u8) { return; }

#[test]
fn clickable_container_hosts_recognizers_and_keeps_children() {
    // A bare container gets a backing view carrying one recognizer per handler,
    // and its children are preserved (laid into that view at apply time).
    var b: Builder = Builder::new();
    b.add(label("a"));
    b.add(label("b"));
    var content: flex::Node = hstack(b);
    let kids: usize = content.child_count();
    assert content.payload() == (0 as *u8);

    var c: flex::Node = clickable(content, ctx: 7 as *u8,
        on_click: t_clickable_handler,
        on_double_click: t_clickable_handler,
        on_right_click: t_clickable_handler);
    assert c.payload() != (0 as *u8);
    assert c.child_count() == kids;
    let bv: ak::View = ak::View::from_raw(c.payload());
    assert bv.gesture_recognizers().count() == (3 as usize);
}

static T_PERFORM_CLICK_CTX: i64 = -1;
fn t_perform_click_handler(sender: *u8, ctx: *u8) { T_PERFORM_CLICK_CTX = ctx as i64; return; }

#[test]
fn clickable_answers_performclick_for_agent_drive() {
    // The agent surface opens a control by sending `performClick:`. A facet
    // clickable's backing view must ANSWER it (fire the same primary-click
    // handler), so a tagged whole-row clickable is agent-openable — not only
    // mouse-clickable. Before the fix the plain NSView ignored performClick:
    // and agent_appkit's unguarded send raised.
    T_PERFORM_CLICK_CTX = -1;
    let c: flex::Node = clickable(label("row"), ctx: 55 as *u8,
        on_click: t_perform_click_handler, agent_id: "row-x");
    let bv: *u8 = c.payload();
    // The backing view responds to performClick: (the respondsToSelector: guard
    // in agent_appkit::click relies on this).
    assert rt::msg_i8_id(bv, rt::sel(#str_ptr("respondsToSelector:\0")),
        rt::sel(#str_ptr("performClick:\0"))) != (0 as i8);
    // Sending it fires the click handler with the clickable's ctx (55).
    rt::msg_void_id(bv, rt::sel(#str_ptr("performClick:\0")), 0 as *u8);
    assert T_PERFORM_CLICK_CTX == (55 as i64);
}

#[test]
fn clickable_without_click_handler_performclick_is_safe_noop() {
    // A clickable with no primary click handler still answers performClick:
    // (its class implements it) but fires nothing — no crash, no stray call.
    T_PERFORM_CLICK_CTX = 999 as i64;
    let c: flex::Node = clickable(label("row"), on_double_click: t_clickable_handler, agent_id: "row-y");
    let bv: *u8 = c.payload();
    rt::msg_void_id(bv, rt::sel(#str_ptr("performClick:\0")), 0 as *u8);
    assert T_PERFORM_CLICK_CTX == (999 as i64);   // unchanged — handler never fired
}

// Assert a text component tagged the inner NSTextView (its scroll's document
// view), not the outer NSScrollView. Consumes the node.
fn assert_tags_inner_text_view(take n: flex::Node, id: str) {
    let scroll_ptr: *u8 = n.payload();
    // The scroll wrapper carries no id...
    assert ak::Accessibility::from_raw(scroll_ptr).accessibility_identifier().count() == (0 as usize);
    // ...its document view (the NSTextView) does.
    let dv: *u8 = { rt::msg_id(scroll_ptr, rt::sel(#str_ptr("documentView\0"))) };
    assert dv != (0 as *u8);
    assert ak::Accessibility::from_raw(dv).accessibility_identifier().view() == id;
    return;
}

#[test]
fn text_components_tag_inner_text_view_for_agent_drive() {
    // composer / text_area must tag the inner NSTextView, not the outer
    // NSScrollView, so the agent surface's set_text (NSTextView setString:)
    // and read address the editable surface. A scroll-tagged composer silently
    // dropped setStringValue:.
    assert_tags_inner_text_view(composer(on_submit: test_noop_action, agent_id: "cmp"), "cmp");
    assert_tags_inner_text_view(text_area(agent_id: "txa"), "txa");
}

