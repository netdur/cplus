#[link_name = "objc_msgSend"]
extern fn msg_void_rect_rect_u64_f64(recv: *u8, sel: *u8, a: rt::Rect, b: rt::Rect, op: u64, f: f64);

// ---- the refresh affordance --------------------------------------------------
// MAUI's RefreshView and ListView's pull-to-refresh band. The ledger said
// "pull-to-refresh is a touch idiom", which is true about the GESTURE and was
// being read as a claim about the feature. macOS has no pull-to-refresh — and
// facet's own rule already says what to do about that:
//
//   an agent has no hands. If something can only be reached by a gesture,
//   that is the bug; add a click path in the UI.
//
// So a refreshable shows a refresh CONTROL at the top of its content: a button
// while idle, a spinner while refreshing. A user clicks it, an agent clicks it,
// and `begin_refresh` drives it from code. Nothing about it is a gesture.
//
// On an NSScrollView the strip is a FLOATING SUBVIEW — AppKit's own answer for
// a thing pinned to the top of a scrolling area, which is exactly the shape
// this needs and is why the list half costs nothing extra.

fn strip_key() -> *u8 { return { 28776 as *u8 }; }
fn spinner_key() -> *u8 { return { 28777 as *u8 }; }
fn refresh_handler_key() -> *u8 { return { 28778 as *u8 }; }
fn refresh_ctx_key() -> *u8 { return { 28779 as *u8 }; }

fn strip_height() -> f64 { return 24.0f64; }

fn refresh_strip_of(host: *u8) -> *u8 { return { synth::get_associated(host, strip_key()) }; }
fn refresh_spinner_of(host: *u8) -> *u8 { return { synth::get_associated(host, spinner_key()) }; }

// The click, whatever produced it. The handler and its ctx ride the STRIP, so
// one trampoline serves both kinds and neither has to grow a delegate.
fn refresh_clicked(sender: *u8, ctx: *u8) {
    let strip: *u8 = { rt::msg_id(sender, rt::sel(#str_ptr("superview\0"))) };
    if strip == (0 as *u8) { return; }
    let h: fn(*u8, *u8) = { synth::get_associated(strip, refresh_handler_key()) as fn(*u8, *u8) };
    if { h } == (0 as fn(*u8, *u8)) { return; }
    h(sender, { synth::get_associated(strip, refresh_ctx_key()) });
    return;
}

// Idempotent. The strip is built once and then only its STATE changes, because
// a scroll view's floating subview list is not something to churn per apply.
fn install_refresh_strip(host: *u8) -> *u8 {
    let existing: *u8 = refresh_strip_of(host);
    if existing != (0 as *u8) { return existing; }
    let box: rt::Rect = { rt::msg_rect(host, rt::sel(#str_ptr("bounds\0"))) };
    let strip: ak::View = akx::new_flipped_view(
        rt::Rect { x: 0.0f64, y: 0.0f64, w: box.w, h: strip_height() });
    // Width tracks the host; the TOP edge is fixed. In a flipped host that is
    // min-Y fixed and max-Y flexible: WidthSizable (2) | MaxYMargin (32).
    { rt::msg_void_u64(strip.raw(), rt::sel(#str_ptr("setAutoresizingMask:\0")), 34 as u64) };

    let b: ak::Button = ak::Button::from_raw(rt::alloc_init(#str_ptr("NSButton\0")));
    b.set_button_type(ak::ButtonType::MomentaryChange);
    b.set_bordered(false);
    b.set_title("");
    match ak::Image::image_with_system_symbol_name("arrow.clockwise", "refresh") {
        option::Option[ak::Image]::Some(img) => { b.set_image(img); }
        option::Option[ak::Image]::None => { b.set_title("Refresh"); }
    }
    let bv: ak::View = b.as_view();
    bv.set_frame(rt::Rect { x: 0.0f64, y: 0.0f64, w: box.w, h: strip_height() });
    { rt::msg_void_u64(bv.raw(), rt::sel(#str_ptr("setAutoresizingMask:\0")), 2 as u64) };
    akx::set_control_action_ctx(b.as_control(), refresh_clicked, 0 as *u8);
    strip.add_subview(bv);

    let pi: ak::ProgressIndicator = ak::ProgressIndicator::from_raw(
        rt::alloc_init(#str_ptr("NSProgressIndicator\0")));
    pi.set_style(ak::ProgressIndicatorStyle::Spinning);
    pi.set_indeterminate(true);
    let pv: ak::View = pi.as_view();
    pv.set_frame(rt::Rect { x: (box.w - strip_height()) / 2.0f64, y: 0.0f64,
                            w: strip_height(), h: strip_height() });
    pv.set_hidden(true);
    strip.add_subview(pv);

    // A scroll view has AppKit's own slot for this; anything else takes an
    // ordinary subview pinned by its mask.
    if { rt::msg_i8_id(host, rt::sel(#str_ptr("isKindOfClass:\0")),
                       rt::get_class(#str_ptr("NSScrollView\0"))) } != (0 as i8) {
        // NSEventGestureAxisVertical = 2.
        { rt::msg_void_id_i64(host, rt::sel(#str_ptr("addFloatingSubview:forAxis:\0")),
                              strip.raw(), 2 as i64) };
    } else {
        ak::View::from_raw(host).add_subview(strip);
    }
    synth::set_associated(host, strip_key(), strip.raw());
    synth::set_associated(host, spinner_key(), pv.raw());
    return strip.raw();
}

fn remove_refresh_strip(host: *u8) {
    let strip: *u8 = refresh_strip_of(host);
    if strip == (0 as *u8) { return; }
    { rt::msg_void(strip, rt::sel(#str_ptr("removeFromSuperview\0"))) };
    synth::set_associated(host, strip_key(), 0 as *u8);
    synth::set_associated(host, spinner_key(), 0 as *u8);
    return;
}

// The whole band in one call, because the five props are one state: whether
// there is an affordance, whether it is usable, and which of its two faces is
// showing.
fn apply_refresh(host: *u8, enabled: bool, refreshing: bool, allowed: bool,
                 color: vocab::Color, h: fn(*u8, *u8), ctx: *u8) {
    if host == (0 as *u8) { return; }
    if !enabled {
        remove_refresh_strip(host);
        return;
    }
    let strip: *u8 = install_refresh_strip(host);
    if strip == (0 as *u8) { return; }
    synth::set_associated(strip, refresh_handler_key(), { h as *u8 });
    synth::set_associated(strip, refresh_ctx_key(), ctx);
    let spinner: *u8 = refresh_spinner_of(host);
    let button: *u8 = refresh_button_of(strip);
    if button != (0 as *u8) {
        { rt::msg_void_i8(button, rt::sel(#str_ptr("setHidden:\0")), refreshing as i8) };
        { rt::msg_void_i8(button, rt::sel(#str_ptr("setEnabled:\0")), allowed as i8) };
    }
    if spinner != (0 as *u8) {
        { rt::msg_void_i8(spinner, rt::sel(#str_ptr("setHidden:\0")), (refreshing == false) as i8) };
        if refreshing {
            { rt::msg_void_id(spinner, rt::sel(#str_ptr("startAnimation:\0")), 0 as *u8) };
        } else {
            { rt::msg_void_id(spinner, rt::sel(#str_ptr("stopAnimation:\0")), 0 as *u8) };
        }
        tint_spinner(spinner, color);
    }
    return;
}

fn refresh_button_of(strip: *u8) -> *u8 {
    let subs: vec::Vec[ak::View] = ak::View::from_raw(strip).subviews();
    return match subs.at_ptr(0 as usize) {
        option::Option[*ak::View]::Some(v) => { (*v).raw() },
        option::Option[*ak::View]::None => 0 as *u8,
    };
}

// NSProgressIndicator has no tint, and the ledger stops there for the
// determinate BAR — a monochrome filter over a bar would flatten its fill and
// its track into one colour, which is worse than not colouring it. An
// indeterminate spinner is uniform, so mapping it onto one colour is exactly
// what tinting it means.
fn tint_spinner(spinner: *u8, c: vocab::Color) {
    if c.is_set() == false { return; }
    let filter: *u8 = { rt::msg_id_id(rt::get_class(#str_ptr("CIFilter\0")),
                                      rt::sel(#str_ptr("filterWithName:\0")),
                                      bridge::nsstring("CIColorMonochrome")) };
    if filter == (0 as *u8) { return; }
    let ci: *u8 = { rt::msg_id_id(rt::get_class(#str_ptr("CIColor\0")),
                                  rt::sel(#str_ptr("colorWithCGColor:\0")),
                                  paint::ns_color(c).c_g_color()) };
    if ci == (0 as *u8) { return; }
    { rt::msg_void_id_id(filter, rt::sel(#str_ptr("setValue:forKey:\0")),
                         ci, bridge::nsstring("inputColor")) };
    let arr: *u8 = { rt::msg_id_id(rt::get_class(#str_ptr("NSArray\0")),
                                   rt::sel(#str_ptr("arrayWithObject:\0")), filter) };
    ak::View::from_raw(spinner).set_wants_layer(true);
    { rt::msg_void_id(spinner, rt::sel(#str_ptr("setContentFilters:\0")), arr) };
    return;
}

// ---- the picker's popover ----------------------------------------------------
// `DatePicker.IsOpen` and its two edges. The ledger said "a field-with-stepper
// has no popover to open", which is true of that ONE control and was standing
// in for the whole question: a graphical NSDatePicker exists, an NSPopover
// exists, and putting the first inside the second is what every macOS app that
// offers a calendar does.
//
// The field stays the field. The popover is a SECOND picker bound to the same
// value, so the control an application laid out does not change shape when it
// gains the ability to open — and a write to `date` still lands in one place.
//
// `is_open` is the click path, which is the point: an agent has no hands and
// cannot reach a calendar by clicking a stepper, but it can write the verb.

fn popover_key() -> *u8 { return { 28780 as *u8 }; }
fn popover_field_key() -> *u8 { return { 28781 as *u8 }; }
fn popover_node_key() -> *u8 { return { 28782 as *u8 }; }
fn popover_opened_key() -> *u8 { return { 28783 as *u8 }; }
fn popover_closed_key() -> *u8 { return { 28784 as *u8 }; }
fn popover_owner_key() -> *u8 { return { 28785 as *u8 }; }

// The NODE the popover belongs to, read back by the two edge handlers — which
// receive the DELEGATE as their sender, so it is the one object both sides
// already have.
fn popover_owner_of(delegate: *u8) -> *u8 {
    return { synth::get_associated(delegate, popover_owner_key()) };
}

// NSDatePickerStyleClockAndCalendar.
fn graphical_style() -> u64 { return 1 as u64; }
// NSPopoverBehaviorTransient — clicking away closes it, which is what makes
// the close edge reachable without a dismiss verb.
fn transient() -> i64 { return 1 as i64; }
// NSRectEdgeMaxY.
fn edge_below() -> u64 { return 3 as u64; }

#[link_name = "objc_msgSend"]
extern fn msg_void_rect_id_u64(recv: *u8, sel: *u8, r: rt::Rect, v: *u8, e: u64);

fn popover_of(v: *u8) -> *u8 { return { synth::get_associated(v, popover_key()) }; }

// The graphical picker changed: write it into the FIELD and let the field's own
// action run. One value, one write-back path — the popover is a second face on
// the same control, not a second source of truth.
fn popover_changed(sender: *u8, ctx: *u8) {
    let field: *u8 = { synth::get_associated(sender, popover_field_key()) };
    if field == (0 as *u8) { return; }
    { rt::msg_void_id(field, rt::sel(#str_ptr("setDateValue:\0")),
                      { rt::msg_id(sender, rt::sel(#str_ptr("dateValue\0"))) }) };
    let target: *u8 = { rt::msg_id(field, rt::sel(#str_ptr("target\0"))) };
    let action: *u8 = { rt::msg_id(field, rt::sel(#str_ptr("action\0"))) };
    if target != (0 as *u8) && action != (0 as *u8) { { rt::msg_void_id(target, action, field) }; }
    return;
}

fn popover_shown_imp(self_obj: *u8, cmd: *u8, note: *u8) {
    fire_popover(self_obj, popover_opened_key());
    return;
}

fn popover_closed_imp(self_obj: *u8, cmd: *u8, note: *u8) {
    // The user dismissed it, so the contract's own `is_open` has to stop
    // claiming otherwise — the same write-back rule every other read follows.
    let flag: *u8 = { synth::get_associated(self_obj, popover_node_key()) };
    if flag != (0 as *u8) { { (*(flag as *bool)) = false }; }
    fire_popover(self_obj, popover_closed_key());
    return;
}

fn fire_popover(delegate: *u8, key: *u8) {
    let h: fn(*u8, *u8) = { synth::get_associated(delegate, key) as fn(*u8, *u8) };
    if { h } == (0 as fn(*u8, *u8)) { return; }
    h(delegate, 0 as *u8);
    return;
}

fn popover_delegate_class() -> *u8 {
    let existing: *u8 = rt::get_class(#str_ptr("FacetPopoverDelegate\0"));
    if existing != (0 as *u8) { return existing; }
    let cls: *u8 = synth::allocate_class_pair(rt::get_class(#str_ptr("NSObject\0")),
                                              #str_ptr("FacetPopoverDelegate\0"), 0 as usize);
    synth::add_method_v_1id(cls, rt::sel(#str_ptr("popoverDidShow:\0")),
                            popover_shown_imp, #str_ptr("v@:@\0"));
    synth::add_method_v_1id(cls, rt::sel(#str_ptr("popoverDidClose:\0")),
                            popover_closed_imp, #str_ptr("v@:@\0"));
    synth::register_class_pair(cls);
    return cls;
}

// Built once, on the first `is_open`. A picker that never opens pays for no
// second picker and no popover.
fn picker_popover(field: *u8, elements: u64, min_date: *u8, max_date: *u8) -> *u8 {
    let existing: *u8 = popover_of(field);
    if existing != (0 as *u8) { return existing; }
    let cal: *u8 = { rt::alloc_init(#str_ptr("NSDatePicker\0")) };
    if cal == (0 as *u8) { return 0 as *u8; }
    { rt::msg_void_u64(cal, rt::sel(#str_ptr("setDatePickerStyle:\0")), graphical_style()) };
    { rt::msg_void_u64(cal, rt::sel(#str_ptr("setDatePickerElements:\0")), elements) };
    { rt::msg_void_id(cal, rt::sel(#str_ptr("setTimeZone:\0")),
                      { rt::msg_id(field, rt::sel(#str_ptr("timeZone\0"))) }) };
    if min_date != (0 as *u8) { { rt::msg_void_id(cal, rt::sel(#str_ptr("setMinDate:\0")), min_date) }; }
    if max_date != (0 as *u8) { { rt::msg_void_id(cal, rt::sel(#str_ptr("setMaxDate:\0")), max_date) }; }
    { rt::msg_void_rect(cal, rt::sel(#str_ptr("setFrame:\0")),
                        rt::Rect { x: 0.0f64, y: 0.0f64, w: 160.0f64, h: 150.0f64 }) };
    { rt::msg_void(cal, rt::sel(#str_ptr("sizeToFit\0"))) };
    synth::set_associated(cal, popover_field_key(), field);
    akx::set_control_action_ctx(ak::Control::from_raw(cal), popover_changed, 0 as *u8);

    let vc: *u8 = { rt::alloc_init(#str_ptr("NSViewController\0")) };
    if vc == (0 as *u8) { return 0 as *u8; }
    { rt::msg_void_id(vc, rt::sel(#str_ptr("setView:\0")), cal) };
    let pop: *u8 = { rt::alloc_init(#str_ptr("NSPopover\0")) };
    if pop == (0 as *u8) { return 0 as *u8; }
    { rt::msg_void_id(pop, rt::sel(#str_ptr("setContentViewController:\0")), vc) };
    { rt::msg_void_i64(pop, rt::sel(#str_ptr("setBehavior:\0")), transient()) };
    let d: *u8 = synth::alloc_init_class(popover_delegate_class());
    if d != (0 as *u8) {
        { rt::msg_void_id(pop, rt::sel(#str_ptr("setDelegate:\0")), d) };
        synth::retain_associated(field, popover_key(), pop);
        synth::retain_associated(pop, popover_key(), d);
        rt::release(d);
    }
    rt::release(vc);
    return pop;
}

// The whole band. `open` is a COMMAND-shaped write — true opens, false closes —
// and the two handlers ride the popover's own edges.
fn apply_picker_popover(field: *u8, open: bool, elements: u64,
                        min_date: *u8, max_date: *u8, flag: *bool, owner: *u8,
                        on_opened: fn(*u8, *u8), on_closed: fn(*u8, *u8)) {
    if field == (0 as *u8) { return; }
    if !open {
        let pop: *u8 = popover_of(field);
        if pop != (0 as *u8) { { rt::msg_void(pop, rt::sel(#str_ptr("close\0"))) }; }
        return;
    }
    // A popover anchors to a view that is ON a window, and AppKit RAISES when
    // it is not. A picker whose `is_open` is written before it is mounted is an
    // ordinary sequencing accident, not a reason to abort the process.
    if { rt::msg_id(field, rt::sel(#str_ptr("window\0"))) } == (0 as *u8) { return; }
    let pop: *u8 = picker_popover(field, elements, min_date, max_date);
    if pop == (0 as *u8) { return; }
    let d: *u8 = { rt::msg_id(pop, rt::sel(#str_ptr("delegate\0"))) };
    if d != (0 as *u8) {
        synth::set_associated(d, popover_node_key(), flag as *u8);
        synth::set_associated(d, popover_owner_key(), owner);
        synth::set_associated(d, popover_opened_key(), { on_opened as *u8 });
        synth::set_associated(d, popover_closed_key(), { on_closed as *u8 });
    }
    // The calendar shows what the field shows, every time it opens.
    let vc: *u8 = { rt::msg_id(pop, rt::sel(#str_ptr("contentViewController\0"))) };
    if vc != (0 as *u8) {
        let cal: *u8 = { rt::msg_id(vc, rt::sel(#str_ptr("view\0"))) };
        if cal != (0 as *u8) {
            { rt::msg_void_id(cal, rt::sel(#str_ptr("setDateValue:\0")),
                              { rt::msg_id(field, rt::sel(#str_ptr("dateValue\0"))) }) };
        }
    }
    { msg_void_rect_id_u64(pop, rt::sel(#str_ptr("showRelativeToRect:ofView:preferredEdge:\0")),
                           { rt::msg_rect(field, rt::sel(#str_ptr("bounds\0"))) },
                           field, edge_below()) };
    return;
}

fn picker_is_open(field: *u8) -> bool {
    let pop: *u8 = popover_of(field);
    if pop == (0 as *u8) { return false; }
    return { rt::msg_i8(pop, rt::sel(#str_ptr("isShown\0"))) } != (0 as i8);
}

// ---- window buttons that appear on hover --------------------------------------
// `ButtonStyle::OnHover` — the traffic lights, but only while the pointer is
// over the group. The ledger said "`window_buttons` has no style beyond the
// traffic lights", which answered a different question: the STYLE here is not
// which buttons, it is when they are drawn, and a tracking area answers that.
//
// The reveal is an alpha rather than `hidden`, because a hidden view leaves no
// hover target and the group could never come back.

fn hover_alpha_key() -> *u8 { return { 28789 as *u8 }; }

fn set_group_alpha(host: *u8, a: f64) {
    let subs: vec::Vec[ak::View] = ak::View::from_raw(host).subviews();
    var i: usize = 0 as usize;
    let count: usize = subs.count();
    while i < count {
        match subs.at_ptr(i) {
            option::Option[*ak::View]::Some(v) => { { (*v).set_alpha_value(a) }; }
            option::Option[*ak::View]::None => { }
        }
        i = i +% (1 as usize);
    }
    return;
}

fn hover_in_imp(self_obj: *u8, cmd: *u8, event: *u8) { set_group_alpha(self_obj, 1.0f64); return; }
fn hover_out_imp(self_obj: *u8, cmd: *u8, event: *u8) {
    if { synth::get_associated(self_obj, hover_alpha_key()) } == (0 as *u8) { return; }
    set_group_alpha(self_obj, 0.0f64);
    return;
}

#[link_name = "objc_msgSend"]
extern fn msg_init_tracking(obj: *u8, sel: *u8, rect: rt::Rect, options: u64,
                            owner: *u8, info: *u8) -> *u8;

fn apply_hover_reveal(host: *u8, on_hover: bool) {
    if host == (0 as *u8) { return; }
    if !on_hover {
        // Back to always-visible, and the tracking area stops mattering.
        synth::set_associated(host, hover_alpha_key(), 0 as *u8);
        set_group_alpha(host, 1.0f64);
        return;
    }
    let cls: *u8 = { synth::object_class(host) };
    if !is_ours(cls) {
        let sub: *u8 = subclass_of(cls, "FacetHover", flavour_hover());
        if sub != cls { let _old: *u8 = { object_setClass(host, sub) }; }
        // MouseEnteredAndExited (0x01) | ActiveAlways (0x80) | InVisibleRect (0x200)
        // — InVisibleRect is what makes it follow the view as layout moves it,
        // so there is no frame observer to keep in step.
        let box: rt::Rect = { rt::msg_rect(host, rt::sel(#str_ptr("bounds\0"))) };
        let ta_alloc: *u8 = { rt::msg_id(rt::get_class(#str_ptr("NSTrackingArea\0")),
                                         rt::sel(#str_ptr("alloc\0"))) };
        let ta: *u8 = { msg_init_tracking(ta_alloc,
            rt::sel(#str_ptr("initWithRect:options:owner:userInfo:\0")),
            box, 641 as u64, host, 0 as *u8) };
        if ta != (0 as *u8) {
            { rt::msg_void_id(host, rt::sel(#str_ptr("addTrackingArea:\0")), ta) };
            rt::release(ta);
        }
    }
    synth::set_associated(host, hover_alpha_key(), 1 as *u8);
    set_group_alpha(host, 0.0f64);
    return;
}

// ---- a slider's own knob ------------------------------------------------------
// "NSSlider's knob is cell-drawn; there is no image slot" is true and stops one
// step short: the cell that draws it has a method for drawing it, and a cell is
// an object whose class can be replaced. `drawKnob:` is handed the rect the
// knob occupies, which is the whole of what an image needs.

fn knob_image_key() -> *u8 { return { 28792 as *u8 }; }

#[link_name = "class_addMethod"]
extern fn add_method_v_rect(cls: *u8, sel: *u8, imp: fn(*u8, *u8, rt::Rect), types: *u8) -> i8;
#[link_name = "objc_msgSend"]
extern fn msg_void_rect_rect_u64_f64_i8(recv: *u8, sel: *u8, a: rt::Rect, b: rt::Rect,
                                        op: u64, f: f64, flip: i8);

fn draw_knob_imp(self_obj: *u8, cmd: *u8, knob: rt::Rect) {
    let img: *u8 = { synth::get_associated(self_obj, knob_image_key()) };
    if img == (0 as *u8) { return; }
    // `respectFlipped:` — a slider's control view is flipped, and an image
    // drawn without it comes out upside down, which is the kind of wrong that
    // only shows up on an asymmetric knob.
    { msg_void_rect_rect_u64_f64_i8(img,
        rt::sel(#str_ptr("drawInRect:fromRect:operation:fraction:respectFlipped:hints:\0")),
        knob, rt::Rect { x: 0.0f64, y: 0.0f64, w: 0.0f64, h: 0.0f64 },
        2 as u64, 1.0f64, 1 as i8) };
    return;
}

fn apply_thumb_image(v: *u8, src: str) {
    let cell: *u8 = field_cell(v);
    if cell == (0 as *u8) { return; }
    if src == "" {
        synth::set_associated(cell, knob_image_key(), 0 as *u8);
        return;
    }
    var img: *u8 = 0 as *u8;
    match ak::Image::image_with_system_symbol_name(src, "") {
        option::Option[ak::Image]::Some(i) => { img = i.raw(); }
        option::Option[ak::Image]::None => {
            match ak::Image::image_named(src) {
                option::Option[ak::Image]::Some(i) => { img = i.raw(); }
                option::Option[ak::Image]::None => {
                    img = ak::Image::new_with_contents_of_file(src).raw();
                }
            }
        }
    }
    if img == (0 as *u8) { return; }
    let cls: *u8 = { synth::object_class(cell) };
    if !is_ours(cls) {
        let sub: *u8 = subclass_of(cls, "FacetKnob", flavour_knob());
        if sub != cls { let _old: *u8 = { object_setClass(cell, sub) }; }
    }
    synth::retain_associated(cell, knob_image_key(), img);
    { rt::msg_void_i8(v, rt::sel(#str_ptr("setNeedsDisplay:\0")), 1 as i8) };
    return;
}

// ---- a scroll the user cannot move --------------------------------------------
// `CarouselView.IsSwipeEnabled` — whether the USER can change the page. macOS
// has no swipe, and the ledger stopped there; the verb is not about the gesture
// but about who is allowed to move the thing, and the answer for a mouse is the
// same one: the wheel does nothing and `position` still works.

fn scroll_locked_key() -> *u8 { return { 28793 as *u8 }; }

// The class is installed once and the FLAG decides, because a class swap is not
// something to undo: a carousel that locks and unlocks would otherwise keep the
// override and stay dead.
fn locked_scroll_imp(self_obj: *u8, cmd: *u8, event: *u8) {
    if { synth::get_associated(self_obj, scroll_locked_key()) } != (0 as *u8) { return; }
    let base: *u8 = { class_getSuperclass(synth::object_class(self_obj)) };
    if base == (0 as *u8) { return; }
    let imp: *u8 = { super_imp_of(base, cmd) };
    if imp == (0 as *u8) { return; }
    let f: fn(*u8, *u8, *u8) = { imp as fn(*u8, *u8, *u8) };
    f(self_obj, cmd, event);
    return;
}

fn apply_scroll_lock(v: *u8, locked: bool) {
    if v == (0 as *u8) { return; }
    let cls: *u8 = { synth::object_class(v) };
    if !locked {
        if is_ours(cls) { synth::set_associated(v, scroll_locked_key(), 0 as *u8); }
        return;
    }
    if !is_ours(cls) {
        let sub: *u8 = subclass_of(cls, "FacetLocked", flavour_locked());
        if sub != cls { let _old: *u8 = { object_setClass(v, sub) }; }
    }
    synth::set_associated(v, scroll_locked_key(), 1 as *u8);
    return;
}

fn scroll_is_locked(v: *u8) -> bool {
    return { synth::get_associated(v, scroll_locked_key()) } != (0 as *u8);
}
