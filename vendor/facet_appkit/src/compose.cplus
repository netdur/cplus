// facet_appkit compose — the verbs one native control does not have.
//
// The rule this file exists for: facet's contract is not a list of things
// AppKit happens to expose. A control does not have to be one native widget.
// Where MAUI declares a verb and no single AppKit class answers it, the answer
// is built from two — a cell subclass, an overlaid button, a disabled first
// item — and only a verb the PLATFORM has no concept of stays unimplemented.
//
// Six verbs live here, and each was recorded "AppKit cannot" on a reading of
// one class in isolation:
//
//   vertical_align   NSTextFieldCell centres, and there is no property. But
//                    `drawingRectForBounds:` is the rect it centres INSIDE, and
//                    a cell is an object whose class can be replaced. Five
//                    controls, two mechanisms — a cell for the field family, a
//                    `textContainerOrigin` for the editor.
//   clear_button     NSTextField has none. NSSearchField's is its own and
//                    cannot be borrowed. So: a button, over the trailing edge,
//                    and the cell gives back the width it covers.
//   placeholder      NSTextView has no placeholder API. A label under the
//                    text, hidden as soon as there is any.
//   popup.title      NSPopUpButton shows the selected item and has no prompt
//                    slot — so the prompt IS an item, disabled, at the top,
//                    which is what a prompt is on every platform that has one.
//   search tints     the magnifier and the cancel button are template images,
//                    which is what makes them tintable rather than what stops
//                    it.
//
// ---- what "asked for" means here ---------------------------------------------
//
// `vertical_align` is spelled with `vocab::TextAlign`, the same enum as the
// horizontal one, and `Center` is its generated default. So Center means NOT
// ASKED and leaves the control's own behaviour standing — exactly the rule
// `text_input::asked_align` follows for the horizontal axis. A control that
// wants centred text already gets it; a control that says Start or End is
// asking for something AppKit would not have done.

import "stdlib/option" as option;
import "stdlib/text" as text;
import "stdlib/status" as status;
import "stdlib/vec" as vec;
import "facet/facet" as core;
import "facet/props" as props;
import "facet/vocabulary" as vocab;
import "flex_layout/flex_layout" as flex;
import "objc/runtime" as rt;
import "objc/bridge" as bridge;
import "objc/synthesis" as synth;
import "appkit/appkit" as ak;
import "appkit/appkit_ext" as akx;
import "quartzcore/quartzcore" as quartz;
import "./paint" as paint;

// ---- associated keys ---------------------------------------------------------
// facet_appkit owns 29000 and up, in one block per file:
//
//   drawing 29000   input 29010   web 29020   recycler 29030   dialogs 29040
//   text_input 29050   scrolling 29060   bordered stroke 29070   compose 29080
//
// NOT 28xxx, which is where `cpc-bindgen` allocates the generated binding's own
// delegate keys from — appkit.cplus is already at 28733 and grows with the SDK.
// An associated key is per-object, so an overlap is silent until the day one
// lands on the same object twice; `keys_are_distinct` is the gate, and the
// range is what keeps the gate from having to be re-won on every regen.

fn align_key() -> *u8 { return { 29080 as *u8 }; }
fn subclass_key() -> *u8 { return { 29081 as *u8 }; }
fn marker_key() -> *u8 { return { 29082 as *u8 }; }
fn trailing_key() -> *u8 { return { 29083 as *u8 }; }
fn clear_button_key() -> *u8 { return { 29084 as *u8 }; }
fn placeholder_key() -> *u8 { return { 29085 as *u8 }; }

// ---- the runtime subclass, once ----------------------------------------------
// One subclass per BASE class, cached on the base itself: a Class is an object,
// so there is no name table and no string compare. `input.cplus` reaches the
// same conclusion for views; this is the cell and editor half.

static SUBCLASSES: u32 = 0 as u32;

extern fn class_getSuperclass(cls: *u8) -> *u8;
extern fn object_setClass(obj: *u8, cls: *u8) -> *u8;
#[link_name = "class_getMethodImplementation"]
extern fn super_imp_of(cls: *u8, sel: *u8) -> *u8;
#[link_name = "class_addMethod"]
extern fn add_method_rect_rect(cls: *u8, sel: *u8,
                               imp: fn(*u8, *u8, rt::Rect) -> rt::Rect, types: *u8) -> i8;
#[link_name = "class_addMethod"]
extern fn add_method_point_0(cls: *u8, sel: *u8, imp: fn(*u8, *u8) -> rt::Point,
                             types: *u8) -> i8;
#[link_name = "objc_msgSend"]
extern fn msg_size_rect(recv: *u8, sel: *u8, r: rt::Rect) -> rt::Size;
#[link_name = "objc_msgSend"]
extern fn msg_rect_id(recv: *u8, sel: *u8, a: *u8) -> rt::Rect;
#[link_name = "objc_msgSend"]
extern fn msg_point0(recv: *u8, sel: *u8) -> rt::Point;

fn digit(d: u32) -> str {
    if d == (0 as u32) { return "0"; }
    if d == (1 as u32) { return "1"; }
    if d == (2 as u32) { return "2"; }
    if d == (3 as u32) { return "3"; }
    if d == (4 as u32) { return "4"; }
    if d == (5 as u32) { return "5"; }
    if d == (6 as u32) { return "6"; }
    if d == (7 as u32) { return "7"; }
    if d == (8 as u32) { return "8"; }
    return "9";
}

fn is_ours(cls: *u8) -> bool {
    return { synth::get_associated(cls, marker_key()) } != (0 as *u8);
}

// Three flavours, because three classes place their text three ways and only
// the LAST of them was obvious:
//
//   FLAVOUR_CELL    NSTextFieldCell — `drawingRectForBounds:` is the rect the
//                   text is laid out inside.
//   FLAVOUR_EDITOR  NSTextView has no cell; `textContainerOrigin` is where the
//                   laid-out text is drawn from.
//   FLAVOUR_TITLE   NSPopUpButtonCell does NOT derive its title from the
//                   drawing rect — a test asserted the drawing-rect hook and
//                   it came back unmoved. `titleRectForBounds:` is the one it
//                   reads, and it is a separate flavour rather than a second
//                   method on the first because an NSTextFieldCell that
//                   overrode BOTH would shift its text twice.
fn flavour_cell() -> u32 { return 0 as u32; }
fn flavour_editor() -> u32 { return 1 as u32; }
fn flavour_title() -> u32 { return 2 as u32; }
fn flavour_hover() -> u32 { return 3 as u32; }
fn flavour_knob() -> u32 { return 4 as u32; }
fn flavour_locked() -> u32 { return 5 as u32; }

// The cache key is per FLAVOUR: three of them exist and two could otherwise
// land on one base class, handing back a subclass that overrides the wrong
// method.
fn flavour_key(flavour: u32) -> *u8 {
    if flavour == flavour_editor() { return { 29096 as *u8 }; }
    if flavour == flavour_title() { return { 29097 as *u8 }; }
    if flavour == flavour_hover() { return { 29098 as *u8 }; }
    if flavour == flavour_knob() { return { 29100 as *u8 }; }
    if flavour == flavour_locked() { return { 29101 as *u8 }; }
    if flavour == flavour_select() { return { 29106 as *u8 }; }
    if flavour == flavour_track() { return { 29109 as *u8 }; }
    if flavour == flavour_kern() { return { 29117 as *u8 }; }
    if flavour == flavour_switch() { return { 29124 as *u8 }; }
    if flavour == flavour_swipe() { return { 29130 as *u8 }; }
    return subclass_key();
}

fn subclass_of(base: *u8, prefix: str, flavour: u32) -> *u8 {
    if base == (0 as *u8) { return base; }
    if is_ours(base) { return base; }
    let cached: *u8 = { synth::get_associated(base, flavour_key(flavour)) };
    if cached != (0 as *u8) { return cached; }
    var name: text::Text = text::from_str(prefix);
    let _a: status::Status = name.append(digit((SUBCLASSES / (10 as u32)) % (10 as u32)));
    let _b: status::Status = name.append(digit(SUBCLASSES % (10 as u32)));
    SUBCLASSES = SUBCLASSES + (1 as u32);
    var made: *u8 = base;
    match name.c_str() {
        option::Option[text::CString]::Some(cs) => {
            let cls: *u8 = synth::allocate_class_pair(base, cs.as_ptr(), 0 as usize);
            if cls != (0 as *u8) {
                let rect_types: *u8 =
                    #str_ptr("{CGRect={CGPoint=dd}{CGSize=dd}}@:{CGRect={CGPoint=dd}{CGSize=dd}}\0");
                if flavour == flavour_cell() {
                    let _m: i8 = add_method_rect_rect(cls,
                        rt::sel(#str_ptr("drawingRectForBounds:\0")), drawing_rect_imp, rect_types);
                }
                if flavour == flavour_title() {
                    let _m: i8 = add_method_rect_rect(cls,
                        rt::sel(#str_ptr("titleRectForBounds:\0")), drawing_rect_imp, rect_types);
                }
                if flavour == flavour_select() {
                    // One class for both: a press that MOVES is a reorder and a
                    // press that does not is a pick, and they cannot be told
                    // apart until the mouse comes up.
                    let _m: i8 = synth::add_method_v_1id(cls,
                        rt::sel(#str_ptr("mouseDown:\0")), drag_start_imp, #str_ptr("v@:@\0"));
                    let _d: i8 = synth::add_method_v_1id(cls,
                        rt::sel(#str_ptr("mouseDragged:\0")), drag_move_imp, #str_ptr("v@:@\0"));
                    let _u: i8 = synth::add_method_v_1id(cls,
                        rt::sel(#str_ptr("mouseUp:\0")), drag_drop_imp, #str_ptr("v@:@\0"));
                }
                if flavour == flavour_swipe() {
                    let _d: i8 = synth::add_method_v_1id(cls,
                        rt::sel(#str_ptr("mouseDown:\0")), swipe_down_imp, #str_ptr("v@:@\0"));
                    let _m: i8 = synth::add_method_v_1id(cls,
                        rt::sel(#str_ptr("mouseDragged:\0")), swipe_drag_imp, #str_ptr("v@:@\0"));
                    let _u: i8 = synth::add_method_v_1id(cls,
                        rt::sel(#str_ptr("mouseUp:\0")), swipe_up_imp, #str_ptr("v@:@\0"));
                }
                if flavour == flavour_kern() {
                    let _b: i8 = add_method_i8_0v(cls,
                        rt::sel(#str_ptr("becomeFirstResponder\0")), kern_become_imp,
                        #str_ptr("c@:\0"));
                    let _r: i8 = add_method_i8_0v(cls,
                        rt::sel(#str_ptr("resignFirstResponder\0")), kern_resign_imp,
                        #str_ptr("c@:\0"));
                }
                if flavour == flavour_knob() || flavour == flavour_track() {
                    let _k: i8 = add_method_v_rect(cls,
                        rt::sel(#str_ptr("drawKnob:\0")), draw_knob_imp,
                        #str_ptr("v@:{CGRect={CGPoint=dd}{CGSize=dd}}\0"));
                }
                if flavour == flavour_track() {
                    let _b: i8 = add_method_v_rect_i8(cls,
                        rt::sel(#str_ptr("drawBarInside:flipped:\0")), draw_bar_imp,
                        #str_ptr("v@:{CGRect={CGPoint=dd}{CGSize=dd}}c\0"));
                }
                if flavour == flavour_locked() {
                    let _s: i8 = synth::add_method_v_1id(cls,
                        rt::sel(#str_ptr("scrollWheel:\0")), locked_scroll_imp, #str_ptr("v@:@\0"));
                }
                if flavour == flavour_hover() {
                    let _e: i8 = synth::add_method_v_1id(cls,
                        rt::sel(#str_ptr("mouseEntered:\0")), hover_in_imp, #str_ptr("v@:@\0"));
                    let _x: i8 = synth::add_method_v_1id(cls,
                        rt::sel(#str_ptr("mouseExited:\0")), hover_out_imp, #str_ptr("v@:@\0"));
                }
                if flavour == flavour_editor() {
                    let _m: i8 = add_method_point_0(cls,
                        rt::sel(#str_ptr("textContainerOrigin\0")), container_origin_imp,
                        #str_ptr("{CGPoint=dd}@:\0"));
                }
                synth::register_class_pair(cls);
                synth::set_associated(cls, marker_key(), 1 as *u8);
                made = cls;
            }
        }
        option::Option[text::CString]::None => { }
    }
    if made != base { synth::set_associated(base, flavour_key(flavour), made); }
    return made;
}

// Call super without objc_msgSendSuper. A struct-returning method needs
// `objc_msgSendSuper_stret` on x86_64 and plain `objc_msgSendSuper` on arm64,
// and taking the IMP off the superclass and calling it as an ordinary function
// is the same call with neither spelling in it. `input::imp_hit_test` uses the
// technique too, on the other side of the same problem.
fn super_drawing_rect(self_obj: *u8, cmd: *u8, bounds: rt::Rect) -> rt::Rect {
    let base: *u8 = { class_getSuperclass(synth::object_class(self_obj)) };
    if base == (0 as *u8) { return bounds; }
    let imp: *u8 = { super_imp_of(base, cmd) };
    if imp == (0 as *u8) { return bounds; }
    let f: fn(*u8, *u8, rt::Rect) -> rt::Rect = { imp as fn(*u8, *u8, rt::Rect) -> rt::Rect };
    return f(self_obj, cmd, bounds);
}

fn super_point(self_obj: *u8, cmd: *u8) -> rt::Point {
    let none: rt::Point = rt::Point { x: 0.0f64, y: 0.0f64 };
    let base: *u8 = { class_getSuperclass(synth::object_class(self_obj)) };
    if base == (0 as *u8) { return none; }
    let imp: *u8 = { super_imp_of(base, cmd) };
    if imp == (0 as *u8) { return none; }
    let f: fn(*u8, *u8) -> rt::Point = { imp as fn(*u8, *u8) -> rt::Point };
    return f(self_obj, cmd);
}

// ---- vertical alignment, the field family ------------------------------------

fn code_top() -> u64 { return 1 as u64; }
fn code_bottom() -> u64 { return 3 as u64; }

// `Center` is the generated default and means NOT ASKED — see the header. A
// justified vertical alignment is not a thing, so it means the same.
fn vertical_code(a: vocab::TextAlign) -> u64 {
    return match a {
        vocab::TextAlign::Start => code_top(),
        vocab::TextAlign::End => code_bottom(),
        vocab::TextAlign::Center => 0 as u64,
        vocab::TextAlign::Justify => 0 as u64,
    };
}

fn control_is_flipped(cell: *u8) -> bool {
    let cv: *u8 = { rt::msg_id(cell, rt::sel(#str_ptr("controlView\0"))) };
    if cv == (0 as *u8) { return false; }
    return { rt::msg_i8(cv, rt::sel(#str_ptr("isFlipped\0"))) } != (0 as i8);
}

// The rect the cell draws its text in. Super's answer is the whole interior,
// which is why a taller field centres: the text is laid out inside it. Shrink
// it to what the text NEEDS and put that where the node asked, and the trailing
// inset a clear button occupies comes off the same rect — one place that owns
// where the text goes.
fn drawing_rect_imp(self_obj: *u8, cmd: *u8, bounds: rt::Rect) -> rt::Rect {
    var base: rt::Rect = super_drawing_rect(self_obj, cmd, bounds);
    let trailing: f64 = { synth::get_associated(self_obj, trailing_key()) as u64 } as f64;
    if trailing > 0.0f64 && base.w > trailing {
        base = rt::Rect { x: base.x, y: base.y, w: base.w - trailing, h: base.h };
    }
    let code: u64 = { synth::get_associated(self_obj, align_key()) as u64 };
    if code == (0 as u64) { return base; }
    // The two flavours differ in WHICH of the two numbers super already knew.
    //
    //   drawing rect   super hands back the whole interior, and the text's own
    //                  height is the thing to compute.
    //   title rect     NSPopUpButtonCell hands back a rect ALREADY the height
    //                  of its title and already centred — so the height is
    //                  known and the BOX to place it in is what has to be
    //                  asked for separately.
    //
    // Getting this backwards is what the first version did, and the slack came
    // out zero: it measured a centred title against itself.
    var box: rt::Rect = base;
    var h: f64 = base.h;
    if cmd == rt::sel(#str_ptr("titleRectForBounds:\0")) {
        box = { msg_rect_of_rect(self_obj, rt::sel(#str_ptr("drawingRectForBounds:\0")), bounds) };
    } else {
        h = { msg_size_rect(self_obj, rt::sel(#str_ptr("cellSizeForBounds:\0")), base) }.h;
    }
    if h > box.h { h = box.h; }
    let slack: f64 = box.h - h;
    if slack <= 0.0f64 { return base; }
    // A flipped control counts y downward, so "toward the top" is the opposite
    // offset. NSTextField's flippedness is asked rather than assumed — it is
    // not the same answer on every macOS.
    let flipped: bool = control_is_flipped(self_obj);
    var y: f64 = box.y;
    if code == code_top() {
        if !flipped { y = box.y + slack; }
    } else {
        if flipped { y = box.y + slack; }
    }
    return rt::Rect { x: base.x, y: y, w: base.w, h: h };
}

#[link_name = "objc_msgSend"]
extern fn msg_rect_of_rect(recv: *u8, sel: *u8, r: rt::Rect) -> rt::Rect;

// Give this control's cell facet's drawing rect. Idempotent, and it does
// NOTHING for a control that asked for neither vertical alignment nor a clear
// button — an untouched cell is one fewer runtime class in the process.
fn field_cell(v: *u8) -> *u8 {
    if v == (0 as *u8) { return 0 as *u8; }
    return { rt::msg_id(v, rt::sel(#str_ptr("cell\0"))) };
}

// Which hook this cell places its text with. A button cell reads the TITLE
// rect and ignores the drawing rect, which is not a guess — the drawing-rect
// version was written first and a test caught it doing nothing.
fn cell_flavour(cell: *u8) -> u32 {
    if { rt::msg_i8_id(cell, rt::sel(#str_ptr("isKindOfClass:\0")),
                       rt::get_class(#str_ptr("NSButtonCell\0"))) } != (0 as i8) {
        return flavour_title();
    }
    return flavour_cell();
}

fn adopt_cell(v: *u8) -> *u8 {
    let cell: *u8 = field_cell(v);
    if cell == (0 as *u8) { return 0 as *u8; }
    let cls: *u8 = { synth::object_class(cell) };
    if is_ours(cls) { return cell; }
    let sub: *u8 = subclass_of(cls, "FacetCell", cell_flavour(cell));
    if sub != cls { let _old: *u8 = { object_setClass(cell, sub) }; }
    return cell;
}

fn apply_field_vertical_align(v: *u8, a: vocab::TextAlign) {
    let code: u64 = vertical_code(a);
    if code == (0 as u64) {
        let cell: *u8 = field_cell(v);
        if cell != (0 as *u8) { synth::set_associated(cell, align_key(), 0 as *u8); }
        return;
    }
    let cell: *u8 = adopt_cell(v);
    if cell == (0 as *u8) { return; }
    synth::set_associated(cell, align_key(), { code as *u8 });
    { rt::msg_void_i8(v, rt::sel(#str_ptr("setNeedsDisplay:\0")), 1 as i8) };
    return;
}

// ---- vertical alignment, the editor ------------------------------------------
// NSTextView has no cell. Its documented hook is `textContainerOrigin`, which
// is where the laid-out text is drawn from — so the same three answers, one
// level down.

fn container_origin_imp(self_obj: *u8, cmd: *u8) -> rt::Point {
    let base: rt::Point = super_point(self_obj, cmd);
    let code: u64 = { synth::get_associated(self_obj, align_key()) as u64 };
    if code == (0 as u64) { return base; }
    let lm: *u8 = { rt::msg_id(self_obj, rt::sel(#str_ptr("layoutManager\0"))) };
    let tc: *u8 = { rt::msg_id(self_obj, rt::sel(#str_ptr("textContainer\0"))) };
    if lm == (0 as *u8) || tc == (0 as *u8) { return base; }
    // The laid-out extent, not the container's — a container is as tall as the
    // view and would leave no slack at all.
    let used: rt::Rect = { msg_rect_id(lm, rt::sel(#str_ptr("usedRectForTextContainer:\0")), tc) };
    let box: rt::Rect = { rt::msg_rect(self_obj, rt::sel(#str_ptr("bounds\0"))) };
    let slack: f64 = box.h - used.h;
    if slack <= 0.0f64 { return base; }
    // An NSTextView is always flipped, so a larger y is further DOWN.
    if code == code_top() { return base; }
    return rt::Point { x: base.x, y: base.y + slack };
}

fn apply_editor_vertical_align(tv: *u8, a: vocab::TextAlign) {
    if tv == (0 as *u8) { return; }
    let code: u64 = vertical_code(a);
    if code == (0 as u64) {
        synth::set_associated(tv, align_key(), 0 as *u8);
        return;
    }
    let cls: *u8 = { synth::object_class(tv) };
    if !is_ours(cls) {
        let sub: *u8 = subclass_of(cls, "FacetEditor", flavour_editor());
        if sub != cls { let _old: *u8 = { object_setClass(tv, sub) }; }
    }
    synth::set_associated(tv, align_key(), { code as *u8 });
    { rt::msg_void_i8(tv, rt::sel(#str_ptr("setNeedsDisplay:\0")), 1 as i8) };
    return;
}

// ---- the clear button --------------------------------------------------------
// NSTextField has none and NSSearchField's belongs to its own cell, so this is
// a real button over the trailing edge. Two halves, and both are needed or it
// looks broken: the button, and the width the CELL gives back so the text does
// not run underneath it.
//
// Pinned by the autoresizing mask rather than by a frame observer — the field
// resizes with the layout, and `MinXMargin | HeightSizable` is AppKit's own way
// of saying "stay at the trailing edge, full height".

fn clear_button_width() -> f64 { return 18.0f64; }

fn clear_button_of(v: *u8) -> *u8 {
    return { synth::get_associated(v, clear_button_key()) };
}

fn clear_pressed(sender: *u8, ctx: *u8) {
    // The field is the button's superview; clearing through the CONTROL is
    // what makes the change reach the delegate, and the delegate is what
    // writes it back into the node.
    let field: *u8 = { rt::msg_id(sender, rt::sel(#str_ptr("superview\0"))) };
    if field == (0 as *u8) { return; }
    { rt::msg_void_id(field, rt::sel(#str_ptr("setStringValue:\0")), bridge::nsstring("")) };
    let target: *u8 = { rt::msg_id(field, rt::sel(#str_ptr("target\0"))) };
    let action: *u8 = { rt::msg_id(field, rt::sel(#str_ptr("action\0"))) };
    if target != (0 as *u8) && action != (0 as *u8) {
        { rt::msg_void_id(target, action, field) };
    }
    refresh_clear_button(field);
    return;
}

// Shown only while there is something to clear. `WhileEditing` is MAUI's word
// and macOS has no "while editing" state a field can be asked for outside its
// window, so the honest reading is "while it has content" — a field with text
// and no focus still shows one, which is what every macOS search field does.
fn refresh_clear_button(v: *u8) {
    let b: *u8 = clear_button_of(v);
    if b == (0 as *u8) { return; }
    let s: *u8 = { rt::msg_id(v, rt::sel(#str_ptr("stringValue\0"))) };
    let len: u64 = { rt::msg_u64(s, rt::sel(#str_ptr("length\0"))) };
    { rt::msg_void_i8(b, rt::sel(#str_ptr("setHidden:\0")), (len == (0 as u64)) as i8) };
    return;
}

fn wants_clear(mode: vocab::ClearButton) -> bool {
    return match mode {
        vocab::ClearButton::Never => false,
        vocab::ClearButton::WhileEditing => true,
    };
}

fn apply_clear_button(v: *u8, mode: vocab::ClearButton) {
    let existing: *u8 = clear_button_of(v);
    if !wants_clear(mode) {
        if existing != (0 as *u8) {
            { rt::msg_void(existing, rt::sel(#str_ptr("removeFromSuperview\0"))) };
            synth::set_associated(v, clear_button_key(), 0 as *u8);
            let cell: *u8 = field_cell(v);
            if cell != (0 as *u8) { synth::set_associated(cell, trailing_key(), 0 as *u8); }
        }
        return;
    }
    if existing != (0 as *u8) { refresh_clear_button(v); return; }
    let box: rt::Rect = { rt::msg_rect(v, rt::sel(#str_ptr("bounds\0"))) };
    let w: f64 = clear_button_width();
    let b: ak::Button = ak::Button::from_raw(rt::alloc_init(#str_ptr("NSButton\0")));
    b.set_button_type(ak::ButtonType::MomentaryChange);
    b.set_bordered(false);
    b.set_title("");
    match ak::Image::image_with_system_symbol_name("xmark.circle.fill", "clear") {
        option::Option[ak::Image]::Some(img) => { b.set_image(img); }
        option::Option[ak::Image]::None => { }
    }
    let bv: ak::View = b.as_view();
    bv.set_frame(rt::Rect { x: box.w - w, y: 0.0f64, w: w, h: box.h });
    // MinXMargin (1) | HeightSizable (16): pinned to the trailing edge, as tall
    // as the field, whatever the layout does to it later.
    { rt::msg_void_u64(bv.raw(), rt::sel(#str_ptr("setAutoresizingMask:\0")), 17 as u64) };
    akx::set_control_action_ctx(b.as_control(), clear_pressed, 0 as *u8);
    ak::View::from_raw(v).add_subview(bv);
    synth::set_associated(v, clear_button_key(), bv.raw());
    // And the cell gives the width back, or the text runs under the button.
    let cell: *u8 = adopt_cell(v);
    if cell != (0 as *u8) {
        synth::set_associated(cell, trailing_key(), { (w as u64) as *u8 });
    }
    refresh_clear_button(v);
    return;
}

// ---- the editor's placeholder ------------------------------------------------
// NSTextView has no placeholder API, which is true and is not the end of it: a
// placeholder is a label under the text, hidden as soon as there is any. It
// goes INSIDE the text view so it scrolls and clips with the content, and it
// takes no input — it is not in the responder chain at all.

fn placeholder_of(tv: *u8) -> *u8 {
    return { synth::get_associated(tv, placeholder_key()) };
}

fn refresh_editor_placeholder(tv: *u8) {
    let label: *u8 = placeholder_of(tv);
    if label == (0 as *u8) { return; }
    let s: *u8 = { rt::msg_id(tv, rt::sel(#str_ptr("string\0"))) };
    let len: u64 = { rt::msg_u64(s, rt::sel(#str_ptr("length\0"))) };
    { rt::msg_void_i8(label, rt::sel(#str_ptr("setHidden:\0")), (len != (0 as u64)) as i8) };
    return;
}

fn apply_editor_placeholder(tv: *u8, s: str, c: vocab::Color, font: option::Option[ak::Font]) {
    if tv == (0 as *u8) { return; }
    var label: *u8 = placeholder_of(tv);
    if s == "" {
        if label != (0 as *u8) {
            { rt::msg_void(label, rt::sel(#str_ptr("removeFromSuperview\0"))) };
            synth::set_associated(tv, placeholder_key(), 0 as *u8);
        }
        return;
    }
    if label == (0 as *u8) {
        let f: ak::TextField = ak::TextField::label_with_string("");
        let lv: ak::View = f.as_view();
        ak::View::from_raw(tv).add_subview(lv);
        label = lv.raw();
        synth::set_associated(tv, placeholder_key(), label);
    }
    let f: ak::TextField = ak::TextField::from_raw(label);
    f.as_control().set_string_value(s);
    var shade: vocab::Color = c;
    if shade.is_set() {
        f.set_text_color(paint::ns_color(shade));
    } else {
        f.set_text_color(ak::Color::placeholder_text_color());
    }
    match font {
        option::Option[ak::Font]::Some(fo) => { f.as_control().set_font(fo); }
        option::Option[ak::Font]::None => { }
    }
    // The origin the text itself starts at, plus the container's own line
    // padding — anything else and the placeholder sits a few points off the
    // text it stands in for, which is exactly the tell of a fake one.
    let origin: rt::Point = { msg_point0(tv, rt::sel(#str_ptr("textContainerOrigin\0"))) };
    var pad: f64 = 0.0f64;
    let tc: *u8 = { rt::msg_id(tv, rt::sel(#str_ptr("textContainer\0"))) };
    if tc != (0 as *u8) {
        pad = { rt::msg_f64(tc, rt::sel(#str_ptr("lineFragmentPadding\0"))) };
    }
    let fit: rt::Size = { msg_size0(label, rt::sel(#str_ptr("fittingSize\0"))) };
    { rt::msg_void_rect(label, rt::sel(#str_ptr("setFrame:\0")),
                        rt::Rect { x: origin.x + pad, y: origin.y, w: fit.w, h: fit.h }) };
    refresh_editor_placeholder(tv);
    return;
}

#[link_name = "objc_msgSend"]
extern fn msg_size0(recv: *u8, sel: *u8) -> rt::Size;

// ---- the popup's prompt ------------------------------------------------------
// `Picker.Title` is the text a popup shows when nothing is chosen.
// NSPopUpButton shows the SELECTED ITEM and has no prompt slot — so the prompt
// is an item: disabled, at the top, selected exactly while the selection is
// empty. That is what a prompt is on every platform that has one, and it means
// `title_color` is just that item's attributed title.
//
// The caller owns the index arithmetic, because only it knows whether the
// application's `selected_index` counts the prompt (it does not).

fn install_popup_title(b: ak::PopUpButton, title: str, c: vocab::Color,
                       font: option::Option[ak::Font], selected: i64) {
    if title == "" { return; }
    let item: ak::MenuItem = ak::MenuItem::new(title, 0 as *u8, "");
    item.set_enabled(false);
    if c.is_set() {
        let attrs: *u8 = paint::rich_attributes(font, c, 0.0f64, 0.0f64,
                                                option::Option[vocab::TextAlign]::None,
                                                vocab::TextDecoration::None);
        let a: *u8 = paint::attributed(title, attrs);
        if a != (0 as *u8) {
            { rt::msg_void_id(item.raw(), rt::sel(#str_ptr("setAttributedTitle:\0")), a) };
            rt::release(a);
        }
    }
    match b.menu() {
        option::Option[ak::Menu]::Some(m) => {
            { rt::msg_void_id_i64(m.raw(), rt::sel(#str_ptr("insertItem:atIndex:\0")),
                                  item.raw(), 0 as i64) };
        }
        option::Option[ak::Menu]::None => { }
    }
    // Nothing chosen: the prompt is what shows. `selectItemAtIndex:` honours a
    // disabled item — it is the MENU that will not let one be clicked, which is
    // exactly the behaviour a prompt wants.
    if selected < (0 as i64) {
        { rt::msg_void_i64(b.raw(), rt::sel(#str_ptr("selectItemAtIndex:\0")), 0 as i64) };
    }
    return;
}

#[link_name = "objc_msgSend"]
extern fn msg_void_id_i64(recv: *u8, sel: *u8, a: *u8, b: i64);

// The offset an application's index needs, because the prompt took index 0.
fn title_offset(title: str) -> i64 {
    if title == "" { return 0 as i64; }
    return 1 as i64;
}

// ---- the search field's own buttons ------------------------------------------
// Both are TEMPLATE images on cells of NSSearchFieldCell's own — which is what
// makes them tintable, not what stops it. A template image is a mask; drawing
// it into a new image through a colour is the documented way to colour one.

fn tint_search_buttons(v: *u8, cancel: vocab::Color, icon: vocab::Color) {
    let cell: *u8 = field_cell(v);
    if cell == (0 as *u8) { return; }
    if icon.is_set() {
        tint_button_cell(cell, #str_ptr("searchButtonCell\0"), icon);
    }
    if cancel.is_set() {
        tint_button_cell(cell, #str_ptr("cancelButtonCell\0"), cancel);
    }
    { rt::msg_void_i8(v, rt::sel(#str_ptr("setNeedsDisplay:\0")), 1 as i8) };
    return;
}

fn tint_button_cell(cell: *u8, which: *u8, c: vocab::Color) {
    let bc: *u8 = { rt::msg_id(cell, rt::sel(which)) };
    if bc == (0 as *u8) { return; }
    let img: *u8 = { rt::msg_id(bc, rt::sel(#str_ptr("image\0"))) };
    if img == (0 as *u8) { return; }
    let tinted: *u8 = tinted_image(img, c);
    if tinted == (0 as *u8) { return; }
    { rt::msg_void_id(bc, rt::sel(#str_ptr("setImage:\0")), tinted) };
    rt::release(tinted);
    return;
}

// A copy of `img` filled with `c` wherever the original had ink. `sourceAtop`
// (5) keeps the source's alpha and takes the fill's colour, which is exactly
// what tinting a template image means.
fn tinted_image(img: *u8, c: vocab::Color) -> *u8 {
    let size: rt::Size = { msg_size0(img, rt::sel(#str_ptr("size\0"))) };
    if size.w <= 0.0f64 || size.h <= 0.0f64 { return 0 as *u8; }
    let alloced: *u8 = { rt::msg_id(rt::get_class(#str_ptr("NSImage\0")),
                                    rt::sel(#str_ptr("alloc\0"))) };
    let out: *u8 = { msg_id_size(alloced, rt::sel(#str_ptr("initWithSize:\0")), size) };
    if out == (0 as *u8) { return 0 as *u8; }
    let whole: rt::Rect = rt::Rect { x: 0.0f64, y: 0.0f64, w: size.w, h: size.h };
    let nothing: rt::Rect = rt::Rect { x: 0.0f64, y: 0.0f64, w: 0.0f64, h: 0.0f64 };
    { rt::msg_void(out, rt::sel(#str_ptr("lockFocus\0"))) };
    // The mask first, at full strength.
    { msg_void_rect_rect_u64_f64(img,
        rt::sel(#str_ptr("drawInRect:fromRect:operation:fraction:\0")),
        whole, nothing, 2 as u64, 1.0f64) };
    // Then the colour, SOURCE ATOP: it keeps the mask's alpha and replaces its
    // colour, which is what tinting a template image means.
    match ak::GraphicsContext::current_context() {
        option::Option[ak::GraphicsContext]::Some(g) => {
            g.set_compositing_operation(ak::CompositingOperation::SourceAtop);
        }
        option::Option[ak::GraphicsContext]::None => { }
    }
    { rt::msg_void(paint::ns_color(c).raw(), rt::sel(#str_ptr("set\0"))) };
    { rt::msg_void_rect(rt::get_class(#str_ptr("NSBezierPath\0")),
                        rt::sel(#str_ptr("fillRect:\0")), whole) };
    { rt::msg_void(out, rt::sel(#str_ptr("unlockFocus\0"))) };
    // No longer a template: it carries its own colour now, and a template
    // would be recoloured again by whatever draws it.
    { rt::msg_void_i8(out, rt::sel(#str_ptr("setTemplate:\0")), 0 as i8) };
    return out;
}

#[link_name = "objc_msgSend"]
extern fn msg_id_size(recv: *u8, sel: *u8, s: rt::Size) -> *u8;
#[link_name = "objc_msgSend"]
extern fn msg_void_rect_rect_u64_f64(recv: *u8, sel: *u8, a: rt::Rect, b: rt::Rect, op: u64, f: f64);

// ---- the refresh affordance --------------------------------------------------
// MAUI's RefreshView and ListView's pull-to-refresh band. The ledger said
// "pull-to-refresh is a touch idiom", which is true about the GESTURE and was
// being read as a claim about the feature. macOS has no pull-to-refresh — and
// facet's own rule already says what to do about that:
//
//   an agent has no hands. If something can only be reached by a gesture,
//   that is the bug; add a click path in the UI.
//
// So a refreshable shows a refresh CONTROL at the top of its content: a button
// while idle, a spinner while refreshing. A user clicks it, an agent clicks it,
// and `begin_refresh` drives it from code. Nothing about it is a gesture.
//
// On an NSScrollView the strip is a FLOATING SUBVIEW — AppKit's own answer for
// a thing pinned to the top of a scrolling area, which is exactly the shape
// this needs and is why the list half costs nothing extra.

fn strip_key() -> *u8 { return { 29086 as *u8 }; }
fn spinner_key() -> *u8 { return { 29087 as *u8 }; }
fn refresh_handler_key() -> *u8 { return { 29088 as *u8 }; }
fn refresh_ctx_key() -> *u8 { return { 29089 as *u8 }; }

fn strip_height() -> f64 { return 24.0f64; }

fn refresh_strip_of(host: *u8) -> *u8 { return { synth::get_associated(host, strip_key()) }; }
fn refresh_spinner_of(host: *u8) -> *u8 { return { synth::get_associated(host, spinner_key()) }; }

// The click, whatever produced it. The handler and its ctx ride the STRIP, so
// one trampoline serves both kinds and neither has to grow a delegate.
fn refresh_clicked(sender: *u8, ctx: *u8) {
    let strip: *u8 = { rt::msg_id(sender, rt::sel(#str_ptr("superview\0"))) };
    if strip == (0 as *u8) { return; }
    let h: fn(*u8, *u8) = { synth::get_associated(strip, refresh_handler_key()) as fn(*u8, *u8) };
    if { h } == (0 as fn(*u8, *u8)) { return; }
    h(sender, { synth::get_associated(strip, refresh_ctx_key()) });
    return;
}

// Idempotent. The strip is built once and then only its STATE changes, because
// a scroll view's floating subview list is not something to churn per apply.
fn install_refresh_strip(host: *u8) -> *u8 {
    let existing: *u8 = refresh_strip_of(host);
    if existing != (0 as *u8) { return existing; }
    let box: rt::Rect = { rt::msg_rect(host, rt::sel(#str_ptr("bounds\0"))) };
    let strip: ak::View = akx::new_flipped_view(
        rt::Rect { x: 0.0f64, y: 0.0f64, w: box.w, h: strip_height() });
    // Width tracks the host; the TOP edge is fixed. In a flipped host that is
    // min-Y fixed and max-Y flexible: WidthSizable (2) | MaxYMargin (32).
    { rt::msg_void_u64(strip.raw(), rt::sel(#str_ptr("setAutoresizingMask:\0")), 34 as u64) };

    let b: ak::Button = ak::Button::from_raw(rt::alloc_init(#str_ptr("NSButton\0")));
    b.set_button_type(ak::ButtonType::MomentaryChange);
    b.set_bordered(false);
    b.set_title("");
    match ak::Image::image_with_system_symbol_name("arrow.clockwise", "refresh") {
        option::Option[ak::Image]::Some(img) => { b.set_image(img); }
        option::Option[ak::Image]::None => { b.set_title("Refresh"); }
    }
    let bv: ak::View = b.as_view();
    bv.set_frame(rt::Rect { x: 0.0f64, y: 0.0f64, w: box.w, h: strip_height() });
    { rt::msg_void_u64(bv.raw(), rt::sel(#str_ptr("setAutoresizingMask:\0")), 2 as u64) };
    akx::set_control_action_ctx(b.as_control(), refresh_clicked, 0 as *u8);
    strip.add_subview(bv);

    let pi: ak::ProgressIndicator = ak::ProgressIndicator::from_raw(
        rt::alloc_init(#str_ptr("NSProgressIndicator\0")));
    pi.set_style(ak::ProgressIndicatorStyle::Spinning);
    pi.set_indeterminate(true);
    let pv: ak::View = pi.as_view();
    pv.set_frame(rt::Rect { x: (box.w - strip_height()) / 2.0f64, y: 0.0f64,
                            w: strip_height(), h: strip_height() });
    pv.set_hidden(true);
    strip.add_subview(pv);

    // A scroll view has AppKit's own slot for this; anything else takes an
    // ordinary subview pinned by its mask.
    if { rt::msg_i8_id(host, rt::sel(#str_ptr("isKindOfClass:\0")),
                       rt::get_class(#str_ptr("NSScrollView\0"))) } != (0 as i8) {
        // NSEventGestureAxisVertical = 2.
        { rt::msg_void_id_i64(host, rt::sel(#str_ptr("addFloatingSubview:forAxis:\0")),
                              strip.raw(), 2 as i64) };
    } else {
        ak::View::from_raw(host).add_subview(strip);
    }
    synth::set_associated(host, strip_key(), strip.raw());
    synth::set_associated(host, spinner_key(), pv.raw());
    return strip.raw();
}

fn remove_refresh_strip(host: *u8) {
    let strip: *u8 = refresh_strip_of(host);
    if strip == (0 as *u8) { return; }
    { rt::msg_void(strip, rt::sel(#str_ptr("removeFromSuperview\0"))) };
    synth::set_associated(host, strip_key(), 0 as *u8);
    synth::set_associated(host, spinner_key(), 0 as *u8);
    return;
}

// The whole band in one call, because the five props are one state: whether
// there is an affordance, whether it is usable, and which of its two faces is
// showing.
fn apply_refresh(host: *u8, enabled: bool, refreshing: bool, allowed: bool,
                 color: vocab::Color, h: fn(*u8, *u8), ctx: *u8) {
    if host == (0 as *u8) { return; }
    if !enabled {
        remove_refresh_strip(host);
        return;
    }
    let strip: *u8 = install_refresh_strip(host);
    if strip == (0 as *u8) { return; }
    synth::set_associated(strip, refresh_handler_key(), { h as *u8 });
    synth::set_associated(strip, refresh_ctx_key(), ctx);
    let spinner: *u8 = refresh_spinner_of(host);
    let button: *u8 = refresh_button_of(strip);
    if button != (0 as *u8) {
        { rt::msg_void_i8(button, rt::sel(#str_ptr("setHidden:\0")), refreshing as i8) };
        { rt::msg_void_i8(button, rt::sel(#str_ptr("setEnabled:\0")), allowed as i8) };
    }
    if spinner != (0 as *u8) {
        { rt::msg_void_i8(spinner, rt::sel(#str_ptr("setHidden:\0")), (refreshing == false) as i8) };
        if refreshing {
            { rt::msg_void_id(spinner, rt::sel(#str_ptr("startAnimation:\0")), 0 as *u8) };
        } else {
            { rt::msg_void_id(spinner, rt::sel(#str_ptr("stopAnimation:\0")), 0 as *u8) };
        }
        tint_spinner(spinner, color);
    }
    return;
}

fn refresh_button_of(strip: *u8) -> *u8 {
    let subs: vec::Vec[ak::View] = ak::View::from_raw(strip).subviews();
    return match subs.at_ptr(0 as usize) {
        option::Option[*ak::View]::Some(v) => { (*v).raw() },
        option::Option[*ak::View]::None => 0 as *u8,
    };
}

// NSProgressIndicator has no tint, and the ledger stops there for the
// determinate BAR — a monochrome filter over a bar would flatten its fill and
// its track into one colour, which is worse than not colouring it. An
// indeterminate spinner is uniform, so mapping it onto one colour is exactly
// what tinting it means.
fn tint_spinner(spinner: *u8, c: vocab::Color) {
    if c.is_set() == false { return; }
    let filter: *u8 = { rt::msg_id_id(rt::get_class(#str_ptr("CIFilter\0")),
                                      rt::sel(#str_ptr("filterWithName:\0")),
                                      bridge::nsstring("CIColorMonochrome")) };
    if filter == (0 as *u8) { return; }
    let ci: *u8 = { rt::msg_id_id(rt::get_class(#str_ptr("CIColor\0")),
                                  rt::sel(#str_ptr("colorWithCGColor:\0")),
                                  paint::ns_color(c).c_g_color()) };
    if ci == (0 as *u8) { return; }
    { rt::msg_void_id_id(filter, rt::sel(#str_ptr("setValue:forKey:\0")),
                         ci, bridge::nsstring("inputColor")) };
    let arr: *u8 = { rt::msg_id_id(rt::get_class(#str_ptr("NSArray\0")),
                                   rt::sel(#str_ptr("arrayWithObject:\0")), filter) };
    ak::View::from_raw(spinner).set_wants_layer(true);
    { rt::msg_void_id(spinner, rt::sel(#str_ptr("setContentFilters:\0")), arr) };
    return;
}

// ---- the picker's popover ----------------------------------------------------
// `DatePicker.IsOpen` and its two edges. The ledger said "a field-with-stepper
// has no popover to open", which is true of that ONE control and was standing
// in for the whole question: a graphical NSDatePicker exists, an NSPopover
// exists, and putting the first inside the second is what every macOS app that
// offers a calendar does.
//
// The field stays the field. The popover is a SECOND picker bound to the same
// value, so the control an application laid out does not change shape when it
// gains the ability to open — and a write to `date` still lands in one place.
//
// `is_open` is the click path, which is the point: an agent has no hands and
// cannot reach a calendar by clicking a stepper, but it can write the verb.

fn popover_key() -> *u8 { return { 29090 as *u8 }; }
fn popover_field_key() -> *u8 { return { 29091 as *u8 }; }
fn popover_node_key() -> *u8 { return { 29092 as *u8 }; }
fn popover_opened_key() -> *u8 { return { 29093 as *u8 }; }
fn popover_closed_key() -> *u8 { return { 29094 as *u8 }; }
fn popover_owner_key() -> *u8 { return { 29095 as *u8 }; }
fn popover_opened_ctx_key() -> *u8 { return { 29096 as *u8 }; }
fn popover_closed_ctx_key() -> *u8 { return { 29097 as *u8 }; }

// A handler's own context, or the owner node when it brought none. The owner
// IS the natural context here — before this, `fire_popover` passed a literal
// null and each handler recovered the node through `popover_owner_of(sender)`
// by hand.
fn _ctx_or(own: *u8, shared: *u8) -> *u8 {
    if own != (0 as *u8) { return own; }
    return shared;
}

// The NODE the popover belongs to, read back by the two edge handlers — which
// receive the DELEGATE as their sender, so it is the one object both sides
// already have.
fn popover_owner_of(delegate: *u8) -> *u8 {
    return { synth::get_associated(delegate, popover_owner_key()) };
}

// NSDatePickerStyleClockAndCalendar.
fn graphical_style() -> u64 { return 1 as u64; }
// NSPopoverBehaviorTransient — clicking away closes it, which is what makes
// the close edge reachable without a dismiss verb.
fn transient() -> i64 { return 1 as i64; }
// NSRectEdgeMaxY.
fn edge_below() -> u64 { return 3 as u64; }

#[link_name = "objc_msgSend"]
extern fn msg_void_rect_id_u64(recv: *u8, sel: *u8, r: rt::Rect, v: *u8, e: u64);

fn popover_of(v: *u8) -> *u8 { return { synth::get_associated(v, popover_key()) }; }

// The graphical picker changed: write it into the FIELD and let the field's own
// action run. One value, one write-back path — the popover is a second face on
// the same control, not a second source of truth.
fn popover_changed(sender: *u8, ctx: *u8) {
    let field: *u8 = { synth::get_associated(sender, popover_field_key()) };
    if field == (0 as *u8) { return; }
    { rt::msg_void_id(field, rt::sel(#str_ptr("setDateValue:\0")),
                      { rt::msg_id(sender, rt::sel(#str_ptr("dateValue\0"))) }) };
    let target: *u8 = { rt::msg_id(field, rt::sel(#str_ptr("target\0"))) };
    let action: *u8 = { rt::msg_id(field, rt::sel(#str_ptr("action\0"))) };
    if target != (0 as *u8) && action != (0 as *u8) { { rt::msg_void_id(target, action, field) }; }
    return;
}

fn popover_shown_imp(self_obj: *u8, cmd: *u8, note: *u8) {
    fire_popover(self_obj, popover_opened_key(), popover_opened_ctx_key());
    return;
}

fn popover_closed_imp(self_obj: *u8, cmd: *u8, note: *u8) {
    // The user dismissed it, so the contract's own `is_open` has to stop
    // claiming otherwise — the same write-back rule every other read follows.
    let flag: *u8 = { synth::get_associated(self_obj, popover_node_key()) };
    if flag != (0 as *u8) { { (*(flag as *bool)) = false }; }
    fire_popover(self_obj, popover_closed_key(), popover_closed_ctx_key());
    return;
}

fn fire_popover(delegate: *u8, key: *u8, ctx_key: *u8) {
    let h: fn(*u8, *u8) = { synth::get_associated(delegate, key) as fn(*u8, *u8) };
    if { h } == (0 as fn(*u8, *u8)) { return; }
    h(delegate, { synth::get_associated(delegate, ctx_key) });
    return;
}

fn popover_delegate_class() -> *u8 {
    let existing: *u8 = rt::get_class(#str_ptr("FacetPopoverDelegate\0"));
    if existing != (0 as *u8) { return existing; }
    let cls: *u8 = synth::allocate_class_pair(rt::get_class(#str_ptr("NSObject\0")),
                                              #str_ptr("FacetPopoverDelegate\0"), 0 as usize);
    synth::add_method_v_1id(cls, rt::sel(#str_ptr("popoverDidShow:\0")),
                            popover_shown_imp, #str_ptr("v@:@\0"));
    synth::add_method_v_1id(cls, rt::sel(#str_ptr("popoverDidClose:\0")),
                            popover_closed_imp, #str_ptr("v@:@\0"));
    synth::register_class_pair(cls);
    return cls;
}

// Built once, on the first `is_open`. A picker that never opens pays for no
// second picker and no popover.
fn picker_popover(field: *u8, elements: u64, min_date: *u8, max_date: *u8) -> *u8 {
    let existing: *u8 = popover_of(field);
    if existing != (0 as *u8) { return existing; }
    let cal: *u8 = { rt::alloc_init(#str_ptr("NSDatePicker\0")) };
    if cal == (0 as *u8) { return 0 as *u8; }
    { rt::msg_void_u64(cal, rt::sel(#str_ptr("setDatePickerStyle:\0")), graphical_style()) };
    { rt::msg_void_u64(cal, rt::sel(#str_ptr("setDatePickerElements:\0")), elements) };
    { rt::msg_void_id(cal, rt::sel(#str_ptr("setTimeZone:\0")),
                      { rt::msg_id(field, rt::sel(#str_ptr("timeZone\0"))) }) };
    if min_date != (0 as *u8) { { rt::msg_void_id(cal, rt::sel(#str_ptr("setMinDate:\0")), min_date) }; }
    if max_date != (0 as *u8) { { rt::msg_void_id(cal, rt::sel(#str_ptr("setMaxDate:\0")), max_date) }; }
    { rt::msg_void_rect(cal, rt::sel(#str_ptr("setFrame:\0")),
                        rt::Rect { x: 0.0f64, y: 0.0f64, w: 160.0f64, h: 150.0f64 }) };
    { rt::msg_void(cal, rt::sel(#str_ptr("sizeToFit\0"))) };
    synth::set_associated(cal, popover_field_key(), field);
    akx::set_control_action_ctx(ak::Control::from_raw(cal), popover_changed, 0 as *u8);

    let vc: *u8 = { rt::alloc_init(#str_ptr("NSViewController\0")) };
    if vc == (0 as *u8) { return 0 as *u8; }
    { rt::msg_void_id(vc, rt::sel(#str_ptr("setView:\0")), cal) };
    let pop: *u8 = { rt::alloc_init(#str_ptr("NSPopover\0")) };
    if pop == (0 as *u8) { return 0 as *u8; }
    { rt::msg_void_id(pop, rt::sel(#str_ptr("setContentViewController:\0")), vc) };
    { rt::msg_void_i64(pop, rt::sel(#str_ptr("setBehavior:\0")), transient()) };
    let d: *u8 = synth::alloc_init_class(popover_delegate_class());
    if d != (0 as *u8) {
        { rt::msg_void_id(pop, rt::sel(#str_ptr("setDelegate:\0")), d) };
        synth::retain_associated(field, popover_key(), pop);
        synth::retain_associated(pop, popover_key(), d);
        rt::release(d);
    }
    rt::release(vc);
    return pop;
}

// The whole band. `open` is a COMMAND-shaped write — true opens, false closes —
// and the two handlers ride the popover's own edges.
fn apply_picker_popover(field: *u8, open: bool, elements: u64,
                        min_date: *u8, max_date: *u8, flag: *bool, owner: *u8,
                        on_opened: fn(*u8, *u8) = 0 as fn(*u8, *u8),
                        on_opened_ctx: *u8 = 0 as *u8,
                        on_closed: fn(*u8, *u8) = 0 as fn(*u8, *u8),
                        on_closed_ctx: *u8 = 0 as *u8) {
    if field == (0 as *u8) { return; }
    if !open {
        let pop: *u8 = popover_of(field);
        if pop != (0 as *u8) { { rt::msg_void(pop, rt::sel(#str_ptr("close\0"))) }; }
        return;
    }
    // A popover anchors to a view that is ON a window, and AppKit RAISES when
    // it is not. A picker whose `is_open` is written before it is mounted is an
    // ordinary sequencing accident, not a reason to abort the process.
    if { rt::msg_id(field, rt::sel(#str_ptr("window\0"))) } == (0 as *u8) { return; }
    let pop: *u8 = picker_popover(field, elements, min_date, max_date);
    if pop == (0 as *u8) { return; }
    let d: *u8 = { rt::msg_id(pop, rt::sel(#str_ptr("delegate\0"))) };
    if d != (0 as *u8) {
        synth::set_associated(d, popover_node_key(), flag as *u8);
        synth::set_associated(d, popover_owner_key(), owner);
        synth::set_associated(d, popover_opened_key(), { on_opened as *u8 });
        synth::set_associated(d, popover_closed_key(), { on_closed as *u8 });
        synth::set_associated(d, popover_opened_ctx_key(), _ctx_or(on_opened_ctx, owner));
        synth::set_associated(d, popover_closed_ctx_key(), _ctx_or(on_closed_ctx, owner));
    }
    // The calendar shows what the field shows, every time it opens.
    let vc: *u8 = { rt::msg_id(pop, rt::sel(#str_ptr("contentViewController\0"))) };
    if vc != (0 as *u8) {
        let cal: *u8 = { rt::msg_id(vc, rt::sel(#str_ptr("view\0"))) };
        if cal != (0 as *u8) {
            { rt::msg_void_id(cal, rt::sel(#str_ptr("setDateValue:\0")),
                              { rt::msg_id(field, rt::sel(#str_ptr("dateValue\0"))) }) };
        }
    }
    { msg_void_rect_id_u64(pop, rt::sel(#str_ptr("showRelativeToRect:ofView:preferredEdge:\0")),
                           { rt::msg_rect(field, rt::sel(#str_ptr("bounds\0"))) },
                           field, edge_below()) };
    return;
}

fn picker_is_open(field: *u8) -> bool {
    let pop: *u8 = popover_of(field);
    if pop == (0 as *u8) { return false; }
    return { rt::msg_i8(pop, rt::sel(#str_ptr("isShown\0"))) } != (0 as i8);
}

// ---- window buttons that appear on hover --------------------------------------
// `ButtonStyle::OnHover` — the traffic lights, but only while the pointer is
// over the group. The ledger said "`window_buttons` has no style beyond the
// traffic lights", which answered a different question: the STYLE here is not
// which buttons, it is when they are drawn, and a tracking area answers that.
//
// The reveal is an alpha rather than `hidden`, because a hidden view leaves no
// hover target and the group could never come back.

fn hover_alpha_key() -> *u8 { return { 29099 as *u8 }; }

fn set_group_alpha(host: *u8, a: f64) {
    let subs: vec::Vec[ak::View] = ak::View::from_raw(host).subviews();
    var i: usize = 0 as usize;
    let count: usize = subs.count();
    while i < count {
        match subs.at_ptr(i) {
            option::Option[*ak::View]::Some(v) => { { (*v).set_alpha_value(a) }; }
            option::Option[*ak::View]::None => { }
        }
        i = i +% (1 as usize);
    }
    return;
}

fn hover_in_imp(self_obj: *u8, cmd: *u8, event: *u8) { set_group_alpha(self_obj, 1.0f64); return; }
fn hover_out_imp(self_obj: *u8, cmd: *u8, event: *u8) {
    if { synth::get_associated(self_obj, hover_alpha_key()) } == (0 as *u8) { return; }
    set_group_alpha(self_obj, 0.0f64);
    return;
}

#[link_name = "objc_msgSend"]
extern fn msg_init_tracking(obj: *u8, sel: *u8, rect: rt::Rect, options: u64,
                            owner: *u8, info: *u8) -> *u8;

fn apply_hover_reveal(host: *u8, on_hover: bool) {
    if host == (0 as *u8) { return; }
    if !on_hover {
        // Back to always-visible, and the tracking area stops mattering.
        synth::set_associated(host, hover_alpha_key(), 0 as *u8);
        set_group_alpha(host, 1.0f64);
        return;
    }
    let cls: *u8 = { synth::object_class(host) };
    if !is_ours(cls) {
        let sub: *u8 = subclass_of(cls, "FacetHover", flavour_hover());
        if sub != cls { let _old: *u8 = { object_setClass(host, sub) }; }
        // MouseEnteredAndExited (0x01) | ActiveAlways (0x80) | InVisibleRect (0x200)
        // — InVisibleRect is what makes it follow the view as layout moves it,
        // so there is no frame observer to keep in step.
        let box: rt::Rect = { rt::msg_rect(host, rt::sel(#str_ptr("bounds\0"))) };
        let ta_alloc: *u8 = { rt::msg_id(rt::get_class(#str_ptr("NSTrackingArea\0")),
                                         rt::sel(#str_ptr("alloc\0"))) };
        let ta: *u8 = { msg_init_tracking(ta_alloc,
            rt::sel(#str_ptr("initWithRect:options:owner:userInfo:\0")),
            box, 641 as u64, host, 0 as *u8) };
        if ta != (0 as *u8) {
            { rt::msg_void_id(host, rt::sel(#str_ptr("addTrackingArea:\0")), ta) };
            rt::release(ta);
        }
    }
    synth::set_associated(host, hover_alpha_key(), 1 as *u8);
    set_group_alpha(host, 0.0f64);
    return;
}

// ---- a slider's own knob ------------------------------------------------------
// "NSSlider's knob is cell-drawn; there is no image slot" is true and stops one
// step short: the cell that draws it has a method for drawing it, and a cell is
// an object whose class can be replaced. `drawKnob:` is handed the rect the
// knob occupies, which is the whole of what an image needs.

fn knob_image_key() -> *u8 { return { 29102 as *u8 }; }

#[link_name = "class_addMethod"]
extern fn add_method_v_rect(cls: *u8, sel: *u8, imp: fn(*u8, *u8, rt::Rect), types: *u8) -> i8;
#[link_name = "objc_msgSend"]
extern fn msg_void_rect_rect_u64_f64_i8(recv: *u8, sel: *u8, a: rt::Rect, b: rt::Rect,
                                        op: u64, f: f64, flip: i8);

fn draw_knob_imp(self_obj: *u8, cmd: *u8, knob: rt::Rect) {
    let img: *u8 = { synth::get_associated(self_obj, knob_image_key()) };
    if img == (0 as *u8) {
        // No image, but perhaps a colour: a knob is a filled circle, which is
        // what NSSliderCell draws and all `thumb_color` asks to change.
        let c: *u8 = { synth::get_associated(self_obj, knob_color_key()) };
        if c == (0 as *u8) { return; }
        let path: *u8 = { rt::msg_id_rect(rt::get_class(#str_ptr("NSBezierPath\0")),
                                          rt::sel(#str_ptr("bezierPathWithOvalInRect:\0")), knob) };
        if path == (0 as *u8) { return; }
        { rt::msg_void(c, rt::sel(#str_ptr("setFill\0"))) };
        { rt::msg_void(path, rt::sel(#str_ptr("fill\0"))) };
        return;
    }
    // `respectFlipped:` — a slider's control view is flipped, and an image
    // drawn without it comes out upside down, which is the kind of wrong that
    // only shows up on an asymmetric knob.
    { msg_void_rect_rect_u64_f64_i8(img,
        rt::sel(#str_ptr("drawInRect:fromRect:operation:fraction:respectFlipped:hints:\0")),
        knob, rt::Rect { x: 0.0f64, y: 0.0f64, w: 0.0f64, h: 0.0f64 },
        2 as u64, 1.0f64, 1 as i8) };
    return;
}

fn apply_thumb_image(v: *u8, src: str) {
    let cell: *u8 = field_cell(v);
    if cell == (0 as *u8) { return; }
    if src == "" {
        synth::set_associated(cell, knob_image_key(), 0 as *u8);
        return;
    }
    var img: *u8 = 0 as *u8;
    match ak::Image::image_with_system_symbol_name(src, "") {
        option::Option[ak::Image]::Some(i) => { img = i.raw(); }
        option::Option[ak::Image]::None => {
            match ak::Image::image_named(src) {
                option::Option[ak::Image]::Some(i) => { img = i.raw(); }
                option::Option[ak::Image]::None => {
                    img = ak::Image::new_with_contents_of_file(src).raw();
                }
            }
        }
    }
    if img == (0 as *u8) { return; }
    let cls: *u8 = { synth::object_class(cell) };
    if !is_ours(cls) {
        let sub: *u8 = subclass_of(cls, "FacetTrack", flavour_track());
        if sub != cls { let _old: *u8 = { object_setClass(cell, sub) }; }
    }
    synth::retain_associated(cell, knob_image_key(), img);
    { rt::msg_void_i8(v, rt::sel(#str_ptr("setNeedsDisplay:\0")), 1 as i8) };
    return;
}

// ---- a scroll the user cannot move --------------------------------------------
// `CarouselView.IsSwipeEnabled` — whether the USER can change the page. macOS
// has no swipe, and the ledger stopped there; the verb is not about the gesture
// but about who is allowed to move the thing, and the answer for a mouse is the
// same one: the wheel does nothing and `position` still works.

fn scroll_locked_key() -> *u8 { return { 29103 as *u8 }; }

// The class is installed once and the FLAG decides, because a class swap is not
// something to undo: a carousel that locks and unlocks would otherwise keep the
// override and stay dead.
fn locked_scroll_imp(self_obj: *u8, cmd: *u8, event: *u8) {
    if { synth::get_associated(self_obj, scroll_locked_key()) } != (0 as *u8) { return; }
    let base: *u8 = { class_getSuperclass(synth::object_class(self_obj)) };
    if base == (0 as *u8) { return; }
    let imp: *u8 = { super_imp_of(base, cmd) };
    if imp == (0 as *u8) { return; }
    let f: fn(*u8, *u8, *u8) = { imp as fn(*u8, *u8, *u8) };
    f(self_obj, cmd, event);
    return;
}

fn apply_scroll_lock(v: *u8, locked: bool) {
    if v == (0 as *u8) { return; }
    let cls: *u8 = { synth::object_class(v) };
    if !locked {
        if is_ours(cls) { synth::set_associated(v, scroll_locked_key(), 0 as *u8); }
        return;
    }
    if !is_ours(cls) {
        let sub: *u8 = subclass_of(cls, "FacetLocked", flavour_locked());
        if sub != cls { let _old: *u8 = { object_setClass(v, sub) }; }
    }
    synth::set_associated(v, scroll_locked_key(), 1 as *u8);
    return;
}

fn scroll_is_locked(v: *u8) -> bool {
    return { synth::get_associated(v, scroll_locked_key()) } != (0 as *u8);
}

// ---- picking a row out of a materialised sequence -----------------------------
// A `collection` is a scroll of ordinary children, not a table, so nothing in
// it reports a selection. The ledger read that as "a materialised collection is
// a scroll of children, not a table" and stopped; what it means is that the
// SELECTION has to be found the same way `carousel.position` is — from the
// geometry, which flex already knows.
//
// The click is taken on the DOCUMENT VIEW rather than on the rows. A plain row
// (a box, a label, a stack) does not accept mouse events, so its click walks up
// the responder chain and arrives here; a row containing a BUTTON keeps its own
// click, which is the right answer and needs no rule of its own.

fn select_hit_key() -> *u8 { return { 29104 as *u8 }; }
fn select_node_key() -> *u8 { return { 29105 as *u8 }; }

fn flavour_select() -> u32 { return 6 as u32; }

fn mouse_down_imp(self_obj: *u8, cmd: *u8, event: *u8) {
    let n: *core::Node = { synth::get_associated(self_obj, select_node_key()) as *core::Node };
    let h: fn(*u8, i64) = { synth::get_associated(self_obj, select_hit_key()) as fn(*u8, i64) };
    if n == (0 as *core::Node) || { h } == (0 as fn(*u8, i64)) { return; }
    h(self_obj, child_at_point(n, local_point(self_obj, event)));
    return;
}

#[link_name = "objc_msgSend"]
extern fn msg_point_point_id(recv: *u8, sel: *u8, p: rt::Point, v: *u8) -> rt::Point;

// The child whose laid-out box contains the point, or -1. Both axes, because a
// vertical stack's every child contains every x — the bug the carousel's own
// index lookup was written with and had to be corrected for.
fn child_at_point(n: *core::Node, p: rt::Point) -> i64 {
    let host: flex::Frame = { (*n).frame() };
    var i: usize = 0 as usize;
    let count: usize = core::child_count_of(n);
    while i < count {
        match core::child_of(n, i) {
            option::Option[*core::Node]::Some(c) => {
                let f: flex::Frame = { (*c).frame() };
                let x: f64 = f.left - host.left;
                let y: f64 = f.top - host.top;
                if p.x >= x && p.x <= (x + f.width) && p.y >= y && p.y <= (y + f.height) {
                    return i as i64;
                }
            }
            option::Option[*core::Node]::None => { }
        }
        i = i +% (1 as usize);
    }
    return -1 as i64;
}

fn install_row_selection(doc: *u8, n: *core::Node, h: fn(*u8, i64)) {
    if doc == (0 as *u8) { return; }
    let cls: *u8 = { synth::object_class(doc) };
    if !is_ours(cls) {
        let sub: *u8 = subclass_of(cls, "FacetSelect", flavour_select());
        if sub != cls { let _old: *u8 = { object_setClass(doc, sub) }; }
    }
    // Re-associated every time: a node that was detached and re-attached under
    // the same view has a new address.
    synth::set_associated(doc, select_node_key(), n as *u8);
    synth::set_associated(doc, select_hit_key(), { h as *u8 });
    return;
}

fn uninstall_row_selection(doc: *u8) {
    if doc == (0 as *u8) { return; }
    synth::set_associated(doc, select_hit_key(), 0 as *u8);
    return;
}

// The selected row's own background. `selectedContentBackgroundColor` is what
// AppKit paints a selected table row with, so a selected collection row looks
// like a selected row rather than like a coloured box.
fn paint_selection(n: *core::Node, selected: i64) {
    var i: usize = 0 as usize;
    let count: usize = core::child_count_of(n);
    while i < count {
        match core::child_of(n, i) {
            option::Option[*core::Node]::Some(c) => {
                let v: *u8 = core::view_of(c);
                if v != (0 as *u8) {
                    let view: ak::View = ak::View::from_raw(v);
                    if (i as i64) == selected {
                        view.set_wants_layer(true);
                        view.layer().set_background_color(
                            selection_color().c_g_color());
                    } else {
                        if view.wants_layer() {
                            view.layer().set_background_color(0 as *u8);
                        }
                    }
                }
            }
            option::Option[*core::Node]::None => { }
        }
        i = i +% (1 as usize);
    }
    return;
}

fn selection_color() -> ak::Color {
    let c: *u8 = { rt::msg_id(rt::get_class(#str_ptr("NSColor\0")),
                              rt::sel(#str_ptr("selectedContentBackgroundColor\0"))) };
    if c == (0 as *u8) { return ak::Color::selected_control_color(); }
    return ak::Color::from_raw(c);
}

// ---- recolouring a system-drawn control ---------------------------------------
// The manifest rejected "a tinted layer under each" and the reasoning holds: a
// rectangle behind a control stops tracking the system appearance and drifts the
// moment Apple changes the control's shape.
//
// A CONTENT FILTER is a different thing. It recolours what AppKit actually
// drew — same shape, same appearance updates, same everything except the hue —
// so neither objection applies to it. What DOES apply is a limit of its own,
// and it is the reason each of these is decided one verb at a time:
//
//   a hue rotation moves colour and leaves GREY alone, because grey has no hue
//   to rotate.
//
// Which is exactly right for the controls that draw one saturated part against
// an achromatic one: a progress bar's fill against its track, a switch's ON
// track against its white thumb. And it is exactly why the OFF track and the
// thumb stay in the ledger — there is nothing there to rotate.
//
// The colour that comes out keeps the system's saturation and brightness at the
// requested HUE. That is a tint, not a fill, and the manifest says so.

fn accent_hue() -> f64 {
    let c: *u8 = { rt::msg_id(rt::get_class(#str_ptr("NSColor\0")),
                              rt::sel(#str_ptr("controlAccentColor\0"))) };
    if c == (0 as *u8) { return 0.6f64; }        // macOS blue, near enough
    return hue_of(c);
}

fn hue_of(c: *u8) -> f64 {
    let space: *u8 = { rt::msg_id(rt::get_class(#str_ptr("NSColorSpace\0")),
                                  rt::sel(#str_ptr("sRGBColorSpace\0"))) };
    let rgb: *u8 = { rt::msg_id_id(c, rt::sel(#str_ptr("colorUsingColorSpace:\0")), space) };
    if rgb == (0 as *u8) { return 0.0f64; }
    return { rt::msg_f64(rgb, rt::sel(#str_ptr("hueComponent\0"))) };
}

fn two_pi() -> f64 { return 6.283185307179586f64; }

// Rotate `view`'s drawing from the system accent's hue to `c`'s. An unset
// colour removes the filter, so a control that stops asking goes back to the
// system's own.
fn hue_shift(view: *u8, c: vocab::Color) {
    if view == (0 as *u8) { return; }
    if c.is_set() == false {
        { rt::msg_void_id(view, rt::sel(#str_ptr("setContentFilters:\0")),
                          { rt::msg_id(rt::get_class(#str_ptr("NSArray\0")),
                                       rt::sel(#str_ptr("array\0"))) }) };
        return;
    }
    let want: f64 = hue_of(paint::ns_color(c).raw());
    var angle: f64 = (want - accent_hue()) * two_pi();
    let filter: *u8 = { rt::msg_id_id(rt::get_class(#str_ptr("CIFilter\0")),
                                      rt::sel(#str_ptr("filterWithName:\0")),
                                      bridge::nsstring("CIHueAdjust")) };
    if filter == (0 as *u8) { return; }
    let n: *u8 = { rt::msg_id_f64(rt::get_class(#str_ptr("NSNumber\0")),
                                  rt::sel(#str_ptr("numberWithDouble:\0")), angle) };
    { rt::msg_void_id_id(filter, rt::sel(#str_ptr("setValue:forKey:\0")),
                         n, bridge::nsstring("inputAngle")) };
    let arr: *u8 = { rt::msg_id_id(rt::get_class(#str_ptr("NSArray\0")),
                                   rt::sel(#str_ptr("arrayWithObject:\0")), filter) };
    ak::View::from_raw(view).set_wants_layer(true);
    { rt::msg_void_id(view, rt::sel(#str_ptr("setContentFilters:\0")), arr) };
    return;
}

// ---- the slider's track -------------------------------------------------------
// `minimum_track_color` has a real setter and is live. The other two are drawn
// by NSSliderCell — by the same cell whose `drawKnob:` already carries
// `thumb_image`, so the hook is one this file already owns.
//
// Only a slider that NAMES a colour is drawn this way. One that names none
// keeps AppKit's own drawing entirely, which is what keeps an ordinary slider
// ordinary.

fn knob_color_key() -> *u8 { return { 29107 as *u8 }; }
fn track_color_key() -> *u8 { return { 29108 as *u8 }; }

fn flavour_track() -> u32 { return 7 as u32; }

#[link_name = "class_addMethod"]
extern fn add_method_v_rect_i8(cls: *u8, sel: *u8, imp: fn(*u8, *u8, rt::Rect, i8),
                               types: *u8) -> i8;

// The EMPTY half of the track. `drawBarInside:flipped:` is handed the whole bar,
// and the filled half is `minimum_track_color`'s — which AppKit still paints,
// on top, from the real property.
fn draw_bar_imp(self_obj: *u8, cmd: *u8, bar: rt::Rect, flipped: i8) {
    let c: *u8 = { synth::get_associated(self_obj, track_color_key()) };
    if c == (0 as *u8) {
        super_bar(self_obj, cmd, bar, flipped);
        return;
    }
    let r: f64 = bar.h / 2.0f64;
    let path: *u8 = { msg_id_rect_f64_f64(rt::get_class(#str_ptr("NSBezierPath\0")),
        rt::sel(#str_ptr("bezierPathWithRoundedRect:xRadius:yRadius:\0")), bar, r, r) };
    if path == (0 as *u8) { return; }
    { rt::msg_void(c, rt::sel(#str_ptr("setFill\0"))) };
    { rt::msg_void(path, rt::sel(#str_ptr("fill\0"))) };
    return;
}

fn super_bar(self_obj: *u8, cmd: *u8, bar: rt::Rect, flipped: i8) {
    let base: *u8 = { class_getSuperclass(synth::object_class(self_obj)) };
    if base == (0 as *u8) { return; }
    let imp: *u8 = { super_imp_of(base, cmd) };
    if imp == (0 as *u8) { return; }
    let f: fn(*u8, *u8, rt::Rect, i8) = { imp as fn(*u8, *u8, rt::Rect, i8) };
    f(self_obj, cmd, bar, flipped);
    return;
}

#[link_name = "objc_msgSend"]
extern fn msg_id_rect_f64_f64(recv: *u8, sel: *u8, r: rt::Rect, x: f64, y: f64) -> *u8;

fn apply_slider_colors(v: *u8, track: vocab::Color, knob: vocab::Color) {
    let cell: *u8 = field_cell(v);
    if cell == (0 as *u8) { return; }
    if track.is_set() == false && knob.is_set() == false {
        if is_ours({ synth::object_class(cell) }) {
            synth::set_associated(cell, track_color_key(), 0 as *u8);
            synth::set_associated(cell, knob_color_key(), 0 as *u8);
        }
        return;
    }
    adopt_track_cell(cell);
    if track.is_set() {
        synth::retain_associated(cell, track_color_key(), paint::ns_color(track).raw());
    }
    if knob.is_set() {
        synth::retain_associated(cell, knob_color_key(), paint::ns_color(knob).raw());
    }
    { rt::msg_void_i8(v, rt::sel(#str_ptr("setNeedsDisplay:\0")), 1 as i8) };
    return;
}

// The knob and the bar share one subclass: a slider that colours its track and
// carries a thumb image is one cell, not two.
fn adopt_track_cell(cell: *u8) {
    let cls: *u8 = { synth::object_class(cell) };
    if is_ours(cls) { return; }
    let sub: *u8 = subclass_of(cls, "FacetTrack", flavour_track());
    if sub != cls { let _old: *u8 = { object_setClass(cell, sub) }; }
    return;
}

// ---- reordering a materialised sequence ---------------------------------------
// `CanReorderItems` is a DRAG, and macOS's answer to "reorder these" is a drag
// too — so unlike pull-to-refresh and swipe-to-reveal there is no idiom
// mismatch to route around. What there is instead is facet's own rule: an
// agent has no hands. It does not need them here, because an agent reorders by
// reordering the DATA and writing `count` — the drag is the user's path to the
// same place, and `on_reorder_completed` is how the application learns which
// one happened.
//
// The drag is tracked on the document view rather than through NSPasteboard.
// A pasteboard drag is for carrying something BETWEEN destinations; this never
// leaves the view it started in, and a drag session would mean a promise the
// contract does not make (that a row can be dropped somewhere else).

fn drag_from_key() -> *u8 { return { 29110 as *u8 }; }
fn drag_moved_key() -> *u8 { return { 29111 as *u8 }; }
fn drag_drop_key() -> *u8 { return { 29112 as *u8 }; }
fn drag_enabled_key() -> *u8 { return { 29113 as *u8 }; }

// An index is stored one-based so that 0 can mean "no drag": the associated
// slot is a pointer, and a null one is the only "unset" it has.
fn stored(i: i64) -> *u8 { return { (i + (1 as i64)) as *u8 }; }
fn restored(p: *u8) -> i64 { return { p as i64 } - (1 as i64); }

fn drag_start_imp(self_obj: *u8, cmd: *u8, event: *u8) {
    mouse_down_imp(self_obj, cmd, event);
    if { synth::get_associated(self_obj, drag_enabled_key()) } == (0 as *u8) { return; }
    let n: *core::Node = { synth::get_associated(self_obj, select_node_key()) as *core::Node };
    if n == (0 as *core::Node) { return; }
    let at: i64 = child_at_point(n, local_point(self_obj, event));
    if at < (0 as i64) { return; }
    synth::set_associated(self_obj, drag_from_key(), stored(at));
    synth::set_associated(self_obj, drag_moved_key(), 0 as *u8);
    return;
}

// The row follows the pointer. Its FRAME is the layout's, so this moves the
// VIEW only — the next layout pass puts it back, which is exactly right: the
// move is not real until the drop reorders the nodes.
fn drag_move_imp(self_obj: *u8, cmd: *u8, event: *u8) {
    let held: *u8 = { synth::get_associated(self_obj, drag_from_key()) };
    if held == (0 as *u8) { return; }
    let n: *core::Node = { synth::get_associated(self_obj, select_node_key()) as *core::Node };
    if n == (0 as *core::Node) { return; }
    synth::set_associated(self_obj, drag_moved_key(), 1 as *u8);
    let from: i64 = restored(held);
    match core::child_of(n, from as usize) {
        option::Option[*core::Node]::Some(c) => {
            let v: *u8 = core::view_of(c);
            if v == (0 as *u8) { return; }
            let p: rt::Point = local_point(self_obj, event);
            let f: rt::Rect = { rt::msg_rect(v, rt::sel(#str_ptr("frame\0"))) };
            { rt::msg_void_rect(v, rt::sel(#str_ptr("setFrame:\0")),
                                rt::Rect { x: f.x, y: p.y - (f.h / 2.0f64), w: f.w, h: f.h }) };
        }
        option::Option[*core::Node]::None => { }
    }
    return;
}

fn drag_drop_imp(self_obj: *u8, cmd: *u8, event: *u8) {
    let held: *u8 = { synth::get_associated(self_obj, drag_from_key()) };
    synth::set_associated(self_obj, drag_from_key(), 0 as *u8);
    if held == (0 as *u8) { return; }
    // A press that never moved is a CLICK, and the click already ran on the way
    // down. Reordering on it would move a row every time one was selected.
    if { synth::get_associated(self_obj, drag_moved_key()) } == (0 as *u8) { return; }
    let n: *core::Node = { synth::get_associated(self_obj, select_node_key()) as *core::Node };
    let h: fn(*u8, i64, i64) = { synth::get_associated(self_obj, drag_drop_key()) as fn(*u8, i64, i64) };
    if n == (0 as *core::Node) || { h } == (0 as fn(*u8, i64, i64)) { return; }
    let from: i64 = restored(held);
    let to: i64 = child_at_point(n, local_point(self_obj, event));
    h(self_obj, from, to);
    return;
}

fn local_point(view: *u8, event: *u8) -> rt::Point {
    let win: rt::Point = { rt::msg_point(event, rt::sel(#str_ptr("locationInWindow\0"))) };
    return { msg_point_point_id(view, rt::sel(#str_ptr("convertPoint:fromView:\0")),
                                win, 0 as *u8) };
}

fn install_row_reorder(doc: *u8, on: bool, h: fn(*u8, i64, i64)) {
    if doc == (0 as *u8) { return; }
    if !on {
        synth::set_associated(doc, drag_enabled_key(), 0 as *u8);
        return;
    }
    synth::set_associated(doc, drag_enabled_key(), 1 as *u8);
    synth::set_associated(doc, drag_drop_key(), { h as *u8 });
    return;
}

fn row_reorder_armed(doc: *u8) -> bool {
    return { synth::get_associated(doc, drag_enabled_key()) } != (0 as *u8);
}

// ---- a picker's kerning --------------------------------------------------------
// "NSDatePicker draws its own fields; no attributed value" is true of the
// CONTROL — its value is an NSDate — and the drawing goes through a cell, so
// the obvious move is the cell's own content hook. That was tried and MEASURED:
// NSDatePickerCell does not route through `drawInteriorWithFrame:inView:`, the
// same way NSPopUpButtonCell does not route through `drawingRectForBounds:`.
// Overriding `drawWithFrame:` instead would mean drawing the bezel and the
// stepper too, which is the whole control.
//
// So the kerned text is an OVERLAY, and the cell's own text is made
// transparent under it. That would break EDITING — a field you cannot see
// while typing in it — so the overlay stands down the moment the picker takes
// first responder and comes back when it gives it up. A kerned picker is a
// kerned picker at rest and an ordinary one under the cursor, which is the
// only reading that does not cost the control something.

fn kern_overlay_key() -> *u8 { return { 29114 as *u8 }; }
fn kern_color_key() -> *u8 { return { 29115 as *u8 }; }

fn flavour_kern() -> u32 { return 8 as u32; }

fn kern_overlay_of(v: *u8) -> *u8 { return { synth::get_associated(v, kern_overlay_key()) }; }

#[link_name = "class_addMethod"]
extern fn add_method_i8_0v(cls: *u8, sel: *u8, imp: fn(*u8, *u8) -> i8, types: *u8) -> i8;

fn super_bool(self_obj: *u8, cmd: *u8) -> i8 {
    let base: *u8 = { class_getSuperclass(synth::object_class(self_obj)) };
    if base == (0 as *u8) { return 0 as i8; }
    let imp: *u8 = { super_imp_of(base, cmd) };
    if imp == (0 as *u8) { return 0 as i8; }
    let f: fn(*u8, *u8) -> i8 = { imp as fn(*u8, *u8) -> i8 };
    return f(self_obj, cmd);
}

// Editing begins: the real text comes back and the overlay goes away.
fn kern_become_imp(self_obj: *u8, cmd: *u8) -> i8 {
    show_kern_overlay(self_obj, false);
    return super_bool(self_obj, cmd);
}

fn kern_resign_imp(self_obj: *u8, cmd: *u8) -> i8 {
    show_kern_overlay(self_obj, true);
    return super_bool(self_obj, cmd);
}

fn show_kern_overlay(v: *u8, on: bool) {
    let label: *u8 = kern_overlay_of(v);
    if label == (0 as *u8) { return; }
    { rt::msg_void_i8(label, rt::sel(#str_ptr("setHidden:\0")), (on == false) as i8) };
    let cell: *u8 = field_cell(v);
    if cell == (0 as *u8) { return; }
    if on {
        { rt::msg_void_id(cell, rt::sel(#str_ptr("setTextColor:\0")),
                          ak::Color::clear_color().raw()) };
    } else {
        let kept: *u8 = { synth::get_associated(v, kern_color_key()) };
        if kept != (0 as *u8) {
            { rt::msg_void_id(cell, rt::sel(#str_ptr("setTextColor:\0")), kept) };
        }
    }
    return;
}

fn apply_picker_kern(v: *u8, kern: f64, shown: str, font: option::Option[ak::Font],
                     ink: vocab::Color) {
    let existing: *u8 = kern_overlay_of(v);
    if kern == 0.0f64 {
        if existing != (0 as *u8) {
            show_kern_overlay(v, false);
            { rt::msg_void(existing, rt::sel(#str_ptr("removeFromSuperview\0"))) };
            synth::set_associated(v, kern_overlay_key(), 0 as *u8);
        }
        return;
    }
    var label: *u8 = existing;
    if label == (0 as *u8) {
        // The colour the cell had before it was made transparent, so editing
        // can have it back.
        let cell: *u8 = field_cell(v);
        if cell != (0 as *u8) {
            let had: *u8 = { rt::msg_id(cell, rt::sel(#str_ptr("textColor\0"))) };
            if had != (0 as *u8) { synth::retain_associated(v, kern_color_key(), had); }
        }
        let cls: *u8 = { synth::object_class(v) };
        if !is_ours(cls) {
            let sub: *u8 = subclass_of(cls, "FacetKern", flavour_kern());
            if sub != cls { let _old: *u8 = { object_setClass(v, sub) }; }
        }
        let f: ak::TextField = ak::TextField::label_with_string("");
        let lv: ak::View = f.as_view();
        // Width and height track the picker: WidthSizable (2) | HeightSizable (16).
        { rt::msg_void_u64(lv.raw(), rt::sel(#str_ptr("setAutoresizingMask:\0")), 18 as u64) };
        ak::View::from_raw(v).add_subview(lv);
        label = lv.raw();
        synth::set_associated(v, kern_overlay_key(), label);
    }
    let a: *u8 = paint::attributed(shown,
        paint::rich_attributes(font, ink, kern, 0.0f64,
                               option::Option[vocab::TextAlign]::None,
                               vocab::TextDecoration::None));
    if a != (0 as *u8) {
        { rt::msg_void_id(label, rt::sel(#str_ptr("setAttributedStringValue:\0")), a) };
        rt::release(a);
    }
    // The picker's own text inset, near enough: the bezel is 2pt and the field
    // starts just inside it.
    let box: rt::Rect = { rt::msg_rect(v, rt::sel(#str_ptr("bounds\0"))) };
    { rt::msg_void_rect(label, rt::sel(#str_ptr("setFrame:\0")),
                        rt::Rect { x: box.x + 3.0f64, y: box.y + 1.0f64,
                                   w: box.w - 6.0f64, h: box.h - 2.0f64 }) };
    show_kern_overlay(v, true);
    return;
}

// Is the kerned text the one on screen right now? False while the picker is
// being edited, which is the whole point of the overlay standing down.
fn kern_overlay_showing(v: *u8) -> bool {
    let label: *u8 = kern_overlay_of(v);
    if label == (0 as *u8) { return false; }
    return { rt::msg_i8(label, rt::sel(#str_ptr("isHidden\0"))) } == (0 as i8);
}

// ---- a switch facet draws -------------------------------------------------------
// `on_color` is a hue rotation over NSSwitch's own drawing and needs nothing
// here. `off_color` and `thumb_color` cannot be: the off track is grey and the
// thumb is white, and a hue rotation has nothing to rotate — which is the same
// fact that makes the other four tints correct.
//
// So a toggle that names either is DRAWN, and only then: one that names neither
// stays an NSSwitch with everything NSSwitch has. The drawn one is two layers
// and it keeps what a switch is for —
//
//   click and space toggle it, because both are wired here rather than
//   inherited; `state` / `setState:` answer, so every caller that speaks to a
//   toggle already keeps working; and the accessibility role and value are set
//   explicitly, because an unlabelled custom view is a switch a screen reader
//   cannot see.
//
// The thumb SLIDES rather than jumping: a switch that teleports reads as a
// checkbox, and the animation is the only part of NSSwitch that cannot be
// re-derived from its state.

fn switch_track_key() -> *u8 { return { 29118 as *u8 }; }
fn switch_thumb_key() -> *u8 { return { 29119 as *u8 }; }
fn switch_state_key() -> *u8 { return { 29120 as *u8 }; }
fn switch_action_key() -> *u8 { return { 29121 as *u8 }; }
fn switch_ctx_key() -> *u8 { return { 29122 as *u8 }; }
fn switch_colors_key() -> *u8 { return { 29123 as *u8 }; }

fn flavour_switch() -> u32 { return 9 as u32; }

fn switch_w() -> f64 { return 38.0f64; }
fn switch_h() -> f64 { return 22.0f64; }

fn drawn_switch_state(v: *u8) -> i64 {
    return { synth::get_associated(v, switch_state_key()) as i64 };
}

fn switch_set_state_imp(self_obj: *u8, cmd: *u8, on: i64) {
    synth::set_associated(self_obj, switch_state_key(), { on as *u8 });
    layout_switch(self_obj, true);
    return;
}

fn switch_state_imp(self_obj: *u8, cmd: *u8) -> i64 { return drawn_switch_state(self_obj); }

fn switch_toggle(self_obj: *u8) {
    var on: i64 = 1 as i64;
    if drawn_switch_state(self_obj) != (0 as i64) { on = 0 as i64; }
    synth::set_associated(self_obj, switch_state_key(), { on as *u8 });
    layout_switch(self_obj, true);
    let h: fn(*u8, *u8) = { synth::get_associated(self_obj, switch_action_key()) as fn(*u8, *u8) };
    if { h } == (0 as fn(*u8, *u8)) { return; }
    h(self_obj, { synth::get_associated(self_obj, switch_ctx_key()) });
    return;
}

fn switch_click_imp(self_obj: *u8, cmd: *u8, event: *u8) { switch_toggle(self_obj); return; }

fn switch_key_imp(self_obj: *u8, cmd: *u8, event: *u8) {
    // Space, the same key NSSwitch answers.
    let s: *u8 = { rt::msg_id(event, rt::sel(#str_ptr("charactersIgnoringModifiers\0"))) };
    if s == (0 as *u8) { return; }
    if bridge::to_text(s) == " " { switch_toggle(self_obj); }
    return;
}

fn switch_accepts_imp(self_obj: *u8, cmd: *u8) -> i8 { return 1 as i8; }

// The track and the thumb, from the state and whatever colours were named. A
// colour that was not named falls back to the system's, so a toggle that named
// only its thumb still looks like a switch.
fn layout_switch(v: *u8, animated: bool) {
    let track: *u8 = { synth::get_associated(v, switch_track_key()) };
    let thumb: *u8 = { synth::get_associated(v, switch_thumb_key()) };
    if track == (0 as *u8) || thumb == (0 as *u8) { return; }
    let on: bool = drawn_switch_state(v) != (0 as i64);
    let box: rt::Rect = { rt::msg_rect(v, rt::sel(#str_ptr("bounds\0"))) };
    var w: f64 = box.w;
    var h: f64 = box.h;
    if w <= 0.0f64 { w = switch_w(); }
    if h <= 0.0f64 { h = switch_h(); }
    let r: f64 = h / 2.0f64;
    { msg_void_rect_layer(track, rt::sel(#str_ptr("setFrame:\0")),
                          rt::Rect { x: 0.0f64, y: 0.0f64, w: w, h: h }) };
    { rt::msg_void_f64(track, rt::sel(#str_ptr("setCornerRadius:\0")), r) };
    let inset: f64 = 2.0f64;
    let d: f64 = h - inset - inset;
    var x: f64 = inset;
    if on { x = w - d - inset; }
    // The thumb SLIDES: a switch that teleports reads as a checkbox.
    if !animated { { rt::msg_void_id(rt::get_class(#str_ptr("CATransaction\0")),
                                     rt::sel(#str_ptr("begin\0")), 0 as *u8) }; }
    { msg_void_rect_layer(thumb, rt::sel(#str_ptr("setFrame:\0")),
                          rt::Rect { x: x, y: inset, w: d, h: d }) };
    { rt::msg_void_f64(thumb, rt::sel(#str_ptr("setCornerRadius:\0")), d / 2.0f64) };
    paint_switch(v, on);
    { rt::msg_void_i8(v, rt::sel(#str_ptr("setNeedsDisplay:\0")), 1 as i8) };
    return;
}

#[link_name = "objc_msgSend"]
extern fn msg_void_rect_layer(recv: *u8, sel: *u8, r: rt::Rect);

// The three colours, each falling back to the system's where it was not named.
struct SwitchColors { on: vocab::Color, off: vocab::Color, thumb: vocab::Color }

fn paint_switch(v: *u8, on: bool) {
    let raw: *u8 = { synth::get_associated(v, switch_colors_key()) };
    if raw == (0 as *u8) { return; }
    let c: *SwitchColors = raw as *SwitchColors;
    let track: *u8 = { synth::get_associated(v, switch_track_key()) };
    let thumb: *u8 = { synth::get_associated(v, switch_thumb_key()) };
    var fill: vocab::Color = { (*c).off };
    if on { fill = { (*c).on }; }
    if fill.is_set() {
        { rt::msg_void_id(track, rt::sel(#str_ptr("setBackgroundColor:\0")),
                          paint::ns_color(fill).c_g_color()) };
    } else {
        var system: ak::Color = ak::Color::control_color();
        if on { system = ak::Color::control_accent_color(); }
        { rt::msg_void_id(track, rt::sel(#str_ptr("setBackgroundColor:\0")), system.c_g_color()) };
    }
    var knob: vocab::Color = { (*c).thumb };
    if knob.is_set() {
        { rt::msg_void_id(thumb, rt::sel(#str_ptr("setBackgroundColor:\0")),
                          paint::ns_color(knob).c_g_color()) };
    } else {
        { rt::msg_void_id(thumb, rt::sel(#str_ptr("setBackgroundColor:\0")),
                          ak::Color::white_color().c_g_color()) };
    }
    return;
}

fn drawn_switch_class() -> *u8 {
    let existing: *u8 = rt::get_class(#str_ptr("FacetSwitch\0"));
    if existing != (0 as *u8) { return existing; }
    let cls: *u8 = synth::allocate_class_pair(rt::get_class(#str_ptr("NSView\0")),
                                              #str_ptr("FacetSwitch\0"), 0 as usize);
    synth::add_method_v_1id(cls, rt::sel(#str_ptr("mouseDown:\0")), switch_click_imp, #str_ptr("v@:@\0"));
    synth::add_method_v_1id(cls, rt::sel(#str_ptr("keyDown:\0")), switch_key_imp, #str_ptr("v@:@\0"));
    add_method_i8_0v(cls, rt::sel(#str_ptr("acceptsFirstResponder\0")), switch_accepts_imp,
                     #str_ptr("c@:\0"));
    add_method_i64_0v(cls, rt::sel(#str_ptr("state\0")), switch_state_imp, #str_ptr("q@:\0"));
    add_method_v_i64(cls, rt::sel(#str_ptr("setState:\0")), switch_set_state_imp, #str_ptr("v@:q\0"));
    synth::register_class_pair(cls);
    return cls;
}

#[link_name = "class_addMethod"]
extern fn add_method_i64_0v(cls: *u8, sel: *u8, imp: fn(*u8, *u8) -> i64, types: *u8) -> i8;
#[link_name = "class_addMethod"]
extern fn add_method_v_i64(cls: *u8, sel: *u8, imp: fn(*u8, *u8, i64), types: *u8) -> i8;

// A toggle that names an achromatic colour is drawn; one that does not keeps
// NSSwitch and everything NSSwitch has. `wants_drawn` is asked of the PROPS, so
// the decision is the application's rather than the backend's.
fn wants_drawn_switch(off: vocab::Color, thumb: vocab::Color) -> bool {
    return off.is_set() || thumb.is_set();
}

fn new_drawn_switch() -> *u8 {
    let alloced: *u8 = { rt::msg_id(drawn_switch_class(), rt::sel(#str_ptr("alloc\0"))) };
    let v: *u8 = { rt::msg_id_rect(alloced, rt::sel(#str_ptr("initWithFrame:\0")),
                                   rt::Rect { x: 0.0f64, y: 0.0f64, w: switch_w(), h: switch_h() }) };
    if v == (0 as *u8) { return 0 as *u8; }
    let view: ak::View = ak::View::from_raw(v);
    view.set_wants_layer(true);
    let track: *u8 = { rt::msg_id(rt::get_class(#str_ptr("CALayer\0")), rt::sel(#str_ptr("layer\0"))) };
    let thumb: *u8 = { rt::msg_id(rt::get_class(#str_ptr("CALayer\0")), rt::sel(#str_ptr("layer\0"))) };
    if track == (0 as *u8) || thumb == (0 as *u8) { return v; }
    view.layer().add_sublayer(quartz::Layer::from_raw(track));
    view.layer().add_sublayer(quartz::Layer::from_raw(thumb));
    synth::set_associated(v, switch_track_key(), track);
    synth::set_associated(v, switch_thumb_key(), thumb);
    // A screen reader has to be able to see it: an unlabelled custom view is a
    // switch nobody but a sighted mouse user can use.
    { rt::msg_void_id(v, rt::sel(#str_ptr("setAccessibilityRole:\0")),
                      bridge::nsstring("AXCheckBox")) };
    { rt::msg_void_i8(v, rt::sel(#str_ptr("setAccessibilityElement:\0")), 1 as i8) };
    return v;
}

fn apply_drawn_switch(v: *u8, on: bool, colors: *SwitchColors,
                      h: fn(*u8, *u8), ctx: *u8) {
    synth::set_associated(v, switch_colors_key(), colors as *u8);
    synth::set_associated(v, switch_action_key(), { h as *u8 });
    synth::set_associated(v, switch_ctx_key(), ctx);
    var state: i64 = 0 as i64;
    if on { state = 1 as i64; }
    synth::set_associated(v, switch_state_key(), { state as *u8 });
    layout_switch(v, false);
    return;
}

// ---- a swipe that actually reveals ----------------------------------------------
// The swipe items are already a MENU, which is the click path an agent needs and
// the reason the band was implementable at all. Two verbs stayed out of it and
// both describe a CONTINUOUS motion, which a click does not have:
//
//   reveal_threshold        how far the content must travel to stay open
//   observe_swipe_changing  where it is while it travels
//
// A trackpad has that motion. So the content slides with a horizontal drag, the
// action strip behind it comes into view, and the two verbs mean what they say.
// The menu is untouched: an agent still clicks, and a user gets both.
//
// The strip is built from the same `swipe_item` children the menu is, so a
// button and a menu row are the same description read twice — there is no
// second place to add an action.

fn swipe_strip_key() -> *u8 { return { 29125 as *u8 }; }
fn swipe_offset_key() -> *u8 { return { 29126 as *u8 }; }
fn swipe_start_key() -> *u8 { return { 29127 as *u8 }; }
fn swipe_hooks_key() -> *u8 { return { 29128 as *u8 }; }
fn swipe_open_key() -> *u8 { return { 29129 as *u8 }; }

fn flavour_swipe() -> u32 { return 10 as u32; }

// What the swipeable's own module supplies: the threshold to beat, and the two
// edges plus the running report.
struct SwipeHooks {
    threshold: f64,
    changing: fn(*u8, *u8),
    opaque changing_ctx: *u8,
    started: fn(*u8, *u8),
    opaque started_ctx: *u8,
    ended: fn(*u8, *u8),
    opaque ended_ctx: *u8,
    opened: fn(*u8, *u8),
    opaque opened_ctx: *u8,
    closed: fn(*u8, *u8),
    opaque closed_ctx: *u8,
}

fn swipe_strip_of(v: *u8) -> *u8 { return { synth::get_associated(v, swipe_strip_key()) }; }

fn swipe_hooks_of(v: *u8) -> *SwipeHooks {
    return { synth::get_associated(v, swipe_hooks_key()) as *SwipeHooks };
}

fn swipe_offset_of(v: *u8) -> f64 {
    return { synth::get_associated(v, swipe_offset_key()) as i64 } as f64;
}

fn swipe_is_open(v: *u8) -> bool {
    return { synth::get_associated(v, swipe_open_key()) } != (0 as *u8);
}

fn fire_swipe(h: fn(*u8, *u8), ctx: *u8, v: *u8) {
    if { h } == (0 as fn(*u8, *u8)) { return; }
    h(v, ctx);
    return;
}

// The content is every subview except the strip, moved as one: a swipeable's
// children are its content and the strip is the backend's.
fn slide_content(v: *u8, dx: f64) {
    let strip: *u8 = { synth::get_associated(v, swipe_strip_key()) };
    let subs: vec::Vec[ak::View] = ak::View::from_raw(v).subviews();
    var i: usize = 0 as usize;
    while i < subs.count() {
        match subs.at_ptr(i) {
            option::Option[*ak::View]::Some(c) => {
                let raw: *u8 = { (*c).raw() };
                if raw != strip {
                    let f: rt::Rect = { rt::msg_rect(raw, rt::sel(#str_ptr("frame\0"))) };
                    { rt::msg_void_rect(raw, rt::sel(#str_ptr("setFrame:\0")),
                                        rt::Rect { x: dx, y: f.y, w: f.w, h: f.h }) };
                }
            }
            option::Option[*ak::View]::None => { }
        }
        i = i +% (1 as usize);
    }
    synth::set_associated(v, swipe_offset_key(), { (dx as i64) as *u8 });
    return;
}

fn swipe_down_imp(self_obj: *u8, cmd: *u8, event: *u8) {
    let p: rt::Point = local_point(self_obj, event);
    synth::set_associated(self_obj, swipe_start_key(), { (p.x as i64 + (1 as i64)) as *u8 });
    return;
}

fn swipe_drag_imp(self_obj: *u8, cmd: *u8, event: *u8) {
    let held: *u8 = { synth::get_associated(self_obj, swipe_start_key()) };
    if held == (0 as *u8) { return; }
    let h: *SwipeHooks = swipe_hooks_of(self_obj);
    if h == (0 as *SwipeHooks) { return; }
    let from: f64 = ({ held as i64 } - (1 as i64)) as f64;
    let now: rt::Point = local_point(self_obj, event);
    // A swipe REVEALS, so it travels one way: dragging right past the closed
    // position is not a gesture this control has.
    var dx: f64 = now.x - from;
    if dx > 0.0f64 { dx = 0.0f64; }
    if swipe_offset_of(self_obj) == 0.0f64 && dx != 0.0f64 {
        fire_swipe({ (*h).started }, { (*h).started_ctx }, self_obj);
    }
    slide_content(self_obj, dx);
    fire_swipe({ (*h).changing }, { (*h).changing_ctx }, self_obj);
    return;
}

fn swipe_up_imp(self_obj: *u8, cmd: *u8, event: *u8) {
    let held: *u8 = { synth::get_associated(self_obj, swipe_start_key()) };
    synth::set_associated(self_obj, swipe_start_key(), 0 as *u8);
    if held == (0 as *u8) { return; }
    let h: *SwipeHooks = swipe_hooks_of(self_obj);
    if h == (0 as *SwipeHooks) { return; }
    let travelled: f64 = 0.0f64 - swipe_offset_of(self_obj);
    if travelled == 0.0f64 { return; }
    fire_swipe({ (*h).ended }, { (*h).ended_ctx }, self_obj);
    // THE THRESHOLD. Past it the reveal stays; short of it the content springs
    // back — which is the whole of what `reveal_threshold` names.
    var bar: f64 = { (*h).threshold };
    if bar <= 0.0f64 { bar = strip_width_of(self_obj) / 2.0f64; }
    if travelled >= bar {
        slide_content(self_obj, 0.0f64 - strip_width_of(self_obj));
        synth::set_associated(self_obj, swipe_open_key(), 1 as *u8);
        fire_swipe({ (*h).opened }, { (*h).opened_ctx }, self_obj);
    } else {
        slide_content(self_obj, 0.0f64);
        synth::set_associated(self_obj, swipe_open_key(), 0 as *u8);
        fire_swipe({ (*h).closed }, { (*h).closed_ctx }, self_obj);
    }
    return;
}

fn strip_width_of(v: *u8) -> f64 {
    let strip: *u8 = { synth::get_associated(v, swipe_strip_key()) };
    if strip == (0 as *u8) { return 0.0f64; }
    let f: rt::Rect = { rt::msg_rect(strip, rt::sel(#str_ptr("frame\0"))) };
    return f.w;
}

fn swipe_action_width() -> f64 { return 88.0f64; }

// The strip the reveal uncovers, behind the content and pinned to the trailing
// edge. Built from the same children the menu is built from.
fn install_swipe_strip(v: *u8, count: usize, h: *SwipeHooks) -> *u8 {
    var strip: *u8 = { synth::get_associated(v, swipe_strip_key()) };
    if strip == (0 as *u8) {
        let box: rt::Rect = { rt::msg_rect(v, rt::sel(#str_ptr("bounds\0"))) };
        let s: ak::View = akx::new_flipped_view(
            rt::Rect { x: 0.0f64, y: 0.0f64, w: 0.0f64, h: box.h });
        // MinXMargin (1) | HeightSizable (16): the trailing edge, full height.
        { rt::msg_void_u64(s.raw(), rt::sel(#str_ptr("setAutoresizingMask:\0")), 17 as u64) };
        // BEHIND the content, which is what makes sliding the content reveal it.
        // `relativeTo` nil means below EVERYTHING, which is where a strip that
        // is uncovered has to be.
        ak::View::from_raw(v).add_subview_positioned(s, ak::WindowOrderingMode::NSWindowBelow,
                                                     ak::View::from_raw(0 as *u8));
        strip = s.raw();
        synth::set_associated(v, swipe_strip_key(), strip);
        let cls: *u8 = { synth::object_class(v) };
        if !is_ours(cls) {
            let sub: *u8 = subclass_of(cls, "FacetSwipe", flavour_swipe());
            if sub != cls { let _old: *u8 = { object_setClass(v, sub) }; }
        }
    }
    synth::set_associated(v, swipe_hooks_key(), h as *u8);
    let box: rt::Rect = { rt::msg_rect(v, rt::sel(#str_ptr("bounds\0"))) };
    let w: f64 = swipe_action_width() * (count as f64);
    { rt::msg_void_rect(strip, rt::sel(#str_ptr("setFrame:\0")),
                        rt::Rect { x: box.w - w, y: 0.0f64, w: w, h: box.h }) };
    return strip;
}

// One button per swipe item, from the SAME description the menu row came from.
fn add_swipe_action(strip: *u8, at: usize, title: str, destructive: bool,
                    h: fn(*u8, *u8), ctx: *u8) {
    let b: ak::Button = ak::Button::from_raw(rt::alloc_init(#str_ptr("NSButton\0")));
    b.set_button_type(ak::ButtonType::MomentaryPushIn);
    b.set_bezel_style(ak::BezelStyle::TexturedSquare);
    b.set_title(title);
    if destructive {
        let a: *u8 = paint::attributed(title,
            paint::rich_attributes(option::Option[ak::Font]::None,
                                   vocab::Color::rgba(0.8f64, 0.1f64, 0.1f64), 0.0f64, 0.0f64,
                                   option::Option[vocab::TextAlign]::None,
                                   vocab::TextDecoration::None));
        if a != (0 as *u8) {
            { rt::msg_void_id(b.raw(), rt::sel(#str_ptr("setAttributedTitle:\0")), a) };
            rt::release(a);
        }
    }
    let bv: ak::View = b.as_view();
    let box: rt::Rect = { rt::msg_rect(strip, rt::sel(#str_ptr("bounds\0"))) };
    bv.set_frame(rt::Rect { x: swipe_action_width() * (at as f64), y: 0.0f64,
                            w: swipe_action_width(), h: box.h });
    akx::set_control_action_ctx(b.as_control(), h, ctx);
    ak::View::from_raw(strip).add_subview(bv);
    return;
}

fn clear_swipe_strip(strip: *u8) {
    let subs: vec::Vec[ak::View] = ak::View::from_raw(strip).subviews();
    var i: usize = 0 as usize;
    while i < subs.count() {
        match subs.at_ptr(i) {
            option::Option[*ak::View]::Some(b) => {
                { rt::msg_void({ (*b).raw() }, rt::sel(#str_ptr("removeFromSuperview\0"))) };
            }
            option::Option[*ak::View]::None => { }
        }
        i = i +% (1 as usize);
    }
    return;
}
