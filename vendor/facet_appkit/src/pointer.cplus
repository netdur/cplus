// facet_appkit pointer — the press band a CONTROL owns, not the gesture band.
//
// Three kinds declare pointer verbs of their own: `button` and `icon_button`
// (`on_pressed` / `on_released`) and `canvas`, which declares the whole
// interaction set the ledger's GraphicsView has — press, release, hover, unhover,
// move, drag, cancel. None of them fired.
//
// ---- why this is not the gesture band -----------------------------------------
//
// `gestures.cplus` answers `.gesture(on_press:)` on ANY node, and `input.cplus`
// delivers it. These are different: they are the CONTROL's own verbs, declared
// by the control's module, and an application that writes
// `button("Save", on_pressed: ...)` never touched the gesture band.
//
// They share a delivery path anyway, because there is only one: input arrives
// on a view, and `input.cplus` already owns the runtime subclass that receives
// it. So this file is the per-kind DISPATCH and input.cplus is the transport —
// `input::arm` is what puts the methods on the class, and it now arms a node
// that wants either band.
//
// ---- what a canvas hover costs ------------------------------------------------
//
// Hover and move need a tracking area, which costs a mouse-moved event per
// node per frame across the window. `input::arm_tracking` already gates that on
// the gesture band asking for hover; a canvas that declares `on_hover` or
// `observe_move_hover_interaction` is the same request, so it is asked the same
// question rather than given a tracking area unconditionally.

import "facet/facet" as core;
import "facet/props" as props;
import "facet/button" as button;
import "facet/icon_button" as icon_button;
import "facet/canvas" as canvas;

// What a press means for each kind, read out of the props at fire time.
// Returns true when a handler ran, which is what `input.cplus` needs to decide
// whether the event was TAKEN or should fall through to AppKit.

// Asked of the NODE, not the kind: a canvas that declares no interaction verb
// should not pay for a runtime subclass, and arming it would change its class
// out from under `drawing`, which owns that class and asserts it.
fn wants_press_band(n: *core::Node) -> bool {
    let d: *core::Data = core::node_data(n);
    if d.is_null() { return false; }
    let raw: *u8 = { (*d).props };
    if raw.is_null() { return false; }
    let kind: u32 = { (*d).kind };
    if kind == props::K_BUTTON {
        let p: *props::ButtonProps = raw as *props::ButtonProps;
        return { (*p).on_pressed } != props::no_handler
            || { (*p).on_released } != props::no_handler;
    }
    if kind == props::K_ICON_BUTTON {
        let p: *props::IconButtonProps = raw as *props::IconButtonProps;
        return { (*p).on_pressed } != props::no_handler
            || { (*p).on_released } != props::no_handler;
    }
    if kind == props::K_CANVAS {
        let p: *props::CanvasProps = raw as *props::CanvasProps;
        return { (*p).on_press } != props::no_handler
            || { (*p).on_release } != props::no_handler
            || { (*p).on_cancel } != props::no_handler
            || { (*p).observe_drag_interaction } != props::no_handler
            || wants_tracking(n);
    }
    return false;
}

// Whether this node's own verbs ask for hover tracking. Same question the
// gesture band is asked, so a canvas that never hovers pays nothing.
fn wants_tracking(n: *core::Node) -> bool {
    let d: *core::Data = core::node_data(n);
    if d.is_null() { return false; }
    if { (*d).kind } != props::K_CANVAS { return false; }
    let p: *props::CanvasProps = { (*d).props } as *props::CanvasProps;
    if p.is_null() { return false; }
    return { (*p).on_hover } != props::no_handler
        || { (*p).on_unhover } != props::no_handler
        || { (*p).observe_move_hover_interaction } != props::no_handler;
}

fn fire(h: fn(*u8, *u8), ctx: *u8, sender: *u8) -> bool {
    if h == props::no_handler { return false; }
    h(sender, ctx);
    return true;
}

fn canvas_props(n: *core::Node) -> *props::CanvasProps {
    let d: *core::Data = core::node_data(n);
    if d.is_null() { return 0 as *props::CanvasProps; }
    if { (*d).kind } != props::K_CANVAS { return 0 as *props::CanvasProps; }
    return { (*d).props } as *props::CanvasProps;
}

fn press(n: *core::Node, sender: *u8) -> bool {
    let d: *core::Data = core::node_data(n);
    if d.is_null() { return false; }
    let raw: *u8 = { (*d).props };
    if raw.is_null() { return false; }
    let kind: u32 = { (*d).kind };
    if kind == props::K_BUTTON {
        let p: *props::ButtonProps = raw as *props::ButtonProps;
        return fire({ (*p).on_pressed }, { (*p).on_pressed_ctx }, sender);
    }
    if kind == props::K_ICON_BUTTON {
        let p: *props::IconButtonProps = raw as *props::IconButtonProps;
        return fire({ (*p).on_pressed }, { (*p).on_pressed_ctx }, sender);
    }
    if kind == props::K_CANVAS {
        let p: *props::CanvasProps = raw as *props::CanvasProps;
        return fire({ (*p).on_press }, { (*p).on_press_ctx }, sender);
    }
    return false;
}

fn release(n: *core::Node, sender: *u8) -> bool {
    let d: *core::Data = core::node_data(n);
    if d.is_null() { return false; }
    let raw: *u8 = { (*d).props };
    if raw.is_null() { return false; }
    let kind: u32 = { (*d).kind };
    if kind == props::K_BUTTON {
        let p: *props::ButtonProps = raw as *props::ButtonProps;
        return fire({ (*p).on_released }, { (*p).on_released_ctx }, sender);
    }
    if kind == props::K_ICON_BUTTON {
        let p: *props::IconButtonProps = raw as *props::IconButtonProps;
        return fire({ (*p).on_released }, { (*p).on_released_ctx }, sender);
    }
    if kind == props::K_CANVAS {
        let p: *props::CanvasProps = raw as *props::CanvasProps;
        return fire({ (*p).on_release }, { (*p).on_release_ctx }, sender);
    }
    return false;
}

// The canvas-only half. A button has no hover or drag verb of its own — the ledger
// does not give it one — so these answer for the canvas and false elsewhere.

fn hover(n: *core::Node, sender: *u8) -> bool {
    let p: *props::CanvasProps = canvas_props(n);
    if p.is_null() { return false; }
    return fire({ (*p).on_hover }, { (*p).on_hover_ctx }, sender);
}

fn unhover(n: *core::Node, sender: *u8) -> bool {
    let p: *props::CanvasProps = canvas_props(n);
    if p.is_null() { return false; }
    return fire({ (*p).on_unhover }, { (*p).on_unhover_ctx }, sender);
}

fn moved(n: *core::Node, sender: *u8) -> bool {
    let p: *props::CanvasProps = canvas_props(n);
    if p.is_null() { return false; }
    return fire({ (*p).observe_move_hover_interaction },
                { (*p).observe_move_hover_interaction_ctx }, sender);
}

fn dragged(n: *core::Node, sender: *u8) -> bool {
    let p: *props::CanvasProps = canvas_props(n);
    if p.is_null() { return false; }
    return fire({ (*p).observe_drag_interaction },
                { (*p).observe_drag_interaction_ctx }, sender);
}

// `CancelInteraction`: the press was abandoned rather than completed. AppKit
// says that by ending the tracking outside the view, which is the same
// `mouseExited:` a hover ends on — so a canvas that is being pressed when the
// pointer leaves gets a cancel, and one that is merely hovered gets an unhover.
fn cancelled(n: *core::Node, sender: *u8) -> bool {
    let p: *props::CanvasProps = canvas_props(n);
    if p.is_null() { return false; }
    return fire({ (*p).on_cancel }, { (*p).on_cancel_ctx }, sender);
}
