// facet_appkit dialogs — the three modal verbs facet declares.
//
// `alert`, `choose_directory` and `choose_file` are blocking by nature: each
// is a native modal, and the app's own loop is suspended while it is up. That
// is the platform's model, not a facet choice, and it is why these are plain
// blocking calls rather than anything asynchronous.
//
// Ported from the pre-regen backend; bodies unchanged except the module
// qualification.

import "stdlib/option" as option;
import "stdlib/text" as text;
import "flex_layout/flex_layout" as flex;
import "facet/facet" as core;
import "facet/vocabulary" as vocab;
import "facet/application" as app;
import "facet/label" as label;
import "facet/button" as button;
import "facet/text_field" as text_field;
import "stdlib/vec" as vec;

import "facet/mount" as mount;
import "stdlib/box" as box;
import "objc/synthesis" as synth;
import "appkit/appkit_ext" as akx;
import "./geometry" as geometry;
import "objc/runtime" as rt;
import "objc/bridge" as bridge;
import "appkit/appkit" as ak;

// A blocking modal alert. Returns the 0-based index of the clicked button
// (0 = `primary`, 1 = `secondary`) — AppKit numbers its responses from 1000,
// which is a platform detail no application should see.
fn alert(title: str, message: str, primary: str, secondary: str = "") -> i32 {
    let a: ak::Alert = ak::Alert::from_raw(rt::alloc_init(#str_ptr("NSAlert\0")));
    a.set_message_text(title);
    a.set_informative_text(message);
    let _b0: ak::Button = a.add_button_with_title(primary);
    if secondary != "" { let _b1: ak::Button = a.add_button_with_title(secondary); }
    let resp: i64 = a.run_modal();
    return (resp -% (1000 as i64)) as i32;
}

// NSModalResponseOK.
fn modal_ok() -> i64 { return 1 as i64; }

fn panel_path(panel: ak::OpenPanel) -> option::Option[text::Text] {
    match panel.as_save_panel().u_r_l() {
        option::Option[ak::URL]::Some(u) => {
            let ns: *u8 = { rt::msg_id(u.raw(), rt::sel(#str_ptr("path\0"))) };
            if ns == (0 as *u8) { return option::Option[text::Text]::None; }
            return option::some(bridge::to_text(ns));
        }
        option::Option[ak::URL]::None => { return option::Option[text::Text]::None; }
    }
    return option::Option[text::Text]::None;
}

// The chosen absolute path, or None when the user cancelled.
fn choose_directory() -> option::Option[text::Text] {
    let panel = ak::OpenPanel::open_panel();
    panel.set_can_choose_directories(true);
    panel.set_can_choose_files(false);
    panel.set_allows_multiple_selection(false);
    panel.as_save_panel().set_can_create_directories(true);
    if panel.as_save_panel().run_modal() != modal_ok() { return option::Option[text::Text]::None; }
    return panel_path(panel);
}

fn choose_file() -> option::Option[text::Text] {
    let panel = ak::OpenPanel::open_panel();
    panel.set_can_choose_files(true);
    panel.set_can_choose_directories(false);
    panel.set_allows_multiple_selection(false);
    if panel.as_save_panel().run_modal() != modal_ok() { return option::Option[text::Text]::None; }
    return panel_path(panel);
}

// ---- window verbs a custom titlebar drives -----------------------------------
// `window_buttons()` renders the platform's own group, but an app drawing its
// OWN controls under Bar::Custom wires them to these: each takes the handler's
// opaque `sender` and drives the window enclosing it. Inert when the sender is
// not in a window, which is the no-op convention everywhere else in facet.

fn window_of_sender(sender: *u8) -> option::Option[ak::Window] {
    if sender == (0 as *u8) { return option::Option[ak::Window]::None; }
    return ak::View::from_raw(sender).window();
}

fn window_close(sender: *u8) {
    match window_of_sender(sender) {
        option::Option[ak::Window]::Some(w) => { w.close(); }
        option::Option[ak::Window]::None => { }
    }
    return;
}

fn window_minimize(sender: *u8) {
    match window_of_sender(sender) {
        option::Option[ak::Window]::Some(w) => { w.miniaturize(0 as *u8); }
        option::Option[ak::Window]::None => { }
    }
    return;
}

fn window_zoom(sender: *u8) {
    match window_of_sender(sender) {
        option::Option[ak::Window]::Some(w) => { w.zoom(0 as *u8); }
        option::Option[ak::Window]::None => { }
    }
    return;
}

// ---- window frame ------------------------------------------------------------
// In the platform's screen coordinates (bottom-left origin on macOS). Read it
// to persist per-project window placement — something the platform's own
// one-frame-per-name autosave cannot do — and hand the same rect back
// unchanged. AppKit clamps a frame that would land off every screen, so a
// frame saved on a monitor that is no longer attached cannot strand a window.

// A zero rect when the root is not an open window — the neutral answer, never
// a trap.
fn window_frame_of(root: *core::Node) -> vocab::Rect {
    let win: *u8 = app::window_native(root);
    if win == (0 as *u8) { return vocab::Rect::zero(); }
    let f: rt::Rect = ak::Window::from_raw(win).frame();
    return vocab::Rect { x: f.x, y: f.y, width: f.w, height: f.h };
}

fn set_window_frame_of(root: *core::Node, frame: vocab::Rect) {
    let win: *u8 = app::window_native(root);
    if win == (0 as *u8) { return; }
    ak::Window::from_raw(win).set_frame_display(
        rt::Rect { x: frame.x, y: frame.y, w: frame.width, h: frame.height },
        true,
        false,
    );
    return;
}

// ---- alert: a window-modal SHEET, non-blocking -------------------------------
//
// The old one was an NSAlert and `runModal`, which is two problems at once. It
// BLOCKS — the caller does not return until the user answers — and it is not
// facet's, so nothing in it has a key, which means AN AGENT CANNOT REACH IT.
// A dialog an agent cannot answer is a dialog an agent cannot get past.
//
// So the sheet is an ordinary facet tree in an ordinary window, attached to its
// parent with `beginSheet:`. Every part of it is addressable the way every
// other part of a facet app is:
//
//   alert:title     alert:message     alert:primary     alert:secondary
//
// Non-blocking: `alert` returns immediately and the answer arrives on the
// callback. That is the whole reason for the change — a blocking call cannot be
// driven over MCP, because the agent's own request is what would have to return
// first.
//
// Window-modal, not application-modal: the sheet blocks ITS PARENT, which is
// what an alert means to a person, while the rest of the app and the agent
// channel keep running.

struct AlertHost {
    opaque root: *core::Node,
    opaque sheet: *u8,
    opaque parent: *u8,
    answer: fn(i32, *u8),
    // The prompt's second answer: the text that was typed. A separate slot
    // rather than a wider `answer`, so an alert and a choose keep the signature
    // they have and only a prompt pays for the string.
    typed: fn(str, *u8),
    // ONE CONTEXT PER HANDLER. `typed` used to read `answer_ctx` — right only
    // while both answers come from the same object, and the shared slot also
    // meant only one of the two could ever be a bound method.
    opaque answer_ctx: *u8,
    opaque typed_ctx: *u8,
}

fn alert_host_key() -> *u8 { return { 29040 as *u8 }; }

fn host_of(sender: *u8) -> *AlertHost {
    // The sender is a button inside the sheet; the host is pinned to the WINDOW.
    let w: *u8 = { rt::msg_id(sender, rt::sel(#str_ptr("window\0"))) };
    if w == (0 as *u8) { return 0 as *AlertHost; }
    return { synth::get_associated(w, alert_host_key()) as *AlertHost };
}

fn alert_primary(sender: *u8, ctx: *u8) { dismiss(host_of(sender), 0 as i32); return; }
fn alert_secondary(sender: *u8, ctx: *u8) { dismiss(host_of(sender), 1 as i32); return; }

// A CHOICE AMONG N, which `alert` could not say. The index rides the ctx slot
// rather than needing one named handler per button — `on_click` already carries
// a ctx, and an index is exactly the kind of small fact it is for.
fn choose_pick(sender: *u8, ctx: *u8) {
    dismiss(host_of(sender), { #addr(ctx) } as i32);
    return;
}

// The prompt's OK reads the field BEFORE dismissing, because `dismiss` unmounts
// the tree — the text would be gone by the time an answer handler ran.
fn prompt_ok(sender: *u8, ctx: *u8) {
    let h: *AlertHost = host_of(sender);
    if h == (0 as *AlertHost) { return; }
    // END EDITING FIRST, and this is the difference between the sheet working
    // and the sheet throwing your typing away.
    //
    // An NSTextField does not hold the text you are typing — the window's
    // shared FIELD EDITOR does — and `stringValue` is only refreshed from it
    // when editing ENDS. Clicking a button ends editing on the way, because
    // the click moves first responder. RETURN DOES NOT: it arrives through
    // `performKeyEquivalent:`, which fires the button before anything touches
    // the responder chain, so the read below saw the value the sheet OPENED
    // with. A rename kept the old name; a New File got an empty one.
    //
    // `endEditingFor: nil` is AppKit's own commit, and it is what every native
    // dialog does before reading a field.
    { rt::msg_void_id({ (*h).sheet }, rt::sel(#str_ptr("endEditingFor:\0")), 0 as *u8) };
    match text_field::find("prompt:value") {
        option::Option[text_field::TextField]::Some(f) => {
            let typed: str = f.text();
            let g: fn(str, *u8) = { (*h).typed };
            if g != (0 as fn(str, *u8)) { g(typed, { (*h).typed_ctx }); }
        }
        option::Option[text_field::TextField]::None => { }
    }
    dismiss(h, 0 as i32);
    return;
}

fn prompt_cancel(sender: *u8, ctx: *u8) { dismiss(host_of(sender), 1 as i32); return; }

fn dismiss(h: *AlertHost, answer: i32) {
    if h == (0 as *AlertHost) { return; }
    let sheet: *u8 = { (*h).sheet };
    let parent: *u8 = { (*h).parent };
    if parent != (0 as *u8) && sheet != (0 as *u8) {
        { rt::msg_void_id(parent, rt::sel(#str_ptr("endSheet:\0")), sheet) };
    }
    if sheet != (0 as *u8) { { rt::msg_void(sheet, rt::sel(#str_ptr("close\0"))) }; }
    // The answer goes out BEFORE the tree is dropped, so a handler can still
    // read anything it wants out of the sheet.
    // Back to the window underneath, before the answer runs — a handler that
    // navigates should find the surface already pointing at the real screen.
    app::agent_attach(parent);
    let f: fn(i32, *u8) = { (*h).answer };
    if f != (0 as fn(i32, *u8)) { f(answer, { (*h).answer_ctx }); }
    let root: *core::Node = { (*h).root };
    if root != (0 as *core::Node) {
        mount::unmount(root);
        let _gone: box::Box[core::Node] = box::from_raw::[core::Node](root as *u8);
    }
    let _h: box::Box[AlertHost] = box::from_raw::[AlertHost](h as *u8);
    return;
}

// The sheet's own tree. Plain facet — nothing here is special, which is the
// point: an agent walks it like any other screen.
// ---- how tall a sheet has to be ---------------------------------------------
//
// THE BUG THIS FIXES. Every sheet took a fixed height — `alert` a flat 140,
// `choose` 110 + 34 per option — computed as though the message were one line,
// and the message label carried no `line_break`, so it CLIPPED rather than
// wrapped. A three-line message therefore appeared as three lines each ending in
// "…", and on `choose` the last button was cut off by the bottom edge: the
// caller could see neither what it was agreeing to nor the option to decline.
//
// Measured rather than guessed would be better and needs a text-measurement hop
// this file does not have. This estimate is deliberately generous — too tall is
// a little empty space, too short is unreadable text and an unreachable button,
// and those are not the same mistake.
//
// 380pt wide less 20pt padding a side leaves 340; at 13pt the average glyph runs
// about 6.4pt, so ~53 characters to a line. Explicit newlines count as breaks of
// their own, because a caller that wrote a paragraph break meant one.
fn message_lines(message: str) -> f64 {
    if message == "" { return 0.0f64; }
    let per_line: usize = 53 as usize;
    var total: f64 = 0.0f64;
    // The owner is bound before the split: a view into a temporary would dangle
    // at the end of the statement (E0513).
    let owner: text::Text = text::from_str(message);
    let segments: vec::Vec[str] = owner.split("\n");
    var i: usize = 0 as usize;
    while i < segments.count() {
        match segments.at_ptr(i) {
            option::Option[*str]::Some(sp) => {
                let n: usize = #str_len({ (*sp) });
                var lines: usize = n / per_line;
                if n % per_line != (0 as usize) { lines = lines +% (1 as usize); }
                if lines == (0 as usize) { lines = 1 as usize; }   // a blank line is still a line
                total = total + (lines as f64);
            }
            option::Option[*str]::None => { }
        }
        i = i +% (1 as usize);
    }
    return total;
}

// The vertical space a message needs, gap included. 17pt a line at 13pt text.
fn message_height(message: str) -> f64 {
    if message == "" { return 0.0f64; }
    return 12.0f64 + (message_lines(message) * 17.0f64);
}

// A sheet taller than the screen is worse than a clipped one — it cannot be
// dismissed. Callers with more to say than this should use a screen, not a
// sheet.
fn capped(h: f64) -> f64 {
    if h > 560.0f64 { return 560.0f64; }
    return h;
}

fn alert_tree(title: str, message: str, primary: str, secondary: str) -> core::Node {
    var b: core::Builder = core::Builder::new();
    b.add(label::label(title, key: "alert:title", font_size: 15.0f64,
                       font_weight: vocab::FontWeight::Bold,
                       text_align: vocab::TextAlign::Start));
    if message != "" {
        // WRAP, do not clip. Without these two the label renders one line and
        // ends it in "…", which is how a sheet came to hide the sentence it
        // existed to show.
        b.add(label::label(message, key: "alert:message", font_size: 13.0f64,
                           line_break: vocab::LineBreak::WordWrap,
                           max_lines: 0 as i64,
                           text_align: vocab::TextAlign::Start));
    }
    var row: core::Builder = core::Builder::new();
    if secondary != "" {
        row.add(button::button(secondary, key: "alert:secondary", on_click: alert_secondary));
    }
    row.add(button::button(primary, key: "alert:primary", on_click: alert_primary));
    b.add(core::row(row, key: "alert:buttons").gap(8.0f64).justify(flex::Justify::FlexEnd));
    return core::column(b, key: "alert").padding(20.0f64).gap(12.0f64);
}

fn choose_tree(title: str, message: str, take options: vec::Vec[text::Text]) -> core::Node {
    var b: core::Builder = core::Builder::new();
    b.add(label::label(title, key: "choose:title", font_size: 15.0f64,
                       font_weight: vocab::FontWeight::Bold,
                       text_align: vocab::TextAlign::Start));
    if message != "" {
        // WRAP, do not clip. Without these two the label renders one line and
        // ends it in "…", which is how a sheet came to hide the sentence it
        // existed to show.
        b.add(label::label(message, key: "choose:message", font_size: 13.0f64,
                           line_break: vocab::LineBreak::WordWrap,
                           max_lines: 0 as i64,
                           text_align: vocab::TextAlign::Start));
    }
    // One button per option, stacked: a row of six buttons is unreadable and a
    // sheet has the height. Keyed by INDEX so an agent can name the one it
    // wants — `choose:opt:2` is addressable where "the third button" is not.
    var col: core::Builder = core::Builder::new();
    var i: usize = 0 as usize;
    while i < options.count() {
        match options.at_ptr(i) {
            option::Option[*text::Text]::Some(t) => {
                let k: text::Text = "choose:opt:${i}";
                col.add(button::button({ (*t).view() }, key: { k.view() },
                                       on_click: choose_pick, on_click_ctx: i as *u8));
            }
            option::Option[*text::Text]::None => { }
        }
        i = i +% (1 as usize);
    }
    b.add(core::column(col, key: "choose:options").gap(6.0f64));
    return core::column(b, key: "choose").padding(20.0f64).gap(12.0f64);
}

fn prompt_tree(title: str, message: str, placeholder: str, primary: str, secondary: str,
               initial: str) -> core::Node {
    var b: core::Builder = core::Builder::new();
    b.add(label::label(title, key: "prompt:title", font_size: 15.0f64,
                       font_weight: vocab::FontWeight::Bold,
                       text_align: vocab::TextAlign::Start));
    if message != "" {
        // WRAP, do not clip. Without these two the label renders one line and
        // ends it in "…", which is how a sheet came to hide the sentence it
        // existed to show.
        b.add(label::label(message, key: "prompt:message", font_size: 13.0f64,
                           line_break: vocab::LineBreak::WordWrap,
                           max_lines: 0 as i64,
                           text_align: vocab::TextAlign::Start));
    }
    // A real facet text_field, which is what makes the prompt agent-drivable:
    // `set_text` reaches it by key like any other field.
    //
    // `initial` IS THE LEDGER'S `initialValue`, and it is not the placeholder.
    // One is the hint shown while the field is EMPTY; the other is what the
    // field starts with and what a person then edits. Only the hint had
    // survived into facet's signature, so a Rename opened on nothing and the
    // old name was greyed out behind the caret — every rename meant typing the
    // whole name again. An application can reach in and `set_text` the field
    // afterwards, and one did; that is a caller supplying a parameter the
    // dialog should take.
    b.add(text_field::text_field(initial, key: "prompt:value", placeholder: placeholder));
    var row: core::Builder = core::Builder::new();
    if secondary != "" {
        row.add(button::button(secondary, key: "prompt:cancel", on_click: prompt_cancel));
    }
    row.add(button::button(primary, key: "prompt:ok", on_click: prompt_ok));
    b.add(core::row(row, key: "prompt:buttons").gap(8.0f64).justify(flex::Justify::FlexEnd));
    return core::column(b, key: "prompt").padding(20.0f64).gap(12.0f64);
}

fn no_typed(v: str, ctx: *u8) { return; }

// `alert`, `choose` and `prompt` differ only in the TREE and its height, so the
// sheet itself is one body. Three copies of the window plumbing was how the
// second one would have started drifting from the first.
fn alert_sheet(title: str, message: str, primary: str, secondary: str = "",
               on_answer: fn(i32, *u8) = 0 as fn(i32, *u8),
               on_answer_ctx: *u8 = 0 as *u8) {
    // Title, buttons and padding, plus however many lines the message runs to.
    present_sheet(alert_tree(title, message, primary, secondary),
                  capped(116.0f64 + message_height(message)),
                  on_answer, on_answer_ctx, no_typed, 0 as *u8,
                  default_key: "alert:primary", cancel_key: "alert:secondary");
    return;
}


fn choose_sheet(title: str, message: str, take options: vec::Vec[text::Text],
                on_answer: fn(i32, *u8) = 0 as fn(i32, *u8),
                on_answer_ctx: *u8 = 0 as *u8) {
    // Tall enough for the buttons it actually has AND the message it actually
    // carries. The second half was missing, so a two-line message pushed the
    // last option off the bottom edge — on a sheet whose last option is
    // typically the one that says no.
    let n: f64 = options.count() as f64;
    // NO DEFAULT ON A CHOOSE, deliberately. Its buttons are N options and none
    // of them is "the obvious one" — making Return pick the first would act on
    // the user's behalf without being asked. Escape has no button to bind to
    // either: a choose sheet carries no cancel, its options ARE the answer.
    present_sheet(choose_tree(title, message, options),
                  capped(78.0f64 + (n * 34.0f64) + message_height(message)),
                  on_answer, on_answer_ctx, no_typed, 0 as *u8);
    return;
}

fn prompt_sheet(title: str, message: str, placeholder: str, primary: str,
                secondary: str = "",
                on_typed: fn(str, *u8) = no_typed, on_typed_ctx: *u8 = 0 as *u8,
                on_answer: fn(i32, *u8) = 0 as fn(i32, *u8),
                on_answer_ctx: *u8 = 0 as *u8,
                // LAST, so no caller that passes positionally moves — the
                // whole reason `item:` was appended rather than inserted.
                initial: str = "") {
    present_sheet(prompt_tree(title, message, placeholder, primary, secondary, initial),
                  capped(151.0f64 + message_height(message)),
                  on_answer, on_answer_ctx, on_typed, on_typed_ctx,
                  default_key: "prompt:ok", cancel_key: "prompt:cancel");
    return;
}

// ---- Return and Escape -------------------------------------------------------
//
// A NATIVE ALERT GIVES THESE AWAY FREE and a facet sheet has to supply them.
// AppKit makes a button the window's DEFAULT by its key equivalent — `"\r"` for
// Return, `"\033"` for Escape — and that is also what draws the default button
// accented. facet builds its sheets out of facet controls, which is what makes
// them keyed and agent-drivable, and the cost is that everything the platform
// alert did for free has to be said here.
//
// It was not said. Typing a name into a prompt and pressing Return did nothing;
// Escape did nothing; the only way out of any sheet was the mouse, immediately
// after typing, which is the most common keyboard reflex there is.
//
// SET ON THE VIEW, not through a facet prop. A default button is a property of
// the SHEET rather than of `button` — the ledger gives `KeyboardAccelerators` to
// a menu item and not to a button, and inventing a shortcut row on every button
// to serve three dialogs would be facet growing vocabulary for its own internals.
// These trees are this file's own, so this file wires them.
//
// RETURN WORKS WHILE THE FIELD HAS FOCUS, which is the case that matters: a
// window's default button fires on Return regardless of first responder, so long
// as the responder does not consume the key. An NSTextField does not.
fn set_key_equivalent(root: *core::Node, key: str, equiv: str) {
    match mount::find(key, within: root) {
        option::Option[*core::Node]::Some(n) => {
            let v: *u8 = core::view_of(n);
            if v == (0 as *u8) { return; }
            if synth::class_responds(synth::object_class(v),
                                     rt::sel(#str_ptr("setKeyEquivalent:\0"))) == (0 as i8) {
                return;
            }
            { rt::msg_void_id(v, rt::sel(#str_ptr("setKeyEquivalent:\0")),
                              bridge::nsstring(equiv)) };
        }
        option::Option[*core::Node]::None => { }
    }
    return;
}

// Return, and Escape. Called for every sheet with the keys that sheet uses;
// a key that is not in this tree is simply not found, so one call site serves
// all three shapes.
fn arm_default_buttons(root: *core::Node, default_key: str, cancel_key: str) {
    if default_key != "" { set_key_equivalent(root, default_key, "\r"); }
    // ESCAPE, as the byte AppKit compares against — `\x1b`, which C's `\033`
    // spells in octal. A button carrying it takes the window's cancel role and
    // answers ⌘. for free with it.
    if cancel_key != "" { set_key_equivalent(root, cancel_key, "\x1b"); }
    return;
}

fn present_sheet(take tree: core::Node, height: f64,
                 on_answer: fn(i32, *u8), on_answer_ctx: *u8,
                 on_typed: fn(str, *u8), on_typed_ctx: *u8,
                 default_key: str = "", cancel_key: str = "") {
    let parent: *u8 = app::window_native(app::newest_window_root());
    var root: core::Node = tree;

    // A titleless panel: a sheet draws no titlebar of its own, and one would
    // sit above the parent's.
    let sheet: *u8 = { rt::msg_id(rt::get_class(#str_ptr("NSWindow\0")),
                                  rt::sel(#str_ptr("alloc\0"))) };
    let w: *u8 = { msg_id_rect_u64_u64_i8(sheet,
        rt::sel(#str_ptr("initWithContentRect:styleMask:backing:defer:\0")),
        rt::Rect { x: 0.0f64, y: 0.0f64, w: 380.0f64, h: height },
        1 as u64,        // NSWindowStyleMaskTitled — a sheet needs one to size
        2 as u64,        // NSBackingStoreBuffered
        0 as i8) };
    if w == (0 as *u8) { return; }
    let content: ak::View = akx::new_flipped_view(
        rt::Rect { x: 0.0f64, y: 0.0f64, w: 380.0f64, h: height });
    { rt::msg_void_id(w, rt::sel(#str_ptr("setContentView:\0")), content.raw()) };

    let rp: *core::Node = match box::new::[core::Node](root) {
        option::Option[box::Box[core::Node]]::Some(b) => { b.into_raw() } as *core::Node,
        option::Option[box::Box[core::Node]]::None => 0 as *core::Node,
    };
    if rp == (0 as *core::Node) { return; }
    // A real mount: the sheet is a window of the app, so `find` reaches it and
    // so does the agent surface.
    let _m: bool = mount::mount(rp);
    app::set_window_native(rp, w);
    let rv: *u8 = core::view_of(rp);
    if rv != (0 as *u8) { content.add_subview(ak::View::from_raw(rv)); }
    { (*rp).calculate_layout(width: 380.0f64, height: height) };
    geometry::reposition(rp);
    // THE ROOT'S OWN VIEW. `reposition` deliberately does not touch it — the
    // window facade sizes it when it makes the content view — and a sheet has no
    // such facade, so it stayed 0x0 with every control laid out inside a rect of
    // no size. They still DREW, because a view does not clip by default; nothing
    // could be CLICKED, because `hitTest:` answers nil for a point outside the
    // receiver's bounds and never descends to a child. Every button in every
    // sheet this presents — alert, choose, prompt — was dead to the mouse, and
    // only an agent's `performClick:` (which skips hit testing) could answer one.
    if rv != (0 as *u8) {
        { rt::msg_void_rect(rv, rt::sel(#str_ptr("setFrame:\0")),
                            rt::Rect { x: 0.0f64, y: 0.0f64, w: 380.0f64, h: height }) };
    }

    // After the mount, because the buttons need their views to exist.
    arm_default_buttons(rp, default_key, cancel_key);

    match box::new::[AlertHost](AlertHost {
        root: rp, sheet: w, parent: parent,
        answer: on_answer, typed: on_typed,
        answer_ctx: on_answer_ctx, typed_ctx: on_typed_ctx,
    }) {
        option::Option[box::Box[AlertHost]]::Some(hb) => {
            let hp: *AlertHost = { hb.into_raw() } as *AlertHost;
            synth::set_associated(w, alert_host_key(), hp as *u8);
        }
        option::Option[box::Box[AlertHost]]::None => { return; }
    }

    if parent != (0 as *u8) {
        // TWO arguments, and the second is explicitly nil. This was sent with
        // the one-argument shim, so the completion-handler slot was whatever
        // happened to be in the register — AppKit calling it would have
        // jumped into nothing. Nil is a valid handler and means "tell me
        // nothing", which is right here: the alert reports through its own
        // buttons, not through the sheet's completion.
        { rt::msg_void_id_id(parent, rt::sel(#str_ptr("beginSheet:completionHandler:\0")),
                             w, 0 as *u8) };
    } else {
        // No parent window to attach to: show it as an ordinary window rather
        // than refusing. An alert with nowhere to hang is still an alert.
        { rt::msg_void_id(w, rt::sel(#str_ptr("makeKeyAndOrderFront:\0")), 0 as *u8) };
    }
    // The agent follows the window in front of the user, and while a
    // window-modal sheet is up that IS the sheet — its buttons are the only
    // thing anyone, person or agent, can act on. The surface is walked when a
    // window opens through the runtime; a sheet is built here, so it says so
    // itself. `dismiss` hands the parent back.
    app::agent_attach(w);
    return;
}

#[link_name = "objc_msgSend"]
extern fn msg_id_rect_u64_u64_i8(recv: *u8, sel: *u8, r: rt::Rect, a: u64, b: u64,
                                 c: i8) -> *u8;
