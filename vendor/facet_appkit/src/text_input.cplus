// facet_appkit text_input — what the three text controls tell the application.
//
// `text_field`, `text_area` and `search_field` all embed `InputViewProps`, and
// all three had the same hole: nothing was wired back. A user typed, AppKit
// updated its own view, and facet never heard. Two consequences, and the
// second is the bad one:
//
//   `on_text_changed` never fired — visible, and a reader might notice.
//   `field.text()` answered the props, and the props still said whatever the
//   application last SET. So an app that read a field after the user typed in
//   it got the old string back, silently and with no error anywhere.
//
// The contract is clear about which of those is the truth: `text()` reads the
// props (`text_field.cplus`), so the props ARE the answer and the backend's
// job is to keep them true. That is what this file does — the native control
// is where editing happens, so every edit is written back into the props
// before the handler runs, and a handler that asks `text()` gets what the
// user typed.
//
// ---- why a delegate and not the action ---------------------------------------
//
// NSTextField's target/action fires on Enter and on focus loss, not on each
// keystroke, so it cannot carry `on_text_changed`. `controlTextDidChange:`
// can, and NSTextView's own `textDidChange:` is the same notification for the
// editor half. Both hand back a notification whose `object` is the thing that
// changed, so ONE imp serves both and the dispatch is on the node's kind.
//
// `on_submit` splits the other way, because the platforms disagree about what
// completing an edit means:
//
//   text_field / search_field   Enter — the control's own action (Entry
//                               .Completed and SearchBar.SearchButtonPressed
//                               are both "the user pressed return")
//   text_area                   focus loss — Enter inserts a newline in a
//                               multi-line editor, so there is no other
//                               moment to mean it (Editor.Completed)
//
// Which is why `did_end_imp` fires submit for the AREA only: a field would
// otherwise submit twice, once from its action and once from end-of-editing.
//
// ---- lifetime ----------------------------------------------------------------
//
// One delegate per view, pinned to the view with `retain_associated`, exactly
// as `web.cplus` pins its navigation delegate. It lives as long as the view
// and dies with it. The node rides on the delegate as an associated pointer,
// and the HANDLER is read from the props at fire time rather than captured —
// so an application that swaps a handler after mount is answered by the new
// one without the delegate being touched.

import "stdlib/option" as option;
import "stdlib/text" as text;
import "facet/facet" as core;
import "facet/props" as props;
import "facet/vocabulary" as vocab;
import "facet/text_field" as text_field;
import "facet/text_area" as text_area;
import "facet/search_field" as search_field;
import "facet/split" as split;
import "objc/runtime" as rt;
import "objc/bridge" as bridge;
import "objc/synthesis" as synth;
import "appkit/appkit" as ak;
import "appkit/appkit_ext" as akx;
import "./paint" as paint;

// ---- associated keys ---------------------------------------------------------
// facet_appkit owns 29000 and up, in one block per file:
//
//   drawing 29000   input 29010   web 29020   recycler 29030   dialogs 29040
//   text_input 29050   scrolling 29060   bordered stroke 29070   compose 29080
//
// NOT 28xxx, which is where `cpc-bindgen` allocates the generated binding's own
// delegate keys from — appkit.cplus is already at 28733 and grows with the SDK.
// An associated key is per-object, so an overlap is silent until the day one
// lands on the same object twice; `keys_are_distinct` is the gate, and the
// range is what keeps the gate from having to be re-won on every regen.

fn node_key() -> *u8 { return { 29050 as *u8 }; }
fn delegate_pin_key() -> *u8 { return { 29051 as *u8 }; }

fn node_of(obj: *u8) -> *core::Node {
    if obj == (0 as *u8) { return 0 as *core::Node; }
    return { synth::get_associated(obj, node_key()) as *core::Node };
}

// Cut a view's delegate loose from its node, before the view comes down.
//
// The delegate reads the node at FIRE time rather than capturing anything,
// which is what lets a swapped handler need no re-install — and it is also why
// a notification arriving during teardown reaches a node that is still very
// much alive and writes into it.
//
// That is not hypothetical. `views::reclass` replaces a field with one of the
// other class, and pulling the old field out of the hierarchy ends its editing
// session: AppKit sends `controlTextDidEndEditing`, the write-back runs, and it
// wrote the DYING object's value over the props the replacement was about to be
// configured from. A field flipped to "show password" while it was focused came
// back empty.
//
// So the node association is cleared and the delegate unhooked. A late
// notification then finds no node and does nothing, which is the same promise
// `web::detach` makes in `view_release` for the same reason.
fn detach(view: *u8, target: *u8) {
    if view == (0 as *u8) { return; }
    let d: *u8 = { synth::get_associated(view, delegate_pin_key()) };
    if d != (0 as *u8) { synth::set_associated(d, node_key(), 0 as *u8); }
    if target != (0 as *u8) {
        { rt::msg_void_id(target, rt::sel(#str_ptr("setDelegate:\0")), 0 as *u8) };
    }
    return;
}

// ---- reaching the shared band ------------------------------------------------
// The three controls embed `InputViewProps` at a different offset each, so the
// pointer is taken through the owning struct rather than by casting the props
// pointer — which would be right for exactly one of the three.

fn input_props_of(n: *core::Node) -> *props::InputViewProps {
    let d: *core::Data = core::node_data(n);
    if d == (0 as *core::Data) { return 0 as *props::InputViewProps; }
    let kind: u32 = { (*d).kind };
    let raw: *u8 = { (*d).props };
    if raw == (0 as *u8) { return 0 as *props::InputViewProps; }
    if kind == props::K_TEXT_FIELD {
        let p: *props::TextFieldProps = raw as *props::TextFieldProps;
        return { #addr_of((*p).input_view) };
    }
    if kind == props::K_TEXT_AREA {
        let p: *props::TextAreaProps = raw as *props::TextAreaProps;
        return { #addr_of((*p).input_view) };
    }
    if kind == props::K_SEARCH_FIELD {
        let p: *props::SearchFieldProps = raw as *props::SearchFieldProps;
        return { #addr_of((*p).input_view) };
    }
    return 0 as *props::InputViewProps;
}

// `on_submit` is the owning control's own verb, not the shared band's, so it
// is read per kind. A node that is not one of the three answers `no_handler`,
// which `fire` treats as nothing to do.
fn submit_handler(n: *core::Node) -> fn(*u8, *u8) {
    let d: *core::Data = core::node_data(n);
    if d == (0 as *core::Data) { return props::no_handler; }
    let raw: *u8 = { (*d).props };
    if raw == (0 as *u8) { return props::no_handler; }
    let kind: u32 = { (*d).kind };
    if kind == props::K_TEXT_FIELD { return { (*(raw as *props::TextFieldProps)).on_submit }; }
    if kind == props::K_TEXT_AREA { return { (*(raw as *props::TextAreaProps)).on_submit }; }
    if kind == props::K_SEARCH_FIELD { return { (*(raw as *props::SearchFieldProps)).on_submit }; }
    return props::no_handler;
}

fn submit_ctx(n: *core::Node) -> *u8 {
    let d: *core::Data = core::node_data(n);
    if d == (0 as *core::Data) { return 0 as *u8; }
    let raw: *u8 = { (*d).props };
    if raw == (0 as *u8) { return 0 as *u8; }
    let kind: u32 = { (*d).kind };
    if kind == props::K_TEXT_FIELD { return { (*(raw as *props::TextFieldProps)).on_submit_ctx }; }
    if kind == props::K_TEXT_AREA { return { (*(raw as *props::TextAreaProps)).on_submit_ctx }; }
    if kind == props::K_SEARCH_FIELD { return { (*(raw as *props::SearchFieldProps)).on_submit_ctx }; }
    return 0 as *u8;
}

fn is_editor(n: *core::Node) -> bool { return core::kind_of(n) == props::K_TEXT_AREA; }

fn fire(h: fn(*u8, *u8), ctx: *u8, sender: *u8) {
    if h == props::no_handler { return; }
    h(sender, ctx);
    return;
}

// ---- native truth -> props ---------------------------------------------------

// What the native side currently holds. An editor answers as NSText; a field
// answers through NSControl, whose `stringValue` is live while editing because
// the field editor writes through to the cell.
fn native_text(n: *core::Node, obj: *u8) -> text::Text {
    if is_editor(n) { return ak::Text::from_raw(obj).string(); }
    return ak::Control::from_raw(obj).string_value();
}

// The selection, in the same coordinates `cursor_position` / `selection_length`
// are declared in. A field has no selection of its own — the field editor owns
// it, and there is one only while the field has focus, so an unfocused field
// keeps whatever the props last said rather than being reset to zero.
fn native_selection(n: *core::Node, obj: *u8) -> option::Option[rt::Range] {
    if is_editor(n) { return option::some(ak::Text::from_raw(obj).selected_range()); }
    match ak::Control::from_raw(obj).current_editor() {
        option::Option[ak::Text]::Some(ed) => { return option::some(ed.selected_range()); }
        option::Option[ak::Text]::None => { return option::Option[rt::Range]::None; }
    }
    return option::Option[rt::Range]::None;
}

// Write what the user did into the props. Deliberately WITHOUT `core::touch`:
// the native view is already showing this, so raising the dirty bit would only
// schedule a write of the string back into the control the user is typing in.
// The props are being made to agree with the screen, not the other way round.
fn sync_from_native(n: *core::Node, obj: *u8) {
    let iv: *props::InputViewProps = input_props_of(n);
    if iv == (0 as *props::InputViewProps) { return; }
    { (*iv).text = text::from_str(native_text(n, obj).view()) };
    match native_selection(n, obj) {
        option::Option[rt::Range]::Some(r) => {
            { (*iv).cursor_position = { r.location } as i64 };
            { (*iv).selection_length = { r.length } as i64 };
        }
        option::Option[rt::Range]::None => { }
    }
    return;
}

// ---- the delegate ------------------------------------------------------------

// `controlTextDidChange:` and `textDidChange:` are the same event with two
// names, and both carry the changed object as the notification's `object`, so
// one imp answers both.
fn did_change_imp(self_obj: *u8, cmd: *u8, notification: *u8) {
    let n: *core::Node = node_of(self_obj);
    if n == (0 as *core::Node) { return; }
    let obj: *u8 = { rt::msg_id(notification, rt::sel(#str_ptr("object\0"))) };
    if obj == (0 as *u8) { return; }
    let iv: *props::InputViewProps = input_props_of(n);
    if iv == (0 as *props::InputViewProps) { return; }
    // The limit is enforced BEFORE the props are synced, so what the
    // application reads is what the control ended up holding — never the
    // over-long string that existed for one instant in between.
    let _cut: bool = enforce_max_length(n, obj, iv);
    sync_from_native(n, obj);
    fire({ (*iv).on_text_changed }, { (*iv).on_text_changed_ctx }, obj);
    return;
}

// A field's field editor is created when editing begins and is SHARED with
// every other field in the window, so anything set on it has to be set again
// here — see `apply_editor_state`.
fn did_begin_imp(self_obj: *u8, cmd: *u8, notification: *u8) {
    let n: *core::Node = node_of(self_obj);
    if n == (0 as *core::Node) { return; }
    if is_editor(n) { return; }
    let iv: *props::InputViewProps = input_props_of(n);
    if iv == (0 as *props::InputViewProps) { return; }
    let obj: *u8 = { rt::msg_id(notification, rt::sel(#str_ptr("object\0"))) };
    if obj == (0 as *u8) { return; }
    apply_editor_state(ak::TextField::from_raw(obj), n, iv);
    apply_selection(ak::TextField::from_raw(obj), iv);
    return;
}

// End of editing. Submit belongs to the EDITOR here and nowhere else — see the
// header: a field's submit is its action, and firing both would fire twice.
fn did_end_imp(self_obj: *u8, cmd: *u8, notification: *u8) {
    let n: *core::Node = node_of(self_obj);
    if n == (0 as *core::Node) { return; }
    let obj: *u8 = { rt::msg_id(notification, rt::sel(#str_ptr("object\0"))) };
    if obj == (0 as *u8) { return; }
    sync_from_native(n, obj);
    if is_editor(n) == false { return; }
    fire(submit_handler(n), submit_ctx(n), obj);
    return;
}

fn delegate_class() -> *u8 {
    let existing: *u8 = rt::get_class(#str_ptr("FacetTextDelegate\0"));
    if existing != (0 as *u8) { return existing; }
    let cls: *u8 = synth::allocate_class_pair(rt::get_class(#str_ptr("NSObject\0")),
                                              #str_ptr("FacetTextDelegate\0"), 0 as usize);
    synth::add_method_v_1id(cls, rt::sel(#str_ptr("controlTextDidChange:\0")),
                            did_change_imp, #str_ptr("v@:@\0"));
    synth::add_method_v_1id(cls, rt::sel(#str_ptr("textDidChange:\0")),
                            did_change_imp, #str_ptr("v@:@\0"));
    synth::add_method_v_1id(cls, rt::sel(#str_ptr("controlTextDidBeginEditing:\0")),
                            did_begin_imp, #str_ptr("v@:@\0"));
    synth::add_method_v_1id(cls, rt::sel(#str_ptr("controlTextDidEndEditing:\0")),
                            did_end_imp, #str_ptr("v@:@\0"));
    synth::add_method_v_1id(cls, rt::sel(#str_ptr("textDidEndEditing:\0")),
                            did_end_imp, #str_ptr("v@:@\0"));
    synth::register_class_pair(cls);
    return cls;
}

// The control's action, which is what Enter reaches on a field. It syncs
// first for the same reason the change hook does: a handler that asks
// `text()` must get what is on screen.
fn submit_imp(sender: *u8, ctx: *u8) {
    let n: *core::Node = ctx as *core::Node;
    if n == (0 as *core::Node) { return; }
    sync_from_native(n, sender);
    let iv: *props::InputViewProps = input_props_of(n);
    if iv != (0 as *props::InputViewProps) {
        fire({ (*iv).on_text_changed }, { (*iv).on_text_changed_ctx }, sender);
    }
    fire(submit_handler(n), submit_ctx(n), sender);
    advance_on_return(n, sender);
    return;
}

// ---- the return key ----------------------------------------------------------
// `ReturnType` names the LABEL on a soft keyboard's return key, and the ledger
// stopped there because macOS has no soft keyboard. The label is not the whole
// of it: one of the six names a BEHAVIOUR, and it is the one an application
// cannot get any other way.
//
//   Next    move to the next field. That is what "Next" means on a keyboard
//           that has it, and `selectNextKeyView:` is the same move on a Mac.
//   the     submit, which is what Return already does — the handler has fired
//   rest    by the time this runs, and the label they differ by has nowhere
//           to be drawn.
//
// So five of the six are still the label and stay recorded; the sixth acts.
fn return_key_of(n: *core::Node) -> vocab::ReturnKey {
    let d: *core::Data = core::node_data(n);
    if d == (0 as *core::Data) { return vocab::ReturnKey::Default; }
    let raw: *u8 = { (*d).props };
    if raw == (0 as *u8) { return vocab::ReturnKey::Default; }
    if { (*d).kind } == props::K_TEXT_FIELD {
        return { (*(raw as *props::TextFieldProps)).return_key };
    }
    if { (*d).kind } == props::K_SEARCH_FIELD {
        return { (*(raw as *props::SearchFieldProps)).return_key };
    }
    return vocab::ReturnKey::Default;
}

fn advance_on_return(n: *core::Node, sender: *u8) {
    let wants: bool = match return_key_of(n) {
        vocab::ReturnKey::Next => true,
        vocab::ReturnKey::Default => false,
        vocab::ReturnKey::Done => false,
        vocab::ReturnKey::Go => false,
        vocab::ReturnKey::Search => false,
        vocab::ReturnKey::Send => false,
    };
    if !wants { return; }
    let win: *u8 = { rt::msg_id(sender, rt::sel(#str_ptr("window\0"))) };
    if win == (0 as *u8) { return; }
    // The field's OWN next key view when it has one, which is the field the
    // application put after it. `selectNextKeyView:` is the fallback and it
    // walks the window's key loop instead — the same move, one level less
    // specific, and the only one available when nothing was named.
    let next: *u8 = { rt::msg_id(sender, rt::sel(#str_ptr("nextKeyView\0"))) };
    if next != (0 as *u8) {
        let _ok: i8 = { rt::msg_i8_id(win, rt::sel(#str_ptr("makeFirstResponder:\0")), next) };
        return;
    }
    { rt::msg_void_id(win, rt::sel(#str_ptr("selectNextKeyView:\0")), sender) };
    return;
}

// ---- the keyboard ------------------------------------------------------------
// `Keyboard` picks the on-screen layout, and macOS has no on-screen keyboard —
// which is true and is not all MAUI's Keyboard carries. A Keyboard is a layout
// AND a set of FLAGS: `Keyboard.Chat` spell-checks and suggests, `Keyboard.Plain`
// does neither, and the four typed ones (Email, Url, Telephone, Numeric) turn
// correction off because correcting an address is worse than not.
//
// The layout has no home here. The flags have exactly one — the field editor,
// which is where `checks_spelling` and `predicts_text` already go, and which is
// SHARED by every field in the window, so all three are set together when this
// field begins editing.
struct KeyboardFlags { spelling: bool, suggestions: bool, correction: bool }

fn keyboard_flags(k: vocab::Keyboard) -> KeyboardFlags {
    return match k {
        // Chat is prose: everything on.
        vocab::Keyboard::Chat => KeyboardFlags { spelling: true, suggestions: true, correction: true },
        vocab::Keyboard::Text => KeyboardFlags { spelling: true, suggestions: true, correction: true },
        // Plain is deliberately bare — the one that says "leave my typing alone".
        vocab::Keyboard::Plain => KeyboardFlags { spelling: false, suggestions: false, correction: false },
        // A typed field: correcting an address or a number is worse than not.
        vocab::Keyboard::Email => KeyboardFlags { spelling: false, suggestions: false, correction: false },
        vocab::Keyboard::Url => KeyboardFlags { spelling: false, suggestions: false, correction: false },
        vocab::Keyboard::Telephone => KeyboardFlags { spelling: false, suggestions: false, correction: false },
        vocab::Keyboard::Numeric => KeyboardFlags { spelling: false, suggestions: false, correction: false },
        // Default defers to the control's own `checks_spelling` / `predicts_text`.
        vocab::Keyboard::Default => KeyboardFlags { spelling: true, suggestions: true, correction: true },
    };
}

fn defers_to_control(k: vocab::Keyboard) -> bool {
    return match k {
        vocab::Keyboard::Default => true,
        vocab::Keyboard::Chat => false,
        vocab::Keyboard::Text => false,
        vocab::Keyboard::Plain => false,
        vocab::Keyboard::Email => false,
        vocab::Keyboard::Url => false,
        vocab::Keyboard::Telephone => false,
        vocab::Keyboard::Numeric => false,
    };
}

// The three switches, from the keyboard AND the two verbs that name them
// directly. A named keyboard is the stronger statement — an application that
// said `Keyboard.Plain` meant it — so it wins where it is not Default.
fn apply_editor_flags(ed: *u8, iv: *props::InputViewProps) {
    let k: vocab::Keyboard = { (*iv).keyboard };
    var spelling: bool = { (*iv).checks_spelling };
    var suggestions: bool = { (*iv).predicts_text };
    var correction: bool = { (*iv).predicts_text };
    if !defers_to_control(k) {
        let f: KeyboardFlags = keyboard_flags(k);
        spelling = f.spelling;
        suggestions = f.suggestions;
        correction = f.correction;
    }
    { rt::msg_void_i8(ed, rt::sel(#str_ptr("setContinuousSpellCheckingEnabled:\0")), spelling as i8) };
    { rt::msg_void_i8(ed, rt::sel(#str_ptr("setAutomaticTextCompletionEnabled:\0")), suggestions as i8) };
    { rt::msg_void_i8(ed, rt::sel(#str_ptr("setAutomaticSpellingCorrectionEnabled:\0")), correction as i8) };
    return;
}

// ---- installation ------------------------------------------------------------

// Called once per view from `create_*`. Attaching at CREATE rather than on
// `C_HANDLERS` is deliberate: the delegate reads the handler out of the props
// every time it fires, so a swapped handler needs no re-install, and there is
// exactly one delegate per view for its whole life.
//
// `target` is the object that sends the notifications — the NSTextView for an
// editor, the field itself otherwise — which is not always the view the node
// is backed by (a text_area's view is its enclosing NSScrollView).
fn install(view: *u8, target: *u8, n: *core::Node) {
    if target == (0 as *u8) { return; }
    let d: *u8 = synth::alloc_init_class(delegate_class());
    if d == (0 as *u8) { return; }
    synth::set_associated(d, node_key(), n as *u8);
    synth::retain_associated(view, delegate_pin_key(), d);
    { rt::msg_void_id(target, rt::sel(#str_ptr("setDelegate:\0")), d) };
    rt::release(d);
    if is_editor(n) { return; }
    // Enter on a field. `set_control_action_ctx` pins its own target to the
    // control, so this is the same lifetime story as the delegate.
    akx::set_control_action_ctx(ak::Control::from_raw(target), submit_imp, n as *u8);
    return;
}

// Whether a node's kind is one this file speaks for. `views` asks before it
// installs, so the answer is in one place rather than three call sites.
fn takes_input(kind: u32) -> bool {
    return kind == props::K_TEXT_FIELD || kind == props::K_TEXT_AREA
        || kind == props::K_SEARCH_FIELD;
}

// ==============================================================================
// The popup's menu delegate
// ==============================================================================
//
// `on_opened` / `on_closed` are declared by `popup`, `date_picker` and
// `time_picker`. Only the popup can answer them, and not through the control:
// NSPopUpButton posts nothing on dismiss. Its MENU does — NSMenu's delegate
// gets `menuWillOpen:` and `menuDidClose:` — so the delegate goes on the menu
// and the node rides on it, the same shape as the text delegate above.
//
// The pickers cannot: an NSDatePicker in either of facet's postures is a field
// with a stepper, and there is no popover to open or close. Recorded.

fn popup_node_key() -> *u8 { return { 29052 as *u8 }; }

fn popup_node_of(obj: *u8) -> *core::Node {
    if obj == (0 as *u8) { return 0 as *core::Node; }
    return { synth::get_associated(obj, popup_node_key()) as *core::Node };
}

// The same delegate serves a SWIPEABLE's menu, because a swipe's edges on this
// backend are the menu's edges — there is no partial state between closed and
// open when the thing that opens it is a click. MAUI names each edge twice
// (the gesture's and the programmatic one) and without a gesture they are the
// same moment, so both fire.
fn swipe_handlers(n: *core::Node, opened: bool) {
    let d: *core::Data = core::node_data(n);
    if d == (0 as *core::Data) { return; }
    if { (*d).kind } != props::K_SWIPEABLE { return; }
    let p: *props::SwipeableProps = { (*d).props } as *props::SwipeableProps;
    if p == (0 as *props::SwipeableProps) { return; }
    let v: *u8 = core::view_of(n);
    if opened {
        fire({ (*p).on_swipe_started }, { (*p).on_swipe_started_ctx }, v);
        fire({ (*p).on_open_requested }, { (*p).on_open_requested_ctx }, v);
    } else {
        fire({ (*p).on_swipe_ended }, { (*p).on_swipe_ended_ctx }, v);
        fire({ (*p).on_close_requested }, { (*p).on_close_requested_ctx }, v);
    }
    return;
}

// Pinned to the VIEW, not the menu: a swipeable rebuilds its menu whenever its
// items change, and a delegate pinned to a menu would die with it.
fn install_swipe(view: *u8, menu: *u8, n: *core::Node) {
    if menu == (0 as *u8) { return; }
    let d: *u8 = synth::alloc_init_class(popup_delegate_class());
    if d == (0 as *u8) { return; }
    synth::set_associated(d, popup_node_key(), n as *u8);
    synth::retain_associated(view, swipe_pin_key(), d);
    { rt::msg_void_id(menu, rt::sel(#str_ptr("setDelegate:\0")), d) };
    rt::release(d);
    return;
}

fn swipe_pin_key() -> *u8 { return { 29056 as *u8 }; }

fn popup_handlers(n: *core::Node, opened: bool) {
    let d: *core::Data = core::node_data(n);
    if d == (0 as *core::Data) { return; }
    // One delegate class, two kinds — asked of the NODE rather than assumed,
    // so a swipeable's menu edges reach the swipe handlers and not nothing.
    if { (*d).kind } == props::K_SWIPEABLE { swipe_handlers(n, opened); return; }
    if { (*d).kind } != props::K_POPUP { return; }
    let p: *props::PopupProps = { (*d).props } as *props::PopupProps;
    if p == (0 as *props::PopupProps) { return; }
    if opened {
        fire({ (*p).on_opened }, { (*p).on_opened_ctx }, core::view_of(n));
    } else {
        fire({ (*p).on_closed }, { (*p).on_closed_ctx }, core::view_of(n));
    }
    return;
}

fn menu_will_open_imp(self_obj: *u8, cmd: *u8, menu: *u8) {
    let n: *core::Node = popup_node_of(self_obj);
    if n == (0 as *core::Node) { return; }
    popup_handlers(n, true);
    return;
}

fn menu_did_close_imp(self_obj: *u8, cmd: *u8, menu: *u8) {
    let n: *core::Node = popup_node_of(self_obj);
    if n == (0 as *core::Node) { return; }
    popup_handlers(n, false);
    return;
}

fn popup_delegate_class() -> *u8 {
    let existing: *u8 = rt::get_class(#str_ptr("FacetPopupDelegate\0"));
    if existing != (0 as *u8) { return existing; }
    let cls: *u8 = synth::allocate_class_pair(rt::get_class(#str_ptr("NSObject\0")),
                                              #str_ptr("FacetPopupDelegate\0"), 0 as usize);
    synth::add_method_v_1id(cls, rt::sel(#str_ptr("menuWillOpen:\0")),
                            menu_will_open_imp, #str_ptr("v@:@\0"));
    synth::add_method_v_1id(cls, rt::sel(#str_ptr("menuDidClose:\0")),
                            menu_did_close_imp, #str_ptr("v@:@\0"));
    synth::register_class_pair(cls);
    return cls;
}

// Pinned to the BUTTON, not the menu: a popup rebuilds its menu whenever its
// items change, and a delegate pinned to a menu would die with it.
fn install_popup(view: *u8, menu: *u8, n: *core::Node) {
    if menu == (0 as *u8) { return; }
    let d: *u8 = synth::alloc_init_class(popup_delegate_class());
    if d == (0 as *u8) { return; }
    synth::set_associated(d, popup_node_key(), n as *u8);
    synth::retain_associated(view, delegate_pin_key(), d);
    { rt::msg_void_id(menu, rt::sel(#str_ptr("setDelegate:\0")), d) };
    rt::release(d);
    return;
}

// ==============================================================================
// The slider's drag edges
// ==============================================================================
//
// `on_drag_started` and `on_drag_completed` have no notification of their own.
// What NSSlider has is `isTracking` on its cell, true while the knob is held —
// so a continuous slider's action, which fires throughout the drag, carries
// both edges: the first action with tracking ON is the start, and the first
// with it OFF is the completion.
//
// The `was_tracking` flag lives on the VIEW as an associated int rather than in
// facet's props, because it is a fact about this drag and not about the
// description.

fn slider_node_key() -> *u8 { return { 29054 as *u8 }; }
fn slider_tracking_key() -> *u8 { return { 29055 as *u8 }; }

fn slider_props_of(n: *core::Node) -> *props::SliderProps {
    let d: *core::Data = core::node_data(n);
    if d == (0 as *core::Data) { return 0 as *props::SliderProps; }
    if { (*d).kind } != props::K_SLIDER { return 0 as *props::SliderProps; }
    return { (*d).props } as *props::SliderProps;
}

fn slider_is_tracking(v: *u8) -> bool {
    let cell: *u8 = { rt::msg_id(v, rt::sel(#str_ptr("cell\0"))) };
    if cell == (0 as *u8) { return false; }
    return { rt::msg_i8(cell, rt::sel(#str_ptr("isHighlighted\0"))) } != (0 as i8);
}

// The action, wrapped: the value handler still runs, and the two edges are
// derived around it.
fn slider_action(sender: *u8, ctx: *u8) {
    let n: *core::Node = ctx as *core::Node;
    if n == (0 as *core::Node) { return; }
    let p: *props::SliderProps = slider_props_of(n);
    if p == (0 as *props::SliderProps) { return; }
    let now: bool = slider_is_tracking(sender);
    let before: bool = { synth::get_associated(sender, slider_tracking_key()) } != (0 as *u8);
    if now && before == false {
        synth::set_associated(sender, slider_tracking_key(), 1 as *u8);
        fire({ (*p).on_drag_started }, { (*p).on_drag_started_ctx }, sender);
    }
    // The value is written back BEFORE the handler, the same rule the text
    // controls follow: `value()` reads the props, so the props must be true.
    { (*p).value = ak::Control::from_raw(sender).double_value() };
    fire({ (*p).on_value_changed }, { (*p).on_value_changed_ctx }, sender);
    if now == false && before {
        synth::set_associated(sender, slider_tracking_key(), 0 as *u8);
        fire({ (*p).on_drag_completed }, { (*p).on_drag_completed_ctx }, sender);
    }
    return;
}

fn install_slider(view: *u8, n: *core::Node) {
    if view == (0 as *u8) { return; }
    synth::set_associated(view, slider_node_key(), n as *u8);
    // Continuous, or the action only arrives once the knob is released and
    // there is no drag to see the edges of.
    { rt::msg_void_i8(view, rt::sel(#str_ptr("setContinuous:\0")), true as i8) };
    let f: fn(*u8, *u8) = slider_action;
    akx::set_control_action_ctx(ak::Control::from_raw(view), f, n as *u8);
    return;
}

// ==============================================================================
// The split view's delegate
// ==============================================================================
//
// `min_leading` / `min_trailing` are ASKED for, not set: NSSplitView consults
// its delegate for the constraint on every drag rather than storing a bound.
// `on_move` arrives on the same object, so one delegate carries all three.

fn split_node_key() -> *u8 { return { 29053 as *u8 }; }

fn split_props_of(n: *core::Node) -> *split::SplitProps {
    let d: *core::Data = core::node_data(n);
    if d == (0 as *core::Data) { return 0 as *split::SplitProps; }
    if { (*d).kind } != split::K_SPLIT { return 0 as *split::SplitProps; }
    return { (*d).props } as *split::SplitProps;
}

fn split_node_of(obj: *u8) -> *core::Node {
    if obj == (0 as *u8) { return 0 as *core::Node; }
    return { synth::get_associated(obj, split_node_key()) as *core::Node };
}

// `splitView:constrainMinCoordinate:ofSubviewAt:` — the LEADING pane's floor.
fn min_coord_imp(self_obj: *u8, cmd: *u8, sv: *u8, proposed: f64, idx: i64) -> f64 {
    let n: *core::Node = split_node_of(self_obj);
    if n == (0 as *core::Node) { return proposed; }
    let p: *split::SplitProps = split_props_of(n);
    if p == (0 as *split::SplitProps) { return proposed; }
    let lo: f64 = { (*p).min_leading };
    if lo > proposed { return lo; }
    return proposed;
}

// `splitView:constrainMaxCoordinate:ofSubviewAt:` — the TRAILING pane's floor,
// expressed as a ceiling on the divider: the trailing pane is what is left.
fn max_coord_imp(self_obj: *u8, cmd: *u8, sv: *u8, proposed: f64, idx: i64) -> f64 {
    let n: *core::Node = split_node_of(self_obj);
    if n == (0 as *core::Node) { return proposed; }
    let p: *split::SplitProps = split_props_of(n);
    if p == (0 as *split::SplitProps) { return proposed; }
    let keep: f64 = { (*p).min_trailing };
    if keep <= 0.0f64 { return proposed; }
    let s: ak::SplitView = ak::SplitView::from_raw(sv);
    var extent: f64 = { s.as_view().frame().h };
    if s.is_vertical() { extent = { s.as_view().frame().w }; }
    let ceiling: f64 = extent - keep;
    if ceiling < proposed { return ceiling; }
    return proposed;
}

// `splitViewDidResizeSubviews:`. The position the user landed on is written
// back into the props BEFORE the handler runs, for the same reason a typed
// character is: `position()` reads the props, so the props have to be true.
fn split_resized_imp(self_obj: *u8, cmd: *u8, note: *u8) {
    let n: *core::Node = split_node_of(self_obj);
    if n == (0 as *core::Node) { return; }
    let p: *split::SplitProps = split_props_of(n);
    if p == (0 as *split::SplitProps) { return; }
    let sv: *u8 = { rt::msg_id(note, rt::sel(#str_ptr("object\0"))) };
    if sv != (0 as *u8) {
        let s: ak::SplitView = ak::SplitView::from_raw(sv);
        // The leading pane's own frame IS the divider position — read off the
        // view rather than computed, so a drag that AppKit clamped reports
        // where the divider actually landed.
        let first: *u8 = { rt::msg_id_u64({ rt::msg_id(sv, rt::sel(#str_ptr("subviews\0"))) },
                                          rt::sel(#str_ptr("objectAtIndex:\0")), 0 as u64) };
        if first != (0 as *u8) {
            let fr: rt::Rect = ak::View::from_raw(first).frame();
            var at: f64 = { fr.h };
            if s.is_vertical() { at = { fr.w }; }
            { (*p).position = at };
        }
    }
    fire({ (*p).on_move }, { (*p).ctx }, sv);
    return;
}

fn split_delegate_class() -> *u8 {
    let existing: *u8 = rt::get_class(#str_ptr("FacetSplitDelegate\0"));
    if existing != (0 as *u8) { return existing; }
    let cls: *u8 = synth::allocate_class_pair(rt::get_class(#str_ptr("NSObject\0")),
                                              #str_ptr("FacetSplitDelegate\0"), 0 as usize);
    add_method_f64_id_f64_i64(cls, rt::sel(#str_ptr("splitView:constrainMinCoordinate:ofSubviewAt:\0")),
                              min_coord_imp, #str_ptr("d@:@di\0"));
    add_method_f64_id_f64_i64(cls, rt::sel(#str_ptr("splitView:constrainMaxCoordinate:ofSubviewAt:\0")),
                              max_coord_imp, #str_ptr("d@:@di\0"));
    synth::add_method_v_1id(cls, rt::sel(#str_ptr("splitViewDidResizeSubviews:\0")),
                            split_resized_imp, #str_ptr("v@:@\0"));
    synth::register_class_pair(cls);
    return cls;
}

#[link_name = "class_addMethod"]
extern fn add_method_f64_id_f64_i64(cls: *u8, sel: *u8, imp: fn(*u8, *u8, *u8, f64, i64) -> f64, types: *u8) -> i8;

// Idempotent: the node is re-associated every time (a re-attached node has a
// new address) but the delegate object is made once and pinned to the view.
fn install_split(view: *u8, n: *core::Node) {
    if view == (0 as *u8) { return; }
    let existing: *u8 = { synth::get_associated(view, delegate_pin_key()) };
    if existing != (0 as *u8) {
        synth::set_associated(existing, split_node_key(), n as *u8);
        return;
    }
    let d: *u8 = synth::alloc_init_class(split_delegate_class());
    if d == (0 as *u8) { return; }
    synth::set_associated(d, split_node_key(), n as *u8);
    synth::retain_associated(view, delegate_pin_key(), d);
    { rt::msg_void_id(view, rt::sel(#str_ptr("setDelegate:\0")), d) };
    rt::release(d);
    return;
}

// ==============================================================================
// The shared band
// ==============================================================================
//
// `InputViewProps` is embedded by all three kinds, so its verbs are ONE body
// here rather than three that drift. What is not shared is the bit VALUES: the
// generator numbers each module's bits from its own field list, and text_area
// has two fewer fields than the other two, so `P_CHARACTER_SPACING` is 8 there
// and 32 in a text_field. `Bits` carries the per-kind numbering, built once per
// kind, and the band body never names a module constant.

struct Bits {
    character_spacing: u64,
    cursor_position: u64,
    font: u64,             // size | weight | family | italic, folded: one font
    is_read_only: u64,
    checks_spelling: u64,
    predicts_text: u64,
    keyboard: u64,
    max_length: u64,
    placeholder: u64,
    placeholder_color: u64,
    selection_length: u64,
    text: u64,
    text_color: u64,
    text_transform: u64,
    text_align: u64,
}

fn bits_of(kind: u32) -> Bits {
    if kind == props::K_TEXT_AREA {
        return Bits {
            character_spacing: text_area::P_CHARACTER_SPACING,
            cursor_position: text_area::P_CURSOR_POSITION,
            font: text_area::P_FONT_SCALES | text_area::P_FONT_SIZE | text_area::P_FONT_WEIGHT
                | text_area::P_FONT_FAMILY | text_area::P_IS_ITALIC,
            is_read_only: text_area::P_IS_READ_ONLY,
            checks_spelling: text_area::P_CHECKS_SPELLING,
            predicts_text: text_area::P_PREDICTS_TEXT,
            keyboard: text_area::P_KEYBOARD,
            max_length: text_area::P_MAX_LENGTH,
            placeholder: text_area::P_PLACEHOLDER,
            placeholder_color: text_area::P_PLACEHOLDER_COLOR,
            selection_length: text_area::P_SELECTION_LENGTH,
            text: text_area::P_TEXT,
            text_color: text_area::P_TEXT_COLOR,
            text_transform: text_area::P_TEXT_TRANSFORM,
            text_align: text_area::P_TEXT_ALIGN,
        };
    }
    if kind == props::K_SEARCH_FIELD {
        return Bits {
            character_spacing: search_field::P_CHARACTER_SPACING,
            cursor_position: search_field::P_CURSOR_POSITION,
            font: search_field::P_FONT_SCALES | search_field::P_FONT_SIZE | search_field::P_FONT_WEIGHT
                | search_field::P_FONT_FAMILY | search_field::P_IS_ITALIC,
            is_read_only: search_field::P_IS_READ_ONLY,
            checks_spelling: search_field::P_CHECKS_SPELLING,
            predicts_text: search_field::P_PREDICTS_TEXT,
            keyboard: search_field::P_KEYBOARD,
            max_length: search_field::P_MAX_LENGTH,
            placeholder: search_field::P_PLACEHOLDER,
            placeholder_color: search_field::P_PLACEHOLDER_COLOR,
            selection_length: search_field::P_SELECTION_LENGTH,
            text: search_field::P_TEXT,
            text_color: search_field::P_TEXT_COLOR,
            text_transform: search_field::P_TEXT_TRANSFORM,
            text_align: search_field::P_TEXT_ALIGN,
        };
    }
    return Bits {
        character_spacing: text_field::P_CHARACTER_SPACING,
        cursor_position: text_field::P_CURSOR_POSITION,
        font: text_field::P_FONT_SCALES | text_field::P_FONT_SIZE | text_field::P_FONT_WEIGHT
            | text_field::P_FONT_FAMILY | text_field::P_IS_ITALIC,
        is_read_only: text_field::P_IS_READ_ONLY,
        checks_spelling: text_field::P_CHECKS_SPELLING,
        predicts_text: text_field::P_PREDICTS_TEXT,
        keyboard: text_field::P_KEYBOARD,
        max_length: text_field::P_MAX_LENGTH,
        placeholder: text_field::P_PLACEHOLDER,
        placeholder_color: text_field::P_PLACEHOLDER_COLOR,
        selection_length: text_field::P_SELECTION_LENGTH,
        text: text_field::P_TEXT,
        text_color: text_field::P_TEXT_COLOR,
        text_transform: text_field::P_TEXT_TRANSFORM,
        text_align: text_field::P_TEXT_ALIGN,
    };
}

// The alignment a control was asked for, or None when it is the vocabulary's
// own default and the control's natural alignment should stand.
fn asked_align(a: vocab::TextAlign) -> option::Option[vocab::TextAlign] {
    return match a {
        // `Center` is the generated default for every text control, which means
        // "not asked for" far more often than it means centred text.
        vocab::TextAlign::Center => option::Option[vocab::TextAlign]::None,
        vocab::TextAlign::Start => option::some(a),
        vocab::TextAlign::End => option::some(a),
        vocab::TextAlign::Justify => option::some(a),
    };
}

fn band_font(iv: *props::InputViewProps) -> option::Option[ak::Font] {
    return paint::ns_font_scaled({ (*iv).font_size }, { (*iv).font_weight },
                                 { (*iv).font_family.view() }, { (*iv).is_italic },
                                 { (*iv).font_scales });
}

// What the control should be SHOWING: the description's text with the display
// transform applied. Never written back — `text()` answers what the
// application set, and a transform is a rendering choice.
fn shown_text(iv: *props::InputViewProps) -> text::Text {
    return paint::transformed({ (*iv).text.view() }, { (*iv).text_transform });
}

// `character_spacing` is a kern attribute and has no plain-string equivalent,
// so a control that asks for it is written as an attributed string. One that
// does not keeps the plain path, which is the one that does not disturb an
// editing session.
fn band_wants_rich(iv: *props::InputViewProps) -> bool {
    return paint::wants_rich({ (*iv).character_spacing }, 0.0f64,
                             vocab::TextDecoration::None);
}

fn band_attributes(iv: *props::InputViewProps, align: vocab::TextAlign) -> *u8 {
    return paint::rich_attributes(band_font(iv), { (*iv).text_color },
                                  { (*iv).character_spacing }, 0.0f64,
                                  asked_align(align), vocab::TextDecoration::None);
}

// ---- the field half (NSTextField, NSSearchField) -----------------------------

fn apply_field_band(f: ak::TextField, n: *core::Node, iv: *props::InputViewProps,
                    align: vocab::TextAlign, dirty: u64, b: Bits) {
    let rich: u64 = b.text | b.text_transform | b.character_spacing | b.font
        | b.text_color | b.text_align;
    if (dirty & rich) != (0 as u64) {
        let want: text::Text = shown_text(iv);
        // The guard that predates this band and still rules: writing the value
        // moves the insertion point, so a field showing what it should show is
        // left alone.
        if f.as_control().string_value().view() != want.view() {
            if band_wants_rich(iv) {
                let a: *u8 = paint::attributed(want.view(), band_attributes(iv, align));
                if a != (0 as *u8) {
                    { rt::msg_void_id(f.raw(), rt::sel(#str_ptr("setAttributedStringValue:\0")), a) };
                    rt::release(a);
                }
            } else {
                f.as_control().set_string_value(want.view());
            }
        }
    }
    // The plain attributes go on the control itself even when the string is
    // attributed: NSTextField uses them for the field editor, which is what an
    // application types into.
    if (dirty & b.font) != (0 as u64) {
        match band_font(iv) {
            option::Option[ak::Font]::Some(font) => { f.as_control().set_font(font); }
            option::Option[ak::Font]::None => { }
        }
    }
    if (dirty & b.text_color) != (0 as u64) {
        let c: vocab::Color = { (*iv).text_color };
        if c.is_set() { f.set_text_color(paint::ns_color(c)); }
    }
    if (dirty & b.text_align) != (0 as u64) {
        match asked_align(align) {
            option::Option[vocab::TextAlign]::Some(a) => { f.as_control().set_alignment(paint::ns_text_align(a)); }
            option::Option[vocab::TextAlign]::None => { }
        }
    }
    if (dirty & (b.placeholder | b.placeholder_color)) != (0 as u64) {
        apply_placeholder(f, iv, align);
    }
    if (dirty & b.is_read_only) != (0 as u64) {
        f.set_editable({ (*iv).is_read_only } == false);
    }
    if (dirty & (b.checks_spelling | b.predicts_text | b.keyboard)) != (0 as u64) {
        // NSTextField has no spell-check switch of its own — the FIELD EDITOR
        // does the checking, and it is shared by every field in the window. So
        // the flag is carried on the node and applied when this field takes
        // focus; see `apply_editor_state`.
        apply_editor_state(f, n, iv);
    }
    if (dirty & (b.cursor_position | b.selection_length)) != (0 as u64) {
        apply_selection(f, iv);
    }
    return;
}

// A coloured placeholder is an attributed placeholder: NSTextField's
// `placeholderString` is plain and always draws in the system's placeholder
// colour.
fn apply_placeholder(f: ak::TextField, iv: *props::InputViewProps, align: vocab::TextAlign) {
    let s: str = { (*iv).placeholder.view() };
    let c: vocab::Color = { (*iv).placeholder_color };
    if c.is_set() == false {
        f.set_placeholder_string(s);
        return;
    }
    let attrs: *u8 = paint::rich_attributes(band_font(iv), c, { (*iv).character_spacing },
                                            0.0f64, asked_align(align),
                                            vocab::TextDecoration::None);
    let a: *u8 = paint::attributed(s, attrs);
    if a == (0 as *u8) { f.set_placeholder_string(s); return; }
    { rt::msg_void_id(f.raw(), rt::sel(#str_ptr("setPlaceholderAttributedString:\0")), a) };
    rt::release(a);
    return;
}

// The caret the APPLICATION asked for. Only meaningful while the control has a
// field editor, which is only while it has focus — an unfocused field has no
// selection to move, and forcing focus to honour a write would steal it from
// wherever the user actually is.
fn apply_selection(f: ak::TextField, iv: *props::InputViewProps) {
    match f.as_control().current_editor() {
        option::Option[ak::Text]::Some(ed) => { set_range(ed, iv); }
        option::Option[ak::Text]::None => { }
    }
    return;
}

fn set_range(ed: ak::Text, iv: *props::InputViewProps) {
    let len: u64 = { rt::msg_u64(bridge::nsstring(ed.string().view()), rt::sel(#str_ptr("length\0"))) };
    var loc: i64 = { (*iv).cursor_position };
    if loc < (0 as i64) { loc = 0 as i64; }
    var start: u64 = loc as u64;
    if start > len { start = len; }
    var sel: i64 = { (*iv).selection_length };
    if sel < (0 as i64) { sel = 0 as i64; }
    var count: u64 = sel as u64;
    if start +% count > len { count = len -% start; }
    ed.set_selected_range(rt::Range { location: start, length: count });
    return;
}

// Spell checking and the length limit both live on the FIELD EDITOR, which a
// field only has while focused and which it SHARES with every other field in
// the window. So neither can be set once and left: they are re-applied each
// time this field begins editing, and that is what `controlTextDidBeginEditing:`
// is for.
fn apply_editor_state(f: ak::TextField, n: *core::Node, iv: *props::InputViewProps) {
    match f.as_control().current_editor() {
        option::Option[ak::Text]::Some(ed) => { apply_editor_flags(ed.raw(), iv); }
        option::Option[ak::Text]::None => { }
    }
    return;
}

// ---- the editor half (NSTextView) --------------------------------------------

fn apply_editor_band(tv: ak::TextView, n: *core::Node, iv: *props::InputViewProps,
                     align: vocab::TextAlign, dirty: u64, b: Bits) {
    if (dirty & (b.text | b.text_transform)) != (0 as u64) {
        let want: text::Text = shown_text(iv);
        if tv.as_text().string().view() != want.view() { tv.as_text().set_string(want.view()); }
    }
    // An editor's attributes apply to the WHOLE storage and to what is typed
    // next, so both are set: `typingAttributes` alone would leave existing text
    // unstyled, and the storage alone would lose the style on the next keypress.
    if (dirty & (b.font | b.text_color | b.character_spacing | b.text_align | b.text)) != (0 as u64) {
        let attrs: *u8 = band_attributes(iv, align);
        if attrs != (0 as *u8) {
            { rt::msg_void_id(tv.raw(), rt::sel(#str_ptr("setTypingAttributes:\0")), attrs) };
            style_storage(tv, attrs);
            rt::release(attrs);
        }
    }
    if (dirty & b.is_read_only) != (0 as u64) {
        tv.set_editable({ (*iv).is_read_only } == false);
    }
    // An editor owns its own text view, so unlike a field this needs no
    // begin-editing hook — the switches go straight on.
    if (dirty & (b.checks_spelling | b.predicts_text | b.keyboard)) != (0 as u64) {
        apply_editor_flags(tv.raw(), iv);
    }
    if (dirty & (b.cursor_position | b.selection_length)) != (0 as u64) {
        set_range(tv.as_text(), iv);
    }
    return;
}

fn style_storage(tv: ak::TextView, attrs: *u8) {
    let storage: *u8 = { rt::msg_id(tv.raw(), rt::sel(#str_ptr("textStorage\0"))) };
    if storage == (0 as *u8) { return; }
    let len: u64 = { rt::msg_u64(storage, rt::sel(#str_ptr("length\0"))) };
    if len == (0 as u64) { return; }
    { rt::msg_void_id_range(storage, rt::sel(#str_ptr("setAttributes:range:\0")),
                            attrs, rt::Range { location: 0 as u64, length: len }) };
    return;
}

// ---- the length limit --------------------------------------------------------
// `max_length` cannot be a formatter (a formatter rejects the whole string and
// beeps) and cannot be a delegate method AppKit offers for both kinds. What is
// true for both is that a change has just happened and the value is too long,
// so the limit is enforced in the change hook: truncate and put the caret back
// where the user had it, capped.

fn enforce_max_length(n: *core::Node, obj: *u8, iv: *props::InputViewProps) -> bool {
    let limit: i64 = { (*iv).max_length };
    if limit <= (0 as i64) { return false; }
    let cur: text::Text = native_text(n, obj);
    let ns: *u8 = bridge::nsstring(cur.view());
    let len: u64 = { rt::msg_u64(ns, rt::sel(#str_ptr("length\0"))) };
    if len <= (limit as u64) { return false; }
    // UTF-16 units, which is what NSString counts and what a selection range is
    // measured in — truncating by BYTES would cut a character in half.
    let cut: *u8 = { rt::msg_id_range(ns, rt::sel(#str_ptr("substringWithRange:\0")),
                                      rt::Range { location: 0 as u64, length: limit as u64 }) };
    let kept: text::Text = bridge::to_text(cut);
    if is_editor(n) {
        ak::Text::from_raw(obj).set_string(kept.view());
    } else {
        ak::Control::from_raw(obj).set_string_value(kept.view());
    }
    return true;
}

#[link_name = "objc_msgSend"]
extern fn msg_id_range(recv: *u8, sel: *u8, r: rt::Range) -> *u8;
