    return;
}

#[test]
fn a_slider_can_draw_its_own_knob() {
    // "NSSlider's knob is cell-drawn; there is no image slot" stops one step
    // short: the CELL that draws it has a method for drawing it, and a cell is
    // an object whose class can be replaced.
    backend::install();
    var plain: core::Node = slider::slider(0.5f64, key: "sk0");
    let pv: *u8 = views::create(0 as *u8, #addr_of(plain));
    let pc: *u8 = { rt::msg_id(pv, rt::sel(#str_ptr("cell\0"))) };
    assert synth::object_class(pc) == rt::get_class(#str_ptr("NSSliderCell\0"));

    var custom: core::Node = slider::slider(0.5f64, key: "sk1", thumb_image: "circle.fill");
    let cv: *u8 = views::create(0 as *u8, #addr_of(custom));
    let cc: *u8 = { rt::msg_id(cv, rt::sel(#str_ptr("cell\0"))) };
    assert synth::object_class(cc) != rt::get_class(#str_ptr("NSSliderCell\0"));
    // The image reached the cell, and drawing the knob does not fault.
    { rt::msg_void_rect(cc, rt::sel(#str_ptr("drawKnob:\0")),
                        rt::Rect { x: 0.0f64, y: 0.0f64, w: 16.0f64, h: 16.0f64 }) };
    views::view_release(pv);
    views::view_release(cv);
    return;
}

#[test]
fn a_carousel_that_is_not_swipeable_ignores_the_wheel() {
    // `IsSwipeEnabled` is not about the gesture but about WHO may move the
    // page. macOS's answer is the same one, and `position` still works.
    backend::install();
    var open_c: core::Node = paged_carousel("swon");
    let ov: *u8 = views::create(0 as *u8, #addr_of(open_c));
    assert compose::scroll_is_locked(ov) == false;

    var locked: core::Node = carousel::carousel(key: "swoff", swipeable: false);
    let lv: *u8 = views::create(0 as *u8, #addr_of(locked));
    assert compose::scroll_is_locked(lv);
    // And unlocking it again really unlocks it — the class stays, the flag
    // decides, because a class swap is not something to undo.
    compose::apply_scroll_lock(lv, false);
    assert compose::scroll_is_locked(lv) == false;
    views::view_release(ov);
    views::view_release(lv);
    return;
}

#[test]
fn maui_bools_that_default_true_are_not_generated_false() {
    // The third instance of one bug: a default nobody chose, silently
    // inverting a verb. A carousel that does not bounce, does not animate and
    // cannot be scrolled by the user is not the control MAUI describes.
    var c: core::Node = carousel::carousel(key: "dflt");
    let p: *core::Node = #addr_of(c);
    let d: *core::Data = core::node_data(p);
    let cp: *props::CarouselProps = { (*d).props } as *props::CarouselProps;
    assert { (*cp).bounces };
    assert { (*cp).animates_scroll };
    assert { (*cp).is_swipeable };
    var s: core::Node = scroll::scroll(key: "dflt2");
    let sd: *core::Data = core::node_data(#addr_of(s));
    let sp: *props::ScrollProps = { (*sd).props } as *props::ScrollProps;
    assert { (*sp).cascades_input };
    var f: core::Node = text_field::text_field("", key: "dflt3");
    let fd: *core::Data = core::node_data(#addr_of(f));
    let fp: *props::TextFieldProps = { (*fd).props } as *props::TextFieldProps;
    assert { (*fp).input_view.checks_spelling };
    return;
}

#[test]
fn a_destructive_toolbar_item_carries_a_red_button() {
    // "NSToolbarItem has no destructive style" is true of the ITEM and not of
    // the toolbar: an item may carry a view of its own, which is how every app
    // with a styled toolbar button has one.
    backend::install();
    var b: core::Builder = core::Builder::new();
    b.add(toolbar_item::toolbar_item("Keep", key: "tb:keep"));
    b.add(toolbar_item::toolbar_item("Erase", key: "tb:erase", destructive: true));
    var root: core::Node = core::column(b, key: "dtroot");
    let ids: *u8 = { rt::alloc_init(#str_ptr("NSMutableArray\0")) };
    let map: *u8 = { rt::alloc_init(#str_ptr("NSMutableDictionary\0")) };
    window::collect_toolbar_items(#addr_of(root), ids, map);
    let keep: *u8 = { rt::msg_id_id(map, rt::sel(#str_ptr("objectForKey:\0")),
                                    bridge::nsstring("tb:keep")) };
    let erase: *u8 = { rt::msg_id_id(map, rt::sel(#str_ptr("objectForKey:\0")),
                                     bridge::nsstring("tb:erase")) };
    // The ordinary one keeps the standard toolbar look — no view of its own.
    assert { rt::msg_id(keep, rt::sel(#str_ptr("view\0"))) } == (0 as *u8);
    let v: *u8 = { rt::msg_id(erase, rt::sel(#str_ptr("view\0"))) };
    assert v != (0 as *u8);
    let a: *u8 = { rt::msg_id(v, rt::sel(#str_ptr("attributedTitle\0"))) };
    assert a != (0 as *u8);
    let attrs: *u8 = { msg_attrs_at(a, rt::sel(#str_ptr("attributesAtIndex:effectiveRange:\0")),
                                    0 as u64, 0 as *u8) };
    let c: *u8 = { rt::msg_id_id(attrs, rt::sel(#str_ptr("objectForKey:\0")),
                                 bridge::nsstring("NSColor")) };
    assert c != (0 as *u8);
    rt::release(ids);
    rt::release(map);
    return;
}

// ---- grouping and selection, the two carriers facet did not have --------------
// `IsGrouped` and `SelectionMode` each had a carrier for the SWITCH and nothing
// for what it switches on: MAUI binds a list of lists and a SelectedItem, and
// Stage 1 dropped both as MODEL without declaring the imperative replacement.

fn g_row(ctx: *u8, i: usize) -> flex::Node {
    var b: core::Node = box_view::box(color: vocab::Color::rgba(0.3f64, 0.3f64, 0.3f64));
    b.set_height(flex::StyleLength::points(20.0f64));
    return b;
}
fn g_header(ctx: *u8, g: usize) -> flex::Node {
    var b: core::Node = box_view::box(color: vocab::Color::rgba(0.9f64, 0.9f64, 0.9f64));
    b.set_height(flex::StyleLength::points(10.0f64));
    return b;
}
fn g_size(ctx: *u8, g: usize) -> usize {
    if g == (0 as usize) { return 2 as usize; }
    return 3 as usize;
}

#[test]
fn a_grouped_collection_interleaves_headers_with_the_same_flat_rows() {
    // The row builder is UNTOUCHED and that is the point: a group is a run of
    // the same flat sequence, so grouping an existing list adds a description
    // rather than rewriting one.
    backend::install();
    var c: core::Node = collection::collection(key: "gc", grouped: true);
    let p: *core::Node = #addr_of(c);
    match collection::find("gc", within: p) {
        option::Option[collection::Collection]::Some(h) => {
            let a: collection::Collection = h.set_row(g_row, ctx: 0 as *u8);
            let b: collection::Collection = a.set_count(5 as usize);
            let d: collection::Collection = b.set_group_count(2 as usize);
            let _e: collection::Collection = d.set_group(g_size, g_header, ctx: 0 as *u8);
        }
        option::Option[collection::Collection]::None => { assert false; }
    }
    assert mount::mount(p);
    // Two headers plus five rows.
    assert core::child_count_of(p) == (7 as usize);
    // And the mapping back: child 0 is a header, child 1 is data row 0,
    // child 3 is a header again, child 4 is data row 2.
    assert controls::data_index_of(p, 0 as i64) == (-1 as i64);
    assert controls::data_index_of(p, 1 as i64) == (0 as i64);
    assert controls::data_index_of(p, 2 as i64) == (1 as i64);
    assert controls::data_index_of(p, 3 as i64) == (-1 as i64);
    assert controls::data_index_of(p, 4 as i64) == (2 as i64);
    assert controls::child_index_of(p, 2 as i64) == (4 as i64);
    mount::unmount(p);
    return;
}

#[test]
fn an_ungrouped_collection_is_flat_and_maps_straight_through() {
    backend::install();
    var c: core::Node = collection::collection(key: "gc2");
    let p: *core::Node = #addr_of(c);
    match collection::find("gc2", within: p) {
        option::Option[collection::Collection]::Some(h) => {
            let a: collection::Collection = h.set_row(g_row, ctx: 0 as *u8);
            let _b: collection::Collection = a.set_count(3 as usize);
        }
        option::Option[collection::Collection]::None => { assert false; }
    }
    assert mount::mount(p);
    assert core::child_count_of(p) == (3 as usize);
    assert controls::data_index_of(p, 2 as i64) == (2 as i64);
    mount::unmount(p);
    return;
}

static PICKS: i64 = 0 as i64;
fn on_row_picked(sender: *u8, ctx: *u8) { PICKS = PICKS + (1 as i64); return; }

#[test]
fn clicking_a_collection_row_selects_it_and_reports_the_data_index() {
    // A collection is a scroll of ordinary children, so nothing in it reports a
    // selection — it is found from the geometry, the same way the carousel's
    // position is. The click is taken on the DOCUMENT VIEW because a plain row
    // does not accept mouse events and its click walks up to there.
    backend::install();
    PICKS = 0 as i64;
    let h: fn(*u8, *u8) = on_row_picked;
    var c: core::Node = collection::collection(key: "sc", grouped: true,
        selection_mode: vocab::SelectionMode::Single, on_selection_changed: h);
    let p: *core::Node = #addr_of(c);
    match collection::find("sc", within: p) {
        option::Option[collection::Collection]::Some(x) => {
            let a: collection::Collection = x.set_row(g_row, ctx: 0 as *u8);
            let b: collection::Collection = a.set_count(5 as usize);
            let d: collection::Collection = b.set_group_count(2 as usize);
            let _e: collection::Collection = d.set_group(g_size, g_header, ctx: 0 as *u8);
        }
        option::Option[collection::Collection]::None => { assert false; }
    }
    assert mount::mount(p);
    // A REAL window: the click arrives in window coordinates and the document
    // view is flipped, so the conversion is the thing under test as much as the
    // hit is. Without one there is nothing to convert against.
    let w: ak::Window = window::make_shell_window(screen::Chrome::new(
        title: "pick", width: 100.0f64, height: 200.0f64));
    let v: *u8 = core::view_of(p);
    match w.content_view() {
        option::Option[ak::View]::Some(cv) => { cv.add_subview(ak::View::from_raw(v)); }
        option::Option[ak::View]::None => { assert false; }
    }
    { rt::msg_void_rect(v, rt::sel(#str_ptr("setFrame:\0")),
                        rt::Rect { x: 0.0f64, y: 0.0f64, w: 100.0f64, h: 200.0f64 }) };
    geometry::relayout_root(p, 100.0f64, 200.0f64, 1.0f64);
    let doc: *u8 = { rt::msg_id(v, rt::sel(#str_ptr("documentView\0"))) };
    // Child 4 is data row 2: header(10) + 2 rows(20) + header(10) puts it at
    // y = 60..80 in the FLIPPED document view, which is y = 200-65 = 135 up
    // from the window's bottom-left origin.
    { rt::msg_void_id(doc, rt::sel(#str_ptr("mouseDown:\0")), point_event(10.0f64, 135.0f64)) };
    assert PICKS == (1 as i64);
    match collection::find("sc", within: p) {
        option::Option[collection::Collection]::Some(x) => { assert x.selected_index() == (2 as i64); }
        option::Option[collection::Collection]::None => { assert false; }
    }
    // A HEADER is not selectable: clicking one changes nothing.
    { rt::msg_void_id(doc, rt::sel(#str_ptr("mouseDown:\0")), point_event(10.0f64, 145.0f64)) };
    assert PICKS == (1 as i64);
    w.close();
    mount::unmount(p);
    return;
}

#[test]
fn a_collection_with_no_selection_mode_takes_no_clicks() {
    backend::install();
    PICKS = 0 as i64;
    let h: fn(*u8, *u8) = on_row_picked;
    var c: core::Node = collection::collection(key: "sc2", on_selection_changed: h);
    let p: *core::Node = #addr_of(c);
    match collection::find("sc2", within: p) {
        option::Option[collection::Collection]::Some(x) => {
            let a: collection::Collection = x.set_row(g_row, ctx: 0 as *u8);
            let _b: collection::Collection = a.set_count(3 as usize);
        }
        option::Option[collection::Collection]::None => { assert false; }
    }
    assert mount::mount(p);
    geometry::relayout_root(p, 100.0f64, 200.0f64, 1.0f64);
    let v: *u8 = core::view_of(p);
    let doc: *u8 = { rt::msg_id(v, rt::sel(#str_ptr("documentView\0"))) };
    { rt::msg_void_id(doc, rt::sel(#str_ptr("mouseDown:\0")), point_event(10.0f64, 10.0f64)) };
    assert PICKS == (0 as i64);
    mount::unmount(p);
    return;
}

fn ragged_row(ctx: *u8, i: usize) -> flex::Node {
    var b: core::Node = box_view::box(color: vocab::Color::rgba(0.2f64, 0.2f64, 0.2f64));
    if i == (0 as usize) { b.set_height(flex::StyleLength::points(40.0f64)); }
    else { b.set_height(flex::StyleLength::points(90.0f64)); }
    return b;
}

fn point_event(x: f64, y: f64) -> *u8 {
    return { msg_mouse_event(
        rt::get_class(#str_ptr("NSEvent\0")),
        rt::sel(#str_ptr("mouseEventWithType:location:modifierFlags:timestamp:windowNumber:context:eventNumber:clickCount:pressure:\0")),
        1 as u64, rt::Point { x: x, y: y }, 0 as u64, 0.0f64,
        0 as i64, 0 as *u8, 0 as i64, 1 as i64, 0.0f32) };
}

#[test]
fn a_grouped_list_counts_headers_as_rows_and_translates_back() {
    // A grouped TABLE's row count is not its item count, which is the whole
    // reason every index has to be translated.
    backend::install();
    var l: core::Node = list::list(key: "gl", grouped: true);
    let p: *core::Node = #addr_of(l);
    match list::find("gl", within: p) {
        option::Option[list::List]::Some(x) => {
            let a: list::List = x.set_row(g_row, ctx: 0 as *u8);
            let b: list::List = a.set_count(5 as usize);
            let d: list::List = b.set_group_count(2 as usize);
            let _e: list::List = d.set_group(g_size, g_header, ctx: 0 as *u8);
        }
        option::Option[list::List]::None => { assert false; }
    }
    let v: *u8 = views::create(0 as *u8, p);
    core::set_view(p, v, views::view_release);
    let tv: *u8 = recycler::table_of(v);
    assert { rt::msg_i64(tv, rt::sel(#str_ptr("numberOfRows\0"))) } == (7 as i64);
    // AppKit's own group styling, which is why a header is a ROW rather than a
    // decoration: the table already knows how to draw one.
    let d: *u8 = { rt::msg_id(tv, rt::sel(#str_ptr("delegate\0"))) };
    assert msg_i8_id_i64(d, rt::sel(#str_ptr("tableView:isGroupRow:\0")), tv, 0 as i64) != (0 as i8);
    assert msg_i8_id_i64(d, rt::sel(#str_ptr("tableView:isGroupRow:\0")), tv, 1 as i64) == (0 as i8);
    assert msg_i8_id_i64(d, rt::sel(#str_ptr("tableView:isGroupRow:\0")), tv, 3 as i64) != (0 as i8);
    return;
}

#[link_name = "objc_msgSend"]
extern fn msg_i8_id_i64(recv: *u8, sel: *u8, a: *u8, b: i64) -> i8;

#[test]
fn a_lists_selection_reads_back_the_data_index() {
    // The write-back the list never had: `selection_mode` said a row could be
    // picked and nothing said which one was.
    backend::install();
    var l: core::Node = list::list(key: "gl2", grouped: true,
                                   selection_mode: vocab::SelectionMode::Single);
    let p: *core::Node = #addr_of(l);
    match list::find("gl2", within: p) {
        option::Option[list::List]::Some(x) => {
            let a: list::List = x.set_row(g_row, ctx: 0 as *u8);
            let b: list::List = a.set_count(5 as usize);
            let d: list::List = b.set_group_count(2 as usize);
            let _e: list::List = d.set_group(g_size, g_header, ctx: 0 as *u8);
        }
        option::Option[list::List]::None => { assert false; }
    }
    let v: *u8 = views::create(0 as *u8, p);
    core::set_view(p, v, views::view_release);
    let tv: *u8 = recycler::table_of(v);
    // Table row 4 is data row 2 — header, two rows, header, THIS.
    let set: *u8 = { rt::msg_id_u64(rt::get_class(#str_ptr("NSIndexSet\0")),
                                    rt::sel(#str_ptr("indexSetWithIndex:\0")), 4 as u64) };
    { msg_void_id_i8_t(tv, rt::sel(#str_ptr("selectRowIndexes:byExtendingSelection:\0")),
                       set, 0 as i8) };
    match list::find("gl2", within: p) {
        option::Option[list::List]::Some(x) => { assert x.selected_index() == (2 as i64); }
        option::Option[list::List]::None => { assert false; }
    }
    return;
}

#[link_name = "objc_msgSend"]
extern fn msg_void_id_i8_t(recv: *u8, sel: *u8, a: *u8, b: i8);

#[test]
fn measure_first_item_makes_a_ragged_sequence_even() {
    // The observable half of a sizing STRATEGY: every item comes out the size
    // of the first, which is the same optimisation the recycler spells uniform.
    backend::install();
    var c: core::Node = collection::collection(key: "is",
        item_sizing: vocab::ItemSizing::MeasureFirstItem);
    let p: *core::Node = #addr_of(c);
    match collection::find("is", within: p) {
        option::Option[collection::Collection]::Some(x) => {
            let a: collection::Collection = x.set_row(ragged_row, ctx: 0 as *u8);
            let _b: collection::Collection = a.set_count(2 as usize);
        }
        option::Option[collection::Collection]::None => { assert false; }
    }
    assert mount::mount(p);
    geometry::relayout_root(p, 100.0f64, 200.0f64, 1.0f64);
    core::clear_dirty(p);
    core::touch(p, collection::P_ITEM_SIZING);
    views::apply(0 as *u8, p);
    geometry::relayout_root(p, 100.0f64, 200.0f64, 1.0f64);
    match core::child_of(p, 1 as usize) {
        option::Option[*core::Node]::Some(x) => { assert { (*x).frame() }.height == 40.0f64; }
        option::Option[*core::Node]::None => { assert false; }
    }
    mount::unmount(p);
    return;
}

#[test]
fn measure_all_items_leaves_a_ragged_sequence_ragged() {
    backend::install();
    var c: core::Node = collection::collection(key: "is2");
    let p: *core::Node = #addr_of(c);
    match collection::find("is2", within: p) {
        option::Option[collection::Collection]::Some(x) => {
            let a: collection::Collection = x.set_row(ragged_row, ctx: 0 as *u8);
            let _b: collection::Collection = a.set_count(2 as usize);
        }
        option::Option[collection::Collection]::None => { assert false; }
    }
    assert mount::mount(p);
    geometry::relayout_root(p, 100.0f64, 200.0f64, 1.0f64);
    core::clear_dirty(p);
    core::touch(p, collection::P_ITEM_SIZING);
    views::apply(0 as *u8, p);
    match core::child_of(p, 1 as usize) {
        option::Option[*core::Node]::Some(x) => { assert { (*x).frame() }.height == 90.0f64; }
        option::Option[*core::Node]::None => { assert false; }
    }
    mount::unmount(p);
    return;
}

// ---- the system-drawn colours, one verb at a time ----------------------------
// "A tinted layer under each" was rejected and stays rejected: it stops
// tracking the system appearance and drifts the moment Apple changes a
// control's shape. A CONTENT FILTER is a different thing — it recolours what
// AppKit actually drew — and its own limit is what decides each verb here:
// a hue rotation moves colour and leaves GREY alone.

#[test]
fn a_progress_bar_takes_a_hue_and_a_plain_one_takes_none() {
    backend::install();
    var plain: core::Node = progress::progress(0.5f64, key: "pg0");
    let pv: *u8 = views::create(0 as *u8, #addr_of(plain));
    assert filter_count(pv) == (0 as u64);

    var red: core::Node = progress::progress(0.5f64, key: "pg1",
        progress_color: vocab::Color::rgba(1.0f64, 0.0f64, 0.0f64));
    let rv: *u8 = views::create(0 as *u8, #addr_of(red));
    assert filter_count(rv) == (1 as u64);
    assert ak::View::from_raw(rv).wants_layer();
    views::view_release(pv);
    views::view_release(rv);
    return;
}

fn filter_count(v: *u8) -> u64 {
    let f: *u8 = { rt::msg_id(v, rt::sel(#str_ptr("contentFilters\0"))) };
    if f == (0 as *u8) { return 0 as u64; }
    return { rt::msg_u64(f, rt::sel(#str_ptr("count\0"))) };
}

#[test]
fn a_toggle_tints_its_on_track_and_a_spinner_its_whole_drawing() {
    backend::install();
    var t: core::Node = toggle::toggle(true, key: "tg1",
        on_color: vocab::Color::rgba(0.0f64, 1.0f64, 0.0f64));
    let tv: *u8 = views::create(0 as *u8, #addr_of(t));
    assert filter_count(tv) == (1 as u64);

    var s: core::Node = spinner::spinner(key: "sp1",
        color: vocab::Color::rgba(0.0f64, 1.0f64, 0.0f64));
    let sv: *u8 = views::create(0 as *u8, #addr_of(s));
    assert filter_count(sv) == (1 as u64);
    views::view_release(tv);
    views::view_release(sv);
    return;
}

#[test]
fn a_checkbox_tints_its_box() {
    backend::install();
    var c: core::Node = checkbox::checkbox(true, key: "cb1",
        color: vocab::Color::rgba(1.0f64, 0.5f64, 0.0f64));
    let v: *u8 = views::create(0 as *u8, #addr_of(c));
    assert filter_count(v) == (1 as u64);
    // Still a checkbox: the art was not swapped, only recoloured — so it has
    // no image of its own and it still holds its state.
    assert { rt::msg_i64(v, rt::sel(#str_ptr("state\0"))) } == (1 as i64);
    views::view_release(v);
    return;
}

#[test]
fn a_colour_that_is_unset_removes_the_filter_again() {
    // A control that stops asking goes back to the system's own drawing.
    backend::install();
    var t: core::Node = toggle::toggle(true, key: "tg2",
        on_color: vocab::Color::rgba(0.0f64, 1.0f64, 0.0f64));
    let p: *core::Node = #addr_of(t);
    let v: *u8 = views::create(0 as *u8, p);
    core::set_view(p, v, views::view_release);
    assert filter_count(v) == (1 as u64);
    match toggle::find("tg2", within: p) {
        option::Option[toggle::Toggle]::Some(h) => {
            let _x: toggle::Toggle = h.set_on_color(vocab::Color::clear());
        }
        option::Option[toggle::Toggle]::None => { assert false; }
    }
    views::apply(0 as *u8, p);
    assert filter_count(v) == (0 as u64);
    return;
}

#[test]
fn a_slider_draws_its_own_track_only_when_a_colour_is_named() {
    // `drawBarInside:flipped:` and `drawKnob:` are the CELL'S own hooks, not a
    // layer under the slider — and a slider that names no colour keeps AppKit's
    // drawing entirely, which is what keeps an ordinary slider ordinary.
    backend::install();
    var plain: core::Node = slider::slider(0.5f64, key: "sl9");
    let pv: *u8 = views::create(0 as *u8, #addr_of(plain));
    let pc: *u8 = { rt::msg_id(pv, rt::sel(#str_ptr("cell\0"))) };
    assert synth::object_class(pc) == rt::get_class(#str_ptr("NSSliderCell\0"));

    var tinted: core::Node = slider::slider(0.5f64, key: "sl10",
        maximum_track_color: vocab::Color::rgba(0.9f64, 0.9f64, 0.2f64),
        thumb_color: vocab::Color::rgba(0.1f64, 0.1f64, 0.9f64));
    let tv: *u8 = views::create(0 as *u8, #addr_of(tinted));
    let tc: *u8 = { rt::msg_id(tv, rt::sel(#str_ptr("cell\0"))) };
    assert synth::object_class(tc) != rt::get_class(#str_ptr("NSSliderCell\0"));
    // Both hooks answer without faulting, which is the half a headless test can
    // hold — what the pixels look like is "run it and try".
    { rt::msg_void_rect(tc, rt::sel(#str_ptr("drawKnob:\0")),
                        rt::Rect { x: 0.0f64, y: 0.0f64, w: 16.0f64, h: 16.0f64 }) };
    { msg_void_rect_i8(tc, rt::sel(#str_ptr("drawBarInside:flipped:\0")),
                       rt::Rect { x: 0.0f64, y: 0.0f64, w: 100.0f64, h: 4.0f64 }, 1 as i8) };
    views::view_release(pv);
    views::view_release(tv);
    return;
}

#[link_name = "objc_msgSend"]
extern fn msg_void_rect_i8(recv: *u8, sel: *u8, r: rt::Rect, f: i8);

#[test]
fn text_prediction_is_the_field_editors_and_the_editors_own() {
    // QuickType is a phone's; macOS predicts inline, in the field editor, and
    // `automaticTextCompletionEnabled` is the switch for it.
    backend::install();
    var a: core::Node = text_area::text_area("", key: "pt1", predicts_text: false);
    let av: *u8 = views::create(0 as *u8, #addr_of(a));
    let tv: *u8 = { rt::msg_id(av, rt::sel(#str_ptr("documentView\0"))) };
    assert { rt::msg_i8(tv, rt::sel(#str_ptr("isAutomaticTextCompletionEnabled\0"))) } == (0 as i8);

    var b: core::Node = text_area::text_area("", key: "pt2", predicts_text: true);
    let bv: *u8 = views::create(0 as *u8, #addr_of(b));
    let btv: *u8 = { rt::msg_id(bv, rt::sel(#str_ptr("documentView\0"))) };
    assert { rt::msg_i8(btv, rt::sel(#str_ptr("isAutomaticTextCompletionEnabled\0"))) } != (0 as i8);
    views::view_release(av);
    views::view_release(bv);
    return;
}

#[test]
fn a_looping_carousel_wraps_its_index_and_a_plain_one_declines() {
    // "An infinite carousel needs the touch paging it wraps" is true of the
    // GESTURE half and was standing in for the whole verb: what `wraps` means
    // to a program is that the index arithmetic is circular, and that half is
    // what an application and an agent both use.
    backend::install();
    var c: core::Node = paged_carousel("wrap");
    set_carousel_animation(#addr_of(c), false);
    set_carousel_wraps(#addr_of(c), true);
    let p: *core::Node = #addr_of(c);
    assert mount::mount(p);
    geometry::relayout_root(p, 100.0f64, 50.0f64, 1.0f64);
    let v: *u8 = core::view_of(p);
    // Five pages. Page 7 is page 2, and it lands where page 2 lands.
    core::clear_dirty(p);
    set_carousel_position(p, 2 as i64);
    core::touch(p, carousel::P_POSITION);
    views::apply(0 as *u8, p);
    let at_two: f64 = clip_origin_y(v);
    assert at_two > 0.0f64;
    core::clear_dirty(p);
    set_carousel_position(p, 0 as i64);
    core::touch(p, carousel::P_POSITION);
    views::apply(0 as *u8, p);
    assert clip_origin_y(v) == 0.0f64;
    core::clear_dirty(p);
    set_carousel_position(p, 7 as i64);
    core::touch(p, carousel::P_POSITION);
    views::apply(0 as *u8, p);
    assert clip_origin_y(v) == at_two;
    // And a negative one comes back from the other end: -1 is the last page.
    core::clear_dirty(p);
    set_carousel_position(p, -1 as i64);
    core::touch(p, carousel::P_POSITION);
    views::apply(0 as *u8, p);
    assert clip_origin_y(v) > at_two;
    mount::unmount(p);
    return;
}

#[test]
fn a_carousel_that_does_not_loop_declines_an_index_it_has_no_page_for() {
    // The ablation, and the rule it protects: without `wraps` an out-of-range
    // index is a MISTAKE and stays one. Pretending it meant the last page would
    // hide it.
    backend::install();
    var c: core::Node = paged_carousel("nowrap");
    set_carousel_animation(#addr_of(c), false);
    set_carousel_wraps(#addr_of(c), false);
    let p: *core::Node = #addr_of(c);
    assert mount::mount(p);
    geometry::relayout_root(p, 100.0f64, 50.0f64, 1.0f64);
    let v: *u8 = core::view_of(p);
    core::clear_dirty(p);
    set_carousel_position(p, 7 as i64);
    core::touch(p, carousel::P_POSITION);
    views::apply(0 as *u8, p);
    assert clip_origin_y(v) == 0.0f64;
    mount::unmount(p);
    return;
}

fn set_carousel_wraps(p: *core::Node, on: bool) {
    let d: *core::Data = core::node_data(p);
    let cp: *props::CarouselProps = { (*d).props } as *props::CarouselProps;
    { (*cp).wraps = on };
    return;
}

// ---- the hybrid scheme --------------------------------------------------------
// "Intercepting needs a WKURLSchemeHandler per scheme" was true, and it was
// standing in for the reason it could not be done: hybrid content loaded as
// `file://`, and WKWebView will not let a scheme handler near a reserved
// scheme — so there was nothing to hand a request to.

static RESOURCES: i64 = 0 as i64;
static LAST_RESOURCE: text::Text = #zero::[text::Text]();
fn on_resource(sender: *u8, ctx: *u8) {
    RESOURCES = RESOURCES + (1 as i64);
    LAST_RESOURCE = webmod::task_path(sender);
    return;
}

#[test]
fn a_hybrid_view_serves_its_root_over_facets_own_scheme() {
    backend::install();
    RESOURCES = 0 as i64;
    // A real directory with a real file in it: the handler reads from disk, so
    // a fake would be testing nothing.
    let root: text::Text = scratch_root();
    let _mk: status::Status = write_file(root.view(), "index.html", "<b>hi</b>");
    let h: fn(*u8, *u8) = on_resource;
    var n: core::Node = hybrid_ui::hybrid_web(key: "hy", hybrid_root: root.view(),
                                              default_file: "index.html",
                                              on_web_resource_requested: h);
    let p: *core::Node = #addr_of(n);
    let v: *u8 = views::create(0 as *u8, p);
    assert v != (0 as *u8);
    core::set_view(p, v, views::view_release);
    // The handler is registered on the CONFIGURATION, which is why it has to
    // happen before the view exists.
    let cfg: *u8 = { rt::msg_id(v, rt::sel(#str_ptr("configuration\0"))) };
    assert cfg != (0 as *u8);
    assert { msg_id_id_str(cfg, rt::sel(#str_ptr("urlSchemeHandlerForURLScheme:\0")),
                           bridge::nsstring("facet")) } != (0 as *u8);
    // And the load went over that scheme rather than file://.
    let url: *u8 = { rt::msg_id(v, rt::sel(#str_ptr("URL\0"))) };
    if url != (0 as *u8) {
        assert bridge::to_text({ rt::msg_id(url, rt::sel(#str_ptr("scheme\0"))) }) == "facet";
    }
    return;
}

#[link_name = "objc_msgSend"]
extern fn msg_id_id_str(recv: *u8, sel: *u8, a: *u8) -> *u8;

#[test]
fn a_request_that_climbs_out_of_the_root_is_refused() {
    // The read is ours, so it is bounded. `..` anywhere is refused outright
    // rather than normalised: a normaliser is a thing to get wrong, and a
    // hybrid app has no reason to name one.
    assert webmod::escapes_root("/../../etc/passwd");
    assert webmod::escapes_root("/assets/../secret");
    assert webmod::escapes_root("/assets/app.js") == false;
    assert webmod::escapes_root("/index.html") == false;
    return;
}

#[test]
fn a_served_resource_carries_the_type_the_page_asked_for() {
    assert webmod::mime_for("/index.html") == "text/html";
    assert webmod::mime_for("/app.js") == "text/javascript";
    assert webmod::mime_for("/style.css") == "text/css";
    assert webmod::mime_for("/logo.png") == "image/png";
    assert webmod::mime_for("/data.bin") == "application/octet-stream";
    return;
}

fn scratch_root() -> text::Text {
    var t: text::Text = text::from_str("/tmp/facet-hybrid-test");
    let _d: result::Result[bool, result::IoError] = fs::create_dir_all(t.view());
    return t;
}

fn write_file(dir: str, name: str, body: str) -> status::Status {
    var path: text::Text = text::from_str(dir);
    let _a: status::Status = path.append("/");
    let _b: status::Status = path.append(name);
    var bytes: vec::Vec[u8] = vec::new::[u8]();
    var i: usize = 0 as usize;
    while i < body.count() {
        match body.byte_at(i) {
            option::Option[u8]::Some(b) => { let _p: status::Status = bytes.append(b); }
            option::Option[u8]::None => { }
        }
        i = i + (1 as usize);
    }
    match fs::create(path.view()) {
        result::Result[fs::File, result::IoError]::Ok(f) => {
            var file: fs::File = f;
            let _w: result::Result[usize, result::IoError] = file.write_all(bytes);
            return status::Status::Ok;
        }
        result::Result[fs::File, result::IoError]::Err(_e) => { return status::Status::Ok; }
    }
}

// ---- reorder -------------------------------------------------------------------
// `CanReorderItems` is a DRAG, and macOS's answer to "reorder these" is a drag
// too — so unlike pull-to-refresh there is no idiom mismatch to route around.
// facet's rule still applies and is still satisfied: an agent reorders by
// reordering the DATA and writing `count`; the drag is the user's path to the
// same place.

static MOVES: i64 = 0 as i64;
fn on_moved(sender: *u8, ctx: *u8) { MOVES = MOVES + (1 as i64); return; }

fn reorder_collection(key: str, mix: bool) -> core::Node {
    let h: fn(*u8, *u8) = on_moved;
    var c: core::Node = collection::collection(key: key, reorder_items: true,
                                               mix_groups: mix, on_reorder_completed: h);
    let p: *core::Node = #addr_of(c);
    match collection::find(key, within: p) {
        option::Option[collection::Collection]::Some(x) => {
            let a: collection::Collection = x.set_row(g_row, ctx: 0 as *u8);
            let _b: collection::Collection = a.set_count(4 as usize);
        }
        option::Option[collection::Collection]::None => { }
    }
    return c;
}

#[test]
fn dragging_a_row_moves_it_and_reports_both_indices() {
    backend::install();
    MOVES = 0 as i64;
    var c: core::Node = reorder_collection("ro", true);
    let p: *core::Node = #addr_of(c);
    assert mount::mount(p);
    let w: ak::Window = window::make_shell_window(screen::Chrome::new(
        title: "reorder", width: 100.0f64, height: 200.0f64));
    let v: *u8 = core::view_of(p);
    match w.content_view() {
        option::Option[ak::View]::Some(cv) => { cv.add_subview(ak::View::from_raw(v)); }
        option::Option[ak::View]::None => { assert false; }
    }
    { rt::msg_void_rect(v, rt::sel(#str_ptr("setFrame:\0")),
                        rt::Rect { x: 0.0f64, y: 0.0f64, w: 100.0f64, h: 200.0f64 }) };
    geometry::relayout_root(p, 100.0f64, 200.0f64, 1.0f64);
    let doc: *u8 = { rt::msg_id(v, rt::sel(#str_ptr("documentView\0"))) };
    assert compose::row_reorder_armed(doc);
    // Rows are 20 tall. Row 0 lives at doc y 0..20 — window y 180..200 — and
    // row 2 at doc y 40..60, window y 140..160.
    { rt::msg_void_id(doc, rt::sel(#str_ptr("mouseDown:\0")), point_event(10.0f64, 190.0f64)) };
    { rt::msg_void_id(doc, rt::sel(#str_ptr("mouseDragged:\0")), point_event(10.0f64, 150.0f64)) };
    { rt::msg_void_id(doc, rt::sel(#str_ptr("mouseUp:\0")), point_event(10.0f64, 150.0f64)) };
    assert MOVES == (1 as i64);
    match collection::find("ro", within: p) {
        option::Option[collection::Collection]::Some(x) => {
            assert x.reorder_from() == (0 as i64);
            assert x.reorder_to() == (2 as i64);
        }
        option::Option[collection::Collection]::None => { assert false; }
    }
    // Four rows still, in a new order.
    assert core::child_count_of(p) == (4 as usize);
    w.close();
    mount::unmount(p);
    return;
}

#[test]
fn a_press_that_never_moved_is_a_pick_and_not_a_reorder() {
    // Reordering on a press that did not move would shuffle a row every time
    // one was selected.
    backend::install();
    MOVES = 0 as i64;
    var c: core::Node = reorder_collection("ro2", true);
    let p: *core::Node = #addr_of(c);
    assert mount::mount(p);
    let w: ak::Window = window::make_shell_window(screen::Chrome::new(
        title: "reorder2", width: 100.0f64, height: 200.0f64));
    let v: *u8 = core::view_of(p);
    match w.content_view() {
        option::Option[ak::View]::Some(cv) => { cv.add_subview(ak::View::from_raw(v)); }
        option::Option[ak::View]::None => { assert false; }
    }
    { rt::msg_void_rect(v, rt::sel(#str_ptr("setFrame:\0")),
                        rt::Rect { x: 0.0f64, y: 0.0f64, w: 100.0f64, h: 200.0f64 }) };
    geometry::relayout_root(p, 100.0f64, 200.0f64, 1.0f64);
    let doc: *u8 = { rt::msg_id(v, rt::sel(#str_ptr("documentView\0"))) };
    // Down on row 0 and up on row 2 with NO drag between. AppKit would send
    // one, so this is the guard on its own: without it a press that merely
    // ended somewhere else would shuffle the row it started on.
    { rt::msg_void_id(doc, rt::sel(#str_ptr("mouseDown:\0")), point_event(10.0f64, 190.0f64)) };
    { rt::msg_void_id(doc, rt::sel(#str_ptr("mouseUp:\0")), point_event(10.0f64, 150.0f64)) };
    assert MOVES == (0 as i64);
    assert core::child_count_of(p) == (4 as usize);
    w.close();
    mount::unmount(p);
    return;
}

#[test]
fn a_collection_that_does_not_reorder_is_not_armed_for_it() {
    backend::install();
    var c: core::Node = collection::collection(key: "ro3");
    let p: *core::Node = #addr_of(c);
    let v: *u8 = views::create(0 as *u8, p);
    core::set_view(p, v, views::view_release);
    let doc: *u8 = { rt::msg_id(v, rt::sel(#str_ptr("documentView\0"))) };
    assert compose::row_reorder_armed(doc) == false;
    return;
}

#[test]
fn without_mix_groups_a_row_stays_in_the_group_it_started_in() {
    // Which is what makes a grouped sequence stay grouped.
    backend::install();
    MOVES = 0 as i64;
    let h: fn(*u8, *u8) = on_moved;
    var c: core::Node = collection::collection(key: "ro4", grouped: true,
                                               reorder_items: true, mix_groups: false,
                                               on_reorder_completed: h);
    let p: *core::Node = #addr_of(c);
    match collection::find("ro4", within: p) {
        option::Option[collection::Collection]::Some(x) => {
            let a: collection::Collection = x.set_row(g_row, ctx: 0 as *u8);
            let b: collection::Collection = a.set_count(5 as usize);
            let d: collection::Collection = b.set_group_count(2 as usize);
            let _e: collection::Collection = d.set_group(g_size, g_header, ctx: 0 as *u8);
        }
        option::Option[collection::Collection]::None => { assert false; }
    }
    assert mount::mount(p);
    let w: ak::Window = window::make_shell_window(screen::Chrome::new(
        title: "reorder3", width: 100.0f64, height: 200.0f64));
    let v: *u8 = core::view_of(p);
    match w.content_view() {
        option::Option[ak::View]::Some(cv) => { cv.add_subview(ak::View::from_raw(v)); }
        option::Option[ak::View]::None => { assert false; }
    }
    { rt::msg_void_rect(v, rt::sel(#str_ptr("setFrame:\0")),
                        rt::Rect { x: 0.0f64, y: 0.0f64, w: 100.0f64, h: 200.0f64 }) };
    geometry::relayout_root(p, 100.0f64, 200.0f64, 1.0f64);
    let doc: *u8 = { rt::msg_id(v, rt::sel(#str_ptr("documentView\0"))) };
    // Child 1 is group 0's first row (doc y 10..30, window 170..190); child 4
    // is group 1's first (doc y 60..80, window 120..140). Different groups.
    { rt::msg_void_id(doc, rt::sel(#str_ptr("mouseDown:\0")), point_event(10.0f64, 180.0f64)) };
    { rt::msg_void_id(doc, rt::sel(#str_ptr("mouseDragged:\0")), point_event(10.0f64, 130.0f64)) };
    { rt::msg_void_id(doc, rt::sel(#str_ptr("mouseUp:\0")), point_event(10.0f64, 130.0f64)) };
    assert MOVES == (0 as i64);
    w.close();
    mount::unmount(p);
    return;
}

#[test]
fn associated_keys_are_distinct_and_out_of_the_bindgens_range() {
    // An associated key is per-OBJECT, so an overlap is silent until the day
    // two of them land on the same object — which happened once already in this
    // package (text_input and recycler both at 28730) and was caught by a
    // failing test rather than by anything saying so.
    //
    // Two rules, and this holds both. Every key facet_appkit defines is
    // distinct; and all of them are 29000 or above, because 28xxx is where
    // `cpc-bindgen` allocates the generated binding's delegate keys from —
    // appkit.cplus is already at 28733 and grows with the SDK.
    var keys: vec::Vec[i64] = vec::new::[i64]();
    let _a: status::Status = keys.append({ drawing::canvas_node_key() as i64 });
    let _b: status::Status = keys.append({ input::node_key() as i64 });
    let _c: status::Status = keys.append({ webmod::scheme_node_key() as i64 });
    let _d: status::Status = keys.append({ recycler::source_key() as i64 });
    let _e: status::Status = keys.append({ dialogs::alert_host_key() as i64 });
    let _f: status::Status = keys.append({ text_input::node_key() as i64 });
    let _g: status::Status = keys.append({ text_input::delegate_pin_key() as i64 });
    let _h: status::Status = keys.append({ scrolling::node_key() as i64 });
    let _i: status::Status = keys.append({ controls::stroke_layer_key() as i64 });
    let _j: status::Status = keys.append({ compose::align_key() as i64 });
    let _k: status::Status = keys.append({ compose::strip_key() as i64 });
    let _l: status::Status = keys.append({ compose::popover_key() as i64 });
    let _m: status::Status = keys.append({ compose::select_node_key() as i64 });
    let _n: status::Status = keys.append({ compose::drag_from_key() as i64 });
    var i: usize = 0 as usize;
    while i < keys.count() {
        let a: i64 = key_at(keys, i);
        assert a >= (29000 as i64);
        var j: usize = i + (1 as usize);
        while j < keys.count() {
            assert a != key_at(keys, j);
            j = j + (1 as usize);
        }
        i = i + (1 as usize);
    }
    return;
}

fn key_at(v: vec::Vec[i64], i: usize) -> i64 {
    return match v.at(i) {
        option::Option[i64]::Some(x) => x,
        option::Option[i64]::None => 0 as i64,
    };
}

#[test]
fn a_tab_strip_lives_in_the_nodes_padding_so_flex_knows_it_is_there() {
    // The half that made NSTabView unworkable: flex laid a pane out against the
    // TABS node's whole box, and the strip had already been spent out of it.
    // Padding is how flex is TOLD — the same mechanism a table's style and a
    // tree's indentation already use — so a pane starts below the strip and the
    // ordinary walk places it.
    backend::install();
    var t: core::Node = tabs::tabs(key: "tabs2");
    var pane: core::Node = core::column(core::Builder::new(), key: "Settings");
    var row: core::Node = box_view::box(color: vocab::Color::rgba(1.0f64, 0.0f64, 0.0f64), key: "r");
    row.set_height(flex::StyleLength::points(20.0f64));
    pane.add_child(row);
    t.add_child(pane);
    let p: *core::Node = #addr_of(t);
    assert mount::mount(p);
    let v: *u8 = core::view_of(p);
    { rt::msg_void_rect(v, rt::sel(#str_ptr("setFrame:\0")),
                        rt::Rect { x: 0.0f64, y: 0.0f64, w: 200.0f64, h: 200.0f64 }) };
    geometry::relayout_root(p, 200.0f64, 200.0f64, 1.0f64);
    // The pane begins BELOW the strip, in the node's own coordinates.
    match core::child_of(p, 0 as usize) {
        option::Option[*core::Node]::Some(c) => { assert { (*c).frame() }.top >= 28.0f64; }
        option::Option[*core::Node]::None => { assert false; }
    }
    // And the host is FLIPPED, which NSTabView never was — the walk's top-left
    // arithmetic measured every pane's y from the wrong edge on that one.
    assert ak::View::from_raw(v).is_flipped();
    mount::unmount(p);
    return;
}

#[test]
fn only_the_selected_tabs_pane_is_in_the_layout() {
    // `hidden` would leave the others stacked in the layout and give the
    // showing one a fraction of the space. `display: none` is flex's own word
    // for out-of-layout, and it is what `switch_to` already uses.
    backend::install();
    var t: core::Node = tabs::tabs(key: "tabs3");
    t.add_child(tab_pane("One"));
    t.add_child(tab_pane("Two"));
    let p: *core::Node = #addr_of(t);
    assert mount::mount(p);
    let v: *u8 = core::view_of(p);
    { rt::msg_void_rect(v, rt::sel(#str_ptr("setFrame:\0")),
                        rt::Rect { x: 0.0f64, y: 0.0f64, w: 200.0f64, h: 200.0f64 }) };
    geometry::relayout_root(p, 200.0f64, 200.0f64, 1.0f64);
    assert pane_height(p, 0 as usize) > 0.0f64;
    assert pane_height(p, 1 as usize) == 0.0f64;
    // Switching moves the whole box to the other pane.
    core::clear_dirty(p);
    match tabs::find("tabs3", within: p) {
        option::Option[tabs::Tabs]::Some(h) => { let _x: tabs::Tabs = h.set_selected_index(1 as i64); }
        option::Option[tabs::Tabs]::None => { assert false; }
    }
    views::apply(0 as *u8, p);
    geometry::relayout_root(p, 200.0f64, 200.0f64, 1.0f64);
    assert pane_height(p, 0 as usize) == 0.0f64;
    assert pane_height(p, 1 as usize) > 0.0f64;
    mount::unmount(p);
    return;
}

static TAB_CHANGES: i64 = 0 as i64;
fn on_tab(sender: *u8, ctx: *u8) { TAB_CHANGES = TAB_CHANGES + (1 as i64); return; }

#[test]
fn clicking_a_tab_switches_it_and_reports_the_change() {
    // An agent has no hands, and a tab strip it cannot switch is a strip it
    // cannot use — `selected_index` is that switch, and MAUI declared no such
    // verb because `CurrentPage` lives on a type outside the manifest slice.
    backend::install();
    TAB_CHANGES = 0 as i64;
    let h: fn(*u8, *u8) = on_tab;
    var t: core::Node = tabs::tabs(key: "tabs4", on_tab_changed: h);
    t.add_child(tab_pane("One"));
    t.add_child(tab_pane("Two"));
    let p: *core::Node = #addr_of(t);
    assert mount::mount(p);
    let v: *u8 = core::view_of(p);
    let strip: *u8 = controls::tab_strip_of(v);
    let tabs_in: vec::Vec[ak::View] = ak::View::from_raw(strip).subviews();
    assert tabs_in.count() == (2 as usize);
    match tabs_in.at_ptr(1 as usize) {
        option::Option[*ak::View]::Some(b) => { send_action({ (*b).raw() }); }
        option::Option[*ak::View]::None => { assert false; }
    }
    assert TAB_CHANGES == (1 as i64);
    match tabs::find("tabs4", within: p) {
        option::Option[tabs::Tabs]::Some(x) => { assert x.selected_index() == (1 as i64); }
        option::Option[tabs::Tabs]::None => { assert false; }
    }
    mount::unmount(p);
    return;
}

#[test]
fn the_five_bar_colours_reach_the_strip_facet_draws() {
    // They were unreachable for one reason — NSTabView drew the strip — and it
    // is not the reason they were recorded under. The strip is ours now.
    backend::install();
    var t: core::Node = tabs::tabs(key: "tabs5",
        bar_background_color: vocab::Color::rgba(0.1f64, 0.1f64, 0.1f64),
        bar_text_color: vocab::Color::rgba(1.0f64, 1.0f64, 1.0f64),
        selected_tab_color: vocab::Color::rgba(0.0f64, 0.4f64, 0.9f64),
        unselected_tab_color: vocab::Color::rgba(0.3f64, 0.3f64, 0.3f64));
    t.add_child(tab_pane("One"));
    t.add_child(tab_pane("Two"));
    let p: *core::Node = #addr_of(t);
    assert mount::mount(p);
    let v: *u8 = core::view_of(p);
    let strip: *u8 = controls::tab_strip_of(v);
    assert ak::View::from_raw(strip).wants_layer();
    assert { rt::msg_id(ak::View::from_raw(strip).layer().raw(),
                        rt::sel(#str_ptr("backgroundColor\0"))) } != (0 as *u8);
    let tabs_in: vec::Vec[ak::View] = ak::View::from_raw(strip).subviews();
    // Both tabs are filled, and the selected one differently from the other.
    match tabs_in.at_ptr(0 as usize) {
        option::Option[*ak::View]::Some(b) => {
            assert { (*b).wants_layer() };
            // The text colour landed as an attributed title, because NSButton
            // has no setTextColor:.
            assert { rt::msg_id({ (*b).raw() }, rt::sel(#str_ptr("attributedTitle\0"))) } != (0 as *u8);
        }
        option::Option[*ak::View]::None => { assert false; }
    }
    mount::unmount(p);
    return;
}

fn tab_pane(key: str) -> core::Node {
    var pane: core::Node = core::column(core::Builder::new(), key: key);
    var row: core::Node = box_view::box(color: vocab::Color::rgba(0.5f64, 0.5f64, 0.5f64));
    row.set_height(flex::StyleLength::points(20.0f64));
    pane.add_child(row);
    return pane;
}

fn pane_height(p: *core::Node, i: usize) -> f64 {
    match core::child_of(p, i) {
        option::Option[*core::Node]::Some(c) => { return { (*c).frame() }.height; }
        option::Option[*core::Node]::None => { return -1.0f64; }
    }
    return -1.0f64;
}

fn match_child(p: *core::Node, i: usize) -> *core::Node {
    return match core::child_of(p, i) {
        option::Option[*core::Node]::Some(c) => c,
        option::Option[*core::Node]::None => 0 as *core::Node,
    };
}


// ---- a collection that binds instead of rebuilding ----------------------------
// "Collection does not recycle by design; nothing to bind INTO" is true about
// RECYCLING and was standing in for the whole verb. A collection materialises
// every row, so there is always something to bind into — what it does not do is
// REUSE a row for a different index as it scrolls.

static BUILT: i64 = 0 as i64;
static BOUND: i64 = 0 as i64;
static LABELS: i64 = 0 as i64;

fn b_row(ctx: *u8, i: usize) -> flex::Node {
    BUILT = BUILT + (1 as i64);
    var col: core::Node = core::column(core::Builder::new(), key: "row");
    col.set_height(flex::StyleLength::points(20.0f64));
    col.add_child(label::label("old", key: "title"));
    return col;
}

fn b_bind(ctx: *u8, i: usize, row: *core::Node) {
    BOUND = BOUND + (1 as i64);
    match label::find("title", within: row) {
        option::Option[label::Label]::Some(l) => { let _x: label::Label = l.set_text("new"); }
        option::Option[label::Label]::None => { }
    }
    return;
}

fn bind_collection(key: str) -> core::Node {
    var c: core::Node = collection::collection(key: key);
    let p: *core::Node = #addr_of(c);
    match collection::find(key, within: p) {
        option::Option[collection::Collection]::Some(x) => {
            let a: collection::Collection = x.set_row(b_row, ctx: 0 as *u8);
            let b: collection::Collection = a.set_row_bind(b_bind, ctx: 0 as *u8);
            let _d: collection::Collection = b.set_count(3 as usize);
        }
        option::Option[collection::Collection]::None => { }
    }
    return c;
}

#[test]
fn a_collection_with_a_bind_writes_into_the_rows_it_already_has() {
    backend::install();
    BUILT = 0 as i64;
    BOUND = 0 as i64;
    var c: core::Node = bind_collection("bc");
    let p: *core::Node = #addr_of(c);
    assert mount::mount(p);
    // The first pass BUILDS, because there is nothing to bind into yet.
    assert BUILT == (3 as i64);
    assert core::child_count_of(p) == (3 as usize);
    let first_built: i64 = BUILT;

    // Same count, new data: the rows are written into, not rebuilt.
    core::clear_dirty(p);
    core::touch(p, collection::P_ROW);
    views::apply(0 as *u8, p);
    assert BUILT == first_built;
    assert BOUND == (3 as i64);
    assert core::child_count_of(p) == (3 as usize);
    // And the write REACHED the row's label, which is the half a prop write
    // alone would not do — a bind marks nodes dirty and touches nothing native.
    assert bound_title(p, 0 as usize) == "new";
    mount::unmount(p);
    return;
}

fn bound_title(p: *core::Node, i: usize) -> text::Text {
    match core::child_of(p, i) {
        option::Option[*core::Node]::Some(row) => {
            match label::find("title", within: row) {
                option::Option[label::Label]::Some(l) => {
                    let v: *u8 = core::view_of(l.node());
                    if v == (0 as *u8) { return text::new(); }
                    return text::from_str(ak::Control::from_raw(v).string_value().view());
                }
                option::Option[label::Label]::None => { return text::new(); }
            }
        }
        option::Option[*core::Node]::None => { return text::new(); }
    }
    return text::new();
}

#[test]
fn a_count_that_changed_rebuilds_because_a_bind_cannot_say_that() {
    // A mismatch means the SHAPE changed, and a bind writes data rather than
    // structure.
    backend::install();
    BUILT = 0 as i64;
    BOUND = 0 as i64;
    var c: core::Node = bind_collection("bc2");
    let p: *core::Node = #addr_of(c);
    assert mount::mount(p);
    let after_first: i64 = BUILT;
    core::clear_dirty(p);
    match collection::find("bc2", within: p) {
        option::Option[collection::Collection]::Some(x) => { let _y: collection::Collection = x.set_count(5 as usize); }
        option::Option[collection::Collection]::None => { assert false; }
    }
    views::apply(0 as *u8, p);
    assert BUILT > after_first;
    assert BOUND == (0 as i64);
    assert core::child_count_of(p) == (5 as usize);
    mount::unmount(p);
    return;
}

#[test]
fn a_collection_with_no_bind_rebuilds_as_it_always_did() {
    backend::install();
    ROWS_BUILT = 0;
    var c: core::Node = collection::collection(key: "bc3");
    let p: *core::Node = #addr_of(c);
    match collection::find("bc3", within: p) {
        option::Option[collection::Collection]::Some(x) => {
            let a: collection::Collection = x.set_row(t_row, ctx: 0 as *u8);
            let _b: collection::Collection = a.set_count(3 as usize);
        }
        option::Option[collection::Collection]::None => { assert false; }
    }
    assert mount::mount(p);
    let after_first: i32 = ROWS_BUILT;
    core::clear_dirty(p);
    core::touch(p, collection::P_ROW);
    views::apply(0 as *u8, p);
    assert ROWS_BUILT > after_first;
    mount::unmount(p);
    return;
}

#[test]
fn a_picker_that_asks_for_a_kern_gets_it_and_stands_down_to_be_edited() {
    // The cell's own content hook was tried first and MEASURED: NSDatePickerCell
    // does not route through `drawInteriorWithFrame:inView:`, the same way
    // NSPopUpButtonCell does not route through `drawingRectForBounds:`. So the
    // kerned text is an overlay with the cell's own text made transparent under
    // it — and the overlay stands down the moment the picker takes first
    // responder, or it would be a field you cannot see while typing in it.
    backend::install();
    var plain: core::Node = date_picker::date_picker(
        vocab::Date { year: 2026 as i64, month: 8 as i64, day: 5 as i64 }, key: "dk0");
    let pv: *u8 = views::create(0 as *u8, #addr_of(plain));
    assert compose::kern_overlay_of(pv) == (0 as *u8);

    var kerned: core::Node = date_picker::date_picker(
        vocab::Date { year: 2026 as i64, month: 8 as i64, day: 5 as i64 },
        key: "dk1", character_spacing: 3.0f64);
    let kv: *u8 = views::create(0 as *u8, #addr_of(kerned));
    let label: *u8 = compose::kern_overlay_of(kv);
    assert label != (0 as *u8);
    assert compose::kern_overlay_showing(kv);
    // It shows what the picker shows, kerned.
    let a: *u8 = { rt::msg_id(label, rt::sel(#str_ptr("attributedStringValue\0"))) };
    assert { rt::msg_u64(a, rt::sel(#str_ptr("length\0"))) } > (0 as u64);
    let attrs: *u8 = { msg_attrs_at(a, rt::sel(#str_ptr("attributesAtIndex:effectiveRange:\0")),
                                    0 as u64, 0 as *u8) };
    assert { rt::msg_id_id(attrs, rt::sel(#str_ptr("objectForKey:\0")),
                           bridge::nsstring("NSKern")) } != (0 as *u8);
    // And the cell's own text is out of the way while the overlay is up.
    let cell: *u8 = { rt::msg_id(kv, rt::sel(#str_ptr("cell\0"))) };
    assert alpha_of({ rt::msg_id(cell, rt::sel(#str_ptr("textColor\0"))) }) == 0.0f64;
    // Editing: the real text comes back and the overlay goes away.
    { rt::msg_i8(kv, rt::sel(#str_ptr("becomeFirstResponder\0"))) };
    assert compose::kern_overlay_showing(kv) == false;
    assert alpha_of({ rt::msg_id(cell, rt::sel(#str_ptr("textColor\0"))) }) > 0.0f64;
    { rt::msg_i8(kv, rt::sel(#str_ptr("resignFirstResponder\0"))) };
    assert compose::kern_overlay_showing(kv);
    views::view_release(pv);
    views::view_release(kv);
    return;
}

fn alpha_of(c: *u8) -> f64 {
    if c == (0 as *u8) { return 1.0f64; }
    let space: *u8 = { rt::msg_id(rt::get_class(#str_ptr("NSColorSpace\0")),
                                  rt::sel(#str_ptr("sRGBColorSpace\0"))) };
    let rgb: *u8 = { rt::msg_id_id(c, rt::sel(#str_ptr("colorUsingColorSpace:\0")), space) };
    if rgb == (0 as *u8) { return 1.0f64; }
    return { rt::msg_f64(rgb, rt::sel(#str_ptr("alphaComponent\0"))) };
}



#[test]
fn a_toggle_that_names_an_achromatic_colour_is_drawn_and_still_a_switch() {
    // `on_color` is a hue rotation over NSSwitch's own drawing. `off_color` and
    // `thumb_color` cannot be — the off track is grey and the thumb is white,
    // and a hue rotation has nothing to rotate, which is the same fact that
    // makes the other four tints correct. So naming either DRAWS the switch,
    // and naming neither keeps NSSwitch and everything NSSwitch has.
    backend::install();
    var plain: core::Node = toggle::toggle(true, key: "tw0");
    let pv: *u8 = views::create(0 as *u8, #addr_of(plain));
    // NSSwitch hands back a private subclass of its own, so the claim is the
    // one that matters: a toggle that named nothing is not the drawn one.
    assert synth::object_class(pv) != rt::get_class(#str_ptr("FacetSwitch\0"));
    assert { rt::msg_i8_id(pv, rt::sel(#str_ptr("isKindOfClass:\0")),
                           rt::get_class(#str_ptr("NSSwitch\0"))) } != (0 as i8);

    var drawn: core::Node = toggle::toggle(true, key: "tw1",
        off_color: vocab::Color::rgba(0.8f64, 0.8f64, 0.8f64),
        thumb_color: vocab::Color::rgba(1.0f64, 0.9f64, 0.0f64));
    let p: *core::Node = #addr_of(drawn);
    let dv: *u8 = views::create(0 as *u8, p);
    core::set_view(p, dv, views::view_release);
    assert synth::object_class(dv) == rt::get_class(#str_ptr("FacetSwitch\0"));
    // Every caller that already speaks to a toggle keeps working: `state`
    // answers, and it answers what the description said.
    assert { rt::msg_i64(dv, rt::sel(#str_ptr("state\0"))) } == (1 as i64);
    { rt::msg_void_i64(dv, rt::sel(#str_ptr("setState:\0")), 0 as i64) };
    assert { rt::msg_i64(dv, rt::sel(#str_ptr("state\0"))) } == (0 as i64);
    // A click toggles it and the write-back runs, the same as an NSSwitch's.
    { rt::msg_void_id(dv, rt::sel(#str_ptr("mouseDown:\0")), mouse_event(1 as u64, 1 as i64)) };
    assert { rt::msg_i64(dv, rt::sel(#str_ptr("state\0"))) } == (1 as i64);
    match toggle::find("tw1", within: p) {
        option::Option[toggle::Toggle]::Some(h) => {
            assert h.on();
        }
        option::Option[toggle::Toggle]::None => { assert false; }
    }
    // It takes the keyboard, and a screen reader can see it.
    assert { rt::msg_i8(dv, rt::sel(#str_ptr("acceptsFirstResponder\0"))) } != (0 as i8);
    assert bridge::to_text({ rt::msg_id(dv, rt::sel(#str_ptr("accessibilityRole\0"))) }) == "AXCheckBox";
    views::view_release(pv);
    return;
}

#[test]
fn a_drawn_switch_moves_its_thumb_with_its_state() {
    // The animation is the only part of NSSwitch that cannot be re-derived from
    // its state, so the thumb's POSITION is what this holds: a switch that
    // teleports reads as a checkbox, and one that never moves reads as broken.
    backend::install();
    var drawn: core::Node = toggle::toggle(false, key: "tw2",
        off_color: vocab::Color::rgba(0.8f64, 0.8f64, 0.8f64));
    let p: *core::Node = #addr_of(drawn);
    let v: *u8 = views::create(0 as *u8, p);
    core::set_view(p, v, views::view_release);
    let off_x: f64 = thumb_x(v);
    { rt::msg_void_i64(v, rt::sel(#str_ptr("setState:\0")), 1 as i64) };
    let on_x: f64 = thumb_x(v);
    assert on_x > off_x;
    return;
}

fn thumb_x(v: *u8) -> f64 {
    let layers: vec::Vec[quartz::Layer] = ak::View::from_raw(v).layer().sublayers();
    match layers.at_ptr(1 as usize) {
        option::Option[*quartz::Layer]::Some(l) => {
            let f: rt::Rect = { rt::msg_rect({ (*l).raw() }, rt::sel(#str_ptr("frame\0"))) };
            return f.x;
        }
        option::Option[*quartz::Layer]::None => { return -1.0f64; }
    }
    return -1.0f64;
}

static SW_CHANGING: i64 = 0 as i64;
fn sw_changing(sender: *u8, ctx: *u8) { SW_CHANGING = SW_CHANGING + (1 as i64); return; }

fn revealing_swipeable(key: str, threshold: f64) -> core::Node {
    let a: fn(*u8, *u8) = sw_clicked;
    var s: core::Node = swipeable::swipeable(key: key, reveal_threshold: threshold,
        observe_swipe_changing: sw_changing, on_swipe_started: sw_started,
        on_swipe_ended: sw_ended, on_open_requested: sw_opened,
        on_close_requested: sw_closed);
    s.add_child(swipe_item::swipe_item(text: "Archive"));
    s.add_child(swipe_item::swipe_item(text: "Delete", destructive: true, on_clicked: a));
    return s;
}

#[test]
fn a_swipe_reveals_a_strip_and_the_threshold_decides_whether_it_stays() {
    // The menu is the click path an agent has and is untouched. A trackpad has
    // the CONTINUOUS motion the other two verbs describe, so the content slides
    // and the strip behind it comes into view.
    backend::install();
    SW_CHANGING = 0 as i64;
    SWIPE_STARTS = 0 as i64;
    SWIPE_ENDS = 0 as i64;
    SWIPE_OPENS = 0 as i64;
    SWIPE_CLOSES = 0 as i64;
    var s: core::Node = revealing_swipeable("sr", 40.0f64);
    let p: *core::Node = #addr_of(s);
    assert mount::mount(p);
    let v: *u8 = core::view_of(p);
    { rt::msg_void_rect(v, rt::sel(#str_ptr("setFrame:\0")),
                        rt::Rect { x: 0.0f64, y: 0.0f64, w: 300.0f64, h: 44.0f64 }) };
    core::clear_dirty(p);
    core::touch(p, props::C_LAYOUT);
    views::apply(0 as *u8, p);
    // Two actions, from the same children the menu was built from.
    let strip: *u8 = compose::swipe_strip_of(v);
    assert strip != (0 as *u8);
    let actions: vec::Vec[ak::View] = ak::View::from_raw(strip).subviews();
    assert actions.count() == (2 as usize);
    // A short drag springs back: under the threshold is a swipe that did not
    // happen, which is the whole of what `reveal_threshold` names.
    { rt::msg_void_id(v, rt::sel(#str_ptr("mouseDown:\0")), point_event(200.0f64, 20.0f64)) };
    { rt::msg_void_id(v, rt::sel(#str_ptr("mouseDragged:\0")), point_event(180.0f64, 20.0f64)) };
    assert SW_CHANGING > (0 as i64);
    assert SWIPE_STARTS == (1 as i64);
    { rt::msg_void_id(v, rt::sel(#str_ptr("mouseUp:\0")), point_event(180.0f64, 20.0f64)) };
    assert SWIPE_ENDS == (1 as i64);
    assert SWIPE_CLOSES == (1 as i64);
    assert compose::swipe_is_open(v) == false;
    // A long one stays open.
    { rt::msg_void_id(v, rt::sel(#str_ptr("mouseDown:\0")), point_event(200.0f64, 20.0f64)) };
    { rt::msg_void_id(v, rt::sel(#str_ptr("mouseDragged:\0")), point_event(120.0f64, 20.0f64)) };
    { rt::msg_void_id(v, rt::sel(#str_ptr("mouseUp:\0")), point_event(120.0f64, 20.0f64)) };
    assert SWIPE_OPENS == (1 as i64);
    assert compose::swipe_is_open(v);
    mount::unmount(p);
    return;
}

#[test]
fn a_swipeable_still_offers_its_menu_after_gaining_a_strip() {
    // The drag is the same description read a SECOND way — an agent still
    // clicks, and there is no second place to add an action.
    backend::install();
    var s: core::Node = revealing_swipeable("sr2", 40.0f64);
    let p: *core::Node = #addr_of(s);
    assert mount::mount(p);
    let v: *u8 = core::view_of(p);
    let menu: *u8 = { rt::msg_id(v, rt::sel(#str_ptr("menu\0"))) };
    assert menu != (0 as *u8);
    assert { rt::msg_i64(menu, rt::sel(#str_ptr("numberOfItems\0"))) } == (2 as i64);
    mount::unmount(p);
    return;
}

// ---- the soft-keyboard band, read for what it carries besides a layout --------

// A field's editor is the first responder while it is focused, not the field —
// so "is this field focused" is asked of the responder's ancestry.
fn responder_is(w: ak::Window, v: *u8) -> bool {
    match w.first_responder() {
        option::Option[ak::Responder]::Some(r) => {
            if r.raw() == v { return true; }
            return { rt::msg_i8_id(r.raw(), rt::sel(#str_ptr("isDescendantOf:\0")), v) } != (0 as i8);
        }
        option::Option[ak::Responder]::None => { return false; }
    }
    return false;
}

#[test]
fn a_keyboards_flags_reach_the_field_editor_even_though_its_layout_cannot() {
    // `Keyboard` picks an on-screen layout, and macOS has no on-screen keyboard.
    // That is true and is not all a Keyboard carries: it is a layout AND a set
    // of flags, and the flags have exactly one home here — the field editor.
    backend::install();
    var plain: core::Node = text_area::text_area("", key: "kb1",
                                                 keyboard: vocab::Keyboard::Plain);
    let pv: *u8 = views::create(0 as *u8, #addr_of(plain));
    let ptv: *u8 = { rt::msg_id(pv, rt::sel(#str_ptr("documentView\0"))) };
    // Plain is deliberately bare — the one that says "leave my typing alone".
    assert { rt::msg_i8(ptv, rt::sel(#str_ptr("isContinuousSpellCheckingEnabled\0"))) } == (0 as i8);
    assert { rt::msg_i8(ptv, rt::sel(#str_ptr("isAutomaticSpellingCorrectionEnabled\0"))) } == (0 as i8);

    var chat: core::Node = text_area::text_area("", key: "kb2",
                                                keyboard: vocab::Keyboard::Chat);
    let cv: *u8 = views::create(0 as *u8, #addr_of(chat));
    let ctv: *u8 = { rt::msg_id(cv, rt::sel(#str_ptr("documentView\0"))) };
    assert { rt::msg_i8(ctv, rt::sel(#str_ptr("isContinuousSpellCheckingEnabled\0"))) } != (0 as i8);

    // A typed field turns correction off: correcting an address is worse than
    // not correcting it.
    var mail: core::Node = text_area::text_area("", key: "kb3",
                                                keyboard: vocab::Keyboard::Email);
    let mv: *u8 = views::create(0 as *u8, #addr_of(mail));
    let mtv: *u8 = { rt::msg_id(mv, rt::sel(#str_ptr("documentView\0"))) };
    assert { rt::msg_i8(mtv, rt::sel(#str_ptr("isAutomaticSpellingCorrectionEnabled\0"))) } == (0 as i8);
    views::view_release(pv);
    views::view_release(cv);
    views::view_release(mv);
    return;
}

#[test]
fn a_font_that_scales_multiplies_its_size_rather_than_replacing_it() {
    // `font_scales` defaults to TRUE — MAUI's own default — so a version of this
    // that swapped the application's size for a text style's would have
    // rewritten the typography of every app that ever named one. Dynamic Type
    // means the named size is a BASE and the reader's preference is a
    // multiplier, and where no preference is expressed the multiplier is 1.
    backend::install();
    var sized: core::Node = label::label("Hi", key: "fs1", font_size: 30.0f64);
    let sv: *u8 = views::create(0 as *u8, #addr_of(sized));
    match ak::Control::from_raw(sv).font() {
        option::Option[ak::Font]::Some(f) => {
            assert f.point_size() == 30.0f64 * paint::body_scale();
        }
        option::Option[ak::Font]::None => { assert false; }
    }
    // Turning it OFF pins the size whatever the reader prefers.
    var pinned: core::Node = label::label("Hi", key: "fs2", font_size: 30.0f64,
                                          font_scales: false);
    let pv: *u8 = views::create(0 as *u8, #addr_of(pinned));
    match ak::Control::from_raw(pv).font() {
        option::Option[ak::Font]::Some(f) => { assert f.point_size() == 30.0f64; }
        option::Option[ak::Font]::None => { assert false; }
    }
    // A named FAMILY keeps its face either way: the multiplier is on the SIZE.
    var named: core::Node = label::label("Hi", key: "fs3", font_size: 30.0f64,
                                         font_family: "Menlo");
    let nv: *u8 = views::create(0 as *u8, #addr_of(named));
    match ak::Control::from_raw(nv).font() {
        option::Option[ak::Font]::Some(f) => {
            assert f.point_size() == 30.0f64 * paint::body_scale();
            assert f.font_name().view() != "";
        }
        option::Option[ak::Font]::None => { assert false; }
    }
    views::view_release(sv);
    views::view_release(pv);
    views::view_release(nv);
    return;
}

#[test]
fn a_return_key_that_says_next_moves_to_the_next_field() {
    // Five of the six name a LABEL on a keyboard macOS does not have. The sixth
    // names a BEHAVIOUR, and it is the one an application cannot get any other
    // way — `selectNextKeyView:` is the same move on a Mac.
    backend::install();
    let w: ak::Window = window::make_shell_window(screen::Chrome::new(
        title: "next", width: 300.0f64, height: 200.0f64));
    var first: core::Node = text_field::text_field("", key: "rk1",
                                                   return_key: vocab::ReturnKey::Next);
    var second: core::Node = text_field::text_field("", key: "rk2");
    let fp: *core::Node = #addr_of(first);
    let sp: *core::Node = #addr_of(second);
    let fv: *u8 = views::create(0 as *u8, fp);
    let sv: *u8 = views::create(0 as *u8, sp);
    core::set_view(fp, fv, views::view_release);
    core::set_view(sp, sv, views::view_release);
    match w.content_view() {
        option::Option[ak::View]::Some(cv) => {
            cv.add_subview(ak::View::from_raw(fv));
            cv.add_subview(ak::View::from_raw(sv));
        }
        option::Option[ak::View]::None => { assert false; }
    }
    { rt::msg_void_rect(fv, rt::sel(#str_ptr("setFrame:\0")),
                        rt::Rect { x: 0.0f64, y: 100.0f64, w: 200.0f64, h: 24.0f64 }) };
    { rt::msg_void_rect(sv, rt::sel(#str_ptr("setFrame:\0")),
                        rt::Rect { x: 0.0f64, y: 60.0f64, w: 200.0f64, h: 24.0f64 }) };
    { rt::msg_void_id(fv, rt::sel(#str_ptr("setNextKeyView:\0")), sv) };
    w.make_key_and_order_front(0 as *u8);
    let _f: bool = w.make_first_responder(ak::View::from_raw(fv).as_responder());
    // The setup has to have TAKEN, or the assertion below passes for the wrong
    // reason — a window that never focused anything has moved nothing.
    assert responder_is(w, fv);
    // Return, as AppKit delivers it: the control's action.
    send_action(fv);
    // Focus moved to the field the application put after it, which is the whole
    // of what Next means.
    assert responder_is(w, fv) == false;
    assert responder_is(w, sv);
    w.close();
    return;
}

// ---- a DSL-authored root reaches the window ---------------------------------
//
// `@ui { ... }` evaluates to a KEYLESS container holding the block's items —
// keyless because nothing named it, a container because a block may hold two
// items. `views::wants_view` gives such a node no view on purpose (a
// pure-layout column costs nothing), so a screen authored the way the contract
// asks hands `open_window` a root that is a pass-through.
//
// The walk inserts every view except the root's, and the root here has none —
// so before `add_root_views` the children were created, attached, and inserted
// NOWHERE. The window opened empty. These are the two shapes that must both
// land: a backed root, and a pass-through root.

#[test]
fn a_dsl_authored_root_is_mounted_into_the_window() {
    backend::install();
    app::reset_default_for_tests();
    var root: core::Node = @ui {
        vstack(key: "body") {
            label::label("hello", key: "headline")
            button::button("go", key: "go")
        }
    };
    let rp: *core::Node = #addr_of(root);
    // The shape the DSL actually produces — keyless, one child, and by the
    // pass-through rule it will never be backed.
    assert { (*rp).key() } == "";
    assert core::child_count_of(rp) == (1 as usize);

    let win: *u8 = window::open_window(rp, screen::Chrome::new(
        title: "dsl", width: 320.0f64, height: 240.0f64));
    assert win != (0 as *u8);
    assert core::view_of(rp) == (0 as *u8);      // still a pass-through

    // The topmost BACKED node — the vstack — is what the window got.
    match core::find_in(rp, "body") {
        option::Option[*core::Node]::Some(b) => {
            let bv: *u8 = core::view_of(b);
            assert bv != (0 as *u8);
            match ak::View::from_raw(bv).superview() {
                option::Option[ak::View]::Some(sv) => { assert sv.is_flipped(); }
                option::Option[ak::View]::None => { assert false; }
            }
        }
        option::Option[*core::Node]::None => { assert false; }
    }
    // ...and the controls under it are on screen, which is the whole point.
    match label::find("headline", within: rp) {
        option::Option[label::Label]::Some(l) => { assert l.text() == "hello"; }
        option::Option[label::Label]::None => { assert false; }
    }
    window::close_window(win);
    backend::uninstall();
    app::reset_default_for_tests();
    return;
}

#[test]
fn a_pass_through_root_with_two_items_lands_both() {
    // A block MAY hold two items, which is why its value is a container at
    // all. Both have to reach the window, in order.
    backend::install();
    app::reset_default_for_tests();
    var root: core::Node = @ui {
        label::label("one", key: "one")
        label::label("two", key: "two")
    };
    let rp: *core::Node = #addr_of(root);
    assert core::child_count_of(rp) == (2 as usize);
    let win: *u8 = window::open_window(rp, screen::Chrome::new(
        title: "two", width: 320.0f64, height: 240.0f64));
    assert win != (0 as *u8);

    match ak::Window::from_raw(win).content_view() {
        option::Option[ak::View]::Some(content) => {
            // Two labels, plus the appearance-observer sentinel the facade adds.
            assert content.subviews().count() >= (2 as usize);
        }
        option::Option[ak::View]::None => { assert false; }
    }
    match label::find("one", within: rp) {
        option::Option[label::Label]::Some(_l) => { }
        option::Option[label::Label]::None => { assert false; }
    }
    match label::find("two", within: rp) {
        option::Option[label::Label]::Some(_l) => { }
        option::Option[label::Label]::None => { assert false; }
    }
    window::close_window(win);
    backend::uninstall();
    app::reset_default_for_tests();
    return;
}

#[test]
fn a_focused_field_keeps_its_text_across_a_class_flip() {
    // The unit tests above flip a field that is not in a window and not being
    // edited. A real app flips one that IS: `is_secure` is what a "show
    // password" toggle writes, and the field it writes to is the one the user
    // was just typing in. That is a different code path — there is a field
    // editor, a first responder, and a delegate whose write-back can fire
    // while the old object is coming down.
    backend::install();
    app::reset_default_for_tests();
    var n: core::Node = text_field::text_field(key: "pw_live", text: "hunter2", secure: true);
    let p: *core::Node = #addr_of(n);
    let win: *u8 = window::open_window(p, screen::Chrome::new(
        title: "live", width: 320.0f64, height: 200.0f64));
    assert win != (0 as *u8);
    let w: ak::Window = ak::Window::from_raw(win);
    let v: *u8 = core::view_of(p);
    assert v != (0 as *u8);
    // Focus it, the way a user about to toggle "show password" would have.
    w.make_key_and_order_front(0 as *u8);
    let _fr: bool = w.make_first_responder(ak::View::from_raw(v).as_responder());
    core::clear_dirty(p);

    match text_field::from(p) {
        option::Option[text_field::TextField]::Some(f) => { let _f: text_field::TextField = f.set_secure(false); }
        option::Option[text_field::TextField]::None => { assert false; }
    }
    views::apply(0 as *u8, p);

    let sv: *u8 = core::view_of(p);
    assert sv != v;
    assert views::is_kind_of(sv, #str_ptr("NSSecureTextField\0")) == false;
    // The PROP must not have been clobbered by a write-back firing as the old
    // field came down...
    match text_field::from(p) {
        option::Option[text_field::TextField]::Some(f) => { assert f.text() == "hunter2"; }
        option::Option[text_field::TextField]::None => { assert false; }
    }
    // ...and the new field must be showing it.
    assert ak::TextField::from_raw(sv).as_control().string_value().view() == "hunter2";
    window::close_window(win);
    backend::uninstall();
    app::reset_default_for_tests();
    return;
}

#[test]
fn a_reclassed_view_is_still_addressable_and_still_measures() {
    // The replacement must be a view `create` made, not one a kind builder
    // made. Building it with `controls::create_text_field` alone produced a
    // field that LOOKED right and had lost everything create adds around the
    // kind body: the accessibility identifier that is the key (so the agent
    // surface could no longer see it), and the intrinsic-size measure (so flex
    // would lay it out at zero height). Both are asserted because both were
    // missing, and neither shows up in a screenshot.
    backend::install();
    var n: core::Node = text_field::text_field(key: "addressable", text: "x");
    let p: *core::Node = #addr_of(n);
    let v: *u8 = views::create(0 as *u8, p);
    core::set_view(p, v, views::view_release);
    let host: ak::View = akx::new_flipped_view(rt::Rect { x: 0.0f64, y: 0.0f64, w: 300.0f64, h: 200.0f64 });
    host.add_subview(ak::View::from_raw(v));
    assert ak::Accessibility::from_raw(v).accessibility_identifier().view() == "addressable";
    core::clear_dirty(p);

    match text_field::from(p) {
        option::Option[text_field::TextField]::Some(f) => { let _f: text_field::TextField = f.set_secure(true); }
        option::Option[text_field::TextField]::None => { assert false; }
    }
    views::apply(0 as *u8, p);

    let sv: *u8 = core::view_of(p);
    assert sv != v;
    // The key still addresses it — this is what the agent surface reads.
    assert ak::Accessibility::from_raw(sv).accessibility_identifier().view() == "addressable";
    // And flex still has a measure pointing at the NEW view, so the field does
    // not collapse to nothing on the next layout pass.
    assert { (*p).context() } == sv;
    return;
}

// ---- the two shared-band carriers Stage 4 ended without ----------------------

#[test]
fn a_background_image_is_the_layers_contents_not_a_subview() {
    // A subview would be a child facet did not put in the tree: the frame walk
    // would not know it, and `insert` would count it as a slot — every index
    // below the node off by one. So the picture is the LAYER's.
    backend::install();
    var n: core::Node = box_view::box(color: vocab::Color::rgba(0.0f64, 0.0f64, 0.0f64, 0.0f64), key: "bg");
    let p: *core::Node = #addr_of(n);
    core::set_background_image(p, "gear");
    let v: *u8 = views::create(0 as *u8, p);
    assert v != (0 as *u8);
    let view: ak::View = ak::View::from_raw(v);
    assert view.wants_layer();
    assert { rt::msg_id(view.layer().raw(), rt::sel(#str_ptr("contents\0"))) } != (0 as *u8);
    // It did NOT become a child.
    assert view.subviews().count() == (0 as usize);
    // And the reader answers what was written.
    assert core::background_image(p) == "gear";
    views::view_release(v);
    return;
}

#[test]
fn a_background_image_can_be_taken_away_again() {
    backend::install();
    var n: core::Node = box_view::box(color: vocab::Color::rgba(0.0f64, 0.0f64, 0.0f64, 0.0f64), key: "bg2");
    let p: *core::Node = #addr_of(n);
    core::set_background_image(p, "gear");
    let v: *u8 = views::create(0 as *u8, p);
    core::set_view(p, v, views::view_release);
    core::clear_dirty(p);
    core::set_background_image(p, "");
    views::apply(0 as *u8, p);
    assert { rt::msg_id(ak::View::from_raw(v).layer().raw(), rt::sel(#str_ptr("contents\0"))) } == (0 as *u8);
    return;
}

#[test]
fn an_empty_background_image_does_not_buy_a_layer() {
    // The same care `is_opaque` takes: a node with no picture must not pay a
    // backing store to say so.
    backend::install();
    var n: core::Node = image::image("gear", key: "noflayer");
    let v: *u8 = views::create(0 as *u8, #addr_of(n));
    assert ak::View::from_raw(v).wants_layer() == false;
    views::view_release(v);
    return;
}

#[test]
fn safe_area_is_on_every_node_and_only_none_opts_out() {
    // The carrier the three deferred Page rows wanted. `scroll` had one and
    // nothing else could, which is why they had no answer.
    var n: core::Node = core::column(core::Builder::new(), key: "page");
    let p: *core::Node = #addr_of(n);
    // Default keeps clear, which is what a page wants without being asked.
    match core::safe_area(p) {
        vocab::SafeArea::Default => { }
        _other => { assert false; }
    }
    assert core::honours_safe_area(p);
    core::set_safe_area(p, vocab::SafeArea::None);
    assert core::honours_safe_area(p) == false;
    core::set_safe_area(p, vocab::SafeArea::All);
    assert core::honours_safe_area(p);
    return;
}

#[test]
fn a_safe_area_write_asks_for_a_layout_pass_as_well_as_its_own_bit() {
    // The value is GEOMETRY: without C_LAYOUT the inset would sit in the props
    // and never reach the screen, because nothing would re-run the pass.
    var n: core::Node = core::column(core::Builder::new(), key: "page2");
    let p: *core::Node = #addr_of(n);
    core::clear_dirty(p);
    core::set_safe_area(p, vocab::SafeArea::None);
    let d: u64 = core::dirty_of(p);
    assert (d & props::C_SAFE_AREA) != (0 as u64);
    assert (d & props::C_LAYOUT) != (0 as u64);
    return;
}

#[test]
fn a_window_root_that_opts_out_of_the_safe_area_gets_the_whole_content_view() {
    // The behavioural end of it. A test cannot make macOS report a non-zero
    // safe area on demand, so what is asserted is the half that is facet's:
    // opting out lays the root out at the content view's full size, and the
    // default path agrees with it whenever the insets are zero (which is the
    // ordinary windowed case).
    backend::install();
    app::reset_default_for_tests();
    var root: core::Node = core::column(core::Builder::new(), key: "sa_root");
    let rp: *core::Node = #addr_of(root);
    core::set_safe_area(rp, vocab::SafeArea::None);
    let win: *u8 = window::open_window(rp, screen::Chrome::new(
        title: "sa", width: 300.0f64, height: 200.0f64));
    assert win != (0 as *u8);
    scheduler::layout_window(rp);
    let rv: *u8 = core::view_of(rp);
    assert rv != (0 as *u8);
    let f: rt::Rect = ak::View::from_raw(rv).frame();
    match ak::Window::from_raw(win).content_view() {
        option::Option[ak::View]::Some(content) => {
            let c: rt::Rect = content.frame();
            assert f.x == 0.0f64;
            assert f.y == 0.0f64;
            assert f.w == c.w;
            assert f.h == c.h;
        }
        option::Option[ak::View]::None => { assert false; }
    }
    window::close_window(win);
    backend::uninstall();
    app::reset_default_for_tests();
    return;
}

// ---- pinch zoom: Chrome.zoomable finally reaches something -------------------
//
// The three Chrome fields had been declared since the runtime tier and NOTHING
// read them — a window asking to zoom got a window that did not. Neither gate
// could see it: verb_coverage counts per-CONTROL prop bits and these are on
// Chrome, guard 5b counts MAUI tier rows and `zoomable` is facet's own word.

#[test]
fn zoom_target_compounds_from_the_base_and_clamps() {
    // The recognizer reports magnification CUMULATIVELY since the gesture
    // began, so the target is base * (1 + m).
    assert zoom::zoom_target(1.0f64, 0.0f64, 1.0f64, 4.0f64) == 1.0f64;
    assert zoom::zoom_target(1.0f64, 1.0f64, 1.0f64, 4.0f64) == 2.0f64;
    // A second pinch compounds from where the first left off rather than
    // restarting at 1.
    assert zoom::zoom_target(2.0f64, 0.5f64, 1.0f64, 4.0f64) == 3.0f64;
    // Both ends clamp.
    assert zoom::zoom_target(1.0f64, 10.0f64, 1.0f64, 4.0f64) == 4.0f64;
    assert zoom::zoom_target(1.0f64, 0.0f64 - 0.9f64, 1.0f64, 4.0f64) == 1.0f64;
    return;
}

#[test]
fn a_nan_magnification_leaves_the_picture_alone() {
    // A gesture stream that reports NaN must not amplify anything. The clamp is
    // written as a failed `>` so NaN collapses to the floor instead of passing
    // through as "in range".
    let nan: f64 = 0.0f64 / 0.0f64;
    assert zoom::zoom_target(2.0f64, nan, 1.0f64, 4.0f64) == 2.0f64;
    assert zoom::pan_origin(7.0f64, nan, 2.0f64) == 7.0f64;
    // A degenerate zoom cannot divide the delta.
    assert zoom::pan_origin(7.0f64, 3.0f64, 0.0f64) == 7.0f64;
    return;
}

#[test]
fn a_degenerate_zoom_range_is_healed_not_inverted() {
    // `max_zoom: 0` should give a window that does not zoom, never one that
    // inverts.
    assert zoom::heal_min(0.0f64) == 1.0f64;
    assert zoom::heal_min(0.0f64 - 2.0f64) == 1.0f64;
    assert zoom::heal_min(2.0f64) == 2.0f64;
    assert zoom::heal_max(1.0f64, 0.0f64) == 1.0f64;   // locked at min
    assert zoom::heal_max(2.0f64, 8.0f64) == 8.0f64;
    return;
}

#[test]
fn the_anchor_keeps_its_fraction_of_the_visible_span() {
    // Zooming about a point means that point does not move. At the left edge
    // the origin stays; at the centre it moves by half the difference.
    assert zoom::zoom_origin(0.0f64, 0.0f64, 100.0f64, 50.0f64) == 0.0f64;
    assert zoom::zoom_origin(50.0f64, 0.0f64, 100.0f64, 50.0f64) == 25.0f64;
    // A degenerate span cannot have a fraction of it.
    assert zoom::zoom_origin(50.0f64, 0.0f64, 0.0f64, 50.0f64) == 0.0f64;
    return;
}

#[test]
fn a_zoomable_window_installs_and_a_plain_one_does_not() {
    backend::install();
    app::reset_default_for_tests();
    zoom::reset_for_tests();

    var plain: core::Node = core::column(core::Builder::new(), key: "plain");
    let pw: *u8 = window::open_window(#addr_of(plain), screen::Chrome::new(
        title: "plain", width: 300.0f64, height: 200.0f64));
    match ak::Window::from_raw(pw).content_view() {
        option::Option[ak::View]::Some(cv) => { assert zoom::is_zoomable(cv.raw()) == false; }
        option::Option[ak::View]::None => { assert false; }
    }
    window::close_window(pw);

    var z: core::Node = core::column(core::Builder::new(), key: "zoomy");
    let zw: *u8 = window::open_window(#addr_of(z), screen::Chrome::new(
        title: "zoomy", width: 300.0f64, height: 200.0f64,
        zoomable: true, max_zoom: 3.0f64));
    match ak::Window::from_raw(zw).content_view() {
        option::Option[ak::View]::Some(cv) => {
            assert zoom::is_zoomable(cv.raw());
            assert zoom::zoom_of(cv.raw()) == 1.0f64;
            // Scaled content must be clipped, or it bleeds over the titlebar.
            assert cv.clips_to_bounds();
        }
        option::Option[ak::View]::None => { assert false; }
    }
    window::close_window(zw);
    backend::uninstall();
    app::reset_default_for_tests();
    return;
}

#[test]
fn the_programmatic_path_scales_the_bounds_and_clamps_to_the_range() {
    // An agent has no hands, so a pinch-only feature would be one no agent
    // could reach. `set_zoom` drives exactly what the gesture drives.
    backend::install();
    app::reset_default_for_tests();
    zoom::reset_for_tests();
    var n: core::Node = core::column(core::Builder::new(), key: "zoomy2");
    let win: *u8 = window::open_window(#addr_of(n), screen::Chrome::new(
        title: "z2", width: 400.0f64, height: 300.0f64,
        zoomable: true, min_zoom: 1.0f64, max_zoom: 3.0f64));
    match ak::Window::from_raw(win).content_view() {
        option::Option[ak::View]::Some(cv) => {
            let host: *u8 = cv.raw();
            let f: rt::Rect = cv.frame();
            assert zoom::set_zoom(host, 2.0f64) == 2.0f64;
            assert zoom::zoom_of(host) == 2.0f64;
            // Magnifying is a BOUNDS change: the frame is untouched and the
            // visible cut is half as wide. No layout pass ran.
            let b: rt::Rect = cv.bounds();
            assert cv.frame().w == f.w;
            assert b.w > (f.w / 2.0f64) - 0.5f64;
            assert b.w < (f.w / 2.0f64) + 0.5f64;
            // Past the ceiling clamps rather than refusing.
            assert zoom::set_zoom(host, 99.0f64) == 3.0f64;
            // ...and back to natural size restores the full cut.
            assert zoom::set_zoom(host, 1.0f64) == 1.0f64;
            let back: rt::Rect = cv.bounds();
            assert back.w > f.w - 0.5f64;
            assert back.w < f.w + 0.5f64;
        }
        option::Option[ak::View]::None => { assert false; }
    }
    window::close_window(win);
    backend::uninstall();
    app::reset_default_for_tests();
    return;
}

#[test]
fn closing_a_window_forgets_its_zoom_entry() {
    // The registry is keyed by ADDRESS; a recycled content view must not
    // inherit a stale range.
    backend::install();
    app::reset_default_for_tests();
    zoom::reset_for_tests();
    var n: core::Node = core::column(core::Builder::new(), key: "zoomy3");
    let win: *u8 = window::open_window(#addr_of(n), screen::Chrome::new(
        title: "z3", width: 300.0f64, height: 200.0f64, zoomable: true));
    var host: *u8 = 0 as *u8;
    match ak::Window::from_raw(win).content_view() {
        option::Option[ak::View]::Some(cv) => { host = cv.raw(); }
        option::Option[ak::View]::None => { assert false; }
    }
    assert zoom::is_zoomable(host);
    window::close_window(win);
    assert zoom::is_zoomable(host) == false;
    // And an uninstalled host answers natural size rather than trapping.
    assert zoom::zoom_of(host) == 1.0f64;
    assert zoom::set_zoom(host, 2.0f64) == 1.0f64;
    backend::uninstall();
    app::reset_default_for_tests();
    return;
}

// ---- a live content write re-measures ---------------------------------------
//
// The bug this guards: `set_text` raises only P_TEXT, which changes no STYLE,
// so flex's incremental cache skipped the subtree and the frame walk
// early-returned. The new string was set on the NSTextField and clipped to the
// box the OLD string was measured at. A column hid it (align_items: Stretch);
// a row showed it plainly, which is why the row is the shape asserted here.
#[test]
fn a_live_text_write_re_measures_the_label() {
    backend::install();
    app::reset_default_for_tests();
    var root: core::Node = core::row(core::Builder::new(), key: "r");
    var l: core::Node = label::label("x", key: "grow");
    let _ok: bool = mount::insert_child(#addr_of(root), l, 0 as usize);
    let rp: *core::Node = #addr_of(root);
    let win: *u8 = window::open_window(rp, screen::Chrome::new(
        title: "measure", width: 600.0f64, height: 200.0f64));
    scheduler::layout_window(rp);

    var before: f64 = 0.0f64;
    match label::find("grow", within: rp) {
        option::Option[label::Label]::Some(h) => {
            before = { (*h.node()).frame() }.width;
            let _l: label::Label = h.set_text("a very much longer string than x");
        }
        option::Option[label::Label]::None => { assert false; }
    }
    assert before > 0.0f64;
    assert before < 40.0f64;

    scheduler::tick();
    scheduler::layout_window(rp);

    match label::find("grow", within: rp) {
        option::Option[label::Label]::Some(h) => {
            let after: f64 = { (*h.node()).frame() }.width;
            // The box grew to fit the new string. Before the fix this was still
            // `before`, to the pixel.
            assert after > before * 3.0f64;
        }
        option::Option[label::Label]::None => { assert false; }
    }
    window::close_window(win);
    backend::uninstall();
    app::reset_default_for_tests();
    return;
}

// ---- the bundled symbol tier renders --------------------------------------
//
// `symbol` recommends the Bundled set and `facet/icons` declares 4,268
// codepoints for it. The backend masked on P_ICON | P_FONT and read neither
// field, so every one of them put an empty string in a label — and the
// coverage tool scored two LIVE verbs off the mask, which is why it survived.

#[test]
fn a_bundled_symbol_puts_its_codepoint_in_the_label() {
    backend::install();
    // U+E9B2 is `home` in Material Symbols. The node asks for the Bundled set,
    // which is the default.
    var n: core::Node = symbol::symbol(0xE9B2u32, key: "home", size: 24.0f64);
    let p: *core::Node = #addr_of(n);
    let v: *u8 = views::create(0 as *u8, p);
    assert v != (0 as *u8);
    let got: text::Text = ak::TextField::from_raw(v).as_control().string_value();
    // The glyph is one Private-Use-Area scalar, so the field is non-empty and
    // is NOT the decimal codepoint rendered as text.
    assert got.view() != "";
    assert got.view() != "59826";
    views::view_release(v);
    return;
}

#[test]
fn a_system_symbol_is_unaffected_by_the_bundled_path() {
    // The two tiers must not interfere: a System symbol names an SF Symbol and
    // must not be given a codepoint from the other set.
    backend::install();
    var n: core::Node = symbol::system_symbol("house", key: "sf", size: 24.0f64);
    let p: *core::Node = #addr_of(n);
    let v: *u8 = views::create(0 as *u8, p);
    assert v != (0 as *u8);
    views::view_release(v);
    return;
}
