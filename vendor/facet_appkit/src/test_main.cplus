// facet_appkit test root — the [[bin]] entry whose import closure pulls the
// whole package (both modules and the facet dep) into `cpc test`. `main` is
// a leak harness: repeated describe -> mount -> apply -> drop cycles; run
// `leaks --atExit -- ./target/debug/facet_appkit_tests` to verify no
// per-cycle growth.

import "objc/runtime" as rt;
import "stdlib/text" as text;
import "stdlib/vec" as vec;
import "stdlib/option" as option;
import "appkit/appkit" as ak;
import "appkit/appkit_ext" as akx;
import "facet/facet" as facet;
import "./facet_appkit" as fak;
import "./ui" as ui;
import "flex_layout/flex_layout" as flex;

fn harness_click(sender: *u8, ctx: *u8) { return; }

// ---- the component runtime: the full surface on real views -----------------
// struct = state, inherent impl = handlers, `impl T: facet::Component` =
// the checked render contract; wiring + mounting are bound method
// references; the ONE rule ("after a component's handler runs, that
// component re-renders") is exercised through a real wired NSButton.

struct ClickCounter {
    count: i32,
}

impl ClickCounter {
    fn on_inc(ref this, sender: *u8) {
        this.count = this.count +% 1;
        return;
    }
}

impl ClickCounter: facet::Component {
    fn render(this) -> flex::Node {
        let t: text::Text = "count ${this.count}";
        return @ui {
            label(t.view(), size: 13.0f64)
        };
    }
}

static CC_A: ClickCounter = #zero::[ClickCounter]();
static CC_B: ClickCounter = #zero::[ClickCounter]();

fn first_subview(host_ptr: *u8) -> *u8 {
    let host: ak::View = ak::View::from_raw(host_ptr);
    var subs: vec::Vec[ak::View] = host.subviews();
    match subs.at_ptr(0 as usize) {
        option::Option[*ak::View]::Some(vp) => { return { (*vp).raw() }; }
        option::Option[*ak::View]::None => { }
    }
    return 0 as *u8;
}

fn press(button_node: *flex::Node) {
    let bp: *u8 = { (*button_node).payload() };
    let t: *u8 = rt::msg_id(bp, rt::sel(#str_ptr("target\0")));
    let a: *u8 = rt::msg_id(bp, rt::sel(#str_ptr("action\0")));
    rt::msg_void_id(t, a, bp);
    return;
}

#[test]
fn component_click_rerenders_owner_only() {
    ui::unmount_all();
    CC_A.count = 0;
    CC_B.count = 0;
    let host_a = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 200.0, h: 40.0 });
    let host_b = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 200.0, h: 40.0 });
    // Mount via bound references: render + component address, one token.
    let ha: f64 = ui::mount(CC_A.render, host: host_a.raw());
    let hb: f64 = ui::mount(CC_B.render, host: host_b.raw());
    assert ha > 0.0f64;
    assert hb > 0.0f64;
    let a0: *u8 = first_subview(host_a.raw());
    let b0: *u8 = first_subview(host_b.raw());
    assert a0 != (0 as *u8);

    // A real wired button: bound reference supplies handler + ctx.
    var plus: flex::Node = ui::button("+1", on: CC_A.on_inc);
    press(#addr_of(plus));

    // Handler ran, and the after-hook re-rendered A's host only.
    assert CC_A.count == 1;
    let a1: *u8 = first_subview(host_a.raw());
    let b1: *u8 = first_subview(host_b.raw());
    assert a1 != a0;                      // A rebuilt (fresh label view)
    assert b1 == b0;                      // B's widget identity SURVIVED
    // The rebuilt label shows the fresh state: "count 1" = 7 chars.
    let lbl: ak::TextField = ak::TextField::from_raw(a1);
    assert lbl.as_control().string_value().count() == (7 as usize);
    ui::unmount_all();
}

#[test]
fn component_state_accumulates_across_rerenders() {
    ui::unmount_all();
    CC_A.count = 0;
    let host = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 200.0, h: 40.0 });
    let _h: f64 = ui::mount(CC_A.render, host: host.raw());
    var plus: flex::Node = ui::button("+1", on: CC_A.on_inc);
    press(#addr_of(plus));
    press(#addr_of(plus));
    press(#addr_of(plus));
    assert CC_A.count == 3;
    let lbl: ak::TextField = ak::TextField::from_raw(first_subview(host.raw()));
    assert lbl.as_control().string_value().count() == (7 as usize);   // "count 3"
    ui::unmount_all();
}

static IDX_SEEN: i64 = -1;

fn idx_handler(sender: *u8, ctx: *u8) {
    IDX_SEEN = ctx as i64;
    return;
}

#[test]
fn non_component_ctx_still_delivers_and_noops_the_after_hook() {
    ui::unmount_all();
    IDX_SEEN = -1;
    // The row-index pattern: ctx is data, not a component. The after-hook
    // must miss the registry and do nothing.
    var del: flex::Node = ui::button_ctx("x", on: idx_handler, ctx: 5 as *u8);
    press(#addr_of(del));
    assert IDX_SEEN == (5 as i64);
    assert ui::invalidate(5 as *u8) == false;
}

#[test]
fn explicit_cross_component_invalidate() {
    ui::unmount_all();
    CC_A.count = 0;
    let host = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 200.0, h: 40.0 });
    let _h: f64 = ui::mount(CC_A.render, host: host.raw());
    let v0: *u8 = first_subview(host.raw());
    // Mutating state does nothing to the screen until invalidate says so.
    CC_A.count = 41;
    assert first_subview(host.raw()) == v0;
    let hit: bool = ui::invalidate(#addr_of(CC_A) as *u8);
    assert hit;
    assert first_subview(host.raw()) != v0;
    let lbl: ak::TextField = ak::TextField::from_raw(first_subview(host.raw()));
    assert lbl.as_control().string_value().count() == (8 as usize);   // "count 41"
    ui::unmount_all();
}

fn main() -> i32 {
    let rc: i32 = probe();
    if rc != 0 { return rc; }
    let rc2: i32 = app_click_cycles();
    if rc2 != 0 { return rc2; }
    let rc3: i32 = ui_mount_cycles();
    if rc3 != 0 { return rc3; }
    let rc4: i32 = component_cycles();
    if rc4 != 0 { return rc4; }
    for k in 0..50 {
        let content = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 300.0, h: 200.0 });
        var root: facet::Node = @facet {
            card {
                label("Iris", size: 28.0f64, bold: true)
                wrap_label("Create a new project or open an existing one.", secondary: true)
                hstack {
                    button("New", primary: true).on_click(harness_click, ctx: 1 as *u8)
                    button("Open").on_click(harness_click, ctx: 2 as *u8)
                }
            }
        };
        let _h: f64 = fak::mount_into(#addr_of(root), content.raw(), 300.0f64, 200.0f64);
    }
    return 0;
}

// Leak-harness segment for the COMPONENT runtime: one mount, then 50 full
// click -> ref-this handler -> auto-invalidate re-render cycles through the
// real target/action pair, plus 50 explicit invalidates. Every re-render
// replaces the host's subtree; the removed views must fully release.
fn component_cycles() -> i32 {
    ui::unmount_all();
    CC_A.count = 0;
    let host = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 200.0, h: 40.0 });
    let h0: f64 = ui::mount(CC_A.render, host: host.raw());
    if h0 <= 0.0f64 { return 41; }
    var plus: flex::Node = ui::button("+1", on: CC_A.on_inc);
    for k in 0..50 {
        press(#addr_of(plus));
    }
    if CC_A.count != 50 { return 42; }
    for k in 0..50 {
        let hit: bool = ui::invalidate(#addr_of(CC_A) as *u8);
        if !hit { return 43; }
    }
    ui::unmount_all();
    return 0;
}

// Debug probe: 0 = healthy; otherwise the counter label's char count (or 100
// when the widget lookup failed) for diagnosing the app runtime.
fn probe() -> i32 {
    fak::COUNT = 9;
    let content = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 300.0, h: 200.0 });
    fak::app_bind(fak::counter_view, content.raw(), 300.0f64, 200.0f64);
    fak::refresh();
    let lp: *u8 = fak::nth_widget(content.raw(), 0 as usize);
    if lp == (0 as *u8) { return 100; }
    let l0 = ak::TextField::from_raw(lp);
    let n: i32 = l0.as_control().string_value().count() as i32;
    if n == 7 { return 0; }
    return n;
}

// Leak-harness segment for the app runtime: one bind, then 50 full
// click -> handler -> re-render cycles through the real target/action.
fn app_click_cycles() -> i32 {
    fak::COUNT = 0;
    let content = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 300.0, h: 200.0 });
    fak::app_bind(fak::counter_view, content.raw(), 300.0f64, 200.0f64);
    fak::refresh();
    for k in 0..50 {
        let bp: *u8 = fak::nth_widget(content.raw(), 1 as usize);
        if bp == (0 as *u8) { return 90; }
        fak::click(bp);
    }
    if fak::COUNT != 50 { return 91; }
    fak::APP_CONTENT = 0 as *u8;
    return 0;
}

// ============================================================================
// Component examples (brainstorm -> living documentation)
// ============================================================================

// ---- Option 1: a component is a plain function returning a description ----
// Props are named params with defaults; composition is a function call in any
// @facet block. Two construction forms:
//
//   (a) DSL form — reads best; the @facet root adds a wrapper column.
//   (b) Builder form — exact shape, no wrapper; for tight subtrees.

fn chip(text_: str, ok: bool = true) -> facet::Node {
    // (b): exact hstack, no wrapper.
    var b: facet::Builder = facet::Builder::new();
    if ok { b.add(facet::label("[ok]", secondary: true)); }
    else  { b.add(facet::label("[--]", secondary: true)); }
    b.add(facet::label(text_));
    return facet::hstack(b);
}

fn chips_panel() -> facet::Node {
    // (a): DSL form composing the component like any item.
    return @facet {
        vstack {
            chip("clang")
            chip("cpc")
            chip("git", ok: false)
        }
    };
}

#[test]
fn component_fns_compose_in_blocks() {
    var root: facet::Node = chips_panel();
    // root column -> vstack -> 3 chips (each an hstack of 2 labels).
    match root.children.at_ptr(0 as usize) {
        option::Option[*facet::Node]::Some(v) => {
            assert { (*v).children.count() } == (3 as usize);
            match { (*v).children.at_ptr(2 as usize) } {
                option::Option[*facet::Node]::Some(c) => {
                    assert { (*c).kind } == facet::kind_row();
                    assert { (*c).children.count() } == (2 as usize);
                }
                option::Option[*facet::Node]::None => { assert false; }
            }
        }
        option::Option[*facet::Node]::None => { assert false; }
    };
}

// ---- Option 2: scoped state = a state struct passed by pointer -------------
// The SAME component fn, two state slices -> two independent widgets. The
// click ctx IS the state slice, so identity and state are one thing; the app
// model stays the single owner.

struct CounterState {
    count: i32,
}

static COUNTER_A: CounterState = CounterState { count: 0 };
static COUNTER_B: CounterState = CounterState { count: 0 };

fn counter_bump(sender: *u8, ctx: *u8) {
    let s: *CounterState = ctx as *CounterState;
    (*s).count = { (*s).count } + 1;
    return;
}

fn counter_row(s: *CounterState, name: str) -> facet::Node {
    let c: i32 = { (*s).count };
    let t: text::Text = "${c}";
    var b: facet::Builder = facet::Builder::new();
    b.add(facet::label(name, secondary: true));
    b.add(facet::label(t.view(), bold: true));
    b.add(facet::button("+1").on_click(counter_bump, ctx: s as *u8));
    return facet::hstack(b);
}

fn two_counters_view() -> facet::Node {
    return @facet {
        vstack {
            counter_row(#addr_of(COUNTER_A), "a")
            counter_row(#addr_of(COUNTER_B), "b")
        }
    };
}

// content -> vstack synth -> row synth[r] -> widget[i].
fn row_widget(content_ptr: *u8, r: usize, i: usize) -> *u8 {
    let content: ak::View = ak::View::from_raw(content_ptr);
    var subs: vec::Vec[ak::View] = content.subviews();
    match subs.at_ptr(0 as usize) {
        option::Option[*ak::View]::Some(stackv) => {
            var rows: vec::Vec[ak::View] = { (*stackv).subviews() };
            match rows.at_ptr(r) {
                option::Option[*ak::View]::Some(rowv) => {
                    var ws: vec::Vec[ak::View] = { (*rowv).subviews() };
                    match ws.at_ptr(i) {
                        option::Option[*ak::View]::Some(w) => { return { (*w).raw() }; }
                        option::Option[*ak::View]::None => { }
                    }
                }
                option::Option[*ak::View]::None => { }
            }
        }
        option::Option[*ak::View]::None => { }
    }
    return 0 as *u8;
}

#[test]
fn component_state_slices_are_independent() {
    COUNTER_A.count = 0;
    COUNTER_B.count = 0;
    let content = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 400.0, h: 200.0 });
    fak::app_bind(two_counters_view, content.raw(), 400.0f64, 200.0f64);
    fak::refresh();

    // Click a's +1 twice, b's once — through the real target/action.
    fak::click(row_widget(content.raw(), 0 as usize, 2 as usize));
    fak::click(row_widget(content.raw(), 0 as usize, 2 as usize));
    fak::click(row_widget(content.raw(), 1 as usize, 2 as usize));

    assert COUNTER_A.count == 2;
    assert COUNTER_B.count == 1;

    // And the UI followed: a's count label reads "2" (1 char).
    let la: ak::TextField = ak::TextField::from_raw(row_widget(content.raw(), 0 as usize, 1 as usize));
    assert la.as_control().string_value().count() == (1 as usize);
    fak::APP_CONTENT = 0 as *u8;
}

// ============================================================================
// The `@ui` surface (merged from the appkit_flex package's test root)
// ============================================================================

fn approx(a: f64, b: f64) -> bool {
    let d: f64 = a - b;
    if d < 0.0f64 { return (0.0f64 - d) < 0.01f64; }
    return d < 0.01f64;
}

fn demo_noop(sender: *u8, ctx: *u8) { return; }

// Leak-harness segment for the @ui layer: repeated describe -> mount ->
// apply -> drop cycles (from the pre-merge appkit_flex harness).
fn ui_mount_cycles() -> i32 {
    for k in 0..50 {
        let content = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 300.0, h: 200.0 });
        var tree: flex::Node = @ui {
            card {
                label("Iris", size: 28.0f64, bold: true)
                wrap_label("Create a new project or open an existing one.", secondary: true)
                hstack {
                    button("New", on: demo_noop, primary: true)
                    button("Open", on: demo_noop)
                }.gap(4.0f64)
            }
        };
        tree.set_width(flex::StyleLength::points(300.0f64));
        tree.calculate_layout(300.0f64, flex::undefined(), flex::Direction::LTR);
        ui::apply(#addr_of(tree), content.raw(), false);
    }
    return 0;
}

fn ui_harness_click(sender: *u8) { return; }


// ---- the `@ui` surface -------------------------------------------------

#[test]
fn dsl_containers_and_widgets_are_peers() {
    // The SwiftUI shape: one context, layout containers and widgets side
    // by side, flow control included.
    let show_footer = true;
    var tree: flex::Node = @ui {
        vstack {
            label("Iris", size: 28.0f64, bold: true)
            label("Version 0.0.1", size: 12.0f64, secondary: true)
            hstack {
                button("New Project", on: demo_noop, primary: true)
                button("Open Project", on: demo_noop)
            }
            for i in 0..3 {
                label("row")
            }
            if show_footer {
                label("footer", secondary: true)
            }
        }
    };
    // The root block is itself a column; the vstack is its one child,
    // and the vstack holds 2 labels + hstack + 3 rows + footer = 7.
    assert tree.child_count() == (1 as usize);
    match tree.children.at_ptr(0 as usize) {
        option::Option[*flex::Node]::Some(v) => {
            assert { (*v).child_count() } == (7 as usize);
        }
        option::Option[*flex::Node]::None => { assert false; }
    };
}

#[test]
fn dsl_fluent_chain_styles_containers() {
    // Same-line fluent chains after a container's `}` (the note-A fix).
    var tree: flex::Node = @ui {
        hstack {
            box().width(10.0f64).height(10.0f64)
            box().width(10.0f64).height(10.0f64)
        }.gap(4.0f64).padding(3.0f64)
    };
    assert tree.child_count() == (1 as usize);
    tree.set_align_items(flex::Align::FlexStart);   // shrink-wrap, don't stretch
    tree.calculate_layout(100.0f64, flex::undefined(), flex::Direction::LTR);
    match tree.child_layout(0 as usize) {
        option::Option[flex::Layout]::Some(f) => {
            // 3 pad + 10 + 4 gap + 10 + 3 pad = 30 wide, 10 + 6 pad = 16 tall.
            assert approx(f.width, 30.0f64);
            assert approx(f.height, 16.0f64);
        }
        option::Option[flex::Layout]::None => { assert false; }
    };
}

#[test]
fn dsl_tree_applies_into_views() {
    // End to end: @ui block -> layout -> real NSView tree.
    let content = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 200.0, h: 100.0 });
    var tree: flex::Node = @ui {
        row {
            label("hi")
            spacer()
            label("there")
        }
    };
    tree.set_width(flex::StyleLength::points(200.0f64));
    tree.set_height(flex::StyleLength::points(100.0f64));
    tree.calculate_layout(200.0f64, 100.0f64, flex::Direction::LTR);
    ui::apply(#addr_of(tree), content.raw(), false);
    // The row container gets one synthesized NSView under content; the
    // two label views nest inside it (the spacer contributes no view).
    let subs: vec::Vec[ak::View] = content.subviews();
    assert subs.count() == (1 as usize);
    match subs.at_ptr(0 as usize) {
        option::Option[*ak::View]::Some(rv) => {
            let inner: vec::Vec[ak::View] = { (*rv).subviews() };
            assert inner.count() == (2 as usize);
        }
        option::Option[*ak::View]::None => { assert false; }
    };
}

// ---- appkit_ext companion (target/action with userdata) -----------------

static EXT_FIRES: i32 = 0;
static EXT_SENDER: i64 = 0;
static EXT_CTX: i64 = 0;

fn ext_handler(sender: *u8, ctx: *u8) {
    EXT_FIRES = EXT_FIRES + 1;
    EXT_SENDER = sender as i64;
    EXT_CTX = ctx as i64;
    return;
}

#[test]
fn action_ctx_target_delivers_sender_and_ctx() {
    EXT_FIRES = 0;
    let t: *u8 = akx::action_ctx_target(ext_handler, 41 as *u8);
    rt::msg_void_id(t, akx::action_ctx_sel(), 7 as *u8);
    assert EXT_FIRES == 1;
    assert EXT_SENDER == (7 as i64);
    assert EXT_CTX == (41 as i64);
}

#[test]
fn action_ctx_targets_are_independent() {
    // Two targets, two ctx values: each delivers its own. This is the
    // per-item identity the setTag workaround emulated.
    EXT_FIRES = 0;
    let a: *u8 = akx::action_ctx_target(ext_handler, 1 as *u8);
    let b: *u8 = akx::action_ctx_target(ext_handler, 2 as *u8);
    rt::msg_void_id(a, akx::action_ctx_sel(), 0 as *u8);
    assert EXT_CTX == (1 as i64);
    rt::msg_void_id(b, akx::action_ctx_sel(), 0 as *u8);
    assert EXT_CTX == (2 as i64);
    assert EXT_FIRES == 2;
}

#[test]
fn set_control_action_ctx_wires_target_and_action() {
    EXT_FIRES = 0;
    let btn = ak::Button::new();
    akx::set_control_action_ctx(btn.as_control(), ext_handler, 9 as *u8);
    let t: *u8 = rt::msg_id(btn.raw(), rt::sel(#str_ptr("target\0")));
    assert t != (0 as *u8);
    rt::msg_void_id(t, akx::action_ctx_sel(), btn.raw());
    assert EXT_FIRES == 1;
    assert EXT_SENDER == (btn.raw() as i64);
    assert EXT_CTX == (9 as i64);
}

#[test]
fn flipped_view_reports_flipped() {
    let v = akx::new_flipped_view(rt::Rect { x: 0.0, y: 0.0, w: 10.0, h: 10.0 });
    let flipped: i8 = rt::msg_i8(v.raw(), rt::sel(#str_ptr("isFlipped\0")));
    assert flipped == (1 as i8);
}

// ---- coverage proof: ANY binding view enters through the escape hatches ----
// None of these widgets exist in the @ui vocabulary — they come straight from
// the generated binding (NSSlider / NSProgressIndicator / NSPopUpButton) and
// enter the layout as ordinary nodes via view()/fixed_view(). This is the
// coverage model: the binding is the coverage; @ui wraps only the everyday
// widgets; everything else needs zero wrapper code.

#[test]
fn any_binding_view_enters_via_escape_hatches() {
    let content = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 400.0, h: 120.0 });

    let s = ak::Slider::new();
    s.as_control().set_double_value(0.5f64);
    let sp: *u8 = s.raw();

    let p = ak::ProgressIndicator::new();
    p.set_indeterminate(false);
    let pp: *u8 = p.as_view().raw();

    let pop = ak::PopUpButton::new(rt::Rect { x: 0.0, y: 0.0, w: 0.0, h: 0.0 }, false);
    pop.add_item_with_title("One");
    pop.add_item_with_title("Two");
    let popp: *u8 = pop.as_view().raw();

    var tree: flex::Node = @ui {
        vstack {
            fixed_view(s.as_view()).height(24.0f64)
            fixed_view(p.as_view()).height(16.0f64)
            view(pop.as_view())
        }
    };
    tree.set_width(flex::StyleLength::points(400.0f64));
    tree.calculate_layout(400.0f64, 120.0f64, flex::Direction::LTR);
    ui::apply(#addr_of(tree), content.raw(), false);

    // All three landed in the view tree with frames from the flex pass.
    let sf: rt::Rect = ak::View::from_raw(sp).frame();
    assert sf.w > 0.0f64;
    assert sf.h == 24.0f64;
    let pf: rt::Rect = ak::View::from_raw(pp).frame();
    assert pf.h == 16.0f64;
    match ak::View::from_raw(popp).superview() {
        option::Option[ak::View]::Some(sv) => { assert sv.raw() != (0 as *u8); }
        option::Option[ak::View]::None => { assert false; }
    };
    // And the popup still behaves like the binding object it is.
    assert pop.number_of_items() == (2 as i64);
}

// ---- @ui agent-id tagging (bugs/facet-agent-id-exposure.md, Gap A) --------

#[test]
fn ui_widgets_carry_agent_id() {
    var tree: flex::Node = @ui {
        vstack {
            label("Iris", agent_id: "title")
            button("New Project", on: demo_noop, agent_id: "new-project")
            button("Open", on: demo_noop)
        }
    };
    match tree.children.at_ptr(0 as usize) {
        option::Option[*flex::Node]::Some(v) => {
            match { (*v).children.at_ptr(0 as usize) } {
                option::Option[*flex::Node]::Some(l) => {
                    let lp: *u8 = { (*l).payload() };
                    assert ak::Accessibility::from_raw(lp).accessibility_identifier().view() == "title";
                }
                option::Option[*flex::Node]::None => { assert false; }
            };
            match { (*v).children.at_ptr(1 as usize) } {
                option::Option[*flex::Node]::Some(b) => {
                    let bp: *u8 = { (*b).payload() };
                    assert ak::Accessibility::from_raw(bp).accessibility_identifier().view() == "new-project";
                }
                option::Option[*flex::Node]::None => { assert false; }
            };
            // Untagged stays untagged.
            match { (*v).children.at_ptr(2 as usize) } {
                option::Option[*flex::Node]::Some(b) => {
                    let bp: *u8 = { (*b).payload() };
                    assert ak::Accessibility::from_raw(bp).accessibility_identifier().count() == (0 as usize);
                }
                option::Option[*flex::Node]::None => { assert false; }
            };
        }
        option::Option[*flex::Node]::None => { assert false; }
    };
    return;
}

static UITAG_CTX: i32 = 0;

fn uitag_render(ctx: *u8) -> flex::Node {
    return @ui {
        button("go", on: demo_noop, agent_id: "go-btn")
    };
}

#[test]
fn ui_agent_id_survives_component_rerender() {
    // The Gap B half: a component re-render replaces its views wholesale;
    // because the constructor tags at every mount, the FRESH button carries
    // the same id — an agent that re-opens its surface finds "go-btn" again.
    ui::unmount_all();
    let host = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 200.0, h: 40.0 });
    let _h0: f64 = ui::mount(uitag_render, ctx: { #addr_of(UITAG_CTX) as *u8 }, host: host.raw());
    var subs: vec::Vec[ak::View] = host.subviews();
    assert subs.count() == (1 as usize);
    match subs.at_ptr(0 as usize) {
        option::Option[*ak::View]::Some(v) => {
            let b0: *u8 = { (*v).raw() };
            assert ak::Accessibility::from_raw(b0).accessibility_identifier().view() == "go-btn";
        }
        option::Option[*ak::View]::None => { assert false; }
    };
    assert ui::invalidate({ #addr_of(UITAG_CTX) as *u8 });
    var subs2: vec::Vec[ak::View] = host.subviews();
    match subs2.at_ptr(0 as usize) {
        option::Option[*ak::View]::Some(v) => {
            let b1: *u8 = { (*v).raw() };
            assert ak::Accessibility::from_raw(b1).accessibility_identifier().view() == "go-btn";
        }
        option::Option[*ak::View]::None => { assert false; }
    };
    ui::unmount_all();
    return;
}
