#[link_name = "objc_msgSend"]
extern fn msg_size_of(recv: *u8, sel: *u8) -> rt::Size;

#[link_name = "objc_msgSend"]
extern fn msg_id_point(recv: *u8, sel: *u8, p: rt::Point) -> *u8;

#[link_name = "objc_msgSend"]
extern fn msg_mouse_event(recv: *u8, sel: *u8, ty: u64, loc: rt::Point, flags: u64,
                          ts: f64, win: i64, cx: *u8, num: i64, clicks: i64,
                          pressure: f32) -> *u8;

type Node = flex::Node;

fn main() -> i32 { return 0; }

// A keyed column, the shape Stage 4 item 1 exists to put on screen.
fn empty_keyed_column() -> core::Node {
    return core::column(core::Builder::new(), key: "body");
}

// ---- the backing rule --------------------------------------------------------

#[test]
fn a_keyed_container_is_backed_and_an_unkeyed_one_is_not() {
    // The same rule facet's fake renderer uses, so the headless conformance
    // tests and this backend agree on the shape of the native tree.
    var keyed: core::Node = core::column(core::Builder::new(), key: "body");
    assert views::wants_view(#addr_of(keyed));
    var bare: core::Node = core::column(core::Builder::new());
    assert views::wants_view(#addr_of(bare)) == false;
    // A control is always backed, key or no key.
    var leaf: core::Node = core::node_with("", props::K_BUTTON, 0 as *u8, core::no_release);
    assert views::wants_view(#addr_of(leaf));
    return;
}

#[test]
fn create_makes_a_flipped_view_and_tags_it_with_the_key() {
    var n: core::Node = empty_keyed_column();
    let v: *u8 = views::create(0 as *u8, #addr_of(n));
    assert v != (0 as *u8);
    // FLIPPED: top-left origin, so the frame walk needs no flip math.
    assert ak::View::from_raw(v).is_flipped();
    // The key IS the accessibilityIdentifier — one token, three jobs.
    assert ak::Accessibility::from_raw(v).accessibility_identifier().view() == "body";
    views::view_release(v);
    return;
}

#[test]
fn an_unbacked_node_creates_nothing() {
    var bare: core::Node = core::column(core::Builder::new());
    assert views::create(0 as *u8, #addr_of(bare)) == (0 as *u8);
    assert views::create(0 as *u8, 0 as *core::Node) == (0 as *u8);
    return;
}

// ---- the shared band ---------------------------------------------------------

#[test]
fn the_shared_band_reaches_the_view() {
    var n: core::Node = empty_keyed_column();
    let p: *core::Node = #addr_of(n);
    core::set_visible(p, false);
    core::set_opacity(p, 0.25f64);
    let v: *u8 = views::create(0 as *u8, p);
    assert v != (0 as *u8);
    let view: ak::View = ak::View::from_raw(v);
    // create reads the band WHOLE, so a view is configured before it is shown.
    assert view.is_hidden();
    assert view.alpha_value() < 0.3f64;
    // ...and apply re-reads only what the dirty bits name.
    core::set_view(p, v, views::view_release);
    core::clear_dirty(p);
    core::set_visible(p, true);
    views::apply(0 as *u8, p);
    assert view.is_hidden() == false;
    assert view.alpha_value() < 0.3f64;      // untouched: its bit was not set
    return;
}

#[test]
fn apply_is_inert_without_a_view_or_a_dirty_word() {
    var n: core::Node = empty_keyed_column();
    let p: *core::Node = #addr_of(n);
    // No view: nothing to apply onto, and no trap.
    views::apply(0 as *u8, p);
    views::apply(0 as *u8, 0 as *core::Node);
    let v: *u8 = views::create(0 as *u8, p);
    core::set_view(p, v, views::view_release);
    core::clear_dirty(p);
    views::apply(0 as *u8, p);               // clean node: nothing re-read
    return;
}

// ---- colour resolution -------------------------------------------------------

#[test]
fn theme_roles_resolve_through_the_apps_palette_then_the_fallback() {
    app::reset_default_for_tests();
    // An UNSET role falls through to its platform token, not to black.
    theme::set_theme(theme::Theme::new());
    let unset: ak::Color = paint::ns_color(vocab::Color::primary());
    assert unset.raw() == ak::Color::control_accent_color().raw();
    // A role the app DID set resolves to the app's literal.
    theme::set_theme(theme::Theme::new(primary: vocab::Color::rgba(1.0f64, 0.0f64, 0.0f64, 1.0f64)));
    let set: ak::Color = paint::ns_color(vocab::Color::primary());
    assert set.red_component() > 0.9f64;
    // A Tier-1 token maps straight onto the platform's adaptive colour.
    assert paint::ns_color(vocab::Color::text()).raw() == ak::Color::label_color().raw();
    theme::set_theme(theme::Theme::new());
    app::reset_default_for_tests();
    return;
}

// ---- appearance-dependent colour ---------------------------------------------
// These read a colour's red channel AS IT RESOLVES under a named appearance,
// which is the only way to see the difference between "decided at draw time"
// and "decided once and frozen" — the two are indistinguishable from the
// object itself.

fn red_under(appearance: str, c: ak::Color) -> f64 {
    let prev: ak::Appearance = ak::Appearance::current_appearance();
    match ak::Appearance::appearance_named(appearance) {
        option::Option[ak::Appearance]::Some(a) => { ak::Appearance::set_current_appearance(a); }
        option::Option[ak::Appearance]::None => { }
    }
    var out: f64 = -1.0f64;
    match c.color_using_color_space(ak::ColorSpace::s_r_g_b_color_space()) {
        option::Option[ak::Color]::Some(s) => { out = s.red_component(); }
        option::Option[ak::Color]::None => { }
    }
    ak::Appearance::set_current_appearance(prev);
    return out;
}

#[test]
fn an_adaptive_pair_resolves_per_appearance_not_once() {
    app::reset_default_for_tests();
    theme::set_theme(theme::Theme::new());
    let c: ak::Color = paint::ns_color(vocab::Color::adaptive(
        light: vocab::Color::rgba(1.0f64, 0.0f64, 0.0f64, 1.0f64),
        dark:  vocab::Color::rgba(0.0f64, 0.0f64, 1.0f64, 1.0f64),
    ));
    // ONE colour object, two answers. Resolved at apply time it could only ever
    // have had one.
    assert red_under("NSAppearanceNameAqua", c) > 0.9f64;
    assert red_under("NSAppearanceNameDarkAqua", c) < 0.1f64;
    app::reset_default_for_tests();
    return;
}

#[test]
fn derived_ink_reads_against_what_the_role_became() {
    app::reset_default_for_tests();
    // Cream primary: the white constant this used to be would be unreadable.
    theme::set_theme(theme::Theme::new(
        primary: vocab::Color::rgba(0.98f64, 0.95f64, 0.87f64, 1.0f64)));
    let pale: ak::Color = paint::ns_color(vocab::Color::on_primary());
    assert red_under("NSAppearanceNameAqua", pale) < 0.1f64;      // black ink

    // A dark primary flips the same role the other way.
    theme::set_theme(theme::Theme::new(
        primary: vocab::Color::rgba(0.20f64, 0.25f64, 0.33f64, 1.0f64)));
    let dark: ak::Color = paint::ns_color(vocab::Color::on_primary());
    assert red_under("NSAppearanceNameAqua", dark) > 0.9f64;      // white ink

    // Unset, the role keeps the platform's own constant — a themeless app is
    // untouched by any of this.
    theme::set_theme(theme::Theme::new());
    assert red_under("NSAppearanceNameAqua", paint::ns_color(vocab::Color::on_primary())) > 0.9f64;
    app::reset_default_for_tests();
    return;
}

#[test]
fn derived_ink_follows_the_appearance_when_its_role_does() {
    app::reset_default_for_tests();
    // `surface` themed as an adaptive pair, `ink` left unset. The ink is derived
    // from a role that is itself appearance-dependent — the full chain, in one
    // colour object.
    theme::set_theme(theme::Theme::new(surface: vocab::Color::adaptive(
        light: vocab::Color::rgba(0.96f64, 0.96f64, 0.97f64, 1.0f64),
        dark:  vocab::Color::rgba(0.09f64, 0.09f64, 0.11f64, 1.0f64),
    )));
    let ink: ak::Color = paint::ns_color(vocab::Color::ink());
    assert red_under("NSAppearanceNameAqua", ink) < 0.1f64;       // black on the pale side
    assert red_under("NSAppearanceNameDarkAqua", ink) > 0.9f64;   // white on the dark side
    theme::set_theme(theme::Theme::new());
    app::reset_default_for_tests();
    return;
}

#[test]
fn a_dynamic_colour_is_wrapped_once_and_a_static_one_never() {
    app::reset_default_for_tests();
    theme::set_theme(theme::Theme::new());
    let a: ak::Color = paint::ns_color(vocab::Color::adaptive(
        light: vocab::Color::rgba(0.1f64, 0.2f64, 0.3f64, 1.0f64),
        dark:  vocab::Color::rgba(0.4f64, 0.5f64, 0.6f64, 1.0f64)));
    let b: ak::Color = paint::ns_color(vocab::Color::adaptive(
        light: vocab::Color::rgba(0.1f64, 0.2f64, 0.3f64, 1.0f64),
        dark:  vocab::Color::rgba(0.4f64, 0.5f64, 0.6f64, 1.0f64)));
    assert a.raw() == b.raw();          // same pair, one wrapper
    let c: ak::Color = paint::ns_color(vocab::Color::adaptive(
        light: vocab::Color::rgba(0.9f64, 0.2f64, 0.3f64, 1.0f64),
        dark:  vocab::Color::rgba(0.4f64, 0.5f64, 0.6f64, 1.0f64)));
    assert c.raw() != a.raw();          // a different pair is a different colour
    // A platform token is already dynamic in AppKit's hands; wrapping it would
    // resolve to the same thing and cost its identity.
    assert paint::ns_color(vocab::Color::text()).raw() == ak::Color::label_color().raw();
    app::reset_default_for_tests();
    return;
}

#[link_name = "objc_msgSend"]
extern fn dyn_msg_id_id(recv: *u8, sel: *u8, a: *u8) -> *u8;
#[link_name = "objc_msgSend"]
extern fn dyn_msg_void_id_id_range(recv: *u8, sel: *u8, a: *u8, b: *u8, r: rt::Range);
#[link_name = "objc_msgSend"]
extern fn dyn_msg_id_id_u64_ptr_range(recv: *u8, sel: *u8, a: *u8, i: u64,
                                      out: *rt::Range, r: rt::Range) -> *u8;

#[test]
fn two_dynamic_colours_are_not_equal_just_for_sharing_a_kind() {
    app::reset_default_for_tests();
    theme::set_theme(theme::Theme::new());
    // Named NSColors compare BY NAME. Every facet wrapper used to be created
    // as "facet.dynamic", so any two of them were `isEqual:` whatever their
    // providers answered — invisible to a view (a view holds ONE colour),
    // fatal inside an attributed string (below).
    let a: ak::Color = paint::ns_color(vocab::Color::adaptive(
        light: vocab::Color::rgba(1.0f64, 0.0f64, 0.0f64, 1.0f64),
        dark:  vocab::Color::rgba(0.8f64, 0.1f64, 0.1f64, 1.0f64)));
    let b: ak::Color = paint::ns_color(vocab::Color::adaptive(
        light: vocab::Color::rgba(0.0f64, 0.0f64, 1.0f64, 1.0f64),
        dark:  vocab::Color::rgba(0.1f64, 0.1f64, 0.8f64, 1.0f64)));
    assert { rt::msg_i8_id(a.raw(), rt::sel(#str_ptr("isEqual:\0")), b.raw()) } == (0 as i8);
    // And a colour is still equal to ITSELF — distinctness, not noise.
    assert { rt::msg_i8_id(a.raw(), rt::sel(#str_ptr("isEqual:\0")), a.raw()) } != (0 as i8);
    app::reset_default_for_tests();
    return;
}

#[test]
fn distinct_dynamic_colours_keep_their_runs_in_an_attributed_string() {
    app::reset_default_for_tests();
    theme::set_theme(theme::Theme::new());
    // The measured failure shape: an NSAttributedString COALESCES adjacent
    // runs whose attribute values are `isEqual:`, so ten syntax colours
    // sharing one catalog name merged into one flat run and the file drew in
    // whichever was written first. Two colours on {0,3} and {3,3} must read
    // back as two runs, not one spanning {0,6}.
    let red: ak::Color = paint::ns_color(vocab::Color::adaptive(
        light: vocab::Color::rgba(1.0f64, 0.0f64, 0.0f64, 1.0f64),
        dark:  vocab::Color::rgba(0.8f64, 0.1f64, 0.1f64, 1.0f64)));
    let blue: ak::Color = paint::ns_color(vocab::Color::adaptive(
        light: vocab::Color::rgba(0.0f64, 0.0f64, 1.0f64, 1.0f64),
        dark:  vocab::Color::rgba(0.1f64, 0.1f64, 0.8f64, 1.0f64)));
    let alloc: *u8 = { rt::msg_id(rt::get_class(#str_ptr("NSMutableAttributedString\0")),
                                  rt::sel(#str_ptr("alloc\0"))) };
    let s: *u8 = { dyn_msg_id_id(alloc, rt::sel(#str_ptr("initWithString:\0")),
                                 bridge::nsstring("abcdef")) };
    assert s != (0 as *u8);
    let key: *u8 = bridge::nsstring("NSColor");   // NSForegroundColorAttributeName
    { dyn_msg_void_id_id_range(s, rt::sel(#str_ptr("addAttribute:value:range:\0")),
                               key, red.raw(),
                               rt::Range { location: 0 as u64, length: 3 as u64 }) };
    { dyn_msg_void_id_id_range(s, rt::sel(#str_ptr("addAttribute:value:range:\0")),
                               key, blue.raw(),
                               rt::Range { location: 3 as u64, length: 3 as u64 }) };
    var eff: rt::Range = rt::Range { location: 0 as u64, length: 0 as u64 };
    let got: *u8 = { dyn_msg_id_id_u64_ptr_range(
        s, rt::sel(#str_ptr("attribute:atIndex:longestEffectiveRange:inRange:\0")),
        key, 0 as u64, #addr_of(eff),
        rt::Range { location: 0 as u64, length: 6 as u64 }) };
    assert got != (0 as *u8);
    // The run STOPS where the colour changes. Before the per-entry name this
    // read back {0,6}: one run, first writer wins, and nothing said anything.
    assert eff.location == (0 as u64);
    assert eff.length == (3 as u64);
    rt::release(s);
    app::reset_default_for_tests();
    return;
}

#[test]
fn a_plain_button_keeps_its_bezel_instead_of_being_layer_backed() {
    app::reset_default_for_tests();
    // Layer-backing an AppKit control costs it the material its bezel is drawn
    // with — a push button rendered into a layer comes out flat. `create`
    // configures with every bit set, so a border pass that asked for a layer
    // before checking whether there was a border to draw made EVERY default
    // button layer-backed on mount.
    var plain: core::Node = button::button("Save", key: "btn:plain");
    let pp: *core::Node = #addr_of(plain);
    let pv: *u8 = views::create(0 as *u8, pp);
    assert pv != (0 as *u8);
    assert ak::View::from_raw(pv).wants_layer() == false;

    // A button that ASKS for a border still gets one.
    var edged: core::Node = button::button("Edged", key: "btn:edged",
                                           border_width: 2.0f64,
                                           border_color: vocab::Color::accent());
    let ep: *core::Node = #addr_of(edged);
    let ev: *u8 = views::create(0 as *u8, ep);
    assert ev != (0 as *u8);
    assert ak::View::from_raw(ev).wants_layer();
    assert ak::View::from_raw(ev).layer().border_width() > 1.9f64;

    // And a corner radius alone is reason enough for a layer.
    var round: core::Node = button::button("Round", key: "btn:round",
                                           corner_radius: vocab::Corners::all(6.0f64));
    let rp: *core::Node = #addr_of(round);
    let rv: *u8 = views::create(0 as *u8, rp);
    assert rv != (0 as *u8);
    assert ak::View::from_raw(rv).wants_layer();

    views::view_release(pv);
    views::view_release(ev);
    views::view_release(rv);
    app::reset_default_for_tests();
    return;
}

#[test]
fn a_bezeled_buttons_background_tints_the_bezel_not_a_layer_behind_it() {
    app::reset_default_for_tests();
    // A CALayer background sits UNDER the bezel and covers its material: the
    // button stops reacting to hover and press and becomes a flat block of
    // colour. `bezelColor` tints the real bezel and keeps all of it.
    var tinted: core::Node = button::button("Move to Trash", key: "btn:primary");
    tinted.set_background_color(vocab::Color::accent());
    let tp: *core::Node = #addr_of(tinted);
    let tv: *u8 = views::create(0 as *u8, tp);
    assert tv != (0 as *u8);
    assert { rt::msg_id(tv, rt::sel(#str_ptr("bezelColor\0"))) } != (0 as *u8);
    assert ak::View::from_raw(tv).wants_layer() == false;

    // A control with no bezel keeps the layer answer — that is what a `box` is.
    var plain: core::Node = box_view::box(vocab::Color::accent(), key: "bx");
    let pp: *core::Node = #addr_of(plain);
    let pv: *u8 = views::create(0 as *u8, pp);
    assert pv != (0 as *u8);
    assert ak::View::from_raw(pv).wants_layer();

    views::view_release(tv);
    views::view_release(pv);
    app::reset_default_for_tests();
    return;
}

#[link_name = "CGColorGetComponents"]
extern fn cg_components(c: *u8) -> *f64;
#[link_name = "CGColorGetNumberOfComponents"]
extern fn cg_component_count(c: *u8) -> usize;

// The mean of a view's layer fill. -1.0 when it has none.
fn layer_fill_mean(v: *u8) -> f64 {
    match ak::View::from_raw(v).layer().background_color() {
        option::Option[*u8]::Some(cg) => {
            if cg_component_count(cg) < (3 as usize) { return -1.0f64; }
            let p: *f64 = cg_components(cg);
            let g: *f64 = { ({ p as usize } +% (8 as usize)) as *f64 };
            let b: *f64 = { ({ p as usize } +% (16 as usize)) as *f64 };
            return ({ *p } + { *g } + { *b }) / 3.0f64;
        }
        option::Option[*u8]::None => { return -1.0f64; }
    }
}

fn force_view_appearance(v: *u8, name: str) {
    match ak::Appearance::appearance_named(name) {
        option::Option[ak::Appearance]::Some(a) => {
            { rt::msg_void_id(v, rt::sel(#str_ptr("setAppearance:\0")), a.raw()) };
        }
        option::Option[ak::Appearance]::None => { }
    }
    return;
}

#[test]
fn a_fill_flattens_in_the_views_own_appearance_not_the_applications() {
    app::reset_default_for_tests();
    theme::set_theme(theme::Theme::new());

    // A layer fill is a CGColor, which has no appearance — it is resolved once,
    // against `NSAppearance.currentAppearance`. Outside a draw cycle that is
    // neither the view's appearance nor the application's: it holds whatever was
    // current when the process started and never follows a flip. Applying inside
    // the VIEW's appearance is what makes a repaint actually repaint, and it is
    // also the only answer that survives a view under an appearance override.
    var n: core::Node = label::label("x", key: "fillcheck");
    n.set_background_color(vocab::Color::window_background());
    let p: *core::Node = #addr_of(n);
    let v: *u8 = views::create(0 as *u8, p);
    assert v != (0 as *u8);

    force_view_appearance(v, "NSAppearanceNameAqua");
    views::configure(v, p, paint::all_bits());
    let light: f64 = layer_fill_mean(v);

    force_view_appearance(v, "NSAppearanceNameDarkAqua");
    views::configure(v, p, paint::all_bits());
    let dark: f64 = layer_fill_mean(v);

    // windowBackground is pale in one and near-black in the other. Whichever way
    // round the machine's own appearance sits, these must NOT be the same fill.
    assert light >= 0.0f64;
    assert dark >= 0.0f64;
    assert light > 0.5f64;
    assert dark < 0.5f64;

    views::view_release(v);
    app::reset_default_for_tests();
    return;
}

#[test]
fn measuring_a_derived_ink_leaves_the_global_appearance_alone() {
    app::reset_default_for_tests();
    theme::set_theme(theme::Theme::new(
        primary: vocab::Color::rgba(0.98f64, 0.95f64, 0.87f64, 1.0f64)));

    // `NSAppearance.setCurrentAppearance:` IGNORES nil. So resolution code that
    // saves the current appearance, sets its own and puts the old one back pins
    // its appearance for the whole process the first time it runs with nothing
    // current — and every CGColor flattened afterwards resolves against that one
    // side. Live, that showed as themed fills stuck on one side while the labels
    // on top of them kept tracking the flip, because a label's colour is a real
    // NSColor and a fill is not.
    //
    // The other tests here cannot see it: they each set an appearance before
    // reading, which is exactly what hides a pinned one.
    match ak::Appearance::appearance_named("NSAppearanceNameAqua") {
        option::Option[ak::Appearance]::Some(a) => { ak::Appearance::set_current_appearance(a); }
        option::Option[ak::Appearance]::None => { }
    }
    let before: text::Text = ak::Appearance::current_appearance().name();

    // Forcing a CGColor runs the provider, which MEASURES the role beneath the
    // ink — the operation that used to leak.
    let ink: ak::Color = paint::ns_color(vocab::Color::on_primary());
    let _cg: *u8 = ink.c_g_color();

    let after: text::Text = ak::Appearance::current_appearance().name();
    assert before.view() == after.view();

    theme::set_theme(theme::Theme::new());
    app::reset_default_for_tests();
    return;
}

// ---- the per-kind bodies -----------------------------------------------------
// `create` and `apply` share one body per kind, so these assert through
// `create` (all bits) and then through `apply` (one bit) — the pairing that
// stops a control being right on mount and wrong on its first update.

#[test]
fn a_label_carries_its_text_through_create_and_apply() {
    var n: core::Node = label::label("Save", key: "title");
    let p: *core::Node = #addr_of(n);
    let v: *u8 = views::create(0 as *u8, p);
    assert v != (0 as *u8);
    let f: ak::TextField = ak::TextField::from_raw(v);
    assert f.as_control().string_value().view() == "Save";
    // A label is NOT editable — `labelWithString:` posture, not a text field.
    assert f.is_editable() == false;
    // The live path: the setter writes one field and sets one bit, and apply
    // reads exactly that.
    core::set_view(p, v, views::view_release);
    core::clear_dirty(p);
    match label::find("title", within: p) {
        option::Option[label::Label]::Some(l) => { let _l: label::Label = l.set_text("Saved"); }
        option::Option[label::Label]::None => { assert false; }
    }
    views::apply(0 as *u8, p);
    assert f.as_control().string_value().view() == "Saved";
    return;
}

#[test]
fn a_labels_transform_is_display_only() {
    // Uppercase is applied on the way to the VIEW; `text()` still reads back
    // what the application set, because a display transform is not a write.
    var n: core::Node = label::label("save", key: "t", text_transform: vocab::TextTransform::Uppercase);
    let p: *core::Node = #addr_of(n);
    let v: *u8 = views::create(0 as *u8, p);
    assert ak::TextField::from_raw(v).as_control().string_value().view() == "SAVE";
    match label::find("t", within: p) {
        option::Option[label::Label]::Some(l) => { assert l.text() == "save"; }
        option::Option[label::Label]::None => { assert false; }
    }
    views::view_release(v);
    return;
}

#[test]
fn a_button_carries_its_title_and_its_enabled_state() {
    var n: core::Node = button::button("Save", key: "save");
    let p: *core::Node = #addr_of(n);
    let v: *u8 = views::create(0 as *u8, p);
    assert v != (0 as *u8);
    let b: ak::Button = ak::Button::from_raw(v);
    assert b.title().view() == "Save";
    assert b.as_control().is_enabled();
    // `enabled` is the SHARED band, but NSControl's enabled is not the view's,
    // so the kind body has to forward it.
    core::set_view(p, v, views::view_release);
    core::clear_dirty(p);
    core::set_enabled(p, false);
    views::apply(0 as *u8, p);
    assert b.as_control().is_enabled() == false;
    return;
}

#[test]
fn a_text_field_is_editable_and_does_not_rewrite_what_it_already_says() {
    var n: core::Node = text_field::text_field(key: "name", text: "ada", placeholder: "who?");
    let p: *core::Node = #addr_of(n);
    let v: *u8 = views::create(0 as *u8, p);
    assert v != (0 as *u8);
    let f: ak::TextField = ak::TextField::from_raw(v);
    assert f.is_editable();
    assert f.as_control().string_value().view() == "ada";
    assert f.placeholder_string().view() == "who?";
    // The guard that matters while someone is typing: an apply whose value is
    // already on screen must not write it again, because writing moves the
    // insertion point.
    core::set_view(p, v, views::view_release);
    core::clear_dirty(p);
    core::touch(p, text_field::P_TEXT);
    views::apply(0 as *u8, p);
    assert f.as_control().string_value().view() == "ada";
    return;
}

#[test]
fn a_scroll_hosts_its_children_in_the_flipped_document_view() {
    // The one kind whose host is not its own view: children belong in the
    // document view, and that translation happens inside the backend where
    // facet cannot see it.
    var n: core::Node = scroll::scroll(key: "list");
    let p: *core::Node = #addr_of(n);
    let v: *u8 = views::create(0 as *u8, p);
    assert v != (0 as *u8);
    let host: *u8 = views::host_for(v);
    assert host != v;
    assert ak::View::from_raw(host).is_flipped();
    // A child inserted through the Renderer lands in the document view, not
    // as a sibling of the scrollers.
    var kid: core::Node = empty_keyed_column();
    let child: *u8 = views::create(0 as *u8, #addr_of(kid));
    views::insert(0 as *u8, v, child, 0 as usize);
    assert ak::View::from_raw(host).subviews().count() == (1 as usize);
    views::view_release(child);
    views::view_release(v);
    return;
}

#[test]
fn the_on_off_controls_carry_their_state_both_ways() {
    // checkbox / radio / toggle are three different AppKit things (a Switch
    // button, a Radio button, a real NSSwitch) reading one facet field, so
    // each is asserted through create AND through a live apply.
    var c: core::Node = checkbox::checkbox(key: "c", on: true);
    let cp: *core::Node = #addr_of(c);
    let cv: *u8 = views::create(0 as *u8, cp);
    assert ak::Button::from_raw(cv).state() == (1 as i64);
    core::set_view(cp, cv, views::view_release);
    core::clear_dirty(cp);
    match checkbox::find("c", within: cp) {
        option::Option[checkbox::Checkbox]::Some(h) => { let _h: checkbox::Checkbox = h.set_on(false); }
        option::Option[checkbox::Checkbox]::None => { assert false; }
    }
    views::apply(0 as *u8, cp);
    assert ak::Button::from_raw(cv).state() == (0 as i64);

    var t: core::Node = toggle::toggle(key: "t", on: true);
    let tv: *u8 = views::create(0 as *u8, #addr_of(t));
    assert ak::Switch::from_raw(tv).state() == (1 as i64);
    views::view_release(tv);

    var r: core::Node = radio::radio(key: "r", on: true);
    let rv: *u8 = views::create(0 as *u8, #addr_of(r));
    assert ak::Button::from_raw(rv).state() == (1 as i64);
    views::view_release(rv);
    return;
}

#[test]
fn a_sliders_range_is_written_before_its_value() {
    // The trap this guards: writing the value first clamps it against the OLD
    // range and the write is silently lost. A slider built at 0..100 with
    // value 75 must actually read 75.
    var s: core::Node = slider::slider(key: "s", minimum: 0.0f64, maximum: 100.0f64, value: 75.0f64);
    let p: *core::Node = #addr_of(s);
    let v: *u8 = views::create(0 as *u8, p);
    let sl: ak::Slider = ak::Slider::from_raw(v);
    assert sl.as_control().double_value() > 74.0f64;
    assert sl.as_control().double_value() < 76.0f64;
    // ...and the same on a live range change.
    core::set_view(p, v, views::view_release);
    core::clear_dirty(p);
    match slider::find("s", within: p) {
        option::Option[slider::Slider]::Some(h) => {
            let h2: slider::Slider = h.set_maximum(1000.0f64);
            let _h3: slider::Slider = h2.set_value(900.0f64);
        }
        option::Option[slider::Slider]::None => { assert false; }
    }
    views::apply(0 as *u8, p);
    assert sl.as_control().double_value() > 899.0f64;
    return;
}

#[test]
fn a_stepper_carries_its_range_increment_and_value() {
    var s: core::Node = stepper::stepper(key: "st", minimum: 1.0f64, maximum: 9.0f64,
                                         increment: 2.0f64, value: 5.0f64);
    let v: *u8 = views::create(0 as *u8, #addr_of(s));
    let st: ak::Stepper = ak::Stepper::from_raw(v);
    assert st.as_control().double_value() > 4.0f64;
    assert st.as_control().double_value() < 6.0f64;
    assert st.increment() > 1.5f64;
    views::view_release(v);
    return;
}

#[test]
fn progress_and_spinner_are_the_same_class_in_two_postures() {
    // A determinate bar over facet's 0..1 range...
    var pr: core::Node = progress::progress(0.5f64, key: "p");
    let pv: *u8 = views::create(0 as *u8, #addr_of(pr));
    let pi: ak::ProgressIndicator = ak::ProgressIndicator::from_raw(pv);
    assert pi.double_value() > 0.4f64;
    assert pi.double_value() < 0.6f64;
    assert pi.is_indeterminate() == false;
    views::view_release(pv);
    // ...and the indeterminate spinner, which must be told to ANIMATE: a
    // stopped one draws nothing, which reads as a broken view.
    var sp: core::Node = spinner::spinner(vocab::Color::clear(), key: "s", running: true);
    let sv: *u8 = views::create(0 as *u8, #addr_of(sp));
    assert ak::ProgressIndicator::from_raw(sv).is_indeterminate();
    views::view_release(sv);
    return;
}

#[test]
fn a_box_is_a_layer_of_colour_with_a_corner_radius() {
    // No AppKit control corresponds — NSBox is a titled grouping frame, which
    // is a different thing — so a box is a layer-backed view.
    var b: core::Node = box_view::box(vocab::Color::rgba(1.0f64, 0.0f64, 0.0f64, 1.0f64), key: "b",
                                      corner_radius: vocab::Corners::all(6.0f64));
    let v: *u8 = views::create(0 as *u8, #addr_of(b));
    let view: ak::View = ak::View::from_raw(v);
    assert view.wants_layer();
    assert view.layer().corner_radius() > 5.0f64;
    views::view_release(v);
    return;
}

#[test]
fn an_unimplemented_kind_still_gets_a_view_and_says_so() {
    // Loudly, once per kind, on stderr — a control that renders as a silent
    // blank rectangle is the failure INTENT is written against. It still gets
    // a backing view so layout and the tree stay honest.
    var n: core::Node = core::node_with("odd", props::K_SLIDER, 0 as *u8, core::no_release);
    let v: *u8 = views::create(0 as *u8, #addr_of(n));
    assert v != (0 as *u8);
    assert ak::View::from_raw(v).is_flipped();
    views::view_release(v);
    return;
}

// ---- the layout pass ---------------------------------------------------------

#[test]
fn the_frame_walk_places_children_top_left_and_host_relative() {
    backend::install();
    var b: core::Builder = core::Builder::new();
    b.add(core::column(core::Builder::new(), key: "first").height(40.0f64));
    b.add(core::column(core::Builder::new(), key: "second").height(60.0f64));
    var root: core::Node = core::column(b, key: "root");
    let rp: *core::Node = #addr_of(root);
    assert mount::mount(rp);
    geometry::relayout_root(rp, 200.0f64, 100.0f64, 1.0f64);
    // flex frames are ABSOLUTE; the native frame is host-relative, and the
    // host here is the root itself, whose own origin is 0,0.
    match core::find_in(rp, "second") {
        option::Option[*core::Node]::Some(sp) => {
            let v: *u8 = core::view_of(sp);
            assert v != (0 as *u8);
            let f: rt::Rect = ak::View::from_raw(v).frame();
            // Second child of a column: y is the first child's height, and it
            // is measured DOWN — no bottom-up flip anywhere.
            assert f.y > 39.0f64 && f.y < 41.0f64;
            assert f.h > 59.0f64 && f.h < 61.0f64;
        }
        option::Option[*core::Node]::None => { assert false; }
    }
    mount::unmount(rp);
    backend::uninstall();
    return;
}

#[test]
fn a_pass_through_container_places_against_the_nearest_host() {
    backend::install();
    // An unkeyed column gets no view, so its child hangs from the ROOT's view
    // and must be placed against the ROOT's frame, not its own.
    var ib: core::Builder = core::Builder::new();
    ib.add(core::column(core::Builder::new(), key: "deep").height(20.0f64));
    var b: core::Builder = core::Builder::new();
    b.add(core::column(core::Builder::new(), key: "spacer").height(30.0f64));
    b.add(core::column(ib));
    var root: core::Node = core::column(b, key: "root");
    let rp: *core::Node = #addr_of(root);
    assert mount::mount(rp);
    geometry::relayout_root(rp, 100.0f64, 100.0f64, 1.0f64);
    match core::find_in(rp, "deep") {
        option::Option[*core::Node]::Some(dp) => {
            let v: *u8 = core::view_of(dp);
            assert v != (0 as *u8);
            let f: rt::Rect = ak::View::from_raw(v).frame();
            // 30 down from the ROOT's top — the pass-through container
            // contributed no coordinate space of its own.
            assert f.y > 29.0f64 && f.y < 31.0f64;
        }
        option::Option[*core::Node]::None => { assert false; }
    }
    mount::unmount(rp);
    backend::uninstall();
    return;
}

#[test]
fn a_full_cache_hit_walks_nothing() {
    // The optimisation's own guard: an unchanged pass reports layout_changed()
    // false at the root and the walk returns immediately. If this ever stops
    // holding, a live drag goes back to O(tree) per frame.
    backend::install();
    var b: core::Builder = core::Builder::new();
    b.add(core::column(core::Builder::new(), key: "child").height(40.0f64));
    var root: core::Node = core::column(b, key: "root");
    let rp: *core::Node = #addr_of(root);
    assert mount::mount(rp);
    geometry::relayout_root(rp, 200.0f64, 100.0f64, 1.0f64);
    assert { (*rp).layout_changed() };
    // Same size, nothing touched: the engine skips the whole subtree.
    { (*rp).calculate_layout(width: 200.0f64, height: 100.0f64) };
    assert { (*rp).layout_changed() } == false;
    // A geometry write invalidates it again — and that write is exactly what
    // C_LAYOUT now tells the backend about.
    match core::find_in(rp, "child") {
        option::Option[*core::Node]::Some(cp) => { core::set_height(cp, 50.0f64); }
        option::Option[*core::Node]::None => { assert false; }
    }
    { (*rp).calculate_layout(width: 200.0f64, height: 100.0f64) };
    assert { (*rp).layout_changed() };
    mount::unmount(rp);
    backend::uninstall();
    return;
}

// ---- the tick ----------------------------------------------------------------

#[test]
fn a_write_arms_the_tick_and_the_tick_coalesces() {
    backend::install();
    var root: core::Node = empty_keyed_column();
    let rp: *core::Node = #addr_of(root);
    assert mount::mount(rp);
    // Drain whatever mounting armed.
    scheduler::tick();
    let before: u64 = scheduler::ticks();
    // Many writes, ONE pending tick — that is the whole point of coalescing
    // at before-waiting rather than syncing per write.
    core::set_opacity(rp, 0.5f64);
    core::set_visible(rp, true);
    core::set_opacity(rp, 0.6f64);
    assert scheduler::sync_pending();
    scheduler::tick();
    assert scheduler::ticks() == before +% (1 as u64);
    assert scheduler::sync_pending() == false;
    // ...and the tick applied them: the dirty word is clear.
    assert core::dirty_of(rp) == (0 as u64);
    // A tick with nothing pending does no work at all.
    scheduler::tick();
    assert scheduler::ticks() == before +% (1 as u64);
    mount::unmount(rp);
    backend::uninstall();
    return;
}

// ---- the window shell --------------------------------------------------------

#[test]
fn chrome_bar_styles_map_onto_the_two_appkit_knobs() {
    // Native is the only one that does NOT run content under the titlebar.
    assert window::wants_full_size_content(screen::Bar::Native) == false;
    assert window::wants_full_size_content(screen::Bar::Blended);
    assert window::wants_full_size_content(screen::Bar::Hidden);
    assert window::wants_full_size_content(screen::Bar::Custom);
    // ...and that shows up in the style mask, which is otherwise identical.
    let native: u64 = window::shell_style_mask(screen::Bar::Native);
    let custom: u64 = window::shell_style_mask(screen::Bar::Custom);
    assert (native & ak::window_style_mask_full_size_content_view) == (0 as u64);
    assert (custom & ak::window_style_mask_full_size_content_view) != (0 as u64);
    assert (native & ak::window_style_mask_titled) != (0 as u64);
    assert (native & ak::window_style_mask_resizable) != (0 as u64);
    return;
}

#[test]
fn open_window_mounts_shows_and_records_its_handle() {
    backend::install();
    app::reset_default_for_tests();
    var root: core::Node = empty_keyed_column();
    let rp: *core::Node = #addr_of(root);
    let win: *u8 = window::open_window(rp, screen::Chrome::new(title: "shell", width: 300.0f64, height: 200.0f64));
    assert win != (0 as *u8);
    // The window is on the APP's record, and its native handle with it — the
    // per-window door that replaced the CURRENT_WIN static.
    assert app::window_count() == (1 as usize);
    assert app::window_native(rp) == win;
    assert app::window_root_for_native(win) == rp;
    // The tree is mounted and its view is in the window's content view.
    assert core::is_attached(rp);
    let rv: *u8 = core::view_of(rp);
    assert rv != (0 as *u8);
    match ak::View::from_raw(rv).superview() {
        option::Option[ak::View]::Some(sv) => {
            // The content view is flipped, which is what makes the whole walk
            // top-left.
            assert sv.is_flipped();
        }
        option::Option[ak::View]::None => { assert false; }
    }
    // ...and it was laid out at the window's size, not left at zero.
    let f: rt::Rect = ak::View::from_raw(rv).frame();
    assert f.w > 200.0f64;
    window::close_window(win);
    backend::uninstall();
    app::reset_default_for_tests();
    return;
}

#[test]
fn open_window_refuses_a_null_root_and_close_is_inert() {
    backend::install();
    assert window::open_window(0 as *core::Node, screen::Chrome::new()) == (0 as *u8);
    // Closing nothing is a no-op, not a trap — the alloc-failure path.
    window::close_window(0 as *u8);
    backend::uninstall();
    return;
}

// ---- a menu item says ⇧/⌥ on top of its ⌘ -----------------------------------
//
// `key:` alone always meant ⌘, and every bare ⌘ letter in an editor is taken —
// five commands shipped with NO shortcut rather than fight over them. `shift:`
// and `alt:` ADD to the ⌘; Command stays in the mask, or the item would become
// a bare-letter shortcut that fires while the user types.

#[test]
fn a_menu_items_shift_and_alt_reach_the_key_equivalent_mask() {
    backend::install();
    var it: screen::MenuItem = screen::MenuItem::new("Go", "Find References",
                                                     key: "f", shift: true, alt: true);
    assert it.shift;
    assert it.alt;
    let raw: *u8 = window::new_menu_item(#addr_of(it));
    assert raw != (0 as *u8);
    let mi: ak::MenuItem = ak::MenuItem::from_raw(raw);
    assert mi.key_equivalent().view() == "f";
    // Command | Shift | Option.
    assert mi.key_equivalent_modifier_mask() == (1703936 as u64);
    return;
}

#[test]
fn a_menu_item_without_modifiers_keeps_the_plain_command_mask() {
    backend::install();
    // The negative half: a bare `key:` stays exactly what it always was —
    // AppKit's own Command default, untouched by this code path.
    var it: screen::MenuItem = screen::MenuItem::new("File", "Save", key: "s");
    assert it.shift == false;
    assert it.alt == false;
    let raw: *u8 = window::new_menu_item(#addr_of(it));
    assert raw != (0 as *u8);
    let mi: ak::MenuItem = ak::MenuItem::from_raw(raw);
    assert mi.key_equivalent_modifier_mask() == (1048576 as u64);   // Command alone
    return;
}

#[test]
fn add_command_carries_the_modifiers_through() {
    var m: screen::AppMenu = screen::app_menu("probe");
    m.add_command("Go", "Show Callers", key: "c", shift: true);
    m.add_item("Go", "Go to Symbol", "g", 0 as u32, alt: true);
    match m.items.at_ptr(0 as usize) {
        option::Option[*screen::MenuItem]::Some(it) => {
            assert { (*it).shift };
            assert { (*it).alt } == false;
        }
        option::Option[*screen::MenuItem]::None => { assert false; }
    }
    match m.items.at_ptr(1 as usize) {
        option::Option[*screen::MenuItem]::Some(it) => {
            assert { (*it).shift } == false;
            assert { (*it).alt };
        }
        option::Option[*screen::MenuItem]::None => { assert false; }
    }
    return;
}

// ---- install -----------------------------------------------------------------

#[test]
fn install_is_idempotent_and_uninstall_restores_the_portable_posture() {
    backend::uninstall();
    assert mount::installed() == false;
    backend::install();
    assert backend::installed();
    assert mount::installed();
    backend::install();                      // twice: still one backend
    assert mount::installed();
    // is_dark answers through the platform while installed...
    let _d: bool = theme::is_dark();
    backend::uninstall();
    // ...and falls back to light (the neutral default) with none.
    assert theme::is_dark() == false;
    assert mount::installed() == false;
    return;
}

// ---- the text and picker batch -----------------------------------------------

#[test]
fn a_text_area_is_a_text_view_inside_a_scroll_view() {
    // The scroller is not optional on AppKit: a bare NSTextView does not
    // scroll, and a multi-line editor that cannot scroll is not one. So the
    // view facet holds is the SCROLL view, and the editor is reached through it.
    var n: core::Node = text_area::text_area(key: "body", text: "hello");
    let p: *core::Node = #addr_of(n);
    let v: *u8 = views::create(0 as *u8, p);
    assert v != (0 as *u8);
    match controls::text_area_editor(v) {
        option::Option[ak::TextView]::Some(tv) => {
            assert tv.as_text().string().view() == "hello";
            assert tv.is_editable();
        }
        option::Option[ak::TextView]::None => { assert false; }
    }
    views::view_release(v);
    return;
}

#[test]
fn a_popup_rebuilds_its_items_then_selects() {
    // The ordering trap: a selection written before the items indexes a list
    // that is not there yet, and AppKit quietly keeps the old one.
    var items: vocab::TextList = vocab::TextList::new();
    let _a: status::Status = items.add("one");
    let _b: status::Status = items.add("two");
    let _c: status::Status = items.add("three");
    var n: core::Node = popup::popup("pick", key: "pick", selected_index: 2 as i64);
    let p: *core::Node = #addr_of(n);
    match popup::find("pick", within: p) {
        option::Option[popup::Popup]::Some(h) => { let _h: popup::Popup = h.set_items(items); }
        option::Option[popup::Popup]::None => { assert false; }
    }
    let v: *u8 = views::create(0 as *u8, p);
    let b: ak::PopUpButton = ak::PopUpButton::from_raw(v);
    // Four rows, not three: `popup("pick", ...)` names the PROMPT, and a
    // prompt is an item — so the application's index 2 is native row 3.
    assert b.number_of_items() == (4 as i64);
    assert b.index_of_selected_item() == (3 as i64);
    assert selected_title(b) == "three";
    views::view_release(v);
    return;
}

#[test]
fn a_split_maps_facets_arrangement_onto_appkits_divider() {
    // facet names the ARRANGEMENT (Columns = side by side); AppKit names the
    // DIVIDER (`vertical` = a vertical divider). One negation apart, and
    // backwards would transpose every split in an app.
    assert controls::is_vertical_divider(split::SplitAxis::Columns);
    assert controls::is_vertical_divider(split::SplitAxis::Rows) == false;
    var n: core::Node = split::split(core::Builder::new(), key: "s", axis: split::SplitAxis::Columns);
    let v: *u8 = views::create(0 as *u8, #addr_of(n));
    assert ak::SplitView::from_raw(v).is_vertical();
    views::view_release(v);
    return;
}

#[test]
fn a_bordered_strokes_its_layer() {
    var n: core::Node = bordered::bordered(key: "b", stroke_width: 2.0f64,
        stroke: vocab::Brush::solid(vocab::Color::rgba(0.0f64, 1.0f64, 0.0f64, 1.0f64)));
    let v: *u8 = views::create(0 as *u8, #addr_of(n));
    let view: ak::View = ak::View::from_raw(v);
    assert view.wants_layer();
    assert view.layer().border_width() > 1.5f64;
    views::view_release(v);
    return;
}

#[test]
fn page_dots_are_drawn_as_sublayers_and_re_tint_without_rebuilding() {
    // AppKit ships nothing of the kind, so they are drawn — as sublayers
    // rather than a drawRect: override, which means no synthesized NSView
    // subclass and a free re-tint on a theme change.
    var n: core::Node = page_dots::page_dots(key: "dots", count: 4 as i64, position: 1 as i64);
    let p: *core::Node = #addr_of(n);
    let v: *u8 = views::create(0 as *u8, p);
    let host: quartz::Layer = ak::View::from_raw(v).layer();
    assert host.sublayers().count() == (4 as usize);
    // A position change re-tints and does NOT rebuild the row — a page turn
    // happens constantly, a count change almost never.
    core::set_view(p, v, views::view_release);
    core::clear_dirty(p);
    core::touch(p, page_dots::P_POSITION);
    views::apply(0 as *u8, p);
    assert host.sublayers().count() == (4 as usize);
    return;
}

#[test]
fn a_single_hidden_dot_draws_nothing() {
    // hides_single is the whole point of a one-page indicator: it is noise.
    var n: core::Node = page_dots::page_dots(key: "d", count: 1 as i64, hides_single: true);
    let v: *u8 = views::create(0 as *u8, #addr_of(n));
    assert ak::View::from_raw(v).layer().sublayers().count() == (0 as usize);
    views::view_release(v);
    // ...and max_dots caps a long row rather than letting it run off the edge.
    var many: core::Node = page_dots::page_dots(key: "m", count: 50 as i64, max_dots: 6 as i64);
    let mv: *u8 = views::create(0 as *u8, #addr_of(many));
    assert ak::View::from_raw(mv).layer().sublayers().count() == (6 as usize);
    views::view_release(mv);
    return;
}

// ---- the civil-date bridge ---------------------------------------------------

#[test]
fn days_from_civil_is_exact_across_the_cases_that_break_naive_maths() {
    // The epoch itself, and the day either side of it.
    assert controls::days_from_civil(1970 as i64, 1 as i64, 1 as i64) == (0 as i64);
    assert controls::days_from_civil(1969 as i64, 12 as i64, 31 as i64) == (-1 as i64);
    assert controls::days_from_civil(1970 as i64, 1 as i64, 2 as i64) == (1 as i64);
    // A leap day, and the day after it.
    assert controls::days_from_civil(2024 as i64, 2 as i64, 29 as i64) == (19782 as i64);
    assert controls::days_from_civil(2024 as i64, 3 as i64, 1 as i64) == (19783 as i64);
    // 2000 IS a leap year (divisible by 400) and 1900 is NOT (by 100 but not
    // 400) — the pair that catches a naive rule.
    assert controls::days_from_civil(2000 as i64, 3 as i64, 1 as i64)
         -% controls::days_from_civil(2000 as i64, 2 as i64, 28 as i64) == (2 as i64);
    assert controls::days_from_civil(1900 as i64, 3 as i64, 1 as i64)
         -% controls::days_from_civil(1900 as i64, 2 as i64, 28 as i64) == (1 as i64);
    // ...and it runs backwards through the epoch without a discontinuity.
    assert controls::days_from_civil(1900 as i64, 1 as i64, 1 as i64) == (-25567 as i64);
    return;
}

#[test]
fn a_civil_date_survives_its_own_round_trip_through_the_picker() {
    // The reason the picker is pinned to UTC: a civil date has no time zone,
    // so rendering it in the machine's local zone would send 2026-01-01 back
    // as 2025-12-31 anywhere west of Greenwich — the value would not survive
    // the trip it was just given.
    var n: core::Node = date_picker::date_picker(
        vocab::Date { year: 2026 as i64, month: 1 as i64, day: 1 as i64 }, key: "when");
    let v: *u8 = views::create(0 as *u8, #addr_of(n));
    let dp: ak::DatePicker = ak::DatePicker::from_raw(v);
    // What went in is what the control holds: the same instant, to the second.
    let want: f64 = (controls::days_from_civil(2026 as i64, 1 as i64, 1 as i64) as f64)
                  * controls::seconds_per_day();
    let got: f64 = { rt::msg_f64(dp.date_value().raw(),
                                 rt::sel(#str_ptr("timeIntervalSince1970\0"))) };
    assert got - want < 1.0f64;
    assert want - got < 1.0f64;
    views::view_release(v);
    return;
}

#[test]
fn an_unset_date_leaves_the_picker_alone() {
    // A zeroed Date is "unset", not year zero: it must not be written as an
    // instant two millennia ago.
    assert controls::ns_date(vocab::Date::zero()) == (0 as *u8);
    var n: core::Node = date_picker::date_picker(vocab::Date::zero(), key: "d");
    let v: *u8 = views::create(0 as *u8, #addr_of(n));
    assert v != (0 as *u8);          // still a real picker, showing today
    views::view_release(v);
    return;
}

#[test]
fn a_time_is_an_offset_into_a_day() {
    // facet's TimePicker carries a Duration because a time of day IS an offset
    // into a day — the one reading that needs no calendar at all.
    var n: core::Node = time_picker::time_picker(
        vocab::Duration { seconds: 3600.0f64 * 9.0f64 + 60.0f64 * 30.0f64 }, key: "t");
    let v: *u8 = views::create(0 as *u8, #addr_of(n));
    let dp: ak::DatePicker = ak::DatePicker::from_raw(v);
    let got: f64 = { rt::msg_f64(dp.date_value().raw(),
                                 rt::sel(#str_ptr("timeIntervalSince1970\0"))) };
    assert got > 34199.0f64 && got < 34201.0f64;      // 09:30 on the epoch day
    views::view_release(v);
    return;
}

#[test]
fn a_tab_pane_is_an_ordinary_subview_and_gains_a_tab_for_it() {
    // NSTabView's panes were NSTabViewItems it sized itself, and facet lays
    // every node out with flex — so the two wrote the same frame and neither
    // reading put a pane in the right place. The strip is facet's own now, so a
    // pane is an ordinary subview and `views::insert` lost its second special
    // case.
    backend::install();
    var t: core::Node = tabs::tabs(key: "tabs");
    var pane: core::Node = core::column(core::Builder::new(), key: "Settings");
    t.add_child(pane);
    let p: *core::Node = #addr_of(t);
    // `create` binds the node onto the host, which is what lets the strip be
    // rebuilt when a pane arrives.
    let host: *u8 = views::create(0 as *u8, p);
    core::set_view(p, host, views::view_release);
    let child: *u8 = views::create(0 as *u8, match_child(p, 0 as usize));
    core::set_view(match_child(p, 0 as usize), child, views::view_release);
    views::insert(0 as *u8, host, child, 0 as usize);
    // The pane is a subview of the host, not an item of anything.
    assert { rt::msg_i8_id(child, rt::sel(#str_ptr("isDescendantOf:\0")), host) } != (0 as i8);
    // And the strip gained a button whose title is the pane's KEY, because a
    // tab needs a title and every addressable node already has one.
    let strip: *u8 = controls::tab_strip_of(host);
    assert strip != (0 as *u8);
    let tabs_in: vec::Vec[ak::View] = ak::View::from_raw(strip).subviews();
    assert tabs_in.count() == (1 as usize);
    match tabs_in.at_ptr(0 as usize) {
        option::Option[*ak::View]::Some(b) => {
            assert ak::Button::from_raw({ (*b).raw() }).title().view() == "Settings";
        }
        option::Option[*ak::View]::None => { assert false; }
    }
    return;
}

// ---- the menu tier: a kind that is not a view --------------------------------

#[test]
fn a_context_menu_is_not_a_view_and_hangs_on_its_parent() {
    // An NSMenu is not an NSView. Both menu kinds answer wants_view false, so
    // the mount walk creates nothing for them and they take no place in the
    // native tree — the menu is read from the NODES when the PARENT's view is
    // built, and hung on that view.
    var probe: core::Node = context_menu::context_menu(key: "probe");
    assert views::wants_view(#addr_of(probe)) == false;
    var probe_item: core::Node = context_menu_item::context_menu_item("Rename", key: "pi");
    assert views::wants_view(#addr_of(probe_item)) == false;

    var menu_node: core::Node = context_menu::context_menu(key: "cm");
    let mp: *core::Node = #addr_of(menu_node);
    assert mount::add_child(mp, context_menu_item::context_menu_item("Rename", key: "ren",
        shortcut: vocab::Shortcut::of("r", modifiers: vocab::KeyModifiers::Cmd)));
    assert mount::add_child(mp, context_menu_item::context_menu_item(""));   // a separator
    assert mount::add_child(mp, context_menu_item::context_menu_item("Delete", key: "del",
        destructive: true));

    let built: *u8 = controls::build_context_menu(mp);
    assert built != (0 as *u8);
    let m: ak::Menu = ak::Menu::from_raw(built);
    assert m.number_of_items() == (3 as i64);
    match m.item_at_index(0 as i64) {
        option::Option[ak::MenuItem]::Some(mi) => {
            assert mi.title().view() == "Rename";
            // The key equivalent is the row context_menu_item declares on its
            // own account, on top of the inherited MenuItem band — so this
            // asserts both halves of the base fix at once.
            assert mi.key_equivalent().view() == "r";
            assert mi.key_equivalent_modifier_mask() == (1048576 as u64);   // Command
        }
        option::Option[ak::MenuItem]::None => { assert false; }
    }
    // A titleless item is a separator: the ledger has no separator type, and that is
    // what every menu-building API means by one.
    match m.item_at_index(1 as i64) {
        option::Option[ak::MenuItem]::Some(sep) => { assert sep.is_separator_item(); }
        option::Option[ak::MenuItem]::None => { assert false; }
    }
    match m.item_at_index(2 as i64) {
        option::Option[ak::MenuItem]::Some(d) => { assert d.title().view() == "Delete"; }
        option::Option[ak::MenuItem]::None => { assert false; }
    }
    // Nothing that is not a context_menu builds one.
    var plain: core::Node = core::column(core::Builder::new(), key: "row");
    assert controls::build_context_menu(#addr_of(plain)) == (0 as *u8);
    return;
}

#[test]
fn a_node_with_a_context_menu_child_gets_it_hung_on_its_view() {
    // End to end: the menu node is a CHILD of the row, has no view of its own,
    // and its menu ends up on the row's view — which is what makes a
    // right-click on the row open it. This is the macOS answer to the
    // swipe-to-reveal actions MANIFEST.md records as impossible, and unlike a
    // swipe it has a keyboard path.
    var menu_node: core::Node = context_menu::context_menu(key: "cm2");
    assert mount::add_child(#addr_of(menu_node), context_menu_item::context_menu_item("Open", key: "o"));
    var b: core::Builder = core::Builder::new();
    b.add(menu_node);
    var row: core::Node = core::column(b, key: "row2");
    let v: *u8 = views::create(0 as *u8, #addr_of(row));
    assert v != (0 as *u8);
    let hung: *u8 = { rt::msg_id(v, rt::sel(#str_ptr("menu\0"))) };
    assert hung != (0 as *u8);
    assert ak::Menu::from_raw(hung).number_of_items() == (1 as i64);
    views::view_release(v);
    return;
}

// ---- span, and the kinds that are decided rather than missing ----------------

#[test]
fn a_labels_spans_become_one_attributed_string() {
    // A span is a styled RUN inside a label, not a thing of its own — so it is
    // not a view, and the label reads its span children instead of its own
    // text. A formatted label's text IS its runs; its own `text` would be a
    // second, contradictory answer to the same question.
    var l: core::Node = label::label("ignored", key: "styled");
    let lp: *core::Node = #addr_of(l);
    assert mount::add_child(lp, span::span("Hello ", key: "a"));
    assert mount::add_child(lp, span::span("world", key: "b",
        font_weight: vocab::FontWeight::Bold,
        text_color: vocab::Color::rgba(1.0f64, 0.0f64, 0.0f64, 1.0f64)));
    assert controls::has_spans(lp);
    var lone: core::Node = span::span("x");
    assert views::wants_view(#addr_of(lone)) == false;

    let v: *u8 = views::create(0 as *u8, lp);
    let f: ak::TextField = ak::TextField::from_raw(v);
    // The runs joined, and the label's OWN text nowhere in sight.
    assert f.as_control().string_value().view() == "Hello world";
    views::view_release(v);

    // A label with no spans still renders its own text, unchanged.
    var plain: core::Node = label::label("Save", key: "plain");
    assert controls::has_spans(#addr_of(plain)) == false;
    let pv: *u8 = views::create(0 as *u8, #addr_of(plain));
    assert ak::TextField::from_raw(pv).as_control().string_value().view() == "Save";
    views::view_release(pv);
    return;
}

#[test]
fn a_swipeable_shows_its_content_and_reveals_by_menu() {
    // The kind that had no answer at all. "Swipe-to-reveal is a touch idiom;
    // use a context menu" — and the second half of that sentence was the
    // answer sitting unwritten next to the first.
    assert controls::decided_absent(props::K_SWIPEABLE) == false;
    assert controls::decided_absent(props::K_BUTTON) == false;
    var r: core::Node = swipeable::swipeable(key: "r");
    let v: *u8 = views::create(0 as *u8, #addr_of(r));
    assert v != (0 as *u8);
    assert ak::View::from_raw(v).is_flipped();
    // No swipe items, no menu: an empty menu on a view is a right-click that
    // opens nothing, which reads as broken.
    assert { rt::msg_id(v, rt::sel(#str_ptr("menu\0"))) } == (0 as *u8);
    views::view_release(v);
    return;
}

// ---- the collection group ----------------------------------------------------

static ROWS_BUILT: i32 = 0;

fn t_row(i: usize, ctx: *u8) -> flex::Node {
    ROWS_BUILT = ROWS_BUILT + 1;
    return label::label("row", key: "r");
}

#[test]
fn a_list_asks_for_no_rows_until_the_table_asks_for_them() {
    // This test used to assert the opposite — that a list MATERIALISED its rows
    // as ordinary children — and that was the honest description of what the
    // backend did until the recycler landed. The rows are AppKit's now: the
    // table asks for one when it needs it, so a list of three and a list of ten
    // thousand cost the same at create.
    //
    // `collection` still materialises, and the difference is deliberate: a
    // collection is a grid whose items flex against each other, which is not
    // what an NSTableView row is.
    ROWS_BUILT = 0;
    var l: core::Node = list::list(key: "rows");
    let lp: *core::Node = #addr_of(l);
    match list::find("rows", within: lp) {
        option::Option[list::List]::Some(h) => {
            let h2: list::List = h.set_row(t_row, ctx: 0 as *u8);
            let _h3: list::List = h2.set_count(3 as usize);
        }
        option::Option[list::List]::None => { assert false; }
    }
    let v: *u8 = views::create(0 as *u8, lp);
    assert v != (0 as *u8);
    assert ROWS_BUILT == 0;
    assert l.child_count() == (0 as usize);
    assert recycler::row_count_of(v) == (3 as i64);
    // A count change is one question with the builder — either replaces the
    // whole sequence — so it reloads rather than patching.
    core::set_view(lp, v, views::view_release);
    core::clear_dirty(lp);
    match list::find("rows", within: lp) {
        option::Option[list::List]::Some(h) => { let _h: list::List = h.set_count(5 as usize); }
        option::Option[list::List]::None => { assert false; }
    }
    views::apply(0 as *u8, lp);
    assert recycler::row_count_of(v) == (5 as i64);
    return;
}

#[test]
fn a_list_hosts_its_rows_in_the_scrolls_document_view() {
    // A sequence host is the same flipped document view a `scroll` uses, so
    // `host_for` redirects rows into it with no extra case.
    var l: core::Node = list::list(key: "l2");
    let v: *u8 = views::create(0 as *u8, #addr_of(l));
    let host: *u8 = views::host_for(v);
    assert host != v;
    assert ak::View::from_raw(host).is_flipped();
    views::view_release(v);
    return;
}

#[test]
fn a_tree_shows_only_open_branches_and_costs_nothing_for_closed_ones() {
    // This used to assert that a tree MATERIALISED its open rows as children,
    // which is what the backend did before the outline view. The rule it was
    // protecting is unchanged and now AppKit's: a closed branch has no rows, so
    // its subtree costs nothing however deep it is.
    backend::install();
    var root: tree::TreeNode = tree::TreeNode::new("root", id: "root");
    var a: tree::TreeNode = tree::TreeNode::new("a", id: "a");
    let _deep: status::Status = a.add_child(tree::TreeNode::new("a1", id: "a1"));
    let _a: status::Status = root.add_child(a);
    let _b: status::Status = root.add_child(tree::TreeNode::new("b", id: "b"));

    var t: core::Node = tree::tree(root, key: "t");
    let tp: *core::Node = #addr_of(t);
    let v: *u8 = views::create(0 as *u8, tp);
    assert v != (0 as *u8);
    core::set_view(tp, v, views::view_release);
    // The rows are AppKit's now, not facet's children — that is the whole
    // change, and this is where it shows.
    assert t.child_count() == (0 as usize);
    views::apply(0 as *u8, tp);
    // Nothing expanded: the root's two children show, "a1" does not.
    assert recycler::tree_row_count_of(v) == (2 as i64);

    // Expand "a" and its child appears. facet's expanded set is the MODEL and
    // the outline view's own state follows it.
    core::clear_dirty(tp);
    var open: vocab::TextList = vocab::TextList::new();
    let _o: status::Status = open.add("a");
    match tree::find("t", within: tp) {
        option::Option[tree::Tree]::Some(h) => { let _h: tree::Tree = h.set_expanded(open); }
        option::Option[tree::Tree]::None => { assert false; }
    }
    views::apply(0 as *u8, tp);
    assert recycler::tree_row_count_of(v) == (3 as i64);
    return;
}

#[test]
fn a_tree_item_is_the_tree_node_itself() {
    backend::install();
    // NSOutlineView's data source is item-based and facet's tree is already a
    // model of items, so the item IS the *TreeNode — nothing maps an index onto
    // a node, and nothing can drift when the model changes shape.
    var root: tree::TreeNode = tree::TreeNode::new("root", id: "root");
    let _a: status::Status = root.add_child(tree::TreeNode::new("only", id: "only"));
    var t: core::Node = tree::tree(root, key: "t2");
    let tp: *core::Node = #addr_of(t);
    let v: *u8 = views::create(0 as *u8, tp);
    core::set_view(tp, v, views::view_release);
    views::apply(0 as *u8, tp);
    assert recycler::tree_row_count_of(v) == (1 as i64);
    // A row's cell holds the realised subtree, the same second mount path a
    // list row takes. With no row builder given, that subtree is the node's own
    // label — which never rendered until 2026-08-04, because the "did the app
    // give a builder" test compared against null and the default is a real
    // function that answers an empty node.
    let cell: *u8 = recycler::tree_view_for_row(v, 0 as i64);
    assert cell != (0 as *u8);
    assert ak::View::from_raw(cell).subviews().count() == (1 as usize);
    return;
}

// A row builder that states no height, so the row's size can only come from
// the label measuring itself — which it can only do once it has a native view.
fn intrinsic_tree_row(n: *tree::TreeNode, ctx: *u8) -> core::Node {
    return label::label({ (*n).label.view() });
}

// A tree renders rows you can SEE.
//
// Both places that size a row used to lay it out before it was realised. A
// label's intrinsic height arrives with the measure callback the backend
// installs while creating its native view, so an unrealised label measured
// zero, clamped to one point, and every row in the tree was one pixel tall:
// present, selectable, expandable, invisible. It bit the height query and the
// cell separately, so fixing one left the other — a correctly sized row
// containing one pixel of text.
#[test]
fn a_default_tree_row_is_taller_than_one_point() {
    backend::install();
    var root: tree::TreeNode = tree::TreeNode::new("root", id: "root");
    let _a: status::Status = root.add_child(tree::TreeNode::new("alpha", id: "alpha"));
    var t: core::Node = tree::tree(root, key: "th1");
    let tp: *core::Node = #addr_of(t);
    let v: *u8 = views::create(0 as *u8, tp);
    core::set_view(tp, v, views::view_release);
    views::apply(0 as *u8, tp);
    assert recycler::tree_row_count_of(v) == (1 as i64);

    let cell: *u8 = recycler::tree_view_for_row(v, 0 as i64);
    assert cell != (0 as *u8);
    let h: f64 = { ak::View::from_raw(cell).frame().h };
    assert h > 1.0f64;
    // The default row states its height, so both the height query and the cell
    // agree on one number rather than each guessing.
    assert h == controls::DEFAULT_TREE_ROW_H;

    // And the label inside it fills the row rather than sitting one pixel tall
    // in the middle of it.
    let subs: vec::Vec[ak::View] = ak::View::from_raw(cell).subviews();
    assert subs.count() == (1 as usize);
    match subs.at_ptr(0 as usize) {
        option::Option[*ak::View]::Some(sv) => { assert { (*sv).frame().h } > 1.0f64; }
        option::Option[*ak::View]::None => { assert false; }
    }
    return;
}

// The same rule for a row the APPLICATION built. Its height is intrinsic and
// nothing states it, so it is only knowable after realising — which is now the
// order the cell path uses.
#[test]
fn a_row_built_by_the_app_is_measured_after_it_is_realised() {
    backend::install();
    var root: tree::TreeNode = tree::TreeNode::new("root", id: "root");
    let _a: status::Status = root.add_child(tree::TreeNode::new("beta", id: "beta"));
    var t: core::Node = tree::tree(root, key: "th2", row: intrinsic_tree_row);
    let tp: *core::Node = #addr_of(t);
    let v: *u8 = views::create(0 as *u8, tp);
    core::set_view(tp, v, views::view_release);
    views::apply(0 as *u8, tp);

    let cell: *u8 = recycler::tree_view_for_row(v, 0 as i64);
    assert cell != (0 as *u8);
    assert { ak::View::from_raw(cell).frame().h } > 1.0f64;
    return;
}

// A stated `row_height` still wins outright — it is asked before the model is
// consulted at all, which is what makes it the cheap answer.
#[test]
fn a_stated_row_height_is_used_as_given() {
    backend::install();
    var root: tree::TreeNode = tree::TreeNode::new("root", id: "root");
    let _a: status::Status = root.add_child(tree::TreeNode::new("gamma", id: "gamma"));
    var t: core::Node = tree::tree(root, key: "th3", row_height: 31.0f64);
    let tp: *core::Node = #addr_of(t);
    let v: *u8 = views::create(0 as *u8, tp);
    core::set_view(tp, v, views::view_release);
    views::apply(0 as *u8, tp);
    assert recycler::tree_row_height_of(v, 0 as i64) == 31.0f64;
    return;
}

// ---- the last kinds ----------------------------------------------------------

#[test]
fn the_menu_bar_tier_builds_but_does_not_occupy_the_tree() {
    // An NSMenu, an NSMenuItem and an NSToolbarItem are objects the
    // APPLICATION or the WINDOW owns — not rectangles in a tree. So all three
    // are non-view kinds, and controls:: builds the AppKit object while the
    // window tier installs it.
    var m: core::Node = menu::menu("File", key: "file");
    assert views::wants_view(#addr_of(m)) == false;
    var item: core::Node = menu_item::menu_item("Open", key: "open");
    assert views::wants_view(#addr_of(item)) == false;
    var ti: core::Node = toolbar_item::toolbar_item("Share", key: "share");
    assert views::wants_view(#addr_of(ti)) == false;

    let mp: *core::Node = #addr_of(m);
    assert mount::add_child(mp, menu_item::menu_item("Open", key: "o"));
    assert mount::add_child(mp, menu_item::menu_item(""));            // a separator
    assert mount::add_child(mp, menu_item::menu_item("Close", key: "c"));
    let built: *u8 = controls::build_menu(mp);
    assert built != (0 as *u8);
    let ns: ak::Menu = ak::Menu::from_raw(built);
    assert ns.title().view() == "File";
    assert ns.number_of_items() == (3 as i64);
    // The same separator rule as a context menu's items, because they are the
    // same object — two sets of rules would be two answers to one question.
    match ns.item_at_index(1 as i64) {
        option::Option[ak::MenuItem]::Some(sep) => { assert sep.is_separator_item(); }
        option::Option[ak::MenuItem]::None => { assert false; }
    }
    // A toolbar item's identifier is the node's KEY: NSToolbar addresses items
    // by identifier, facet addresses nodes by key, one need answered once.
    let tb: *u8 = controls::build_toolbar_item(#addr_of(ti));
    assert tb != (0 as *u8);
    let ident: *u8 = { rt::msg_id(tb, rt::sel(#str_ptr("itemIdentifier\0"))) };
    assert bridge::to_text(ident).view() == "share";
    // Nothing that is not one builds one.
    var plain: core::Node = core::column(core::Builder::new(), key: "x");
    assert controls::build_menu(#addr_of(plain)) == (0 as *u8);
    assert controls::build_toolbar_item(#addr_of(plain)) == (0 as *u8);
    return;
}

// ---- canvas ------------------------------------------------------------------
// The replay is checked AT THE PIXELS. A bitmap context is the same CGContext
// `drawRect:` gets, so a test can hand `drawing::replay` one, run a recording
// through it and read the bytes back — which is the only honest way to assert
// that a drawing verb draws.

#[link_name = "CGBitmapContextCreate"]
extern fn bitmap_context_create(data: *u8, width: usize, height: usize,
                                bits_per_component: usize, bytes_per_row: usize,
                                space: *u8, info: u32) -> *u8;
extern fn CGContextRelease(c: *u8);
extern fn CGColorSpaceCreateDeviceRGB() -> *u8;
extern fn CGColorSpaceRelease(cs: *u8);
extern fn CGContextTranslateCTM(c: *u8, tx: f64, ty: f64);
extern fn CGContextScaleCTM(c: *u8, sx: f64, sy: f64);

// A 4x4 RGBA surface, set up the way AppKit sets one up for a flipped view:
// y down, origin top-left. Returns a context at +1, or 0.
//
// kCGImageAlphaPremultipliedLast = 1, so the bytes are R,G,B,A per pixel, and
// data row 0 is the TOP row — which is what makes the flip assertable below.
fn surface_of_side(pixels: *u8, side: usize) -> *u8 {
    let space: *u8 = CGColorSpaceCreateDeviceRGB();
    if space == (0 as *u8) { return 0 as *u8; }
    let ctx: *u8 = bitmap_context_create(pixels, side, side, 8 as usize,
                                         side * (4 as usize), space, 1 as u32);
    CGColorSpaceRelease(space);
    if ctx == (0 as *u8) { return 0 as *u8; }
    CGContextTranslateCTM(ctx, 0.0f64, side as f64);
    CGContextScaleCTM(ctx, 1.0f64, -1.0f64);
    return ctx;
}

fn test_surface(pixels: *u8) -> *u8 { return surface_of_side(pixels, 4 as usize); }

// Alpha at (x, y) on a 16-wide surface. Alpha, not a colour channel, because
// it answers "did anything land here" whatever the colour was.
fn alpha_at(px: *u8, x: usize, y: usize) -> u8 {
    let i: usize = (y * (16 as usize) + x) * (4 as usize) + (3 as usize);
    return { *({ px as usize + i } as *u8) };
}

#[test]
fn a_canvas_is_its_own_flipped_view_class() {
    // The one control with a class of its own, because it is the one control
    // that draws. Flipped like every other backing view, so the recording's
    // coordinates need no adjustment anywhere.
    var c: core::Node = canvas::canvas(key: "c");
    let v: *u8 = views::create(0 as *u8, #addr_of(c));
    assert v != (0 as *u8);
    assert rt::msg_i8(v, rt::sel(#str_ptr("isFlipped\0"))) == (1 as i8);
    assert synth::object_class(v) == drawing::canvas_view_class();
    views::view_release(v);
    return;
}

#[test]
fn a_recorded_fill_reaches_the_pixels_top_down() {
    var px: [u8; 64] = [0u8; 64];
    let ctx: *u8 = test_surface(#addr_of(px[0 as usize]));
    assert ctx != (0 as *u8);

    // The TOP half, in the canvas's own top-left coordinates.
    var c: vocab::Canvas = vocab::Canvas::of(vocab::Size::of(4.0f64, 4.0f64));
    let _a: status::Status = c.set_fill(vocab::Color::rgba(1.0f64, 0.0f64, 0.0f64));
    let _b: status::Status = c.fill_rect(vocab::Rect::of(0.0f64, 0.0f64, 4.0f64, 2.0f64));
    drawing::replay(ctx, #addr_of(c));

    // Row 0 is the top of the image, so a fill at y=0 lands there. This is the
    // whole flip contract in one assertion.
    assert px[0 as usize] == (255 as u8);        // row 0, red
    assert px[1 as usize] == (0 as u8);
    assert px[16 as usize] == (255 as u8);       // row 1, red
    assert px[32 as usize] == (0 as u8);         // row 2, untouched
    assert px[48 as usize] == (0 as u8);         // row 3, untouched
    CGContextRelease(ctx);
    return;
}

#[test]
fn a_clip_stops_the_paint_and_restore_puts_it_back() {
    var px: [u8; 64] = [0u8; 64];
    let ctx: *u8 = test_surface(#addr_of(px[0 as usize]));
    assert ctx != (0 as *u8);

    var c: vocab::Canvas = vocab::Canvas::of(vocab::Size::of(4.0f64, 4.0f64));
    let _a: status::Status = c.set_fill(vocab::Color::rgba(0.0f64, 1.0f64, 0.0f64));
    let _b: status::Status = c.save();
    let _d: status::Status = c.clip_rect(vocab::Rect::of(0.0f64, 0.0f64, 4.0f64, 1.0f64));
    let _e: status::Status = c.fill_rect(vocab::Rect::of(0.0f64, 0.0f64, 4.0f64, 4.0f64));
    let _f: status::Status = c.restore();
    // Outside the clip now that it is restored — and a DIFFERENT colour, so a
    // clip that silently did nothing cannot pass this.
    let _g: status::Status = c.set_fill(vocab::Color::rgba(0.0f64, 0.0f64, 1.0f64));
    let _h: status::Status = c.fill_rect(vocab::Rect::of(0.0f64, 3.0f64, 4.0f64, 1.0f64));
    drawing::replay(ctx, #addr_of(c));

    assert px[1 as usize] == (255 as u8);        // row 0 green, inside the clip
    assert px[17 as usize] == (0 as u8);         // row 1 clipped out
    assert px[50 as usize] == (255 as u8);       // row 3 blue, after the restore
    CGContextRelease(ctx);
    return;
}

#[test]
fn a_gradient_brush_paints_a_different_colour_at_each_end() {
    var px: [u8; 64] = [0u8; 64];
    let ctx: *u8 = test_surface(#addr_of(px[0 as usize]));
    assert ctx != (0 as *u8);

    // 90 degrees: top to bottom in a y-down space.
    var c: vocab::Canvas = vocab::Canvas::of(vocab::Size::of(4.0f64, 4.0f64));
    let _a: status::Status = c.set_fill_brush(
        vocab::Brush { start: vocab::Color::rgba(1.0f64, 0.0f64, 0.0f64),
                       end: vocab::Color::rgba(0.0f64, 0.0f64, 1.0f64),
                       angle: 90.0f64, is_gradient: true },
        across: vocab::Rect::sized(4.0f64, 4.0f64));
    let _b: status::Status = c.fill_rect(vocab::Rect::sized(4.0f64, 4.0f64));
    drawing::replay(ctx, #addr_of(c));

    // Red at one end, blue at the other. Which end is which is the angle's
    // business; that they DIFFER is the gradient's.
    assert px[0 as usize] != px[48 as usize];
    assert px[2 as usize] != px[50 as usize];
    CGContextRelease(ctx);
    return;
}

#[test]
fn a_path_fill_reaches_the_pixels() {
    var px: [u8; 64] = [0u8; 64];
    let ctx: *u8 = test_surface(#addr_of(px[0 as usize]));
    assert ctx != (0 as *u8);

    var p: vocab::Path = vocab::Path::new();
    let _a: status::Status = p.move_to(vocab::Point::of(0.0f64, 0.0f64));
    let _b: status::Status = p.line_to(vocab::Point::of(4.0f64, 0.0f64));
    let _d: status::Status = p.line_to(vocab::Point::of(4.0f64, 4.0f64));
    let _e: status::Status = p.line_to(vocab::Point::of(0.0f64, 4.0f64));
    let _f: status::Status = p.close();

    var c: vocab::Canvas = vocab::Canvas::of(vocab::Size::of(4.0f64, 4.0f64));
    let _g: status::Status = c.set_fill(vocab::Color::rgba(1.0f64, 1.0f64, 1.0f64));
    let _h: status::Status = c.fill_path(#addr_of(p));
    drawing::replay(ctx, #addr_of(c));

    assert px[0 as usize] == (255 as u8);
    assert px[63 as usize] == (255 as u8);       // the last pixel's alpha
    CGContextRelease(ctx);
    return;
}

#[test]
fn text_reaches_the_pixels() {
    var px: [u8; 64] = [0u8; 64];
    let ctx: *u8 = test_surface(#addr_of(px[0 as usize]));
    assert ctx != (0 as *u8);

    var c: vocab::Canvas = vocab::Canvas::of(vocab::Size::of(4.0f64, 4.0f64));
    let _a: status::Status = c.set_text_color(vocab::Color::rgba(1.0f64, 1.0f64, 1.0f64));
    let _b: status::Status = c.set_font(size: 12.0f64);
    let _d: status::Status = c.draw_text_block("MMMM", box: vocab::Rect::sized(4.0f64, 4.0f64));
    drawing::replay(ctx, #addr_of(c));

    // Some ink landed. Which glyphs, at which subpixel, is AppKit's business
    // and not ours to assert — the standing rule is to test our bindings, not
    // Apple's text engine.
    var lit: bool = false;
    var i: usize = 0 as usize;
    while i < (64 as usize) {
        if px[i] != (0 as u8) { lit = true; }
        i = i +% (1 as usize);
    }
    assert lit;
    CGContextRelease(ctx);
    return;
}

#[test]
fn a_shadow_falls_DOWN_from_a_positive_y_offset() {
    // The screenshot bug this test exists for: a shadow's offset is NOT
    // carried through the CTM, so the flip that makes everything else
    // top-left does not reach it, and a positive y threw the shadow UP.
    // The ledger negates it in the same place (`#if MONOMAC`).
    var px: [u8; 1024] = [0u8; 1024];
    let ctx: *u8 = surface_of_side(#addr_of(px[0 as usize]), 16 as usize);
    assert ctx != (0 as *u8);

    var c: vocab::Canvas = vocab::Canvas::of(vocab::Size::of(16.0f64, 16.0f64));
    let _a: status::Status = c.set_shadow(vocab::Shadow {
        color: vocab::Color::rgba(0.0f64, 0.0f64, 0.0f64, 1.0f64),
        offset: vocab::Point::of(0.0f64, 4.0f64),
        radius: 1.0f64, opacity: 1.0f64 });
    let _b: status::Status = c.set_fill(vocab::Color::rgba(1.0f64, 0.0f64, 0.0f64));
    let _d: status::Status = c.fill_rect(vocab::Rect::of(4.0f64, 4.0f64, 8.0f64, 4.0f64));
    drawing::replay(ctx, #addr_of(c));

    let below: u8 = alpha_at(#addr_of(px[0 as usize]), 8 as usize, 10 as usize);
    let above: u8 = alpha_at(#addr_of(px[0 as usize]), 8 as usize, 1 as usize);
    assert below > (0 as u8);
    assert above == (0 as u8);
    CGContextRelease(ctx);
    return;
}

#[test]
fn an_arc_sweeps_the_way_clockwise_says() {
    // 0 degrees is 3 o'clock and 90 is 12 o'clock, so `clockwise: true` from
    // 0 to 90 is the LONG way — down through 6 and 9 — and `false` is the
    // quarter through the top right. That reads backwards until you notice
    // the angles are measured the ordinary way while the screen's y runs
    // down; the ledger resolves it identically (`AddArc(..., !clockwise)` over
    // negated angles), and this pins it so nobody "fixes" it by eye.
    var wide: [u8; 1024] = [0u8; 1024];
    let a: *u8 = surface_of_side(#addr_of(wide[0 as usize]), 16 as usize);
    assert a != (0 as *u8);
    var cw: vocab::Canvas = vocab::Canvas::of(vocab::Size::of(16.0f64, 16.0f64));
    let _a: status::Status = cw.set_fill(vocab::Color::rgba(1.0f64, 0.0f64, 0.0f64));
    let _b: status::Status = cw.fill_arc(vocab::Rect::sized(16.0f64, 16.0f64),
                                          from: 0.0f64, to: 90.0f64, clockwise: true);
    drawing::replay(a, #addr_of(cw));

    var narrow: [u8; 1024] = [0u8; 1024];
    let b: *u8 = surface_of_side(#addr_of(narrow[0 as usize]), 16 as usize);
    assert b != (0 as *u8);
    var ccw: vocab::Canvas = vocab::Canvas::of(vocab::Size::of(16.0f64, 16.0f64));
    let _d: status::Status = ccw.set_fill(vocab::Color::rgba(1.0f64, 0.0f64, 0.0f64));
    let _e: status::Status = ccw.fill_arc(vocab::Rect::sized(16.0f64, 16.0f64),
                                           from: 0.0f64, to: 90.0f64, clockwise: false);
    drawing::replay(b, #addr_of(ccw));

    // A closed arc is arc-plus-CHORD, so the two fills are complements about
    // the chord from 3 o'clock to 12 o'clock: the long way is the 3/4 disc,
    // the quarter is the thin segment outside that chord.
    //
    // Bottom left: in the 3/4 disc, not in the segment.
    assert alpha_at(#addr_of(wide[0 as usize]), 5 as usize, 11 as usize) > (0 as u8);
    assert alpha_at(#addr_of(narrow[0 as usize]), 5 as usize, 11 as usize) == (0 as u8);
    // Beyond the chord at the top right: in the segment, not in the 3/4 disc.
    assert alpha_at(#addr_of(narrow[0 as usize]), 12 as usize, 3 as usize) > (0 as u8);
    assert alpha_at(#addr_of(wide[0 as usize]), 12 as usize, 3 as usize) == (0 as u8);
    CGContextRelease(a);
    CGContextRelease(b);
    return;
}

#[test]
fn a_drawing_that_records_nothing_draws_nothing() {
    var px: [u8; 64] = [0u8; 64];
    let ctx: *u8 = test_surface(#addr_of(px[0 as usize]));
    assert ctx != (0 as *u8);
    var c: vocab::Canvas = vocab::Canvas::of(vocab::Size::of(4.0f64, 4.0f64));
    drawing::replay(ctx, #addr_of(c));
    // And neither does a null one, which is the path a canvas with no Drawable
    // takes every time it is asked to draw.
    drawing::replay(ctx, 0 as *vocab::Canvas);
    drawing::replay(0 as *u8, #addr_of(c));
    assert px[0 as usize] == (0 as u8);
    assert px[63 as usize] == (0 as u8);
    CGContextRelease(ctx);
    return;
}

#[test]
fn window_buttons_wait_for_a_window_before_adopting() {
    // The REAL traffic lights get re-parented, not a drawing of them — so the
    // green button keeps its hover menu and full-screen behaviour. They can
    // only be fetched once the view is in a window, and it is not in one at
    // create time, so the node is an empty box of the right size until then
    // and adoption happens on a later apply.
    var wb: core::Node = chrome::window_buttons(key: "wb");
    let v: *u8 = views::create(0 as *u8, #addr_of(wb));
    assert v != (0 as *u8);
    assert ak::View::from_raw(v).subviews().count() == (0 as usize);
    // Applying off-window is inert rather than a trap.
    views::apply(0 as *u8, #addr_of(wb));
    views::view_release(v);
    return;
}

#[test]
fn every_kind_now_has_an_answer() {
    // The sweep's own guard: no kind falls to the unimplemented path any more.
    // A kind added later without a body will fail here, which is the point.
    var k: u32 = 1 as u32;
    while k <= (38 as u32) {
        assert views::has_body(k);
        k = k +% (1 as u32);
    }
    // web and hybrid_web were the last two deferrals, and the deferral was
    // the missing package rather than anything AppKit could not do. With
    // vendor/webkit landed there is nothing left on the warning path.
    assert views::has_body(props::K_WEB);
    assert views::has_body(props::K_HYBRID_WEB);
    assert views::has_body(1000 as u32);      // symbol
    assert views::has_body(1001 as u32);      // tree
    assert views::has_body(1002 as u32);      // split
    assert views::has_body(1003 as u32);      // window_buttons
    assert views::has_body(core::K_NODE);     // the container backing
    return;
}

// ---- input: the gesture band, the key band, the sender readers ---------------
// Stage 4 item 4. What CAN be asserted here is asserted; what cannot — whether
// a real click feels right — ends with "run it and try", per the standing rule.
// A synthesized NSEvent is a real NSEvent, so the key reader is fully testable.

static IN_CLICKS: i64 = 0 as i64;
static IN_KEYS: i64 = 0 as i64;

fn in_took(sender: *u8, ctx: *u8) -> bool { IN_CLICKS = IN_CLICKS + (1 as i64); return true; }
fn in_declined(sender: *u8, ctx: *u8) -> bool { IN_CLICKS = IN_CLICKS + (1 as i64); return false; }
fn in_key(event: *u8, ctx: *u8) -> bool { IN_KEYS = IN_KEYS + (1 as i64); return true; }
static IN_DOUBLES: i64 = 0 as i64;
fn in_double(sender: *u8, ctx: *u8) -> bool { IN_DOUBLES = IN_DOUBLES + (1 as i64); return true; }

// A bare function name is not a value in C+ (E0312): the handler is bound to a
// typed const first, and these are the ones the tests below hand to `gesture`.
fn h_took() -> gestures::Handler { let f: gestures::Handler = in_took; return f; }
fn h_declined() -> gestures::Handler { let f: gestures::Handler = in_declined; return f; }
fn h_key() -> gestures::Handler { let f: gestures::Handler = in_key; return f; }
fn h_double() -> gestures::Handler { let f: gestures::Handler = in_double; return f; }

// A real NSEvent, built the way AppKit builds one. `keyCode` is what the
// reader maps; the characters and flags ride along.
fn fake_key_event(code: u16, chars: str, flags: u64) -> *u8 {
    return { msg_key_event(
        rt::get_class(#str_ptr("NSEvent\0")),
        rt::sel(#str_ptr("keyEventWithType:location:modifierFlags:timestamp:windowNumber:context:characters:charactersIgnoringModifiers:isARepeat:keyCode:\0")),
        10 as u64,                       // NSEventTypeKeyDown
        rt::Point { x: 0.0f64, y: 0.0f64 },
        flags, 0.0f64, 0 as i64, 0 as *u8,
        bridge::nsstring(chars), bridge::nsstring(chars), 0 as i8, code) };
}

#[link_name = "objc_msgSend"]
extern fn msg_key_event(recv: *u8, sel: *u8, ty: u64, loc: rt::Point, flags: u64,
                        ts: f64, win: i64, cx: *u8, chars: *u8, ignoring: *u8,
                        repeat: i8, code: u16) -> *u8;
// `keyCode` is `unsigned short` and the last two arguments land on the STACK
// (x0..x7 are full by then). Apple's arm64 ABI packs stack arguments at their
// natural alignment, so declaring it u64 reads the wrong slot — the modifier
// flags come through fine because they ride a register, which is exactly why
// this was invisible until the code was asserted.

#[test]
fn a_gesture_node_is_backed_even_without_a_key() {
    // Input arrives on a VIEW. An unkeyed container with gestures would
    // otherwise describe a handler nothing could ever deliver to.
    var bare: core::Node = core::column(core::Builder::new());
    assert views::wants_view(#addr_of(bare)) == false;
    var touched: core::Node = core::column(core::Builder::new()).gesture(on_click: h_took());
    assert views::wants_view(#addr_of(touched));
    return;
}

#[test]
fn a_painted_node_is_backed_even_without_a_key_or_a_gesture() {
    // Drawing arrives on a view exactly as input does. A container styled with
    // a fill, a radius and a clip, carrying neither a key nor a handler, was
    // laid out and contributed its size — and the styling went nowhere. Every
    // filled pill on a card sheet read as bare words floating where a button
    // should be, and nothing warned.
    var bare: core::Node = core::column(core::Builder::new());
    assert views::wants_view(#addr_of(bare)) == false;

    var filled: core::Node = core::column(core::Builder::new());
    core::set_background_color(#addr_of(filled), vocab::Color::system_blue());
    assert views::wants_view(#addr_of(filled));

    var rounded: core::Node = core::column(core::Builder::new());
    core::set_corner_radius(#addr_of(rounded), vocab::Corners::all(6.0f64));
    assert views::wants_view(#addr_of(rounded));

    var clipped: core::Node = core::column(core::Builder::new());
    core::set_clip(#addr_of(clipped), vocab::Shape::rounded(6.0f64));
    assert views::wants_view(#addr_of(clipped));

    var faded: core::Node = core::column(core::Builder::new());
    core::set_opacity(#addr_of(faded), 0.5f64);
    assert views::wants_view(#addr_of(faded));

    var hidden: core::Node = core::column(core::Builder::new());
    core::set_visible(#addr_of(hidden), false);
    assert views::wants_view(#addr_of(hidden));

    var turned: core::Node = core::column(core::Builder::new());
    core::set_rotation(#addr_of(turned), 90.0f64);
    assert views::wants_view(#addr_of(turned));

    // And a node that asks for NONE of it still costs nothing — the whole
    // point of the passthrough rule.
    var plain: core::Node = core::column(core::Builder::new());
    assert views::wants_painting(#addr_of(plain)) == false;
    assert views::wants_view(#addr_of(plain)) == false;
    return;
}

#[test]
fn arming_moves_the_class_and_keeps_the_original_as_super() {
    // The decline chain needs `super`, and `super` needs the backing class to
    // still be there — so the view's isa moves onto a SUBCLASS of what it was,
    // never onto a replacement. An NSButton stays an NSButton.
    var n: core::Node = button::button("Save", key: "b").gesture(on_click: h_took());
    let p: *core::Node = #addr_of(n);
    let original: *u8 = synth::object_class(controls::create_button(p));
    let v: *u8 = views::create(0 as *u8, p);
    assert v != (0 as *u8);
    let armed: *u8 = synth::object_class(v);
    assert armed != original;
    assert input::class_super(armed) == original;
    // Idempotent: apply re-arms on every C_GESTURES write and the class must
    // move exactly once, or the second swap would subclass our own subclass.
    core::set_view(p, v, views::view_release);
    core::touch(p, core::C_GESTURES);
    views::apply(0 as *u8, p);
    assert synth::object_class(v) == armed;
    return;
}

#[test]
fn a_second_node_of_the_same_kind_reuses_the_class() {
    // One subclass per BACKING class: a thousand gesture rows over three
    // control kinds make three classes, not a thousand.
    var a: core::Node = core::column(core::Builder::new(), key: "a").gesture(on_click: h_took());
    var b: core::Node = core::column(core::Builder::new(), key: "b").gesture(on_click: h_took());
    let va: *u8 = views::create(0 as *u8, #addr_of(a));
    let vb: *u8 = views::create(0 as *u8, #addr_of(b));
    assert synth::object_class(va) == synth::object_class(vb);
    views::view_release(va);
    views::view_release(vb);
    return;
}

#[test]
fn a_gesture_view_answers_performclick_for_the_agent() {
    // THE AGENT'S ONLY DOOR. `click` on the agent surface sends `performClick:`
    // to the backing view; agent_appkit guards the send with `respondsToSelector:`
    // and answers NotActionable when the view does not, because an unguarded
    // send used to raise. A plain NSView carrying a gesture answered nothing, so
    // every `.gesture(on_click:)` node was mouse-only — which is the unreachable
    // affordance facet's own agent doctrine calls the bug.
    //
    // The old backend wired the handler twice for exactly this reason and left a
    // test saying so. The regeneration dropped both; this is the test back.
    IN_CLICKS = 0 as i64;
    var n: core::Node = core::column(core::Builder::new(), key: "row").gesture(on_click: h_took());
    let p: *core::Node = #addr_of(n);
    let v: *u8 = views::create(0 as *u8, p);
    assert v != (0 as *u8);
    assert synth::class_responds(synth::object_class(v),
                                 rt::sel(#str_ptr("performClick:\0"))) != (0 as i8);
    // ...and it FIRES the node's click handler, not merely answers the selector.
    { rt::msg_void_id(v, rt::sel(#str_ptr("performClick:\0")), 0 as *u8) };
    assert IN_CLICKS == (1 as i64);
    views::view_release(v);
    return;
}

#[test]
fn a_node_without_gestures_keeps_its_class() {
    // Arming is not free — it costs a class and an association — so a tree
    // that asks for no input pays for none of it.
    var n: core::Node = core::column(core::Builder::new(), key: "plain");
    let v: *u8 = views::create(0 as *u8, #addr_of(n));
    assert synth::object_class(v) == akx::flipped_view_class();
    views::view_release(v);
    return;
}

#[test]
fn the_key_reader_reads_a_real_nsevent() {
    backend::install();
    // The platform code comes through raw...
    let esc: *u8 = fake_key_event(53 as u16, "", 0 as u64);
    assert gestures::key_code(esc) == (53 as i64);
    // ...and the NAME is what an app branches on, so it never spells 53.
    assert gestures::key_named(esc) == gestures::key_escape();
    let ret: *u8 = fake_key_event(36 as u16, "\r", 0 as u64);
    assert gestures::key_named(ret) == gestures::key_return();
    // Keypad enter is Return too: an app that asks "was that enter" means both.
    assert gestures::key_named(fake_key_event(76 as u16, "\r", 0 as u64))
           == gestures::key_return();
    let left: *u8 = fake_key_event(123 as u16, "", 0 as u64);
    assert gestures::key_named(left) == gestures::key_arrow_left();
    // A printable key has no name and is read through its characters.
    let a: *u8 = fake_key_event(0 as u16, "a", 0 as u64);
    assert gestures::key_named(a) == gestures::key_none();
    assert gestures::key_chars(a).view() == "a";
    return;
}

#[test]
fn modifier_flags_are_translated_not_cast() {
    backend::install();
    // NSEventModifierFlag* live at bits 17..20; facet's are 0..3. An app must
    // never see an AppKit constant, so this is a translation.
    let shift: u64 = 131072 as u64;
    let command: u64 = 1048576 as u64;
    let e: *u8 = fake_key_event(0 as u16, "A", shift | command);
    let m: u64 = gestures::key_modifiers(e);
    assert gestures::has_modifier(m, gestures::mod_shift());
    assert gestures::has_modifier(m, gestures::mod_command());
    assert gestures::has_modifier(m, gestures::mod_control()) == false;
    assert gestures::has_modifier(m, gestures::mod_option()) == false;
    // And the raw flags are NOT what came back.
    assert m != (shift | command);
    return;
}

#[test]
fn a_key_handler_is_what_makes_a_view_focusable() {
    // `acceptsFirstResponder` is answered from the node, not hardcoded: a
    // gesture set with no key handler must not start swallowing tab focus.
    var clicky: core::Node = core::column(core::Builder::new(), key: "c").gesture(on_click: h_took());
    let vc: *u8 = views::create(0 as *u8, #addr_of(clicky));
    assert rt::msg_i8(vc, rt::sel(#str_ptr("acceptsFirstResponder\0"))) == (0 as i8);
    var keyed: core::Node = core::column(core::Builder::new(), key: "k").gesture(on_key: h_key());
    let vk: *u8 = views::create(0 as *u8, #addr_of(keyed));
    assert rt::msg_i8(vk, rt::sel(#str_ptr("acceptsFirstResponder\0"))) == (1 as i8);
    views::view_release(vc);
    views::view_release(vk);
    return;
}

#[test]
fn the_sender_readers_walk_up_to_the_nearest_tagged_view() {
    backend::install();
    // A click on an untagged icon inside a tagged row answers the ROW — which
    // is what makes one handler over two hundred rows work.
    var row: core::Node = core::column(core::Builder::new(), key: "row:7");
    let rv: *u8 = views::create(0 as *u8, #addr_of(row));
    var icon: core::Node = core::column(core::Builder::new());
    let iv: *u8 = views::create(0 as *u8, #addr_of(icon));
    assert iv == (0 as *u8);                       // unkeyed, ungestured: no view
    let inner: *u8 = rt::retain(akx::new_flipped_view(
        rt::Rect { x: 0.0f64, y: 0.0f64, w: 1.0f64, h: 1.0f64 }).raw());
    ak::View::from_raw(rv).add_subview(ak::View::from_raw(inner));

    assert component::key_of(rv).view() == "row:7";
    assert component::key_of(inner).view() == "row:7";
    // Nothing tagged anywhere up the chain is an empty answer, not a trap.
    assert component::key_of(0 as *u8).view() == "";
    rt::release(inner);
    views::view_release(rv);
    return;
}

#[test]
fn an_item_reaches_the_sender_that_carries_it() {
    backend::install();
    // The gap this closed: SenderReaders declared `item_of` against a `.item(p)`
    // verb facet never had, so it could only ever answer null.
    var marker: i64 = 99 as i64;
    var row: core::Node = core::column(core::Builder::new(), key: "row");
    let p: *core::Node = #addr_of(row);
    core::set_item(p, #addr_of(marker) as *u8);
    assert core::item_of(p) == (#addr_of(marker) as *u8);
    let v: *u8 = views::create(0 as *u8, p);
    assert component::item_of(v) == (#addr_of(marker) as *u8);
    // ...and up the walk, from a child that carries none of its own.
    let inner: *u8 = rt::retain(akx::new_flipped_view(
        rt::Rect { x: 0.0f64, y: 0.0f64, w: 1.0f64, h: 1.0f64 }).raw());
    ak::View::from_raw(v).add_subview(ak::View::from_raw(inner));
    assert component::item_of(inner) == (#addr_of(marker) as *u8);
    rt::release(inner);
    views::view_release(v);
    return;
}

#[test]
fn raise_puts_the_keyed_element_in_front_of_its_siblings() {
    backend::install();
    // The no-rebuild z-order change: facet is not reactive, so the element is
    // addressed and moved rather than re-described.
    let w: ak::Window = window::make_shell_window(
        screen::Chrome::new(title: "t", width: 200.0f64, height: 200.0f64));
    match w.content_view() {
        option::Option[ak::View]::Some(content) => {
            var a: core::Node = core::column(core::Builder::new(), key: "a");
            var b: core::Node = core::column(core::Builder::new(), key: "b");
            let va: *u8 = views::create(0 as *u8, #addr_of(a));
            let vb: *u8 = views::create(0 as *u8, #addr_of(b));
            content.add_subview(ak::View::from_raw(va));
            content.add_subview(ak::View::from_raw(vb));
            // b is last, so b is in front.
            assert input::find_by_key(content.raw(), "a") == va;
            assert content.subviews().count() == (2 as usize);
            input::raise(vb, "a");
            // a is last now — on AppKit, last in `subviews` IS the front.
            match content.subviews().at_ptr(1 as usize) {
                option::Option[*ak::View]::Some(last) => { assert { (*last).raw() } == va; }
                option::Option[*ak::View]::None => { assert false; }
            }
            views::view_release(va);
            views::view_release(vb);
        }
        option::Option[ak::View]::None => { assert false; }
    }
    w.close();
    return;
}

fn digits_i64(n: i64) -> text::Text {
    if n == (0 as i64) { return text::from_str("0"); }
    if n < (0 as i64) { return text::from_str("negative"); }
    var stack: [i64; 20] = #zero::[[i64; 20]]();
    var v: i64 = n;
    var i: usize = 0 as usize;
    while v > (0 as i64) && i < (20 as usize) {
        stack[i] = v % (10 as i64);
        v = v / (10 as i64);
        i = i +% (1 as usize);
    }
    var out: text::Text = text::new();
    while i > (0 as usize) {
        i = i -% (1 as usize);
        let d: i64 = stack[i];
        if d == (0 as i64) { let _z: status::Status = out.append("0"); }
        else if d == (1 as i64) { let _z: status::Status = out.append("1"); }
        else if d == (2 as i64) { let _z: status::Status = out.append("2"); }
        else if d == (3 as i64) { let _z: status::Status = out.append("3"); }
        else if d == (4 as i64) { let _z: status::Status = out.append("4"); }
        else if d == (5 as i64) { let _z: status::Status = out.append("5"); }
        else if d == (6 as i64) { let _z: status::Status = out.append("6"); }
        else if d == (7 as i64) { let _z: status::Status = out.append("7"); }
        else if d == (8 as i64) { let _z: status::Status = out.append("8"); }
        else { let _z: status::Status = out.append("9"); }
    }
    return out;
}

fn registered_drag_types(v: *u8) -> u64 {
    let a: *u8 = { rt::msg_id(v, rt::sel(#str_ptr("registeredDraggedTypes\0"))) };
    if a == (0 as *u8) { return 0 as u64; }
    return { rt::msg_u64(a, rt::sel(#str_ptr("count\0"))) };
}

#[test]
fn a_drop_zone_registers_only_when_it_asks_to() {
    backend::install();
    // `allow_drop` is the switch: a view that never asked is not a dragging
    // destination, and AppKit will not offer it one.
    // The gate is REGISTRATION, not the selector: both views share one class
    // (one per backing kind), so a per-view gate could never be a method —
    // adding one would decide the other view's behaviour too.
    var plain: core::Node = core::column(core::Builder::new(), key: "p").gesture(on_click: h_took());
    let vp: *u8 = views::create(0 as *u8, #addr_of(plain));
    var zone: core::Node = core::column(core::Builder::new(), key: "z")
        .gesture(on_drop: h_took(), allow_drop: true);
    let vz: *u8 = views::create(0 as *u8, #addr_of(zone));
    assert synth::object_class(vp) == synth::object_class(vz);
    assert registered_drag_types(vp) == (0 as u64);
    assert registered_drag_types(vz) > (0 as u64);
    assert component::drag_targeted(vz) == false;
    assert component::dropped_text(vz).view() == "";
    views::view_release(vp);
    views::view_release(vz);
    return;
}

// ---- web and hybrid_web ------------------------------------------------------
// Stage 4 item 5's first two rows, unblocked by vendor/webkit. What is asserted
// is that the contract REACHES WebKit; what a page then renders is WebKit's
// business, not ours to test.

#[test]
fn a_web_view_is_a_wkwebview_with_a_navigation_delegate() {
    var n: core::Node = web_ui::web(source: "", key: "w");
    let v: *u8 = views::create(0 as *u8, #addr_of(n));
    assert v != (0 as *u8);
    assert synth::class_responds(synth::object_class(v),
                                 rt::sel(#str_ptr("loadRequest:\0"))) != (0 as i8);
    // The delegate is pinned to the view, so it lives exactly as long as the
    // thing it speaks for — no static, no registry.
    let d: *u8 = { rt::msg_id(v, rt::sel(#str_ptr("navigationDelegate\0"))) };
    assert d != (0 as *u8);
    assert synth::object_class(d) == webmod::delegate_class();
    views::view_release(v);
    return;
}

#[test]
fn a_source_is_read_three_ways_and_they_cannot_be_confused() {
    // The ledger's Source is a WebViewSource — URL or HTML. facet reduced it to a
    // `str`, so the STRING has to say which, and these are the three readings.
    assert webmod::starts_with_angle("<h1>hi</h1>");
    assert webmod::starts_with_angle("https://x") == false;
    assert webmod::has_scheme("https://example.com");
    assert webmod::has_scheme("file:///tmp/a.html");
    assert webmod::has_scheme("/tmp/a.html") == false;
    assert webmod::has_scheme("ab") == false;
    // A file grants read access to its FOLDER, or its stylesheet is refused
    // and the page looks broken rather than blocked.
    assert webmod::parent_of("/tmp/site/index.html").view() == "/tmp/site";
    assert webmod::parent_of("index.html").view() == ".";
    assert webmod::parent_of("/index.html").view() == "/";
    return;
}

#[test]
fn the_navigation_band_reaches_the_web_view() {
    var n: core::Node = web_ui::web(source: "https://example.com", key: "nav");
    let p: *core::Node = #addr_of(n);
    let v: *u8 = views::create(0 as *u8, p);
    assert v != (0 as *u8);
    core::set_view(p, v, views::view_release);
    // The commands are one-shot bits, and each has to reach a real selector.
    match web_ui::find("nav", within: p) {
        option::Option[web_ui::Web]::Some(x) => {
            core::clear_dirty(p);
            let _a: web_ui::Web = x.reload();
            assert (core::dirty_of(p) & web_ui::P_RELOAD) != (0 as u64);
            views::apply(0 as *u8, p);
            core::clear_dirty(p);
            let _b: web_ui::Web = x.go_back();
            assert (core::dirty_of(p) & web_ui::P_GO_BACK) != (0 as u64);
            views::apply(0 as *u8, p);
            core::clear_dirty(p);
            let _c: web_ui::Web = x.eval("1 + 1");
            assert (core::dirty_of(p) & web_ui::P_EVAL) != (0 as u64);
            views::apply(0 as *u8, p);
            // A read whose truth lives in the platform: nothing has loaded, so
            // there is nowhere to go back TO, and the props say so.
            assert x.can_go_back() == false;
        }
        option::Option[web_ui::Web]::None => { assert false; }
    }
    // The load is still in flight, and WebKit retains the page while it is —
    // so releasing the view does NOT deallocate it, and a callback arriving
    // afterwards would read a node that has gone. `detach` is what makes that
    // callback inert, and this is the test that leaves one in flight.
    views::view_release(v);
    core::set_view(p, 0 as *u8, core::no_release);
    return;
}

#[test]
fn a_hybrid_view_carries_the_message_channel_both_ways() {
    var n: core::Node = hybrid_ui::hybrid_web(key: "h");
    let p: *core::Node = #addr_of(n);
    let v: *u8 = views::create(0 as *u8, p);
    assert v != (0 as *u8);
    // The page's door back: one handler, named `facet`, on the content
    // controller the view was built with.
    let cfg: *u8 = { rt::msg_id(v, rt::sel(#str_ptr("configuration\0"))) };
    assert cfg != (0 as *u8);
    let ucc: *u8 = { rt::msg_id(cfg, rt::sel(#str_ptr("userContentController\0"))) };
    assert ucc != (0 as *u8);
    // ...and facet's door out. `send_message` is a command, so it raises its
    // bit and apply is what runs the script.
    core::set_view(p, v, views::view_release);
    match hybrid_ui::find("h", within: p) {
        option::Option[hybrid_ui::HybridWeb]::Some(x) => {
            core::clear_dirty(p);
            let _a: hybrid_ui::HybridWeb = x.send_message("hello");
            assert (core::dirty_of(p) & hybrid_ui::P_SEND_MESSAGE) != (0 as u64);
            views::apply(0 as *u8, p);
        }
        option::Option[hybrid_ui::HybridWeb]::None => { assert false; }
    }
    return;
}

#[test]
fn a_message_body_is_escaped_before_it_becomes_a_script() {
    // The body is spliced into JavaScript, so a quote or a newline in it would
    // otherwise end the literal and run whatever followed.
    assert webmod::json_string("plain").view() == "\"plain\"";
    assert webmod::json_string("say \"hi\"").view() == "\"say \\\"hi\\\"\"";
    assert webmod::json_string("a\nb").view() == "\"a\\nb\"";
    assert webmod::json_string("c:\\path").view() == "\"c:\\\\path\"";
    assert webmod::json_string("").view() == "\"\"";
    return;
}

// ---- the window tier: item 5 -------------------------------------------------
// The rows the ledger deferred because none can be answered without a native
// window. Each is asserted against a REAL NSWindow, which is the only way to
// tell "implemented" from "returns a plausible number".

#[test]
fn the_button_policy_reaches_the_titlebar() {
    // `close_button_only` used to say exactly this in one word and could say
    // nothing else. The ledger asks for the two rows apart, because a window
    // may well want one and not the other.
    let w: ak::Window = window::make_shell_window(screen::Chrome::new(
        title: "policy", width: 300.0f64, height: 200.0f64,
        maximizable: false, minimizable: true));
    assert button_hidden(w, 2 as i64);         // NSWindowZoomButton
    assert button_hidden(w, 1 as i64) == false; // NSWindowMiniaturizeButton
    w.close();

    let both: ak::Window = window::make_shell_window(screen::Chrome::new(
        title: "both", width: 300.0f64, height: 200.0f64));
    assert button_hidden(both, 1 as i64) == false;
    assert button_hidden(both, 2 as i64) == false;
    both.close();
    return;
}

fn button_hidden(w: ak::Window, which: i64) -> bool {
    let b: *u8 = { rt::msg_id_i64(w.raw(), rt::sel(#str_ptr("standardWindowButton:\0")), which) };
    if b == (0 as *u8) { return true; }
    return { rt::msg_i8(b, rt::sel(#str_ptr("isHidden\0"))) } != (0 as i8);
}

#[test]
fn zero_is_unbounded_for_a_maximum_size() {
    // The trap this exists for: an unset maximum must not become a maximum of
    // NOTHING. The minimum pair already reads that way, so the maximum has to
    // agree or the two fields mean different things by the same value.
    let unset: ak::Window = window::make_shell_window(screen::Chrome::new(
        title: "unset", width: 300.0f64, height: 200.0f64));
    let m: rt::Size = { msg_size_of(unset.raw(), rt::sel(#str_ptr("contentMaxSize\0"))) };
    assert m.w > 10000.0f64;
    assert m.h > 10000.0f64;
    unset.close();

    // ...and each axis is answered on its own, so a window can cap one only.
    let capped: ak::Window = window::make_shell_window(screen::Chrome::new(
        title: "capped", width: 300.0f64, height: 200.0f64, max_width: 640.0f64));
    let c: rt::Size = { msg_size_of(capped.raw(), rt::sel(#str_ptr("contentMaxSize\0"))) };
    assert c.w == 640.0f64;
    assert c.h > 10000.0f64;
    capped.close();
    return;
}

#[test]
fn the_platform_reads_answer_safely_with_no_window() {
    // Every one of these is a row that needs a native window, and every one
    // has to answer something USABLE without one — a density of 0 would make
    // size arithmetic collapse, which is worse than a wrong-but-sane 1.
    assert window::density_of(0 as *core::Node) == 1.0f64;
    assert window::is_active(0 as *core::Node) == false;
    return;
}

#[test]
fn the_appearance_override_is_explicit_and_undoable() {
    backend::install();
    // Application.UserAppTheme. Unspecified is not a third colour scheme — it
    // is "give the system back", and without it an override could never be
    // taken off.
    window::set_app_appearance(vocab::Appearance::Dark);
    assert window::app_appearance() == vocab::Appearance::Dark;
    assert theme::is_dark();
    window::set_app_appearance(vocab::Appearance::Light);
    assert window::app_appearance() == vocab::Appearance::Light;
    assert theme::is_dark() == false;
    window::set_app_appearance(vocab::Appearance::Unspecified);
    assert window::app_appearance() == vocab::Appearance::Unspecified;
    return;
}

#[test]
fn the_app_menu_is_grouped_in_first_seen_order() {
    backend::install();
    // facet's AppMenu is FLAT — each item names its menu — and AppKit wants a
    // tree. The grouping happens here, and the order is first mention, which
    // is the only order a flat list can have expressed.
    var m: screen::AppMenu = screen::app_menu("probe");
    m.add_item("probe", "Quit", "q", screen::menu_action_quit());
    m.add_item("File", "New", "n", screen::menu_action_none());
    m.add_item("Edit", "Copy", "c", screen::menu_action_copy());
    m.add_item("File", "Close", "w", screen::menu_action_close_window());
    window::install_app_menu(#addr_of(m));

    let nsapp: *u8 = { rt::msg_id(rt::get_class(#str_ptr("NSApplication\0")),
                                  rt::sel(#str_ptr("sharedApplication\0"))) };
    let bar: *u8 = { rt::msg_id(nsapp, rt::sel(#str_ptr("mainMenu\0"))) };
    assert bar != (0 as *u8);
    assert { rt::msg_u64(bar, rt::sel(#str_ptr("numberOfItems\0"))) } == (3 as u64);
    assert menu_title_at(bar, 0 as i64) == "probe";
    assert menu_title_at(bar, 1 as i64) == "File";
    assert menu_title_at(bar, 2 as i64) == "Edit";
    // Two File items landed in ONE File menu, not two.
    let file: *u8 = { rt::msg_id(item_at(bar, 1 as i64), rt::sel(#str_ptr("submenu\0"))) };
    assert { rt::msg_u64(file, rt::sel(#str_ptr("numberOfItems\0"))) } == (2 as u64);
    // A platform verb gets the platform's selector and NO target, so the
    // responder chain decides — which is what greys Copy out with nothing
    // focused, without facet knowing anything about focus.
    let edit: *u8 = { rt::msg_id(item_at(bar, 2 as i64), rt::sel(#str_ptr("submenu\0"))) };
    let copy: *u8 = { rt::msg_id_i64(edit, rt::sel(#str_ptr("itemAtIndex:\0")), 0 as i64) };
    assert { rt::msg_id(copy, rt::sel(#str_ptr("target\0"))) } == (0 as *u8);
    return;
}

fn item_at(menu: *u8, i: i64) -> *u8 {
    return { rt::msg_id_i64(menu, rt::sel(#str_ptr("itemAtIndex:\0")), i) };
}

fn menu_title_at(menu: *u8, i: i64) -> text::Text {
    let it: *u8 = item_at(menu, i);
    if it == (0 as *u8) { return text::new(); }
    return bridge::to_text({ rt::msg_id(it, rt::sel(#str_ptr("title\0"))) });
}

#[test]
fn a_command_item_gets_a_trampoline_and_a_platform_one_does_not() {
    backend::install();
    var m: screen::AppMenu = screen::app_menu("probe");
    m.add_command("File", "Save", key: "s", on_click: menu_saved);
    window::install_app_menu(#addr_of(m));
    let nsapp: *u8 = { rt::msg_id(rt::get_class(#str_ptr("NSApplication\0")),
                                  rt::sel(#str_ptr("sharedApplication\0"))) };
    let bar: *u8 = { rt::msg_id(nsapp, rt::sel(#str_ptr("mainMenu\0"))) };
    let file: *u8 = { rt::msg_id(item_at(bar, 0 as i64), rt::sel(#str_ptr("submenu\0"))) };
    let save: *u8 = item_at(file, 0 as i64);
    // An app command WINS over a token action, so it carries a real target.
    assert { rt::msg_id(save, rt::sel(#str_ptr("target\0"))) } != (0 as *u8);
    return;
}

fn menu_saved(sender: *u8, ctx: *u8) { return; }

#[test]
fn the_toolbar_is_read_from_the_tree_wherever_the_items_sit() {
    backend::install();
    // A toolbar_item is not a view, so it is read from the NODES — and from
    // anywhere in the tree, because a screen describes its toolbar where the
    // content that owns it lives, which is rarely the top.
    var inner: core::Builder = core::Builder::new();
    inner.add(toolbar_item::toolbar_item("Save", key: "tb:save"));
    inner.add(toolbar_item::toolbar_item("Share", key: "tb:share"));
    var b: core::Builder = core::Builder::new();
    b.add(core::column(inner, key: "nested"));
    var root: core::Node = core::column(b, key: "root");

    let ids: *u8 = { rt::alloc_init(#str_ptr("NSMutableArray\0")) };
    let map: *u8 = { rt::alloc_init(#str_ptr("NSMutableDictionary\0")) };
    window::collect_toolbar_items(#addr_of(root), ids, map);
    assert { rt::msg_u64(ids, rt::sel(#str_ptr("count\0"))) } == (2 as u64);
    assert { rt::msg_u64(map, rt::sel(#str_ptr("count\0"))) } == (2 as u64);
    rt::release(ids);
    rt::release(map);

    // A tree with none asks for no toolbar at all, rather than an empty one.
    var bare: core::Node = core::column(core::Builder::new(), key: "bare");
    let none: *u8 = { rt::alloc_init(#str_ptr("NSMutableArray\0")) };
    let nomap: *u8 = { rt::alloc_init(#str_ptr("NSMutableDictionary\0")) };
    window::collect_toolbar_items(#addr_of(bare), none, nomap);
    assert { rt::msg_u64(none, rt::sel(#str_ptr("count\0"))) } == (0 as u64);
    rt::release(none);
    rt::release(nomap);
    return;
}

// ---- input, actually DELIVERED -----------------------------------------------
// The gap the probe found: every test above asserts that arming HAPPENED, and
// none asserts that an event then reaches the handler. A synthesized NSEvent
// sent straight to the view exercises the real IMP, the real association and
// the real decline path, with no run loop in the way.

fn mouse_event(kind: u64, clicks: i64) -> *u8 {
    return { msg_mouse_event(
        rt::get_class(#str_ptr("NSEvent\0")),
        rt::sel(#str_ptr("mouseEventWithType:location:modifierFlags:timestamp:windowNumber:context:eventNumber:clickCount:pressure:\0")),
        kind, rt::Point { x: 5.0f64, y: 5.0f64 }, 0 as u64, 0.0f64,
        0 as i64, 0 as *u8, 0 as i64, clicks, 0.0f32) };
}

#[test]
fn a_click_reaches_the_handler() {
    backend::install();
    IN_CLICKS = 0 as i64;
    var n: core::Node = box_view::box(color: vocab::Color::rgba(1.0f64, 0.0f64, 0.0f64),
                                      key: "hit").gesture(on_click: h_took());
    let p: *core::Node = #addr_of(n);
    let v: *u8 = views::create(0 as *u8, p);
    assert v != (0 as *u8);
    // NSEventTypeLeftMouseDown = 1, LeftMouseUp = 2. A click is reported on the
    // way UP, which is the same moment NSButton considers itself clicked.
    { rt::msg_void_id(v, rt::sel(#str_ptr("mouseDown:\0")), mouse_event(1 as u64, 1 as i64)) };
    assert IN_CLICKS == (0 as i64);
    { rt::msg_void_id(v, rt::sel(#str_ptr("mouseUp:\0")), mouse_event(2 as u64, 1 as i64)) };
    assert IN_CLICKS == (1 as i64);
    views::view_release(v);
    return;
}

#[test]
fn a_double_click_is_not_two_singles() {
    backend::install();
    IN_CLICKS = 0 as i64;
    IN_DOUBLES = 0 as i64;
    var n: core::Node = box_view::box(color: vocab::Color::rgba(1.0f64, 0.0f64, 0.0f64),
                                      key: "dbl")
        .gesture(on_click: h_took(), on_double_click: h_double());
    let v: *u8 = views::create(0 as *u8, #addr_of(n));
    { rt::msg_void_id(v, rt::sel(#str_ptr("mouseUp:\0")), mouse_event(2 as u64, 2 as i64)) };
    assert IN_DOUBLES == (1 as i64);
    assert IN_CLICKS == (0 as i64);
    views::view_release(v);
    return;
}

#[test]
fn a_right_click_reaches_the_handler() {
    backend::install();
    IN_CLICKS = 0 as i64;
    var n: core::Node = box_view::box(color: vocab::Color::rgba(1.0f64, 0.0f64, 0.0f64),
                                      key: "rc").gesture(on_right_click: h_took());
    let v: *u8 = views::create(0 as *u8, #addr_of(n));
    // NSEventTypeRightMouseDown = 3.
    { rt::msg_void_id(v, rt::sel(#str_ptr("rightMouseDown:\0")), mouse_event(3 as u64, 1 as i64)) };
    assert IN_CLICKS == (1 as i64);
    views::view_release(v);
    return;
}

#[test]
fn a_key_reaches_the_handler_through_the_band() {
    backend::install();
    IN_KEYS = 0 as i64;
    var n: core::Node = core::column(core::Builder::new(), key: "k").gesture(on_key: h_key());
    let v: *u8 = views::create(0 as *u8, #addr_of(n));
    { rt::msg_void_id(v, rt::sel(#str_ptr("keyDown:\0")),
                      fake_key_event(53 as u16, "", 0 as u64)) };
    assert IN_KEYS == (1 as i64);
    views::view_release(v);
    return;
}

#[test]
fn a_live_write_after_mount_reaches_the_native_control() {
    backend::install();
    // The end-to-end nothing had asserted: a handler writes through `find`,
    // and the write has to REACH THE SCREEN. Both probes only ever proved the
    // first frame — the canvas drew once at open, the gesture band fired its
    // handlers — and a handler whose effect never lands looks exactly like a
    // handler that never ran.
    var b: core::Builder = core::Builder::new();
    b.add(label::label("before", key: "out"));
    var root: core::Node = core::column(b, key: "root");
    let p: *core::Node = #addr_of(root);
    assert mount::mount(p);

    match label::find("out", within: p) {
        option::Option[label::Label]::Some(l) => {
            let _x: label::Label = l.set_text("after");
        }
        option::Option[label::Label]::None => { assert false; }
    }
    // The write raised a dirty bit; the backend coalesces into ONE sync per
    // run-loop turn, so the tick is what carries it across.
    scheduler::tick();

    match core::find_in(p, "out") {
        option::Option[*core::Node]::Some(n) => {
            let v: *u8 = core::view_of(n);
            assert v != (0 as *u8);
            let shown: text::Text = ak::TextField::from_raw(v).as_control().string_value();
            assert shown.view() == "after";
        }
        option::Option[*core::Node]::None => { assert false; }
    }
    mount::unmount(p);
    return;
}

#[test]
fn a_label_measures_itself_instead_of_collapsing() {
    backend::install();
    // THE BUG THE PROBE FOUND, by showing nothing. flex sizes a leaf from its
    // measure callback and nothing had installed one, so every control without
    // an explicit width and height laid out 0x0 — present, correct, invisible.
    var b: core::Builder = core::Builder::new();
    b.add(label::label("a label with real words in it", key: "l"));
    b.add(button::button("Save", key: "btn"));
    var root: core::Node = core::column(b, key: "root");
    let p: *core::Node = #addr_of(root);
    assert mount::mount(p);
    { (*p).calculate_layout(width: 400.0f64, height: 300.0f64) };

    match core::find_in(p, "l") {
        option::Option[*core::Node]::Some(n) => {
            let f: flex::Frame = { (*n).frame() };
            assert f.height > 0.0f64;
            assert f.width > 0.0f64;
        }
        option::Option[*core::Node]::None => { assert false; }
    }
    // A button sizes to its TITLE, which is the whole point of asking the
    // platform rather than guessing.
    match core::find_in(p, "btn") {
        option::Option[*core::Node]::Some(n) => {
            assert { (*n).frame().width } > 20.0f64;
            assert { (*n).frame().height } > 0.0f64;
        }
        option::Option[*core::Node]::None => { assert false; }
    }
    mount::unmount(p);
    return;
}

#[test]
fn a_surface_is_sized_by_its_container_not_by_asking_it() {
    // The other half of the rule: a scroll view, a web view or a canvas has a
    // fitting size too and it means something else. Asking WKWebView how big
    // it would like to be is not a question with a useful answer.
    assert views::has_intrinsic_size(props::K_LABEL);
    assert views::has_intrinsic_size(props::K_BUTTON);
    assert views::has_intrinsic_size(props::K_SCROLL) == false;
    assert views::has_intrinsic_size(props::K_WEB) == false;
    assert views::has_intrinsic_size(props::K_CANVAS) == false;
    assert views::has_intrinsic_size(props::K_LIST) == false;
    assert views::has_intrinsic_size(core::K_NODE) == false;
    return;
}

#[test]
fn an_armed_view_still_hit_tests_to_itself() {
    backend::install();
    // The probe reported nothing with every node correctly armed, which leaves
    // one link: does AppKit still FIND the view? `hitTest:` is overridden for
    // the Opaque rule, and an override that answers null makes a view
    // click-through — armed, correct and unreachable.
    //
    // In a REAL WINDOW, because that is the only place hit-testing is defined:
    // NSView.hitTest: measures the point against the view's frame in its
    // SUPERVIEW's space, and a view with no superview has no such space. The
    // first version of this test asked a detached view and learned nothing.
    let w: ak::Window = window::make_shell_window(screen::Chrome::new(
        title: "hit", width: 200.0f64, height: 200.0f64));
    let host: ak::View = akx::new_flipped_view(
        rt::Rect { x: 0.0f64, y: 0.0f64, w: 200.0f64, h: 200.0f64 });
    w.set_content_view(host);

    var n: core::Node = box_view::box(color: vocab::Color::rgba(1.0f64, 0.0f64, 0.0f64),
                                      key: "hit").gesture(on_click: h_took());
    let v: *u8 = views::create(0 as *u8, #addr_of(n));
    assert v != (0 as *u8);
    { rt::msg_void_rect(v, rt::sel(#str_ptr("setFrame:\0")),
                        rt::Rect { x: 0.0f64, y: 0.0f64, w: 100.0f64, h: 50.0f64 }) };
    host.add_subview(ak::View::from_raw(v));

    // Asked of the VIEW, not of its host: hitTest: measures the point against
    // the receiver's own frame, so the point belongs to the SUPERVIEW's space
    // and only the receiver knows which space that is. Asking the host means
    // asking in the WINDOW's space, one level up, which is how the first two
    // versions of this test managed to fail on a view that was perfectly fine.
    let inside: *u8 = { msg_id_point(v, rt::sel(#str_ptr("hitTest:\0")),
                                     rt::Point { x: 50.0f64, y: 25.0f64 }) };
    assert inside == v;
    // ...and outside its frame it must NOT answer, or it would swallow clicks
    // meant for its siblings.
    let outside: *u8 = { msg_id_point(v, rt::sel(#str_ptr("hitTest:\0")),
                                      rt::Point { x: 150.0f64, y: 150.0f64 }) };
    assert outside != v;
    views::view_release(v);
    w.close();
    return;
}

#[test]
fn a_plain_subview_hit_tests_the_same_way_an_armed_one_should() {
    // The control for the test above: same setup, NO gestures and no class
    // swap. If this one ever fails, the override is innocent and the setup is
    // what is wrong — which is exactly what it caught the first time.
    let w: ak::Window = window::make_shell_window(screen::Chrome::new(
        title: "plain", width: 200.0f64, height: 200.0f64));
    let host: ak::View = akx::new_flipped_view(
        rt::Rect { x: 0.0f64, y: 0.0f64, w: 200.0f64, h: 200.0f64 });
    w.set_content_view(host);
    let plain: ak::View = akx::new_flipped_view(
        rt::Rect { x: 0.0f64, y: 0.0f64, w: 100.0f64, h: 50.0f64 });
    host.add_subview(plain);
    let inside: *u8 = { msg_id_point(plain.raw(), rt::sel(#str_ptr("hitTest:\0")),
                                     rt::Point { x: 50.0f64, y: 25.0f64 }) };
    assert inside == plain.raw();
    w.close();
    return;
}

extern fn CFRunLoopRunInMode(mode: *u8, seconds: f64, return_after_source: i8) -> i32;
extern fn CFStringCreateWithCString(alloc: *u8, cstr: *u8, encoding: u32) -> *u8;

#[test]
fn the_observer_actually_fires_and_carries_a_write_across() {
    backend::install();
    // The link nothing had tested. `a_live_write_after_mount_reaches_the_native
    // _control` calls tick() BY HAND, which proves the walk and skips the only
    // part that can silently not happen: whether the CFRunLoopObserver runs at
    // all. A write that never gets a tick looks exactly like a write that got
    // one and did nothing.
    var b: core::Builder = core::Builder::new();
    b.add(label::label("before", key: "obs"));
    var root: core::Node = core::column(b, key: "obsroot");
    let p: *core::Node = #addr_of(root);
    assert mount::mount(p);
    scheduler::tick();                        // drain anything mount queued

    let before: u64 = scheduler::ticks();
    match label::find("obs", within: p) {
        option::Option[label::Label]::Some(l) => { let _x: label::Label = l.set_text("after"); }
        option::Option[label::Label]::None => { assert false; }
    }
    // The write must have ASKED for a sync...
    assert scheduler::sync_pending();
    // ...and running the loop must deliver one, with nothing called by hand.
    let mode: *u8 = CFStringCreateWithCString(0 as *u8,
                                              #str_ptr("kCFRunLoopDefaultMode\0"),
                                              134217984 as u32);
    let _r: i32 = CFRunLoopRunInMode(mode, 0.2f64, 0 as i8);
    assert scheduler::ticks() > before;
    assert scheduler::sync_pending() == false;

    match core::find_in(p, "obs") {
        option::Option[*core::Node]::Some(n) => {
            let v: *u8 = core::view_of(n);
            assert v != (0 as *u8);
            assert ak::TextField::from_raw(v).as_control().string_value().view() == "after";
        }
        option::Option[*core::Node]::None => { assert false; }
    }
    mount::unmount(p);
    return;
}

#[test]
fn the_sync_observer_is_installed_at_all() {
    backend::install();
    assert scheduler::observer_installed();
    return;
}

// ---- the recycling list ------------------------------------------------------
// `list` on an NSTableView. The suite cannot scroll, so it asks the delegate
// what NSTableView asks it — which is the whole of the contract between them.

static RL_BUILDS: i64 = 0 as i64;

fn rl_row(i: usize, ctx: *u8) -> core::Node {
    RL_BUILDS = RL_BUILDS + (1 as i64);
    var b: core::Builder = core::Builder::new();
    b.add(label::label("row", key: ""));
    return core::column(b, key: "");
}

fn rl_list(count: usize, row_height: i64) -> core::Node {
    var n: core::Node = list::list(key: "rl");
    let p: *core::Node = #addr_of(n);
    match list::find("rl", within: p) {
        option::Option[list::List]::Some(x) => {
            let _a: list::List = x.set_row(rl_row);
            let _b: list::List = x.set_count(count);
            if row_height > (0 as i64) { let _c: list::List = x.set_row_height(row_height); }
        }
        option::Option[list::List]::None => { }
    }
    return n;
}

#[test]
fn a_list_does_not_build_a_row_until_it_is_asked_for() {
    backend::install();
    // The whole point: ten thousand rows must not cost ten thousand builds.
    // Creating the list asks for NONE of them.
    RL_BUILDS = 0 as i64;
    var n: core::Node = rl_list(10000 as usize, 40 as i64);
    let p: *core::Node = #addr_of(n);
    let v: *u8 = views::create(0 as *u8, p);
    assert v != (0 as *u8);
    assert recycler::row_count_of(v) == (10000 as i64);
    assert RL_BUILDS == (0 as i64);
    views::view_release(v);
    return;
}

#[test]
fn a_uniform_row_height_skips_measurement_entirely() {
    backend::install();
    // `row_height` is the cheapest a list can be: no build, no layout, no
    // cache — and no O(rows) pass when the width changes.
    RL_BUILDS = 0 as i64;
    var n: core::Node = rl_list(500 as usize, 44 as i64);
    let v: *u8 = views::create(0 as *u8, #addr_of(n));
    assert recycler::fixed_height_of(v) == (44.0f64);
    assert recycler::height_of_row(v, 0 as i64) == (44.0f64);
    assert recycler::height_of_row(v, 499 as i64) == (44.0f64);
    assert RL_BUILDS == (0 as i64);
    views::view_release(v);
    return;
}

#[test]
fn a_measured_height_is_cached_so_a_scroll_does_not_rebuild_the_list() {
    backend::install();
    // NSTableView asks heightOfRow: for EVERY row whenever it recomputes
    // geometry, and answering means building the row. Without this cache a
    // scroll re-measures the whole list on every pass, which is the periodic
    // hitch the cache exists to stop.
    RL_BUILDS = 0 as i64;
    var n: core::Node = rl_list(50 as usize, 0 as i64);
    let v: *u8 = views::create(0 as *u8, #addr_of(n));
    let h0: f64 = recycler::height_of_row(v, 0 as i64);
    assert h0 > 0.0f64;
    let after_first: i64 = RL_BUILDS;
    assert after_first == (1 as i64);
    // Asked again: answered from the cache, nothing rebuilt.
    assert recycler::height_of_row(v, 0 as i64) == h0;
    assert RL_BUILDS == after_first;
    views::view_release(v);
    return;
}

#[test]
fn a_row_is_realised_into_its_cell_and_torn_down_when_the_cell_is_reused() {
    backend::install();
    // The second mount path, end to end. A row's subtree is realised into the
    // cell and OWNED by it — in facet a node owns its views, so the cell has to
    // hold the node or it would empty the moment it was filled.
    RL_BUILDS = 0 as i64;
    var n: core::Node = rl_list(3 as usize, 0 as i64);
    let v: *u8 = views::create(0 as *u8, #addr_of(n));
    let cell: *u8 = recycler::view_for_row(v, 0 as i64);
    assert cell != (0 as *u8);
    // The row was built and its views are IN the cell.
    assert ak::View::from_raw(cell).subviews().count() == (1 as usize);
    // The same cell taken for another row: the old subtree goes, the new one
    // arrives, and the cell still holds exactly one root.
    let again: *u8 = recycler::view_for_row(v, 1 as i64);
    assert ak::View::from_raw(again).subviews().count() == (1 as usize);
    views::view_release(v);
    return;
}

// ---- a row's CONTENT is positioned -------------------------------------------
// `place_row` frames the cell and the row root. Everything INSIDE the row is
// placed by `geometry::reposition`, and that call was missing: the frame walk
// the window scheduler runs cannot reach a realised row, because a realised row
// is not in any window. So every view in a row kept the frame its factory made
// it with — each label 4x16 at the origin, `labelWithString:@""`'s own size,
// since `setStringValue:` does not resize. The row's HEIGHT was right
// (`height_imp` lays out an unrealised copy), so the table reserved exactly the
// right space and drew the whole row into the top-left corner of it.
//
// Two labels, because ONE at the origin is indistinguishable from one correctly
// placed. The second has to sit below the first.

fn rp_row(i: usize, ctx: *u8) -> core::Node {
    var b: core::Builder = core::Builder::new();
    b.add(label::label("first line", key: "a"));
    b.add(label::label("second line", key: "b"));
    return core::column(b, key: "");
}

fn rp_bind(i: usize, row: *core::Node, ctx: *u8) {
    match label::find("a", within: row) {
        option::Option[label::Label]::Some(l) => {
            let _x: label::Label = l.set_text(digits_i64(i as i64).view());
        }
        option::Option[label::Label]::None => { }
    }
    return;
}

fn rp_list(count: usize, bound: bool) -> core::Node {
    var n: core::Node = list::list(key: "rp");
    let p: *core::Node = #addr_of(n);
    match list::find("rp", within: p) {
        option::Option[list::List]::Some(x) => {
            let a: list::List = x.set_row(rp_row);
            let b: list::List = a.set_count(count);
            if bound { let _c: list::List = b.set_row_bind(rp_bind); }
        }
        option::Option[list::List]::None => { assert false; }
    }
    return n;
}

// Both labels span the cell and the second is BELOW the first. The row root is
// a bare column — nothing keys it, so it is unbacked and its labels pass
// straight through into the cell, which is why these are the cell's own
// subviews.
fn assert_row_content_is_placed(cell: *u8) {
    let cw: f64 = { ak::View::from_raw(cell).frame().w };
    assert cw > 1.0f64;
    let subs: vec::Vec[ak::View] = ak::View::from_raw(cell).subviews();
    assert subs.count() == (2 as usize);
    var first_h: f64 = 0.0f64;
    match subs.at_ptr(0 as usize) {
        option::Option[*ak::View]::Some(sv) => {
            let f: rt::Rect = { (*sv).frame() };
            assert f.y == 0.0f64;
            // Stretched across the row rather than left at the 4pt an empty
            // label is born with.
            assert f.w == cw;
            assert f.h > 1.0f64;
            first_h = f.h;
        }
        option::Option[*ak::View]::None => { assert false; }
    }
    match subs.at_ptr(1 as usize) {
        option::Option[*ak::View]::Some(sv) => {
            let f: rt::Rect = { (*sv).frame() };
            // The whole claim: an unplaced row stacks every label at the origin.
            assert f.y == first_h;
            assert f.w == cw;
        }
        option::Option[*ak::View]::None => { assert false; }
    }
    return;
}

// ---- a row's height, stated rather than built ---------------------------------

static SH_BUILDS: i64 = 0 as i64;
static SH_ASKED: i64 = 0 as i64;

fn sh_row(i: usize, ctx: *u8) -> core::Node {
    SH_BUILDS = SH_BUILDS + (1 as i64);
    var b: core::Builder = core::Builder::new();
    b.add(label::label("row", key: ""));
    return core::column(b, key: "");
}

// Every extent stated, so the answer is arithmetic — the shape a real list has
// when its rows are cards of stated parts.
fn sh_height(i: usize, ctx: *u8) -> f64 {
    SH_ASKED = SH_ASKED + (1 as i64);
    if (i % (2 as usize)) == (0 as usize) { return 40.0f64; }
    return 24.0f64;
}

// A row this app cannot compute: 0 means "build it", and that is legal.
fn sh_height_partial(i: usize, ctx: *u8) -> f64 {
    if i == (3 as usize) { return 0.0f64; }
    return 40.0f64;
}

fn sh_list(count: usize, f: fn(usize, *u8) -> f64, f_ctx: *u8 = 0 as *u8) -> core::Node {
    var n: core::Node = list::list(key: "sh", uneven_rows: true);
    let p: *core::Node = #addr_of(n);
    match list::find("sh", within: p) {
        option::Option[list::List]::Some(x) => {
            let a: list::List = x.set_row(sh_row);
            let b: list::List = a.set_count(count);
            let _c: list::List = b.set_row_height_of(f, row_height_of_ctx: f_ctx);
        }
        option::Option[list::List]::None => { assert false; }
    }
    return n;
}

#[test]
fn a_stated_row_height_is_answered_without_building_the_row() {
    backend::install();
    // The whole point. A recycling table asks for the height of EVERY row when
    // its width changes, and measuring by BUILDING meant an uneven list
    // rebuilt its entire model on every frame of a live drag. An application
    // that states the extents its rows stack already knows the answer.
    SH_BUILDS = 0 as i64;
    SH_ASKED = 0 as i64;
    var n: core::Node = sh_list(50 as usize, sh_height);
    let v: *u8 = views::create(0 as *u8, #addr_of(n));

    assert recycler::height_of_row(v, 0 as i64) == 40.0f64;
    assert recycler::height_of_row(v, 1 as i64) == 24.0f64;
    assert recycler::height_of_row(v, 8 as i64) == 40.0f64;
    // Asked three times, built ZERO.
    assert SH_ASKED == (3 as i64);
    assert SH_BUILDS == (0 as i64);
    views::view_release(v);
    return;
}

#[test]
fn a_row_the_app_cannot_state_falls_back_to_being_built() {
    backend::install();
    // 0 means "no answer", not "zero tall". A partial answer is a legal
    // answer, so an app can state the rows it knows and leave the rest.
    SH_BUILDS = 0 as i64;
    var n: core::Node = sh_list(10 as usize, sh_height_partial);
    let v: *u8 = views::create(0 as *u8, #addr_of(n));
    assert recycler::height_of_row(v, 0 as i64) == 40.0f64;
    assert SH_BUILDS == (0 as i64);
    // Row 3 answers 0, so it is built and measured the old way.
    let h3: f64 = recycler::height_of_row(v, 3 as i64);
    assert h3 > 0.0f64;
    assert SH_BUILDS == (1 as i64);
    views::view_release(v);
    return;
}

#[test]
fn a_grouped_lists_stated_height_is_asked_about_the_DATA_index() {
    backend::install();
    // `row_height_of(i)` means the same `i` that `row(i)` means. A grouped
    // table's table rows are offset by the headers above them, and handing the
    // raw table row to the application is the same defect the bind had.
    // Groups of 2 and 3 over 5 items:
    //   0 header | 1 data0 | 2 data1 | 3 header | 4 data2 | 5 data3 | 6 data4
    SH_BUILDS = 0 as i64;
    var l: core::Node = list::list(key: "shg", uneven_rows: true, grouped: true);
    let p: *core::Node = #addr_of(l);
    match list::find("shg", within: p) {
        option::Option[list::List]::Some(x) => {
            let a: list::List = x.set_row(sh_row);
            let b: list::List = a.set_count(5 as usize);
            let c: list::List = b.set_group_count(2 as usize);
            let d: list::List = c.set_group_size(g_size);
            let e: list::List = d.set_group_header(g_header);
            let _f: list::List = e.set_row_height_of(sh_height);
        }
        option::Option[list::List]::None => { assert false; }
    }
    let v: *u8 = views::create(0 as *u8, p);
    core::set_view(p, v, views::view_release);
    // Table row 1 is DATA 0 -> 40. Table row 2 is DATA 1 -> 24.
    assert recycler::height_of_row(v, 1 as i64) == 40.0f64;
    assert recycler::height_of_row(v, 2 as i64) == 24.0f64;
    // Table row 4 is DATA 2 -> 40, not table-row 4's answer (24).
    assert recycler::height_of_row(v, 4 as i64) == 40.0f64;
    // None of that built a row.
    assert SH_BUILDS == (0 as i64);
    // A HEADER has no data index, so it is built and measured as before.
    let hh: f64 = recycler::height_of_row(v, 0 as i64);
    assert hh > 0.0f64;
    return;
}

#[test]
fn a_list_with_no_stated_height_still_measures_by_building() {
    backend::install();
    // The default is unchanged: no callback means build and measure, which is
    // what every list did before this could be said.
    SH_BUILDS = 0 as i64;
    var n: core::Node = list::list(key: "sh2", uneven_rows: true);
    let p: *core::Node = #addr_of(n);
    match list::find("sh2", within: p) {
        option::Option[list::List]::Some(x) => {
            let a: list::List = x.set_row(sh_row);
            let _b: list::List = a.set_count(10 as usize);
        }
        option::Option[list::List]::None => { assert false; }
    }
    let v: *u8 = views::create(0 as *u8, p);
    let _h: f64 = recycler::height_of_row(v, 0 as i64);
    assert SH_BUILDS == (1 as i64);
    views::view_release(v);
    return;
}

// ---- a list write pays for what it changed, and no more ---------------------
//
// The apply body wiped the height cache and reloaded the table on EVERY dirty
// bit — gated on nothing — so a selection write alone discarded every measured
// height and every vended cell, and a streaming transcript re-shaped and
// re-drew every visible row on every token. Three fixes live together here:
// the stated-height copy that only arrived under a GROUP bit, the reload that
// now runs only for sequence writes, and `invalidate_row` for the one write
// neither covers — a row that changed in place.

static IV_BUMP: f64 = 0.0f64;

fn iv_height(i: usize, ctx: *u8) -> f64 {
    SH_ASKED = SH_ASKED + (1 as i64);
    if (i % (2 as usize)) == (0 as usize) { return 40.0f64 + IV_BUMP; }
    return 24.0f64 + IV_BUMP;
}

fn iv_list(count: usize) -> core::Node {
    var n: core::Node = list::list(key: "iv", uneven_rows: true);
    let p: *core::Node = #addr_of(n);
    match list::find("iv", within: p) {
        option::Option[list::List]::Some(x) => {
            let a: list::List = x.set_row(sh_row);
            let b: list::List = a.set_count(count);
            let _c: list::List = b.set_row_height_of(iv_height);
        }
        option::Option[list::List]::None => { assert false; }
    }
    return n;
}

fn iv_ask_all(v: *u8, rows: i64) {
    var r: i64 = 0 as i64;
    while r < rows {
        let _h: f64 = recycler::height_of_row(v, r);
        r = r + (1 as i64);
    }
    return;
}

#[test]
fn a_stated_height_written_post_mount_arrives_without_a_group_write() {
    backend::install();
    // `set_row_height_of` raises P_ROW, and the recycler copied the field into
    // its RowSource only under the GROUP bits — so the post-mount write, the
    // only pattern a cursor-configured list has, was silently dropped unless a
    // group write happened to ride along. The workaround in the wild was a
    // no-op `set_grouped(false)` written beside the height, to open a gate
    // whose own comment only ever talked about groups.
    SH_BUILDS = 0 as i64;
    SH_ASKED = 0 as i64;
    IV_BUMP = 0.0f64;
    var n: core::Node = list::list(key: "pm", uneven_rows: true);
    let p: *core::Node = #addr_of(n);
    match list::find("pm", within: p) {
        option::Option[list::List]::Some(x) => {
            let a: list::List = x.set_row(sh_row);
            let _b: list::List = a.set_count(10 as usize);
        }
        option::Option[list::List]::None => { assert false; }
    }
    let v: *u8 = views::create(0 as *u8, p);
    core::set_view(p, v, views::view_release);
    core::clear_dirty(p);
    match list::find("pm", within: p) {
        option::Option[list::List]::Some(x) => {
            let _h: list::List = x.set_row_height_of(iv_height);
        }
        option::Option[list::List]::None => { assert false; }
    }
    views::apply(0 as *u8, p);
    // The stated answer, not the built-and-floored one — and stated without
    // ever building a row.
    assert recycler::height_of_row(v, 0 as i64) == 40.0f64;
    assert SH_ASKED == (1 as i64);
    assert SH_BUILDS == (0 as i64);
    return;
}

#[test]
fn a_selection_write_alone_keeps_every_measured_height() {
    backend::install();
    SH_BUILDS = 0 as i64;
    SH_ASKED = 0 as i64;
    IV_BUMP = 0.0f64;
    var n: core::Node = iv_list(10 as usize);
    let p: *core::Node = #addr_of(n);
    let v: *u8 = views::create(0 as *u8, p);
    core::set_view(p, v, views::view_release);
    let _h0: f64 = recycler::height_of_row(v, 0 as i64);
    assert SH_ASKED == (1 as i64);
    assert recycler::heights_width_of(v) > 0.0f64;
    core::clear_dirty(p);
    match list::find("iv", within: p) {
        option::Option[list::List]::Some(x) => {
            let _s: list::List = x.set_selected_index(3 as i64);
        }
        option::Option[list::List]::None => { assert false; }
    }
    views::apply(0 as *u8, p);
    // Neither wiped nor re-asked: the cache and its width survive, and the
    // next question is answered from it.
    //
    // Counted around the QUESTION rather than from the top of the test.
    // Selecting a row is something AppKit may answer by asking that row's own
    // height — whether it does depends on whether the real table has laid
    // itself out yet, which made a `SH_ASKED == 1` here fail about one run in
    // three. What this test is about is row 0's measurement surviving, and
    // that is exactly what a delta of zero across the re-ask says.
    assert recycler::heights_width_of(v) > 0.0f64;
    let asked_before: i64 = SH_ASKED;
    assert recycler::height_of_row(v, 0 as i64) == 40.0f64;
    assert SH_ASKED == asked_before;
    return;
}

#[test]
fn a_count_write_still_discards_the_old_measurements() {
    backend::install();
    // The gate is on SEQUENCE writes, not on writing at all: after a count
    // change the measurements belong to the old sequence, exactly as before.
    SH_BUILDS = 0 as i64;
    SH_ASKED = 0 as i64;
    IV_BUMP = 0.0f64;
    var n: core::Node = iv_list(10 as usize);
    let p: *core::Node = #addr_of(n);
    let v: *u8 = views::create(0 as *u8, p);
    core::set_view(p, v, views::view_release);
    let _h0: f64 = recycler::height_of_row(v, 0 as i64);
    assert recycler::heights_width_of(v) > 0.0f64;
    core::clear_dirty(p);
    match list::find("iv", within: p) {
        option::Option[list::List]::Some(x) => {
            let _c: list::List = x.set_count(11 as usize);
        }
        option::Option[list::List]::None => { assert false; }
    }
    views::apply(0 as *u8, p);
    assert recycler::heights_width_of(v) == 0.0f64;
    return;
}

fn rk_kind(i: usize, ctx: *u8) -> usize {
    if (i % (3 as usize)) == (0 as usize) { return 0 as usize; }
    if (i % (3 as usize)) == (1 as usize) { return 1 as usize; }
    return 7 as usize;                       // kinds need not be dense
}

#[test]
fn rows_of_different_kinds_are_vended_from_different_pools() {
    backend::install();
    // The bind promise. One identity for every row means `makeViewWithIdentifier:`
    // can hand a bubble's cell to a tool card, and a bind writes the card's data
    // into the bubble's subtree with nothing to say so — which is why a
    // transcript of three shapes could not state a bind at all.
    SH_BUILDS = 0 as i64;
    SH_ASKED = 0 as i64;
    IV_BUMP = 0.0f64;
    var n: core::Node = list::list(key: "rk", uneven_rows: true);
    let p: *core::Node = #addr_of(n);
    match list::find("rk", within: p) {
        option::Option[list::List]::Some(x) => {
            let a: list::List = x.set_row(sh_row);
            let b: list::List = a.set_count(6 as usize);
            let c: list::List = b.set_row_height_of(iv_height);
            let _d: list::List = c.set_row_kind(rk_kind);
        }
        option::Option[list::List]::None => { assert false; }
    }
    let v: *u8 = views::create(0 as *u8, p);
    core::set_view(p, v, views::view_release);
    // Same shape, same pool; different shape, different pool.
    assert recycler::identity_of_row(v, 0 as i64) == "facet.row";
    assert recycler::identity_of_row(v, 3 as i64) == "facet.row";
    assert recycler::identity_of_row(v, 1 as i64) == "facet.row.1";
    assert recycler::identity_of_row(v, 4 as i64) == "facet.row.1";
    assert recycler::identity_of_row(v, 2 as i64) == "facet.row.7";
    return;
}

#[test]
fn a_list_that_names_no_kind_keeps_the_one_pool_it_always_had() {
    backend::install();
    SH_BUILDS = 0 as i64;
    SH_ASKED = 0 as i64;
    IV_BUMP = 0.0f64;
    var n: core::Node = iv_list(4 as usize);
    let p: *core::Node = #addr_of(n);
    let v: *u8 = views::create(0 as *u8, p);
    core::set_view(p, v, views::view_release);
    assert recycler::identity_of_row(v, 0 as i64) == "facet.row";
    assert recycler::identity_of_row(v, 3 as i64) == "facet.row";
    return;
}

#[test]
fn a_group_header_is_its_own_shape_and_its_own_pool() {
    backend::install();
    // A header is built by `group_header` and a row by `row` — two shapes that
    // shared one pool for as long as grouping has existed.
    SH_BUILDS = 0 as i64;
    SH_ASKED = 0 as i64;
    IV_BUMP = 0.0f64;
    var n: core::Node = list::list(key: "rkg", uneven_rows: true, grouped: true);
    let p: *core::Node = #addr_of(n);
    match list::find("rkg", within: p) {
        option::Option[list::List]::Some(x) => {
            let a: list::List = x.set_row(sh_row);
            let b: list::List = a.set_count(5 as usize);
            let c: list::List = b.set_group_count(2 as usize);
            let d: list::List = c.set_group_size(g_size);
            let e: list::List = d.set_group_header(g_header);
            let _f: list::List = e.set_row_height_of(iv_height);
        }
        option::Option[list::List]::None => { assert false; }
    }
    let v: *u8 = views::create(0 as *u8, p);
    core::set_view(p, v, views::view_release);
    // 0 header | 1 data0 | 2 data1 | 3 header | 4 data2 ...
    assert recycler::identity_of_row(v, 0 as i64) == "facet.row.header";
    assert recycler::identity_of_row(v, 3 as i64) == "facet.row.header";
    assert recycler::identity_of_row(v, 1 as i64) == "facet.row";
    assert recycler::identity_of_row(v, 4 as i64) == "facet.row";
    return;
}

#[test]
fn an_append_keeps_every_height_the_list_had_already_measured() {
    backend::install();
    // The transcript write. `set_count` says NEW SEQUENCE and costs every
    // measured height; `insert_rows` says the sequence GREW, and the rows
    // above the splice are the rows they were, at the heights they were
    // measured at. The stale answers below are the proof they were not
    // re-asked: the oracle would answer 6 more now.
    SH_BUILDS = 0 as i64;
    SH_ASKED = 0 as i64;
    IV_BUMP = 0.0f64;
    var n: core::Node = iv_list(5 as usize);
    let p: *core::Node = #addr_of(n);
    let v: *u8 = views::create(0 as *u8, p);
    core::set_view(p, v, views::view_release);
    iv_ask_all(v, 5 as i64);
    assert SH_ASKED == (5 as i64);
    IV_BUMP = 6.0f64;
    core::clear_dirty(p);
    match list::find("iv", within: p) {
        option::Option[list::List]::Some(x) => {
            let _i: list::List = x.insert_rows(at: 5 as usize, count: 2 as usize);
        }
        option::Option[list::List]::None => { assert false; }
    }
    views::apply(0 as *u8, p);
    // The cache and the width it was taken at both survive.
    assert recycler::heights_width_of(v) > 0.0f64;
    // The old rows answer their OLD numbers, without asking again. (Counted
    // around the questions rather than from the top: a real table may service
    // the insert by asking for the new rows itself, which is the table doing
    // its job and not this list re-measuring.)
    let asked: i64 = SH_ASKED;
    assert recycler::height_of_row(v, 0 as i64) == 40.0f64;
    assert recycler::height_of_row(v, 4 as i64) == 40.0f64;
    assert SH_ASKED == asked;
    // The two new rows are the ones that get measured — with the new content.
    assert recycler::height_of_row(v, 5 as i64) == 30.0f64;
    assert recycler::height_of_row(v, 6 as i64) == 46.0f64;
    assert SH_BUILDS == (0 as i64);
    return;
}

#[test]
fn an_insert_in_the_middle_shifts_the_cache_with_the_rows() {
    backend::install();
    // A splice is not just a count: row 1's measurement belongs to whatever
    // row 1 becomes. Inserting one row at 1 moves every old measurement down
    // by one, and the new row alone is unmeasured.
    SH_BUILDS = 0 as i64;
    SH_ASKED = 0 as i64;
    IV_BUMP = 0.0f64;
    var n: core::Node = iv_list(4 as usize);
    let p: *core::Node = #addr_of(n);
    let v: *u8 = views::create(0 as *u8, p);
    core::set_view(p, v, views::view_release);
    iv_ask_all(v, 4 as i64);            // cache: 40 24 40 24
    IV_BUMP = 6.0f64;
    core::clear_dirty(p);
    match list::find("iv", within: p) {
        option::Option[list::List]::Some(x) => {
            let _i: list::List = x.insert_rows(at: 1 as usize, count: 1 as usize);
        }
        option::Option[list::List]::None => { assert false; }
    }
    views::apply(0 as *u8, p);
    assert recycler::height_of_row(v, 0 as i64) == 40.0f64;   // untouched
    assert recycler::height_of_row(v, 1 as i64) == 30.0f64;   // the new row
    // Old row 1 (24) now sits at index 2, where a fresh ask would answer 46.
    assert recycler::height_of_row(v, 2 as i64) == 24.0f64;
    assert recycler::height_of_row(v, 3 as i64) == 40.0f64;
    assert recycler::height_of_row(v, 4 as i64) == 24.0f64;
    return;
}

#[test]
fn a_removal_drops_exactly_those_rows_measurements() {
    backend::install();
    SH_BUILDS = 0 as i64;
    SH_ASKED = 0 as i64;
    IV_BUMP = 0.0f64;
    var n: core::Node = iv_list(5 as usize);
    let p: *core::Node = #addr_of(n);
    let v: *u8 = views::create(0 as *u8, p);
    core::set_view(p, v, views::view_release);
    iv_ask_all(v, 5 as i64);            // cache: 40 24 40 24 40
    IV_BUMP = 6.0f64;
    core::clear_dirty(p);
    match list::find("iv", within: p) {
        option::Option[list::List]::Some(x) => {
            let _r: list::List = x.remove_rows(at: 1 as usize, count: 2 as usize);
        }
        option::Option[list::List]::None => { assert false; }
    }
    views::apply(0 as *u8, p);
    let asked: i64 = SH_ASKED;
    assert recycler::height_of_row(v, 0 as i64) == 40.0f64;
    // What was row 3 is row 1 now, and it kept ITS number (24), not row 1's.
    assert recycler::height_of_row(v, 1 as i64) == 24.0f64;
    assert recycler::height_of_row(v, 2 as i64) == 40.0f64;
    assert SH_ASKED == asked;
    return;
}

// NEGATIVE: a grouped list takes the reload. The splice is data-indexed and
// the translation reads `group_size`, which the application has already moved
// to describe the NEW sequence — so there is no honest way to ask where the
// old rows were.
#[test]
fn a_grouped_splice_reloads_rather_than_guessing_the_table_rows() {
    backend::install();
    SH_BUILDS = 0 as i64;
    SH_ASKED = 0 as i64;
    IV_BUMP = 0.0f64;
    var n: core::Node = list::list(key: "spg", uneven_rows: true, grouped: true);
    let p: *core::Node = #addr_of(n);
    match list::find("spg", within: p) {
        option::Option[list::List]::Some(x) => {
            let a: list::List = x.set_row(sh_row);
            let b: list::List = a.set_count(5 as usize);
            let c: list::List = b.set_group_count(2 as usize);
            let d: list::List = c.set_group_size(g_size);
            let e: list::List = d.set_group_header(g_header);
            let _f: list::List = e.set_row_height_of(iv_height);
        }
        option::Option[list::List]::None => { assert false; }
    }
    let v: *u8 = views::create(0 as *u8, p);
    core::set_view(p, v, views::view_release);
    let _h: f64 = recycler::height_of_row(v, 1 as i64);
    assert recycler::heights_width_of(v) > 0.0f64;
    core::clear_dirty(p);
    match list::find("spg", within: p) {
        option::Option[list::List]::Some(x) => {
            let _i: list::List = x.insert_rows(at: 5 as usize, count: 1 as usize);
        }
        option::Option[list::List]::None => { assert false; }
    }
    views::apply(0 as *u8, p);
    // The reload took the measurements with it, exactly as a count write does.
    assert recycler::heights_width_of(v) == 0.0f64;
    return;
}

#[test]
fn invalidate_row_re_asks_that_row_and_keeps_the_rest() {
    backend::install();
    // The streaming write: same count, same sequence, ONE row's content
    // changed. The old contract had no way to say it, so an 87-row transcript
    // re-measured all 87 of itself on every token.
    SH_BUILDS = 0 as i64;
    SH_ASKED = 0 as i64;
    IV_BUMP = 0.0f64;
    var n: core::Node = iv_list(5 as usize);
    let p: *core::Node = #addr_of(n);
    let v: *u8 = views::create(0 as *u8, p);
    core::set_view(p, v, views::view_release);
    iv_ask_all(v, 5 as i64);
    assert SH_ASKED == (5 as i64);
    // The content of row 2 changes...
    IV_BUMP = 6.0f64;
    core::clear_dirty(p);
    match list::find("iv", within: p) {
        option::Option[list::List]::Some(x) => {
            let _i: list::List = x.invalidate_row(2 as usize);
        }
        option::Option[list::List]::None => { assert false; }
    }
    views::apply(0 as *u8, p);
    // ...and row 2 alone answers the new height. Its neighbours answer from
    // the cache — the stale number is the proof they were not re-asked.
    assert recycler::height_of_row(v, 2 as i64) == 46.0f64;
    assert recycler::height_of_row(v, 1 as i64) == 24.0f64;
    assert recycler::height_of_row(v, 0 as i64) == 40.0f64;
    assert recycler::height_of_row(v, 4 as i64) == 40.0f64;
    assert SH_BUILDS == (0 as i64);
    return;
}

#[test]
fn two_invalidations_coalesce_to_the_span_between_them() {
    backend::install();
    // Pending invalidations merge to min..max, which is what a backend can
    // act on cheaply — a row between two edits costs a height re-ask, not a
    // rebuild. So row 2, named by NEITHER call, re-asks too.
    SH_BUILDS = 0 as i64;
    SH_ASKED = 0 as i64;
    IV_BUMP = 0.0f64;
    var n: core::Node = iv_list(5 as usize);
    let p: *core::Node = #addr_of(n);
    let v: *u8 = views::create(0 as *u8, p);
    core::set_view(p, v, views::view_release);
    iv_ask_all(v, 5 as i64);
    IV_BUMP = 6.0f64;
    core::clear_dirty(p);
    match list::find("iv", within: p) {
        option::Option[list::List]::Some(x) => {
            let a: list::List = x.invalidate_row(1 as usize);
            let _b: list::List = a.invalidate_row(3 as usize);
        }
        option::Option[list::List]::None => { assert false; }
    }
    views::apply(0 as *u8, p);
    assert recycler::height_of_row(v, 1 as i64) == 30.0f64;
    assert recycler::height_of_row(v, 2 as i64) == 46.0f64;
    assert recycler::height_of_row(v, 3 as i64) == 30.0f64;
    // The rows outside the span kept their cache.
    assert recycler::height_of_row(v, 0 as i64) == 40.0f64;
    assert recycler::height_of_row(v, 4 as i64) == 40.0f64;
    return;
}

// NEGATIVE: rows the list does not have are nothing to act on. A span reaching
// past the count is clamped to the rows that exist; one starting past it does
// nothing at all — a count can have shrunk under a pending invalidation.
#[test]
fn an_invalidation_past_the_count_is_clamped_or_inert() {
    backend::install();
    SH_BUILDS = 0 as i64;
    SH_ASKED = 0 as i64;
    IV_BUMP = 0.0f64;
    var n: core::Node = iv_list(5 as usize);
    let p: *core::Node = #addr_of(n);
    let v: *u8 = views::create(0 as *u8, p);
    core::set_view(p, v, views::view_release);
    iv_ask_all(v, 5 as i64);
    IV_BUMP = 6.0f64;
    core::clear_dirty(p);
    match list::find("iv", within: p) {
        option::Option[list::List]::Some(x) => {
            let _s: list::List = x.invalidate_rows(from: 3 as usize, count: 50 as usize);
        }
        option::Option[list::List]::None => { assert false; }
    }
    views::apply(0 as *u8, p);
    // Clamped: 3 and 4 re-ask, 2 keeps its cache.
    assert recycler::height_of_row(v, 3 as i64) == 30.0f64;
    assert recycler::height_of_row(v, 4 as i64) == 46.0f64;
    assert recycler::height_of_row(v, 2 as i64) == 40.0f64;
    // Wholly past the count: inert, and nothing to crash on.
    core::clear_dirty(p);
    match list::find("iv", within: p) {
        option::Option[list::List]::Some(x) => {
            let _i: list::List = x.invalidate_row(99 as usize);
        }
        option::Option[list::List]::None => { assert false; }
    }
    views::apply(0 as *u8, p);
    assert recycler::height_of_row(v, 0 as i64) == 40.0f64;
    return;
}

#[test]
fn a_grouped_invalidation_lands_on_the_table_rows_of_its_data_span() {
    backend::install();
    // The span is DATA-indexed — the same `i` that `row(i)` means. Groups of
    // 2 and 3 over 5 items, so data 2 sits one header past its own number:
    //   0 header | 1 data0 | 2 data1 | 3 header | 4 data2 | 5 data3 | 6 data4
    SH_BUILDS = 0 as i64;
    SH_ASKED = 0 as i64;
    IV_BUMP = 0.0f64;
    var l: core::Node = list::list(key: "ivg", uneven_rows: true, grouped: true);
    let p: *core::Node = #addr_of(l);
    match list::find("ivg", within: p) {
        option::Option[list::List]::Some(x) => {
            let a: list::List = x.set_row(sh_row);
            let b: list::List = a.set_count(5 as usize);
            let c: list::List = b.set_group_count(2 as usize);
            let d: list::List = c.set_group_size(g_size);
            let e: list::List = d.set_group_header(g_header);
            let _f: list::List = e.set_row_height_of(iv_height);
        }
        option::Option[list::List]::None => { assert false; }
    }
    let v: *u8 = views::create(0 as *u8, p);
    core::set_view(p, v, views::view_release);
    assert recycler::height_of_row(v, 1 as i64) == 40.0f64;
    assert recycler::height_of_row(v, 4 as i64) == 40.0f64;
    assert recycler::height_of_row(v, 5 as i64) == 24.0f64;
    IV_BUMP = 6.0f64;
    core::clear_dirty(p);
    match list::find("ivg", within: p) {
        option::Option[list::List]::Some(x) => {
            let _i: list::List = x.invalidate_row(2 as usize);
        }
        option::Option[list::List]::None => { assert false; }
    }
    views::apply(0 as *u8, p);
    // Table row 4 — data 2 — re-asked; its neighbours in DATA space kept
    // their cache.
    assert recycler::height_of_row(v, 4 as i64) == 46.0f64;
    assert recycler::height_of_row(v, 1 as i64) == 40.0f64;
    assert recycler::height_of_row(v, 5 as i64) == 24.0f64;
    return;
}

#[test]
fn a_rows_content_stretches_with_the_cell_without_waiting_for_a_reload() {
    backend::install();
    // A width change reaches a row through AppKit tiling its columns, inside
    // AppKit's own layout — not on facet's tick. A row that waits for a reload
    // to learn its width is therefore a frame behind the pane it sits in, which
    // is visible as cards clipped off the right on the way out and short of it
    // on the way back. `vendor/facet_appkit.old` never had that, and not by
    // reloading sooner: it put `NSViewWidthSizable` on the cell's whole subtree
    // and let AppKit stretch the content live.
    //
    // The mask is gone — it shrank fixed-size views too, see
    // `a_narrowed_cell_re_lays_its_row_out_rather_than_shrinking_every_view` —
    // and the cell's own resize hook re-runs flex instead. This claim is
    // unchanged by that and is the reason the hook has to be synchronous:
    // resize the CELL alone — no reload, no tick, nothing facet does — and the
    // content must already have followed.
    //
    // The column width is stated because a headless table's frame is zero, and
    // a cell 1pt wide taken 100pt narrower is a NEGATIVE width — a number
    // AppKit's springs were happy to divide and nothing should be asserted on.
    var n: core::Node = rp_list(3 as usize, false);
    let v: *u8 = views::create(0 as *u8, #addr_of(n));
    recycler::set_column_width(v, 300.0f64);
    let cell: *u8 = recycler::view_for_row(v, 0 as i64);
    assert cell != (0 as *u8);
    let cf: rt::Rect = { ak::View::from_raw(cell).frame() };
    let subs: vec::Vec[ak::View] = ak::View::from_raw(cell).subviews();
    assert subs.count() > (0 as usize);
    var before: f64 = 0.0f64;
    match subs.at_ptr(0 as usize) {
        option::Option[*ak::View]::Some(sv) => { before = { (*sv).frame().w }; }
        option::Option[*ak::View]::None => { assert false; }
    }
    assert before > 0.0f64;

    // AppKit resizes the cell. Nothing else happens — no reloadData, no tick.
    ak::View::from_raw(cell).set_frame(rt::Rect { x: 0.0f64, y: 0.0f64,
                                                  w: cf.w - 100.0f64, h: cf.h });

    match subs.at_ptr(0 as usize) {
        option::Option[*ak::View]::Some(sv) => {
            let after: f64 = { (*sv).frame().w };
            // Narrower by exactly what the cell lost: the margins are fixed and
            // the width absorbs the change.
            assert after == before - 100.0f64;
        }
        option::Option[*ak::View]::None => { assert false; }
    }
    views::view_release(v);
    return;
}

#[test]
fn a_list_table_keeps_the_automatic_style_and_a_zero_intercell_gap() {
    backend::install();
    // Two numbers on the table are load-bearing and each has pulled once.
    //
    // The intercell gap defaults to {3, 2}: three points of horizontal inset,
    // so the cell a row is drawn into is narrower than the column the row was
    // laid out against, and the right edge of a card is what falls off.
    //
    // The style must stay AUTOMATIC (0). FullWidth — the old backend's choice,
    // and once written here as "Plain" — makes the table tile at create:
    // reloadData runs the height pass immediately, `heightOfRow:` builds every
    // row, and the lazy create that `a_list_asks_for_no_rows_until_the_table_
    // asks_for_them` pins is gone. The insets a resolved automatic style adds
    // are compensated where rows are measured: `column_width` reads the
    // COLUMN, which AppKit narrows by exactly those insets.
    var n: core::Node = rp_list(3 as usize, false);
    let v: *u8 = views::create(0 as *u8, #addr_of(n));
    let tv: *u8 = { rt::msg_id(v, rt::sel(#str_ptr("documentView\0"))) };
    assert tv != (0 as *u8);
    assert { rt::msg_i64(tv, rt::sel(#str_ptr("style\0"))) } == (0 as i64);   // Automatic
    let sp: rt::Size = { rt::msg_size(tv, rt::sel(#str_ptr("intercellSpacing\0"))) };
    assert { sp.w } == 0.0f64;
    assert { sp.h } == 0.0f64;
    views::view_release(v);
    return;
}

#[test]
fn a_tree_table_keeps_the_automatic_style_and_a_zero_intercell_gap() {
    backend::install();
    // The outline view is configured by a separate create path, so the list
    // being right proves nothing about it — same pins, same reason.
    var root: tree::TreeNode = tree::TreeNode::new("root", id: "root");
    let _a: status::Status = root.add_child(tree::TreeNode::new("leaf", id: "leaf"));
    var t: core::Node = tree::tree(root, key: "fwt", row: rp_tree_row);
    let v: *u8 = views::create(0 as *u8, #addr_of(t));
    let ov: *u8 = { rt::msg_id(v, rt::sel(#str_ptr("documentView\0"))) };
    assert ov != (0 as *u8);
    assert { rt::msg_i64(ov, rt::sel(#str_ptr("style\0"))) } == (0 as i64);   // Automatic
    let sp: rt::Size = { rt::msg_size(ov, rt::sel(#str_ptr("intercellSpacing\0"))) };
    assert { sp.w } == 0.0f64;
    assert { sp.h } == 0.0f64;
    views::view_release(v);
    return;
}

// A row that STATES a height lays its content out in that height.
fn tall_row(n: *tree::TreeNode, ctx: *u8) -> flex::Node {
    var b: core::Builder = core::Builder::new();
    b.add(box_view::box(color: vocab::Color::rgba(0.5f64, 0.5f64, 0.5f64))
        .width(15.0f64).height(15.0f64));
    b.add(label::label("main.cplus", font_size: 14.0f64,
                       text_align: vocab::TextAlign::Start)
        .grow(1.0f64).shrink(1.0f64));
    var row: core::Node = ui::hstack(b).align(flex::Align::Center).gap(6.0f64);
    row.set_padding_edge(flex::Edge::Horizontal, 4.0f64);
    return row;
}

#[test]
fn a_stated_row_height_is_the_height_the_content_is_laid_out_IN() {
    backend::install();
    // The row was laid out at WIDTH ONLY, so its height came from its content
    // and the cell was set to that — a 15pt icon-and-name inside a 34pt row,
    // pinned to the top of it. AppKit centres what IT draws in the FULL row,
    // the disclosure triangle most visibly, so the triangle sat in the middle
    // while the icon and the name sat on the ceiling. A row that stated a
    // comfortable height got no benefit from stating one.
    var root: tree::TreeNode = tree::TreeNode::new("root", id: "root");
    let _a: status::Status = root.add_child(tree::TreeNode::new("main.cplus", id: "f"));
    var t: core::Node = tree::tree(root, key: "va", row: tall_row, row_height: 34.0f64);
    let tp: *core::Node = #addr_of(t);
    let v: *u8 = views::create(0 as *u8, tp);
    core::set_view(tp, v, views::view_release);
    views::apply(0 as *u8, tp);
    assert recycler::tree_height_of_row(v, 0 as i64) == 34.0f64;

    let cell: *u8 = recycler::tree_view_for_row(v, 0 as i64);
    assert cell != (0 as *u8);
    // The cell is the ROW, not the content.
    assert { ak::View::from_raw(cell).frame().h } == 34.0f64;

    // And `align(Center)` centres in it: (34 - 15) / 2.
    let subs: vec::Vec[ak::View] = ak::View::from_raw(cell).subviews();
    assert subs.count() == (2 as usize);
    match subs.at_ptr(0 as usize) {
        option::Option[*ak::View]::Some(sv) => {
            let f: rt::Rect = { (*sv).frame() };
            assert f.h == 15.0f64;
            assert f.y > 5.0f64;
            assert f.y < 12.0f64;
        }
        option::Option[*ak::View]::None => { assert false; }
    }
    return;
}

#[test]
fn the_selection_write_back_stands_down_while_facet_is_applying() {
    backend::install();
    // `reloadData` CLEARS the selection, and AppKit reports that clear like any
    // other selection change — so the reload's own side effect wrote
    // `selected = ""` into the model, destroying the record needed to put the
    // selection back afterwards. The expansion write-back has stood down
    // during an apply since it was written; the selection one never did.
    //
    // Posed directly: `reloadData` headlessly does not clear the selection at
    // all (no window, no display cycle), so a test that merely reloads passes
    // whether the guard is there or not — measured, after it fooled me once.
    var root: tree::TreeNode = tree::TreeNode::new("root", id: "root");
    let _a: status::Status = root.add_child(tree::TreeNode::new("alpha", id: "alpha"));
    let _b: status::Status = root.add_child(tree::TreeNode::new("beta", id: "beta"));
    var t: core::Node = tree::tree(root, key: "sel", row: rp_tree_row);
    let tp: *core::Node = #addr_of(t);
    let v: *u8 = views::create(0 as *u8, tp);
    core::set_view(tp, v, views::view_release);
    core::touch(tp, tree::P_ROOT);
    views::apply(0 as *u8, tp);
    let ov: *u8 = recycler::table_of(v);

    let set: *u8 = { rt::msg_id_u64(rt::get_class(#str_ptr("NSIndexSet\0")),
                                    rt::sel(#str_ptr("indexSetWithIndex:\0")), 1 as u64) };
    { msg_void_id_i8_t(ov, rt::sel(#str_ptr("selectRowIndexes:byExtendingSelection:\0")),
                       set, 0 as i8) };
    recycler::tree_clear_selection_as_a_reload_would(v, false);
    // Not applying: this IS the user, and the model follows them.
    match tree::find("sel", within: tp) {
        option::Option[tree::Tree]::Some(h) => { assert h.selected() == ""; }
        option::Option[tree::Tree]::None => { assert false; }
    }

    // Select again, then do the same thing WHILE APPLYING.
    { msg_void_id_i8_t(ov, rt::sel(#str_ptr("selectRowIndexes:byExtendingSelection:\0")),
                       set, 0 as i8) };
    match tree::find("sel", within: tp) {
        option::Option[tree::Tree]::Some(h) => { assert h.selected() == "beta"; }
        option::Option[tree::Tree]::None => { assert false; }
    }
    recycler::tree_clear_selection_as_a_reload_would(v, true);
    // The model REMEMBERS. That memory is what `select_by_id` restores from
    // after the reload; without it there is nothing to restore and the user
    // loses the highlight to a reload they did not cause.
    match tree::find("sel", within: tp) {
        option::Option[tree::Tree]::Some(h) => { assert h.selected() == "beta"; }
        option::Option[tree::Tree]::None => { assert false; }
    }
    return;
}

#[test]
fn expanding_a_folder_YOURSELF_does_not_reload_the_tree_out_from_under_you() {
    backend::install();
    // AppKit expands the item and THEN tells us, and the write-back that
    // records it dirties `P_EXPANDED` exactly like an application calling
    // `expand()` would. Reloading on that re-vends every row and takes the
    // SELECTION and the keyboard focus with them — press right-arrow to open a
    // folder and the highlight vanishes and the tree stops answering the arrows.
    //
    // There is nothing to apply: the outline view is already in the state the
    // model now describes. The whole effect of the fix is a reload that does
    // NOT happen, which is why this counts them.
    var root: tree::TreeNode = tree::TreeNode::new("root", id: "root");
    var branch: tree::TreeNode = tree::TreeNode::new("src", id: "src", is_branch: true);
    let _c: status::Status = branch.add_child(tree::TreeNode::new("main.cplus", id: "m"));
    let _b: status::Status = root.add_child(branch);
    var t: core::Node = tree::tree(root, key: "kx", row: rp_tree_row);
    let tp: *core::Node = #addr_of(t);
    let v: *u8 = views::create(0 as *u8, tp);
    core::set_view(tp, v, views::view_release);
    views::apply(0 as *u8, tp);

    // THE USER opens it: AppKit expanded already, the model is recording.
    recycler::reset_tree_reloads();
    recycler::tree_notify_expanded(v, 0 as i64);
    core::clear_dirty(tp);
    core::touch(tp, tree::P_EXPANDED);
    views::apply(0 as *u8, tp);
    assert recycler::tree_reloads() == (0 as i64);

    // THE APPLICATION expands: nothing has been applied yet, so this one must
    // reload. Same dirty bit, opposite origin — which is the distinction that
    // did not exist before.
    match tree::find("kx", within: tp) {
        option::Option[tree::Tree]::Some(h) => { let _e: tree::Tree = h.expand("src"); }
        option::Option[tree::Tree]::None => { assert false; }
    }
    core::clear_dirty(tp);
    core::touch(tp, tree::P_EXPANDED);
    views::apply(0 as *u8, tp);
    assert recycler::tree_reloads() == (1 as i64);
    return;
}

#[test]
fn a_reused_cell_shows_ONE_row_not_the_old_one_underneath() {
    backend::install();
    // Tearing the old row down releases the views its node owned, but a
    // released view whose SUPERVIEW still retains it does not go anywhere —
    // and the cell is that superview. The previous row's labels stayed and the
    // new row's were added on top: "SKILL.md" and "main.cplus" drawn through
    // each other in one row.
    RL_BUILDS = 0 as i64;
    var n: core::Node = rl_list(5 as usize, 0 as i64);
    let v: *u8 = views::create(0 as *u8, #addr_of(n));
    let cell: *u8 = recycler::make_cell(v);
    assert cell != (0 as *u8);

    // No bind, so every fill REBUILDS into the same cell — the shape that
    // doubled.
    recycler::fill_into(v, cell, 0 as i64);
    let after_first: usize = ak::View::from_raw(cell).subviews().count();
    assert after_first > (0 as usize);

    recycler::fill_into(v, cell, 1 as i64);
    assert ak::View::from_raw(cell).subviews().count() == after_first;
    recycler::fill_into(v, cell, 2 as i64);
    assert ak::View::from_raw(cell).subviews().count() == after_first;
    // Rebuilt each time — this is the path, not the bind one.
    assert RL_BUILDS == (3 as i64);
    views::view_release(v);
    return;
}

#[test]
fn a_width_change_records_the_width_and_does_not_reload() {
    backend::install();
    // TWO CLAIMS, and the second one replaced a reload.
    //
    // `last_width` starts at 0, so the FIRST notification always compared as a
    // change — for rows that had just been vended at that very width. Nothing
    // is owed: record it and move on.
    //
    // And a REAL change no longer reloads either. It used to, because nothing
    // else re-laid a materialized row out at a new width; `FacetRowCell` now
    // does that from its own resize hook, in AppKit's own tiling pass. The
    // reload was costing the user their selection — `reloadData` invalidates
    // the rows, and until AppKit rebuilds them at the next display there is no
    // selected row and no highlight. Measured on one divider drag: 98 reloads,
    // each restoring the selection and each losing it again.
    var root: tree::TreeNode = tree::TreeNode::new("root", id: "root");
    let _a: status::Status = root.add_child(tree::TreeNode::new("alpha", id: "alpha"));
    var t: core::Node = tree::tree(root, key: "fw", row: rp_tree_row);
    let tp: *core::Node = #addr_of(t);
    let v: *u8 = views::create(0 as *u8, tp);
    core::set_view(tp, v, views::view_release);
    views::apply(0 as *u8, tp);

    recycler::reset_tree_reloads();
    recycler::set_column_width(v, 400.0f64);
    recycler::tree_notify_resized(v);
    assert recycler::tree_last_width_of(v) == 400.0f64;
    assert recycler::tree_reloads() == (0 as i64);

    // A real change is taken up — and costs no reload.
    recycler::set_column_width(v, 250.0f64);
    recycler::tree_notify_resized(v);
    assert recycler::tree_last_width_of(v) == 250.0f64;
    assert recycler::tree_reloads() == (0 as i64);

    // Nor does a second one, however many the drag delivers.
    recycler::set_column_width(v, 180.0f64);
    recycler::tree_notify_resized(v);
    assert recycler::tree_last_width_of(v) == 180.0f64;
    assert recycler::tree_reloads() == (0 as i64);

    // A ROOT change is a different question and still reloads: the model is
    // new, so the rows genuinely are.
    match tree::from(tp) {
        option::Option[tree::Tree]::Some(handle) => {
            var fresh: tree::TreeNode = tree::TreeNode::new("root", id: "root");
            let _n: status::Status = fresh.add_child(tree::TreeNode::new("beta", id: "beta"));
            let _r: tree::Tree = handle.set_root(fresh);
        }
        option::Option[tree::Tree]::None => { assert false; }
    }
    views::apply(0 as *u8, tp);
    assert recycler::tree_reloads() > (0 as i64);
    return;
}

#[test]
fn a_resize_arriving_inside_the_tables_own_delegate_does_not_re_enter_it() {
    backend::install();
    // AppKit resizes its columns WHILE vending and measuring rows, so the
    // frame-change notification arrives during a callback we are already
    // inside. Reloading there re-enters the table:
    //
    //     WARNING: Application performed a reentrant operation in its
    //     NSTableView delegate. This warning will become an assert in the
    //     future.
    //
    // On screen it was rows drawn twice and a stuttering first expand.
    // Skipping is correct rather than merely safe: the table is laying out at
    // that width right now and every row it vends is already placed at it.
    var root: tree::TreeNode = tree::TreeNode::new("root", id: "root");
    let _a: status::Status = root.add_child(tree::TreeNode::new("alpha", id: "alpha"));
    var t: core::Node = tree::tree(root, key: "reent", row: rp_tree_row);
    let tp: *core::Node = #addr_of(t);
    let v: *u8 = views::create(0 as *u8, tp);
    core::set_view(tp, v, views::view_release);
    views::apply(0 as *u8, tp);

    recycler::set_column_width(v, 400.0f64);
    recycler::tree_notify_resized(v);
    assert recycler::tree_last_width_of(v) == 400.0f64;

    // The same notification, arriving from inside a delegate callback, is
    // ignored — the width is left for whoever is not already in the table.
    recycler::set_column_width(v, 250.0f64);
    recycler::tree_notify_resized_in_delegate(v);
    assert recycler::tree_last_width_of(v) == 400.0f64;

    // Outside one, it is taken up as before.
    recycler::tree_notify_resized(v);
    assert recycler::tree_last_width_of(v) == 250.0f64;
    return;
}

// ---- a tree row has a NAME on the agent surface -----------------------------
//
// The "a tree row cannot be named" gap: a tree row is the one control an
// application cannot key.
// The row a builder returns is CONTENT, mounted inside a cell the recycler owns,
// so no application key lands on the row itself — `describe_ui` showed nothing
// under `files:tree` and the Files pane could not be driven at all. The old
// pre-recycler tree took `row_id` and tagged each cell with it; this is that,
// carried forward.

fn ri_row_id(n: *tree::TreeNode, ctx: *u8) -> text::Text {
    return text::from_str("row:${{ (*n).id_of() }}");
}

fn ri_tree(with_id: bool) -> core::Node {
    var root: tree::TreeNode = tree::TreeNode::new("root", id: "root");
    var branch: tree::TreeNode = tree::TreeNode::new("src", id: "src", is_branch: true);
    let _k: status::Status = branch.add_child(tree::TreeNode::new("main.cplus", id: "src/main"));
    let _b: status::Status = root.add_child(branch);
    let _a: status::Status = root.add_child(tree::TreeNode::new("SKILL.md", id: "skill"));
    if with_id {
        return tree::tree(root, key: "ri", row: rp_tree_row, row_id: ri_row_id);
    }
    return tree::tree(root, key: "ri", row: rp_tree_row);
}

// NOT a `mount(with_id) -> *u8` helper, however much these five tests want
// one: the node is dropped when such a helper returns, and the data source
// dereferences it on every question the outline view asks. Each test holds its
// own tree for as long as it looks at it.
fn cell_identifier(cell: *u8) -> text::Text {
    return ak::Accessibility::from_raw(cell).accessibility_identifier();
}

#[test]
fn a_tree_row_carries_the_id_the_application_gave_it() {
    backend::install();
    var t: core::Node = ri_tree(true);
    let tp: *core::Node = #addr_of(t);
    let v: *u8 = views::create(0 as *u8, tp);
    core::set_view(tp, v, views::view_release);
    views::apply(0 as *u8, tp);
    recycler::set_column_width(v, 300.0f64);
    let cell: *u8 = recycler::tree_view_for_row(v, 0 as i64);
    assert cell != (0 as *u8);
    // Row 0 is `src` — the id is the application's, not the label and not the
    // row number, so it survives the tree being rebuilt in a different order.
    assert cell_identifier(cell).view() == "row:src";
    let second: *u8 = recycler::tree_view_for_row(v, 1 as i64);
    assert second != (0 as *u8);
    assert cell_identifier(second).view() == "row:skill";
    return;
}

#[test]
fn a_recycled_cell_is_re_tagged_with_the_row_it_now_shows() {
    backend::install();
    // The failure this prevents is silent and it is the whole reason the tag
    // happens on every vend: an id written once names the item that built the
    // cell, and every reuse after that points the agent at the wrong row.
    var t: core::Node = ri_tree(true);
    let tp: *core::Node = #addr_of(t);
    let v: *u8 = views::create(0 as *u8, tp);
    core::set_view(tp, v, views::view_release);
    views::apply(0 as *u8, tp);
    recycler::set_column_width(v, 300.0f64);
    let cell: *u8 = recycler::tree_view_for_row(v, 0 as i64);
    assert cell != (0 as *u8);
    assert cell_identifier(cell).view() == "row:src";
    recycler::tree_fill_into(v, cell, 1 as i64);
    assert cell_identifier(cell).view() == "row:skill";
    return;
}

// NEGATIVE: a tree that names no rows tags none. An id nobody chose is worse
// than no id — the agent surface would carry a name the application cannot
// predict and did not ask to expose.
#[test]
fn a_tree_with_no_row_id_leaves_its_rows_untagged() {
    backend::install();
    var t: core::Node = ri_tree(false);
    let tp: *core::Node = #addr_of(t);
    let v: *u8 = views::create(0 as *u8, tp);
    core::set_view(tp, v, views::view_release);
    views::apply(0 as *u8, tp);
    recycler::set_column_width(v, 300.0f64);
    let cell: *u8 = recycler::tree_view_for_row(v, 0 as i64);
    assert cell != (0 as *u8);
    assert cell_identifier(cell).view() == "";
    return;
}

// ---- and a click, which for a row is two different things -------------------

#[test]
fn clicking_a_leaf_row_selects_it() {
    backend::install();
    var t: core::Node = ri_tree(true);
    let tp: *core::Node = #addr_of(t);
    let v: *u8 = views::create(0 as *u8, tp);
    core::set_view(tp, v, views::view_release);
    views::apply(0 as *u8, tp);
    recycler::set_column_width(v, 300.0f64);
    // Row 1 is the leaf `SKILL.md`.
    let cell: *u8 = recycler::tree_view_for_row(v, 1 as i64);
    assert cell != (0 as *u8);
    assert recycler::tree_selected_row_of(v) == (-1 as i64);
    recycler::perform_click_on(cell);
    assert recycler::tree_selected_row_of(v) == (1 as i64);
    return;
}

#[test]
fn clicking_an_expandable_row_toggles_it_instead() {
    backend::install();
    // Selection is the only click a leaf row has, but a BRANCH already has one
    // that means something else — and an agent that could only ever select
    // could never open a folder to reach what is inside it.
    var t: core::Node = ri_tree(true);
    let tp: *core::Node = #addr_of(t);
    let v: *u8 = views::create(0 as *u8, tp);
    core::set_view(tp, v, views::view_release);
    views::apply(0 as *u8, tp);
    recycler::set_column_width(v, 300.0f64);
    let cell: *u8 = recycler::tree_view_for_row(v, 0 as i64);
    assert cell != (0 as *u8);
    assert recycler::tree_rows_of(v) == (2 as i64);
    recycler::perform_click_on(cell);
    // Opened: the child is a row now, and the row was NOT selected.
    assert recycler::tree_rows_of(v) == (3 as i64);
    assert recycler::tree_selected_row_of(v) == (-1 as i64);
    // And it closes again.
    recycler::perform_click_on(cell);
    assert recycler::tree_rows_of(v) == (2 as i64);
    return;
}

// ---- an outline view has to RECOGNISE its own items -------------------------
//
// AppKit identifies an outline item by the OBJECT: selection, expansion,
// `rowForItem:` and its row rebuild all key on the pointers the data source
// hands back. `box_item` minted a fresh NSObject per
// `outlineView:child:ofItem:`, so no two answers were ever the same item and
// the outline view could not recognise anything it had been told.
//
// It surfaced as the selection disappearing on a splitter drag, in one
// direction, which is three removes from the cause. Traced in a live window:
//
//     tree reload#98: keep=b rows=6 sel=2      the reload restores it
//     tree reload:done:            sel=2       still there
//     tree vend:enter:             sel=-1      gone, before the next vend
//
// The re-select worked every time; AppKit dropped it afterwards, rebuilding
// rows out of items it had never seen. The next reload put it back, which is
// what made it look like a direction — a drag that ends on a clear leaves the
// highlight off.

fn identity_tree() -> core::Node {
    var root: tree::TreeNode = tree::TreeNode::new("root", id: "root");
    var branch: tree::TreeNode = tree::TreeNode::new("branch", id: "br", is_branch: true);
    let _k: status::Status = branch.add_child(tree::TreeNode::new("kid", id: "br/kid"));
    let _b: status::Status = root.add_child(branch);
    let _a: status::Status = root.add_child(tree::TreeNode::new("alpha", id: "alpha"));
    let _c: status::Status = root.add_child(tree::TreeNode::new("beta", id: "beta"));
    return tree::tree(root, key: "ident", row: rp_tree_row);
}

#[test]
fn the_same_node_is_always_the_same_outline_item() {
    backend::install();
    var t: core::Node = identity_tree();
    let tp: *core::Node = #addr_of(t);
    let v: *u8 = views::create(0 as *u8, tp);
    core::set_view(tp, v, views::view_release);
    views::apply(0 as *u8, tp);

    // The same (parent, index) asked twice — one node, one item.
    let first: *u8 = recycler::tree_child_of_root(v, 1 as i64);
    let again: *u8 = recycler::tree_child_of_root(v, 1 as i64);
    assert first != (0 as *u8);
    assert first == again;
    // And a different index is a different item, so this is identity and not a
    // single box handed to everyone.
    let other: *u8 = recycler::tree_child_of_root(v, 2 as i64);
    assert other != (0 as *u8);
    assert other != first;
    return;
}

#[test]
fn a_reload_does_not_cost_the_tree_its_items() {
    backend::install();
    var t: core::Node = identity_tree();
    let tp: *core::Node = #addr_of(t);
    let v: *u8 = views::create(0 as *u8, tp);
    core::set_view(tp, v, views::view_release);
    views::apply(0 as *u8, tp);
    let before: *u8 = recycler::tree_child_of_root(v, 1 as i64);
    // A width change is the reload the splitter drag causes, several times a
    // second. The items must survive it, or AppKit is rebuilding its rows from
    // strangers every time.
    recycler::set_column_width(v, 400.0f64);
    recycler::tree_notify_resized(v);
    recycler::set_column_width(v, 250.0f64);
    recycler::tree_notify_resized(v);
    let after: *u8 = recycler::tree_child_of_root(v, 1 as i64);
    assert after == before;
    return;
}

#[test]
fn a_tree_re_places_its_rows_when_its_width_changes() {
    backend::install();
    // A tree had NO resize path — the list observed its own frame and re-placed
    // its rows, the tree observed nothing. So a materialized tree row was never
    // re-laid out for a width change, and `autoresize_subtree`'s springs were
    // the only thing tracking it. Springs share a delta in PROPORTION to current
    // widths, so a subtree crushed to ~zero has no proportion left and never
    // grows back: labels truncate, clip to slivers, then vanish, inside cells
    // that are full width again. Only a re-vend healed it, which for a tree
    // meant an fs event or a tab flip.
    var root: tree::TreeNode = tree::TreeNode::new("root", id: "root");
    let _a: status::Status = root.add_child(tree::TreeNode::new("alpha", id: "alpha"));
    var t: core::Node = tree::tree(root, key: "twr", row: rp_tree_row);
    let tp: *core::Node = #addr_of(t);
    let v: *u8 = views::create(0 as *u8, tp);
    core::set_view(tp, v, views::view_release);
    views::apply(0 as *u8, tp);

    recycler::set_column_width(v, 400.0f64);
    recycler::tree_notify_resized(v);
    assert recycler::tree_last_width_of(v) == 400.0f64;

    // A new width is taken up.
    recycler::set_column_width(v, 250.0f64);
    recycler::tree_notify_resized(v);
    assert recycler::tree_last_width_of(v) == 250.0f64;
    // And the row content was placed at it, not left at the width it was
    // vended with.
    let cell: *u8 = recycler::tree_view_for_row(v, 0 as i64);
    assert cell != (0 as *u8);
    assert { ak::View::from_raw(cell).frame().w } == 250.0f64;

    // An unchanged width does nothing — this is the only coalescing the tree
    // has, because its reload cannot be deferred (below).
    recycler::tree_notify_resized(v);
    assert recycler::tree_last_width_of(v) == 250.0f64;
    return;
}

#[test]
fn a_trees_reload_is_synchronous_because_its_data_source_reads_the_node() {
    backend::install();
    // WHY THE TREE DOES NOT DEFER ITS RELOAD TO THE TICK, written down because
    // making it match the list is the obvious "cleanup" and it crashes.
    //
    // A tree's data source dereferences its facet NODE to answer every
    // `numberOfChildrenOfItem:`; a list's only reads a count off its source. A
    // tree reload queued for a later tick therefore runs after that node may be
    // gone, and AppKit walks the model into freed memory:
    //
    //     recycler.tree_props_of
    //     -[NSOutlineView _expandItemEntry:expandChildren:startLevel:]
    //     -[NSOutlineView _uncachedNumberOfRows]
    //     -[NSOutlineView reloadData]
    //
    // Run from the notification the node is live, and `layout_enclosing_scroll`
    // is what makes the early read safe — it forces AppKit's deferred column
    // tiling, which is the only thing the tick was buying.
    var root: tree::TreeNode = tree::TreeNode::new("root", id: "root");
    let _a: status::Status = root.add_child(tree::TreeNode::new("beta", id: "beta"));
    var t: core::Node = tree::tree(root, key: "tsync", row: rp_tree_row);
    let tp: *core::Node = #addr_of(t);
    let v: *u8 = views::create(0 as *u8, tp);
    core::set_view(tp, v, views::view_release);
    views::apply(0 as *u8, tp);

    let pending_before: usize = scheduler::pending_reload_count();
    recycler::set_column_width(v, 300.0f64);
    recycler::tree_notify_resized(v);
    // Done already, with nothing left for a tick that could outlive the node.
    assert recycler::tree_last_width_of(v) == 300.0f64;
    assert scheduler::pending_reload_count() == pending_before;
    return;
}

#[test]
fn a_realised_list_rows_content_is_placed_not_left_at_the_origin() {
    backend::install();
    var n: core::Node = rp_list(3 as usize, false);
    let v: *u8 = views::create(0 as *u8, #addr_of(n));
    let cell: *u8 = recycler::view_for_row(v, 0 as i64);
    assert cell != (0 as *u8);
    assert_row_content_is_placed(cell);
    views::view_release(v);
    return;
}

// ---- a cell that arrives narrower than the row was laid out for -------------
//
// A row is laid out at the COLUMN's width, because before AppKit has framed a
// cell there is no other width to ask for — and then AppKit frames the cell at
// something else. An outline view always does: an indented row's cell is inset
// by its level, so it arrives NARROWER than the row was built for. Measured on
// the Files tree: laid out at 432, framed at 423.
//
// That 9pt used to go to autoresizing, which is per-SUBVIEW arithmetic: with
// fixed margins each flexible subview absorbs the WHOLE delta, so every view in
// the row lost 9pt of width, not the row. A name label with slack loses 9 of
// 397 invisibly. A 21pt icon loses 9 of 21 and draws as half a glyph — which is
// what the Files tree showed, in a frame every dump agreed was 21x19, because
// 21 was the LAYOUT's answer and 12 was the view's.
//
// The row shape here is the one that makes the difference legible: a
// fixed-width leading element and a growing label. A re-layout keeps the fixed
// element at 40 and takes the delta out of the label. Springs take it out of
// both.

fn fw_row(i: usize, ctx: *u8) -> core::Node {
    var b: core::Builder = core::Builder::new();
    b.add(label::label("icon", key: "lead").width(40.0f64));
    b.add(label::label("a name", key: "name").grow(1.0f64));
    return core::row(b, key: "");
}

fn fw_tree_row(n: *tree::TreeNode, ctx: *u8) -> core::Node {
    return fw_row(0 as usize, 0 as *u8);
}

fn fw_list(count: usize) -> core::Node {
    var n: core::Node = list::list(key: "fw");
    let p: *core::Node = #addr_of(n);
    match list::find("fw", within: p) {
        option::Option[list::List]::Some(x) => {
            let a: list::List = x.set_row(fw_row);
            let _b: list::List = a.set_count(count);
        }
        option::Option[list::List]::None => { assert false; }
    }
    return n;
}

// The frame of subview `i` of a placed row: 0 is the fixed lead, 1 the growing
// label. A missing one answers a zero rect, which fails every assertion below.
fn fw_frame(cell: *u8, i: usize) -> rt::Rect {
    let subs: vec::Vec[ak::View] = ak::View::from_raw(cell).subviews();
    match subs.at_ptr(i) {
        option::Option[*ak::View]::Some(sv) => { return { (*sv).frame() }; }
        option::Option[*ak::View]::None => { }
    }
    return rt::Rect { x: 0.0f64, y: 0.0f64, w: 0.0f64, h: 0.0f64 };
}

fn fw_sub_count(cell: *u8) -> usize {
    return { ak::View::from_raw(cell).subviews().count() };
}

// `w` off the cell, the way AppKit takes it: the frame is set on the cell and
// nothing else is told.
fn narrow_cell(cell: *u8, to: f64) {
    let was: rt::Rect = { ak::View::from_raw(cell).frame() };
    { msg_void_rect_of(cell, rt::sel(#str_ptr("setFrame:\0")),
                       rt::Rect { x: was.x, y: was.y, w: to, h: was.h }) };
    return;
}

#[link_name = "objc_msgSend"]
extern fn msg_void_rect_of(recv: *u8, sel: *u8, r: rt::Rect);

#[test]
fn a_narrowed_cell_re_lays_its_row_out_rather_than_shrinking_every_view() {
    backend::install();
    var n: core::Node = fw_list(3 as usize);
    let v: *u8 = views::create(0 as *u8, #addr_of(n));
    recycler::set_column_width(v, 200.0f64);
    let cell: *u8 = recycler::view_for_row(v, 0 as i64);
    assert cell != (0 as *u8);
    assert { ak::View::from_raw(cell).frame().w } == 200.0f64;
    assert fw_sub_count(cell) == (2 as usize);
    assert fw_frame(cell, 0 as usize).w == 40.0f64;

    // AppKit frames the cell 9pt narrower than the row was laid out for.
    narrow_cell(cell, 191.0f64);

    assert fw_sub_count(cell) == (2 as usize);
    // The whole claim. Springs leave 31 here.
    assert fw_frame(cell, 0 as usize).w == 40.0f64;
    assert fw_frame(cell, 0 as usize).x == 0.0f64;
    // The delta lands where the layout says it goes: on the one node that
    // grows, which still starts flush against the fixed one.
    assert fw_frame(cell, 1 as usize).x == 40.0f64;
    assert fw_frame(cell, 1 as usize).w == 151.0f64;
    views::view_release(v);
    return;
}

// The tree is where this actually bit: indentation is why an outline cell is
// narrower than its column at all.
#[test]
fn a_narrowed_tree_cell_re_lays_its_row_out_too() {
    backend::install();
    var root: tree::TreeNode = tree::TreeNode::new("root", id: "root");
    let _a: status::Status = root.add_child(tree::TreeNode::new("alpha", id: "alpha"));
    var t: core::Node = tree::tree(root, key: "fwt", row: fw_tree_row);
    let tp: *core::Node = #addr_of(t);
    let v: *u8 = views::create(0 as *u8, tp);
    core::set_view(tp, v, views::view_release);
    views::apply(0 as *u8, tp);
    recycler::set_column_width(v, 200.0f64);

    let cell: *u8 = recycler::tree_view_for_row(v, 0 as i64);
    assert cell != (0 as *u8);
    narrow_cell(cell, 191.0f64);
    assert fw_sub_count(cell) == (2 as usize);
    assert fw_frame(cell, 0 as usize).w == 40.0f64;
    assert fw_frame(cell, 1 as usize).w == 151.0f64;
    return;
}

// A WIDER cell is the same question from the other side — a divider dragged
// out. The fixed element must not grow with it.
#[test]
fn a_widened_cell_gives_the_extra_width_to_what_grows() {
    backend::install();
    var n: core::Node = fw_list(3 as usize);
    let v: *u8 = views::create(0 as *u8, #addr_of(n));
    recycler::set_column_width(v, 200.0f64);
    let cell: *u8 = recycler::view_for_row(v, 0 as i64);
    assert cell != (0 as *u8);
    narrow_cell(cell, 320.0f64);
    assert fw_frame(cell, 0 as usize).w == 40.0f64;
    assert fw_frame(cell, 1 as usize).w == 280.0f64;
    views::view_release(v);
    return;
}

// NEGATIVE: a cell with no row in it is resized by AppKit like any other view —
// the hook has nothing to place and must say so rather than dereference a node
// that is not there.
#[test]
fn resizing_a_cell_that_holds_no_row_does_nothing() {
    backend::install();
    var n: core::Node = fw_list(3 as usize);
    let v: *u8 = views::create(0 as *u8, #addr_of(n));
    recycler::set_column_width(v, 200.0f64);
    let cell: *u8 = recycler::make_cell(v);
    assert cell != (0 as *u8);
    narrow_cell(cell, 120.0f64);
    assert { ak::View::from_raw(cell).frame().w } == 120.0f64;
    assert { ak::View::from_raw(cell).subviews().count() } == (0 as usize);
    views::view_release(v);
    return;
}

// ---- the expand that drifted ------------------------------------------------
//
// Expanding a folder slid the rows below it into place over about a quarter of
// a second. What moves is AppKit's own NSTableRowView — measured in a live
// window, sampling every 50ms: `animationKeys` = 1 on every row after the
// expanded item, its presentation frame 202pt from its model frame, decaying
// 202 -> 124 -> 61 -> 15 over four samples. Nothing facet places moves.
//
// So the fix is NSAnimationContext, not CATransaction, and the grouping has to
// span the expansion: AppKit starts the animation between `WillExpand` and
// `DidExpand`, which is the only pair that brackets it.
//
// A HEADLESS TEST CANNOT SEE THE ANIMATION — there is no run loop pass, no
// window and no Core Animation. What it can hold is the part that goes wrong
// silently: the grouping must be balanced, and a `Did` that this file never
// opened must not pop somebody else's context off a process-wide stack. The
// motion itself was verified on screen, in `examples/icon_probe`.

#[test]
fn an_expansion_is_bracketed_by_a_grouping_and_gives_it_back() {
    backend::install();
    assert recycler::held_row_animations() == (0 as i64);
    recycler::tree_will_expand_imp(0 as *u8, 0 as *u8, 0 as *u8);
    // Held ACROSS the expansion, which is where AppKit starts the row slide.
    assert recycler::held_row_animations() == (1 as i64);
    recycler::tree_did_expand_imp(0 as *u8, 0 as *u8, 0 as *u8);
    assert recycler::held_row_animations() == (0 as i64);

    // Collapse moves rows too, and is the same pair.
    recycler::tree_will_collapse_imp(0 as *u8, 0 as *u8, 0 as *u8);
    assert recycler::held_row_animations() == (1 as i64);
    recycler::tree_did_collapse_imp(0 as *u8, 0 as *u8, 0 as *u8);
    assert recycler::held_row_animations() == (0 as i64);
    return;
}

// NEGATIVE: NSAnimationContext's stack is process-wide. An `endGrouping` for a
// grouping this file never began pops whatever the application had open, and
// the next animation anywhere in the process inherits a duration from here.
#[test]
fn a_did_expand_with_no_will_does_not_pop_a_grouping_this_file_never_opened() {
    backend::install();
    assert recycler::held_row_animations() == (0 as i64);
    recycler::tree_did_expand_imp(0 as *u8, 0 as *u8, 0 as *u8);
    assert recycler::held_row_animations() == (0 as i64);
    recycler::tree_did_collapse_imp(0 as *u8, 0 as *u8, 0 as *u8);
    assert recycler::held_row_animations() == (0 as i64);
    return;
}

// The reuse branch places too. It re-lays-out and re-places rather than
// rebuilding, so the frames have to be pushed again — a bind can change what
// the row measures.
#[test]
fn a_recycled_rows_content_is_placed_again_on_every_reuse() {
    backend::install();
    var n: core::Node = rp_list(100 as usize, true);
    let v: *u8 = views::create(0 as *u8, #addr_of(n));
    let cell: *u8 = recycler::make_cell(v);
    assert cell != (0 as *u8);
    recycler::fill_into(v, cell, 0 as i64);
    assert_row_content_is_placed(cell);
    // Reused: nothing is rebuilt, and the placement survives that.
    recycler::fill_into(v, cell, 42 as i64);
    assert_row_content_is_placed(cell);
    views::view_release(v);
    return;
}

// The tree runs the same helper now, so its rows are placed on the same terms.
fn rp_tree_row(n: *tree::TreeNode, ctx: *u8) -> core::Node {
    var b: core::Builder = core::Builder::new();
    b.add(label::label("first line", key: "a"));
    b.add(label::label("second line", key: "b"));
    return core::column(b, key: "");
}

#[test]
fn a_realised_tree_rows_content_is_placed_not_left_at_the_origin() {
    backend::install();
    var root: tree::TreeNode = tree::TreeNode::new("root", id: "root");
    let _a: status::Status = root.add_child(tree::TreeNode::new("delta", id: "delta"));
    var t: core::Node = tree::tree(root, key: "rpt", row: rp_tree_row);
    let tp: *core::Node = #addr_of(t);
    let v: *u8 = views::create(0 as *u8, tp);
    core::set_view(tp, v, views::view_release);
    views::apply(0 as *u8, tp);
    let cell: *u8 = recycler::tree_view_for_row(v, 0 as i64);
    assert cell != (0 as *u8);
    assert_row_content_is_placed(cell);
    return;
}

// ---- the bind step -----------------------------------------------------------
// The reason recycling was not yet fast: the CELL was reused and the WORK was
// not. With a bind, a cell's subtree is built once and every later row writes
// into it.

static RB_BUILDS: i64 = 0 as i64;
static RB_BINDS: i64 = 0 as i64;

fn rb_row(i: usize, ctx: *u8) -> core::Node {
    RB_BUILDS = RB_BUILDS + (1 as i64);
    var b: core::Builder = core::Builder::new();
    b.add(label::label("", key: "title"));
    return core::column(b, key: "");
}

fn rb_bind(i: usize, row: *core::Node, ctx: *u8) {
    RB_BINDS = RB_BINDS + (1 as i64);
    match label::find("title", within: row) {
        option::Option[label::Label]::Some(l) => {
            let _x: label::Label = l.set_text(digits_i64(i as i64).view());
        }
        option::Option[label::Label]::None => { }
    }
    return;
}

#[test]
fn a_bound_row_is_written_into_rather_than_rebuilt() {
    backend::install();
    RB_BUILDS = 0 as i64;
    RB_BINDS = 0 as i64;
    var n: core::Node = list::list(key: "bl");
    let p: *core::Node = #addr_of(n);
    match list::find("bl", within: p) {
        option::Option[list::List]::Some(x) => {
            let a: list::List = x.set_row(rb_row);
            let b: list::List = a.set_row_bind(rb_bind);
            let _c: list::List = b.set_count(100 as usize);
        }
        option::Option[list::List]::None => { assert false; }
    }
    let v: *u8 = views::create(0 as *u8, p);
    assert v != (0 as *u8);

    // First use of a cell: built once, and bound immediately — so the builder
    // is responsible for SHAPE only and a row can never show the data of
    // whichever row happened to build its cell.
    // A cell of the suite's own, because a headless table never fills its
    // reuse queue — asking it for a recycled cell always answers nil, so the
    // branch that matters would never run under test.
    let cell: *u8 = recycler::make_cell(v);
    assert cell != (0 as *u8);
    recycler::fill_into(v, cell, 0 as i64);
    assert RB_BUILDS == (1 as i64);
    assert RB_BINDS == (1 as i64);
    assert cell_shows(cell, "0");

    // Reused for another row: NOTHING is rebuilt. This is the whole point.
    recycler::fill_into(v, cell, 7 as i64);
    assert RB_BUILDS == (1 as i64);
    assert RB_BINDS == (2 as i64);
    assert cell_shows(cell, "7");

    recycler::fill_into(v, cell, 42 as i64);
    assert RB_BUILDS == (1 as i64);
    assert cell_shows(cell, "42");
    views::view_release(v);
    return;
}

// What the cell's label currently reads. Walks down to the first NSTextField,
// because the row's shape is the test's own and shallow.
fn cell_shows(cell: *u8, want: str) -> bool {
    let subs: vec::Vec[ak::View] = ak::View::from_raw(cell).subviews();
    var i: usize = 0 as usize;
    while i < subs.count() {
        match subs.at_ptr(i) {
            option::Option[*ak::View]::Some(sp) => {
                if view_reads({ (*sp).raw() }, want) { return true; }
            }
            option::Option[*ak::View]::None => { }
        }
        i = i +% (1 as usize);
    }
    return false;
}

fn view_reads(v: *u8, want: str) -> bool {
    if synth::class_responds(synth::object_class(v),
                             rt::sel(#str_ptr("stringValue\0"))) != (0 as i8) {
        if ak::TextField::from_raw(v).as_control().string_value().view() == want { return true; }
    }
    let subs: vec::Vec[ak::View] = ak::View::from_raw(v).subviews();
    var i: usize = 0 as usize;
    while i < subs.count() {
        match subs.at_ptr(i) {
            option::Option[*ak::View]::Some(sp) => { if view_reads({ (*sp).raw() }, want) { return true; } }
            option::Option[*ak::View]::None => { }
        }
        i = i +% (1 as usize);
    }
    return false;
}

#[test]
fn measuring_a_bound_list_builds_one_subtree_not_one_per_row() {
    backend::install();
    // The other half of the cost, and the one that bites on a RESIZE: heights
    // are asked for every row, and answering meant building every row. With a
    // bind, the shape is built once and each row's data written into it.
    RB_BUILDS = 0 as i64;
    RB_BINDS = 0 as i64;
    // `has_uneven_rows` is what says every row must be MEASURED; without it a
    // list measures one and reuses the answer, which is the case below.
    var n: core::Node = list::list(key: "bm", uneven_rows: true);
    let p: *core::Node = #addr_of(n);
    match list::find("bm", within: p) {
        option::Option[list::List]::Some(x) => {
            let a: list::List = x.set_row(rb_row);
            let b: list::List = a.set_row_bind(rb_bind);
            let _c: list::List = b.set_count(200 as usize);
        }
        option::Option[list::List]::None => { assert false; }
    }
    let v: *u8 = views::create(0 as *u8, p);
    var i: i64 = 0 as i64;
    while i < (20 as i64) {
        let _h: f64 = recycler::height_of_row(v, i);
        i = i + (1 as i64);
    }
    // Twenty rows measured, twenty binds — and the builds are what recycling
    // is for. Without a bind this would be twenty subtrees.
    assert RB_BINDS == (20 as i64);
    views::view_release(v);
    return;
}

#[test]
fn a_list_of_even_rows_measures_one_of_them() {
    // `has_uneven_rows: false` is the default and it is an OPTIMISATION, never
    // a guess: the height still comes from measuring a row — this only says the
    // answer may be reused. Twenty rows, one measurement.
    backend::install();
    RB_BUILDS = 0 as i64;
    RB_BINDS = 0 as i64;
    var n: core::Node = list::list(key: "even");
    let p: *core::Node = #addr_of(n);
    match list::find("even", within: p) {
        option::Option[list::List]::Some(x) => {
            let a: list::List = x.set_row(rb_row);
            let b: list::List = a.set_row_bind(rb_bind);
            let _c: list::List = b.set_count(200 as usize);
        }
        option::Option[list::List]::None => { assert false; }
    }
    let v: *u8 = views::create(0 as *u8, p);
    var i: i64 = 0 as i64;
    while i < (20 as i64) {
        let _h: f64 = recycler::height_of_row(v, i);
        i = i + (1 as i64);
    }
    assert RB_BINDS == (1 as i64);
    views::view_release(v);
    return;
}

#[test]
fn a_list_without_a_bind_still_works_the_old_way() {
    backend::install();
    // The bind is OPTIONAL and its absence is not an error: a list that names
    // no bind rebuilds each row, which is what every backend did before the
    // contract could say otherwise.
    RL_BUILDS = 0 as i64;
    var n: core::Node = rl_list(10 as usize, 0 as i64);
    let v: *u8 = views::create(0 as *u8, #addr_of(n));
    let cell: *u8 = recycler::make_cell(v);
    recycler::fill_into(v, cell, 0 as i64);
    recycler::fill_into(v, cell, 1 as i64);
    assert RL_BUILDS == (2 as i64);      // rebuilt, because nothing binds
    views::view_release(v);
    return;
}

#[test]
fn a_resize_discovered_during_layout_is_serviced_in_the_SAME_tick() {
    backend::install();
    // A table learns it was resized from `NSViewFrameDidChangeNotification`,
    // which AppKit posts SYNCHRONOUSLY from `setFrame:` — and in a facet app
    // the call that sets that frame is the tick's OWN layout pass, because the
    // width came from the flex tree (a divider moved, a pane grew). So the
    // resize is discovered DURING layout.
    //
    // Draining reloads BEFORE layout therefore serviced only the PREVIOUS
    // pass's resize: exactly one tick of lag, and visible — the pane took its
    // new width while the rows inside kept the old one and caught up a frame
    // later, clipping on the way out and leaving a gap on the way back.
    //
    // The width here is changed on the NODE, not on the window, so the frame
    // move can only come from the layout pass.
    var b: core::Builder = core::Builder::new();
    b.add(rl_list(30 as usize, 0 as i64));
    var root: core::Node = core::column(b, key: "host").align(flex::Align::Stretch);
    let rp: *core::Node = #addr_of(root);
    let win: *u8 = window::open_window(rp, screen::Chrome::new(title: "resize",
                                                               width: 500.0f64,
                                                               height: 300.0f64));
    assert win != (0 as *u8);

    let lp: *core::Node = match core::child_of(rp, 0 as usize) {
        option::Option[*core::Node]::Some(c) => c,
        option::Option[*core::Node]::None => 0 as *core::Node,
    };
    assert lp != (0 as *core::Node);
    { (*lp).set_width(flex::StyleLength::points(400.0f64)) };
    scheduler::tick();
    let v: *u8 = core::view_of(lp);
    assert v != (0 as *u8);
    let w1: f64 = recycler::column_width_of(v);
    assert w1 > 0.0f64;

    // The width changes in the FLEX TREE. Nothing has moved a native frame yet
    // — the layout pass inside the next tick is what will.
    { (*lp).set_width(flex::StyleLength::points(260.0f64)) };
    core::touch_all(lp);
    scheduler::tick();

    // ONE tick. The rows were measured at the width the table has NOW.
    let w2: f64 = recycler::column_width_of(v);
    assert w2 != w1;
    assert recycler::heights_width_of(v) == w2;
    assert scheduler::pending_reload_count() == (0 as usize);
    app::close_window(rp);
    return;
}

#[test]
fn a_frame_notification_that_arrives_before_the_column_retiles_is_not_lost() {
    backend::install();
    // The resize arrives as `NSViewFrameDidChangeNotification` on the TABLE,
    // and the width we measure against belongs to the COLUMN. Whether AppKit
    // has re-tiled its columns by the time it posts that notification is not
    // an ordering facet owns.
    //
    // Reading the column IN the notification therefore risked answering the
    // width it had BEFORE the resize — which compares equal to the last width,
    // returns early, and drops the resize on the floor. Rows then keep a width
    // the table no longer has, and no later notification rescues it because
    // each one carries the same stale answer. Reading it on the TICK, after
    // AppKit has finished, cannot go wrong that way.
    var n: core::Node = rl_list(20 as usize, 0 as i64);
    let p: *core::Node = #addr_of(n);
    let v: *u8 = views::create(0 as *u8, p);
    core::set_view(p, v, views::view_release);
    recycler::resize_to(v, 400.0f64);
    scheduler::tick();
    assert recycler::column_width_of(v) == 400.0f64;

    // The notification lands FIRST, while the column still reads 400.
    recycler::notify_resized(v);
    // AppKit tiles afterwards.
    recycler::set_column_width(v, 250.0f64);
    // The tick reads the width that is true NOW.
    scheduler::tick();

    assert recycler::column_width_of(v) == 250.0f64;
    // And the heights in hand were measured at it, not at the width the
    // notification saw.
    assert recycler::heights_width_of(v) == 250.0f64;
    views::view_release(v);
    return;
}

static SD_RUNS: i64 = 0 as i64;
fn sd_job(p: *u8) { SD_RUNS = SD_RUNS + (1 as i64); return; }

#[test]
fn a_recorded_drag_is_serviced_synchronously_not_left_to_the_observer() {
    backend::install();
    // Measured on a live drag (FACET_DEBUG_DRAG): while the mouse streams
    // events the run loop never reaches `kCFRunLoopBeforeWaiting` — dozens of
    // recorded drag moves, zero ticks, the debug cycle counter frozen — so an
    // observer at ANY order cannot service a drag; AppKit draws each event's
    // pane resize synchronously at end-of-event. The split delegate therefore
    // services the layout inline through `service_split_drag`, the same way
    // `windowDidResize` already calls `layout_window` directly. This pins the
    // verb: one call runs a full tick — including the queued reloads — with
    // no observer involved.
    SD_RUNS = 0 as i64;
    scheduler::defer_reload(sd_job, 7 as *u8);
    let before: u64 = scheduler::ticks();
    scheduler::service_split_drag();
    assert SD_RUNS == (1 as i64);
    assert scheduler::pending_reload_count() == (0 as usize);
    assert scheduler::ticks() == before + (1 as u64);
    return;
}

#[test]
fn the_tick_observer_sorts_before_core_animations_commit() {
    backend::install();
    // `kCFRunLoopBeforeWaiting` is also where Core Animation commits, at order
    // 2,000,000 — and the commit is what the frame SHOWS. An observer order
    // above it runs after the commit, so every write the tick makes is correct
    // in memory and drawn one frame late. A divider drag shows that as the
    // pane taking its new width in AppKit's own pass while everything facet
    // lays out inside it — the cards — catches up a frame behind, clipping on
    // the way out and gapping on the way back. The order is asserted off the
    // REAL installed observer, not the constant that asked for it.
    scheduler::install_sync_tick();
    let order: i64 = scheduler::observer_order();
    assert order >= (0 as i64);
    assert order < (2000000 as i64);
    return;
}

#[test]
fn a_drag_coalesces_its_reloads_onto_the_tick_rather_than_reloading_inline() {
    backend::install();
    // A drag used to defer onto a 0.1s `performSelector:`, which fires only in
    // the DEFAULT run-loop mode — so during an event-tracking drag it did not
    // fire at all and nothing re-laid out until the divider stopped.
    //
    // Now the reload is a job on the TICK: a CFRunLoopObserver at
    // `kCFRunLoopBeforeWaiting` in COMMON modes, so it runs DURING the drag,
    // once per pass. Many frame changes between two ticks collapse to ONE
    // reload — which is the whole point, because `reloadData` asks
    // `heightOfRow:` for every row.
    RL_BUILDS = 0 as i64;
    var n: core::Node = rl_list(200 as usize, 0 as i64);
    let v: *u8 = views::create(0 as *u8, #addr_of(n));
    scheduler::tick();
    let pending_timers: usize = akx::after_pending_count();

    // Three frames of a drag, between ticks.
    recycler::resize_to(v, 300.0f64);
    recycler::resize_to(v, 280.0f64);
    recycler::resize_to(v, 260.0f64);

    // ONE reload queued, not three — and no TIMER, which is what made the old
    // one invisible mid-drag.
    assert scheduler::pending_reload_count() == (1 as usize);
    assert akx::after_pending_count() == pending_timers;

    // The tick runs it, and leaves nothing behind.
    scheduler::tick();
    assert scheduler::pending_reload_count() == (0 as usize);
    // Measured at the width the table is at NOW.
    assert recycler::height_of_row(v, 0 as i64) > 0.0f64;
    views::view_release(v);
    return;
}

#[test]
fn a_resize_that_does_not_change_the_width_does_no_work() {
    backend::install();
    // A height change moves the viewport, not the rows — nothing re-wraps, so
    // nothing needs re-measuring. This guard is what keeps a live relayout from
    // running on frames that changed nothing horizontally, and it matters more
    // now that the relayout is immediate.
    RL_BUILDS = 0 as i64;
    var n: core::Node = rl_list(50 as usize, 0 as i64);
    let v: *u8 = views::create(0 as *u8, #addr_of(n));
    recycler::resize_to(v, 400.0f64);
    let builds_after_first: i64 = RL_BUILDS;
    recycler::resize_to(v, 400.0f64);
    assert RL_BUILDS == builds_after_first;
    views::view_release(v);
    return;
}

// ---- alert: a sheet an agent can answer --------------------------------------

static AL_ANSWER: i32 = -1;
fn al_answered(which: i32, ctx: *u8) { AL_ANSWER = which; return; }

#[test]
fn an_alert_is_a_facet_tree_the_agent_can_address() {
    backend::install();
    // The whole reason it stopped being an NSAlert: nothing in an NSAlert has a
    // key, so an agent cannot reach it — and a dialog an agent cannot answer is
    // a dialog an agent cannot get past.
    AL_ANSWER = -1;
    let before: usize = app::window_count();
    dialogs::alert_sheet("Discard?", "Three edits will be lost.", "Discard", "Keep",
                         on_answer: al_answered, on_answer_ctx: 0 as *u8);
    // It is a real window of the app, so `find` reaches into it — which is the
    // same door the agent surface uses.
    assert app::window_count() == (before + (1 as usize));
    match label::find("alert:title") {
        option::Option[label::Label]::Some(l) => { assert l.text() == "Discard?"; }
        option::Option[label::Label]::None => { assert false; }
    }
    match label::find("alert:message") {
        option::Option[label::Label]::Some(l) => { assert l.text() == "Three edits will be lost."; }
        option::Option[label::Label]::None => { assert false; }
    }
    match button::find("alert:primary") {
        option::Option[button::Button]::Some(b) => { assert b.title() == "Discard"; }
        option::Option[button::Button]::None => { assert false; }
    }
    match button::find("alert:secondary") {
        option::Option[button::Button]::Some(b) => { assert b.title() == "Keep"; }
        option::Option[button::Button]::None => { assert false; }
    }

    // NON-BLOCKING: control is here, the answer has not arrived, and the app is
    // free to keep running — which is what lets an agent's own request return.
    assert AL_ANSWER == (-1 as i32);

    // Answered by CLICKING, the same path a person or an agent takes.
    click_key("alert:primary");
    assert AL_ANSWER == 0;
    assert app::window_count() == before;
    return;
}

#[test]
fn an_alert_with_one_button_has_no_second_one() {
    backend::install();
    let before: usize = app::window_count();
    dialogs::alert_sheet("Saved", "", "OK", "", on_answer: al_answered, on_answer_ctx: 0 as *u8);
    match button::find("alert:secondary") {
        option::Option[button::Button]::Some(_b) => { assert false; }
        option::Option[button::Button]::None => { }
    }
    // ...and no message label either, rather than an empty one taking space.
    match label::find("alert:message") {
        option::Option[label::Label]::Some(_l) => { assert false; }
        option::Option[label::Label]::None => { }
    }
    AL_ANSWER = -1;
    click_key("alert:primary");
    assert AL_ANSWER == 0;
    assert app::window_count() == before;
    return;
}

// Click the keyed control, the way the agent surface does: find the view, send
// its action.
fn click_key(key: str) {
    match button::find(key) {
        option::Option[button::Button]::Some(b) => {
            let v: *u8 = core::view_of(b.node());
            if v != (0 as *u8) {
                { rt::msg_void_id(v, rt::sel(#str_ptr("performClick:\0")), 0 as *u8) };
            }
        }
        option::Option[button::Button]::None => { assert false; }
    }
    return;
}

#[test]
fn a_titlebar_slot_is_lifted_out_of_the_content() {
    backend::install();
    // GTK supports this best (GtkHeaderBar IS leading/trailing widget slots),
    // AppKit has NSTitlebarAccessoryViewController, and Windows has neither —
    // an app there draws its own bar, which is what Bar::Custom is for. So this
    // is the GTK-shaped extra and Bar::Custom stays the portable answer.
    var lead: core::Node = chrome::titlebar_leading(
        label::label("search", key: "tb:search"));
    var b: core::Builder = core::Builder::new();
    b.add(lead);
    b.add(label::label("body", key: "tb:body"));
    var root: core::Node = core::column(b, key: "tbroot");
    let p: *core::Node = #addr_of(root);

    let w: ak::Window = window::make_shell_window(screen::Chrome::new(
        title: "tb", width: 300.0f64, height: 200.0f64));
    assert mount::mount(p);
    window::install_titlebar_accessories(w, p);

    // The accessory is on the WINDOW...
    let list: *u8 = { rt::msg_id(w.raw(), rt::sel(#str_ptr("titlebarAccessoryViewControllers\0"))) };
    assert list != (0 as *u8);
    assert { rt::msg_u64(list, rt::sel(#str_ptr("count\0"))) } == (1 as u64);

    // ...and OUT of the content's layout, because a node laid out in two places
    // is laid out wrong in one.
    match core::find_in(p, chrome::titlebar_leading_key()) {
        option::Option[*core::Node]::Some(n) => {
            assert { (*n).style.display } == flex::Display::None;
        }
        option::Option[*core::Node]::None => { assert false; }
    }
    mount::unmount(p);
    w.close();
    return;
}

#[test]
fn a_window_with_no_titlebar_slots_gets_no_accessories() {
    backend::install();
    var b: core::Builder = core::Builder::new();
    b.add(label::label("body", key: "nb:body"));
    var root: core::Node = core::column(b, key: "nbroot");
    let p: *core::Node = #addr_of(root);
    let w: ak::Window = window::make_shell_window(screen::Chrome::new(
        title: "nb", width: 300.0f64, height: 200.0f64));
    assert mount::mount(p);
    window::install_titlebar_accessories(w, p);
    let list: *u8 = { rt::msg_id(w.raw(), rt::sel(#str_ptr("titlebarAccessoryViewControllers\0"))) };
    if list != (0 as *u8) {
        assert { rt::msg_u64(list, rt::sel(#str_ptr("count\0"))) } == (0 as u64);
    }
    mount::unmount(p);
    w.close();
    return;
}

// ---- what the user types ------------------------------------------------------
// The hole these close: nothing wired a text control back to facet, so
// `on_text_changed` never fired and — worse, because it is silent —
// `field.text()` kept answering whatever the application last SET. An app that
// read a field after the user typed in it got the old string.
//
// These type through the REAL path. `keyDown:` on the field editor is what
// AppKit itself calls, and it runs interpretKeyEvents -> insertText ->
// didChangeText -> the notification. Posting the notification by hand would
// prove the imp is reachable and nothing about whether AppKit ever reaches it.

static TYPED: i64 = 0 as i64;
static SUBMITS: i64 = 0 as i64;
static TYPED_SAW: text::Text = #zero::[text::Text]();
// The handler's ctx cannot be the node — the node does not exist until the
// constructor that takes the handler has returned. A static is the test's own
// way round that; an application uses `find(key)`.
static TYPED_NODE: *core::Node = #zero::[*core::Node]();

fn on_typed(sender: *u8, ctx: *u8) {
    TYPED = TYPED + (1 as i64);
    // Read through the CURSOR, which is the contract's own reader — the point
    // of the fix is that this answers what is on screen.
    match text_field::from(TYPED_NODE) {
        option::Option[text_field::TextField]::Some(f) => { TYPED_SAW = text::from_str(f.text()); }
        option::Option[text_field::TextField]::None => { }
    }
    return;
}

fn on_submitted(sender: *u8, ctx: *u8) { SUBMITS = SUBMITS + (1 as i64); return; }

fn h_typed() -> fn(*u8, *u8) { let f: fn(*u8, *u8) = on_typed; return f; }
fn h_submitted() -> fn(*u8, *u8) { let f: fn(*u8, *u8) = on_submitted; return f; }

// A field editor exists only while the field is focused, so the field has to
// be in a key window and first responder before there is anything to type in.
fn focused_editor(w: ak::Window, v: *u8) -> option::Option[ak::Text] {
    let f: ak::TextField = ak::TextField::from_raw(v);
    w.make_key_and_order_front(0 as *u8);
    assert w.make_first_responder(f.as_view().as_responder());
    return f.as_control().current_editor();
}

#[test]
fn typing_in_a_text_field_reaches_the_props_and_the_handler() {
    backend::install();
    TYPED = 0 as i64;
    TYPED_SAW = text::from_str("");
    var n: core::Node = text_field::text_field(key: "typed", text: "",
                                              on_text_changed: h_typed());
    let p: *core::Node = #addr_of(n);
    TYPED_NODE = p;
    let v: *u8 = views::create(0 as *u8, p);
    assert v != (0 as *u8);
    let w: ak::Window = window::make_shell_window(screen::Chrome::new(
        title: "typing", width: 300.0f64, height: 200.0f64));
    let host: ak::View = akx::new_flipped_view(rt::Rect { x: 0.0f64, y: 0.0f64, w: 300.0f64, h: 200.0f64 });
    host.add_subview(ak::View::from_raw(v));
    w.set_content_view(host);
    match focused_editor(w, v) {
        option::Option[ak::Text]::Some(ed) => {
            { rt::msg_void_id(ed.raw(), rt::sel(#str_ptr("keyDown:\0")),
                              fake_key_event(0 as u16, "a", 0 as u64)) };
        }
        option::Option[ak::Text]::None => { assert false; }
    }
    // Both halves, and the second is the one that was silently wrong: the
    // handler ran AND the contract's reader answers what was typed.
    assert TYPED == (1 as i64);
    assert TYPED_SAW.view() == "a";
    match text_field::from(p) {
        option::Option[text_field::TextField]::Some(f) => { assert f.text() == "a"; }
        option::Option[text_field::TextField]::None => { assert false; }
    }
    w.close();
    views::view_release(v);
    return;
}

// ---- is_secure names a CLASS, and the flip is live ---------------------------
//
// This was the last create-only verb with a real application behind it. The
// tests below are the four things that have to hold for it to be called live:
// the class actually changes, the props survive the change, the field stays
// where it was in its parent, and no OTHER write pays for the machinery.

fn is_secure_field(v: *u8) -> bool {
    return views::is_kind_of(v, #str_ptr("NSSecureTextField\0"));
}

#[test]
fn flipping_is_secure_swaps_the_class_and_carries_the_props_across() {
    backend::install();
    var n: core::Node = text_field::text_field(key: "pw", text: "hunter2",
                                               placeholder: "password");
    let p: *core::Node = #addr_of(n);
    let v: *u8 = views::create(0 as *u8, p);
    assert v != (0 as *u8);
    core::set_view(p, v, views::view_release);
    let host: ak::View = akx::new_flipped_view(rt::Rect { x: 0.0f64, y: 0.0f64, w: 300.0f64, h: 200.0f64 });
    host.add_subview(ak::View::from_raw(v));
    // It starts plain, because `is_secure` defaults false.
    assert is_secure_field(v) == false;
    core::clear_dirty(p);

    match text_field::from(p) {
        option::Option[text_field::TextField]::Some(f) => { let _f: text_field::TextField = f.set_secure(true); }
        option::Option[text_field::TextField]::None => { assert false; }
    }
    views::apply(0 as *u8, p);

    // The node holds a DIFFERENT object, and that object is the secure class.
    let sv: *u8 = core::view_of(p);
    assert sv != v;
    assert is_secure_field(sv);
    // Everything the old field carried is on the new one — this is the whole
    // claim, and it holds because the swap re-applies the band rather than
    // copying a hand-written list of props.
    assert ak::TextField::from_raw(sv).as_control().string_value().view() == "hunter2";
    assert ak::TextField::from_raw(sv).placeholder_string().view() == "password";
    assert ak::TextField::from_raw(sv).is_editable();
    assert ak::TextField::from_raw(sv).is_bezeled();
    return;
}

#[test]
fn the_reclassed_field_stands_in_the_slot_the_old_one_had() {
    backend::install();
    var before: core::Node = box_view::box(color: vocab::Color::rgba(1.0f64, 0.0f64, 0.0f64), key: "before");
    var n: core::Node = text_field::text_field(key: "pw2", text: "");
    var after: core::Node = box_view::box(color: vocab::Color::rgba(0.0f64, 1.0f64, 0.0f64), key: "after");
    let p: *core::Node = #addr_of(n);
    let v: *u8 = views::create(0 as *u8, p);
    core::set_view(p, v, views::view_release);
    let host: ak::View = akx::new_flipped_view(rt::Rect { x: 0.0f64, y: 0.0f64, w: 300.0f64, h: 200.0f64 });
    let b: *u8 = views::create(0 as *u8, #addr_of(before));
    let a: *u8 = views::create(0 as *u8, #addr_of(after));
    host.add_subview(ak::View::from_raw(b));
    host.add_subview(ak::View::from_raw(v));
    host.add_subview(ak::View::from_raw(a));
    ak::View::from_raw(v).set_frame(rt::Rect { x: 7.0f64, y: 9.0f64, w: 120.0f64, h: 22.0f64 });
    core::clear_dirty(p);

    match text_field::from(p) {
        option::Option[text_field::TextField]::Some(f) => { let _f: text_field::TextField = f.set_secure(true); }
        option::Option[text_field::TextField]::None => { assert false; }
    }
    views::apply(0 as *u8, p);
    let sv: *u8 = core::view_of(p);

    // Same slot: a reclass that appended would put the field last and reorder
    // the UI, which is the bug `replaceSubview:with:` exists to not have.
    let subs: vec::Vec[ak::View] = host.subviews();
    assert subs.count() == (3 as usize);
    match subs.at_ptr(1 as usize) {
        option::Option[*ak::View]::Some(at) => { assert { (*at).raw() } == sv; }
        option::Option[*ak::View]::None => { assert false; }
    }
    // Same box, so nothing flashes at the origin before the next layout pass.
    let fr: rt::Rect = ak::View::from_raw(sv).frame();
    assert fr.x > 6.9f64;
    assert fr.x < 7.1f64;
    assert fr.w > 119.9f64;
    assert fr.w < 120.1f64;
    return;
}

#[test]
fn flipping_is_secure_back_returns_the_plain_class() {
    backend::install();
    var n: core::Node = text_field::text_field(key: "pw3", text: "abc", secure: true);
    let p: *core::Node = #addr_of(n);
    let v: *u8 = views::create(0 as *u8, p);
    core::set_view(p, v, views::view_release);
    let host: ak::View = akx::new_flipped_view(rt::Rect { x: 0.0f64, y: 0.0f64, w: 300.0f64, h: 200.0f64 });
    host.add_subview(ak::View::from_raw(v));
    // Created secure, because create reads the prop too.
    assert is_secure_field(v);
    core::clear_dirty(p);

    match text_field::from(p) {
        option::Option[text_field::TextField]::Some(f) => { let _f: text_field::TextField = f.set_secure(false); }
        option::Option[text_field::TextField]::None => { assert false; }
    }
    views::apply(0 as *u8, p);
    let sv: *u8 = core::view_of(p);
    assert sv != v;
    assert is_secure_field(sv) == false;
    assert ak::TextField::from_raw(sv).as_control().string_value().view() == "abc";
    return;
}

#[test]
fn a_write_that_is_not_is_secure_keeps_the_same_object() {
    // The negative, and the one that would make the machinery expensive if it
    // were wrong: a reclass on every apply would throw the field editor away
    // mid-keystroke. Only a CHANGE of class may swap the object.
    backend::install();
    var n: core::Node = text_field::text_field(key: "pw4", text: "one");
    let p: *core::Node = #addr_of(n);
    let v: *u8 = views::create(0 as *u8, p);
    core::set_view(p, v, views::view_release);
    let host: ak::View = akx::new_flipped_view(rt::Rect { x: 0.0f64, y: 0.0f64, w: 300.0f64, h: 200.0f64 });
    host.add_subview(ak::View::from_raw(v));
    core::clear_dirty(p);

    // An ordinary prop write.
    match text_field::from(p) {
        option::Option[text_field::TextField]::Some(f) => { let _f: text_field::TextField = f.set_text("two"); }
        option::Option[text_field::TextField]::None => { assert false; }
    }
    views::apply(0 as *u8, p);
    assert core::view_of(p) == v;
    assert ak::TextField::from_raw(v).as_control().string_value().view() == "two";

    // And `is_secure` WRITTEN TO THE VALUE IT ALREADY HAS: the bit is dirty,
    // the class is not wrong, so there is nothing to replace.
    core::clear_dirty(p);
    match text_field::from(p) {
        option::Option[text_field::TextField]::Some(f) => { let _f: text_field::TextField = f.set_secure(false); }
        option::Option[text_field::TextField]::None => { assert false; }
    }
    views::apply(0 as *u8, p);
    assert core::view_of(p) == v;
    return;
}

#[test]
fn a_text_field_reports_the_caret_it_actually_has() {
    // `cursor_position` and `selection_length` are declared two-way and were
    // answering the description. After a keystroke the caret is past the
    // character, and that is what the props have to say.
    backend::install();
    var n: core::Node = text_field::text_field(key: "caret", text: "");
    let p: *core::Node = #addr_of(n);
    let v: *u8 = views::create(0 as *u8, p);
    let w: ak::Window = window::make_shell_window(screen::Chrome::new(
        title: "caret", width: 300.0f64, height: 200.0f64));
    let host: ak::View = akx::new_flipped_view(rt::Rect { x: 0.0f64, y: 0.0f64, w: 300.0f64, h: 200.0f64 });
    host.add_subview(ak::View::from_raw(v));
    w.set_content_view(host);
    match focused_editor(w, v) {
        option::Option[ak::Text]::Some(ed) => {
            { rt::msg_void_id(ed.raw(), rt::sel(#str_ptr("keyDown:\0")),
                              fake_key_event(0 as u16, "a", 0 as u64)) };
            { rt::msg_void_id(ed.raw(), rt::sel(#str_ptr("keyDown:\0")),
                              fake_key_event(11 as u16, "b", 0 as u64)) };
        }
        option::Option[ak::Text]::None => { assert false; }
    }
    match text_field::from(p) {
        option::Option[text_field::TextField]::Some(f) => {
            assert f.text() == "ab";
            assert f.cursor_position() == (2 as i64);
            assert f.selection_length() == (0 as i64);
        }
        option::Option[text_field::TextField]::None => { assert false; }
    }
    w.close();
    views::view_release(v);
    return;
}

#[test]
fn typing_in_a_text_area_reaches_the_props() {
    // The editor half. Its notification is `textDidChange:` rather than
    // `controlTextDidChange:`, and its view is the NSTextView INSIDE the
    // scroll view the node is backed by — so this proves the delegate went on
    // the right object.
    backend::install();
    var n: core::Node = text_area::text_area(key: "area", text: "");
    let p: *core::Node = #addr_of(n);
    let v: *u8 = views::create(0 as *u8, p);
    assert v != (0 as *u8);
    let tv: *u8 = { rt::msg_id(v, rt::sel(#str_ptr("documentView\0"))) };
    assert tv != (0 as *u8);
    { rt::msg_void_id(tv, rt::sel(#str_ptr("insertText:\0")), bridge::nsstring("hi")) };
    match text_area::from(p) {
        option::Option[text_area::TextArea]::Some(a) => { assert a.text() == "hi"; }
        option::Option[text_area::TextArea]::None => { assert false; }
    }
    views::view_release(v);
    return;
}

#[test]
fn a_search_field_reports_what_was_typed_into_it() {
    backend::install();
    var n: core::Node = search_field::search_field(key: "find", text: "");
    let p: *core::Node = #addr_of(n);
    let v: *u8 = views::create(0 as *u8, p);
    let w: ak::Window = window::make_shell_window(screen::Chrome::new(
        title: "find", width: 300.0f64, height: 200.0f64));
    let host: ak::View = akx::new_flipped_view(rt::Rect { x: 0.0f64, y: 0.0f64, w: 300.0f64, h: 200.0f64 });
    host.add_subview(ak::View::from_raw(v));
    w.set_content_view(host);
    match focused_editor(w, v) {
        option::Option[ak::Text]::Some(ed) => {
            { rt::msg_void_id(ed.raw(), rt::sel(#str_ptr("keyDown:\0")),
                              fake_key_event(1 as u16, "s", 0 as u64)) };
        }
        option::Option[ak::Text]::None => { assert false; }
    }
    match search_field::from(p) {
        option::Option[search_field::SearchField]::Some(s) => { assert s.text() == "s"; }
        option::Option[search_field::SearchField]::None => { assert false; }
    }
    w.close();
    views::view_release(v);
    return;
}

#[test]
fn a_field_that_never_gained_a_handler_still_keeps_its_props_true() {
    // The negative that matters: the write-back is not conditional on anyone
    // listening. A field with no `on_text_changed` still has to answer `text()`
    // with what is on screen, or the fix would only work for apps that happen
    // to subscribe.
    backend::install();
    var n: core::Node = text_field::text_field(key: "quiet", text: "old");
    let p: *core::Node = #addr_of(n);
    let v: *u8 = views::create(0 as *u8, p);
    let w: ak::Window = window::make_shell_window(screen::Chrome::new(
        title: "quiet", width: 300.0f64, height: 200.0f64));
    let host: ak::View = akx::new_flipped_view(rt::Rect { x: 0.0f64, y: 0.0f64, w: 300.0f64, h: 200.0f64 });
    host.add_subview(ak::View::from_raw(v));
    w.set_content_view(host);
    match focused_editor(w, v) {
        option::Option[ak::Text]::Some(ed) => {
            { rt::msg_void_id(ed.raw(), rt::sel(#str_ptr("keyDown:\0")),
                              fake_key_event(2 as u16, "!", 0 as u64)) };
        }
        option::Option[ak::Text]::None => { assert false; }
    }
    match text_field::from(p) {
        option::Option[text_field::TextField]::Some(f) => { assert f.text() != "old"; }
        option::Option[text_field::TextField]::None => { assert false; }
    }
    w.close();
    views::view_release(v);
    return;
}

#[test]
fn a_text_area_submits_when_editing_ends_and_a_field_does_not() {
    // Enter inserts a newline in a multi-line editor, so `Editor.Completed` is
    // end-of-editing there and the control's action everywhere else. Wiring
    // both on a field would fire submit twice, which is why `did_end_imp`
    // gates on the kind — this is that gate.
    backend::install();
    SUBMITS = 0 as i64;
    var n: core::Node = text_area::text_area(key: "sub", text: "",
                                            on_submit: h_submitted());
    let p: *core::Node = #addr_of(n);
    let v: *u8 = views::create(0 as *u8, p);
    let tv: *u8 = { rt::msg_id(v, rt::sel(#str_ptr("documentView\0"))) };
    let w: ak::Window = window::make_shell_window(screen::Chrome::new(
        title: "sub", width: 300.0f64, height: 200.0f64));
    w.set_content_view(ak::View::from_raw(v));
    w.make_key_and_order_front(0 as *u8);
    assert w.make_first_responder(ak::View::from_raw(tv).as_responder());
    // Resigning first responder is what ends an editor's editing session.
    assert w.make_first_responder(w.as_responder());
    assert SUBMITS == (1 as i64);
    w.close();
    views::view_release(v);
    return;
}

// ---- the InputView band -------------------------------------------------------
// One body in `text_input` serves all three text kinds, so these assert the
// band once per verb and pick whichever kind exercises it most directly. What
// they do NOT do is assert props: every one reads back off the native control,
// because a props round-trip would pass with the band deleted.

fn field_view(n: *core::Node) -> ak::TextField {
    return ak::TextField::from_raw(views::create(0 as *u8, n));
}

#[test]
fn character_spacing_becomes_a_kern_attribute() {
    // `character_spacing` has no plain-string equivalent anywhere in AppKit —
    // it is a kern attribute, so a field that asks for it must be written as an
    // attributed string rather than a plain one.
    backend::install();
    var n: core::Node = text_field::text_field(key: "kern", text: "ada", character_spacing: 3.0f64);
    let f: ak::TextField = field_view(#addr_of(n));
    let a: ak::AttributedString = f.as_control().attributed_string_value();
    match a.attribute_at_index("NSKern", 0 as u64, 0 as *u8,
                               rt::Range { location: 0 as u64, length: 3 as u64 }) {
        option::Option[*u8]::Some(v) => {
            assert { rt::msg_f64(v, rt::sel(#str_ptr("doubleValue\0"))) } == 3.0f64;
        }
        option::Option[*u8]::None => { assert false; }
    }
    views::view_release(f.as_view().raw());
    return;
}

#[test]
fn a_field_with_no_kern_stays_on_the_plain_string_path() {
    // The other half of the gate, and the one that protects editing: an
    // attributed write disturbs the field editor, so a control that asked for
    // none of the rich verbs must not take that path.
    backend::install();
    var n: core::Node = text_field::text_field(key: "plain", text: "ada");
    let f: ak::TextField = field_view(#addr_of(n));
    let a: ak::AttributedString = f.as_control().attributed_string_value();
    match a.attribute_at_index("NSKern", 0 as u64, 0 as *u8,
                               rt::Range { location: 0 as u64, length: 3 as u64 }) {
        option::Option[*u8]::Some(_v) => { assert false; }
        option::Option[*u8]::None => { }
    }
    views::view_release(f.as_view().raw());
    return;
}

#[test]
fn italic_is_a_trait_conversion_not_a_weight() {
    backend::install();
    var n: core::Node = text_field::text_field(key: "it", text: "x", italic: true, font_size: 13.0f64);
    let f: ak::TextField = field_view(#addr_of(n));
    match f.as_control().font() {
        option::Option[ak::Font]::Some(font) => {
            // NSItalicFontMask = 1.
            assert ({ ak::FontManager::shared_font_manager().traits_of_font(font) } & (1 as u64)) != (0 as u64);
        }
        option::Option[ak::Font]::None => { assert false; }
    }
    views::view_release(f.as_view().raw());
    return;
}

#[test]
fn text_transform_changes_what_is_SHOWN_and_not_what_is_READ() {
    // The rule the transform helper's comment states: a transform is a
    // rendering choice, so `text()` still answers what the application set.
    backend::install();
    var n: core::Node = text_field::text_field(key: "up", text: "ada",
                                              text_transform: vocab::TextTransform::Uppercase);
    let p: *core::Node = #addr_of(n);
    let f: ak::TextField = field_view(p);
    assert f.as_control().string_value().view() == "ADA";
    match text_field::from(p) {
        option::Option[text_field::TextField]::Some(c) => { assert c.text() == "ada"; }
        option::Option[text_field::TextField]::None => { assert false; }
    }
    views::view_release(f.as_view().raw());
    return;
}

#[test]
fn max_length_truncates_what_was_typed_not_what_was_set() {
    // Enforced in the change hook, because neither a formatter nor a delegate
    // method covers both kinds. The assertion that matters is that the props
    // and the control agree afterwards — a truncation the app cannot see is
    // the same silent-wrong-answer bug the write-back exists to close.
    backend::install();
    var n: core::Node = text_field::text_field(key: "cap", text: "", max_length: 2 as i64);
    let p: *core::Node = #addr_of(n);
    let v: *u8 = views::create(0 as *u8, p);
    let w: ak::Window = window::make_shell_window(screen::Chrome::new(
        title: "cap", width: 300.0f64, height: 200.0f64));
    let host: ak::View = akx::new_flipped_view(rt::Rect { x: 0.0f64, y: 0.0f64, w: 300.0f64, h: 200.0f64 });
    host.add_subview(ak::View::from_raw(v));
    w.set_content_view(host);
    match focused_editor(w, v) {
        option::Option[ak::Text]::Some(ed) => {
            { rt::msg_void_id(ed.raw(), rt::sel(#str_ptr("keyDown:\0")), fake_key_event(0 as u16, "a", 0 as u64)) };
            { rt::msg_void_id(ed.raw(), rt::sel(#str_ptr("keyDown:\0")), fake_key_event(11 as u16, "b", 0 as u64)) };
            { rt::msg_void_id(ed.raw(), rt::sel(#str_ptr("keyDown:\0")), fake_key_event(8 as u16, "c", 0 as u64)) };
        }
        option::Option[ak::Text]::None => { assert false; }
    }
    assert ak::TextField::from_raw(v).as_control().string_value().view() == "ab";
    match text_field::from(p) {
        option::Option[text_field::TextField]::Some(c) => { assert c.text() == "ab"; }
        option::Option[text_field::TextField]::None => { assert false; }
    }
    w.close();
    views::view_release(v);
    return;
}

#[test]
fn any_node_can_be_rounded_not_just_the_four_controls_that_carried_it() {
    app::reset_default_for_tests();
    // A card is a CONTAINER, and a container could not be rounded: corner_radius
    // rode per-control props (box, button, icon_button, bordered) and nothing
    // else could ask for it. Now it is on the shared band.
    var n: core::Node = core::column(core::Builder::new(), key: "card");
    n.set_corner_radius(vocab::Corners::all(8.0f64));
    let p: *core::Node = #addr_of(n);
    let v: *u8 = views::create(0 as *u8, p);
    assert v != (0 as *u8);
    let view: ak::View = ak::View::from_raw(v);
    assert view.wants_layer();
    assert view.layer().corner_radius() > 7.9f64;
    // Rounded and NOT clipped is a rectangle with rounded paint on it, which is
    // not what anyone means by rounded.
    assert view.layer().masks_to_bounds();

    // Zero clears both — and asks for no layer when there is none to clear.
    var flat: core::Node = core::column(core::Builder::new(), key: "flat");
    let fp: *core::Node = #addr_of(flat);
    let fv: *u8 = views::create(0 as *u8, fp);
    assert fv != (0 as *u8);
    assert ak::View::from_raw(fv).wants_layer() == false;

    views::view_release(v);
    views::view_release(fv);
    app::reset_default_for_tests();
    return;
}

#[test]
fn an_empty_placeholder_is_nil_not_an_empty_string() {
    app::reset_default_for_tests();
    // They are not the same thing to AppKit. An empty `placeholderString` is
    // still A PLACEHOLDER, and a search field reserves room for one: measured,
    // `searchButtonRectForBounds:` answers y=13 with `@""` and y=8 with nil, so
    // the magnifier sat off-centre while the field was empty and dropped into
    // place on the first keystroke. Every field defaults `placeholder` to "",
    // so this reached all of them — it is only VISIBLE on the one control that
    // draws something else beside its text.
    var n: core::Node = search_field::search_field("", key: "sf");
    let p: *core::Node = #addr_of(n);
    let v: *u8 = views::create(0 as *u8, p);
    assert v != (0 as *u8);
    assert { rt::msg_id(v, rt::sel(#str_ptr("placeholderString\0"))) } == (0 as *u8);
    assert { rt::msg_id(v, rt::sel(#str_ptr("placeholderAttributedString\0"))) } == (0 as *u8);

    // The magnifier does not move when the text arrives.
    let cell: *u8 = { rt::msg_id(v, rt::sel(#str_ptr("cell\0"))) };
    let b: rt::Rect = rt::Rect { x: 0.0f64, y: 0.0f64, w: 240.0f64, h: 24.0f64 };
    let empty: rt::Rect = { rt::msg_rect_rect(cell, rt::sel(#str_ptr("searchButtonRectForBounds:\0")), b) };
    { rt::msg_void_id(v, rt::sel(#str_ptr("setStringValue:\0")), bridge::nsstring("abc")) };
    let typed: rt::Rect = { rt::msg_rect_rect(cell, rt::sel(#str_ptr("searchButtonRectForBounds:\0")), b) };
    assert empty.y == typed.y;
    assert empty.x == typed.x;

    // A real placeholder is still set, and still moves nothing.
    var w: core::Node = search_field::search_field("", key: "sf2", placeholder: "Search");
    let wp: *core::Node = #addr_of(w);
    let wv: *u8 = views::create(0 as *u8, wp);
    assert { rt::msg_id(wv, rt::sel(#str_ptr("placeholderString\0"))) } != (0 as *u8);

    views::view_release(v);
    views::view_release(wv);
    app::reset_default_for_tests();
    return;
}

#[test]
fn a_placeholder_colour_makes_the_placeholder_attributed() {
    // `placeholderString` is plain and always draws in the system's colour, so
    // a coloured placeholder is the attributed one or it is nothing.
    backend::install();
    var n: core::Node = text_field::text_field("", key: "ph", placeholder: "who?",
                                              placeholder_color: vocab::Color::rgba(1.0f64, 0.0f64, 0.0f64));
    let f: ak::TextField = field_view(#addr_of(n));
    let a: *u8 = { rt::msg_id(f.raw(), rt::sel(#str_ptr("placeholderAttributedString\0"))) };
    assert a != (0 as *u8);
    assert { rt::msg_u64(a, rt::sel(#str_ptr("length\0"))) } == (4 as u64);
    views::view_release(f.as_view().raw());
    return;
}

#[test]
fn the_editor_band_styles_existing_text_and_what_is_typed_next() {
    // An editor's attributes have to go on BOTH the storage and the typing
    // attributes: the storage alone loses the style on the next keypress, and
    // typingAttributes alone leaves what is already there unstyled.
    backend::install();
    var n: core::Node = text_area::text_area(key: "st", text: "hello", character_spacing: 2.0f64);
    let v: *u8 = views::create(0 as *u8, #addr_of(n));
    let tv: *u8 = { rt::msg_id(v, rt::sel(#str_ptr("documentView\0"))) };
    let storage: *u8 = { rt::msg_id(tv, rt::sel(#str_ptr("textStorage\0"))) };
    let a: ak::AttributedString = ak::AttributedString::from_raw(storage);
    match a.attribute_at_index("NSKern", 0 as u64, 0 as *u8,
                               rt::Range { location: 0 as u64, length: 5 as u64 }) {
        option::Option[*u8]::Some(k) => { assert { rt::msg_f64(k, rt::sel(#str_ptr("doubleValue\0"))) } == 2.0f64; }
        option::Option[*u8]::None => { assert false; }
    }
    let typing: *u8 = { rt::msg_id(tv, rt::sel(#str_ptr("typingAttributes\0"))) };
    assert { rt::msg_id_id(typing, rt::sel(#str_ptr("objectForKey:\0")), bridge::nsstring("NSKern")) } != (0 as *u8);
    views::view_release(v);
    return;
}

// The colour a run actually landed with, read back off the storage.
fn run_color_at(tv: *u8, at: u64) -> *u8 {
    let storage: *u8 = { rt::msg_id(tv, rt::sel(#str_ptr("textStorage\0"))) };
    let a: ak::AttributedString = ak::AttributedString::from_raw(storage);
    let len: u64 = { rt::msg_u64(storage, rt::sel(#str_ptr("length\0"))) };
    return match a.attribute_at_index("NSColor", at, 0 as *u8,
                                      rt::Range { location: 0 as u64, length: len }) {
        option::Option[*u8]::Some(c) => c,
        option::Option[*u8]::None => 0 as *u8,
    };
}

#[test]
fn style_runs_colour_ranges_of_the_text_that_is_already_there() {
    // Syntax highlighting, said portably. `formatted_text` replaces the
    // content, which an editor cannot do — the text is the user's, and
    // re-setting it moves the caret and breaks undo. A StyleRun names a RANGE
    // instead, which is the shape a lexer's answer has.
    backend::install();
    var n: core::Node = text_area::text_area(key: "sr", text: "let x = 1;");
    let p: *core::Node = #addr_of(n);
    let v: *u8 = views::create(0 as *u8, p);
    core::set_view(p, v, views::view_release);
    let tv: *u8 = { rt::msg_id(v, rt::sel(#str_ptr("documentView\0"))) };

    var runs: vocab::StyleRuns = vocab::StyleRuns::new();
    let _a: status::Status = runs.add_color(0 as usize, 3 as usize,
                                            vocab::Color::rgba(1.0f64, 0.0f64, 0.0f64));
    let _b: status::Status = runs.add_color(8 as usize, 1 as usize,
                                            vocab::Color::rgba(0.0f64, 0.0f64, 1.0f64));
    match text_area::find("sr", within: p) {
        option::Option[text_area::TextArea]::Some(h) => {
            let _s: text_area::TextArea = h.set_style_runs(runs);
        }
        option::Option[text_area::TextArea]::None => { assert false; }
    }
    views::apply(0 as *u8, p);

    // Three distinct runs: the keyword, the default band between them, the
    // literal. Distinct POINTERS are not enough — two catalog colours sharing
    // a name are `isEqual:`, and an attributed string coalesces equal runs,
    // which is what once drew ten syntax colours as one.
    let kw: *u8 = run_color_at(tv, 0 as u64);
    let mid: *u8 = run_color_at(tv, 5 as u64);
    let lit: *u8 = run_color_at(tv, 8 as u64);
    assert kw != (0 as *u8);
    assert lit != (0 as *u8);
    assert { rt::msg_i8_id(kw, rt::sel(#str_ptr("isEqual:\0")), lit) } == (0 as i8);
    assert { rt::msg_i8_id(kw, rt::sel(#str_ptr("isEqual:\0")), mid) } == (0 as i8);

    // And clearing them puts the whole file back to one colour.
    match text_area::find("sr", within: p) {
        option::Option[text_area::TextArea]::Some(h) => {
            let _c: text_area::TextArea = h.clear_style_runs();
        }
        option::Option[text_area::TextArea]::None => { assert false; }
    }
    views::apply(0 as *u8, p);
    let after: *u8 = run_color_at(tv, 0 as u64);
    let after_mid: *u8 = run_color_at(tv, 5 as u64);
    if after != (0 as *u8) && after_mid != (0 as *u8) {
        assert { rt::msg_i8_id(after, rt::sel(#str_ptr("isEqual:\0")), after_mid) } != (0 as i8);
    }
    return;
}

#[test]
fn a_style_run_is_counted_in_BYTES_and_lands_on_the_characters_it_names() {
    // The offsets are BYTES of the control's own text; an NSTextStorage indexes
    // in UTF-16 units. They disagree on exactly the characters a code editor is
    // full of — one emoji shifts every run after it, and nothing downstream
    // would say so.
    backend::install();
    // "🙂" is 4 bytes and TWO utf-16 units; "ab" follows it.
    var n: core::Node = text_area::text_area(key: "sr2", text: "🙂ab");
    let p: *core::Node = #addr_of(n);
    let v: *u8 = views::create(0 as *u8, p);
    core::set_view(p, v, views::view_release);
    let tv: *u8 = { rt::msg_id(v, rt::sel(#str_ptr("documentView\0"))) };
    var runs: vocab::StyleRuns = vocab::StyleRuns::new();
    // Byte 4..5 is "a" — utf-16 index 2.
    let _a: status::Status = runs.add_color(4 as usize, 1 as usize,
                                            vocab::Color::rgba(1.0f64, 0.0f64, 0.0f64));
    match text_area::find("sr2", within: p) {
        option::Option[text_area::TextArea]::Some(h) => {
            let _s: text_area::TextArea = h.set_style_runs(runs);
        }
        option::Option[text_area::TextArea]::None => { assert false; }
    }
    views::apply(0 as *u8, p);
    let emoji: *u8 = run_color_at(tv, 0 as u64);
    let a_col: *u8 = run_color_at(tv, 2 as u64);
    let b_col: *u8 = run_color_at(tv, 3 as u64);
    assert a_col != (0 as *u8);
    // The emoji and the "b" either side kept the band's colour; only "a" moved.
    assert { rt::msg_i8_id(a_col, rt::sel(#str_ptr("isEqual:\0")), emoji) } == (0 as i8);
    assert { rt::msg_i8_id(a_col, rt::sel(#str_ptr("isEqual:\0")), b_col) } == (0 as i8);
    return;
}

// NEGATIVE: a lexer that ran one keystroke behind names rows past the end. That
// is stale, not wrong — the next write fixes it — so it clips rather than traps.
#[test]
fn style_runs_past_the_end_of_the_text_are_clipped() {
    backend::install();
    var n: core::Node = text_area::text_area(key: "sr3", text: "abc");
    let p: *core::Node = #addr_of(n);
    let v: *u8 = views::create(0 as *u8, p);
    core::set_view(p, v, views::view_release);
    var runs: vocab::StyleRuns = vocab::StyleRuns::new();
    let _a: status::Status = runs.add_color(1 as usize, 99 as usize,
                                            vocab::Color::rgba(1.0f64, 0.0f64, 0.0f64));
    let _b: status::Status = runs.add_color(50 as usize, 2 as usize,
                                            vocab::Color::rgba(0.0f64, 1.0f64, 0.0f64));
    match text_area::find("sr3", within: p) {
        option::Option[text_area::TextArea]::Some(h) => {
            let _s: text_area::TextArea = h.set_style_runs(runs);
        }
        option::Option[text_area::TextArea]::None => { assert false; }
    }
    views::apply(0 as *u8, p);
    let tv: *u8 = { rt::msg_id(v, rt::sel(#str_ptr("documentView\0"))) };
    assert run_color_at(tv, 2 as u64) != (0 as *u8);
    return;
}

static SEL_FIRED: i64 = 0 as i64;
static SEL_AT: i64 = -1 as i64;

fn on_caret_moved(sender: *u8, ctx: *u8) {
    SEL_FIRED = SEL_FIRED + (1 as i64);
    let n: *core::Node = ctx as *core::Node;
    if n == (0 as *core::Node) { return; }
    match text_area::find("sel", within: n) {
        option::Option[text_area::TextArea]::Some(h) => { SEL_AT = h.cursor_position(); }
        option::Option[text_area::TextArea]::None => { }
    }
    return;
}

#[test]
fn the_caret_moving_is_an_event_rather_than_something_to_poll() {
    // `on_text_changed` fires for text and nothing fired for the SELECTION, so
    // a status line showing `Ln 4, Col 9` was a 4x/sec poll of a control that
    // knows the answer exactly.
    backend::install();
    SEL_FIRED = 0 as i64;
    SEL_AT = -1 as i64;
    var n: core::Node = text_area::text_area(key: "sel", text: "hello world");
    let p: *core::Node = #addr_of(n);
    let v: *u8 = views::create(0 as *u8, p);
    core::set_view(p, v, views::view_release);
    match text_area::find("sel", within: p) {
        option::Option[text_area::TextArea]::Some(h) => {
            let _e: text_area::TextArea = h.set_on_selection_changed(on_caret_moved, p as *u8);
        }
        option::Option[text_area::TextArea]::None => { assert false; }
    }
    let tv: *u8 = { rt::msg_id(v, rt::sel(#str_ptr("documentView\0"))) };
    let ed: ak::Text = ak::Text::from_raw(tv);
    ed.set_selected_range(rt::Range { location: 6 as u64, length: 0 as u64 });
    assert SEL_FIRED > (0 as i64);
    // ...and the handler reads where the caret IS, which is the whole point.
    assert SEL_AT == (6 as i64);
    return;
}

#[test]
fn a_text_areas_editor_can_always_grow_past_its_box() {
    // BOTH kinds are vertically resizable, and that is not what `auto_size`
    // says. A text area is a scroll view over a document view, so an editor
    // that may not exceed its own frame is one that cannot scroll: tying
    // `verticallyResizable` to `auto_size` left every fixed-size box — the new
    // project description among them — unable to hold more text than fitted in
    // it, with the overflow neither visible nor reachable.
    //
    // What `auto_size` says is whether the editor FITS ITSELF to its text. That
    // is `sizeToFit`, and it is what makes a composer grow as it is typed into.
    // The box stays the scroll view's frame either way, and flex owns that.
    backend::install();
    var grows: core::Node = text_area::text_area(key: "g", text: "one\ntwo\nthree",
                                                 auto_size: vocab::AutoSize::TextChanges);
    let gv: *u8 = views::create(0 as *u8, #addr_of(grows));
    match controls::text_area_editor(gv) {
        option::Option[ak::TextView]::Some(tv) => {
            assert tv.as_text().is_vertically_resizable();
            assert tv.as_text().max_size().h > 1000.0f64;
        }
        option::Option[ak::TextView]::None => { assert false; }
    }
    var fixed: core::Node = text_area::text_area(key: "f", text: "one\ntwo\nthree");
    let fv: *u8 = views::create(0 as *u8, #addr_of(fixed));
    match controls::text_area_editor(fv) {
        option::Option[ak::TextView]::Some(tv) => {
            // The one that changed: a fixed-size area is resizable too, and has
            // the same ceiling, so its text can run past the box and be
            // scrolled to. Its HEIGHT is the layout pass's answer
            // (`geometry::size_text_document`) rather than its text's, which is
            // the whole of the difference `auto_size` names.
            assert tv.as_text().is_vertically_resizable();
            assert tv.as_text().max_size().h > 1000.0f64;
        }
        option::Option[ak::TextView]::None => { assert false; }
    }
    views::view_release(gv);
    views::view_release(fv);
    return;
}

#[test]
fn a_search_field_honours_the_band_a_text_field_does() {
    // NSSearchField is an NSTextField subclass and shares the band; the point
    // of the shared body is that it did NOT have to be implemented twice.
    backend::install();
    var n: core::Node = search_field::search_field(key: "sb", text: "q", read_only: true,
                                                   text_color: vocab::Color::rgba(1.0f64, 0.0f64, 0.0f64));
    let f: ak::TextField = field_view(#addr_of(n));
    assert f.is_editable() == false;
    assert f.as_control().string_value().view() == "q";
    views::view_release(f.as_view().raw());
    return;
}

#[test]
fn a_write_to_cursor_position_moves_the_caret() {
    backend::install();
    var n: core::Node = text_area::text_area(key: "car", text: "hello",
                                             cursor_position: 3 as i64, selection_length: 2 as i64);
    let v: *u8 = views::create(0 as *u8, #addr_of(n));
    match controls::text_area_editor(v) {
        option::Option[ak::TextView]::Some(tv) => {
            let r: rt::Range = tv.as_text().selected_range();
            assert { r.location } == (3 as u64);
            assert { r.length } == (2 as u64);
        }
        option::Option[ak::TextView]::None => { assert false; }
    }
    views::view_release(v);
    return;
}

#[test]
fn a_selection_past_the_end_is_clamped_not_a_crash() {
    // The negative: `cursor_position` is an i64 the application controls and
    // NSText raises on an out-of-range selection.
    backend::install();
    var n: core::Node = text_area::text_area(key: "clamp", text: "hi",
                                             cursor_position: 99 as i64, selection_length: 99 as i64);
    let v: *u8 = views::create(0 as *u8, #addr_of(n));
    match controls::text_area_editor(v) {
        option::Option[ak::TextView]::Some(tv) => {
            let r: rt::Range = tv.as_text().selected_range();
            assert { r.location } == (2 as u64);
            assert { r.length } == (0 as u64);
        }
        option::Option[ak::TextView]::None => { assert false; }
    }
    views::view_release(v);
    return;
}

// ---- the list's own events and appearance -------------------------------------

static PICKED: i64 = 0 as i64;
fn on_picked(sender: *u8, ctx: *u8) { PICKED = PICKED + (1 as i64); return; }
fn h_picked() -> fn(*u8, *u8) { let f: fn(*u8, *u8) = on_picked; return f; }

#[test]
fn selecting_a_row_reaches_the_handler() {
    // Through the REAL path: `selectRowIndexes:` is what a click ends in, and
    // NSTableView posts the selection notification from it. Calling the imp by
    // hand would prove it compiles and nothing about whether AppKit reaches it.
    backend::install();
    PICKED = 0 as i64;
    var l: core::Node = list::list(key: "sel", on_item_selected: h_picked(),
                                   selection_mode: vocab::SelectionMode::Single);
    let lp: *core::Node = #addr_of(l);
    match list::find("sel", within: lp) {
        option::Option[list::List]::Some(h) => {
            let h2: list::List = h.set_row(t_row, ctx: 0 as *u8);
            let _h3: list::List = h2.set_count(3 as usize);
        }
        option::Option[list::List]::None => { assert false; }
    }
    let v: *u8 = views::create(0 as *u8, lp);
    core::set_view(lp, v, views::view_release);
    let tv: *u8 = recycler::table_of(v);
    assert tv != (0 as *u8);
    let idx: *u8 = { rt::msg_id_u64(rt::get_class(#str_ptr("NSIndexSet\0")),
                                    rt::sel(#str_ptr("indexSetWithIndex:\0")), 1 as u64) };
    { rt::msg_void_id_i8(tv, rt::sel(#str_ptr("selectRowIndexes:byExtendingSelection:\0")),
                         idx, false as i8) };
    assert PICKED == (1 as i64);
    return;
}

#[test]
fn a_list_that_selects_nothing_still_draws_no_highlight() {
    // `selection_mode: None` is the generated default now that the enum zeros
    // follow the ledger rather than the alphabet — so this also pins that default.
    backend::install();
    var l: core::Node = list::list(key: "nosel");
    let lp: *core::Node = #addr_of(l);
    let v: *u8 = views::create(0 as *u8, lp);
    core::set_view(lp, v, views::view_release);
    core::clear_dirty(lp);
    core::touch(lp, list::P_SELECTION_MODE);
    views::apply(0 as *u8, lp);
    let tv: *u8 = recycler::table_of(v);
    // NSTableViewSelectionHighlightStyleNone = -1.
    assert { rt::msg_i64(tv, rt::sel(#str_ptr("selectionHighlightStyle\0"))) } == (0 as i64 - (1 as i64));
    assert { rt::msg_i8(tv, rt::sel(#str_ptr("allowsMultipleSelection\0"))) } == (0 as i8);
    return;
}

#[test]
fn a_multi_select_list_says_so_to_the_table() {
    backend::install();
    var l: core::Node = list::list(key: "multi", selection_mode: vocab::SelectionMode::Multiple);
    let lp: *core::Node = #addr_of(l);
    let v: *u8 = views::create(0 as *u8, lp);
    core::set_view(lp, v, views::view_release);
    core::clear_dirty(lp);
    core::touch(lp, list::P_SELECTION_MODE);
    views::apply(0 as *u8, lp);
    let tv: *u8 = recycler::table_of(v);
    assert { rt::msg_i8(tv, rt::sel(#str_ptr("allowsMultipleSelection\0"))) } != (0 as i8);
    // The TABLE's style is untouched: it governs selection BEHAVIOUR too, and
    // selection is the only way a table row is clicked. What a facet row does
    // not want — the platform DRAWING that selection — is suppressed on the
    // row view instead. See `a_row_view_never_draws_the_platforms_selection`.
    assert { rt::msg_i64(tv, rt::sel(#str_ptr("selectionHighlightStyle\0"))) } == (1 as i64);
    return;
}

#[test]
fn a_row_view_never_draws_the_platforms_selection() {
    backend::install();
    // A facet row draws itself, so the platform must not draw a selection
    // behind it: a full-row blue flash under an inset card, in the platform's
    // colours, one layer above the card's own. AppKit hands us each row view as
    // it makes it, and the row view carries the same property for its OWN
    // drawing — which is the half we want gone, without touching whether the
    // row can be picked.
    var l: core::Node = rl_list(5 as usize, 30 as i64);
    let lp: *core::Node = #addr_of(l);
    match list::find("rl", within: lp) {
        option::Option[list::List]::Some(x) => {
            let _s: list::List = x.set_selection_mode(vocab::SelectionMode::Single);
        }
        option::Option[list::List]::None => { assert false; }
    }
    let v: *u8 = views::create(0 as *u8, lp);
    core::set_view(lp, v, views::view_release);
    core::clear_dirty(lp);
    core::touch(lp, list::P_SELECTION_MODE);
    views::apply(0 as *u8, lp);
    let tv: *u8 = recycler::table_of(v);
    // The table still says it selects — the click depends on that.
    assert { rt::msg_i64(tv, rt::sel(#str_ptr("selectionHighlightStyle\0"))) } == (1 as i64);

    // The row view AppKit just made draws nothing.
    // NSTableViewSelectionHighlightStyleNone = -1.
    let rv: *u8 = { rt::alloc_init(#str_ptr("NSTableRowView\0")) };
    assert rv != (0 as *u8);
    recycler::row_added(v, rv, 0 as i64);
    assert { rt::msg_i64(rv, rt::sel(#str_ptr("selectionHighlightStyle\0"))) }
        == (0 as i64 - (1 as i64));
    rt::release(rv);
    return;
}

#[test]
fn a_separator_none_takes_the_grid_line_away() {
    backend::install();
    var l: core::Node = list::list(key: "nosep", separator: vocab::Separator::None);
    let lp: *core::Node = #addr_of(l);
    let v: *u8 = views::create(0 as *u8, lp);
    core::set_view(lp, v, views::view_release);
    core::clear_dirty(lp);
    core::touch(lp, list::P_SEPARATOR);
    views::apply(0 as *u8, lp);
    let tv: *u8 = recycler::table_of(v);
    assert { rt::msg_u64(tv, rt::sel(#str_ptr("gridStyleMask\0"))) } == (0 as u64);
    return;
}

#[test]
fn the_appearance_band_never_runs_on_the_create_pass() {
    // The deviation this file records, asserted rather than described: on the
    // create pass the appearance verbs are SKIPPED, because any of them makes
    // NSTableView validate itself and validating asks the data source for rows.
    // A list that built rows at create would not be a recycling list.
    backend::install();
    ROWS_BUILT = 0;
    var l: core::Node = list::list(key: "cre", separator: vocab::Separator::None,
                                   selection_mode: vocab::SelectionMode::Multiple);
    let lp: *core::Node = #addr_of(l);
    match list::find("cre", within: lp) {
        option::Option[list::List]::Some(h) => {
            let h2: list::List = h.set_row(t_row, ctx: 0 as *u8);
            let _h3: list::List = h2.set_count(50 as usize);
        }
        option::Option[list::List]::None => { assert false; }
    }
    let v: *u8 = views::create(0 as *u8, lp);
    assert ROWS_BUILT == 0;
    let tv: *u8 = recycler::table_of(v);
    // AppKit's own default survives the first frame, which is the cost.
    assert { rt::msg_i8(tv, rt::sel(#str_ptr("allowsMultipleSelection\0"))) } == (0 as i8);
    // And the next apply is what lands it.
    core::set_view(lp, v, views::view_release);
    core::clear_dirty(lp);
    core::touch(lp, list::P_SELECTION_MODE);
    views::apply(0 as *u8, lp);
    assert { rt::msg_i8(tv, rt::sel(#str_ptr("allowsMultipleSelection\0"))) } != (0 as i8);
    return;
}

static SCROLLS: i64 = 0 as i64;
fn on_scrolled(sender: *u8, ctx: *u8) { SCROLLS = SCROLLS + (1 as i64); return; }
fn h_scrolled() -> fn(*u8, *u8) { let f: fn(*u8, *u8) = on_scrolled; return f; }

#[test]
fn scrolling_reaches_the_handler_however_it_was_caused() {
    // Through the clip view's BOUNDS, not `scrollWheel:` — which is the whole
    // design: this scroll comes from `scrollToPoint:`, and a wheel override
    // would not have seen it. Neither would it see a scroller drag, a
    // page-down, or an accessibility client.
    backend::install();
    SCROLLS = 0 as i64;
    var s: core::Node = scroll::scroll(key: "sc", observe_scrolled: h_scrolled());
    let p: *core::Node = #addr_of(s);
    let v: *u8 = views::create(0 as *u8, p);
    assert v != (0 as *u8);
    core::set_view(p, v, views::view_release);
    let clip: *u8 = { rt::msg_id(v, rt::sel(#str_ptr("contentView\0"))) };
    assert clip != (0 as *u8);
    { msg_void_point(clip, rt::sel(#str_ptr("scrollToPoint:\0")),
                         rt::Point { x: 0.0f64, y: 40.0f64 }) };
    assert SCROLLS > (0 as i64);
    return;
}

// iris gap "a scroll that cannot scroll an axis still eats that axis":
// hiding a scroller does not decline the gesture. An
// automatic-elasticity NSScrollView claims the wheel on an axis it cannot
// scroll — rubber-banding against nothing instead of passing it to an
// enclosing scroll view — so iris's board (vertical lanes inside a horizontal
// strip) would not scroll sideways with the pointer over a lane.
// A view can be subclassed TWICE — once by its kind's body (compose, for
// vertical alignment) and once by arming (input) — and the second swap makes
// the first one's "call super" wrong if it is written as one hop up from the
// object's class: that hop lands on the class carrying our OWN override.
//
// `textContainerOrigin` is asked during layout, so the recursion was a stack
// overflow while typing, and an aligned text area inside a scroll never even
// appeared — it blew its stack being measured. The assertion here is that the
// call RETURNS: if the walk regresses, this test dies with the suite.
// The user's report: a text area's text came out BLACK where the app asked
// for white, and keys beeped instead of typing. Black text and no focus are
// the same symptom read twice — both are what you get when the editor band
// never reaches the NSTextView inside the scroll view. This asks the platform
// what it actually got.
#[test]
fn a_text_area_receives_its_text_colour() {
    backend::install();
    var n: core::Node = text_area::text_area(text: "hello", key: "ta:colour",
                                             text_color: vocab::Color::rgba(1.0f64, 1.0f64, 1.0f64, 1.0f64))
        .height(60.0f64);
    let p: *core::Node = #addr_of(n);
    let v: *u8 = views::create(0 as *u8, p);
    assert v != (0 as *u8);
    let doc: *u8 = { rt::msg_id(v, rt::sel(#str_ptr("documentView\0"))) };
    assert doc != (0 as *u8);
    // NSTextView.textColor — white is what was asked for.
    let c: *u8 = { rt::msg_id(doc, rt::sel(#str_ptr("textColor\0"))) };
    assert c != (0 as *u8);
    let r: f64 = { rt::msg_f64(c, rt::sel(#str_ptr("redComponent\0"))) };
    let g: f64 = { rt::msg_f64(c, rt::sel(#str_ptr("greenComponent\0"))) };
    let b: f64 = { rt::msg_f64(c, rt::sel(#str_ptr("blueComponent\0"))) };
    assert r > 0.9f64;
    assert g > 0.9f64;
    assert b > 0.9f64;
    // And it must be editable, or every key is a beep.
    assert { rt::msg_i8(doc, rt::sel(#str_ptr("isEditable\0"))) } != (0 as i8);
    views::view_release(v);
    return;
}

// THE SAME QUESTION WITH NO COLOUR NAMED, which is the ordinary case and the one
// that was broken. `ui::text_area("...", key: ...)` names no colour, and the
// gallery's does not.
//
// `rich_attributes` omits the colour key when none is set — correct for a label,
// which is not replacing anything — but the editor band hands that dict to
// `setTypingAttributes:` and `setAttributes:range:` over the WHOLE storage. So
// omitting did not mean "leave it alone", it meant "strip the colour off this
// text". Measured on a dark appearance: `textColor` came back nil and the first
// character carried no NSColor at all, so the text system drew flat black on a
// 30,30,30 background — reported as "the text area shows in black", and
// unreadable rather than merely wrong.
//
// Asserted as "has a colour at all", not as a specific value: the answer is the
// platform's `labelColor`, which is white-ish on a dark appearance and black on
// a light one, and pinning either would make this test a thing that fails when
// the CI machine's appearance changes. Nil is the bug; a colour is the fix.
#[test]
fn a_text_area_with_no_colour_named_still_gets_one() {
    backend::install();
    var n: core::Node = text_area::text_area(text: "hello", key: "ta:nocolour")
        .height(60.0f64);
    let p: *core::Node = #addr_of(n);
    let v: *u8 = views::create(0 as *u8, p);
    assert v != (0 as *u8);
    let doc: *u8 = { rt::msg_id(v, rt::sel(#str_ptr("documentView\0"))) };
    assert doc != (0 as *u8);
    // NIL HERE IS THE BUG. Not "some default the text view kept" — there was
    // none, which is exactly why the fallback reached black.
    assert { rt::msg_id(doc, rt::sel(#str_ptr("textColor\0"))) } != (0 as *u8);
    // And the text itself carries it, which is the half a `textColor` read alone
    // would not have caught: the storage is what the layout manager draws from.
    let ts: *u8 = { rt::msg_id(doc, rt::sel(#str_ptr("textStorage\0"))) };
    assert ts != (0 as *u8);
    assert { rt::msg_u64(ts, rt::sel(#str_ptr("length\0"))) } > (0 as u64);
    let attrs: *u8 = { rt::msg_id_u64_id(ts, rt::sel(#str_ptr("attributesAtIndex:effectiveRange:\0")),
                                         0 as u64, 0 as *u8) };
    assert attrs != (0 as *u8);
    assert { rt::msg_id_id(attrs, rt::sel(#str_ptr("objectForKey:\0")),
                           bridge::nsstring("NSColor")) } != (0 as *u8);
    views::view_release(v);
    return;
}

// The same question with the nesting iris actually has: the text area is the
// content of a vertical scroll (the card sheet's prose column, new project's
// form). A text area is itself an NSScrollView, so this is a scroll inside a
// scroll — the only structural difference between the areas that work and the
// ones that do not. Mounted, because a subtree's views exist only once the
// tree is mounted.
#[test]
fn a_text_area_inside_a_scroll_still_receives_its_band() {
    backend::install();
    var area: core::Node = text_area::text_area(text: "hello", key: "ta:nested",
                                                text_color: vocab::Color::rgba(1.0f64, 1.0f64, 1.0f64, 1.0f64))
        .height(60.0f64);
    var inner: core::Builder = core::Builder::new();
    inner.add(area);
    var content: core::Node = core::column(inner, key: "nested:content");

    var sc: core::Node = scroll::scroll(key: "nested:scroll", axis: vocab::ScrollAxis::Vertical);
    match scroll::from(#addr_of(sc)) {
        option::Option[scroll::Scroll]::Some(s) => { let _c: scroll::Scroll = s.set_content(content); }
        option::Option[scroll::Scroll]::None => { assert false; }
    }
    var root: core::Builder = core::Builder::new();
    root.add(sc.height(120.0f64));
    var tree: core::Node = core::column(root, key: "nested:root");
    let rp: *core::Node = #addr_of(tree);
    assert mount::mount(rp);
    geometry::relayout_root(rp, 300.0f64, 200.0f64, 1.0f64);

    match core::find_in(rp, "ta:nested") {
        option::Option[*core::Node]::Some(a) => {
            let av: *u8 = core::view_of(a);
            assert av != (0 as *u8);
            let doc: *u8 = { rt::msg_id(av, rt::sel(#str_ptr("documentView\0"))) };
            assert doc != (0 as *u8);
            // Editable, or every key press is a beep.
            assert { rt::msg_i8(doc, rt::sel(#str_ptr("isEditable\0"))) } != (0 as i8);
            // And the colour the application asked for, not the platform default.
            let col: *u8 = { rt::msg_id(doc, rt::sel(#str_ptr("textColor\0"))) };
            assert col != (0 as *u8);
            assert { rt::msg_f64(col, rt::sel(#str_ptr("redComponent\0"))) } > 0.9f64;
        }
        option::Option[*core::Node]::None => { assert false; }
    }
    mount::unmount(rp);
    backend::uninstall();
    return;
}

// The box a text area DRAWS and the box it can be CLICKED IN were not the same
// box. An NSTextView is sized to its text, and `size_scroll_content` skipped
// text areas outright — so a one-line description inside a 120-point area was a
// 14-point document view with the clip view showing through underneath. The
// clip view carries the I-beam document cursor across the whole viewport, so it
// still looked like a text area: the pointer changed, the click landed on
// nothing, focus never moved, and every keystroke after it went to the window
// and beeped. That is the whole of "the description box cannot be typed into".
#[test]
fn a_text_areas_editor_fills_its_box_so_a_click_low_in_it_still_lands() {
    backend::install();
    var area: core::Node = text_area::text_area(text: "one line", key: "ta:box")
        .height(120.0f64);
    var root: core::Builder = core::Builder::new();
    root.add(area);
    var tree: core::Node = core::column(root, key: "box:root");
    let rp: *core::Node = #addr_of(tree);
    assert mount::mount(rp);
    geometry::relayout_root(rp, 300.0f64, 200.0f64, 1.0f64);

    match core::find_in(rp, "ta:box") {
        option::Option[*core::Node]::Some(a) => {
            let av: *u8 = core::view_of(a);
            assert av != (0 as *u8);
            let doc: *u8 = { rt::msg_id(av, rt::sel(#str_ptr("documentView\0"))) };
            assert doc != (0 as *u8);
            let port: rt::Size = { msg_size_of(av, rt::sel(#str_ptr("contentSize\0"))) };
            assert port.h > 0.0f64;
            let f: rt::Rect = { rt::msg_rect(doc, rt::sel(#str_ptr("frame\0"))) };
            // As wide as the viewport, because the area wraps rather than
            // scrolling sideways, and never shorter than it.
            assert f.w == port.w;
            assert f.h >= port.h;
            // The claim that matters, asked the way AppKit asks it: a point near
            // the BOTTOM of the box reaches the editor. `hitTest:` takes the
            // point in the receiver's superview space, so it is asked of the
            // clip view, whose space is the scroll view's.
            let clip: *u8 = { rt::msg_id(av, rt::sel(#str_ptr("contentView\0"))) };
            assert clip != (0 as *u8);
            let deep: *u8 = { msg_id_point(clip, rt::sel(#str_ptr("hitTest:\0")),
                                           rt::Point { x: port.w / 2.0f64,
                                                       y: port.h - 4.0f64 }) };
            assert deep == doc;
        }
        option::Option[*core::Node]::None => { assert false; }
    }
    mount::unmount(rp);
    backend::uninstall();
    return;
}

#[test]
fn an_aligned_and_armed_text_view_can_call_super() {
    backend::install();
    var n: core::Node = text_area::text_area(text: "hello",
                                             key: "ta:both",
                                             vertical_align: vocab::TextAlign::Start)
        .height(60.0f64)
        .gesture(on_click: h_took());
    let p: *core::Node = #addr_of(n);
    let v: *u8 = views::create(0 as *u8, p);
    assert v != (0 as *u8);
    // The text view is inside the text area's own scroll view.
    let doc: *u8 = { rt::msg_id(v, rt::sel(#str_ptr("documentView\0"))) };
    assert doc != (0 as *u8);
    // Both subclasses are on it: the kind body ran, then arming swapped again.
    // Asking for the origin must reach NSTextView's implementation rather than
    // re-entering ours.
    let _o: rt::Point = { msg_point_0(doc, rt::sel(#str_ptr("textContainerOrigin\0"))) };
    views::view_release(v);
    return;
}

#[test]
fn a_scroll_declines_the_axis_it_does_not_scroll() {
    backend::install();
    var v_only: core::Node = scroll::scroll(key: "el:v", axis: vocab::ScrollAxis::Vertical);
    let pv: *core::Node = #addr_of(v_only);
    let vv: *u8 = views::create(0 as *u8, pv);
    assert vv != (0 as *u8);
    let sv: ak::ScrollView = ak::ScrollView::from_raw(vv);
    // The axis it scrolls stays elastic; the one it cannot is refused.
    assert elasticity_is_none(sv.horizontal_scroll_elasticity());
    assert elasticity_is_none(sv.vertical_scroll_elasticity()) == false;
    views::view_release(vv);

    var h_only: core::Node = scroll::scroll(key: "el:h", axis: vocab::ScrollAxis::Horizontal);
    let ph: *core::Node = #addr_of(h_only);
    let hv: *u8 = views::create(0 as *u8, ph);
    let sh: ak::ScrollView = ak::ScrollView::from_raw(hv);
    assert elasticity_is_none(sh.vertical_scroll_elasticity());
    assert elasticity_is_none(sh.horizontal_scroll_elasticity()) == false;
    views::view_release(hv);

    // `Both` claims both, which is correct: there is no ancestor to defer to
    // on an axis this view really does scroll.
    var both: core::Node = scroll::scroll(key: "el:b", axis: vocab::ScrollAxis::Both);
    let pb: *core::Node = #addr_of(both);
    let bv: *u8 = views::create(0 as *u8, pb);
    let sb: ak::ScrollView = ak::ScrollView::from_raw(bv);
    assert elasticity_is_none(sb.horizontal_scroll_elasticity()) == false;
    assert elasticity_is_none(sb.vertical_scroll_elasticity()) == false;
    views::view_release(bv);
    return;
}

fn elasticity_is_none(e: ak::ScrollElasticity) -> bool {
    return match e {
        ak::ScrollElasticity::None => true,
        ak::ScrollElasticity::Automatic => false,
        ak::ScrollElasticity::Allowed => false,
    };
}

#[test]
fn a_released_scroll_view_leaves_no_observer_behind() {
    // A notification centre holds observers UNRETAINED. One that outlives its
    // registration is a dangling pointer the next scroll walks into, so the
    // release path has to remove it — and this asserts the removal by scrolling
    // a clip view whose node is gone.
    backend::install();
    SCROLLS = 0 as i64;
    var s: core::Node = scroll::scroll(key: "sc2", observe_scrolled: h_scrolled());
    let p: *core::Node = #addr_of(s);
    let v: *u8 = views::create(0 as *u8, p);
    let clip: *u8 = { rt::retain({ rt::msg_id(v, rt::sel(#str_ptr("contentView\0"))) }) };
    views::view_release(v);
    { msg_void_point(clip, rt::sel(#str_ptr("scrollToPoint:\0")),
                         rt::Point { x: 0.0f64, y: 80.0f64 }) };
    assert SCROLLS == (0 as i64);
    rt::release(clip);
    return;
}

#[link_name = "objc_msgSend"]
extern fn msg_void_point(recv: *u8, sel: *u8, p: rt::Point);

// ---- the control's own pointer verbs ------------------------------------------

static PRESSES: i64 = 0 as i64;
static RELEASES: i64 = 0 as i64;
static CANCELS: i64 = 0 as i64;
fn on_press_v(sender: *u8, ctx: *u8) { PRESSES = PRESSES + (1 as i64); return; }
fn on_release_v(sender: *u8, ctx: *u8) { RELEASES = RELEASES + (1 as i64); return; }
fn on_cancel_v(sender: *u8, ctx: *u8) { CANCELS = CANCELS + (1 as i64); return; }
fn h_press_v() -> fn(*u8, *u8) { let f: fn(*u8, *u8) = on_press_v; return f; }
fn h_release_v() -> fn(*u8, *u8) { let f: fn(*u8, *u8) = on_release_v; return f; }
fn h_cancel_v() -> fn(*u8, *u8) { let f: fn(*u8, *u8) = on_cancel_v; return f; }

#[test]
fn a_buttons_own_press_and_release_are_not_the_gesture_band() {
    // `button(on_pressed:)` is the CONTROL's verb. An application that used it
    // never wrote `.gesture(...)`, so it has no Gestures at all — which is the
    // one path where `input::arm` runs with a null gesture set.
    backend::install();
    PRESSES = 0 as i64;
    RELEASES = 0 as i64;
    var n: core::Node = button::button("Save", key: "pb",
                                       on_pressed: h_press_v(), on_released: h_release_v());
    let p: *core::Node = #addr_of(n);
    let v: *u8 = views::create(0 as *u8, p);
    core::set_view(p, v, views::view_release);
    { rt::msg_void_id(v, rt::sel(#str_ptr("mouseDown:\0")), mouse_event(1 as u64, 1 as i64)) };
    assert PRESSES == (1 as i64);
    assert RELEASES == (0 as i64);
    { rt::msg_void_id(v, rt::sel(#str_ptr("mouseUp:\0")), mouse_event(2 as u64, 1 as i64)) };
    assert RELEASES == (1 as i64);
    return;
}

#[test]
fn a_button_with_no_pointer_verbs_is_not_armed_at_all() {
    // The gate is the declared HANDLER, not the kind: arming moves the view's
    // class, and a control that asked for nothing should not pay for that.
    backend::install();
    var n: core::Node = button::button("Plain", key: "plainb");
    let v: *u8 = views::create(0 as *u8, #addr_of(n));
    assert synth::object_class(v) == rt::get_class(#str_ptr("NSButton\0"));
    views::view_release(v);
    return;
}

#[test]
fn a_canvas_press_and_release_reach_the_canvas_verbs() {
    backend::install();
    PRESSES = 0 as i64;
    RELEASES = 0 as i64;
    var c: core::Node = canvas::canvas(key: "cp", on_press: h_press_v(), on_release: h_release_v());
    let p: *core::Node = #addr_of(c);
    let v: *u8 = views::create(0 as *u8, p);
    core::set_view(p, v, views::view_release);
    { rt::msg_void_id(v, rt::sel(#str_ptr("mouseDown:\0")), mouse_event(1 as u64, 1 as i64)) };
    { rt::msg_void_id(v, rt::sel(#str_ptr("mouseUp:\0")), mouse_event(2 as u64, 1 as i64)) };
    assert PRESSES == (1 as i64);
    assert RELEASES == (1 as i64);
    return;
}

#[test]
fn leaving_a_canvas_while_pressed_is_a_cancel_and_not_a_release() {
    // `CancelInteraction` is the press that was ABANDONED. AppKit says so only
    // by ending the tracking somewhere the release will never arrive, so the
    // difference between a cancel and a plain unhover is whether the pointer
    // was down — which is the flag this asserts.
    backend::install();
    CANCELS = 0 as i64;
    RELEASES = 0 as i64;
    var c: core::Node = canvas::canvas(key: "cc", on_cancel: h_cancel_v(), on_release: h_release_v());
    let p: *core::Node = #addr_of(c);
    let v: *u8 = views::create(0 as *u8, p);
    core::set_view(p, v, views::view_release);
    // Exit with no press: not a cancel.
    { rt::msg_void_id(v, rt::sel(#str_ptr("mouseExited:\0")), mouse_event(2 as u64, 0 as i64)) };
    assert CANCELS == (0 as i64);
    // Press, then leave: a cancel, and NOT a release.
    { rt::msg_void_id(v, rt::sel(#str_ptr("mouseDown:\0")), mouse_event(1 as u64, 1 as i64)) };
    { rt::msg_void_id(v, rt::sel(#str_ptr("mouseExited:\0")), mouse_event(2 as u64, 0 as i64)) };
    assert CANCELS == (1 as i64);
    assert RELEASES == (0 as i64);
    return;
}

#[test]
fn a_radio_group_is_honoured_by_NAME_not_by_superview() {
    // AppKit groups radios by SUPERVIEW and has no group name. facet names the
    // group, and this backend used to record that as "AppKit cannot" — which
    // was wrong: a portable model the backend declines to honour is the
    // description being rendered wrong, not a platform limit.
    //
    // The two radios here are in DIFFERENT containers on purpose. Under
    // AppKit's own rule they would not affect each other at all.
    backend::install();
    var left: core::Builder = core::Builder::new();
    left.add(radio::radio(true, key: "a", group: "pick"));
    var right: core::Builder = core::Builder::new();
    right.add(radio::radio(false, key: "b", group: "pick"));
    var outer: core::Builder = core::Builder::new();
    outer.add(core::column(left, key: "L"));
    outer.add(core::column(right, key: "R"));
    var root: core::Node = core::column(outer, key: "grouproot");
    let p: *core::Node = #addr_of(root);
    assert mount::mount(p);

    match radio::find("b", within: p) {
        option::Option[radio::Radio]::Some(b) => {
            let v: *u8 = core::view_of(b.node());
            assert v != (0 as *u8);
            // Turning B on through the CONTROL, which is what a click ends in.
            ak::Button::from_raw(v).set_state(1 as i64);
            ak::Control::from_raw(v).perform_click(0 as *u8);
        }
        option::Option[radio::Radio]::None => { assert false; }
    }
    // A is off, in the props AND on its control — one answer, not two.
    match radio::find("a", within: p) {
        option::Option[radio::Radio]::Some(a) => {
            assert a.on() == false;
            let av: *u8 = core::view_of(a.node());
            assert ak::Button::from_raw(av).state() == (0 as i64);
        }
        option::Option[radio::Radio]::None => { assert false; }
    }
    mount::unmount(p);
    return;
}

#[test]
fn a_dashed_border_becomes_a_stroke_layer_and_a_plain_one_does_not() {
    // A layer border is one solid rectangle of one width — no dash, no cap, no
    // join, no shape. Everything past `stroke_width` needs a PATH, and this is
    // the gate: a node that asks for a dash gets a CAShapeLayer, one that does
    // not keeps the cheap border and pays for no second layer.
    backend::install();
    var plain: core::Node = bordered::bordered(key: "bp", stroke_width: 2.0f64,
        stroke: vocab::Brush::solid(vocab::Color::rgba(0.0f64, 1.0f64, 0.0f64, 1.0f64)));
    let pv: *u8 = views::create(0 as *u8, #addr_of(plain));
    assert ak::View::from_raw(pv).layer().border_width() > 1.5f64;
    assert controls::has_stroke_layer(ak::View::from_raw(pv)) == false;

    var dashed: core::Node = bordered::bordered(key: "bd", stroke_width: 2.0f64,
        stroke: vocab::Brush::solid(vocab::Color::rgba(0.0f64, 1.0f64, 0.0f64, 1.0f64)),
        stroke_dash: vocab::Dashes::of(4.0f64, 2.0f64));
    let dp: *core::Node = #addr_of(dashed);
    let dv: *u8 = views::create(0 as *u8, dp);
    // The resize observer reads the node's props through its view, so the node
    // has to be paired with it first — which is what mount does.
    core::set_view(dp, dv, views::view_release);
    let view: ak::View = ak::View::from_raw(dv);
    assert controls::has_stroke_layer(view);
    // A stroked path is GEOMETRY, and the frame walk sizes a view after its
    // body runs — so the path arrives with the size, not at create. Sizing the
    // view is what a real layout pass does.
    view.set_frame(rt::Rect { x: 0.0f64, y: 0.0f64, w: 80.0f64, h: 40.0f64 });
    // The plain border is TAKEN AWAY, or the node draws two.
    assert view.layer().border_width() == 0.0f64;
    let sl: *u8 = controls::stroke_layer_of(view);
    assert { rt::msg_id(sl, rt::sel(#str_ptr("lineDashPattern\0"))) } != (0 as *u8);
    // The path arrives WITH the size, which is the whole reason the view is
    // observed rather than pathed once at create.
    assert { rt::msg_id(sl, rt::sel(#str_ptr("path\0"))) } != (0 as *u8);
    views::view_release(pv);
    return;
}

#[test]
fn asking_for_a_shape_and_then_not_takes_the_stroke_layer_away() {
    // The teardown half: a node that stops asking must stop paying. Without it
    // the shape layer outlives the request and keeps drawing the old outline
    // under the new plain border.
    backend::install();
    var n: core::Node = bordered::bordered(key: "bt", stroke_width: 2.0f64,
        stroke: vocab::Brush::solid(vocab::Color::rgba(1.0f64, 0.0f64, 0.0f64, 1.0f64)),
        stroke_dash: vocab::Dashes::of(3.0f64, 3.0f64));
    let p: *core::Node = #addr_of(n);
    let v: *u8 = views::create(0 as *u8, p);
    let view: ak::View = ak::View::from_raw(v);
    assert controls::has_stroke_layer(view);
    core::set_view(p, v, views::view_release);
    core::clear_dirty(p);
    match bordered::from(p) {
        option::Option[bordered::Bordered]::Some(b) => {
            let _x: bordered::Bordered = b.set_stroke_dash(vocab::Dashes::none());
        }
        option::Option[bordered::Bordered]::None => { assert false; }
    }
    views::apply(0 as *u8, p);
    assert controls::has_stroke_layer(view) == false;
    assert view.layer().border_width() > 1.5f64;
    return;
}

#[test]
fn a_picker_format_names_which_components_show() {
    // NSDatePicker has no format STRING — it has an element mask. So a format
    // is read for WHICH components it names, and the ordering and separators
    // stay the locale's, which is what a date picker is for.
    backend::install();
    var ymd: core::Node = date_picker::date_picker(vocab::Date::zero(), key: "ymd", format: "yyyy-MM-dd");
    let v1: *u8 = views::create(0 as *u8, #addr_of(ymd));
    // NSDatePickerElementFlagYearMonthDay = 0xe0.
    assert { rt::msg_u64(v1, rt::sel(#str_ptr("datePickerElements\0"))) } == (224 as u64);

    var ym: core::Node = date_picker::date_picker(vocab::Date::zero(), key: "ym", format: "MMMM yyyy");
    let v2: *u8 = views::create(0 as *u8, #addr_of(ym));
    // YearMonth = 0xc0: no day named, so no day shown.
    assert { rt::msg_u64(v2, rt::sel(#str_ptr("datePickerElements\0"))) } == (192 as u64);

    var hms: core::Node = time_picker::time_picker(vocab::Duration { seconds: 0.0f64 }, key: "hms", format: "HH:mm:ss");
    let v3: *u8 = views::create(0 as *u8, #addr_of(hms));
    // HourMinuteSecond = 0xe.
    assert { rt::msg_u64(v3, rt::sel(#str_ptr("datePickerElements\0"))) } == (14 as u64);

    var hm: core::Node = time_picker::time_picker(vocab::Duration { seconds: 0.0f64 }, key: "hm", format: "HH:mm");
    let v4: *u8 = views::create(0 as *u8, #addr_of(hm));
    assert { rt::msg_u64(v4, rt::sel(#str_ptr("datePickerElements\0"))) } == (12 as u64);

    views::view_release(v1);
    views::view_release(v2);
    views::view_release(v3);
    views::view_release(v4);
    return;
}

// ---- what a scroll implies ----------------------------------------------------
// `position`, `is_scrolling` and the threshold have no AppKit source: a scroll
// view reports an offset and nothing else. These assert the DERIVATION, by
// scrolling for real and reading back what facet concluded.

static POSCHANGES: i64 = 0 as i64;
static THRESHOLDS: i64 = 0 as i64;
fn on_pos(sender: *u8, ctx: *u8) { POSCHANGES = POSCHANGES + (1 as i64); return; }
fn on_thr(sender: *u8, ctx: *u8) { THRESHOLDS = THRESHOLDS + (1 as i64); return; }
fn h_pos() -> fn(*u8, *u8) { let f: fn(*u8, *u8) = on_pos; return f; }
fn h_thr() -> fn(*u8, *u8) { let f: fn(*u8, *u8) = on_thr; return f; }

// A carousel's pages are its CHILDREN, like a table's rows — attached after
// the node exists, because the constructor takes no builder.
fn paged_carousel(key: str) -> core::Node {
    var c: core::Node = carousel::carousel(key: key, on_position_changed: h_pos(),
                                           remaining_threshold: 2 as i64,
                                           on_remaining_items_threshold_reached: h_thr());
    var i: i64 = 0 as i64;
    while i < (5 as i64) {
        var page: core::Node = box_view::box(color: vocab::Color::rgba(0.2f64, 0.2f64, 0.2f64));
        page.set_width(flex::StyleLength::points(100.0f64));
        page.set_height(flex::StyleLength::points(50.0f64));
        c.add_child(page);
        i = i + (1 as i64);
    }
    return c;
}

#[test]
fn scrolling_a_carousel_derives_its_position_from_the_offset() {
    // A carousel's `position` is an INDEX; a scroll view's truth is an OFFSET.
    // Nothing in AppKit converts one to the other, so facet derives it off the
    // frames flex already laid out — and this scrolls for real to check.
    backend::install();
    POSCHANGES = 0 as i64;
    var c: core::Node = paged_carousel("car");
    let p: *core::Node = #addr_of(c);
    assert mount::mount(p);
    let v: *u8 = core::view_of(p);
    assert v != (0 as *u8);
    c.calculate_layout(width: 100.0f64);
    let clip: *u8 = { rt::msg_id(v, rt::sel(#str_ptr("contentView\0"))) };
    // Onto the third page.
    { msg_void_point(clip, rt::sel(#str_ptr("scrollToPoint:\0")),
                     rt::Point { x: 0.0f64, y: 100.0f64 }) };
    match carousel::from(p) {
        option::Option[carousel::Carousel]::Some(h) => {
            assert h.position() == (2 as i64);
            // The scroll is IN PROGRESS: it just arrived, and nothing has
            // settled it yet.
            assert h.is_scrolling();
        }
        option::Option[carousel::Carousel]::None => { assert false; }
    }
    assert POSCHANGES == (1 as i64);
    mount::unmount(p);
    return;
}

#[test]
fn the_remaining_threshold_fires_once_on_the_way_in() {
    // A handler that loads the next page must not be asked for it on every
    // scrolled pixel — so the threshold ARMS on the way in and only re-arms
    // after the scroll has left the tail.
    backend::install();
    THRESHOLDS = 0 as i64;
    var c: core::Node = paged_carousel("thr");
    let p: *core::Node = #addr_of(c);
    assert mount::mount(p);
    let v: *u8 = core::view_of(p);
    c.calculate_layout(width: 100.0f64);
    let clip: *u8 = { rt::msg_id(v, rt::sel(#str_ptr("contentView\0"))) };
    // Page 3 of 5: three remain, past a threshold of two.
    { msg_void_point(clip, rt::sel(#str_ptr("scrollToPoint:\0")),
                     rt::Point { x: 0.0f64, y: 100.0f64 }) };
    assert THRESHOLDS == (0 as i64);
    // Page 4: two remain, so it fires.
    { msg_void_point(clip, rt::sel(#str_ptr("scrollToPoint:\0")),
                     rt::Point { x: 0.0f64, y: 150.0f64 }) };
    assert THRESHOLDS == (1 as i64);
    // Still in the tail: it must NOT fire again.
    { msg_void_point(clip, rt::sel(#str_ptr("scrollToPoint:\0")),
                     rt::Point { x: 0.0f64, y: 200.0f64 }) };
    assert THRESHOLDS == (1 as i64);
    // Back out, then in again: that is a second arrival.
    { msg_void_point(clip, rt::sel(#str_ptr("scrollToPoint:\0")),
                     rt::Point { x: 0.0f64, y: 0.0f64 }) };
    { msg_void_point(clip, rt::sel(#str_ptr("scrollToPoint:\0")),
                     rt::Point { x: 0.0f64, y: 150.0f64 }) };
    assert THRESHOLDS == (2 as i64);
    mount::unmount(p);
    return;
}

// ---- the verbs the ledger had wrong ------------------------------------------
// Each of these was recorded "AppKit cannot" or "no carrier", and each was
// wrong: the API exists, or the statement is settable one level down, or the
// thing the ledger said had no reader was simply never installed.

#[test]
fn a_slider_fills_its_track_with_the_minimum_track_colour() {
    // `trackFillColor` — NSSlider has had it since 10.12, and the ledger said
    // the whole track was cell-drawn with no colour slot. Half of that is true:
    // the EMPTY half and the knob still are.
    backend::install();
    var s: core::Node = slider::slider(0.5f64, key: "sl",
                                       minimum_track_color: vocab::Color::rgba(1.0f64, 0.0f64, 0.0f64));
    let v: *u8 = views::create(0 as *u8, #addr_of(s));
    assert v != (0 as *u8);
    let c: *u8 = { rt::msg_id(v, rt::sel(#str_ptr("trackFillColor\0"))) };
    assert c != (0 as *u8);
    // Red, in whatever space AppKit hands it back.
    let rgb: *u8 = { rt::msg_id_id(c, rt::sel(#str_ptr("colorUsingColorSpace:\0")),
                                   { rt::msg_id(rt::get_class(#str_ptr("NSColorSpace\0")),
                                                rt::sel(#str_ptr("sRGBColorSpace\0"))) }) };
    assert rgb != (0 as *u8);
    assert { rt::msg_f64(rgb, rt::sel(#str_ptr("redComponent\0"))) } > 0.9f64;
    assert { rt::msg_f64(rgb, rt::sel(#str_ptr("greenComponent\0"))) } < 0.1f64;
    views::view_release(v);
    return;
}

#[test]
fn a_slider_that_asks_for_no_track_colour_gets_the_systems() {
    // The unset colour must not paint: `clear()` is "nothing was said", and a
    // slider that said nothing has to look like every other slider.
    backend::install();
    var s: core::Node = slider::slider(0.5f64, key: "sl2");
    let v: *u8 = views::create(0 as *u8, #addr_of(s));
    let c: *u8 = { rt::msg_id(v, rt::sel(#str_ptr("trackFillColor\0"))) };
    assert c == (0 as *u8);
    views::view_release(v);
    return;
}

#[test]
fn an_opaque_image_says_so_on_its_layer() {
    // `-[NSView isOpaque]` has no setter, which is what the ledger read. The
    // STATEMENT is settable one level down, and that is the level the
    // compositor reads it at.
    backend::install();
    var i: core::Node = image::image("gear", key: "im", is_opaque: true);
    let v: *u8 = views::create(0 as *u8, #addr_of(i));
    assert v != (0 as *u8);
    assert ak::View::from_raw(v).wants_layer();
    assert { rt::msg_i8(ak::View::from_raw(v).layer().raw(), rt::sel(#str_ptr("isOpaque\0"))) } != (0 as i8);
    views::view_release(v);
    return;
}

#[test]
fn a_transparent_image_is_not_given_a_layer_to_say_so() {
    // A view that asks for `is_opaque: false` is describing what it does
    // anyway. Giving it a layer to say so would cost a backing store per image.
    backend::install();
    var i: core::Node = image::image("gear", key: "im2");
    let v: *u8 = views::create(0 as *u8, #addr_of(i));
    assert ak::View::from_raw(v).wants_layer() == false;
    views::view_release(v);
    return;
}

#[test]
fn an_input_transparent_node_hands_the_hit_back() {
    // The shared band's `input_transparent`, which had no implementation at
    // all — AppKit has no per-view switch, so the answer is the hit test, and
    // that is why such a node is armed even with no gestures on it.
    backend::install();
    var n: core::Node = box_view::box(color: vocab::Color::rgba(0.0f64, 0.0f64, 1.0f64), key: "ghost");
    core::set_input_transparent(#addr_of(n), true);
    let p: *core::Node = #addr_of(n);
    let v: *u8 = views::create(0 as *u8, p);
    core::set_view(p, v, views::view_release);
    { rt::msg_void_rect(v, rt::sel(#str_ptr("setFrame:\0")),
                        rt::Rect { x: 0.0f64, y: 0.0f64, w: 100.0f64, h: 100.0f64 }) };
    assert { rt::msg_id_point(v, rt::sel(#str_ptr("hitTest:\0")),
                              rt::Point { x: 50.0f64, y: 50.0f64 }) } == (0 as *u8);
    return;
}

#[test]
fn an_ordinary_node_still_takes_its_own_hit() {
    // The ablation: without the transparency the same node answers itself, so
    // the test above is asserting the new path and not a broken hit test.
    backend::install();
    var n: core::Node = box_view::box(color: vocab::Color::rgba(0.0f64, 0.0f64, 1.0f64), key: "solid")
        .gesture(on_click: h_took());
    let p: *core::Node = #addr_of(n);
    let v: *u8 = views::create(0 as *u8, p);
    core::set_view(p, v, views::view_release);
    { rt::msg_void_rect(v, rt::sel(#str_ptr("setFrame:\0")),
                        rt::Rect { x: 0.0f64, y: 0.0f64, w: 100.0f64, h: 100.0f64 }) };
    assert { rt::msg_id_point(v, rt::sel(#str_ptr("hitTest:\0")),
                              rt::Point { x: 50.0f64, y: 50.0f64 }) } == v;
    return;
}

#[test]
fn a_scroll_that_does_not_cascade_lets_its_children_be_hit() {
    // `CascadeInputTransparent`. The hit test runs TOP-DOWN, so a container
    // that answers nil is never asked about its subviews — which IS the
    // cascade. Turning it off means answering nil only where SUPER said self.
    backend::install();
    var child: core::Node = box_view::box(color: vocab::Color::rgba(1.0f64, 0.0f64, 0.0f64), key: "inner");
    child.set_width(flex::StyleLength::points(50.0f64));
    child.set_height(flex::StyleLength::points(50.0f64));
    var s: core::Node = scroll::scroll(key: "nocascade", cascades_input: false);
    s.add_child(child);
    core::set_input_transparent(#addr_of(s), true);
    let p: *core::Node = #addr_of(s);
    assert mount::mount(p);
    let v: *u8 = core::view_of(p);
    s.calculate_layout(width: 100.0f64);
    { rt::msg_void_rect(v, rt::sel(#str_ptr("setFrame:\0")),
                        rt::Rect { x: 0.0f64, y: 0.0f64, w: 100.0f64, h: 100.0f64 }) };
    // Somewhere over the child: the scroll declines, the child does not.
    let hit: *u8 = { rt::msg_id_point(v, rt::sel(#str_ptr("hitTest:\0")),
                                      rt::Point { x: 10.0f64, y: 10.0f64 }) };
    assert hit != v;
    mount::unmount(p);
    return;
}

#[test]
fn a_cascading_transparent_scroll_takes_its_whole_subtree_out() {
    backend::install();
    var child: core::Node = box_view::box(color: vocab::Color::rgba(1.0f64, 0.0f64, 0.0f64), key: "inner2");
    child.set_width(flex::StyleLength::points(50.0f64));
    child.set_height(flex::StyleLength::points(50.0f64));
    var s: core::Node = scroll::scroll(key: "cascade", cascades_input: true);
    s.add_child(child);
    core::set_input_transparent(#addr_of(s), true);
    let p: *core::Node = #addr_of(s);
    assert mount::mount(p);
    let v: *u8 = core::view_of(p);
    s.calculate_layout(width: 100.0f64);
    { rt::msg_void_rect(v, rt::sel(#str_ptr("setFrame:\0")),
                        rt::Rect { x: 0.0f64, y: 0.0f64, w: 100.0f64, h: 100.0f64 }) };
    assert { rt::msg_id_point(v, rt::sel(#str_ptr("hitTest:\0")),
                              rt::Point { x: 10.0f64, y: 10.0f64 }) } == (0 as *u8);
    mount::unmount(p);
    return;
}

#[test]
fn toolbar_items_come_out_in_placement_then_priority_order() {
    // The bar's ORDER is a property of the whole bar, which is why the walk
    // collects before it builds. Primary first, Secondary last, the ledger's own
    // Priority within each group.
    backend::install();
    var b: core::Builder = core::Builder::new();
    b.add(toolbar_item::toolbar_item("Late", key: "tb:late",
                                     placement: vocab::ToolbarPlacement::Secondary));
    b.add(toolbar_item::toolbar_item("Second", key: "tb:second", priority: 2 as i64));
    b.add(toolbar_item::toolbar_item("First", key: "tb:first", priority: 1 as i64));
    b.add(toolbar_item::toolbar_item("Early", key: "tb:early",
                                     placement: vocab::ToolbarPlacement::Primary));
    var root: core::Node = core::column(b, key: "tbroot");
    let ids: *u8 = { rt::alloc_init(#str_ptr("NSMutableArray\0")) };
    let map: *u8 = { rt::alloc_init(#str_ptr("NSMutableDictionary\0")) };
    window::collect_toolbar_items(#addr_of(root), ids, map);
    assert { rt::msg_u64(ids, rt::sel(#str_ptr("count\0"))) } == (4 as u64);
    assert ident_at(ids, 0 as u64) == "tb:early";
    assert ident_at(ids, 1 as u64) == "tb:first";
    assert ident_at(ids, 2 as u64) == "tb:second";
    assert ident_at(ids, 3 as u64) == "tb:late";
    // And the group decides how readily it collapses into the overflow.
    let secondary: *u8 = { rt::msg_id_id(map, rt::sel(#str_ptr("objectForKey:\0")),
                                         bridge::nsstring("tb:late")) };
    assert { rt::msg_i64(secondary, rt::sel(#str_ptr("visibilityPriority\0"))) } == (-1000 as i64);
    let primary: *u8 = { rt::msg_id_id(map, rt::sel(#str_ptr("objectForKey:\0")),
                                       bridge::nsstring("tb:early")) };
    assert { rt::msg_i64(primary, rt::sel(#str_ptr("visibilityPriority\0"))) } == (1000 as i64);
    rt::release(ids);
    rt::release(map);
    return;
}

fn ident_at(arr: *u8, i: u64) -> text::Text {
    return bridge::to_text({ rt::msg_id_u64(arr, rt::sel(#str_ptr("objectAtIndex:\0")), i) });
}

#[test]
fn a_menu_described_in_the_tree_reaches_the_menu_bar() {
    // `build_menu` has turned a `menu` node into an NSMenu since the tier
    // landed, and nothing ever installed it — the same shape of gap
    // `install_app_menu` was written to close for the value-carried AppMenu.
    backend::install();
    var b: core::Builder = core::Builder::new();
    // Described Edit-first, but File asks to come earlier.
    var edit: core::Node = menu::menu("Edit", priority: 2 as i64);
    edit.add_child(menu_item::menu_item("Copy"));
    var file: core::Node = menu::menu("File", priority: 1 as i64);
    file.add_child(menu_item::menu_item("New"));
    b.add(edit);
    b.add(file);
    var root: core::Node = core::column(b, key: "menuroot");

    let bar: *u8 = { rt::alloc_init(#str_ptr("NSMenu\0")) };
    assert window::add_tree_menus(bar, #addr_of(root)) == (2 as i64);
    assert { rt::msg_i64(bar, rt::sel(#str_ptr("numberOfItems\0"))) } == (2 as i64);
    assert menu_title_at(bar, 0 as i64) == "File";
    assert menu_title_at(bar, 1 as i64) == "Edit";
    // And the submenu carries the items its children described.
    let first: *u8 = { rt::msg_id_i64(bar, rt::sel(#str_ptr("itemAtIndex:\0")), 0 as i64) };
    let sub: *u8 = { rt::msg_id(first, rt::sel(#str_ptr("submenu\0"))) };
    assert { rt::msg_i64(sub, rt::sel(#str_ptr("numberOfItems\0"))) } == (1 as i64);
    rt::release(bar);
    return;
}

#[test]
fn a_tree_with_no_menu_nodes_leaves_the_bar_alone() {
    backend::install();
    var bare: core::Node = core::column(core::Builder::new(), key: "nomenus");
    let bar: *u8 = { rt::alloc_init(#str_ptr("NSMenu\0")) };
    assert window::add_tree_menus(bar, #addr_of(bare)) == (0 as i64);
    assert { rt::msg_i64(bar, rt::sel(#str_ptr("numberOfItems\0"))) } == (0 as i64);
    rt::release(bar);
    return;
}

#[test]
fn an_unanimated_carousel_position_lands_at_once() {
    // The two halves of `animates_scroll`, and the only way to tell them apart
    // without a run loop: a jump has already happened when the write returns.
    backend::install();
    // `animates_scroll` defaults TRUE, which is the ledger's own default — so a
    // carousel that wants a jump has to say so.
    var c: core::Node = paged_carousel("jump");
    set_carousel_animation(#addr_of(c), false);
    let p: *core::Node = #addr_of(c);
    assert mount::mount(p);
    geometry::relayout_root(p, 100.0f64, 50.0f64, 1.0f64);
    let v: *u8 = core::view_of(p);
    core::clear_dirty(p);
    set_carousel_position(p, 2 as i64);
    core::touch(p, carousel::P_POSITION);
    views::apply(0 as *u8, p);
    assert clip_origin_y(v) > 50.0f64;
    mount::unmount(p);
    return;
}

#[test]
fn an_animated_carousel_position_is_still_on_its_way() {
    // Same write, `animates_scroll: true`: the clip view is animating, so it
    // has NOT arrived by the time apply returns. That difference is the verb.
    backend::install();
    var c: core::Node = carousel::carousel(key: "slide", animates_scroll: true);
    var i: i64 = 0 as i64;
    while i < (5 as i64) {
        var page: core::Node = box_view::box(color: vocab::Color::rgba(0.2f64, 0.2f64, 0.2f64));
        page.set_width(flex::StyleLength::points(100.0f64));
        page.set_height(flex::StyleLength::points(50.0f64));
        c.add_child(page);
        i = i + (1 as i64);
    }
    let p: *core::Node = #addr_of(c);
    assert mount::mount(p);
    geometry::relayout_root(p, 100.0f64, 50.0f64, 1.0f64);
    let v: *u8 = core::view_of(p);
    core::clear_dirty(p);
    set_carousel_position(p, 2 as i64);
    core::touch(p, carousel::P_POSITION);
    views::apply(0 as *u8, p);
    assert clip_origin_y(v) == 0.0f64;
    mount::unmount(p);
    return;
}

fn set_carousel_animation(p: *core::Node, on: bool) {
    let d: *core::Data = core::node_data(p);
    let cp: *props::CarouselProps = { (*d).props } as *props::CarouselProps;
    { (*cp).animates_scroll = on };
    return;
}

fn set_carousel_position(p: *core::Node, at: i64) {
    let d: *core::Data = core::node_data(p);
    let cp: *props::CarouselProps = { (*d).props } as *props::CarouselProps;
    { (*cp).position = at };
    return;
}

fn clip_origin_y(v: *u8) -> f64 {
    let clip: *u8 = { rt::msg_id(v, rt::sel(#str_ptr("contentView\0"))) };
    return { rt::msg_rect(clip, rt::sel(#str_ptr("bounds\0"))) }.y;
}

// ---- composed verbs: what two native things do that one cannot ---------------

#[link_name = "objc_msgSend"]
extern fn msg_rect_of_rect(recv: *u8, sel: *u8, r: rt::Rect) -> rt::Rect;
#[link_name = "objc_msgSend"]
extern fn msg_point_0(recv: *u8, sel: *u8) -> rt::Point;

fn cell_rect(v: *u8, box: rt::Rect) -> rt::Rect {
    let cell: *u8 = { rt::msg_id(v, rt::sel(#str_ptr("cell\0"))) };
    return { msg_rect_of_rect(cell, rt::sel(#str_ptr("drawingRectForBounds:\0")), box) };
}

fn tall() -> rt::Rect { return rt::Rect { x: 0.0f64, y: 0.0f64, w: 200.0f64, h: 120.0f64 }; }

#[test]
fn a_label_asked_to_sit_at_the_top_draws_there() {
    // NSTextFieldCell centres its text in the rect it is handed, and has no
    // property for the alternative. So the RECT is what changes — and a cell
    // is an object whose class can be replaced.
    backend::install();
    var top: core::Node = label::label("Top", key: "vt", vertical_align: vocab::TextAlign::Start);
    let tv: *u8 = views::create(0 as *u8, #addr_of(top));
    var bottom: core::Node = label::label("Bottom", key: "vb", vertical_align: vocab::TextAlign::End);
    let bv: *u8 = views::create(0 as *u8, #addr_of(bottom));
    let tr: rt::Rect = cell_rect(tv, tall());
    let br: rt::Rect = cell_rect(bv, tall());
    // Each one is only as tall as its text needs.
    assert tr.h < 60.0f64;
    assert br.h < 60.0f64;
    // And they are at opposite ends of the same box.
    assert tr.y != br.y;
    let flipped: bool = { rt::msg_i8(tv, rt::sel(#str_ptr("isFlipped\0"))) } != (0 as i8);
    if flipped { assert tr.y < br.y; } else { assert tr.y > br.y; }
    views::view_release(tv);
    views::view_release(bv);
    return;
}

#[test]
fn a_label_that_did_not_ask_keeps_appkits_own_rect() {
    // `Center` is the generated default for vertical_align and means NOT
    // ASKED — a label that says nothing must not get a runtime subclass, and
    // must draw in exactly the rect AppKit would have given it.
    backend::install();
    var plain: core::Node = label::label("Plain", key: "vp");
    let v: *u8 = views::create(0 as *u8, #addr_of(plain));
    let cell: *u8 = { rt::msg_id(v, rt::sel(#str_ptr("cell\0"))) };
    assert synth::object_class(cell) == rt::get_class(#str_ptr("NSTextFieldCell\0"));
    let r: rt::Rect = cell_rect(v, tall());
    assert r.h > 100.0f64;
    views::view_release(v);
    return;
}

#[test]
fn an_editor_asked_to_sit_at_the_bottom_moves_its_container_origin() {
    // NSTextView has no cell at all. Its documented hook is
    // `textContainerOrigin` — the point the laid-out text is drawn from.
    backend::install();
    var a: core::Node = text_area::text_area("one line", key: "ea");
    let av: *u8 = views::create(0 as *u8, #addr_of(a));
    var b: core::Node = text_area::text_area("one line", key: "eb",
                                             vertical_align: vocab::TextAlign::End);
    let bv: *u8 = views::create(0 as *u8, #addr_of(b));
    { rt::msg_void_rect(av, rt::sel(#str_ptr("setFrame:\0")), tall()) };
    { rt::msg_void_rect(bv, rt::sel(#str_ptr("setFrame:\0")), tall()) };
    let ae: *u8 = { rt::msg_id(av, rt::sel(#str_ptr("documentView\0"))) };
    let be: *u8 = { rt::msg_id(bv, rt::sel(#str_ptr("documentView\0"))) };
    { rt::msg_void_rect(ae, rt::sel(#str_ptr("setFrame:\0")), tall()) };
    { rt::msg_void_rect(be, rt::sel(#str_ptr("setFrame:\0")), tall()) };
    let ao: rt::Point = { msg_point_0(ae, rt::sel(#str_ptr("textContainerOrigin\0"))) };
    let bo: rt::Point = { msg_point_0(be, rt::sel(#str_ptr("textContainerOrigin\0"))) };
    // An NSTextView is always flipped: further down is a larger y.
    assert bo.y > ao.y;
    views::view_release(av);
    views::view_release(bv);
    return;
}

#[test]
fn a_field_with_a_clear_button_has_one_and_hides_it_when_empty() {
    backend::install();
    var empty: core::Node = text_field::text_field("", key: "cb1",
                                                   clear_button: vocab::ClearButton::WhileEditing);
    let ev: *u8 = views::create(0 as *u8, #addr_of(empty));
    let eb: *u8 = compose::clear_button_of(ev);
    assert eb != (0 as *u8);
    assert { rt::msg_i8(eb, rt::sel(#str_ptr("isHidden\0"))) } != (0 as i8);

    var filled: core::Node = text_field::text_field("typed", key: "cb2",
                                                     clear_button: vocab::ClearButton::WhileEditing);
    let fv: *u8 = views::create(0 as *u8, #addr_of(filled));
    let fb: *u8 = compose::clear_button_of(fv);
    assert fb != (0 as *u8);
    assert { rt::msg_i8(fb, rt::sel(#str_ptr("isHidden\0"))) } == (0 as i8);
    // And pressing it empties the field.
    { rt::msg_void_id(fb, rt::sel(#str_ptr("performClick:\0")), 0 as *u8) };
    assert ak::Control::from_raw(fv).string_value().view() == "";
    assert { rt::msg_i8(fb, rt::sel(#str_ptr("isHidden\0"))) } != (0 as i8);
    views::view_release(ev);
    views::view_release(fv);
    return;
}

#[test]
fn a_field_with_no_clear_button_grows_no_subview() {
    backend::install();
    var plain: core::Node = text_field::text_field("x", key: "cb3");
    let v: *u8 = views::create(0 as *u8, #addr_of(plain));
    assert compose::clear_button_of(v) == (0 as *u8);
    views::view_release(v);
    return;
}

#[test]
fn the_clear_button_gives_its_width_back_to_the_text() {
    // Both halves or it looks broken: the button, AND the width the cell stops
    // drawing into, or the text runs underneath it.
    backend::install();
    var plain: core::Node = text_field::text_field("x", key: "cw1");
    let pv: *u8 = views::create(0 as *u8, #addr_of(plain));
    var cleared: core::Node = text_field::text_field("x", key: "cw2",
                                                     clear_button: vocab::ClearButton::WhileEditing);
    let cv: *u8 = views::create(0 as *u8, #addr_of(cleared));
    let pr: rt::Rect = cell_rect(pv, tall());
    let cr: rt::Rect = cell_rect(cv, tall());
    assert cr.w < pr.w;
    views::view_release(pv);
    views::view_release(cv);
    return;
}

#[test]
fn an_editor_placeholder_shows_until_there_is_text() {
    backend::install();
    var e: core::Node = text_area::text_area("", key: "ph1", placeholder: "Say something");
    let p: *core::Node = #addr_of(e);
    let v: *u8 = views::create(0 as *u8, p);
    core::set_view(p, v, views::view_release);
    let tv: *u8 = { rt::msg_id(v, rt::sel(#str_ptr("documentView\0"))) };
    let label: *u8 = compose::placeholder_of(tv);
    assert label != (0 as *u8);
    assert ak::Control::from_raw(label).string_value().view() == "Say something";
    assert { rt::msg_i8(label, rt::sel(#str_ptr("isHidden\0"))) } == (0 as i8);
    // Typing hides it.
    core::clear_dirty(p);
    set_area_text(p, "typed");
    core::touch(p, text_area::P_TEXT);
    views::apply(0 as *u8, p);
    assert { rt::msg_i8(label, rt::sel(#str_ptr("isHidden\0"))) } != (0 as i8);
    return;
}

fn set_area_text(p: *core::Node, s: str) {
    let d: *core::Data = core::node_data(p);
    let tp: *props::TextAreaProps = { (*d).props } as *props::TextAreaProps;
    let iv: *props::InputViewProps = { #addr_of((*tp).input_view) };
    { (*iv).text = text::from_str(s) };
    return;
}

#[test]
fn the_editor_placeholder_hands_the_click_to_the_editor() {
    // A reader clicks AT the words, because that is where the text will go.
    // The overlay is a real NSTextField, and an NSTextField answers `hitTest:`
    // with itself — so the click landed on the label, the editor never became
    // first responder, and the rect that most invites a click was the one rect
    // that could not take one.
    backend::install();
    var e: core::Node = text_area::text_area("", key: "ph3", placeholder: "Say something");
    let p: *core::Node = #addr_of(e);
    let v: *u8 = views::create(0 as *u8, p);
    core::set_view(p, v, views::view_release);
    let tv: *u8 = { rt::msg_id(v, rt::sel(#str_ptr("documentView\0"))) };
    let label: *u8 = compose::placeholder_of(tv);
    assert label != (0 as *u8);

    // Ask the LABEL itself, at a point inside its own bounds. Whatever else
    // is true of the view hierarchy, the overlay must never claim the point.
    let lb: rt::Rect = { rt::msg_rect(label, rt::sel(#str_ptr("bounds\0"))) };
    assert lb.w > 0.0f64;
    assert lb.h > 0.0f64;
    let mid: rt::Point = rt::Point { x: lb.x + (lb.w / 2.0f64), y: lb.y + (lb.h / 2.0f64) };
    let hit: *u8 = { msg_id_point(label, rt::sel(#str_ptr("hitTest:\0")), mid) };
    assert hit == (0 as *u8);
    return;
}

#[link_name = "objc_msgSend"]
extern fn msg_id_point(recv: *u8, sel: *u8, p: rt::Point) -> *u8;

#[test]
fn an_editor_with_no_placeholder_grows_no_label() {
    backend::install();
    var e: core::Node = text_area::text_area("", key: "ph2");
    let v: *u8 = views::create(0 as *u8, #addr_of(e));
    let tv: *u8 = { rt::msg_id(v, rt::sel(#str_ptr("documentView\0"))) };
    assert compose::placeholder_of(tv) == (0 as *u8);
    views::view_release(v);
    return;
}

#[test]
fn a_popup_prompt_is_a_disabled_first_item() {
    // NSPopUpButton shows the SELECTED ITEM and has no prompt slot. So the
    // prompt is an item — and every application index shifts by one, which is
    // the half that would silently pick the wrong row if it were forgotten.
    backend::install();
    var n: core::Node = popup::popup("Choose one", key: "pt", selected_index: -1 as i64);
    let p: *core::Node = #addr_of(n);
    let v: *u8 = views::create(0 as *u8, p);
    core::set_view(p, v, views::view_release);
    set_popup_items(p);
    core::clear_dirty(p);
    core::touch(p, popup::P_ITEMS);
    views::apply(0 as *u8, p);
    let b: ak::PopUpButton = ak::PopUpButton::from_raw(v);
    assert b.number_of_items() == (4 as i64);
    match b.item_at_index(0 as i64) {
        option::Option[ak::MenuItem]::Some(it) => {
            assert it.title().view() == "Choose one";
            assert it.is_enabled() == false;
        }
        option::Option[ak::MenuItem]::None => { assert false; }
    }
    // Nothing chosen: the prompt is what shows.
    assert b.index_of_selected_item() == (0 as i64);
    // And index 1 still means the application's item 1, not the prompt's.
    set_popup_index(p, 1 as i64);
    core::clear_dirty(p);
    core::touch(p, popup::P_SELECTED_INDEX);
    views::apply(0 as *u8, p);
    assert selected_title(b) == "Beta";
    return;
}

#[test]
fn a_popup_with_no_prompt_indexes_its_items_directly() {
    backend::install();
    var n: core::Node = popup::popup("", key: "pt2");
    let p: *core::Node = #addr_of(n);
    let v: *u8 = views::create(0 as *u8, p);
    core::set_view(p, v, views::view_release);
    set_popup_items(p);
    set_popup_index(p, 1 as i64);
    core::clear_dirty(p);
    core::touch(p, popup::P_ITEMS | popup::P_SELECTED_INDEX);
    views::apply(0 as *u8, p);
    let b: ak::PopUpButton = ak::PopUpButton::from_raw(v);
    assert b.number_of_items() == (3 as i64);
    assert selected_title(b) == "Beta";
    return;
}

fn selected_title(b: ak::PopUpButton) -> text::Text {
    return match b.item_at_index(b.index_of_selected_item()) {
        option::Option[ak::MenuItem]::Some(it) => text::from_str(it.title().view()),
        option::Option[ak::MenuItem]::None => text::new(),
    };
}

// A destination list: two sections, a locked device, and a rule between them.
fn dest_enabled(i: usize, ctx: *u8) -> bool {
    if i == (0 as usize) { return false; }        // "iOS — Device", a header
    if i == (2 as usize) { return false; }        // paired, locked
    return true;
}

fn set_dest_items(p: *core::Node) {
    let d: *core::Data = core::node_data(p);
    let pp: *props::PopupProps = { (*d).props } as *props::PopupProps;
    let items: *vocab::TextList = { #addr_of((*pp).items) };
    let _a: status::Status = { (*items).add("iOS — Device") };
    let _b: status::Status = { (*items).add("iPhone 17 Pro — iOS 27.0") };
    let _c: status::Status = { (*items).add("iPhone 15 (locked)") };
    let _d: status::Status = { (*items).add("") };            // a separator
    let _e: status::Status = { (*items).add("iOS — Simulator") };
    return;
}

#[test]
fn a_chooser_says_what_it_IS_separately_from_what_it_SHOWS() {
    // NSPopUpButton displays the selected item, so the collapsed control and
    // the open row were one string: a 74pt toolbar had to read whatever the
    // menu read. `label` is the cell's own title, and it survives a selection.
    backend::install();
    var n: core::Node = popup::popup("", key: "dst", selected_index: 1 as i64);
    let p: *core::Node = #addr_of(n);
    let v: *u8 = views::create(0 as *u8, p);
    core::set_view(p, v, views::view_release);
    set_dest_items(p);
    core::clear_dirty(p);
    core::touch(p, popup::P_ITEMS);
    views::apply(0 as *u8, p);
    let b: ak::PopUpButton = ak::PopUpButton::from_raw(v);
    let cell: *u8 = { rt::msg_id(v, rt::sel(#str_ptr("cell\0"))) };
    let pc: ak::PopUpButtonCell = ak::PopUpButtonCell::from_raw(cell);
    // Nothing said: the button reads its selection, exactly as before.
    assert pc.uses_item_from_menu();

    match popup::find("dst", within: p) {
        option::Option[popup::Popup]::Some(h) => {
            let _l: popup::Popup = h.set_label("iPhone 17 Pro");
        }
        option::Option[popup::Popup]::None => { assert false; }
    }
    views::apply(0 as *u8, p);
    assert pc.uses_item_from_menu() == false;
    match pc.as_menu_item_cell().menu_item() {
        option::Option[ak::MenuItem]::Some(it) => {
            assert it.title().view() == "iPhone 17 Pro";
        }
        option::Option[ak::MenuItem]::None => { assert false; }
    }
    // ...while the ROW keeps the long form.
    assert selected_title(b) == "iPhone 17 Pro — iOS 27.0";

    // And clearing it hands the answer back to the selection.
    match popup::find("dst", within: p) {
        option::Option[popup::Popup]::Some(h) => {
            let _l: popup::Popup = h.set_label("");
        }
        option::Option[popup::Popup]::None => { assert false; }
    }
    views::apply(0 as *u8, p);
    assert pc.uses_item_from_menu();
    return;
}

#[test]
fn a_row_can_be_present_and_not_pickable_and_an_empty_one_is_a_rule() {
    // The two halves of a grouped chooser: a SECTION HEADER is a row that
    // cannot be picked, and so is a device that is paired but locked — hiding
    // it reads as "we cannot see your phone". Both had to be selectable rows
    // that `on_selected_index_changed` caught and put back.
    backend::install();
    var n: core::Node = popup::popup("", key: "dst2");
    let p: *core::Node = #addr_of(n);
    let v: *u8 = views::create(0 as *u8, p);
    core::set_view(p, v, views::view_release);
    set_dest_items(p);
    match popup::find("dst2", within: p) {
        option::Option[popup::Popup]::Some(h) => {
            let _e: popup::Popup = h.set_item_enabled(dest_enabled);
        }
        option::Option[popup::Popup]::None => { assert false; }
    }
    core::clear_dirty(p);
    core::touch(p, popup::P_ITEMS | popup::P_ITEM_ENABLED);
    views::apply(0 as *u8, p);
    let b: ak::PopUpButton = ak::PopUpButton::from_raw(v);
    assert b.number_of_items() == (5 as i64);
    assert popup_item_enabled(b, 0 as i64) == false;   // the header
    assert popup_item_enabled(b, 1 as i64);            // a real destination
    assert popup_item_enabled(b, 2 as i64) == false;   // present, locked
    // The empty title is a separator, which is what an empty title means in
    // every other menu facet builds.
    match b.item_at_index(3 as i64) {
        option::Option[ak::MenuItem]::Some(it) => { assert it.is_separator_item(); }
        option::Option[ak::MenuItem]::None => { assert false; }
    }
    return;
}

fn popup_item_enabled(b: ak::PopUpButton, i: i64) -> bool {
    return match b.item_at_index(i) {
        option::Option[ak::MenuItem]::Some(it) => it.is_enabled(),
        option::Option[ak::MenuItem]::None => false,
    };
}

fn set_popup_items(p: *core::Node) {
    let d: *core::Data = core::node_data(p);
    let pp: *props::PopupProps = { (*d).props } as *props::PopupProps;
    let items: *vocab::TextList = { #addr_of((*pp).items) };
    let _a: status::Status = { (*items).add("Alpha") };
    let _b: status::Status = { (*items).add("Beta") };
    let _c: status::Status = { (*items).add("Gamma") };
    return;
}

fn set_popup_index(p: *core::Node, i: i64) {
    let d: *core::Data = core::node_data(p);
    let pp: *props::PopupProps = { (*d).props } as *props::PopupProps;
    { (*pp).selected_index = i };
    return;
}

#[test]
fn a_search_field_tints_its_own_buttons() {
    // A template image is a MASK, which is what makes it tintable rather than
    // what stops it: drawing it through a colour is the documented way.
    backend::install();
    var n: core::Node = search_field::search_field("", key: "sf",
        search_icon_color: vocab::Color::rgba(1.0f64, 0.0f64, 0.0f64));
    let v: *u8 = views::create(0 as *u8, #addr_of(n));
    let cell: *u8 = { rt::msg_id(v, rt::sel(#str_ptr("cell\0"))) };
    let sb: *u8 = { rt::msg_id(cell, rt::sel(#str_ptr("searchButtonCell\0"))) };
    let img: *u8 = { rt::msg_id(sb, rt::sel(#str_ptr("image\0"))) };
    assert img != (0 as *u8);
    // The tinted copy carries its own colour, so it is no longer a template —
    // a template would be recoloured again by whatever draws it.
    assert { rt::msg_i8(img, rt::sel(#str_ptr("isTemplate\0"))) } == (0 as i8);
    views::view_release(v);
    return;
}

#[test]
fn a_popup_asked_to_sit_at_the_top_moves_its_title() {
    // The one control in the family whose cell is not an NSTextFieldCell.
    // NSPopUpButtonCell descends from NSButtonCell, and what it draws its
    // title inside is `titleRectForBounds:` — which NSCell derives from the
    // drawing rect. So the same hook answers, and this asserts it does rather
    // than assuming the inheritance holds.
    backend::install();
    var plain: core::Node = popup::popup("", key: "pv1");
    let pv: *u8 = views::create(0 as *u8, #addr_of(plain));
    var top: core::Node = popup::popup("", key: "pv2", vertical_align: vocab::TextAlign::Start);
    let tv: *u8 = views::create(0 as *u8, #addr_of(top));
    let pc: *u8 = { rt::msg_id(pv, rt::sel(#str_ptr("cell\0"))) };
    let tc: *u8 = { rt::msg_id(tv, rt::sel(#str_ptr("cell\0"))) };
    let pr: rt::Rect = { msg_rect_of_rect(pc, rt::sel(#str_ptr("titleRectForBounds:\0")), tall()) };
    let tr: rt::Rect = { msg_rect_of_rect(tc, rt::sel(#str_ptr("titleRectForBounds:\0")), tall()) };
    assert tr.y != pr.y;
    views::view_release(pv);
    views::view_release(tv);
    return;
}

// ---- the reads that went stale -----------------------------------------------
// A contract READ answers from the props, and the props were only ever written
// by the application — so a control the USER changed answered with the value
// before the change. `radio.on`, the text controls and `slider.value` were
// written back because something else needed it; the rest were not.

#[test]
fn a_checkbox_the_user_ticked_reads_back_ticked() {
    backend::install();
    var n: core::Node = checkbox::checkbox(false, key: "ck");
    let p: *core::Node = #addr_of(n);
    let v: *u8 = views::create(0 as *u8, p);
    core::set_view(p, v, views::view_release);
    match checkbox::find("ck", within: p) {
        option::Option[checkbox::Checkbox]::Some(h) => { assert h.on() == false; }
        option::Option[checkbox::Checkbox]::None => { assert false; }
    }
    // The user's tick: AppKit flips the state and THEN sends the action, so
    // that is what the test does. `performClick:` would flip it a second time.
    { rt::msg_void_i64(v, rt::sel(#str_ptr("setState:\0")), 1 as i64) };
    send_action(v);
    match checkbox::find("ck", within: p) {
        option::Option[checkbox::Checkbox]::Some(h) => { assert h.on(); }
        option::Option[checkbox::Checkbox]::None => { assert false; }
    }
    return;
}

#[test]
fn a_toggle_the_user_flipped_reads_back_flipped() {
    backend::install();
    var n: core::Node = toggle::toggle(false, key: "tg");
    let p: *core::Node = #addr_of(n);
    let v: *u8 = views::create(0 as *u8, p);
    core::set_view(p, v, views::view_release);
    { rt::msg_void_i64(v, rt::sel(#str_ptr("setState:\0")), 1 as i64) };
    send_action(v);
    match toggle::find("tg", within: p) {
        option::Option[toggle::Toggle]::Some(h) => { assert h.on(); }
        option::Option[toggle::Toggle]::None => { assert false; }
    }
    return;
}

#[test]
fn a_stepper_the_user_moved_reads_back_moved() {
    backend::install();
    var n: core::Node = stepper::stepper(0.0f64, key: "st", maximum: 10.0f64);
    let p: *core::Node = #addr_of(n);
    let v: *u8 = views::create(0 as *u8, p);
    core::set_view(p, v, views::view_release);
    { msg_void_f64_ctrl(v, rt::sel(#str_ptr("setDoubleValue:\0")), 3.0f64) };
    send_action(v);
    match stepper::find("st", within: p) {
        option::Option[stepper::Stepper]::Some(h) => { assert h.value() == 3.0f64; }
        option::Option[stepper::Stepper]::None => { assert false; }
    }
    return;
}

#[link_name = "objc_msgSend"]
extern fn msg_void_f64_ctrl(recv: *u8, sel: *u8, v: f64);

// What AppKit does when a control is used: message the target with the action.
fn send_action(v: *u8) {
    let target: *u8 = { rt::msg_id(v, rt::sel(#str_ptr("target\0"))) };
    let action: *u8 = { rt::msg_id(v, rt::sel(#str_ptr("action\0"))) };
    if target == (0 as *u8) || action == (0 as *u8) { return; }
    { rt::msg_void_id(target, action, v) };
    return;
}

#[test]
fn a_popup_the_user_picked_reads_back_the_applications_index() {
    // And NOT the native one: the prompt occupies row 0, so the two differ by
    // exactly the offset `apply_popup` adds on the way in.
    backend::install();
    var n: core::Node = popup::popup("Choose", key: "pk");
    let p: *core::Node = #addr_of(n);
    let v: *u8 = views::create(0 as *u8, p);
    core::set_view(p, v, views::view_release);
    set_popup_items(p);
    core::clear_dirty(p);
    core::touch(p, popup::P_ITEMS);
    views::apply(0 as *u8, p);
    let b: ak::PopUpButton = ak::PopUpButton::from_raw(v);
    // Native row 2 is the application's item 1. The action is SENT rather
    // than clicked: `performClick:` on a popup opens its menu and runs a modal
    // event loop, which in a test is a hang.
    b.select_item_at_index(2 as i64);
    send_action(v);
    match popup::find("pk", within: p) {
        option::Option[popup::Popup]::Some(h) => { assert h.selected_index() == (1 as i64); }
        option::Option[popup::Popup]::None => { assert false; }
    }
    return;
}

#[test]
fn a_date_picker_the_user_moved_reads_back_that_civil_date() {
    // The write-back has to use the PAIR of the function that wrote it, or a
    // date read through a different calendar drifts by a day at the boundary.
    backend::install();
    var n: core::Node = date_picker::date_picker(vocab::Date { year: 2020 as i64, month: 1 as i64, day: 1 as i64 },
                                                 key: "dp");
    let p: *core::Node = #addr_of(n);
    let v: *u8 = views::create(0 as *u8, p);
    core::set_view(p, v, views::view_release);
    // 2026-08-05, as an NSDate at UTC midnight.
    let want: vocab::Date = vocab::Date { year: 2026 as i64, month: 8 as i64, day: 5 as i64 };
    { rt::msg_void_id(v, rt::sel(#str_ptr("setDateValue:\0")), controls::ns_date(want)) };
    send_action(v);
    match date_picker::find("dp", within: p) {
        option::Option[date_picker::DatePicker]::Some(h) => {
            let got: vocab::Date = h.date();
            assert got.year == (2026 as i64);
            assert got.month == (8 as i64);
            assert got.day == (5 as i64);
        }
        option::Option[date_picker::DatePicker]::None => { assert false; }
    }
    return;
}

#[test]
fn a_time_picker_the_user_moved_reads_back_the_time_of_day() {
    backend::install();
    var n: core::Node = time_picker::time_picker(vocab::Duration { seconds: 0.0f64 }, key: "tp");
    let p: *core::Node = #addr_of(n);
    let v: *u8 = views::create(0 as *u8, p);
    core::set_view(p, v, views::view_release);
    // Nine-thirty in the morning, on a day 20000 days after the epoch: the
    // DATE has to come off and leave only the time.
    let secs: f64 = 20000.0f64 * 86400.0f64 + 9.5f64 * 3600.0f64;
    { rt::msg_void_id(v, rt::sel(#str_ptr("setDateValue:\0")),
                      { rt::msg_id_f64(rt::get_class(#str_ptr("NSDate\0")),
                                       rt::sel(#str_ptr("dateWithTimeIntervalSince1970:\0")), secs) }) };
    send_action(v);
    match time_picker::find("tp", within: p) {
        option::Option[time_picker::TimePicker]::Some(h) => {
            assert h.time().seconds == (9.5f64 * 3600.0f64);
        }
        option::Option[time_picker::TimePicker]::None => { assert false; }
    }
    return;
}

#[test]
fn a_civil_date_survives_the_round_trip() {
    // The pair, asserted directly: every boundary a calendar gets wrong.
    assert_roundtrip(1970 as i64, 1 as i64, 1 as i64);
    assert_roundtrip(2000 as i64, 2 as i64, 29 as i64);
    assert_roundtrip(2026 as i64, 12 as i64, 31 as i64);
    assert_roundtrip(2100 as i64, 3 as i64, 1 as i64);
    return;
}

fn assert_roundtrip(y: i64, m: i64, d: i64) {
    let back: vocab::Date = controls::civil_from_days(controls::days_from_civil(y, m, d));
    assert back.year == y;
    assert back.month == m;
    assert back.day == d;
    return;
}

// ---- the refresh band --------------------------------------------------------
// "Pull-to-refresh is a touch idiom" is true about the GESTURE and was being
// read as a claim about the feature. facet's own rule says what to do with a
// gesture-only affordance: an agent has no hands, so add a click path.

static REFRESHES: i64 = 0 as i64;
fn on_refreshing_h(sender: *u8, ctx: *u8) { REFRESHES = REFRESHES + (1 as i64); return; }
fn h_refreshing() -> fn(*u8, *u8) { let f: fn(*u8, *u8) = on_refreshing_h; return f; }

#[test]
fn a_refreshable_that_is_not_refreshable_shows_no_affordance() {
    backend::install();
    var r: core::Node = refreshable::refreshable(key: "rf0");
    let v: *u8 = views::create(0 as *u8, #addr_of(r));
    assert compose::refresh_strip_of(v) == (0 as *u8);
    views::view_release(v);
    return;
}

#[test]
fn a_refreshable_offers_a_click_path_and_reports_the_refresh() {
    backend::install();
    REFRESHES = 0 as i64;
    var r: core::Node = refreshable::refreshable(key: "rf1", refreshable: true,
                                                 on_refreshing: h_refreshing());
    let p: *core::Node = #addr_of(r);
    let v: *u8 = views::create(0 as *u8, p);
    core::set_view(p, v, views::view_release);
    let strip: *u8 = compose::refresh_strip_of(v);
    assert strip != (0 as *u8);
    // Idle: the button shows, the spinner does not.
    let button: *u8 = compose::refresh_button_of(strip);
    assert button != (0 as *u8);
    assert { rt::msg_i8(button, rt::sel(#str_ptr("isHidden\0"))) } == (0 as i8);
    assert { rt::msg_i8(compose::refresh_spinner_of(v), rt::sel(#str_ptr("isHidden\0"))) } != (0 as i8);
    // A click is the whole point: it reports, and `is_refreshing` is already
    // true by the time the handler runs.
    send_action(button);
    assert REFRESHES == (1 as i64);
    match refreshable::find("rf1", within: p) {
        option::Option[refreshable::Refreshable]::Some(h) => { assert h.is_refreshing(); }
        option::Option[refreshable::Refreshable]::None => { assert false; }
    }
    // And the two faces have swapped.
    assert { rt::msg_i8(button, rt::sel(#str_ptr("isHidden\0"))) } != (0 as i8);
    assert { rt::msg_i8(compose::refresh_spinner_of(v), rt::sel(#str_ptr("isHidden\0"))) } == (0 as i8);
    return;
}

#[test]
fn a_lists_refresh_strip_floats_over_its_scroll() {
    // NSScrollView's own slot for a thing pinned to the top of the content —
    // which is exactly this shape, and is why the list half cost nothing extra.
    backend::install();
    var l: core::Node = list::list(key: "rl", refreshable: true, on_refreshing: h_refreshing());
    let p: *core::Node = #addr_of(l);
    let v: *u8 = views::create(0 as *u8, p);
    core::set_view(p, v, views::view_release);
    let strip: *u8 = compose::refresh_strip_of(v);
    assert strip != (0 as *u8);
    // Floating means it does NOT ride the document view, so it does not
    // scroll away with the rows — that is the whole reason to use AppKit's own
    // slot rather than adding a subview.
    assert { rt::msg_i8_id(strip, rt::sel(#str_ptr("isDescendantOf:\0")), v) } != (0 as i8);
    let doc: *u8 = { rt::msg_id(v, rt::sel(#str_ptr("documentView\0"))) };
    assert { rt::msg_i8_id(strip, rt::sel(#str_ptr("isDescendantOf:\0")), doc) } == (0 as i8);
    return;
}

#[test]
fn begin_refresh_is_the_command_an_agent_has() {
    backend::install();
    REFRESHES = 0 as i64;
    var l: core::Node = list::list(key: "rl2", refreshable: true, on_refreshing: h_refreshing());
    let p: *core::Node = #addr_of(l);
    let v: *u8 = views::create(0 as *u8, p);
    core::set_view(p, v, views::view_release);
    core::clear_dirty(p);
    match list::find("rl2", within: p) {
        option::Option[list::List]::Some(h) => { let _x: list::List = h.begin_refresh(); }
        option::Option[list::List]::None => { assert false; }
    }
    views::apply(0 as *u8, p);
    assert REFRESHES == (1 as i64);
    assert compose::refresh_spinner_of(v) != (0 as *u8);
    assert { rt::msg_i8(compose::refresh_spinner_of(v), rt::sel(#str_ptr("isHidden\0"))) } == (0 as i8);
    // And end_refresh puts the button back.
    core::clear_dirty(p);
    match list::find("rl2", within: p) {
        option::Option[list::List]::Some(h) => { let _x: list::List = h.end_refresh(); }
        option::Option[list::List]::None => { assert false; }
    }
    views::apply(0 as *u8, p);
    assert { rt::msg_i8(compose::refresh_spinner_of(v), rt::sel(#str_ptr("isHidden\0"))) } != (0 as i8);
    match list::find("rl2", within: p) {
        option::Option[list::List]::Some(h) => { assert h.is_refreshing() == false; }
        option::Option[list::List]::None => { assert false; }
    }
    return;
}

#[test]
fn a_refresh_that_is_not_allowed_shows_a_disabled_button() {
    backend::install();
    var l: core::Node = list::list(key: "rl3", refreshable: true, refresh: false, on_refreshing: h_refreshing());
    let p: *core::Node = #addr_of(l);
    let v: *u8 = views::create(0 as *u8, p);
    core::set_view(p, v, views::view_release);
    let button: *u8 = compose::refresh_button_of(compose::refresh_strip_of(v));
    assert { rt::msg_i8(button, rt::sel(#str_ptr("isEnabled\0"))) } == (0 as i8);
    return;
}

#[test]
fn a_refresh_colour_tints_the_spinner() {
    // An indeterminate spinner is uniform, so mapping it onto one colour IS
    // what tinting it means. The determinate BAR stays in the ledger: a
    // monochrome filter would flatten its fill and its track together.
    backend::install();
    var r: core::Node = refreshable::refreshable(key: "rf2", refreshable: true, refreshing: true,
        refresh_color: vocab::Color::rgba(1.0f64, 0.0f64, 0.0f64));
    let v: *u8 = views::create(0 as *u8, #addr_of(r));
    let spinner: *u8 = compose::refresh_spinner_of(v);
    assert spinner != (0 as *u8);
    let filters: *u8 = { rt::msg_id(spinner, rt::sel(#str_ptr("contentFilters\0"))) };
    assert { rt::msg_u64(filters, rt::sel(#str_ptr("count\0"))) } == (1 as u64);
    views::view_release(v);
    return;
}

// ---- swipe items, reachable ---------------------------------------------------

static SWIPE_CLICKS: i64 = 0 as i64;
static SWIPE_INVOKES: i64 = 0 as i64;
static SWIPE_OPENS: i64 = 0 as i64;
static SWIPE_STARTS: i64 = 0 as i64;
static SWIPE_CLOSES: i64 = 0 as i64;
static SWIPE_ENDS: i64 = 0 as i64;
fn sw_clicked(sender: *u8, ctx: *u8) { SWIPE_CLICKS = SWIPE_CLICKS + (1 as i64); return; }
fn sw_invoked(sender: *u8, ctx: *u8) { SWIPE_INVOKES = SWIPE_INVOKES + (1 as i64); return; }
fn sw_opened(sender: *u8, ctx: *u8) { SWIPE_OPENS = SWIPE_OPENS + (1 as i64); return; }
fn sw_started(sender: *u8, ctx: *u8) { SWIPE_STARTS = SWIPE_STARTS + (1 as i64); return; }
fn sw_closed(sender: *u8, ctx: *u8) { SWIPE_CLOSES = SWIPE_CLOSES + (1 as i64); return; }
fn sw_ended(sender: *u8, ctx: *u8) { SWIPE_ENDS = SWIPE_ENDS + (1 as i64); return; }

fn swipe_tree(key: str) -> core::Node {
    let a: fn(*u8, *u8) = sw_clicked;
    let b: fn(*u8, *u8) = sw_invoked;
    var s: core::Node = swipeable::swipeable(key: key,
        on_open_requested: sw_opened, on_swipe_started: sw_started,
        on_close_requested: sw_closed, on_swipe_ended: sw_ended);
    s.add_child(swipe_item::swipe_item(text: "Archive", icon: "archivebox"));
    s.add_child(swipe_item::swipe_item(text: "Delete", destructive: true,
                                       on_clicked: a, on_invoked: b));
    return s;
}

#[test]
fn a_swipeables_items_become_the_menu_it_reveals() {
    backend::install();
    var s: core::Node = swipe_tree("sw");
    let v: *u8 = views::create(0 as *u8, #addr_of(s));
    let menu: *u8 = { rt::msg_id(v, rt::sel(#str_ptr("menu\0"))) };
    assert menu != (0 as *u8);
    assert { rt::msg_i64(menu, rt::sel(#str_ptr("numberOfItems\0"))) } == (2 as i64);
    assert menu_title_at(menu, 0 as i64) == "Archive";
    assert menu_title_at(menu, 1 as i64) == "Delete";
    // The icon reached the row.
    let first: *u8 = { rt::msg_id_i64(menu, rt::sel(#str_ptr("itemAtIndex:\0")), 0 as i64) };
    assert { rt::msg_id(first, rt::sel(#str_ptr("image\0"))) } != (0 as *u8);
    // Destructive is a red title, which is what every app that marks one does.
    let second: *u8 = { rt::msg_id_i64(menu, rt::sel(#str_ptr("itemAtIndex:\0")), 1 as i64) };
    assert { rt::msg_id(second, rt::sel(#str_ptr("attributedTitle\0"))) } != (0 as *u8);
    views::view_release(v);
    return;
}

#[test]
fn a_swipe_item_fires_both_of_its_names() {
    // `SwipeItem.Invoked` is the ledger's second name for the same moment, so both
    // run — an application that wired either gets it.
    backend::install();
    SWIPE_CLICKS = 0 as i64;
    SWIPE_INVOKES = 0 as i64;
    var s: core::Node = swipe_tree("sw2");
    let v: *u8 = views::create(0 as *u8, #addr_of(s));
    let menu: *u8 = { rt::msg_id(v, rt::sel(#str_ptr("menu\0"))) };
    let item: *u8 = { rt::msg_id_i64(menu, rt::sel(#str_ptr("itemAtIndex:\0")), 1 as i64) };
    let target: *u8 = { rt::msg_id(item, rt::sel(#str_ptr("target\0"))) };
    let action: *u8 = { rt::msg_id(item, rt::sel(#str_ptr("action\0"))) };
    assert target != (0 as *u8);
    { rt::msg_void_id(target, action, item) };
    assert SWIPE_CLICKS == (1 as i64);
    assert SWIPE_INVOKES == (1 as i64);
    views::view_release(v);
    return;
}

#[test]
fn a_swipes_edges_are_the_menus_edges() {
    backend::install();
    SWIPE_OPENS = 0 as i64;
    SWIPE_STARTS = 0 as i64;
    SWIPE_CLOSES = 0 as i64;
    SWIPE_ENDS = 0 as i64;
    var s: core::Node = swipe_tree("sw3");
    let p: *core::Node = #addr_of(s);
    let v: *u8 = views::create(0 as *u8, p);
    core::set_view(p, v, views::view_release);
    let menu: *u8 = { rt::msg_id(v, rt::sel(#str_ptr("menu\0"))) };
    let d: *u8 = { rt::msg_id(menu, rt::sel(#str_ptr("delegate\0"))) };
    assert d != (0 as *u8);
    { rt::msg_void_id(d, rt::sel(#str_ptr("menuWillOpen:\0")), menu) };
    assert SWIPE_OPENS == (1 as i64);
    assert SWIPE_STARTS == (1 as i64);
    { rt::msg_void_id(d, rt::sel(#str_ptr("menuDidClose:\0")), menu) };
    assert SWIPE_CLOSES == (1 as i64);
    assert SWIPE_ENDS == (1 as i64);
    return;
}

// ---- the picker's popover ----------------------------------------------------
// "A field-with-stepper has no popover to open" is true of that ONE control and
// was standing in for the whole question: a graphical NSDatePicker exists, an
// NSPopover exists, and putting the first inside the second is what every
// macOS app that offers a calendar does.

static PICKER_OPENS: i64 = 0 as i64;
static PICKER_CLOSES: i64 = 0 as i64;
fn pk_opened(sender: *u8, ctx: *u8) { PICKER_OPENS = PICKER_OPENS + (1 as i64); return; }
fn pk_closed(sender: *u8, ctx: *u8) { PICKER_CLOSES = PICKER_CLOSES + (1 as i64); return; }

#[test]
fn a_date_picker_that_never_opens_builds_no_popover() {
    backend::install();
    var n: core::Node = date_picker::date_picker(vocab::Date { year: 2026 as i64, month: 1 as i64, day: 1 as i64 },
                                                 key: "dpc");
    let v: *u8 = views::create(0 as *u8, #addr_of(n));
    assert compose::popover_of(v) == (0 as *u8);
    views::view_release(v);
    return;
}

#[test]
fn opening_a_date_picker_shows_a_calendar_bound_to_the_same_value() {
    backend::install();
    PICKER_OPENS = 0 as i64;
    PICKER_CLOSES = 0 as i64;
    let o: fn(*u8, *u8) = pk_opened;
    let c: fn(*u8, *u8) = pk_closed;
    var n: core::Node = date_picker::date_picker(vocab::Date { year: 2026 as i64, month: 8 as i64, day: 5 as i64 },
                                                 key: "dpo", on_opened: o, on_closed: c);
    let p: *core::Node = #addr_of(n);
    let v: *u8 = views::create(0 as *u8, p);
    core::set_view(p, v, views::view_release);
    // A real window, because a popover anchors to a view that is ON one — and
    // AppKit raises rather than declining when it is not.
    let w: ak::Window = window::make_shell_window(screen::Chrome::new(
        title: "picker", width: 300.0f64, height: 200.0f64));
    match w.content_view() {
        option::Option[ak::View]::Some(cv) => { cv.add_subview(ak::View::from_raw(v)); }
        option::Option[ak::View]::None => { assert false; }
    }
    // On screen: a popover does not show relative to a view in a window that
    // has never been displayed, and `isShown` is how it says so.
    w.make_key_and_order_front(0 as *u8);
    { rt::msg_void_rect(v, rt::sel(#str_ptr("setFrame:\0")),
                        rt::Rect { x: 0.0f64, y: 0.0f64, w: 140.0f64, h: 24.0f64 }) };
    core::clear_dirty(p);
    match date_picker::find("dpo", within: p) {
        option::Option[date_picker::DatePicker]::Some(h) => { let _x: date_picker::DatePicker = h.set_open(true); }
        option::Option[date_picker::DatePicker]::None => { assert false; }
    }
    views::apply(0 as *u8, p);
    let pop: *u8 = compose::popover_of(v);
    assert pop != (0 as *u8);
    assert compose::picker_is_open(v);
    // The EDGES are asserted by messaging the delegate, not by waiting: AppKit
    // delivers popoverDidShow: after its own animation, and a test that spun
    // the run loop would be asserting Apple's timing rather than our wiring.
    let d: *u8 = { rt::msg_id(pop, rt::sel(#str_ptr("delegate\0"))) };
    assert d != (0 as *u8);
    { rt::msg_void_id(d, rt::sel(#str_ptr("popoverDidShow:\0")), 0 as *u8) };
    assert PICKER_OPENS == (1 as i64);
    // The calendar shows what the field shows.
    let vc: *u8 = { rt::msg_id(pop, rt::sel(#str_ptr("contentViewController\0"))) };
    let cal: *u8 = { rt::msg_id(vc, rt::sel(#str_ptr("view\0"))) };
    assert { rt::msg_i8_id(cal, rt::sel(#str_ptr("isKindOfClass:\0")),
                           rt::get_class(#str_ptr("NSDatePicker\0"))) } != (0 as i8);
    assert { rt::msg_u64(cal, rt::sel(#str_ptr("datePickerStyle\0"))) } == (1 as u64);
    // And it is showing the SAME date, not its own default.
    let a: f64 = { rt::msg_f64({ rt::msg_id(cal, rt::sel(#str_ptr("dateValue\0"))) },
                               rt::sel(#str_ptr("timeIntervalSince1970\0"))) };
    let b: f64 = { rt::msg_f64({ rt::msg_id(v, rt::sel(#str_ptr("dateValue\0"))) },
                               rt::sel(#str_ptr("timeIntervalSince1970\0"))) };
    assert a == b;

    // Closing it fires the other edge and stops `is_open` claiming otherwise.
    core::clear_dirty(p);
    match date_picker::find("dpo", within: p) {
        option::Option[date_picker::DatePicker]::Some(h) => { let _x: date_picker::DatePicker = h.set_open(false); }
        option::Option[date_picker::DatePicker]::None => { assert false; }
    }
    views::apply(0 as *u8, p);
    // NOT `isShown == false` here: AppKit animates a popover closed and only
    // clears the flag when the animation ends, so asserting it would be
    // asserting Apple's timing. What is ours is that the close was ISSUED and
    // that the edge writes the contract back.
    { rt::msg_void_id(d, rt::sel(#str_ptr("popoverDidClose:\0")), 0 as *u8) };
    assert PICKER_CLOSES == (1 as i64);
    // And the close writes `is_open` back, so a user dismissal does not leave
    // the contract claiming it is still open.
    match date_picker::find("dpo", within: p) {
        option::Option[date_picker::DatePicker]::Some(h) => { assert h.is_open() == false; }
        option::Option[date_picker::DatePicker]::None => { assert false; }
    }
    w.close();
    return;
}

#[test]
fn the_calendar_writes_its_pick_through_the_field() {
    // One value, one write-back path: the popover is a second FACE on the same
    // control, not a second source of truth.
    backend::install();
    var n: core::Node = date_picker::date_picker(vocab::Date { year: 2026 as i64, month: 8 as i64, day: 5 as i64 },
                                                 key: "dpw");
    let p: *core::Node = #addr_of(n);
    let v: *u8 = views::create(0 as *u8, p);
    core::set_view(p, v, views::view_release);
    let w: ak::Window = window::make_shell_window(screen::Chrome::new(
        title: "picker2", width: 300.0f64, height: 200.0f64));
    match w.content_view() {
        option::Option[ak::View]::Some(cv) => { cv.add_subview(ak::View::from_raw(v)); }
        option::Option[ak::View]::None => { assert false; }
    }
    core::clear_dirty(p);
    match date_picker::find("dpw", within: p) {
        option::Option[date_picker::DatePicker]::Some(h) => { let _x: date_picker::DatePicker = h.set_open(true); }
        option::Option[date_picker::DatePicker]::None => { assert false; }
    }
    views::apply(0 as *u8, p);
    let pop: *u8 = compose::popover_of(v);
    assert pop != (0 as *u8);
    let vc: *u8 = { rt::msg_id(pop, rt::sel(#str_ptr("contentViewController\0"))) };
    let cal: *u8 = { rt::msg_id(vc, rt::sel(#str_ptr("view\0"))) };
    // The user picks a different day in the calendar.
    let want: vocab::Date = vocab::Date { year: 2026 as i64, month: 12 as i64, day: 25 as i64 };
    { rt::msg_void_id(cal, rt::sel(#str_ptr("setDateValue:\0")), controls::ns_date(want)) };
    send_action(cal);
    match date_picker::find("dpw", within: p) {
        option::Option[date_picker::DatePicker]::Some(h) => {
            let got: vocab::Date = h.date();
            assert got.year == (2026 as i64);
            assert got.month == (12 as i64);
            assert got.day == (25 as i64);
        }
        option::Option[date_picker::DatePicker]::None => { assert false; }
    }
    w.close();
    return;
}

#[test]
fn a_time_picker_opens_a_clock() {
    backend::install();
