// facet_appkit input — the gesture band, the key band, and the sender readers.
//
// Stage 4 item 4. Three of facet's install slots are filled here, and one rule
// shapes all of it: THE DECLINE CHAIN. A gesture handler answers `bool`, and
// `false` means "not mine" — the event must then continue exactly as if facet
// had never looked at it.
//
// ---- why a dynamic subclass and not NSGestureRecognizer ----------------------
//
// A recognizer cannot decline. By the time its action fires it has already
// claimed the event, and there is no way to put it back. The only thing on
// AppKit that continues an event is `[super mouseDown:]` — the responder chain
// picking up where it left off — so the handlers have to BE the view's event
// methods.
//
// But gestures are a MODIFIER on any node (see facet's gestures.cplus), and the
// backing view of a node is whatever its kind needs: an NSButton, an
// NSTextField, an NSScrollView. facet cannot hand out one gesture view class
// without changing what a control IS.
//
// So the class is made at runtime, per backing class, and the view's isa is
// moved onto it — the same technique KVO uses, for the same reason. NSButton
// stays an NSButton; it gains overrides that call super when the app declines.
// One subclass per backing class, cached, so a thousand gesture rows over three
// control kinds make three classes.
//
// ---- what is NOT here --------------------------------------------------------
//
// `on_pinch` is wired to `magnifyWithEvent:` but the window-level pinch-to-zoom
// path is its own thing (see facet's pinch memory: SCALE only, no reflow).
// Scroll is not a gesture: facet routes it through the scroll control, and the
// nested-axis rule lives in FacetScrollView.

import "stdlib/option" as option;
import "stdlib/io" as io;
import "stdlib/env" as env;
import "stdlib/text" as text;
import "stdlib/status" as status;
import "flex_layout/flex_layout" as flex;
import "facet/facet" as core;
import "facet/props" as props;
import "facet/gestures" as gestures;
import "facet/vocabulary" as vocab;
import "./pointer" as pointer;
import "facet/component" as component;
import "objc/runtime" as rt;
import "objc/synthesis" as synth;
import "objc/bridge" as bridge;
import "appkit/appkit" as ak;
import "appkit/appkit_ext" as akx;

// ---- the objc runtime pieces the synthesis module does not export ------------

extern fn object_setClass(obj: *u8, cls: *u8) -> *u8;
extern fn class_getSuperclass(cls: *u8) -> *u8;
extern fn class_getName(cls: *u8) -> *u8;
extern fn class_getMethodImplementation(cls: *u8, sel: *u8) -> *u8;

#[link_name = "class_addMethod"]
extern fn add_method_i8_0(cls: *u8, sel: *u8, imp: fn(*u8, *u8) -> i8, types: *u8) -> i8;

#[link_name = "class_addMethod"]
extern fn add_method_id_point(cls: *u8, sel: *u8, imp: fn(*u8, *u8, rt::Point) -> *u8,
                              types: *u8) -> i8;

#[link_name = "class_addMethod"]
extern fn add_method_u64_1id(cls: *u8, sel: *u8, imp: fn(*u8, *u8, *u8) -> u64,
                             types: *u8) -> i8;

#[link_name = "objc_msgSend"]
extern fn msg_point_id(recv: *u8, sel: *u8, a: *u8) -> rt::Point;

#[link_name = "objc_msgSendSuper"]
extern fn msg_super_id_point(s: *SuperRef, sel: *u8, p: rt::Point) -> *u8;

#[repr(C)]
// Both fields are BORROWED: the receiver is the view (mount owns it) and the
// class is the runtime's. Nothing here frees either.
struct SuperRef { opaque receiver: *u8, opaque super_class: *u8 }

// ---- tracing -----------------------------------------------------------------
// `FACET_TRACE=1` turns on a line per armed view and a line per event. It is
// off by default and costs one bool read when it is, because the alternative —
// asking a user to describe what a pointer did — is not a way to find a bug.
//
//     FACET_TRACE=1 ./target/debug/gesture_probe 2>&1 | tee /tmp/facet.log
//
// Written to STDERR and unbuffered, so a line is on screen the moment it
// happens rather than at exit.

static TRACE_READ: bool = false;
static TRACE_ON: bool = false;

fn tracing() -> bool {
    if !TRACE_READ {
        TRACE_READ = true;
        TRACE_ON = env::has_var("FACET_TRACE");
    }
    return TRACE_ON;
}

fn trace(s: str) {
    if !tracing() { return; }
    io::eprintln(s);
    return;
}

fn trace2(a: str, b: str) {
    if !tracing() { return; }
    var t: text::Text = text::from_str(a);
    let _x: status::Status = t.append(b);
    io::eprintln(t.view());
    return;
}

fn trace_ptr(a: str, p: *u8) {
    if !tracing() { return; }
    var t: text::Text = text::from_str(a);
    if p == (0 as *u8) { let _z: status::Status = t.append(" <null>"); }
    else { let _z: status::Status = t.append(" <set>"); }
    io::eprintln(t.view());
    return;
}

// The class a view is currently of, by name — the one fact that says whether
// arming happened at all.
fn class_name_of(v: *u8) -> text::Text {
    if v == (0 as *u8) { return text::from_str("<null view>"); }
    // NSStringFromClass, so the C string does not have to be walked by hand.
    let ns: *u8 = { rt::msg_id(v, rt::sel(#str_ptr("className\0"))) };
    if ns == (0 as *u8) { return text::from_str("<no name>"); }
    return bridge::to_text(ns);
}

// ---- associated keys ---------------------------------------------------------
// facet_appkit owns 29000 and up, in one block per file:
//
//   drawing 29000   input 29010   web 29020   recycler 29030   dialogs 29040
//   text_input 29050   scrolling 29060   bordered stroke 29070   compose 29080
//
// NOT 28xxx, which is where `cpc-bindgen` allocates the generated binding's own
// delegate keys from — appkit.cplus is already at 28733 and grows with the SDK.
// An associated key is per-object, so an overlap is silent until the day one
// lands on the same object twice; `keys_are_distinct` is the gate, and the
// range is what keeps the gate from having to be re-won on every regen.

fn node_key() -> *u8 { return { 29010 as *u8 }; }
fn armed_key() -> *u8 { return { 29011 as *u8 }; }
fn long_press_key() -> *u8 { return { 29012 as *u8 }; }
fn item_key() -> *u8 { return { 29013 as *u8 }; }
fn tracking_key() -> *u8 { return { 29014 as *u8 }; }
// Is the pointer down on this view right now? Only a canvas asks, and only to
// tell an abandoned press from a plain unhover.
fn pressed_key() -> *u8 { return { 29016 as *u8 }; }

fn is_pressed(v: *u8) -> bool { return { synth::get_associated(v, pressed_key()) } != (0 as *u8); }

// The node a view carries gestures for, or null.
fn node_of_view(v: *u8) -> *core::Node {
    if v == (0 as *u8) { return 0 as *core::Node; }
    return { synth::get_associated(v, node_key()) as *core::Node };
}

fn gestures_of_view(v: *u8) -> *gestures::Gestures {
    let n: *core::Node = node_of_view(v);
    if n == (0 as *core::Node) { return 0 as *gestures::Gestures; }
    return gestures::gestures_of(n);
}

// Fire one handler off the view's node. False when there is nothing to fire or
// the app declined — either way the caller falls through to super.
fn fire_of(self_obj: *u8, h: gestures::Handler, ctx: *u8) -> bool {
    let n: *core::Node = node_of_view(self_obj);
    if n == (0 as *core::Node) {
        trace("[input]   fire: NO NODE on this view — the association is missing");
        return false;
    }
    if h == gestures::no_gesture {
        trace("[input]   fire: no handler for this verb");
        return false;
    }
    let took: bool = gestures::fire(n, h, ctx);
    if took { trace("[input]   fire: handler TOOK it"); }
    else { trace("[input]   fire: handler DECLINED"); }
    return took;
}

// ---- super dispatch ----------------------------------------------------------
// `self`'s class is OUR subclass, so its superclass is the original backing
// class and the ordinary responder behaviour lives there.

// The class an armed view's overrides fall through to — its ORIGINAL backing
// class. Public because the suite asserts the subclass relationship: that is
// what makes the decline chain reachable at all.
fn class_super(cls: *u8) -> *u8 { return class_getSuperclass(cls); }

fn super_of(self_obj: *u8) -> *u8 {
    return class_getSuperclass(synth::object_class(self_obj));
}

fn decline(self_obj: *u8, cmd: *u8, event: *u8) {
    akx::call_super_void_id(self_obj, super_of(self_obj), cmd, event);
    return;
}

// ---- the pointer band --------------------------------------------------------

fn imp_mouse_down(self_obj: *u8, cmd: *u8, event: *u8) {
    trace("[input] event mouseDown:");
    // The CONTROL's own press verb first — `button.on_pressed` is not a
    // gesture and an application that used it never wrote `.gesture(...)`.
    // It never takes the event: a button still has to click.
    synth::set_associated(self_obj, pressed_key(), 1 as *u8);
    let own_n: *core::Node = node_of_view(self_obj);
    if own_n != (0 as *core::Node) { let _p: bool = pointer::press(own_n, self_obj); }
    let g: *gestures::Gestures = gestures_of_view(self_obj);
    if g == (0 as *gestures::Gestures) { decline(self_obj, cmd, event); return; }
    // `.window_drag()` — the surface an application marks so a CUSTOM titlebar
    // can move the window. `Bar::Custom` hides the real traffic lights and
    // `window_buttons()` supplies its own, and this is the third piece of that
    // answer; without it a custom titlebar was a bar you could not drag the
    // window by. `drags_window` had ZERO readers in this package, and a comment
    // in window.cplus described the reader as though it existed.
    //
    // AppKit does the whole drag from one call: it takes over the event loop
    // until the mouse comes up, which is why nothing below runs afterwards and
    // why this cannot be combined with the pan gesture on the same node.
    if { (*g).drags_window } {
        match ak::View::from_raw(self_obj).window() {
            option::Option[ak::Window]::Some(w) => {
                // DOUBLE-CLICK ZOOMS, and it has to be answered first: the drag
                // call below takes over the event loop until mouse-up, so the
                // second click of a double never arrives. On macOS this gesture
                // is the only way to zoom a window whose titlebar is
                // transparent and whose bar the app draws itself — which is
                // every Bar::Blended screen.
                //
                // The old backend had this branch (appkit_ext.old:1631) and
                // regeneration dropped it, leaving the drag unconditional.
                if { rt::msg_i64(event, rt::sel(#str_ptr("clickCount\0"))) } >= (2 as i64) {
                    { rt::msg_void_id(w.raw(), rt::sel(#str_ptr("performZoom:\0")), self_obj) };
                    return;
                }
                w.perform_window_drag_with_event(ak::Event::from_raw(event));
                return;
            }
            option::Option[ak::Window]::None => { }
        }
    }
    // A long press is a press that OUTLASTS a timer, so it is armed here and
    // disarmed on the way up. `after` returns a token; the token is the timer.
    let lp: gestures::Handler = { (*g).on_long_press };
    if lp != gestures::no_gesture {
        let id: u64 = akx::after({ (*g).long_press_seconds }, long_press_fired, self_obj);
        synth::set_associated(self_obj, long_press_key(), id as *u8);
    }
    var took: bool = fire_of(self_obj, { (*g).on_press }, { (*g).on_press_ctx });
    if took { return; }
    decline(self_obj, cmd, event);
    return;
}

fn long_press_fired(ctx: *u8) {
    synth::set_associated(ctx, long_press_key(), 0 as *u8);
    let g: *gestures::Gestures = gestures_of_view(ctx);
    if g == (0 as *gestures::Gestures) { return; }
    let _took: bool = fire_of(ctx, { (*g).on_long_press }, { (*g).on_long_press_ctx });
    return;
}

fn cancel_long_press(self_obj: *u8) {
    let id: u64 = { synth::get_associated(self_obj, long_press_key()) as u64 };
    if id != (0 as u64) {
        akx::cancel_after(id);
        synth::set_associated(self_obj, long_press_key(), 0 as *u8);
    }
    return;
}

fn imp_mouse_up(self_obj: *u8, cmd: *u8, event: *u8) {
    trace("[input] event mouseUp:");
    cancel_long_press(self_obj);
    synth::set_associated(self_obj, pressed_key(), 0 as *u8);
    let own_n: *core::Node = node_of_view(self_obj);
    if own_n != (0 as *core::Node) { let _r: bool = pointer::release(own_n, self_obj); }
    let g: *gestures::Gestures = gestures_of_view(self_obj);
    if g == (0 as *gestures::Gestures) { decline(self_obj, cmd, event); return; }
    var took: bool = fire_of(self_obj, { (*g).on_release }, { (*g).on_release_ctx });
    // A click is a completed press, so it is reported on the way UP — the same
    // moment NSButton considers itself clicked, and the reason a drag off the
    // control does not fire one.
    let clicks: i64 = akx::wd_click_count(event);
    if clicks >= (2 as i64) {
        if fire_of(self_obj, { (*g).on_double_click }, { (*g).on_double_click_ctx }) { took = true; }
    } else {
        if fire_of(self_obj, { (*g).on_click }, { (*g).on_click_ctx }) { took = true; }
    }
    if took { return; }
    decline(self_obj, cmd, event);
    return;
}

fn imp_right_mouse_down(self_obj: *u8, cmd: *u8, event: *u8) {
    trace("[input] event rightMouseDown:");
    let g: *gestures::Gestures = gestures_of_view(self_obj);
    if g == (0 as *gestures::Gestures) { decline(self_obj, cmd, event); return; }
    if fire_of(self_obj, { (*g).on_right_click }, { (*g).on_right_click_ctx }) { return; }
    decline(self_obj, cmd, event);
    return;
}

fn imp_mouse_dragged(self_obj: *u8, cmd: *u8, event: *u8) {
    trace("[input] event mouseDragged:");
    let own_n: *core::Node = node_of_view(self_obj);
    if own_n != (0 as *core::Node) { let _o: bool = pointer::dragged(own_n, self_obj); }
    // A drag is not a press any more: whatever the long press was waiting for,
    // this is not it.
    cancel_long_press(self_obj);
    let g: *gestures::Gestures = gestures_of_view(self_obj);
    if g == (0 as *gestures::Gestures) { decline(self_obj, cmd, event); return; }
    if fire_of(self_obj, { (*g).on_pan }, { (*g).on_pan_ctx }) { return; }
    decline(self_obj, cmd, event);
    return;
}

fn imp_mouse_moved(self_obj: *u8, cmd: *u8, event: *u8) {
    trace("[input] event mouseMoved:");
    let own_n: *core::Node = node_of_view(self_obj);
    if own_n != (0 as *core::Node) { let _o: bool = pointer::moved(own_n, self_obj); }
    let g: *gestures::Gestures = gestures_of_view(self_obj);
    if g == (0 as *gestures::Gestures) { decline(self_obj, cmd, event); return; }
    if fire_of(self_obj, { (*g).on_pointer_move }, { (*g).on_pointer_move_ctx }) { return; }
    decline(self_obj, cmd, event);
    return;
}

fn imp_mouse_entered(self_obj: *u8, cmd: *u8, event: *u8) {
    trace("[input] event mouseEntered:");
    let own_n: *core::Node = node_of_view(self_obj);
    if own_n != (0 as *core::Node) { let _o: bool = pointer::hover(own_n, self_obj); }
    let g: *gestures::Gestures = gestures_of_view(self_obj);
    if g == (0 as *gestures::Gestures) { decline(self_obj, cmd, event); return; }
    if fire_of(self_obj, { (*g).on_hover }, { (*g).on_hover_ctx }) { return; }
    decline(self_obj, cmd, event);
    return;
}

fn imp_mouse_exited(self_obj: *u8, cmd: *u8, event: *u8) {
    trace("[input] event mouseExited:");
    let own_n: *core::Node = node_of_view(self_obj);
    if own_n != (0 as *core::Node) {
        let _o: bool = pointer::unhover(own_n, self_obj);
        // Leaving WHILE PRESSED is `CancelInteraction`: the press was
        // abandoned rather than completed, and AppKit says so only by ending
        // the tracking somewhere the release will never arrive.
        if is_pressed(self_obj) { let _c: bool = pointer::cancelled(own_n, self_obj); }
    }
    let g: *gestures::Gestures = gestures_of_view(self_obj);
    if g == (0 as *gestures::Gestures) { decline(self_obj, cmd, event); return; }
    if fire_of(self_obj, { (*g).on_unhover }, { (*g).on_unhover_ctx }) { return; }
    decline(self_obj, cmd, event);
    return;
}

fn imp_magnify(self_obj: *u8, cmd: *u8, event: *u8) {
    trace("[input] event magnifyWithEvent:");
    let g: *gestures::Gestures = gestures_of_view(self_obj);
    if g == (0 as *gestures::Gestures) { decline(self_obj, cmd, event); return; }
    if fire_of(self_obj, { (*g).on_pinch }, { (*g).on_pinch_ctx }) { return; }
    decline(self_obj, cmd, event);
    return;
}

fn imp_swipe(self_obj: *u8, cmd: *u8, event: *u8) {
    trace("[input] event swipeWithEvent:");
    let g: *gestures::Gestures = gestures_of_view(self_obj);
    if g == (0 as *gestures::Gestures) { decline(self_obj, cmd, event); return; }
    if fire_of(self_obj, { (*g).on_swipe }, { (*g).on_swipe_ctx }) { return; }
    decline(self_obj, cmd, event);
    return;
}

// ---- the key band ------------------------------------------------------------
// `on_key` fires on the FOCUSED element, so the view has to be able to be one.
// `acceptsFirstResponder` is answered from the node rather than hardcoded: a
// gesture set with no key handler must not start swallowing tab focus.

fn imp_key_down(self_obj: *u8, cmd: *u8, event: *u8) {
    trace("[input] event keyDown:");
    let n: *core::Node = node_of_view(self_obj);
    if n != (0 as *core::Node) {
        // fire_key hands the handler the EVENT, not the sender — the key band's
        // documented shape, because a key handler reads the event through
        // key_code / key_chars / key_named.
        if gestures::fire_key(n, event) { return; }
    }
    decline(self_obj, cmd, event);
    return;
}

fn imp_accepts_first_responder(self_obj: *u8, cmd: *u8) -> i8 {
    let n: *core::Node = node_of_view(self_obj);
    if n == (0 as *core::Node) { return 0 as i8; }
    if gestures::on_key_of(n) != gestures::no_gesture { return 1 as i8; }
    // Not ours to answer: a control that was already first-responder-capable
    // stays so.
    let s: SuperRef = SuperRef { receiver: self_obj, super_class: super_of(self_obj) };
    return super_bool(#addr_of(s), cmd);
}

#[link_name = "objc_msgSendSuper"]
extern fn super_bool(s: *SuperRef, sel: *u8) -> i8;

// ---- hit testing -------------------------------------------------------------
// `HitTest::Opaque` claims the node's whole area — gaps, transparent padding
// and all — which a plain NSView does NOT do: an NSView with no drawn content
// still hit-tests, but a subview on top wins, and that is exactly what
// DeferToChild wants. So Opaque is the only case that overrides.

fn imp_hit_test(self_obj: *u8, cmd: *u8, p: rt::Point) -> *u8 {
    let s: SuperRef = SuperRef { receiver: self_obj, super_class: super_of(self_obj) };
    let hit: *u8 = msg_super_id_point(#addr_of(s), cmd, p);
    if tracing() {
        trace_ptr("[input] hitTest: super answered", hit);
        if p.x > 40.0f64 && p.x < 60.0f64 { trace("[input] hitTest: point arrived INTACT"); }
        else { trace("[input] hitTest: point is MANGLED"); }
        // The same question asked without objc_msgSendSuper: take the IMP off
        // the superclass and call it as an ordinary function.
        let imp: *u8 = class_getMethodImplementation(super_of(self_obj), cmd);
        if imp != (0 as *u8) {
            let f: fn(*u8, *u8, rt::Point) -> *u8 = { imp as fn(*u8, *u8, rt::Point) -> *u8 };
            trace_ptr("[input] hitTest: direct IMP answered", f(self_obj, cmd, p));
        }
    }
    let n: *core::Node = node_of_view(self_obj);
    if n == (0 as *core::Node) { return hit; }
    // `input_transparent` — the shared band's, and the one place it can be
    // answered. AppKit has no per-view switch for "do not receive input", so
    // the answer is the hit test itself, and the hit test runs TOP-DOWN: a
    // container that answers nil is never asked about its subviews.
    //
    // That is what makes the cascade nearly free, and it is why `scroll`
    // carries the only switch for it:
    //
    //   cascades   answer nil outright — the subtree is unreachable, which is
    //              exactly CascadeInputTransparent's meaning.
    //   not        answer nil only where SUPER answered `self`. A child that
    //              claimed the point still gets it; the node itself does not.
    if core::input_transparent(n) {
        if cascades_input(n) { return 0 as *u8; }
        if hit == self_obj { return 0 as *u8; }
        return hit;
    }
    if !gestures::is_opaque_to_input(n) { return hit; }
    // Inside our bounds, we take it whatever the subviews said.
    if hit != (0 as *u8) { return self_obj; }
    let local: rt::Point = msg_point_id(self_obj, rt::sel(#str_ptr("convertPoint:fromView:\0")),
                                        0 as *u8);
    let b: rt::Rect = { rt::msg_rect(self_obj, rt::sel(#str_ptr("bounds\0"))) };
    if local.x >= b.x && local.y >= b.y && local.x <= (b.x + b.w) && local.y <= (b.y + b.h) {
        return self_obj;
    }
    return hit;
}

// Does this node's input transparency reach its children? `scroll` is the one
// kind that declares the switch; every other kind takes the ledger's own default,
// which is that it does.
fn cascades_input(n: *core::Node) -> bool {
    let d: *core::Data = core::node_data(n);
    if d == (0 as *core::Data) { return true; }
    if { (*d).kind } != props::K_SCROLL { return true; }
    let p: *props::ScrollProps = { (*d).props } as *props::ScrollProps;
    if p == (0 as *props::ScrollProps) { return true; }
    return { (*p).cascades_input };
}

// ---- drag and drop -----------------------------------------------------------
// The destination half rides appkit_ext's drop IMPs, because they already carry
// the targeted flag, the dropped text and the autoscroll-at-the-edge behaviour
// that a drop over a scrolling list needs. This module supplies the handlers
// they call; `dropped_text` and `drag_targeted` read the same associated slots.

fn drop_shim(sender: *u8, ctx: *u8) {
    let _took: bool = fire_of(ctx, drop_handler_of(ctx), drop_ctx_of(ctx));
    return;
}

fn drop_handler_of(v: *u8) -> gestures::Handler {
    let g: *gestures::Gestures = gestures_of_view(v);
    if g == (0 as *gestures::Gestures) { return gestures::no_gesture; }
    return { (*g).on_drop };
}

fn drop_ctx_of(v: *u8) -> *u8 {
    let g: *gestures::Gestures = gestures_of_view(v);
    if g == (0 as *gestures::Gestures) { return 0 as *u8; }
    return { (*g).on_drop_ctx };
}

fn drag_over_shim(sender: *u8, ctx: *u8) {
    let g: *gestures::Gestures = gestures_of_view(ctx);
    if g == (0 as *gestures::Gestures) { return; }
    // One AppKit callback, two facet verbs: appkit_ext reports enter and exit
    // through the same hook, and the targeted flag is what tells them apart.
    let entering: bool = akx::drag_targeted(ctx);
    let h: gestures::Handler = if entering { { (*g).on_drag_over } }
                               else { { (*g).on_drag_leave } };
    let c: *u8 = if entering { { (*g).on_drag_over_ctx } }
                 else { { (*g).on_drag_leave_ctx } };
    let _took: bool = fire_of(ctx, h, c);
    return;
}

// The class is SHARED by every view of the same backing kind, so nothing here
// may add a method: two nodes of one kind would then decide each other's
// behaviour. The drop selectors live on the class from the start
// (`add_input_methods`) and the gate is `registerForDraggedTypes:` — which is
// AppKit's own gate, so a view that never asked is never offered a drag.
fn arm_drop(v: *u8, g: *gestures::Gestures) {
    if !{ (*g).allow_drop } { return; }
    // The handlers appkit_ext's IMPs call. ctx is the VIEW, so the shim can get
    // back to the node without a second association.
    let dh: fn(*u8, *u8) = drop_shim;
    let oh: fn(*u8, *u8) = drag_over_shim;
    synth::set_associated(v, akx::drop_handler_key(), dh as *u8);
    synth::set_associated(v, akx::drop_ctx_key(), v);
    synth::set_associated(v, akx::drag_target_key(), oh as *u8);
    synth::set_associated(v, akx::drag_over_ctx_key(), v);
    // Text only, which is what facet's drop verb carries.
    { rt::msg_void_id(v, rt::sel(#str_ptr("registerForDraggedTypes:\0")),
                      dragged_types()) };
    return;
}

// NSPasteboardTypeString, in an NSArray. Built each time it is needed rather
// than cached: arming happens once per gesture-bearing view, not per event.
fn dragged_types() -> *u8 {
    let arr: *u8 = { rt::msg_id(rt::get_class(#str_ptr("NSMutableArray\0")),
                                rt::sel(#str_ptr("array\0"))) };
    { rt::msg_void_id(arr, rt::sel(#str_ptr("addObject:\0")),
                      bridge::nsstring("public.utf8-plain-text")) };
    return arr;
}

// The source half. appkit_ext's drag view carries the payload text on an
// associated key and begins the session from its own mouse tracking, so arming
// a drag is setting that text plus the source-mask answer.
fn arm_drag_source(v: *u8, g: *gestures::Gestures) {
    if !{ (*g).can_drag } { return; }
    // Same rule as arm_drop: the selector is on the class already, and the
    // PAYLOAD is the gate — appkit_ext begins a session only for a view that
    // carries drag text.
    let key: text::Text = component::key_of(v);
    { synth::set_associated(v, akx::drag_text_key(), bridge::nsstring(key.view())) };
    return;
}

// ---- the item ----------------------------------------------------------------
// `set_item(n, p)` is what a shared handler tells its nodes apart by, and the
// association is how the sender walk finds it: `item_of(sender)` climbs
// superviews to the nearest tagged one, exactly as `key_of` does, so a click on
// an untagged icon inside a row answers the ROW's record.
//
// Bound on every node, not only gesture-bearing ones — a button in a row wants
// its row's item as much as a gesture does.
fn bind_item(v: *u8, n: *core::Node) {
    if v == (0 as *u8) || n == (0 as *core::Node) { return; }
    let p: *u8 = core::item_of(n);
    if p == (0 as *u8) && { synth::get_associated(v, item_key()) } == (0 as *u8) { return; }
    // ASSIGN, never retain: the application owns the item and outlives the
    // node. facet stores the pointer and dereferences nothing.
    synth::set_associated(v, item_key(), p);
    return;
}

// ---- arming ------------------------------------------------------------------

// The runtime class cache. A Class IS an object, so the subclass is associated
// with the base class itself — no name table, no string compare, and it stays
// correct if two base classes ever shared a name.
fn subclass_key() -> *u8 { return { 29015 as *u8 }; }

static INPUT_CLASSES: u32 = 0 as u32;

// One digit as a literal. This module cannot import views.cplus (views imports
// THIS one) and a number formatter is not worth a third module — the name only
// has to be unique, and two digits is far more backing classes than facet has
// kinds.
fn one_digit(d: u32) -> str {
    if d == (0 as u32) { return "0"; }
    if d == (1 as u32) { return "1"; }
    if d == (2 as u32) { return "2"; }
    if d == (3 as u32) { return "3"; }
    if d == (4 as u32) { return "4"; }
    if d == (5 as u32) { return "5"; }
    if d == (6 as u32) { return "6"; }
    if d == (7 as u32) { return "7"; }
    if d == (8 as u32) { return "8"; }
    return "9";
}

// The subclass of `base` carrying facet's event overrides. One per base class:
// a thousand gesture rows over three control kinds make three classes.
// Focus and blur. The superclass decides whether the change happens at all —
// an NSTextField can refuse to give up first responder while its value is
// invalid — so the handler fires only when the super call SUCCEEDS. Reporting
// a focus that was refused would be worse than not reporting it.
#[link_name = "objc_msgSendSuper"]
extern fn msg_super_i8(s: *SuperRef, sel: *u8) -> i8;

// Does this view still own the window's field editor?
//
// This is the question that separates the two kinds of `resignFirstResponder`
// an NSTextField gets. Focusing one makes the window's shared FIELD EDITOR the
// first responder, and installing it makes the field itself resign — a resign
// that is part of GAINING focus, not losing it. A field that has moved on has
// no editor.
//
// `currentEditor` is NSControl's, so it is asked only of objects that answer
// it; a plain view resigning is always a real blur.
fn still_editing(v: *u8) -> bool {
    if synth::class_responds(synth::object_class(v),
                             rt::sel(#str_ptr("currentEditor\0"))) == (0 as i8) {
        return false;
    }
    return { rt::msg_id(v, rt::sel(#str_ptr("currentEditor\0"))) } != (0 as *u8);
}

// EDGE-triggered: fire only when the answer CHANGES.
//
// The state cannot be read from the window, which was the first thing tried:
// at `resign` time the new first responder is not installed yet, so the window
// still names the OUTGOING view and no blur is ever seen. The direction has to
// come from which call arrived, with `still_editing` as the one correction —
// and the edge trigger absorbs the rest of the shuffle, so one user-visible
// focus change calls the application once.
fn sync_focus(v: *u8, focused: bool) {
    let n: *core::Node = node_of_view(v);
    if n == (0 as *core::Node) { return; }
    var now: bool = focused;
    if !focused && still_editing(v) { now = true; }
    if core::is_focused(n) == now { return; }
    core::set_focused(n, now);
    if now { core::fire_focus_handler(n); } else { core::fire_blur_handler(n); }
    return;
}

fn imp_become_first_responder(self_obj: *u8, cmd: *u8) -> i8 {
    var sup: SuperRef = SuperRef {
        receiver: self_obj,
        super_class: { class_getSuperclass(synth::object_class(self_obj)) },
    };
    // The superclass decides whether the change happens at all — a field can
    // refuse to give up first responder while its value is invalid — so the
    // state is only re-read when the super call succeeded.
    let ok: i8 = { msg_super_i8(#addr_of(sup), cmd) };
    if ok != (0 as i8) { sync_focus(self_obj, true); }
    return ok;
}

fn imp_resign_first_responder(self_obj: *u8, cmd: *u8) -> i8 {
    var sup: SuperRef = SuperRef {
        receiver: self_obj,
        super_class: { class_getSuperclass(synth::object_class(self_obj)) },
    };
    let ok: i8 = { msg_super_i8(#addr_of(sup), cmd) };
    if ok != (0 as i8) { sync_focus(self_obj, false); }
    return ok;
}

fn input_class_for(base: *u8) -> *u8 {
    let cached: *u8 = { synth::get_associated(base, subclass_key()) };
    if cached != (0 as *u8) { return cached; }

    // objc_allocateClassPair needs a unique NAME, and the base's own is not
    // reachable as a `str` — so the classes are numbered.
    var name: text::Text = text::from_str("FacetInput");
    let _t: status::Status = name.append(one_digit((INPUT_CLASSES / (10 as u32)) % (10 as u32)));
    let _u: status::Status = name.append(one_digit(INPUT_CLASSES % (10 as u32)));
    INPUT_CLASSES = INPUT_CLASSES + (1 as u32);

    var made: *u8 = base;
    match name.c_str() {
        option::Option[text::CString]::Some(cs) => {
            let cls: *u8 = synth::allocate_class_pair(base, cs.as_ptr(), 0 as usize);
            if cls != (0 as *u8) {
                add_input_methods(cls);
                synth::register_class_pair(cls);
                made = cls;
            }
        }
        option::Option[text::CString]::None => { }
    }
    if made != base { synth::set_associated(base, subclass_key(), made); }
    return made;
}

// `performClick:` — THE AGENT'S DOOR, and the only one it has.
//
// The agent surface clicks by sending this selector to the backing view. That
// lands on NSControls and, through `select_row_of`, on table rows; a plain
// NSView carrying a gesture answers nothing, so the guard in agent_appkit
// refuses with NotActionable rather than raising an unrecognized selector.
//
// Which made `.gesture(on_click:)` produce exactly the affordance facet's own
// doctrine forbids: `agent.cplus` says an agent has no hands, so an affordance
// only a gesture can reach is the bug and the fix is a click path in the UI.
// `.gesture(on_click:)` is the ONLY verb that makes a container clickable, so
// without this there was no way to satisfy that rule for a whole-row control —
// a recents row, a card, a list item built from a box rather than a button.
//
// The handler is read from the node at fire time rather than captured, so a
// swapped `on_click` is answered by the new one. `fire_click` answers false
// when the node carries no click handler, which is the gesture view that only
// drags: it responds to the selector and does nothing, the same as sending
// `performClick:` to a control with no action.
fn imp_perform_click(self_obj: *u8, cmd: *u8, sender: *u8) {
    let n: *core::Node = node_of_view(self_obj);
    if n == (0 as *core::Node) { return; }
    let _fired: bool = gestures::fire_click(n);
}

// Where the drop landed, in the receiving node's own space. The backend stashed
// it during `performDragOperation:` — see `appkit_ext::drop_set_point`, which
// converts out of window space while the view that was hit is still in hand.
fn drop_position(sender: *u8) -> option::Option[vocab::Point] {
    if sender == (0 as *u8) { return option::Option[vocab::Point]::None; }
    if !akx::drop_has_point(sender) { return option::Option[vocab::Point]::None; }
    let p: rt::Point = akx::drop_point_of(sender);
    return option::Option[vocab::Point]::Some(vocab::Point { x: { p.x }, y: { p.y } });
}

fn add_input_methods(cls: *u8) {
    synth::add_method_v_1id(cls, rt::sel(#str_ptr("performClick:\0")), imp_perform_click, #str_ptr("v@:@\0"));
    synth::add_method_v_1id(cls, rt::sel(#str_ptr("mouseDown:\0")), imp_mouse_down, #str_ptr("v@:@\0"));
    synth::add_method_v_1id(cls, rt::sel(#str_ptr("mouseUp:\0")), imp_mouse_up, #str_ptr("v@:@\0"));
    synth::add_method_v_1id(cls, rt::sel(#str_ptr("rightMouseDown:\0")), imp_right_mouse_down, #str_ptr("v@:@\0"));
    synth::add_method_v_1id(cls, rt::sel(#str_ptr("mouseDragged:\0")), imp_mouse_dragged, #str_ptr("v@:@\0"));
    synth::add_method_v_1id(cls, rt::sel(#str_ptr("mouseMoved:\0")), imp_mouse_moved, #str_ptr("v@:@\0"));
    synth::add_method_v_1id(cls, rt::sel(#str_ptr("mouseEntered:\0")), imp_mouse_entered, #str_ptr("v@:@\0"));
    synth::add_method_v_1id(cls, rt::sel(#str_ptr("mouseExited:\0")), imp_mouse_exited, #str_ptr("v@:@\0"));
    synth::add_method_v_1id(cls, rt::sel(#str_ptr("magnifyWithEvent:\0")), imp_magnify, #str_ptr("v@:@\0"));
    synth::add_method_v_1id(cls, rt::sel(#str_ptr("swipeWithEvent:\0")), imp_swipe, #str_ptr("v@:@\0"));
    synth::add_method_v_1id(cls, rt::sel(#str_ptr("keyDown:\0")), imp_key_down, #str_ptr("v@:@\0"));
    add_method_i8_0(cls, rt::sel(#str_ptr("acceptsFirstResponder\0")),
                    imp_accepts_first_responder, #str_ptr("c@:\0"));
    // The shared band's `on_focus` / `on_blur`, and the write that makes
    // `is_focused()` answer. All three were declared on every cursor and
    // none of them existed: `core::fire_focus_handler` and
    // `fire_blur_handler` had ZERO callers anywhere, and `core::set_focused`
    // was called only by one of facet's own tests, so `is_focused()` was a
    // reader that could only ever answer false.
    add_method_i8_0(cls, rt::sel(#str_ptr("becomeFirstResponder\0")),
                    imp_become_first_responder, #str_ptr("c@:\0"));
    add_method_i8_0(cls, rt::sel(#str_ptr("resignFirstResponder\0")),
                    imp_resign_first_responder, #str_ptr("c@:\0"));
    add_method_id_point(cls, rt::sel(#str_ptr("hitTest:\0")), imp_hit_test,
                        #str_ptr("@@:{CGPoint=dd}\0"));
    // Drag and drop. On the class unconditionally — see arm_drop for why the
    // per-view gate cannot be a method.
    synth::add_method_u64_1id(cls, rt::sel(#str_ptr("draggingEntered:\0")),
                              akx::drop_entered_imp, #str_ptr("Q@:@\0"));
    synth::add_method_v_1id(cls, rt::sel(#str_ptr("draggingExited:\0")),
                            akx::drop_exited_imp, #str_ptr("v@:@\0"));
    add_method_u64_1id(cls, rt::sel(#str_ptr("draggingUpdated:\0")),
                       akx::drop_updated_imp, #str_ptr("Q@:@\0"));
    synth::add_method_i8_1id(cls, rt::sel(#str_ptr("prepareForDragOperation:\0")),
                             akx::drop_prepare_imp, #str_ptr("c@:@\0"));
    synth::add_method_i8_1id(cls, rt::sel(#str_ptr("performDragOperation:\0")),
                             akx::drop_perform_imp, #str_ptr("c@:@\0"));
    synth::add_method_u64_1id_i64(cls,
        rt::sel(#str_ptr("draggingSession:sourceOperationMaskForDraggingContext:\0")),
        akx::drag_source_mask_imp, #str_ptr("Q@:@q\0"));
    // The two ENDS of a drag, from the source's side. `can_drag` armed the
    // source and `on_drop` fired at the destination, but the dragging node was
    // never told its drag began or how it finished — both handlers were
    // declared and referenced nowhere. The session's own two callbacks say it,
    // and the delegate seam for them already existed (the mask IMP above is on
    // the same protocol).
    add_method_v_2id_point(cls,
        rt::sel(#str_ptr("draggingSession:willBeginAtPoint:\0")),
        imp_drag_session_began, #str_ptr("v@:@{CGPoint=dd}\0"));
    add_method_v_2id_point_u64(cls,
        rt::sel(#str_ptr("draggingSession:endedAtPoint:operation:\0")),
        imp_drag_session_ended, #str_ptr("v@:@{CGPoint=dd}Q\0"));
    return;
}

fn imp_drag_session_began(self_obj: *u8, cmd: *u8, session: *u8, at: rt::Point) {
    let g: *gestures::Gestures = gestures_of_view(self_obj);
    if g == (0 as *gestures::Gestures) { return; }
    let _took: bool = fire_of(self_obj, { (*g).on_drag_start }, { (*g).on_drag_start_ctx });
    return;
}

fn imp_drag_session_ended(self_obj: *u8, cmd: *u8, session: *u8, at: rt::Point, op: u64) {
    let g: *gestures::Gestures = gestures_of_view(self_obj);
    if g == (0 as *gestures::Gestures) { return; }
    let _took: bool = fire_of(self_obj, { (*g).on_drop_completed }, { (*g).on_drop_completed_ctx });
    return;
}

#[link_name = "class_addMethod"]
extern fn add_method_v_2id_point(cls: *u8, sel: *u8, imp: fn(*u8, *u8, *u8, rt::Point),
                                 types: *u8) -> i8;
#[link_name = "class_addMethod"]
extern fn add_method_v_2id_point_u64(cls: *u8, sel: *u8,
                                     imp: fn(*u8, *u8, *u8, rt::Point, u64),
                                     types: *u8) -> i8;

fn is_armed(v: *u8) -> bool {
    return { synth::get_associated(v, armed_key()) } != (0 as *u8);
}

// Give `v` facet's event behaviour for `n`. Idempotent: apply calls it on every
// C_GESTURES write, and the class swap must happen once.
fn arm(v: *u8, n: *core::Node) {
    if v == (0 as *u8) || n == (0 as *core::Node) {
        trace("[input] arm: SKIPPED — null view or null node");
        return;
    }
    let g: *gestures::Gestures = gestures::gestures_of(n);
    // A control with pointer verbs of its OWN is armed too: `button.on_pressed`
    // and the canvas interaction set are the control's verbs, not the gesture
    // band's, and an application that used them never touched `.gesture(...)`.
    let own: bool = pointer::wants_press_band(n);
    // A node that takes NO input is armed too, for the opposite reason: the
    // hit test is the only place AppKit lets that be said, and `imp_hit_test`
    // is on this class.
    let transparent: bool = core::input_transparent(n);
    // A node carrying ONLY a focus handler is armed too. `on_focus` is on the
    // shared band, so a plain container can declare one without ever touching
    // `.gesture(...)` — and before this it was never armed, so the class that
    // implements become/resign was never installed and the handler could not
    // fire however correctly it was wired.
    let focus: bool = core::wants_focus_events(n);
    if g == (0 as *gestures::Gestures) && own == false && transparent == false
        && focus == false {
        trace2("[input] arm: SKIPPED — node has no Gestures, key=", { (*n).key() });
        return;
    }
    trace2("[input] arm: key=", { (*n).key() });
    // The node pointer is re-associated every time, because a node that was
    // detached and re-attached under the same view has a new address.
    synth::set_associated(v, node_key(), n as *u8);
    if is_armed(v) {
        if g != (0 as *gestures::Gestures) { arm_tracking(v, g); }
        arm_own_tracking(v, n);
        return;
    }
    let before: text::Text = class_name_of(v);
    let _old: *u8 = object_setClass(v, input_class_for(synth::object_class(v)));
    synth::set_associated(v, armed_key(), 1 as *u8);
    if tracing() {
        var t: text::Text = text::from_str("[input] arm: class ");
        let _a: status::Status = t.append(before.view());
        let _b: status::Status = t.append(" -> ");
        let _c: status::Status = t.append(class_name_of(v).view());
        io::eprintln(t.view());
    }
    // A control armed for its OWN pointer verbs has no Gestures at all, so
    // every gesture-band installer is asked whether there is one first. This is
    // the one path where `arm` runs with a null `g`.
    if g != (0 as *gestures::Gestures) {
        arm_tracking(v, g);
        arm_drop(v, g);
        arm_drag_source(v, g);
    }
    arm_own_tracking(v, n);
    return;
}

// A canvas that declares a hover verb wants the same tracking area the gesture
// band's hover wants, and for the same price — so it is asked separately rather
// than given one because it is a canvas.
fn arm_own_tracking(v: *u8, n: *core::Node) {
    if pointer::wants_tracking(n) == false { return; }
    // Enter/exit AND move: the canvas set has all three, and asking for a
    // subset would mean a second tracking area when the other verb appears.
    add_tracking_area(v, (1 as u64) | (2 as u64));
    return;
}

// Hover and pointer-move need a tracking area; nothing else does, and a
// tracking area on every gesture view would cost a mouse-moved event per node
// per frame across the whole window.
//
// NSTrackingMouseEnteredAndExited 1 | NSTrackingMouseMoved 2 |
// NSTrackingActiveInKeyWindow 0x20 | NSTrackingInVisibleRect 0x200.
fn arm_tracking(v: *u8, g: *gestures::Gestures) {
    let wants_enter: bool = { (*g).on_hover } != gestures::no_gesture
                         || { (*g).on_unhover } != gestures::no_gesture;
    let wants_move: bool = { (*g).on_pointer_move } != gestures::no_gesture;
    if !wants_enter && !wants_move { return; }
    var opts: u64 = 32 as u64 + (512 as u64);
    var which: u64 = 0 as u64;
    if wants_enter { which = which | (1 as u64); }
    if wants_move { which = which | (2 as u64); }
    add_tracking_area(v, which);
    return;
}

// NSTrackingActiveInKeyWindow 0x20 | NSTrackingInVisibleRect 0x200, plus
// whichever of entered/exited (1) and moved (2) the caller asked for.
fn add_tracking_area(v: *u8, which: u64) {
    if { synth::get_associated(v, tracking_key()) } != (0 as *u8) { return; }
    let opts: u64 = (32 as u64) + (512 as u64) | which;
    let area: *u8 = { rt::msg_id(rt::get_class(#str_ptr("NSTrackingArea\0")),
                                 rt::sel(#str_ptr("alloc\0"))) };
    let inited: *u8 = { msg_id_rect_u64_id_id(
        area, rt::sel(#str_ptr("initWithRect:options:owner:userInfo:\0")),
        rt::Rect { x: 0.0f64, y: 0.0f64, w: 0.0f64, h: 0.0f64 }, opts, v, 0 as *u8) };
    if inited == (0 as *u8) { return; }
    { rt::msg_void_id(v, rt::sel(#str_ptr("addTrackingArea:\0")), inited) };
    synth::set_associated(v, tracking_key(), 1 as *u8);
    rt::release(inited);
    return;
}

#[link_name = "objc_msgSend"]
extern fn msg_id_rect_u64_id_id(recv: *u8, sel: *u8, a: rt::Rect, b: u64,
                                c: *u8, d: *u8) -> *u8;

// ---- the key reader ----------------------------------------------------------
// facet's side of an NSEvent: the platform code raw, the characters, portable
// modifier bits, and the named-key table.

fn key_code(event: *u8) -> i64 {
    if event == (0 as *u8) { return 0 as i64 - (1 as i64); }
    // MASKED to 16 bits, and it matters: -[NSEvent keyCode] returns an
    // `unsigned short`, so the ABI only promises the low half of the register
    // and the rest is whatever was there. Unmasked, the same Escape key
    // compares equal to 53 on one call and to garbage on the next.
    let raw: u64 = { rt::msg_u64(event, rt::sel(#str_ptr("keyCode\0"))) };
    return { raw & (65535 as u64) } as i64;
}

fn key_chars(event: *u8) -> text::Text {
    if event == (0 as *u8) { return text::new(); }
    let ns: *u8 = { rt::msg_id(event, rt::sel(#str_ptr("characters\0"))) };
    if ns == (0 as *u8) { return text::new(); }
    return bridge::to_text(ns);
}

// NSEventModifierFlag* are bit 17..20; facet's are bits 0..3, so this is a
// translation and not a cast — an app never sees an AppKit constant.
fn key_modifiers(event: *u8) -> u64 {
    if event == (0 as *u8) { return 0 as u64; }
    let f: u64 = { rt::msg_u64(event, rt::sel(#str_ptr("modifierFlags\0"))) };
    var out: u64 = 0 as u64;
    if (f & (131072 as u64)) != (0 as u64) { out = out | gestures::mod_shift(); }
    if (f & (262144 as u64)) != (0 as u64) { out = out | gestures::mod_control(); }
    if (f & (524288 as u64)) != (0 as u64) { out = out | gestures::mod_option(); }
    if (f & (1048576 as u64)) != (0 as u64) { out = out | gestures::mod_command(); }
    return out;
}

// The macOS virtual key codes, mapped onto facet's names. Only the keys facet
// names — everything else is `key_none()` and reads through key_code/key_chars,
// which is the contract that table declares.
fn key_named(event: *u8) -> i64 {
    let c: i64 = key_code(event);
    if c == (36 as i64) { return gestures::key_return(); }
    if c == (76 as i64) { return gestures::key_return(); }   // keypad enter
    if c == (48 as i64) { return gestures::key_tab(); }
    if c == (49 as i64) { return gestures::key_space(); }
    if c == (51 as i64) { return gestures::key_delete(); }
    if c == (117 as i64) { return gestures::key_forward_delete(); }
    if c == (53 as i64) { return gestures::key_escape(); }
    if c == (123 as i64) { return gestures::key_arrow_left(); }
    if c == (124 as i64) { return gestures::key_arrow_right(); }
    if c == (126 as i64) { return gestures::key_arrow_up(); }
    if c == (125 as i64) { return gestures::key_arrow_down(); }
    if c == (115 as i64) { return gestures::key_home(); }
    if c == (119 as i64) { return gestures::key_end(); }
    if c == (116 as i64) { return gestures::key_page_up(); }
    if c == (121 as i64) { return gestures::key_page_down(); }
    return gestures::key_none();
}

fn key_reader() -> gestures::KeyReader {
    return gestures::KeyReader {
        code: key_code,
        chars: key_chars,
        modifiers: key_modifiers,
        named: key_named,
    };
}

// ---- the sender readers ------------------------------------------------------
// A handler is given the thing that fired: a control for a control's action,
// the backing view for a gesture (facet's `gesture_sender`). Both are views, so
// all four readers are one superview walk.

// A recognizer sender normalises to its view; anything else IS the view.
fn sender_view(sender: *u8) -> *u8 {
    if sender == (0 as *u8) { return 0 as *u8; }
    if synth::class_responds(synth::object_class(sender), rt::sel(#str_ptr("view\0"))) != (0 as i8) {
        let v: *u8 = { rt::msg_id(sender, rt::sel(#str_ptr("view\0"))) };
        if v != (0 as *u8) { return v; }
    }
    return sender;
}

// The key IS the accessibilityIdentifier (one token, three jobs), and the walk
// goes UP: a click on an untagged icon inside a tagged row answers the row.
fn key_of(sender: *u8) -> text::Text {
    var v: *u8 = sender_view(sender);
    while v != (0 as *u8) {
        let ns: *u8 = { rt::msg_id(v, rt::sel(#str_ptr("accessibilityIdentifier\0"))) };
        if ns != (0 as *u8) {
            let len: u64 = { rt::msg_u64_u64(ns, rt::sel(#str_ptr("lengthOfBytesUsingEncoding:\0")),
                                             bridge::ns_utf8()) };
            if len > (0 as u64) { return bridge::to_text(ns); }
        }
        v = { rt::msg_id(v, rt::sel(#str_ptr("superview\0"))) };
    }
    return text::new();
}

// The app pointer a node carries, found by the same walk, so `item` and `key`
// always resolve off the same view.
fn item_of(sender: *u8) -> *u8 {
    var v: *u8 = sender_view(sender);
    while v != (0 as *u8) {
        let it: *u8 = { synth::get_associated(v, item_key()) };
        if it != (0 as *u8) { return it; }
        v = { rt::msg_id(v, rt::sel(#str_ptr("superview\0"))) };
    }
    return 0 as *u8;
}

// Bring the keyed element to the front of its siblings, in place — the
// no-rebuild z-order change. facet is not reactive, so the element is addressed
// rather than re-described.
fn raise(sender: *u8, key: str) {
    let sv: *u8 = sender_view(sender);
    if sv == (0 as *u8) { return; }
    let win: *u8 = { rt::msg_id(sv, rt::sel(#str_ptr("window\0"))) };
    if win == (0 as *u8) { return; }
    let content: *u8 = { rt::msg_id(win, rt::sel(#str_ptr("contentView\0"))) };
    if content == (0 as *u8) { return; }
    let target: *u8 = find_by_key(content, key);
    if target == (0 as *u8) { return; }
    let v: ak::View = ak::View::from_raw(target);
    match v.superview() {
        option::Option[ak::View]::Some(sup) => {
            // Removing and re-adding puts it last in the subview order, which
            // IS the front on AppKit.
            v.remove_from_superview();
            sup.add_subview(v);
        }
        option::Option[ak::View]::None => { }
    }
    return;
}

fn find_by_key(root: *u8, key: str) -> *u8 {
    if root == (0 as *u8) { return 0 as *u8; }
    let ns: *u8 = { rt::msg_id(root, rt::sel(#str_ptr("accessibilityIdentifier\0"))) };
    if ns != (0 as *u8) {
        if bridge::to_text(ns).view() == key { return root; }
    }
    let subs: *u8 = { rt::msg_id(root, rt::sel(#str_ptr("subviews\0"))) };
    if subs == (0 as *u8) { return 0 as *u8; }
    let count: u64 = { rt::msg_u64(subs, rt::sel(#str_ptr("count\0"))) };
    var i: u64 = 0 as u64;
    while i < count {
        let child: *u8 = { rt::msg_id_u64(subs, rt::sel(#str_ptr("objectAtIndex:\0")), i) };
        let hit: *u8 = find_by_key(child, key);
        if hit != (0 as *u8) { return hit; }
        i = i + (1 as u64);
    }
    return 0 as *u8;
}

fn dropped_text(sender: *u8) -> text::Text {
    let v: *u8 = sender_view(sender);
    if v == (0 as *u8) { return text::new(); }
    return akx::drop_text_of(v);
}

fn drag_targeted(sender: *u8) -> bool {
    let v: *u8 = sender_view(sender);
    if v == (0 as *u8) { return false; }
    return akx::drag_targeted(v);
}

fn sender_readers() -> component::SenderReaders {
    return component::SenderReaders {
        raise: raise,
        key_of: key_of,
        item_of: item_of,
        dropped_text: dropped_text,
        drop_position: drop_position,
        drag_targeted: drag_targeted,
    };
}
