// facet_appkit web — `web` and `hybrid_web`, on WKWebView.
//
// Both kinds are the same view with different wiring, so they share one file
// and one delegate class. The delegate is a synthesized NSObject that answers
// three protocols at once — WKNavigationDelegate for the navigation band,
// WKScriptMessageHandler for the hybrid channel — because they are all
// "the page told us something" and splitting them would mean two objects
// pinned to one view.
//
// ---- the two reads are WRITTEN BACK -------------------------------------------
//
// `can_go_back()` and `can_go_forward()` are contract READS, and the truth for
// both lives in WKWebView's back-forward list, not in facet. So the delegate
// writes them into the props on every navigation: the cursor then answers from
// the props like every other read, and an application never learns that one
// answer came from the platform and another from the description.
//
// ---- the hybrid channel ------------------------------------------------------
//
// facet declares a raw message in each direction and nothing about how they are
// carried, so this package names the carrier:
//
//   page -> facet   window.webkit.messageHandlers.facet.postMessage(body)
//   facet -> page   window.facet.onmessage(body), if the page defined it
//
// `facet` is the handler name, and it is the same word both ways so a page
// author only has to learn one.

import "stdlib/option" as option;
import "stdlib/text" as text;
import "stdlib/status" as status;
import "stdlib/fs" as fs;
import "stdlib/result" as result;
import "stdlib/vec" as vec;
import "flex_layout/flex_layout" as flex;
import "facet/facet" as core;
import "facet/props" as props;
import "facet/web" as web;
import "facet/hybrid_web" as hybrid_web;
import "objc/runtime" as rt;
import "objc/synthesis" as synth;
import "objc/bridge" as bridge;
import "appkit/appkit" as ak;
import "webkit/webkit" as wk;
import "./paint" as paint;

// ---- associated keys ---------------------------------------------------------
// facet_appkit owns 29000 and up, in one block per file:
//
//   drawing 29000   input 29010   web 29020   recycler 29030   dialogs 29040
//   text_input 29050   scrolling 29060   bordered stroke 29070   compose 29080
//
// NOT 28xxx, which is where `cpc-bindgen` allocates the generated binding's own
// delegate keys from — appkit.cplus is already at 28733 and grows with the SDK.
// An associated key is per-object, so an overlap is silent until the day one
// lands on the same object twice; `keys_are_distinct` is the gate, and the
// range is what keeps the gate from having to be re-won on every regen.

fn node_key() -> *u8 { return { 29020 as *u8 }; }
fn delegate_pin_key() -> *u8 { return { 29021 as *u8 }; }

fn node_of(obj: *u8) -> *core::Node {
    if obj == (0 as *u8) { return 0 as *core::Node; }
    return { synth::get_associated(obj, node_key()) as *core::Node };
}

// ---- the delegate ------------------------------------------------------------

fn fire(n: *core::Node, h: fn(*u8, *u8), ctx: *u8, sender: *u8) {
    if h == props::no_handler { return; }
    h(sender, ctx);
    return;
}

// The navigation state a contract READ answers from. Written here because
// WKWebView owns the truth and the cursor reads the props.
fn refresh_nav_state(n: *core::Node, view: *u8) {
    let p: *props::WebProps = props_of_web(n);
    if p == (0 as *props::WebProps) { return; }
    let w: wk::WebView = wk::WebView::from_raw(view);
    { (*p).can_go_back = w.can_go_back() };
    { (*p).can_go_forward = w.can_go_forward() };
    return;
}

fn props_of_web(n: *core::Node) -> *props::WebProps {
    let d: *core::Data = core::node_data(n);
    if d == (0 as *core::Data) { return 0 as *props::WebProps; }
    if { (*d).kind } != props::K_WEB { return 0 as *props::WebProps; }
    return { (*d).props } as *props::WebProps;
}

fn props_of_hybrid(n: *core::Node) -> *props::HybridWebProps {
    let d: *core::Data = core::node_data(n);
    if d == (0 as *core::Data) { return 0 as *props::HybridWebProps; }
    if { (*d).kind } != props::K_HYBRID_WEB { return 0 as *props::HybridWebProps; }
    return { (*d).props } as *props::HybridWebProps;
}

// -[WKNavigationDelegate webView:didStartProvisionalNavigation:]
//
// The ledger's `Navigating` is cancellable; facet's handler returns nothing, so it
// could not cancel even if this were wired to
// `decidePolicyForNavigationAction:` — which is why the START of a navigation
// is the honest thing to report here.
fn did_start_imp(self_obj: *u8, cmd: *u8, view: *u8, nav: *u8) {
    let n: *core::Node = node_of(self_obj);
    if n == (0 as *core::Node) { return; }
    let p: *props::WebProps = props_of_web(n);
    if p == (0 as *props::WebProps) { return; }
    fire(n, { (*p).on_navigating }, { (*p).on_navigating_ctx }, view);
    return;
}

fn did_finish_imp(self_obj: *u8, cmd: *u8, view: *u8, nav: *u8) {
    let n: *core::Node = node_of(self_obj);
    if n == (0 as *core::Node) { return; }
    refresh_nav_state(n, view);
    let p: *props::WebProps = props_of_web(n);
    if p == (0 as *props::WebProps) { return; }
    fire(n, { (*p).on_navigated }, { (*p).on_navigated_ctx }, view);
    return;
}

fn did_fail_imp(self_obj: *u8, cmd: *u8, view: *u8, nav: *u8, err: *u8) {
    // A failed navigation still changed the back-forward list, so the reads
    // are refreshed. facet declares no failure handler; `on_navigated` is for
    // arrival, and reporting a failure through it would be a lie.
    let n: *core::Node = node_of(self_obj);
    if n == (0 as *core::Node) { return; }
    refresh_nav_state(n, view);
    return;
}

fn did_terminate_imp(self_obj: *u8, cmd: *u8, view: *u8) {
    let n: *core::Node = node_of(self_obj);
    if n == (0 as *core::Node) { return; }
    let p: *props::WebProps = props_of_web(n);
    if p == (0 as *props::WebProps) { return; }
    fire(n, { (*p).on_process_terminated }, { (*p).on_process_terminated_ctx }, view);
    return;
}

// -[WKScriptMessageHandler userContentController:didReceiveScriptMessage:]
//
// The message body reaches the handler as the SENDER, stringified. facet's
// handler shape is `(sender, ctx)` and carries no payload slot, so the body is
// what `sender` is — the one reading that lets a page send anything at all.
fn did_receive_message_imp(self_obj: *u8, cmd: *u8, controller: *u8, message: *u8) {
    let n: *core::Node = node_of(self_obj);
    if n == (0 as *core::Node) { return; }
    let p: *props::HybridWebProps = props_of_hybrid(n);
    if p == (0 as *props::HybridWebProps) { return; }
    let m: wk::ScriptMessage = wk::ScriptMessage::from_raw(message);
    let body: *u8 = m.body();
    let as_string: *u8 = { rt::msg_id(body, rt::sel(#str_ptr("description\0"))) };
    fire(n, { (*p).on_raw_message_received }, { (*p).on_raw_message_received_ctx },
         as_string);
    return;
}

fn delegate_class() -> *u8 {
    let existing: *u8 = rt::get_class(#str_ptr("FacetWebDelegate\0"));
    if existing != (0 as *u8) { return existing; }
    let cls: *u8 = synth::allocate_class_pair(rt::get_class(#str_ptr("NSObject\0")),
                                              #str_ptr("FacetWebDelegate\0"), 0 as usize);
    synth::add_method_v_2id(cls, rt::sel(#str_ptr("webView:didStartProvisionalNavigation:\0")),
                            did_start_imp, #str_ptr("v@:@@\0"));
    synth::add_method_v_2id(cls, rt::sel(#str_ptr("webView:didFinishNavigation:\0")),
                            did_finish_imp, #str_ptr("v@:@@\0"));
    synth::add_method_v_3id(cls, rt::sel(#str_ptr("webView:didFailNavigation:withError:\0")),
                            did_fail_imp, #str_ptr("v@:@@@\0"));
    synth::add_method_v_3id(cls, rt::sel(#str_ptr("webView:didFailProvisionalNavigation:withError:\0")),
                            did_fail_imp, #str_ptr("v@:@@@\0"));
    synth::add_method_v_1id(cls, rt::sel(#str_ptr("webViewWebContentProcessDidTerminate:\0")),
                            did_terminate_imp, #str_ptr("v@:@\0"));
    synth::add_method_v_2id(cls, rt::sel(#str_ptr("userContentController:didReceiveScriptMessage:\0")),
                            did_receive_message_imp, #str_ptr("v@:@@\0"));
    synth::register_class_pair(cls);
    return cls;
}

// One delegate per view, pinned to it so it lives exactly as long.
fn new_delegate(view: *u8, n: *core::Node) -> *u8 {
    let d: *u8 = synth::alloc_init_class(delegate_class());
    if d == (0 as *u8) { return 0 as *u8; }
    synth::set_associated(d, node_key(), n as *u8);
    synth::retain_associated(view, delegate_pin_key(), d);
    rt::release(d);
    return d;
}

// ---- building the view -------------------------------------------------------

fn new_configuration() -> *u8 {
    return { rt::alloc_init(#str_ptr("WKWebViewConfiguration\0")) };
}

// A WKWebView at +1, with `config` consumed.
fn new_web_view(config: *u8) -> *u8 {
    let alloced: *u8 = { rt::msg_id(rt::get_class(#str_ptr("WKWebView\0")),
                                    rt::sel(#str_ptr("alloc\0"))) };
    let zero: rt::Rect = rt::Rect { x: 0.0f64, y: 0.0f64, w: 0.0f64, h: 0.0f64 };
    let v: *u8 = { msg_id_rect_id(alloced, rt::sel(#str_ptr("initWithFrame:configuration:\0")),
                                  zero, config) };
    return v;
}

#[link_name = "objc_msgSend"]
extern fn msg_id_rect_id(recv: *u8, sel: *u8, a: rt::Rect, b: *u8) -> *u8;

fn create_web(n: *core::Node) -> *u8 {
    let config: *u8 = new_configuration();
    let v: *u8 = new_web_view(config);
    rt::release(config);
    if v == (0 as *u8) { return 0 as *u8; }
    let d: *u8 = new_delegate(v, n);
    { rt::msg_void_id(v, rt::sel(#str_ptr("setNavigationDelegate:\0")), d) };
    return v;
}

// The hybrid view differs in ONE thing: a script message handler named `facet`
// on its content controller, which is the page's door back.
fn create_hybrid_web(n: *core::Node) -> *u8 {
    let config: *u8 = new_configuration();
    // BEFORE the view: a WKWebView's scheme handlers cannot be added once it
    // exists, which is why this is the one thing that has to happen here.
    let scheme: *u8 = install_scheme(config, n);
    let v: *u8 = new_web_view(config);
    if v == (0 as *u8) { rt::release(config); return 0 as *u8; }
    let d: *u8 = new_delegate(v, n);
    { rt::msg_void_id(v, rt::sel(#str_ptr("setNavigationDelegate:\0")), d) };
    let controller: *u8 = { rt::msg_id(config, rt::sel(#str_ptr("userContentController\0"))) };
    if controller != (0 as *u8) {
        { rt::msg_void_id_id(controller,
                             rt::sel(#str_ptr("addScriptMessageHandler:name:\0")),
                             d, bridge::nsstring("facet")) };
    }
    // The handler is retained by the configuration the view keeps, but the
    // ASSOCIATION back to the node is ours to hold: pin it on the view, which
    // outlives every task.
    if scheme != (0 as *u8) {
        synth::retain_associated(v, scheme_node_key(), scheme);
        rt::release(scheme);
    }
    rt::release(config);
    // `on_web_view_initializing` is BEFORE the view is usable and
    // `on_web_view_initialized` after — the only two moments the ledger names, and
    // both of them are here because this is where a WKWebView comes into being.
    let p: *props::HybridWebProps = props_of_hybrid(n);
    if p != (0 as *props::HybridWebProps) {
        fire(n, { (*p).on_web_view_initializing }, { (*p).on_web_view_initializing_ctx }, v);
        fire(n, { (*p).on_web_view_initialized }, { (*p).on_web_view_initialized_ctx }, v);
    }
    return v;
}

// ---- loading -----------------------------------------------------------------
// The ledger's `Source` is a WebViewSource — a URL one or an HTML one. facet reduced
// it to a `str`, so the STRING has to say which, and these are the three
// readings that cannot be confused with each other:
//
//   starts with `<`     markup, loaded as HTML
//   contains `://`      an absolute URL
//   anything else       a file path, loaded with read access to its folder
//
// A file needs the folder granted too, or its stylesheet and scripts are
// refused — which looks like a broken page rather than a permissions answer.
fn load_source(v: *u8, src: str) {
    if src == "" { return; }
    if starts_with_angle(src) {
        { rt::msg_id_id_id(v, rt::sel(#str_ptr("loadHTMLString:baseURL:\0")),
                           bridge::nsstring(src), 0 as *u8) };
        return;
    }
    if has_scheme(src) {
        let url: *u8 = { rt::msg_id_id(rt::get_class(#str_ptr("NSURL\0")),
                                       rt::sel(#str_ptr("URLWithString:\0")),
                                       bridge::nsstring(src)) };
        if url == (0 as *u8) { return; }
        let req: *u8 = { rt::msg_id_id(rt::get_class(#str_ptr("NSURLRequest\0")),
                                       rt::sel(#str_ptr("requestWithURL:\0")), url) };
        if req == (0 as *u8) { return; }
        { rt::msg_id_id(v, rt::sel(#str_ptr("loadRequest:\0")), req) };
        return;
    }
    let folder: text::Text = parent_of(src);
    load_file(v, src, folder.view());
    return;
}

fn load_file(v: *u8, path: str, folder: str) {
    let file: *u8 = { rt::msg_id_id(rt::get_class(#str_ptr("NSURL\0")),
                                    rt::sel(#str_ptr("fileURLWithPath:\0")),
                                    bridge::nsstring(path)) };
    if file == (0 as *u8) { return; }
    let dir: *u8 = { rt::msg_id_id(rt::get_class(#str_ptr("NSURL\0")),
                                   rt::sel(#str_ptr("fileURLWithPath:\0")),
                                   bridge::nsstring(folder)) };
    if dir == (0 as *u8) { return; }
    { rt::msg_id_id_id(v, rt::sel(#str_ptr("loadFileURL:allowingReadAccessToURL:\0")),
                       file, dir) };
    return;
}

fn byte_of(s: str, i: usize) -> u8 {
    return match s.byte_at(i) {
        option::Option[u8]::Some(b) => b,
        option::Option[u8]::None => 0 as u8,
    };
}

fn starts_with_angle(s: str) -> bool { return s.has_prefix("<"); }

// `://` anywhere makes it an absolute URL. Scanned by BYTE rather than by
// slicing, because a `str` is a borrowed view and every slice of one here
// would be a Text allocation per character.
fn has_scheme(s: str) -> bool {
    let n: usize = s.count();
    if n < (3 as usize) { return false; }
    var i: usize = 0 as usize;
    while (i + (3 as usize)) <= n {
        if byte_of(s, i) == (58 as u8) && byte_of(s, i + (1 as usize)) == (47 as u8)
           && byte_of(s, i + (2 as usize)) == (47 as u8) { return true; }
        i = i +% (1 as usize);
    }
    return false;
}

// The folder a path sits in — everything before the last separator, or "." for
// a bare name. Owned, because a `str` cannot be built from a shorter view of
// itself without one.
fn parent_of(path: str) -> text::Text {
    var cut: usize = 0 as usize;
    var found: bool = false;
    var i: usize = 0 as usize;
    let n: usize = path.count();
    while i < n {
        if byte_of(path, i) == (47 as u8) { cut = i; found = true; }
        i = i +% (1 as usize);
    }
    if !found { return text::from_str("."); }
    if cut == (0 as usize) { return text::from_str("/"); }
    // `slice` returns a view of the `path` param; copy it into the owned
    // return.
    return match path.slice(from: 0 as usize, to: cut) {
        option::Option[str]::Some(s) => text::from_str(s),
        option::Option[str]::None => text::from_str("."),
    };
}

fn eval_js(v: *u8, script: str) {
    if script == "" { return; }
    { rt::msg_void_id_id(v, rt::sel(#str_ptr("evaluateJavaScript:completionHandler:\0")),
                         bridge::nsstring(script), 0 as *u8) };
    return;
}

// ---- web ---------------------------------------------------------------------

fn apply_web(v: *u8, n: *core::Node, dirty: u64) {
    let p: *props::WebProps = props_of_web(n);
    if p == (0 as *props::WebProps) { return; }
    // The user agent BEFORE the source: a page loaded under the wrong agent
    // and re-loaded under the right one is two requests and a visible flash.
    if (dirty & web::P_USER_AGENT) != (0 as u64) {
        let ua: str = { (*p).user_agent.view() };
        if ua != "" {
            { rt::msg_void_id(v, rt::sel(#str_ptr("setCustomUserAgent:\0")),
                              bridge::nsstring(ua)) };
        }
    }
    if (dirty & web::P_SOURCE) != (0 as u64) {
        load_source(v, { (*p).source.view() });
    }
    // The commands. Each is a one-shot bit the sync walk clears.
    if (dirty & web::P_GO_BACK) != (0 as u64) {
        { rt::msg_id(v, rt::sel(#str_ptr("goBack\0"))) };
    }
    if (dirty & web::P_GO_FORWARD) != (0 as u64) {
        { rt::msg_id(v, rt::sel(#str_ptr("goForward\0"))) };
    }
    if (dirty & web::P_RELOAD) != (0 as u64) {
        { rt::msg_id(v, rt::sel(#str_ptr("reload\0"))) };
    }
    if (dirty & web::P_EVAL) != (0 as u64) {
        eval_js(v, { (*p).eval_script.view() });
    }
    return;
}

// ---- hybrid_web --------------------------------------------------------------

fn apply_hybrid_web(v: *u8, n: *core::Node, dirty: u64) {
    let p: *props::HybridWebProps = props_of_hybrid(n);
    if p == (0 as *props::HybridWebProps) { return; }
    // Root and default file are ONE load: a root without a file has nothing to
    // show, and a file without a root has no read access to its siblings.
    if (dirty & (hybrid_web::P_HYBRID_ROOT | hybrid_web::P_DEFAULT_FILE)) != (0 as u64) {
        let root: str = { (*p).hybrid_root.view() };
        let file: str = { (*p).default_file.view() };
        if root != "" && file != "" {
            // Over facet's OWN scheme, not file:// — which is what gives the
            // page an origin and gives every resource request somewhere to
            // arrive. See the scheme handler at the foot of this file.
            var url: text::Text = text::from_str(facet_scheme());
            let _a: status::Status = url.append("://root/");
            let _b: status::Status = url.append(file);
            let u: *u8 = { rt::msg_id_id(rt::get_class(#str_ptr("NSURL\0")),
                                         rt::sel(#str_ptr("URLWithString:\0")),
                                         bridge::nsstring(url.view())) };
            if u != (0 as *u8) {
                let req: *u8 = { rt::msg_id_id(rt::get_class(#str_ptr("NSURLRequest\0")),
                                               rt::sel(#str_ptr("requestWithURL:\0")), u) };
                if req != (0 as *u8) {
                    { rt::msg_id_id(v, rt::sel(#str_ptr("loadRequest:\0")), req) };
                }
            }
        }
    }
    if (dirty & hybrid_web::P_SEND_MESSAGE) != (0 as u64) {
        send_to_page(v, { (*p).outgoing_message.view() });
    }
    return;
}

// facet to the page. Guarded on the page's side existing, so a message sent
// before the page defined its handler is dropped rather than throwing inside
// the page — which would surface as a console error the application never
// wrote.
fn send_to_page(v: *u8, body: str) {
    if body == "" { return; }
    var js: text::Text = text::from_str("if (window.facet && window.facet.onmessage) { window.facet.onmessage(");
    let _a: status::Status = js.append(json_string(body).view());
    let _b: status::Status = js.append("; }");
    eval_js(v, js.view());
    return;
}

// The body as a JavaScript string literal. Only the three characters that can
// break out of one are escaped — a quote, a backslash and a newline — because
// this is a literal in a script we build, not a JSON document.
fn json_string(s: str) -> text::Text {
    let src: text::Text = text::from_str(s);
    var out: text::Text = text::from_str("\"");
    var start: usize = 0 as usize;
    var i: usize = 0 as usize;
    let n: usize = s.count();
    while i < n {
        let b: u8 = byte_of(s, i);
        var esc: str = "";
        if b == (34 as u8) { esc = "\\\""; }
        else if b == (92 as u8) { esc = "\\\\"; }
        else if b == (10 as u8) { esc = "\\n"; }
        else if b == (13 as u8) { esc = "\\r"; }
        if esc != "" {
            append_range(#addr_of(out), #addr_of(src), start, i);
            let _a: status::Status = out.append(esc);
            start = i +% (1 as usize);
        }
        i = i +% (1 as usize);
    }
    append_range(#addr_of(out), #addr_of(src), start, n);
    let _b: status::Status = out.append("\"");
    return out;
}

// The bytes of `src` in [from, to), appended to `out`. Whole ranges rather
// than bytes: a `str` is a borrowed view, so a one-byte view has nothing to
// borrow FROM, and copying per byte would allocate per character.
fn append_range(out: *text::Text, src: *text::Text, from: usize, to: usize) {
    if from >= to { return; }
    match { (*src).slice(from: from, to: to) } {
        option::Option[str]::Some(t) => {
            let _a: status::Status = { (*out).append(t) };
        }
        option::Option[str]::None => { }
    }
    return;
}

// ---- teardown ----------------------------------------------------------------
// A web view outlives its node, and that is not a bug in facet's ownership — it
// is WebKit's. While a load is in flight the WKWebView is retained by the page
// proxy, so releasing it does not deallocate it, its associated objects stay
// alive, and a navigation callback arrives LATER with a node pointer that is
// gone. Closing a window mid-load is the everyday version; an ASAN run caught
// it as a use-after-free inside `didStartProvisionalLoadForFrame`.
//
// So the node is cut loose EXPLICITLY rather than by the view's lifetime: the
// delegate keeps working, finds no node, and does nothing. Every IMP above
// already returns early on a null node, which is what makes this the whole fix.
fn detach(v: *u8) {
    if v == (0 as *u8) { return; }
    if synth::class_responds(synth::object_class(v),
                             rt::sel(#str_ptr("setNavigationDelegate:\0"))) == (0 as i8) {
        return;
    }
    // Stop first: no more callbacks are generated for a load nobody wants.
    { rt::msg_void(v, rt::sel(#str_ptr("stopLoading\0"))) };
    let d: *u8 = { synth::get_associated(v, delegate_pin_key()) };
    if d != (0 as *u8) {
        // The node association is the dangling one. Cleared here, so a callback
        // that is already queued finds nothing and returns.
        synth::set_associated(d, node_key(), 0 as *u8);
    }
    { rt::msg_void_id(v, rt::sel(#str_ptr("setNavigationDelegate:\0")), 0 as *u8) };
    return;
}

// Is this a web view at all? The teardown path asks before it acts, so no other
// kind pays for the check beyond one `respondsToSelector:`.
fn is_web_view(v: *u8) -> bool {
    if v == (0 as *u8) { return false; }
    return synth::class_responds(synth::object_class(v),
                                 rt::sel(#str_ptr("setNavigationDelegate:\0"))) != (0 as i8);
}

// ==============================================================================
// The hybrid scheme — and why `on_web_resource_requested` needed one
// ==============================================================================
//
// The ledger said "intercepting needs a WKURLSchemeHandler per scheme", which
// is true and was standing in for the reason it could not be done: hybrid
// content was loaded as `file://`, and WKWebView will not let a scheme handler
// near a reserved scheme. So there was nothing to hand a request to.
//
// Hybrid content now loads over a scheme of facet's own, which is what the ledger's
// own HybridWebView does on this platform for exactly this reason. Three
// things follow from it and all three are the point:
//
//   - every resource the page asks for arrives HERE, so
//     `on_web_resource_requested` fires for each one and means what it says.
//   - the page has an ORIGIN, so `localStorage` and `fetch` work, which they
//     do not from a file:// document.
//   - the read is ours, so it is bounded: a request that climbs out of
//     `hybrid_root` is refused rather than served.
//
// `web(source:)` is untouched — a plain web view loading a file or a URL is not
// a hybrid app and has no root to serve from.

fn facet_scheme() -> str { return "facet"; }
fn scheme_node_key() -> *u8 { return { 29022 as *u8 }; }

#[link_name = "objc_msgSend"]
extern fn msg_id_id_u64_i64_id(recv: *u8, sel: *u8, a: *u8, b: *u8, c: i64, d: *u8) -> *u8;
#[link_name = "objc_msgSend"]
extern fn msg_id_bytes(recv: *u8, sel: *u8, p: *u8, n: usize) -> *u8;
#[link_name = "objc_msgSend"]
extern fn msg_void_id_scheme(recv: *u8, sel: *u8, a: *u8, b: *u8);

// A path is served only if it stays under the root. `..` anywhere is refused
// outright rather than normalised: a normaliser is a thing to get wrong, and a
// hybrid app has no reason to name one.
fn escapes_root(p: str) -> bool {
    let n: usize = p.count();
    if n < (2 as usize) { return false; }
    var i: usize = 0 as usize;
    while (i + (2 as usize)) <= n {
        if byte_of(p, i) == (46 as u8) && byte_of(p, i + (1 as usize)) == (46 as u8) {
            return true;
        }
        i = i + (1 as usize);
    }
    return false;
}

fn mime_for(path: str) -> str {
    if path.has_suffix(".html") { return "text/html"; }
    if path.has_suffix(".htm") { return "text/html"; }
    if path.has_suffix(".js") { return "text/javascript"; }
    if path.has_suffix(".mjs") { return "text/javascript"; }
    if path.has_suffix(".css") { return "text/css"; }
    if path.has_suffix(".json") { return "application/json"; }
    if path.has_suffix(".svg") { return "image/svg+xml"; }
    if path.has_suffix(".png") { return "image/png"; }
    if path.has_suffix(".jpg") { return "image/jpeg"; }
    if path.has_suffix(".jpeg") { return "image/jpeg"; }
    if path.has_suffix(".gif") { return "image/gif"; }
    if path.has_suffix(".woff2") { return "font/woff2"; }
    return "application/octet-stream";
}

fn task_path(task: *u8) -> text::Text {
    let req: *u8 = { rt::msg_id(task, rt::sel(#str_ptr("request\0"))) };
    if req == (0 as *u8) { return text::new(); }
    let url: *u8 = { rt::msg_id(req, rt::sel(#str_ptr("URL\0"))) };
    if url == (0 as *u8) { return text::new(); }
    return bridge::to_text({ rt::msg_id(url, rt::sel(#str_ptr("path\0"))) });
}

fn fail_task(task: *u8) {
    // THREE ARGUMENTS, not four. This shared four-slot extern also serves
    // `initWithURL:MIMEType:expectedContentLength:textEncodingName:`, and the
    // spare `0 as *u8` copied across with it — which shifted every argument
    // one place right: the domain landed as the domain, NULL as the code, and
    // `404` reached `userInfo` AS A DICTIONARY POINTER. NSError keeps it and
    // anything that later reads the error's userInfo dereferences 404.
    let err: *u8 = { msg_id_id_i64_id(rt::get_class(#str_ptr("NSError\0")),
        rt::sel(#str_ptr("errorWithDomain:code:userInfo:\0")),
        bridge::nsstring("FacetHybrid"), 404 as i64, 0 as *u8) };
    if err == (0 as *u8) { return; }
    { rt::msg_void_id(task, rt::sel(#str_ptr("didFailWithError:\0")), err) };
    return;
}

fn start_task_imp(self_obj: *u8, cmd: *u8, wv: *u8, task: *u8) {
    let n: *core::Node = { synth::get_associated(self_obj, scheme_node_key()) as *core::Node };
    if n == (0 as *core::Node) { fail_task(task); return; }
    let p: *props::HybridWebProps = props_of_hybrid(n);
    if p == (0 as *props::HybridWebProps) { fail_task(task); return; }
    // The handler runs FIRST and for every resource, which is the whole verb.
    // It observes: a request is served whatever it does, because facet declares
    // no way to answer one and inventing a return channel here would be a verb
    // the contract does not have.
    fire(n, { (*p).on_web_resource_requested }, { (*p).on_web_resource_requested_ctx }, task);

    let rel: text::Text = task_path(task);
    if escapes_root(rel.view()) { fail_task(task); return; }
    var full: text::Text = text::from_str({ (*p).hybrid_root.view() });
    let _a: status::Status = full.append(rel.view());
    match fs::open_read(full.view()) {
        result::Result[fs::File, result::IoError]::Ok(f) => {
            var file: fs::File = f;
            match file.read_to_end() {
                result::Result[vec::Vec[u8], result::IoError]::Ok(bytes) => {
                    respond(task, bytes, mime_for(rel.view()));
                }
                result::Result[vec::Vec[u8], result::IoError]::Err(_e) => { fail_task(task); }
            }
        }
        result::Result[fs::File, result::IoError]::Err(_e) => { fail_task(task); }
    }
    return;
}

fn respond(task: *u8, bytes: vec::Vec[u8], mime: str) {
    let req: *u8 = { rt::msg_id(task, rt::sel(#str_ptr("request\0"))) };
    if req == (0 as *u8) { return; }
    let url: *u8 = { rt::msg_id(req, rt::sel(#str_ptr("URL\0"))) };
    if url == (0 as *u8) { return; }
    let alloced: *u8 = { rt::msg_id(rt::get_class(#str_ptr("NSURLResponse\0")),
                                    rt::sel(#str_ptr("alloc\0"))) };
    let resp: *u8 = { msg_id_id_u64_i64_id(alloced,
        rt::sel(#str_ptr("initWithURL:MIMEType:expectedContentLength:textEncodingName:\0")),
        url, bridge::nsstring(mime), bytes.count() as i64,
        bridge::nsstring("utf-8")) };
    if resp == (0 as *u8) { return; }
    // `as_byte_view` is the borrowed window onto the Vec's own storage, which
    // is what NSData wants — and it is copied by `dataWithBytes:`, so the view
    // does not have to outlive this statement.
    let view: str = bytes.as_byte_view();
    let data: *u8 = { msg_id_bytes(rt::get_class(#str_ptr("NSData\0")),
        rt::sel(#str_ptr("dataWithBytes:length:\0")),
        { #str_ptr(view) }, bytes.count()) };
    { rt::msg_void_id(task, rt::sel(#str_ptr("didReceiveResponse:\0")), resp) };
    if data != (0 as *u8) {
        { rt::msg_void_id(task, rt::sel(#str_ptr("didReceiveData:\0")), data) };
    }
    { rt::msg_void(task, rt::sel(#str_ptr("didFinish\0"))) };
    rt::release(resp);
    return;
}

// Nothing to stop: every response is delivered inside `start`, so a task is
// finished before this could be called for it.
fn stop_task_imp(self_obj: *u8, cmd: *u8, wv: *u8, task: *u8) { return; }

fn scheme_handler_class() -> *u8 {
    let existing: *u8 = rt::get_class(#str_ptr("FacetSchemeHandler\0"));
    if existing != (0 as *u8) { return existing; }
    let cls: *u8 = synth::allocate_class_pair(rt::get_class(#str_ptr("NSObject\0")),
                                              #str_ptr("FacetSchemeHandler\0"), 0 as usize);
    synth::add_method_v_2id(cls, rt::sel(#str_ptr("webView:startURLSchemeTask:\0")),
                            start_task_imp, #str_ptr("v@:@@\0"));
    synth::add_method_v_2id(cls, rt::sel(#str_ptr("webView:stopURLSchemeTask:\0")),
                            stop_task_imp, #str_ptr("v@:@@\0"));
    synth::register_class_pair(cls);
    return cls;
}

// Registered on the CONFIGURATION, which is why it happens at creation: a
// WKWebView's scheme handlers cannot be added once it exists.
fn install_scheme(config: *u8, n: *core::Node) -> *u8 {
    let h: *u8 = synth::alloc_init_class(scheme_handler_class());
    if h == (0 as *u8) { return 0 as *u8; }
    synth::set_associated(h, scheme_node_key(), n as *u8);
    { msg_void_id_scheme(config, rt::sel(#str_ptr("setURLSchemeHandler:forURLScheme:\0")),
                         h, bridge::nsstring(facet_scheme())) };
    return h;
}

#[link_name = "objc_msgSend"]
extern fn msg_id_id_i64_id(recv: *u8, sel: *u8, a: *u8, b: i64, c: *u8) -> *u8;
