// facet_appkit scheduler — the platform's scheduling primitives, and the sync
// tick that drives the whole seam.
//
// ---- the tick ----------------------------------------------------------------
//
// M5: `core::touch` requests a sync through the hook `mount::install`
// registers; the BACKEND coalesces those requests on its run loop and calls
// `mount::sync()`. facet has no loop of its own, so "coalesce" has to mean
// something the platform already does.
//
// It is a CFRunLoopObserver at kCFRunLoopBeforeWaiting (Stage 4 decision 1):
// the moment the loop has finished everything it had and is about to sleep.
// That is the flush point Core Animation itself commits on, so a batch of
// writes from one event lands as one visual update, and a hundred writes in a
// loop cost one tick rather than a hundred.
//
// `schedule` therefore does almost nothing: raise a flag, nudge the loop. The
// observer does the work.
//
// ---- what the tick does, in order --------------------------------------------
//
//   1. mount::sync()      per-node applies — the dirty word says what changed
//   2. the layout pass    per window: calculate_layout at the content view's
//                         size, then the frame walk (geometry.cplus)
//
// That order matters: an apply can change what a node MEASURES (a label's new
// text), and the layout pass right after it is what re-flows to fit. Running
// the layout pass unconditionally on a requested tick is deliberate — flex's
// incremental cache is what makes the "nothing actually moved" case cheap, and
// a tick only ever happens because something asked for one.

import "stdlib/vec" as vec;
import "stdlib/option" as option;
import "stdlib/status" as status;
import "flex_layout/flex_layout" as flex;
import "facet/facet" as core;
import "facet/mount" as mount;
import "facet/services" as services;
import "facet/application" as app;
import "objc/runtime" as rt;
import "appkit/appkit" as ak;
import "appkit/appkit_ext" as akx;
import "./geometry" as geometry;

// ---- CoreFoundation run loop -------------------------------------------------

extern fn CFRunLoopGetMain() -> *u8;
extern fn CFRunLoopWakeUp(rl: *u8);
extern fn CFRunLoopAddObserver(rl: *u8, observer: *u8, mode: *u8);
extern fn CFRunLoopObserverCreate(
    allocator: *u8,
    activities: u64,
    repeats: i8,
    order: i64,
    callout: fn(*u8, u64, *u8),
    context: *u8,
) -> *u8;
extern fn CFStringCreateWithCString(alloc: *u8, cstr: *u8, encoding: u32) -> *u8;

// The loop is about to sleep: everything queued has been handled.
fn cf_before_waiting() -> u64 { return 32 as u64; }
fn cf_utf8() -> u32 { return 134217984 as u32; }   // kCFStringEncodingUTF8

// kCFRunLoopCommonModes, the REAL constant, read through dlsym.
//
// This used to build an equal CFString instead, on the reasoning that the
// constant's value IS the string "kCFRunLoopCommonModes" and CFEqual would
// match it. It does not: CFRunLoop recognises the common-modes SENTINEL by
// POINTER, so an equal-but-different string is treated as an ordinary mode
// named "kCFRunLoopCommonModes" — a mode nothing ever runs in. The observer
// was created, added and never called, and that is exactly what it looks like
// from the outside: every write marked dirty, every tick missed, nothing on
// screen ever updating.
//
// dlsym hands back the ADDRESS OF THE VARIABLE, so the CFStringRef is one
// dereference further in.
fn common_modes() -> *u8 {
    let rtld_default: *u8 = { ((0 as usize) -% (2 as usize)) as *u8 };
    let slot: *u8 = { dlsym(rtld_default, #str_ptr("kCFRunLoopCommonModes\0")) };
    if slot == (0 as *u8) { return 0 as *u8; }
    return { *(slot as **u8) };
}

// CFRunLoopObserverContext: {version, info, retain, release, copyDescription}.
// Zeroed — the observer carries no info, because the pending flag below is
// process state either way (one backend per process, one main loop).
struct ObserverContext {
    version: i64,
    opaque info: *u8,
    opaque retain: *u8,
    opaque release: *u8,
    opaque copy_description: *u8,
}

// ---- the pending flag --------------------------------------------------------
// Process-scoped by nature: there is one main run loop and one backend. Both
// are exactly what the statics rule allows a static to hold.

static SYNC_PENDING: bool = false;
static OBSERVER_INSTALLED: bool = false;
static TICKS: u64 = 0 as u64;

// Renderer.schedule. Called from core::touch on every unbatched write, so it
// must stay this cheap.
fn schedule(ctx: *u8) {
    SYNC_PENDING = true;
    if OBSERVER_INSTALLED {
        let rl: *u8 = { CFRunLoopGetMain() };
        if rl != (0 as *u8) { { CFRunLoopWakeUp(rl) }; }
    }
    return;
}

fn before_waiting(observer: *u8, activity: u64, info: *u8) {
    tick();
    return;
}

// The tick itself, factored out so the suite can drive it without a run loop.
fn tick() {
    if !SYNC_PENDING { return; }
    SYNC_PENDING = false;
    TICKS = TICKS +% (1 as u64);
    mount::sync();
    layout_all_windows();
    return;
}

// How many ticks have run. For tests, and for anyone measuring whether writes
// are coalescing the way the observer is supposed to make them.
fn ticks() -> u64 { return TICKS; }
fn sync_pending() -> bool { return SYNC_PENDING; }
fn observer_installed() -> bool { return OBSERVER_INSTALLED; }

fn install_sync_tick() {
    if OBSERVER_INSTALLED { return; }
    let rl: *u8 = { CFRunLoopGetMain() };
    if rl == (0 as *u8) { return; }
    var cx: ObserverContext = ObserverContext {
        version: 0 as i64,
        info: 0 as *u8,
        retain: 0 as *u8,
        release: 0 as *u8,
        copy_description: 0 as *u8,
    };
    let obs: *u8 = { CFRunLoopObserverCreate(
        0 as *u8,
        cf_before_waiting(),
        1 as i8,                 // repeats
        2147483647 as i64,       // order: last, after AppKit's own observers
        before_waiting,
        #addr_of(cx) as *u8,
    ) };
    if obs == (0 as *u8) { return; }
    { CFRunLoopAddObserver(rl, obs, common_modes()) };
    OBSERVER_INSTALLED = true;
    return;
}

// ---- the layout pass ---------------------------------------------------------

// Every open window of the running app: lay its tree out at the content view's
// current size and walk the frames. The window host calls this directly too,
// on windowDidResize and once after the window is first shown.
fn layout_all_windows() {
    var i: usize = 0 as usize;
    let n: usize = app::window_count();
    while i < n {
        let root: *core::Node = app::window_root(i);
        if root != (0 as *core::Node) { layout_window(root); }
        i = i +% (1 as usize);
    }
    return;
}

// One window. The host is the window's content view — the flipped view the
// shell installed — so the tree lays out at exactly the size it fills.
// ---- the split registry -------------------------------------------------------
// Splits are REGISTERED, not queued, and re-settled after every layout walk.
//
// A queue was wrong twice over. A job captures the position it was queued with,
// so a user drag — which updates the props — is overwritten on the next walk by
// whatever the constructor asked for. And a job only runs on a walk it was
// queued for, so a window resize, which runs the walk with no apply before it,
// re-sizes the panes from flex and re-asserts nothing.
//
// A registry has neither problem: every walk ends by settling every split
// against the props' CURRENT position, which is the one place the number lives.
//
// The settle itself is a fn-pointer, so this module needs to know nothing about
// splits — the same shape the place jobs use, and what keeps `controls`
// importable from here without a cycle.
static SPLIT_NODES: vec::Vec[*core::Node] = #zero::[vec::Vec[*core::Node]]();
static SPLIT_SETTLE_FN: fn(*core::Node) = #zero::[fn(*core::Node)]();

fn set_split_settle_fn(f: fn(*core::Node)) { SPLIT_SETTLE_FN = f; return; }

fn register_split(n: *core::Node) {
    if n == (0 as *core::Node) { return; }
    let reg: *vec::Vec[*core::Node] = { #addr_of(SPLIT_NODES) };
    var i: usize = 0 as usize;
    let count: usize = { (*reg).count() };
    while i < count {
        match { (*reg).at(i) } {
            option::Option[*core::Node]::Some(p) => { if p == n { return; } }
            option::Option[*core::Node]::None => { }
        }
        i = i +% (1 as usize);
    }
    let _s: status::Status = { (*reg).append(n) };
    return;
}

// Drop a split that is no longer mounted, so a registry entry cannot outlive
// the node it points at.
fn forget_split(n: *core::Node) {
    let reg: *vec::Vec[*core::Node] = { #addr_of(SPLIT_NODES) };
    var i: usize = 0 as usize;
    while i < { (*reg).count() } {
        match { (*reg).at(i) } {
            option::Option[*core::Node]::Some(p) => {
                if p == n {
                    let _g: option::Option[*core::Node] = { (*reg).swap_remove(i) };
                    return;
                }
            }
            option::Option[*core::Node]::None => { }
        }
        i = i +% (1 as usize);
    }
    return;
}

fn resettle_splits() {
    let f: fn(*core::Node) = SPLIT_SETTLE_FN;
    if f == (0 as fn(*core::Node)) { return; }
    let reg: *vec::Vec[*core::Node] = { #addr_of(SPLIT_NODES) };
    var i: usize = 0 as usize;
    let count: usize = { (*reg).count() };
    while i < count {
        match { (*reg).at(i) } {
            option::Option[*core::Node]::Some(p) => { f(p); }
            option::Option[*core::Node]::None => { }
        }
        i = i +% (1 as usize);
    }
    return;
}

// The same two-phase problem, one step more general: anything that must be
// placed against a REAL frame. `apply` runs before layout, so a view sized 0x0
// there cannot centre, measure or clamp anything against its host.
//
// The job carries its own function, so this queue needs to know nothing about
// the control it serves — which is also what keeps `controls` importable from
// here without a cycle.
struct PlaceJob {
    // The NODE only. Its view is `core::view_of(n)`, so carrying both would be
    // two names for one thing — and a trailing `*u8` in a fn type reads as a
    // handler's context slot, which this is not (W0824/W0825 both said so).
    f: fn(*core::Node),
    opaque n: *core::Node,
}

static PLACE_JOBS: vec::Vec[PlaceJob] = #zero::[vec::Vec[PlaceJob]]();

fn defer_place(f: fn(*core::Node), n: *core::Node) {
    if n == (0 as *core::Node) { return; }
    let jobs: *vec::Vec[PlaceJob] = { #addr_of(PLACE_JOBS) };
    let _s: status::Status = { (*jobs).append(PlaceJob { f: f, n: n }) };
    // Same reason as `defer_split`: `mount` runs `apply` directly, outside a
    // tick, so a job queued there would wait for a layout nobody asked for.
    schedule(0 as *u8);
    return;
}

fn drain_place_jobs() {
    let jobs: *vec::Vec[PlaceJob] = { #addr_of(PLACE_JOBS) };
    while { (*jobs).count() } > (0 as usize) {
        let last: usize = { (*jobs).count() } -% (1 as usize);
        match { (*jobs).swap_remove(last) } {
            option::Option[PlaceJob]::Some(job) => {
                let f: fn(*core::Node) = { job.f };
                if f != (0 as fn(*core::Node)) { f({ job.n }); }
            }
            option::Option[PlaceJob]::None => { }
        }
    }
    return;
}

fn layout_window(root: *core::Node) {
    let win: *u8 = app::window_native(root);
    if win == (0 as *u8) { return; }
    match ak::Window::from_raw(win).content_view() {
        option::Option[ak::View]::Some(content) => {
            let f: rt::Rect = content.frame();
            // The safe area, which is the shared band's `safe_area` finally
            // having somewhere to land. A window's content view knows its own
            // insets — the titlebar when the content runs under it, the notch
            // in full screen — and AppKit will not apply them for us because
            // facet places every child by frame rather than by constraint.
            //
            // So the root is laid out INSIDE the insets and placed at their
            // origin. `SafeArea::None` is the only answer that opts out, and
            // it is the one that gets the whole content view.
            let ins: ak::EdgeInsets = safe_insets(content, root);
            let w: f64 = f.w - ins.left - ins.right;
            let h: f64 = f.h - ins.top - ins.bottom;
            geometry::relayout_root(root, w, h, ak::Window::from_raw(win).backing_scale_factor());
            // The root's own view fills the safe box: mount inserted it
            // nowhere (the facade did), so the frame walk never sizes it.
            let rv: *u8 = core::view_of(root);
            if rv != (0 as *u8) {
                geometry::set_view_frame(rv, rt::Rect { x: ins.left, y: ins.top, w: w, h: h });
                resettle_splits();
                drain_place_jobs();
                return;
            }
            // A pass-through root has no view of its own, so the facade put
            // its topmost BACKED descendants in the window instead — and those
            // are the views the inset has to move, or a DSL-authored screen
            // ignores the safe area that a keyed one honours.
            if ins.left != 0.0f64 || ins.top != 0.0f64 { offset_root_views(root, ins.left, ins.top); }
            resettle_splits();
            drain_place_jobs();
        }
        option::Option[ak::View]::None => { }
    }
    return;
}

// The insets this root wants kept clear, or zero when it opts out.
fn safe_insets(content: ak::View, root: *core::Node) -> ak::EdgeInsets {
    if !core::honours_safe_area(root) {
        return ak::EdgeInsets { top: 0.0f64, left: 0.0f64, bottom: 0.0f64, right: 0.0f64 };
    }
    return { msg_insets(content.raw(), rt::sel(#str_ptr("safeAreaInsets\0"))) };
}

#[link_name = "objc_msgSend"]
extern fn msg_insets(recv: *u8, sel: *u8) -> ak::EdgeInsets;

// Shift the topmost backed views of a pass-through root by the inset. Mirrors
// `window::add_root_views`, which chose them.
fn offset_root_views(n: *core::Node, dx: f64, dy: f64) {
    if n == (0 as *core::Node) { return; }
    let v: *u8 = core::view_of(n);
    if v != (0 as *u8) {
        let b: rt::Rect = { rt::msg_rect(v, rt::sel(#str_ptr("frame\0"))) };
        geometry::set_view_frame(v, rt::Rect { x: b.x + dx, y: b.y + dy, w: b.w, h: b.h });
        return;
    }
    var i: usize = 0 as usize;
    let count: usize = core::child_count_of(n);
    while i < count {
        match core::child_of(n, i) {
            option::Option[*core::Node]::Some(c) => { offset_root_views(c, dx, dy); }
            option::Option[*core::Node]::None => { }
        }
        i = i +% (1 as usize);
    }
    return;
}

// ---- run_on_main -------------------------------------------------------------
// The hop every background result rides home on. Non-blocking: the caller
// returns immediately and the main loop picks the work up on its next turn.

extern fn dlsym(handle: *u8, symbol: *u8) -> *u8;
extern fn dispatch_async_f(queue: *u8, ctx: *u8, work: fn(*u8));

// `dispatch_get_main_queue()` is a macro over a libdispatch global, so there
// is no function to call — dlsym the symbol (RTLD_DEFAULT is -2 on Darwin).
fn main_dispatch_queue() -> *u8 {
    let rtld_default: *u8 = { ((0 as usize) -% (2 as usize)) as *u8 };
    return { dlsym(rtld_default, #str_ptr("_dispatch_main_q\0")) };
}

fn run_on_main(work: fn(*u8), ctx: *u8) {
    { dispatch_async_f(main_dispatch_queue(), ctx, work) };
    return;
}

// ---- the async pump — `spawn_ui`'s wake source -------------------------------
//
// Without this, a UI task runs to its FIRST suspension and is never polled
// again: `spawn_ui` does one `run_on_main(pump_async)` hop, and a task that
// then parks on a timer or an fd has nothing left to wake it. Every
// `spawn_ui` that awaited anything real was parked for the life of the
// process, and `run_on_worker` — which awaits `net::read_fd_async` — never
// returned at all.
//
// services.cplus says plainly "The backend calls this whenever the reactor's
// kqueue reads ready", and no file in this package mentioned the reactor. The
// pre-regen backend had it (`git show eb5b1b7:.../facet_appkit.cplus:1611`)
// and it was not ported.
//
// The mechanism: the stdlib reactor parks suspended coroutines and wakes them
// off a kqueue, and a kqueue fd itself READS AS READY when it holds events. So
// a dispatch read source on that fd, on the main queue, makes the AppKit run
// loop the executor — a timer or fd firing inside the reactor runs
// `pump_async` on the main thread, which resumes everything that can progress.
extern fn dispatch_source_create(type_: *u8, handle: u64, mask: u64, queue: *u8) -> *u8;
extern fn dispatch_source_set_event_handler_f(source: *u8, handler: fn(*u8));
extern fn dispatch_resume(obj: *u8);
extern fn stdlib_reactor_kqfd_v1() -> i32;

static ASYNC_PUMP_SOURCE: *u8 = #zero::[*u8]();

fn install_async_pump() {
    if ASYNC_PUMP_SOURCE != (0 as *u8) { return; }
    // `_dispatch_source_type_read` is a libdispatch global, not a function —
    // the same dlsym shape `main_dispatch_queue` needs and for the same reason.
    let rtld_default: *u8 = { ((0 as usize) -% (2 as usize)) as *u8 };
    let read_type: *u8 = { dlsym(rtld_default, #str_ptr("_dispatch_source_type_read\0")) };
    if read_type == (0 as *u8) { return; }
    let kq: i32 = { stdlib_reactor_kqfd_v1() };
    if kq < (0 as i32) { return; }
    let src: *u8 = { dispatch_source_create(read_type, kq as u64, 0 as u64, main_dispatch_queue()) };
    if src == (0 as *u8) { return; }
    { dispatch_source_set_event_handler_f(src, services::pump_async) };
    { dispatch_resume(src) };
    ASYNC_PUMP_SOURCE = src;
    return;
}

fn async_pump_installed() -> bool { return ASYNC_PUMP_SOURCE != (0 as *u8); }

// ---- observe_size ------------------------------------------------------------
// The event half of element geometry: fire on the UI thread after every resize
// of this element — divider drag, window resize, relayout.

fn observe_size(n: *core::Node, cb: fn(*u8), ctx: *u8) -> u64 {
    if n == (0 as *core::Node) { return 0 as u64; }
    var v: *u8 = core::view_of(n);
    // A node with no view of its own is not a node with no SIZE. A keyless
    // pure-layout container passes through to the nearest backed ancestor and
    // is laid out with it — and `@ui { }` produces exactly such a root, so
    // observing a DSL-authored screen's size answered an already-cancelled
    // handle and the caller was never told anything.
    //
    // The nearest backed ancestor is the view whose frame this node's size
    // follows, so that is what gets observed.
    if v == (0 as *u8) { v = nearest_backed_view(n); }
    if v == (0 as *u8) { return 0 as u64; }
    return akx::observe_frame(ak::View::from_raw(v), cb, ctx);
}

// A node has no parent pointer, so the ancestor is found by searching DOWN
// from each open window's root and carrying the last backed node seen. Once
// per observer, not per frame, so the walk is affordable.
fn nearest_backed_view(target: *core::Node) -> *u8 {
    var i: usize = 0 as usize;
    let n: usize = app::window_count();
    while i < n {
        let root: *core::Node = app::window_root(i);
        if root != (0 as *core::Node) {
            let hit: *u8 = backed_ancestor_walk(root, target, 0 as *u8);
            if hit != (0 as *u8) { return hit; }
        }
        i = i +% (1 as usize);
    }
    return 0 as *u8;
}

fn backed_ancestor_walk(node: *core::Node, target: *core::Node, carried: *u8) -> *u8 {
    var here: *u8 = carried;
    let v: *u8 = core::view_of(node);
    if v != (0 as *u8) { here = v; }
    if node == target { return here; }
    var i: usize = 0 as usize;
    let count: usize = core::child_count_of(node);
    while i < count {
        match core::child_of(node, i) {
            option::Option[*core::Node]::Some(c) => {
                let hit: *u8 = backed_ancestor_walk(c, target, here);
                if hit != (0 as *u8) { return hit; }
            }
            option::Option[*core::Node]::None => { }
        }
        i = i +% (1 as usize);
    }
    return 0 as *u8;
}

// ---- the struct facet installs -----------------------------------------------

fn scheduler() -> services::Scheduler {
    return services::Scheduler {
        run_on_main: run_on_main,
        after: akx::after,
        cancel_after: akx::cancel_after,
        observe_size: observe_size,
        cancel_observe_size: akx::cancel_observe_frame,
    };
}
