// facet_appkit recycler — `list` and `collection` on a recycling NSTableView.
//
// The scaling answer for long content. Only the rows in and near the viewport
// exist; a cell view that leaves the viewport is reused for a row coming in, so
// ten thousand rows cost about a screenful of views rather than ten thousand.
//
// ---- why this is a SECOND mount path -----------------------------------------
//
// Every other control's children are facet's: the mount walk creates them, the
// frame walk places them, teardown releases them. A recycled row is none of
// that. AppKit decides when it exists, so the row's subtree is realised through
// `mount::realise` — the same walk, minus the window — and torn down through
// `mount::unrealise` when its cell is taken for another row.
//
// The node is OWNED BY THE CELL, on an associated key, because in facet a node
// owns its views: drop the node and the views go with it. The old backend could
// let the node drop after applying, since its renderer retained the views
// separately; here that would empty the cell the instant it was filled.
//
// ---- what makes it fast, and what does not -----------------------------------
//
// NSTableView asks `heightOfRow:` for EVERY row whenever it recomputes geometry
// — not only the visible ones — and answering means building the row and laying
// it out. Without a cache a scroll re-measures the whole list on every pass,
// which is felt as a periodic hitch. So heights are cached by row, and the
// cache is keyed to the width it was measured at.
//
// `row_height` skips measurement ENTIRELY. When an application knows its rows
// are uniform that is the cheapest a list can be: no build, no layout, no
// cache, and no O(rows) pass on a resize.
//
// What this does NOT yet do is reuse the row's CONTENTS. A recycled cell is
// stripped and its subtree rebuilt from a fresh description, so scrolling pays
// a full build per row — the cell is reused and the work is not. Fixing that
// needs a contract answer (a bind step that writes a row's data into an
// existing subtree instead of describing a new one), and it is the next thing
// on this file rather than a note nobody wrote down.

import "stdlib/option" as option;
import "stdlib/env" as env;
import "stdlib/io" as io;
import "stdlib/text" as text;
import "stdlib/vec" as vec;
import "stdlib/box" as box;
import "stdlib/status" as status;
import "flex_layout/flex_layout" as flex;
import "facet/facet" as core;
import "facet/props" as props;
import "facet/mount" as mount;
import "facet/list" as list;
import "facet/vocabulary" as vocab;
import "facet/tree" as tree;
import "./controls" as controls;
import "./paint" as paint;
import "./compose" as compose;
import "./geometry" as geometry;
import "./scheduler" as scheduler;
import "objc/runtime" as rt;
import "objc/synthesis" as synth;
import "objc/bridge" as bridge;
import "appkit/appkit" as ak;
import "appkit/appkit_ext" as akx;

// ---- the method shapes AppKit's two protocols need ---------------------------

#[link_name = "class_addMethod"]
extern fn add_method_i64_1id(cls: *u8, sel: *u8, imp: fn(*u8, *u8, *u8) -> i64,
                             types: *u8) -> i8;

#[link_name = "class_addMethod"]
extern fn add_method_f64_1id_i64(cls: *u8, sel: *u8,
                                 imp: fn(*u8, *u8, *u8, i64) -> f64, types: *u8) -> i8;

#[link_name = "class_addMethod"]
extern fn add_method_id_2id_i64(cls: *u8, sel: *u8,
                                imp: fn(*u8, *u8, *u8, *u8, i64) -> *u8,
                                types: *u8) -> i8;

#[link_name = "objc_msgSend"]
extern fn msg_id_id_i64(recv: *u8, sel: *u8, a: *u8, b: i64) -> *u8;

#[link_name = "objc_msgSend"]
extern fn msg_void_rect(recv: *u8, sel: *u8, r: rt::Rect);

// ---- associated keys ---------------------------------------------------------
// facet_appkit owns 29000 and up, in one block per file:
//
//   drawing 29000   input 29010   web 29020   recycler 29030   dialogs 29040
//   text_input 29050   scrolling 29060   bordered stroke 29070   compose 29080
//
// NOT 28xxx, which is where `cpc-bindgen` allocates the generated binding's own
// delegate keys from — appkit.cplus is already at 28733 and grows with the SDK.
// An associated key is per-object, so an overlap is silent until the day one
// lands on the same object twice; `keys_are_distinct` is the gate, and the
// range is what keeps the gate from having to be re-won on every regen.

fn source_key() -> *u8 { return { 29030 as *u8 }; }
fn cell_node_key() -> *u8 { return { 29031 as *u8 }; }
// The outline item a cell is currently showing, and the view that vended it.
// Unretained on purpose: both outlive the cell — the item is owned by the tree's
// box map, the outline view owns the cell's whole subtree.
fn cell_item_key() -> *u8 { return { 29037 as *u8 }; }
fn cell_owner_key() -> *u8 { return { 29038 as *u8 }; }
fn agent_pin_key() -> *u8 { return { 29032 as *u8 }; }

// ---- the row source ----------------------------------------------------------
// One per list, heap-allocated and pinned to the table view, so it lives
// exactly as long as the thing that reads it.

struct RowSource {
    row: fn(usize, *u8) -> core::Node,
    bind: fn(usize, *core::Node, *u8),
    opaque row_ctx: *u8,
    count: i64,
    // `row_height` from the contract: 0 means measure, anything else means the
    // rows are uniform and nothing needs measuring at all.
    fixed_height: f64,
    // Measured heights by row; 0 = not measured yet. Grown with zeros so the
    // index always means the row, however the table walks them.
    heights: vec::Vec[f64],
    // The width those measurements were taken at. A different width re-wraps
    // every row, so the whole cache is worth nothing.
    heights_width: f64,
    // ---- the resize pass ------------------------------------------------
    // A live drag changes the width on every frame, and every change
    // invalidates every measurement. Reloading on each one re-measures the
    // whole list dozens of times a second, which is the resize hitch.
    // So a reload is SCHEDULED and the token kept, and the next frame cancels
    // the one before it: the list re-measures once, when the drag settles.
    last_width: f64,

    // Was the viewport at the bottom when this resize began? Read BEFORE the
    // reload changes the geometry, and re-pinned after — the chat behaviour,
    // and the one that is invisible until it is missing.
    follow_tail: bool,
    opaque table: *u8,
    // The node this table backs. Handlers are read out of its props at fire
    // time rather than captured, so a swapped handler needs no re-install.
    // `opaque`: the TREE owns the node; this is a borrow that never outlives it.
    opaque node: *core::Node,
    // `has_uneven_rows == false`: measure ONE row and answer with it for all.
    uniform: bool,
    // ---- grouping -------------------------------------------------------
    // A grouped table is the SAME flat sequence with headers interleaved, so
    // `row` is untouched and every table index is translated on the way in.
    // `groups == 0` means ungrouped and the translation is the identity.
    groups: i64,
    // The height of a row WITHOUT building it. `no_row_height_of` (or a 0
    // answer) means "build and measure", which is what every list did before.
    row_height_of: fn(usize, *u8) -> f64,
    opaque row_height_of_ctx: *u8,
    // Which SHAPE a row has, and therefore which reuse pool its cell comes
    // from. `no_row_kind` answers 0 for everything — one pool, which is what
    // this table had before a list could say otherwise.
    row_kind: fn(usize, *u8) -> usize,
    opaque row_kind_ctx: *u8,
    group_size: fn(usize, *u8) -> usize,
    opaque group_size_ctx: *u8,
    group_header: fn(usize, *u8) -> core::Node,
    opaque group_header_ctx: *u8,
}

// A TABLE row back to what it shows. Negative is a header: `-(g+1)`, because 0
// is a valid data index and a header of group 0 has to be distinguishable from
// it. Non-negative is the flat data index the application counts in.
fn resolve_row(s: *RowSource, row: i64) -> i64 {
    if { (*s).groups } <= (0 as i64) { return row; }
    let size: fn(usize, *u8) -> usize = { (*s).group_size };
    var at: i64 = 0 as i64;
    var flat: i64 = 0 as i64;
    var g: i64 = 0 as i64;
    while g < { (*s).groups } {
        if at == row { return -(g +% (1 as i64)); }
        at = at +% (1 as i64);
        let rows: i64 = size(g as usize, { (*s).group_size_ctx }) as i64;
        var k: i64 = 0 as i64;
        while k < rows {
            if at == row { return flat; }
            at = at +% (1 as i64);
            flat = flat +% (1 as i64);
            k = k +% (1 as i64);
        }
        g = g +% (1 as i64);
    }
    return -1 as i64;
}

// The reverse, for a selection written FROM the contract: which table row shows
// data index `data`.
fn table_row_of(s: *RowSource, data: i64) -> i64 {
    if data < (0 as i64) { return -1 as i64; }
    if { (*s).groups } <= (0 as i64) { return data; }
    var row: i64 = 0 as i64;
    let total: i64 = table_row_count(s);
    while row < total {
        if resolve_row(s, row) == data { return row; }
        row = row +% (1 as i64);
    }
    return -1 as i64;
}

fn is_header_row(s: *RowSource, row: i64) -> bool {
    return resolve_row(s, row) < (0 as i64);
}

// The first table row that shows DATA: 0 when ungrouped, and past the leading
// header when grouped. It is a scan rather than a constant because a group of
// size ZERO contributes a header and no rows, so the first data row is not
// always row 1. Reached only on the uniform-height path, once per query, over
// a row count that is headers-plus-items.
fn first_data_row(s: *RowSource) -> i64 {
    if { (*s).groups } <= (0 as i64) { return 0 as i64; }
    let total: i64 = table_row_count(s);
    var r: i64 = 0 as i64;
    while r < total {
        if resolve_row(s, r) >= (0 as i64) { return r; }
        r = r +% (1 as i64);
    }
    return 0 as i64;
}

// Headers plus rows. A grouped table's row count is not its item count, which
// is the whole reason every index has to be translated.
fn table_row_count(s: *RowSource) -> i64 {
    if { (*s).groups } <= (0 as i64) { return { (*s).count }; }
    let size: fn(usize, *u8) -> usize = { (*s).group_size };
    var total: i64 = { (*s).groups };
    var g: i64 = 0 as i64;
    while g < { (*s).groups } {
        total = total +% (size(g as usize, { (*s).group_size_ctx }) as i64);
        g = g +% (1 as i64);
    }
    return total;
}

fn source_of(tv: *u8) -> *RowSource {
    if tv == (0 as *u8) { return 0 as *RowSource; }
    return { synth::get_associated(tv, source_key()) as *RowSource };
}

// FINISH APPKIT'S LAYOUT BEFORE MEASURING. The column is what rows are measured
// against, and a layer-backed table tiles its columns in ITS layout pass —
// deferred to the Core Animation commit, which runs after the tick, and during
// a live divider drag may not run between events at all. Read without forcing
// it, the column still answers the width the LAST pass tiled (measured on a
// drag: table already 471 while the column said 100), and every row is laid out
// one resize behind, or never.
//
// Headless — where nothing defers — this is a no-op, which is why the suite's
// simulated widths stay authoritative.
fn layout_enclosing_scroll(tv: *u8) {
    if tv == (0 as *u8) { return; }
    var host: *u8 = { rt::msg_id(tv, rt::sel(#str_ptr("enclosingScrollView\0"))) };
    if host == (0 as *u8) { host = tv; }
    { rt::msg_void(host, rt::sel(#str_ptr("layoutSubtreeIfNeeded\0"))) };
    return;
}

// The width a CELL gets — the COLUMN's, not the table's frame.
//
// This one is a bug, not a detail. Modern NSTableView styles inset cells
// horizontally, so the frame is WIDER than the column; measuring wrapped rows
// at frame width under-measures their height and clips the last lines at
// certain widths. It presents as "scrolling down does not show the rest of the
// message", which is nothing like the mistake that caused it.
fn column_width(tv: *u8) -> f64 {
    let cols: *u8 = { rt::msg_id(tv, rt::sel(#str_ptr("tableColumns\0"))) };
    if cols != (0 as *u8) {
        let n: u64 = { rt::msg_u64(cols, rt::sel(#str_ptr("count\0"))) };
        if n > (0 as u64) {
            let c0: *u8 = { rt::msg_id_u64(cols, rt::sel(#str_ptr("objectAtIndex:\0")), 0 as u64) };
            if c0 != (0 as *u8) {
                let w: f64 = { rt::msg_f64(c0, rt::sel(#str_ptr("width\0"))) };
                if w >= 1.0f64 { return w; }
            }
        }
    }
    let fw: f64 = { rt::msg_rect(tv, rt::sel(#str_ptr("frame\0"))) }.w;
    if fw < 1.0f64 { return 1.0f64; }
    return fw;
}

// ---- the data source and delegate --------------------------------------------

fn num_rows_imp(self_obj: *u8, cmd: *u8, tv: *u8) -> i64 {
    let s: *RowSource = source_of(tv);
    if s == (0 as *RowSource) { return 0 as i64; }
    return table_row_count(s);
}

// AppKit's own group styling for a header row — which is why a header is a row
// rather than a decoration: the table already knows how to draw one.
fn is_group_row_imp(self_obj: *u8, cmd: *u8, tv: *u8, row: i64) -> i8 {
    let s: *RowSource = source_of(tv);
    if s == (0 as *RowSource) { return 0 as i8; }
    return is_header_row(s, row) as i8;
}

// Build TABLE row `i` as a detached facet node. A header and a row come from
// different builders, and the caller cannot tell them apart — which is the
// point: every path through this file speaks in table rows and the translation
// happens once, here.
fn build_row(s: *RowSource, i: i64) -> core::Node {
    let at: i64 = resolve_row(s, i);
    if at < (0 as i64) {
        let h: fn(usize, *u8) -> core::Node = { (*s).group_header };
        return h((-at -% (1 as i64)) as usize, { (*s).group_header_ctx });
    }
    let f: fn(usize, *u8) -> core::Node = { (*s).row };
    return f(at as usize, { (*s).row_ctx });
}

fn height_imp(self_obj: *u8, cmd: *u8, tv: *u8, row: i64) -> f64 {
    let s: *RowSource = source_of(tv);
    if s == (0 as *RowSource) { return 1.0f64; }
    // Uniform rows: answer without building anything. The cheapest a list can
    // be, and the whole reason `row_height` is in the contract.
    let fh: f64 = { (*s).fixed_height };
    if fh >= 1.0f64 { return fh; }

    let w: f64 = column_width(tv);
    let hp: *vec::Vec[f64] = { #addr_of((*s).heights) };
    if w != { (*s).heights_width } {
        { (*hp).remove_all() };
        { (*s).heights_width = w };
    } else if row >= (0 as i64) {
        var probe: usize = row as usize;
        // `uniform` says every DATA row measures the same. It says nothing
        // about a HEADER, which comes from `group_header` — a different
        // builder and a different shape. Slot 0 of a GROUPED table is the
        // first header, so sharing it handed every row the header's height,
        // and a grouped list collapsed to header height throughout unless the
        // application stated `row_height`. NSTableView asks from row 0 down,
        // so the header always won the slot.
        let uniform: bool = { (*s).uniform };
        if uniform && !is_header_row(s, row) { probe = first_data_row(s) as usize; }
        match { (*hp).at(probe) } {
            option::Option[f64]::Some(cached) => { if cached > 0.0f64 { return cached; } }
            option::Option[f64]::None => { }
        }
    }

    // ASK BEFORE BUILDING. An application that states the extents its rows
    // stack knows its heights as arithmetic, and building a subtree to
    // rediscover them is the expensive half of a resize: this delegate is
    // asked for EVERY row whenever the width changes, so an uneven list
    // measured by building rebuilds the whole model on every frame of a drag.
    // A 0 answer means "I cannot compute this one", and it falls through to
    // the build below — so a partial answer is a legal answer.
    let hof: fn(usize, *u8) -> f64 = { (*s).row_height_of };
    if hof != props::no_row_height_of && row >= (0 as i64) {
        // THE DATA INDEX, not the table row — `row_height_of(i)` means the same
        // `i` that `row(i)` means, and a grouped table's table rows are offset
        // by the headers above them. A HEADER has no data index and is built
        // and measured as before: it comes from `group_header`, there is one
        // per group, and they are not what makes a resize expensive.
        let at: i64 = resolve_row(s, row);
        if at >= (0 as i64) {
            let stated: f64 = hof(at as usize, { (*s).row_height_of_ctx });
            if stated >= 1.0f64 {
                // Cached against the TABLE row, which is what the delegate is
                // asked about.
                let idx: usize = row as usize;
                while { (*hp).count() } <= idx { append_zero(hp); }
                set_height(hp, idx, stated);
                return stated;
            }
        }
    }

    // Measuring means building the row and laying it out. No views: this is a
    // pure flex measurement, so nothing is realised and nothing has to be torn
    // down afterwards.
    //
    // With a bind, the SHAPE is built once and this row's data written into it
    // — so measuring a thousand rows builds one subtree, not a thousand.
    var node: core::Node = build_row(s, row);
    bind_into(s, row, #addr_of(node));
    node.calculate_layout(width: w);
    var h: f64 = { node.frame().height };
    if h < 1.0f64 { h = 1.0f64; }
    if row >= (0 as i64) {
        let idx: usize = row as usize;
        while { (*hp).count() } <= idx { append_zero(hp); }
        set_height(hp, idx, h);
    }
    return h;
}

fn append_zero(hp: *vec::Vec[f64]) {
    let _e: status::Status = { (*hp).append(0.0f64) };
    return;
}

fn set_height(hp: *vec::Vec[f64], at: usize, v: f64) {
    let _e: status::Status = { (*hp).set(v, at: at) };
    return;
}

// ONE REUSE POOL PER ROW SHAPE.
//
// `makeViewWithIdentifier:` hands back whatever cell last scrolled off under
// that identifier, so a single identity for every row means a bind — which
// writes into an EXISTING subtree — can land in a cell built for a different
// shape. Nothing catches it: the wrong subtree takes the right data and draws
// something that is not the row. That is why a transcript of three row shapes
// could not state a bind at all.
//
// The kind is asked per row and answers 0 unless the application named one, so
// a list that never says anything keeps the exact identity it always used.
fn row_identity(s: *RowSource, data: i64) -> text::Text {
    // A GROUP HEADER is its own shape and always was — built by
    // `group_header`, never by `row` — so it gets its own pool whether or not
    // the application says anything about kinds.
    if data < (0 as i64) { return "facet.row.header".to_text(); }
    let f: fn(usize, *u8) -> usize = { (*s).row_kind };
    if f == props::no_row_kind { return "facet.row".to_text(); }
    let k: usize = f(data as usize, { (*s).row_kind_ctx });
    if k == (0 as usize) { return "facet.row".to_text(); }
    return "facet.row.${k}";
}

// The cell for a row. Recycled by identity, and the row's realised subtree is
// torn down and rebuilt inside it.
fn view_for_row_imp(self_obj: *u8, cmd: *u8, tv: *u8, col: *u8, row: i64) -> *u8 {
    let s: *RowSource = source_of(tv);
    if s == (0 as *RowSource) { return 0 as *u8; }
    let w: f64 = column_width(tv);

    let ident: text::Text = row_identity(s, resolve_row(s, row));
    let id: str = ident;
    var cell: *u8 = { msg_id_id_i64(tv, rt::sel(#str_ptr("makeViewWithIdentifier:owner:\0")),
                                    bridge::nsstring(id), 0 as i64) };
    if cell == (0 as *u8) {
        cell = new_cell(id, w);
        if cell == (0 as *u8) { return 0 as *u8; }
    }
    fill_cell(s, cell, row, w);
    return cell;
}

// A cell of our own, tagged so the table will offer it back.
fn new_cell(identity: str, w: f64) -> *u8 {
    let cell: *u8 = rt::retain(new_row_cell(rt::Rect { x: 0.0f64, y: 0.0f64, w: w, h: 1.0f64 }));
    if cell == (0 as *u8) { return 0 as *u8; }
    { rt::msg_void_id(cell, rt::sel(#str_ptr("setIdentifier:\0")), bridge::nsstring(identity)) };
    return rt::autorelease(cell);
}

// ---- the cell class, and why a row needs one ---------------------------------
//
// A CELL IS NOT THE WIDTH IT WAS LAID OUT AT. Rows are laid out at the COLUMN's
// width, because that is the only width there is to ask for before AppKit has a
// cell to answer about — and then AppKit frames the cell at something else. In
// an outline view it always does: an indented row's cell is inset by its level's
// indentation plus the disclosure column, so the cell arrives NARROWER than the
// row was built for. Measured on the Files tree: laid out at 432, framed at 423.
//
// That 9pt used to be absorbed by autoresizing, which is the wrong arithmetic
// for it. `NSViewWidthSizable` is per-subview and the margins around each one
// were fixed, so AppKit took the FULL delta out of EVERY subview's width —
// every one of them, independently, whatever it was. A name label losing 9pt of
// its 397 is invisible. A 21pt icon losing 9pt is cut in half, which is exactly
// what the Files tree showed: a document glyph with its right side missing, in a
// frame that measured 21x19 everywhere anyone looked, because 21 is what the
// LAYOUT said and 12 is what the VIEW got.
//
// So the cell re-places its content when its size changes. `resizeSubviewsWith-
// OldSize:` is AppKit's own hook for exactly this question, it runs INSIDE
// `setFrameSize:` — synchronously, during a live divider drag, where no facet
// tick is running — and re-running flex at the real width answers it the way the
// row was written rather than by dividing a remainder. Super is deliberately not
// called: the masks it would apply are the arithmetic being replaced.
fn row_cell_class() -> *u8 {
    let existing: *u8 = rt::get_class(#str_ptr("FacetRowCell\0"));
    if existing != (0 as *u8) { return existing; }
    let cls: *u8 = synth::allocate_class_pair(akx::flipped_view_class(),
                                              #str_ptr("FacetRowCell\0"), 0 as usize);
    add_method_v_1size(cls, rt::sel(#str_ptr("resizeSubviewsWithOldSize:\0")),
                       cell_resize_imp, #str_ptr("v@:{CGSize=dd}\0"));
    // A ROW IS CLICKABLE, and this is where a row says so.
    //
    // The agent's click sends `performClick:`; a view that does not answer it
    // is reported as not actionable. A row cell answering it is what makes a
    // tagged tree row openable over the socket, and what the pre-recycler
    // backend did with the same two branches: an expandable row TOGGLES, a leaf
    // SELECTS — because selection is the only click a table row has, and it is
    // what fires `on_select`.
    synth::add_method_v_1id(cls, rt::sel(#str_ptr("performClick:\0")),
                            cell_perform_click_imp, #str_ptr("v@:@\0"));
    synth::register_class_pair(cls);
    return cls;
}

// The table this cell is a row of, or null: a cell lives inside an
// NSTableRowView inside the table, and both hops are AppKit's, not ours.
fn enclosing_table_of(v: *u8) -> *u8 {
    var cur: *u8 = v;
    while cur != (0 as *u8) {
        if geometry::is_kind_of(cur, #str_ptr("NSTableView\0")) { return cur; }
        cur = { rt::msg_id(cur, rt::sel(#str_ptr("superview\0"))) };
    }
    return 0 as *u8;
}

fn cell_perform_click_imp(self_obj: *u8, cmd: *u8, sender: *u8) {
    // A TREE ROW answers through the item it is showing, which the vend put on
    // it. Not through the view hierarchy: `rowForView:` only knows views the
    // table has displayed, so a cell clicked before its first display — or in a
    // suite, where nothing displays at all — would answer -1 and do nothing.
    let item: *u8 = { synth::get_associated(self_obj, cell_item_key()) };
    let ov: *u8 = { synth::get_associated(self_obj, cell_owner_key()) };
    if item != (0 as *u8) && ov != (0 as *u8) {
        if { rt::msg_i8_id(ov, rt::sel(#str_ptr("isExpandable:\0")), item) } != (0 as i8) {
            // A BRANCH TOGGLES. Selection is the only click a leaf row has, but
            // a folder already has one that means something else — and an agent
            // that could only select could never open a folder to reach what is
            // inside it. The ordinary did-expand write-back records it, so the
            // model ends up saying what a user's disclosure click would leave.
            if { rt::msg_i8_id(ov, rt::sel(#str_ptr("isItemExpanded:\0")), item) } != (0 as i8) {
                { rt::msg_void_id(ov, rt::sel(#str_ptr("collapseItem:\0")), item) };
            } else {
                { rt::msg_void_id(ov, rt::sel(#str_ptr("expandItem:\0")), item) };
            }
            return;
        }
        select_table_row(ov, { rt::msg_i64_id(ov, rt::sel(#str_ptr("rowForItem:\0")), item) });
        return;
    }
    // A LIST row has no item; the table it is in is the one that can say which
    // row it is.
    let tv: *u8 = enclosing_table_of(self_obj);
    if tv == (0 as *u8) { return; }
    select_table_row(tv, { rt::msg_i64_id(tv, rt::sel(#str_ptr("rowForView:\0")), self_obj) });
    return;
}

// Select `row`, which is what a click on a table row IS: the selection delegate
// is where both `list` and `tree` deliver it.
fn select_table_row(tv: *u8, row: i64) {
    if row < (0 as i64) { return; }
    let idx: *u8 = { rt::msg_id_u64(rt::get_class(#str_ptr("NSIndexSet\0")),
                                    rt::sel(#str_ptr("indexSetWithIndex:\0")), row as u64) };
    if idx == (0 as *u8) { return; }
    { rt::msg_void_id_i8(tv, rt::sel(#str_ptr("selectRowIndexes:byExtendingSelection:\0")),
                         idx, false as i8) };
    return;
}

#[link_name = "class_addMethod"]
extern fn add_method_v_1size(cls: *u8, sel: *u8, imp: fn(*u8, *u8, rt::Size),
                             types: *u8) -> i8;

fn new_row_cell(frame: rt::Rect) -> *u8 {
    let alloced: *u8 = { rt::msg_id(row_cell_class(), rt::sel(#str_ptr("alloc\0"))) };
    if alloced == (0 as *u8) { return 0 as *u8; }
    return rt::autorelease({ rt::msg_id_rect(alloced, rt::sel(#str_ptr("initWithFrame:\0")), frame) });
}

// `place_row` frames the cell itself, which re-enters this hook. One flag,
// because a row placing itself is not a resize to answer.
static PLACING_ROW: bool = false;

fn cell_resize_imp(self_obj: *u8, cmd: *u8, old: rt::Size) {
    if PLACING_ROW { return; }
    let np: *core::Node = { synth::get_associated(self_obj, cell_node_key()) as *core::Node };
    if np == (0 as *core::Node) { return; }
    let f: rt::Rect = { rt::msg_rect(self_obj, rt::sel(#str_ptr("frame\0"))) };
    if f.w < 1.0f64 || f.h < 1.0f64 { return; }
    // Width only. A height change moves the row, it does not re-wrap it — and
    // the height the table gives a cell is the height it asked us for.
    if f.w == old.w { return; }
    place_row_content(self_obj, np, f.w, f.h);
    return;
}

// Put row `row` into `cell`, whether or not the cell already holds one.
//
// THE RECYCLING PATH is the first branch: with a bind, a cell's subtree is
// built ONCE and every later row writes into it, so scrolling costs a handful
// of property writes instead of a subtree, a layout and a view per node.
// Without a bind the cell is emptied and rebuilt — what every backend did
// before the contract could say otherwise.
//
// Factored out of the delegate because it is the half worth testing on its
// own: a headless table never fills its reuse queue, so `makeViewWithIdentifier`
// always answers nil and the reuse branch would never run under test.
fn fill_cell(s: *RowSource, cell: *u8, row: i64, w: f64) {
    let existing: *core::Node = { synth::get_associated(cell, cell_node_key()) as *core::Node };
    if has_bind(s) && existing != (0 as *core::Node) {
        bind_into(s, row, existing);
        // A bind WRITES PROPS, which marks nodes dirty and touches nothing
        // native. A realised row is outside the window walk, so nothing would
        // ever carry those writes across — `sync_from` is that walk, rooted
        // here. Applied immediately rather than coalesced: the row is about to
        // be shown.
        mount::sync_from(existing);
        // The row's own size can change with its data, so it is re-laid out
        // and re-placed — the cheap half of what a rebuild did.
        let _h: f64 = place_row(cell, existing, w, row_h: { (*s).fixed_height });
        return;
    }
    if existing != (0 as *core::Node) { release_cell_row(cell); }

    var node: core::Node = build_row(s, row);
    match box::new::[core::Node](node) {
        option::Option[box::Box[core::Node]]::Some(b) => {
            let np: *core::Node = { b.into_raw() } as *core::Node;
            empty_cell(cell);
            // The CELL is the host. A row's root is usually a bare container —
            // nothing keys it, nothing gives it gestures — so it is not backed
            // and its children pass straight through into the cell, exactly as
            // a layout-only column does inside a scroll view.
            let _rv: *u8 = mount::realise(np, cell);
            // Bound immediately, including on the first use: the builder is
            // then responsible for SHAPE ONLY, and a row can never show the
            // data of whichever row happened to build its cell.
            bind_into(s, row, np);
            mount::sync_from(np);
            let _h: f64 = place_row(cell, np, w, row_h: { (*s).fixed_height });
            synth::set_associated(cell, cell_node_key(), np as *u8);
        }
        option::Option[box::Box[core::Node]]::None => { }
    }
    return;
}

// NO IMPLICIT ANIMATION WHILE A ROW IS PLACED.
//
// The views in a cell are layer-backed, and setting a layer-backed view's frame
// inside a run loop pass can animate it — Core Animation's implicit actions, on
// by default. A row is placed, not moved, so they are turned off for the walk.
// `CATransaction` begin/commit with actions disabled is the switch, the same
// one `compose` uses when a control must NOT slide.
//
// WHAT THIS IS NOT. It was written for the expand that showed its rows drifting
// into position, and it does not fix that — measured, not argued: with these
// two functions neutered, a live window sampled every 50ms across a user's
// expand reports exactly the same motion, and every animating object is an
// NSTableRowView. Nothing in a cell moves either way. That symptom is AppKit's
// own row animation and is held off by `hold_row_animation`.
//
// It stays because the claim in its first paragraph is still true and cheap to
// keep true — two msgsends per placement — not because it was ever seen to
// change anything on screen.
fn without_implicit_animation_begin() {
    let cls: *u8 = rt::get_class(#str_ptr("CATransaction\0"));
    { rt::msg_void_id(cls, rt::sel(#str_ptr("begin\0")), 0 as *u8) };
    { rt::msg_void_i8(cls, rt::sel(#str_ptr("setDisableActions:\0")), 1 as i8) };
    return;
}

fn without_implicit_animation_end() {
    let cls: *u8 = rt::get_class(#str_ptr("CATransaction\0"));
    { rt::msg_void_id(cls, rt::sel(#str_ptr("commit\0")), 0 as *u8) };
    return;
}

// Lay the row out at the cell's width, push the frames onto the views inside
// it, and give both the cell and the row's root view that size. Answers the
// height it settled on, which is what the tree's cell frame is written from.
//
// `floor_h` is what a row that measures under a point falls back to.
//
// THE `reposition` CALL WAS MISSING and nothing stood in for it. A realised
// row is not in any window, so `relayout_root` — the only other caller of the
// frame walk — never reaches it, and nothing else in this package sets a
// descendant's frame. Every view in a row therefore kept the frame its factory
// made it with: each label 4x16 at the origin, because `create_label` calls
// `labelWithString:@""` and `setStringValue:` does not resize. The row's
// HEIGHT was right all along (`height_imp` lays out an unrealised copy), so the
// table reserved exactly the right space and drew the whole row into the
// top-left corner of it.
fn place_row(cell: *u8, np: *core::Node, w: f64, floor_h: f64 = 1.0f64,
             row_h: f64 = 0.0f64) -> f64 {
    // LAY THE ROW OUT AT THE ROW'S HEIGHT, not at its content's.
    //
    // `row_h` is what the delegate told AppKit this row is — a stated
    // `row_height`. The row was laid out at WIDTH ONLY, so its height came from
    // its content, and the cell was set to that: a 15pt icon-and-name inside a
    // 34pt row, pinned to the top of it. AppKit centres what IT draws in the
    // full row — the disclosure triangle most visibly — so the triangle sat in
    // the middle while the icon and the name sat on the ceiling, and a row that
    // stated a comfortable height got no benefit from it.
    //
    // Given the row's real height the root fills it, and a row that says
    // `align(Center)` / `justify(Center)` centres its content in the row the
    // user actually sees. Unstated, `row_h` is 0 and the height still comes
    // from the content, which is also exactly what AppKit was told — so nothing
    // changes there.
    //
    // If content still comes out shorter than `row_h` (a custom builder that
    // ignores the wrap), pin the content VIEW to the vertical centre of the
    // cell so it still lines up with the disclosure.
    // Prefer natural content height when a fixed row_h is given, so a short
    // plain label can be centred in the row (disclosure alignment). Full-height
    // builders (center_in_tree_row wrap) still measure at row_h and fill it.
    if row_h >= 1.0f64 {
        { (*np).calculate_layout(width: w) };
        var natural: f64 = { (*np).frame().height };
        if natural + 0.5f64 >= row_h {
            { (*np).calculate_layout(width: w, height: row_h) };
        }
    } else {
        { (*np).calculate_layout(width: w) };
    }
    var content_h: f64 = { (*np).frame().height };
    if content_h < 1.0f64 { content_h = floor_h; }
    var h: f64 = content_h;
    if row_h >= 1.0f64 { h = row_h; }
    // The cell is framed HERE and re-placed at whatever size AppKit gives it
    // afterwards, by the cell's own resize hook — so the flag holds across both
    // `setFrame:`s below, which would otherwise re-enter that hook to redo the
    // work this line is already doing.
    PLACING_ROW = true;
    without_implicit_animation_begin();
    // Before the cell is framed, and reading the LAYOUT frames rather than the
    // views', so the order against the two `setFrame:`s below does not matter.
    geometry::reposition(np);
    { msg_void_rect(cell, rt::sel(#str_ptr("setFrame:\0")),
                    rt::Rect { x: 0.0f64, y: 0.0f64, w: w, h: h }) };
    let rv: *u8 = core::view_of(np);
    if rv != (0 as *u8) {
        // Always centre the content view in the cell when the row is taller
        // than the content. Cell is flipped (top-left origin). This is what
        // lines the label up with AppKit's disclosure triangle.
        var y: f64 = 0.0f64;
        var vh: f64 = content_h;
        if content_h + 0.5f64 < h {
            y = (h - content_h) / 2.0f64;
        } else {
            vh = h;
        }
        { msg_void_rect(rv, rt::sel(#str_ptr("setFrame:\0")),
                        rt::Rect { x: 0.0f64, y: y, w: w, h: vh }) };
    }
    // The CELL follows the column's width; what is INSIDE it is placed by the
    // resize hook that follows from that, not by a mask. See `row_cell_class`.
    cell_follows_width(cell);
    without_implicit_animation_end();
    PLACING_ROW = false;
    return h;
}

// Re-place a row's content at a size the cell already has — the resize hook's
// half of `place_row`, which must not touch the cell's own frame because it
// runs inside `setFrameSize:`.
fn place_row_content(cell: *u8, np: *core::Node, w: f64, h: f64) {
    PLACING_ROW = true;
    without_implicit_animation_begin();
    // Lay out at the cell's width; height is natural so a short label can be
    // centred in `h` the same way place_row does after a fixed row_height.
    { (*np).calculate_layout(width: w) };
    geometry::reposition(np);
    let rv: *u8 = core::view_of(np);
    if rv != (0 as *u8) {
        var content_h: f64 = { (*np).frame().height };
        if content_h < 1.0f64 { content_h = h; }
        var y: f64 = 0.0f64;
        var vh: f64 = content_h;
        if content_h + 0.5f64 < h {
            y = (h - content_h) / 2.0f64;
        } else {
            vh = h;
            { (*np).calculate_layout(width: w, height: h) };
            geometry::reposition(np);
        }
        { msg_void_rect(rv, rt::sel(#str_ptr("setFrame:\0")),
                        rt::Rect { x: 0.0f64, y: y, w: w, h: vh }) };
    }
    without_implicit_animation_end();
    PLACING_ROW = false;
    return;
}

fn has_bind(s: *RowSource) -> bool {
    return { (*s).bind } != props::no_bind;
}

// Write row `row` — a TABLE row — into `into`.
//
// The translation is the whole job. `build_row` resolves a table row to a data
// index before it picks a builder, and this did not: it handed the raw table
// row to the application, so a grouped list BUILT `resolve_row(r)` and then
// wrote row `r`'s data into it. The two disagree by the number of headers
// above, so every row below the first header showed the wrong item, and the
// further down the table the further off — with groups of 2 and 3, table row 4
// is data row 2 and was written with data row 4.
//
// A HEADER binds nothing. It was built by `group_header`, not by `row`, so the
// row bind has no shape to write into; handed a raw table row it ran on every
// header as well. `controls::rebind_rows` — the collection's copy of this same
// translation — had both halves right all along (`data_index_of`, then
// `if data >= 0`), which is the shape to compare against if this drifts again.
//
// Ungrouped, `resolve_row` is the identity, so nothing changes for a flat list.
fn bind_into(s: *RowSource, row: i64, into: *core::Node) {
    let f: fn(usize, *core::Node, *u8) = { (*s).bind };
    if f == props::no_bind { return; }
    let at: i64 = resolve_row(s, row);
    if at < (0 as i64) { return; }
    f(at as usize, into, { (*s).row_ctx });
    return;
}

// THE CELL FOLLOWS THE COLUMN'S WIDTH — and nothing else does.
//
// A width change does NOT reach a row through facet. NSTableView tiles its
// columns inside AppKit's own layout, and the cell views are resized there —
// nowhere near facet's tick. So a row that waits for a reload to learn its new
// width is always a frame behind whatever the pane is doing: drag a divider and
// the pane takes the new width while the cards inside keep the old one, clipped
// off the right edge on the way out and short of it on the way back, catching
// up one frame later. Moving the reload earlier or later in the tick cannot fix
// that, because the tick is not the clock the resize arrives on.
//
// `vendor/facet_appkit.old` solved that with `list_autoresize_subtree`:
// `NSViewWidthSizable` on the cell AND everything under it, so AppKit stretched
// the content live. This package copied it, and the copy carried a bug the old
// one had too — see `row_cell_class`. Autoresizing is per-subview arithmetic,
// so a cell that arrives 9pt narrower than the row was laid out for takes 9pt
// off EVERY flexible subview's width, not 9pt off the row: fine for a label
// with slack, and half of a 21pt icon.
//
// The mask stays on the CELL, which is the one view the claim above is actually
// about — it must follow the column while AppKit is the only thing running.
// What is inside it is re-laid out by flex from the cell's resize hook, which
// is the same moment and the right arithmetic.
//
// WIDTH ONLY. The vertical mask stays off: heights are ours, they come from the
// flex pass, and letting AppKit stretch them would fight the frames `reposition`
// just set.
fn cell_follows_width(v: *u8) {
    if v == (0 as *u8) { return; }
    { rt::msg_void_u64(v, rt::sel(#str_ptr("setAutoresizingMask:\0")),
                       ak::autoresizing_mask_options_n_s_view_width_sizable) };
    return;
}

// The realised root fills the cell. Its own children were placed by the
// `geometry::reposition` call in `place_row` just above, relative to it, so
// only the root needs a frame here.
//
// That claim used to be made against "the frame walk" with no caller named,
// and it was false: no walk ran on this path at all. Name the call, so the
// next reader can check it.
fn geometry_place(v: *u8, w: f64, h: f64) {
    { msg_void_rect(v, rt::sel(#str_ptr("setFrame:\0")),
                    rt::Rect { x: 0.0f64, y: 0.0f64, w: w, h: h }) };
    return;
}

// Tear down whatever row this cell is currently showing.
// EMPTY THE CELL BEFORE PUTTING A ROW IN IT.
//
// Tearing the old row down releases the views its node owned — but a released
// view whose SUPERVIEW still retains it does not go anywhere, and the cell is
// that superview. So the previous row's labels stayed in the cell and the new
// row's were added on top: "SKILL.md" and "main.cplus" drawn through each
// other in one row, which is what a recycled cell looks like when only half of
// it was recycled.
//
// Done here rather than inside the teardown because it must hold however the
// cell arrived — reused by AppKit, rebuilt after a bind was refused, or handed
// over with content nobody recorded. A cell about to receive a row has no
// business holding anything, and on an empty one this costs one message.
fn empty_cell(cell: *u8) {
    if cell == (0 as *u8) { return; }
    let subs: *u8 = { rt::msg_id(cell, rt::sel(#str_ptr("subviews\0"))) };
    if subs == (0 as *u8) { return; }
    // Count first, then take index 0 each time: `removeFromSuperview` mutates
    // the array being read, so an index walk skips every other view.
    var n: u64 = { rt::msg_u64(subs, rt::sel(#str_ptr("count\0"))) };
    while n > (0 as u64) {
        let live: *u8 = { rt::msg_id(cell, rt::sel(#str_ptr("subviews\0"))) };
        if live == (0 as *u8) { return; }
        if { rt::msg_u64(live, rt::sel(#str_ptr("count\0"))) } == (0 as u64) { return; }
        let sv: *u8 = { rt::msg_id_u64(live, rt::sel(#str_ptr("objectAtIndex:\0")), 0 as u64) };
        if sv == (0 as *u8) { return; }
        { rt::msg_void(sv, rt::sel(#str_ptr("removeFromSuperview\0"))) };
        n = n -% (1 as u64);
    }
    return;
}

fn release_cell_row(cell: *u8) {
    let np: *core::Node = { synth::get_associated(cell, cell_node_key()) as *core::Node };
    if np == (0 as *core::Node) { return; }
    mount::unrealise(np);
    synth::set_associated(cell, cell_node_key(), 0 as *u8);
    // Dropping the box drops the node, which releases every view it owns.
    let _gone: box::Box[core::Node] = box::from_raw::[core::Node](np as *u8);
    return;
}

fn recycler_class() -> *u8 {
    let existing: *u8 = rt::get_class(#str_ptr("FacetRowSource\0"));
    if existing != (0 as *u8) { return existing; }
    let cls: *u8 = synth::allocate_class_pair(rt::get_class(#str_ptr("NSObject\0")),
                                              #str_ptr("FacetRowSource\0"), 0 as usize);
    add_method_i64_1id(cls, rt::sel(#str_ptr("numberOfRowsInTableView:\0")),
                       num_rows_imp, #str_ptr("q@:@\0"));
    add_method_i8_1id_i64(cls, rt::sel(#str_ptr("tableView:isGroupRow:\0")),
                          is_group_row_imp, #str_ptr("c@:@q\0"));
    add_method_f64_1id_i64(cls, rt::sel(#str_ptr("tableView:heightOfRow:\0")),
                           height_imp, #str_ptr("d@:@q\0"));
    add_method_id_2id_i64(cls, rt::sel(#str_ptr("tableView:viewForTableColumn:row:\0")),
                          view_for_row_imp, #str_ptr("@@:@@q\0"));
    // The delegate half. `didAddRowView` / `didRemoveRowView` are AppKit's own
    // names for a row coming into and going out of existence, which is exactly
    // what `on_item_appearing` / `on_item_disappearing` mean — and on a
    // RECYCLING table they are the only honest answer, because a row that
    // scrolls away really is removed.
    synth::add_method_v_1id(cls, rt::sel(#str_ptr("tableViewSelectionDidChange:\0")),
                            selection_changed_imp, #str_ptr("v@:@\0"));
    add_method_v_2id_i64(cls, rt::sel(#str_ptr("tableView:didAddRowView:forRow:\0")),
                         row_added_imp, #str_ptr("v@:@@q\0"));
    add_method_v_2id_i64(cls, rt::sel(#str_ptr("tableView:didRemoveRowView:forRow:\0")),
                         row_removed_imp, #str_ptr("v@:@@q\0"));
    synth::register_class_pair(cls);
    return cls;
}

#[link_name = "class_addMethod"]
extern fn add_method_v_2id_i64(cls: *u8, sel: *u8, imp: fn(*u8, *u8, *u8, *u8, i64), types: *u8) -> i8;
#[link_name = "class_addMethod"]
extern fn add_method_i8_1id_i64(cls: *u8, sel: *u8, imp: fn(*u8, *u8, *u8, i64) -> i8, types: *u8) -> i8;

// ---- the list's own events ---------------------------------------------------

fn list_node_of(tv: *u8) -> *core::Node {
    let s: *RowSource = source_of(tv);
    if s == (0 as *RowSource) { return 0 as *core::Node; }
    return { (*s).node };
}

fn fire_list(n: *core::Node, h: fn(*u8, *u8), ctx: *u8, sender: *u8) {
    if n == (0 as *core::Node) { return; }
    if h == props::no_handler { return; }
    h(sender, ctx);
    return;
}

// A selection change is BOTH `on_item_selected` and `on_item_tapped` on this
// backend, and the manifest says why: a table row is selected by click and by
// arrow key, and macOS has no separate "tapped" moment. Firing only the first
// would leave the keyboard path silent.
fn selection_changed_imp(self_obj: *u8, cmd: *u8, note: *u8) {
    let tv: *u8 = { rt::msg_id(note, rt::sel(#str_ptr("object\0"))) };
    if tv == (0 as *u8) { return; }
    let n: *core::Node = list_node_of(tv);
    if n == (0 as *core::Node) { return; }
    let p: *props::ListProps = props_of_list(n);
    if p == (0 as *props::ListProps) { return; }
    // The write-back, BEFORE the handlers: a handler asking which row is
    // selected gets the one that caused it. And the answer is the DATA index —
    // a grouped table's fifth row may be its third item.
    let s: *RowSource = source_of(tv);
    if s != (0 as *RowSource) {
        let picked: i64 = { rt::msg_i64(tv, rt::sel(#str_ptr("selectedRow\0"))) };
        if picked < (0 as i64) { { (*p).selected_index = -1 as i64 }; }
        else { { (*p).selected_index = resolve_row(s, picked) }; }
    }
    fire_list(n, { (*p).on_item_selected }, { (*p).on_item_selected_ctx }, tv);
    fire_list(n, { (*p).on_item_tapped }, { (*p).on_item_tapped_ctx }, tv);
    return;
}

// A FACET ROW DRAWS ITSELF, so the platform must not draw a selection behind
// it — a full-row blue flash under an inset card, in the platform's colours,
// one layer above the card's own.
//
// It is suppressed HERE, on the row view, and not by turning the table's
// `selectionHighlightStyle` off. Those look like the same switch and are not:
// the table's style governs selection BEHAVIOUR as well as its drawing, and
// selection is the only way a table row is clicked at all — NSTableView owns
// the mouse inside its rows, so a `.gesture(on_click:)` in a row is never
// delivered to. Turning it off at the table risks taking the click with the
// blue, and no headless test can tell you whether it did: an NSTableView with
// no window runs its tracking loop against an empty event queue and selects
// nothing either way (measured — the control with the highlight ON fails the
// same test). `NSTableRowView` carries the same property for its own drawing
// only, which is exactly the half we want gone.
fn suppress_row_highlight(rowview: *u8) {
    if rowview == (0 as *u8) { return; }
    { rt::msg_void_i64(rowview, rt::sel(#str_ptr("setSelectionHighlightStyle:\0")),
                       0 as i64 - (1 as i64)) };
    return;
}

fn row_added_imp(self_obj: *u8, cmd: *u8, tv: *u8, rowview: *u8, row: i64) {
    suppress_row_highlight(rowview);
    let n: *core::Node = list_node_of(tv);
    if n == (0 as *core::Node) { return; }
    let p: *props::ListProps = props_of_list(n);
    if p == (0 as *props::ListProps) { return; }
    fire_list(n, { (*p).on_item_appearing }, { (*p).on_item_appearing_ctx }, rowview);
    return;
}

fn row_removed_imp(self_obj: *u8, cmd: *u8, tv: *u8, rowview: *u8, row: i64) {
    let n: *core::Node = list_node_of(tv);
    if n == (0 as *core::Node) { return; }
    let p: *props::ListProps = props_of_list(n);
    if p == (0 as *props::ListProps) { return; }
    fire_list(n, { (*p).on_item_disappearing }, { (*p).on_item_disappearing_ctx }, rowview);
    return;
}

// ---- building the control ----------------------------------------------------

fn create_recycling_list(n: *core::Node) -> *u8 {
    let scroll: ak::ScrollView = akx::new_scroll_view(
        rt::Rect { x: 0.0f64, y: 0.0f64, w: 0.0f64, h: 0.0f64 }, false);
    let tv: *u8 = { rt::alloc_init(#str_ptr("NSTableView\0")) };
    if tv == (0 as *u8) { return rt::retain(scroll.as_view().raw()); }

    // One column, full width. facet's rows are whole nodes; a column is
    // AppKit's unit and not a concept the contract has.
    let col: *u8 = { rt::msg_id(rt::get_class(#str_ptr("NSTableColumn\0")),
                                rt::sel(#str_ptr("alloc\0"))) };
    let col2: *u8 = { rt::msg_id_id(col, rt::sel(#str_ptr("initWithIdentifier:\0")),
                                    bridge::nsstring("facet.col")) };
    if col2 != (0 as *u8) {
        { rt::msg_void_id(tv, rt::sel(#str_ptr("addTableColumn:\0")), col2) };
        rt::release(col2);
    }
    // No header, no grid, no alternating rows: a facet row draws itself, and a
    // list that added chrome of its own would be lying about what it holds.
    { rt::msg_void_id(tv, rt::sel(#str_ptr("setHeaderView:\0")), 0 as *u8) };
    { rt::msg_void_i64(tv, rt::sel(#str_ptr("setColumnAutoresizingStyle:\0")), 1 as i64) };
    // INTERCELL SPACING IS ZERO, and it is not a detail. AppKit's default is
    // {3, 2}: three points of HORIZONTAL inset, so the cell a row is drawn into
    // is narrower than the column that `column_width` reports. Laying the row
    // out at the column's width then draws it wider than the cell it sits in,
    // and the right edge of a card is what falls off. `facet_appkit.old` zeroed
    // it (`set_intercell_spacing({0,0})`) and the new backend did not carry it
    // across.
    { rt::msg_void_size(tv, rt::sel(#str_ptr("setIntercellSpacing:\0")),
                        rt::Size { w: 0.0f64, h: 0.0f64 }) };

    // 0 is AUTOMATIC — not Plain, which a comment here once claimed — and
    // automatic is DELIBERATE, tried both ways. An explicit style (FullWidth,
    // what `facet_appkit.old` used) makes the table tile at create: reloadData
    // runs the height pass immediately, `heightOfRow:` builds every row, and a
    // list of ten thousand pays for all of them before it is even in a window
    // — eight contract tests (`a_list_asks_for_no_rows_until_the_table_asks_
    // for_them` and friends) went red. Automatic cannot resolve until the
    // table joins a hierarchy, so the height pass waits for the first real
    // layout, which is the lazy create the contract promises. The width cost
    // of automatic — the resolved style insets the cells — is already paid
    // for where it matters: `column_width` reads the COLUMN, which AppKit
    // narrows by exactly those insets, so rows are laid out at the width the
    // cell really gets.
    { rt::msg_void_i64(tv, rt::sel(#str_ptr("setStyle:\0")), 0 as i64) };   // NSTableViewStyleAutomatic
    { rt::msg_void_i64(tv, rt::sel(#str_ptr("setSelectionHighlightStyle:\0")),
                       0 as i64 - (1 as i64)) };                            // None

    // One object answers both protocols — they are the same question asked in
    // three ways — pinned to the table so it lives exactly as long.
    let agent: *u8 = synth::alloc_init_class(recycler_class());
    if agent != (0 as *u8) {
        { rt::msg_void_id(tv, rt::sel(#str_ptr("setDataSource:\0")), agent) };
        { rt::msg_void_id(tv, rt::sel(#str_ptr("setDelegate:\0")), agent) };
        synth::retain_associated(tv, agent_pin_key(), agent);
        rt::release(agent);
    }
    debug_track(tv);
    scroll.set_document_view(ak::View::from_raw(tv));
    rt::release(tv);
    return rt::retain(scroll.as_view().raw());
}

// The NSTableView inside a list's scroll view.
fn table_of(v: *u8) -> *u8 {
    if v == (0 as *u8) { return 0 as *u8; }
    return { rt::msg_id(v, rt::sel(#str_ptr("documentView\0"))) };
}

// Install or update the row source, then reload. The builder and the count are
// ONE question: either changing replaces the whole sequence, and a partial
// answer would leave rows from two models mixed.
// A refresh has started, however it started: the state is written back BEFORE
// the handler, so a handler asking `list.is_refreshing()` gets the state that
// caused it rather than the state before it.
fn start_list_refresh(v: *u8, n: *core::Node, p: *props::ListProps) {
    { (*p).is_refreshing = true };
    compose::apply_refresh(v, { (*p).is_refreshable }, true, { (*p).can_refresh },
                           { (*p).refresh_color }, list_refresh_clicked, n as *u8);
    let h: fn(*u8, *u8) = { (*p).on_refreshing };
    if h != props::no_handler { h(v, { (*p).on_refreshing_ctx }); }
    return;
}

fn list_refresh_clicked(sender: *u8, ctx: *u8) {
    let n: *core::Node = ctx as *core::Node;
    let p: *props::ListProps = props_of_list(n);
    if p == (0 as *props::ListProps) { return; }
    let v: *u8 = core::view_of(n);
    if v == (0 as *u8) { return; }
    start_list_refresh(v, n, p);
    return;
}

fn apply_recycling_list(v: *u8, n: *core::Node, dirty: u64) {
    let tv: *u8 = table_of(v);
    if tv == (0 as *u8) { return; }
    let p: *props::ListProps = props_of_list(n);
    if p == (0 as *props::ListProps) { return; }

    var s: *RowSource = source_of(tv);
    if s == (0 as *RowSource) {
        match box::new::[RowSource](RowSource {
            row: { (*p).row },
            bind: { (*p).bind },
            row_ctx: { (*p).row_ctx },
            count: { (*p).count },
            fixed_height: 0.0f64,
            heights: vec::new::[f64](),
            heights_width: 0.0f64,
            last_width: 0.0f64,
            follow_tail: false,
            table: tv,
            node: n,
            uniform: false,
            groups: 0 as i64,
            group_size: props::no_group_size,
            group_header: props::no_group_header,
            row_height_of: props::no_row_height_of,
            row_height_of_ctx: 0 as *u8,
            row_kind: props::no_row_kind,
            row_kind_ctx: 0 as *u8,
            group_size_ctx: 0 as *u8,
            group_header_ctx: 0 as *u8,
        }) {
            option::Option[box::Box[RowSource]]::Some(b) => {
                s = { b.into_raw() } as *RowSource;
                synth::set_associated(tv, source_key(), s as *u8);
                // The resize pass. Observed once, for the life of the table.
                let _obs: u64 = akx::observe_frame(ak::View::from_raw(tv),
                                                   on_table_resized, s as *u8);
            }
            option::Option[box::Box[RowSource]]::None => { return; }
        }
    }
    // The refresh band. `list` carries the same seven verbs RefreshView does,
    // and the same answer: a click path, not a gesture — on a scroll view the
    // strip is AppKit's own floating subview, pinned to the top of the content.
    let refresh_band: u64 = list::P_IS_REFRESHABLE | list::P_IS_REFRESHING
        | list::P_CAN_REFRESH | list::P_REFRESH_COLOR | props::C_HANDLERS;
    if (dirty & refresh_band) != (0 as u64) || dirty == paint::all_bits() {
        let f: fn(*u8, *u8) = list_refresh_clicked;
        compose::apply_refresh(v, { (*p).is_refreshable }, { (*p).is_refreshing },
                               { (*p).can_refresh }, { (*p).refresh_color }, f, n as *u8);
    }
    // `begin_refresh` and `end_refresh` are COMMANDS — the code path an agent
    // has, and the reason a gesture was never the only way in.
    // NOT on the create pass. `create` calls apply with every bit set, which
    // for a COMMAND means "do it" — so a list that merely exists would report
    // a refresh nobody asked for. The same guard the scroll_to command needs.
    let first_pass: bool = dirty == paint::all_bits();
    if (dirty & list::P_BEGIN_REFRESH) != (0 as u64) && first_pass == false {
        start_list_refresh(v, n, p);
    }
    if (dirty & list::P_END_REFRESH) != (0 as u64) && first_pass == false {
        { (*p).is_refreshing = false };
        compose::apply_refresh(v, { (*p).is_refreshable }, false, { (*p).can_refresh },
                               { (*p).refresh_color }, list_refresh_clicked, n as *u8);
    }
    { (*s).row = { (*p).row } };
    { (*s).bind = { (*p).bind } };
    { (*s).row_ctx = { (*p).row_ctx } };
    { (*s).count = { (*p).count } };
    // The stated height rides the ROW band — `set_row_height_of` raises
    // P_ROW — so it is copied beside `row`, unconditionally. It sat inside
    // the group gate below, where an UNGROUPED list's post-mount write never
    // arrived: every row fell back to build-and-measure, an unrealised label
    // measures 0, and a transcript of wrapped rows collapsed to its padding.
    // A grouped list picked the field up by accident, its group writes
    // opening the gate — which is why the grouped timeline worked and the
    // flat transcript did not.
    { (*s).row_height_of = { (*p).row_height_of } };
    { (*s).row_height_of_ctx = { (*p).row_height_of_ctx } };
    // The row's SHAPE rides the same band, for the same reason: it is part of
    // describing what a row IS, and it decides which pool the cell comes from.
    { (*s).row_kind = { (*p).row_kind } };
    { (*s).row_kind_ctx = { (*p).row_kind_ctx } };
    // `is_grouped` is the switch and the three group fields are what it
    // switches on. Off, or with no groups described, `groups` stays 0 and every
    // index translation is the identity.
    if (dirty & (list::P_IS_GROUPED | list::P_GROUP_COUNT | list::P_GROUP)) != (0 as u64)
        || dirty == paint::all_bits() {
        if { (*p).is_grouped } { { (*s).groups = { (*p).group_count } }; }
        else { { (*s).groups = 0 as i64 }; }
        { (*s).group_size = { (*p).group_size } };
        { (*s).group_header = { (*p).group_header } };
        { (*s).group_size_ctx = { (*p).group_size_ctx } };
        { (*s).group_header_ctx = { (*p).group_header_ctx } };
    }
    let rh: i64 = { (*p).row_height };
    if rh > (0 as i64) { { (*s).fixed_height = rh as f64 }; }
    else { { (*s).fixed_height = 0.0f64 }; }
    // The measurements belong to the old sequence — when there IS a new
    // sequence. Only a write that can change what the rows ARE pays for a
    // reload: ungated, every list write reloaded the world, so a selection
    // write alone discarded every measured height and every vended cell, and
    // a streaming transcript re-shaped and re-drew every visible row on
    // every token.
    let sequence_band: u64 = list::P_ROW | list::P_COUNT | list::P_ROW_HEIGHT
        | list::P_HAS_UNEVEN_ROWS | list::P_IS_GROUPED | list::P_GROUP_COUNT
        | list::P_GROUP;
    let reloading: bool = (dirty & sequence_band) != (0 as u64);
    if reloading {
        { (*s).heights.remove_all() };
        { (*s).heights_width = 0.0f64 };
    }
    // `has_uneven_rows == false` is an OPTIMISATION and never a guess: the
    // height still comes from measuring a row, this only says the answer may be
    // reused for the rest. Setting it sends no message, so unlike the
    // appearance band below it is safe on the create pass.
    if (dirty & list::P_HAS_UNEVEN_ROWS) != (0 as u64) || dirty == paint::all_bits() {
        { (*s).uniform = { (*p).has_uneven_rows } == false };
    }
    // ---- the table's own appearance ------------------------------------------
    //
    // Gated strictly on the bits, with NO create pass — unlike every other
    // apply body in this package, and the reason is measured rather than
    // stylistic: each of these messages makes NSTableView validate itself, and
    // a table that has a data source answers validation by ASKING FOR ROWS.
    // On the create pass that builds rows before the table ever asked for one,
    // which is the promise a recycling list exists to keep
    // (`a_list_asks_for_no_rows_until_the_table_asks_for_them`).
    //
    // What that costs: a list whose FIRST description already names a
    // selection mode or a separator gets AppKit's default for one frame. The
    // alternative — configuring before the data source is attached — was tried
    // and does not work: `setGridStyleMask:` alone still made the table ask.
    // Recorded in MANIFEST rather than papered over.
    let creating: bool = dirty == paint::all_bits();
    if (dirty & list::P_SELECTION_MODE) != (0 as u64) && creating == false {
        apply_selection_mode(tv, { (*p).selection_mode });
    }
    if (dirty & (list::P_SEPARATOR | list::P_SEPARATOR_COLOR)) != (0 as u64) && creating == false {
        apply_separator(tv, { (*p).separator }, { (*p).separator_color });
    }
    if (dirty & (list::P_VERTICAL_SCROLL_BARS | list::P_HORIZONTAL_SCROLL_BARS)) != (0 as u64)
        && creating == false {
        let sv: ak::ScrollView = ak::ScrollView::from_raw(v);
        sv.set_has_vertical_scroller(controls::shows_bars({ (*p).vertical_scroll_bars }));
        sv.set_has_horizontal_scroller(controls::shows_bars({ (*p).horizontal_scroll_bars }));
    }
    if reloading {
        { rt::msg_void(tv, rt::sel(#str_ptr("reloadData\0"))) };
        // The reload re-measures everything; a pending invalidation or splice
        // is covered by it, so both only have to be forgotten.
        { (*p).invalidate_lo = -1 as i64 };
        { (*p).invalidate_hi = -1 as i64 };
        { (*p).splice_at = -1 as i64 };
        { (*p).splice_count = 0 as i64 };
    } else {
        // The splice FIRST: it moves rows, and an invalidation names rows in
        // the sequence the splice leaves behind.
        if (dirty & list::P_SPLICE_ROWS) != (0 as u64) {
            apply_splice(tv, s, p);
        }
        if (dirty & list::P_INVALIDATE_ROW) != (0 as u64) {
            apply_invalidation(tv, s, p);
        }
    }
    // A selection written FROM the contract, translated the other way: the
    // application counts items and the table counts rows, and a grouped table's
    // third item is not its third row. After the reload, or it indexes a table
    // that has not been told the sequence changed.
    if (dirty & (list::P_SELECTED_INDEX | list::P_COUNT | list::P_ROW)) != (0 as u64)
        && creating == false {
        select_data_row(tv, s, { (*p).selected_index });
    }
    // `scroll_to` is a COMMAND: act on the bit, and the sync walk clears it.
    if (dirty & list::P_SCROLL_TO) != (0 as u64) && creating == false {
        let want: i64 = { (*p).scroll_to_index };
        if want >= (0 as i64) {
            { rt::msg_void_i64(tv, rt::sel(#str_ptr("scrollRowToVisible:\0")), want) };
        }
    }
    return;
}

// THE SEQUENCE GREW OR SHRANK, and the rows either side of the splice are the
// rows they were. `insertRowsAtIndexes:` / `removeRowsAtIndexes:` is what
// NSTableView wants to be told — it keeps every vended cell, the selection and
// the scroll position, and asks for heights only where they can have changed —
// and our own height cache is spliced to match, which is the whole point: the
// rows above an append keep the measurements they already paid for.
//
// GROUPED lists take the reload. A data-indexed splice would have to be
// translated into table rows, and the translation reads `group_size` — which
// the application has ALREADY moved to describe the new sequence, so there is
// no honest way to ask where the old rows were. `set_count` is what a grouped
// list says, exactly as before.
fn apply_splice(tv: *u8, s: *RowSource, p: *props::ListProps) {
    let at: i64 = { (*p).splice_at };
    let delta: i64 = { (*p).splice_count };
    { (*p).splice_at = -1 as i64 };
    { (*p).splice_count = 0 as i64 };
    if at < (0 as i64) || delta == (0 as i64) { return; }
    if { (*s).groups } > (0 as i64) {
        // The same reload a count write takes, measurements and all — the
        // group structure moved under the cache, so it describes nothing.
        { (*s).heights.remove_all() };
        { (*s).heights_width = 0.0f64 };
        { rt::msg_void(tv, rt::sel(#str_ptr("reloadData\0"))) };
        return;
    }
    let hp: *vec::Vec[f64] = { #addr_of((*s).heights) };
    // NSTableViewAnimationEffectNone. A list says WHAT changed; how it looks
    // changing is the animation band's business, and a transcript that slides
    // its own history is a bug report.
    let none: u64 = 0 as u64;
    if delta > (0 as i64) {
        let span: *u8 = { msg_id_range(rt::get_class(#str_ptr("NSIndexSet\0")),
                                       rt::sel(#str_ptr("indexSetWithIndexesInRange:\0")),
                                       rt::Range { location: at as u64,
                                                   length: delta as u64 }) };
        if span == (0 as *u8) { return; }
        // A new row has no measurement yet, and 0 is exactly how a row that
        // was never measured reads — so the rows below keep theirs.
        var k: i64 = 0 as i64;
        while k < delta {
            if (at as usize) <= { (*hp).count() } {
                let _e: status::Status = { (*hp).insert(0.0f64, at: at as usize) };
            }
            k = k +% (1 as i64);
        }
        { msg_void_id_u64(tv, rt::sel(#str_ptr("insertRowsAtIndexes:withAnimation:\0")),
                          span, none) };
        return;
    }
    let gone: i64 = 0 as i64 -% delta;
    let span: *u8 = { msg_id_range(rt::get_class(#str_ptr("NSIndexSet\0")),
                                   rt::sel(#str_ptr("indexSetWithIndexesInRange:\0")),
                                   rt::Range { location: at as u64,
                                               length: gone as u64 }) };
    if span == (0 as *u8) { return; }
    var k: i64 = 0 as i64;
    while k < gone {
        if (at as usize) < { (*hp).count() } {
            let _r: option::Option[f64] = { (*hp).remove(at: at as usize) };
        }
        k = k +% (1 as i64);
    }
    { msg_void_id_u64(tv, rt::sel(#str_ptr("removeRowsAtIndexes:withAnimation:\0")),
                      span, none) };
    return;
}

#[link_name = "objc_msgSend"]
extern fn msg_void_id_u64(recv: *u8, sel: *u8, a: *u8, b: u64);

// Re-ask a SPAN of rows without discarding the rest — the streaming write.
// `noteHeightOfRowsWithIndexesChanged:` re-asks heights for exactly those rows,
// `reloadDataForRowIndexes:` re-fills their visible cells, and everything else
// survives: the selection, the scroll position, every other vended cell. The
// tree's resize pass uses the same message for the same reason.
//
// The pending span is DATA-indexed — the same `i` that `row(i)` means — and
// translated here, once. A grouped span covers the headers interleaved inside
// it, which costs each a height re-ask, not a rebuild.
fn apply_invalidation(tv: *u8, s: *RowSource, p: *props::ListProps) {
    let lo_d: i64 = { (*p).invalidate_lo };
    let hi_d: i64 = { (*p).invalidate_hi };
    { (*p).invalidate_lo = -1 as i64 };
    { (*p).invalidate_hi = -1 as i64 };
    if lo_d < (0 as i64) || hi_d < lo_d { return; }
    let n: i64 = { (*s).count };
    // Rows the list does not have are not an error — a count can have shrunk
    // under a pending span — but they are nothing to act on either.
    if n <= (0 as i64) || lo_d >= n { return; }
    var hi_c: i64 = hi_d;
    if hi_c >= n { hi_c = n -% (1 as i64); }
    let lo: i64 = table_row_of(s, lo_d);
    let hi: i64 = table_row_of(s, hi_c);
    if lo < (0 as i64) || hi < lo { return; }
    // Drop OUR cache for those rows. 0 is "not measured", the same answer a
    // fresh row has, so the next height question rebuilds exactly these.
    let hp: *vec::Vec[f64] = { #addr_of((*s).heights) };
    var r: i64 = lo;
    while r <= hi {
        if (r as usize) < { (*hp).count() } { set_height(hp, r as usize, 0.0f64); }
        r = r +% (1 as i64);
    }
    let span: *u8 = { msg_id_range(rt::get_class(#str_ptr("NSIndexSet\0")),
                                   rt::sel(#str_ptr("indexSetWithIndexesInRange:\0")),
                                   rt::Range { location: lo as u64,
                                               length: (hi -% lo +% (1 as i64)) as u64 }) };
    if span == (0 as *u8) { return; }
    // Heights first, so the cells the reload re-fills are placed into frames
    // the new content actually fits.
    { rt::msg_void_id(tv, rt::sel(#str_ptr("noteHeightOfRowsWithIndexesChanged:\0")), span) };
    let col0: *u8 = { rt::msg_id_u64(rt::get_class(#str_ptr("NSIndexSet\0")),
                                     rt::sel(#str_ptr("indexSetWithIndex:\0")), 0 as u64) };
    if col0 == (0 as *u8) { return; }
    { rt::msg_void_id_id(tv, rt::sel(#str_ptr("reloadDataForRowIndexes:columnIndexes:\0")),
                         span, col0) };
    return;
}

fn select_data_row(tv: *u8, s: *RowSource, data: i64) {
    let row: i64 = table_row_of(s, data);
    if row < (0 as i64) {
        { rt::msg_void(tv, rt::sel(#str_ptr("deselectAll:\0"))) };
        return;
    }
    let set: *u8 = { rt::msg_id_u64(rt::get_class(#str_ptr("NSIndexSet\0")),
                                    rt::sel(#str_ptr("indexSetWithIndex:\0")), row as u64) };
    if set == (0 as *u8) { return; }
    { msg_void_id_i8(tv, rt::sel(#str_ptr("selectRowIndexes:byExtendingSelection:\0")),
                         set, 0 as i8) };
    return;
}

#[link_name = "objc_msgSend"]
extern fn msg_void_id_i8(recv: *u8, sel: *u8, a: *u8, b: i8);

fn apply_selection_mode(tv: *u8, m: vocab::SelectionMode) {
    let multi: bool = match m {
        vocab::SelectionMode::Multiple => true,
        vocab::SelectionMode::Single => false,
        vocab::SelectionMode::None => false,
    };
    let selectable: bool = match m {
        vocab::SelectionMode::None => false,
        vocab::SelectionMode::Single => true,
        vocab::SelectionMode::Multiple => true,
    };
    { rt::msg_void_i8(tv, rt::sel(#str_ptr("setAllowsMultipleSelection:\0")), multi as i8) };
    { rt::msg_void_i8(tv, rt::sel(#str_ptr("setAllowsEmptySelection:\0")), true as i8) };
    // THE TABLE'S OWN STYLE IS LEFT ALONE — selection BEHAVIOUR is what this
    // sets, and taking a row's ability to be picked would take its click with
    // it (NSTableView owns the mouse in its rows, so selection is the only way
    // a row is clicked at all). What a facet row does not want is the platform
    // DRAWING that selection, and that is suppressed one layer down, on the row
    // view — see `row_added_imp`. The two are separable there and are not
    // separable here.
    // NSTableViewSelectionHighlightStyleRegular = 1, None = -1.
    var hl: i64 = 0 as i64 - (1 as i64);
    if selectable { hl = 1 as i64; }
    { rt::msg_void_i64(tv, rt::sel(#str_ptr("setSelectionHighlightStyle:\0")), hl) };
    if selectable == false { { rt::msg_void(tv, rt::sel(#str_ptr("deselectAll:\0"))) }; }
    return;
}

fn apply_separator(tv: *u8, sep: vocab::Separator, c: vocab::Color) {
    // NSTableViewGridLineStyle: none 0, horizontal 1.
    let shown: u64 = match sep {
        vocab::Separator::Default => 1 as u64,
        vocab::Separator::None => 0 as u64,
    };
    { rt::msg_void_u64(tv, rt::sel(#str_ptr("setGridStyleMask:\0")), shown) };
    if c.is_set() {
        { rt::msg_void_id(tv, rt::sel(#str_ptr("setGridColor:\0")), paint::ns_color(c).raw()) };
    }
    return;
}

// ---- drag debug (FACET_DEBUG_DRAG=1) -----------------------------------------
// The dump half of the scheduler's drag trace: one line per tracked list with
// every width on the chain from the pane host down to the first row's
// innermost content. The lag shows up as the column where the number stops
// following. Tables are tracked at create and never removed — diagnostic
// only, run it on a screen whose lists stay mounted.

extern fn printf(fmt: *u8, ...) -> i32;

#[link_name = "objc_msgSend"]
extern fn msg_id_i64_i8(recv: *u8, sel: *u8, a: i64, b: i8) -> *u8;

static DBG_TABLES: vec::Vec[*u8] = #zero::[vec::Vec[*u8]]();

fn debug_track(tv: *u8) {
    if !scheduler::debug_on() { return; }
    let reg: *vec::Vec[*u8] = { #addr_of(DBG_TABLES) };
    let _s: status::Status = { (*reg).append(tv) };
    { printf(#str_ptr("[dragdbg] tracking list table %p (%llu tracked)\n\0"),
             tv, { (*reg).count() } as u64) };
    return;
}

fn dbg_w(v: *u8) -> f64 {
    if v == (0 as *u8) { return 0.0f64 - 1.0f64; }
    return { rt::msg_rect(v, rt::sel(#str_ptr("frame\0"))) }.w;
}

fn dbg_first_subview(v: *u8) -> *u8 {
    if v == (0 as *u8) { return 0 as *u8; }
    let subs: *u8 = { rt::msg_id(v, rt::sel(#str_ptr("subviews\0"))) };
    if subs == (0 as *u8) { return 0 as *u8; }
    if { rt::msg_u64(subs, rt::sel(#str_ptr("count\0"))) } == (0 as u64) { return 0 as *u8; }
    return { rt::msg_id_u64(subs, rt::sel(#str_ptr("objectAtIndex:\0")), 0 as u64) };
}

fn debug_dump(tag: str) {
    let reg: *vec::Vec[*u8] = { #addr_of(DBG_TABLES) };
    var i: usize = 0 as usize;
    while i < { (*reg).count() } {
        match { (*reg).at(i) } {
            option::Option[*u8]::Some(tv) => {
                let scr: *u8 = { rt::msg_id(tv, rt::sel(#str_ptr("enclosingScrollView\0"))) };
                var pane: *u8 = 0 as *u8;
                var clip: *u8 = 0 as *u8;
                if scr != (0 as *u8) {
                    pane = { rt::msg_id(scr, rt::sel(#str_ptr("superview\0"))) };
                    clip = { rt::msg_id(scr, rt::sel(#str_ptr("contentView\0"))) };
                }
                // Row 0's realised chain: NSTableRowView -> our cell -> content.
                let rv: *u8 = { msg_id_i64_i8(tv, rt::sel(#str_ptr("rowViewAtRow:makeIfNecessary:\0")),
                                              0 as i64, 0 as i8) };
                let cell: *u8 = dbg_first_subview(rv);
                let inner: *u8 = dbg_first_subview(cell);
                { printf(#str_ptr("[dragdbg c%llu] %-11.*s t%llu pane=%.1f scroll=%.1f clip=%.1f table=%.1f col=%.1f row0=%.1f cell=%.1f inner=%.1f\n\0"),
                         scheduler::debug_cycle(), #str_len(tag) as i32, #str_ptr(tag), i as u64,
                         dbg_w(pane), dbg_w(scr), dbg_w(clip), dbg_w(tv), column_width(tv),
                         dbg_w(rv), dbg_w(cell), dbg_w(inner)) };
            }
            option::Option[*u8]::None => { }
        }
        i = i +% (1 as usize);
    }
    return;
}

// ---- the resize pass ---------------------------------------------------------

// Is the viewport within 60pt of the bottom? Read BEFORE a reload changes the
// geometry. A list with no enclosing scroll view counts as at-bottom, because
// there is nowhere else it could be.
fn is_near_bottom(tv: *u8) -> bool {
    let esv: *u8 = { rt::msg_id(tv, rt::sel(#str_ptr("enclosingScrollView\0"))) };
    if esv == (0 as *u8) { return true; }
    let clip: *u8 = { rt::msg_id(esv, rt::sel(#str_ptr("contentView\0"))) };
    if clip == (0 as *u8) { return true; }
    let b: rt::Rect = { rt::msg_rect(clip, rt::sel(#str_ptr("bounds\0"))) };
    let doc_h: f64 = { rt::msg_rect(tv, rt::sel(#str_ptr("frame\0"))) }.h;
    return (b.y + b.h) >= (doc_h - 60.0f64);
}

fn scroll_to_bottom(tv: *u8) {
    let rows: i64 = { rt::msg_i64(tv, rt::sel(#str_ptr("numberOfRows\0"))) };
    if rows <= (0 as i64) { return; }
    { rt::msg_void_i64(tv, rt::sel(#str_ptr("scrollRowToVisible:\0")), rows - (1 as i64)) };
    return;
}

// The table's frame changed. A width change is the only one that matters — a
// height change moves the viewport, not the rows.
fn on_table_resized(ctx: *u8) {
    let s: *RowSource = { ctx as *RowSource };
    if s == (0 as *RowSource) { return; }
    if { (*s).table } == (0 as *u8) { return; }
    if scheduler::debug_on() {
        scheduler::debug_mark_active();
        let dtv: *u8 = { (*s).table };
        { printf(#str_ptr("[dragdbg c%llu] resize-note table=%.1f col=%.1f (reload queued)\n\0"),
                 scheduler::debug_cycle(), dbg_w(dtv), column_width(dtv)) };
    }
    // THE WIDTH IS NOT READ HERE, and that is the point. This runs from
    // `NSViewFrameDidChangeNotification` on the TABLE, while the thing we
    // measure against is the COLUMN — and whether AppKit has re-tiled its
    // columns by the time it posts that notification is an ordering we do not
    // own. Reading the column here can answer the width it had BEFORE the
    // resize, which compares equal to `last_width`, returns early, and drops
    // the resize on the floor: the rows then keep a width the table no longer
    // has, and nothing ever corrects it because the next notification carries
    // the same stale answer.
    //
    // The tick has no such problem. It runs at `kCFRunLoopBeforeWaiting`,
    // after AppKit has finished laying itself out, so the column width read
    // there is the one the table actually has.
    scheduler::defer_reload(reload_job, ctx);
    return;
}

// LIVE, ON THE TICK. This used to coalesce onto a 0.1s `performSelector:` —
// which fires only in the DEFAULT run-loop mode, so during an event-tracking
// drag it did not fire at all: rows kept their old width under a moving
// divider and snapped when you let go.
//
// The tick is the right clock. It is a CFRunLoopObserver at
// `kCFRunLoopBeforeWaiting` registered in COMMON modes, so it fires DURING the
// drag, once per pass, batching every other facet write with this one. The
// layout engine is built for exactly that: flex keeps a cross-call incremental
// cache, so re-laying out at a new width costs the part that moved.
//
// What has to be coalesced is `reloadData`, which asks `heightOfRow:` for
// EVERY row: one call for a `row_height` list, one for a UNIFORM list, and one
// per row for `uneven_rows` — unless the application states its heights
// (`set_row_height_of`), which answers without building anything.
fn reload_job(ctx: *u8) {
    let s: *RowSource = { ctx as *RowSource };
    if s == (0 as *RowSource) { return; }
    let tv: *u8 = { (*s).table };
    if tv == (0 as *u8) { return; }
    // FINISH APPKIT'S LAYOUT BEFORE MEASURING. The column is what rows are
    // measured against, and a layer-backed table tiles its columns in ITS
    // layout pass — deferred to the Core Animation commit, which runs after
    // this job (the tick sorts before the commit), and during a live divider
    // drag may not run between events at all. Read without forcing it, the
    // column still answers the width the LAST pass tiled (measured on a drag:
    // table already 471 while the column said 100), and every row is laid out
    // one resize behind, or never. `layoutSubtreeIfNeeded` runs the deferred
    // pass NOW, insets and all; headless — where nothing defers — it is a
    // no-op, which is why the suite's simulated widths stay authoritative.
    layout_enclosing_scroll(tv);
    let w: f64 = column_width(tv);
    let dbg: bool = scheduler::debug_on();
    // A height change moves the viewport, not the rows — nothing re-wraps.
    if w == { (*s).last_width } {
        if dbg { { printf(#str_ptr("[dragdbg c%llu] reload skipped: col=%.1f unchanged\n\0"),
                          scheduler::debug_cycle(), w) }; }
        return;
    }
    if dbg { { printf(#str_ptr("[dragdbg c%llu] reload at col=%.1f (was %.1f)\n\0"),
                      scheduler::debug_cycle(), w, { (*s).last_width }) }; }
    { (*s).last_width = w };
    // Whether we were at the bottom is read BEFORE anything moves: a narrower
    // width re-wraps rows taller, so the content grows under the viewport and
    // "at the bottom" stops being true by the time the reload has run.
    { (*s).follow_tail = is_near_bottom(tv) };
    // The measurements belonged to the old width.
    { (*s).heights.remove_all() };
    { (*s).heights_width = 0.0f64 };
    { rt::msg_void(tv, rt::sel(#str_ptr("reloadData\0"))) };
    if { (*s).follow_tail } { scroll_to_bottom(tv); }
    return;
}



fn props_of_list(n: *core::Node) -> *props::ListProps {
    let d: *core::Data = core::node_data(n);
    if d == (0 as *core::Data) { return 0 as *props::ListProps; }
    if { (*d).kind } != props::K_LIST { return 0 as *props::ListProps; }
    return { (*d).props } as *props::ListProps;
}

// How many rows the source is answering for — the suite's window into a table
// it cannot scroll.
// The frame notification ALONE — no column change first. The suite's way to
// reproduce AppKit posting `NSViewFrameDidChangeNotification` before it has
// re-tiled its columns.
fn notify_resized(v: *u8) {
    let tv: *u8 = table_of(v);
    if tv == (0 as *u8) { return; }
    let s: *RowSource = source_of(tv);
    if s == (0 as *RowSource) { return; }
    on_table_resized(s as *u8);
    return;
}

// Set the column width WITHOUT notifying — the other half of that ordering.
fn set_column_width(v: *u8, w: f64) {
    let tv: *u8 = table_of(v);
    if tv == (0 as *u8) { return; }
    let cols: *u8 = { rt::msg_id(tv, rt::sel(#str_ptr("tableColumns\0"))) };
    if cols == (0 as *u8) { return; }
    let n: u64 = { rt::msg_u64(cols, rt::sel(#str_ptr("count\0"))) };
    if n == (0 as u64) { return; }
    let c0: *u8 = { rt::msg_id_u64(cols, rt::sel(#str_ptr("objectAtIndex:\0")), 0 as u64) };
    if c0 != (0 as *u8) { { rt::msg_void_f64(c0, rt::sel(#str_ptr("setWidth:\0")), w) }; }
    return;
}

fn heights_width_of(v: *u8) -> f64 {
    let s: *RowSource = source_of(table_of(v));
    if s == (0 as *RowSource) { return 0.0f64; }
    return { (*s).heights_width };
}

// Drive the delegate's row-added hook, the way AppKit does.
fn row_added(v: *u8, rowview: *u8, row: i64) {
    let tv: *u8 = table_of(v);
    if tv == (0 as *u8) { return; }
    row_added_imp(0 as *u8, 0 as *u8, tv, rowview, row);
    return;
}

// Drive the tree's frame-change path, the way the observer does.
fn tree_height_of_row(v: *u8, row: i64) -> f64 {
    let ov: *u8 = table_of(v);
    if ov == (0 as *u8) { return 0.0f64; }
    let item: *u8 = { rt::msg_id_i64(ov, rt::sel(#str_ptr("itemAtRow:\0")), row) };
    if item == (0 as *u8) { return 0.0f64; }
    return tree_height_imp(0 as *u8, 0 as *u8, ov, item);
}

// Drive the DidExpand notification the way AppKit does, for an item by row.
// Drive what a reload does to the selection: clear it, then let AppKit report
// the clear. `reloadData` headlessly does not clear at all (no window, no
// display cycle), so the real sequence has to be posed directly.
fn tree_clear_selection_as_a_reload_would(v: *u8, syncing: bool) {
    let ov: *u8 = table_of(v);
    if ov == (0 as *u8) { return; }
    let s: *TreeSource = tree_source_of(ov);
    if s == (0 as *TreeSource) { return; }
    { (*s).syncing = syncing };
    { rt::msg_void(ov, rt::sel(#str_ptr("deselectAll:\0"))) };
    tree_selection_changed_from(ov);
    { (*s).syncing = false };
    return;
}

fn tree_selection_changed_from(ov: *u8) {
    let s: *TreeSource = tree_source_of(ov);
    if s == (0 as *TreeSource) { return; }
    if { (*s).syncing } { return; }
    let p: *tree::TreeProps = tree_props_of({ (*s).node });
    if p == (0 as *tree::TreeProps) { return; }
    let row: i64 = { rt::msg_i64(ov, rt::sel(#str_ptr("selectedRow\0"))) };
    if row < (0 as i64) { { (*p).selected = text::new() }; return; }
    let item: *u8 = { rt::msg_id_i64(ov, rt::sel(#str_ptr("itemAtRow:\0")), row) };
    let tn: *tree::TreeNode = unbox_item(item);
    if tn != (0 as *tree::TreeNode) {
        { (*p).selected = text::from_str({ (*tn).id.view() }) };
    }
    return;
}

fn tree_notify_expanded(v: *u8, row: i64) {
    let ov: *u8 = table_of(v);
    if ov == (0 as *u8) { return; }
    let s: *TreeSource = tree_source_of(ov);
    if s == (0 as *TreeSource) { return; }
    let item: *u8 = { rt::msg_id_i64(ov, rt::sel(#str_ptr("itemAtRow:\0")), row) };
    if item == (0 as *u8) { return; }
    // AppKit has already expanded it before it tells anyone.
    { (*s).syncing = true };
    { rt::msg_void_id(ov, rt::sel(#str_ptr("expandItem:\0")), item) };
    { (*s).syncing = false };
    let tn: *tree::TreeNode = unbox_item(item);
    if tn == (0 as *tree::TreeNode) { return; }
    { (*s).expanded_by_user = true };
    match tree::from({ (*s).node }) {
        option::Option[tree::Tree]::Some(t) => {
            let _e: tree::Tree = t.expand({ (*tn).id.view() });
        }
        option::Option[tree::Tree]::None => { }
    }
    return;
}

// The same notification, posed as AppKit posts it from inside a delegate call.
fn tree_notify_resized_in_delegate(v: *u8) {
    let ov: *u8 = table_of(v);
    if ov == (0 as *u8) { return; }
    let s: *TreeSource = tree_source_of(ov);
    if s == (0 as *TreeSource) { return; }
    { (*s).in_delegate = true };
    on_tree_resized(s as *u8);
    { (*s).in_delegate = false };
    return;
}

fn tree_notify_resized(v: *u8) {
    let ov: *u8 = table_of(v);
    if ov == (0 as *u8) { return; }
    let s: *TreeSource = tree_source_of(ov);
    if s == (0 as *TreeSource) { return; }
    on_tree_resized(s as *u8);
    return;
}

fn tree_last_width_of(v: *u8) -> f64 {
    let s: *TreeSource = tree_source_of(table_of(v));
    if s == (0 as *TreeSource) { return 0.0f64; }
    return { (*s).last_width };
}

fn column_width_of(v: *u8) -> f64 {
    let tv: *u8 = table_of(v);
    if tv == (0 as *u8) { return 0.0f64; }
    return column_width(tv);
}

fn row_count_of(v: *u8) -> i64 {
    let s: *RowSource = source_of(table_of(v));
    if s == (0 as *RowSource) { return 0 as i64; }
    return { (*s).count };
}

fn fixed_height_of(v: *u8) -> f64 {
    let s: *RowSource = source_of(table_of(v));
    if s == (0 as *RowSource) { return 0.0f64; }
    return { (*s).fixed_height };
}

// Ask the delegate directly, the way NSTableView does.
fn height_of_row(v: *u8, row: i64) -> f64 {
    let tv: *u8 = table_of(v);
    if tv == (0 as *u8) { return 0.0f64; }
    return height_imp(0 as *u8, 0 as *u8, tv, row);
}

fn view_for_row(v: *u8, row: i64) -> *u8 {
    let tv: *u8 = table_of(v);
    if tv == (0 as *u8) { return 0 as *u8; }
    return view_for_row_imp(0 as *u8, 0 as *u8, tv, 0 as *u8, row);
}

// WHICH POOL row `row` is vended from. The suite's way to see the decision: a
// headless table never fills its reuse queue, so asking it for a recycled cell
// always answers nil and the identity a cell would have been taken under is
// invisible from the outside.
fn identity_of_row(v: *u8, row: i64) -> text::Text {
    let tv: *u8 = table_of(v);
    if tv == (0 as *u8) { return text::new(); }
    let s: *RowSource = source_of(tv);
    if s == (0 as *RowSource) { return text::new(); }
    return row_identity(s, resolve_row(s, row));
}

// A cell the caller keeps, filled with `row`. The suite's way into the REUSE
// branch: a headless table never fills its reuse queue, so asking it for a
// recycled cell always answers nil and the branch that matters never runs.
fn fill_into(v: *u8, cell: *u8, row: i64) {
    let tv: *u8 = table_of(v);
    if tv == (0 as *u8) { return; }
    let s: *RowSource = source_of(tv);
    if s == (0 as *RowSource) { return; }
    fill_cell(s, cell, row, column_width(tv));
    return;
}

fn make_cell(v: *u8) -> *u8 {
    let tv: *u8 = table_of(v);
    if tv == (0 as *u8) { return 0 as *u8; }
    return new_cell("facet.row", column_width(tv));
}

// ==============================================================================
// tree — a recycling NSOutlineView
// ==============================================================================
//
// The same machinery as `list`, and a BETTER fit: NSOutlineView's data source is
// item-based, and facet's tree is already a model of items. The item pointer IS
// the `*TreeNode`, so nothing has to map an index onto a node and nothing can
// drift when the model changes shape.
//
//   numberOfChildrenOfItem:  TreeNode::child_count      (the root, for nil)
//   child:ofItem:            TreeNode::child_ptr
//   isItemExpandable:        child_count > 0
//   viewForTableColumn:item: the app's row builder, or a label of the node
//
// The root is the CONTAINER, not a row — a tree shows its children — which is
// what `nil means the root` already says in AppKit's protocol.
//
// INDENTATION IS APPKIT'S HERE. The materialising version made it a leading pad
// on the row, because it had no other way; an outline view indents its own
// cells and drawing a second gutter inside them would double it.
//
// Expansion is facet's state (`TreeProps.expanded`, a set of ids) and AppKit's
// (per-item). They are synchronised in one direction on reload — facet's set is
// the model — and the other way when the USER expands, so a click does not have
// to round-trip through a rebuild.

fn tree_source_key() -> *u8 { return { 29033 as *u8 }; }
fn tree_agent_pin_key() -> *u8 { return { 29034 as *u8 }; }
fn item_node_key() -> *u8 { return { 29035 as *u8 }; }

struct TreeSource {
    opaque node: *core::Node,      // the facet tree node, for props
    opaque outline: *u8,
    // The width the rows in hand were laid out at. A tree had NO resize path at
    // all — the list observed its own frame and re-placed its rows, the tree
    // observed nothing — so a materialized tree row was never re-laid out for a
    // width change, and `autoresize_subtree`'s springs were the only thing
    // tracking it. Springs distribute a delta in PROPORTION to current widths,
    // so a subtree squeezed to ~zero has no proportion left and never grows
    // back: labels truncate, clip to slivers, then vanish, inside cells that
    // are full width again. Only a re-vend healed it, which for a tree meant an
    // fs event or a tab flip.
    last_width: f64,
    // True while AppKit is inside one of OUR delegate callbacks. A resize that
    // arrives then must not reload: re-entering the table from inside its own
    // delegate is what AppKit warns about ("Application performed a reentrant
    // operation in its NSTableView delegate"), and it shows as rows drawn
    // twice and a stuttering expand.
    in_delegate: bool,
    // Set when an expansion arrived FROM AppKit — the user clicked a triangle
    // or pressed the arrow key — so the model write that records it does not
    // come back around as a reload. See `apply_recycling_tree`.
    expanded_by_user: bool,
    // True while `sync_expansion` is APPLYING the model to the outline view.
    // AppKit answers each `expandItem:` with a DidExpand notification, and the
    // write-back must not rewrite the model from its own application — for a
    // collapse that would delete the entry that caused it.
    syncing: bool,
}

fn tree_source_of(ov: *u8) -> *TreeSource {
    if ov == (0 as *u8) { return 0 as *TreeSource; }
    return { synth::get_associated(ov, tree_source_key()) as *TreeSource };
}

fn tree_props_of(n: *core::Node) -> *tree::TreeProps {
    let d: *core::Data = core::node_data(n);
    if d == (0 as *core::Data) { return 0 as *tree::TreeProps; }
    if { (*d).kind } != tree::K_TREE { return 0 as *tree::TreeProps; }
    return { (*d).props } as *tree::TreeProps;
}

fn props_for(ov: *u8) -> *tree::TreeProps {
    let s: *TreeSource = tree_source_of(ov);
    if s == (0 as *TreeSource) { return 0 as *tree::TreeProps; }
    return tree_props_of({ (*s).node });
}

// AppKit hands items back as `id`, and facet's items are `*TreeNode` — not
// objects. So each one is carried by a box: an NSObject with the pointer on an
// associated key. Made on demand and autoreleased; the outline view retains
// what it keeps.
// ONE BOX PER NODE, FOR THE LIFE OF THE TREE.
//
// An outline view identifies items by the OBJECT: selection, expansion,
// `rowForItem:` and its row rebuild are all keyed on the pointers the data
// source hands back. This minted a fresh NSObject on every
// `outlineView:child:ofItem:` — so no two answers were ever the same item, and
// AppKit could not recognise anything it had been told a moment earlier.
//
// It presented as the selection vanishing on a splitter drag, one direction
// only. The trace says why, and it is not where anyone was looking:
//
//     tree reload#98: keep=b rows=6 sel=2     the reload restores it
//     tree reload:done:            sel=2      still there
//     tree vend:enter:             sel=-1     gone, before the next vend
//
// The re-select was working every time. AppKit was dropping it afterwards,
// while rebuilding rows out of items it had never seen before — and the next
// reload put it back, which is why widening "fixed" it and why it looked like a
// direction. A drag that ends on a clear leaves the highlight off.
//
// The map is keyed by the node's ADDRESS, which the model guarantees is stable
// from insertion until removal (`tree.cplus`, "who owns the model"). It hangs
// off the outline view, so it dies with it, and it is emptied whenever the root
// is replaced — see `apply_tree`.
fn item_map_key() -> *u8 { return { 29036 as *u8 }; }

fn item_map(ov: *u8) -> *u8 {
    if ov == (0 as *u8) { return 0 as *u8; }
    let existing: *u8 = { synth::get_associated(ov, item_map_key()) };
    if existing != (0 as *u8) { return existing; }
    let map: *u8 = { rt::alloc_init(#str_ptr("NSMutableDictionary\0")) };
    if map == (0 as *u8) { return 0 as *u8; }
    synth::retain_associated(ov, item_map_key(), map);
    { rt::release(map) };
    return { synth::get_associated(ov, item_map_key()) };
}

fn forget_items(ov: *u8) {
    let map: *u8 = { synth::get_associated(ov, item_map_key()) };
    if map == (0 as *u8) { return; }
    { rt::msg_void(map, rt::sel(#str_ptr("removeAllObjects\0"))) };
    return;
}

fn box_item(ov: *u8, node: *tree::TreeNode) -> *u8 {
    if node == (0 as *tree::TreeNode) { return 0 as *u8; }
    let map: *u8 = item_map(ov);
    // No map is no worse than this function has ever been: a fresh box still
    // names the right node, it is only AppKit's memory of it that suffers.
    let key: *u8 = { msg_id_ptr(rt::get_class(#str_ptr("NSValue\0")),
                                    rt::sel(#str_ptr("valueWithPointer:\0")), node as *u8) };
    if map != (0 as *u8) && key != (0 as *u8) {
        let hit: *u8 = { rt::msg_id_id(map, rt::sel(#str_ptr("objectForKey:\0")), key) };
        if hit != (0 as *u8) { return hit; }
    }
    let obj: *u8 = { rt::alloc_init(#str_ptr("NSObject\0")) };
    if obj == (0 as *u8) { return 0 as *u8; }
    synth::set_associated(obj, item_node_key(), node as *u8);
    if map != (0 as *u8) && key != (0 as *u8) {
        // The map owns it, which is what makes the box outlive the call that
        // made it — an autoreleased one could not be handed back later.
        { rt::msg_void_id_id(map, rt::sel(#str_ptr("setObject:forKey:\0")), obj, key) };
        { rt::release(obj) };
        return obj;
    }
    return rt::autorelease(obj);
}

#[link_name = "objc_msgSend"]
extern fn msg_id_ptr(recv: *u8, sel: *u8, p: *u8) -> *u8;

fn unbox_item(item: *u8) -> *tree::TreeNode {
    if item == (0 as *u8) { return 0 as *tree::TreeNode; }
    return { synth::get_associated(item, item_node_key()) as *tree::TreeNode };
}

// nil is the ROOT — AppKit's own convention, and it matches facet's: the root
// is the container, not a row.
fn item_or_root(ov: *u8, item: *u8) -> *tree::TreeNode {
    if item != (0 as *u8) { return unbox_item(item); }
    let p: *tree::TreeProps = props_for(ov);
    if p == (0 as *tree::TreeProps) { return 0 as *tree::TreeNode; }
    return { #addr_of((*p).root) };
}

fn tree_child_count_imp(self_obj: *u8, cmd: *u8, ov: *u8, item: *u8) -> i64 {
    let n: *tree::TreeNode = item_or_root(ov, item);
    if n == (0 as *tree::TreeNode) { return 0 as i64; }
    return { (*n).child_count() } as i64;
}

fn tree_child_imp(self_obj: *u8, cmd: *u8, ov: *u8, index: i64, item: *u8) -> *u8 {
    let n: *tree::TreeNode = item_or_root(ov, item);
    if n == (0 as *tree::TreeNode) { return 0 as *u8; }
    return match { (*n).child_ptr(index as usize) } {
        option::Option[*tree::TreeNode]::Some(c) => box_item(ov, c),
        option::Option[*tree::TreeNode]::None => 0 as *u8,
    };
}

fn tree_expandable_imp(self_obj: *u8, cmd: *u8, ov: *u8, item: *u8) -> i8 {
    let n: *tree::TreeNode = unbox_item(item);
    if n == (0 as *tree::TreeNode) { return 0 as i8; }
    if { (*n).child_count() } > (0 as usize) { return 1 as i8; }
    return 0 as i8;
}

// The outline view's own row height, for when the model cannot answer.
fn outline_default_row_height(ov: *u8) -> f64 {
    let h: f64 = { rt::msg_f64(ov, rt::sel(#str_ptr("rowHeight\0"))) };
    if h >= 1.0f64 { return h; }
    return controls::DEFAULT_TREE_ROW_H;
}

fn tree_height_imp(self_obj: *u8, cmd: *u8, ov: *u8, item: *u8) -> f64 {
    let ds: *TreeSource = tree_source_of(ov);
    if ds != (0 as *TreeSource) { { (*ds).in_delegate = true }; }
    let h: f64 = tree_height_body(ov, item);
    if ds != (0 as *TreeSource) { { (*ds).in_delegate = false }; }
    return h;
}

fn tree_height_body(ov: *u8, item: *u8) -> f64 {
    let p: *tree::TreeProps = props_for(ov);
    if p == (0 as *tree::TreeProps) { return outline_default_row_height(ov); }
    let fh: f64 = { (*p).row_height };
    if fh >= 1.0f64 { return fh; }
    let n: *tree::TreeNode = unbox_item(item);
    if n == (0 as *tree::TreeNode) { return outline_default_row_height(ov); }
    var row: core::Node = tree_row_node(n, p);
    tree_bind_into(p, n, #addr_of(row));
    row.calculate_layout(width: column_width(ov));
    var h: f64 = { row.frame().height };
    // A row measured HERE has not been realised, so any part of it sized by an
    // intrinsic measure answers zero — the measure callback arrives with the
    // native view. Zero means "could not measure", not "zero tall"; clamping it
    // to one point made every such row invisible. A builder that wants an exact
    // height states one, on the row or through `row_height`.
    if h < 1.0f64 { h = outline_default_row_height(ov); }
    return h;
}

// The application's row builder, or a plain label of the node's own text when
// it gave none — a tree with no builder still shows its shape.
// The height this tree STATES for every row, or 0 for "measure it". Only a
// stated height can differ from what the content measures, which is the only
// case where a row has spare space to align within.
// How many times the tree has reloaded. The user-expansion fix is invisible
// otherwise: its whole effect is a reload that does NOT happen.
static TREE_RELOADS: i64 = 0 as i64;
fn tree_reloads() -> i64 { return TREE_RELOADS; }
fn reset_tree_reloads() { TREE_RELOADS = 0 as i64; return; }

// ---- tree focus trace (FACET_DEBUG_TREE=1) ----------------------------------
//
// The Files tree loses first responder on the FIRST expand and not on collapse,
// and three readings of the code guessed wrong. Expand VENDS new cells and
// collapse does not, so the trace follows the vend: who the window's first
// responder is before and after each step that could move it.
//
// Env-gated and free when off, same precedent as FACET_DEBUG_DRAG.
static TDBG_READ: bool = false;
static TDBG_ON: bool = false;

fn tree_debug_on() -> bool {
    if !TDBG_READ { TDBG_READ = true; TDBG_ON = env::has_var("FACET_DEBUG_TREE"); }
    return TDBG_ON;
}

// The window's first responder, as a class name — enough to see focus move off
// the outline view and onto the window (which is what a C_BLUR does) or onto a
// freshly vended control.
fn tree_responder(ov: *u8) -> str {
    if ov == (0 as *u8) { return "<no view>"; }
    let win: *u8 = { rt::msg_id(ov, rt::sel(#str_ptr("window\0"))) };
    if win == (0 as *u8) { return "<no window>"; }
    let fr: *u8 = { rt::msg_id(win, rt::sel(#str_ptr("firstResponder\0"))) };
    if fr == (0 as *u8) { return "<none>"; }
    if fr == win { return "WINDOW"; }
    if fr == ov { return "outlineview"; }
    // Not naming the class: `class_name` answers a C string and the point here
    // is only WHICH of the three it is. Focus landing on the window is a blur;
    // landing off the outline view at all is the bug.
    return "other";
}

// Every subview of a vended cell, with its frame. The icon reads as cut on
// screen and measures correctly in the suite, so the answer has to come from
// the running app.
fn tree_dump_cell(cell: *u8) {
    if cell == (0 as *u8) { return; }
    let cf: rt::Rect = { rt::msg_rect(cell, rt::sel(#str_ptr("frame\0"))) };
    let cx: i64 = cf.x as i64; let cw: i64 = cf.w as i64; let ch: i64 = cf.h as i64;
    io::eprintln("tree cell: x=${cx} w=${cw} h=${ch}");
    let arr: *u8 = { rt::msg_id(cell, rt::sel(#str_ptr("subviews\0"))) };
    if arr == (0 as *u8) { return; }
    let n: u64 = { rt::msg_u64(arr, rt::sel(#str_ptr("count\0"))) };
    var i: u64 = 0 as u64;
    while i < n {
        let sv: *u8 = { rt::msg_id_u64(arr, rt::sel(#str_ptr("objectAtIndex:\0")), i) };
        let f: rt::Rect = { rt::msg_rect(sv, rt::sel(#str_ptr("frame\0"))) };
        let x: i64 = f.x as i64; let y: i64 = f.y as i64;
        let w2: i64 = f.w as i64; let h2: i64 = f.h as i64;
        let idx: i64 = i as i64;
        io::eprintln("tree   sub ${idx}: x=${x} y=${y} w=${w2} h=${h2}");
        i = i +% (1 as u64);
    }
    return;
}

// What a reload did to the selection: what it meant to keep, how many rows it
// had to look through, and where it landed. `keep` non-empty with `sel` -1 is
// the failure being hunted.
fn tree_reload_trace(ov: *u8, keep: str) {
    if !tree_debug_on() { return; }
    let rows: i64 = { rt::msg_i64(ov, rt::sel(#str_ptr("numberOfRows\0"))) };
    let sel: i64 = { rt::msg_i64(ov, rt::sel(#str_ptr("selectedRow\0"))) };
    let n: i64 = TREE_RELOADS;
    let who: i64 = ov as i64;
    io::eprintln("tree reload#${n}: ov=${who} keep=${keep} rows=${rows} sel=${sel}");
    return;
}

fn tree_trace(ov: *u8, where_: str) {
    if !tree_debug_on() { return; }
    let who: str = tree_responder(ov);
    let rows: i64 = { rt::msg_i64(ov, rt::sel(#str_ptr("numberOfRows\0"))) };
    let sel: i64 = { rt::msg_i64(ov, rt::sel(#str_ptr("selectedRow\0"))) };
    io::eprintln("tree ${where_}: responder=${who} rows=${rows} sel=${sel}");
    return;
}

fn stated_tree_row_height(p: *tree::TreeProps) -> f64 {
    if p == (0 as *tree::TreeProps) { return 0.0f64; }
    let h: f64 = { (*p).row_height };
    if h >= 1.0f64 { return h; }
    return 0.0f64;
}

fn tree_row_node(n: *tree::TreeNode, p: *tree::TreeProps) -> core::Node {
    // Same door as materialise_tree: height + vertical centre for the disclosure.
    return controls::build_tree_row(n, p);
}

fn tree_view_for_item_imp(self_obj: *u8, cmd: *u8, ov: *u8, col: *u8, item: *u8) -> *u8 {
    tree_trace(ov, "vend:enter");
    let ds: *TreeSource = tree_source_of(ov);
    if ds != (0 as *TreeSource) { { (*ds).in_delegate = true }; }
    let out: *u8 = tree_view_for_item_body(ov, item);
    // EVERY VEND, because the cell is RECYCLED: an id written once names the
    // item that happened to build the cell, and from the next reuse onwards it
    // names the wrong row. Same reason the bind runs every time.
    tag_tree_row(ov, item, out);
    // What the cell is showing, and who vended it — read by `performClick:`,
    // which cannot ask the view hierarchy: a cell has no superview until AppKit
    // places it, and `rowForView:` knows nothing about a view the table has not
    // displayed yet.
    if out != (0 as *u8) {
        synth::set_associated(out, cell_item_key(), item);
        synth::set_associated(out, cell_owner_key(), ov);
    }
    if tree_debug_on() { tree_dump_cell(out); }
    if ds != (0 as *TreeSource) { { (*ds).in_delegate = false }; }
    return out;
}

// THE ROW'S NAME ON THE AGENT SURFACE.
//
// A tree row is the one control an application cannot key: the row it builds is
// CONTENT, mounted inside a cell this file makes and owns, so no application
// key ever lands on the row itself. Without this the Files tree is invisible to
// `describe_ui` — the pane is there, the rows are not — and nothing in it can
// be clicked over the socket.
//
// The id is the accessibilityIdentifier, which is what a key already is
// everywhere else in this backend (`views::create`): one token for facet's
// address, the agent surface's id and the platform's a11y id. No dependency on
// the agent package falls out of that, which is the point.
fn tag_tree_row(ov: *u8, item: *u8, cell: *u8) {
    if cell == (0 as *u8) { return; }
    let p: *tree::TreeProps = props_for(ov);
    if p == (0 as *tree::TreeProps) { return; }
    let f: fn(*tree::TreeNode, *u8) -> text::Text = { (*p).row_id };
    // Against `no_row_id` by NAME, like every other absent handler here.
    if f == tree::no_row_id { return; }
    let n: *tree::TreeNode = unbox_item(item);
    if n == (0 as *tree::TreeNode) { return; }
    let id: text::Text = f(n, { (*p).row_id_ctx });
    ak::Accessibility::from_raw(cell).set_accessibility_identifier(id.view());
    return;
}

fn tree_view_for_item_body(ov: *u8, item: *u8) -> *u8 {
    let p: *tree::TreeProps = props_for(ov);
    if p == (0 as *tree::TreeProps) { return 0 as *u8; }
    let n: *tree::TreeNode = unbox_item(item);
    if n == (0 as *tree::TreeNode) { return 0 as *u8; }
    let w: f64 = column_width(ov);

    var cell: *u8 = { msg_id_id_i64(ov, rt::sel(#str_ptr("makeViewWithIdentifier:owner:\0")),
                                    bridge::nsstring("facet.item"), 0 as i64) };
    var fresh: bool = false;
    if cell == (0 as *u8) {
        // A `FacetRowCell`, like the list's — an outline cell is the one that
        // MUST re-place itself, because indentation is why its width differs
        // from the column's in the first place.
        cell = rt::retain(new_row_cell(rt::Rect { x: 0.0f64, y: 0.0f64, w: w, h: 1.0f64 }));
        if cell == (0 as *u8) { return 0 as *u8; }
        { rt::msg_void_id(cell, rt::sel(#str_ptr("setIdentifier:\0")),
                          bridge::nsstring("facet.item")) };
        rt::autorelease(cell);
        fresh = true;
    }

    // The same recycling path the list takes, with the ITEM in place of the
    // index — see `view_for_row_imp`.
    if tree_has_bind(p) && !fresh {
        let existing: *core::Node = { synth::get_associated(cell, cell_node_key()) as *core::Node };
        if existing != (0 as *core::Node) {
            tree_bind_into(p, n, existing);
            mount::sync_from(existing);
            let _bh: f64 = place_row(cell, existing, w, outline_default_row_height(ov),
                                     row_h: stated_tree_row_height(p));
            return cell;
        }
    }
    if !fresh { release_cell_row(cell); }

    // Realise FIRST, then lay out. A node's intrinsic size comes from the
    // measure callback the backend installs while creating its native view, so
    // laying out beforehand measures every such node at zero — the row came out
    // one point tall and the text inside it with it. The recycle path above
    // already had this order, because the node it reuses is already realised.
    let node: core::Node = tree_row_node(n, p);
    match box::new::[core::Node](node) {
        option::Option[box::Box[core::Node]]::Some(b) => {
            let np: *core::Node = { b.into_raw() } as *core::Node;
            empty_cell(cell);
            let _rv: *u8 = mount::realise(np, cell);
            tree_bind_into(p, n, np);
            mount::sync_from(np);
            let _h: f64 = place_row(cell, np, w, outline_default_row_height(ov),
                                    row_h: stated_tree_row_height(p));
            synth::set_associated(cell, cell_node_key(), np as *u8);
        }
        option::Option[box::Box[core::Node]]::None => { }
    }
    return cell;
}

fn tree_has_bind(p: *tree::TreeProps) -> bool {
    return { (*p).bind } != tree::no_bind;
}

fn tree_bind_into(p: *tree::TreeProps, n: *tree::TreeNode, into: *core::Node) {
    let f: fn(*tree::TreeNode, *u8, *core::Node) = { (*p).bind };
    if f == tree::no_bind { return; }
    f(n, { (*p).bind_ctx }, into);
    return;
}

fn tree_agent_class() -> *u8 {
    let existing: *u8 = rt::get_class(#str_ptr("FacetTreeSource\0"));
    if existing != (0 as *u8) { return existing; }
    let cls: *u8 = synth::allocate_class_pair(rt::get_class(#str_ptr("NSObject\0")),
                                              #str_ptr("FacetTreeSource\0"), 0 as usize);
    add_method_i64_2id(cls, rt::sel(#str_ptr("outlineView:numberOfChildrenOfItem:\0")),
                       tree_child_count_imp, #str_ptr("q@:@@\0"));
    add_method_id_2id_i64_swapped(cls, rt::sel(#str_ptr("outlineView:child:ofItem:\0")),
                                  tree_child_imp, #str_ptr("@@:@q@\0"));
    synth::add_method_i8_2id(cls, rt::sel(#str_ptr("outlineView:isItemExpandable:\0")),
                             tree_expandable_imp, #str_ptr("c@:@@\0"));
    add_method_f64_2id(cls, rt::sel(#str_ptr("outlineView:heightOfRowByItem:\0")),
                       tree_height_imp, #str_ptr("d@:@@\0"));
    add_method_id_3id_x(cls, rt::sel(#str_ptr("outlineView:viewForTableColumn:item:\0")),
                        tree_view_for_item_imp, #str_ptr("@@:@@@\0"));
    synth::add_method_v_1id(cls, rt::sel(#str_ptr("outlineViewSelectionDidChange:\0")),
                            tree_selection_changed_imp, #str_ptr("v@:@\0"));
    // Expansion was WRITE-ONLY. facet's `expanded` set drove the outline view
    // and nothing drove it back, so a user clicking a disclosure triangle
    // never reached the model — and `Tree::restore()`, whose whole purpose is
    // re-applying expansion after a rebuild, replayed a stale set. Selection
    // already round-tripped, which made the asymmetry the loud part.
    synth::add_method_v_1id(cls, rt::sel(#str_ptr("outlineViewItemDidExpand:\0")),
                            tree_did_expand_imp, #str_ptr("v@:@\0"));
    synth::add_method_v_1id(cls, rt::sel(#str_ptr("outlineViewItemDidCollapse:\0")),
                            tree_did_collapse_imp, #str_ptr("v@:@\0"));
    // The WILL half is here for the animation, not the model — see
    // `hold_row_animation`. Nothing about expansion state is read or written
    // before AppKit has done it.
    synth::add_method_v_1id(cls, rt::sel(#str_ptr("outlineViewItemWillExpand:\0")),
                            tree_will_expand_imp, #str_ptr("v@:@\0"));
    synth::add_method_v_1id(cls, rt::sel(#str_ptr("outlineViewItemWillCollapse:\0")),
                            tree_will_collapse_imp, #str_ptr("v@:@\0"));
    // NO ROW-HIGHLIGHT SUPPRESSION HERE, deliberately, and it is not an
    // oversight to be tidied up into matching the list.
    //
    // A LIST row in iris is a card that draws its own selected state, so the
    // platform's full-row blue behind it is a second answer to the same
    // question. A TREE row is a name and an icon that draw no such thing, so
    // the platform's highlight IS the feedback — take it away and nothing says
    // which row is selected.
    //
    // Which means the two are a CHOICE the contract cannot currently express:
    // `selection_mode` says whether a row can be picked, and nothing says
    // whether the platform should draw it. Hard-coding opposite answers per
    // control is what is happening here, and it is the wrong shape — a
    // `selection_highlight` word beside `selection_mode` is the right one.
    synth::register_class_pair(cls);
    return cls;
}

#[link_name = "class_addMethod"]
extern fn add_method_i64_2id(cls: *u8, sel: *u8, imp: fn(*u8, *u8, *u8, *u8) -> i64,
                             types: *u8) -> i8;
#[link_name = "class_addMethod"]
extern fn add_method_id_2id_i64_swapped(cls: *u8, sel: *u8,
                                        imp: fn(*u8, *u8, *u8, i64, *u8) -> *u8,
                                        types: *u8) -> i8;
#[link_name = "class_addMethod"]
extern fn add_method_f64_2id(cls: *u8, sel: *u8, imp: fn(*u8, *u8, *u8, *u8) -> f64,
                             types: *u8) -> i8;
#[link_name = "class_addMethod"]
extern fn add_method_id_3id_x(cls: *u8, sel: *u8,
                              imp: fn(*u8, *u8, *u8, *u8, *u8) -> *u8, types: *u8) -> i8;

// The selected row's IDENTITY, written back into the props before the handler
// runs. `selected()` reads the props — the same rule the text controls follow —
// so a handler that asks which row is selected gets the one that just was.
// The two halves of the expansion write-back. Both read the notification's
// `userInfo["NSObject"]`, which is the item that opened or closed.
//
// Guarded by `syncing`: `sync_expansion` calls `expandItem:` itself to apply
// the model, and AppKit answers each of those with this notification. Without
// the guard the model would be rewritten from its own application — harmless
// for expand, but a collapse during a rebuild would delete the entry that
// caused it.
fn tree_notified_item(note: *u8) -> *u8 {
    let info: *u8 = { rt::msg_id(note, rt::sel(#str_ptr("userInfo\0"))) };
    if info == (0 as *u8) { return 0 as *u8; }
    return { rt::msg_id_id(info, rt::sel(#str_ptr("objectForKey:\0")),
                           bridge::nsstring("NSObject")) };
}

fn tree_expansion_changed(note: *u8, now_expanded: bool) {
    let ov: *u8 = { rt::msg_id(note, rt::sel(#str_ptr("object\0"))) };
    if ov == (0 as *u8) { return; }
    let s: *TreeSource = tree_source_of(ov);
    if s == (0 as *TreeSource) { return; }
    if { (*s).syncing } { return; }
    let item: *u8 = tree_notified_item(note);
    if item == (0 as *u8) { return; }
    let tn: *tree::TreeNode = unbox_item(item);
    if tn == (0 as *tree::TreeNode) { return; }
    let n: *core::Node = { (*s).node };
    match tree::from(n) {
        option::Option[tree::Tree]::Some(t) => {
            // The outline view has ALREADY done this; the model is only
            // recording it. Say so, or `apply` reloads to "apply" a change
            // that is already applied — and takes the selection with it.
            tree_trace(ov, "write-back:expand");
            { (*s).expanded_by_user = true };
            let id: str = { (*tn).id.view() };
            if now_expanded {
                let _e: tree::Tree = t.expand(id);
            } else {
                let _c: tree::Tree = t.collapse(id);
            }
        }
        option::Option[tree::Tree]::None => { }
    }
    return;
}

// ---- a row is PLACED, not moved ----------------------------------------------
//
// Expanding a folder slid the rows below it into their new positions over about
// a quarter of a second. Measured in a live window, sampling every 50ms: the
// animating object is the NSTableRowView of each row AFTER the expanded item —
// `animationKeys` = 1, and its presentation frame 200pt from its model frame,
// decaying 202 -> 124 -> 61 -> 15 across four samples. Nothing facet places
// moves at all.
//
// That is why disabling Core Animation's implicit actions did not touch it, and
// the ablation says so plainly: with `without_implicit_animation_*` neutered,
// the same expand produces the same measurements. Those guards are still right
// for what they guard — a frame `place_row` writes is a placement — but they
// were never what this symptom was about.
//
// The row animation is AppKit's own, run for the user's disclosure click, and
// NSAnimationContext is what governs it: a zero-duration grouping opened before
// the expansion and closed after it. It has to be a GROUPING rather than a
// property set, because the animation is started inside AppKit's own handling
// between the two notifications, and `WillExpand`/`DidExpand` are the only pair
// that bracket it.
//
// The DEPTH COUNTER is not defensive dressing. An unbalanced `endGrouping`
// pops a context this code never pushed, and NSAnimationContext's stack is
// process-wide: the next animation anyone runs would inherit a duration from
// here. Only a grouping this file opened is closed.
static ANIM_HELD: i64 = 0 as i64;

fn hold_row_animation() {
    let cls: *u8 = rt::get_class(#str_ptr("NSAnimationContext\0"));
    if cls == (0 as *u8) { return; }
    { rt::msg_void(cls, rt::sel(#str_ptr("beginGrouping\0"))) };
    let ctx: *u8 = { rt::msg_id(cls, rt::sel(#str_ptr("currentContext\0"))) };
    if ctx != (0 as *u8) {
        { rt::msg_void_f64(ctx, rt::sel(#str_ptr("setDuration:\0")), 0.0f64) };
    }
    ANIM_HELD = ANIM_HELD + (1 as i64);
    return;
}

fn release_row_animation() {
    if ANIM_HELD <= (0 as i64) { return; }
    let cls: *u8 = rt::get_class(#str_ptr("NSAnimationContext\0"));
    if cls == (0 as *u8) { return; }
    ANIM_HELD = ANIM_HELD - (1 as i64);
    { rt::msg_void(cls, rt::sel(#str_ptr("endGrouping\0"))) };
    return;
}

// For the suite: a grouping opened here must always be closed, whichever
// notification pair ran.
fn held_row_animations() -> i64 { return ANIM_HELD; }

fn tree_will_expand_imp(self_obj: *u8, cmd: *u8, note: *u8) {
    hold_row_animation();
    return;
}

fn tree_will_collapse_imp(self_obj: *u8, cmd: *u8, note: *u8) {
    hold_row_animation();
    return;
}

fn tree_did_expand_imp(self_obj: *u8, cmd: *u8, note: *u8) {
    // The write-back, and any reload it causes, happen INSIDE the grouping —
    // so a reload triggered by the width change an expansion brings on (the
    // scroller appearing narrows the column) cannot animate either.
    tree_expansion_changed(note, true);
    release_row_animation();
    return;
}

fn tree_did_collapse_imp(self_obj: *u8, cmd: *u8, note: *u8) {
    tree_expansion_changed(note, false);
    release_row_animation();
    return;
}

fn tree_selection_changed_imp(self_obj: *u8, cmd: *u8, note: *u8) {
    let ov: *u8 = { rt::msg_id(note, rt::sel(#str_ptr("object\0"))) };
    if ov == (0 as *u8) { return; }
    let s: *TreeSource = tree_source_of(ov);
    if s == (0 as *TreeSource) { return; }
    if tree_debug_on() {
        let row: i64 = { rt::msg_i64(ov, rt::sel(#str_ptr("selectedRow\0"))) };
        var sync: i64 = 0 as i64;
        if { (*s).syncing } { sync = 1 as i64; }
        let n: i64 = TREE_RELOADS;
        io::eprintln("tree selection-changed: row=${row} syncing=${sync} reloads=${n}");
    }
    // STAND DOWN WHILE FACET IS APPLYING, the same guard the expansion
    // write-back has had. `reloadData` CLEARS the selection, and AppKit reports
    // that clear like any other — so the reload's own side effect was writing
    // `selected = ""` into the model, destroying the very record needed to put
    // the selection back. `select_by_id` then restored nothing, and the user
    // lost the highlight to a reload they did not cause.
    if { (*s).syncing } { return; }
    let n: *core::Node = { (*s).node };
    let p: *tree::TreeProps = tree_props_of(n);
    if p == (0 as *tree::TreeProps) { return; }
    let row: i64 = { rt::msg_i64(ov, rt::sel(#str_ptr("selectedRow\0"))) };
    if row >= (0 as i64) {
        let item: *u8 = { rt::msg_id_i64(ov, rt::sel(#str_ptr("itemAtRow:\0")), row) };
        let tn: *tree::TreeNode = unbox_item(item);
        if tn != (0 as *tree::TreeNode) {
            { (*p).selected = text::from_str({ (*tn).id.view() }) };
        }
    } else {
        { (*p).selected = text::new() };
    }
    // A tree's handler takes the TREE NODE, not a native sender: a row here is
    // a model item, and the item is what the application asked about.
    let h: fn(*tree::TreeNode, *u8) = { (*p).on_select };
    if h == tree::no_select { return; }
    if row < (0 as i64) { return; }
    let item: *u8 = { rt::msg_id_i64(ov, rt::sel(#str_ptr("itemAtRow:\0")), row) };
    let tn: *tree::TreeNode = unbox_item(item);
    if tn == (0 as *tree::TreeNode) { return; }
    h(tn, { (*p).on_select_ctx });
    return;
}

// A write to `selected` moves the outline's selection to the row with that
// identity — the read-back's mirror image, and the reason identity has to
// survive a model rebuild.
fn select_by_id(ov: *u8, want: str) {
    if want == "" {
        { rt::msg_void(ov, rt::sel(#str_ptr("deselectAll:\0"))) };
        return;
    }
    let rows: i64 = { rt::msg_i64(ov, rt::sel(#str_ptr("numberOfRows\0"))) };
    var i: i64 = 0 as i64;
    while i < rows {
        let item: *u8 = { rt::msg_id_i64(ov, rt::sel(#str_ptr("itemAtRow:\0")), i) };
        let tn: *tree::TreeNode = unbox_item(item);
        if tn != (0 as *tree::TreeNode) {
            if { (*tn).id.view() } == want {
                let idx: *u8 = { rt::msg_id_u64(rt::get_class(#str_ptr("NSIndexSet\0")),
                                                rt::sel(#str_ptr("indexSetWithIndex:\0")), i as u64) };
                { rt::msg_void_id_i8(ov, rt::sel(#str_ptr("selectRowIndexes:byExtendingSelection:\0")),
                                     idx, false as i8) };
                return;
            }
        }
        i = i + (1 as i64);
    }
    return;
}

fn create_recycling_tree(n: *core::Node) -> *u8 {
    let scroll: ak::ScrollView = akx::new_scroll_view(
        rt::Rect { x: 0.0f64, y: 0.0f64, w: 0.0f64, h: 0.0f64 }, false);
    let ov: *u8 = { rt::alloc_init(#str_ptr("NSOutlineView\0")) };
    if ov == (0 as *u8) { return rt::retain(scroll.as_view().raw()); }

    let col: *u8 = { rt::msg_id(rt::get_class(#str_ptr("NSTableColumn\0")),
                                rt::sel(#str_ptr("alloc\0"))) };
    let col2: *u8 = { rt::msg_id_id(col, rt::sel(#str_ptr("initWithIdentifier:\0")),
                                    bridge::nsstring("facet.col")) };
    if col2 != (0 as *u8) {
        { rt::msg_void_id(ov, rt::sel(#str_ptr("addTableColumn:\0")), col2) };
        // The outline column is the one that carries the disclosure triangles.
        { rt::msg_void_id(ov, rt::sel(#str_ptr("setOutlineTableColumn:\0")), col2) };
        rt::release(col2);
    }
    { rt::msg_void_id(ov, rt::sel(#str_ptr("setHeaderView:\0")), 0 as *u8) };
    { rt::msg_void_i64(ov, rt::sel(#str_ptr("setColumnAutoresizingStyle:\0")), 1 as i64) };
    // INTERCELL SPACING IS ZERO, and it is not a detail. AppKit's default is
    // {3, 2}: three points of HORIZONTAL inset, so the cell a row is drawn into
    // is narrower than the column that `column_width` reports. Laying the row
    // out at the column's width then draws it wider than the cell it sits in,
    // and the right edge of a card is what falls off. `facet_appkit.old` zeroed
    // it (`set_intercell_spacing({0,0})`) and the new backend did not carry it
    // across.
    { rt::msg_void_size(ov, rt::sel(#str_ptr("setIntercellSpacing:\0")),
                        rt::Size { w: 0.0f64, h: 0.0f64 }) };

    // AUTOMATIC (0), deliberately — an explicit style tiles at create and
    // builds every row for the height pass. The list's comment has the story.
    { rt::msg_void_i64(ov, rt::sel(#str_ptr("setStyle:\0")), 0 as i64) };   // NSTableViewStyleAutomatic
    // Default band when the model has not stated row_height yet; heightOfRow
    // overrides per item. Keeps the disclosure geometry on a known band.
    { rt::msg_void_f64(ov, rt::sel(#str_ptr("setRowHeight:\0")),
                       controls::DEFAULT_TREE_ROW_H) };

    let agent: *u8 = synth::alloc_init_class(tree_agent_class());
    if agent != (0 as *u8) {
        { rt::msg_void_id(ov, rt::sel(#str_ptr("setDataSource:\0")), agent) };
        { rt::msg_void_id(ov, rt::sel(#str_ptr("setDelegate:\0")), agent) };
        synth::retain_associated(ov, tree_agent_pin_key(), agent);
        rt::release(agent);
    }
    scroll.set_document_view(ak::View::from_raw(ov));
    rt::release(ov);
    return rt::retain(scroll.as_view().raw());
}

fn apply_recycling_tree(v: *u8, n: *core::Node, dirty: u64) {
    let ov: *u8 = table_of(v);
    if ov == (0 as *u8) { return; }
    var s: *TreeSource = tree_source_of(ov);
    if s == (0 as *TreeSource) {
        match box::new::[TreeSource](TreeSource { node: n, outline: ov,
                                                 last_width: 0.0f64,
                                                 in_delegate: false,
                                                 expanded_by_user: false,
                                                 syncing: false }) {
            option::Option[box::Box[TreeSource]]::Some(b) => {
                s = { b.into_raw() } as *TreeSource;
                synth::set_associated(ov, tree_source_key(), s as *u8);
                // The resize pass, the same one the list has had. Observed once,
                // for the life of the outline view.
                let _obs: u64 = akx::observe_frame(ak::View::from_raw(ov),
                                                   on_tree_resized, s as *u8);
            }
            option::Option[box::Box[TreeSource]]::None => { return; }
        }
    }
    { (*s).node = n };
    // The model, the builder and the expansion set all change WHICH rows exist,
    // so any of them reloads. An outline view keeps its own expansion state, so
    // the reload is followed by re-applying facet's — the model is facet's.
    if tree_debug_on() {
        let d: u64 = dirty;
        io::eprintln("tree apply: dirty=${d}");
        tree_trace(ov, "apply:enter");
    }
    // A NEW ROOT IS A NEW MODEL. The boxes name node addresses in the old one,
    // so they are dropped before the reload that will ask for fresh ones —
    // otherwise the map grows for the life of the view and hands AppKit an item
    // for a node that no longer exists.
    if (dirty & tree::P_ROOT) != (0 as u64) { forget_items(ov); }
    var reload: bool = (dirty & (tree::P_ROOT | tree::P_ROW)) != (0 as u64);
    if (dirty & tree::P_EXPANDED) != (0 as u64) {
        // AN EXPANSION THE USER PERFORMED IS ALREADY APPLIED. AppKit expanded
        // the item and then told us, and the write-back that records it dirties
        // `P_EXPANDED` exactly like an application calling `expand()` would.
        // Reloading on it re-vends every row, which takes the SELECTION with
        // them: press right-arrow to open a folder and the highlight vanishes
        // and the tree stops answering the keyboard. Nothing to apply — the
        // outline view is already in the state the model now describes.
        if { (*s).expanded_by_user } { { (*s).expanded_by_user = false }; }
        else { reload = true; }
    }
    if reload {
        reload_tree_keeping_selection(s, ov);
        tree_trace(ov, "apply:after-reload");
    }
    // After the rows exist, or there is nothing to find the identity among.
    if (dirty & (tree::P_SELECTED | tree::P_ROOT)) != (0 as u64) {
        let p: *tree::TreeProps = tree_props_of(n);
        if p != (0 as *tree::TreeProps) { select_by_id(ov, { (*p).selected.view() }); }
    }
    return;
}

// A TREE RE-PLACES ITS ROWS WHEN ITS WIDTH CHANGES, exactly as a list does.
//
// It had no resize path at all, which is why the crush showed up here and not
// in the Saves timeline: not "the timeline reloads more often", but "the list
// has a width path and the tree had none". `autoresize_subtree` was standing in
// as the only tracking, and a spring cannot recover from zero — a subtree
// squeezed to ~zero has no proportion left to grow back by.
//
// `place_row` recomputes from the flex tree and keeps no memory of a crushed
// frame, so ANY re-place heals one.
//
// SYNCHRONOUS, NOT DEFERRED TO THE TICK — and that is the whole difference from
// the list, which defers. A tree's data source DEREFERENCES ITS FACET NODE
// (`tree_props_of((*s).node)` answers every `numberOfChildrenOfItem:`), while a
// list's only reads a count off the source. So a tree reload queued for a later
// tick can run after that node is gone, and AppKit walks the model straight
// into freed memory:
//
//     recycler.tree_props_of
//     -[NSOutlineView _expandItemEntry:expandChildren:startLevel:]
//     -[NSOutlineView _uncachedNumberOfRows]
//     -[NSOutlineView reloadData]
//
// Running it here, inside the frame-change notification, the view is live and
// so is the node that owns it. `layout_enclosing_scroll` is what makes that
// safe to do early: it forces AppKit's deferred column tiling NOW, so the width
// read on this line is the one the outline view really has, and the reason the
// list needed the tick does not apply.
//
// Coalescing is `last_width` alone: many notifications, one reload per width
// the tree has actually been given.
// RELOAD THE TREE WITHOUT LOSING THE USER'S ROW.
//
// `reloadData` clears the selection, and AppKit reports that clear like any
// other selection change — so without the `syncing` bracket the write-back
// writes `selected = ""` into the model, destroying the record needed to put it
// back. Both callers reload for reasons the user did not ask for (a width
// change, a new root), so neither should cost them the row they were on.
//
// This existed only on the apply path. The RESIZE path reloaded bare, which is
// why the first expand of a session lost the highlight and later ones did not:
// expanding changes the row count, the scroll view re-tiles, the frame
// notification fires, and that first width comparison is against a `last_width`
// still at its initial 0 — so it reads as a change and reloads. The second
// expand compares equal and never reloads at all.
// NOT DIRECTLY TESTABLE HEADLESSLY, and worth saying so where it lives: a
// windowless NSOutlineView does not clear its selection on `reloadData` at all,
// so a test that reloads and checks the selection survived passes whether the
// bracket below is here or not (measured — it fooled me once). The guard it
// depends on IS pinned, by
// `the_selection_write_back_stands_down_while_facet_is_applying`, which poses
// the clear-and-report directly instead of hoping AppKit performs it.
fn reload_tree_keeping_selection(s: *TreeSource, ov: *u8) {
    TREE_RELOADS = TREE_RELOADS + (1 as i64);
    { (*s).expanded_by_user = false };
    let pn: *tree::TreeProps = tree_props_of({ (*s).node });
    var keep: text::Text = text::new();
    if pn != (0 as *tree::TreeProps) { keep = text::from_str({ (*pn).selected.view() }); }
    // WITHOUT IMPLICIT ANIMATION. A reload re-vends every visible row, and the
    // views it makes are layer-backed — so each one's first frame animates in
    // from wherever Core Animation thinks it was. Expanding a folder changes
    // the column width as a side effect (rows appear, the scroller re-tiles:
    // measured 466 -> 479), which reloads, which made the whole tree drift into
    // place. The second expand compares widths equal, never reloads, and was
    // always smooth — which is why this only ever showed the first time.
    without_implicit_animation_begin();
    { (*s).syncing = true };
    { rt::msg_void(ov, rt::sel(#str_ptr("reloadData\0"))) };
    { (*s).syncing = false };
    sync_expansion(ov);
    { (*s).syncing = true };
    select_by_id(ov, keep.view());
    { (*s).syncing = false };
    without_implicit_animation_end();
    tree_reload_trace(ov, keep.view());
    tree_trace(ov, "reload:done");
    return;
}

fn on_tree_resized(ctx: *u8) {
    let s: *TreeSource = { ctx as *TreeSource };
    if s == (0 as *TreeSource) { return; }
    let ov: *u8 = { (*s).outline };
    if ov == (0 as *u8) { return; }
    // NOT FROM INSIDE THE TABLE'S OWN DELEGATE. AppKit resizes its columns
    // while vending and measuring rows, so this notification arrives DURING a
    // callback we are already in — and `layoutSubtreeIfNeeded` + `reloadData`
    // there re-enter the table, which AppKit warns about and which draws rows
    // twice and stutters the expand that triggered it.
    //
    // Skipping is correct, not merely safe: the table is laying out at the
    // width in question right now, and every row it vends in this pass is
    // already being placed at it. Nothing is owed.
    if { (*s).in_delegate } { return; }
    layout_enclosing_scroll(ov);
    let w: f64 = column_width(ov);
    // A height change moves the viewport, not the rows — nothing re-wraps.
    if w == { (*s).last_width } { return; }
    // First observation: record the width, do not treat it as a change. The
    // rows in hand were vended at it.
    let first: bool = { (*s).last_width } <= 0.0f64;
    { (*s).last_width = w };
    if first { return; }
    // A WIDTH CHANGE IS NOT A RELOAD.
    //
    // It used to be one, because nothing else re-laid a materialized row out at
    // a new width. `FacetRowCell` does now: AppKit resizes the cells when it
    // tiles the column, and each one re-runs flex from its own resize hook,
    // synchronously, in that same pass. By the time this notification arrives
    // every visible row has already been placed at `w`.
    //
    // Reloading anyway cost the user their selection. `reloadData` invalidates
    // the outline view's rows, and until it rebuilds them — which it defers to
    // the next display — `selectedRow` is -1 and no highlight is drawn. Traced
    // in a live window, one divider drag: 98 reloads, each one restoring the
    // selection and each one having it dropped again before the next vend, with
    // AppKit never reporting a selection change at all. Drag one way, let go
    // while the tree is in that state, and the blue row is simply gone until
    // something else reloads it back.
    //
    // HEIGHTS ARE THE EXCEPTION, and only when the application did not state
    // one: a measured row can re-wrap at a new width and be a different height.
    // `noteHeightOfRowsWithIndexesChanged:` re-asks for those without
    // discarding a single row — the selection, the expansion and the vended
    // cells all survive it.
    let p: *tree::TreeProps = props_for(ov);
    if stated_tree_row_height(p) >= 1.0f64 { return; }
    let rows: i64 = { rt::msg_i64(ov, rt::sel(#str_ptr("numberOfRows\0"))) };
    if rows <= (0 as i64) { return; }
    let all: *u8 = { msg_id_range(rt::get_class(#str_ptr("NSIndexSet\0")),
                                  rt::sel(#str_ptr("indexSetWithIndexesInRange:\0")),
                                  rt::Range { location: 0 as u64, length: rows as u64 }) };
    if all == (0 as *u8) { return; }
    { (*s).syncing = true };
    { rt::msg_void_id(ov, rt::sel(#str_ptr("noteHeightOfRowsWithIndexesChanged:\0")), all) };
    { (*s).syncing = false };
    return;
}

#[link_name = "objc_msgSend"]
extern fn msg_id_range(recv: *u8, sel: *u8, r: rt::Range) -> *u8;

// facet's expanded set is the model; AppKit's per-item state follows it.
// Walked from the root, because expanding a node only matters once its parent
// is expanded — an outline view has no rows for a closed branch to expand.
fn sync_expansion(ov: *u8) {
    let p: *tree::TreeProps = props_for(ov);
    if p == (0 as *tree::TreeProps) { return; }
    // Applying the model, so the write-back stands down for the duration.
    let s: *TreeSource = tree_source_of(ov);
    if s != (0 as *TreeSource) { { (*s).syncing = true }; }
    expand_walk(ov, p, { #addr_of((*p).root) }, true);
    if s != (0 as *TreeSource) { { (*s).syncing = false }; }
    return;
}

fn expand_walk(ov: *u8, p: *tree::TreeProps, n: *tree::TreeNode, is_root: bool) {
    if n == (0 as *tree::TreeNode) { return; }
    if !is_root {
        if controls::is_expanded(p, n) {
            { rt::msg_void_id(ov, rt::sel(#str_ptr("expandItem:\0")), find_item(ov, n)) };
        } else {
            return;   // a closed branch has no rows to expand below it
        }
    }
    var i: usize = 0 as usize;
    let count: usize = { (*n).child_count() };
    while i < count {
        match { (*n).child_ptr(i) } {
            option::Option[*tree::TreeNode]::Some(c) => { expand_walk(ov, p, c, false); }
            option::Option[*tree::TreeNode]::None => { }
        }
        i = i +% (1 as usize);
    }
    return;
}

// The outline view's OWN box for a node. Boxing afresh would hand it an item it
// has never seen, so the row it belongs to is asked for instead — `rowForItem:`
// answers -1 for anything not currently in the view, which is the case a closed
// ancestor produces.
fn find_item(ov: *u8, n: *tree::TreeNode) -> *u8 {
    let count: i64 = { rt::msg_i64(ov, rt::sel(#str_ptr("numberOfRows\0"))) };
    var i: i64 = 0 as i64;
    while i < count {
        let it: *u8 = { rt::msg_id_i64(ov, rt::sel(#str_ptr("itemAtRow:\0")), i) };
        if unbox_item(it) == n { return it; }
        i = i + (1 as i64);
    }
    return 0 as *u8;
}

// The box the data source answers for root child `i` — the suite's way to ask
// whether an outline view recognises its own items, which needs no drag and no
// window.
fn tree_child_of_root(v: *u8, i: i64) -> *u8 {
    let ov: *u8 = table_of(v);
    if ov == (0 as *u8) { return 0 as *u8; }
    return tree_child_imp(0 as *u8, 0 as *u8, ov, i, 0 as *u8);
}

// Fill an EXISTING cell with another item — the tree's `fill_into`, which the
// suite needs because a headless outline view never offers a cell back.
fn tree_fill_into(v: *u8, cell: *u8, row: i64) {
    let ov: *u8 = table_of(v);
    if ov == (0 as *u8) { return; }
    let item: *u8 = { rt::msg_id_i64(ov, rt::sel(#str_ptr("itemAtRow:\0")), row) };
    if item == (0 as *u8) { return; }
    let p: *tree::TreeProps = props_for(ov);
    if p == (0 as *tree::TreeProps) { return; }
    let n: *tree::TreeNode = unbox_item(item);
    if n == (0 as *tree::TreeNode) { return; }
    let existing: *core::Node = { synth::get_associated(cell, cell_node_key()) as *core::Node };
    if existing != (0 as *core::Node) && tree_has_bind(p) {
        tree_bind_into(p, n, existing);
        mount::sync_from(existing);
        let _h: f64 = place_row(cell, existing, column_width(ov),
                                outline_default_row_height(ov),
                                row_h: stated_tree_row_height(p));
    }
    tag_tree_row(ov, item, cell);
    return;
}

// The agent's press, sent the way agent_appkit sends it.
fn perform_click_on(cell: *u8) {
    if cell == (0 as *u8) { return; }
    { rt::msg_void_id(cell, rt::sel(#str_ptr("performClick:\0")), 0 as *u8) };
    return;
}

fn tree_selected_row_of(v: *u8) -> i64 {
    let ov: *u8 = table_of(v);
    if ov == (0 as *u8) { return -1 as i64; }
    return { rt::msg_i64(ov, rt::sel(#str_ptr("selectedRow\0"))) };
}

fn tree_rows_of(v: *u8) -> i64 {
    let ov: *u8 = table_of(v);
    if ov == (0 as *u8) { return 0 as i64; }
    return { rt::msg_i64(ov, rt::sel(#str_ptr("numberOfRows\0"))) };
}

// How many rows the outline view is showing — the suite's window into a tree
// it cannot click.
// What the outline view would use for a row's height — the delegate path, for
// tests that need the number rather than the rendered result.
fn tree_row_height_of(v: *u8, row: i64) -> f64 {
    let ov: *u8 = table_of(v);
    if ov == (0 as *u8) { return 0.0f64; }
    let item: *u8 = { rt::msg_id_i64(ov, rt::sel(#str_ptr("itemAtRow:\0")), row) };
    if item == (0 as *u8) { return 0.0f64; }
    return tree_height_imp(0 as *u8, 0 as *u8, ov, item);
}

fn tree_row_count_of(v: *u8) -> i64 {
    let ov: *u8 = table_of(v);
    if ov == (0 as *u8) { return 0 as i64; }
    return { rt::msg_i64(ov, rt::sel(#str_ptr("numberOfRows\0"))) };
}

// The cell for a row index, the way the outline view asks for one — the suite's
// way in, since it cannot scroll.
fn tree_view_for_row(v: *u8, row: i64) -> *u8 {
    let ov: *u8 = table_of(v);
    if ov == (0 as *u8) { return 0 as *u8; }
    let item: *u8 = { rt::msg_id_i64(ov, rt::sel(#str_ptr("itemAtRow:\0")), row) };
    if item == (0 as *u8) { return 0 as *u8; }
    return tree_view_for_item_imp(0 as *u8, 0 as *u8, ov, 0 as *u8, item);
}

// Drive the resize pass at a given column width. The suite's way in: it has no
// window to drag, and the pass is about what happens BETWEEN frames.
fn resize_to(v: *u8, w: f64) {
    let tv: *u8 = table_of(v);
    if tv == (0 as *u8) { return; }
    let s: *RowSource = source_of(tv);
    if s == (0 as *RowSource) { return; }
    let cols: *u8 = { rt::msg_id(tv, rt::sel(#str_ptr("tableColumns\0"))) };
    if cols != (0 as *u8) {
        let n: u64 = { rt::msg_u64(cols, rt::sel(#str_ptr("count\0"))) };
        if n > (0 as u64) {
            let c0: *u8 = { rt::msg_id_u64(cols, rt::sel(#str_ptr("objectAtIndex:\0")), 0 as u64) };
            if c0 != (0 as *u8) {
                { rt::msg_void_f64(c0, rt::sel(#str_ptr("setWidth:\0")), w) };
            }
        }
    }
    on_table_resized(s as *u8);
    return;
}
