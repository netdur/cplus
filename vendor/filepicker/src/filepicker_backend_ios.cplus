// UIDocumentPickerViewController. iOS only.
//
// ---- a delegate, not a block ------------------------------------------------
//
// UIKit's picker answers through `UIDocumentPickerDelegate`, so this
// synthesises one — the same arrangement `camera` uses for its photo delegate.
// There are TWO methods and both must be implemented: a picker that only
// answers `didPickDocumentsAtURLs:` leaves the caller's handler hanging
// forever when the person taps Cancel, because `documentPickerWasCancelled:`
// is where that arrives.
//
// ---- the URL is security-scoped ---------------------------------------------
//
// A file chosen outside the app's container comes back with a scoped URL, and
// reading it without `startAccessingSecurityScopedResource` fails with a
// permission error that names nothing useful. The facade hands back a plain
// path, so this package's contract is "the path is valid for the dispatch" —
// an app that wants to keep it needs a bookmark, which is a different feature.

import "stdlib/option" as option;
import "stdlib/box" as box;
import "objc/runtime" as rt;
import "objc/bridge" as bridge;
import "objc/synthesis" as synth;
import "./filepicker" as fp;

#[link_name = "objc_msgSend"]
extern fn _msg_present(recv: *u8, sel: *u8, a: *u8, b: i8, c: *u8);

#[link_name = "strlen"]
extern fn _strlen(s: *u8) -> usize;

struct _Pending {
    on_pick: fn(*u8, usize, *u8),
    opaque ctx: *u8,
}

static _SESSION_KEY: u8 = 0 as u8;
static _DELEGATE_CLASS: *u8 = 0 as *u8;

fn _root_controller() -> *u8 {
    let app: *u8 = rt::msg_id(rt::get_class(#str_ptr("UIApplication\0")),
                              rt::sel(#str_ptr("sharedApplication\0")));
    if app.is_null() { return 0 as *u8; }
    let wins: *u8 = rt::msg_id(app, rt::sel(#str_ptr("windows\0")));
    if wins.is_null() { return 0 as *u8; }
    let n: i64 = rt::msg_i64(wins, rt::sel(#str_ptr("count\0")));
    var i: i64 = 0 as i64;
    while i < n {
        let w: *u8 = rt::msg_id_i64(wins, rt::sel(#str_ptr("objectAtIndex:\0")), i);
        if w.is_not_null() {
            if rt::msg_i8(w, rt::sel(#str_ptr("isKeyWindow\0"))) != (0 as i8) {
                let c: *u8 = rt::msg_id(w, rt::sel(#str_ptr("rootViewController\0")));
                if c.is_not_null() { return c; }
            }
        }
        i = i + (1 as i64);
    }
    return 0 as *u8;
}

fn _answer(self_obj: *u8, urls: *u8) {
    let raw: *u8 = synth::get_associated(self_obj, #addr_of(_SESSION_KEY));
    if raw.is_null() { return; }
    let p: *_Pending = raw as *_Pending;
    let f: fn(*u8, usize, *u8) = { (*p).on_pick };
    if f.is_null() { return; }

    var buf: [u8; 1024] = #zero::[[u8; 1024]]();
    var out_ptr: *u8 = 0 as *u8;
    var out_len: usize = 0 as usize;

    if urls.is_not_null() {
        let n: i64 = rt::msg_i64(urls, rt::sel(#str_ptr("count\0")));
        if n > (0 as i64) {
            let url: *u8 = rt::msg_id_i64(urls, rt::sel(#str_ptr("objectAtIndex:\0")),
                                          0 as i64);
            if url.is_not_null() {
                let s: *u8 = rt::msg_id(url, rt::sel(#str_ptr("path\0")));
                if s.is_not_null() {
                    let c: *u8 = rt::msg_id(s, rt::sel(#str_ptr("UTF8String\0")));
                    if c.is_not_null() {
                        let len: usize = { _strlen(c) };
                        var i: usize = 0 as usize;
                        while i < len && i < (1023 as usize) {
                            buf[i] = { *({ c + i }) };
                            i = i + (1 as usize);
                        }
                        out_ptr = { #addr_of(buf) as *u8 };
                        out_len = i;
                    }
                }
            }
        }
    }
    f(out_ptr, out_len, { (*p).ctx });
    return;
}

fn _imp_picked(self_obj: *u8, cmd: *u8, controller: *u8, urls: *u8) {
    _answer(self_obj, urls);
    return;
}

// CANCEL IS AN ANSWER, and a picker that does not implement this leaves the
// caller's handler waiting forever.
fn _imp_cancelled(self_obj: *u8, cmd: *u8, controller: *u8) {
    _answer(self_obj, 0 as *u8);
    return;
}

fn _delegate_class() -> *u8 {
    if _DELEGATE_CLASS.is_not_null() { return _DELEGATE_CLASS; }
    let sup: *u8 = rt::get_class(#str_ptr("NSObject\0"));
    if sup.is_null() { return 0 as *u8; }
    let cls: *u8 = synth::allocate_class_pair(sup, #str_ptr("CplusFilePickerDelegate\0"),
                                              0 as usize);
    if cls.is_null() { return 0 as *u8; }
    let _ = synth::conform(cls, #str_ptr("UIDocumentPickerDelegate\0"));
    let _ = synth::add_method_v_2id(cls,
        rt::sel(#str_ptr("documentPicker:didPickDocumentsAtURLs:\0")),
        _imp_picked, #str_ptr("v@:@@\0"));
    let _ = synth::add_method_v_1id(cls,
        rt::sel(#str_ptr("documentPickerWasCancelled:\0")),
        _imp_cancelled, #str_ptr("v@:@\0"));
    synth::register_class_pair(cls);
    _DELEGATE_CLASS = cls;
    return cls;
}

fn _present(vc: *u8, on_pick: fn(*u8, usize, *u8), ctx: *u8) -> i32 {
    let root: *u8 = _root_controller();
    if root.is_null() { return 2; }

    let dcls: *u8 = _delegate_class();
    if dcls.is_null() { return 1; }
    let d: *u8 = rt::msg_id(rt::msg_id(dcls, rt::sel(#str_ptr("alloc\0"))),
                            rt::sel(#str_ptr("init\0")));
    if d.is_null() { return 4; }

    var blank: _Pending = _Pending { on_pick: on_pick, ctx: ctx };
    var p: *_Pending = match box::new::[_Pending](blank) {
        option::Option[box::Box[_Pending]]::Some(b) => { b.into_raw() as *_Pending },
        option::Option[box::Box[_Pending]]::None => { 0 as *_Pending },
    };
    if p.is_null() { return 4; }
    synth::set_associated(d, #addr_of(_SESSION_KEY), p as *u8);
    // RETAINED BY THE ASSOCIATION. UIKit holds its delegate weakly, so nothing
    // else here owns it and a released one is a picker that answers nobody.
    rt::msg_void_id(vc, rt::sel(#str_ptr("setDelegate:\0")), d);

    { _msg_present(root, rt::sel(#str_ptr("presentViewController:animated:completion:\0")),
                   vc, 1 as i8, 0 as *u8) };
    return 0;
}

export extern fn _c_available() -> i32 {
    if rt::get_class(#str_ptr("UIDocumentPickerViewController\0")).is_null() { return 0; }
    if _root_controller().is_null() { return 0; }
    return 1;
}

export extern fn _c_open(on_pick: fn(*u8, usize, *u8), ctx: *u8,
                         types: *u8, types_len: usize) -> i32 {
    let cls: *u8 = rt::get_class(#str_ptr("UIDocumentPickerViewController\0"));
    if cls.is_null() { return 1; }

    // `public.item` — everything. Filtering by extension would mean building
    // UTType objects from three letters, which is a guess for anything
    // unusual; the facade's `types` is honoured on macOS and Android and
    // ignored here rather than approximated.
    let ut: *u8 = bridge::nsstring("public.item");
    let arr: *u8 = rt::msg_id_id(rt::get_class(#str_ptr("NSArray\0")),
                                 rt::sel(#str_ptr("arrayWithObject:\0")), ut);
    if arr.is_null() { return 4; }

    // AS A COPY: the alternative hands back a URL into another app's container
    // that stops working the moment that app is suspended.
    let vc: *u8 = rt::msg_id_id_i8(rt::msg_id(cls, rt::sel(#str_ptr("alloc\0"))),
        rt::sel(#str_ptr("initWithDocumentTypes:inMode:\0")), arr, 1 as i8);
    if vc.is_null() { return 4; }
    return _present(vc, on_pick, ctx);
}

// NOT A SAVE PANEL. iOS has no "choose where to write" picker — the shape is
// `initForExportingURLs:`, which takes a file that ALREADY EXISTS and asks
// where to copy it. An app wanting the macOS flow writes to its own container
// first and exports that.
export extern fn _c_save(suggested: *u8, suggested_len: usize,
                         on_pick: fn(*u8, usize, *u8), ctx: *u8) -> i32 {
    return 1;
}
