// app_dirs — where this app keeps its files: its private DATA directory and
// its CACHE directory, created on first ask (spendwise S42). MAUI's
// FileSystem.AppDataDirectory and FileSystem.CacheDirectory.
//
// THE NEUTRAL BASE: a platform with no override has no answer, said once per
// call rather than resolved to some other platform's path. Each platform
// shadows this file (`app_dirs_<platform>.cplus`), and the runtime facades
// re-export the two calls as `runtime::app_data_dir()` / `runtime::cache_dir()`.

import "stdlib/option" as option;
import "stdlib/text" as text;
import "stdlib/io" as io;

fn data_dir() -> option::Option[text::Text] {
    io::eprintln("facet runtime: app_data_dir has no answer on this platform");
    return option::Option[text::Text]::None;
}

fn cache_dir() -> option::Option[text::Text] {
    io::eprintln("facet runtime: cache_dir has no answer on this platform");
    return option::Option[text::Text]::None;
}
