// app_dirs on Linux: the XDG base directories, $XDG_DATA_HOME/<name> (else
// ~/.local/share/<name>) and $XDG_CACHE_HOME/<name> (else ~/.cache/<name>),
// created. <name> is what the app gave `App::new`. See app_dirs.cplus.

import "stdlib/option" as option;
import "stdlib/text" as text;
import "stdlib/env" as env;
import "stdlib/fs" as fs;
import "stdlib/result" as result;
import "facet/application" as app;

fn data_dir() -> option::Option[text::Text] { return xdg("XDG_DATA_HOME", ".local/share"); }
fn cache_dir() -> option::Option[text::Text] { return xdg("XDG_CACHE_HOME", ".cache"); }

fn xdg(var_name: str, under_home: str) -> option::Option[text::Text] {
    var base: text::Text = text::new();
    match env::var(var_name) {
        option::Option[text::Text]::Some(v) => { base = v; }
        option::Option[text::Text]::None => { }
    }
    if base.view() == "" {
        match env::var("HOME") {
            option::Option[text::Text]::Some(h) => { base = "${h.view()}/${under_home}"; }
            option::Option[text::Text]::None => { return option::Option[text::Text]::None; }
        }
    }
    let dir: text::Text = "${base.view()}/${app_name().view()}";
    match fs::create_dir_all(dir.view()) {
        result::Result[bool, result::IoError]::Ok(_) => { return option::Option[text::Text]::Some(dir); }
        result::Result[bool, result::IoError]::Err(_) => {
            if fs::is_dir(dir.view()) { return option::Option[text::Text]::Some(dir); }
            return option::Option[text::Text]::None;
        }
    }
}

fn app_name() -> text::Text {
    let a: *app::Application = app::current();
    if a.is_not_null() {
        let n: str = { (*a).name.view() };
        if n != "" { return text::from_str(n); }
    }
    return text::from_str("facet");
}
