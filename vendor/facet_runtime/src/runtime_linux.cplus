// facet runtime facade for Linux. `import "facet_runtime/runtime"` resolves
// HERE on a Linux target, through the resolver's platform override on the
// filename, and this file selects the GTK 4 backend. macOS resolves to
// runtime_macos.cplus the same way; a target with neither lands on the neutral
// base runtime.cplus, which renders nothing and says so — never some other
// platform's toolkit.
//
// This is one of the TWO files in facet that name a platform. Everything it
// does is forward: the surface below is runtime.cplus's, verb for verb, so an
// application type-checks identically on every target.
//
// WRITTEN BY COPYING THE MACOS FACADE, which is what the neutral base says to
// do — "porting facet to a new platform starts by copying a real facade, not
// this file: the shape of a real facade is one import line away from its
// backend package". Almost all of it survived that copy unchanged, because
// almost all of it is about facet's own tiers (App, routes, nav, screens,
// teardown) and not about a toolkit. What differs is named below, and it is
// only three things:
//
//   1. THE OBSERVERS. AppKit answers every lifecycle row with
//      NSNotificationCenter; a GTK window carries them as PROPERTIES, so each
//      one is a `notify::` connection on the window rather than a named
//      notification. That makes an observation per-WINDOW here — see the note
//      on each.
//
//   2. THERE IS NO ⌘Q SEAM. `-[NSApplication terminate:]` never returns to the
//      run loop, so the macOS facade has to intercept it and restart the quit
//      as an ordinary unwind. GTK has no such call: a quit IS closing the
//      windows, `close-request` runs on each, and the loop ends when the last
//      one goes. The ordinary unwind is the ONLY unwind, so there is nothing to
//      redirect and `app_should_terminate` has no counterpart.
//
//   3. `on_should_quit` therefore rides the window's own close. It is asked
//      through `should_close` on the primary window, which is the same question
//      at the same moment — and it is the one place this facade wires a hook
//      the macOS one wires somewhere else.
import "stdlib/option" as option;
import "stdlib/text" as text;
import "stdlib/vec" as vec;
import "stdlib/status" as status;
import "stdlib/box" as box;
import "stdlib/io" as io;
import "flex_layout/flex_layout" as flex;
import "facet/facet" as core;
import "facet/vocabulary" as vocab;
import "facet/component" as component;
import "facet/screen" as screen;
import "facet/services" as services;
import "facet/application" as app;
import "facet/mount" as mount;
import "facet/nav" as nav;
import "facet_gtk/facet_gtk" as backend;
import "facet_gtk/window" as host;
import "facet_gtk/dialogs" as dialogs;

type Node = flex::Node;
type Builder = flex::Builder;
type AppMenu = screen::AppMenu;
type MenuItem = screen::MenuItem;
type Chrome = screen::Chrome;
type ScreenBox = screen::ScreenBox;

// The window an application describes by hand, when it wants neither
// `run_component` nor `run_screen`. Identical to runtime.cplus's declaration.
interface Window {
    fn root(ref this) -> Node;
    fn title(this) -> str;
    fn width(this) -> f64;
    fn height(this) -> f64;
    fn bar(this) -> screen::Bar;
    fn is_maximizable(this) -> bool;
    fn is_minimizable(this) -> bool;
    fn max_width(this) -> f64;
    fn max_height(this) -> f64;
    fn min_width(this) -> f64;
    fn min_height(this) -> f64;
    fn wants_pinch_zoom(this) -> bool;
    fn min_zoom(this) -> f64;
    fn max_zoom(this) -> f64;
    fn has_app_menu(this) -> bool;
    fn app_menu(ref this) -> AppMenu;
    fn should_close_callback(this) -> fn(*u8) -> bool;
    fn will_close_callback(this) -> fn(*u8);
    fn lifecycle_context(this) -> *u8;
}

// `should_close`, `will_close` and `component_context` were required of every
// implementor and called by nothing — `run` uses the `_callback` pair, which
// is what a backend can actually store on a window. Three methods every
// hand-written Window had to write and none of them ran. Removed rather than
// wired: a redundant requirement is a tax, and the callback pair is the one
// with a consumer.

// Menu-token re-exports, so a facade import serves an app's menu block whole.
fn app_menu(title: str) -> AppMenu { return screen::app_menu(title); }
fn menu_action_none() -> u32 { return screen::menu_action_none(); }
fn menu_action_quit() -> u32 { return screen::menu_action_quit(); }
fn menu_action_close_window() -> u32 { return screen::menu_action_close_window(); }
fn menu_action_undo() -> u32 { return screen::menu_action_undo(); }
fn menu_action_redo() -> u32 { return screen::menu_action_redo(); }
fn menu_action_cut() -> u32 { return screen::menu_action_cut(); }
fn menu_action_copy() -> u32 { return screen::menu_action_copy(); }
fn menu_action_paste() -> u32 { return screen::menu_action_paste(); }
fn menu_action_select_all() -> u32 { return screen::menu_action_select_all(); }
fn menu_action_find() -> u32 { return screen::menu_action_find(); }
fn menu_action_find_next() -> u32 { return screen::menu_action_find_next(); }
fn menu_action_find_previous() -> u32 { return screen::menu_action_find_previous(); }
fn menu_action_find_replace() -> u32 { return screen::menu_action_find_replace(); }
fn null_enabled_fn() -> fn(*u8) -> bool { return screen::null_enabled_fn(); }
fn null_title_fn() -> fn(*u8) -> text::Text { return screen::null_title_fn(); }

// ---- the agent surface, for every host ---------------------------------------
//
// WHICH HOST AN APP IS ON IS NOT A REASON FOR ITS AGENT SURFACE TO DIFFER, and
// it used to be the whole reason: `agent_mcp` was a method on `App`, so the
// three blocking hosts — `run`, `run_component`, `run_screen` — had no way to
// ask for one at all. A scaffolded app is on `run_screen` (AGENTS.md prescribes
// it, because facet's Android facade does not implement `App::run`), so the
// generated shape was exactly the shape that could not serve. See plan.md.
//
// ONE STORAGE, at process scope, because that is what the thing being described
// actually is: one address, one accept loop, latched once by
// `facet_agent::serve_once`. `App::agent_mcp` writes here too.
//
// Setting it is not enough on its own — the app still calls
// `facet_agent::enable()` to fill the serving seam, exactly as the `App` tier
// has always required.
static AGENT_ID: text::Text = #zero::[text::Text]();

// Serve the agent surface under the name `id`. Call before the host, on any
// tier. AN ID, NOT AN ADDRESS: see the macOS facade for why, and
// `agent_mcp::uds_path` / `agent_mcp::loopback_port` for the conventions.
fn agent_mcp(id: str) {
    AGENT_ID = text::from_str(id);
    return;
}

// The name this process serves under, or "" if the app never asked.
fn agent_id() -> str { return AGENT_ID.view(); }

// Start the worker if an address was named. Called by every host, BEFORE the
// first window, so an agent that connects immediately waits on an empty surface
// for a moment rather than being refused by a socket that does not exist yet.
// `serve_once` latches, so a host that later opens more windows is a no-op
// after the first.
fn serve_agent_if_asked() {
    let id: str = AGENT_ID.view();
    if id != "" { app::agent_serve_once(id); }
    return;
}

// ---- the blocking hosts ------------------------------------------------------

fn chrome_of_window[W: Window](ref w: W) -> Chrome {
    return screen::Chrome::new(
        title: w.title(),
        width: w.width(),
        height: w.height(),
        min_width: w.min_width(),
        min_height: w.min_height(),
        bar: w.bar(),
        maximizable: w.is_maximizable(),
        minimizable: w.is_minimizable(),
        max_width: w.max_width(),
        max_height: w.max_height(),
        zoomable: w.wants_pinch_zoom(),
        min_zoom: w.min_zoom(),
        max_zoom: w.max_zoom(),
    );
}

fn run[W: Window](take window: W) {
    backend::install();
    serve_agent_if_asked();
    var owned_window: W = window;
    var root: Node = owned_window.root();
    // The menu this window declares. `has_app_menu` and `app_menu` were
    // required of every implementor and NEVER CALLED — `install_app_menu`
    // reached run_component, run_screen and App::run, and not this host — so a
    // hand-written Window answering `has_app_menu() == true` built its items
    // for nothing and opened with no menu bar.
    if owned_window.has_app_menu() {
        var m: AppMenu = owned_window.app_menu();
        host::install_app_menu(#addr_of(m));
    }
    let c: Chrome = chrome_of_window(owned_window);
    let _w: *u8 = host::open_window(
        #addr_of(root), c,
        should_close: owned_window.should_close_callback(),
        should_close_ctx: owned_window.lifecycle_context(),
        will_close: owned_window.will_close_callback(),
        will_close_ctx: owned_window.lifecycle_context(),
    );
    host::run_loop();
    settle_and_teardown(#addr_of(root));
    return;
}

fn default_should_close(ctx: *u8) -> bool { return true; }
fn default_will_close(ctx: *u8) { return; }

// Run a component that OWNS its own lifetime — no module static required.
//
// The runtime holds the instance in THIS frame, which outlives the loop (it
// blocks), so the component lives exactly as long as the window and its
// address is stable: handlers bound in `build(ref this)` point at it.
//
// Returns the component: the loop blocks until the window closes, so the value
// that comes back carries its FINAL field state, and a launcher can hand back
// what the user chose without a side channel.
//
// Lifecycle is the RUNTIME's job, fired at the seams:
//   on_attach after the mount, before the loop — the tree is live and `find`
//             resolves, so initial routing belongs there.
//   on_detach when the loop stops, before teardown — the views are still
//             alive. Best-effort by nature: an app terminated outright never
//             returns from the loop.
fn run_component[C: component::Component + component::Lifecycle](
    take component_v: C,
    title: str = "facet",
    width: f64 = 480.0f64,
    height: f64 = 360.0f64,
    // The zoom trio, forwarded like the other three. `run_component` built a
    // Chrome naming only title/width/height, so content magnification was
    // unreachable from the simple entry on BOTH platforms however well the
    // backend implemented it — an app had to adopt `screen::Screen` to ask for a
    // feature that has nothing to do with screens.
    zoomable: bool = false,
    min_zoom: f64 = 1.0f64,
    max_zoom: f64 = 4.0f64,
    take menu: AppMenu = screen::empty_app_menu(),
) -> C {
    backend::install();
    serve_agent_if_asked();
    var owned_menu: AppMenu = menu;
    host::install_app_menu(#addr_of(owned_menu));
    var owned: C = component_v;
    var root: Node = owned.build();
    let _w: *u8 = host::open_window(
        #addr_of(root),
        screen::Chrome::new(title: title, width: width, height: height,
                            zoomable: zoomable, min_zoom: min_zoom, max_zoom: max_zoom),
    );
    // nav::quit / nav::go can unwind this window too — the caller reads the
    // pending intent after the return, the way an App loop does.
    CURRENT_ROOT = #addr_of(root);
    nav::set_close_fn(close_current);
    owned.on_attach();
    host::run_loop();
    owned.on_detach();
    nav::set_close_fn(0 as fn());
    CURRENT_ROOT = 0 as *core::Node;
    settle_and_teardown(#addr_of(root));
    return owned;
}

// run_component with the window read from the SCREEN itself: it also conforms
// to `Screen`, so its `chrome()` supplies what the window parameters would.
fn run_screen[S: component::Component + component::Lifecycle + screen::Screen](
    take screen_v: S,
    take menu: AppMenu = screen::empty_app_menu(),
) -> S {
    backend::install();
    serve_agent_if_asked();
    var owned: S = screen_v;
    // The screen's own contribution, merged before the bar is installed. Same
    // rule App::run follows; a screen that declares menu items gets them
    // whichever host runs it.
    var owned_menu: AppMenu = menu;
    owned_menu.extend(owned.menu_items());
    host::install_app_menu(#addr_of(owned_menu));
    let c: Chrome = owned.chrome();
    var root: Node = owned.build();
    let _w: *u8 = host::open_window(#addr_of(root), c);
    CURRENT_ROOT = #addr_of(root);
    nav::set_close_fn(close_current);
    owned.on_attach();
    host::run_loop();
    owned.on_detach();
    nav::set_close_fn(0 as fn());
    CURRENT_ROOT = 0 as *core::Node;
    settle_and_teardown(#addr_of(root));
    return owned;
}

// The teardown contract, in one place because getting it wrong is a
// use-after-free inside a run-loop callback.
//
// `wait_for_jobs` covers only the WORKER half: it returns when no worker
// thread is inside a job. An apply already QUEUED on the main loop still holds
// the job's address and runs when the loop next turns. So the loop is drained
// until BOTH counters read zero — which is what `jobs_settled()` answers —
// before anything a job was given can drop.
fn settle_and_teardown(root: *core::Node) {
    services::wait_for_jobs();
    var spins: i64 = 0 as i64;
    while !services::jobs_settled() {
        drain_once();
        spins = spins +% (1 as i64);
        if spins > (100000 as i64) { break; }   // never wedge a teardown
    }
    return;
}

// One turn of the main loop, so a queued apply can land. The window is gone by
// now, so this is the only thing that moves the queue at all.
fn drain_once() {
    services::pump_async(0 as *u8);
    return;
}

// ---- modal verbs -------------------------------------------------------------

// A window-modal sheet, NON-BLOCKING: returns immediately and the answer
// arrives on `on_answer` with the 0-based index of the button clicked.
//
// It used to be an NSAlert and `runModal`, which was two problems at once. It
// BLOCKED — the caller did not return until the user answered — and it was not
// facet's, so nothing in it had a key and AN AGENT COULD NOT REACH IT. A dialog
// an agent cannot answer is a dialog an agent cannot get past.
//
// The sheet is an ordinary facet tree in an ordinary window now, so every part
// of it is addressable the way everything else is: `alert:title`,
// `alert:message`, `alert:primary`, `alert:secondary`.
//
// Window-modal, not application-modal: it blocks its PARENT, which is what an
// alert means to a person, while the rest of the app and the agent channel keep
// running.
fn alert(title: str, message: str, primary: str, secondary: str = "",
         on_answer: fn(i32, *u8) = 0 as fn(i32, *u8),
         on_answer_ctx: *u8 = 0 as *u8) {
    dialogs::alert_sheet(title, message, primary, secondary,
                         on_answer, on_answer_ctx);
    return;
}

// A CHOICE AMONG N. `alert` says yes or no; this says which. The sheet is a
// plain facet tree of buttons keyed `choose:opt:0..N`, so an agent picks one by
// name — which is the whole reason it is built rather than an NSAlert with
// buttons added, and the same reason `alert` is a sheet.
fn choose(title: str, message: str, take options: vec::Vec[text::Text],
          on_answer: fn(i32, *u8) = 0 as fn(i32, *u8),
          on_answer_ctx: *u8 = 0 as *u8) {
    dialogs::choose_sheet(title, message, options, on_answer, on_answer_ctx);
    return;
}

// A VALUE, typed. `on_typed` receives the text; `on_answer` receives 0 for the
// primary button and 1 for the secondary, so a caller can tell "typed nothing"
// from "cancelled". The field is a real facet text_field keyed `prompt:value`,
// so `set_text` reaches it exactly like any other.
fn prompt(title: str, message: str, placeholder: str = "", primary: str = "OK",
          secondary: str = "Cancel",
          on_typed: fn(str, *u8) = dialogs::no_typed,
          on_typed_ctx: *u8 = 0 as *u8,
          on_answer: fn(i32, *u8) = 0 as fn(i32, *u8),
          on_answer_ctx: *u8 = 0 as *u8) {
    dialogs::prompt_sheet(title, message, placeholder, primary, secondary,
                          on_typed, on_typed_ctx, on_answer, on_answer_ctx);
    return;
}

// The blocking NSAlert, kept for the one case a sheet cannot serve: a decision
// that must be made before the process can go on, with no window to attach to.
// An agent cannot reach it, which is why it is not the default.
fn alert_blocking(title: str, message: str, primary: str, secondary: str = "") -> i32 {
    return dialogs::alert(title, message, primary, secondary);
}

fn choose_directory() -> option::Option[text::Text] { return dialogs::choose_directory(); }
fn choose_file() -> option::Option[text::Text] { return dialogs::choose_file(); }

// ---- secondary windows -------------------------------------------------------

// Open a non-modal window alongside the running app. Returns immediately.
//
// The tree is MOVED to the heap: the window owns it for as long as it is open
// and it is freed when the window closes. That second half was the comment's
// claim and not the code's — `into_raw()` had no matching `from_raw` anywhere,
// so every presented window leaked its whole tree. `pushed_closed` does it for
// a pushed screen; `presented_closed` is the same courtesy here.
//
// An app that wants to keep addressing the tree uses `nav::push` or
// `set_content` instead, both of which keep an owner it can name.
fn present_window(take root: Node, title: str, width: f64, height: f64) {
    backend::install();
    match box::new::[Node](root) {
        option::Option[box::Box[Node]]::Some(b) => {
            let p: *Node = b.into_raw() as *Node;
            let w: *u8 = host::open_window(
                p, screen::Chrome::new(title: title, width: width, height: height),
                will_close: presented_closed, will_close_ctx: p as *u8,
            );
            // Same reason as a pushed screen: the agent follows the window an
            // application just put in front of the user.
            if w != (0 as *u8) { app::agent_attach(w); }
        }
        option::Option[box::Box[Node]]::None => { }
    }
    return;
}

// ---- window verbs ------------------------------------------------------------

fn window_close(sender: *u8) { dialogs::window_close(sender); return; }
fn window_minimize(sender: *u8) { dialogs::window_minimize(sender); return; }
fn window_zoom(sender: *u8) { dialogs::window_zoom(sender); return; }

// The window gaining or losing key status — the app-level focus/blur pair.
// Cancel through the returned handle, including by letting it drop, so hold it
// in a field or the observation dies immediately.
// BOTH RIDE ONE SIGNAL. A GTK window's `is-active` is a property, so there is
// one `notify::is-active` and the observer asks which way it went — where
// AppKit has a named notification per direction. A handler registered for the
// direction it did not get would fire on both, so the filter is here.
fn observe_window_active(cb: fn(*u8), ctx: *u8 = 0 as *u8) -> services::Cancellable {
    return services::Cancellable::of(host::observe_active(active_filter, cb as *u8),
                                     host::cancel_observe);
}

fn observe_window_inactive(cb: fn(*u8), ctx: *u8 = 0 as *u8) -> services::Cancellable {
    return services::Cancellable::of(host::observe_active(inactive_filter, cb as *u8),
                                     host::cancel_observe);
}

fn active_filter(cb: *u8) {
    if !is_window_active() { return; }
    let f: fn(*u8) = cb as fn(*u8);
    if f != (0 as fn(*u8)) { f(0 as *u8); }
    return;
}

fn inactive_filter(cb: *u8) {
    if is_window_active() { return; }
    let f: fn(*u8) = cb as fn(*u8);
    if f != (0 as fn(*u8)) { f(0 as *u8); }
    return;
}

// ---- the window tier's platform reads ----------------------------------------
// Window.DisplayDensity, Window.IsActivated and the process lifecycle. Each is
// a row the ledger deferred to this stage because none of them can be answered
// without a native window: facet's description does not know the backing scale
// or whether the app is frontmost, and inventing a value would be worse than
// having none.

// Window.DisplayDensity — points to pixels for the app's newest window. 1.0
// with no window up, which is the value that makes size arithmetic keep
// working rather than collapsing to zero.
fn display_density() -> f64 {
    return host::density_of(app::newest_window_root());
}

// Window.DisplayDensityChanged. Fires when the window moves between screens of
// different scale, which is the whole of what "the density changed" means on a
// desktop.
fn observe_display_density(cb: fn(*u8), ctx: *u8 = 0 as *u8) -> services::Cancellable {
    return services::Cancellable::of(host::observe_density(cb, ctx), host::cancel_observe);
}

// Window.IsActivated — the READ half of the pair whose observers already
// shipped (`observe_window_active` / `_inactive`). A handler that only ever
// learns about the change cannot answer "is it active NOW", which is what a
// screen asks when it is built.
fn is_window_active() -> bool {
    return host::is_active(app::newest_window_root());
}

// Window.SizeChanged. The window's own resize, not a node's — `observe_size`
// answers that one, and this is the row the ledger asked for.
fn observe_window_size(cb: fn(*u8), ctx: *u8 = 0 as *u8) -> services::Cancellable {
    return services::Cancellable::of(host::observe_size_changed(cb, ctx),
                                     host::cancel_observe);
}

// Window.Backgrounding / Resumed / Stopped. On a desktop these are the app
// being hidden, unhidden and terminated — the same three moments, under the
// names the platform gives them.
// "Backgrounded" on a Linux desktop is the window being minimised or otherwise
// shown to nobody, which GTK states as `suspended`. One signal carries both
// directions, so each verb filters for the one it means — the same shape as the
// active/inactive pair above.
fn observe_backgrounding(cb: fn(*u8), ctx: *u8 = 0 as *u8) -> services::Cancellable {
    return services::Cancellable::of(host::observe_suspended(suspended_filter, cb as *u8),
                                     host::cancel_observe);
}

fn observe_resumed(cb: fn(*u8), ctx: *u8 = 0 as *u8) -> services::Cancellable {
    return services::Cancellable::of(host::observe_suspended(resumed_filter, cb as *u8),
                                     host::cancel_observe);
}

fn suspended_filter(cb: *u8) {
    if !host::is_suspended() { return; }
    let f: fn(*u8) = cb as fn(*u8);
    if f != (0 as fn(*u8)) { f(0 as *u8); }
    return;
}

fn resumed_filter(cb: *u8) {
    if host::is_suspended() { return; }
    let f: fn(*u8) = cb as fn(*u8);
    if f != (0 as fn(*u8)) { f(0 as *u8); }
    return;
}

// THE APP STOPPING IS NOT A NOTIFICATION HERE. AppKit posts
// NSApplicationWillTerminateNotification; GTK has no application-lifecycle
// broadcast at all outside GtkApplication, which this backend deliberately does
// not adopt (it would take over the main loop, the lifecycle and a D-Bus name
// for the sake of a menu — see `facet_gtk/window`).
//
// So the honest answer is the LAST WINDOW CLOSING, which is the same moment,
// and it is already an ordinary close: `App::run` reaches `on_quit` after the
// loop returns. An observer registered here would fire from the same place that
// hook already does, so this stays inert and MANIFEST.md §1 records why rather
// than a filter that never runs.
fn observe_stopped(cb: fn(*u8), ctx: *u8 = 0 as *u8) -> services::Cancellable {
    return services::Cancellable::none();
}

// Application.UserAppTheme — an EXPLICIT light/dark choice, overriding the
// system's. `Appearance::Unspecified` gives the system back, which is the
// only way to undo an override and therefore not optional.
fn set_app_appearance(a: vocab::Appearance) {
    host::set_app_appearance(a);
    return;
}

fn app_appearance() -> vocab::Appearance {
    return host::app_appearance();
}

// The frame of the app's newest window, in the platform's screen coordinates.
// Zero when nothing is up.
fn window_frame() -> vocab::Rect {
    return dialogs::window_frame_of(app::newest_window_root());
}

fn set_window_frame(frame: vocab::Rect) {
    dialogs::set_window_frame_of(app::newest_window_root(), frame);
    return;
}

// ---- App ---------------------------------------------------------------------
// The process tier. An App owns the once-per-process concerns — the app menu,
// the agent surface, launch and quit hooks — and a registry of named screen
// routes. `run(initial)` shows one screen at a time as a blocking window;
// `nav::go` unwinds it and shows the next, `nav::push`/`pop` show and dismiss
// secondary screens alongside, `nav::quit` (or closing the window with nothing
// pending) ends the loop.

struct AppRoute {
    name: text::Text,
    factory: fn() -> screen::ScreenBox,
}

fn app_hook_noop(ctx: *u8) { return; }

// The default answer to "may I quit?" — yes, which is what an app with no
// opinion has always done.
fn app_always_quit(ctx: *u8) -> bool { return true; }

struct App {
    // The Application record (the ledger's word): theme, navigation, windows.
    // Embedded BY VALUE — two Apps in one exe each own a clean one; `run`
    // makes it Application.Current for the loop's lifetime.
    application: app::Application,
    name_text: text::Text,
    menu_fn: fn() -> AppMenu,
    on_launch_fn: fn(*u8),
    on_quit_fn: fn(*u8),
    on_should_quit_fn: fn(*u8) -> bool,
    opaque hook_ctx: *u8,
    routes: vec::Vec[AppRoute],
}

impl App {
    fn new(name: str = "facet") -> App {
        return App {
            application: app::Application::new(),
            name_text: text::from_str(name),
            menu_fn: 0 as fn() -> AppMenu,
            on_launch_fn: app_hook_noop,
            on_quit_fn: app_hook_noop,
            on_should_quit_fn: app_always_quit,
            hook_ctx: 0 as *u8,
            routes: vec::new::[AppRoute](),
        };
    }

    fn name(this) -> str { return this.name_text.view(); }

    fn menu(ref this, build: fn() -> AppMenu) { this.menu_fn = build; return; }

    // Register a screen under a route name. The factory constructs a FRESH
    // boxed screen each time the route is shown.
    fn screen(ref this, name: str, factory: fn() -> screen::ScreenBox) {
        this.routes.append(AppRoute { name: text::from_str(name), factory: factory });
        return;
    }

    fn agent_mcp(ref this, id: str = "") {
        if id == "" { agent_mcp(this.name()); return; }
        agent_mcp(id);
        return;
    }

    fn on_launch(ref this, f: fn(*u8), ctx: *u8 = 0 as *u8) {
        this.on_launch_fn = f;
        this.hook_ctx = ctx;
        return;
    }

    fn on_quit(ref this, f: fn(*u8)) { this.on_quit_fn = f; return; }

    // ASKED BEFORE THE APP GOES, and the only hook that can say no.
    //
    // `on_quit` above is a NOTIFICATION and cannot refuse; ⌘Q is the case that
    // needs refusing, because `-[NSApplication terminate:]` never returns to
    // the run loop and every seam past `run_loop()` — `Lifecycle::on_detach`
    // and `on_quit` both — is on the far side of a return that does not happen.
    // An app driving a subprocess found this the way anyone will: a file half
    // written after a quit that looked clean.
    //
    // Answer FALSE to hold the quit. Nothing else happens — the app stays up,
    // and finishing (or asking, and then finishing) is the app's business.
    // `nav::quit()` when it is done, which is the same orderly unwind a closed
    // window takes.
    //
    // Answer TRUE, or set nothing, and ⌘Q now goes through that same unwind
    // rather than around it: `on_detach` and `on_quit` run where they always
    // ran, with the run loop still alive underneath them, so a subprocess can
    // be stopped in order and a reply read back.
    fn on_should_quit(ref this, f: fn(*u8) -> bool, ctx: *u8 = 0 as *u8) {
        this.on_should_quit_fn = f;
        // ONLY WHEN GIVEN. An App has one `hook_ctx` and `on_launch` may have
        // set it already; an omitted ctx here must not zero that.
        if ctx != (0 as *u8) { this.hook_ctx = ctx; }
        return;
    }

    fn route_factory(this, route: str) -> fn() -> screen::ScreenBox {
        var i: usize = 0 as usize;
        let n: usize = this.routes.count();
        while i < n {
            match this.routes.at_ptr(i) {
                option::Option[*AppRoute]::Some(rp) => {
                    if { (*rp).name.view() } == route { return { (*rp).factory }; }
                }
                option::Option[*AppRoute]::None => { }
            }
            i = i +% (1 as usize);
        }
        return 0 as fn() -> screen::ScreenBox;
    }

    fn build_menu(this) -> AppMenu {
        let f: fn() -> AppMenu = this.menu_fn;
        if f != (0 as fn() -> AppMenu) { return f(); }
        var m: AppMenu = screen::app_menu(this.name());
        m.add_item(this.name(), "Quit", "q", screen::menu_action_quit());
        return m;
    }

    // Run the app: show `initial` (its `arg()` reads `arg`), then follow nav
    // intents until quit. Blocks for the app's whole life. InvalidInput when a
    // route resolves to nothing — the loop cannot continue without a screen.
    fn run(ref this, initial: str, arg: str = "") -> status::Status {
        backend::install();
        // The contract every real facade follows: this app's record IS
        // Application.Current while its loop runs, and stops being it after,
        // so a second app started later begins from its own clean record. The
        // host back-pointer makes this the ONE door.
        this.application.host = #addr_of(this) as *u8;
        app::make_current(#addr_of(this.application));
        nav::reset(arg);
        nav::set_close_fn(close_current);
        nav::set_push_fn(push_screen);
        nav::set_pop_fn(pop_screen);
        // `build_menu` already answers with the default (the app's name plus
        // Quit) when nothing set one, so an application that never asked for a
        // menu still gets a working one.
        //
        // It is NOT installed here. The screen contributes to it — `Screen`
        // requires a `menu_items()` and the contract says they are "merged
        // additively by the runtime each time the screen is shown" — so the
        // install has to happen after the screen exists, which is inside the
        // loop below. It used to happen here, once, and every screen's
        // contribution was discarded: `AppMenu::extend` had no caller outside
        // its own tests, and guard 5b recorded the row as implemented because
        // the string named a declaration.
        // The agent surface, if the app asked for one. ONCE per process — the
        // accept loop lives for the app's life — and before the first window,
        // so an agent that connects immediately is not racing the launch hook.
        //
        // `agent_mcp(path)` recorded the path and nothing served it until now:
        // the same shape as the app menu, which was built and never installed.
        serve_agent_if_asked();
        // NO TERMINATE SEAM. The macOS facade installs one here because ⌘Q
        // does not come back to the run loop; on GTK every quit is a window
        // close and `should_close` on the primary window is where the app is
        // asked — see `screen_should_close` below.
        let launch: fn(*u8) = this.on_launch_fn;
        launch(this.hook_ctx);

        var route: text::Text = text::from_str(initial);
        var outcome: status::Status = status::Status::Ok;
        loop {
            let f: fn() -> screen::ScreenBox = this.route_factory(route.view());
            if f == (0 as fn() -> screen::ScreenBox) { outcome = status::Status::InvalidInput; break; }
            var sb: screen::ScreenBox = f();
            if !sb.valid() { outcome = status::Status::InvalidInput; break; }
            // The app's menu plus THIS screen's contribution, rebuilt per
            // screen so leaving one takes its items away again — an additive
            // merge into a bar that is never rebuilt would accumulate.
            var bar: AppMenu = this.build_menu();
            bar.extend(sb.menu_items());
            host::install_app_menu(#addr_of(bar));
            let c: Chrome = sb.chrome();
            var root: Node = sb.build();
            let w: *u8 = host::open_window(#addr_of(root), c,
                                           should_close: screen_should_close);
            CURRENT_ROOT = #addr_of(root);
            // The agent reads the LIVE view tree, so the surface is re-opened
            // on the new window each time a screen is shown. The serve worker
            // holds the surface's ADDRESS, so re-opening in place retargets
            // every later request rather than needing the worker restarted.
            if w != (0 as *u8) { app::agent_attach(w); }
            sb.on_attach();
            host::run_loop();        // blocks until this screen's window closes
            close_all_pushed();      // replacing the root dismisses pushed screens
            sb.on_detach();
            // A worker may still be inside this screen's data, and `sb` is
            // freed a few lines down: settling here is what stops a worker
            // writing into freed memory.
            settle_and_teardown(#addr_of(root));
            CURRENT_ROOT = 0 as *core::Node;
            // sb drops here: the screen instance is freed before the next shows.
            let taken: u32 = nav::take();
            if taken == nav::intent_go() {
                route = text::from_str(nav::target());
            } else {
                break;   // quit, or the window closed with nothing pending
            }
        }

        nav::clear_hooks();
        app::release_current();
        this.application.host = 0 as *u8;
        let quit: fn(*u8) = this.on_quit_fn;
        quit(this.hook_ctx);
        return outcome;
    }
}

// ---- App <-> nav wiring ------------------------------------------------------
// The hooks nav fires while a loop runs. `CURRENT_ROOT` is the PRIMARY screen's
// tree, which is process-scoped in the same sense the backend is: one primary
// screen is up at a time, and pushed screens are tracked separately below.

static CURRENT_ROOT: *core::Node = #zero::[*core::Node]();

// THE APP IS ASKED THROUGH THE WINDOW, because on GTK that is the only place
// there is to ask.
//
// The macOS facade intercepts `terminate:` — a call that never returns to the
// run loop, so every teardown seam past `run_loop()` would be skipped without
// it. GTK has no such call. Every quit is a window closing: the title-bar
// button, the menu's Quit item (which closes the windows), and `nav::quit` all
// arrive at `close-request`, `run_loop()` returns when the last one goes, and
// `App::run` reaches `on_detach` and `on_quit` exactly where it always did.
//
// So this is not an interception, it is the ORDINARY question, forwarded: the
// primary screen's window is opened with this as its `should_close`, and an app
// that answers false holds the close the same way it holds a quit. Nothing else
// happens — holding the moment is the point, and finishing is the app's
// business. `nav::quit()` when it is done.
fn screen_should_close(ctx: *u8) -> bool {
    let ap: *App = running_app();
    if ap == (0 as *App) { return true; }       // no app running: let it go
    let ask: fn(*u8) -> bool = { (*ap).on_should_quit_fn };
    if ask == (0 as fn(*u8) -> bool) { return true; }
    return ask({ (*ap).hook_ctx });
}

// nav::go / nav::quit: unwind the current primary window. Zeroed first so a
// second verb in the same handler (go then quit) closes nothing twice.
fn close_current() {
    // Pushed screens FIRST. The run loop stops when the last window closes
    // (`OPEN_WINDOWS <= 0`), and a pushed screen is in that count — so closing
    // only the primary left the loop running, `App::run` never returned, and
    // the `go`/`quit` intent was never read. `close_all_pushed` ran after the
    // loop, which is exactly too late to help it exit.
    close_all_pushed();
    let r: *core::Node = CURRENT_ROOT;
    CURRENT_ROOT = 0 as *core::Node;
    if r == (0 as *core::Node) { return; }
    host::close_window_of(r);
    return;
}

// One pushed (secondary) screen: the tree it shows and the heap ScreenBox that
// owns its instance.
struct PushedScreen {
    opaque root: *core::Node,
    opaque sbp: *u8,
}

static PUSHED: vec::Vec[PushedScreen] = #zero::[vec::Vec[PushedScreen]]();

// A presented window closed: give its tree back. Without this the box made in
// `present_window` was never reclaimed.
fn presented_closed(ctx: *u8) {
    if ctx == (0 as *u8) { return; }
    let _b: box::Box[Node] = box::from_raw::[Node](ctx);
    return;
}

// nav::push: show `route` in a window alongside the primary.
fn push_screen(route: str, arg: str) -> bool {
    let ap: *App = running_app();
    if ap == (0 as *App) { return false; }
    let f: fn() -> screen::ScreenBox = { (*ap).route_factory(route) };
    if f == (0 as fn() -> screen::ScreenBox) { return false; }
    nav::set_arg(arg);   // after the lookup: a failed push leaves arg alone
    var sb: screen::ScreenBox = f();
    if !sb.valid() { return false; }
    let c: Chrome = sb.chrome();
    var tree: Node = sb.build();
    // The tree and the box both outlive this frame, so both go to the heap.
    let tp: *core::Node = match box::new::[Node](tree) {
        option::Option[box::Box[Node]]::Some(tb) => { tb.into_raw() } as *core::Node,
        option::Option[box::Box[Node]]::None => 0 as *core::Node,
    };
    if tp == (0 as *core::Node) { return false; }
    let sbp: *u8 = match box::new::[screen::ScreenBox](sb) {
        option::Option[box::Box[screen::ScreenBox]]::Some(b) => b.into_raw(),
        option::Option[box::Box[screen::ScreenBox]]::None => 0 as *u8,
    };
    if sbp == (0 as *u8) { return false; }
    let w: *u8 = host::open_window(tp, c,
                                   should_close: default_should_close,
                                   should_close_ctx: sbp,
                                   will_close: pushed_closed, will_close_ctx: sbp);
    if w == (0 as *u8) { return false; }
    // The agent reads the LIVE view tree of ONE window, and it was only ever
    // pointed at the primary — so a pushed screen was invisible to an agent,
    // and so was an `alert` sheet. The sheet case is the sharp one: dialogs
    // argues it was rewritten off NSAlert/runModal precisely so "an agent
    // cannot answer it" would stop being true, and the surface never followed.
    app::agent_attach(w);
    let stack: *vec::Vec[PushedScreen] = #addr_of(PUSHED);
    { (*stack).append(PushedScreen { root: tp, sbp: sbp }) };
    { (*(sbp as *screen::ScreenBox)).on_attach() };
    return true;
}

// Fires ONCE per pushed window, whichever way it closes (nav::pop, the user's
// close button, the unwind sweep) — from windowWillClose, BEFORE the tree
// unmounts, so the screen's views are alive for on_detach.
fn pushed_closed(ctx: *u8) {
    if ctx == (0 as *u8) { return; }
    { (*(ctx as *screen::ScreenBox)).on_detach() };
    pushed_remove(ctx);
    let _b: box::Box[screen::ScreenBox] = box::from_raw::[screen::ScreenBox](ctx);
    return;
}

fn pushed_remove(sbp: *u8) {
    let stack: *vec::Vec[PushedScreen] = #addr_of(PUSHED);
    let n: usize = { (*stack).count() };
    var i: usize = 0 as usize;
    while i < n {
        let hit: bool = match { (*stack).at_ptr(i) } {
            option::Option[*PushedScreen]::Some(pp) => sbp == { (*pp).sbp },
            option::Option[*PushedScreen]::None => false,
        };
        if hit {
            let _e: option::Option[PushedScreen] = { (*stack).remove(at: i) };
            return;
        }
        i = i +% (1 as usize);
    }
    return;
}

// nav::pop: dismiss the most recently pushed screen. False when none is up.
fn pop_screen() -> bool {
    let stack: *vec::Vec[PushedScreen] = #addr_of(PUSHED);
    let n: usize = { (*stack).count() };
    if n == (0 as usize) { return false; }
    let r: *core::Node = match { (*stack).at_ptr(n -% (1 as usize)) } {
        option::Option[*PushedScreen]::Some(pp) => { (*pp).root },
        option::Option[*PushedScreen]::None => 0 as *core::Node,
    };
    if r == (0 as *core::Node) { return false; }
    host::close_window_of(r);   // fires pushed_closed, which removes the entry
    return true;
}

// A replaced primary takes its pushed screens with it, each through the normal
// close path. The guard bounds the loop if a close ever fails to remove its
// entry.
fn close_all_pushed() {
    var sweeps: i32 = 0;
    loop {
        let stack: *vec::Vec[PushedScreen] = #addr_of(PUSHED);
        if { (*stack).count() } == (0 as usize) { return; }
        if sweeps > 256 { return; }
        sweeps = sweeps + 1;
        let _p: bool = pop_screen();
    }
    return;
}

// ---- app context -------------------------------------------------------------
// Everything derives from the ONE door: `app::current()` answers the running
// Application record, whose `host` points back at the embedding App.

fn running_app() -> *App {
    if !app::has_current() { return 0 as *App; }
    let a: *app::Application = app::current();
    return { (*a).host } as *App;
}

fn app_running() -> bool { return running_app() != (0 as *App); }

fn app_name() -> str {
    let ap: *App = running_app();
    if ap == (0 as *App) { return ""; }
    return { (*ap).name() };
}

fn has_screen(route: str) -> bool {
    let ap: *App = running_app();
    if ap == (0 as *App) { return false; }
    let f: fn() -> screen::ScreenBox = { (*ap).route_factory(route) };
    return f != (0 as fn() -> screen::ScreenBox);
}

fn register_screen(route: str, factory: fn() -> screen::ScreenBox) -> bool {
    let ap: *App = running_app();
    if ap == (0 as *App) { return false; }
    if has_screen(route) { return false; }
    { (*ap).screen(route, factory) };
    return true;
}

// ---- agent hookup ------------------------------------------------------------
// Registered by facet/agent when an app opts into serving. Its own struct so
// importing facet/runtime never drags the agent packages in.

// ---- tests -------------------------------------------------------------------
// This file SHADOWS runtime.cplus on macOS, so the base's tests do not run —
// the parts of its surface that do not need a window are re-covered here.
// Anything that opens one belongs to facet_appkit's own suite, which has a
// run loop; these stay headless.

fn rt_screen_factory() -> screen::ScreenBox { return screen::ScreenBox::invalid(); }

#[test]
fn app_routes_register_and_resolve() {
    var a: App = App::new(name: "probe");
    assert a.name() == "probe";
    a.screen("workspace", rt_screen_factory);
    a.screen("settings", rt_screen_factory);
    assert a.route_factory("workspace") != (0 as fn() -> screen::ScreenBox);
    assert a.route_factory("nowhere") == (0 as fn() -> screen::ScreenBox);
    return;
}

#[test]
fn app_context_is_inert_without_a_running_app() {
    // Nothing running: every reader answers neutrally rather than reaching
    // through a null door.
    app::release_current();
    assert app_running() == false;
    assert app_name() == "";
    assert has_screen("workspace") == false;
    assert register_screen("workspace", rt_screen_factory) == false;
    return;
}

#[test]
fn the_running_app_is_reached_through_the_one_door() {
    // `App::run` points app::current() at its own record and the record's
    // host back at the App — that pair IS the app context, and nothing here
    // is a second static.
    app::release_current();
    var a: App = App::new(name: "iris");
    a.screen("welcome", rt_screen_factory);
    a.application.host = #addr_of(a) as *u8;
    app::make_current(#addr_of(a.application));
    assert app_running();
    assert app_name() == "iris";
    assert has_screen("welcome");
    assert has_screen("nope") == false;
    // Dynamic registration goes through the same door; a name already taken
    // is refused rather than shadowed.
    assert register_screen("later", rt_screen_factory);
    assert has_screen("later");
    assert register_screen("later", rt_screen_factory) == false;
    // Releasing the door makes every reader neutral again — a second app in
    // the same exe starts clean.
    app::release_current();
    a.application.host = 0 as *u8;
    assert app_running() == false;
    assert app_name() == "";
    return;
}

#[test]
fn the_default_menu_names_the_app_and_carries_quit() {
    var a: App = App::new(name: "iris");
    let m: AppMenu = a.build_menu();
    assert m.items.count() == (1 as usize);
    match m.items.at_ptr(0 as usize) {
        option::Option[*MenuItem]::Some(p) => {
            assert { (*p).title.equals("Quit") };
            assert { (*p).menu.equals("iris") };
            assert { (*p).action } == screen::menu_action_quit();
        }
        option::Option[*MenuItem]::None => { assert false; }
    }
    return;
}

#[test]
fn nav_push_and_pop_are_inert_with_no_app_running() {
    // The negative half of the push/pop hooks: no running App means no route
    // registry to adjudicate against, so both report false and change nothing.
    app::release_current();
    assert push_screen("settings", "") == false;
    assert pop_screen() == false;
    close_all_pushed();                        // nothing to sweep
    // close_current with no primary window up closes nothing and does not trap.
    close_current();
    return;
}

#[test]
fn window_frame_is_zero_with_no_window_up() {
    app::reset_default_for_tests();
    let f: vocab::Rect = window_frame();
    assert f.width == 0.0f64;
    assert f.height == 0.0f64;
    // The write half is equally inert rather than reaching a null window.
    set_window_frame(vocab::Rect { x: 10.0f64, y: 10.0f64, width: 100.0f64, height: 100.0f64 });
    return;
}


// ---- the quit question -------------------------------------------------------
//
// The seam these cover is the one that REPLACED an interception. On macOS ⌘Q
// needs catching because `terminate:` never returns; here a quit is a window
// closing, and the only thing this facade has to do is forward the question to
// the app at that moment. So what is asserted is the forwarding, headlessly —
// whether GTK really emits `close-request` belongs to an app under
// `examples/`.

static SAID_NO_CALLS: i32 = 0;

fn rt_refuse_quit(ctx: *u8) -> bool {
    SAID_NO_CALLS = SAID_NO_CALLS + 1;
    return false;
}

fn rt_allow_quit(ctx: *u8) -> bool {
    SAID_NO_CALLS = SAID_NO_CALLS + 1;
    return true;
}

#[test]
fn an_app_that_says_not_yet_holds_the_close() {
    app::reset_default_for_tests();
    var a: App = App::new(name: "probe");
    a.on_should_quit(rt_refuse_quit);
    a.application.host = #addr_of(a) as *u8;
    app::make_current(#addr_of(a.application));
    SAID_NO_CALLS = 0;
    // FALSE is what `close-request` turns into TRUE — GTK's word for "the
    // close was handled and must not happen".
    assert screen_should_close(0 as *u8) == false;
    assert SAID_NO_CALLS == 1;
    app::release_current();
    a.application.host = 0 as *u8;
    return;
}

#[test]
fn an_app_that_agrees_lets_the_window_go() {
    app::reset_default_for_tests();
    var a: App = App::new(name: "probe");
    a.on_should_quit(rt_allow_quit);
    a.application.host = #addr_of(a) as *u8;
    app::make_current(#addr_of(a.application));
    SAID_NO_CALLS = 0;
    assert screen_should_close(0 as *u8);
    assert SAID_NO_CALLS == 1;
    app::release_current();
    a.application.host = 0 as *u8;
    return;
}

#[test]
fn an_app_with_no_opinion_lets_the_window_go() {
    // `App::new` sets `app_always_quit`, so an app that never asked still
    // closes — the behaviour every app had before the hook existed.
    app::reset_default_for_tests();
    var a: App = App::new(name: "probe");
    a.application.host = #addr_of(a) as *u8;
    app::make_current(#addr_of(a.application));
    assert screen_should_close(0 as *u8);
    app::release_current();
    a.application.host = 0 as *u8;
    return;
}

#[test]
fn the_close_question_is_inert_with_no_app_running() {
    // NEGATIVE, and the one that matters: nothing of ours to unwind, so the
    // honest answer is GTK's own. Refusing here would wedge a window that has
    // no App behind it and no other way to close.
    app::release_current();
    assert screen_should_close(0 as *u8);
    return;
}

// ---- what this facade does NOT answer ----------------------------------------

#[test]
fn observe_stopped_is_inert_and_says_so_by_answering_nothing() {
    // GTK has no application-lifecycle broadcast outside GtkApplication, which
    // this backend deliberately does not adopt. The last window closing is the
    // same moment and `App::run` already reaches `on_quit` there, so this
    // answers an INERT handle rather than a filter that never fires.
    var c: services::Cancellable = observe_stopped(rt_noop_observer);
    assert !c.pending();
    c.cancel();                                 // idempotent, and not a trap
    return;
}

fn rt_noop_observer(ctx: *u8) { return; }

#[test]
fn an_observer_registered_with_no_window_up_is_inert() {
    // Every observation here is a `notify::` on a WINDOW, so there is nothing
    // to connect to before one exists. An inert handle is the honest answer;
    // a live-looking one that never fires is not.
    app::reset_default_for_tests();
    var a: services::Cancellable = observe_window_active(rt_noop_observer);
    assert !a.pending();
    var b: services::Cancellable = observe_window_size(rt_noop_observer);
    assert !b.pending();
    var d: services::Cancellable = observe_display_density(rt_noop_observer);
    assert !d.pending();
    return;
}

#[test]
fn the_agent_hooks_default_to_saying_so() {
    // Registered by facet/agent into the application seam; unregistered,
    // serving says why instead of silently serving nothing.
    app::install_agent(app::AgentHooks { attach_window: 0 as fn(*u8), serve_once: 0 as fn(str),
                                         pin_policy: 0 as fn(*u8, vocab::Agent) });
    app::agent_attach(0 as *u8);               // inert, not a trap
    app::agent_serve_once("/tmp/probe.sock");  // prints the reason
    app::agent_pin(0 as *u8, vocab::Agent::Private);   // and the pin is inert too
    return;
}
