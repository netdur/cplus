// app_dirs on macOS: ~/Library/Application Support/<id> and
// ~/Library/Caches/<id>, created. The user's Library is SHARED by every app,
// so the directory is named for this one: its bundle identifier when it has
// one, else the name it gave `App::new`. See app_dirs.cplus.

import "stdlib/option" as option;
import "stdlib/text" as text;
import "stdlib/fs" as fs;
import "stdlib/result" as result;
import "objc/runtime" as rt;
import "objc/bridge" as bridge;
import "facet/application" as app;

#[link_name = "NSSearchPathForDirectoriesInDomains"]
extern fn search_path(directory: u64, domains: u64, expand_tilde: i8) -> *u8;

// NSSearchPathDirectory: NSCachesDirectory 13, NSApplicationSupportDirectory
// 14. NSUserDomainMask 1.
fn data_dir() -> option::Option[text::Text] { return named_under(14 as u64); }
fn cache_dir() -> option::Option[text::Text] { return named_under(13 as u64); }

fn named_under(which: u64) -> option::Option[text::Text] {
    let arr: *u8 = { search_path(which, 1 as u64, 1 as i8) };
    if arr.is_null() { return option::Option[text::Text]::None; }
    let first: *u8 = { rt::msg_id(arr, rt::sel(#str_ptr("firstObject\0"))) };
    if first.is_null() { return option::Option[text::Text]::None; }
    let base: text::Text = bridge::to_text(first);
    let id: text::Text = app_id();
    let dir: text::Text = "${base.view()}/${id.view()}";
    return made(dir);
}

fn app_id() -> text::Text {
    let cls: *u8 = rt::get_class(#str_ptr("NSBundle\0"));
    let b: *u8 = { rt::msg_id(cls, rt::sel(#str_ptr("mainBundle\0"))) };
    if b.is_not_null() {
        let bid: *u8 = { rt::msg_id(b, rt::sel(#str_ptr("bundleIdentifier\0"))) };
        if bid.is_not_null() {
            let t: text::Text = bridge::to_text(bid);
            if t.view() != "" { return t; }
        }
    }
    let a: *app::Application = app::current();
    if a.is_not_null() {
        let n: str = { (*a).name.view() };
        if n != "" { return text::from_str(n); }
    }
    return text::from_str("facet");
}

fn made(take dir: text::Text) -> option::Option[text::Text] {
    match fs::create_dir_all(dir.view()) {
        result::Result[bool, result::IoError]::Ok(_) => { return option::Option[text::Text]::Some(dir); }
        result::Result[bool, result::IoError]::Err(_) => {
            if fs::is_dir(dir.view()) { return option::Option[text::Text]::Some(dir); }
            return option::Option[text::Text]::None;
        }
    }
}
