// facet_runtime's suite exists chiefly for one guarantee the facades carried
// when they lived inside facet: importing ./runtime compiles the ACTIVE
// platform's facade AND its backend — on macOS that is runtime_macos plus
// facet_appkit — so a backend that does not build turns facet_runtime red.
// The boot surface itself needs a window and a run loop; anything that opens
// one belongs to the backend's own suite or an app under playground/. The
// facades carry their own headless #[test]s (routes, refusals, agent-hook
// defaults), which run as part of this suite.

import "stdlib/option" as option;
import "stdlib/text" as text;
import "./runtime" as runtime;
import "stdlib/fs" as fs;
import "stdlib/result" as result;

#[test]
fn the_facade_and_its_backend_compile() {
    // The import above is the assertion: resolving `./runtime` on this
    // platform compiles the platform facade and the backend it installs.
}

// ---- the clipboard, through the FACADE ----------------------------------------

#[test]
fn the_clipboard_is_reachable_from_the_portable_facade() {
    // THE POINT OF THIS ONE IS THE FORWARD, not the pasteboard. The backend's
    // own suite already asserts NSPasteboard round-trips; what it cannot catch
    // is a facade variant that never got the two lines — and there are five of
    // them (base, macos, ios, linux, android), each a separate file, each
    // silently compiling without them.
    //
    // Reaching `runtime::` rather than the backend is what makes this an
    // assertion about the wiring. On a platform whose facade forwards, this
    // round-trips; on the NEUTRAL BASE it answers false and None, loudly, which
    // is the documented no-backend contract and not a failure of this test.
    let sentinel: str = "facet_runtime-clipboard-forward";
    if runtime::copy_text(sentinel) {
        match runtime::paste_text() {
            option::Option[text::Text]::Some(got) => {
                // A backend that CAN read answers what was written. GTK cannot
                // — its clipboard read is async-only — so `None` below is a
                // legitimate answer there and not a broken forward.
                assert got.view() == sentinel;
            }
            option::Option[text::Text]::None => { }
        }
    }
}

// spendwise S42: the app's data and cache directories exist once asked for, a
// file written there reads back, and the two are different places.
#[test]
fn the_app_data_and_cache_directories_exist_and_take_a_file() {
    var data: text::Text = text::new();
    var cache: text::Text = text::new();
    match runtime::app_data_dir() {
        option::Option[text::Text]::Some(d) => { data = d; }
        option::Option[text::Text]::None => { assert false; }
    }
    match runtime::cache_dir() {
        option::Option[text::Text]::Some(d) => { cache = d; }
        option::Option[text::Text]::None => { assert false; }
    }
    assert fs::is_dir(data.view());
    assert fs::is_dir(cache.view());
    assert data.view() != cache.view();
    // Named for this app, not the shared Library itself.
    assert data.view().has_suffix("Application Support") == false;
    let f: text::Text = "${data.view()}/s42-probe.txt";
    match fs::write_string(f.view(), "saved") {
        result::Result[usize, result::IoError]::Ok(_) => { }
        result::Result[usize, result::IoError]::Err(_) => { assert false; }
    }
    match fs::read_to_string(f.view()) {
        result::Result[text::Text, result::IoError]::Ok(t) => { assert t.view() == "saved"; }
        result::Result[text::Text, result::IoError]::Err(_) => { assert false; }
    }
    let _r = fs::remove_file(f.view());
}
