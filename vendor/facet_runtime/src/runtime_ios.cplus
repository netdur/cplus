// facet runtime facade for iOS. `import "facet_runtime/runtime"` resolves HERE on an
// iOS target, through the resolver's platform override on the filename, and
// this file selects the UIKit backend. macOS resolves to runtime_macos.cplus
// the same way; a target with neither lands on the neutral base runtime.cplus.
//
// Together with runtime_macos.cplus this is one of the two files in facet that
// name a platform. The surface below is runtime.cplus's, verb for verb, so an
// application type-checks identically on both.
//
// ============================================================================
// ONE STRUCTURAL DIFFERENCE, AND EVERY ODD-LOOKING THING HERE FOLLOWS FROM IT.
//
// `UIApplicationMain` DOES NOT RETURN. It takes the process and calls `exit()`
// when the app dies. `[NSApp run]` returns when the last window closes, and the
// macOS facade is built on that: `run_component` blocks, then hands the
// component's final state back; `App::run` loops — open a window, block, close,
// read the pending nav intent, open the next.
//
// None of that shape is reachable on iOS. So:
//
//   * `run_component` / `run_screen` do not return their argument's final
//     state, because they do not return at all. Their shape is unchanged, so an
//     application compiles identically on both platforms; the component lives
//     in the frame that entered the loop, which is now the process's bottom
//     frame forever, so handlers bound in `build(ref this)` stay valid.
//   * `App::run` shows the initial screen and enters the loop. NAVIGATION IS A
//     SWAP, not a window cycle: `nav::go` tears the current screen down and
//     builds the next INTO THE SAME WINDOW, because a phone has one window and
//     closing it is not something an app may do.
//   * Nothing after the loop entry runs. There is no teardown, no `on_quit`,
//     no settle: the process is gone. That is not a gap in this file, it is
//     what iOS termination is — apps are killed, they do not wind down.
//
// The facade says all of that in comments at each call site rather than
// papering over it, because an application author reading `run_component`'s
// signature on both platforms would otherwise expect the returned value to mean
// something here.
// ============================================================================

import "stdlib/option" as option;
import "stdlib/text" as text;
import "stdlib/vec" as vec;
import "stdlib/status" as status;
import "stdlib/box" as box;
import "stdlib/io" as io;
import "flex_layout/flex_layout" as flex;
import "facet/facet" as core;
import "facet/vocabulary" as vocab;
import "facet/component" as component;
import "facet/screen" as screen;
import "facet/services" as services;
import "facet/application" as app;
import "facet/screen" as screen_mod;
import "facet/window" as window;
import "facet/mount" as mount;
import "facet/nav" as nav;
import "facet_uikit/facet_uikit" as backend;
import "facet_uikit/window" as host;
import "facet_uikit/notify" as notify;
import "facet_uikit/dialogs" as dialogs;
import "facet_uikit/clipboard" as clipboard;

type Node = flex::Node;
type Builder = flex::Builder;
type AppMenu = screen::AppMenu;
type MenuItem = screen::MenuItem;
type Chrome = screen::Chrome;
type ScreenBox = screen::ScreenBox;

// One loud line for a verb this platform declines to offer, so an application
// that calls it on iOS learns why rather than watching nothing happen. The
// counterpart of runtime.cplus's `no_backend` — but this is not "no backend",
// it is "not this platform", and the message says which.
fn not_on_ios(entry: str) {
    io::eprintln(text::from_str("facet(ios): ").appending(entry)
        .appending(" has no iOS equivalent — see vendor/facet_uikit/MANIFEST.md. It is a no-op here.").view());
}

fn not_yet(entry: str) {
    io::eprintln(text::from_str("facet(ios): ").appending(entry)
        .appending(" is not built in facet_uikit yet — see its MANIFEST.md. It is a no-op here.").view());
}

// The window an application describes by hand. Identical to runtime.cplus's
// declaration, so a `Window` implementor compiles on both platforms — most of
// its answers simply describe nothing on a phone.
interface Window {
    fn root(ref this) -> Node;
    fn title(this) -> str;
    fn width(this) -> f64;
    fn height(this) -> f64;
    fn bar(this) -> screen::Bar;
    fn is_maximizable(this) -> bool;
    fn is_minimizable(this) -> bool;
    fn max_width(this) -> f64;
    fn max_height(this) -> f64;
    fn min_width(this) -> f64;
    fn min_height(this) -> f64;
    fn wants_pinch_zoom(this) -> bool;
    fn min_zoom(this) -> f64;
    fn max_zoom(this) -> f64;
    fn has_app_menu(this) -> bool;
    fn app_menu(ref this) -> AppMenu;
    fn should_close_callback(this) -> fn(*u8) -> bool;
    fn will_close_callback(this) -> fn(*u8);
    fn lifecycle_context(this) -> *u8;
}

// Menu-token re-exports, so a facade import serves an app's menu block whole.
// They resolve and they compile; there is no menu bar to install them into, and
// `install_app_menu` on this backend is a no-op that MANIFEST.md records.
fn app_menu(title: str) -> AppMenu { return screen::app_menu(title); }
fn menu_action_none() -> u32 { return screen::menu_action_none(); }
fn menu_action_quit() -> u32 { return screen::menu_action_quit(); }
fn menu_action_close_window() -> u32 { return screen::menu_action_close_window(); }
fn menu_action_undo() -> u32 { return screen::menu_action_undo(); }
fn menu_action_redo() -> u32 { return screen::menu_action_redo(); }
fn menu_action_cut() -> u32 { return screen::menu_action_cut(); }
fn menu_action_copy() -> u32 { return screen::menu_action_copy(); }
fn menu_action_paste() -> u32 { return screen::menu_action_paste(); }
fn menu_action_select_all() -> u32 { return screen::menu_action_select_all(); }
fn menu_action_find() -> u32 { return screen::menu_action_find(); }
fn menu_action_find_next() -> u32 { return screen::menu_action_find_next(); }
fn menu_action_find_previous() -> u32 { return screen::menu_action_find_previous(); }
fn menu_action_find_replace() -> u32 { return screen::menu_action_find_replace(); }
fn null_enabled_fn() -> fn(*u8) -> bool { return screen::null_enabled_fn(); }
fn null_title_fn() -> fn(*u8) -> text::Text { return screen::null_title_fn(); }

fn chrome_of_window[W: Window](ref w: W) -> Chrome {
    return screen::Chrome::new(
        title: w.title(),
        width: w.width(),
        height: w.height(),
        min_width: w.min_width(),
        min_height: w.min_height(),
        bar: w.bar(),
        maximizable: w.is_maximizable(),
        minimizable: w.is_minimizable(),
        max_width: w.max_width(),
        max_height: w.max_height(),
        zoomable: w.wants_pinch_zoom(),
        min_zoom: w.min_zoom(),
        max_zoom: w.max_zoom(),
    );
}

// ---- the hosts ----------------------------------------------------------------
//
// The three simple hosts keep their tree in a LOCAL, exactly as the macOS
// facade does, and for the same reason: the frame that calls `run_loop` never
// unwinds, so its locals live as long as the window does.
//
// `App::run` cannot. Its screens are built and replaced from a nav callback,
// long after `run` entered the loop, so each one is boxed and held in a static
// — see `show_route`.

static HELD_ROOT: *core::Node = 0 as *core::Node;

fn hold_root(take root: Node) -> *core::Node {
    return match box::new::[Node](root) {
        option::Option[box::Box[Node]]::Some(b) => {
            let p: *core::Node = b.into_raw() as *core::Node;
            HELD_ROOT = p;
            p
        }
        option::Option[box::Box[Node]]::None => 0 as *core::Node,
    };
}

// ---- the agent surface, for every host ---------------------------------------
//
// WHICH HOST AN APP IS ON IS NOT A REASON FOR ITS AGENT SURFACE TO DIFFER, and
// it used to be the whole reason: `agent_mcp` was a method on `App`, so the
// three blocking hosts — `run`, `run_component`, `run_screen` — had no way to
// ask for one at all. A scaffolded app is on `run_screen` (AGENTS.md prescribes
// it, because facet's Android facade does not implement `App::run`), so the
// generated shape was exactly the shape that could not serve. See plan.md.
//
// ONE STORAGE, at process scope, because that is what the thing being described
// actually is: one address, one accept loop, latched once by
// `facet_agent::serve_once`. `App::agent_mcp` writes here too.
//
// Setting it is not enough on its own — the app still calls
// `facet_agent::enable()` to fill the serving seam, exactly as the `App` tier
// has always required.
static AGENT_ID: text::Text = #zero::[text::Text]();

// Serve the agent surface under the name `id`. Call before the host, on any
// tier. AN ID, NOT AN ADDRESS: see the macOS facade for why, and
// `agent_mcp::uds_path` / `agent_mcp::loopback_port` for the conventions.
fn agent_mcp(id: str) {
    AGENT_ID = text::from_str(id);
}

// The name this process serves under, or "" if the app never asked.
fn agent_id() -> str { return AGENT_ID.view(); }

// Start the worker if an address was named. Called by every host, BEFORE the
// first window, so an agent that connects immediately waits on an empty surface
// for a moment rather than being refused by a socket that does not exist yet.
// `serve_once` latches, so a host that later opens more windows is a no-op
// after the first.
fn serve_agent_if_asked() {
    let id: str = AGENT_ID.view();
    if id != "" { app::agent_serve_once(id); }
}

fn run[W: Window](take window: W) {
    backend::install();
    serve_agent_if_asked();
    host::set_popped(pushed_gone);
    var owned_window: W = window;
    var root: Node = owned_window.root();
    let c: Chrome = chrome_of_window(owned_window);
    let _w: *u8 = host::open_window(
        #addr_of(root), c,
        should_close: owned_window.should_close_callback(),
        should_close_ctx: owned_window.lifecycle_context(),
        will_close: owned_window.will_close_callback(),
        will_close_ctx: owned_window.lifecycle_context(),
    );
    // The window is built INSIDE this call, at launch, and it does not return.
    // `root` and `owned_window` are locals of a frame that therefore never
    // unwinds — which is what makes taking their addresses safe here, exactly
    // as the macOS facade relies on its own blocking loop.
    host::run_loop();
}

fn default_should_close(ctx: *u8) -> bool { return true; }
fn default_will_close(ctx: *u8) { return; }

// `on_attach` FIRES AT LAUNCH, NOT HERE.
//
// The macOS facade calls it straight after `open_window`, and that is correct
// there because the mount happened inside that call. On iOS `open_window` only
// RECORDS — the window does not exist until `UIApplicationMain` reaches the
// launch hook — so the same line would run against a tree nothing has mounted.
// Measured in the simulator: `mount::find` answered None, and the app came up
// with its shell and no content at all.
//
// So the component's address and a monomorphised trampoline go to the host,
// which fires them once the tree is live. The address is stable because the
// frame that owns it never unwinds.
fn attach_trampoline[C: component::Component + component::Lifecycle](ctx: *u8) {
    let p: *C = ctx as *C;
    { (*p).on_attach(component::Attach::Mount) };
}

// A component that owns its own lifetime.
//
// DOES NOT RETURN, so the `-> C` in the signature is a shape shared with the
// macOS facade rather than a value an application can use. The component is
// held in a boxed static for the process's life, which is what keeps the
// handlers bound in `build(ref this)` pointing at a live instance.
fn run_component[C: component::Component + component::Lifecycle](
    take component_v: C,
    title: str = "facet",
    width: f64 = 480.0f64,
    height: f64 = 360.0f64,
    // The zoom trio, forwarded like the other three. `run_component` built a
    // Chrome naming only title/width/height, so content magnification was
    // unreachable from the simple entry on BOTH platforms however well the
    // backend implemented it — an app had to adopt `screen::Screen` to ask for a
    // feature that has nothing to do with screens.
    zoomable: bool = false,
    min_zoom: f64 = 1.0f64,
    max_zoom: f64 = 4.0f64,
    // The BAR, forwarded for the same reason as the zoom trio above and
    // discovered the same way. A `split` whose leading pane is
    // `PaneRole::Sidebar` only looks like the platform's own sidebar when the
    // window is full-size-content with its title hidden — on macOS that is
    // what puts the sidebar against the top of the window and the traffic
    // lights on top of it. `Bar::Blended` already says exactly that, and
    // `run_component` could not reach it, so the simple entry could ask for a
    // sidebar and never get the thing that makes one look right.
    bar: screen::Bar = screen::Bar::Native,
    take menu: AppMenu = screen::empty_app_menu(),
) -> C {
    backend::install();
    serve_agent_if_asked();
    host::set_popped(pushed_gone);
    var owned_menu: AppMenu = menu;
    host::install_app_menu(#addr_of(owned_menu));
    var owned: C = component_v;
    var root: Node = owned.build();
    let _w: *u8 = host::open_window(
        #addr_of(root), screen::Chrome::new(title: title, width: width, height: height,
                                           zoomable: zoomable, min_zoom: min_zoom,
                                           max_zoom: max_zoom));
    nav::set_close_fn(close_current);
    host::set_launched(attach_trampoline::[C], #addr_of(owned) as *u8);
    // THE APP LIFECYCLE. No matching unbind, and that is not an oversight:
    // `run_loop` below never returns, so this frame is immortal and `owned`
    // outlives every event that could reach it. The desktop hosts, whose loop
    // DOES return, unbind before the frame unwinds.
    let _bound: status::Status = component::bind_app_lifecycle::[C](#addr_of(owned));
    host::run_loop();   // does not return
    // Unreachable in a running app, and `owned` is returned rather than
    // rebuilt so the SHAPE matches the macOS facade exactly — an application
    // that reads the returned component compiles identically on both, and only
    // the platform note above says why it never arrives here.
    return owned;
}

fn run_screen[S: component::Component + component::Lifecycle + screen::Screen](
    take screen_v: S,
    take menu: AppMenu = screen::empty_app_menu(),
) -> S {
    backend::install();
    serve_agent_if_asked();
    host::set_popped(pushed_gone);
    var owned: S = screen_v;
    var owned_menu: AppMenu = menu;
    owned_menu.extend(owned.menu_items());
    host::install_app_menu(#addr_of(owned_menu));
    let c: Chrome = owned.chrome();
    var root: Node = owned.build();
    let _w: *u8 = host::open_window(#addr_of(root), c);
    nav::set_close_fn(close_current);
    host::set_launched(attach_trampoline::[S], #addr_of(owned) as *u8);
    // THE APP LIFECYCLE. No matching unbind, and that is not an oversight:
    // `run_loop` below never returns, so this frame is immortal and `owned`
    // outlives every event that could reach it. The desktop hosts, whose loop
    // DOES return, unbind before the frame unwinds.
    let _bound: status::Status = component::bind_app_lifecycle::[S](#addr_of(owned));
    host::run_loop();   // does not return
    return owned;
}

// ---- modal verbs ---------------------------------------------------------------
//
// NOT BUILT, and named rather than approximated. `UIAlertController` is the iOS
// answer and every one of its actions carries a HANDLER BLOCK — the same block
// bridge `popup`'s UIMenu and the web tier are waiting on. An alert whose
// buttons cannot call back is not an alert.
//
// facet's own sheet answer (an ordinary facet tree in a window, so an agent can
// reach it by key) is the better port anyway, and it needs the modal
// presentation tier rather than UIAlertController.

fn alert(title: str, message: str, primary: str, secondary: str = "",
         on_answer: fn(i32, *u8) = 0 as fn(i32, *u8),
         on_answer_ctx: *u8 = 0 as *u8) {
    dialogs::alert(title, message, primary, secondary, on_answer, on_answer_ctx);
    return;
}

fn choose(title: str, message: str, take options: vec::Vec[text::Text],
          on_answer: fn(i32, *u8) = 0 as fn(i32, *u8),
          on_answer_ctx: *u8 = 0 as *u8) {
    // Owned so the list outlives the call that built it: the alert is presented
    // and this returns, and the buttons were already made from these strings.
    var owned: vec::Vec[text::Text] = options;
    dialogs::choose(title, message, #addr_of(owned), on_answer, on_answer_ctx);
    return;
}

// `initial` IS THE LEDGER'S `initialValue`, and it is a different thing from
// `placeholder`: one is the hint shown while the field is EMPTY, the other is
// what the field starts with and what a person then edits. The row declares
// both — `DisplayPromptAsync(title, message, accept, cancel, placeholder,
// maxLength, keyboard, initialValue)` — and only the hint reached this
// signature, so a Rename opened on nothing and the old name sat greyed out
// behind the caret.
//
// APPENDED LAST, so no caller that passes positionally moves.
fn prompt(title: str, message: str, placeholder: str = "", primary: str = "OK",
          secondary: str = "Cancel",
          on_typed: fn(str, *u8) = 0 as fn(str, *u8),
          on_typed_ctx: *u8 = 0 as *u8,
          on_answer: fn(i32, *u8) = 0 as fn(i32, *u8),
          on_answer_ctx: *u8 = 0 as *u8,
          initial: str = "") {
    dialogs::prompt(title, message, placeholder, primary, secondary,
                    on_typed, on_typed_ctx, on_answer, on_answer_ctx,
                    initial: initial);
    return;
}

// A BLOCKING alert cannot exist here at all, and not because it is unbuilt: iOS
// has no nested modal run loop an application may spin. The main loop is
// UIKit's and blocking it is how an app gets killed by the watchdog.
fn alert_blocking(title: str, message: str, primary: str, secondary: str = "") -> i32 {
    not_on_ios("alert_blocking");
    return -1;
}

// A file system browser. `UIDocumentPickerViewController` is the iOS answer and
// it is presentation + a delegate, not a blocking call — so the BLOCKING shape
// these two have cannot be honoured here whatever gets built later.
fn choose_directory() -> option::Option[text::Text] {
    not_on_ios("choose_directory");
    return option::Option[text::Text]::None;
}

fn choose_file() -> option::Option[text::Text] {
    not_on_ios("choose_file");
    return option::Option[text::Text]::None;
}

// THE CLIPBOARD IS NOT ONE OF THE ABSENT ONES. A phone has no file picker of
// this shape and it very much has a pasteboard, so these forward like any
// other service rather than answering `not_on_ios`.
fn copy_text(s: str) -> bool { return clipboard::copy_text(s); }
fn paste_text() -> option::Option[text::Text] { return clipboard::paste_text(); }

// ---- secondary windows -----------------------------------------------------------
// There are none. A phone has one window; a second "window" on iOS is a
// presented view controller, which is the modal tier above and is not built.
// A SHEET, not a second window. `width` and `height` are a desktop window's
// size and a sheet has none of its own — iOS sizes it from the presentation
// style — so both are read and ignored, which MANIFEST.md records rather than
// pretending the numbers landed.
fn present_window(take root: Node, title: str, width: f64, height: f64) {
    let _w: f64 = width;
    let _h: f64 = height;
    let tp: *core::Node = match box::new::[Node](root) {
        option::Option[box::Box[Node]]::Some(b) => { b.into_raw() } as *core::Node,
        option::Option[box::Box[Node]]::None => 0 as *core::Node,
    };
    if tp.is_null() { return; }
    if !mount::mount(tp) { return; }
    let _ok: bool = host::present_screen(tp, title, 0 as *u8);
}

// An application may not close, minimise or zoom its own window. Apple rejects
// apps that terminate themselves; the user leaves an app, the app does not
// leave the user.
fn window_close(sender: *u8) { not_on_ios("window_close"); return; }
fn window_minimize(sender: *u8) { not_on_ios("window_minimize"); return; }
fn window_zoom(sender: *u8) { not_on_ios("window_zoom"); return; }

// ---- observers and reads ----------------------------------------------------------

// Points to pixels. The screen's scale, which on a phone is the whole answer:
// there is one screen and a window cannot be dragged to another.
fn display_density() -> f64 {
    return host::display_density();
}

// A phone's density never changes — the window cannot move between screens —
// so an observer here would be a handle that can never fire. `Cancellable::none`
// says so; a live handle that never fires would not.
fn observe_display_density(cb: fn(*u8), ctx: *u8 = 0 as *u8) -> services::Cancellable {
    return services::Cancellable::none();
}

// "Active" on iOS is the app being frontmost, which is what the window's key
// status means on a desktop — the same question, asked of the application.
fn is_window_active() -> bool {
    return host::is_app_active();
}

// The window's size, which on a phone changes exactly when the device rotates.
// `services::observe_size` over the window's root node is the same machinery a
// node-level observer uses — the root IS the window's content, so watching it
// is watching the window.
fn observe_window_size(cb: fn(*u8), ctx: *u8 = 0 as *u8) -> services::Cancellable {
    let root: *core::Node = app::window_root(0 as usize);
    if root.is_null() { return services::Cancellable::none(); }
    return services::observe_size(root, cb, ctx);
}

// Backgrounding / resumed / stopped. THE ONE PLACE THIS PLATFORM IS RICHER:
// these three are real, frequent, user-visible moments on a phone, where on a
// desktop they are hide, unhide and terminate.
//
// NOTIFICATIONS, NOT THE APP DELEGATE, and that is a correction rather than a
// preference. These five verbs used to ride `applicationDidEnterBackground:`
// and its three siblings through a backend-local `observe_lifecycle`, and UIKit
// does not send any of those four to an app that has adopted UIScene — which
// every app scaffolded by `cpc new` has. They fired for nobody. The
// `UIApplication*Notification` names carry neither the "not called" note nor
// the iOS 26 deprecation the delegate methods do, and they post regardless of
// scene adoption. See `bugs/closed/ios-lifecycle-verbs-never-fire-under-scenes.md`.
//
// This is now structurally the same file as `runtime_macos.cplus`, which
// answers the same five verbs through `akx::observe_named`.
fn observe_backgrounding(cb: fn(*u8), ctx: *u8 = 0 as *u8) -> services::Cancellable {
    let id: u64 = notify::observe_named("UIApplicationDidEnterBackgroundNotification",
                                        0 as *u8, cb, ctx);
    return services::Cancellable::of(id, notify::cancel_observe);
}

fn observe_resumed(cb: fn(*u8), ctx: *u8 = 0 as *u8) -> services::Cancellable {
    let id: u64 = notify::observe_named("UIApplicationWillEnterForegroundNotification",
                                        0 as *u8, cb, ctx);
    return services::Cancellable::of(id, notify::cancel_observe);
}

// `stopped` is TERMINATION, and on iOS it is the one lifecycle edge that is not
// guaranteed: a backgrounded app is usually killed without
// `applicationWillTerminate:` ever being sent. The notification is wired
// because it does arrive when the app is quit while foregrounded, and
// MANIFEST.md records that an app which needs to save state should save it on
// BACKGROUNDING instead.
//
// Worth knowing while reading the report above: `applicationWillTerminate:` is
// the ONE of the delegate's lifecycle methods that carries neither the
// "not called under scenes" note nor a deprecation, so this verb was probably
// the only one of the five that ever worked. It moves to the notification
// anyway — five verbs on one mechanism beats four on one and a survivor on
// another.
fn observe_stopped(cb: fn(*u8), ctx: *u8 = 0 as *u8) -> services::Cancellable {
    let id: u64 = notify::observe_named("UIApplicationWillTerminateNotification",
                                        0 as *u8, cb, ctx);
    return services::Cancellable::of(id, notify::cancel_observe);
}

// "Window active" on iOS is the APPLICATION being frontmost and interactive,
// which is what `didBecomeActive` / `willResignActive` mean — the same question
// a desktop asks of a window, asked of the app, exactly as `is_window_active`
// already answers it.
fn observe_window_active(cb: fn(*u8), ctx: *u8 = 0 as *u8) -> services::Cancellable {
    let id: u64 = notify::observe_named("UIApplicationDidBecomeActiveNotification",
                                        0 as *u8, cb, ctx);
    return services::Cancellable::of(id, notify::cancel_observe);
}

fn observe_window_inactive(cb: fn(*u8), ctx: *u8 = 0 as *u8) -> services::Cancellable {
    let id: u64 = notify::observe_named("UIApplicationWillResignActiveNotification",
                                        0 as *u8, cb, ctx);
    return services::Cancellable::of(id, notify::cancel_observe);
}

// An explicit light/dark choice overriding the system's:
// `overrideUserInterfaceStyle` on the window, which is exactly the macOS verb's
// meaning and one of the few window-level properties iOS does have.
fn set_app_appearance(a: vocab::Appearance) {
    host::set_app_appearance(a);
}

fn app_appearance() -> vocab::Appearance {
    return host::app_appearance();
}

// The window's frame IS the screen's bounds, and it cannot be set — which is a
// read that works and a write that never can.
fn window_frame() -> vocab::Rect {
    return host::window_frame();
}

fn set_window_frame(frame: vocab::Rect) { not_on_ios("set_window_frame"); return; }

// ---- App ---------------------------------------------------------------------
// The same surface as the macOS facade. `run` differs in the one way the header
// of this file describes: it shows the first screen and enters the loop, and
// navigation swaps the screen inside the one window rather than cycling
// windows.

fn app_hook_noop(ctx: *u8) { return; }

// AN APP IS AN INSTANCE, AND THIS IS A HANDLE TO ONE. The runtime owns the
// instance (`app::new_instance`); the caller owns a name for it. Every other
// facet tier already works this way — `Label`, `Button`, `window::Window`,
// `screen::Cursor` — and App was the last one where the caller held the thing
// itself.
//
// That is not a tidy-up. `App::run` on Android sets up and RETURNS, because the
// Activity owns the loop — so an App the caller owned was dropped the moment
// `main` unwound, leaving `app::make_current` and the route registry pointing
// at freed memory. It is why Android had no App tier at all.
//
// The state lives in `app::Application`, which is where application.cplus says
// app-scoped state goes. It used to be declared FIVE times, once per facade.
struct App {
    opaque _p: *app::Application,
}

impl App {
    fn new(name: str = "facet") -> App {
        let p: *app::Application = app::new_instance(name);
        { (*p).on_launch_fn = app_hook_noop };
        { (*p).on_quit_fn = app_hook_noop };
        return App { _p: p };
    }

    fn name(this) -> str { return app::instance_name(this._p); }

    fn menu(this, build: fn() -> AppMenu) { { (*this._p).menu_fn = build as *u8 }; return; }

    fn screen(this, name: str, factory: fn() -> screen::ScreenBox) {
        app::add_route(this._p, name, factory as *u8);
    }

    fn agent_mcp(this, id: str = "") {
        if id == "" { agent_mcp(this.name()); return; }
        agent_mcp(id);
    }

    fn on_launch(this, f: fn(*u8), ctx: *u8 = 0 as *u8) {
        { (*this._p).on_launch_fn = f };
        { (*this._p).hook_ctx = ctx };
    }

    fn on_quit(this, f: fn(*u8)) { { (*this._p).on_quit_fn = f }; return; }


    // ---- the app's environment ------------------------------------------------
    // Facts about THIS app, living for its life. Not `stdlib::env` — that is the
    // OS's — and deliberately without a change channel: if the UI must update
    // when a value changes, it belongs in a `resource`.
    //
    // `@` keys are C+'s and facet's (`@platform`, `@arch`, `@target`,
    // `@app.name`, `@backend`), and `set_env` refuses them so an application
    // cannot tell an agent it is something it is not.
    fn env(this, key: str) -> str { return app::env_in(this._p, key); }
    fn set_env(this, key: str, value: str) -> bool {
        return app::set_env_in(this._p, key, value);
    }
    fn env_flag(this, key: str) -> bool { return app::env_flag_in(this._p, key); }
    fn set_env_flag(this, key: str, on: bool) -> bool {
        return app::set_env_flag_in(this._p, key, on);
    }
    fn has_env(this, key: str) -> bool { return app::has_env_in(this._p, key); }
    fn clear_env(this, key: str) -> bool { return app::clear_env_in(this._p, key); }
    fn env_keys(this) -> vec::Vec[text::Text] { return app::env_keys_in(this._p); }

    // ---- what the app is showing ----------------------------------------------
    // Sugar over the window and screen tiers, and worth having: the app is the
    // thing a caller already has in hand.
    fn windows(this) -> vec::Vec[window::Window] { return window::all(); }
    fn window_keys(this) -> vec::Vec[text::Text] { return window::keys(); }
    fn screens(this) -> vec::Vec[screen_mod::Cursor] { return screen_mod::stack(); }
    fn is_running(this) -> bool { return app::has_current(); }

    // The one place that knows both sides of the *u8 the record stores.
    fn route_factory(this, route: str) -> fn() -> screen::ScreenBox {
        return app::route_factory(this._p, route) as fn() -> screen::ScreenBox;
    }

    fn build_menu(this) -> AppMenu {
        let f: fn() -> AppMenu = { (*this._p).menu_fn } as fn() -> AppMenu;
        if f.is_not_null() { return f(); }
        var m: AppMenu = screen::app_menu(this.name());
        m.add_item(this.name(), "Quit", "q", screen::menu_action_quit());
        return m;
    }

    // Show `initial` and enter the loop. DOES NOT RETURN in a running app: the
    // status is the one the caller would have got had the initial route failed
    // to resolve, which is the only outcome reachable from here.
    //
    // `on_quit` is never called, and that is iOS rather than an omission —
    // there is no moment between "the app is running" and "the process is
    // gone". An app that needs to persist state uses `observe_backgrounding`,
    // which is the hook the platform actually gives for it.
    fn run(this, initial: str, arg: str = "") -> status::Status {
        backend::install();
    host::set_popped(pushed_gone);
        app::make_current(this._p);
        nav::reset(arg);
        nav::set_close_fn(close_current);
        nav::set_push_fn(push_screen);
        nav::set_pop_fn(pop_screen);
        // The stack IS the platform's here, so its depth is a real answer and
        // a back button can ask it. `pop_to` waits for the shared stack (step
        // 2) — this host's entries carry no route to look for.
        nav::set_depth_fn(stack_depth);
        // The backend's door into the route registry, for a scene it is asked
        // to connect. See `scene_build`.
        host::set_scene_build_fn(scene_build);
        host::set_scene_attached_fn(scene_attached);
        host::set_scene_gone_fn(scene_gone);
        serve_agent_if_asked();
        let launch: fn(*u8) = { (*this._p).on_launch_fn };
        if launch.is_not_null() { launch({ (*this._p).hook_ctx }); }
        // The route resolves NOW — a bad route name should fail before the
        // process is handed to UIKit — but the screen is shown at LAUNCH, for
        // the same reason `on_attach` is fired there.
        if { (*(#addr_of(this) as *App)).route_factory(initial) } == (0 as fn() -> screen::ScreenBox) {
            nav::clear_hooks();
            app::release_current();
            return status::Status::InvalidInput;
        }
        PENDING_ROUTE = text::from_str(initial);
        host::set_launched(show_pending, 0 as *u8);
        host::run_loop();   // does not return
        return status::Status::Ok;
    }
}

// ---- the screen swap -------------------------------------------------------------
// The iOS shape of navigation: there is one window, and `nav::go` replaces what
// it shows. The macOS facade closes a window and lets `App::run`'s loop open the
// next; here the loop is UIKit's and cannot be re-entered, so the swap happens
// inside the nav hook itself.

// NO `CURRENT_APP` STATIC. It used to hold `#addr_of(this)` from inside `run`,
// which was the address of a by-value parameter and survived only because
// `run_loop()` never returns on this platform — correct by accident, and the
// kind of thing that stops being correct the moment anything else calls `run`.
// `app::current()` is the one door now, and the App handle is that pointer
// wearing the App type.
static CURRENT_SB: *u8 = 0 as *u8;
static PENDING_ROUTE: text::Text = #zero::[text::Text]();

// The launch hook for an App: show the initial screen once the window exists.
fn show_pending(ctx: *u8) {
    let _ok: bool = show_route(PENDING_ROUTE.view());
}

fn show_route(route: str) -> bool {
    if !app::has_current() { return false; }
    let f: fn() -> screen::ScreenBox =
        app::route_factory(app::current(), route) as fn() -> screen::ScreenBox;
    if f.is_null() { return false; }
    var sb: screen::ScreenBox = f();
    if !sb.valid() { return false; }
    // The app's menu plus THIS screen's contribution — built for parity with
    // the macOS facade, and installed into a backend that has no menu bar.
    var bar: AppMenu = App { _p: app::current() }.build_menu();
    bar.extend(sb.menu_items());
    host::install_app_menu(#addr_of(bar));
    let c: Chrome = sb.chrome();
    let p: *core::Node = hold_root(sb.build());
    if p.is_null() { return false; }
    // Tear the previous screen down only once the new one is built: a failed
    // build would otherwise leave the window showing nothing at all.
    drop_current_screen();
    // NO `agent_attach` HERE, and the macOS facade's matching line is not an
    // omission. `open_window` on this platform only RECORDS; the tree becomes
    // live inside facet_uikit's `attach_root`, which is where the attach is —
    // ONE site, covering `run`, `run_component`, `run_screen` and this one.
    // `run` in particular has no launch hook of its own to hang a facade-side
    // attach on, so four call sites here would still have left a hole.
    let _w: *u8 = host::open_window(p, c);
    match box::new::[screen::ScreenBox](sb) {
        option::Option[box::Box[screen::ScreenBox]]::Some(b) => {
            let sp: *screen::ScreenBox = b.into_raw() as *screen::ScreenBox;
            CURRENT_SB = sp as *u8;
            { (*sp).on_attach(component::Attach::Mount) };
            // THE APP LIFECYCLE. `run_component` and `run_screen` bind their own
            // component; the App loop never bound the ScreenBox, so a screen
            // shown through a ROUTE never learned the app had backgrounded — and
            // on this platform that is where an exclusive device has to be given
            // back. The box is heap-held and never freed, so the address is good
            // for the life of the subscription.
            let _bound: status::Status =
                component::bind_app_lifecycle::[screen::ScreenBox](sp);
        }
        option::Option[box::Box[screen::ScreenBox]]::None => { }
    }
    return true;
}

fn drop_current_screen() {
    if CURRENT_SB.is_null() { return; }
    let sp: *screen::ScreenBox = CURRENT_SB as *screen::ScreenBox;
    let _unbound: status::Status =
        component::unbind_app_lifecycle::[screen::ScreenBox](sp);
    { (*sp).on_detach(component::Detach::Unmount) };
    CURRENT_SB = 0 as *u8;
    // The ScreenBox and the tree it built are deliberately NOT freed. A worker
    // may still be inside the screen's data, and the macOS facade settles the
    // job queue before dropping — which it can do because its loop returned.
    // There is no such moment here, so the honest choice is to leak one screen
    // per navigation rather than free something a queued apply still holds.
    // MANIFEST.md records it: the fix is a settle that runs ON the loop, not
    // after it.
}

// nav::go / nav::quit while a loop runs.
fn close_current() {
    let taken: u32 = nav::take();
    if taken == nav::intent_go() {
        let _ok: bool = show_route(nav::target());
        return;
    }
    if taken == nav::intent_quit() {
        // There is nothing to quit to. An iOS app that calls `exit()` looks to
        // the user like a crash, and Apple rejects it — so the intent is
        // reported and refused rather than honoured badly.
        not_on_ios("nav::quit");
    }
}

// Pushed screens are a modal presentation on iOS — the tier `alert` and
// `present_window` also wait on. Refused rather than silently doing nothing:
// `nav::push` answers false, which is what its callers check.
// ---- a second window, on an iPad that opted in ----------------------------------
// The `Show::Window` half of the rule on this platform. An iPhone has one
// window and `activate_scene` answers false there, so the push falls through to
// the stack — which is the rule working ("with whatever room this platform
// has"), not a degradation. An iPad whose plist says
// `UIApplicationSupportsMultipleScenes` gets a real second window.

// What the pending scene is for. UIKit connects a scene asynchronously, so the
// route it was asked for has to survive the gap; the KEY rides in the
// NSUserActivity and this carries the rest. One at a time, main-thread only.
static PENDING_ROUTE_FOR_SCENE: text::Text = #zero::[text::Text]();
static PENDING_ARG_FOR_SCENE: text::Text = #zero::[text::Text]();

// THE BACKEND'S DOOR INTO THE ROUTE REGISTRY. facet_uikit cannot resolve a
// route — the registry is the runtime's — so it calls this when a scene
// connects asking for one. Answers the tree to show, or null for a route
// nothing answers, which gives an empty window rather than a crash.
fn scene_build(key: str) -> *core::Node {
    if !app::has_current() { return 0 as *core::Node; }
    // A LIVE PUSH knows its own route and argument. A RESTORED scene does not —
    // the process is new — so the key is all there is, and the key is
    // `route` or `route:arg` by construction (nav::key_for). Splitting it back
    // is what lets a window iPadOS restored come back with its screen in it.
    //
    // A key that came from an explicit `key:` override cannot be split, so it
    // resolves to no route and the backend throws the scene away rather than
    // showing a blank one. That is the honest limit of restoring from a name.
    var route: str = PENDING_ROUTE_FOR_SCENE.view();
    var arg: str = PENDING_ARG_FOR_SCENE.view();
    if route == "" {
        // A RESTORED scene: the key is all there is. `nav::route_of_key` is the
        // inverse of the `nav::key_for` that wrote it, and the pair is pinned by
        // a round-trip test — including an argument that itself contains a colon
        // (`open:file:///tmp/a`), which a split written here got right by luck.
        route = nav::route_of_key(key);
        arg = nav::arg_of_key(key);
    }
    if route == "" { return 0 as *core::Node; }
    let f: fn() -> screen::ScreenBox =
        app::route_factory(app::current(), route) as fn() -> screen::ScreenBox;
    if f.is_null() { return 0 as *core::Node; }
    nav::adopt_push_args(arg);
    var sb: screen::ScreenBox = f();
    if !sb.valid() { return 0 as *core::Node; }
    let tp: *core::Node = match box::new::[Node](sb.build()) {
        option::Option[box::Box[Node]]::Some(b) => { b.into_raw() } as *core::Node,
        option::Option[box::Box[Node]]::None => 0 as *core::Node,
    };
    if tp.is_null() { return 0 as *core::Node; }
    let sbp: *u8 = match box::new::[screen::ScreenBox](sb) {
        option::Option[box::Box[screen::ScreenBox]]::Some(b) => b.into_raw(),
        option::Option[box::Box[screen::ScreenBox]]::None => 0 as *u8,
    };
    if sbp.is_null() { return 0 as *core::Node; }
    // The window's own screen gets the same lifecycle every other one does.
    let _bound: status::Status =
        component::bind_app_lifecycle::[screen::ScreenBox](sbp as *screen::ScreenBox);
    // `on_attach` IS NOT FIRED HERE. The tree is not in a window yet — this
    // function only builds it — so a screen calling `mount::find` would get
    // None. `scene_attached` below is the seam, and the backend calls it once
    // the tree is mounted.
    PENDING_SCENE_SB = sbp;
    return tp;
}

static PENDING_SCENE_SB: *u8 = 0 as *u8;

// The backend, when this window has GONE — the user closed it, the system
// reclaimed it, or `destroy_scene` asked. Fires the screen's teardown the way
// every other window close in facet does.
//
// The box is NOT freed, for the reason every facade records: a queued apply may
// still be inside this screen's data and the next screen is allocated into
// whatever this frees.
fn scene_gone(key: str) {
    let sbp: *u8 = scene_screen_take(key);
    if sbp.is_null() { return; }
    let _unbound: status::Status =
        component::unbind_app_lifecycle::[screen::ScreenBox](sbp as *screen::ScreenBox);
    { (*(sbp as *screen::ScreenBox)).on_detach(component::Detach::Unmount) };
}

// One entry per open scene screen, so a close can find the box its window was
// showing. Small and fixed-shape: an app has a handful of windows, not a
// thousand.
static SCENE_KEYS: vec::Vec[text::Text] = #zero::[vec::Vec[text::Text]]();
static SCENE_SBS: vec::Vec[usize] = #zero::[vec::Vec[usize]]();

fn scene_screen_put(key: str, sbp: *u8) {
    let _a: status::Status = SCENE_KEYS.append(text::from_str(key));
    let _b: status::Status = SCENE_SBS.append({ #addr(sbp) });
}

fn scene_screen_take(key: str) -> *u8 {
    let n: usize = SCENE_KEYS.count();
    var i: usize = 0 as usize;
    while i < n {
        let hit: bool = match SCENE_KEYS.at_ptr(i) {
            option::Option[*text::Text]::Some(k) => ({ (*k).view() } == key),
            option::Option[*text::Text]::None => false,
        };
        if hit {
            let p: usize = match SCENE_SBS.at_ptr(i) {
                option::Option[*usize]::Some(v) => { (*v) },
                option::Option[*usize]::None => 0 as usize,
            };
            let _k: option::Option[text::Text] = SCENE_KEYS.remove(at: i);
            let _v: option::Option[usize] = SCENE_SBS.remove(at: i);
            return p as *u8;
        }
        i = i +% (1 as usize);
    }
    return 0 as *u8;
}

// The backend, once this window's tree is live.
fn scene_attached(key: str) {
    let sbp: *u8 = PENDING_SCENE_SB;
    PENDING_SCENE_SB = 0 as *u8;
    if sbp.is_null() { return; }
    scene_screen_put(key, sbp);
    { (*(sbp as *screen::ScreenBox)).on_attach(component::Attach::Mount) };
}

// Ask for a window. False when this app cannot have a second one, which is what
// makes the caller fall back to the stack.
fn open_scene(route: str, key: str, arg: str) -> bool {
    PENDING_ROUTE_FOR_SCENE = text::from_str(route);
    PENDING_ARG_FOR_SCENE = text::from_str(arg);
    return host::activate_scene(key);
}

// A PUSHED SCREEN IS A VIEW CONTROLLER ON THE STACK, which is the iOS shape of
// what macOS does with a second window. The back button and the swipe-back
// gesture come with the stack rather than being drawn here.
//
// The tree and the ScreenBox both outlive this frame, so both go to the heap;
// the box is what the host hands back when the screen goes, whichever way it
// went.
fn push_screen(route: str, key: str, arg: str, show: u32) -> bool {
    if !app::has_current() { return false; }
    // BOTH SHAPES ARE THE SAME THING HERE, and that is the rule working rather
    // than a degradation. `Show::Window` means "with whatever room this
    // platform has"; an iPhone has one window, so the room is a stack entry.
    // An iPad that opted into multiple scenes is where the two diverge, and
    // that is plans/nav-windows.md step 7.
    //
    // `key` is deliberately NOT used to name a window. A pushed screen here
    // lives inside the SAME UIWindow, so naming it would make
    // `window::find("settings")` answer on a phone — and the contract is that a
    // key names a window only where the platform gave that screen one. It names
    // the SCREEN, which is the tier that always exists.
    // A PEER WINDOW WHERE THERE IS ROOM. On an iPad that opted into multiple
    // scenes this is a real second window; everywhere else `open_scene` answers
    // false and the push becomes a stack entry, which is the same intent
    // rendered the way this platform can render it.
    if show == nav::show_code(nav::Show::Window) {
        if open_scene(route, key, arg) { return true; }
    }
    let f: fn() -> screen::ScreenBox =
        app::route_factory(app::current(), route) as fn() -> screen::ScreenBox;
    if f.is_null() { return false; }
    nav::adopt_push_args(arg);   // after the lookup: a failed push leaves them alone
    var sb: screen::ScreenBox = f();
    if !sb.valid() { return false; }
    let c: Chrome = sb.chrome();
    let tp: *core::Node = match box::new::[Node](sb.build()) {
        option::Option[box::Box[Node]]::Some(b) => { b.into_raw() } as *core::Node,
        option::Option[box::Box[Node]]::None => 0 as *core::Node,
    };
    if tp.is_null() { return false; }
    if !mount::mount(tp) { return false; }
    let sbp: *u8 = match box::new::[screen::ScreenBox](sb) {
        option::Option[box::Box[screen::ScreenBox]]::Some(b) => b.into_raw(),
        option::Option[box::Box[screen::ScreenBox]]::None => 0 as *u8,
    };
    if sbp.is_null() { return false; }
    if !host::push_screen(tp, c.title(), sbp) { return false; }
    { (*(sbp as *screen::ScreenBox)).on_attach(component::Attach::Mount) };
    let _bound: status::Status =
        component::bind_app_lifecycle::[screen::ScreenBox](sbp as *screen::ScreenBox);
    return true;
}

// Fires ONCE per pushed screen, whichever way it left — `nav::pop`, the back
// button, or the swipe-back gesture. The host cannot tell those apart and does
// not try: it reports what is no longer on the stack.
fn pushed_gone(box_: *u8) {
    if box_.is_null() { return; }
    let _unbound: status::Status =
        component::unbind_app_lifecycle::[screen::ScreenBox](box_ as *screen::ScreenBox);
    { (*(box_ as *screen::ScreenBox)).on_detach(component::Detach::Unmount) };
    // The ScreenBox and its tree are deliberately NOT freed, for the reason
    // `drop_current_screen` gives: there is no moment on this platform where
    // the loop has returned and the job queue is settled, so freeing something
    // a queued apply still holds would be worse than leaking it.
}

fn pop_screen() -> bool {
    return host::pop_screen();
}

// How deep the nav stack is — 0 at the root screen, which is what makes
// `nav::can_pop()` false there and lets the platform's own back behaviour
// through.
fn stack_depth() -> usize {
    return host::pushed_count();
}

// ---- app context ------------------------------------------------------------

// THE RUNNING APP, as a handle. One app runs at a time, so `app::current()` is
// the whole answer — the handle is that pointer wearing the App type.
//
// `runtime::app()` always answers: the running app, or the process default.
fn app() -> App {
    return App { _p: app::current() };
}

fn app_running() -> bool { return app::has_current(); }

fn app_name() -> str {
    if !app::has_current() { return ""; }
    return app::instance_name(app::current());
}

fn has_screen(route: str) -> bool {
    if !app::has_current() { return false; }
    return app::route_factory(app::current(), route).is_not_null();
}

fn register_screen(route: str, factory: fn() -> screen::ScreenBox) -> bool {
    if !app::has_current() { return false; }
    if has_screen(route) { return false; }
    app::add_route(app::current(), route, factory as *u8);
    return true;
}
