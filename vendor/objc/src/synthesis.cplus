// Objective-C class SYNTHESIS: build a class at runtime and install C+ functions
// as its method IMPs. This is how a generated binding implements a delegate or
// data source with no Objective-C source — the same machinery vendor/appkit
// uses for target/action and delegate objects. A synthesized delegate stores
// its C+ handler context as an associated object; each IMP trampoline reads it
// back and dispatches.

import "./runtime" as rt;

extern fn objc_allocateClassPair(superclass: *u8, name: *u8, extra_bytes: usize) -> *u8;
extern fn objc_registerClassPair(cls: *u8);

// PROTOCOL CONFORMANCE, which is not the same thing as having the methods.
//
// Some frameworks check `conformsToProtocol:` rather than `respondsToSelector:`
// and refuse a class that answers every message but claims nothing. UIKit's
// scene machinery is one: a synthesized class with
// `scene:willConnectToSession:options:` on it still dies at launch with
//
//     'representation's delegateClass must conform to UISceneDelegate protocol'
//
// because the check is on the protocol list, not the method list. The methods
// were all there. `class_addProtocol` is what was missing, and it must be called
// BEFORE `objc_registerClassPair` — a registered class cannot gain one.
extern fn objc_getProtocol(name: *u8) -> *u8;
extern fn class_addProtocol(cls: *u8, protocol: *u8) -> i8;

// `class_addMethod`, one extern per IMP ABI. Every IMP receives (self, _cmd, ...);
// delegate methods that take only object args use the `v_Nid` shapes (void
// return, N trailing `id` arguments after self/_cmd).
#[link_name = "class_addMethod"]
extern fn class_addMethod_v_0id(cls: *u8, sel: *u8, imp: fn(*u8, *u8), types: *u8) -> i8;
#[link_name = "class_addMethod"]
extern fn class_addMethod_v_1id(cls: *u8, sel: *u8, imp: fn(*u8, *u8, *u8), types: *u8) -> i8;
#[link_name = "class_addMethod"]
extern fn class_addMethod_v_2id(cls: *u8, sel: *u8, imp: fn(*u8, *u8, *u8, *u8), types: *u8) -> i8;
#[link_name = "class_addMethod"]
extern fn class_addMethod_v_3id(cls: *u8, sel: *u8, imp: fn(*u8, *u8, *u8, *u8, *u8), types: *u8) -> i8;
#[link_name = "class_addMethod"]
extern fn class_addMethod_v_4id(cls: *u8, sel: *u8, imp: fn(*u8, *u8, *u8, *u8, *u8, *u8), types: *u8) -> i8;
#[link_name = "class_addMethod"]
extern fn class_addMethod_v_5id(cls: *u8, sel: *u8, imp: fn(*u8, *u8, *u8, *u8, *u8, *u8, *u8), types: *u8) -> i8;

// Value-returning IMPs (data-source style: the callback hands a value back to
// the framework). `<ret>_Nid` = returns <ret>, N trailing object args. Covers
// the common delegate/data-source return types; grow as needed.
#[link_name = "class_addMethod"]
extern fn class_addMethod_id_0id(cls: *u8, sel: *u8, imp: fn(*u8, *u8) -> *u8, types: *u8) -> i8;
#[link_name = "class_addMethod"]
extern fn class_addMethod_id_1id(cls: *u8, sel: *u8, imp: fn(*u8, *u8, *u8) -> *u8, types: *u8) -> i8;
#[link_name = "class_addMethod"]
extern fn class_addMethod_id_2id(cls: *u8, sel: *u8, imp: fn(*u8, *u8, *u8, *u8) -> *u8, types: *u8) -> i8;
#[link_name = "class_addMethod"]
extern fn class_addMethod_id_3id(cls: *u8, sel: *u8, imp: fn(*u8, *u8, *u8, *u8, *u8) -> *u8, types: *u8) -> i8;
#[link_name = "class_addMethod"]
extern fn class_addMethod_id_4id(cls: *u8, sel: *u8, imp: fn(*u8, *u8, *u8, *u8, *u8, *u8) -> *u8, types: *u8) -> i8;
#[link_name = "class_addMethod"]
extern fn class_addMethod_i64_0id(cls: *u8, sel: *u8, imp: fn(*u8, *u8) -> i64, types: *u8) -> i8;
#[link_name = "class_addMethod"]
extern fn class_addMethod_i64_1id(cls: *u8, sel: *u8, imp: fn(*u8, *u8, *u8) -> i64, types: *u8) -> i8;
#[link_name = "class_addMethod"]
extern fn class_addMethod_i64_2id(cls: *u8, sel: *u8, imp: fn(*u8, *u8, *u8, *u8) -> i64, types: *u8) -> i8;
#[link_name = "class_addMethod"]
extern fn class_addMethod_u64_0id(cls: *u8, sel: *u8, imp: fn(*u8, *u8) -> u64, types: *u8) -> i8;
#[link_name = "class_addMethod"]
extern fn class_addMethod_u64_1id(cls: *u8, sel: *u8, imp: fn(*u8, *u8, *u8) -> u64, types: *u8) -> i8;
// One object arg then an NSInteger, returning NSUInteger — the shape of
// `draggingSession:sourceOperationMaskForDraggingContext:` (an NSDraggingSource).
#[link_name = "class_addMethod"]
extern fn class_addMethod_u64_1id_i64(cls: *u8, sel: *u8, imp: fn(*u8, *u8, *u8, i64) -> u64, types: *u8) -> i8;
#[link_name = "class_addMethod"]
extern fn class_addMethod_i16_0id(cls: *u8, sel: *u8, imp: fn(*u8, *u8) -> i16, types: *u8) -> i8;
#[link_name = "class_addMethod"]
extern fn class_addMethod_i8_1id(cls: *u8, sel: *u8, imp: fn(*u8, *u8, *u8) -> i8, types: *u8) -> i8;
#[link_name = "class_addMethod"]
extern fn class_addMethod_i8_2id(cls: *u8, sel: *u8, imp: fn(*u8, *u8, *u8, *u8) -> i8, types: *u8) -> i8;
#[link_name = "class_addMethod"]
extern fn class_addMethod_i8_3id(cls: *u8, sel: *u8, imp: fn(*u8, *u8, *u8, *u8, *u8) -> i8, types: *u8) -> i8;

// Associated objects carry the C+ handler context on the synthesized instance.
// OBJC_ASSOCIATION_ASSIGN = 0 (the context is a raw pointer we keep alive).
#[link_name = "objc_setAssociatedObject"]
extern fn objc_setAssociatedObject(object: *u8, key: *u8, value: *u8, policy: usize);
#[link_name = "objc_getAssociatedObject"]
extern fn objc_getAssociatedObject(object: *u8, key: *u8) -> *u8;

fn allocate_class_pair(superclass: *u8, name: *u8, extra_bytes: usize) -> *u8 {
    return { objc_allocateClassPair(superclass, name, extra_bytes) };
}

fn register_class_pair(cls: *u8) {
    { objc_registerClassPair(cls); };
}

// The protocol object of that name, or null if nothing in the process declares
// one. Null is the normal answer for a protocol whose framework is not linked.
fn get_protocol(name: *u8) -> *u8 {
    return { objc_getProtocol(name) };
}

// Declare that `cls` conforms. BEFORE `register_class_pair` — a registered class
// cannot gain a protocol, and the call quietly answers false if it is too late.
fn add_protocol(cls: *u8, protocol: *u8) -> i8 {
    if protocol == (0 as *u8) { return 0 as i8; }
    return { class_addProtocol(cls, protocol) };
}

// Name it and claim it, which is the whole of what a caller wants. False when
// the protocol is not in the process — an honest answer, since the framework
// that checks for it is then not there either.
fn conform(cls: *u8, name: *u8) -> i8 {
    return add_protocol(cls, get_protocol(name));
}

fn add_method_v_0id(cls: *u8, selector: *u8, imp: fn(*u8, *u8), types: *u8) -> i8 {
    return { class_addMethod_v_0id(cls, selector, imp, types) };
}

fn add_method_v_1id(cls: *u8, selector: *u8, imp: fn(*u8, *u8, *u8), types: *u8) -> i8 {
    return { class_addMethod_v_1id(cls, selector, imp, types) };
}

fn add_method_v_2id(cls: *u8, selector: *u8, imp: fn(*u8, *u8, *u8, *u8), types: *u8) -> i8 {
    return { class_addMethod_v_2id(cls, selector, imp, types) };
}

