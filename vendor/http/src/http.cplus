// http — HTTP(S) requests over the operating system's own stack.
//
// WHAT IT BINDS. NSURLSession, and nothing else. TLS, certificate validation,
// DNS, connection reuse, HTTP/2 and HTTP/3, proxy and VPN configuration,
// System Settings' privacy switches — every one of those is a thing Apple
// already ships, tests and patches, and re-implementing any of it here would
// be worse code shipping later. `stdlib/net` is TCP over numeric IPv4 with no
// DNS and no TLS; this package is the answer to "then how do I GET an https
// URL", and the reason a program should stop shelling out to `/usr/bin/curl`
// for one.
//
// NSURLSession is Foundation, not AppKit, so this one backend covers macOS and
// iOS both. The manifest links Foundation for the same reason.
//
// -------------------------------------------------------------------------
// THREADING CONTRACT
// -------------------------------------------------------------------------
//
// Every verb here BLOCKS the calling thread until the exchange finishes or the
// request's own timeout fires. That is the whole API — there is no async tier
// in v1.
//
// Call it off the main thread. Blocking the main thread does not deadlock
// (NSURLSession delivers completions on its own private queue, never on the
// main queue) but it freezes the UI for a network round trip, which is the
// same bug either way.
//
// In a facet app the shape is a service: produce off-main, apply on-main.
//
//     // off the UI thread — services::on_worker, a thread::spawn, a Job
//     fn fetch(ctx: *u8) {
//         match http::get("https://example.com/feed.json") {
//             result::Result[http::Response, http::Error]::Ok(r)  => { deliver(r); }
//             result::Result[http::Response, http::Error]::Err(e) => { report(e); }
//         }
//     }
//     // then hop the RESULT home with services::run_on_main before touching a
//     // view, or any state the mount walk reads.
//
// Internally the wait is a `dispatch_semaphore_t` and the completion handler
// is a hand-built Objective-C block. The handler runs on a background queue:
// it writes everything it collected into a slot on the waiting frame and
// signals LAST. `dispatch_semaphore_signal` is a release barrier and
// `dispatch_semaphore_wait` an acquire barrier, so write-before-signal /
// read-after-wait is the entire synchronisation story. Nothing else is shared
// across the two threads.
//
// -------------------------------------------------------------------------
// ROADMAP — the other platforms are NOT in scope
// -------------------------------------------------------------------------
//
// Each of these is the OS's own client, bound the same way this one is:
//
//   linux    libcurl (easy interface, blocking `curl_easy_perform`)
//   windows  WinHTTP (`WinHttpSendRequest` / `WinHttpReceiveResponse`)
//   android  JNI to `java.net.HttpURLConnection` (see vendor/jni)
//   esp32    `esp_http_client` from ESP-IDF (see vendor/espidf)
//
// When the second one lands, the file split follows the language's own
// mechanism: the platform-free half (Method / Header / Request / Response /
// Error) stays here and the transport moves to `transport.cplus`, shadowed per
// platform by `transport_linux.cplus` and friends. Splitting it before there
// is a second backend to shape the seam would be guesswork.

import "stdlib/text" as text;
import "stdlib/vec" as vec;
import "stdlib/option" as option;
import "stdlib/result" as result;
import "stdlib/status" as status;
import "objc/runtime" as rt;
import "objc/bridge" as bridge;

// ==========================================================================
// Error codes
// ==========================================================================

// Foundation's own failures arrive carrying their NSError code, and every
// NSURLErrorDomain code is NEGATIVE (-1009 offline, -1001 timed out, -1002
// unsupported URL, -1200 TLS failure, ...). So a POSITIVE code always means
// the request never left this process, and these are the only three ways that
// happens.
//
// All three are rare, and the first is rarer than it looks: modern Foundation
// percent-escapes almost anything rather than refusing it, so a URL a human
// would call malformed comes back as a REAL NSError -1002 from the session
// instead. Measured, not assumed — `send_reports_an_unusable_url_as_a_
// transport_error` is that measurement.
const ERROR_INVALID_URL: i64 = 1;
const ERROR_TASK_REFUSED: i64 = 2;
const ERROR_NO_RESPONSE: i64 = 3;

// ==========================================================================
// The message types
// ==========================================================================

enum Method {
    Get,
    Head,
    Post,
    Put,
    Patch,
    Delete,
}

// The wire spelling of a method — what goes on the request line, uppercase as
// RFC 9110 requires (method names are case-SENSITIVE, unlike header names).
fn method_name(m: Method) -> str {
    return match m {
        Method::Get    => "GET",
        Method::Head   => "HEAD",
        Method::Post   => "POST",
        Method::Put    => "PUT",
        Method::Patch  => "PATCH",
        Method::Delete => "DELETE",
    };
}

// One header field. Names are case-INsensitive on the wire (RFC 9110 §5.1),
// which is why `Request::set_header` and `Response::header` both compare that
// way rather than byte-for-byte.
struct Header {
    name: text::Text,
    value: text::Text,
}

// What to send. Build it with `Request::new`, then set what you need. Every
// field is readable; the `set_` methods are the mutating half and want a `var`
// receiver.
//
// `timeout_seconds` becomes `NSURLRequest.timeoutInterval` — Foundation's idle
// timeout between packets, not a deadline on the whole transfer. It is also
// the only thing that guarantees the completion handler eventually fires,
// which is what lets the wait inside `send` be unbounded.
struct Request {
    method: Method,
    url: text::Text,
    headers: vec::Vec[Header],
    body: vec::Vec[u8],
    timeout_seconds: f64,
}

impl Request {
    // The URL is the content; everything else has an answer that is right most
    // of the time. `Request::new(url)` is a GET with Foundation's own 60s
    // interval, and the labels make the rest read at the call site:
    //
    //     Request::new("https://example.com/v1/items", method: Method::Post)
    //     Request::new(feed_url, timeout_seconds: 4.0)   // a launch must not stall
    fn new(url: str, method: Method = Method::Get, timeout_seconds: f64 = 60.0) -> Request {
        return Request {
            method: method,
            url: text::from_str(url),
            headers: vec::new::[Header](),
            body: vec::new::[u8](),
            timeout_seconds: timeout_seconds,
        };
    }

    // Set `name` to a value, replacing any field already under that name
    // (case-insensitively) — the same semantics as Foundation's
    // `-setValue:forHTTPHeaderField:`, so a Request and the NSURLRequest built
    // from it always agree on how many of each field there are.
    //
    //     req.set_header("Accept", to: "application/json")
    fn set_header(ref this, name: str, to: str) -> status::Status {
        var i: usize = 0 as usize;
        while i < this.headers.count() {
            guard let option::Option[*Header]::Some(h) = this.headers.at_ptr(i) else { break; };
            let matched: bool = { (*h).name.equals_ignoring_case(name) };
            if matched {
                return this.headers.set(Header { name: text::from_str(name), value: text::from_str(to) }, i);
            }
            i = i +% (1 as usize);
        }
        return this.headers.append(Header { name: text::from_str(name), value: text::from_str(to) });
    }

    // The value under `name`, or None. Case-insensitive, like the wire.
    fn header(this, name: str) -> option::Option[text::Text] {
        return _find_header(this.headers, name);
    }

    // Replace the request body with a copy of `bytes`.
    fn set_body(ref this, bytes: u8[]) -> status::Status {
        this.body.remove_all();
        return this.body.append_slice(bytes);
    }

    // Replace the request body with a copy of `body`'s bytes. Sets no content
    // type — say what the bytes are with `set_header("Content-Type", to: ...)`.
    // One memcpy, not one bounds-checked read per byte: a JSON payload is a
    // perfectly ordinary megabyte.
    fn set_body_text(ref this, body: str) -> status::Status {
        return this.set_body({ #slice_from_raw_parts(#str_ptr(body), #str_len(body)) });
    }

    fn set_timeout(ref this, seconds: f64) {
        this.timeout_seconds = seconds;
    }
}

// What came back. A NON-2xx status is DATA, not an error: the server answered,
// and 404 is an answer. `Error` is reserved for the exchanges that never
// produced one.
struct Response {
    status: i32,
    body: vec::Vec[u8],
    _headers: vec::Vec[Header],
}

impl Response {
    fn is_success(this) -> bool {
        return this.status >= 200 && this.status <= 299;
    }

    // The value of response header `name`, or None. Case-insensitive.
    fn header(this, name: str) -> option::Option[text::Text] {
        return _find_header(this._headers, name);
    }

    fn header_count(this) -> usize {
        return this._headers.count();
    }

    // The body bytes as an owned Text. NOT validated as UTF-8 — a `Text` holds
    // whatever bytes it is given, and only the caller knows whether this
    // response was supposed to be text at all. Check `Content-Type` first, or
    // read `body` directly when it is not.
    fn body_text(this) -> text::Text {
        return text::from_str(this.body.as_byte_view());
    }
}

// Why there is no Response.
//
// `code` is Foundation's NSError code — always negative, see NSURLError.h —
// unless it is one of the positive ERROR_* constants above, which mean the
// request never left the process. `message` is the NSError's
// `localizedDescription`, i.e. the sentence Apple would have shown a user.
struct Error {
    code: i64,
    message: text::Text,
}

// Shared by `Request::header` and `Response::header`: the header list is short
// enough (a handful of fields) that a linear scan beats carrying a map.
fn _find_header(headers: vec::Vec[Header], name: str) -> option::Option[text::Text] {
    var i: usize = 0 as usize;
    while i < headers.count() {
        guard let option::Option[*Header]::Some(h) = headers.at_ptr(i) else { break; };
        let matched: bool = { (*h).name.equals_ignoring_case(name) };
        if matched {
            return option::Option[text::Text]::Some({ (*h).value.clone() });
        }
        i = i +% (1 as usize);
    }
    return option::Option[text::Text]::None;
}

// ==========================================================================
// The public verbs
// ==========================================================================

// GET `url`, blocking until the server answers or the request times out.
// Convenience for `send(Request::new(url))`.
fn get(url: str) -> result::Result[Response, Error] {
    let req: Request = Request::new(url);
    return send(req);
}

// Perform `req`, blocking. `req` is BORROWED — it is only read, so the same
// request can be sent again.
//
// What the OS does that this package does not re-decide: redirects are
// followed, the system cookie store is read and written, `Accept-Encoding` is
// negotiated and the response transparently decompressed, and the system proxy
// and VPN configuration applies. Whatever NSURLSession's shared session does
// is what happens, which is the point of binding it.
//
// A NON-2xx status is Ok, not Err. The server answered; read `status`.
fn send(req: Request) -> result::Result[Response, Error] {
    return _perform(req);
}

// ==========================================================================
// Foundation transport
// ==========================================================================
//
// Below here is NSURLSession and the block machinery that makes an escaping
// completion handler callable from a language with no closures.

#[link_name = "malloc"]
extern fn ext_malloc(n: usize) -> *u8;

#[link_name = "free"]
extern fn ext_free(p: *u8);

#[link_name = "memcpy"]
extern fn ext_memcpy(dst: *u8, src: *u8, n: usize) -> *u8;

// libdispatch. Plain C functions with no macro in the way, so they bind
// directly — unlike `dispatch_get_main_queue()`, which is a macro over a
// global and is why the schedulers elsewhere in vendor go the long way round.
extern fn dispatch_semaphore_create(value: i64) -> *u8;
extern fn dispatch_semaphore_wait(sem: *u8, timeout: u64) -> i64;
extern fn dispatch_semaphore_signal(sem: *u8) -> i64;

// DISPATCH_TIME_FOREVER == ~0ull. Built arithmetically: an integer literal
// wraps through i32 before `as`, so `18446744073709551615 as u64` is not the
// way to spell it.
fn _forever() -> u64 {
    return (0 as u64) -% (1 as u64);
}

// The autorelease pool. `+[NSURL URLWithString:]`, `+[NSMutableURLRequest
// requestWithURL:]` and the bridge's NSStrings are all autoreleased, and a
// plain C thread has no pool — without these two the objects leak and the
// runtime says so on stderr.
#[link_name = "objc_autoreleasePoolPush"]
extern fn pool_push() -> *u8;

#[link_name = "objc_autoreleasePoolPop"]
extern fn pool_pop(p: *u8);

// -------------------------------------------------------------------------
// The escaping block
// -------------------------------------------------------------------------
//
// `-dataTaskWithRequest:completionHandler:` takes an ESCAPING block: the
// session `Block_copy`s it during the msgSend and calls it much later, from a
// background queue. This is the same hand-built stack-block shape that
// `appkit_ext::dynamic_color` has been passing to AppKit — isa from
// `rt::stack_block_isa()`, flags 0 (so there are no copy/dispose helpers and
// nothing walks the captures), invoke, descriptor, then POD captures. Because
// flags is 0 the copy is a flat memcpy of these 48 bytes, which is exactly why
// `#addr_of` on a stack local is safe here: what escapes is the session's
// copy, not this frame.
//
// Both captures are POD pointers, and both stay valid for the whole call: the
// slot lives on the frame that is blocked in `dispatch_semaphore_wait`, and
// the semaphore is released only after that wait returns.
#[repr(C)]
struct _CompletionBlock {
    opaque isa: *u8,
    flags: i32,
    reserved: i32,
    invoke: fn(*u8, *u8, *u8, *u8),
    opaque descriptor: *u8,
    opaque slot: *u8,
    opaque sem: *u8,
}

// The descriptor is SHARED by every copy the session makes and is read after
// the block is copied, so it must outlive any one call — hence a `static`
// rather than a frame local. Fully initialised at its declaration, which is
// what makes concurrent `send`s safe: `block_desc` only ever READS this, so
// two threads in flight at once share it without a write between them. (The
// malloc-a-descriptor-on-first-use idiom next door in appkit_ext would race
// here, and leak the loser's copy.)
static _BLOCK_DESC: rt::BlockDescriptor = rt::BlockDescriptor {
    reserved: 0 as u64,
    // A literal because a `static` initializer takes no `#size_of` (E0911) and
    // no const may fold one (E0921). `completion_block_is_the_flags_zero_stack_
    // shape` is the guard: it fails the moment the struct stops being 48 bytes.
    size: 48 as u64,
};

fn _block_desc() -> *u8 {
    return { #addr_of(_BLOCK_DESC) as *u8 };
}

// Everything the completion handler collected, handed back across the
// semaphore. Plain data on purpose: the background queue writes POD only, and
// the waiting thread does every allocation, every Text, every release. The
// four pointers are `opaque` because this struct is a transfer record and owns
// nothing — `slot_teardown` on the waiting side is the single owner.
#[repr(C)]
struct _Slot {
    opaque body: *u8,       // malloc'd copy of the response bytes, 0 when empty
    body_len: usize,
    opaque response: *u8,   // RETAINED NSHTTPURLResponse, 0 on transport failure
    opaque error: *u8,      // RETAINED NSError, 0 on success
}

// Runs on one of NSURLSession's background queues.
//
// Copy the bytes out of the NSData NOW — it is autoreleased into a pool this
// code does not own, and the pool drains the moment this returns. The response
// and the error are retained instead of copied: both are immutable value-ish
// Foundation objects, and a +1 reference is a cheaper way to keep them alive
// than transcribing them here.
//
// Signal LAST. Every write above must be visible to the waiting thread, and
// the signal/wait pair is what makes them so.
fn _completion_invoke(block: *u8, data: *u8, response: *u8, error: *u8) {
    let b: *_CompletionBlock = { block as *_CompletionBlock };
    let slot: *_Slot = { { (*b).slot } as *_Slot };

    if data.is_not_null() {
        let n: u64 = rt::msg_u64(data, rt::sel(#str_ptr("length\0")));
        if n > (0 as u64) {
            let src: *u8 = rt::msg_id(data, rt::sel(#str_ptr("bytes\0")));
            // `src` is tested BEFORE the malloc: allocating first and then
            // bailing out would strand the buffer, and nothing on this side of
            // the semaphore will ever free it.
            if src.is_not_null() {
                let dst: *u8 = ext_malloc(n as usize);
                // A failed malloc degrades to an empty body rather than
                // trapping: the status and the headers are still worth
                // delivering.
                if dst.is_not_null() {
                    let _c: *u8 = ext_memcpy(dst, src, n as usize);
                    { (*slot).body = dst };
                    { (*slot).body_len = n as usize };
                }
            }
        }
    }
    if response.is_not_null() { { (*slot).response = rt::retain(response) }; }
    if error.is_not_null() { { (*slot).error = rt::retain(error) }; }

    let _s: i64 = dispatch_semaphore_signal({ (*b).sem });
}

fn _slot_teardown(ref slot: _Slot) {
    ext_free(slot.body);
    slot.body = 0 as *u8;
    slot.body_len = 0 as usize;
    if slot.response.is_not_null() { rt::release(slot.response); }
    slot.response = 0 as *u8;
    if slot.error.is_not_null() { rt::release(slot.error); }
    slot.error = 0 as *u8;
}

// -------------------------------------------------------------------------
// Building the NSURLRequest
// -------------------------------------------------------------------------

// An autoreleased NSMutableURLRequest carrying everything in `req`, or 0 when
// `url` is not a URL Foundation will accept. Must be called inside a pool.
fn _build_ns_request(req: Request) -> *u8 {
    let url_string: *u8 = bridge::nsstring(req.url);
    let url: *u8 = rt::msg_id_id(rt::get_class(#str_ptr("NSURL\0")),
                                 rt::sel(#str_ptr("URLWithString:\0")),
                                 url_string);
    if url.is_null() { return 0 as *u8; }

    let ns_req: *u8 = rt::msg_id_id(rt::get_class(#str_ptr("NSMutableURLRequest\0")),
                                    rt::sel(#str_ptr("requestWithURL:\0")),
                                    url);
    if ns_req.is_null() { return 0 as *u8; }

    rt::msg_void_id(ns_req, rt::sel(#str_ptr("setHTTPMethod:\0")),
                    bridge::nsstring(method_name(req.method)));
    rt::msg_void_f64(ns_req, rt::sel(#str_ptr("setTimeoutInterval:\0")), req.timeout_seconds);

    var i: usize = 0 as usize;
    while i < req.headers.count() {
        guard let option::Option[*Header]::Some(h) = req.headers.at_ptr(i) else { break; };
        let name: *u8 = bridge::nsstring({ (*h).name });
        let value: *u8 = bridge::nsstring({ (*h).value });
        rt::msg_void_id_id(ns_req, rt::sel(#str_ptr("setValue:forHTTPHeaderField:\0")), value, name);
        i = i +% (1 as usize);
    }

    let body_len: usize = req.body.count();
    if body_len > (0 as usize) {
        guard let option::Option[*u8]::Some(base) = req.body.at_ptr(0 as usize) else { return ns_req; };
        let data: *u8 = rt::msg_id_id_u64(rt::get_class(#str_ptr("NSData\0")),
                                          rt::sel(#str_ptr("dataWithBytes:length:\0")),
                                          base, body_len as u64);
        if data.is_not_null() {
            rt::msg_void_id(ns_req, rt::sel(#str_ptr("setHTTPBody:\0")), data);
        }
    }
    return ns_req;
}

// -------------------------------------------------------------------------
// Reading the NSHTTPURLResponse
// -------------------------------------------------------------------------

// `response` is an NSURLResponse; only the HTTP subclass carries a status line.
// Every http/https exchange produces one, but a `file://` URL does not, so ask
// rather than assume.
fn _is_http_response(response: *u8) -> bool {
    if response.is_null() { return false; }
    let cls: *u8 = rt::get_class(#str_ptr("NSHTTPURLResponse\0"));
    return rt::msg_i8_id(response, rt::sel(#str_ptr("isKindOfClass:\0")), cls) != (0 as i8);
}

// `-allHeaderFields` copied out into owned C+ values, so a Response outlives
// every Objective-C object it came from. Foundation has already merged
// repeated fields and canonicalised the names.
fn _read_headers(response: *u8) -> vec::Vec[Header] {
    var out: vec::Vec[Header] = vec::new::[Header]();
    if !_is_http_response(response) { return out; }

    let dict: *u8 = rt::msg_id(response, rt::sel(#str_ptr("allHeaderFields\0")));
    if dict.is_null() { return out; }
    let keys: *u8 = rt::msg_id(dict, rt::sel(#str_ptr("allKeys\0")));
    if keys.is_null() { return out; }

    let n: u64 = rt::msg_u64(keys, rt::sel(#str_ptr("count\0")));
    var i: u64 = 0 as u64;
    while i < n {
        let key: *u8 = rt::msg_id_u64(keys, rt::sel(#str_ptr("objectAtIndex:\0")), i);
        let value: *u8 = rt::msg_id_id(dict, rt::sel(#str_ptr("objectForKey:\0")), key);
        if key.is_not_null() && value.is_not_null() {
            let _a: status::Status = out.append(Header {
                name: bridge::to_text(key),
                value: bridge::to_text(value),
            });
        }
        i = i +% (1 as u64);
    }
    return out;
}

fn _read_error(err: *u8) -> Error {
    let code: i64 = rt::msg_i64(err, rt::sel(#str_ptr("code\0")));
    let described: *u8 = rt::msg_id(err, rt::sel(#str_ptr("localizedDescription\0")));
    guard let option::Option[text::Text]::Some(message) = bridge::to_text_option(described) else {
        return Error { code: code, message: text::from_str("request failed") };
    };
    return Error { code: code, message: message };
}

fn _fail(code: i64, message: str) -> result::Result[Response, Error] {
    return result::Result[Response, Error]::Err(Error {
        code: code,
        message: text::from_str(message),
    });
}

// -------------------------------------------------------------------------
// The exchange
// -------------------------------------------------------------------------

fn _perform(req: Request) -> result::Result[Response, Error] {
    let pool: *u8 = pool_push();
    defer pool_pop(pool);

    let ns_req: *u8 = _build_ns_request(req);
    if ns_req.is_null() {
        return _fail(ERROR_INVALID_URL, "not a URL Foundation can request");
    }

    // `+sharedSession` is the process-wide session: the system cookie store,
    // the system cache, the system credential store, and connection reuse
    // across every caller. A package-private NSURLSessionConfiguration would
    // be a policy decision this package has no business making.
    let session: *u8 = rt::msg_id(rt::get_class(#str_ptr("NSURLSession\0")),
                                  rt::sel(#str_ptr("sharedSession\0")));

    var slot: _Slot = #zero::[_Slot]();
    let sem: *u8 = dispatch_semaphore_create(0 as i64);
    if sem.is_null() {
        return _fail(ERROR_TASK_REFUSED, "could not create a wait semaphore");
    }

    var blk: _CompletionBlock = _CompletionBlock {
        isa: rt::stack_block_isa(),
        flags: 0 as i32,
        reserved: 0 as i32,
        invoke: _completion_invoke,
        descriptor: _block_desc(),
        slot: { #addr_of(slot) as *u8 },
        sem: sem,
    };

    let task: *u8 = rt::msg_id_id_id(session,
                                     rt::sel(#str_ptr("dataTaskWithRequest:completionHandler:\0")),
                                     ns_req,
                                     { #addr_of(blk) as *u8 });
    if task.is_null() {
        rt::release(sem);
        return _fail(ERROR_TASK_REFUSED, "NSURLSession refused the request");
    }

    rt::msg_void(task, rt::sel(#str_ptr("resume\0")));

    // Unbounded on purpose. The request's own timeoutInterval guarantees the
    // completion handler fires, so there is nothing to race — and racing a
    // semaphore timeout against it would abandon the slot while a live
    // background queue still holds a pointer into this frame.
    let _w: i64 = dispatch_semaphore_wait(sem, _forever());

    // Past the wait, the handler is done and the slot is ours alone. Releasing
    // the semaphore here is safe for the same reason: `dispatch_semaphore_
    // signal` touches nothing after the wake-up it caused.
    rt::release(sem);

    let out: result::Result[Response, Error] = _harvest(slot);
    _slot_teardown(slot);
    return out;
}

// Turn a completed slot into the public answer. Reads only — `slot_teardown`
// does the freeing, so this stays a pure translation.
fn _harvest(slot: _Slot) -> result::Result[Response, Error] {
    if slot.error.is_not_null() {
        return result::Result[Response, Error]::Err(_read_error(slot.error));
    }
    if !_is_http_response(slot.response) {
        return _fail(ERROR_NO_RESPONSE, "no HTTP response and no error");
    }

    var body: vec::Vec[u8] = vec::new::[u8]();
    if slot.body.is_not_null() && slot.body_len > (0 as usize) {
        let _e: status::Status = body.extend_from_raw(slot.body, slot.body_len);
    }

    let status_code: i64 = rt::msg_i64(slot.response, rt::sel(#str_ptr("statusCode\0")));
    return result::Result[Response, Error]::Ok(Response {
        status: status_code as i32,
        body: body,
        _headers: _read_headers(slot.response),
    });
}

// ==========================================================================
// Tests
// ==========================================================================
//
// Everything down to `net_` runs OFFLINE: request building and error mapping
// are exercised against real Foundation objects without a single packet
// leaving the machine (a malformed URL is rejected by NSURLSession locally,
// before any DNS). The `net_` tests at the bottom need the internet.

// ---- method vocabulary ---------------------------------------------------

#[test]
fn method_names_are_the_wire_spellings() {
    assert method_name(Method::Get).compare("GET") == 0;
    assert method_name(Method::Head).compare("HEAD") == 0;
    assert method_name(Method::Post).compare("POST") == 0;
    assert method_name(Method::Put).compare("PUT") == 0;
    assert method_name(Method::Patch).compare("PATCH") == 0;
    assert method_name(Method::Delete).compare("DELETE") == 0;
}

// ---- Request ------------------------------------------------------------

#[test]
fn request_new_defaults() {
    let req: Request = Request::new("https://example.com/a");
    assert req.url.equals("https://example.com/a");
    assert req.headers.count() == (0 as usize);
    assert req.body.count() == (0 as usize);
    assert req.timeout_seconds == 60.0;
}

#[test]
fn request_new_takes_a_timeout() {
    let req: Request = Request::new("https://example.com/a", method: Method::Post, timeout_seconds: 2.5);
    assert req.timeout_seconds == 2.5;
}

#[test]
fn request_set_header_appends() {
    var req: Request = Request::new("https://example.com/a");
    let _a: status::Status = req.set_header("Accept", to: "application/json");
    let _b: status::Status = req.set_header("X-Trace", to: "1");
    assert req.headers.count() == (2 as usize);
}

#[test]
fn request_set_header_replaces_case_insensitively() {
    var req: Request = Request::new("https://example.com/a");
    let _a: status::Status = req.set_header("Content-Type", to: "text/plain");
    let _b: status::Status = req.set_header("content-TYPE", to: "application/json");
    assert req.headers.count() == (1 as usize);
    guard let option::Option[text::Text]::Some(v) = req.header("Content-Type") else {
        assert false;
        return;
    };
    assert v.equals("application/json");
}

#[test]
fn request_header_lookup_is_case_insensitive() {
    var req: Request = Request::new("https://example.com/a");
    let _a: status::Status = req.set_header("Accept", to: "application/json");
    guard let option::Option[text::Text]::Some(v) = req.header("ACCEPT") else {
        assert false;
        return;
    };
    assert v.equals("application/json");
}

#[test]
fn request_header_missing_is_none() {
    let req: Request = Request::new("https://example.com/a");
    match req.header("Accept") {
        option::Option[text::Text]::Some(_) => { assert false; }
        option::Option[text::Text]::None    => {}
    }
}

#[test]
fn request_set_body_text_copies_the_bytes() {
    var req: Request = Request::new("https://example.com/a", method: Method::Post);
    let _b: status::Status = req.set_body_text("{\"k\":1}");
    assert req.body.count() == (7 as usize);
    assert req.body.as_byte_view().compare("{\"k\":1}") == 0;
}

#[test]
fn request_set_body_replaces_rather_than_appends() {
    var req: Request = Request::new("https://example.com/a", method: Method::Post);
    let _a: status::Status = req.set_body_text("first");
    let _b: status::Status = req.set_body_text("second");
    assert req.body.as_byte_view().compare("second") == 0;
}

#[test]
fn request_set_body_text_of_an_empty_string_is_an_empty_body() {
    // `#str_ptr("")` can be null; `set_body` must not memcpy from it.
    var req: Request = Request::new("https://example.com/a", method: Method::Post);
    let _a: status::Status = req.set_body_text("payload");
    let _b: status::Status = req.set_body_text("");
    assert req.body.count() == (0 as usize);
}

#[test]
fn request_set_body_text_survives_a_large_payload() {
    let chunk: text::Text = text::repeating("0123456789", 4096 as usize);
    var req: Request = Request::new("https://example.com/a", method: Method::Post);
    let _b: status::Status = req.set_body_text(chunk);
    assert req.body.count() == (40960 as usize);
    assert req.body.as_byte_view().has_prefix("0123456789");
    assert req.body.as_byte_view().has_suffix("0123456789");
}

#[test]
fn request_set_body_takes_a_slice() {
    var bytes: vec::Vec[u8] = vec::new::[u8]();
    let _0: status::Status = bytes.append(1 as u8);
    let _1: status::Status = bytes.append(2 as u8);
    let _2: status::Status = bytes.append(0 as u8);
    let _3: status::Status = bytes.append(255 as u8);
    var req: Request = Request::new("https://example.com/a", method: Method::Put);
    let _s: status::Status = req.set_body(bytes.as_slice());
    assert req.body.count() == (4 as usize);
    guard let option::Option[u8]::Some(third) = req.body.at(2 as usize) else {
        assert false;
        return;
    };
    assert third == (0 as u8);
}

#[test]
fn request_set_timeout_writes_back() {
    var req: Request = Request::new("https://example.com/a");
    req.set_timeout(3.0);
    assert req.timeout_seconds == 3.0;
}

// ---- Response -----------------------------------------------------------

fn _response_with_status(code: i32) -> Response {
    return Response {
        status: code,
        body: vec::new::[u8](),
        _headers: vec::new::[Header](),
    };
}

#[test]
fn response_is_success_spans_2xx_only() {
    assert !_response_with_status(199).is_success();
    assert _response_with_status(200).is_success();
    assert _response_with_status(204).is_success();
    assert _response_with_status(299).is_success();
    assert !_response_with_status(300).is_success();
    assert !_response_with_status(404).is_success();
    assert !_response_with_status(500).is_success();
}

#[test]
fn response_header_is_case_insensitive() {
    var headers: vec::Vec[Header] = vec::new::[Header]();
    let _a: status::Status = headers.append(Header {
        name: text::from_str("Content-Type"),
        value: text::from_str("application/json"),
    });
    let r: Response = Response { status: 200, body: vec::new::[u8](), _headers: headers };
    assert r.header_count() == (1 as usize);
    guard let option::Option[text::Text]::Some(v) = r.header("content-type") else {
        assert false;
        return;
    };
    assert v.equals("application/json");
}

#[test]
fn response_header_missing_is_none() {
    let r: Response = _response_with_status(200);
    match r.header("Content-Type") {
        option::Option[text::Text]::Some(_) => { assert false; }
        option::Option[text::Text]::None    => {}
    }
}

#[test]
fn response_body_text_reads_the_bytes() {
    var body: vec::Vec[u8] = vec::new::[u8]();
    let _0: status::Status = body.append(104 as u8);   // 'h'
    let _1: status::Status = body.append(105 as u8);   // 'i'
    let r: Response = Response { status: 200, body: body, _headers: vec::new::[Header]() };
    let t: text::Text = r.body_text();
    assert t.equals("hi");
}

#[test]
fn response_body_text_of_an_empty_body_is_empty() {
    let r: Response = _response_with_status(204);
    let t: text::Text = r.body_text();
    assert t.count() == (0 as usize);
}

// ---- the block shape ----------------------------------------------------

#[test]
fn completion_block_is_the_flags_zero_stack_shape() {
    // isa + flags + reserved + invoke + descriptor + two POD captures. The
    // descriptor's `size` MUST be this number or Block_copy copies the wrong
    // span, so pin it here rather than trusting a hand-written 48.
    assert #size_of::[_CompletionBlock]() == (48 as usize);
    let d: *rt::BlockDescriptor = { _block_desc() as *rt::BlockDescriptor };
    assert { (*d).size } == (48 as u64);
    assert { (*d).reserved } == (0 as u64);
    assert rt::stack_block_isa().is_not_null();
}

#[test]
fn forever_is_dispatch_time_forever() {
    assert _forever() == (18446744073709551615 as u64);
}

// ---- request building, against real Foundation objects -------------------

#[test]
fn build_ns_request_carries_method_url_and_timeout() {
    let pool: *u8 = pool_push();
    defer pool_pop(pool);

    let req: Request = Request::new("https://example.com/thing?x=1", method: Method::Delete, timeout_seconds: 7.5);
    let ns_req: *u8 = _build_ns_request(req);
    assert ns_req.is_not_null();

    let method: text::Text = bridge::to_text(rt::msg_id(ns_req, rt::sel(#str_ptr("HTTPMethod\0"))));
    assert method.equals("DELETE");

    let url: *u8 = rt::msg_id(ns_req, rt::sel(#str_ptr("URL\0")));
    let absolute: text::Text = bridge::to_text(rt::msg_id(url, rt::sel(#str_ptr("absoluteString\0"))));
    assert absolute.equals("https://example.com/thing?x=1");

    assert rt::msg_f64(ns_req, rt::sel(#str_ptr("timeoutInterval\0"))) == 7.5;
}

#[test]
fn build_ns_request_carries_headers() {
    let pool: *u8 = pool_push();
    defer pool_pop(pool);

    var req: Request = Request::new("https://example.com/a");
    let _a: status::Status = req.set_header("Accept", to: "application/json");
    let _b: status::Status = req.set_header("X-Trace", to: "abc");
    let ns_req: *u8 = _build_ns_request(req);
    assert ns_req.is_not_null();

    let sel: *u8 = rt::sel(#str_ptr("valueForHTTPHeaderField:\0"));
    let accept: text::Text = bridge::to_text(rt::msg_id_id(ns_req, sel, bridge::nsstring("Accept")));
    assert accept.equals("application/json");
    // Foundation looks header names up case-insensitively too — the same
    // contract `Request::set_header` keeps, checked here against the real one.
    let trace: text::Text = bridge::to_text(rt::msg_id_id(ns_req, sel, bridge::nsstring("x-trace")));
    assert trace.equals("abc");
}

#[test]
fn build_ns_request_carries_the_body() {
    let pool: *u8 = pool_push();
    defer pool_pop(pool);

    var req: Request = Request::new("https://example.com/a", method: Method::Post);
    let _b: status::Status = req.set_body_text("hello body");
    let ns_req: *u8 = _build_ns_request(req);
    assert ns_req.is_not_null();

    let data: *u8 = rt::msg_id(ns_req, rt::sel(#str_ptr("HTTPBody\0")));
    assert data.is_not_null();
    assert rt::msg_u64(data, rt::sel(#str_ptr("length\0"))) == (10 as u64);
}

#[test]
fn build_ns_request_leaves_an_empty_body_unset() {
    let pool: *u8 = pool_push();
    defer pool_pop(pool);

    let req: Request = Request::new("https://example.com/a");
    let ns_req: *u8 = _build_ns_request(req);
    assert ns_req.is_not_null();
    assert rt::msg_id(ns_req, rt::sel(#str_ptr("HTTPBody\0"))).is_null();
}

// ---- error mapping ------------------------------------------------------

#[test]
fn read_error_takes_the_code_and_the_localized_description() {
    let pool: *u8 = pool_push();
    defer pool_pop(pool);

    // A real NSError, built the way Foundation builds the ones this package
    // actually sees. -1009 is NSURLErrorNotConnectedToInternet.
    let err: *u8 = rt::msg_id_id_i64_id(rt::get_class(#str_ptr("NSError\0")),
                                        rt::sel(#str_ptr("errorWithDomain:code:userInfo:\0")),
                                        bridge::nsstring("NSURLErrorDomain"),
                                        -1009,
                                        0 as *u8);
    assert err.is_not_null();
    let mapped: Error = _read_error(err);
    assert mapped.code == -1009;
    assert mapped.message.count() > (0 as usize);
}

#[test]
fn harvest_of_an_empty_slot_reports_no_response() {
    let slot: _Slot = #zero::[_Slot]();
    guard let result::Result[Response, Error]::Err(e) = _harvest(slot) else {
        assert false;
        return;
    };
    assert e.code == ERROR_NO_RESPONSE;
}

#[test]
fn slot_teardown_is_idempotent_on_a_zero_slot() {
    var slot: _Slot = #zero::[_Slot]();
    _slot_teardown(slot);
    _slot_teardown(slot);
    assert slot.body.is_null();
    assert slot.body_len == (0 as usize);
}

// A malformed URL never reaches the network: NSURLSession rejects it locally
// with NSURLErrorUnsupportedURL (-1002). So this is the negative test for the
// whole `send` path — block, semaphore, slot, error mapping — and it needs no
// internet to run.
#[test]
fn send_reports_an_unusable_url_as_a_transport_error() {
    guard let result::Result[Response, Error]::Err(e) = get("not a url at all") else {
        assert false;
        return;
    };
    assert e.code == -1002;
    assert e.message.count() > (0 as usize);
}

#[test]
fn send_reports_an_empty_url_as_a_transport_error() {
    guard let result::Result[Response, Error]::Err(e) = get("") else {
        assert false;
        return;
    };
    assert e.code < (0 as i64);
}

// ---- integration: these need the internet --------------------------------

#[test]
fn net_get_reads_a_real_response() {
    guard let result::Result[Response, Error]::Ok(r) =
        get("https://hn.algolia.com/api/v1/search?tags=front_page") else {
        assert false;
        return;
    };
    assert r.status == 200;
    assert r.is_success();
    assert r.body.count() > (0 as usize);
    // A real response carries real headers, and the body is the JSON the API
    // promises — proof the bytes came out of the NSData and not from nowhere.
    assert r.header_count() > (0 as usize);
    guard let option::Option[text::Text]::Some(kind) = r.header("content-type") else {
        assert false;
        return;
    };
    assert kind.contains("json");
    assert r.body.as_byte_view().contains("\"hits\"");
}

// Non-2xx is DATA. The server answered; 404 IS the answer, and a caller must
// not have to tell it apart from a dead network.
#[test]
fn net_a_404_is_a_response_not_an_error() {
    guard let result::Result[Response, Error]::Ok(r) =
        get("https://hn.algolia.com/api/v1/definitely_not_a_route") else {
        assert false;
        return;
    };
    assert r.status == 404;
    assert !r.is_success();
}

// The request this package builds is the request the server sees: httpbin
// echoes the method, the headers and the body back as JSON.
#[test]
fn net_post_sends_the_method_headers_and_body() {
    var req: Request = Request::new("https://postman-echo.com/post", method: Method::Post, timeout_seconds: 20.0);
    let _a: status::Status = req.set_header("Content-Type", to: "application/json");
    let _b: status::Status = req.set_header("X-Cplus-Probe", to: "http-package");
    let _c: status::Status = req.set_body_text("{\"hello\":\"world\"}");

    guard let result::Result[Response, Error]::Ok(r) = send(req) else {
        assert false;
        return;
    };
    assert r.status == 200;
    let echoed: str = r.body.as_byte_view();
    assert echoed.contains("http-package");
    assert echoed.contains("\"hello\"");
}
