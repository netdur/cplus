// agent_appkit test root — headless coverage against real AppKit widgets.
//
// The library never imports appkit (it drives views through the raw ObjC
// runtime); the typed binding here is fixture convenience only. Every test
// builds a real NSWindow + widgets, opens a Surface, and exercises the
// walk / describe / act paths, including the negatives: unexposed nodes,
// unknown ids, and views that left the live UI (`Stale`).

import "objc/runtime" as rt;
import "objc/bridge" as bridge;
import "appkit/appkit" as ak;
import "appkit/appkit_ext" as akx;   // for new_drag_view: the mouseDown: regression below drives a real FacetDragView
import "agent_core/identity" as identity;
import "agent_core/surface" as surface;
import "stdlib/vec" as vec;
import "stdlib/text" as text;
import "stdlib/option" as option;
import "./agent_appkit" as agent;

fn main() -> i32 { return 0; }

fn null_ctx() -> *u8 { return { 0 as *u8 }; }

// One titled window with a content view; the app is initialized once
// (shared_application is idempotent).
fn fixture_window(w: f64, h: f64) -> ak::Window {
    let _app: ak::Application = ak::Application::shared_application();
    let win = ak::Window::new(
        rt::Rect { x: 0.0, y: 0.0, w: w, h: h },
        ak::window_style_mask_titled,
        ak::BackingStoreType::NSBackingStoreBuffered,
        false,
    );
    rt::retain(win.raw());
    let content = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: w, h: h });
    win.set_content_view(ak::View::from_raw(content.raw()));
    return win;
}

fn content_of(win: ak::Window) -> ak::View {
    return ak::View::from_raw(rt::msg_id(win.raw(), rt::sel(#str_ptr("contentView\0"))));
}

fn add_button(content: ak::View, title: str) -> ak::Button {
    let b = ak::Button::new_with_frame(rt::Rect { x: 10.0, y: 10.0, w: 80.0, h: 24.0 });
    b.set_title(title);
    content.add_subview(b.as_view());
    return b;
}

static CLICKS: i32 = 0;
fn on_probe_click(sender: *u8) {
    CLICKS = CLICKS + 1;
    return;
}

#[test]
fn walk_classifies_and_exposes_only_tagged() {
    let win = fixture_window(300.0f64, 200.0f64);
    let content = content_of(win);
    let b = add_button(content, "go");
    agent::set_agent_id(b.as_view().raw(), "go-btn");
    let l = ak::TextField::label_with_string("hello");
    content.add_subview(l.as_view());

    var s: agent::Surface = agent::open(win.raw());
    let nodes: vec::Vec[agent::AppKitNode] = s.describe();
    // window + content group + button + label = 4 nodes.
    assert nodes.count() == (4 as usize);
    match nodes.at_ptr(2 as usize) {
        option::Option[*agent::AppKitNode]::Some(n) => {
            assert identity::role_eq({ (*n).role }, identity::Role::Button);
            assert { (*n).id.view() } == "go-btn";
            assert { (*n).actionable };
        }
        option::Option[*agent::AppKitNode]::None => { assert false; }
    }
    match nodes.at_ptr(3 as usize) {
        option::Option[*agent::AppKitNode]::Some(n) => {
            assert identity::role_eq({ (*n).role }, identity::Role::Text);
            // Untagged: auto id, not exposed, not actionable.
            assert !{ (*n).actionable };
        }
        option::Option[*agent::AppKitNode]::None => { assert false; }
    };
    return;
}

#[test]
fn open_walks_titlebar_accessory_controls() {
    // #13: title-bar accessory views (fak::install_titlebar) are siblings of the
    // contentView under NSThemeFrame; open() must reach them so a tagged control
    // there stays agent-addressable (regressed when #12 moved iris's toolbar
    // into the title bar). Attach the accessory raw — the library owns no appkit.
    let win = fixture_window(400.0f64, 300.0f64);
    let acc_view = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 200.0, h: 30.0 });
    let tb = add_button(acc_view, "run");
    agent::set_agent_id(tb.as_view().raw(), "run-toggle");
    let vc_ptr: *u8 = rt::alloc_init(#str_ptr("NSTitlebarAccessoryViewController\0"));
    rt::msg_void_id(vc_ptr, rt::sel(#str_ptr("setView:\0")), acc_view.raw());
    rt::msg_void_id(win.raw(), rt::sel(#str_ptr("addTitlebarAccessoryViewController:\0")), vc_ptr);

    var s: agent::Surface = agent::open(win.raw());
    let nodes: vec::Vec[agent::AppKitNode] = s.describe();
    var found: bool = false;
    var i: usize = 0 as usize;
    while i < nodes.count() {
        match nodes.at_ptr(i) {
            option::Option[*agent::AppKitNode]::Some(n) => {
                if { (*n).id.view() } == "run-toggle" {
                    found = true;
                    assert identity::role_eq({ (*n).role }, identity::Role::Button);
                    assert { (*n).actionable };
                }
            }
            option::Option[*agent::AppKitNode]::None => { }
        }
        i = i +% (1 as usize);
    }
    assert found;   // the accessory's control was NOT reached before the fix
    return;
}

#[test]
fn click_gates_by_exposure_and_id() {
    CLICKS = 0;
    let win = fixture_window(300.0f64, 200.0f64);
    let content = content_of(win);
    let b = add_button(content, "go");
    b.as_control().set_on_action(on_probe_click);
    agent::set_agent_id(b.as_view().raw(), "go-btn");
    let stray = add_button(content, "stray"); // untagged -> NotExposed
    let _sv: *u8 = stray.as_view().raw();

    var s: agent::Surface = agent::open(win.raw());
    assert surface::outcome_eq(s.click("go-btn"), surface::Outcome::Allowed);
    assert CLICKS == 1;
    assert surface::outcome_eq(s.click("nope"), surface::Outcome::NotFound);
    // The stray button's auto id resolves but the node is unexposed.
    let nodes: vec::Vec[agent::AppKitNode] = s.describe();
    match nodes.at_ptr(3 as usize) {
        option::Option[*agent::AppKitNode]::Some(n) => {
            let auto_id: text::Text = text::from_str({ (*n).id.view() });
            assert surface::outcome_eq(s.click(auto_id.view()), surface::Outcome::NotExposed);
        }
        option::Option[*agent::AppKitNode]::None => { assert false; }
    }
    assert CLICKS == 1;
}

#[test]
fn accessibility_identifier_is_the_declarative_tag_channel() {
    // A view tagged ONLY via accessibilityIdentifier (what facet's mount
    // applies) is exposed exactly like a set_agent_id pin...
    let win = fixture_window(300.0f64, 200.0f64);
    let content = content_of(win);
    let b = add_button(content, "go");
    ak::Accessibility::from_raw(b.as_view().raw()).set_accessibility_identifier("ax-btn");

    var s: agent::Surface = agent::open(win.raw());
    assert surface::outcome_eq(s.click("ax-btn"), surface::Outcome::Allowed);

    // ...and an explicit pin wins over the identifier when both exist.
    agent::set_agent_id(b.as_view().raw(), "pinned");
    var s2: agent::Surface = agent::open(win.raw());
    assert surface::outcome_eq(s2.click("pinned"), surface::Outcome::Allowed);
    assert surface::outcome_eq(s2.click("ax-btn"), surface::Outcome::NotFound);
}

#[test]
fn removed_view_reports_stale_not_uaf() {
    let win = fixture_window(300.0f64, 200.0f64);
    let content = content_of(win);
    let b = add_button(content, "go");
    agent::set_agent_id(b.as_view().raw(), "go-btn");

    var s: agent::Surface = agent::open(win.raw());
    assert surface::outcome_eq(s.click("go-btn"), surface::Outcome::Allowed);

    // Replace the UI the way an MVU re-render does: the button leaves the
    // window. The surface retains it (no dangling pointer), and acting on
    // it now reports Stale — the agent's cue to re-open.
    b.as_view().remove_from_superview();
    assert surface::outcome_eq(s.click("go-btn"), surface::Outcome::Stale);
    assert surface::outcome_eq(s.scroll_to("go-btn"), surface::Outcome::Stale);
    let base: u64 = s.text_version("go-btn");
    // set_text authorization fails earlier (a button is click-ceiling), so
    // use a field for the text path.
    let f = ak::TextField::new_with_frame(rt::Rect { x: 10.0, y: 50.0, w: 100.0, h: 24.0 });
    content.add_subview(f.as_view());
    agent::set_agent_id(f.as_view().raw(), "field");
    var s2: agent::Surface = agent::open(win.raw());
    f.as_view().remove_from_superview();
    assert surface::outcome_eq(s2.set_text("field", "x", s2.text_version("field")), surface::Outcome::Stale);
    let _b: u64 = base;
}

#[test]
fn click_on_view_without_performclick_reports_notactionable_not_raise() {
    // A tagged plain NSView is exposed and actionable (non-controls default to
    // enabled), yet does NOT answer `performClick:`. The previous unguarded
    // send raised "unrecognized selector" — an agent click on a facet
    // `clickable` (a gesture-only NSView) could crash the process. `click` now
    // guards with respondsToSelector: (like `live_enabled` already does) and
    // reports NotActionable instead. facet clickables answer performClick: now,
    // so this exercises the defensive path for any non-clicking tagged view.
    let win = fixture_window(300.0f64, 200.0f64);
    let content = content_of(win);
    let plain = ak::View::new(rt::Rect { x: 5.0, y: 5.0, w: 40.0, h: 20.0 });
    content.add_subview(ak::View::from_raw(plain.raw()));
    agent::set_agent_id(plain.raw(), "plain-view");

    var s: agent::Surface = agent::open(win.raw());
    assert surface::outcome_eq(s.click("plain-view"), surface::Outcome::NotActionable);
}

#[test]
fn declared_affordance_overrides_native_classify() {
    // Phase 2: a plain NSView classifies as Group by type, but a declared
    // affordance (what facet set_identity records) wins — so a clickable
    // wrapper is Button, not Group, and describe stops guessing.
    let win = fixture_window(300.0f64, 200.0f64);
    let content = content_of(win);
    let plain = ak::View::new(rt::Rect { x: 5.0, y: 5.0, w: 40.0, h: 20.0 });
    content.add_subview(ak::View::from_raw(plain.raw()));
    agent::set_agent_id(plain.raw(), "row-click");
    agent::set_affordance(plain.raw(), identity::Role::Button);

    var s: agent::Surface = agent::open(win.raw());
    let nodes: vec::Vec[agent::AppKitNode] = s.describe();
    // window + content + plain = 3.
    assert nodes.count() == (3 as usize);
    match nodes.at_ptr(2 as usize) {
        option::Option[*agent::AppKitNode]::Some(n) => {
            assert { (*n).id.view() } == "row-click";
            assert identity::role_eq({ (*n).role }, identity::Role::Button);
            assert { (*n).actionable };
        }
        option::Option[*agent::AppKitNode]::None => { assert false; }
    };

    // Without a declaration the same native type stays Group (fallback).
    let plain2 = ak::View::new(rt::Rect { x: 50.0, y: 5.0, w: 40.0, h: 20.0 });
    content.add_subview(ak::View::from_raw(plain2.raw()));
    agent::set_agent_id(plain2.raw(), "bare");
    var s2: agent::Surface = agent::open(win.raw());
    let nodes2: vec::Vec[agent::AppKitNode] = s2.describe();
    match nodes2.at_ptr(3 as usize) {
        option::Option[*agent::AppKitNode]::Some(n) => {
            assert { (*n).id.view() } == "bare";
            assert identity::role_eq({ (*n).role }, identity::Role::Group);
        }
        option::Option[*agent::AppKitNode]::None => { assert false; }
    };
}

#[test]
fn declared_input_affordance_on_scroll_document_style_view() {
    // Composer/text_area identity lands on the inner NSTextView; if that
    // view carries a declared Input affordance it must win even if a future
    // classify regression would mis-tag it.
    let win = fixture_window(300.0f64, 200.0f64);
    let content = content_of(win);
    let tv = ak::TextView::new_with_frame(rt::Rect { x: 10.0, y: 10.0, w: 200.0, h: 60.0 });
    content.add_subview(tv.as_view());
    agent::set_agent_id(tv.as_view().raw(), "chat-input");
    agent::set_affordance(tv.as_view().raw(), identity::Role::Input);

    var s: agent::Surface = agent::open(win.raw());
    assert surface::outcome_eq(
        s.set_text("chat-input", "hello", s.text_version("chat-input")),
        surface::Outcome::Allowed);
    let ttxt: text::Text = bridge::to_text(rt::msg_id(tv.as_view().raw(), rt::sel(#str_ptr("string\0"))));
    assert ttxt.view() == "hello";
    // Drive is text — click is refused even though the node is exposed.
    assert surface::outcome_eq(s.click("chat-input"), surface::Outcome::NotActionable);
}

#[test]
fn declared_drive_none_is_observe_only() {
    // A tagged label with declared Text (drive_none) is exposed for reads but
    // never actionable — the agent cannot click or set_text it.
    let win = fixture_window(300.0f64, 200.0f64);
    let content = content_of(win);
    let l = ak::TextField::label_with_string("hello");
    content.add_subview(l.as_view());
    agent::set_agent_id(l.as_view().raw(), "title");
    agent::set_affordance(l.as_view().raw(), identity::Role::Text);

    var s: agent::Surface = agent::open(win.raw());
    let nodes: vec::Vec[agent::AppKitNode] = s.describe();
    match nodes.at_ptr(2 as usize) {
        option::Option[*agent::AppKitNode]::Some(n) => {
            assert { (*n).id.view() } == "title";
            assert identity::role_eq({ (*n).role }, identity::Role::Text);
            assert !{ (*n).actionable };
        }
        option::Option[*agent::AppKitNode]::None => { assert false; }
    }
    assert surface::outcome_eq(s.click("title"), surface::Outcome::NotActionable);
    assert surface::outcome_eq(
        s.set_text("title", "x", s.text_version("title")),
        surface::Outcome::NotActionable);
}

#[test]
fn declared_button_refuses_set_text() {
    let win = fixture_window(300.0f64, 200.0f64);
    let content = content_of(win);
    let b = add_button(content, "go");
    agent::set_agent_id(b.as_view().raw(), "go-btn");
    agent::set_affordance(b.as_view().raw(), identity::Role::Button);

    var s: agent::Surface = agent::open(win.raw());
    assert surface::outcome_eq(
        s.set_text("go-btn", "nope", s.text_version("go-btn")),
        surface::Outcome::NotActionable);
    // Click still works.
    assert surface::outcome_eq(s.click("go-btn"), surface::Outcome::Allowed);
}

#[test]
fn set_text_persists_on_field_and_text_view() {
    // Regression: set_text always sent `setStringValue:`, which NSTextView
    // silently ignores — the outcome was Allowed but the text never landed
    // (bugs/agent-appkit-set-text-nstextview.md). Both setter paths must
    // actually persist on the widget.
    let win = fixture_window(300.0f64, 240.0f64);
    let content = content_of(win);
    let f = ak::TextField::new_with_frame(rt::Rect { x: 10.0, y: 50.0, w: 200.0, h: 24.0 });
    content.add_subview(f.as_view());
    agent::set_agent_id(f.as_view().raw(), "name");
    let tv = ak::TextView::new_with_frame(rt::Rect { x: 10.0, y: 90.0, w: 200.0, h: 80.0 });
    content.add_subview(tv.as_view());
    agent::set_agent_id(tv.as_view().raw(), "desc");

    var s: agent::Surface = agent::open(win.raw());
    assert surface::outcome_eq(
        s.set_text("name", "AgentApp", s.text_version("name")),
        surface::Outcome::Allowed);
    assert surface::outcome_eq(
        s.set_text("desc", "a multi-line\ndescription", s.text_version("desc")),
        surface::Outcome::Allowed);

    // Read back through the widgets themselves: NSControl via `stringValue`,
    // NSTextView via `string`.
    let ftxt: text::Text = bridge::to_text(rt::msg_id(f.as_view().raw(), rt::sel(#str_ptr("stringValue\0"))));
    assert ftxt.view() == "AgentApp";
    let ttxt: text::Text = bridge::to_text(rt::msg_id(tv.as_view().raw(), rt::sel(#str_ptr("string\0"))));
    assert ttxt.view() == "a multi-line\ndescription";

    // Both writes bumped their versions.
    assert s.text_version("name") > (0 as u64);
    assert s.text_version("desc") > (0 as u64);
}

#[test]
fn describe_survives_a_replaced_tree() {
    // A full describe on a surface whose views were ALL removed must not
    // crash (views are retained; reads land on live, detached objects).
    let win = fixture_window(300.0f64, 200.0f64);
    let content = content_of(win);
    let b = add_button(content, "go");
    agent::set_agent_id(b.as_view().raw(), "go-btn");

    var s: agent::Surface = agent::open(win.raw());
    b.as_view().remove_from_superview();
    let nodes: vec::Vec[agent::AppKitNode] = s.describe();
    assert nodes.count() == (3 as usize);
}

// ---- hit_test: the pointer question the action verbs cannot ask -------------

// An overlay covering `under`, added AFTER it so it is topmost (hitTest: walks
// subviews in reverse). Plain NSView: hit-testing is frame + hidden, not paint.
fn add_overlay(content: ak::View, over: rt::Rect) -> ak::View {
    let v = ak::View::new(over);
    content.add_subview(v);
    return v;
}

#[test]
fn hit_test_reports_a_reachable_control() {
    let win = fixture_window(300.0f64, 200.0f64);
    let content = content_of(win);
    let b = add_button(content, "go");
    agent::set_agent_id(b.as_view().raw(), "go-btn");

    var s: agent::Surface = agent::open(win.raw());
    let h: surface::HitTest = s.hit_test("go-btn");
    assert surface::outcome_eq(h.outcome, surface::Outcome::Allowed);
    assert h.supported;
    assert h.reachable;
    assert h.covered == false;
    assert h.covered_by.view() == "";
}

// THE CASE THIS VERB EXISTS FOR. `click` cannot tell these apart: it sends
// `performClick:` straight to the view, so it reports Allowed on a control no
// person could reach. The assertion on `click` below is the point — it is not
// a bug, it is the blindness, and hit_test is what sees past it.
#[test]
fn hit_test_names_the_exposed_overlay_that_buries_a_control() {
    let win = fixture_window(300.0f64, 200.0f64);
    let content = content_of(win);
    let b = add_button(content, "go");
    agent::set_agent_id(b.as_view().raw(), "go-btn");
    // Covers the button's frame (10,10,80,24) completely.
    let ov = add_overlay(content, rt::Rect { x: 0.0, y: 0.0, w: 200.0, h: 100.0 });
    agent::set_agent_id(ov.raw(), "overlay");

    var s: agent::Surface = agent::open(win.raw());
    let h: surface::HitTest = s.hit_test("go-btn");
    assert surface::outcome_eq(h.outcome, surface::Outcome::Allowed);
    assert h.reachable == false;
    assert h.covered;
    assert h.covered_by.view() == "overlay";

    // ...while the action verb still says yes, which is exactly the gap.
    assert surface::outcome_eq(s.click("go-btn"), surface::Outcome::Allowed);
    // And the overlay itself is reachable — it is the thing on top.
    let ho: surface::HitTest = s.hit_test("overlay");
    assert ho.reachable;
    assert ho.covered == false;
}

// The obstruction is reported, its identity is not, when it is UI the app never
// exposed. Naming it would let an agent enumerate unexposed nodes by putting
// something under them, which is a hole in the consent model rather than a
// feature — `covered` still carries the fact.
#[test]
fn hit_test_reports_an_unexposed_obstruction_without_naming_it() {
    let win = fixture_window(300.0f64, 200.0f64);
    let content = content_of(win);
    let b = add_button(content, "go");
    agent::set_agent_id(b.as_view().raw(), "go-btn");
    let _ov = add_overlay(content, rt::Rect { x: 0.0, y: 0.0, w: 200.0, h: 100.0 });   // untagged

    var s: agent::Surface = agent::open(win.raw());
    let h: surface::HitTest = s.hit_test("go-btn");
    assert h.reachable == false;
    assert h.covered;
    assert h.covered_by.view() == "";
}

// A hit on a node's own CHILD still means the node is reachable — the pointer
// got there. Without this a container would always report itself covered by
// its own content, which is the opposite of the answer wanted.
#[test]
fn hit_test_counts_a_hit_on_a_childs_view_as_reaching_the_parent() {
    let win = fixture_window(300.0f64, 200.0f64);
    let content = content_of(win);
    let group = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 200.0, h: 100.0 });
    content.add_subview(group);
    agent::set_agent_id(group.raw(), "group");
    let inner = ak::Button::new_with_frame(rt::Rect { x: 0.0, y: 0.0, w: 200.0, h: 100.0 });
    group.add_subview(inner.as_view());
    agent::set_agent_id(inner.as_view().raw(), "inner-btn");

    var s: agent::Surface = agent::open(win.raw());
    let h: surface::HitTest = s.hit_test("group");
    assert h.reachable;
    assert h.covered == false;
}

#[test]
fn hit_test_negatives_report_rather_than_guess() {
    let win = fixture_window(300.0f64, 200.0f64);
    let content = content_of(win);
    let b = add_button(content, "go");
    agent::set_agent_id(b.as_view().raw(), "go-btn");
    var s: agent::Surface = agent::open(win.raw());

    // Unknown id: no reachability claim at all.
    let miss: surface::HitTest = s.hit_test("nope");
    assert surface::outcome_eq(miss.outcome, surface::Outcome::NotFound);
    assert miss.reachable == false;
    assert miss.covered == false;

    // A view that left the live UI is Stale, not "unreachable" — the
    // difference matters: one says re-open the surface, the other says
    // something is on top.
    b.as_view().remove_from_superview();
    let gone: surface::HitTest = s.hit_test("go-btn");
    assert surface::outcome_eq(gone.outcome, surface::Outcome::Stale);
    assert gone.reachable == false;
    assert gone.covered == false;
}
// ---- the real mouseDown: path ----------------------------------------------

#[link_name = "objc_autoreleasePoolPush"]
extern fn pool_push() -> *u8;
#[link_name = "objc_autoreleasePoolPop"]
extern fn pool_pop(p: *u8);

// The regression test for bugs/dragging-item-double-release.md, driving the
// path that actually crashed rather than modelling it.
//
// `drag_mousedown_imp` over-released its NSDraggingItem, so the drag session's
// autoreleased array was left holding freed memory. The fault did not land at
// the click — it landed at the next autorelease-pool DRAIN, which is why the
// stack named nothing of ours and why 105 scripted agent cycles never saw it
// (the ACI's `click` sends `performClick:` and never enters `mouseDown:`).
//
// So: a real NSEvent, a real `mouseDown:` on a real FacetDragView in a real
// window, then drain the pool inside the test. With the bug present this
// process dies here; the assertion below is simply that it did not.
#[test]
fn a_real_mouse_down_on_a_draggable_survives_the_pool_drain() {
    let win = fixture_window(400.0f64, 300.0f64);
    let content = content_of(win);
    let card = akx::new_drag_view("card-payload");
    card.set_frame(rt::Rect { x: 20.0, y: 20.0, w: 120.0, h: 60.0 });
    content.add_subview(card);

    let wnum: i64 = rt::msg_i64(win.raw(), rt::sel(#str_ptr("windowNumber\0")));
    let at: rt::Point = rt::Point { x: 80.0, y: 50.0 };
    let nilctx: ak::GraphicsContext = ak::GraphicsContext::from_raw(0 as *u8);
    let pool: *u8 = { pool_push() };
    match ak::Event::mouse_event_with_type(
        ak::EventType::LeftMouseDown,
        at,
        0 as u64, 0.0f64, wnum,
        nilctx,
        0 as i64, 1 as i64, 1.0f32,
    ) {
        option::Option[ak::Event]::Some(ev) => {
            // THE CLICK. One mouseDown: was the whole trigger — no drag, no
            // drop, no movement.
            rt::msg_void_id(card.raw(), rt::sel(#str_ptr("mouseDown:\0")), ev.raw());
        }
        option::Option[ak::Event]::None => { assert false; }
    }
    // THE CRASH SITE. Releases the drag session's array, which releases its
    // elements — one of which used to be freed memory.
    { pool_pop(pool); }

    assert true;   // reached here: no over-release, no zombie, no SIGSEGV
}

// ---- gap 1: the drag's visual layer, and coexisting with a click -----------

static ENTERS: i32 = 0;
static EXITS: i32 = 0;
// One handler for both edges; which edge it is comes from the SENDER. A handler
// that had to be told would be a handler that can be told wrong.
fn on_target_probe(sender: *u8, ctx: *u8) {
    if akx::drag_targeted(sender) { ENTERS = ENTERS + 1; } else { EXITS = EXITS + 1; }
    return;
}
fn on_drop_probe(sender: *u8, ctx: *u8) { return; }

fn mouse_at(win: ak::Window, ty: ak::EventType, x: f64, y: f64) -> ak::Event {
    let at: rt::Point = rt::Point { x: x, y: y };
    let nilctx: ak::GraphicsContext = ak::GraphicsContext::from_raw(0 as *u8);
    let wnum: i64 = rt::msg_i64(win.raw(), rt::sel(#str_ptr("windowNumber\0")));
    return match ak::Event::mouse_event_with_type(ty, at, 0 as u64, 0.0f64, wnum, nilctx, 0 as i64, 1 as i64, 1.0f32) {
        option::Option[ak::Event]::Some(e) => e,
        option::Option[ak::Event]::None => { ak::Event::from_raw(0 as *u8) }
    };
}

// (c) A lane must be able to highlight while a card is over it. Ordinary hover
// cannot do this — AppKit suppresses mouse-tracking for the duration of a drag
// — so the destination's own callbacks are the only source. And a DROP counts
// as an exit: nothing else fires afterwards, so a highlight lit on enter and
// never cleared stays lit forever.
#[test]
fn a_drop_target_reports_drag_enter_and_exit_including_on_drop() {
    let win = fixture_window(400.0f64, 300.0f64);
    let content = content_of(win);
    let lane = akx::new_drop_view(on_drop_probe, null_ctx());
    lane.set_frame(rt::Rect { x: 0.0, y: 0.0, w: 200.0, h: 200.0 });
    content.add_subview(lane);
    akx::set_drag_over(lane.raw(), on_target_probe, null_ctx());

    ENTERS = 0;
    EXITS = 0;
    let entered_sel: *u8 = rt::sel(#str_ptr("draggingEntered:\0"));
    let exited_sel: *u8 = rt::sel(#str_ptr("draggingExited:\0"));
    assert rt::msg_i8_id(lane.raw(), rt::sel(#str_ptr("respondsToSelector:\0")), exited_sel) != (0 as i8);

    assert akx::drag_targeted(lane.raw()) == false;

    // Enter sets the state BEFORE calling, so the handler already reads true —
    // and still advertises Copy (=1) to the dragger.
    assert rt::msg_u64_id(lane.raw(), entered_sel, 0 as *u8) == (1 as u64);
    assert ENTERS == (1 as i32);
    assert EXITS == (0 as i32);
    assert akx::drag_targeted(lane.raw());

    // IDEMPOTENT: re-entering an already-targeted view fires nothing, so a
    // handler cannot be made to count edges that did not happen.
    assert rt::msg_u64_id(lane.raw(), entered_sel, 0 as *u8) == (1 as u64);
    assert ENTERS == (1 as i32);

    // Leaving without dropping.
    rt::msg_void_id(lane.raw(), exited_sel, 0 as *u8);
    assert EXITS == (1 as i32);
    assert akx::drag_targeted(lane.raw()) == false;
    // ...and leaving twice is also idempotent.
    rt::msg_void_id(lane.raw(), exited_sel, 0 as *u8);
    assert EXITS == (1 as i32);

    // Dropping ALSO clears it — the case a highlight would otherwise survive
    // forever, and the reason the framework owns this edge rather than the app.
    assert rt::msg_u64_id(lane.raw(), entered_sel, 0 as *u8) == (1 as u64);
    assert ENTERS == (2 as i32);
    let _ok: i8 = rt::msg_i8_id(lane.raw(), rt::sel(#str_ptr("performDragOperation:\0")), 0 as *u8);
    assert EXITS == (2 as i32);
    assert akx::drag_targeted(lane.raw()) == false;
}

// (d) A destination must implement draggingUpdated:, which is where it walks
// the enclosing scroll view as the pointer nears an edge. Without it a column
// that is off-screen cannot be reached at all, and wheel-scrolling mid-drag is
// not a gesture anyone makes with a card in hand.
#[test]
fn a_drop_target_answers_dragging_updated_for_autoscroll() {
    let win = fixture_window(400.0f64, 300.0f64);
    let content = content_of(win);
    let lane = akx::new_drop_view(on_drop_probe, null_ctx());
    lane.set_frame(rt::Rect { x: 0.0, y: 0.0, w: 200.0, h: 200.0 });
    content.add_subview(lane);

    let updated: *u8 = rt::sel(#str_ptr("draggingUpdated:\0"));
    assert rt::msg_i8_id(lane.raw(), rt::sel(#str_ptr("respondsToSelector:\0")), updated) != (0 as i8);
    // Still advertises Copy, and survives a nil sender (no window, no drag).
    assert rt::msg_u64_id(lane.raw(), updated, 0 as *u8) == (1 as u64);
}

// (b) THE ONE THAT MATTERS. A press that never travels is a CLICK: no drag
// session starts, and the event is handed to the next responder so whatever
// would have had it still gets it. This is what lets the drag source be the
// card itself rather than a separate grip rail — and with the card as the
// source, its own snapshot becomes the drag preview, so (a) needs no API.
#[test]
fn a_press_without_movement_is_a_click_not_a_drag() {
    let win = fixture_window(400.0f64, 300.0f64);
    let content = content_of(win);
    let card = akx::new_drag_view("card-1");
    card.set_frame(rt::Rect { x: 20.0, y: 20.0, w: 200.0, h: 100.0 });
    content.add_subview(card);

    let responds: *u8 = rt::sel(#str_ptr("respondsToSelector:\0"));
    assert rt::msg_i8_id(card.raw(), responds, rt::sel(#str_ptr("mouseDragged:\0"))) != (0 as i8);
    assert rt::msg_i8_id(card.raw(), responds, rt::sel(#str_ptr("mouseUp:\0"))) != (0 as i8);

    let pool: *u8 = { pool_push() };
    // Press: ARMED, and no session — the old behaviour began one right here.
    rt::msg_void_id(card.raw(), rt::sel(#str_ptr("mouseDown:\0")), mouse_at(win, ak::EventType::LeftMouseDown, 100.0f64, 60.0f64).raw());
    assert akx::drag_is_armed(card.raw());
    // Release without travel: disarmed, and the event went to the next
    // responder rather than being swallowed.
    rt::msg_void_id(card.raw(), rt::sel(#str_ptr("mouseUp:\0")), mouse_at(win, ak::EventType::LeftMouseUp, 100.0f64, 60.0f64).raw());
    assert akx::drag_is_armed(card.raw()) == false;
    { pool_pop(pool); }
    return;
}

// A press that moves less than the threshold is still a click — the tremor a
// deliberate click carries must not turn into a drag.
#[test]
fn a_press_within_the_threshold_is_still_a_click() {
    let win = fixture_window(400.0f64, 300.0f64);
    let content = content_of(win);
    let card = akx::new_drag_view("card-2");
    card.set_frame(rt::Rect { x: 20.0, y: 20.0, w: 200.0, h: 100.0 });
    content.add_subview(card);

    let pool: *u8 = { pool_push() };
    rt::msg_void_id(card.raw(), rt::sel(#str_ptr("mouseDown:\0")), mouse_at(win, ak::EventType::LeftMouseDown, 100.0f64, 60.0f64).raw());
    // ~1.4pt of travel, under the 3pt threshold: still a click in progress.
    rt::msg_void_id(card.raw(), rt::sel(#str_ptr("mouseDragged:\0")), mouse_at(win, ak::EventType::LeftMouseDragged, 101.0f64, 61.0f64).raw());
    assert akx::drag_is_armed(card.raw());
    rt::msg_void_id(card.raw(), rt::sel(#str_ptr("mouseUp:\0")), mouse_at(win, ak::EventType::LeftMouseUp, 101.0f64, 61.0f64).raw());
    assert akx::drag_is_armed(card.raw()) == false;
    { pool_pop(pool); }
    return;
}

// ...and past it, the press BECOMES a drag: the session starts and the press
// state is consumed, so one press can only ever produce one session.
#[test]
fn a_press_past_the_threshold_becomes_a_drag() {
    let win = fixture_window(400.0f64, 300.0f64);
    let content = content_of(win);
    let card = akx::new_drag_view("card-3");
    card.set_frame(rt::Rect { x: 20.0, y: 20.0, w: 200.0, h: 100.0 });
    content.add_subview(card);

    let pool: *u8 = { pool_push() };
    rt::msg_void_id(card.raw(), rt::sel(#str_ptr("mouseDown:\0")), mouse_at(win, ak::EventType::LeftMouseDown, 100.0f64, 60.0f64).raw());
    assert akx::drag_is_armed(card.raw());
    // 40pt of travel — unambiguously a drag.
    rt::msg_void_id(card.raw(), rt::sel(#str_ptr("mouseDragged:\0")), mouse_at(win, ak::EventType::LeftMouseDragged, 140.0f64, 60.0f64).raw());
    assert akx::drag_is_armed(card.raw()) == false;   // consumed by the session
    // A second drag in the same press starts nothing more.
    rt::msg_void_id(card.raw(), rt::sel(#str_ptr("mouseDragged:\0")), mouse_at(win, ak::EventType::LeftMouseDragged, 180.0f64, 60.0f64).raw());
    rt::msg_void_id(card.raw(), rt::sel(#str_ptr("mouseUp:\0")), mouse_at(win, ak::EventType::LeftMouseUp, 180.0f64, 60.0f64).raw());
    { pool_pop(pool); }
    return;
}

// A view with no payload is not a drag source at all, and must not accumulate
// press state — the guard that keeps a plain container from leaking a boxed
// point on every click.
#[test]
fn a_view_without_a_payload_never_arms_the_threshold() {
    let win = fixture_window(400.0f64, 300.0f64);
    let content = content_of(win);
    let plain: *u8 = { rt::msg_id(rt::msg_id(akx::drag_view_class(), rt::sel(#str_ptr("alloc\0"))), rt::sel(#str_ptr("init\0"))) };
    ak::View::from_raw(plain).set_frame(rt::Rect { x: 0.0, y: 0.0, w: 50.0, h: 50.0 });
    content.add_subview(ak::View::from_raw(plain));

    let pool: *u8 = { pool_push() };
    rt::msg_void_id(plain, rt::sel(#str_ptr("mouseDown:\0")), mouse_at(win, ak::EventType::LeftMouseDown, 10.0f64, 10.0f64).raw());
    rt::msg_void_id(plain, rt::sel(#str_ptr("mouseDragged:\0")), mouse_at(win, ak::EventType::LeftMouseDragged, 90.0f64, 90.0f64).raw());
    assert akx::drag_is_armed(plain) == false;   // never armed
    rt::msg_void_id(plain, rt::sel(#str_ptr("mouseUp:\0")), mouse_at(win, ak::EventType::LeftMouseUp, 90.0f64, 90.0f64).raw());
    { pool_pop(pool); }
    return;
}

// ---- drag auto-scroll: an edge BAND, not "outside the view" ----------------

fn near(a: f64, b: f64) -> bool {
    let d: f64 = if a > b { a - b } else { b - a };
    return d < 0.001f64;
}

// `autoscroll:` only fires when the pointer leaves the view's bounds, so it
// worked on a lane (small clip) and never on the board strip (clip the size of
// the window — a pointer anywhere inside it is "not outside"). The band is the
// fix, and this is its arithmetic: a viewport spanning 0..500 with a 40pt band.
// bugs/drag-autoscroll-only-on-an-overflowing-clip-view.md
#[test]
fn autoscroll_band_is_proportional_and_only_near_the_edges() {
    // Dead centre: nothing. This is the case that must NOT jitter.
    assert near(akx::autoscroll_delta(250.0f64, 0.0f64, 500.0f64), 0.0f64);
    // Just inside the band, either side: nothing.
    assert near(akx::autoscroll_delta(41.0f64, 0.0f64, 500.0f64), 0.0f64);
    assert near(akx::autoscroll_delta(459.0f64, 0.0f64, 500.0f64), 0.0f64);

    // At the leading edge: full step, negative (scroll back toward the start).
    assert near(akx::autoscroll_delta(0.0f64, 0.0f64, 500.0f64), 0.0f64 - 16.0f64);
    // At the trailing edge: full step, positive.
    assert near(akx::autoscroll_delta(500.0f64, 0.0f64, 500.0f64), 16.0f64);

    // Halfway into the band: half the step, so the nudge grows with depth
    // rather than jumping.
    assert near(akx::autoscroll_delta(20.0f64, 0.0f64, 500.0f64), 0.0f64 - 8.0f64);
    assert near(akx::autoscroll_delta(480.0f64, 0.0f64, 500.0f64), 8.0f64);

    // BEYOND the edge — which is all `autoscroll:` could ever detect — clamps to
    // the full step rather than running away. This is how the band subsumes the
    // old behaviour instead of replacing it.
    assert near(akx::autoscroll_delta(-200.0f64, 0.0f64, 500.0f64), 0.0f64 - 16.0f64);
    assert near(akx::autoscroll_delta(900.0f64, 0.0f64, 500.0f64), 16.0f64);

    // A scrolled viewport: the band follows the visible range, not the document.
    assert near(akx::autoscroll_delta(1000.0f64, 1000.0f64, 1500.0f64), 0.0f64 - 16.0f64);
    assert near(akx::autoscroll_delta(1250.0f64, 1000.0f64, 1500.0f64), 0.0f64);
    return;
}

// A clip view whose document FITS has no range on that axis and must not move —
// the jitter the report called out. Both axes, and through the real callback.
#[test]
fn autoscroll_leaves_a_clip_view_with_nothing_to_scroll_alone() {
    let win = fixture_window(400.0f64, 300.0f64);
    let content = content_of(win);
    let sv = ak::ScrollView::new(rt::Rect { x: 0.0, y: 0.0, w: 200.0, h: 200.0 });
    content.add_subview(sv.as_view());
    // Document SMALLER than the viewport: no range in either direction.
    let doc = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 100.0, h: 100.0 });
    sv.set_document_view(doc);

    let clip: *u8 = { rt::msg_id(sv.raw(), rt::sel(#str_ptr("contentView\0"))) };
    assert clip != (0 as *u8);
    let before: rt::Rect = rt::msg_rect(clip, rt::sel(#str_ptr("bounds\0")));
    // A pointer hard against the corner — deep in both bands.
    akx::autoscroll_clip(clip, rt::Point { x: 0.0, y: 0.0 });
    let after: rt::Rect = rt::msg_rect(clip, rt::sel(#str_ptr("bounds\0")));
    assert near(after.x, before.x);
    assert near(after.y, before.y);
    return;
}

// ...and one that DOES overflow moves, on the axis with range. This is the half
// that never worked: the strip is the size of the window, so nothing was ever
// "outside" it.
#[test]
fn autoscroll_moves_a_clip_view_that_has_range() {
    let win = fixture_window(400.0f64, 300.0f64);
    let content = content_of(win);
    let sv = ak::ScrollView::new(rt::Rect { x: 0.0, y: 0.0, w: 200.0, h: 200.0 });
    content.add_subview(sv.as_view());
    // Wide document: horizontal range, no vertical range.
    let doc = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 2000.0, h: 100.0 });
    sv.set_document_view(doc);

    let clip: *u8 = { rt::msg_id(sv.raw(), rt::sel(#str_ptr("contentView\0"))) };
    let before: rt::Rect = rt::msg_rect(clip, rt::sel(#str_ptr("bounds\0")));
    // Pointer at the RIGHT edge of the clip, in window coords (the clip sits at
    // the content view's origin, so window x ~ clip x here).
    akx::autoscroll_clip(clip, rt::Point { x: 199.0, y: 100.0 });
    let after: rt::Rect = rt::msg_rect(clip, rt::sel(#str_ptr("bounds\0")));
    assert after.x > before.x;          // walked toward the far end
    assert near(after.y, before.y);     // the axis with no range stayed put
    return;
}
