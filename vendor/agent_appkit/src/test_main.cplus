// agent_appkit test root — headless coverage against real AppKit widgets.
//
// The library never imports appkit (it drives views through the raw ObjC
// runtime); the typed binding here is fixture convenience only. Every test
// builds a real NSWindow + widgets, opens a Surface, and exercises the
// walk / describe / act paths, including the negatives: unexposed nodes,
// unknown ids, and views that left the live UI (`Stale`).

import "objc/runtime" as rt;
import "objc/bridge" as bridge;
import "appkit/appkit" as ak;
import "appkit/appkit_ext" as akx;   // for new_drag_view: the mouseDown: regression below drives a real FacetDragView
import "agent_core/identity" as identity;
import "agent_core/surface" as surface;
import "agent_core/auth" as auth;
import "stdlib/vec" as vec;
import "stdlib/text" as text;
import "stdlib/option" as option;
import "stdlib/io" as io;
import "objc/synthesis" as synth;
import "stdlib/thread" as thread;   // the off-main invoke_menu regression below needs a real second thread
import "./agent_appkit" as agent;

fn main() -> i32 { return 0; }

fn null_ctx() -> *u8 { return { 0 as *u8 }; }

// One titled window with a content view; the app is initialized once
// (shared_application is idempotent).
fn fixture_window(w: f64, h: f64) -> ak::Window {
    let _app: ak::Application = ak::Application::shared_application();
    let win = ak::Window::new(
        rt::Rect { x: 0.0, y: 0.0, w: w, h: h },
        ak::window_style_mask_titled,
        ak::BackingStoreType::NSBackingStoreBuffered,
        false,
    );
    rt::retain(win.raw());
    let content = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: w, h: h });
    win.set_content_view(ak::View::from_raw(content.raw()));
    return win;
}

fn content_of(win: ak::Window) -> ak::View {
    return ak::View::from_raw(rt::msg_id(win.raw(), rt::sel(#str_ptr("contentView\0"))));
}

// A button that is actually WIRED, which is what every test using this fixture
// meant by "a button". It used to build one with no target and no action — dead
// by construction — and the suite could not tell, because `click` answered
// `Allowed` for it. That is the same blindness this file now tests for, and it
// was inside the tests themselves.
fn add_button(content: ak::View, title: str) -> ak::Button {
    let b = ak::Button::new_with_frame(rt::Rect { x: 10.0, y: 10.0, w: 80.0, h: 24.0 });
    b.set_title(title);
    b.as_control().set_on_action(on_probe_click);
    content.add_subview(b.as_view());
    return b;
}

// ...and one that is NOT, for the tests that are about exactly that. Same
// class, same frame, same everything a describe can see — the only difference
// is that nothing is on the other end.
fn add_dead_button(content: ak::View, title: str) -> ak::Button {
    let b = ak::Button::new_with_frame(rt::Rect { x: 10.0, y: 10.0, w: 80.0, h: 24.0 });
    b.set_title(title);
    content.add_subview(b.as_view());
    return b;
}

static CLICKS: i32 = 0;
fn on_probe_click(sender: *u8) {
    CLICKS = CLICKS + 1;
}

#[test]
fn walk_classifies_and_exposes_only_tagged() {
    let win = fixture_window(300.0, 200.0);
    let content = content_of(win);
    let b = add_button(content, "go");
    agent::set_agent_id(b.as_view().raw(), "go-btn");
    let l = ak::TextField::label_with_string("hello");
    content.add_subview(l.as_view());

    var s: agent::Surface = agent::open(win.raw());
    let nodes: vec::Vec[agent::AppKitNode] = s.describe(auth::operator());
    // window + content group + button + label = 4 nodes.
    assert nodes.count() == 4;
    match nodes.at_ptr(2) {
        option::Option[*agent::AppKitNode]::Some(n) => {
            assert identity::role_eq({ (*n).role }, identity::Role::Button);
            assert { (*n).id.view() } == "go-btn";
            assert { (*n).actionable };
        }
        option::Option::None => { assert false; }
    }
    match nodes.at_ptr(3) {
        option::Option[*agent::AppKitNode]::Some(n) => {
            assert identity::role_eq({ (*n).role }, identity::Role::Text);
            // Untagged: auto id, not exposed, not actionable.
            assert !{ (*n).actionable };
        }
        option::Option::None => { assert false; }
    };
}

#[test]
fn open_walks_titlebar_accessory_controls() {
    // #13: title-bar accessory views (fak::install_titlebar) are siblings of the
    // contentView under NSThemeFrame; open() must reach them so a tagged control
    // there stays agent-addressable (regressed when #12 moved iris's toolbar
    // into the title bar). Attach the accessory raw — the library owns no appkit.
    let win = fixture_window(400.0, 300.0);
    let acc_view = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 200.0, h: 30.0 });
    let tb = add_button(acc_view, "run");
    agent::set_agent_id(tb.as_view().raw(), "run-toggle");
    let vc_ptr: *u8 = rt::alloc_init(#str_ptr("NSTitlebarAccessoryViewController\0"));
    rt::msg_void_id(vc_ptr, rt::sel(#str_ptr("setView:\0")), acc_view.raw());
    rt::msg_void_id(win.raw(), rt::sel(#str_ptr("addTitlebarAccessoryViewController:\0")), vc_ptr);

    var s: agent::Surface = agent::open(win.raw());
    let nodes: vec::Vec[agent::AppKitNode] = s.describe(auth::operator());
    var found: bool = false;
    var i: usize = 0;
    while i < nodes.count() {
        match nodes.at_ptr(i) {
            option::Option[*agent::AppKitNode]::Some(n) => {
                if { (*n).id.view() } == "run-toggle" {
                    found = true;
                    assert identity::role_eq({ (*n).role }, identity::Role::Button);
                    assert { (*n).actionable };
                }
            }
            option::Option::None => { }
        }
        i = i +% 1;
    }
    assert found;   // the accessory's control was NOT reached before the fix
}

#[test]
fn click_gates_by_exposure_and_id() {
    CLICKS = 0;
    let win = fixture_window(300.0, 200.0);
    let content = content_of(win);
    let b = add_button(content, "go");
    b.as_control().set_on_action(on_probe_click);
    agent::set_agent_id(b.as_view().raw(), "go-btn");
    let stray = add_button(content, "stray"); // untagged -> NotExposed
    let _sv: *u8 = stray.as_view().raw();

    var s: agent::Surface = agent::open(win.raw());
    assert surface::outcome_eq(s.click(auth::operator(), "go-btn"), surface::Outcome::Allowed);
    assert CLICKS == 1;
    assert surface::outcome_eq(s.click(auth::operator(), "nope"), surface::Outcome::NotFound);
    // The stray button's auto id resolves but the node is unexposed.
    let nodes: vec::Vec[agent::AppKitNode] = s.describe(auth::operator());
    match nodes.at_ptr(3) {
        option::Option[*agent::AppKitNode]::Some(n) => {
            let auto_id: text::Text = text::from_str({ (*n).id.view() });
            assert surface::outcome_eq(s.click(auth::operator(), auto_id.view()), surface::Outcome::NotExposed);
        }
        option::Option::None => { assert false; }
    }
    assert CLICKS == 1;
}

#[test]
fn accessibility_identifier_is_the_declarative_tag_channel() {
    // A view tagged ONLY via accessibilityIdentifier (what facet's mount
    // applies) is exposed exactly like a set_agent_id pin...
    let win = fixture_window(300.0, 200.0);
    let content = content_of(win);
    let b = add_button(content, "go");
    ak::Accessibility::from_raw(b.as_view().raw()).set_accessibility_identifier("ax-btn");

    var s: agent::Surface = agent::open(win.raw());
    assert surface::outcome_eq(s.click(auth::operator(), "ax-btn"), surface::Outcome::Allowed);

    // ...and an explicit pin wins over the identifier when both exist.
    agent::set_agent_id(b.as_view().raw(), "pinned");
    var s2: agent::Surface = agent::open(win.raw());
    assert surface::outcome_eq(s2.click(auth::operator(), "pinned"), surface::Outcome::Allowed);
    assert surface::outcome_eq(s2.click(auth::operator(), "ax-btn"), surface::Outcome::NotFound);
}

#[test]
fn removed_view_reports_stale_not_uaf() {
    let win = fixture_window(300.0, 200.0);
    let content = content_of(win);
    let b = add_button(content, "go");
    agent::set_agent_id(b.as_view().raw(), "go-btn");

    var s: agent::Surface = agent::open(win.raw());
    assert surface::outcome_eq(s.click(auth::operator(), "go-btn"), surface::Outcome::Allowed);

    // Replace the UI the way an MVU re-render does: the button leaves the
    // window. The surface retains it (no dangling pointer), and acting on
    // it now reports Stale — the agent's cue to re-open.
    b.as_view().remove_from_superview();
    assert surface::outcome_eq(s.click(auth::operator(), "go-btn"), surface::Outcome::Stale);
    assert surface::outcome_eq(s.scroll_to(auth::operator(), "go-btn"), surface::Outcome::Stale);
    let base: u64 = s.text_version("go-btn");
    // set_text authorization fails earlier (a button is click-ceiling), so
    // use a field for the text path.
    let f = ak::TextField::new_with_frame(rt::Rect { x: 10.0, y: 50.0, w: 100.0, h: 24.0 });
    content.add_subview(f.as_view());
    agent::set_agent_id(f.as_view().raw(), "field");
    var s2: agent::Surface = agent::open(win.raw());
    f.as_view().remove_from_superview();
    assert surface::outcome_eq(s2.set_text(auth::operator(), "field", "x", s2.text_version("field")), surface::Outcome::Stale);
    let _b: u64 = base;
}

#[test]
fn click_on_view_without_performclick_reports_notactionable_not_raise() {
    // A tagged plain NSView is exposed and actionable (non-controls default to
    // enabled), yet does NOT answer `performClick:`. The previous unguarded
    // send raised "unrecognized selector" — an agent click on a facet
    // `clickable` (a gesture-only NSView) could crash the process. `click` now
    // guards with respondsToSelector: (like `live_enabled` already does) and
    // reports NotActionable instead. facet clickables answer performClick: now,
    // so this exercises the defensive path for any non-clicking tagged view.
    let win = fixture_window(300.0, 200.0);
    let content = content_of(win);
    let plain = ak::View::new(rt::Rect { x: 5.0, y: 5.0, w: 40.0, h: 20.0 });
    content.add_subview(ak::View::from_raw(plain.raw()));
    agent::set_agent_id(plain.raw(), "plain-view");

    var s: agent::Surface = agent::open(win.raw());
    assert surface::outcome_eq(s.click(auth::operator(), "plain-view"), surface::Outcome::NotActionable);
}

// ---- a gesture container is wired -------------------------------------------

// A plain NSView subclass that ANSWERS `performClick:` and carries none of
// appkit_ext's slots — the shape a framework produces when it swaps in a class
// to receive input. facet's is `FacetInput00`; this is the same thing without
// the dependency.
static PROBE_CLICKS: i32 = 0;
fn probe_perform_click(self_obj: *u8, cmd: *u8, sender: *u8) {
    PROBE_CLICKS = PROBE_CLICKS + 1;
}

fn armed_view_class() -> *u8 {
    let existing: *u8 = { rt::get_class(#str_ptr("AgentProbeArmedView\0")) };
    if existing.is_not_null() { return existing; }
    let cls: *u8 = synth::allocate_class_pair(rt::get_class(#str_ptr("NSView\0")),
                                              #str_ptr("AgentProbeArmedView\0"), 0);
    let _a: i8 = synth::add_method_v_1id(cls, rt::sel(#str_ptr("performClick:\0")),
                                         probe_perform_click, #str_ptr("v@:@\0"));
    synth::register_class_pair(cls);
    return cls;
}

#[test]
fn a_view_that_answers_performclick_is_wired() {
    // THE REGRESSION `wired` INTRODUCED. It was added so a dead control could
    // be told from a live one, and it read appkit_ext's agent-click SLOT for
    // every non-control — a slot facet never fills. So every gesture-bound
    // container reported `wired=false`: the one CORRECT way to make a
    // non-control clickable, and the very form the flag exists to distinguish
    // from a dead button.
    //
    // A framework swaps in a class that receives input only for a node that HAS
    // input, so answering `performClick:` is the answer. The exception is
    // appkit_ext's own two classes, whose `performClick:` reads the slot and
    // does nothing when it is empty — those are checked below.
    let win = fixture_window(300.0, 200.0);
    let content = content_of(win);

    // A view that answers the selector and is NOT one of the slot-reading
    // classes — the case the old rule got wrong. An NSButton would take the
    // CONTROL branch and never reach this one, which is why the first version
    // of this test passed against the bug.
    PROBE_CLICKS = 0;
    let armed: *u8 = synth::alloc_init_class(armed_view_class());
    { rt::msg_void_rect(armed, rt::sel(#str_ptr("setFrame:\0")),
                        rt::Rect { x: 5.0, y: 5.0, w: 40.0, h: 20.0 }) };
    content.add_subview(ak::View::from_raw(armed));
    agent::set_agent_id(armed, "live");

    var s: agent::Surface = agent::open(win.raw());
    let nodes: vec::Vec[agent::AppKitNode] = s.describe(auth::operator());
    var saw: bool = false;
    var i: usize = 0;
    while i < nodes.count() {
        match nodes.at_ptr(i) {
            option::Option[*agent::AppKitNode]::Some(n) => {
                if { (*n).id.view() } == "live" { saw = true; assert { (*n).wired }; }
            }
            option::Option::None => { }
        }
        i = i +% 1;
    }
    assert saw;
    // ...and `click` delivers to it.
    assert surface::outcome_eq(s.click(auth::operator(), "live"), surface::Outcome::Allowed);
    assert PROBE_CLICKS == 1;
}

#[test]
fn an_agent_clickable_view_is_wired_only_with_a_handler() {
    // The exception, both ways. appkit_ext's clickable view answers
    // `performClick:` unconditionally and then reads a slot, so for THIS class
    // — and only this class — answering the selector is not the same as being
    // wired.
    let win = fixture_window(300.0, 200.0);
    let content = content_of(win);

    let bare: ak::View = akx::new_clickable_view(rt::Rect { x: 5.0, y: 5.0, w: 40.0, h: 20.0 });
    content.add_subview(ak::View::from_raw(bare.raw()));
    agent::set_agent_id(bare.raw(), "slot-empty");

    let armed: ak::View = akx::new_clickable_view(rt::Rect { x: 5.0, y: 40.0, w: 40.0, h: 20.0 });
    content.add_subview(ak::View::from_raw(armed.raw()));
    akx::set_agent_click(armed, on_probe_click_2, 0 as *u8);
    agent::set_agent_id(armed.raw(), "slot-armed");

    var s: agent::Surface = agent::open(win.raw());
    let nodes: vec::Vec[agent::AppKitNode] = s.describe(auth::operator());
    var i: usize = 0;
    var saw_empty: bool = false;
    var saw_armed: bool = false;
    while i < nodes.count() {
        match nodes.at_ptr(i) {
            option::Option[*agent::AppKitNode]::Some(n) => {
                if { (*n).id.view() } == "slot-empty" {
                    saw_empty = true;
                    assert { (*n).wired } == false;
                }
                if { (*n).id.view() } == "slot-armed" {
                    saw_armed = true;
                    assert { (*n).wired };
                }
            }
            option::Option::None => { }
        }
        i = i +% 1;
    }
    assert saw_empty;
    assert saw_armed;

    // AND `click` REFUSES WITHOUT ACTING. The first version sent the click and
    // then reported `no_handler`, which is a verb that performs the action and
    // says it did not — untrustworthy in both directions, and an agent retrying
    // does the thing twice.
    CLICKS_2 = 0;
    assert surface::outcome_eq(s.click(auth::operator(), "slot-empty"),
                               surface::Outcome::NoHandler);
    assert CLICKS_2 == 0;
    assert surface::outcome_eq(s.click(auth::operator(), "slot-armed"),
                               surface::Outcome::Allowed);
    assert CLICKS_2 == 1;
}

static CLICKS_2: i32 = 0;
fn on_probe_click_2(sender: *u8, ctx: *u8) { CLICKS_2 = CLICKS_2 + 1; return; }

// ---- the disclosure part -----------------------------------------------------
//
// A folder row has TWO affordances — click the name to select it, click the
// triangle to open it — and a synthesized click carries no coordinate that
// could tell them apart. So the row's own click selects, like a person's, and
// the triangle gets its own address: `<row-id>:disclosure`, the same shape a
// search field's `:clear` uses.
//
// THE PART IS ONLY CREATED FOR A ROW THAT HAS ONE. That gate is `row_is_
// expandable`, and it is the whole reason this cannot advertise a press that
// does not exist — the bug the `clickable` field was added to remove. These
// pin the gate from the outside, where every answer must be NO.

#[test]
fn nothing_that_is_not_an_outline_row_grows_a_disclosure_part() {
    // A tagged view in a plain window is not a row of anything. If the gate
    // were loose this is where a phantom `:disclosure` would appear, on every
    // keyed node in every app.
    let win = fixture_window(300.0, 200.0);
    let content = content_of(win);
    let plain = ak::View::new(rt::Rect { x: 5.0, y: 5.0, w: 40.0, h: 20.0 });
    content.add_subview(ak::View::from_raw(plain.raw()));
    agent::set_agent_id(plain.raw(), "notarow");

    assert agent::row_is_expandable(plain.raw()) == false;

    var s: agent::Surface = agent::open(win.raw());
    let nodes: vec::Vec[agent::AppKitNode] = s.describe(auth::operator());
    // window + content + plain, and NOTHING else.
    assert nodes.count() == 3;
    var i: usize = 0;
    while i < nodes.count() {
        match nodes.at_ptr(i) {
            option::Option[*agent::AppKitNode]::Some(n) => {
                assert { (*n).id.view() } != "notarow:disclosure";
            }
            option::Option::None => { assert false; }
        }
        i = i +% 1;
    }
}

#[test]
fn a_disclosure_press_with_no_outline_under_it_refuses_rather_than_pretending() {
    // The other end of the same guarantee. If a part is ever minted for a view
    // that turns out not to be a row — recycled away, or the tree replaced
    // between describe and click — the press must REFUSE. `allowed` for a
    // toggle that did not happen is the exact silent failure this whole entry
    // came from.
    let win = fixture_window(300.0, 200.0);
    let content = content_of(win);
    let plain = ak::View::new(rt::Rect { x: 5.0, y: 5.0, w: 40.0, h: 20.0 });
    content.add_subview(ak::View::from_raw(plain.raw()));

    assert surface::outcome_eq(agent::click_part(plain.raw(), agent::PART_DISCLOSURE),
                               surface::Outcome::NotActionable);
}

#[test]
fn the_capability_flag_names_the_disclosure_part_too() {
    // `view_clickable` mirrors `click`'s body branch for branch, and a part
    // wired into `part_of` without an arm in BOTH would advertise a press that
    // does not exist. This is the pairing, asserted rather than assumed.
    let win = fixture_window(300.0, 200.0);
    let content = content_of(win);
    let plain = ak::View::new(rt::Rect { x: 5.0, y: 5.0, w: 40.0, h: 20.0 });
    content.add_subview(ak::View::from_raw(plain.raw()));
    assert agent::view_clickable(plain.raw(), agent::PART_DISCLOSURE);
    // And an unknown part is still refused by both halves.
    assert agent::view_clickable(plain.raw(), 99u32) == false;
    assert surface::outcome_eq(agent::click_part(plain.raw(), 99u32),
                               surface::Outcome::NotActionable);
}

#[test]
fn declared_affordance_overrides_native_classify() {
    // Phase 2: a plain NSView classifies as Group by type, but a declared
    // affordance (what facet set_identity records) wins — so a clickable
    // wrapper is Button, not Group, and describe stops guessing.
    let win = fixture_window(300.0, 200.0);
    let content = content_of(win);
    let plain = ak::View::new(rt::Rect { x: 5.0, y: 5.0, w: 40.0, h: 20.0 });
    content.add_subview(ak::View::from_raw(plain.raw()));
    agent::set_agent_id(plain.raw(), "row-click");
    agent::set_affordance(plain.raw(), identity::Role::Button);

    var s: agent::Surface = agent::open(win.raw());
    let nodes: vec::Vec[agent::AppKitNode] = s.describe(auth::operator());
    // window + content + plain = 3.
    assert nodes.count() == 3;
    match nodes.at_ptr(2) {
        option::Option[*agent::AppKitNode]::Some(n) => {
            assert { (*n).id.view() } == "row-click";
            assert identity::role_eq({ (*n).role }, identity::Role::Button);
            assert { (*n).actionable };
        }
        option::Option::None => { assert false; }
    };

    // Without a declaration the same native type stays Group (fallback).
    let plain2 = ak::View::new(rt::Rect { x: 50.0, y: 5.0, w: 40.0, h: 20.0 });
    content.add_subview(ak::View::from_raw(plain2.raw()));
    agent::set_agent_id(plain2.raw(), "bare");
    var s2: agent::Surface = agent::open(win.raw());
    let nodes2: vec::Vec[agent::AppKitNode] = s2.describe(auth::operator());
    match nodes2.at_ptr(3) {
        option::Option[*agent::AppKitNode]::Some(n) => {
            assert { (*n).id.view() } == "bare";
            assert identity::role_eq({ (*n).role }, identity::Role::Group);
        }
        option::Option::None => { assert false; }
    };
}

#[test]
fn declared_input_affordance_on_scroll_document_style_view() {
    // Composer/text_area identity lands on the inner NSTextView; if that
    // view carries a declared Input affordance it must win even if a future
    // classify regression would mis-tag it.
    let win = fixture_window(300.0, 200.0);
    let content = content_of(win);
    let tv = ak::TextView::new_with_frame(rt::Rect { x: 10.0, y: 10.0, w: 200.0, h: 60.0 });
    content.add_subview(tv.as_view());
    agent::set_agent_id(tv.as_view().raw(), "chat-input");
    agent::set_affordance(tv.as_view().raw(), identity::Role::Input);

    var s: agent::Surface = agent::open(win.raw());
    assert surface::outcome_eq(
        s.set_text(auth::operator(), "chat-input", "hello", s.text_version("chat-input")),
        surface::Outcome::Allowed);
    let ttxt: text::Text = bridge::to_text(rt::msg_id(tv.as_view().raw(), rt::sel(#str_ptr("string\0"))));
    assert ttxt.view() == "hello";
    // Drive is text — click is refused even though the node is exposed.
    assert surface::outcome_eq(s.click(auth::operator(), "chat-input"), surface::Outcome::NotActionable);
}

#[test]
fn declared_drive_none_is_observe_only() {
    // A tagged label with declared Text (drive_none) is exposed for reads but
    // never actionable — the agent cannot click or set_text it.
    let win = fixture_window(300.0, 200.0);
    let content = content_of(win);
    let l = ak::TextField::label_with_string("hello");
    content.add_subview(l.as_view());
    agent::set_agent_id(l.as_view().raw(), "title");
    agent::set_affordance(l.as_view().raw(), identity::Role::Text);

    var s: agent::Surface = agent::open(win.raw());
    let nodes: vec::Vec[agent::AppKitNode] = s.describe(auth::operator());
    match nodes.at_ptr(2) {
        option::Option[*agent::AppKitNode]::Some(n) => {
            assert { (*n).id.view() } == "title";
            assert identity::role_eq({ (*n).role }, identity::Role::Text);
            assert !{ (*n).actionable };
        }
        option::Option::None => { assert false; }
    }
    assert surface::outcome_eq(s.click(auth::operator(), "title"), surface::Outcome::NotActionable);
    assert surface::outcome_eq(
        s.set_text(auth::operator(), "title", "x", s.text_version("title")),
        surface::Outcome::NotActionable);
}

#[test]
fn declared_button_refuses_set_text() {
    let win = fixture_window(300.0, 200.0);
    let content = content_of(win);
    let b = add_button(content, "go");
    agent::set_agent_id(b.as_view().raw(), "go-btn");
    agent::set_affordance(b.as_view().raw(), identity::Role::Button);

    var s: agent::Surface = agent::open(win.raw());
    assert surface::outcome_eq(
        s.set_text(auth::operator(), "go-btn", "nope", s.text_version("go-btn")),
        surface::Outcome::NotActionable);
    // Click still works.
    assert surface::outcome_eq(s.click(auth::operator(), "go-btn"), surface::Outcome::Allowed);
}

#[test]
fn set_text_persists_on_field_and_text_view() {
    // Regression: set_text always sent `setStringValue:`, which NSTextView
    // silently ignores — the outcome was Allowed but the text never landed
    // (bugs/agent-appkit-set-text-nstextview.md). Both setter paths must
    // actually persist on the widget.
    let win = fixture_window(300.0, 240.0);
    let content = content_of(win);
    let f = ak::TextField::new_with_frame(rt::Rect { x: 10.0, y: 50.0, w: 200.0, h: 24.0 });
    content.add_subview(f.as_view());
    agent::set_agent_id(f.as_view().raw(), "name");
    let tv = ak::TextView::new_with_frame(rt::Rect { x: 10.0, y: 90.0, w: 200.0, h: 80.0 });
    content.add_subview(tv.as_view());
    agent::set_agent_id(tv.as_view().raw(), "desc");

    var s: agent::Surface = agent::open(win.raw());
    assert surface::outcome_eq(
        s.set_text(auth::operator(), "name", "AgentApp", s.text_version("name")),
        surface::Outcome::Allowed);
    assert surface::outcome_eq(
        s.set_text(auth::operator(), "desc", "a multi-line\ndescription", s.text_version("desc")),
        surface::Outcome::Allowed);

    // Read back through the widgets themselves: NSControl via `stringValue`,
    // NSTextView via `string`.
    let ftxt: text::Text = bridge::to_text(rt::msg_id(f.as_view().raw(), rt::sel(#str_ptr("stringValue\0"))));
    assert ftxt.view() == "AgentApp";
    let ttxt: text::Text = bridge::to_text(rt::msg_id(tv.as_view().raw(), rt::sel(#str_ptr("string\0"))));
    assert ttxt.view() == "a multi-line\ndescription";

    // Both writes bumped their versions.
    assert s.text_version("name") > 0;
    assert s.text_version("desc") > 0;
}

#[test]
fn the_caret_can_be_placed_and_is_counted_in_bytes() {
    // No verb placed a caret, so a symbol command could not be AIMED: every
    // editor command that acts at the insertion point rested on an insertion
    // point nothing here could put anywhere.
    let win = fixture_window(300.0, 240.0);
    let content = content_of(win);
    let tv = ak::TextView::new_with_frame(rt::Rect { x: 10.0, y: 90.0, w: 200.0, h: 80.0 });
    content.add_subview(tv.as_view());
    agent::set_agent_id(tv.as_view().raw(), "editor");
    var s: agent::Surface = agent::open(win.raw());
    assert surface::outcome_eq(
        s.set_text(auth::operator(), "editor", "hello world", s.text_version("editor")),
        surface::Outcome::Allowed);

    assert surface::outcome_eq(s.set_caret(auth::operator(), "editor", 6, 5),
                               surface::Outcome::Allowed);
    let r: rt::Range = tv.as_text().selected_range();
    assert { r.location } == 6;
    assert { r.length } == 5;

    // BYTES, not UTF-16 units — the two disagree on exactly the characters a
    // code editor is full of, and a caret placed by the wrong index lands in
    // the wrong column with nothing to say so. "🙂" is 4 bytes, 2 units.
    assert surface::outcome_eq(
        s.set_text(auth::operator(), "editor", "🙂ab", s.text_version("editor")),
        surface::Outcome::Allowed);
    assert surface::outcome_eq(s.set_caret(auth::operator(), "editor", 4, 1),
                               surface::Outcome::Allowed);
    let r2: rt::Range = tv.as_text().selected_range();
    assert { r2.location } == 2;
    assert { r2.length } == 1;
}

#[test]
fn set_caret_refuses_a_control_whose_drive_is_not_text() {
    let win = fixture_window(300.0, 200.0);
    let content = content_of(win);
    let b = add_button(content, "go");
    agent::set_agent_id(b.as_view().raw(), "go-btn");
    var s: agent::Surface = agent::open(win.raw());
    assert surface::outcome_eq(s.set_caret(auth::operator(), "go-btn", 0, 0),
                               surface::Outcome::NotActionable);
    assert surface::outcome_eq(s.set_caret(auth::operator(), "nobody", 0, 0),
                               surface::Outcome::NotFound);
}

#[test]
fn read_runs_reports_what_the_control_is_actually_drawing() {
    // "Did the syntax colour land" needed a temporary probe compiled into the
    // app four separate times, because every read verb answered `text` and none
    // answered how it is drawn.
    let win = fixture_window(300.0, 240.0);
    let content = content_of(win);
    let tv = ak::TextView::new_with_frame(rt::Rect { x: 10.0, y: 90.0, w: 200.0, h: 80.0 });
    content.add_subview(tv.as_view());
    agent::set_agent_id(tv.as_view().raw(), "editor");
    var s: agent::Surface = agent::open(win.raw());
    assert surface::outcome_eq(
        s.set_text(auth::operator(), "editor", "let x", s.text_version("editor")),
        surface::Outcome::Allowed);
    // Colour the first three characters red, the way a lexer would.
    let storage: *u8 = { rt::msg_id(tv.as_view().raw(), rt::sel(#str_ptr("textStorage\0"))) };
    // DEVICE RGB, because that is the space the answer is reported in: a
    // calibrated red converts to #ff2600 on this display, which is the honest
    // answer to "what is it drawing" and a confusing one to assert.
    let red: *u8 = { msg_id_4f64(rt::get_class(#str_ptr("NSColor\0")),
                                 rt::sel(#str_ptr("colorWithDeviceRed:green:blue:alpha:\0")),
                                 1.0, 0.0, 0.0, 1.0) };
    { msg_void_id_id_range(storage, rt::sel(#str_ptr("addAttribute:value:range:\0")),
                           bridge::nsstring("NSColor"), red,
                           rt::Range { location: 0, length: 3 }) };

    let runs: surface::Runs = s.read_runs(auth::operator(), "editor");
    assert surface::outcome_eq(runs.outcome, surface::Outcome::Allowed);
    assert runs.supported;
    assert runs.runs.count() >= 2;
    match runs.runs.at_ptr(0) {
        option::Option[*surface::TextRun]::Some(r) => {
            assert { (*r).start } == 0;
            assert { (*r).length } == 3;
            assert { (*r).color.view() } == "#ff0000";
        }
        option::Option::None => { assert false; }
    }
}

#[link_name = "objc_msgSend"]
extern fn msg_id_4f64(recv: *u8, sel: *u8, a: f64, b: f64, c: f64, d: f64) -> *u8;
#[link_name = "objc_msgSend"]
extern fn msg_void_id_id_range(recv: *u8, sel: *u8, a: *u8, b: *u8, r: rt::Range);

#[test]
fn read_runs_says_unsupported_rather_than_empty_for_a_control_with_no_text() {
    let win = fixture_window(300.0, 200.0);
    let content = content_of(win);
    let b = add_button(content, "go");
    agent::set_agent_id(b.as_view().raw(), "go-btn");
    var s: agent::Surface = agent::open(win.raw());
    let runs: surface::Runs = s.read_runs(auth::operator(), "go-btn");
    // An NSButton has no attributed store to walk. `supported: false` is a
    // different answer from "no runs", which is the distinction the `clickable`
    // field was added to make.
    assert runs.runs.count() == 0;
    assert runs.supported == false;
    let missing: surface::Runs = s.read_runs(auth::operator(), "nobody");
    assert surface::outcome_eq(missing.outcome, surface::Outcome::NotFound);
}

static MENU_FIRED: i32 = 0;

fn on_menu_command(sender: *u8) {
    MENU_FIRED = MENU_FIRED + 1;
}

#[test]
fn a_menu_item_can_be_invoked_by_the_name_a_person_reads() {
    // No verb invoked a MENU ITEM, so every key equivalent — ⌘F, ⌘G and five
    // Go/Edit commands — rested on the menu click reaching `events::emit`, the
    // one link nothing here could drive.
    MENU_FIRED = 0;
    let app: ak::Application = ak::Application::shared_application();
    let root: ak::Menu = ak::Menu::new("MainMenu");
    let file_item: ak::MenuItem = ak::MenuItem::new("File", 0 as *u8, "");
    let file_menu: ak::Menu = ak::Menu::new("File");
    let save: ak::MenuItem = ak::MenuItem::new("Save", 0 as *u8, "s");
    save.set_on_action(on_menu_command);
    file_menu.add_item(save);
    let greyed: ak::MenuItem = ak::MenuItem::new("Greyed", 0 as *u8, "");
    greyed.set_enabled(false);
    file_menu.add_item(greyed);
    // An autoenabling menu decides for itself, which would re-enable the item
    // this test is about; the app states the answer instead.
    file_menu.set_autoenables_items(false);
    root.add_item(file_item);
    root.set_submenu(file_menu, file_item);
    app.set_main_menu(root);

    assert surface::outcome_eq(agent::mcp_invoke_menu(0 as *u8, auth::operator(), "File/Save"),
                               surface::Outcome::Allowed);
    assert MENU_FIRED == 1;
    // A disabled item is NOT actionable, and an unknown one is not found —
    // the same two words a node gets.
    assert surface::outcome_eq(agent::mcp_invoke_menu(0 as *u8, auth::operator(), "File/Greyed"),
                               surface::Outcome::NotActionable);
    assert surface::outcome_eq(agent::mcp_invoke_menu(0 as *u8, auth::operator(), "File/Nope"),
                               surface::Outcome::NotFound);
    assert surface::outcome_eq(agent::mcp_invoke_menu(0 as *u8, auth::operator(), "Nope/Save"),
                               surface::Outcome::NotFound);
    // A path with no menu in it is not a path.
    assert surface::outcome_eq(agent::mcp_invoke_menu(0 as *u8, auth::operator(), "Save"),
                               surface::Outcome::NotFound);
    assert MENU_FIRED == 1;
}

// ---- and the same verb from the thread it is actually driven on -------------
//
// THIS IS THE VERB'S REAL CALLER. `invoke_menu` exists to be driven by something
// that is not a person, so it arrives on the socket worker's thread and never on
// AppKit's — and it used to abort() there. The enabled check ran
// `[menu update]` on the caller's thread, which AppKit answers with an uncaught
// NSInternalInconsistencyException ("modification of a menu's items on a
// non-main thread when the menu is part of the main menu") while the
// `performActionForItemAtIndex:` one line below it hopped correctly. So the verb
// knew it was off-main, and hopped for the ACTION but not for the QUESTION it
// asks first.
//
// It only fired when the menu was FOUND — a bad path answers NotFound before
// reaching `update` — so the test above passes either way and this one is the
// only thing that can fail.
//
// THE MAIN THREAD HAS TO PUMP. `performSelectorOnMainThread:waitUntilDone:YES`
// enqueues onto the main run loop and blocks the worker until it runs; main is
// sitting in `join()` with no run loop of its own, so without the pump the two
// deadlock and this hangs instead of failing. The spin bound is what turns a
// regression back into a failure rather than a hang.

static OFFMAIN_RESULT: i32 = -1;
static OFFMAIN_DONE: i32 = 0;
static OFFMAIN_WAS_MAIN: i32 = -1;

fn invoke_menu_worker() -> i32 {
    // ASSERTED, not assumed. If this worker ran on the main thread the verb
    // would take its direct branch, the hop would never be exercised, and this
    // test would pass while proving nothing.
    if rt::msg_i8(rt::get_class(#str_ptr("NSThread\0")),
                  rt::sel(#str_ptr("isMainThread\0"))) != 0 {
        OFFMAIN_WAS_MAIN = 1;
    } else {
        OFFMAIN_WAS_MAIN = 0;
    }
    let oc: surface::Outcome = agent::mcp_invoke_menu(0 as *u8, auth::operator(), "File/Save");
    if surface::outcome_eq(oc, surface::Outcome::Allowed) {
        OFFMAIN_RESULT = 1;
    } else {
        OFFMAIN_RESULT = 0;
    }
    OFFMAIN_DONE = 1;
    return 0;
}

// One bounded turn of the main run loop. NSDefaultRunLoopMode IS the string
// "kCFRunLoopDefaultMode", which is how a package with no extern globals names
// it.
fn pump_main_runloop_once() {
    let rl: *u8 = rt::msg_id(rt::get_class(#str_ptr("NSRunLoop\0")),
                             rt::sel(#str_ptr("mainRunLoop\0")));
    if rl.is_null() { return; }
    let until: *u8 = rt::msg_id_f64(rt::get_class(#str_ptr("NSDate\0")),
                                    rt::sel(#str_ptr("dateWithTimeIntervalSinceNow:\0")),
                                    0.01);
    let _ran: i8 = rt::msg_i8_id_id(rl, rt::sel(#str_ptr("runMode:beforeDate:\0")),
                                    bridge::nsstring("kCFRunLoopDefaultMode"), until);
}

#[test]
fn a_menu_invoked_off_the_main_thread_does_not_abort() {
    MENU_FIRED = 0;
    OFFMAIN_RESULT = -1;
    OFFMAIN_DONE = 0;
    OFFMAIN_WAS_MAIN = -1;
    let app: ak::Application = ak::Application::shared_application();
    let root: ak::Menu = ak::Menu::new("MainMenu");
    let file_item: ak::MenuItem = ak::MenuItem::new("File", 0 as *u8, "");
    let file_menu: ak::Menu = ak::Menu::new("File");
    let save: ak::MenuItem = ak::MenuItem::new("Save", 0 as *u8, "s");
    save.set_on_action(on_menu_command);
    file_menu.add_item(save);
    file_menu.set_autoenables_items(false);
    root.add_item(file_item);
    root.set_submenu(file_menu, file_item);
    app.set_main_menu(root);

    // A NAMED fn-typed binding: a bare fn name is not a value here (E0312).
    let worker: fn() -> i32 = invoke_menu_worker;
    var h: thread::JoinHandle[i32] = thread::spawn(worker);
    var spins: i32 = 0;
    while OFFMAIN_DONE == 0 && spins < 600 {
        pump_main_runloop_once();
        spins = spins + 1;
    }
    let _rc: i32 = h.join();

    // Reached the end at all: before the fix this line was never executed,
    // because the process had aborted inside `[menu update]`.
    assert OFFMAIN_DONE == 1;
    // The hop was really exercised.
    assert OFFMAIN_WAS_MAIN == 0;
    assert OFFMAIN_RESULT == 1;
    // And the action really ran — on the main thread, once.
    assert MENU_FIRED == 1;
}

#[test]
fn describe_survives_a_replaced_tree() {
    // A full describe on a surface whose views were ALL removed must not
    // crash (views are retained; reads land on live, detached objects).
    let win = fixture_window(300.0, 200.0);
    let content = content_of(win);
    let b = add_button(content, "go");
    agent::set_agent_id(b.as_view().raw(), "go-btn");

    var s: agent::Surface = agent::open(win.raw());
    b.as_view().remove_from_superview();
    let nodes: vec::Vec[agent::AppKitNode] = s.describe(auth::operator());
    assert nodes.count() == 3;
}

// ---- hit_test: the pointer question the action verbs cannot ask -------------

// An overlay covering `under`, added AFTER it so it is topmost (hitTest: walks
// subviews in reverse). Plain NSView: hit-testing is frame + hidden, not paint.
fn add_overlay(content: ak::View, over: rt::Rect) -> ak::View {
    let v = ak::View::new(over);
    content.add_subview(v);
    return v;
}

#[test]
fn hit_test_reports_a_reachable_control() {
    let win = fixture_window(300.0, 200.0);
    let content = content_of(win);
    let b = add_button(content, "go");
    agent::set_agent_id(b.as_view().raw(), "go-btn");

    var s: agent::Surface = agent::open(win.raw());
    let h: surface::HitTest = s.hit_test(auth::operator(), "go-btn");
    assert surface::outcome_eq(h.outcome, surface::Outcome::Allowed);
    assert h.supported;
    assert h.reachable;
    assert h.covered == false;
    assert h.covered_by.view() == "";
}

// THE CASE THIS VERB EXISTS FOR. `click` cannot tell these apart: it sends
// `performClick:` straight to the view, so it reports Allowed on a control no
// person could reach. The assertion on `click` below is the point — it is not
// a bug, it is the blindness, and hit_test is what sees past it.
#[test]
fn hit_test_names_the_exposed_overlay_that_buries_a_control() {
    let win = fixture_window(300.0, 200.0);
    let content = content_of(win);
    let b = add_button(content, "go");
    agent::set_agent_id(b.as_view().raw(), "go-btn");
    // Covers the button's frame (10,10,80,24) completely.
    let ov = add_overlay(content, rt::Rect { x: 0.0, y: 0.0, w: 200.0, h: 100.0 });
    agent::set_agent_id(ov.raw(), "overlay");

    var s: agent::Surface = agent::open(win.raw());
    let h: surface::HitTest = s.hit_test(auth::operator(), "go-btn");
    assert surface::outcome_eq(h.outcome, surface::Outcome::Allowed);
    assert h.reachable == false;
    assert h.covered;
    assert h.covered_by.view() == "overlay";

    // ...while the action verb still says yes, which is exactly the gap.
    assert surface::outcome_eq(s.click(auth::operator(), "go-btn"), surface::Outcome::Allowed);
    // And the overlay itself is reachable — it is the thing on top.
    let ho: surface::HitTest = s.hit_test(auth::operator(), "overlay");
    assert ho.reachable;
    assert ho.covered == false;
}

// The obstruction is reported, its identity is not, when it is UI the app never
// exposed. Naming it would let an agent enumerate unexposed nodes by putting
// something under them, which is a hole in the consent model rather than a
// feature — `covered` still carries the fact.
#[test]
fn hit_test_reports_an_unexposed_obstruction_without_naming_it() {
    let win = fixture_window(300.0, 200.0);
    let content = content_of(win);
    let b = add_button(content, "go");
    agent::set_agent_id(b.as_view().raw(), "go-btn");
    let _ov = add_overlay(content, rt::Rect { x: 0.0, y: 0.0, w: 200.0, h: 100.0 });   // untagged

    var s: agent::Surface = agent::open(win.raw());
    let h: surface::HitTest = s.hit_test(auth::operator(), "go-btn");
    assert h.reachable == false;
    assert h.covered;
    assert h.covered_by.view() == "";
}

// A hit on a node's own CHILD still means the node is reachable — the pointer
// got there. Without this a container would always report itself covered by
// its own content, which is the opposite of the answer wanted.
#[test]
fn hit_test_counts_a_hit_on_a_childs_view_as_reaching_the_parent() {
    let win = fixture_window(300.0, 200.0);
    let content = content_of(win);
    let group = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 200.0, h: 100.0 });
    content.add_subview(group);
    agent::set_agent_id(group.raw(), "group");
    let inner = ak::Button::new_with_frame(rt::Rect { x: 0.0, y: 0.0, w: 200.0, h: 100.0 });
    group.add_subview(inner.as_view());
    agent::set_agent_id(inner.as_view().raw(), "inner-btn");

    var s: agent::Surface = agent::open(win.raw());
    let h: surface::HitTest = s.hit_test(auth::operator(), "group");
    assert h.reachable;
    assert h.covered == false;
}

#[test]
fn hit_test_negatives_report_rather_than_guess() {
    let win = fixture_window(300.0, 200.0);
    let content = content_of(win);
    let b = add_button(content, "go");
    agent::set_agent_id(b.as_view().raw(), "go-btn");
    var s: agent::Surface = agent::open(win.raw());

    // Unknown id: no reachability claim at all.
    let miss: surface::HitTest = s.hit_test(auth::operator(), "nope");
    assert surface::outcome_eq(miss.outcome, surface::Outcome::NotFound);
    assert miss.reachable == false;
    assert miss.covered == false;

    // A view that left the live UI is Stale, not "unreachable" — the
    // difference matters: one says re-open the surface, the other says
    // something is on top.
    b.as_view().remove_from_superview();
    let gone: surface::HitTest = s.hit_test(auth::operator(), "go-btn");
    assert surface::outcome_eq(gone.outcome, surface::Outcome::Stale);
    assert gone.reachable == false;
    assert gone.covered == false;
}
// ---- the real mouseDown: path ----------------------------------------------

#[link_name = "objc_autoreleasePoolPush"]
extern fn pool_push() -> *u8;
#[link_name = "objc_autoreleasePoolPop"]
extern fn pool_pop(p: *u8);

// The regression test for bugs/dragging-item-double-release.md, driving the
// path that actually crashed rather than modelling it.
//
// `drag_mousedown_imp` over-released its NSDraggingItem, so the drag session's
// autoreleased array was left holding freed memory. The fault did not land at
// the click — it landed at the next autorelease-pool DRAIN, which is why the
// stack named nothing of ours and why 105 scripted agent cycles never saw it
// (the ACI's `click` sends `performClick:` and never enters `mouseDown:`).
//
// So: a real NSEvent, a real `mouseDown:` on a real FacetDragView in a real
// window, then drain the pool inside the test. With the bug present this
// process dies here; the assertion below is simply that it did not.
#[test]
fn a_real_mouse_down_on_a_draggable_survives_the_pool_drain() {
    let win = fixture_window(400.0, 300.0);
    let content = content_of(win);
    let card = akx::new_drag_view("card-payload");
    card.set_frame(rt::Rect { x: 20.0, y: 20.0, w: 120.0, h: 60.0 });
    content.add_subview(card);

    let wnum: i64 = rt::msg_i64(win.raw(), rt::sel(#str_ptr("windowNumber\0")));
    let at: rt::Point = rt::Point { x: 80.0, y: 50.0 };
    let nilctx: ak::GraphicsContext = ak::GraphicsContext::from_raw(0 as *u8);
    let pool: *u8 = { pool_push() };
    match ak::Event::mouse_event_with_type(
        ak::EventType::LeftMouseDown,
        at,
        0, 0.0, wnum,
        nilctx,
        0, 1, 1.0,
    ) {
        option::Option[ak::Event]::Some(ev) => {
            // THE CLICK. One mouseDown: was the whole trigger — no drag, no
            // drop, no movement.
            rt::msg_void_id(card.raw(), rt::sel(#str_ptr("mouseDown:\0")), ev.raw());
        }
        option::Option::None => { assert false; }
    }
    // THE CRASH SITE. Releases the drag session's array, which releases its
    // elements — one of which used to be freed memory.
    { pool_pop(pool); }

    assert true;   // reached here: no over-release, no zombie, no SIGSEGV
}

// ---- gap 1: the drag's visual layer, and coexisting with a click -----------

static ENTERS: i32 = 0;
static EXITS: i32 = 0;
// One handler for both edges; which edge it is comes from the SENDER. A handler
// that had to be told would be a handler that can be told wrong.
fn on_target_probe(sender: *u8, ctx: *u8) {
    if akx::drag_targeted(sender) { ENTERS = ENTERS + 1; } else { EXITS = EXITS + 1; }
}
fn on_drop_probe(sender: *u8, ctx: *u8) { return; }

fn mouse_at(win: ak::Window, ty: ak::EventType, x: f64, y: f64) -> ak::Event {
    let at: rt::Point = rt::Point { x: x, y: y };
    let nilctx: ak::GraphicsContext = ak::GraphicsContext::from_raw(0 as *u8);
    let wnum: i64 = rt::msg_i64(win.raw(), rt::sel(#str_ptr("windowNumber\0")));
    return match ak::Event::mouse_event_with_type(ty, at, 0, 0.0, wnum, nilctx, 0, 1, 1.0) {
        option::Option[ak::Event]::Some(e) => e,
        option::Option::None => { ak::Event::from_raw(0 as *u8) }
    };
}

// (c) A lane must be able to highlight while a card is over it. Ordinary hover
// cannot do this — AppKit suppresses mouse-tracking for the duration of a drag
// — so the destination's own callbacks are the only source. And a DROP counts
// as an exit: nothing else fires afterwards, so a highlight lit on enter and
// never cleared stays lit forever.
#[test]
fn a_drop_target_reports_drag_enter_and_exit_including_on_drop() {
    let win = fixture_window(400.0, 300.0);
    let content = content_of(win);
    let lane = akx::new_drop_view(on_drop_probe, null_ctx());
    lane.set_frame(rt::Rect { x: 0.0, y: 0.0, w: 200.0, h: 200.0 });
    content.add_subview(lane);
    akx::set_drag_over(lane.raw(), on_target_probe, null_ctx());

    ENTERS = 0;
    EXITS = 0;
    let entered_sel: *u8 = rt::sel(#str_ptr("draggingEntered:\0"));
    let exited_sel: *u8 = rt::sel(#str_ptr("draggingExited:\0"));
    assert rt::msg_i8_id(lane.raw(), rt::sel(#str_ptr("respondsToSelector:\0")), exited_sel) != 0;

    assert akx::drag_targeted(lane.raw()) == false;

    // Enter sets the state BEFORE calling, so the handler already reads true —
    // and still advertises Copy (=1) to the dragger.
    assert rt::msg_u64_id(lane.raw(), entered_sel, 0 as *u8) == 1;
    assert ENTERS == 1;
    assert EXITS == 0;
    assert akx::drag_targeted(lane.raw());

    // IDEMPOTENT: re-entering an already-targeted view fires nothing, so a
    // handler cannot be made to count edges that did not happen.
    assert rt::msg_u64_id(lane.raw(), entered_sel, 0 as *u8) == 1;
    assert ENTERS == 1;

    // Leaving without dropping.
    rt::msg_void_id(lane.raw(), exited_sel, 0 as *u8);
    assert EXITS == 1;
    assert akx::drag_targeted(lane.raw()) == false;
    // ...and leaving twice is also idempotent.
    rt::msg_void_id(lane.raw(), exited_sel, 0 as *u8);
    assert EXITS == 1;

    // Dropping ALSO clears it — the case a highlight would otherwise survive
    // forever, and the reason the framework owns this edge rather than the app.
    assert rt::msg_u64_id(lane.raw(), entered_sel, 0 as *u8) == 1;
    assert ENTERS == 2;
    let _ok: i8 = rt::msg_i8_id(lane.raw(), rt::sel(#str_ptr("performDragOperation:\0")), 0 as *u8);
    assert EXITS == 2;
    assert akx::drag_targeted(lane.raw()) == false;
}

// (d) A destination must implement draggingUpdated:, which is where it walks
// the enclosing scroll view as the pointer nears an edge. Without it a column
// that is off-screen cannot be reached at all, and wheel-scrolling mid-drag is
// not a gesture anyone makes with a card in hand.
#[test]
fn a_drop_target_answers_dragging_updated_for_autoscroll() {
    let win = fixture_window(400.0, 300.0);
    let content = content_of(win);
    let lane = akx::new_drop_view(on_drop_probe, null_ctx());
    lane.set_frame(rt::Rect { x: 0.0, y: 0.0, w: 200.0, h: 200.0 });
    content.add_subview(lane);

    let updated: *u8 = rt::sel(#str_ptr("draggingUpdated:\0"));
    assert rt::msg_i8_id(lane.raw(), rt::sel(#str_ptr("respondsToSelector:\0")), updated) != 0;
    // Still advertises Copy, and survives a nil sender (no window, no drag).
    assert rt::msg_u64_id(lane.raw(), updated, 0 as *u8) == 1;
}

// (b) THE ONE THAT MATTERS. A press that never travels is a CLICK: no drag
// session starts, and the event is handed to the next responder so whatever
// would have had it still gets it. This is what lets the drag source be the
// card itself rather than a separate grip rail — and with the card as the
// source, its own snapshot becomes the drag preview, so (a) needs no API.
#[test]
fn a_press_without_movement_is_a_click_not_a_drag() {
    let win = fixture_window(400.0, 300.0);
    let content = content_of(win);
    let card = akx::new_drag_view("card-1");
    card.set_frame(rt::Rect { x: 20.0, y: 20.0, w: 200.0, h: 100.0 });
    content.add_subview(card);

    let responds: *u8 = rt::sel(#str_ptr("respondsToSelector:\0"));
    assert rt::msg_i8_id(card.raw(), responds, rt::sel(#str_ptr("mouseDragged:\0"))) != 0;
    assert rt::msg_i8_id(card.raw(), responds, rt::sel(#str_ptr("mouseUp:\0"))) != 0;

    let pool: *u8 = { pool_push() };
    // Press: ARMED, and no session — the old behaviour began one right here.
    rt::msg_void_id(card.raw(), rt::sel(#str_ptr("mouseDown:\0")), mouse_at(win, ak::EventType::LeftMouseDown, 100.0, 60.0).raw());
    assert akx::drag_is_armed(card.raw());
    // Release without travel: disarmed, and the event went to the next
    // responder rather than being swallowed.
    rt::msg_void_id(card.raw(), rt::sel(#str_ptr("mouseUp:\0")), mouse_at(win, ak::EventType::LeftMouseUp, 100.0, 60.0).raw());
    assert akx::drag_is_armed(card.raw()) == false;
    { pool_pop(pool); }
}

// A press that moves less than the threshold is still a click — the tremor a
// deliberate click carries must not turn into a drag.
#[test]
fn a_press_within_the_threshold_is_still_a_click() {
    let win = fixture_window(400.0, 300.0);
    let content = content_of(win);
    let card = akx::new_drag_view("card-2");
    card.set_frame(rt::Rect { x: 20.0, y: 20.0, w: 200.0, h: 100.0 });
    content.add_subview(card);

    let pool: *u8 = { pool_push() };
    rt::msg_void_id(card.raw(), rt::sel(#str_ptr("mouseDown:\0")), mouse_at(win, ak::EventType::LeftMouseDown, 100.0, 60.0).raw());
    // ~1.4pt of travel, under the 3pt threshold: still a click in progress.
    rt::msg_void_id(card.raw(), rt::sel(#str_ptr("mouseDragged:\0")), mouse_at(win, ak::EventType::LeftMouseDragged, 101.0, 61.0).raw());
    assert akx::drag_is_armed(card.raw());
    rt::msg_void_id(card.raw(), rt::sel(#str_ptr("mouseUp:\0")), mouse_at(win, ak::EventType::LeftMouseUp, 101.0, 61.0).raw());
    assert akx::drag_is_armed(card.raw()) == false;
    { pool_pop(pool); }
}

// ...and past it, the press BECOMES a drag: the session starts and the press
// state is consumed, so one press can only ever produce one session.
#[test]
fn a_press_past_the_threshold_becomes_a_drag() {
    let win = fixture_window(400.0, 300.0);
    let content = content_of(win);
    let card = akx::new_drag_view("card-3");
    card.set_frame(rt::Rect { x: 20.0, y: 20.0, w: 200.0, h: 100.0 });
    content.add_subview(card);

    let pool: *u8 = { pool_push() };
    rt::msg_void_id(card.raw(), rt::sel(#str_ptr("mouseDown:\0")), mouse_at(win, ak::EventType::LeftMouseDown, 100.0, 60.0).raw());
    assert akx::drag_is_armed(card.raw());
    // 40pt of travel — unambiguously a drag.
    rt::msg_void_id(card.raw(), rt::sel(#str_ptr("mouseDragged:\0")), mouse_at(win, ak::EventType::LeftMouseDragged, 140.0, 60.0).raw());
    assert akx::drag_is_armed(card.raw()) == false;   // consumed by the session
    // A second drag in the same press starts nothing more.
    rt::msg_void_id(card.raw(), rt::sel(#str_ptr("mouseDragged:\0")), mouse_at(win, ak::EventType::LeftMouseDragged, 180.0, 60.0).raw());
    rt::msg_void_id(card.raw(), rt::sel(#str_ptr("mouseUp:\0")), mouse_at(win, ak::EventType::LeftMouseUp, 180.0, 60.0).raw());
    { pool_pop(pool); }
}

// A view with no payload is not a drag source at all, and must not accumulate
// press state — the guard that keeps a plain container from leaking a boxed
// point on every click.
#[test]
fn a_view_without_a_payload_never_arms_the_threshold() {
    let win = fixture_window(400.0, 300.0);
    let content = content_of(win);
    let plain: *u8 = { rt::msg_id(rt::msg_id(akx::drag_view_class(), rt::sel(#str_ptr("alloc\0"))), rt::sel(#str_ptr("init\0"))) };
    ak::View::from_raw(plain).set_frame(rt::Rect { x: 0.0, y: 0.0, w: 50.0, h: 50.0 });
    content.add_subview(ak::View::from_raw(plain));

    let pool: *u8 = { pool_push() };
    rt::msg_void_id(plain, rt::sel(#str_ptr("mouseDown:\0")), mouse_at(win, ak::EventType::LeftMouseDown, 10.0, 10.0).raw());
    rt::msg_void_id(plain, rt::sel(#str_ptr("mouseDragged:\0")), mouse_at(win, ak::EventType::LeftMouseDragged, 90.0, 90.0).raw());
    assert akx::drag_is_armed(plain) == false;   // never armed
    rt::msg_void_id(plain, rt::sel(#str_ptr("mouseUp:\0")), mouse_at(win, ak::EventType::LeftMouseUp, 90.0, 90.0).raw());
    { pool_pop(pool); }
}

// ---- drag auto-scroll: an edge BAND, not "outside the view" ----------------

fn near(a: f64, b: f64) -> bool {
    let d: f64 = if a > b { a - b } else { b - a };
    return d < 0.001;
}

// `autoscroll:` only fires when the pointer leaves the view's bounds, so it
// worked on a lane (small clip) and never on the board strip (clip the size of
// the window — a pointer anywhere inside it is "not outside"). The band is the
// fix, and this is its arithmetic: a viewport spanning 0..500 with a 40pt band.
// bugs/drag-autoscroll-only-on-an-overflowing-clip-view.md
#[test]
fn autoscroll_band_is_proportional_and_only_near_the_edges() {
    // Dead centre: nothing. This is the case that must NOT jitter.
    assert near(akx::autoscroll_delta(250.0, 0.0, 500.0), 0.0);
    // Just inside the band, either side: nothing.
    assert near(akx::autoscroll_delta(41.0, 0.0, 500.0), 0.0);
    assert near(akx::autoscroll_delta(459.0, 0.0, 500.0), 0.0);

    // At the leading edge: full step, negative (scroll back toward the start).
    assert near(akx::autoscroll_delta(0.0, 0.0, 500.0), 0.0 - 16.0);
    // At the trailing edge: full step, positive.
    assert near(akx::autoscroll_delta(500.0, 0.0, 500.0), 16.0);

    // Halfway into the band: half the step, so the nudge grows with depth
    // rather than jumping.
    assert near(akx::autoscroll_delta(20.0, 0.0, 500.0), 0.0 - 8.0);
    assert near(akx::autoscroll_delta(480.0, 0.0, 500.0), 8.0);

    // BEYOND the edge — which is all `autoscroll:` could ever detect — clamps to
    // the full step rather than running away. This is how the band subsumes the
    // old behaviour instead of replacing it.
    assert near(akx::autoscroll_delta(-200.0, 0.0, 500.0), 0.0 - 16.0);
    assert near(akx::autoscroll_delta(900.0, 0.0, 500.0), 16.0);

    // A scrolled viewport: the band follows the visible range, not the document.
    assert near(akx::autoscroll_delta(1000.0, 1000.0, 1500.0), 0.0 - 16.0);
    assert near(akx::autoscroll_delta(1250.0, 1000.0, 1500.0), 0.0);
}

// A clip view whose document FITS has no range on that axis and must not move —
// the jitter the report called out. Both axes, and through the real callback.
#[test]
fn autoscroll_leaves_a_clip_view_with_nothing_to_scroll_alone() {
    let win = fixture_window(400.0, 300.0);
    let content = content_of(win);
    let sv = ak::ScrollView::new(rt::Rect { x: 0.0, y: 0.0, w: 200.0, h: 200.0 });
    content.add_subview(sv.as_view());
    // Document SMALLER than the viewport: no range in either direction.
    let doc = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 100.0, h: 100.0 });
    sv.set_document_view(doc);

    let clip: *u8 = { rt::msg_id(sv.raw(), rt::sel(#str_ptr("contentView\0"))) };
    assert clip.is_not_null();
    let before: rt::Rect = rt::msg_rect(clip, rt::sel(#str_ptr("bounds\0")));
    // A pointer hard against the corner — deep in both bands.
    akx::autoscroll_clip(clip, rt::Point { x: 0.0, y: 0.0 });
    let after: rt::Rect = rt::msg_rect(clip, rt::sel(#str_ptr("bounds\0")));
    assert near(after.x, before.x);
    assert near(after.y, before.y);
}

// ...and one that DOES overflow moves, on the axis with range. This is the half
// that never worked: the strip is the size of the window, so nothing was ever
// "outside" it.
#[test]
fn autoscroll_moves_a_clip_view_that_has_range() {
    let win = fixture_window(400.0, 300.0);
    let content = content_of(win);
    let sv = ak::ScrollView::new(rt::Rect { x: 0.0, y: 0.0, w: 200.0, h: 200.0 });
    content.add_subview(sv.as_view());
    // Wide document: horizontal range, no vertical range.
    let doc = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 2000.0, h: 100.0 });
    sv.set_document_view(doc);

    let clip: *u8 = { rt::msg_id(sv.raw(), rt::sel(#str_ptr("contentView\0"))) };
    let before: rt::Rect = rt::msg_rect(clip, rt::sel(#str_ptr("bounds\0")));
    // Pointer at the RIGHT edge of the clip, in window coords (the clip sits at
    // the content view's origin, so window x ~ clip x here).
    akx::autoscroll_clip(clip, rt::Point { x: 199.0, y: 100.0 });
    let after: rt::Rect = rt::msg_rect(clip, rt::sel(#str_ptr("bounds\0")));
    assert after.x > before.x;          // walked toward the far end
    assert near(after.y, before.y);     // the axis with no range stayed put
}

// ---- set_text must tell the app, for controls that are told ----------------

static SLIDER_CHANGES: i32 = 0;
static FIELD_ACTIONS: i32 = 0;
fn on_slider_changed(sender: *u8, ctx: *u8) { SLIDER_CHANGES = SLIDER_CHANGES + 1; return; }
fn on_field_action(sender: *u8, ctx: *u8) { FIELD_ACTIONS = FIELD_ACTIONS + 1; return; }

// A slider has no read-on-demand moment — the app learns its value from
// `on_change` — so writing it without firing that leaves the UI and the model
// disagreeing with nothing to say which is right. Measured on iris: an agent
// `set_text` moved the knob while the percent field mirroring it kept the old
// number.
// bugs/agent-set-text-does-not-notify-the-app.md
#[test]
fn set_text_on_a_value_control_fires_the_apps_change_handler() {
    let win = fixture_window(320.0, 200.0);
    let content = content_of(win);
    let sl = ak::Slider::new();
    sl.set_min_value(0.0);
    sl.set_max_value(1.0);
    sl.as_control().set_double_value(0.55);
    sl.as_view().set_frame(rt::Rect { x: 10.0, y: 10.0, w: 200.0, h: 24.0 });
    content.add_subview(sl.as_view());
    akx::set_control_action_ctx(sl.as_control(), on_slider_changed, null_ctx());
    agent::set_agent_id(sl.as_view().raw(), "progress");
    agent::set_affordance_drive(sl.as_view().raw(), identity::Role::Input, identity::drive_text());

    SLIDER_CHANGES = 0;
    var s: agent::Surface = agent::open(win.raw());
    assert surface::outcome_eq(
        s.set_text(auth::operator(), "progress", "0.7", s.text_version("progress")),
        surface::Outcome::Allowed);

    // The control moved...
    let got: f64 = sl.as_control().double_value();
    assert got > 0.65;
    assert got < 0.75;
    // ...AND the app was told, which is the whole bug.
    assert SLIDER_CHANGES == 1;
}

// A text field must NOT be notified: its action is the ENTER key, so firing it
// from a write would turn "type into this field" into "submit this form" — a
// worse surprise than the one being fixed. A field is read on demand.
#[test]
fn set_text_on_a_field_does_not_fire_its_enter_action() {
    let win = fixture_window(320.0, 200.0);
    let content = content_of(win);
    let f = ak::TextField::new_with_frame(rt::Rect { x: 10.0, y: 50.0, w: 200.0, h: 24.0 });
    content.add_subview(f.as_view());
    akx::set_control_action_ctx(f.as_control(), on_field_action, null_ctx());
    agent::set_agent_id(f.as_view().raw(), "name");

    FIELD_ACTIONS = 0;
    var s: agent::Surface = agent::open(win.raw());
    assert surface::outcome_eq(
        s.set_text(auth::operator(), "name", "typed", s.text_version("name")),
        surface::Outcome::Allowed);

    let txt: text::Text = bridge::to_text(rt::msg_id(f.as_view().raw(), rt::sel(#str_ptr("stringValue\0"))));
    assert txt.view() == "typed";      // the write landed
    assert FIELD_ACTIONS == 0; // and submitted nothing
}

// ---- a search field is THREE controls, not one -------------------------------

static SEARCH_FIRED: i64 = 0;
fn on_search_action(sender: *u8) { SEARCH_FIRED = SEARCH_FIRED + 1; return; }

#[test]
fn a_search_field_exposes_its_text_its_search_and_its_clear() {
    // NSSearchField is three affordances in one control: type into it, click the
    // magnifier to run the search, click the cancel glyph to clear it. Two of the
    // three are NSButtonCells on the field's NSSearchFieldCell, and `walk`
    // descends `subviews` — which a cell is not. The agent could type a query
    // and then had no way to run it or take it back.
    SEARCH_FIRED = 0;
    let win = fixture_window(300.0, 200.0);
    let content = content_of(win);
    let sf: *u8 = rt::alloc_init(#str_ptr("NSSearchField\0"));
    rt::msg_void_rect(sf, rt::sel(#str_ptr("setFrame:\0")),
                      rt::Rect { x: 0.0, y: 0.0, w: 200.0, h: 24.0 });
    content.add_subview(ak::View::from_raw(sf));
    agent::set_agent_id(sf, "search");
    ak::Control::from_raw(sf).set_on_action(on_search_action);

    var s: agent::Surface = agent::open(win.raw());
    let nodes: vec::Vec[agent::AppKitNode] = s.describe(auth::operator());
    // window + content group + the field + its two parts. It was 3.
    assert nodes.count() == 5;

    // 1 — type into it.
    assert surface::outcome_eq(s.set_text(auth::operator(), "search", "needle", s.text_version("search")),
                               surface::Outcome::Allowed);
    let typed: text::Text = bridge::to_text(rt::msg_id(sf, rt::sel(#str_ptr("stringValue\0"))));
    assert typed.view() == "needle";

    // 2 — run the search. The magnifier fires the field's own action, which is
    // what Return reaches, so `on_submit` runs exactly as it does for a person.
    assert surface::outcome_eq(s.click(auth::operator(), "search:search"), surface::Outcome::Allowed);
    assert SEARCH_FIRED == 1;

    // 3 — clear it. The text goes, and the now-empty search runs, which is what
    // makes the glyph a clear rather than a select-all-and-delete.
    assert surface::outcome_eq(s.click(auth::operator(), "search:clear"), surface::Outcome::Allowed);
    let after: text::Text = bridge::to_text(rt::msg_id(sf, rt::sel(#str_ptr("stringValue\0"))));
    assert after.is_empty();
    assert SEARCH_FIRED == 2;

    // An id that names no part is still NotFound — the suffixes are addresses,
    // not a pattern the surface will invent an answer for.
    assert surface::outcome_eq(s.click(auth::operator(), "search:zoom"), surface::Outcome::NotFound);
}

#[test]
fn describe_reports_delivery_beside_permission_and_capability() {
    // THE THIRD QUESTION. `actionable` is permission, `clickable` is capability,
    // and a control can pass both and still be dead: an NSControl is driven by
    // its target/action and ONLY by that — it consumes its own mouse event, so
    // a gesture recognizer attached to one never fires. iris shipped a button
    // written that way and nobody noticed for weeks, because every signal on
    // this wire read identically to a working one.
    //
    // Two buttons, same class, same frame, same everything a describe can see.
    // The only difference is whether anything is on the other end.
    CLICKS = 0;
    let win = fixture_window(300.0, 200.0);
    let content = content_of(win);

    let live = add_button(content, "Live");
    agent::set_agent_id(live.as_view().raw(), "live");
    let dead = add_dead_button(content, "Dead");
    agent::set_agent_id(dead.as_view().raw(), "dead");

    var s: agent::Surface = agent::open(win.raw());
    let nodes: vec::Vec[agent::AppKitNode] = s.describe(auth::operator());

    var saw_live: bool = false;
    var saw_dead: bool = false;
    var i: usize = 0;
    while i < nodes.count() {
        match nodes.at_ptr(i) {
            option::Option[*agent::AppKitNode]::Some(n) => {
                if { (*n).id.view() } == "live" {
                    saw_live = true;
                    assert { (*n).actionable };
                    assert { (*n).clickable };
                    assert { (*n).wired };
                }
                if { (*n).id.view() } == "dead" {
                    saw_dead = true;
                    // Permitted, and a click WOULD land on it — both true, both
                    // useless on their own. The three flags together are what
                    // separate the two buttons.
                    assert { (*n).actionable };
                    assert { (*n).clickable };
                    assert { (*n).wired } == false;
                }
            }
            option::Option::None => { }
        }
        i = i +% 1;
    }
    assert saw_live;
    assert saw_dead;

    // AND `click` SAYS SO TOO, which is the half that makes a sweep honest: a
    // suite asserting `Allowed` cannot tell "it worked" from "it went nowhere".
    assert surface::outcome_eq(s.click(auth::operator(), "live"), surface::Outcome::Allowed);
    assert CLICKS == 1;
    assert surface::outcome_eq(s.click(auth::operator(), "dead"), surface::Outcome::NoHandler);
    // The click was still SENT — this is a report, not a refusal.
    assert CLICKS == 1;
}

#[test]
fn describe_reports_the_click_capability_beside_the_permission() {
    // `actionable` is a PERMISSION (exposed + enabled + not observe-only) and a
    // tagged non-control defaults to it — see the NotActionable test above,
    // which asserts exactly that pairing from the other side. `click` asks a
    // CAPABILITY: does the view answer `performClick:`. A keyed layout
    // container is permitted and cannot, so every one of them advertised a
    // press that did not exist, and an agent — for which the flag is the whole
    // of what it knows — had to spend a click on each to find out.
    let win = fixture_window(300.0, 200.0);
    let content = content_of(win);

    let group = ak::View::new(rt::Rect { x: 5.0, y: 5.0, w: 100.0, h: 40.0 });
    content.add_subview(ak::View::from_raw(group.raw()));
    agent::set_agent_id(group.raw(), "lane");

    let b = add_button(content, "Add");
    agent::set_agent_id(b.as_view().raw(), "add");

    var s: agent::Surface = agent::open(win.raw());
    let nodes: vec::Vec[agent::AppKitNode] = s.describe(auth::operator());
    assert nodes.count() == 4;

    // The keyed container: permitted, not clickable — and `click` agrees.
    match nodes.at_ptr(2) {
        option::Option[*agent::AppKitNode]::Some(n) => {
            assert { (*n).id.view() } == "lane";
            assert { (*n).actionable };
            assert !{ (*n).clickable };
        }
        option::Option::None => { assert false; }
    };
    assert surface::outcome_eq(s.click(auth::operator(), "lane"), surface::Outcome::NotActionable);

    // The button: both, and `click` agrees there too. The flag has to predict
    // the verb or it is worse than no flag at all.
    match nodes.at_ptr(3) {
        option::Option[*agent::AppKitNode]::Some(n) => {
            assert { (*n).id.view() } == "add";
            assert { (*n).actionable };
            assert { (*n).clickable };
        }
        option::Option::None => { assert false; }
    };
    assert surface::outcome_eq(s.click(auth::operator(), "add"), surface::Outcome::Allowed);
}

#[test]
fn describe_reports_a_text_drive_as_not_clickable() {
    // The other half of the capability: a declared drive_text input is exposed,
    // enabled and actionable — `set_text` is exactly what it is for — but
    // `click` refuses it rather than no-op, so `clickable` must say so. This is
    // the pairing that rules out folding the capability into `actionable`.
    let win = fixture_window(300.0, 200.0);
    let content = content_of(win);
    let f = ak::TextField::new_with_frame(rt::Rect { x: 10.0, y: 10.0, w: 120.0, h: 22.0 });
    content.add_subview(f.as_view());
    agent::set_agent_id(f.as_view().raw(), "title");
    agent::set_affordance(f.as_view().raw(), identity::Role::Input);

    var s: agent::Surface = agent::open(win.raw());
    let nodes: vec::Vec[agent::AppKitNode] = s.describe(auth::operator());
    match nodes.at_ptr(2) {
        option::Option[*agent::AppKitNode]::Some(n) => {
            assert { (*n).id.view() } == "title";
            assert { (*n).actionable };
            assert !{ (*n).clickable };
        }
        option::Option::None => { assert false; }
    };
    assert surface::outcome_eq(s.click(auth::operator(), "title"), surface::Outcome::NotActionable);
}

#[test]
fn the_walked_view_reports_an_untagged_node_own_text() {
    // iris/components.txt: `mode: full` returns three times the nodes of
    // `mode: exposed` and DROPPED the text that makes them mean anything — a
    // card whose face reads "Card 1" answered "" in the mode that shows the
    // most of the screen. One predicate did it: the walked view asked
    // `can_read_value`, which folds the CURATION bit into a CONTENT question,
    // so the mode that exists to show untagged structure blanked all of it.
    //
    // It protected nothing even before this: the walk stores a non-sensitive
    // node's own text as its registry NAME, and the walked view has always
    // carried `name`. The blank `text` only made the field lie — and since
    // `readable` reaches the wire on a gated node only, nothing said so.
    let win = fixture_window(300.0, 200.0);
    let content = content_of(win);
    let card = ak::View::new(rt::Rect { x: 5.0, y: 5.0, w: 200.0, h: 60.0 });
    content.add_subview(ak::View::from_raw(card.raw()));
    agent::set_agent_id(card.raw(), "card:1");
    // The title the card DRAWS, on a node nobody tagged — the shape of every
    // structural label in a real tree.
    let title = ak::TextField::label_with_string("Card 1");
    card.add_subview(title.as_view());

    var s: agent::Surface = agent::open(win.raw());
    let nodes: vec::Vec[agent::AppKitNode] = s.describe(auth::operator());
    // window, content group, card, title.
    assert nodes.count() == 4;
    match nodes.at_ptr(3) {
        option::Option[*agent::AppKitNode]::Some(n) => {
            assert identity::role_eq({ (*n).role }, identity::Role::Text);
            // Still not exposed and still not actionable — curation is
            // untouched. Only the content question changed its answer.
            assert !{ (*n).actionable };
            assert { (*n).text.view() } == "Card 1";
            assert { (*n).readable };
        }
        option::Option::None => { assert false; }
    };
}

#[test]
fn the_walked_view_is_not_a_way_around_an_exclusion() {
    // The other half of `is_exposed`, and the half that IS a content gate: an
    // excluded subtree is not the application's content, so the walked view
    // withholds what it says however wide the grant. It stays LISTED — it is on
    // screen and it has a frame — and `readable: false` is what says the blank
    // is a refusal rather than an empty label.
    let win = fixture_window(300.0, 200.0);
    let content = content_of(win);
    let panel = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 200.0, h: 100.0 });
    content.add_subview(ak::View::from_raw(panel.raw()));
    agent::set_agent_id(panel.raw(), "assistant");
    agent::set_agent_policy(panel.raw(), identity::policy_exclude());
    let line = ak::TextField::label_with_string("thinking about your card");
    panel.add_subview(line.as_view());

    var s: agent::Surface = agent::open(win.raw());
    let nodes: vec::Vec[agent::AppKitNode] = s.describe(auth::protected_operator());
    assert nodes.count() == 4;
    match nodes.at_ptr(3) {
        option::Option[*agent::AppKitNode]::Some(n) => {
            assert { (*n).text.view() } == "";
            assert !{ (*n).readable };
            // AND NOT THE OTHER WAY EITHER. The walk's name fallback stores a
            // node's own text as its registry NAME, and the walked view carries
            // `name` — so the line arrived in the model's context with `text`
            // blanked beside it. `set_content_name` refuses an excluded node
            // now, the same way it refuses a tiered one.
            assert { (*n).name.view() } == "";
        }
        option::Option::None => { assert false; }
    };
}

#[test]
fn describe_carries_the_accessibility_label_as_the_node_name() {
    // The walk already read the label into the registry's name — the curated
    // view has always reported it — but the full view dropped it, so a group
    // whose title lives in a grandchild, and every icon-only control, arrived
    // as `text: ""` and said nothing about itself. The label is written on
    // purpose; the agent simply could not see it.
    let win = fixture_window(300.0, 200.0);
    let content = content_of(win);

    // A container with NO text of its own, named only by its label.
    let card = ak::View::new(rt::Rect { x: 5.0, y: 5.0, w: 100.0, h: 40.0 });
    content.add_subview(ak::View::from_raw(card.raw()));
    agent::set_agent_id(card.raw(), "card:3");
    ak::Accessibility::from_raw(card.raw()).set_accessibility_label("the trail feed");

    // A control whose label OVERRIDES its own title — the override channel.
    let b = add_button(content, "+");
    agent::set_agent_id(b.as_view().raw(), "col:add");
    ak::Accessibility::from_raw(b.as_view().raw()).set_accessibility_label("Add a card");

    var s: agent::Surface = agent::open(win.raw());
    let nodes: vec::Vec[agent::AppKitNode] = s.describe(auth::operator());

    match nodes.at_ptr(2) {
        option::Option[*agent::AppKitNode]::Some(n) => {
            assert { (*n).id.view() } == "card:3";
            assert { (*n).text.view() } == "";
            assert { (*n).name.view() } == "the trail feed";
        }
        option::Option::None => { assert false; }
    };
    match nodes.at_ptr(3) {
        option::Option[*agent::AppKitNode]::Some(n) => {
            assert { (*n).id.view() } == "col:add";
            assert { (*n).text.view() } == "+";
            assert { (*n).name.view() } == "Add a card";
        }
        option::Option::None => { assert false; }
    };
}

#[test]
fn a_node_with_no_label_names_itself_by_its_own_title() {
    // No accessibility label anywhere: `name` falls back to the widget's own
    // title (which is what the registry already does), and a node with neither
    // reports "" rather than inventing one.
    let win = fixture_window(300.0, 200.0);
    let content = content_of(win);
    let b = add_button(content, "Save");
    agent::set_agent_id(b.as_view().raw(), "save");
    let group = ak::View::new(rt::Rect { x: 5.0, y: 60.0, w: 100.0, h: 40.0 });
    content.add_subview(ak::View::from_raw(group.raw()));
    agent::set_agent_id(group.raw(), "strip");

    var s: agent::Surface = agent::open(win.raw());
    let nodes: vec::Vec[agent::AppKitNode] = s.describe(auth::operator());
    match nodes.at_ptr(2) {
        option::Option[*agent::AppKitNode]::Some(n) => {
            assert { (*n).id.view() } == "save";
            assert { (*n).name.view() } == "Save";
        }
        option::Option::None => { assert false; }
    };
    match nodes.at_ptr(3) {
        option::Option[*agent::AppKitNode]::Some(n) => {
            assert { (*n).id.view() } == "strip";
            assert { (*n).name.view() } == "";
        }
        option::Option::None => { assert false; }
    };
}

// ---- the tiers: visible, named, and gated on the grant -----------------------

// A payment box: a secure card field and a plain CVC beside it. Returns the
// card view so a test can read it back and prove a refused write was refused.
fn payment_form(content: ak::View) -> *u8 {
    let box_v = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 300.0, h: 80.0 });
    content.add_subview(ak::View::from_raw(box_v.raw()));
    agent::set_agent_id(box_v.raw(), "payment");

    let card: *u8 = rt::alloc_init(#str_ptr("NSSecureTextField\0"));
    rt::msg_void_id(card, rt::sel(#str_ptr("setStringValue:\0")),
                    bridge::nsstring("4242424242424242"));
    // The developer's label — facet's `.accessibility_label`. A different
    // channel from the widget's content, and the one that has to survive.
    rt::msg_void_id(card, rt::sel(#str_ptr("setAccessibilityLabel:\0")),
                    bridge::nsstring("Card number"));
    box_v.add_subview(ak::View::from_raw(card));
    agent::set_agent_id(card, "payment:card");
    // Explicit: the card is the autofillable one, so it is Protected rather
    // than the Private its class would otherwise imply.
    agent::set_agent_policy(card, identity::policy_protected());

    let cvc = ak::TextField::new_with_frame(rt::Rect { x: 0.0, y: 40.0, w: 60.0, h: 24.0 });
    cvc.as_control().set_string_value("311");
    rt::msg_void_id(cvc.as_view().raw(), rt::sel(#str_ptr("setAccessibilityLabel:\0")),
                    bridge::nsstring("Security code"));
    box_v.add_subview(cvc.as_view());
    agent::set_agent_id(cvc.as_view().raw(), "payment:cvc");
    // The three digits. Private, and the app will never mint the bit.
    agent::set_agent_policy(cvc.as_view().raw(), identity::policy_private());
    return card;
}

fn node_named(nodes: vec::Vec[agent::AppKitNode], id: str) -> option::Option[*agent::AppKitNode] {
    var i: usize = 0;
    while i < nodes.count() {
        match nodes.at_ptr(i) {
            option::Option[*agent::AppKitNode]::Some(n) => {
                if { (*n).id.view() } == id { return option::Option[*agent::AppKitNode]::Some(n); }
            }
            option::Option::None => { }
        }
        i = i +% 1;
    }
    return option::Option[*agent::AppKitNode]::None;
}

#[test]
fn an_ordinary_assistant_sees_the_payment_fields_and_reads_neither() {
    // The shape of the whole feature. The assistant knows the form has a card
    // number and a security code, knows what they are called, and gets no
    // digits from either.
    let win = fixture_window(400.0, 200.0);
    let content = content_of(win);
    let card: *u8 = payment_form(content);

    var s: agent::Surface = agent::open(win.raw());
    let nodes: vec::Vec[agent::AppKitNode] = s.describe(auth::operator());
    match node_named(nodes, "payment:card") {
        option::Option[*agent::AppKitNode]::Some(n) => {
            assert { (*n).tier } == identity::tier_protected();
            assert !{ (*n).readable };
            assert { (*n).text.view() } == "";
            assert { (*n).name.view() } == "Card number";   // the dev's label survives
            assert !{ (*n).actionable };
        }
        option::Option::None => { assert false; }
    };
    match node_named(nodes, "payment:cvc") {
        option::Option[*agent::AppKitNode]::Some(n) => {
            assert { (*n).tier } == identity::tier_private();
            assert !{ (*n).readable };
            assert { (*n).text.view() } == "";
            assert { (*n).name.view() } == "Security code";
        }
        option::Option::None => { assert false; }
    };
    // The refusals say which is worth asking about and which is not.
    assert surface::outcome_eq(s.set_text(auth::operator(), "payment:card", "5555555555554444", 0),
                               surface::Outcome::NeedsGrant);
    assert surface::outcome_eq(s.set_text(auth::operator(), "payment:cvc", "999", 0),
                               surface::Outcome::Forbidden);
    assert agent::node_text(card, identity::Role::Input).view() == "4242424242424242";
    // Attribute runs are a content read: one run of sixteen characters is the
    // number's length.
    assert surface::outcome_eq(s.read_runs(auth::operator(), "payment:card").outcome,
                               surface::Outcome::NeedsGrant);
    // Navigation is still open — an agent may bring a field it cannot read
    // onto the screen so the PERSON can fill it in.
    assert surface::outcome_eq(s.scroll_to(auth::operator(), "payment:card"),
                               surface::Outcome::Allowed);
}

#[test]
fn the_approved_grant_autofills_the_card_and_still_not_the_cvc() {
    // The autofill flow against a real widget. The app asked the user, minted
    // `protected_operator`, and the same calls now pass — for the card. The
    // CVC is Private and this grant, like every grant the app hands out, does
    // not carry the bit.
    let win = fixture_window(400.0, 200.0);
    let content = content_of(win);
    let card: *u8 = payment_form(content);
    let approved: auth::Grant = auth::protected_operator();

    var s: agent::Surface = agent::open(win.raw());
    let nodes: vec::Vec[agent::AppKitNode] = s.describe(approved);
    match node_named(nodes, "payment:card") {
        option::Option[*agent::AppKitNode]::Some(n) => {
            assert { (*n).readable };
            assert { (*n).text.view() } == "4242424242424242";
            assert { (*n).actionable };
        }
        option::Option::None => { assert false; }
    };
    match node_named(nodes, "payment:cvc") {
        option::Option[*agent::AppKitNode]::Some(n) => {
            assert !{ (*n).readable };
            assert { (*n).text.view() } == "";
        }
        option::Option::None => { assert false; }
    };
    assert surface::outcome_eq(s.set_text(approved, "payment:card", "5555555555554444", 0),
                               surface::Outcome::Allowed);
    assert agent::node_text(card, identity::Role::Input).view() == "5555555555554444";
    assert surface::outcome_eq(s.set_text(approved, "payment:cvc", "999", 0),
                               surface::Outcome::Forbidden);
}

#[test]
fn a_secure_field_defaults_to_private_with_no_declaration_at_all() {
    // The one a developer should not have to ask for. An NSSecureTextField the
    // app never annotated is Private — not Protected, because the platform is
    // saying these contents are not to be shown, and Protected would mean
    // "there is a grant that opens this".
    let win = fixture_window(400.0, 200.0);
    let content = content_of(win);
    let pw: *u8 = rt::alloc_init(#str_ptr("NSSecureTextField\0"));
    rt::msg_void_id(pw, rt::sel(#str_ptr("setStringValue:\0")), bridge::nsstring("hunter2"));
    content.add_subview(ak::View::from_raw(pw));
    agent::set_agent_id(pw, "pw");

    var s: agent::Surface = agent::open(win.raw());
    match node_named(s.describe(auth::protected_operator()), "pw") {
        option::Option[*agent::AppKitNode]::Some(n) => {
            assert { (*n).tier } == identity::tier_private();
            assert !{ (*n).readable };
            assert { (*n).text.view() } == "";
            // Not even the name: the walk's fallback would have made the
            // password this node's name, which is how it leaked.
            assert { (*n).name.view() } == "";
        }
        option::Option::None => { assert false; }
    };
}

#[test]
fn an_explicit_declaration_beats_the_secure_class_default() {
    // The inference is a DEFAULT, not a law — in both directions. An app whose
    // "secure" field holds something an assistant is meant to drive (a
    // passphrase it just generated) says so, and the statement wins.
    let win = fixture_window(400.0, 200.0);
    let content = content_of(win);
    let pw: *u8 = rt::alloc_init(#str_ptr("NSSecureTextField\0"));
    rt::msg_void_id(pw, rt::sel(#str_ptr("setStringValue:\0")), bridge::nsstring("hunter2"));
    content.add_subview(ak::View::from_raw(pw));
    agent::set_agent_id(pw, "pw");
    agent::set_agent_policy(pw, identity::policy_none());

    var s: agent::Surface = agent::open(win.raw());
    match node_named(s.describe(auth::operator()), "pw") {
        option::Option[*agent::AppKitNode]::Some(n) => {
            assert { (*n).tier } == identity::tier_open();
            assert { (*n).readable };
            assert { (*n).text.view() } == "hunter2";
        }
        option::Option::None => { assert false; }
    };
}

#[test]
fn a_tier_on_the_box_covers_the_label_nobody_would_have_named() {
    // Marking the CONTAINER is what a developer will actually do, and it is
    // the only version that holds: the leak is never the field you remembered,
    // it is the "Card ending 4242" label beside it — a plain NSTextField with
    // nothing secure about it.
    let win = fixture_window(400.0, 300.0);
    let content = content_of(win);
    let box_v = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 300.0, h: 80.0 });
    content.add_subview(ak::View::from_raw(box_v.raw()));
    agent::set_agent_id(box_v.raw(), "payment");
    agent::set_agent_policy(box_v.raw(), identity::policy_protected());

    let summary = ak::TextField::label_with_string("Card ending 4242");
    box_v.add_subview(summary.as_view());
    agent::set_agent_id(summary.as_view().raw(), "payment:summary");

    // A plain field OUTSIDE the box: this must keep working exactly as before.
    let email = ak::TextField::new_with_frame(rt::Rect { x: 0.0, y: 120.0, w: 200.0, h: 24.0 });
    email.as_control().set_string_value("ada@example.com");
    content.add_subview(email.as_view());
    agent::set_agent_id(email.as_view().raw(), "email");

    var s: agent::Surface = agent::open(win.raw());
    let nodes: vec::Vec[agent::AppKitNode] = s.describe(auth::operator());
    match node_named(nodes, "payment:summary") {
        option::Option[*agent::AppKitNode]::Some(n) => {
            assert { (*n).tier } == identity::tier_protected();   // inherited
            assert { (*n).text.view() } == "";
            assert { (*n).name.view() } == "";
        }
        option::Option::None => { assert false; }
    };
    // The neighbour is untouched. A tier that quietly blinds the rest of the
    // form is a tier nobody will turn on.
    match node_named(nodes, "email") {
        option::Option[*agent::AppKitNode]::Some(n) => {
            assert { (*n).tier } == identity::tier_open();
            assert { (*n).readable };
            assert { (*n).text.view() } == "ada@example.com";
            assert { (*n).actionable };
        }
        option::Option::None => { assert false; }
    };
    assert surface::outcome_eq(s.set_text(auth::operator(), "email", "grace@example.com", 0),
                               surface::Outcome::Allowed);
}

#[test]
fn a_blind_grant_gets_no_tree_at_all() {
    // The gate is not only about tiers: an agent with no `read` bit is not a
    // reader of ordinary nodes either.
    let win = fixture_window(400.0, 200.0);
    let content = content_of(win);
    let _card: *u8 = payment_form(content);
    var s: agent::Surface = agent::open(win.raw());
    // `NeedsGrant`, not `Forbidden`: a missing BASE capability is what a wider
    // grant fixes. `Forbidden` is reserved for the Private tier, which is the
    // one an application declares and never mints.
    assert surface::outcome_eq(s.click(auth::nothing(), "payment"), surface::Outcome::NeedsGrant);
    assert surface::outcome_eq(s.scroll_to(auth::nothing(), "payment"), surface::Outcome::NeedsGrant);
}

#[test]
fn an_excluded_subtree_is_gone_while_a_gated_one_is_present() {
    // The two are not the same setting and the difference is the point:
    // `exclude` is for UI that is not the application's content (the
    // assistant's own panel), the tiers are for content that is not the
    // agent's.
    let win = fixture_window(400.0, 200.0);
    let content = content_of(win);
    let panel = ak::View::new(rt::Rect { x: 0.0, y: 0.0, w: 200.0, h: 100.0 });
    content.add_subview(ak::View::from_raw(panel.raw()));
    agent::set_agent_id(panel.raw(), "assistant");
    agent::set_agent_policy(panel.raw(), identity::policy_exclude());
    let send = add_button(panel, "Send");
    agent::set_agent_id(send.as_view().raw(), "assistant:send");

    var s: agent::Surface = agent::open(win.raw());
    // Its own Send button is not addressable — the assistant cannot press it,
    // even with the widest grant the app ever mints.
    assert surface::outcome_eq(s.click(auth::protected_operator(), "assistant:send"),
                               surface::Outcome::NotExposed);
    assert surface::outcome_eq(s.scroll_to(auth::protected_operator(), "assistant"),
                               surface::Outcome::NotExposed);
}
