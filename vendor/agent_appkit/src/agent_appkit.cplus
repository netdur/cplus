// agent_appkit — the AppKit backend for the agent surface (Theme B, Iris GAP 1).
//
// `open(window)` walks a live NSView hierarchy into a `Surface`: the agent-core
// identity tree (ids / roles / enabled state / exposure) plus a NodeId->NSView
// map and the text-version state. From a `Surface` you get:
//
//   - the READ path: `describe()` -> `Vec[AppKitNode]`, a live snapshot
//     ({ id, role, class_name, frame, is_hidden, text, parent }). This is how an
//     agent sees the UI (describe_ui, not screenshots).
//   - the WRITE path: `click` / `set_text` / `scroll_to`, each gated through the
//     framework-agnostic `agent_core::surface` authorization brain (exposure +
//     affordance ceiling + optimistic-concurrency version) — the real widget I/O
//     happens only when the core returns `Allowed`.
//
// The agent-visible/actionable surface is the *exposed* subset: a node is
// exposed iff it was tagged with `set_agent_id` (the developer curates what the
// agent can touch). Untagged views are still walked for tree completeness but
// are NotExposed, so actions on them are refused.
//
// The walk is a recursive DFS (pre-order); recursion depth tracks view-tree
// depth, which is shallow in practice. NSView frames come back via
// `rt::msg_rect` (NSRect is an HFA of four doubles, returned in registers on
// arm64).

import "stdlib/vec" as vec;
import "stdlib/option" as option;
import "stdlib/text" as text;
import "objc/runtime" as rt;
import "objc/bridge" as bridge;
import "agent_core/identity" as identity;
import "agent_core/surface" as surface;
import "agent_core/events" as events;
import "agent_core/backend" as mcpb;

fn null() -> *u8 {
    return { 0 as *u8 };
}

fn is_null(p: *u8) -> bool {
    return p == null();
}

// ---- main-thread marshaling -------------------------------------------------
//
// AppKit requires UI mutations to run on the main thread. When the MCP bridge
// is driven off-thread (the realistic deployment: `agent_mcp::serve_uds` on a
// background connection), the agent's click / set_text / scroll_to would
// otherwise message views off-main. These helpers hop to the main thread when
// needed. C+ has no closures (so no `dispatch_async(^{...})`) and no extern
// globals (so no `dispatch_get_main_queue()`); the closure-free path is Cocoa's
// `performSelectorOnMainThread:withObject:waitUntilDone:`, which carries a
// selector plus one `id` argument. `waitUntilDone:YES` keeps the action
// synchronous, so the Outcome the caller returns stays accurate. Already on the
// main thread, we send directly (the common in-app case, and what the headless
// tests exercise).

fn on_main_thread() -> bool {
    let ns_thread: *u8 = rt::get_class(#str_ptr("NSThread\0"));
    return rt::msg_i8(ns_thread, rt::sel(#str_ptr("isMainThread\0"))) != (0 as i8);
}

// Send `[target action:arg]` on the main thread (directly if already there).
// `action` takes 0 or 1 `id` arg (the withObject value); pass `null()` for none.
fn perform_on_main(target: *u8, action: *u8, arg: *u8) {
    if on_main_thread() {
        rt::msg_void_id(target, action, arg);
        return;
    }
    rt::msg_void_id_id_i8(
        target,
        rt::sel(#str_ptr("performSelectorOnMainThread:withObject:waitUntilDone:\0")),
        action,
        arg,
        1 as i8,
    );
    return;
}

// scroll_to passes an NSRect (a struct), which performSelectorOnMainThread
// can't carry as its `id` argument. So scroll the view's own bounds into view
// through a no-extra-arg helper method registered on NSView once:
// `cplusScrollSelfVisible:` reads its own bounds and calls `scrollRectToVisible:`.
// Registered lazily and idempotently (class_addMethod no-ops if it exists).
static SCROLL_METHOD_REGISTERED: bool = false;

fn cplus_scroll_self_visible(view: *u8, _cmd: *u8, _sender: *u8) {
    let b: rt::Rect = rt::msg_rect(view, rt::sel(#str_ptr("bounds\0")));
    rt::msg_void_rect(view, rt::sel(#str_ptr("scrollRectToVisible:\0")), b);
    return;
}

fn ensure_scroll_method() {
    if { SCROLL_METHOD_REGISTERED } {
        return;
    }
    let cls: *u8 = rt::get_class(#str_ptr("NSView\0"));
    if !is_null(cls) {
        rt::add_method_action(
            cls,
            rt::sel(#str_ptr("cplusScrollSelfVisible:\0")),
            cplus_scroll_self_visible,
            #str_ptr("v@:@\0"),
        );
    }
    { SCROLL_METHOD_REGISTERED = true; }
    return;
}

// Tell the app the value changed, the way a real edit would.
//
// A VALUE control — slider, stepper, popup, switch — reports through its
// target/action; that is how `facet::slider(..., on_change, ctx)` learns
// anything at all, because a slider has no read-on-demand moment the way a text
// field does. Writing the control without firing it left the UI and the app's
// model silently disagreeing: iris's card sheet mirrors a slider and a typed
// percent field, and an agent `set_text` on the slider moved the knob while the
// field kept the old number, with nothing in describe_ui saying which was right.
//
// NOT fired for text. An NSTextField's action is its ENTER key, so firing it
// here would turn a field write into a form submission — a much worse surprise
// than the one being fixed. A field is read on demand, so nothing is owed.
// bugs/agent-set-text-does-not-notify-the-app.md
static SEND_ACTION_METHOD_REGISTERED: bool = false;

fn cplus_agent_send_action(view: *u8, _cmd: *u8, _sender: *u8) {
    if !responds_to(view, #str_ptr("sendAction:to:\0")) { return; }
    let action: *u8 = rt::msg_id(view, rt::sel(#str_ptr("action\0")));
    if is_null(action) { return; }
    let target: *u8 = rt::msg_id(view, rt::sel(#str_ptr("target\0")));
    let _sent: i8 = rt::msg_i8_id_id(view, rt::sel(#str_ptr("sendAction:to:\0")), action, target);
    return;
}

fn ensure_send_action_method() {
    if { SEND_ACTION_METHOD_REGISTERED } { return; }
    let cls: *u8 = rt::get_class(#str_ptr("NSControl\0"));
    if !is_null(cls) {
        rt::add_method_action(
            cls,
            rt::sel(#str_ptr("cplusAgentSendAction:\0")),
            cplus_agent_send_action,
            #str_ptr("v@:@\0"),
        );
    }
    { SEND_ACTION_METHOD_REGISTERED = true; }
    return;
}

// Whether writing this view's value owes the app its ACTION. Text controls are
// excluded on purpose and always were: an NSTextField's action is SUBMIT (the
// Enter key), so firing it after a write would not report a change, it would
// commit one. Their notification is a different message entirely — see
// `notify_text_changed_on_main`.
fn value_control_notifies(v: *u8) -> bool {
    if is_null(v) { return false; }
    if is_kind(v, #str_ptr("NSTextField\0")) { return false; }
    if is_kind(v, #str_ptr("NSTextView\0")) { return false; }
    return is_kind(v, #str_ptr("NSControl\0"));
}

// Tell the application a text control changed, the way AppKit tells it.
//
// A typed keystroke reaches the app through the field's DELEGATE —
// `controlTextDidChange:` for an NSControl, `textDidChange:` for an NSTextView
// — and that is what runs `sync_from_native`, so the props catch up with the
// view. An agent write went straight to `setStringValue:` and stopped there:
// the view showed the new text, `describe_ui` read the view and reported it,
// and the application's own `text()` still answered the old value. Two truths
// for one field, which is worse than the write failing.
//
// Excluded from the action path above, so this is the one that owes them
// something. The notification carries the changed object exactly as AppKit's
// does, because `did_change_imp` reads it back out of `object`.
fn notify_text_changed_on_main(view: *u8) {
    if is_null(view) { return; }
    let is_text_view: bool = is_kind(view, #str_ptr("NSTextView\0"));
    if !is_text_view && !is_kind(view, #str_ptr("NSTextField\0")) { return; }
    let delegate: *u8 = { rt::msg_id(view, rt::sel(#str_ptr("delegate\0"))) };
    if is_null(delegate) { return; }
    let name: *u8 = if is_text_view {
        bridge::nsstring("NSTextDidChangeNotification")
    } else {
        bridge::nsstring("NSControlTextDidChangeNotification")
    };
    let note: *u8 = { rt::msg_id_id_id(rt::get_class(#str_ptr("NSNotification\0")),
                                       rt::sel(#str_ptr("notificationWithName:object:\0")),
                                       name, view) };
    if is_null(note) { return; }
    let sel_name: *u8 = if is_text_view {
        #str_ptr("textDidChange:\0")
    } else {
        #str_ptr("controlTextDidChange:\0")
    };
    let sel: *u8 = rt::sel(sel_name);
    if { rt::msg_i8_id(delegate, rt::sel(#str_ptr("respondsToSelector:\0")), sel) } == (0 as i8) {
        return;
    }
    perform_on_main(delegate, sel, note);
    return;
}

fn notify_value_changed_on_main(view: *u8) {
    if !value_control_notifies(view) { return; }
    ensure_send_action_method();
    perform_on_main(view, rt::sel(#str_ptr("cplusAgentSendAction:\0")), null());
    return;
}

// Scroll `view`'s bounds into view on the main thread.
fn scroll_visible_on_main(view: *u8) {
    if on_main_thread() {
        let b: rt::Rect = rt::msg_rect(view, rt::sel(#str_ptr("bounds\0")));
        rt::msg_void_rect(view, rt::sel(#str_ptr("scrollRectToVisible:\0")), b);
        return;
    }
    ensure_scroll_method();
    rt::msg_void_id_id_i8(
        view,
        rt::sel(#str_ptr("performSelectorOnMainThread:withObject:waitUntilDone:\0")),
        rt::sel(#str_ptr("cplusScrollSelfVisible:\0")),
        null(),
        1 as i8,
    );
    return;
}

// ---- agent-id tagging -------------------------------------------------------

// A unique, stable address used as the associated-object key for the pinned
// agent-id. The byte's value is irrelevant — only its address matters.
static AGENT_ID_KEY: u8 = 0;

fn agent_id_key() -> *u8 {
    return { #addr_of(AGENT_ID_KEY) };
}

// Pin a stable agent-id on a view (developer tagging). The walk uses a pinned id
// as the node's developer id, which both (a) keeps the resolved agent-id stable
// across re-layouts and (b) marks the node *exposed* — i.e. part of the curated
// surface the agent may act on. Stored as an associated, retained NSString
// (OBJC_ASSOCIATION_RETAIN_NONATOMIC = 1).
fn set_agent_id(view: *u8, id: str) {
    let ns: *u8 = bridge::nsstring(id);
    rt::set_associated_object(view, agent_id_key(), ns, 1 as usize);
}

// Read a view's agent-id, or None if it was never tagged. A pinned id
// (`set_agent_id`) wins; otherwise a non-empty AppKit accessibilityIdentifier
// counts as the tag. The identifier channel is how declarative frameworks
// tag without depending on this package: facet re-applies each node's
// `agent_id` as the accessibilityIdentifier at every mount, so the tag
// survives re-renders that replace the views.
fn get_agent_id(view: *u8) -> option::Option[text::Text] {
    let ns: *u8 = rt::get_associated_object(view, agent_id_key());
    if !is_null(ns) {
        return option::Option[text::Text]::Some(bridge::to_text(ns));
    }
    if responds_to(view, #str_ptr("accessibilityIdentifier\0")) {
        let ident: *u8 = rt::msg_id(view, rt::sel(#str_ptr("accessibilityIdentifier\0")));
        if !is_null(ident) {
            let t: text::Text = bridge::to_text(ident);
            if t.count() > (0 as usize) {
                return option::Option[text::Text]::Some(t);
            }
        }
    }
    return option::Option[text::Text]::None;
}

// ---- declared affordance (role + drive-method) ------------------------------
//
// Facet's set_identity (and hand-built widgets via set_affordance) pin a packed
// (role, drive) on the view so the walk does not re-guess the role from the
// native class. Storage: associated-object ASSIGN of a packed non-null integer
// under agent_core::affordance_key() — same key facet_appkit writes.

// Record the declared affordance. `drive` defaults from the role when you only
// care about classification (the common case).
fn set_affordance(view: *u8, role: identity::Role) {
    if is_null(view) { return; }
    let drive: u32 = identity::drive_for_role(role);
    let packed: *u8 = identity::pack_affordance(identity::role_index(role) as u32, drive);
    // OBJC_ASSOCIATION_ASSIGN (0): value is an integer disguised as a pointer.
    rt::set_associated_object(view, identity::affordance_key(), packed, 0 as usize);
    return;
}

// Record role + an explicit drive method (for widgets whose drive does not
// follow the role default).
fn set_affordance_drive(view: *u8, role: identity::Role, drive: u32) {
    if is_null(view) { return; }
    let packed: *u8 = identity::pack_affordance(identity::role_index(role) as u32, drive);
    rt::set_associated_object(view, identity::affordance_key(), packed, 0 as usize);
    return;
}

// Declared role if the view was annotated; None means "fall back to classify".
fn get_declared_role(view: *u8) -> option::Option[identity::Role] {
    if is_null(view) { return option::Option[identity::Role]::None; }
    let p: *u8 = rt::get_associated_object(view, identity::affordance_key());
    if !identity::is_packed_affordance(p) {
        return option::Option[identity::Role]::None;
    }
    return option::Option[identity::Role]::Some(identity::role_from_index(identity::unpack_role(p)));
}

// Declared drive method if annotated; None when missing.
fn get_declared_drive(view: *u8) -> option::Option[u32] {
    if is_null(view) { return option::Option[u32]::None; }
    let p: *u8 = rt::get_associated_object(view, identity::affordance_key());
    if !identity::is_packed_affordance(p) {
        return option::Option[u32]::None;
    }
    return option::Option[u32]::Some(identity::unpack_drive(p));
}

// ---- the describe_ui snapshot node ------------------------------------------

// One node of the describe_ui snapshot. `id` is the resolved agent-id; `role` is
// the curated role; `class_name` is the AppKit class (e.g. "NSButton"); `frame`
// is the view's frame in its superview's coordinates; `text` is the live label /
// content; `name` is the accessibility label the walk read (else the widget's
// own title); `actionable` is whether the agent may ACT on it (exposed + enabled
// + not observe-only); `clickable` is whether a click would be DELIVERED.
// `parent` indexes into the returned `Vec[AppKitNode]` (None for the window
// root), so the flat list reconstructs the tree.
struct AppKitNode {
    id: text::Text,
    role: identity::Role,
    class_name: text::Text,
    frame: rt::Rect,
    is_hidden: bool,
    text: text::Text,
    name: text::Text,
    actionable: bool,
    clickable: bool,
    parent: option::Option[usize],
}

// Per-node Auto Layout health, surfaced by `Surface::layout_diagnostics`. Lets
// an agent (or a developer debugging a generated UI) ask "is this layout
// well-formed?" without a screenshot. `uses_autolayout` is true when the view
// opts into constraints (`translatesAutoresizingMaskIntoConstraints == NO`);
// `has_ambiguous_layout` mirrors AppKit's `-[NSView hasAmbiguousLayout]` — true
// when the constraint solver cannot pin the view's frame (under-constrained).
struct LayoutDiagnostic {
    id: text::Text,
    class_name: text::Text,
    uses_autolayout: bool,
    has_ambiguous_layout: bool,
}

// ---- role classification ----------------------------------------------------

fn is_kind(obj: *u8, class_name: *u8) -> bool {
    let cls: *u8 = rt::get_class(class_name);
    if is_null(cls) {
        return false;
    }
    return rt::msg_i8_id(obj, rt::sel(#str_ptr("isKindOfClass:\0")), cls) != (0 as i8);
}

fn responds_to(obj: *u8, selector_name: *u8) -> bool {
    let s: *u8 = rt::sel(selector_name);
    return rt::msg_i8_id(obj, rt::sel(#str_ptr("respondsToSelector:\0")), s) != (0 as i8);
}

// The view that actually holds a node's TEXT.
//
// A text area's node is backed by the SCROLL VIEW — a bare NSTextView does not
// scroll, so the scroller is not optional and the text view is its
// `documentView`. Every text verb has to go one level down for it, and until
// this existed they did not: `setStringValue:` on an NSScrollView is a silent
// no-op, so `set_text` on a text area wrote nothing, told nobody, and returned
// Allowed. A write that reports success and does nothing is worse than one
// that fails.
//
// The read goes through the same door, because a read and a write that
// disagree about which view they mean is the same bug wearing a different hat.
fn text_target(v: *u8) -> *u8 {
    if is_null(v) { return v; }
    if !is_kind(v, #str_ptr("NSScrollView\0")) { return v; }
    let doc: *u8 = { rt::msg_id(v, rt::sel(#str_ptr("documentView\0"))) };
    if is_null(doc) { return v; }
    if is_kind(doc, #str_ptr("NSTextView\0")) { return doc; }
    return v;
}

// Map an AppKit view to the curated agent-core role vocabulary by native type.
// Fallback only — preferred path is a declared affordance (set_affordance /
// facet set_identity). NSTextField splits on editability; table/outline views
// are Lists; everything else (plain views, stacks, scroll views) is Group.
fn classify(view: *u8) -> identity::Role {
    // Before the type checks: a text area presents as its scroller, and a
    // scroller answers Group. The agent was told a writable field was scenery.
    if text_target(view) != view { return identity::Role::Input; }
    if is_kind(view, #str_ptr("NSButton\0")) {
        return identity::Role::Button;
    }
    if is_kind(view, #str_ptr("NSTextField\0")) {
        if rt::msg_i8(view, rt::sel(#str_ptr("isEditable\0"))) != (0 as i8) {
            return identity::Role::Input;
        }
        return identity::Role::Text;
    }
    if is_kind(view, #str_ptr("NSTextView\0")) {
        return identity::Role::Input;
    }
    if is_kind(view, #str_ptr("NSTableView\0")) || is_kind(view, #str_ptr("NSOutlineView\0")) {
        return identity::Role::List;
    }
    return identity::Role::Group;
}

// Role used by the walk: declared affordance wins; native classify is the
// fallback for hand-built widgets that never called set_affordance.
fn resolve_role(view: *u8) -> identity::Role {
    return match get_declared_role(view) {
        option::Option[identity::Role]::Some(r) => r,
        option::Option[identity::Role]::None => classify(view),
    };
}

// The live text a node carries: a window's title, a button's title, a text
// field's string value, a text view's string. Roles without inherent text
// return "". Every selector is respondsToSelector-guarded: a declared role
// (e.g. Button on a plain clickable NSView) must not raise when the native
// class does not answer the role's usual getter.
fn node_text(view: *u8, role: identity::Role) -> text::Text {
    if identity::role_eq(role, identity::Role::Window) {
        if responds_to(view, #str_ptr("title\0")) {
            let wt: *u8 = rt::msg_id(view, rt::sel(#str_ptr("title\0")));
            if !is_null(wt) {
                return bridge::to_text(wt);
            }
        }
        return text::from_str("");
    }
    if identity::role_eq(role, identity::Role::Button) {
        if responds_to(view, #str_ptr("title\0")) {
            let t: *u8 = rt::msg_id(view, rt::sel(#str_ptr("title\0")));
            if !is_null(t) {
                return bridge::to_text(t);
            }
        }
        return text::from_str("");
    }
    if identity::role_eq(role, identity::Role::Text) || identity::role_eq(role, identity::Role::Input) {
        // Same door as the write: a text area answers through its scroll view,
        // and the text is one level down.
        let view: *u8 = text_target(view);
        // NSTextView's content is `string`; NSTextField's is `stringValue`.
        // Prefer the selector the view actually answers (declared Input on a
        // non-text view yields "").
        if is_kind(view, #str_ptr("NSTextView\0")) || responds_to(view, #str_ptr("string\0")) {
            if responds_to(view, #str_ptr("string\0")) {
                let s: *u8 = rt::msg_id(view, rt::sel(#str_ptr("string\0")));
                if !is_null(s) {
                    return bridge::to_text(s);
                }
            }
        }
        if responds_to(view, #str_ptr("stringValue\0")) {
            let s: *u8 = rt::msg_id(view, rt::sel(#str_ptr("stringValue\0")));
            if !is_null(s) {
                return bridge::to_text(s);
            }
        }
    }
    return text::from_str("");
}

fn class_name_text(view: *u8) -> text::Text {
    let c: *u8 = rt::class_name(view);
    if is_null(c) {
        return text::from_str("");
    }
    let view_str: str = { #str_from_raw_parts(c, c_strlen(c)) };
    return text::from_str(view_str);
}

// Length of a NUL-terminated C string (the class name from object_getClassName).
fn c_strlen(p: *u8) -> usize {
    var n: usize = 0 as usize;
    loop {
        let b: u8 = { *(p + n) };
        if b == (0 as u8) {
            break;
        }
        n = n +% (1 as usize);
    }
    return n;
}

// Live enabled state. NSControl responds to `isEnabled`; plain NSView / NSWindow
// do not — sending it would raise "unrecognized selector", so guard with
// `respondsToSelector:` and treat non-controls as enabled.
fn live_enabled(view: *u8) -> bool {
    if responds_to(view, #str_ptr("isEnabled\0")) {
        return rt::msg_i8(view, rt::sel(#str_ptr("isEnabled\0"))) != (0 as i8);
    }
    return true;
}

// Live hidden state. Views respond to `isHidden`; NSWindow does not (it has
// `isVisible`), so guard.
fn live_hidden(view: *u8) -> bool {
    if responds_to(view, #str_ptr("isHidden\0")) {
        return rt::msg_i8(view, rt::sel(#str_ptr("isHidden\0"))) != (0 as i8);
    }
    if responds_to(view, #str_ptr("isVisible\0")) {
        return rt::msg_i8(view, rt::sel(#str_ptr("isVisible\0"))) == (0 as i8);
    }
    return false;
}

// ---- notification -> verb translation ---------------------------------------

// Map an AppKit notification name to the curated agent-core `Verb`, or None if
// it isn't one the agent surface reports. The app installs the actual observers
// (NSNotificationCenter / target-action / delegate methods are closure-free C
// callbacks reaching app-global state, so observer *installation* is app policy,
// not the library's); this is the semantic translation those callbacks use, and
// `Surface::emit` is how a translated event reaches a subscriber. Verbs come
// from the W3C-a11y / AppKit-AX channels (plan.agent-core.md §7.2).
fn verb_for_notification(name: str) -> option::Option[events::Verb] {
    if name == "NSControlTextDidChangeNotification" {
        return option::Option[events::Verb]::Some(events::Verb::Changed);
    }
    if name == "NSControlTextDidEndEditingNotification" {
        return option::Option[events::Verb]::Some(events::Verb::Submitted);
    }
    if name == "NSTableViewSelectionDidChangeNotification" {
        return option::Option[events::Verb]::Some(events::Verb::Selected);
    }
    if name == "NSPopUpButtonWillPopUpNotification" {
        return option::Option[events::Verb]::Some(events::Verb::Opened);
    }
    if name == "NSWindowDidBecomeKeyNotification" {
        return option::Option[events::Verb]::Some(events::Verb::WindowOpened);
    }
    if name == "NSWindowWillCloseNotification" {
        return option::Option[events::Verb]::Some(events::Verb::WindowClosed);
    }
    return option::Option[events::Verb]::None;
}

// ---- subview iteration ------------------------------------------------------

fn subview_count(view: *u8) -> usize {
    let arr: *u8 = rt::msg_id(view, rt::sel(#str_ptr("subviews\0")));
    if is_null(arr) {
        return 0 as usize;
    }
    let n: i64 = rt::msg_i64(arr, rt::sel(#str_ptr("count\0")));
    return n as usize;
}

fn subview_at(view: *u8, i: usize) -> *u8 {
    let arr: *u8 = rt::msg_id(view, rt::sel(#str_ptr("subviews\0")));
    return rt::msg_id_u64(arr, rt::sel(#str_ptr("objectAtIndex:\0")), i as u64);
}

// ---- the Surface ------------------------------------------------------------

// A RETAINED NSView wrapped as a nominal type. `opaque` marks the pointer
// unaccounted-by-design; the retain/release pairing lives in `open`/`walk` and
// `Surface::drop`.
//
// The wrapper is NOT a workaround. `Vec[*u8]` compiles today — stdlib/pty.cplus
// and process.cplus both use it — and the "unknown type <raw-ptr>" monomorphizer
// bug this once cited was fixed 2026-07-08. `ViewRef` stays because `opaque`
// states something a bare `*u8` element cannot: these pointers carry a refcount
// this module owns.
// ---- controls that are more than one affordance ------------------------------
//
// `walk` descends `subviews`, and some AppKit controls hold sub-controls that
// are CELLS rather than views. NSSearchField is the sharp case: typing into it
// is one third of what it does, and the magnifier and the cancel glyph — the
// other two — are NSButtonCells on its NSSearchFieldCell. A subview walk sees
// the field and nothing in it, so an agent could type a query and then had no
// way to run it or clear it.
//
// They are exposed as synthetic children of the field. A `ViewRef` therefore
// names a view AND WHICH PART of it: `PART_SELF` is the view itself, any other
// part is a sub-control driven THROUGH its owner. Nothing about the alignment
// changes — a synthetic child is one `add_child` and one `views.append`, like
// every other node.
//
// The same shape fits a stepper's two arrows or a date picker's segments: a new
// part id and a case in `click_part`.
const PART_SELF: u32 = 0u32;
const PART_SEARCH: u32 = 1u32;
const PART_CLEAR: u32 = 2u32;

struct ViewRef {
    opaque p: *u8,
    part: u32,
}

// The live surface of one window: the identity tree, the NodeId->NSView map
// (index 0 is the synthetic app root, mapped to null), and the text-version
// state for optimistic-concurrency edits.
//
// The map RETAINS every view (released in `drop`). A UI update that replaces
// widgets (e.g. an MVU re-render) therefore cannot leave the map dangling:
// replaced views live on, detached from their window, and the write paths
// report `Stale` for them instead of touching dead UI. Re-open the surface
// after events to pick up the fresh tree.
struct Surface {
    reg: identity::Registry,
    versions: surface::TextVersions,
    views: vec::Vec[ViewRef],
}

// Whether a mapped view left the live UI: still alive (retained above), but
// no longer attached to any window — acting on it would be invisible to the
// user. Nodes that don't respond to `window` (the NSWindow root itself) are
// never stale.
fn is_detached(view: *u8) -> bool {
    if is_null(view) {
        return true;
    }
    if !responds_to(view, #str_ptr("window\0")) {
        return false;
    }
    return is_null(rt::msg_id(view, rt::sel(#str_ptr("window\0"))));
}

// Read an NSString-valued accessibility property ("accessibilityLabel\0",
// "accessibilityHelp\0") off a view; empty Text when absent/unanswered.
fn view_a11y_string(view: *u8, prop: str) -> text::Text {
    if !responds_to(view, #str_ptr(prop)) { return text::new(); }
    let v: *u8 = rt::msg_id(view, rt::sel(#str_ptr(prop)));
    if is_null(v) { return text::new(); }
    return bridge::to_text(v);
}

// Recursively register a view subtree: classify the view, add it to the
// identity tree (a pinned agent-id becomes the developer id, which also exposes
// the node), reflect its live enabled state, map NodeId->view, then recurse into
// Drive a sub-control the walk exposed as a part of its owner.
//
// Both go through the OWNER, not the cell. A cell's click is
// `performClickWithFrame:inView:`, which needs the frame the field lays it out
// in, and neither cell carries the application's handler anyway — the field
// does. So each part does what the glyph does, by the shortest honest route:
//
//   SEARCH  the field's own action, which is exactly what Return reaches, so
//           `on_submit` fires the same way it does for a person.
//   CLEAR   empty the text and tell the app, which is what the cancel glyph
//           does. Through the same two notifications `set_text` uses, so the
//           props, the view and the app stay in step — emptying the field
//           behind them is the desync that made `set_text` a bug once already.
fn click_part(v: *u8, part: u32) -> surface::Outcome {
    if part == PART_SEARCH {
        ensure_send_action_method();
        perform_on_main(v, rt::sel(#str_ptr("cplusAgentSendAction:\0")), null());
        return surface::Outcome::Allowed;
    }
    if part == PART_CLEAR {
        perform_on_main(v, rt::sel(#str_ptr("setStringValue:\0")), bridge::nsstring(""));
        notify_text_changed_on_main(v);
        // The cancel glyph also RUNS the (now empty) search — that is what
        // makes it a clear rather than a select-all-and-delete.
        ensure_send_action_method();
        perform_on_main(v, rt::sel(#str_ptr("cplusAgentSendAction:\0")), null());
        return surface::Outcome::Allowed;
    }
    return surface::Outcome::NotActionable;
}

// One sub-control of `owner`, exposed as its own addressable node. The id is
// the owner's with a suffix, so `search` gains `search:search` and
// `search:clear` — predictable beats opaque, the same rule the tree rows follow.
//
// It is a Button because that is what it is to an agent: a thing you click. The
// `views` entry points at the OWNER, tagged with the part, because that is what
// the click has to be sent through.
fn add_part(ref reg: identity::Registry, ref views: vec::Vec[ViewRef],
            owner: *u8, parent: usize, base: str, part: u32,
            suffix: str, name: str) {
    let id: text::Text = text::from_str(base).appending(suffix);
    let child: usize = reg.add_child(parent, option::Option[str]::Some({ id.view() }),
                                     identity::Role::Button);
    reg.set_enabled(child, live_enabled(owner));
    reg.set_name(child, name);
    let _r: *u8 = rt::retain(owner);
    views.append(ViewRef { p: owner, part: part });
    return;
}

// its subviews in order (DFS pre-order). `views` stays index-aligned with the
// registry: every `add_child` is paired with exactly one `views.push`. Recursion
// depth is the view-tree depth (shallow in practice).
fn walk(ref reg: identity::Registry, ref views: vec::Vec[ViewRef], view: *u8, parent_reg: usize) {
    let role: identity::Role = resolve_role(view);
    let pinned: option::Option[text::Text] = get_agent_id(view);
    let reg_node: usize = match pinned {
        option::Option[text::Text]::Some(t) => {
            reg.add_child(parent_reg, option::Option[str]::Some({ t }), role)
        }
        option::Option[text::Text]::None => {
            reg.add_child(parent_reg, option::Option[str]::None, role)
        }
    };
    reg.set_enabled(reg_node, live_enabled(view));
    // The agent-facing NAME: the accessibility label when the dev set one
    // (facet .accessibility_label — the override channel, essential for
    // icon-only controls), else the widget's own title/text. The exposed
    // describe is the agent's tool list; a tool needs a human name.
    var nm: text::Text = view_a11y_string(view, "accessibilityLabel\0");
    if nm.is_empty() { nm = node_text(view, role); }
    if nm.is_empty() == false { reg.set_name(reg_node, { nm.view() }); }
    // The intent DESCRIPTION rides the accessibility help/hint channel
    // (facet .accessibility_hint) — dev-authored, no widget fallback.
    let ds: text::Text = view_a11y_string(view, "accessibilityHelp\0");
    if ds.is_empty() == false { reg.set_description(reg_node, { ds.view() }); }
    // Declared drive_none (labels, groups, windows) → observe-only so the
    // agent may read but never act. Only when an affordance was recorded —
    // hand-built widgets without set_affordance keep the previous default.
    match get_declared_drive(view) {
        option::Option[u32]::Some(d) => {
            if d == identity::drive_none() {
                reg.set_observe_only(reg_node);
            }
        }
        option::Option[u32]::None => { }
    }
    let _r: *u8 = rt::retain(view);
    views.append(ViewRef { p: view, part: PART_SELF });

    // The parts a subview walk cannot reach. Only for a field the developer
    // tagged: exposure is opt-in, and a sub-control of an unexposed control has
    // no address worth handing out either.
    if is_kind(view, #str_ptr("NSSearchField\0")) {
        match get_agent_id(view) {
            option::Option[text::Text]::Some(base) => {
                add_part(reg, views, view, reg_node, { base.view() }, PART_SEARCH,
                         ":search", "Search");
                add_part(reg, views, view, reg_node, { base.view() }, PART_CLEAR,
                         ":clear", "Clear");
            }
            option::Option[text::Text]::None => { }
        }
    }

    let n: usize = subview_count(view);
    var i: usize = 0 as usize;
    while i < n {
        walk(reg, views, subview_at(view, i), reg_node);
        i = i +% (1 as usize);
    }
    return;
}

// Walk a window's view hierarchy into a `Surface`. The window is the root node
// (role Window) under the registry's app root; its contentView subtree follows.
fn open(window: *u8) -> Surface {
    var reg: identity::Registry = identity::new();
    var views: vec::Vec[ViewRef] = vec::new::[ViewRef]();
    // NodeId 0 is the synthetic app root — no backing view.
    views.append(ViewRef { p: null(), part: PART_SELF });

    if is_null(window) {
        return Surface { reg: reg, versions: surface::new_text_versions(), views: views };
    }

    let win_pinned: option::Option[text::Text] = get_agent_id(window);
    let win_reg: usize = match win_pinned {
        option::Option[text::Text]::Some(t) => {
            reg.add_child(reg.root(), option::Option[str]::Some({ t }), identity::Role::Window)
        }
        option::Option[text::Text]::None => {
            reg.add_child(reg.root(), option::Option[str]::None, identity::Role::Window)
        }
    };
    let _rw: *u8 = rt::retain(window);
    views.append(ViewRef { p: window, part: PART_SELF });

    let content: *u8 = rt::msg_id(window, rt::sel(#str_ptr("contentView\0")));
    if !is_null(content) {
        walk(reg, views, content, win_reg);
    }

    // Title-bar accessory views (fak::install_titlebar) are siblings of the
    // contentView under NSThemeFrame, so the walk above never reaches them.
    // Walk each accessory controller's view under the window node too, so
    // title-bar controls — which pin their agent ids at mount — stay
    // agent-addressable (describe_ui / drive), not silently dropped.
    let accs: *u8 = rt::msg_id(window, rt::sel(#str_ptr("titlebarAccessoryViewControllers\0")));
    if !is_null(accs) {
        let na: i64 = rt::msg_i64(accs, rt::sel(#str_ptr("count\0")));
        var ai: i64 = 0 as i64;
        while ai < na {
            let vc: *u8 = rt::msg_id_u64(accs, rt::sel(#str_ptr("objectAtIndex:\0")), ai as u64);
            let av: *u8 = rt::msg_id(vc, rt::sel(#str_ptr("view\0")));
            if !is_null(av) {
                walk(reg, views, av, win_reg);
            }
            ai = ai +% (1 as i64);
        }
    }

    return Surface { reg: reg, versions: surface::new_text_versions(), views: views };
}

// Convenience: the read-only snapshot of a window in one call.
fn describe(window: *u8) -> vec::Vec[AppKitNode] {
    let s: Surface = open(window);
    return s.describe();
}

impl Surface {
    // Balance the per-view retains taken by `open`/`walk` (index 0 is the
    // synthetic app root, mapped to null — skipped).
    fn drop(ref this) {
        var i: usize = 0 as usize;
        let n: usize = this.views.count();
        while i < n {
            match this.views.at_ptr(i) {
                option::Option[*ViewRef]::Some(r) => {
                    let p: *u8 = { (*r).p };
                    if !is_null(p) {
                        rt::release(p);
                    }
                }
                option::Option[*ViewRef]::None => {}
            }
            i = i +% (1 as usize);
        }
        return;
    }

    fn view_of(this, node: usize) -> *u8 {
        return match this.views.at_ptr(node) {
            option::Option[*ViewRef]::Some(r) => { (*r).p },
            option::Option[*ViewRef]::None => null(),
        };
    }

    // Which part of that view the node means. `PART_SELF` for every node the
    // walk found as a view of its own.
    fn part_of(this, node: usize) -> u32 {
        return match this.views.at_ptr(node) {
            option::Option[*ViewRef]::Some(r) => { (*r).part },
            option::Option[*ViewRef]::None => PART_SELF,
        };
    }

    // Live describe_ui snapshot. Reads each node's current frame / hidden / text
    // from its view, so it reflects state *now* (e.g. after a `set_text`). The
    // synthetic app root (NodeId 0) is omitted; snapshot index = NodeId - 1.
    fn describe(this) -> vec::Vec[AppKitNode] {
        var out: vec::Vec[AppKitNode] = vec::new::[AppKitNode]();
        let total: usize = this.reg.count();
        var node: usize = 1 as usize;
        while node < total {
            let view: *u8 = this.view_of(node);
            let role: identity::Role = this.reg.role_of(node);
            let parent: option::Option[usize] = match this.reg.parent_of(node) {
                option::Option[usize]::Some(p) => {
                    if p == (0 as usize) {
                        option::Option[usize]::None
                    } else {
                        option::Option[usize]::Some(p -% (1 as usize))
                    }
                }
                option::Option[usize]::None => option::Option[usize]::None,
            };
            out.append(AppKitNode {
                id: text::from_str(this.reg.resolved_id(node)),
                role: role,
                class_name: class_name_text(view),
                frame: rt::msg_rect(view, rt::sel(#str_ptr("frame\0"))),
                is_hidden: live_hidden(view),
                text: node_text(view, role),
                // The walk already read the accessibility label into the
                // registry's name (falling back to the widget's own title), so
                // the full view reports the same name the curated one does —
                // it was simply never carried across. A card whose title lives
                // in a grandchild, and every icon button, say nothing without
                // it.
                name: text::from_str(this.reg.name_of(node)),
                actionable: this.reg.is_exposed(node) && this.reg.is_agent_actionable(node),
                clickable: view_clickable(view, this.part_of(node)),
                parent: parent,
            });
            node = node +% (1 as usize);
        }
        return out;
    }

    // READ: Auto Layout health per node. For each non-root node, reports whether
    // the view opts into constraints and whether its layout is ambiguous
    // (under-constrained). Pure reads via the ObjC runtime — no mutation, so no
    // authorization gate beyond being in the tree. Same node ordering as
    // `describe` (snapshot index = NodeId - 1). Useful to an agent diagnosing a
    // UI it just built, or to a developer, without a screenshot.
    fn layout_diagnostics(this) -> vec::Vec[LayoutDiagnostic] {
        var out: vec::Vec[LayoutDiagnostic] = vec::new::[LayoutDiagnostic]();
        let total: usize = this.reg.count();
        var node: usize = 1 as usize;
        while node < total {
            let view: *u8 = this.view_of(node);
            // Both selectors are NSView-only — the tree also carries the
            // NSWindow root node, which doesn't respond to them — so guard each
            // with `respondsToSelector:` and report false for non-view nodes.
            // `translatesAutoresizingMaskIntoConstraints == NO` => the view is
            // driven by constraints (opted into Auto Layout).
            let translates: bool =
                if responds_to(view, #str_ptr("translatesAutoresizingMaskIntoConstraints\0")) {
                    rt::msg_i8(view, rt::sel(#str_ptr("translatesAutoresizingMaskIntoConstraints\0")))
                        != (0 as i8)
                } else {
                    true
                };
            let ambiguous: bool = if responds_to(view, #str_ptr("hasAmbiguousLayout\0")) {
                rt::msg_i8(view, rt::sel(#str_ptr("hasAmbiguousLayout\0"))) != (0 as i8)
            } else {
                false
            };
            out.append(LayoutDiagnostic {
                id: text::from_str(this.reg.resolved_id(node)),
                class_name: class_name_text(view),
                uses_autolayout: !translates,
                has_ambiguous_layout: ambiguous,
            });
            node = node +% (1 as usize);
        }
        return out;
    }

    // EVENTS: translate a fired widget into an agent event. Resolves the source
    // agent-id to its NodeId and offers `{ source, verb }` to the subscriber
    // (which applies its own subtree/verb/role filter + backpressure). Returns
    // false if the id is unknown. The app's closure-free notification/action
    // callback calls this with the verb from `verb_for_notification` (or a
    // direct one, e.g. `Clicked` for a target-action). Events bubble: a
    // subscriber on an ancestor sees descendant events.
    fn emit(this, ref sub: events::Subscriber, source_id: str, verb: events::Verb) -> bool {
        match this.reg.lookup(source_id) {
            option::Option[usize]::Some(node) => {
                sub.offer({ #addr_of(this.reg) }, events::event(node, verb));
                return true;
            }
            option::Option[usize]::None => {}
        }
        return false;
    }

    // The current text version of a node (for optimistic-concurrency edits).
    // 0 if the id is unknown or never edited.
    fn text_version(this, id: str) -> u64 {
        return match this.reg.lookup(id) {
            option::Option[usize]::Some(n) => this.versions.version_of(n),
            option::Option[usize]::None => 0 as u64,
        };
    }

    // WRITE: click a control. Authorized via the core (exposed + actionable);
    // on `Allowed`, sends `performClick:` to the backing view. A view that
    // left the live UI since `open` (re-render, removal) reports `Stale`.
    fn click(this, id: str) -> surface::Outcome {
        match this.reg.lookup(id) {
            option::Option[usize]::Some(node) => {
                let oc: surface::Outcome = surface::authorize_action(this.reg, node);
                if !surface::outcome_eq(oc, surface::Outcome::Allowed) {
                    return oc;
                }
                let v: *u8 = this.view_of(node);
                if is_detached(v) {
                    return surface::Outcome::Stale;
                }
                // A PART is driven through its owner, and must be answered
                // before the drive check below: a search field's parts share
                // its view, and the field declares drive_text, so the check
                // would refuse a click on a button that is genuinely a button.
                let part: u32 = this.part_of(node);
                if part != PART_SELF {
                    return click_part(v, part);
                }
                // Declared drive must be click when present (inputs are
                // drive_text — refuse click rather than no-op on the field).
                match get_declared_drive(v) {
                    option::Option[u32]::Some(d) => {
                        if d != identity::drive_click() {
                            return surface::Outcome::NotActionable;
                        }
                    }
                    option::Option[u32]::None => { }
                }
                // `performClick:` only lands on a view that answers it — NSControls,
                // and facet clickable/actionable views (which implement it to fire
                // their primary click handler, so a tagged whole-row clickable is
                // agent-openable). A plain gesture-only view does NOT respond; the
                // previous unguarded send raised an unrecognized-selector exception.
                // Guard it and report `NotActionable` rather than crashing.
                if !responds_to(v, #str_ptr("performClick:\0")) {
                    // A row cell inside a table/outline: the agent's click IS
                    // the user's row selection — select it, let the widget's
                    // selection delegate fire (ui::tree's on_select).
                    if select_row_of(v) {
                        return surface::Outcome::Allowed;
                    }
                    return surface::Outcome::NotActionable;
                }
                perform_on_main(v, rt::sel(#str_ptr("performClick:\0")), null());
                return surface::Outcome::Allowed;
            }
            option::Option[usize]::None => {}
        }
        return surface::Outcome::NotFound;
    }

    // READ: is this node what a pointer at its own centre would reach? Gated as
    // a read (exposure, not the affordance ceiling) — asking whether an
    // observe-only node is covered is a fair question, and this cannot act on
    // it either way.
    //
    // The verb exists because `click` above cannot answer it: it sends
    // `performClick:` straight to the view, so it succeeds identically whether
    // the control is in front of the user or buried under an overlay. That
    // blindness cost a release once — a single human click on a `.draggable()`
    // box double-released an NSDraggingItem, and 105 scripted cycles could not
    // reproduce it because `click` never enters the path that crashes.
    fn hit_test(this, id: str) -> surface::HitTest {
        match this.reg.lookup(id) {
            option::Option[usize]::Some(node) => {
                let oc: surface::Outcome = surface::authorize_read(this.reg, node);
                if !surface::outcome_eq(oc, surface::Outcome::Allowed) {
                    return surface::hit_test_refused(oc, true);
                }
                let v: *u8 = this.view_of(node);
                if is_detached(v) {
                    return surface::hit_test_refused(surface::Outcome::Stale, true);
                }
                let hit: *u8 = view_at_center_of(v);
                if is_null(hit) {
                    // Nothing at all is there: zero-sized, or clipped away by an
                    // ancestor. Not reachable, and not covered BY anything.
                    return surface::hit_test_refused(surface::Outcome::Allowed, true);
                }
                if is_at_or_inside(hit, v) {
                    return surface::HitTest {
                        outcome: surface::Outcome::Allowed, supported: true,
                        reachable: true, covered: false, covered_by: text::new(),
                    };
                }
                // Covered. Name the obstruction only if it is itself exposed —
                // otherwise the fact is reported and the identity is not.
                return surface::HitTest {
                    outcome: surface::Outcome::Allowed, supported: true,
                    reachable: false, covered: true, covered_by: this.exposed_id_at_or_above(hit),
                };
            }
            option::Option[usize]::None => {}
        }
        return surface::hit_test_refused(surface::Outcome::NotFound, true);
    }

    // The id of the nearest EXPOSED node at or above `v`, or "". Walks up
    // because the view actually hit is often an untagged inner view of the
    // thing a person would name.
    fn exposed_id_at_or_above(this, v: *u8) -> text::Text {
        var cur: *u8 = v;
        while !is_null(cur) {
            let total: usize = this.reg.count();
            var node: usize = 1 as usize;
            while node < total {
                if this.view_of(node) == cur && this.reg.is_exposed(node) {
                    return text::from_str(this.reg.id_view(node));
                }
                node = node +% (1 as usize);
            }
            cur = rt::msg_id(cur, rt::sel(#str_ptr("superview\0")));
        }
        return text::new();
    }

    // WRITE: set a field's text with optimistic concurrency. `base_version` is
    // the version the agent last read (`text_version`); a racing edit yields
    // `VersionConflict`. On `Allowed`, sends the class-appropriate setter then
    // bumps.
    fn set_text(ref this, id: str, value: str, base_version: u64) -> surface::Outcome {
        match this.reg.lookup(id) {
            option::Option[usize]::Some(node) => {
                let oc: surface::Outcome =
                    surface::authorize_text_write(this.reg, this.versions, node, base_version);
                if !surface::outcome_eq(oc, surface::Outcome::Allowed) {
                    return oc;
                }
                let v: *u8 = this.view_of(node);
                if is_detached(v) {
                    return surface::Outcome::Stale;
                }
                // Declared drive must be text when present (buttons are
                // drive_click — refuse set_text rather than silently no-op).
                match get_declared_drive(v) {
                    option::Option[u32]::Some(d) => {
                        if d != identity::drive_text() {
                            return surface::Outcome::NotActionable;
                        }
                    }
                    option::Option[u32]::None => { }
                }
                let ns: *u8 = bridge::nsstring(value);
                // A text area's node is backed by its SCROLL VIEW; the text
                // lives one level down. Resolve first, then branch — NSTextView
                // sets its content via `setString:`, NSControl via
                // `setStringValue:` (which a scroll view silently ignores).
                let tv: *u8 = text_target(v);
                let sel_name: *u8 = if is_kind(tv, #str_ptr("NSTextView\0")) {
                    #str_ptr("setString:\0")
                } else {
                    #str_ptr("setStringValue:\0")
                };
                perform_on_main(tv, rt::sel(sel_name), ns);
                // ...and tell the app, for controls whose contract is "you are
                // told when I change". `click` fires the handler it authorizes;
                // without this, `set_text` was the one verb that drove a control
                // behind the app's back.
                notify_value_changed_on_main(tv);
                notify_text_changed_on_main(tv);
                this.versions.bump(node);
                return surface::Outcome::Allowed;
            }
            option::Option[usize]::None => {}
        }
        return surface::Outcome::NotFound;
    }

    // READ/NAV: scroll a node's bounds into view. Authorized via `authorize_read`
    // (exposure required; the affordance ceiling does not apply to navigation).
    fn scroll_to(this, id: str) -> surface::Outcome {
        match this.reg.lookup(id) {
            option::Option[usize]::Some(node) => {
                let oc: surface::Outcome = surface::authorize_read(this.reg, node);
                if !surface::outcome_eq(oc, surface::Outcome::Allowed) {
                    return oc;
                }
                if is_detached(this.view_of(node)) {
                    return surface::Outcome::Stale;
                }
                scroll_visible_on_main(this.view_of(node));
                return surface::Outcome::Allowed;
            }
            option::Option[usize]::None => {}
        }
        return surface::Outcome::NotFound;
    }
}

// ---- MCP backend vtable -----------------------------------------------------
//
// The backend-neutral `agent_core::backend::Backend` that lets the
// backend-agnostic `agent_mcp` bridge drive an AppKit `Surface`. Each fn casts
// the type-erased `*u8` back to `*Surface` and calls the real method (C+ has no
// generic method dispatch on user types — a fn-pointer vtable is how runtime
// polymorphism is done; calling the mutating `set_text` through the erased
// pointer relies on the raw-pointer-deref-is-a-writable-place rule).

// Clone a borrowed `Text` field (via its `str` view) into a fresh owned `Text`.
fn ctext(s: str) -> text::Text {
    return text::from_str(s);
}

// describe → the neutral node list. Converts AppKit's f64 `rt::Rect` frame to
// the neutral `Rect`, reading each owned node through a pointer and cloning its
// `Text`s (never moving them out of the Vec, which would double-free).
fn mcp_describe(p: *u8) -> vec::Vec[mcpb::UiNode] {
    refresh_surface(p);
    let s: *Surface = { p as *Surface };
    let local: vec::Vec[AppKitNode] = (*s).describe();
    var out: vec::Vec[mcpb::UiNode] = vec::new::[mcpb::UiNode]();
    var i: usize = 0 as usize;
    while i < local.count() {
        match local.at_ptr(i) {
            option::Option[*AppKitNode]::Some(n) => {
                out.append(mcpb::UiNode {
                    id: ctext((*n).id.view()),
                    role: { (*n).role },
                    class_name: ctext((*n).class_name.view()),
                    frame: mcpb::Rect {
                        x: { (*n).frame.x },
                        y: { (*n).frame.y },
                        w: { (*n).frame.w },
                        h: { (*n).frame.h },
                    },
                    is_hidden: { (*n).is_hidden },
                    text: ctext((*n).text.view()),
                    name: ctext((*n).name.view()),
                    description: text::new(),
                    actionable: { (*n).actionable },
                    clickable: { (*n).clickable },
                    parent: { (*n).parent },
                });
            }
            option::Option[*AppKitNode]::None => {}
        }
        i = i +% (1 as usize);
    }
    return out;
}

fn mcp_click(p: *u8, id: str) -> surface::Outcome {
    refresh_surface(p);
    let s: *Surface = { p as *Surface };
    return (*s).click(id);
}

fn mcp_set_text(p: *u8, id: str, value: str, base: u64) -> surface::Outcome {
    refresh_surface(p);
    let s: *Surface = { p as *Surface };
    return (*s).set_text(id, value, base);
}

// AppKit's navigate is scroll-into-view (Win32/GTK focus instead).
fn mcp_navigate(p: *u8, id: str) -> surface::Outcome {
    refresh_surface(p);
    let s: *Surface = { p as *Surface };
    return (*s).scroll_to(id);
}

// Refreshes first like every other verb: "is this covered" is a question about
// the tree as it is NOW, and a stale snapshot would answer about the old one.
fn mcp_hit_test(p: *u8, id: str) -> surface::HitTest {
    refresh_surface(p);
    let s: *Surface = { p as *Surface };
    return (*s).hit_test(id);
}

// The vtable agent_mcp drives an AppKit surface through. Pass the surface as
// `{ #addr_of(surf) as *u8 }` alongside this to `agent_mcp::serve_uds` / etc.

// ---- lazy surface refresh ---------------------------------------------------
// The surface is a SNAPSHOT (registry + retained views) — and the app's tree
// is dynamic in ways no hook can enumerate (facet verbs, @ui-native
// mutations, async fills). So the surface re-walks itself ON REQUEST: every
// MCP operation refreshes from the window it was opened on before acting.
// Describe/click/set_text therefore always see the tree as it is NOW; a view
// that has not mounted yet is simply absent, and the agent asks again later.
// The walk must run on the main thread (AppKit); off-main callers hop with
// the registered-method trick scroll_visible_on_main uses, waitUntilDone so
// the request proceeds against the fresh registry. The serve loop handles
// one connection at a time, so the static handoff has a single writer.

static REFRESH_TARGET: *u8 = #zero::[*u8]();
static REFRESH_METHOD_REGISTERED: bool = false;

// Re-walk in place: drop the old registry + view retains, install a fresh
// walk of the same window. TextVersions restart (they key on NodeIds, which
// renumber with the walk); optimistic edits re-read after a refresh anyway.
//
// `keeps(nothing)` because a `Surface` is self-referential, not borrowing:
// its `index` is keyed by views into its own `ids`, so the whole thing is
// one allocation's worth of lifetime and nothing a caller owns escapes into
// it. The checker sees a view-carrying value stored through `*Surface` and
// asks (E0516); this is the answer.
#[keeps(nothing)]
fn refresh_in_place(p: *u8) {
    let s: *Surface = { p as *Surface };
    let win: *u8 = { (*s).view_of(1 as usize) };
    if is_null(win) { return; }
    { *s = open(win); }
    return;
}

fn cplus_agent_refresh(receiver: *u8, _cmd: *u8, _arg: *u8) {
    let p: *u8 = REFRESH_TARGET;
    if is_null(p) { return; }
    refresh_in_place(p);
    return;
}

fn ensure_refresh_method() {
    if { REFRESH_METHOD_REGISTERED } {
        return;
    }
    let cls: *u8 = rt::get_class(#str_ptr("NSWindow\0"));
    if !is_null(cls) {
        rt::add_method_action(
            cls,
            rt::sel(#str_ptr("cplusAgentRefresh:\0")),
            cplus_agent_refresh,
            #str_ptr("v@:@\0"),
        );
    }
    { REFRESH_METHOD_REGISTERED = true; }
    return;
}

// ---- row selection (agent click on a table/outline row cell) ---------------
// A row CELL answers no performClick: — selecting it is the table's job:
// selectRowIndexes: on the enclosing NSTableView/NSOutlineView, which posts
// the SelectionDidChange notification, firing the widget's selection delegate
// exactly as a user click would (ui::tree -> on_select). The 2-arg send hops
// to the main thread through a registered method (the refresh pattern).

static SELECT_METHOD_REGISTERED: bool = false;

fn cplus_agent_select_row(table: *u8, _cmd: *u8, idxset: *u8) {
    rt::msg_void_id_i8(table, rt::sel(#str_ptr("selectRowIndexes:byExtendingSelection:\0")), idxset, 0 as i8);
    return;
}

fn ensure_select_method() {
    if { SELECT_METHOD_REGISTERED } {
        return;
    }
    let cls: *u8 = rt::get_class(#str_ptr("NSTableView\0"));
    if !is_null(cls) {
        rt::add_method_action(
            cls,
            rt::sel(#str_ptr("cplusAgentSelectRow:\0")),
            cplus_agent_select_row,
            #str_ptr("v@:@\0"),
        );
    }
    { SELECT_METHOD_REGISTERED = true; }
    return;
}

// The nearest enclosing NSTableView (NSOutlineView included) above `v`, or null.
fn enclosing_table(v: *u8) -> *u8 {
    let table_cls: *u8 = rt::get_class(#str_ptr("NSTableView\0"));
    var cur: *u8 = v;
    while !is_null(cur) {
        if rt::msg_i8_id(cur, rt::sel(#str_ptr("isKindOfClass:\0")), table_cls) != (0 as i8) {
            return cur;
        }
        // `superview` is NSView's, and the tree also carries the NSWindow root
        // — the same node `layout_diagnostics` guards its two selectors for.
        // Sending it raised an unrecognized-selector NSException and killed the
        // process. It was reachable from `click` all along (a window root
        // answers no `performClick:`, so it fell straight through to the row
        // path); asking the question from `describe` is only what made it
        // certain to happen.
        if !responds_to(cur, #str_ptr("superview\0")) {
            return null();
        }
        cur = rt::msg_id(cur, rt::sel(#str_ptr("superview\0")));
    }
    return null();
}

// Toggle an EXPANDABLE outline row: the agent's click on a folder row is
// the disclosure gesture, not a selection — expand (or collapse) it so the
// nested rows materialize, each already carrying its own row_id agent key
// via the cell builder. False when the row is not an expandable outline item.
fn toggle_expand_row(table: *u8, v: *u8) -> bool {
    let ov_cls: *u8 = rt::get_class(#str_ptr("NSOutlineView\0"));
    if rt::msg_i8_id(table, rt::sel(#str_ptr("isKindOfClass:\0")), ov_cls) == (0 as i8) { return false; }
    let row: i64 = rt::msg_i64_id(table, rt::sel(#str_ptr("rowForView:\0")), v);
    if row < (0 as i64) { return false; }
    let item: *u8 = rt::msg_id_i64(table, rt::sel(#str_ptr("itemAtRow:\0")), row);
    if is_null(item) { return false; }
    if rt::msg_i8_id(table, rt::sel(#str_ptr("isExpandable:\0")), item) == (0 as i8) { return false; }
    let expanded: i8 = rt::msg_i8_id(table, rt::sel(#str_ptr("isItemExpanded:\0")), item);
    if expanded != (0 as i8) {
        perform_on_main(table, rt::sel(#str_ptr("collapseItem:\0")), item);
    } else {
        perform_on_main(table, rt::sel(#str_ptr("expandItem:\0")), item);
    }
    return true;
}

// Select the row containing `v`, if a table encloses it. True when selected.
// An expandable outline row toggles instead: click-a-folder = disclosure,
// click-a-file = selection (which fires the widget's on_select).
fn select_row_of(v: *u8) -> bool {
    let table: *u8 = enclosing_table(v);
    if is_null(table) { return false; }
    if toggle_expand_row(table, v) { return true; }
    let row: i64 = rt::msg_i64_id(table, rt::sel(#str_ptr("rowForView:\0")), v);
    if row < (0 as i64) { return false; }
    let idx_cls: *u8 = rt::get_class(#str_ptr("NSIndexSet\0"));
    let idxset: *u8 = rt::msg_id_u64(idx_cls, rt::sel(#str_ptr("indexSetWithIndex:\0")), row as u64);
    if is_null(idxset) { return false; }
    ensure_select_method();
    perform_on_main(table, rt::sel(#str_ptr("cplusAgentSelectRow:\0")), idxset);
    return true;
}

// The READ-ONLY half of `select_row_of`: would a click on `v` reach a row?
// Both of that function's branches require a row — the disclosure toggle asks
// `rowForView:` before it asks whether the item is expandable — so the row
// index alone is the whole condition, and asking for it selects nothing.
fn can_select_row_of(v: *u8) -> bool {
    let table: *u8 = enclosing_table(v);
    if is_null(table) { return false; }
    return rt::msg_i64_id(table, rt::sel(#str_ptr("rowForView:\0")), v) >= (0 as i64);
}

// Would a `click` on this node be DELIVERED? The capability half of the
// permission/capability pair `describe` reports (see backend::UiNode.clickable).
//
// It mirrors `Surface::click`'s own body, branch for branch, and that is the
// point: a flag that predicts a different answer than the verb gives is worse
// than no flag, so the two are written to be read side by side. What it does
// NOT do is any of the things `click` does that are not questions — it never
// sends `performClick:`, never selects a row, and never toggles a disclosure
// triangle. `is_detached` is deliberately not folded in either: staleness is a
// property of the moment, and `describe` has just refreshed the tree.
fn view_clickable(v: *u8, part: u32) -> bool {
    if is_null(v) { return false; }
    // A PART is driven through its owner and answered before the drive check,
    // exactly as in `click`: a search field's parts share its view and the
    // field declares drive_text, so checking the drive first would refuse a
    // button that is genuinely a button.
    if part != PART_SELF { return true; }
    match get_declared_drive(v) {
        option::Option[u32]::Some(d) => {
            if d != identity::drive_click() { return false; }
        }
        option::Option[u32]::None => { }
    }
    if responds_to(v, #str_ptr("performClick:\0")) { return true; }
    return can_select_row_of(v);
}

// ---- pointer reachability ---------------------------------------------------
// AppKit's own hit-testing, asked a question rather than driven. Nothing here
// synthesizes an event.

// The topmost view above `v` — the window's content view when there is one, and
// otherwise the end of the superview chain, so this answers the same question
// for a surface that is mounted but not yet in a window.
fn hit_root_of(v: *u8) -> *u8 {
    var cur: *u8 = v;
    loop {
        let sup: *u8 = rt::msg_id(cur, rt::sel(#str_ptr("superview\0")));
        if is_null(sup) { return cur; }
        cur = sup;
    }
    return cur;
}

// Is `v` `ancestor`, or inside it? A hit on a node's own child still means the
// node is reachable — the pointer got there.
fn is_at_or_inside(v: *u8, ancestor: *u8) -> bool {
    var cur: *u8 = v;
    while !is_null(cur) {
        if cur == ancestor { return true; }
        cur = rt::msg_id(cur, rt::sel(#str_ptr("superview\0")));
    }
    return false;
}

// What the pointer would reach at `v`'s own centre. Null when nothing is there
// — a zero-sized or fully clipped node, which is itself an answer.
fn view_at_center_of(v: *u8) -> *u8 {
    let b: rt::Rect = rt::msg_rect(v, rt::sel(#str_ptr("bounds\0")));
    if b.w <= 0.0 || b.h <= 0.0 { return null(); }
    let center: rt::Point = rt::Point { x: b.x + (b.w / 2.0), y: b.y + (b.h / 2.0) };
    let root: *u8 = hit_root_of(v);
    if is_null(root) { return null(); }
    // `hitTest:` wants the point in the RECEIVER's superview space; converting
    // to `nil` walks the chain to that space whether or not a window exists.
    let p: rt::Point = rt::msg_point_point_id(v, rt::sel(#str_ptr("convertPoint:toView:\0")), center, null());
    return rt::msg_id_point(root, rt::sel(#str_ptr("hitTest:\0")), p);
}

fn refresh_surface(p: *u8) {
    if on_main_thread() {
        refresh_in_place(p);
        return;
    }
    let s: *Surface = { p as *Surface };
    let win: *u8 = { (*s).view_of(1 as usize) };
    if is_null(win) { return; }
    ensure_refresh_method();
    REFRESH_TARGET = p;
    perform_on_main(win, rt::sel(#str_ptr("cplusAgentRefresh:\0")), null());
    REFRESH_TARGET = null();
    return;
}

// The curated describe: identity::Registry.describe() over the wire — only
// developer-EXPOSED nodes, lean fields (id, role, the human name as `text`,
// actionable, parent re-parented to the nearest exposed ancestor). Structural
// auto-keyed chrome is pruned; frames and classes are omitted so the agent's
// context stays small. describe_ui's DEFAULT view ("full" opts into
// mcp_describe above).
fn mcp_describe_exposed(p: *u8) -> vec::Vec[mcpb::UiNode] {
    refresh_surface(p);
    let s: *Surface = { p as *Surface };
    let views: vec::Vec[identity::NodeView] = { (*s).reg.describe() };
    var out: vec::Vec[mcpb::UiNode] = vec::new::[mcpb::UiNode]();
    var i: usize = 0 as usize;
    while i < views.count() {
        match views.at_ptr(i) {
            option::Option[*identity::NodeView]::Some(n) => {
                // `is_hidden` is READ, never assumed. Frames and class names
                // are omitted here on purpose — the default view keeps the
                // agent's context small — but omitting a field and asserting a
                // false one are different things. This said `false` for every
                // node, so the default projection reported a hidden step as on
                // screen while `mode:full` reported it hidden, and an agent
                // could not tell which step it was looking at.
                // The view AND which part of it this node means — `clickable`
                // needs both, for the same reason `click` does.
                var live: *u8 = null();
                var part: u32 = PART_SELF;
                match { (*s).reg.lookup({ (*n).id.view() }) } {
                    option::Option[usize]::Some(idx) => {
                        live = { (*s).view_of(idx) };
                        part = { (*s).part_of(idx) };
                    }
                    option::Option[usize]::None => { }
                }
                out.append(mcpb::UiNode {
                    id: text::from_str({ (*n).id.view() }),
                    role: { (*n).role },
                    class_name: text::new(),
                    frame: mcpb::Rect { x: 0.0f64, y: 0.0f64, w: 0.0f64, h: 0.0f64 },
                    is_hidden: if is_null(live) { false } else { live_hidden(live) },
                    text: text::from_str({ (*n).name.view() }),
                    name: text::from_str({ (*n).name.view() }),
                    description: text::from_str({ (*n).description.view() }),
                    actionable: { (*n).actionable },
                    clickable: view_clickable(live, part),
                    parent: { (*n).parent },
                });
            }
            option::Option[*identity::NodeView]::None => {}
        }
        i = i +% (1 as usize);
    }
    return out;
}

fn mcp_backend() -> mcpb::Backend {
    return mcpb::Backend {
        describe: mcp_describe,
        describe_exposed: mcp_describe_exposed,
        click: mcp_click,
        set_text: mcp_set_text,
        navigate: mcp_navigate,
        hit_test: mcp_hit_test,
    };
}
