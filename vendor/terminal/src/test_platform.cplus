// terminal/test_platform — every test in this suite that is PLATFORM-SHAPED.
//
// Split out of `test_main.cplus`, which is otherwise portable: the screen model
// and the pseudo-terminal are the same code everywhere and their tests run on
// any target. TWO GROUPS ARE NOT.
//
//   * THE WIDGET's — they drive an NSTextView, read back its attributed string
//     and post AppKit notifications. Keeping them in the shared file meant the
//     whole suite named `objc` and `appkit`, and on Linux it did not LINK.
//   * THE LIVE SHELL's — they start `/bin/zsh` and ask it what `$HISTFILE` is.
//     zsh is macOS's default and is installed almost nowhere else, so on Linux
//     they failed at `execl` with the pseudo-terminal reporting hangup. The
//     SHELL is the platform's, and so is the mechanism they check: ZDOTDIR is
//     zsh's, and bash has `--rcfile` instead.
//
// `test_platform_linux.cplus` is the sibling the resolver picks there.
//
// The split is the same one `appkit_linux.cplus` makes for the widget itself,
// and for the same reason: a module that is one platform's half must be
// reachable by a name that resolves per platform.

import "./terminal" as terminal;
import "./pty" as pty;
import "./appkit" as terminal_ui;
import "./widget" as terminal_widget;
import "stdlib/option" as option;
import "stdlib/text" as text;
import "objc/runtime" as rt;
import "objc/bridge" as bridge;
import "appkit/appkit" as ak;

extern fn usleep(us: u32) -> i32;

#[test]
fn the_platform_widget_is_present() {
    assert pty::supported();
    assert terminal_ui::supported();
    assert terminal_widget::supported();
}

// ---- the widget -------------------------------------------------------------

extern fn CFRunLoopRunInMode(mode: *u8, seconds: f64, return_after_source: i8) -> i32;

// Let the main run loop turn so the widget's dispatch read source fires and
// render() actually runs — several times, which is the point.
fn pump(times: i32) {
    let mode: *u8 = terminal_ui::appkit_string_global(#str_ptr("kCFRunLoopDefaultMode\0"));
    var i: i32 = 0 as i32;
    while i < times {
        let _r: i32 = { CFRunLoopRunInMode(mode, 0.05f64, 0 as i8) };
        i = i +% (1 as i32);
    }
    return;
}

#[test]
fn widget_focus_reports_failure_off_screen() {
    // Typing is the primary way to drive a terminal, so `focus` is part of the
    // widget's contract — and its honest answer when the widget is not mounted
    // is FALSE. A window is what holds a first responder; silently returning
    // true would let an app believe its pane was ready to type into.
    match terminal_ui::start() {
        option::Option[terminal_ui::Widget]::Some(w) => {
            assert w.is_running();
            assert !w.focus();
            assert !w.has_focus();
            w.stop();
            assert !w.is_running();
            // Focus stays false on a stopped widget rather than trapping.
            assert !w.focus();
        }
        option::Option[terminal_ui::Widget]::None => { assert false; }
    };
    return;
}

#[test]
fn focus_probe_is_false_without_a_key_window() {
    // What the cursor's shape is keyed on. A null view, and a live-but-unmounted
    // one, both have no window to hold a first responder — so the answer is
    // false and the cursor draws its NOT-focused shape.
    assert terminal_ui::view_has_focus(0 as *u8) == false;
    match terminal_ui::start() {
        option::Option[terminal_ui::Widget]::Some(w) => {
            assert w.has_focus() == false;
            // Rendering must survive the no-window state — it is where every
            // widget starts, and render() paints the cursor on every pass.
            w.send("printf hi\n");
            pump(4 as i32);
            assert w.has_focus() == false;
            w.stop();
        }
        option::Option[terminal_ui::Widget]::None => { assert false; }
    };
    return;
}

// Counter for the completion callback. A `static` because the handler is a
// plain fn pointer with a context argument, which is the shape every native
// callback in this package uses.
static COMMAND_ENDED: i32 = 0;
fn note_command_ended(_ctx: *u8) {
    COMMAND_ENDED = COMMAND_ENDED + 1;
    return;
}

#[test]
fn the_widget_runs_a_command_and_reports_how_it_ended() {
    // The whole point of the API, end to end: an application asks for a command
    // to run and finds out when it finished, what it exited with, and what it
    // printed — without watching the byte stream itself.
    match terminal_ui::start() {
        option::Option[terminal_ui::Widget]::Some(w) => {
            COMMAND_ENDED = 0;
            w.on_command_end(note_command_ended, 0 as *u8);

            var i: i32 = 0 as i32;
            while i < (200 as i32) && !w.has_integration() {
                pump(1 as i32);
                i = i +% (1 as i32);
            }
            assert w.has_integration();
            assert w.command_state() == terminal::CommandState::Idle;
            assert match w.exit_code() {
                option::Option[i32]::Some(_) => false,
                option::Option[i32]::None => true,
            };

            let id: u64 = w.run("printf 'built\\n'; (exit 2)");
            assert id == (1 as u64);

            var j: i32 = 0 as i32;
            while j < (400 as i32) && w.finished_count() == (0 as u64) {
                pump(1 as i32);
                j = j +% (1 as i32);
            }
            assert w.finished_count() == (1 as u64);
            assert w.command_id() == (1 as u64);
            assert match w.exit_code() {
                option::Option[i32]::Some(c) => c == (2 as i32),
                option::Option[i32]::None => false,
            };
            let out: text::Text = w.output();
            assert out.equals("built\n");
            // Fired once, from the read handler, on the main thread.
            assert COMMAND_ENDED == (1 as i32);

            // The pane knows where it is, too.
            let cwd: text::Text = w.cwd();
            assert cwd.has_prefix("/");

            w.stop();
        }
        option::Option[terminal_ui::Widget]::None => { assert false; }
    };
    return;
}

#[test]
fn clear_empties_the_widget_without_disturbing_the_shell() {
    // WHAT A RUN PRESS DOES BEFORE IT SENDS THE BUILD: empty the pane, so that
    // everything in it afterwards belongs to the run the user just asked for.
    // Nothing goes down the pty, which is the half worth testing — the ledger
    // keeps counting and the next command still reports itself, so a caller
    // that cleared is not a caller that lost track of its own build.
    match terminal_ui::start() {
        option::Option[terminal_ui::Widget]::Some(w) => {
            var i: i32 = 0 as i32;
            while i < (200 as i32) && !w.has_integration() {
                pump(1 as i32);
                i = i +% (1 as i32);
            }
            assert w.has_integration();

            let first: u64 = w.run("printf 'old\\n'");
            assert first == (1 as u64);
            var j: i32 = 0 as i32;
            while j < (400 as i32) && w.finished_count() == (0 as u64) {
                pump(1 as i32);
                j = j +% (1 as i32);
            }
            assert w.finished_count() == (1 as u64);
            let before: text::Text = w.text();
            assert before.count() > (0 as usize);

            w.clear();
            assert w.text().count() == (0 as usize);

            // Still the same session, and still the same ledger: the next
            // command gets the NEXT id rather than starting the count again,
            // and it ends where the caller is already listening.
            let second: u64 = w.run("printf 'new\\n'");
            assert second == (2 as u64);
            var k: i32 = 0 as i32;
            while k < (400 as i32) && w.finished_count() < (2 as u64) {
                pump(1 as i32);
                k = k +% (1 as i32);
            }
            assert w.finished_count() == (2 as u64);
            let out: text::Text = w.output();
            assert out.equals("new\n");

            w.stop();
        }
        option::Option[terminal_ui::Widget]::None => { assert false; }
    };
    return;
}

// Counter for the test below. Separate from COMMAND_ENDED so the two tests
// cannot read each other's tally.
static EARLY_ENDED: i32 = 0;
fn note_early_ended(_ctx: *u8) {
    EARLY_ENDED = EARLY_ENDED + 1;
    return;
}

#[test]
fn a_command_sent_before_the_first_prompt_still_reports_its_own_end() {
    // THE CASE EVERY IDE PANE IS: a build starts the moment the pane opens, so
    // the first command is sent before the shell has drawn a prompt and
    // therefore before any mark could have arrived. The test above waits for
    // `has_integration` first, which is precisely the wait a real caller does
    // not do — and the wait that hid this: with the shim installed but not yet
    // heard from, `run` bracketed the command with printf marks of its own,
    // those marks opened a SECOND command on top of the shim's, and the id
    // promised here was never the id that ended. The caller's build finished on
    // screen and its status chip said "Building" for the rest of the session.
    match terminal_ui::start() {
        option::Option[terminal_ui::Widget]::Some(w) => {
            EARLY_ENDED = 0;
            w.on_command_end(note_early_ended, 0 as *u8);

            // No pump: nothing has been read, so no mark has been seen. This is
            // the state a first Run press actually finds.
            assert !w.has_integration();

            let id: u64 = w.run("printf 'early\\n'; (exit 3)");
            assert id == (1 as u64);

            var j: i32 = 0 as i32;
            while j < (400 as i32) && w.finished_count() == (0 as u64) {
                pump(1 as i32);
                j = j +% (1 as i32);
            }

            // The id the caller was promised is the id that ended — the whole
            // contract, and the half that was broken.
            assert w.finished_count() == (1 as u64);
            assert w.command_id() == id;
            assert match w.exit_code() {
                option::Option[i32]::Some(c) => c == (3 as i32),
                option::Option[i32]::None => false,
            };
            assert w.output().equals("early\n");
            assert EARLY_ENDED == (1 as i32);

            // And nothing of ours was typed at the user: the shim marks the
            // command, so the pane holds what a developer would have typed.
            assert !w.text().contains("133;C");

            w.stop();
        }
        option::Option[terminal_ui::Widget]::None => { assert false; }
    };
    return;
}

#[test]
fn the_widget_refuses_to_run_over_a_busy_shell() {
    // The id `run` returns is only a sound promise if nothing else can claim it
    // first, which is why a busy pane is refused rather than queued.
    match terminal_ui::start() {
        option::Option[terminal_ui::Widget]::Some(w) => {
            var i: i32 = 0 as i32;
            while i < (200 as i32) && !w.has_integration() {
                pump(1 as i32);
                i = i +% (1 as i32);
            }
            assert w.has_integration();

            let first: u64 = w.run("sleep 2");
            assert first == (1 as u64);
            var j: i32 = 0 as i32;
            while j < (100 as i32) && w.command_state() != terminal::CommandState::Running {
                pump(1 as i32);
                j = j +% (1 as i32);
            }
            assert w.command_state() == terminal::CommandState::Running;
            assert w.run("echo nope") == (0 as u64);

            // ^C gets the pane back rather than waiting the sleep out.
            w.interrupt();
            var k: i32 = 0 as i32;
            while k < (200 as i32) && w.finished_count() == (0 as u64) {
                pump(1 as i32);
                k = k +% (1 as i32);
            }
            assert w.finished_count() == (1 as u64);
            w.stop();
        }
        option::Option[terminal_ui::Widget]::None => { assert false; }
    };
    return;
}

#[test]
fn a_stopped_widget_answers_rather_than_traps() {
    match terminal_ui::start() {
        option::Option[terminal_ui::Widget]::Some(w) => {
            w.stop();
            assert w.run("true") == (0 as u64);
            assert w.command_state() == terminal::CommandState::Idle;
            assert w.finished_count() == (0 as u64);
            assert !w.alternate_screen();
            let out: text::Text = w.output();
            assert out.is_empty();
        }
        option::Option[terminal_ui::Widget]::None => { assert false; }
    };
    return;
}

#[link_name = "objc_msgSend"]
extern fn msg_attr_at(recv: *u8, sel: *u8, name: *u8, idx: u64, eff: *rt::Range) -> *u8;

// How many characters carry `name`, over a string of `len` UTF-16 units.
fn attr_span(storage: *u8, name: *u8, len: u64) -> u64 {
    let q: *u8 = rt::sel(#str_ptr("attribute:atIndex:effectiveRange:\0"));
    var i: u64 = 0 as u64;
    var n: u64 = 0 as u64;
    while i < len {
        var eff: rt::Range = rt::Range { location: 0 as u64, length: 0 as u64 };
        if { msg_attr_at(storage, q, name, i, #addr_of(eff)) } != (0 as *u8) { n = n +% (1 as u64); }
        i = i +% (1 as u64);
    }
    return n;
}

#[test]
fn the_cursor_stays_one_cell_across_repeated_renders() {
    // The cursor is drawn with text attributes, and `-[NSTextView setString:]`
    // stamps the view's TYPING attributes onto the new text. NSTextView derives
    // those from the character at the insertion point — which render() parks
    // directly on the cell it just styled. So the cursor's own attribute became
    // the typing attribute and the NEXT render painted it over the WHOLE string:
    // the first frame looked right and every frame after drew the entire line as
    // one enormous cursor.
    //
    // This has to drive the REAL widget through REAL renders. Calling
    // paint_cursor by hand does not reproduce it — the typing attributes are
    // only re-derived once the view is in a window with a live layout manager
    // and the run loop is turning.
    match terminal_ui::start() {
        option::Option[terminal_ui::Widget]::Some(w) => {
            let scroll: *u8 = w.native_handle();
            let win: ak::Window = ak::Window::new(
                rt::Rect { x: 0.0f64, y: 0.0f64, w: 500.0f64, h: 200.0f64 },
                15 as u64, ak::BackingStoreType::NSBackingStoreBuffered, false);
            win.set_content_view(ak::View::from_raw(scroll));
            let tv_raw: *u8 = rt::msg_id(scroll, rt::sel(#str_ptr("documentView\0")));
            assert tv_raw != (0 as *u8);
            // The insertion point — and therefore the typing attributes that
            // carried the bug — is only maintained for a first responder in an
            // ordered-in window. Without these two calls the widget renders but
            // never re-derives typing attributes, and the test passes against
            // the bug.
            win.make_key_and_order_front(0 as *u8);
            let _fr: i8 = rt::msg_i8_id(win.raw(), rt::sel(#str_ptr("makeFirstResponder:\0")), tv_raw);

            w.send("printf 'ABC'\n");
            pump(40 as i32);
            w.send("printf 'DEF'\n");
            pump(40 as i32);

            let ns: *u8 = rt::msg_id(tv_raw, rt::sel(#str_ptr("string\0")));
            let len: u64 = rt::msg_u64(ns, rt::sel(#str_ptr("length\0")));
            assert len > (0 as u64);

            let bg: *u8 = terminal_ui::appkit_string_global(#str_ptr("NSBackgroundColorAttributeName\0"));
            let ul: *u8 = terminal_ui::appkit_string_global(#str_ptr("NSUnderlineStyleAttributeName\0"));
            assert bg != (0 as *u8);
            assert ul != (0 as *u8);

            match ak::TextView::from_raw(tv_raw).text_storage() {
                option::Option[ak::TextStorage]::Some(st) => {
                    let s: *u8 = st.as_mutable_attributed_string().raw();
                    // Not in a key window, so the cursor is the UNFOCUSED shape:
                    // exactly one underlined cell, and no reverse-video block.
                    // The bug made both of these the whole document.
                    assert attr_span(s, ul, len) == (1 as u64);
                    assert attr_span(s, bg, len) == (0 as u64);
                }
                option::Option[ak::TextStorage]::None => { assert false; }
            }
            w.stop();
        }
        option::Option[terminal_ui::Widget]::None => { assert false; }
    }
    return;
}

// ---- the window-key observer must not outlive the context ------------------

// Post a notification by name with a nil object — what AppKit does when a
// window becomes or resigns key. Every registered observer for that name runs.
fn post_note(name: str) {
    let nc: *u8 = rt::msg_id(rt::get_class(#str_ptr("NSNotificationCenter\0")),
                             rt::sel(#str_ptr("defaultCenter\0")));
    rt::msg_void_id_id(nc, rt::sel(#str_ptr("postNotificationName:object:\0")),
                       bridge::nsstring(name), 0 as *u8);
    return;
}

#[test]
fn a_key_notification_after_teardown_touches_nothing() {
    // CRASH ON QUIT, every time, once the widget was dropped and the window then
    // closed: the key observer is pinned to the TEXT VIEW, which outlives the
    // malloc'd context it dereferenced. The guard was itself the use-after-free —
    // `cancel_requested` lives inside the freed block.
    //
    // Silent without ASan (freed-but-mapped memory reads as garbage and the
    // process exits), which is why it survived. Run with `cpc test --asan` to
    // see it fail without the fix.
    // bugs/terminal-key-observer-outlives-its-context.md
    match terminal_ui::start() {
        option::Option[terminal_ui::Widget]::Some(w) => {
            var wv: terminal_ui::Widget = w;
            assert wv.is_running();
            let tv: *u8 = terminal_ui::text_view_of(wv);
            assert tv != (0 as *u8);
            // Alive: the context is reachable through the view.
            assert terminal_ui::context_of(tv) != (0 as *u8);

            wv.stop();
            terminal_ui::force_destroy(wv);

            // The association is cleared BY the free, so every observer that
            // goes through it now finds nothing — no dangling pointer is left
            // to dereference.
            assert terminal_ui::context_of(tv) == (0 as *u8);

            // The observers are still registered (pinned to a live view) and
            // still FIRE — asserted, because a test that proves the handler is
            // safe while never invoking it proves nothing. Counted with `>`
            // rather than an exact delta: widgets from earlier tests leave their
            // own observers registered, so each post reaches several.
            let before: i32 = terminal_ui::key_note_calls();
            post_note("NSWindowDidBecomeKeyNotification");
            let after_became: i32 = terminal_ui::key_note_calls();
            assert after_became > before;
            post_note("NSWindowDidResignKeyNotification");
            assert terminal_ui::key_note_calls() > after_became;
        }
        option::Option[terminal_ui::Widget]::None => { assert false; }
    };
    return;
}


// ---- the live shell ----------------------------------------------------------

// Wait for the shell's first prompt mark. A fixed iteration count is NOT good
// enough: the user's real rc files are sourced before the first prompt (a conda
// init alone runs into hundreds of milliseconds), so the budget has to be
// generous and the exit condition has to be the thing being waited for. A fixed
// count made the first test in this file fail only when later tests were also
// compiled in, which reads as anything but a timeout.
fn read_until_prompt(ref sess: pty::Session, ref s: terminal::Screen) {
    var buf: [u8; 4096] = [0 as u8; 4096];
    var n: i32 = 0 as i32;
    while n < (2000 as i32) {
        match sess.read_into(#addr_of(buf) as *u8, 4096 as usize) {
            pty::ReadResult::Data(k) => {
                s.feed({ #str_from_raw_parts(#addr_of(buf) as *u8, k) });
            }
            pty::ReadResult::WouldBlock => { let _u: i32 = { usleep(5000 as u32) }; }
            pty::ReadResult::Closed => { break; }
            pty::ReadResult::Failed => { break; }
        }
        if s.has_integration() { break; }
        n = n +% (1 as i32);
    }
    return;
}

fn read_until_finished(ref sess: pty::Session, ref s: terminal::Screen, count: u64) {
    var buf: [u8; 4096] = [0 as u8; 4096];
    var n: i32 = 0 as i32;
    while n < (2000 as i32) {
        match sess.read_into(#addr_of(buf) as *u8, 4096 as usize) {
            pty::ReadResult::Data(k) => {
                s.feed({ #str_from_raw_parts(#addr_of(buf) as *u8, k) });
            }
            pty::ReadResult::WouldBlock => { let _u: i32 = { usleep(5000 as u32) }; }
            pty::ReadResult::Closed => { break; }
            pty::ReadResult::Failed => { break; }
        }
        if s.finished_count() >= count { break; }
        n = n +% (1 as i32);
    }
    return;
}

#[test]
fn the_pty_backend_is_present() {
    assert pty::supported();
    assert terminal_widget::supported();
}

#[test]
fn pty_starts_the_child_in_the_requested_cwd() {
    // The cwd argument had NO coverage, and it was the broken path: `start`
    // parked the directory in an Option and matched it twice, so the CString was
    // moved out and freed before forkpty and the child then chdir'd through a
    // dangling pointer. A real round trip is the only honest check. Uses /usr
    // because /tmp is a symlink and getcwd would resolve it to /private/tmp.
    match pty::start(shell: "/bin/sh", cwd: "/usr") {
        option::Option[pty::Session]::Some(s) => {
            var sess: pty::Session = s;
            let _w: isize = sess.write("pwd\n");
            var screen: terminal::Screen = terminal::new(rows: 24 as u16, cols: 200 as u16);
            var tries: i32 = 0 as i32;
            while tries < (400 as i32) {
                read_all(sess, screen, 1 as i32);
                if screen.view().contains("/usr") { break; }
                tries = tries +% (1 as i32);
            }
            assert screen.view().contains("/usr");
        }
        option::Option[pty::Session]::None => { assert false; }
    }
    return;
}




// Poll until `probe` shows up on the screen, or the budget runs out. Returns
// what the screen held either way, so a failed assert shows the real thing.
fn read_until_screen_has(ref sess: pty::Session, ref s: terminal::Screen, probe: str) -> bool {
    var buf: [u8; 4096] = [0 as u8; 4096];
    var n: i32 = 0 as i32;
    while n < (2000 as i32) {
        match sess.read_into(#addr_of(buf) as *u8, 4096 as usize) {
            pty::ReadResult::Data(k) => {
                s.feed({ #str_from_raw_parts(#addr_of(buf) as *u8, k) });
            }
            pty::ReadResult::WouldBlock => { let _u: i32 = { usleep(5000 as u32) }; }
            pty::ReadResult::Closed => { break; }
            pty::ReadResult::Failed => { break; }
        }
        if s.view().contains(probe) { return true; }
        n = n +% (1 as i32);
    }
    return false;
}

#[test]
fn a_live_zsh_reports_command_marks_and_exit_codes() {
    // The whole command API rests on this: the shell, not the terminal, is what
    // knows a command started and how it ended.
    var sess: pty::Session = match pty::start(shell: "/bin/zsh") {
        option::Option[pty::Session]::Some(s) => s,
        option::Option[pty::Session]::None => { assert false; return; }
    };
    var screen: terminal::Screen = terminal::new(rows: 24 as u16, cols: 80 as u16);
    read_until_prompt(sess, screen);
    assert screen.has_integration();
    assert screen.command_state() == terminal::CommandState::Idle;

    // A subshell, so the status is reported without the login shell exiting —
    // which would take the prompt that carries the report with it.
    let _w: isize = sess.write("(exit 3)\n");
    read_until_finished(sess, screen, 1 as u64);
    assert screen.finished_count() >= (1 as u64);
    assert screen.exit_code() == (3 as i32);
    // `$1` rather than zsh's normalised `$2`, so this is what was typed.
    assert screen.command_line() == "(exit 3)";
    sess.close();
    return;
}
#[test]
fn a_live_zsh_reports_its_working_directory() {
    var sess: pty::Session = match pty::start(shell: "/bin/zsh", cwd: "/usr") {
        option::Option[pty::Session]::Some(s) => s,
        option::Option[pty::Session]::None => { assert false; return; }
    };
    var screen: terminal::Screen = terminal::new(rows: 24 as u16, cols: 80 as u16);
    read_until_prompt(sess, screen);
    assert screen.cwd() == "/usr";
    sess.close();
    return;
}
#[test]
fn a_live_command_captures_exactly_its_own_output() {
    // End to end against a real shell: no prompt, no echo of the command, and
    // none of zsh's partial-line marker.
    var sess: pty::Session = match pty::start(shell: "/bin/zsh") {
        option::Option[pty::Session]::Some(s) => s,
        option::Option[pty::Session]::None => { assert false; return; }
    };
    var screen: terminal::Screen = terminal::new(rows: 24 as u16, cols: 200 as u16);
    read_until_prompt(sess, screen);
    let _w: isize = sess.write("printf 'one\\ntwo\\n'\n");
    read_until_finished(sess, screen, 1 as u64);
    let out: text::Text = screen.output();
    assert out.equals("one\ntwo\n");
    assert screen.exit_code() == (0 as i32);
    sess.close();
    return;
}
#[test]
fn a_live_clear_actually_empties_the_pane() {
    // The first half of the bug report. `clear` sends `ESC[H ESC[2J ESC[3J`,
    // every one of which the old model stripped, so the command scrolled the
    // screen by one line and changed nothing else.
    var sess: pty::Session = match pty::start(shell: "/bin/zsh") {
        option::Option[pty::Session]::Some(s) => s,
        option::Option[pty::Session]::None => { assert false; return; }
    };
    var screen: terminal::Screen = terminal::new(rows: 24 as u16, cols: 80 as u16);
    read_until_prompt(sess, screen);

    // Enough output to push rows off a 24-row screen and into scrollback, so
    // that blanking the visible grid is NOT enough to pass this: `clear` has to
    // drop the history too, which is the `ESC[3J` half.
    let _w1: isize = sess.write("printf 'BEFORE_CLEAR\\n'; for i in $(seq 1 60); do printf 'filler %d\\n' $i; done\n");
    assert read_until_screen_has(sess, screen, "filler 60");
    assert screen.scrollback().contains("BEFORE_CLEAR");

    let _w2: isize = sess.write("clear\n");
    var n: i32 = 0 as i32;
    var gone: bool = false;
    while n < (2000 as i32) {
        read_all(sess, screen, 1 as i32);
        if !screen.view().contains("BEFORE_CLEAR") { gone = true; break; }
        n = n +% (1 as i32);
    }
    assert gone;
    // Scrollback went with it — `ESC[3J` is the half that empties the pane
    // rather than merely blanking the visible rows.
    assert screen.scrollback() == "";
    sess.close();
    return;
}
#[test]
fn a_live_top_takes_the_alternate_screen_and_gives_it_back() {
    // The other half of the report. `top` is the demanding case: it takes the
    // alternate screen, sets a scroll region, and repaints with absolute
    // addressing — so with no screen to address, every repaint appended and
    // quitting left the wreckage behind.
    var sess: pty::Session = match pty::start(shell: "/bin/zsh") {
        option::Option[pty::Session]::Some(s) => s,
        option::Option[pty::Session]::None => { assert false; return; }
    };
    var screen: terminal::Screen = terminal::new(rows: 24 as u16, cols: 80 as u16);
    read_until_prompt(sess, screen);

    let _w1: isize = sess.write("printf 'BEFORE_TOP\\n'\n");
    assert read_until_screen_has(sess, screen, "BEFORE_TOP");

    let _w2: isize = sess.write("top\n");
    assert read_until_screen_has(sess, screen, "Processes:");
    assert screen.alternate_screen();
    // The alternate screen is exactly the screen: what is underneath is parked,
    // not shown, and repaints overwrite rather than accumulate.
    assert screen.view().contains("BEFORE_TOP") == false;
    var lines: usize = (1 as usize) +% screen.view().to_text().count_of("\n");
    assert lines <= (24 as usize);

    // Let it repaint several times. Appending would show up as growth; a screen
    // stays the same height.
    var reps: i32 = 0 as i32;
    while reps < (60 as i32) {
        read_all(sess, screen, 1 as i32);
        reps = reps +% (1 as i32);
    }
    assert screen.alternate_screen();
    var after: usize = (1 as usize) +% screen.view().to_text().count_of("\n");
    assert after <= (24 as usize);

    let _w3: isize = sess.write("q");
    var n: i32 = 0 as i32;
    var back: bool = false;
    while n < (2000 as i32) {
        read_all(sess, screen, 1 as i32);
        if !screen.alternate_screen() { back = true; break; }
        n = n +% (1 as i32);
    }
    assert back;
    // Quitting hands the screen back with what was underneath intact.
    assert screen.view().contains("BEFORE_TOP");
    sess.close();
    return;
}
#[test]
fn pty_does_not_persist_shell_history_by_default() {
    // An app's terminal pane must not write the user's GLOBAL history: what is
    // typed in iris is iris's business, and macOS keeps only SAVEHIST=1000
    // entries, so a chatty pane evicts the commands the user actually wants.
    //
    // Asking the live shell is the only honest check. Exporting HISTFILE looks
    // like it works and does not: /etc/zshrc reassigns it unconditionally AFTER
    // our environment is in place.
    var sess: pty::Session = match pty::start(shell: "/bin/zsh") {
        option::Option[pty::Session]::Some(s) => s,
        option::Option[pty::Session]::None => { assert false; return; }
    };
    var screen: terminal::Screen = terminal::new(rows: 24 as u16, cols: 200 as u16);
    read_until_prompt(sess, screen);
    let _w: isize = sess.write("print -r -- \"HF=[$HISTFILE] SH=[$SAVEHIST]\"\n");
    read_until_finished(sess, screen, 1 as u64);
    let out: text::Text = screen.output();
    assert out.equals("HF=[] SH=[0]\n");
    sess.close();
    return;
}
#[test]
fn pty_save_history_true_leaves_the_shell_alone() {
    // The opt-in must actually opt in, or the default is untestable. The trap
    // here is caused by the shim itself: /etc/zshrc derives HISTFILE from
    // ZDOTDIR, which is ours, so without the repair this quietly moved the
    // user's history into a temp directory.
    var sess: pty::Session = match pty::start(shell: "/bin/zsh", save_history: true) {
        option::Option[pty::Session]::Some(s) => s,
        option::Option[pty::Session]::None => { assert false; return; }
    };
    var screen: terminal::Screen = terminal::new(rows: 24 as u16, cols: 200 as u16);
    read_until_prompt(sess, screen);
    let _w: isize = sess.write("print -r -- \"HF=[$HISTFILE]\"\n");
    read_until_finished(sess, screen, 1 as u64);
    let out: text::Text = screen.output();
    assert out.contains(".zsh_history");
    assert out.contains("cplus-terminal-rc") == false;
    assert out.contains("HF=[]") == false;
    sess.close();
    return;
}
#[test]
fn pty_history_opt_out_keeps_the_users_shell_intact() {
    // The opt-out works by pointing ZDOTDIR at generated rc files, so the risk
    // it carries is the opposite of the bug: a shell that no longer loads the
    // user's setup. The shim sources the real dotfiles, so anything they export
    // must still be there — HOME is the one every environment has.
    var sess: pty::Session = match pty::start(shell: "/bin/zsh") {
        option::Option[pty::Session]::Some(s) => s,
        option::Option[pty::Session]::None => { assert false; return; }
    };
    var screen: terminal::Screen = terminal::new(rows: 24 as u16, cols: 200 as u16);
    read_until_prompt(sess, screen);
    let _w: isize = sess.write("print -r -- \"RC=[$HOME] ZD=[$CPLUS_TERM_HOME]\"\n");
    read_until_finished(sess, screen, 1 as u64);
    let out: text::Text = screen.output();
    assert out.contains("RC=[/");                // a real absolute HOME
    assert out.contains("ZD=[/");                // shim knows the real root
    assert out.contains("RC=[]") == false;
    sess.close();
    return;
}
#[test]
fn opening_a_second_pane_does_not_recurse_the_shim() {
    // `setenv` is process-wide, so by the second `start()` the live ZDOTDIR is
    // already the shim. Deriving the shim's source root from the environment
    // therefore pointed the generated rc files at THEMSELVES, and each one
    // sourced itself until zsh bailed out with "job table full or recursion
    // limit exceeded" — leaving a shell with none of the user's setup. Opening a
    // second terminal pane was the whole repro, which no single-session test
    // could ever see.
    var first: pty::Session = match pty::start(shell: "/bin/zsh") {
        option::Option[pty::Session]::Some(s) => s,
        option::Option[pty::Session]::None => { assert false; return; }
    };
    var s1: terminal::Screen = terminal::new(rows: 24 as u16, cols: 200 as u16);
    read_until_prompt(first, s1);
    let _w1: isize = first.write("print -r -- \"ONE=[$HISTFILE]\"\n");
    read_until_finished(first, s1, 1 as u64);
    let o1: text::Text = s1.output();
    assert o1.contains("ONE=[]");
    first.close();

    var second: pty::Session = match pty::start(shell: "/bin/zsh") {
        option::Option[pty::Session]::Some(s) => s,
        option::Option[pty::Session]::None => { assert false; return; }
    };
    var s2: terminal::Screen = terminal::new(rows: 24 as u16, cols: 200 as u16);
    read_until_prompt(second, s2);
    let _w2: isize = second.write("print -r -- \"TWO=[$HISTFILE] HOME=[$HOME]\"\n");
    read_until_finished(second, s2, 1 as u64);
    let o2: text::Text = s2.output();
    assert s2.view().contains("recursion") == false;
    assert o2.contains("TWO=[]");
    assert o2.contains("HOME=[/");
    second.close();
    return;
}
#[test]
fn the_shell_exit_status_comes_back() {
    var sess: pty::Session = match pty::start(shell: "/bin/zsh") {
        option::Option[pty::Session]::Some(s) => s,
        option::Option[pty::Session]::None => { assert false; return; }
    };
    var screen: terminal::Screen = terminal::new();
    read_until_prompt(sess, screen);
    assert !sess.has_exited();

    let _w: isize = sess.write("exit 7\n");
    var tries: i32 = 0 as i32;
    while tries < (600 as i32) {
        read_all(sess, screen, 2 as i32);
        if sess.has_exited() { break; }
        tries = tries +% (1 as i32);
    }
    assert match sess.poll_exit() {
        option::Option[i32]::Some(c) => c == (7 as i32),
        option::Option[i32]::None => false,
    };
    // waitpid hands a status over exactly once, so the answer has to survive
    // teardown reaping it a second time.
    sess.close();
    assert match sess.poll_exit() {
        option::Option[i32]::Some(c) => c == (7 as i32),
        option::Option[i32]::None => false,
    };
    return;
}
