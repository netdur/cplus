// terminal/pty — macOS pseudo-terminal session.
//
// The public Session surface is intentionally small and backend-shaped. A
// future platform module can replace this implementation without changing the
// widget: start, read, write, resize, and close.
//
// WHY THIS EXISTS ALONGSIDE stdlib/pty. stdlib/pty binds the same syscalls and
// argues against forkpty by name: it forks, and in a threaded app only
// async-signal-safe calls are legal before exec, so it uses openpty +
// posix_spawn(POSIX_SPAWN_SETSID) instead. Folding this file into a thin
// convenience over stdlib's PtyChild is the obvious consolidation, and it is
// NOT the right trade:
//
//   * Everything below is verified against LIVE shells from `cpc test` — the
//     cwd round trip execs /bin/sh and reads `pwd` back, and the three history
//     tests start /bin/zsh and ask it what $HISTFILE and $SAVEHIST actually
//     are. That last one cannot be replaced by a cheaper check: /etc/zshrc
//     reassigns HISTFILE after our environment is in place, so testing the
//     environment alone passes while the real shell still writes history.
//   * stdlib/pty's `spawn` has no live coverage at all, and says why: a child
//     spawned inside the test driver deadlocks the harness (the same limit
//     process.cplus documents). Its tests cover the pure pieces only.
//
// So the consolidation would move a live-tested path onto a spawn mechanism
// that cannot be tested here, trading verified behaviour for tidiness. The fork
// hazard is real but contained and deliberate: the child below does chdir and
// execl and nothing else, both async-signal-safe, and every environment
// variable is set in the PARENT before the fork.
//
// The one genuine wart that structure would have fixed is that parent-side
// setenv mutates the HOST process environment — which is why the ZDOTDIR
// capture/restore below exists at all. If that ever needs closing, the fix is
// `execle` with an envp built in the parent, NOT a change of spawn mechanism:
// exec takes the vector directly, it stays async-signal-safe in the child, and
// the live tests above keep working as the oracle.

import "stdlib/option" as option;
import "stdlib/text" as text;
import "stdlib/env" as env;
import "stdlib/fs" as fs;
import "stdlib/result" as result;
import "stdlib/status" as status;
// The platform's own numbers, its default shell, and the whole
// shell-integration story — `ptysys_linux.cplus` on Linux. Everything left in
// this file is the same code on both.
import "./ptysys" as sys;

extern fn forkpty(master: *i32, name: *u8, termp: *u8, winp: *WinSize) -> i32;
extern fn chdir(path: *u8) -> i32;
extern fn setenv(name: *u8, value: *u8, overwrite: i32) -> i32;
extern fn unsetenv(name: *u8) -> i32;
extern fn _exit(code: i32);
extern fn read(fd: i32, buf: *u8, count: usize) -> isize;
extern fn write(fd: i32, buf: *u8, count: usize) -> isize;
extern fn close(fd: i32) -> i32;
extern fn kill(pid: i32, signal: i32) -> i32;
extern fn waitpid(pid: i32, status: *i32, options: i32) -> i32;
// fcntl and ioctl are VARIADIC in libc. Declared fixed-arity, the third
// argument is passed in a register the callee never reads on AArch64-darwin, so
// O_NONBLOCK and TIOCSWINSZ silently do nothing (or worse). Same defect that
// was in stdlib/process.
extern fn fcntl(fd: i32, cmd: i32, ...) -> i32;
extern fn ioctl(fd: i32, request: u64, ...) -> i32;

#[repr(C)]
struct WinSize {
    rows: u16,
    cols: u16,
    xpixel: u16,
    ypixel: u16,
}

enum ReadResult {
    Data(usize),
    WouldBlock,
    Closed,
    Failed,
}

struct Session {
    _master: i32,
    _pid: i32,
    _closed: bool,
    // waitpid hands a status over exactly ONCE, and both `poll_exit` and
    // `close` reap. Remembering it here is what lets a caller ask for the exit
    // code after the widget has already torn the session down.
    _reaped: bool,
    _status: i32,
    // Whether this shell was handed the OSC 133 shim. Answered from the
    // INSTALLATION, not from having seen a mark — see `start`.
    _marks: bool,
}

// WIFEXITED / WEXITSTATUS, plus the 128+signal convention a shell itself
// reports for a child that was killed rather than returning.
fn decode_wait_status(st: i32) -> i32 {
    if (st & (0x7f as i32)) == (0 as i32) {
        return (st >> (8 as i32)) & (0xff as i32);
    }
    return (128 as i32) +% (st & (0x7f as i32));
}

fn supported() -> bool { return true; }

fn make_nonblocking(fd: i32) {
    let flags: i32 = { fcntl(fd, 3 as i32, 0 as i32) }; // F_GETFL
    if flags >= (0 as i32) {
        let _rc: i32 = { fcntl(fd, 4 as i32, flags | sys::o_nonblock()) }; // F_SETFL
    }
    return;
}

// `save_history: true` leaves the shell's history configuration completely
// alone — the pane writes to the user's global history like any other terminal.
// The default shell is the PLATFORM's — `/bin/zsh` on macOS, `/bin/bash` on
// Linux. It is a named argument rather than a literal default because a default
// has to be one constant expression and there is no one right answer.
fn start(shell: str = "", cwd: str = "", rows: u16 = 24 as u16, cols: u16 = 80 as u16, save_history: bool = false) -> option::Option[Session] {
    let shell_resolved: str = if shell == "" { sys::default_shell() } else { shell };
    let shell_text: text::Text = text::from_str(shell_resolved);
    let shell_c: text::CString = match shell_text.c_str() {
        option::Option[text::CString]::Some(v) => v,
        option::Option[text::CString]::None => { return option::Option[Session]::None; }
    };
    // The cwd is held as an OWNED CString in a plain local, and its raw pointer
    // is taken once, here in the parent. It must not live in an Option that is
    // matched more than once: a match arm binds the payload BY VALUE, which
    // moves it out of the local and frees it at the end of the arm — and the
    // local keeps the same bits, so a later match hands the freed pointer out
    // again. That is a use-after-free plus a double free on every start() that
    // is given a cwd, which is why passing one blanked the terminal or aborted
    // in malloc while the no-cwd path looked fine. cpc reports no error for the
    // second read (bugs/moved-from-local-is-readable-and-double-frees.md).
    var cwd_text: text::Text = text::from_str(cwd);
    let cwd_c: text::CString = match cwd_text.c_str() {
        option::Option[text::CString]::Some(v) => v,
        option::Option[text::CString]::None => { return option::Option[Session]::None; }
    };
    // Valid until `start` returns, and therefore across forkpty: the child gets
    // a copy of this address space, and execs before any drop could run.
    let cwd_ptr: *u8 = cwd_c.as_ptr();

    // TERM/COLORTERM are exported in the PARENT, before the fork, and the child
    // inherits environ. setenv() allocates, and only async-signal-safe calls are
    // legal between fork and exec: if another thread held the malloc lock when
    // we forked, a setenv in the child would deadlock it forever. This library
    // runs inside threaded apps (a reactor, worker threads), so that is a real
    // hazard, not a theoretical one.
    let _term: i32 = { setenv(#str_ptr("TERM\0"), #str_ptr("xterm-256color\0"), 1 as i32) };
    let _color: i32 = { setenv(#str_ptr("COLORTERM\0"), #str_ptr("truecolor\0"), 1 as i32) };
    // `setenv` mutates the HOST process environment and is not undone when
    // `start` returns, so a pane that turned history off would otherwise leave
    // HISTFILE=/dev/null behind for the next pane whatever IT asked for.
    if save_history {
        let _hf: i32 = { unsetenv(#str_ptr("HISTFILE\0")) };
    } else {
        // Works for bash/ksh directly; zsh needs the ZDOTDIR shim below because
        // /etc/zshrc reassigns HISTFILE after this point.
        let _hf: i32 = { setenv(#str_ptr("HISTFILE\0"), #str_ptr("/dev/null\0"), 1 as i32) };
    }
    // Installed for BOTH history dispositions, because the command marks are
    // not a history feature — a caller that opted into the user's real history
    // still needs to know when a build finished.
    //
    // AND REMEMBERED, because "will this shell report marks" is a question the
    // installer can answer and an observer cannot answer YET. `Widget::run` has
    // to choose between sending a bare command and bracketing it with printfs
    // of its own at the moment the FIRST command is sent — which, for a pane
    // that builds as soon as it opens, is before the shell has drawn a prompt
    // and therefore before any mark could have arrived. Inferring "no
    // integration" from that silence is wrong twice over: the bracketing
    // printfs are echoed at the user, and their marks INTERLEAVE with the
    // shim's own, so the ledger hands out ids that no longer match the one
    // `run` promised and the command's end is never recognised — a build that
    // finishes while the caller waits for it forever.
    //
    // zsh only: ZDOTDIR is a zsh mechanism, so a bash pane genuinely has no
    // marks, which is the case the bracketing path handles correctly.
    let integ: sys::Integration = sys::install_integration(shell_resolved, save_history == false);
    let marks: bool = integ.marks;
    // HELD AS AN OWNED CString IN A PLAIN LOCAL, with its pointer taken once —
    // the same discipline the cwd above documents, and for the same reason:
    // this pointer has to survive the fork and be read in the child, where no
    // allocation is legal.
    // CLONED, not moved: `Integration` owns its Text and its destructor would
    // free a moved field a second time (E0509). One copy of a path.
    var rc_text: text::Text = integ.rc.clone();
    let rc_c: text::CString = match rc_text.c_str() {
        option::Option[text::CString]::Some(v) => v,
        option::Option[text::CString]::None => { return option::Option[Session]::None; }
    };
    let rc_ptr: *u8 = rc_c.as_ptr();

    var master: i32 = -1 as i32;
    var ws: WinSize = WinSize { rows: rows, cols: cols, xpixel: 0 as u16, ypixel: 0 as u16 };
    let pid: i32 = { forkpty(#addr_of(master), 0 as *u8, 0 as *u8, #addr_of(ws)) };
    if pid < (0 as i32) { return option::Option[Session]::None; }
    if pid == (0 as i32) {
        // Child: chdir and execl only — both async-signal-safe.
        if cwd != "" {
            let _cd: i32 = { chdir(cwd_ptr) };
        }
        let _exec: i32 = sys::exec_shell(shell_c.as_ptr(), rc_ptr, integ.use_rcfile);
        { _exit(127 as i32); }
    }

    make_nonblocking(master);
    return option::Option[Session]::Some(Session {
        _master: master,
        _pid: pid,
        _closed: false,
        _reaped: false,
        _status: -1 as i32,
        _marks: marks,
    });
}

impl Session {
    fn master_fd(this) -> i32 { return this._master; }
    fn pid(this) -> i32 { return this._pid; }
    fn is_open(this) -> bool { return !this._closed; }

    // Does this shell report OSC 133 marks? True from the instant the session
    // starts, where `Screen::has_integration` can only become true once a mark
    // has actually arrived — which is one prompt too late for a caller that
    // runs a command immediately.
    fn expects_marks(this) -> bool { return this._marks; }

    fn read_into(this, buffer: *u8, capacity: usize) -> ReadResult {
        if this._closed || capacity == (0 as usize) { return ReadResult::Closed; }
        let n: isize = { read(this._master, buffer, capacity) };
        if n > (0 as isize) { return ReadResult::Data(n as usize); }
        if n == (0 as isize) { return ReadResult::Closed; }
        let e: i32 = sys::errno_value();
        if e == sys::eagain() { return ReadResult::WouldBlock; }
        // The PTY peer closed. Darwin reports it as EIO on the master and so
        // does Linux, but the VALUE is asked for rather than written twice.
        if e == sys::eio() { return ReadResult::Closed; }
        return ReadResult::Failed;
    }

    fn write(this, bytes: str) -> isize {
        if this._closed { return -1 as isize; }
        return { write(this._master, #str_ptr(bytes), #str_len(bytes)) };
    }

    fn resize(this, rows: u16, cols: u16) -> bool {
        if this._closed { return false; }
        var ws: WinSize = WinSize { rows: rows, cols: cols, xpixel: 0 as u16, ypixel: 0 as u16 };
        return { ioctl(this._master, sys::tiocswinsz(), #addr_of(ws) as *u8) } == (0 as i32);
    }

    // Has the shell itself exited, and with what status? `None` while it is
    // still running. Non-blocking, and safe to call in a loop: waitpid gives a
    // status up exactly once, so the answer is remembered.
    fn poll_exit(ref this) -> option::Option[i32] {
        if this._reaped { return option::Option[i32]::Some(this._status); }
        if this._pid <= (0 as i32) { return option::Option[i32]::None; }
        var st: i32 = 0 as i32;
        let r: i32 = { waitpid(this._pid, #addr_of(st), 1 as i32) }; // WNOHANG
        if r == this._pid {
            this._reaped = true;
            this._status = decode_wait_status(st);
            return option::Option[i32]::Some(this._status);
        }
        if r < (0 as i32) {
            // ECHILD — something else already collected it, and the status is
            // gone with it. Still exited, just not knowably how.
            this._reaped = true;
            this._status = -1 as i32;
            return option::Option[i32]::Some(this._status);
        }
        return option::Option[i32]::None;
    }

    fn has_exited(ref this) -> bool {
        return match this.poll_exit() {
            option::Option[i32]::Some(_) => true,
            option::Option[i32]::None => false,
        };
    }

    fn close(ref this) {
        if this._closed { return; }
        this._closed = true;
        if this._master >= (0 as i32) {
            let _fd: i32 = { close(this._master) };
            this._master = -1 as i32;
        }
        // Reap BEFORE signalling: a shell that already exited on its own has a
        // real status waiting, and hanging up first would still collect it, but
        // asking first means the common case never touches a signal at all.
        match this.poll_exit() {
            option::Option[i32]::Some(_) => { return; }
            option::Option[i32]::None => {}
        }
        let _sig: i32 = { kill(this._pid, 1 as i32) }; // SIGHUP
        var st: i32 = 0 as i32;
        let first: i32 = { waitpid(this._pid, #addr_of(st), 1 as i32) }; // WNOHANG
        if first == this._pid {
            this._reaped = true;
            this._status = decode_wait_status(st);
            return;
        }
        if first == (0 as i32) {
            // A foreground program may ignore SIGHUP. Widget destruction must
            // remain deterministic, so finish the owned child rather than
            // blocking the AppKit main thread indefinitely.
            let _kill: i32 = { kill(this._pid, 9 as i32) }; // SIGKILL
            let got: i32 = { waitpid(this._pid, #addr_of(st), 0 as i32) };
            if got == this._pid {
                this._reaped = true;
                this._status = decode_wait_status(st);
                return;
            }
        }
        this._reaped = true;
        this._status = -1 as i32;
        return;
    }

    fn drop(ref this) {
        this.close();
        return;
    }
}
