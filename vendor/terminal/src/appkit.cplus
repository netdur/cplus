// terminal/appkit — live macOS terminal widget.
//
// A Widget owns an NSScrollView/NSTextView pair and a real PTY session. A
// libdispatch READ source drains the master fd on the main queue, feeds the
// portable Transcript, and updates AppKit. A tiny NSTextView subclass forwards
// keys to the PTY. The returned flex node is compatible with facet_appkit's
// view-bearing layout layer; `native_handle` also plugs into facet::native.

import "./pty" as pty;
import "./terminal" as terminal;
import "stdlib/option" as option;
import "stdlib/status" as status;
import "stdlib/text" as text;
import "objc/runtime" as rt;
import "objc/bridge" as bridge;
import "objc/synthesis" as synth;
import "appkit/appkit" as ak;
import "appkit/appkit_ext" as akx;
import "flex_layout/flex_layout" as flex;

extern fn malloc(n: usize) -> *u8;
extern fn free(p: *u8);
extern fn dlsym(handle: *u8, symbol: *u8) -> *u8;
extern fn dispatch_source_create(type_: *u8, handle: u64, mask: u64, queue: *u8) -> *u8;
// dispatch_source_set_context does NOT exist. The context setter is the generic
// dispatch_set_context(dispatch_object_t, void*), which applies to sources too.
extern fn dispatch_set_context(source: *u8, context: *u8);
extern fn dispatch_source_set_event_handler_f(source: *u8, handler: fn(*u8));
extern fn dispatch_source_set_cancel_handler_f(source: *u8, handler: fn(*u8));
extern fn dispatch_resume(object: *u8);
extern fn dispatch_source_cancel(source: *u8);
extern fn dispatch_release(object: *u8);
// Hop to the NEXT main-queue turn. Async even when the caller is already on the
// main thread, which is the whole point where it is used (repaint_for_focus).
extern fn dispatch_async_f(queue: *u8, context: *u8, work: fn(*u8));

struct TerminalContext {
    session: pty::Session,
    transcript: terminal::Transcript,
    opaque text_view: *u8,     // borrowed from Widget._scroll's view tree
    opaque scroll_view: *u8,   // borrowed from Widget._scroll
    opaque source: *u8,        // released by the dispatch cancel handler
    cell_width: f64,
    cell_height: f64,
    cancel_requested: bool,
    cancel_finished: bool,
    dispose_requested: bool,
}

struct Widget {
    _scroll: ak::ScrollView,
    opaque _ctx: *TerminalContext,
}

fn supported() -> bool { return true; }

fn terminal_context_key() -> *u8 { return { 30101 as *u8 }; }

fn main_dispatch_queue() -> *u8 {
    let rtld_default: *u8 = { ((0 as usize) -% (2 as usize)) as *u8 };
    return { dlsym(rtld_default, #str_ptr("_dispatch_main_q\0")) };
}

// AppKit's attribute names are NSString globals. Read them out of the framework
// instead of hardcoding their values: `NSColor` / `NSBackgroundColor` are the
// real contents of those symbols, which makes a literal look correct right up
// until it is not.
fn appkit_string_global(symbol: *u8) -> *u8 {
    let rtld_default: *u8 = { ((0 as usize) -% (2 as usize)) as *u8 };
    let slot: *u8 = { dlsym(rtld_default, symbol) };
    if slot == (0 as *u8) { return 0 as *u8; }
    let cell: *u64 = { slot as *u64 };
    let value: u64 = { *cell };
    return { value as *u8 };
}

// UTF-16 units in `p[from..to)`. NSRange counts UTF-16, the transcript counts
// bytes, and the two only agree while the text stays ASCII — a prompt with a
// single accented character or an em dash is enough to put the cursor block on
// the wrong cell.
fn utf16_units(p: *u8, from: usize, to: usize) -> u64 {
    var i: usize = from;
    var n: u64 = 0 as u64;
    while i < to {
        let b: u8 = { p[i] };
        if !terminal::is_utf8_continuation(b) {
            // A 4-byte scalar is a surrogate PAIR in UTF-16.
            if b >= (0xf0 as u8) { n = n +% (2 as u64); } else { n = n +% (1 as u64); }
        }
        i = i +% (1 as usize);
    }
    return n;
}

// Does the terminal hold the keyboard right now? Both halves matter: the view
// must be its window's first responder AND that window must be key. Typing goes
// nowhere if either is false, so both must read as "not focused".
fn view_has_focus(tv_raw: *u8) -> bool {
    if tv_raw == (0 as *u8) { return false; }
    let win: *u8 = rt::msg_id(tv_raw, rt::sel(#str_ptr("window\0")));
    if win == (0 as *u8) { return false; }
    if rt::msg_i8(win, rt::sel(#str_ptr("isKeyWindow\0"))) == (0 as i8) { return false; }
    return rt::msg_id(win, rt::sel(#str_ptr("firstResponder\0"))) == tv_raw;
}

// The cursor. FOCUSED: the cell in reverse video — a solid block, the way a
// terminal draws it, meaning "type and it lands here". UNFOCUSED: a thick
// underline under the same cell — the cursor position is still legible, but it
// plainly is not taking keys.
//
// The two states differ in SHAPE, not shade. Dimming the block would encode
// focus as a colour difference alone, which is unreadable to anyone who cannot
// separate close colours, and washes out on a light theme besides. Filled block
// vs underline survives any palette and any vision, and it is the same
// distinction Terminal.app and iTerm2 draw (they hollow the block instead).
//
// Attributes rather than the selection, so selecting text with the mouse and
// copying it still works.
//
// `set_string` does NOT hand back a clean slate, which is the trap here.
// `-[NSTextView setString:]` stamps the view's TYPING attributes onto the new
// text, and NSTextView derives those from the character at the insertion
// point — which `render` parks directly on the cell we just styled. So the
// cursor's own attribute is adopted as the typing attribute and the NEXT
// render paints it across the WHOLE string: one render looks right, and from
// the second one on the entire line is a cursor. (That is why it read as
// "the block is enormous" rather than as a missing cursor.)
//
// Wiping the range we own before painting it is the fix, and it has to happen
// on every pass, not just when the style changes.
fn paint_cursor(tv: ak::TextView, at: rt::Range, focused: bool, full: rt::Range) {
    let bg_name: *u8 = appkit_string_global(#str_ptr("NSBackgroundColorAttributeName\0"));
    let fg_name: *u8 = appkit_string_global(#str_ptr("NSForegroundColorAttributeName\0"));
    let ul_name: *u8 = appkit_string_global(#str_ptr("NSUnderlineStyleAttributeName\0"));
    if bg_name == (0 as *u8) || fg_name == (0 as *u8) { return; }
    match tv.text_storage() {
        option::Option[ak::TextStorage]::Some(storage) => {
            let s: *u8 = storage.as_mutable_attributed_string().raw();
            let add: *u8 = rt::sel(#str_ptr("addAttribute:value:range:\0"));
            let remove: *u8 = rt::sel(#str_ptr("removeAttribute:range:\0"));
            // Clean slate over the whole document: drop any inherited cursor
            // styling, then restore the one attribute the terminal always
            // wants. Background is left absent so the view's own background
            // shows through; foreground must be re-applied or the text falls
            // back to the default black on a dark view.
            rt::msg_void_id_range(s, remove, bg_name, full);
            if ul_name != (0 as *u8) { rt::msg_void_id_range(s, remove, ul_name, full); }
            rt::msg_void_id_id_range(s, add, fg_name, ak::Color::text_color().raw(), full);
            if focused {
                rt::msg_void_id_id_range(s, add, bg_name, ak::Color::text_color().raw(), at);
                rt::msg_void_id_id_range(s, add, fg_name, ak::Color::text_background_color().raw(), at);
            } else {
                if ul_name == (0 as *u8) { return; }
                // NSUnderlineStyleThick = 2.
                let thick: *u8 = rt::msg_id_i64(rt::get_class(#str_ptr("NSNumber\0")), rt::sel(#str_ptr("numberWithInt:\0")), 2 as i64);
                rt::msg_void_id_id_range(s, add, ul_name, thick, at);
            }
        }
        option::Option[ak::TextStorage]::None => {}
    }
    return;
}

fn render(c: *TerminalContext) {
    if c == (0 as *TerminalContext) || { (*c).text_view } == (0 as *u8) { return; }
    let tv: ak::TextView = ak::TextView::from_raw({ (*c).text_view });

    // The cursor needs a cell to sit on. The transcript drops the blanks a
    // shell leaves under it (that is what makes `\b space \b` read as an
    // erase), so pad them back for display only — otherwise the block would
    // have nothing to occupy at the end of a line, which is where it spends
    // most of its time.
    let cursor: usize = { (*c).transcript.cursor() };
    var display: text::Text = text::from_str({ (*c).transcript.view() });
    while display.count() <= cursor {
        let _pad: status::Status = display.append(" ");
    }
    tv.as_text().set_string(display.view());

    // NSString length is UTF-16 units, which is exactly what NSRange expects.
    // Measure the TAIL from the cursor rather than the head: the tail is the
    // rest of the live line, the head is the whole scrollback.
    let ns: *u8 = rt::msg_id(tv.raw(), rt::sel(#str_ptr("string\0")));
    let end: u64 = rt::msg_u64(ns, rt::sel(#str_ptr("length\0")));
    let tail: u64 = utf16_units(#str_ptr(display.view()), cursor, display.count());
    var at: u64 = 0 as u64;
    if end > tail { at = end -% tail; }
    // The padding guarantees a cell at the cursor, so `at` lands inside the
    // string — unless the shell emitted bytes NSString and this arithmetic
    // disagree about (invalid UTF-8 survives `feed`, which is deliberate). An
    // out-of-bounds NSRange is an ObjC exception, i.e. the app dies, so clamp
    // rather than trust the two counts to agree.
    if end == (0 as u64) { return; }
    if at >= end { at = end -% (1 as u64); }

    let cell: rt::Range = rt::Range { location: at, length: 1 as u64 };
    let whole: rt::Range = rt::Range { location: 0 as u64, length: end };
    paint_cursor(tv, cell, view_has_focus({ (*c).text_view }), whole);
    // Empty selection at the cursor: nothing is highlighted (the block is drawn
    // by attributes) and ⌘C with no selection copies nothing, as it should.
    let caret: rt::Range = rt::Range { location: at, length: 0 as u64 };
    tv.as_text().set_selected_range(caret);
    tv.as_text().scroll_range_to_visible(cell);
    return;
}

fn destroy_context(c: *TerminalContext) {
    if c == (0 as *TerminalContext) { return; }
    { #drop_in_place::[TerminalContext](c); }
    { free(c as *u8); }
    return;
}

fn cancel_finished(ctx: *u8) {
    let c: *TerminalContext = { ctx as *TerminalContext };
    { (*c).session.close(); }
    if { (*c).source } != (0 as *u8) {
        { dispatch_release({ (*c).source }); }
        { (*c).source = 0 as *u8; }
    }
    { (*c).cancel_finished = true; }
    if { (*c).dispose_requested } { destroy_context(c); }
    return;
}

fn request_cancel(c: *TerminalContext) {
    if c == (0 as *TerminalContext) || { (*c).cancel_requested } { return; }
    { (*c).cancel_requested = true; }
    { dispatch_source_cancel({ (*c).source }); }
    // Cancellation prevents further main-queue reads. Close/reap now as well
    // as in the cancel handler so dropping a widget during application
    // shutdown cannot leave its shell alive if the run loop never turns again.
    { (*c).session.close(); }
    return;
}

fn read_ready(ctx: *u8) {
    let c: *TerminalContext = { ctx as *TerminalContext };
    if c == (0 as *TerminalContext) || { (*c).cancel_requested } { return; }
    var buf: [u8; 8192] = [0 as u8; 8192];
    var changed: bool = false;
    loop {
        match { (*c).session.read_into(#addr_of(buf) as *u8, 8192 as usize) } {
            pty::ReadResult::Data(n) => {
                let chunk: str = { #str_from_raw_parts(#addr_of(buf) as *u8, n) };
                { (*c).transcript.feed(chunk); }
                changed = true;
            }
            pty::ReadResult::WouldBlock => { break; }
            pty::ReadResult::Closed => {
                { (*c).transcript.finish(); }
                changed = true;
                request_cancel(c);
                break;
            }
            pty::ReadResult::Failed => {
                request_cancel(c);
                break;
            }
        }
    }
    if changed { render(c); }
    return;
}

fn send(c: *TerminalContext, bytes: str) {
    if c == (0 as *TerminalContext) || { (*c).cancel_requested } { return; }
    let _written: isize = { (*c).session.write(bytes) };
    return;
}

// Keys, natively — and NOT through facet's `on_key`, which is the portable key
// primitive and would be the obvious home for this. The decision, recorded
// because the alternative keeps looking attractive from outside:
//
//   * The table below is Darwin virtual key codes (36 Return, 48 Tab, 51
//     Delete, 123-126 arrows, ...). facet's `key_code` is documented as the
//     PLATFORM code, so routing through `on_key` would carry these same
//     constants into the handler — the same backend-specific code, one layer
//     further from the thing it is specific to. Portability would need facet to
//     grow named keys, which is a change worth making when something portable
//     needs them, not to relocate this.
//   * The Command branch is not key handling at all: it is `copy:`,
//     `selectAll:` and NSPasteboard on the text view. No portable primitive
//     covers those, and dropping them would cost the terminal native
//     selection and paste.
//   * `on_key` delivers through a process-wide event filter matched by view.
//     This widget is a first responder with focus-dependent cursor painting
//     (`view_has_focus` above drives the block-vs-underline shape) and wants
//     the real responder chain, including the super call for anything it does
//     not claim.
//
// The consequence is accepted, not overlooked: this widget cannot run on a
// non-AppKit backend. A terminal emulator is a native widget in every toolkit
// that ships one, and the portable seam it does sit behind is the `terminal`
// package's own API, not its key path.
fn key_down_imp(self_obj: *u8, cmd: *u8, event_obj: *u8) {
    let c: *TerminalContext = { synth::get_associated(self_obj, terminal_context_key()) as *TerminalContext };
    if c == (0 as *TerminalContext) || { (*c).cancel_requested } { return; }
    let event: ak::Event = ak::Event::from_raw(event_obj);
    let key: u16 = event.key_code();
    let mods: u64 = event.modifier_flags();

    // Preserve native selection/copy and implement paste explicitly (the view
    // is read-only so pasted text must go to the PTY, never into the transcript).
    if (mods & ak::event_modifier_flags_n_s_event_modifier_flag_command) != (0 as u64) {
        // C
        if key == (8 as u16) {
            ak::TextView::from_raw(self_obj).as_text().copy(self_obj);
            // A
        } else if key == (0 as u16) {
            ak::TextView::from_raw(self_obj).as_text().select_all(self_obj);
            // V
        } else if key == (9 as u16) {
            let pb: *u8 = rt::msg_id(rt::get_class(#str_ptr("NSPasteboard\0")), rt::sel(#str_ptr("generalPasteboard\0")));
            let ns: *u8 = rt::msg_id_id(pb, rt::sel(#str_ptr("stringForType:\0")), bridge::nsstring("public.utf8-plain-text"));
            if ns != (0 as *u8) {
                let pasted = bridge::to_text(ns);
                send(c, pasted);
            }
        }
        return;
    }

    if key == (36 as u16) || key == (76 as u16) { send(c, "\r"); return; }
    if key == (48 as u16) { send(c, "\t"); return; }
    if key == (51 as u16) { send(c, "\x7f"); return; }
    if key == (53 as u16) { send(c, "\x1b"); return; }
    if key == (123 as u16) { send(c, "\x1b[D"); return; }
    if key == (124 as u16) { send(c, "\x1b[C"); return; }
    if key == (125 as u16) { send(c, "\x1b[B"); return; }
    if key == (126 as u16) { send(c, "\x1b[A"); return; }
    if key == (115 as u16) { send(c, "\x1b[H"); return; }
    if key == (119 as u16) { send(c, "\x1b[F"); return; }
    if key == (117 as u16) { send(c, "\x1b[3~"); return; }
    if key == (116 as u16) { send(c, "\x1b[5~"); return; }
    if key == (121 as u16) { send(c, "\x1b[6~"); return; }

    match event.characters() {
        option::Option[text::Text]::Some(chars) => { send(c, chars); }
        option::Option[text::Text]::None => {}
    }
    return;
}

// Gaining or losing the keyboard produces no PTY output, so nothing would
// redraw and the cursor would keep whichever shape it had when the last byte
// arrived — the exact confusion this is meant to remove. Repaint on the
// transition instead.
//
// `objc_msgSendSuper` and the BOOL-returning no-argument `class_addMethod`
// shape are not in objc/synthesis, so both are declared here (the same way
// appkit_ext declares its own super trampolines).
#[repr(C)]
struct ObjcSuper { opaque receiver: *u8, opaque super_class: *u8 }

#[link_name = "objc_msgSendSuper"]
extern fn msg_super_i8(sup: *ObjcSuper, sel: *u8) -> i8;

#[link_name = "class_addMethod"]
extern fn add_method_i8_0(cls: *u8, sel: *u8, imp: fn(*u8, *u8) -> i8, types: *u8) -> i8;

fn call_super_i8(self_obj: *u8, sel: *u8) -> i8 {
    var sup: ObjcSuper = ObjcSuper { receiver: self_obj, super_class: rt::get_class(#str_ptr("NSTextView\0")) };
    return { msg_super_i8(#addr_of(sup), sel) };
}

// Super decides whether the change actually happens, so run it FIRST and only
// repaint if it agreed — repainting on a refused focus change would draw a
// state the view is not in.
//
// The repaint is DEFERRED by one main-queue turn, and that is load-bearing:
// -[NSWindow makeFirstResponder:] cannot update its `firstResponder` before
// calling resignFirstResponder, because resign is allowed to return NO and veto
// the change. So inside resign, the window still names THIS view as its first
// responder, view_has_focus still answers true, and a synchronous render would
// repaint the focused block that is already on screen — leaving a terminal that
// looks focused forever, since nothing else repaints until the next PTY byte.
// (becomeFirstResponder runs after the ivar is set and would read correctly;
// deferring both keeps one path instead of two.)
fn repaint_for_focus(self_obj: *u8) {
    let c: *TerminalContext = { synth::get_associated(self_obj, terminal_context_key()) as *TerminalContext };
    if c == (0 as *TerminalContext) || { (*c).cancel_requested } { return; }
    // The VIEW travels as the context, retained for the hop — never the
    // TerminalContext pointer. Widget::drop can free the context between this
    // responder change and the next turn (it frees synchronously when the source
    // already finished cancelling), and a queued repaint holding that pointer
    // would land in freed memory. Drop also clears this associated object first,
    // so re-reading it below is precisely how the deferred pass learns it must
    // do nothing.
    { dispatch_async_f(main_dispatch_queue(), rt::retain(self_obj), repaint_deferred); }
    return;
}

// The deferred half. Balances the retain above on every path.
fn repaint_deferred(ctx: *u8) {
    let c: *TerminalContext = { synth::get_associated(ctx, terminal_context_key()) as *TerminalContext };
    if c != (0 as *TerminalContext) && !{ (*c).cancel_requested } { render(c); }
    rt::release(ctx);
    return;
}

fn become_first_responder_imp(self_obj: *u8, cmd: *u8) -> i8 {
    let ok: i8 = call_super_i8(self_obj, cmd);
    if ok != (0 as i8) { repaint_for_focus(self_obj); }
    return ok;
}

fn resign_first_responder_imp(self_obj: *u8, cmd: *u8) -> i8 {
    let ok: i8 = call_super_i8(self_obj, cmd);
    if ok != (0 as i8) { repaint_for_focus(self_obj); }
    return ok;
}

// The window becoming or resigning KEY is the other half of focus, and it fires
// on the window, not the view. Registered with a nil object (any window), which
// costs a repaint when some other window changes key and saves tracking when
// this view is mounted, re-parented, or moved between windows.
fn window_key_changed(ctx: *u8) {
    let c: *TerminalContext = { ctx as *TerminalContext };
    if c == (0 as *TerminalContext) || { (*c).cancel_requested } { return; }
    render(c);
    return;
}

fn focus_obs_key_became() -> *u8 { return { 30102 as *u8 }; }
fn focus_obs_key_resigned() -> *u8 { return { 30103 as *u8 }; }

fn terminal_text_view_class() -> *u8 {
    let existing: *u8 = rt::get_class(#str_ptr("CplusTerminalTextView\0"));
    if existing != (0 as *u8) { return existing; }
    let cls: *u8 = synth::allocate_class_pair(rt::get_class(#str_ptr("NSTextView\0")), #str_ptr("CplusTerminalTextView\0"), 0 as usize);
    let _m: i8 = synth::add_method_v_1id(cls, rt::sel(#str_ptr("keyDown:\0")), key_down_imp, #str_ptr("v@:@\0"));
    let _b: i8 = { add_method_i8_0(cls, rt::sel(#str_ptr("becomeFirstResponder\0")), become_first_responder_imp, #str_ptr("c@:\0")) };
    let _r: i8 = { add_method_i8_0(cls, rt::sel(#str_ptr("resignFirstResponder\0")), resign_first_responder_imp, #str_ptr("c@:\0")) };
    synth::register_class_pair(cls);
    return cls;
}

fn new_terminal_text_view(frame: rt::Rect) -> ak::TextView {
    let alloced: *u8 = rt::msg_id(terminal_text_view_class(), rt::sel(#str_ptr("alloc\0")));
    let inited: *u8 = rt::msg_id_rect(alloced, rt::sel(#str_ptr("initWithFrame:\0")), frame);
    return ak::TextView::from_raw(rt::autorelease(inited));
}

fn resize_pty(ctx: *u8) {
    let c: *TerminalContext = { ctx as *TerminalContext };
    if c == (0 as *TerminalContext) || { (*c).cancel_requested } { return; }
    let size: rt::Size = ak::ScrollView::from_raw({ (*c).scroll_view }).content_size();
    var cols: u16 = (size.w / { (*c).cell_width }) as u16;
    var rows: u16 = (size.h / { (*c).cell_height }) as u16;
    if cols < (2 as u16) { cols = 2 as u16; }
    if rows < (1 as u16) { rows = 1 as u16; }
    let _ok: bool = { (*c).session.resize(rows, cols) };
    return;
}

fn start(
    shell: str = "/bin/zsh",
    cwd: str = "",
    max_scrollback: usize = 1048576 as usize,
    font_size: f64 = 13.0f64,
    save_history: bool = false,
) -> option::Option[Widget] {
    var session: pty::Session = match pty::start(shell, cwd: cwd, save_history: save_history) {
        option::Option[pty::Session]::Some(s) => s,
        option::Option[pty::Session]::None => { return option::Option[Widget]::None; }
    };

    let zero: rt::Rect = rt::Rect { x: 0.0f64, y: 0.0f64, w: 0.0f64, h: 0.0f64 };
    let scroll: ak::ScrollView = ak::ScrollView::new(zero);
    scroll.set_border_type(ak::BorderType::NSNoBorder);
    scroll.set_has_vertical_scroller(true);
    scroll.set_autohides_scrollers(true);
    scroll.set_draws_background(true);
    scroll.set_background_color(ak::Color::text_background_color());

    let tv: ak::TextView = new_terminal_text_view(zero);
    tv.set_editable(false);
    tv.set_selectable(true);
    tv.set_rich_text(false);
    tv.set_draws_background(true);
    tv.set_background_color(ak::Color::text_background_color());
    tv.as_text().set_text_color(ak::Color::text_color());
    let font: ak::Font = ak::Font::monospaced_system_font_of_size(font_size, 0.0f64);
    tv.as_text().set_font(font);
    tv.set_text_container_inset(rt::Size { w: 8.0f64, h: 6.0f64 });
    tv.as_view().set_autoresizing_mask(ak::autoresizing_mask_options_n_s_view_width_sizable);
    scroll.set_document_view(tv.as_view());

    let c: *TerminalContext = { malloc(#size_of::[TerminalContext]()) as *TerminalContext };
    if c == (0 as *TerminalContext) {
        session.close();
        return option::Option[Widget]::None;
    }
    { *c = TerminalContext {
        session: session,
        transcript: terminal::Transcript::new(max_bytes: max_scrollback),
        text_view: tv.raw(),
        scroll_view: scroll.raw(),
        source: 0 as *u8,
        cell_width: font.maximum_advancement().w,
        cell_height: font.ascender() - font.descender() + font.leading(),
        cancel_requested: false,
        cancel_finished: false,
        dispose_requested: false,
    }; }
    synth::set_associated(tv.raw(), terminal_context_key(), c as *u8);

    let rtld_default: *u8 = { ((0 as usize) -% (2 as usize)) as *u8 };
    let read_type: *u8 = { dlsym(rtld_default, #str_ptr("_dispatch_source_type_read\0")) };
    if read_type == (0 as *u8) {
        synth::set_associated(tv.raw(), terminal_context_key(), 0 as *u8);
        { (*c).session.close(); }
        destroy_context(c);
        return option::Option[Widget]::None;
    }
    let source: *u8 = { dispatch_source_create(read_type, { (*c).session.master_fd() } as u64, 0 as u64, main_dispatch_queue()) };
    if source == (0 as *u8) {
        synth::set_associated(tv.raw(), terminal_context_key(), 0 as *u8);
        { (*c).session.close(); }
        destroy_context(c);
        return option::Option[Widget]::None;
    }
    { (*c).source = source; }
    { dispatch_set_context(source, c as *u8); }
    { dispatch_source_set_event_handler_f(source, read_ready); }
    { dispatch_source_set_cancel_handler_f(source, cancel_finished); }
    { dispatch_resume(source); }

    akx::observe_frame_change(scroll.as_view(), resize_pty, c as *u8);
    akx::observe_notification("NSWindowDidBecomeKeyNotification", 0 as *u8, window_key_changed, c as *u8,
                              pin_on: tv.raw(), pin_key: focus_obs_key_became());
    akx::observe_notification("NSWindowDidResignKeyNotification", 0 as *u8, window_key_changed, c as *u8,
                              pin_on: tv.raw(), pin_key: focus_obs_key_resigned());
    resize_pty(c as *u8);
    return option::Option[Widget]::Some(Widget { _scroll: scroll, _ctx: c });
}

fn release_view(p: *u8) { rt::release(p); return; }

impl Widget {
    // Owned AppKit view handle. The Widget must stay alive while the terminal
    // should remain interactive.
    fn view(this) -> ak::View { return this._scroll.as_view(); }

    // Retained raw handle for facet::native(handle).
    fn native_handle(this) -> *u8 { return rt::retain(this._scroll.raw()); }

    // A fixed flex leaf. Size it with width/height/grow like any @ui widget.
    fn node(this) -> flex::Node {
        var n: flex::Node = flex::Node::new();
        n.set_payload(rt::retain(this._scroll.raw()), release_view);
        return n;
    }

    fn send(this, bytes: str) { send(this._ctx, bytes); return; }

    // Put the keyboard IN the terminal. Typing is the primary way to use a
    // terminal, so an app must be able to say where the caret is rather than
    // inherit whatever the key-view loop picked — and a keyed focus verb is not
    // available here, because a view mounted through the native escape hatch is
    // not addressable by key. Call it AFTER the widget is mounted (on_attach,
    // or a handler): false means it is not on screen yet, so there is no window
    // to hold a first responder.
    fn focus(this) -> bool {
        if this._ctx == (0 as *TerminalContext) { return false; }
        let tv: *u8 = { (*this._ctx).text_view };
        if tv == (0 as *u8) { return false; }
        let win: *u8 = rt::msg_id(tv, rt::sel(#str_ptr("window\0")));
        if win == (0 as *u8) { return false; }
        return rt::msg_i8_id(win, rt::sel(#str_ptr("makeFirstResponder:\0")), tv) != (0 as i8);
    }

    // Does the terminal currently hold the keyboard? The counterpart to focus:
    // an app that re-focuses after its own controls can ask first instead of
    // reasserting blindly.
    fn has_focus(this) -> bool {
        if this._ctx == (0 as *TerminalContext) { return false; }
        let tv: *u8 = { (*this._ctx).text_view };
        if tv == (0 as *u8) { return false; }
        let win: *u8 = rt::msg_id(tv, rt::sel(#str_ptr("window\0")));
        if win == (0 as *u8) { return false; }
        return rt::msg_id(win, rt::sel(#str_ptr("firstResponder\0"))) == tv;
    }

    fn text(this) -> text::Text {
        if this._ctx == (0 as *TerminalContext) { return text::new(); }
        return text::from_str({ (*this._ctx).transcript.view() });
    }

    fn is_running(this) -> bool {
        return this._ctx != (0 as *TerminalContext) && !{ (*this._ctx).cancel_requested };
    }

    fn stop(this) { request_cancel(this._ctx); return; }

    fn drop(ref this) {
        let c: *TerminalContext = this._ctx;
        if c == (0 as *TerminalContext) { return; }
        synth::set_associated({ (*c).text_view }, terminal_context_key(), 0 as *u8);
        { (*c).dispose_requested = true; }
        if { (*c).cancel_finished } {
            destroy_context(c);
        } else {
            request_cancel(c);
        }
        this._ctx = 0 as *TerminalContext;
        return;
    }
}
