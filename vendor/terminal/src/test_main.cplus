import "./terminal" as terminal;
import "./pty" as pty;
import "./appkit" as terminal_ui;
import "stdlib/option" as option;
import "stdlib/text" as text;

extern fn usleep(us: u32) -> i32;

#[test]
fn transcript_strips_ansi_and_osc() {
    var t: terminal::Transcript = terminal::Transcript::new();
    t.feed("plain \x1b[31mred\x1b[0m");
    t.feed("\x1b]0;window title\x07 done");
    assert t.view() == "plain red done";
}

#[test]
fn transcript_treats_cr_as_cursor_not_newline() {
    // bugs/terminal-transcript-has-no-cursor.md, symptom 1 — the prompt storm.
    // zsh repaints with `\r<prompt>` on every keystroke; when CR appended a
    // newline, each repaint became another transcript line.
    var t: terminal::Transcript = terminal::Transcript::new();
    t.feed("abc\r(base) % ");
    assert t.view() == "(base) %";      // ONE line, overwritten in place

    // CRLF must still be exactly one newline.
    var u: terminal::Transcript = terminal::Transcript::new();
    u.feed("one\r\n");
    assert u.view() == "one\n";

    // A repaint SHORTER than what it overwrites leaves the tail behind, exactly
    // as a real terminal does — nothing is implicitly cleared.
    var v: terminal::Transcript = terminal::Transcript::new();
    v.feed("longer text\rshort");
    assert v.view() == "shortr text";
    // ...which is why a shell that means to clear sends ESC[K, and it must work.
    v.feed("\x1b[K");
    assert v.view() == "short";
}

#[test]
fn transcript_backspace_moves_and_overwrites() {
    // Symptom 2. `\b space \b` is how every shell erases; the space does the
    // blanking and the trailing blank cell must not render.
    var t: terminal::Transcript = terminal::Transcript::new();
    t.feed("abc\x08 \x08");
    assert t.view() == "ab";

    // The case that separates a cursor from a delete: backspace then write.
    // A deleting backspace yields "abX" only by luck here; it diverges the
    // moment the shell overwrites more than one cell.
    var u: terminal::Transcript = terminal::Transcript::new();
    u.feed("abc\x08X");
    assert u.view() == "abX";

    // Overwriting several cells after backing up — a completion rewrite.
    var v: terminal::Transcript = terminal::Transcript::new();
    v.feed("abcdef\x08\x08\x08XYZ");
    assert v.view() == "abcXYZ";
}

#[test]
fn transcript_honours_cursor_csi() {
    // ESC[C / ESC[D were parsed and discarded; they move the cursor.
    var t: terminal::Transcript = terminal::Transcript::new();
    t.feed("abcdef");
    t.feed("\x1b[3D");        // back three cells
    t.feed("XY");
    assert t.view() == "abcXYf";

    t.feed("\x1b[1C");        // forward one, past the 'f'
    t.feed("!");
    assert t.view() == "abcXYf!";

    // ESC[K truncates from the cursor. ("keep " loses its trailing blank to
    // the same live-line trim that makes `\b space \b` render as an erase.)
    var u: terminal::Transcript = terminal::Transcript::new();
    u.feed("keep this\x1b[4D\x1b[K");
    assert u.view() == "keep";
}

#[test]
fn transcript_erase_survives_utf8() {
    // Motion steps whole scalars, so it never lands mid-character. Backing up
    // twice over "llo" puts the cursor on the first `l`, and `!` OVERWRITES it
    // — the trailing `o` survives, which is exactly the delete-vs-move
    // distinction this bug was about.
    var t: terminal::Transcript = terminal::Transcript::new();
    t.feed("héllo\x08\x08!");
    assert t.view() == "hél!o";

    // Erasing a multi-byte scalar in place must not leave a continuation byte.
    var u: terminal::Transcript = terminal::Transcript::new();
    u.feed("héllo");
    u.feed("\x1b[4D");
    u.feed("e");
    assert u.view() == "hello";
}

#[test]
fn transcript_keeps_utf8_and_bounds_scrollback() {
    var t: terminal::Transcript = terminal::Transcript::new(max_bytes: 1024 as usize);
    t.feed("héllo\n");
    var i: i32 = 0 as i32;
    while i < (200 as i32) {
        t.feed("0123456789\n");
        i = i +% (1 as i32);
    }
    assert t.count() <= (1024 as usize);
    assert t.count() > (0 as usize);
}

#[test]
fn transcript_cursor_tracks_the_live_line() {
    // The UI draws a block on this cell, so it has to be the cell the shell
    // would write next — not the end of the text.
    var t: terminal::Transcript = terminal::Transcript::new();
    t.feed("abc");
    assert t.cursor() == (3 as usize);
    t.feed("\x08");                       // BS moves left, erases nothing
    assert t.cursor() == (2 as usize);
    t.feed("\r");                         // CR is column 0, not a new line
    assert t.cursor() == (0 as usize);
    t.feed("hello\n");                    // overwrite, then commit
    assert t.view() == "hello\n";
    assert t.cursor() == t.count();       // start of the fresh line

    // Motion steps whole scalars, so the cursor never lands inside one — a
    // block drawn mid-scalar would split a character in half.
    var u: terminal::Transcript = terminal::Transcript::new();
    u.feed("hé");
    assert u.cursor() == (3 as usize);    // 1 byte + 2 bytes
    u.feed("\x1b[1D");
    assert u.cursor() == (1 as usize);    // onto the `é`, not into it
}

#[test]
fn transcript_cursor_can_sit_past_the_trimmed_view() {
    // `view()` drops the blank a shell leaves under the cursor after
    // `\b space \b`. The cursor still points AT that blank, and a renderer is
    // expected to pad it back — clamping to the view's end would draw the
    // block one cell to the left of where the shell actually is.
    var t: terminal::Transcript = terminal::Transcript::new();
    t.feed("ab\x08 \x08");
    assert t.view() == "a";
    assert t.cursor() == (1 as usize);

    var u: terminal::Transcript = terminal::Transcript::new();
    u.feed("hi ");                        // trailing blank, cursor after it
    assert u.view() == "hi";
    assert u.cursor() == (3 as usize);
}

#[test]
fn macos_pty_backend_is_present() {
    assert pty::supported();
    assert terminal_ui::supported();
}

#[test]
fn pty_starts_the_child_in_the_requested_cwd() {
    // The cwd argument had NO coverage, and it was the broken path: `start`
    // parked the directory in an Option and matched it twice, so the CString
    // was moved out and freed before forkpty and the child then chdir'd through
    // a dangling pointer. Every other test here calls `start` with no cwd,
    // which skips the whole thing — that is how it stayed broken while the
    // suite passed.
    //
    // A real round-trip is the only honest check: the child has to survive to
    // exec, and `pwd` has to come back naming the directory we asked for. Uses
    // /usr because /tmp is a symlink and getcwd would resolve it to
    // /private/tmp.
    match pty::start(shell: "/bin/sh", cwd: "/usr") {
        option::Option[pty::Session]::Some(s) => {
            var sess: pty::Session = s;
            let _w: isize = sess.write("pwd\n");

            var buf: [u8; 4096] = [0 as u8; 4096];
            var seen: text::Text = text::new();
            var tries: i32 = 0 as i32;
            // Bounded: the master fd is non-blocking, so this polls rather than
            // hanging the suite if the child never speaks.
            while tries < (400 as i32) {
                match sess.read_into(#addr_of(buf) as *u8, 4096 as usize) {
                    pty::ReadResult::Data(n) => {
                        seen.append({ #str_from_raw_parts(#addr_of(buf) as *u8, n) });
                    }
                    pty::ReadResult::WouldBlock => { let _u: i32 = { usleep(5000 as u32) }; }
                    pty::ReadResult::Closed => { break; }
                    pty::ReadResult::Failed => { break; }
                }
                if seen.contains("/usr") { break; }
                tries = tries +% (1 as i32);
            }
            assert seen.contains("/usr");
        }
        option::Option[pty::Session]::None => { assert false; }
    }
    return;
}

#[test]
fn widget_focus_reports_failure_off_screen() {
    // Typing is the primary way to drive a terminal, so `focus` is part of the
    // widget's contract — and its honest answer when the widget is not mounted
    // is FALSE. A window is what holds a first responder; without one there is
    // nothing to give the keyboard to, and silently returning true would let an
    // app believe its pane was ready to type into.
    match terminal_ui::start() {
        option::Option[terminal_ui::Widget]::Some(w) => {
            assert w.is_running();
            assert !w.focus();
            assert !w.has_focus();
            w.stop();
            assert !w.is_running();
            // Focus stays false on a stopped widget rather than trapping.
            assert !w.focus();
        }
        option::Option[terminal_ui::Widget]::None => { assert false; }
    };
    return;
}
