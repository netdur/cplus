import "./terminal" as terminal;
import "./pty" as pty;
import "./widget" as terminal_widget;
import "stdlib/option" as option;
import "stdlib/text" as text;
// THE PLATFORM'S WIDGET TESTS, which are not portable and used to live here.
// Imported rather than merely present in `src/`: a module nothing names is a
// module nothing compiles, and these are part of the gate. The resolver picks
// `test_widget_linux.cplus` on Linux.
import "./test_platform" as _;

extern fn usleep(us: u32) -> i32;

// ---- the screen model -------------------------------------------------------
//
// These pin the behaviour the previous line-buffer model got right, because a
// grid has to keep every one of them: CR is cursor motion rather than a line
// break, backspace MOVES, and the blank a shell leaves under the cursor does
// not render. bugs/terminal-transcript-has-no-cursor.md is why they exist.

#[test]
fn screen_strips_ansi_and_osc() {
    var t: terminal::Screen = terminal::new();
    t.feed("plain \x1b[31mred\x1b[0m");
    t.feed("\x1b]0;window title\x07 done");
    assert t.view() == "plain red done";
    assert t.title() == "window title";
}

#[test]
fn screen_treats_cr_as_cursor_not_newline() {
    // The prompt storm: zsh repaints with `\r<prompt>` on every keystroke, and
    // when CR appended a newline each repaint became another transcript line.
    var t: terminal::Screen = terminal::new();
    t.feed("abc\r(base) % ");
    assert t.view() == "(base) %";      // ONE line, overwritten in place

    var u: terminal::Screen = terminal::new();
    u.feed("one\r\n");
    assert u.view() == "one\n";

    // A repaint SHORTER than what it overwrites leaves the tail behind, exactly
    // as a real terminal does — nothing is implicitly cleared.
    var v: terminal::Screen = terminal::new();
    v.feed("longer text\rshort");
    assert v.view() == "shortr text";
    // ...which is why a shell that means to clear sends ESC[K, and it must work.
    v.feed("\x1b[K");
    assert v.view() == "short";
}

#[test]
fn screen_backspace_moves_and_overwrites() {
    // `\b space \b` is how every shell erases; the space does the blanking and
    // the trailing blank cell must not render.
    var t: terminal::Screen = terminal::new();
    t.feed("abc\x08 \x08");
    assert t.view() == "ab";

    // The case that separates a cursor from a delete: backspace then write.
    var u: terminal::Screen = terminal::new();
    u.feed("abc\x08X");
    assert u.view() == "abX";

    // Overwriting several cells after backing up — a completion rewrite.
    var v: terminal::Screen = terminal::new();
    v.feed("abcdef\x08\x08\x08XYZ");
    assert v.view() == "abcXYZ";
}

#[test]
fn screen_honours_cursor_csi() {
    var t: terminal::Screen = terminal::new();
    t.feed("abcdef");
    t.feed("\x1b[3D");        // back three cells
    t.feed("XY");
    assert t.view() == "abcXYf";

    t.feed("\x1b[1C");        // forward one, past the 'f'
    t.feed("!");
    assert t.view() == "abcXYf!";

    var u: terminal::Screen = terminal::new();
    u.feed("keep this\x1b[4D\x1b[K");
    assert u.view() == "keep";
}

#[test]
fn screen_erase_survives_utf8() {
    // Motion steps whole scalars, so it never lands mid-character. Backing up
    // twice over "llo" puts the cursor on the first `l`, and `!` OVERWRITES it.
    var t: terminal::Screen = terminal::new();
    t.feed("héllo\x08\x08!");
    assert t.view() == "hél!o";

    // Erasing a multi-byte scalar in place must not leave a continuation byte.
    var u: terminal::Screen = terminal::new();
    u.feed("héllo");
    u.feed("\x1b[4D");
    u.feed("e");
    assert u.view() == "hello";
}

#[test]
fn screen_cursor_tracks_the_live_line() {
    // The UI draws a block on this cell, so it has to be the cell the shell
    // would write next — not the end of the text.
    var t: terminal::Screen = terminal::new();
    t.feed("abc");
    assert t.cursor() == (3 as usize);
    t.feed("\x08");                       // BS moves left, erases nothing
    assert t.cursor() == (2 as usize);
    t.feed("\r");                         // CR is column 0, not a new line
    assert t.cursor() == (0 as usize);
    t.feed("hello\n");                    // overwrite, then commit
    assert t.view() == "hello\n";
    assert t.cursor() == t.count();       // start of the fresh line

    var u: terminal::Screen = terminal::new();
    u.feed("hé");
    assert u.cursor() == (3 as usize);    // 1 byte + 2 bytes
    u.feed("\x1b[1D");
    assert u.cursor() == (1 as usize);    // onto the `é`, not into it
}

#[test]
fn screen_cursor_can_sit_past_the_trimmed_view() {
    // `view()` drops the blank a shell leaves under the cursor after
    // `\b space \b`. The cursor still points AT that blank, and a renderer pads
    // it back — clamping to the view's end would draw the block one cell left of
    // where the shell actually is.
    var t: terminal::Screen = terminal::new();
    t.feed("ab\x08 \x08");
    assert t.view() == "a";
    assert t.cursor() == (1 as usize);

    var u: terminal::Screen = terminal::new();
    u.feed("hi ");                        // trailing blank, cursor after it
    assert u.view() == "hi";
    assert u.cursor() == (3 as usize);
}

// ---- what the grid added ----------------------------------------------------

#[test]
fn clear_empties_the_pane() {
    // `clear` sends `ESC[H ESC[2J ESC[3J`, and the old model stripped all three,
    // so the command did nothing whatsoever.
    var s: terminal::Screen = terminal::new(rows: 5 as u16, cols: 20 as u16);
    var i: i32 = 0 as i32;
    while i < (12 as i32) {
        s.feed("line\r\n");
        i = i +% (1 as i32);
    }
    assert s.count() > (0 as usize);

    s.feed("\x1b[H\x1b[2J\x1b[3J");
    assert s.view() == "";
    assert s.cursor() == (0 as usize);

    // ...and the prompt that follows lands at the top.
    s.feed("host% ");
    assert s.view() == "host%";
}

#[test]
fn erase_display_alone_does_not_touch_history() {
    var s: terminal::Screen = terminal::new(rows: 3 as u16, cols: 10 as u16);
    s.feed("a\r\nb\r\nc\r\nd\r\n");        // 'a' and 'b' have scrolled off
    assert s.scrollback() == "a\nb\n";
    assert s.view() == "a\nb\nc\nd\n";

    // `2J` blanks the SCREEN; only `ESC[3J` touches history, which is why
    // `clear` sends both. It does not move the cursor either, so the blank rows
    // above it are still screen and still render.
    s.feed("\x1b[2J");
    assert s.scrollback() == "a\nb\n";
    assert s.view() == "a\nb\n\n\n";
}

#[test]
fn absolute_addressing_lands_on_the_right_cell() {
    // `top` addresses with `ESC[<n>d` and `ESC[<n>G`, which a line buffer has
    // nowhere to put.
    var s: terminal::Screen = terminal::new(rows: 5 as u16, cols: 20 as u16);
    s.feed("\x1b[3;5Hmid");
    assert s.view() == "\n\n    mid";
    s.feed("\x1b[1;1Htop");
    assert s.view() == "top\n\n    mid";
    s.feed("\x1b[5d\x1b[2Gbottom");
    assert s.view() == "top\n\n    mid\n\n bottom";
}

#[test]
fn the_alternate_screen_restores_what_was_underneath() {
    // What `top` does: take the screen, draw on it, give it back on quit.
    var s: terminal::Screen = terminal::new(rows: 4 as u16, cols: 20 as u16);
    s.feed("prompt$ top\r\n");
    assert !s.alternate_screen();

    s.feed("\x1b[?1049h");
    assert s.alternate_screen();
    s.feed("\x1b[1;24r\x1b[H\x1b[2JProcesses: 500\r\nLoad Avg: 1.20");
    assert s.view() == "Processes: 500\nLoad Avg: 1.20";

    s.feed("\x1b[?1049l");
    assert !s.alternate_screen();
    assert s.view() == "prompt$ top\n";
}

#[test]
fn a_scroll_region_scrolls_only_inside_itself() {
    var s: terminal::Screen = terminal::new(rows: 5 as u16, cols: 10 as u16);
    s.feed("\x1b[HTOP\r\n");
    s.feed("\x1b[2;4r");                  // region is rows 2..4
    s.feed("\x1b[2;1Hone\r\ntwo\r\nthree\r\nfour");
    // "one" scrolled out of the region; TOP is untouched.
    assert s.view() == "TOP\ntwo\nthree\nfour";
    // Nothing left the top of the SCREEN, so nothing became history.
    assert s.scrollback() == "";
}

#[test]
fn autowrap_is_deferred_and_joins_the_logical_line() {
    // A row filled EXACTLY to the width must not leave a blank row behind: a VT
    // wraps on the next write, not on the one that filled the row.
    var s: terminal::Screen = terminal::new(rows: 4 as u16, cols: 5 as u16);
    s.feed("abcde\r\nxy");
    assert s.view() == "abcde\nxy";

    // One past the width: the wrap fires, and the two rows read back as the one
    // logical line they are — so copying a long command line out gives a line.
    var w: terminal::Screen = terminal::new(rows: 4 as u16, cols: 5 as u16);
    w.feed("abcdefg");
    assert w.view() == "abcdefg";
    assert w.cursor() == (7 as usize);
}

#[test]
fn scrollback_holds_logical_lines_and_is_bounded() {
    var s: terminal::Screen = terminal::new(rows: 3 as u16, cols: 8 as u16, max_scrollback: 1024 as usize);
    var i: i32 = 0 as i32;
    while i < (400 as i32) {
        s.feed("0123456\r\n");
        i = i +% (1 as i32);
    }
    assert s.scrollback().count() <= (1024 as usize);
    assert s.scrollback().count() > (0 as usize);
    assert s.view().count() > (0 as usize);
}

#[test]
fn insert_and_delete_edit_the_row() {
    var s: terminal::Screen = terminal::new(rows: 2 as u16, cols: 10 as u16);
    s.feed("abcdef\x1b[1;3H\x1b[2P");        // delete 2 at column 3
    assert s.view() == "abef";
    s.feed("\x1b[1;3H\x1b[2@");              // insert 2 blanks
    assert s.view() == "ab  ef";
    s.feed("\x1b[1;1H\x1b[3X");              // erase 3 in place
    assert s.view() == "    ef";
}

#[test]
fn insert_and_delete_move_whole_rows() {
    var s: terminal::Screen = terminal::new(rows: 4 as u16, cols: 6 as u16);
    s.feed("\x1b[Hone\r\ntwo\r\nthree");
    s.feed("\x1b[2;1H\x1b[L");               // insert a line above "two"
    assert s.view() == "one\n\ntwo\nthree";
    s.feed("\x1b[2;1H\x1b[M");               // take it back out
    assert s.view() == "one\ntwo\nthree";
}

#[test]
fn dec_graphics_draws_a_box_not_letters() {
    // Without the translation an ncurses frame renders as `lqqk`.
    var s: terminal::Screen = terminal::new(rows: 2 as u16, cols: 10 as u16);
    s.feed("\x1b(0lqqk\x1b(B");
    assert s.view() == "┌──┐";
}

#[test]
fn a_query_gets_an_answer_back() {
    // A program that asks where the cursor is and never hears back just waits.
    var s: terminal::Screen = terminal::new(rows: 10 as u16, cols: 40 as u16);
    assert !s.has_reply();
    s.feed("\x1b[3;7H\x1b[6n");
    assert s.has_reply();
    assert s.reply() == "\x1b[3;7R";
    s.clear_reply();
    assert !s.has_reply();

    s.feed("\x1b[c");
    assert s.reply() == "\x1b[?1;2c";
}

#[test]
fn wide_scalars_take_two_columns() {
    var s: terminal::Screen = terminal::new(rows: 2 as u16, cols: 6 as u16);
    s.feed("日本");
    assert s.view() == "日本";
    assert s.cursor() == (6 as usize);       // 2 scalars x 3 bytes
    s.feed("語");                             // does not fit in 6 columns
    assert s.view() == "日本語";
}

#[test]
fn modes_the_key_path_depends_on() {
    var s: terminal::Screen = terminal::new();
    assert !s.application_cursor_keys();
    assert !s.bracketed_paste();
    assert s.cursor_visible();
    s.feed("\x1b[?1h\x1b[?2004h\x1b[?25l");
    assert s.application_cursor_keys();
    assert s.bracketed_paste();
    assert !s.cursor_visible();
    s.feed("\x1b[?1l\x1b[?2004l\x1b[?25h");
    assert !s.application_cursor_keys();
    assert !s.bracketed_paste();
    assert s.cursor_visible();
}

#[test]
fn resize_keeps_the_prompt_and_banks_the_rest() {
    var s: terminal::Screen = terminal::new(rows: 4 as u16, cols: 10 as u16);
    s.feed("\x1b[Hone\r\ntwo\r\nthree\r\nhost% ");
    assert s.view() == "one\ntwo\nthree\nhost%";
    s.resize(2 as u16, 10 as u16);
    // The cursor row survives; the rows above it became history rather than
    // being dropped.
    assert s.view() == "one\ntwo\nthree\nhost%";
    assert s.scrollback() == "one\ntwo\n";
    s.resize(6 as u16, 10 as u16);
    assert s.view() == "one\ntwo\nthree\nhost%";
}

#[test]
fn a_scalar_split_across_feeds_is_still_one_scalar() {
    // Chunk boundaries fall wherever the pseudo-terminal put them, which is not
    // where UTF-8 scalars end.
    var first: [u8; 2] = [0 as u8; 2];
    first[0] = 0x68 as u8;                   // 'h'
    first[1] = 0xc3 as u8;                   // first half of 'é'
    var second: [u8; 4] = [0 as u8; 4];
    second[0] = 0xa9 as u8;                  // second half of 'é'
    second[1] = 0x6c as u8;
    second[2] = 0x6c as u8;
    second[3] = 0x6f as u8;

    var s: terminal::Screen = terminal::new();
    s.feed({ #str_from_raw_parts(#addr_of(first) as *u8, 2 as usize) });
    s.feed({ #str_from_raw_parts(#addr_of(second) as *u8, 4 as usize) });
    assert s.view() == "héllo";
}

// ---- the command ledger -----------------------------------------------------

#[test]
fn command_marks_report_the_exit_code() {
    var s: terminal::Screen = terminal::new(rows: 6 as u16, cols: 40 as u16);
    assert !s.has_integration();
    assert s.command_state() == terminal::CommandState::Idle;

    s.feed("\x1b]133;A\x07host% ");
    assert s.has_integration();
    assert s.command_state() == terminal::CommandState::Idle;

    s.feed("cpc build\r\n\x1b]133;C;cpc build\x07");
    assert s.command_state() == terminal::CommandState::Running;
    assert s.command_line() == "cpc build";
    assert s.command_id() == (1 as u64);
    assert s.finished_count() == (0 as u64);

    s.feed("error: nope\r\n");
    let running: text::Text = s.output();
    assert running.equals("error: nope\n");

    s.feed("\x1b]133;D;1\x07");
    assert s.command_state() == terminal::CommandState::Done;
    assert s.exit_code() == (1 as i32);
    assert s.finished_count() == (1 as u64);

    s.feed("\x1b]133;A\x07host% ");
    assert s.command_state() == terminal::CommandState::Idle;
    // The prompt drawn AFTER the command must not have grown into its output.
    let done: text::Text = s.output();
    assert done.equals("error: nope\n");

    // A second command gets a fresh id and its own output.
    s.feed("\x1b]133;C;true\x07\x1b]133;D;0\x07");
    assert s.command_id() == (2 as u64);
    assert s.exit_code() == (0 as i32);
    assert s.finished_count() == (2 as u64);
}

#[test]
fn captured_output_is_what_reached_the_screen() {
    // zsh writes its partial-line marker — a reverse-video `%` padded to the
    // full width — BEFORE running precmd, and erases it with `ESC[J` only
    // AFTER. So it lands inside the command's region on the wire while never
    // being visible for an instant. Capturing printable bytes put it on the end
    // of every command's output; capturing the grid does not.
    var s: terminal::Screen = terminal::new(rows: 6 as u16, cols: 20 as u16);
    s.feed("\x1b]133;C;printf hi\x07");
    s.feed("hi\r\n");
    s.feed("\x1b[7m%\x1b[27m                   \r \r");   // the marker
    s.feed("\x1b]133;D;0\x07");
    let out: text::Text = s.output();
    assert out.equals("hi\n");
}

#[test]
fn osc_7_reports_the_working_directory() {
    var s: terminal::Screen = terminal::new();
    s.feed("\x1b]7;file://mac.local/Users/adel/Workspace\x07");
    assert s.cwd() == "/Users/adel/Workspace";
    // ST-terminated as well as BEL-terminated.
    s.feed("\x1b]7;file://mac.local/tmp\x1b\\");
    assert s.cwd() == "/tmp";
}

// ---- the pseudo-terminal ----------------------------------------------------

fn read_all(ref sess: pty::Session, ref s: terminal::Screen, tries: i32) {
    var buf: [u8; 4096] = [0 as u8; 4096];
    var n: i32 = 0 as i32;
    while n < tries {
        match sess.read_into(#addr_of(buf) as *u8, 4096 as usize) {
            pty::ReadResult::Data(k) => {
                s.feed({ #str_from_raw_parts(#addr_of(buf) as *u8, k) });
            }
            pty::ReadResult::WouldBlock => { let _u: i32 = { usleep(5000 as u32) }; }
            pty::ReadResult::Closed => { break; }
            pty::ReadResult::Failed => { break; }
        }
        n = n +% (1 as i32);
    }
    return;
}








