// terminal/widget — portable facet-facing terminal widget.
//
// Applications use this module rather than naming AppKit. The owned Widget
// keeps the platform session alive; node() returns a portable facet native
// escape-hatch node. A future backend keeps this surface and replaces only the
// platform implementation selected underneath it.

import "./appkit" as backend;
import "./terminal" as terminal;
import "stdlib/option" as option;
import "stdlib/text" as text;
import "facet/facet" as facet;

struct Widget {
    _backend: backend::Widget,
}

// Re-exported so an application can name the state without importing the screen
// model as well.
fn state_idle() -> terminal::CommandState { return terminal::CommandState::Idle; }
fn state_running() -> terminal::CommandState { return terminal::CommandState::Running; }
fn state_done() -> terminal::CommandState { return terminal::CommandState::Done; }

fn supported() -> bool { return backend::supported(); }

fn start(
    shell: str = "/bin/zsh",
    cwd: str = "",
    max_scrollback: usize = 1048576 as usize,
    font_size: f64 = 13.0f64,
    // Off by default: an app pane must not write the user's global shell
    // history. Pass true for a terminal meant to behave like the real one.
    save_history: bool = false,
) -> option::Option[Widget] {
    return match backend::start(
        shell,
        cwd: cwd,
        max_scrollback: max_scrollback,
        font_size: font_size,
        save_history: save_history,
    ) {
        option::Option[backend::Widget]::Some(w) => {
            option::Option[Widget]::Some(Widget { _backend: w })
        }
        option::Option[backend::Widget]::None => option::Option[Widget]::None,
    };
}

impl Widget {
    // The node owns its own retain on the native view. Keep Widget itself alive
    // for as long as the terminal should remain interactive.
    fn node(this, key: str = "") -> facet::Node {
        return facet::adopt_native(this._backend.native_handle(),
                                   backend::release_view, key: key);
    }

    fn send(this, bytes: str) {
        this._backend.send(bytes);
        return;
    }

    // Give the terminal the keyboard, so the user can type into the shell the
    // way they would in any terminal. Call it after the widget is mounted —
    // `on_attach` for a launch-ready caret, and again at the end of a handler
    // that runs one of the app's own controls, since clicking a button can take
    // focus away. False = not on screen yet.
    fn focus(this) -> bool {
        return this._backend.focus();
    }

    fn has_focus(this) -> bool {
        return this._backend.has_focus();
    }

    fn text(this) -> text::Text {
        return this._backend.text();
    }

    fn is_running(this) -> bool {
        return this._backend.is_running();
    }

    fn stop(this) {
        this._backend.stop();
        return;
    }

    // ---- driving commands ---------------------------------------------------
    //
    // A terminal that can only be typed into is not enough for an application
    // that runs builds in one: it has to know when the build finished and
    // whether it worked. The shell reports both through prompt/command marks
    // that `terminal/pty` installs, and this is where they surface.
    //
    //     let id: u64 = term.run("cpc build");
    //     // ...later, from on_command_end or a poll:
    //     match term.exit_code() {
    //         option::Option[i32]::Some(0) => { /* built */ }
    //         option::Option[i32]::Some(_) => { show(term.output()); }
    //         option::Option[i32]::None    => { /* still running */ }
    //     }

    // Run `command`. Returns the id it will be given, or 0 if it was not sent
    // because the session is stopped or the previous command is still running.
    fn run(this, command: str) -> u64 {
        return this._backend.run(command);
    }

    // Interrupt whatever is running, as ^C does.
    fn interrupt(this) {
        this._backend.interrupt();
        return;
    }

    // Empty the pane: the screen and the scrollback both, without sending the
    // shell a thing. An app that runs its builds here calls it before the first
    // command of a run, so what the user reads is that run and nothing older —
    // and unlike typing `clear`, the command line about to be echoed survives.
    //
    // A command that is still running is NOT stopped and its screen is emptied
    // under it. Ask `command_state` first if that matters.
    fn clear(this) {
        this._backend.clear();
        return;
    }

    fn has_integration(this) -> bool { return this._backend.has_integration(); }
    fn command_state(this) -> terminal::CommandState { return this._backend.command_state(); }
    fn command_id(this) -> u64 { return this._backend.command_id(); }
    fn command_line(this) -> text::Text { return this._backend.command_line(); }

    // The exit status of the last command that finished; `None` while one is
    // still running, and before any has run.
    fn exit_code(this) -> option::Option[i32] { return this._backend.exit_code(); }

    fn finished_count(this) -> u64 { return this._backend.finished_count(); }

    // What the running or last-finished command put on the screen.
    fn output(this) -> text::Text { return this._backend.output(); }

    fn cwd(this) -> text::Text { return this._backend.cwd(); }
    fn title(this) -> text::Text { return this._backend.title(); }

    // Is a full-screen program up (`vim`, `top`)? Worth asking before sending
    // the shell a command it will not see.
    fn alternate_screen(this) -> bool { return this._backend.alternate_screen(); }

    // Called on the main thread once per command that finishes.
    fn on_command_end(this, handler: fn(*u8), ctx: *u8 = 0 as *u8) {
        this._backend.on_command_end(handler, ctx);
        return;
    }

    // Called once when the shell itself goes away.
    fn on_exit(this, handler: fn(*u8), ctx: *u8 = 0 as *u8) {
        this._backend.on_exit(handler, ctx);
        return;
    }

    fn shell_exit_code(this) -> option::Option[i32] { return this._backend.shell_exit_code(); }
}
