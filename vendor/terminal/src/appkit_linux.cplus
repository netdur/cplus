// The Linux face of `terminal/appkit` — a forwarder to the GTK half.
//
// WHY THIS FILE EXISTS, and it is the same reason `inspector/appkit_ios.cplus`
// gives: a prebuilt package is compiled from a generated entry that imports
// EVERY module in `src/`, so the archive covers the whole public surface. That
// is right for a portable package and wrong for a module that is one platform's
// half — `appkit.cplus` imports the `appkit` package, which is a
// `[macos.dependencies]` and is not linked here, so the Linux slice carried
// references to it and any consumer died at the link on symbols named after a
// package it never asked for. That is exactly what happened: `objc.src.runtime.sel`,
// `appkit.src.appkit.ScrollView.drop`, and sixty more.
//
// IT FORWARDS RATHER THAN REFUSES. `gtk.cplus` is the GTK twin of
// `appkit.cplus` — same surface, same job — so `terminal/appkit` means the
// platform half on BOTH platforms instead of quietly meaning nothing on one.
// `widget.cplus` names `./appkit` and needs no change.

import "./gtk" as gtk;
import "./terminal" as terminal;
import "stdlib/option" as option;
import "stdlib/text" as text;
import "flex_layout/flex_layout" as flex;

// The type `widget.cplus` names as `backend::Widget`. A forwarding FUNCTION
// cannot re-export a type, and the alias is what makes `terminal/appkit` mean
// one surface on both platforms rather than most of one and a hole.
type Widget = gtk::Widget;

fn supported() -> bool { return gtk::supported(); }

fn start(
    shell: str = "",
    cwd: str = "",
    max_scrollback: usize = 1048576 as usize,
    font_size: f64 = 13.0f64,
    save_history: bool = false,
) -> option::Option[Widget] {
    return gtk::start(shell, cwd: cwd, max_scrollback: max_scrollback,
                      font_size: font_size, save_history: save_history);
}

fn release_view(p: *u8) { gtk::release_view(p); return; }
