// terminal/ptysys_linux — the Linux half of `ptysys.cplus`.
//
// Read that file first: it declares the seam and this one answers the same
// verbs. Four libc numbers, the platform's own shell, and the shell-integration
// story — which is where the two genuinely differ.
//
// ---- bash is not zsh, and ZDOTDIR has no counterpart -------------------------
//
// The Darwin half points ZDOTDIR at a directory of shim rc files, because zsh
// reads `$ZDOTDIR/.zshrc` and macOS's own `/etc/zshrc` honours the variable.
// BASH HAS NO SUCH VARIABLE. What it has is `--rcfile FILE`, which replaces
// `~/.bashrc` for an interactive shell — so the integration is a file named on
// the COMMAND LINE rather than found through the environment, and that is why
// `exec_shell` exists as a seam at all.
//
// One consequence worth stating: the pane is `-i` here and `-l` there. bash
// reads `--rcfile` only for an interactive NON-login shell — a login bash reads
// `/etc/profile` and `~/.bash_profile` and ignores the flag entirely — so
// asking for both would silently drop the integration. An interactive shell is
// what a terminal pane is, and it is what VS Code launches for the same reason.
//
// A LINUX BOX MAY WELL RUN ZSH, and then the zsh mechanism is the right one:
// `ZDOTDIR` is zsh's own and owes nothing to macOS. So this file installs the
// ZDOTDIR shim for a zsh shell and the rcfile for a bash one, and the
// `Integration` it answers says which.

import "stdlib/option" as option;
import "stdlib/text" as text;
import "stdlib/env" as env;
import "stdlib/fs" as fs;
import "stdlib/result" as result;
import "stdlib/status" as status;

extern fn setenv(name: *u8, value: *u8, overwrite: i32) -> i32;
extern fn unsetenv(name: *u8) -> i32;
extern fn execl(path: *u8, arg0: *u8, ...) -> i32;
// glibc publishes errno's address as `__errno_location`, where Darwin uses
// `__error`. Same value, different symbol — and getting it wrong is a link
// error rather than a wrong answer.
extern fn __errno_location() -> *i32;

// ---- the four numbers --------------------------------------------------------

fn errno_value() -> i32 { return { *{ __errno_location() } }; }

// Linux `O_NONBLOCK` is 04000 octal — not Darwin's 4, which on Linux is
// `O_WRONLY|O_RDWR` nonsense. `stdlib/netsys_linux` names the same bit.
fn o_nonblock() -> i32 { return 0x800 as i32; }

// Linux `EAGAIN`, which is also `EWOULDBLOCK`.
fn eagain() -> i32 { return 11 as i32; }

// `EIO` — what a PTY reports once its peer has closed. The same value
// everywhere POSIX.
fn eio() -> i32 { return 5 as i32; }

// Linux `TIOCSWINSZ` from <asm-generic/ioctls.h>. A plain number here, where
// Darwin encodes direction and size into the request.
fn tiocswinsz() -> u64 { return 0x5414 as u64; }

// The shell a Linux distribution installs and makes the default. zsh is
// available everywhere and default almost nowhere.
fn default_shell() -> str { return "/bin/bash"; }

// ---- the integration ---------------------------------------------------------

// DECLARED IDENTICALLY IN BOTH SYS FILES — `pty.cplus` names the fields and must
// not care which one it compiled against. See `ptysys.cplus` for what each means.
struct Integration {
    rc: text::Text,
    use_rcfile: bool,
    marks: bool,
}

fn no_integration() -> Integration {
    return Integration { rc: text::new(), use_rcfile: false, marks: false };
}

// The directory both flavours of shim live in. The two history dispositions get
// SEPARATE directories for the reason the Darwin half documents: an app that
// opens a pane of each kind would otherwise have the second rewrite change what
// the first pane reads on any later startup stage.
fn integration_dir(kill_history: bool) -> option::Option[text::Text] {
    var base: text::Text = match env::var("TMPDIR") {
        option::Option[text::Text]::Some(t) => t,
        option::Option[text::Text]::None => text::from_str("/tmp/"),
    };
    if base.has_suffix("/") == false { let _s: status::Status = base.append("/"); }
    let flavour: str = if kill_history { "nohist" } else { "hist" };
    let dir: text::Text = "${base}cplus-terminal-rc-${flavour}";
    match fs::create_dir_all(dir.view()) {
        result::Result[bool, result::IoError]::Ok(_) => {}
        result::Result[bool, result::IoError]::Err(_) => {
            return option::Option[text::Text]::None;
        }
    }
    return option::Option[text::Text]::Some(dir);
}

// ---- bash's OSC 133 ----------------------------------------------------------
//
// The same marks the zsh half emits — `133;C` when a line is accepted, `133;D`
// with the status before the next prompt, `133;A` at the prompt, and `OSC 7`
// for the cwd — so `terminal/terminal` parses ONE vocabulary and the ledger
// does not learn which shell produced it.
//
// THE HOOKS ARE WHERE BASH DIFFERS, and the difference is the whole difficulty.
// zsh has `preexec`, which fires once per accepted line. bash has `trap ...
// DEBUG`, which fires before EVERY SIMPLE COMMAND — including every command
// inside the very PROMPT_COMMAND that draws the next prompt. Two guards make it
// fire once per line, and both were paid for:
//
//   * THE LATCH. `__cplus_at_prompt` is set when the prompt is drawn and
//     cleared by the first command after it, so a `for` loop reports one start
//     rather than one per iteration.
//   * THE SELF-GUARD. Without it the trap reports OUR OWN prompt command:
//     `__cplus_precmd` is itself a simple command, the trap fires for it with
//     the latch still set from the previous prompt, and the ledger recorded
//     `command_line=[__cplus_precmd]` and counted TWO commands for one typed
//     line. Measured, not guessed.
//
// AND THE HOOK IS APPENDED, NOT PREPENDED. A user who already has a
// PROMPT_COMMAND runs their commands at the prompt too, and every one of them
// fires the trap. Running ours LAST means the latch is still clear while theirs
// run — so they are ignored — and is set only once the prompt is really
// finished. Prepending put ours first and reported the user's own prompt
// command as the user's command.
//
// `$BASH_COMMAND` is the line the trap is firing for, which is what `$1` is to
// zsh's preexec. A newline inside an OSC payload terminates the sequence early
// and sprays the rest across the screen, so it is collapsed rather than sent —
// the same hazard the zsh half handles by falling back to preexec's `$2`.
//
// `local __cplus_st=$?` has to be the FIRST line of the prompt command, or
// bash's own bookkeeping has already overwritten the status we came for.
//
// WHAT THIS MECHANISM CANNOT SEE, stated because it is a real narrowing against
// the zsh half rather than an oversight: bash runs the DEBUG trap "before each
// simple command, for command, case command, select command, arithmetic for
// command, and before the first command of a function". A BARE SUBSHELL —
// `(exit 3)` — is none of those, so it gets no start mark and therefore no end
// one, and the pane reports the previous command's status. zsh's `preexec`
// fires on the LINE and has no such gap. `set -T` would propagate the trap into
// subshells and also into every function body, which floods the ledger with
// commands nobody typed; the narrowing is the better trade. Wrap it in a
// simple command (`sh -c 'exit 3'`) and it is reported like anything else.
//
// No `${...}` anywhere below, deliberately: that is C+ string interpolation and
// would be eaten before bash ever saw it. `$1`, `$?`, `$PWD` and `$(...)` are
// all safe; braces are not.
fn marks_rc() -> text::Text {
    var t: text::Text = text::new();
    let _a: status::Status = t.append("\n# Command marks for terminal/pty. OSC 133, as iTerm2 and VS Code use.\n");
    let _b: status::Status = t.append("if [ -z \"$CPLUS_TERM_MARKS\" ]; then\n");
    let _c: status::Status = t.append("  CPLUS_TERM_MARKS=1\n");
    let _d: status::Status = t.append("  __cplus_preexec() {\n");
    // Completion runs commands too, and none of them is a line the user ran.
    let _e: status::Status = t.append("    [ -n \"$COMP_LINE\" ] && return\n");
    // OUR OWN prompt command, which the trap sees like any other.
    let _f: status::Status = t.append("    case \"$BASH_COMMAND\" in __cplus_precmd*) return ;; esac\n");
    let _g: status::Status = t.append("    [ -z \"$__cplus_at_prompt\" ] && return\n");
    let _h: status::Status = t.append("    __cplus_at_prompt=\n");
    let _i: status::Status = t.append("    __cplus_ran=1\n");
    let _j: status::Status = t.append("    __cplus_c=$BASH_COMMAND\n");
    let _k: status::Status = t.append("    __cplus_c=$(printf '%s' \"$__cplus_c\" | tr '\\n' ' ')\n");
    let _l: status::Status = t.append("    printf '\\033]133;C;%s\\007' \"$__cplus_c\"\n");
    let _m: status::Status = t.append("  }\n");
    let _n: status::Status = t.append("  __cplus_precmd() {\n");
    let _o: status::Status = t.append("    local __cplus_st=$?\n");
    let _p: status::Status = t.append("    if [ -n \"$__cplus_ran\" ]; then\n");
    let _q: status::Status = t.append("      unset __cplus_ran\n");
    let _r: status::Status = t.append("      printf '\\033]133;D;%d\\007' $__cplus_st\n");
    let _s: status::Status = t.append("    fi\n");
    let _t2: status::Status = t.append("    printf '\\033]7;file://%s%s\\007' \"$HOSTNAME\" \"$PWD\"\n");
    let _u: status::Status = t.append("    printf '\\033]133;A\\007'\n");
    // LAST, and that ordering is the guard described above: everything the
    // prompt still has to do runs with the latch clear.
    let _v: status::Status = t.append("    __cplus_at_prompt=1\n");
    let _w: status::Status = t.append("  }\n");
    let _x: status::Status = t.append("  trap '__cplus_preexec' DEBUG\n");
    let _y: status::Status = t.append("  if [ -n \"$PROMPT_COMMAND\" ]; then\n");
    let _z: status::Status = t.append("    PROMPT_COMMAND=\"$PROMPT_COMMAND;__cplus_precmd\"\n");
    let _z1: status::Status = t.append("  else\n");
    let _z2: status::Status = t.append("    PROMPT_COMMAND=__cplus_precmd\n");
    let _z3: status::Status = t.append("  fi\n");
    let _z4: status::Status = t.append("fi\n");
    return t;
}

// The bash rc file: source the user's real `~/.bashrc` first, then add ours.
//
// SOURCED FIRST AND NOT LAST. The user's rc may set its own PROMPT_COMMAND, and
// the marks prepend to whatever is there — reversing the order would let the
// user's assignment overwrite ours and the pane would report nothing while
// looking correctly configured.
fn write_bash_rc(dir: str, kill_history: bool) -> option::Option[text::Text] {
    var body: text::Text = text::from_str(
        "# Generated by terminal/pty. Rewritten on every start(); do not edit.\n");
    let _a: status::Status = body.append("if [ -r \"$HOME/.bashrc\" ]; then . \"$HOME/.bashrc\"; fi\n");
    if kill_history {
        // `unset HISTFILE` runs after the user's rc has had its say, so it is
        // the last word. HISTSIZE stays, so the up-arrow still works within the
        // session; nothing reaches disk.
        let _b: status::Status = body.append(
            "\n# The embedded terminal does not persist history (terminal/pty save_history).\nunset HISTFILE\nHISTFILESIZE=0\n");
    }
    let marks: text::Text = marks_rc();
    let _c: status::Status = body.append(marks.view());
    let path: text::Text = "${dir}/bashrc";
    return match fs::write_string(path.view(), body.view()) {
        result::Result[usize, result::IoError]::Ok(_) => option::Option[text::Text]::Some(path),
        result::Result[usize, result::IoError]::Err(_) => option::Option[text::Text]::None,
    };
}

// ---- zsh on Linux ------------------------------------------------------------
//
// The ZDOTDIR shim, minus the one thing that was about macOS: Darwin's
// `/etc/zshrc` reassigns HISTFILE unconditionally after our environment is in
// place, which is why that half repairs the value. A Linux `/etc/zsh/zshrc`
// does not, so `unset HISTFILE` is the whole story here.
static ZDOTDIR_CAPTURED: bool = false;
static ZDOTDIR_WAS_SET: bool = false;
static ZDOTDIR_ORIGINAL: [u8; 1024] = [0 as u8; 1024];

fn capture_original_zdotdir() {
    if ZDOTDIR_CAPTURED { return; }
    ZDOTDIR_CAPTURED = true;
    match env::var("ZDOTDIR") {
        option::Option[text::Text]::Some(z) => {
            let v: str = z.view();
            let n: usize = #str_len(v);
            if n < (1023 as usize) {
                let p: *u8 = #str_ptr(v);
                var i: usize = 0 as usize;
                while i < n {
                    ZDOTDIR_ORIGINAL[i] = { *(p + i) };
                    i = i +% (1 as usize);
                }
                ZDOTDIR_ORIGINAL[n] = 0 as u8;
                ZDOTDIR_WAS_SET = true;
            }
        }
        option::Option[text::Text]::None => {}
    }
    return;
}

// zsh's own OSC 133, kept separate from bash's above because the HOOKS are the
// whole difference: zsh has real `preexec`/`precmd` and needs no latch.
fn zsh_marks_rc() -> text::Text {
    var t: text::Text = text::new();
    let _a: status::Status = t.append("\n# Command marks for terminal/pty. OSC 133, as iTerm2 and VS Code use.\n");
    let _b: status::Status = t.append("if [ -z \"$CPLUS_TERM_MARKS\" ]; then\n");
    let _c: status::Status = t.append("  CPLUS_TERM_MARKS=1\n");
    let _d: status::Status = t.append("  __cplus_preexec() {\n");
    let _e: status::Status = t.append("    __cplus_ran=1\n");
    let _e2: status::Status = t.append("    __cplus_c=$1\n");
    let _e3: status::Status = t.append("    case $__cplus_c in\n");
    let _e4: status::Status = t.append("      *$'\\n'*) __cplus_c=$2 ;;\n");
    let _e5: status::Status = t.append("    esac\n");
    let _f: status::Status = t.append("    printf '\\033]133;C;%s\\007' \"$__cplus_c\"\n");
    let _g: status::Status = t.append("  }\n");
    let _h: status::Status = t.append("  __cplus_precmd() {\n");
    let _i: status::Status = t.append("    local __cplus_st=$?\n");
    let _j: status::Status = t.append("    if [ -n \"$__cplus_ran\" ]; then\n");
    let _k: status::Status = t.append("      unset __cplus_ran\n");
    let _l: status::Status = t.append("      printf '\\033]133;D;%d\\007' $__cplus_st\n");
    let _m: status::Status = t.append("    fi\n");
    let _n: status::Status = t.append("    printf '\\033]7;file://%s%s\\007' \"$HOST\" \"$PWD\"\n");
    let _o: status::Status = t.append("    printf '\\033]133;A\\007'\n");
    let _p: status::Status = t.append("  }\n");
    let _q: status::Status = t.append("  autoload -Uz add-zsh-hook 2>/dev/null\n");
    let _r: status::Status = t.append("  if whence add-zsh-hook >/dev/null 2>&1; then\n");
    let _s: status::Status = t.append("    add-zsh-hook preexec __cplus_preexec\n");
    let _t: status::Status = t.append("    add-zsh-hook precmd __cplus_precmd\n");
    let _u: status::Status = t.append("  else\n");
    let _v: status::Status = t.append("    preexec_functions+=(__cplus_preexec)\n");
    let _w: status::Status = t.append("    precmd_functions+=(__cplus_precmd)\n");
    let _x: status::Status = t.append("  fi\n");
    let _y: status::Status = t.append("fi\n");
    return t;
}

fn shim_rc(dir: str, name: str, extra: str) -> bool {
    // ZDOTDIR is restored around the source so the user's rc sees the value it
    // expects, then put back so zsh keeps finding OUR files for the later
    // startup stages. The `$ZDOTDIR != $__cplus_zd` guard makes self-sourcing
    // impossible.
    let body: text::Text = "# Generated by terminal/pty. Rewritten on every start(); do not edit.\n__cplus_zd=\"$ZDOTDIR\"\nZDOTDIR=\"$CPLUS_TERM_HOME\"\n[ \"$ZDOTDIR\" != \"$__cplus_zd\" ] && [ -r \"$ZDOTDIR/${name}\" ] && . \"$ZDOTDIR/${name}\"\nZDOTDIR=\"$__cplus_zd\"\nunset __cplus_zd\n${extra}\n";
    let path: text::Text = "${dir}/${name}";
    return match fs::write_string(path.view(), body.view()) {
        result::Result[usize, result::IoError]::Ok(_) => true,
        result::Result[usize, result::IoError]::Err(_) => false,
    };
}

fn install_zsh_shim(dir: str, kill_history: bool) -> bool {
    capture_original_zdotdir();
    let home: text::Text = match env::var("HOME") {
        option::Option[text::Text]::Some(h) => h,
        option::Option[text::Text]::None => { return false; }
    };
    // The source root is the user's ORIGINAL ZDOTDIR — the captured one, never
    // `env::var` here: by the second `start()` the live value is already OUR
    // shim, and reading it would point the shims at themselves.
    if ZDOTDIR_WAS_SET {
        let _h: i32 = { setenv(#str_ptr("CPLUS_TERM_HOME\0"), #addr_of(ZDOTDIR_ORIGINAL[0]), 1 as i32) };
    } else {
        // `view()` is a ptr+len and NOT NUL-terminated; setenv would read past
        // the end.
        let home_c: text::CString = match home.c_str() {
            option::Option[text::CString]::Some(v) => v,
            option::Option[text::CString]::None => { return false; }
        };
        let _h: i32 = { setenv(#str_ptr("CPLUS_TERM_HOME\0"), home_c.as_ptr(), 1 as i32) };
    }
    var extra: text::Text = text::new();
    if kill_history {
        let _k: status::Status = extra.append("\n# The embedded terminal does not persist history (terminal/pty save_history).\nunset HISTFILE\nSAVEHIST=0\n");
    }
    let marks: text::Text = zsh_marks_rc();
    let _m: status::Status = extra.append(marks.view());

    if shim_rc(dir, ".zshenv", "") == false { return false; }
    if shim_rc(dir, ".zprofile", "") == false { return false; }
    if shim_rc(dir, ".zshrc", extra.view()) == false { return false; }
    if shim_rc(dir, ".zlogin", extra.view()) == false { return false; }
    let dir_text: text::Text = text::from_str(dir);
    let dir_c: text::CString = match dir_text.c_str() {
        option::Option[text::CString]::Some(v) => v,
        option::Option[text::CString]::None => { return false; }
    };
    let _zd: i32 = { setenv(#str_ptr("ZDOTDIR\0"), dir_c.as_ptr(), 1 as i32) };
    return true;
}

// The one door `pty.cplus` calls. Which mechanism runs is decided by the SHELL,
// not by the platform: a Linux box running zsh gets zsh's, and everything else
// falls through to bash's rcfile.
//
// A shell that is neither gets no integration and says so, rather than being
// handed a bash rc it would not read.
fn install_integration(shell: str, kill_history: bool) -> Integration {
    let dir: text::Text = match integration_dir(kill_history) {
        option::Option[text::Text]::Some(d) => d,
        option::Option[text::Text]::None => { return no_integration(); }
    };
    let shell_text: text::Text = text::from_str(shell);
    if shell_text.has_suffix("zsh") {
        if install_zsh_shim(dir.view(), kill_history) {
            return Integration { rc: text::new(), use_rcfile: false, marks: true };
        }
        return no_integration();
    }
    if shell_text.has_suffix("bash") {
        return match write_bash_rc(dir.view(), kill_history) {
            option::Option[text::Text]::Some(p) => Integration { rc: p, use_rcfile: true, marks: true },
            option::Option[text::Text]::None => no_integration(),
        };
    }
    return no_integration();
}

// The child side of the fork, and it never returns on success. ONLY
// ASYNC-SIGNAL-SAFE CALLS ARE LEGAL HERE — `execl` is one, and everything the
// argv needs was allocated in the parent before the fork.
//
// `-i` with an rcfile, `-l` without. See this file's header: bash reads
// `--rcfile` only for an interactive NON-login shell, so asking for both would
// silently drop the integration.
fn exec_shell(shell_c: *u8, rc_c: *u8, use_rcfile: bool) -> i32 {
    if use_rcfile && rc_c != (0 as *u8) {
        return { execl(shell_c, shell_c, #str_ptr("--rcfile\0"), rc_c, #str_ptr("-i\0"), 0 as *u8) };
    }
    return { execl(shell_c, shell_c, #str_ptr("-l\0"), 0 as *u8) };
}
