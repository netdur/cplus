import "winrt/runtime" as rt;
import "winui/winui" as ui;
import "facet/facet" as core;
struct View {
    object: rt::Object,
    content: rt::Object,
    opaque node: *core::Node,
    kind: u32,
    token: ui::EventRegistrationToken,
    token2: ui::EventRegistrationToken,
    token3: ui::EventRegistrationToken,
    token4: ui::EventRegistrationToken,
    measure_token: ui::EventRegistrationToken,
    measure_subscribed: bool,
    subscribed: bool,
    applying: bool,
    scroll_pending: bool,
    draw_pending: bool,
    draw_width: f64,
    draw_height: f64,
    opaque extra: *u8,
    opaque shortcut: *u8,
    opaque presentation: *u8,
    opaque parent: *u8,
    item_reader: fn(*u8)->*u8,
    opaque item_context: *u8,
}
