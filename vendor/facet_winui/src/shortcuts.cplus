fn subscriptions() -> i64 {return LIVE;}
fn entries(value: rt::Object) -> ui::IVector_Microsoft_UI_Xaml_Input_KeyboardAccelerator {let visual=native::must::[ui::IUIElement](ui::IUIElement::query(value));return native::must::[ui::IVector_Microsoft_UI_Xaml_Input_KeyboardAccelerator](ui::IVector_Microsoft_UI_Xaml_Input_KeyboardAccelerator::query(native::must::[rt::Object](visual.keyboard_accelerators())));}
fn invoked(sender: rt::Object,args: rt::Object,ctx: *u8) -> rt::Status {
    let s=ctx as *State;let r=(*s).record;var current=r;
    while current.is_not_null() {let common=#addr_of((*core::node_data((*current).node)).common);if !(*common).is_enabled || !(*common).is_visible {return rt::Status {code:0};}current=(*current).parent as *record::View;}
    let event=native::must::[ui::IKeyboardAcceleratorInvokedEventArgs](ui::IKeyboardAcceleratorInvokedEventArgs::query(args));native::check(event.set_handled(true));
    let parent=(*r).parent as *record::View;var flyout=rt::Object::empty();
    if (*parent).kind==props::K_MENU {let button=native::must::[ui::IButton](ui::IButton::query((*parent).object));flyout=native::must::[rt::Object](button.flyout());}
    else {let visual=native::must::[ui::IUIElement](ui::IUIElement::query((*parent).object));flyout=native::must::[rt::Object](visual.context_flyout());}
    if !flyout.is_null() {let base=native::must::[ui::IFlyoutBase](ui::IFlyoutBase::query(flyout));native::check(base.hide());}
    // The application may delete the action and this registration. No state
    // is read after calling the regular action delivery path.
    let call=(*s).call;return call((*r).object,args,r as *u8);
}
fn release(r: *record::View) {
    if (*r).shortcut.is_null() {return;}
    let owner: box::Box[State]=box::from_raw::[State]((*r).shortcut);(*r).shortcut=0 as *u8;let s=owner.ptr();
    let accelerator=native::must::[ui::IKeyboardAccelerator](ui::IKeyboardAccelerator::query((*s).object));native::check(accelerator.remove_invoked((*s).token));LIVE=LIVE-1;
    // During Window.Closed WinUI is already retiring its accelerator lists.
