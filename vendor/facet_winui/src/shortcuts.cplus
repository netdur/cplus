        let owner=match box::new::[State](State {object:accelerator.object(),collection:list.object(),token:#zero::[ui::EventRegistrationToken](),record:r,call:call}) {option::Option::Some(v)=>v,option::Option::None=>{assert false;return;}};let s=owner.ptr();
        let handler=native::must::[ui::TypedEventHandler_Microsoft_UI_Xaml_Input_KeyboardAccelerator_Microsoft_UI_Xaml_Input_KeyboardAcceleratorInvokedEventArgs](ui::TypedEventHandler_Microsoft_UI_Xaml_Input_KeyboardAccelerator_Microsoft_UI_Xaml_Input_KeyboardAcceleratorInvokedEventArgs::new(invoked,s as *u8));
        (*s).token=native::must::[ui::EventRegistrationToken](accelerator.add_invoked(handler.object()));native::check(list.append(accelerator.object()));(*r).shortcut=owner.into_raw();LIVE=LIVE+1;
    }
    let s=(*r).shortcut as *State;let accelerator=native::must::[ui::IKeyboardAccelerator](ui::IKeyboardAccelerator::query((*s).object));native::check(accelerator.set_key(key));native::check(accelerator.set_modifiers(modifiers((*p).shortcut_modifiers)));native::check(accelerator.set_is_enabled((*core::node_data((*r).node)).common.is_enabled));
    native::check(accelerator.set_scope_owner(if (*parent).kind==props::K_CONTEXT_MENU || (*parent).kind==props::K_SWIPEABLE {(*parent).object.clone()} else {rt::Object::empty()}));
    let prefix=match (*p).shortcut_modifiers {vocab::KeyModifiers::Alt=>"Alt+",vocab::KeyModifiers::Ctrl=>"Ctrl+",vocab::KeyModifiers::Shift=>"Shift+",vocab::KeyModifiers::Cmd=>"Win+",vocab::KeyModifiers::Windows=>"Win+",_=>""};
    var label=text::from_str(prefix);let appended=label.append(text::from_str((*p).shortcut_key.view()).uppercased().view());native::check(item.set_keyboard_accelerator_text_override(label.view()));
}
