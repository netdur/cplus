    while i<native::must::[u32](list.size()) {let entry=native::must::[rt::Object](list.get_at(i));if native::must::[rt::Object](entry.query(rt::unknown_iid())).raw()==identity.raw() {native::check(list.remove_at(i));break;}i=i+1;}
}
fn apply(r: *record::View,call: fn(rt::Object,rt::Object,*u8)->rt::Status) {
    if (*r).kind!=props::K_CONTEXT_MENU_ITEM {return;}
    let p: *props::ContextMenuItemProps=(*core::node_data((*r).node)).props as *props::ContextMenuItemProps;let key=key_code((*p).shortcut_key.view());let parent=(*r).parent as *record::View;
    let item=native::must::[ui::IMenuFlyoutItem](ui::IMenuFlyoutItem::query((*r).object));
    if key==0 || parent.is_null() {release(r);native::check(item.set_keyboard_accelerator_text_override(""));return;}
    if (*r).shortcut.is_null() {
