fn key_code(key: str) -> i32 {
    let owned=text::from_str(key).lowercased();let value=owned.view();
    if value.count()==1 {match value.byte_at(0) {option::Option::Some(c)=>{if c>=97u8 && c<=122u8 {return c as i32-32;}if c>=48u8 && c<=57u8 {return c as i32;}},option::Option::None=>{}}}
    if value.has_prefix("f") && value.count()>=2 && value.count()<=3 {
        var number: i32=0;var i: usize=1;while i<value.count() {match value.byte_at(i) {option::Option::Some(c)=>{if c<48u8 || c>57u8 {return 0;}number=number*10+c as i32-48;},option::Option::None=>{return 0;}}i=i+1;}
        if number>=1 && number<=24 {return 111+number;}
    }
    if value=="enter" || value=="return" {return 13;}if value=="escape" || value=="esc" {return 27;}if value=="space" {return 32;}if value=="tab" {return 9;}
    if value=="backspace" {return 8;}if value=="delete" {return 46;}if value=="insert" {return 45;}if value=="home" {return 36;}if value=="end" {return 35;}
    if value=="left" {return 37;}if value=="up" {return 38;}if value=="right" {return 39;}if value=="down" {return 40;}if value=="pageup" {return 33;}if value=="pagedown" {return 34;}return 0;
}
fn modifiers(value: vocab::KeyModifiers) -> u32 {return match value {vocab::KeyModifiers::Alt=>ui::virtual_key_modifiers_menu,vocab::KeyModifiers::Ctrl=>ui::virtual_key_modifiers_control,vocab::KeyModifiers::Shift=>ui::virtual_key_modifiers_shift,vocab::KeyModifiers::Cmd=>ui::virtual_key_modifiers_windows,vocab::KeyModifiers::Windows=>ui::virtual_key_modifiers_windows,_=>ui::virtual_key_modifiers_none};}
