fn attach(r: *record::View) {
    let state: box::Box[State]=match box::new::[State](#zero::[State]()) {option::Option::Some(v)=>v,option::Option::None=>{assert false;return;}};
    (*r).extra=state.into_raw();
    let view: ui::IWebView2=native::must::[ui::IWebView2](ui::IWebView2::query((*r).object));
    let a: ui::TypedEventHandler_Microsoft_UI_Xaml_Controls_WebView2_Microsoft_UI_Xaml_Controls_CoreWebView2InitializedEventArgs=native::must::[ui::TypedEventHandler_Microsoft_UI_Xaml_Controls_WebView2_Microsoft_UI_Xaml_Controls_CoreWebView2InitializedEventArgs](ui::TypedEventHandler_Microsoft_UI_Xaml_Controls_WebView2_Microsoft_UI_Xaml_Controls_CoreWebView2InitializedEventArgs::new(initialized,r as *u8));
    let b: ui::TypedEventHandler_Microsoft_UI_Xaml_Controls_WebView2_Microsoft_Web_WebView2_Core_CoreWebView2NavigationStartingEventArgs=native::must::[ui::TypedEventHandler_Microsoft_UI_Xaml_Controls_WebView2_Microsoft_Web_WebView2_Core_CoreWebView2NavigationStartingEventArgs](ui::TypedEventHandler_Microsoft_UI_Xaml_Controls_WebView2_Microsoft_Web_WebView2_Core_CoreWebView2NavigationStartingEventArgs::new(starting,r as *u8));
    let c: ui::TypedEventHandler_Microsoft_UI_Xaml_Controls_WebView2_Microsoft_Web_WebView2_Core_CoreWebView2NavigationCompletedEventArgs=native::must::[ui::TypedEventHandler_Microsoft_UI_Xaml_Controls_WebView2_Microsoft_Web_WebView2_Core_CoreWebView2NavigationCompletedEventArgs](ui::TypedEventHandler_Microsoft_UI_Xaml_Controls_WebView2_Microsoft_Web_WebView2_Core_CoreWebView2NavigationCompletedEventArgs::new(completed,r as *u8));
    let d: ui::TypedEventHandler_Microsoft_UI_Xaml_Controls_WebView2_Microsoft_Web_WebView2_Core_CoreWebView2ProcessFailedEventArgs=native::must::[ui::TypedEventHandler_Microsoft_UI_Xaml_Controls_WebView2_Microsoft_Web_WebView2_Core_CoreWebView2ProcessFailedEventArgs](ui::TypedEventHandler_Microsoft_UI_Xaml_Controls_WebView2_Microsoft_Web_WebView2_Core_CoreWebView2ProcessFailedEventArgs::new(failed,r as *u8));
    (*r).token=native::must::[ui::EventRegistrationToken](view.add_core_web_view2_initialized(a.object()));
    (*r).token2=native::must::[ui::EventRegistrationToken](view.add_navigation_starting(b.object()));
    (*r).token3=native::must::[ui::EventRegistrationToken](view.add_navigation_completed(c.object()));
    (*r).token4=native::must::[ui::EventRegistrationToken](view.add_core_process_failed(d.object()));LIVE=LIVE+4;
}
fn release(r: *record::View) {
    let view: ui::IWebView2=native::must::[ui::IWebView2](ui::IWebView2::query((*r).object));
    native::check(view.remove_core_web_view2_initialized((*r).token));native::check(view.remove_navigation_starting((*r).token2));
    native::check(view.remove_navigation_completed((*r).token3));native::check(view.remove_core_process_failed((*r).token4));LIVE=LIVE-4;
    let state: box::Box[State]=box::from_raw::[State]((*r).extra);(*r).extra=0 as *u8;
    // Window.Closed can arrive after WebView2 closed its controller. Measured
    // on host shutdown: event removals succeed, repeated Close is E_UNEXPECTED.
    // Navigation/removal while the window is live still requires successful Close.
    let closed: rt::Status=view.close();
    if !SHUTTING_DOWN || closed.code!=(0x8000ffff as i32) {native::check(closed);}
}
