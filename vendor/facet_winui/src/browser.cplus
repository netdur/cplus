struct State { pending: u64, applied: bool, ready: bool, source: rt::Object, default_agent: text::Text }
static LIVE: i64=0;
static SHUTTING_DOWN: bool=false;
fn subscriptions() -> i64 {return LIVE;}
fn begin_shutdown() {SHUTTING_DOWN=true;}
fn flush(r: *record::View) {
    let state: *State=(*r).extra as *State;
    if !(*state).ready {return;}
    let pending: u64=(*state).pending;(*state).pending=0;
    let p: *props::WebProps=(*core::node_data((*r).node)).props as *props::WebProps;
    let view: ui::IWebView2=native::must::[ui::IWebView2](ui::IWebView2::query((*r).object));
    let engine: ui::ICoreWebView2=native::must::[ui::ICoreWebView2](ui::ICoreWebView2::query(native::must::[rt::Object](view.core_web_view2())));
    if (pending&web::P_USER_AGENT)!=0 {
        let settings: ui::ICoreWebView2Settings2=native::must::[ui::ICoreWebView2Settings2](ui::ICoreWebView2Settings2::query(native::must::[rt::Object](engine.settings())));
        native::check(settings.set_user_agent(if (*p).user_agent.is_empty() {(*state).default_agent.view()} else {(*p).user_agent.view()}));
    }
    if (pending&web::P_SOURCE)!=0 {
        if (*state).source.is_null() {native::check(view.navigate_to_string(""));}
        else {native::check(view.set_source((*state).source));}
    }
    if (pending&web::P_GO_BACK)!=0 && native::must::[bool](view.can_go_back()) {native::check(view.go_back());}
    if (pending&web::P_GO_FORWARD)!=0 && native::must::[bool](view.can_go_forward()) {native::check(view.go_forward());}
    if (pending&web::P_RELOAD)!=0 {native::check(view.reload());}
    if (pending&web::P_EVAL)!=0 {let operation: rt::Object=native::must::[rt::Object](view.execute_script_async((*p).eval_script.view()));}
}
fn apply(r: *record::View,source: rt::Object) {
    let state: *State=(*r).extra as *State;
    let dirty: u64=core::dirty_of((*r).node);
    let mask: u64=web::P_SOURCE|web::P_USER_AGENT|web::P_EVAL|web::P_GO_BACK|web::P_GO_FORWARD|web::P_RELOAD;
    if !(*state).applied {(*state).pending=web::P_SOURCE|web::P_USER_AGENT;}
    else {(*state).pending=(*state).pending|(dirty&mask);}
    if (dirty&web::P_SOURCE)!=0 || !(*state).applied {(*state).source=source.clone();}
    let first: bool=!(*state).applied;(*state).applied=true;
    if first {
        let view: ui::IWebView2=native::must::[ui::IWebView2](ui::IWebView2::query((*r).object));
        let operation: rt::Object=native::must::[rt::Object](view.ensure_core_web_view2_async());
    }
    flush(r);
}
fn initialized(sender: rt::Object,args: rt::Object,context: *u8) -> rt::Status {
    let r: *record::View=context as *record::View;let state: *State=(*r).extra as *State;
    let view: ui::IWebView2=native::must::[ui::IWebView2](ui::IWebView2::query(sender));
    let object: rt::Object=native::must::[rt::Object](view.core_web_view2());
    if object.is_null() {return rt::Status {code:0};}
    let engine: ui::ICoreWebView2=native::must::[ui::ICoreWebView2](ui::ICoreWebView2::query(object));
    let settings: ui::ICoreWebView2Settings2=native::must::[ui::ICoreWebView2Settings2](ui::ICoreWebView2Settings2::query(native::must::[rt::Object](engine.settings())));
    (*state).default_agent=native::must::[text::Text](settings.user_agent());(*state).ready=true;flush(r);return rt::Status {code:0};
}
fn starting(sender: rt::Object,args: rt::Object,context: *u8) -> rt::Status {
    let r: *record::View=context as *record::View;let p: *props::WebProps=(*core::node_data((*r).node)).props as *props::WebProps;
    let call: fn(*u8,*u8)=(*p).on_navigating;let ctx: *u8=(*p).on_navigating_ctx;
    if call!=props::no_handler {call(context,ctx);}return rt::Status {code:0};
}
fn completed(sender: rt::Object,args: rt::Object,context: *u8) -> rt::Status {
    let r: *record::View=context as *record::View;let p: *props::WebProps=(*core::node_data((*r).node)).props as *props::WebProps;
    let view: ui::IWebView2=native::must::[ui::IWebView2](ui::IWebView2::query(sender));
    (*p).can_go_back=native::must::[bool](view.can_go_back());(*p).can_go_forward=native::must::[bool](view.can_go_forward());
    // Preserve a pending application write when an earlier navigation finishes.
    if (core::dirty_of((*r).node)&web::P_SOURCE)==0 {
        let engine: ui::ICoreWebView2=native::must::[ui::ICoreWebView2](ui::ICoreWebView2::query(native::must::[rt::Object](view.core_web_view2())));
        (*p).source=native::must::[text::Text](engine.source());
    }
    let call: fn(*u8,*u8)=(*p).on_navigated;let ctx: *u8=(*p).on_navigated_ctx;
    if call!=props::no_handler {call(context,ctx);}return rt::Status {code:0};
}
fn failed(sender: rt::Object,args: rt::Object,context: *u8) -> rt::Status {
    let r: *record::View=context as *record::View;let p: *props::WebProps=(*core::node_data((*r).node)).props as *props::WebProps;
    let call: fn(*u8,*u8)=(*p).on_process_terminated;let ctx: *u8=(*p).on_process_terminated_ctx;
    if call!=props::no_handler {call(context,ctx);}return rt::Status {code:0};
