// facet_winui/input - the READ half facet's contract asks of every backend:
// the gesture band on any node, the key band and its readers, the focus and
// blur commands, and which node holds the keyboard.
//
// THE DECLINE CHAIN IS WINUI'S OWN. A gesture handler answers `bool`: true
// is "mine", false is "not mine, carry on". XAML's routed events already work
// that way - an event bubbles from the element it hit up the visual tree
// until something marks it Handled - so true sets Handled and false leaves it
// alone: the next node up with a gesture hears it, and native handling under
// it still runs. A control claims what it handles natively (a Button marks
// its own presses handled), which is facet's rule for nested controls.
//
// BANDS ARE ARMED IN PIECES, each when the node first declares one of its
// verbs (facet_gtk's rule: a node does not pay for verbs it never named), and
// never removed until the view is released. Handlers are read off the node at
// fire time, so a detached set makes every one of them `no_gesture` and the
// band fires nothing.
//
// The one-pointer assumption is stated, as on Win32: press position, the
// moved flag and the long-press latch are per view, not per pointer id.
//
// | verb                     | WinUI source                                           |
// |--------------------------|--------------------------------------------------------|
// | on_click                 | Tapped (not after a swipe or a long press)             |
// | on_double_click          | DoubleTapped; falls back to on_click, since the second |
// |                          | tap of a pair raises no Tapped                         |
// | on_right_click           | RightTapped                                            |
// | on_press / on_release    | PointerPressed / PointerReleased                       |
// | on_hover / on_unhover    | PointerEntered / PointerExited                         |
// | on_pointer_move          | PointerMoved                                           |
// | on_pan                   | a move with the pointer down, past a 4-DIP slop        |
// | on_swipe                 | a release at least swipe_threshold from its press      |
// | on_long_press            | long_press_seconds held without moving (a timer), or   |
// |                          | touch Holding                                          |
// | on_pinch                 | Ctrl + wheel, as on Win32                              |
// | on_key                   | KeyDown, on the focused element or bubbling through    |
//
// The drag-and-drop verbs are not in this module (facet_winui's collections
// own their own drag; a general drop band is separate work).
import "stdlib/box" as box;
import "stdlib/option" as option;
import "stdlib/result" as result;
import "stdlib/status" as status;
import "stdlib/text" as text;
import "stdlib/vec" as vec;
import "winui/winui" as ui;
import "winrt/runtime" as rt;
import "facet/facet" as core;
import "facet/props" as props;
import "facet/gestures" as gestures;
import "./record" as record;
import "./native" as native;
import "./scheduler" as scheduler;
import "./presentation" as presentation;

extern fn GetKeyState(key: i32) -> i16;

// ---- bands ------------------------------------------------------------------------
const B_PRESSED: u32=1;
const B_RELEASED: u32=2;
const B_MOVED: u32=4;
const B_ENTERED: u32=8;
const B_EXITED: u32=16;
const B_TAPPED: u32=32;
const B_DOUBLE: u32=64;
const B_RIGHT: u32=128;
const B_HOLDING: u32=256;
const B_WHEEL: u32=512;
const B_KEY: u32=1024;
const BAND_COUNT: usize=11;
// The slop a press may wander before it is a pan: every click jitters.
const SLOP: f64=4.0f64;

fn set(f: gestures::Handler) -> bool { return f!=gestures::no_gesture; }
// The bands a gesture set needs. Pure, so a test can read it.
fn bands_for(g: *gestures::Gestures) -> u32 {
    if g.is_null() { return 0; }
    var b: u32=0;
    let pan: bool=set((*g).on_pan); let swipe: bool=set((*g).on_swipe); let long: bool=set((*g).on_long_press);
    if set((*g).on_press) || pan || swipe || long { b=b|B_PRESSED; }
    if set((*g).on_release) || pan || swipe || long { b=b|B_RELEASED; }
    if set((*g).on_pointer_move) || pan || swipe || long { b=b|B_MOVED; }
    if set((*g).on_hover) { b=b|B_ENTERED; }
    if set((*g).on_unhover) { b=b|B_EXITED; }
    if set((*g).on_click) || swipe || long { b=b|B_TAPPED; }
    if set((*g).on_double_click) || set((*g).on_click) { b=b|B_DOUBLE; }
    if set((*g).on_right_click) { b=b|B_RIGHT; }
    if long { b=b|B_HOLDING; }
    if set((*g).on_pinch) { b=b|B_WHEEL; }
    if set((*g).on_key) { b=b|B_KEY; }
    return b;
}
// A release this far from its press is a swipe. Pure, for the same reason.
fn is_swipe(dx: f64, dy: f64, threshold: f64) -> bool {
    let t: f64=if threshold>0.0f64 {threshold} else {100.0f64};
    return dx*dx+dy*dy>=t*t;
}
fn beyond_slop(dx: f64, dy: f64) -> bool { return dx*dx+dy*dy>SLOP*SLOP; }

struct Band {
    opaque view: *record::View,
    armed: u32,
    tokens: [ui::EventRegistrationToken; 11],
    pressed: bool,
    moved: bool,
    long_fired: bool,
    swallow_tap: bool,
    x: f64,
    y: f64,
    timer: u64,
}
static LIVE: i64=0;
fn subscriptions() -> i64 { return LIVE; }
fn band_of(r: *record::View) -> *Band { return (*r).input as *Band; }

fn node_of(b: *Band) -> *core::Node { return (*(*b).view).node; }
fn gestures_of(b: *Band) -> *gestures::Gestures {
    let n=node_of(b);
    if n.is_null() { return 0 as *gestures::Gestures; }
    return gestures::gestures_of(n);
}
// Fire `f`/`ctx` for this band's node; true when the node took it.
fn fire(b: *Band, f: gestures::Handler, ctx: *u8) -> bool {
    let n=node_of(b);
    if n.is_null() { return false; }
    return gestures::fire(n,f,ctx);
}
fn position(b: *Band, args: rt::Object) -> ui::Point {
    let event=native::must::[ui::IPointerRoutedEventArgs](ui::IPointerRoutedEventArgs::query(args));
    let point=native::must::[ui::IPointerPoint](ui::IPointerPoint::query(native::must::[rt::Object](event.get_current_point((*(*b).view).object.clone()))));
    return native::must::[ui::Point](point.position());
}
fn handled_pointer(args: rt::Object, took: bool) {
    if !took { return; }
    native::check(native::must::[ui::IPointerRoutedEventArgs](ui::IPointerRoutedEventArgs::query(args)).set_handled(true));
}

// ---- the pointer band -------------------------------------------------------------
fn long_elapsed(context: *u8) {
    let b: *Band=context as *Band;
    if !live_band(b) { return; }
    (*b).timer=0;
    if !(*b).pressed || (*b).moved { return; }
    let g=gestures_of(b);
    if g.is_null() { return; }
    if fire(b,(*g).on_long_press,(*g).on_long_press_ctx) { (*b).long_fired=true; (*b).swallow_tap=true; }
}
fn pressed(sender: rt::Object, args: rt::Object, context: *u8) -> rt::Status {
    let b: *Band=context as *Band; let g=gestures_of(b);
    if g.is_null() { return rt::Status {code:0}; }
    let at=position(b,args);
    (*b).pressed=true; (*b).moved=false; (*b).long_fired=false; (*b).swallow_tap=false;
    (*b).x=at.x as f64; (*b).y=at.y as f64;
    if set((*g).on_long_press) {
        if (*b).timer!=0 { scheduler::cancel((*b).timer); }
        let seconds: f64=if (*g).long_press_seconds>0.0f64 {(*g).long_press_seconds} else {0.5f64};
        (*b).timer=scheduler::after(seconds,long_elapsed,b as *u8);
    }
    handled_pointer(args,fire(b,(*g).on_press,(*g).on_press_ctx));
    return rt::Status {code:0};
}
fn released(sender: rt::Object, args: rt::Object, context: *u8) -> rt::Status {
    let b: *Band=context as *Band; let g=gestures_of(b);
    if g.is_null() || !(*b).pressed { return rt::Status {code:0}; }
    (*b).pressed=false;
    if (*b).timer!=0 { scheduler::cancel((*b).timer); (*b).timer=0; }
    let at=position(b,args);
    var took: bool=fire(b,(*g).on_release,(*g).on_release_ctx);
    // A gesture that ended somewhere else was never a click on anything.
    if !(*b).long_fired && set((*g).on_swipe) && is_swipe(at.x as f64-(*b).x,at.y as f64-(*b).y,(*g).swipe_threshold) {
        if fire(b,(*g).on_swipe,(*g).on_swipe_ctx) { took=true; (*b).swallow_tap=true; }
    }
    handled_pointer(args,took);
    return rt::Status {code:0};
}
fn moved(sender: rt::Object, args: rt::Object, context: *u8) -> rt::Status {
    let b: *Band=context as *Band; let g=gestures_of(b);
    if g.is_null() { return rt::Status {code:0}; }
    var took: bool=fire(b,(*g).on_pointer_move,(*g).on_pointer_move_ctx);
    if (*b).pressed {
        let at=position(b,args);
        if !(*b).moved && beyond_slop(at.x as f64-(*b).x,at.y as f64-(*b).y) {
            (*b).moved=true;
            if (*b).timer!=0 { scheduler::cancel((*b).timer); (*b).timer=0; }
        }
        if (*b).moved && fire(b,(*g).on_pan,(*g).on_pan_ctx) { took=true; }
    }
    handled_pointer(args,took);
    return rt::Status {code:0};
}
fn entered(sender: rt::Object, args: rt::Object, context: *u8) -> rt::Status {
    let b: *Band=context as *Band; let n=node_of(b);
    if n.is_not_null() { handled_pointer(args,gestures::fire_hover(n,true)); }
    return rt::Status {code:0};
}
fn exited(sender: rt::Object, args: rt::Object, context: *u8) -> rt::Status {
    let b: *Band=context as *Band; let n=node_of(b);
    if n.is_not_null() { handled_pointer(args,gestures::fire_hover(n,false)); }
    return rt::Status {code:0};
}
fn wheel(sender: rt::Object, args: rt::Object, context: *u8) -> rt::Status {
    let b: *Band=context as *Band; let g=gestures_of(b);
    if g.is_null() || (key_modifiers_now() & gestures::mod_control())==0 { return rt::Status {code:0}; }
    handled_pointer(args,fire(b,(*g).on_pinch,(*g).on_pinch_ctx));
    return rt::Status {code:0};
}
fn tapped(sender: rt::Object, args: rt::Object, context: *u8) -> rt::Status {
    let b: *Band=context as *Band; let g=gestures_of(b);
    if g.is_null() { return rt::Status {code:0}; }
    let event=native::must::[ui::ITappedRoutedEventArgs](ui::ITappedRoutedEventArgs::query(args));
    if (*b).swallow_tap { (*b).swallow_tap=false; native::check(event.set_handled(true)); return rt::Status {code:0}; }
    if fire(b,(*g).on_click,(*g).on_click_ctx) { native::check(event.set_handled(true)); }
    return rt::Status {code:0};
}
fn double_tapped(sender: rt::Object, args: rt::Object, context: *u8) -> rt::Status {
    let b: *Band=context as *Band; let g=gestures_of(b);
    if g.is_null() { return rt::Status {code:0}; }
    let event=native::must::[ui::IDoubleTappedRoutedEventArgs](ui::IDoubleTappedRoutedEventArgs::query(args));
    let took: bool=if set((*g).on_double_click) {fire(b,(*g).on_double_click,(*g).on_double_click_ctx)} else {fire(b,(*g).on_click,(*g).on_click_ctx)};
    if took { native::check(event.set_handled(true)); }
    return rt::Status {code:0};
}
fn right_tapped(sender: rt::Object, args: rt::Object, context: *u8) -> rt::Status {
    let b: *Band=context as *Band; let n=node_of(b);
    if n.is_null() { return rt::Status {code:0}; }
    if gestures::fire_right_click(n) { native::check(native::must::[ui::IRightTappedRoutedEventArgs](ui::IRightTappedRoutedEventArgs::query(args)).set_handled(true)); }
    return rt::Status {code:0};
}
fn holding(sender: rt::Object, args: rt::Object, context: *u8) -> rt::Status {
    let b: *Band=context as *Band; let g=gestures_of(b);
    if g.is_null() || (*b).long_fired { return rt::Status {code:0}; }
    let event=native::must::[ui::IHoldingRoutedEventArgs](ui::IHoldingRoutedEventArgs::query(args));
    if native::must::[i32](event.holding_state())!=ui::holding_state_started { return rt::Status {code:0}; }
    if fire(b,(*g).on_long_press,(*g).on_long_press_ctx) { (*b).long_fired=true; (*b).swallow_tap=true; native::check(event.set_handled(true)); }
    return rt::Status {code:0};
}

// ---- the key band -----------------------------------------------------------------
// The event a key handler is handed is the IKeyRoutedEventArgs itself, read
// through the KeyReader below; the handler's `true` marks it Handled.
fn key_down(sender: rt::Object, args: rt::Object, context: *u8) -> rt::Status {
    let b: *Band=context as *Band; let n=node_of(b);
    if n.is_null() { return rt::Status {code:0}; }
    if gestures::fire_key(n,args.raw()) { native::check(native::must::[ui::IKeyRoutedEventArgs](ui::IKeyRoutedEventArgs::query(args)).set_handled(true)); }
    return rt::Status {code:0};
}
fn key_args(event: *u8) -> result::Result[ui::IKeyRoutedEventArgs, rt::Error] {
    if event.is_null() { return result::Result[ui::IKeyRoutedEventArgs, rt::Error]::Err(rt::Error {code:rt::pointer_error()}); }
    return ui::IKeyRoutedEventArgs::query(rt::Object::retain(event));
}
fn key_code(event: *u8) -> i64 {
    match key_args(event) { result::Result::Ok(a)=>{ return native::must::[i32](a.key()) as i64; }, result::Result::Err(_)=>{ return -1; } }
}
// Empty by decision, as on Win32: KeyDown carries the key, not the character.
fn key_chars(event: *u8) -> text::Text { return text::new(); }
fn down(vk: i32) -> bool { return (GetKeyState(vk) as i32 & 0x8000)!=0; }
fn key_modifiers_now() -> u64 {
    var m: u64=0;
    if down(0x10) { m=m|gestures::mod_shift(); }     // VK_SHIFT
    if down(0x11) { m=m|gestures::mod_control(); }   // VK_CONTROL
    if down(0x12) { m=m|gestures::mod_option(); }    // VK_MENU (Alt)
    if down(0x5B) || down(0x5C) { m=m|gestures::mod_command(); }   // VK_LWIN / VK_RWIN
    return m;
}
fn key_modifiers(event: *u8) -> u64 { return key_modifiers_now(); }
// VirtualKey onto facet's named keys. Pure.
fn named_key(vk: i64) -> i64 {
    if vk==13 { return gestures::key_return(); }
    if vk==9 { return gestures::key_tab(); }
    if vk==32 { return gestures::key_space(); }
    if vk==8 { return gestures::key_delete(); }
    if vk==46 { return gestures::key_forward_delete(); }
    if vk==27 { return gestures::key_escape(); }
    if vk==37 { return gestures::key_arrow_left(); }
    if vk==39 { return gestures::key_arrow_right(); }
    if vk==38 { return gestures::key_arrow_up(); }
    if vk==40 { return gestures::key_arrow_down(); }
    if vk==36 { return gestures::key_home(); }
    if vk==35 { return gestures::key_end(); }
    if vk==33 { return gestures::key_page_up(); }
    if vk==34 { return gestures::key_page_down(); }
    return gestures::key_none();
}
fn key_named(event: *u8) -> i64 { return named_key(key_code(event)); }
fn key_reader() -> gestures::KeyReader {
    return gestures::KeyReader {code:key_code,chars:key_chars,modifiers:key_modifiers,named:key_named};
}

// ---- arming -----------------------------------------------------------------------
fn element(r: *record::View) -> ui::IUIElement { return native::must::[ui::IUIElement](ui::IUIElement::query((*r).object.clone())); }
fn band_for(r: *record::View) -> *Band {
    if (*r).input.is_not_null() { return band_of(r); }
    let owner: box::Box[Band]=match box::new::[Band](Band {view:r,armed:0,tokens:#zero::[[ui::EventRegistrationToken; 11]](),
        pressed:false,moved:false,long_fired:false,swallow_tap:false,x:0.0f64,y:0.0f64,timer:0}) {
        option::Option::Some(v)=>{v}, option::Option::None=>{ return 0 as *Band; }
    };
    (*r).input=owner.into_raw();
    return band_of(r);
}
fn arm(b: *Band, bit: u32, index: usize) {
    if ((*b).armed & bit)!=0 { return; }
    let e=element((*b).view); let ctx: *u8=b as *u8;
    var token: ui::EventRegistrationToken=#zero::[ui::EventRegistrationToken]();
    if bit==B_PRESSED { token=native::must::[ui::EventRegistrationToken](e.add_pointer_pressed(native::must::[ui::PointerEventHandler](ui::PointerEventHandler::new(pressed,ctx)).object())); }
    if bit==B_RELEASED { token=native::must::[ui::EventRegistrationToken](e.add_pointer_released(native::must::[ui::PointerEventHandler](ui::PointerEventHandler::new(released,ctx)).object())); }
    if bit==B_MOVED { token=native::must::[ui::EventRegistrationToken](e.add_pointer_moved(native::must::[ui::PointerEventHandler](ui::PointerEventHandler::new(moved,ctx)).object())); }
    if bit==B_ENTERED { token=native::must::[ui::EventRegistrationToken](e.add_pointer_entered(native::must::[ui::PointerEventHandler](ui::PointerEventHandler::new(entered,ctx)).object())); }
    if bit==B_EXITED { token=native::must::[ui::EventRegistrationToken](e.add_pointer_exited(native::must::[ui::PointerEventHandler](ui::PointerEventHandler::new(exited,ctx)).object())); }
    if bit==B_TAPPED { token=native::must::[ui::EventRegistrationToken](e.add_tapped(native::must::[ui::TappedEventHandler](ui::TappedEventHandler::new(tapped,ctx)).object())); }
    if bit==B_DOUBLE { token=native::must::[ui::EventRegistrationToken](e.add_double_tapped(native::must::[ui::DoubleTappedEventHandler](ui::DoubleTappedEventHandler::new(double_tapped,ctx)).object())); }
    if bit==B_RIGHT { token=native::must::[ui::EventRegistrationToken](e.add_right_tapped(native::must::[ui::RightTappedEventHandler](ui::RightTappedEventHandler::new(right_tapped,ctx)).object())); }
    if bit==B_HOLDING { token=native::must::[ui::EventRegistrationToken](e.add_holding(native::must::[ui::HoldingEventHandler](ui::HoldingEventHandler::new(holding,ctx)).object())); }
    if bit==B_WHEEL { token=native::must::[ui::EventRegistrationToken](e.add_pointer_wheel_changed(native::must::[ui::PointerEventHandler](ui::PointerEventHandler::new(wheel,ctx)).object())); }
    if bit==B_KEY { token=native::must::[ui::EventRegistrationToken](e.add_key_down(native::must::[ui::KeyEventHandler](ui::KeyEventHandler::new(key_down,ctx)).object())); }
    (*b).tokens[index]=token; (*b).armed=(*b).armed|bit; LIVE=LIVE+1;
}
fn disarm(b: *Band, bit: u32, index: usize) {
    if ((*b).armed & bit)==0 { return; }
    let e=element((*b).view); let token=(*b).tokens[index];
    if bit==B_PRESSED { native::check(e.remove_pointer_pressed(token)); }
    if bit==B_RELEASED { native::check(e.remove_pointer_released(token)); }
    if bit==B_MOVED { native::check(e.remove_pointer_moved(token)); }
    if bit==B_ENTERED { native::check(e.remove_pointer_entered(token)); }
    if bit==B_EXITED { native::check(e.remove_pointer_exited(token)); }
    if bit==B_TAPPED { native::check(e.remove_tapped(token)); }
    if bit==B_DOUBLE { native::check(e.remove_double_tapped(token)); }
    if bit==B_RIGHT { native::check(e.remove_right_tapped(token)); }
    if bit==B_HOLDING { native::check(e.remove_holding(token)); }
    if bit==B_WHEEL { native::check(e.remove_pointer_wheel_changed(token)); }
    if bit==B_KEY { native::check(e.remove_key_down(token)); }
    (*b).armed=(*b).armed&(~bit); LIVE=LIVE-1;
}
// Containers are Borders, which facet_winui always gives a brush (transparent
// when unset), so their gaps are hit-testable already; nothing to arm for
// HitTest::Opaque beyond the band itself.
fn container(kind: u32) -> bool {
    return kind==core::K_NODE || kind==props::K_BOX || kind==props::K_BORDERED || kind==props::K_TABLE || kind==props::K_TABS || kind==props::K_CONTEXT_MENU || kind==props::K_SWIPEABLE;
}
// ---- the views' doors -------------------------------------------------------------
// Every view: its element knows its record (focus readback), and the record is
// live. Called once at create.
static VIEWS: vec::Vec[usize]=#zero::[vec::Vec[usize]]();
fn live_view(r: *record::View) -> bool {
    var i: usize=0; let want: usize=r as usize;
    while i<VIEWS.count() { if let option::Option::Some(v)=VIEWS.at(i) { if v==want { return true; } } i=i+1; }
    return false;
}
fn live_band(b: *Band) -> bool {
    if b.is_null() { return false; }
    let r=(*b).view;
    return live_view(r) && (*r).input==(b as *u8);
}
fn attach(r: *record::View) {
    let added: status::Status=VIEWS.append(r as usize); assert added==status::Status::Ok;
    let f=native::must::[ui::IPropertyValueStatics](ui::PropertyValue::i_property_value_statics_factory());
    let boxed=native::must::[rt::Object](f.create_u_int64(r as usize as u64));
    match ui::IFrameworkElement::query((*r).object.clone()) { result::Result::Ok(e)=>{ native::check(e.set_tag(boxed)); }, result::Result::Err(_)=>{} }
}
// Every apply: arm what the node's gestures now need, and act on the focus
// and blur commands.
fn apply(r: *record::View, n: *core::Node) {
    let g=gestures::gestures_of(n);
    let need: u32=bands_for(g);
    if need!=0 {
        let b=band_for(r);
        if b.is_not_null() {
            var i: usize=0;
            while i<BAND_COUNT { let bit: u32=(1 as u32)<<(i as u32); if (need & bit)!=0 { arm(b,bit,i); } i=i+1; }
        }
        // A container that reads keys must be able to hold the keyboard.
        if (need & B_KEY)!=0 && container((*r).kind) { native::check(element(r).set_is_tab_stop(true)); }
    }
    let d: u64=core::dirty_of(n);
    if (d & props::C_FOCUS)!=0 { focus(r); }
    if (d & props::C_BLUR)!=0 { blur(r); }
}
// FOCUS AND BLUR ARE COMMANDS: act on the bit, the sync walk clears it.
fn focus(r: *record::View) {
    let e=element(r);
    if container((*r).kind) { native::check(e.set_is_tab_stop(true)); }
    let took: bool=match e.focus(ui::focus_state_programmatic) { result::Result::Ok(v)=>{v}, result::Result::Err(_)=>{false} };
    // Not loaded yet: take it when it is (views::measured_loaded, or the
    // next apply).
    if !took { (*r).pending_focus=ui::focus_state_programmatic; }
}
// GIVE IT UP, do not hand it anywhere the app did not name: the keyboard goes
// to the window's content root, which runs no handlers of its own.
fn blur(r: *record::View) {
    let e=element(r);
    let root=match e.xaml_root() { result::Result::Ok(v)=>{v}, result::Result::Err(_)=>{ return; } };
    if root.is_null() { return; }
    let focus=native::must::[ui::IFocusManagerStatics](ui::FocusManager::i_focus_manager_statics_factory());
    let focused=match focus.get_focused_element_with_root(root.clone()) { result::Result::Ok(v)=>{v}, result::Result::Err(_)=>{ return; } };
    if focused.is_null() || view_of_element(focused)!=r { return; }
    let content=match native::must::[ui::IXamlRoot](ui::IXamlRoot::query(root)).content() { result::Result::Ok(v)=>{v}, result::Result::Err(_)=>{ return; } };
    if content.is_null() { return; }
    let sink=native::must::[ui::IUIElement](ui::IUIElement::query(content));
    native::check(sink.set_is_tab_stop(true));
    let _moved: bool=native::must::[bool](sink.focus(ui::focus_state_programmatic));
}
fn release(r: *record::View) {
    var i: usize=0; let want: usize=r as usize;
    while i<VIEWS.count() { if let option::Option::Some(v)=VIEWS.at(i) { if v==want { let gone: option::Option[usize]=VIEWS.swap_remove(i); break; } } i=i+1; }
    if (*r).input.is_null() { return; }
    let b=band_of(r);
    if (*b).timer!=0 { scheduler::cancel((*b).timer); (*b).timer=0; }
    // During Window.Closed WinUI is retiring the tree; detach callbacks only.
    var k: usize=0;
    while k<BAND_COUNT { disarm(b,(1 as u32)<<(k as u32),k); k=k+1; }
    let owner: box::Box[Band]=box::from_raw::[Band]((*r).input); (*r).input=0 as *u8;
}

// ---- who has the keyboard ---------------------------------------------------------
// The view an element belongs to: the nearest element up its visual tree whose
// Tag names a live view. Null for anything that is not facet's.
fn tagged(element: rt::Object) -> *record::View {
    let e=match ui::IFrameworkElement::query(element) { result::Result::Ok(v)=>{v}, result::Result::Err(_)=>{ return 0 as *record::View; } };
    let tag=match e.tag() { result::Result::Ok(v)=>{v}, result::Result::Err(_)=>{ return 0 as *record::View; } };
    if tag.is_null() { return 0 as *record::View; }
    let value=match ui::IPropertyValue::query(tag) { result::Result::Ok(v)=>{v}, result::Result::Err(_)=>{ return 0 as *record::View; } };
    let raw: u64=match value.get_u_int64() { result::Result::Ok(v)=>{v}, result::Result::Err(_)=>{ return 0 as *record::View; } };
    let r=raw as usize as *record::View;
    return if live_view(r) {r} else {0 as *record::View};
}
fn view_of_element(element: rt::Object) -> *record::View {
    let tree=native::must::[ui::IVisualTreeHelperStatics](ui::VisualTreeHelper::i_visual_tree_helper_statics_factory());
    var at: rt::Object=element.clone();
    var depth: i32=0;
    while !at.is_null() && depth<64 {
        let r=tagged(at.clone());
        if r.is_not_null() { return r; }
        at=match tree.get_parent(at) { result::Result::Ok(o)=>{o}, result::Result::Err(_)=>{ return 0 as *record::View; } };
        depth=depth+1;
    }
    return 0 as *record::View;
}
// The host's global focus events: the node that took or lost the keyboard
// says so (`is_focused`) and hears its own on_focus / on_blur.
fn focus_changed(element: rt::Object, gained: bool) {
    if presentation::is_shutting_down() { return; }
    let r=view_of_element(element);
    if r.is_null() || (*r).node.is_null() { return; }
    let n=(*r).node;
    let data=core::node_data(n);
    if data.is_null() { return; }
    core::set_focused(n,gained);
    if gained { core::fire_focus_handler(n); } else { core::fire_blur_handler(n); }
}
