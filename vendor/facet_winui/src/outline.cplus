fn props(r: *record::View) -> *tree::TreeProps { return (*core::node_data((*r).node)).props as *tree::TreeProps; }
fn lookup(n: *tree::TreeNode,id: str) -> *tree::TreeNode {
    if (*n).id.view()==id { return n; }
