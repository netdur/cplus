    }
    return rt::Status {code:0};
}
// Cache application-provided names during apply. Native layout only maps
// cached names to current containers, never calls application code.
fn row_name(p: *tree::TreeProps,model: *tree::TreeNode) -> text::Text {
    if (*p).row_id==tree::no_row_id {return text::new();}
    return (*p).row_id(model,content::context((*p).row_id_ctx,(*p).ctx));
}
fn name_rows(r: *record::View) {
    let state=(*r).extra as *State;if state.is_null() || !(*state).named {return;}
    let view=native::must::[ui::ITreeView2](ui::ITreeView2::query((*r).object));
