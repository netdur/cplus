            let other=native::must::[rt::Object]((*entry).object.query(rt::unknown_iid()));if other.raw()==identity.raw() {if !(*p).selection.has((*entry).id.view()) {changed=true;}let added=ids.add((*entry).id.view());break;}
        },option::Option::None=>{}}j=j+1;}
