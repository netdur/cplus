    let item=lookup(#addr_of((*p).root),(*p).selected.view());if item.is_null() || (*p).selected.is_empty() {return rt::Status {code:0};}
    let call=(*p).on_select;let context=if (*p).on_select_ctx.is_not_null() {(*p).on_select_ctx} else {(*p).ctx};if call!=tree::no_select {call(item,context);}return rt::Status {code:0};
}
fn expanded(sender: rt::Object,args: rt::Object,ctx: *u8) -> rt::Status {
    let r: *record::View=ctx as *record::View; if (*r).applying {return rt::Status {code:0};}
    let state: *State=(*r).extra as *State; let p: *tree::TreeProps=props(r);
    (*p).expanded.clear(); var i: usize=0;
