    let nodes=native::must::[ui::IVector_Microsoft_UI_Xaml_Controls_TreeViewNode](ui::IVector_Microsoft_UI_Xaml_Controls_TreeViewNode::query(native::must::[rt::Object](control.selected_nodes())));
    var ids=vocab::TextList::new();var i: u32=0;let count=native::must::[u32](nodes.size());var changed=(*p).selection.count()!=count as usize;
    while i<count {
