    var i: usize=0;while i<(*state).entries.count() {
        match (*state).entries.at_ptr(i) {option::Option::Some(entry)=>{
            let container=native::must::[rt::Object](view.container_from_node((*entry).object));
            if !container.is_null() && native::must::[text::Text](automation.get_automation_id(container)).view()!=(*entry).name.view() {native::check(automation.set_automation_id(container,(*entry).name.view()));}
        },option::Option::None=>{}}i=i+1;
