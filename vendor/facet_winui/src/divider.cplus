struct State {thumb: rt::Object,token: ui::EventRegistrationToken,inserted: bool}
static LIVE: i64=0;
fn subscriptions() -> i64 {return LIVE;}
fn dragged(sender: rt::Object,args: rt::Object,ctx: *u8) -> rt::Status {
    let r: *record::View=ctx as *record::View;let p: *split::SplitProps=(*core::node_data((*r).node)).props as *split::SplitProps;
