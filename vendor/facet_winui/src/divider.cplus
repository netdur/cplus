    let delta: f64=if (*p).axis==split::SplitAxis::Columns {native::must::[f64](event.horizontal_change())} else {native::must::[f64](event.vertical_change())};
    let frame=(*(*r).node).frame();let extent: f64=if (*p).axis==split::SplitAxis::Columns {frame.width} else {frame.height};var next: f64=(*p).position+delta;
    if next<(*p).min_leading {next=(*p).min_leading;}if (*p).max_leading>0.0f64 && next>(*p).max_leading {next=(*p).max_leading;}if next>extent-(*p).min_trailing {next=extent-(*p).min_trailing;}if (*p).max_trailing>0.0f64 && next<extent-(*p).max_trailing {next=extent-(*p).max_trailing;}
    (*p).position=next;core::touch((*r).node,split::P_POSITION);let call: fn(*u8,*u8)=(*p).on_move;let context: *u8=(*p).ctx;if call!=props::no_handler {call(ctx,context);}return rt::Status {code:0};
}
fn attach(r: *record::View) {
    let thumb: ui::Thumb=native::must::[ui::Thumb](ui::Thumb::new());let handler: ui::DragDeltaEventHandler=native::must::[ui::DragDeltaEventHandler](ui::DragDeltaEventHandler::new(dragged,r as *u8));let token: ui::EventRegistrationToken=native::must::[ui::EventRegistrationToken](thumb.add_drag_delta(handler.object()));
    let owner: box::Box[State]=match box::new::[State](State {thumb:thumb.object(),token:token,inserted:false}) {option::Option::Some(v)=>{v},option::Option::None=>{assert false;return;}};(*r).extra=owner.into_raw();LIVE=LIVE+1;return;
}
fn place(r: *record::View,width: f64,height: f64) {
