    if !(*s).inserted {let panel: ui::IPanel=native::must::[ui::IPanel](ui::IPanel::query((*r).content));let children: ui::IVector_Microsoft_UI_Xaml_UIElement=native::must::[ui::IVector_Microsoft_UI_Xaml_UIElement](ui::IVector_Microsoft_UI_Xaml_UIElement::query(native::must::[rt::Object](panel.children())));native::check(children.append((*s).thumb));(*s).inserted=true;}
    let element: ui::IFrameworkElement=native::must::[ui::IFrameworkElement](ui::IFrameworkElement::query((*s).thumb));let horizontal: bool=(*p).axis==split::SplitAxis::Columns;
    var position: f64=(*p).position;match core::child_of((*r).node,0) {option::Option::Some(child)=>{let f=(*child).frame();position=if horizontal {f.width} else {f.height};},option::Option::None=>{}}
    native::check(element.set_width(if horizontal {6.0f64} else {width}));native::check(element.set_height(if horizontal {height} else {6.0f64}));
    let canvas: ui::ICanvasStatics=native::must::[ui::ICanvasStatics](ui::Canvas::i_canvas_statics_factory());native::check(canvas.set_left((*s).thumb,if horizontal {position-3.0f64} else {0.0f64}));native::check(canvas.set_top((*s).thumb,if horizontal {0.0f64} else {position-3.0f64}));native::check(canvas.set_z_index((*s).thumb,100));
    let control: ui::IControl=native::must::[ui::IControl](ui::IControl::query((*s).thumb));native::check(control.set_background(style::brush(if (*p).divider_color.is_set() {(*p).divider_color} else {vocab::Color::outline()})));
    let a: ui::IAutomationPropertiesStatics=native::must::[ui::IAutomationPropertiesStatics](ui::AutomationProperties::i_automation_properties_statics_factory());native::check(a.set_name((*s).thumb,"Resize panes"));return;
}
fn release(r: *record::View) {let s: *State=(*r).extra as *State;let thumb: ui::IThumb=native::must::[ui::IThumb](ui::IThumb::query((*s).thumb));native::check(thumb.remove_drag_delta((*s).token));let owner: box::Box[State]=box::from_raw::[State]((*r).extra);(*r).extra=0 as *u8;LIVE=LIVE-1;return;}
