// facet_winui's headless suite. Nothing here starts the WinUI Application:
// that needs the staged runtime and a desktop, and is what the examples'
// verify scripts are for. These cover the host's bookkeeping that runs
// without XAML - and they give `cpc test` a root other than
// facet_winui.cplus, whose `run` (four parameters, three defaulted) the
// compiler otherwise lends its defaults to an unrelated local fn pointer
// named `run` in facet/services (E0308 "fn pointer `run` expects 1, got 4").
import "stdlib/text" as text;
import "stdlib/vec" as vec;
import "facet/facet" as core;
import "facet/screen" as screen;
import "facet/window_chrome" as chrome;
import "facet/label" as label;
import "./facet_winui" as host;
import "./dialogs" as dialogs;
import "./scheduler" as scheduler;

fn tm_noop(ctx: *u8) { return; }

#[test]
fn no_window_opens_before_launch() {
    // XAML windows exist only after Application.Start has launched.
    var root: core::Node = label::label("x", key: "probe");
    assert !host::launched();
    assert host::open_window(#addr_of(root), screen::Chrome::new()).is_null();
    assert host::window_count() == (0 as usize);
    assert host::active_host().is_null();
    return;
}

#[test]
fn window_buttons_are_found_anywhere_in_the_tree() {
    // Bar::Blended drops the system caption only for a tree that draws its own.
    var b: core::Builder = core::Builder::new();
    var inner: core::Builder = core::Builder::new();
    inner.add(chrome::window_buttons(key: "wb"));
    b.add(core::row(inner, key: "header"));
    var with: core::Node = core::column(b, key: "root");
    assert host::has_window_buttons(#addr_of(with));
    var bare: core::Node = label::label("x", key: "bare");
    assert !host::has_window_buttons(#addr_of(bare));
    assert !host::has_window_buttons(0 as *core::Node);
    return;
}

#[test]
fn observers_register_and_cancel() {
    let a: u64 = host::observe(1, tm_noop);
    let b: u64 = host::observe(3, tm_noop);
    assert a != (0 as u64);
    assert b != a;
    assert host::observe(2, 0 as fn(*u8)) == (0 as u64);
    host::cancel_observe(a);
    host::cancel_observe(a);   // idempotent
    host::cancel_observe(b);
    return;
}

#[test]
fn a_sheet_without_a_window_is_refused() {
    // No window to put it on: nothing is mounted and nothing is left behind.
    dialogs::alert_sheet("t", "m", "OK");
    assert !dialogs::live();
    assert dialogs::alert("t", "m", "OK") == -1;
    return;
}

#[test]
fn sheet_heights_follow_the_message() {
    assert dialogs::message_lines("") == 0.0f64;
    assert dialogs::message_lines("short") == 1.0f64;
    assert dialogs::message_lines("one\ntwo") == 2.0f64;
    var long: text::Text = text::new();
    var i: usize = 0;
    while i < (120 as usize) { long = long.appending("x"); i = i + (1 as usize); }
    assert dialogs::message_lines(long.view()) == 3.0f64;
    assert dialogs::capped(900.0f64) == 560.0f64;
    return;
}

static TM_ASKED: i32 = 0;
fn tm_refuse(ctx: *u8) -> bool { TM_ASKED = TM_ASKED + 1; return false; }
fn tm_allow(ctx: *u8) -> bool { TM_ASKED = TM_ASKED + 1; return true; }

#[test]
fn a_close_is_asked_through_the_window_policy() {
    // The question AppWindow.Closing and the window buttons put. With no
    // policy the answer is yes; a refusal is the policy's own answer.
    var h: host::Host = #zero::[host::Host]();
    assert host::ask_should_close(#addr_of(h));
    TM_ASKED = 0;
    h.should_close = tm_refuse;
    assert !host::ask_should_close(#addr_of(h));
    h.should_close = tm_allow;
    assert host::ask_should_close(#addr_of(h));
    assert TM_ASKED == 2;
    return;
}

#[test]
fn a_close_request_without_an_open_window_is_refused() {
    // NEGATIVE: no window is open, so nothing is asked and nothing closes.
    var h: host::Host = #zero::[host::Host]();
    TM_ASKED = 0;
    h.should_close = tm_allow;
    assert !host::request_close(0 as *host::Host);
    assert !host::request_close(#addr_of(h));
    assert TM_ASKED == 0;
    return;
}

#[test]
fn a_deferred_callback_runs_for_the_window_it_was_scheduled_from() {
    // The scheduler's pair nests: entering answers the window to restore.
    var a: host::Host = #zero::[host::Host]();
    var b: host::Host = #zero::[host::Host]();
    let outer: *u8 = host::enter_origin(#addr_of(a) as *u8);
    assert outer.is_null();
    let inner: *u8 = host::enter_origin(#addr_of(b) as *u8);
    assert inner == (#addr_of(a) as *u8);
    assert host::enter_origin(inner) == (#addr_of(b) as *u8);
    assert host::enter_origin(outer) == (#addr_of(a) as *u8);
    return;
}

#[test]
fn a_window_that_is_not_open_never_answers_who_asked() {
    // NEGATIVE: an origin that is not an open window (closed, or never
    // opened) is ignored, and with no event and no window nothing asked.
    var gone: host::Host = #zero::[host::Host]();
    let outer: *u8 = host::enter_origin(#addr_of(gone) as *u8);
    assert host::origin().is_null();
    assert host::capture_origin().is_null();
    assert host::asking_host().is_null();
    let _o: *u8 = host::enter_origin(outer);
    return;
}

static TM_HOPPED: i32 = 0;
fn tm_hop(ctx: *u8) { TM_HOPPED = TM_HOPPED + 1; }

#[test]
fn a_hop_with_no_dispatcher_is_dropped_not_run() {
    // NEGATIVE: before any run has published a queue, a worker's hop is
    // refused and its work never runs on the caller's thread.
    TM_HOPPED = 0;
    assert !scheduler::post(tm_hop, 0 as *u8);
    assert TM_HOPPED == 0;
    return;
}

static TM_APP_WIDE: i32 = 0;
static TM_OWN: i32 = 0;
fn tm_app_wide(ctx: *u8) { TM_APP_WIDE = TM_APP_WIDE + 1; }
fn tm_own(ctx: *u8) { TM_OWN = TM_OWN + 1; }

#[test]
fn a_window_observer_hears_only_its_own_window() {
    // App-wide observers hear every window; a window's own hear only it.
    var a: host::Host = #zero::[host::Host]();
    var b: host::Host = #zero::[host::Host]();
    TM_APP_WIDE = 0; TM_OWN = 0;
    let wide: u64 = host::observe(4, tm_app_wide);
    let own: u64 = host::observe_window(4, tm_own, 0 as *u8, #addr_of(a));
    host::fire(4, #addr_of(b));
    assert TM_APP_WIDE == 1;
    assert TM_OWN == 0;
    host::fire(4, #addr_of(a));
    assert TM_APP_WIDE == 2;
    assert TM_OWN == 1;
    // Another kind reaches neither.
    host::fire(3, #addr_of(a));
    assert TM_APP_WIDE == 2;
    assert TM_OWN == 1;
    host::cancel_observe(wide);
    host::cancel_observe(own);
    return;
}

#[test]
fn a_closed_window_takes_its_observers_with_it() {
    // NEGATIVE: once its window has gone, a window's observer never fires,
    // even for a later window at the same address.
    var a: host::Host = #zero::[host::Host]();
    TM_OWN = 0;
    let own: u64 = host::observe_window(4, tm_own, 0 as *u8, #addr_of(a));
    host::forget_observers_of(#addr_of(a));
    host::fire(4, #addr_of(a));
    assert TM_OWN == 0;
    host::cancel_observe(own);   // already gone: a no-op
    return;
}
