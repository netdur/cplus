fn clicked(sender: rt::Object, args: rt::Object, context: *u8) -> rt::Status {
    if (*(context as *View)).applying {return rt::Status {code:0};}
    let record: *View=context as *View;
    if choices::button_mode(record)!=(*record).button_toggles {return rt::Status {code:0};}
    let n: *core::Node=(*record).node;
    let data: *core::Data=core::node_data(n);
    if data.is_null() || !(*data).common.is_enabled { return rt::Status {code:0}; }
    let p: *props::ButtonProps=(*data).props as *props::ButtonProps;
    if (*p).toggles {
        let toggle: ui::IToggleButton=native::must::[ui::IToggleButton](ui::IToggleButton::query(sender));let checked: rt::Object=native::must::[rt::Object](toggle.is_checked());let reference: ui::IReference_Bool=native::must::[ui::IReference_Bool](ui::IReference_Bool::query(checked));(*p).on=native::must::[bool](reference.value());
    }
