    if kind!=props::K_TABLE && kind!=props::K_SWIPEABLE && kind!=props::K_CAROUSEL && kind!=core::K_NODE && kind!=props::K_LABEL && kind!=props::K_BUTTON && kind!=props::K_TEXT_FIELD && kind!=props::K_SCROLL && kind!=tree::K_TREE && kind!=split::K_SPLIT && kind!=props::K_SWIPE_ITEM && kind!=props::K_CANVAS && kind!=props::K_BOX && kind!=props::K_BORDERED && !items::supports(kind) && !media::supports(kind) && !pickers::supports(kind) && !editing::supports(kind) && !choices::supports(kind) { return false; }
    if core::view_of(n).is_not_null() || (kind!=props::K_TABLE && kind!=props::K_SWIPEABLE && kind!=props::K_CAROUSEL && kind!=core::K_NODE && kind!=props::K_SCROLL && kind!=split::K_SPLIT && kind!=props::K_BORDERED && count!=0) { return false; }
