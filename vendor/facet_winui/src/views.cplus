// Native records are owned by Facet Data.view_release, not by the WinUI tree.
// An event context borrows its record; unsubscribe before destroying the record.
import "stdlib/box" as box;
import "stdlib/option" as option;
import "stdlib/text" as text;
import "stdlib/io" as io;
import "stdlib/env" as env;
import "winrt/runtime" as rt;
import "winui/winui" as ui;
import "facet/facet" as core;
import "facet/props" as props;
import "facet/component" as component;
import "facet/vocabulary" as vocab;
import "facet/scroll" as scroll;
import "facet/text_field" as field;
import "flex_layout/flex_layout" as flex;
import "./native" as native;

struct View {
    object: rt::Object,
    content: rt::Object,
    opaque node: *core::Node,
    kind: u32,
    token: ui::EventRegistrationToken,
    subscribed: bool,
    applying: bool,
    scroll_pending: bool,
}
static LIVE: i64=0;
static SUBSCRIPTIONS: i64=0;
fn live_views() -> i64 { return LIVE; }
fn live_subscriptions() -> i64 { return SUBSCRIPTIONS; }
fn supports(n: *core::Node) -> bool {
    let kind: u32=core::kind_of(n); let count: usize=core::child_count_of(n);
    if kind!=core::K_NODE && kind!=props::K_LABEL && kind!=props::K_BUTTON && kind!=props::K_TEXT_FIELD && kind!=props::K_SCROLL { return false; }
    if core::view_of(n).is_not_null() || (kind!=core::K_NODE && kind!=props::K_SCROLL && count!=0) { return false; }
    if kind==props::K_TEXT_FIELD {
        let data: *core::Data=core::node_data(n);
        if (*( (*data).props as *props::TextFieldProps)).is_secure { return false; }
    }
    var i: usize=0;
    while i<count {
        match core::child_of(n,i) { option::Option::Some(child)=>{if !supports(child) {return false;}},option::Option::None=>{} }
        i=i+1;
    }
    return true;
}
fn measure(ctx: *u8, width: f64, wm: flex::MeasureMode, height: f64, hm: flex::MeasureMode) -> flex::Size {
    let value: rt::Object=object(ctx);
    let element: ui::IFrameworkElement=native::must::[ui::IFrameworkElement](ui::IFrameworkElement::query(value));
    let old_width: f64=native::must::[f64](element.width()); let old_height: f64=native::must::[f64](element.height());
    let automatic: f64=#bitcast::[f64](0x7ff8000000000000u64);
    native::check(element.set_width(automatic)); native::check(element.set_height(automatic));
    let layout: ui::IUIElement=native::must::[ui::IUIElement](ui::IUIElement::query(value));
    let infinity: f32=#bitcast::[f32](0x7f800000u32);
    native::check(layout.measure(ui::Size {width:if wm==flex::MeasureMode::Undefined {infinity} else {width as f32},height:if hm==flex::MeasureMode::Undefined {infinity} else {height as f32}}));
    let size: ui::Size=native::must::[ui::Size](layout.desired_size());
    native::check(element.set_width(old_width)); native::check(element.set_height(old_height));
    var w: f64=size.width as f64; var h: f64=size.height as f64;
    if wm==flex::MeasureMode::Exactly || (wm==flex::MeasureMode::AtMost && w>width) {w=width;}
    if hm==flex::MeasureMode::Exactly || (hm==flex::MeasureMode::AtMost && h>height) {h=height;}
    return flex::Size {width:w,height:h};
}

fn clicked(sender: rt::Object, args: rt::Object, context: *u8) -> rt::Status {
    let record: *View=context as *View;
    let n: *core::Node=(*record).node;
    let data: *core::Data=core::node_data(n);
    if data.is_null() || !(*data).common.is_enabled { return rt::Status {code:0}; }
    let p: *props::ButtonProps=(*data).props as *props::ButtonProps;
    // Copy both before invoking: the handler may remove and destroy this node.
    let call: fn(*u8,*u8)=(*p).on_click; let ctx: *u8=(*p).on_click_ctx;
    if call!=props::no_handler { call(context,ctx); }
    return rt::Status {code:0};
}

fn text_changed(sender: rt::Object, args: rt::Object, context: *u8) -> rt::Status {
    let record: *View=context as *View;
    if (*record).applying { return rt::Status {code:0}; }
    let n: *core::Node=(*record).node;
    if (core::dirty_of(n) & field::P_TEXT)!=0 { return rt::Status {code:0}; }
    let data: *core::Data=core::node_data(n);
    let p: *props::TextFieldProps=(*data).props as *props::TextFieldProps;
    let edit: ui::ITextBox=native::must::[ui::ITextBox](ui::ITextBox::query(sender));
    let value: text::Text=native::must::[text::Text](edit.text());
    // WinUI can deliver TextChanged after a programmatic set. Equality also
    // suppresses those deferred notifications, after the applying guard ends.
    if value.view()==(*p).input_view.text.view() { return rt::Status {code:0}; }
    (*p).input_view.text=value;
    (*p).input_view.cursor_position=native::must::[i32](edit.selection_start()) as i64;
    (*p).input_view.selection_length=native::must::[i32](edit.selection_length()) as i64;
    (*n).mark_content_changed();
    core::touch(n,0 as u64); // Schedule intrinsic layout even without an app callback.
    let call: fn(*u8,*u8)=(*p).input_view.on_text_changed;
    let ctx: *u8=(*p).input_view.on_text_changed_ctx;
    if call!=props::no_handler { call(context,ctx); }
    // The callback may have destroyed record and n.
    return rt::Status {code:0};
}
fn configure_text(record: *View, n: *core::Node) {
    let data: *core::Data=core::node_data(n);
    let p: *props::TextFieldProps=(*data).props as *props::TextFieldProps;
    assert !(*p).is_secure; // PasswordBox needs a separate implementation.
    let edit: ui::ITextBox=native::must::[ui::ITextBox](ui::ITextBox::query((*record).object));
    (*record).applying=true;
    native::check(edit.set_placeholder_text((*p).input_view.placeholder.view()));
    native::check(edit.set_is_read_only((*p).input_view.is_read_only));
    let limit: i64=(*p).input_view.max_length;
    native::check(edit.set_max_length(if limit<0 {0} else if limit>2147483647 {2147483647} else {limit as i32}));
    native::check(edit.set_is_spell_check_enabled((*p).input_view.checks_spelling));
    native::check(edit.set_is_text_prediction_enabled((*p).input_view.predicts_text));
    let current: text::Text=native::must::[text::Text](edit.text());
    if current.view()!=(*p).input_view.text.view() { native::check(edit.set_text((*p).input_view.text.view())); }
    // Reflect native normalization (for example MaxLength) without firing a
    // user-edit callback for a programmatic property update.
    (*p).input_view.text=native::must::[text::Text](edit.text());
    let control: ui::IControl=native::must::[ui::IControl](ui::IControl::query((*record).object));
    native::check(control.set_is_enabled((*data).common.is_enabled));
    if (*p).input_view.font_size>0.0f64 { native::check(control.set_font_size((*p).input_view.font_size)); }
    (*record).applying=false;
    return;
}
fn bar(value: vocab::ScrollBars) -> i32 {
    if value==vocab::ScrollBars::Always { return ui::scroll_bar_visibility_visible; }
    if value==vocab::ScrollBars::Never { return ui::scroll_bar_visibility_hidden; }
    return ui::scroll_bar_visibility_auto;
}
fn configure_scroll(record: *View, n: *core::Node) {
    let data: *core::Data=core::node_data(n);
    let p: *props::ScrollProps=(*data).props as *props::ScrollProps;
    let control: ui::IScrollViewer=native::must::[ui::IScrollViewer](ui::IScrollViewer::query((*record).object));
    (*record).applying=true;
    let horizontal: bool=(*p).axis==vocab::ScrollAxis::Both || (*p).axis==vocab::ScrollAxis::Horizontal;
    let vertical: bool=(*p).axis==vocab::ScrollAxis::Both || (*p).axis==vocab::ScrollAxis::Vertical;
    native::check(control.set_horizontal_scroll_mode(if horizontal {ui::scroll_mode_enabled} else {ui::scroll_mode_disabled}));
    native::check(control.set_vertical_scroll_mode(if vertical {ui::scroll_mode_enabled} else {ui::scroll_mode_disabled}));
    native::check(control.set_horizontal_scroll_bar_visibility(if horizontal {bar((*p).horizontal_scroll_bars)} else {ui::scroll_bar_visibility_disabled}));
    native::check(control.set_vertical_scroll_bar_visibility(if vertical {bar((*p).vertical_scroll_bars)} else {ui::scroll_bar_visibility_disabled}));
    if !(*record).subscribed || (core::dirty_of(n) & (scroll::P_SCROLL_X | scroll::P_SCROLL_Y))!=0 {
        (*record).scroll_pending=true;
    }
    (*record).applying=false;
    return;
}
fn scrolled(sender: rt::Object, args: rt::Object, context: *u8) -> rt::Status {
    let record: *View=context as *View;
    if (*record).scroll_pending || (*record).applying { return rt::Status {code:0}; }
    let data: *core::Data=core::node_data((*record).node);
    let p: *props::ScrollProps=(*data).props as *props::ScrollProps;
    let control: ui::IScrollViewer=native::must::[ui::IScrollViewer](ui::IScrollViewer::query(sender));
    let x: f64=native::must::[f64](control.horizontal_offset());
    let y: f64=native::must::[f64](control.vertical_offset());
    if x==(*p).scroll_x && y==(*p).scroll_y { return rt::Status {code:0}; }
    (*p).scroll_x=x; (*p).scroll_y=y;
    let call: fn(*u8,*u8)=(*p).observe_scrolled; let ctx: *u8=(*p).observe_scrolled_ctx;
    if call!=props::no_handler { call(context,ctx); }
    return rt::Status {code:0};
}
fn size_scroll(record: *View, n: *core::Node) {
    let frame: flex::Frame=(*n).frame(); var width: f64=frame.width; var height: f64=frame.height;
    var i: usize=0;
    while i<core::child_count_of(n) {
        match core::child_of(n,i) {
            option::Option::Some(child)=>{
                let f: flex::Frame=(*child).frame();
                let right: f64=f.left-frame.left+f.width; let bottom: f64=f.top-frame.top+f.height;
                if right>width {width=right;} if bottom>height {height=bottom;}
            },option::Option::None=>{}
        }
        i=i+1;
    }
    let content: ui::IFrameworkElement=native::must::[ui::IFrameworkElement](ui::IFrameworkElement::query((*record).content));
    native::check(content.set_width(width)); native::check(content.set_height(height));
    let data: *core::Data=core::node_data(n); let p: *props::ScrollProps=(*data).props as *props::ScrollProps;
    (*p).content_size=vocab::Size {width:width,height:height};
    if (*record).scroll_pending {
        let layout: ui::IUIElement=native::must::[ui::IUIElement](ui::IUIElement::query((*record).object));
        native::check(layout.update_layout());
        let control: ui::IScrollViewer=native::must::[ui::IScrollViewer](ui::IScrollViewer::query((*record).object));
        // Initial layout can run before the native viewport is loaded.
        if native::must::[f64](control.viewport_height())<=0.0f64 { return; }
        let factory: ui::IPropertyValueStatics=native::must::[ui::IPropertyValueStatics](ui::PropertyValue::i_property_value_statics_factory());
        let x: rt::Object=native::must::[rt::Object](factory.create_double((*p).scroll_x));
        let y: rt::Object=native::must::[rt::Object](factory.create_double((*p).scroll_y));
        let accepted: bool=native::must::[bool](control.change_view_with_optional_animation(x,y,rt::Object::empty(),true));
        (*record).scroll_pending=false;
    }
    return;
}
fn object(view: *u8) -> rt::Object {
    if view.is_null() { return rt::Object::empty(); }
    return (*(view as *View)).object.clone();
}
fn children(view: *u8) -> ui::IVector_Microsoft_UI_Xaml_UIElement {
    let record: *View=view as *View;
    let host: rt::Object=if (*record).kind==props::K_SCROLL {(*record).content.clone()} else {object(view)};
    let panel: ui::IPanel=native::must::[ui::IPanel](ui::IPanel::query(host));
    return native::must::[ui::IVector_Microsoft_UI_Xaml_UIElement](ui::IVector_Microsoft_UI_Xaml_UIElement::query(native::must::[rt::Object](panel.children())));
}
fn configure(record: *View, n: *core::Node) {
    let data: *core::Data=core::node_data(n);
    if data.is_null() { return; }
    let value: rt::Object=(*record).object.clone();
    if env::has_var("FACET_WINUI_TRACE") {
        let key: str=(*n).key(); let opacity: f64=(*data).common.opacity; let visible: bool=(*data).common.is_visible;
        io::eprintln("WinUI props ${key}: opacity=${opacity} visible=${visible}");
    }
    let element: ui::IUIElement=native::must::[ui::IUIElement](ui::IUIElement::query(value));
    native::check(element.set_opacity((*data).common.opacity));
    native::check(element.set_is_hit_test_visible(!(*data).common.input_transparent));
    native::check(element.set_visibility(if (*data).common.is_visible {0 as i32} else {1 as i32}));
    if (*record).kind==props::K_LABEL {
        let p: *props::LabelProps=(*data).props as *props::LabelProps;
        let label: ui::ITextBlock=native::must::[ui::ITextBlock](ui::ITextBlock::query(value));
        native::check(label.set_text((*p).text.view()));
        if (*p).font_size>0.0f64 { native::check(label.set_font_size((*p).font_size)); }
    }
    if (*record).kind==props::K_BUTTON {
        let p: *props::ButtonProps=(*data).props as *props::ButtonProps;
        let factory: ui::IPropertyValueStatics=native::must::[ui::IPropertyValueStatics](ui::PropertyValue::i_property_value_statics_factory());
        let content: ui::IContentControl=native::must::[ui::IContentControl](ui::IContentControl::query(value));
        native::check(content.set_content(native::must::[rt::Object](factory.create_string((*p).title.view()))));
        let control: ui::IControl=native::must::[ui::IControl](ui::IControl::query(value));
        native::check(control.set_is_enabled((*data).common.is_enabled));
        if (*p).font_size>0.0f64 { native::check(control.set_font_size((*p).font_size)); }
    }
    if (*record).kind==props::K_TEXT_FIELD { configure_text(record,n); }
    if (*record).kind==props::K_SCROLL { configure_scroll(record,n); }
    if (*record).kind==props::K_LABEL || (*record).kind==props::K_BUTTON || (*record).kind==props::K_TEXT_FIELD { (*n).mark_content_changed(); }
    return;
}
fn create(ctx: *u8, n: *core::Node) -> *u8 {
    let kind: u32=core::kind_of(n);
    var value: rt::Object=rt::Object::empty();
    if kind==props::K_LABEL { let v: ui::TextBlock=native::must::[ui::TextBlock](ui::TextBlock::new()); value=v.object(); }
    else if kind==props::K_BUTTON { let v: ui::Button=native::must::[ui::Button](ui::Button::new()); value=v.object(); }
    else if kind==props::K_TEXT_FIELD { let v: ui::TextBox=native::must::[ui::TextBox](ui::TextBox::new()); value=v.object(); }
    else if kind==props::K_SCROLL { let v: ui::ScrollViewer=native::must::[ui::ScrollViewer](ui::ScrollViewer::new()); value=v.object(); }
    else if kind==core::K_NODE { let v: ui::Canvas=native::must::[ui::Canvas](ui::Canvas::new()); value=v.object(); }
    else { io::eprintln("facet_winui unsupported node kind ${kind}"); assert false; return 0 as *u8; }
    let record: box::Box[View]=match box::new::[View](View {object:value,content:rt::Object::empty(),node:n,kind:kind,token:#zero::[ui::EventRegistrationToken](),subscribed:false,applying:false,scroll_pending:false}) {
        option::Option::Some(v)=>{v}, option::Option::None=>{assert false; return 0 as *u8;}
    };
    let p: *View=record.ptr();
    if kind==props::K_SCROLL {
        let canvas: ui::Canvas=native::must::[ui::Canvas](ui::Canvas::new()); (*p).content=canvas.object();
        let control: ui::IContentControl=native::must::[ui::IContentControl](ui::IContentControl::query((*p).object));
        native::check(control.set_content((*p).content));
    }
    configure(p,n);
    if kind==props::K_LABEL || kind==props::K_BUTTON || kind==props::K_TEXT_FIELD {
        (*n).set_context(p as *u8); (*n).set_measure(measure); (*n).mark_content_changed();
    }
    if kind==props::K_BUTTON {
        let button: ui::IButtonBase=native::must::[ui::IButtonBase](ui::IButtonBase::query((*p).object));
        let callback: ui::RoutedEventHandler=native::must::[ui::RoutedEventHandler](ui::RoutedEventHandler::new(clicked,p as *u8));
        (*p).token=native::must::[ui::EventRegistrationToken](button.add_click(callback.object()));
        (*p).subscribed=true; SUBSCRIPTIONS=SUBSCRIPTIONS+1;
    }
    if kind==props::K_TEXT_FIELD {
        let edit: ui::ITextBox=native::must::[ui::ITextBox](ui::ITextBox::query((*p).object));
        let callback: ui::TextChangedEventHandler=native::must::[ui::TextChangedEventHandler](ui::TextChangedEventHandler::new(text_changed,p as *u8));
        (*p).token=native::must::[ui::EventRegistrationToken](edit.add_text_changed(callback.object()));
        (*p).subscribed=true; SUBSCRIPTIONS=SUBSCRIPTIONS+1;
    }
    if kind==props::K_SCROLL {
        let control: ui::IScrollViewer=native::must::[ui::IScrollViewer](ui::IScrollViewer::query((*p).object));
        let callback: ui::EventHandler_Microsoft_UI_Xaml_Controls_ScrollViewerViewChangedEventArgs=native::must::[ui::EventHandler_Microsoft_UI_Xaml_Controls_ScrollViewerViewChangedEventArgs](ui::EventHandler_Microsoft_UI_Xaml_Controls_ScrollViewerViewChangedEventArgs::new(scrolled,p as *u8));
        (*p).token=native::must::[ui::EventRegistrationToken](control.add_view_changed(callback.object()));
        (*p).subscribed=true; SUBSCRIPTIONS=SUBSCRIPTIONS+1;
    }
    LIVE=LIVE+1;
    return record.into_raw();
}
fn release(view: *u8) {
    if view.is_null() { return; }
    let p: *View=view as *View;
    if (*p).subscribed {
        if (*p).kind==props::K_BUTTON {
            let button: ui::IButtonBase=native::must::[ui::IButtonBase](ui::IButtonBase::query((*p).object));
            native::check(button.remove_click((*p).token));
        } else if (*p).kind==props::K_TEXT_FIELD {
            let edit: ui::ITextBox=native::must::[ui::ITextBox](ui::ITextBox::query((*p).object)); native::check(edit.remove_text_changed((*p).token));
        } else if (*p).kind==props::K_SCROLL {
            let control: ui::IScrollViewer=native::must::[ui::IScrollViewer](ui::IScrollViewer::query((*p).object)); native::check(control.remove_view_changed((*p).token));
        }
        (*p).subscribed=false; SUBSCRIPTIONS=SUBSCRIPTIONS-1;
    }
    (*p).node=0 as *core::Node;
    let owner: box::Box[View]=box::from_raw::[View](view);
    LIVE=LIVE-1;
    return;
}
fn apply(ctx: *u8, n: *core::Node) {
    let v: *u8=core::view_of(n); if v.is_not_null() { configure(v as *View,n); }
    return;
}
fn insert(ctx: *u8, host: *u8, child: *u8, index: usize) {
    let list: ui::IVector_Microsoft_UI_Xaml_UIElement=children(host);
    native::check(list.insert_at(index as u32,object(child)));
    if env::has_var("FACET_WINUI_TRACE") { let count: u32=native::must::[u32](list.size()); io::eprintln("WinUI children=${count}"); }
    return;
}
fn remove(ctx: *u8, host: *u8, child: *u8) {
    let list: ui::IVector_Microsoft_UI_Xaml_UIElement=children(host);
    let count: u32=native::must::[u32](list.size());
    let target: rt::Object=native::must::[rt::Object](object(child).query(rt::unknown_iid()));
    var i: u32=0;
    while i<count {
        let item: rt::Object=native::must::[rt::Object](list.get_at(i));
        let identity: rt::Object=native::must::[rt::Object](item.query(rt::unknown_iid()));
        if identity.raw()==target.raw() { native::check(list.remove_at(i)); return; }
        i=i+1;
    }
    return;
}
fn place(n: *core::Node, parent: flex::Frame) {
    let frame: flex::Frame=(*n).frame(); let value: rt::Object=object(core::view_of(n));
    if env::has_var("FACET_WINUI_TRACE") {
        let key: str=(*n).key(); let x: f64=frame.left; let y: f64=frame.top; let w: f64=frame.width; let h: f64=frame.height;
        io::eprintln("WinUI frame ${key}: ${x},${y} ${w}x${h}");
    }
    if value.is_null() { return; }
    let element: ui::IFrameworkElement=native::must::[ui::IFrameworkElement](ui::IFrameworkElement::query(value));
    native::check(element.set_width(frame.width)); native::check(element.set_height(frame.height));
    let canvas: ui::ICanvasStatics=native::must::[ui::ICanvasStatics](ui::Canvas::i_canvas_statics_factory());
    native::check(canvas.set_left(value,frame.left-parent.left)); native::check(canvas.set_top(value,frame.top-parent.top));
    var i: usize=0;
    while i<core::child_count_of(n) {
        match core::child_of(n,i) { option::Option::Some(child)=>{place(child,frame);},option::Option::None=>{} }
        i=i+1;
    }
    if core::kind_of(n)==props::K_SCROLL { size_scroll(core::view_of(n) as *View,n); }
    return;
}
fn sender_key(sender: *u8) -> text::Text {
    let n: *core::Node=(*(sender as *View)).node;
    return text::from_str((*n).key());
}
fn sender_item(sender: *u8) -> *u8 {
    let n: *core::Node=(*(sender as *View)).node;
    return core::item_of(n);
}
fn install_readers() {
    var readers: component::SenderReaders=component::sender_readers_none();
    readers.key_of=sender_key; readers.item_of=sender_item; component::install_sender_readers(readers);
    return;
}
