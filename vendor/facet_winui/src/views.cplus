    else if kind==props::K_SCROLL { let v: ui::ScrollViewer=native::must::[ui::ScrollViewer](ui::ScrollViewer::new()); value=v.object(); }
    else if kind==props::K_CANVAS {let v: ui::Canvas=native::must::[ui::Canvas](ui::Canvas::new());value=v.object();}
    else if kind==chrome::K_WINDOW_BUTTONS {let v=native::must::[ui::Border](ui::Border::new());value=v.object();}
    else if media::supports(kind) {value=media::create(kind,n);}
    else if pickers::supports(kind) {value=pickers::create(kind);}
