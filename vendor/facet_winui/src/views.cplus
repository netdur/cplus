    if core::view_of(n).is_not_null() || (!menus::supports(kind) && kind!=props::K_TABS && kind!=props::K_REFRESHABLE && kind!=props::K_TABLE && kind!=props::K_SWIPEABLE && kind!=props::K_CAROUSEL && kind!=core::K_NODE && kind!=props::K_SCROLL && kind!=split::K_SPLIT && kind!=props::K_BORDERED && count!=0) { return false; }
