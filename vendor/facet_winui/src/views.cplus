fn prepare_layout(n: *core::Node) {
    let kind: u32=core::kind_of(n);
    if kind==props::K_SWIPE_ITEM {(*n).set_display(flex::Display::None);}
    if kind==split::K_SPLIT {
        let p: *split::SplitProps=(*core::node_data(n)).props as *split::SplitProps;
        let f: flex::Frame=(*n).frame();
        let extent: f64=if (*p).axis==split::SplitAxis::Columns {f.width} else {f.height};
        var position: f64=(*p).position;
        if position<(*p).min_leading {position=(*p).min_leading;}
        if (*p).max_leading>0.0f64 && position>(*p).max_leading {position=(*p).max_leading;}
        if extent>0.0f64 && position>extent-(*p).min_trailing {position=extent-(*p).min_trailing;}
        if position<0.0f64 {position=0.0f64;}
        if (*p).collapsed_leading {position=0.0f64;}
        if (*p).collapsed_trailing {position=extent;}
        (*n).set_flex_direction(if (*p).axis==split::SplitAxis::Columns {flex::FlexDirection::Row} else {flex::FlexDirection::Column});
        (*n).set_gap(flex::Gutter::All,flex::StyleLength::points((*p).divider_thickness));
        match core::child_of(n,0) {option::Option::Some(c)=>{(*c).set_flex_basis(flex::StyleLength::points(position));(*c).set_flex_grow(0.0f64);(*c).set_flex_shrink(0.0f64);},option::Option::None=>{}}
        match core::child_of(n,1) {option::Option::Some(c)=>{(*c).set_flex_basis(flex::StyleLength::points(0.0f64));(*c).set_flex_grow(1.0f64);},option::Option::None=>{}}
    }
    if kind==props::K_SCROLL {
        (*n).set_overflow(flex::Overflow::Scroll);
        match core::child_of(n,0) {option::Option::Some(c)=>{(*c).set_flex_shrink(0.0f64);},option::Option::None=>{}}
    }
    var i: usize=0;
    while i<core::child_count_of(n) {match core::child_of(n,i) {option::Option::Some(c)=>{prepare_layout(c);},option::Option::None=>{}} i=i+1;}
    return;
}
fn sender_key(sender: *u8) -> text::Text {
    let n: *core::Node=(*(sender as *View)).node;
    return text::from_str((*n).key());
}
fn sender_item(sender: *u8) -> *u8 {
    var r: *View=sender as *View;
    while r.is_not_null() {let item: *u8=core::item_of((*r).node);if item.is_not_null() {return item;}r=(*r).parent as *View;}
    return 0 as *u8;
}
fn install_readers() {
    var readers: component::SenderReaders=component::sender_readers_none();
    readers.key_of=sender_key; readers.item_of=sender_item; component::install_sender_readers(readers);
    return;
}

fn layout_row(n: *core::Node,width: f64,height: f64) -> f64 {prepare_layout(n);(*n).calculate_layout(width:width,height:height);place(n,(*n).frame());return (*n).frame().height;}
