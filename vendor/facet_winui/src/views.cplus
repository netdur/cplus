type View = record::View;
static LIVE: i64=0;
static SUBSCRIPTIONS: i64=0;
fn live_views() -> i64 { return LIVE; }
fn live_subscriptions() -> i64 { return SUBSCRIPTIONS+outline::subscriptions()+choices::subscriptions()+editing::subscriptions()+pickers::subscriptions()+media::subscriptions()+items::subscriptions()+actions::subscriptions()+divider::subscriptions()+presentation::subscriptions(); }
fn supports(n: *core::Node) -> bool {
