fn place(row: *Row,width: f64,height: i64,layout: fn(*core::Node,f64,f64)->f64) {
    let element=native::must::[ui::IFrameworkElement](ui::IFrameworkElement::query((*row).canvas));let actual=native::must::[f64](element.actual_width());
    let available=if actual>0.0f64 {actual} else {width-40.0f64-(*row).depth as f64*16.0f64};
    mount::sync_from(#addr_of((*row).node));let result=layout(#addr_of((*row).node),if available>0.0f64 {available} else {1.0f64},if height>0 {if height>4 {height as f64-4.0f64} else {1.0f64}} else {flex::undefined()});
    if result!=(*row).height {native::check(element.set_height(result));(*row).height=result;}
