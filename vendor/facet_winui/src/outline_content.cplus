struct Row {node: core::Node,canvas: rt::Object,token: ui::EventRegistrationToken,opaque host: *record::View,id: text::Text,kind: usize,depth: usize,height: f64}
static LIVE: i64=0;
fn subscriptions() -> i64 {return LIVE;}
fn context(own: *u8,shared: *u8) -> *u8 {return if own.is_not_null() {own} else {shared};}
fn lookup(model: *tree::TreeNode,id: str) -> *tree::TreeNode {
    if (*model).id.view()==id {return model;}var i: usize=0;while i<(*model).child_count() {match (*model).child_ptr(i) {option::Option::Some(child)=>{let found=lookup(child,id);if found.is_not_null() {return found;}},option::Option::None=>{}}i=i+1;}return 0 as *tree::TreeNode;
}
fn item(ctx: *u8) -> *u8 {let row=ctx as *Row;let p=(*core::node_data((*(*row).host).node)).props as *tree::TreeProps;return lookup(#addr_of((*p).root),(*row).id.view()) as *u8;}
fn shape(p: *tree::TreeProps,model: *tree::TreeNode) -> usize {return (*p).row_kind(model,context((*p).row_kind_ctx,(*p).ctx));}
fn children(row: *Row) -> ui::IVector_Microsoft_UI_Xaml_UIElement {let panel=native::must::[ui::IPanel](ui::IPanel::query((*row).canvas));return native::must::[ui::IVector_Microsoft_UI_Xaml_UIElement](ui::IVector_Microsoft_UI_Xaml_UIElement::query(native::must::[rt::Object](panel.children())));}
fn sized(sender: rt::Object,args: rt::Object,ctx: *u8) -> rt::Status {let row=ctx as *Row;core::touch((*(*row).host).node,0u64);return rt::Status {code:0};}
fn realise(row: *Row,model: *tree::TreeNode,p: *tree::TreeProps) {
    let n=#addr_of((*row).node);
    if (*p).bind!=tree::no_bind {(*p).bind(model,context((*p).bind_ctx,(*p).ctx),n);}
    let view=mount::realise(n) as *record::View;assert view.is_not_null();(*view).parent=(*row).host as *u8;(*view).item_reader=item;(*view).item_context=row as *u8;
    native::check(children(row).append(record::visual(view)));native_slot::bind(view,(*row).canvas,native_slot::PANEL);
