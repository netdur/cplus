fn create(host: *record::View,model: *tree::TreeNode,p: *tree::TreeProps,depth: usize) -> *Row {
    let canvas=native::must::[ui::Canvas](ui::Canvas::new());
    let owner=match box::new::[Row](Row {node:(*p).row(model,context((*p).row_ctx,(*p).ctx)),canvas:canvas.object(),token:#zero::[ui::EventRegistrationToken](),host:host,id:text::from_str((*model).id.view()),kind:shape(p,model),depth:depth,height:-1.0f64}) {option::Option::Some(v)=>v,option::Option::None=>{assert false;return 0 as *Row;}};
    let row=owner.ptr();realise(row,model,p);
    let element=native::must::[ui::IFrameworkElement](ui::IFrameworkElement::query(canvas.object()));let callback=native::must::[ui::SizeChangedEventHandler](ui::SizeChangedEventHandler::new(sized,row as *u8));(*row).token=native::must::[ui::EventRegistrationToken](element.add_size_changed(callback.object()));LIVE=LIVE+1;return owner.into_raw() as *Row;
}
fn refresh(row: *Row,model: *tree::TreeNode,p: *tree::TreeProps,rebuild: bool) {
    let kind=shape(p,model);
    if rebuild || kind!=(*row).kind {
        native::check(children(row).clear());mount::unrealise(#addr_of((*row).node));
        (*row).node=(*p).row(model,context((*p).row_ctx,(*p).ctx));(*row).kind=kind;realise(row,model,p);
    } else if (*p).bind!=tree::no_bind {(*p).bind(model,context((*p).bind_ctx,(*p).ctx),#addr_of((*row).node));}
