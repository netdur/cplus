fn navigated(sender: rt::Object,args: rt::Object,ctx: *u8) -> rt::Status {
    let s=ctx as *State;let event=native::must::[ui::ICoreWebView2NavigationCompletedEventArgs](ui::ICoreWebView2NavigationCompletedEventArgs::query(args));
    if (*s).awaiting_navigation || native::must::[u64](event.navigation_id())!=(*s).navigation {return rt::Status {code:0};}
