// Optional integration seam. The renderer never imports an agent package.
import "winrt/runtime" as rt;
import "facet/facet" as core;
struct Hooks {
    opened: fn(rt::Object),
    closing: fn(),
    apply: fn(rt::Object,*core::Node),
    alias: fn(rt::Object,*core::Node,str),
    release: fn(rt::Object),
}
static _HOOKS: Hooks=#zero::[Hooks]();
fn install(hooks: Hooks) { _HOOKS=hooks; }
fn opened(window: rt::Object) { if _HOOKS.opened.is_not_null() { (_HOOKS.opened)(window); } }
fn closing() { if _HOOKS.closing.is_not_null() { (_HOOKS.closing)(); } }
fn apply(object: rt::Object,node: *core::Node) { if _HOOKS.apply.is_not_null() { (_HOOKS.apply)(object,node); } }
fn release(object: rt::Object) { if _HOOKS.release.is_not_null() { (_HOOKS.release)(object); } }

// An auxiliary native view of the same logical node needs a distinct identity
// while inheriting its policy. It is unpinned through the ordinary release hook.
fn alias(object: rt::Object,node: *core::Node,key: str) {if _HOOKS.alias.is_not_null() {(_HOOKS.alias)(object,node,key);}}
