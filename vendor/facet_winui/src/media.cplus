static LIVE: i64=0;
fn subscriptions() -> i64 {return LIVE+browser::subscriptions()+hybrid::subscriptions();}
fn supports(k: u32) -> bool {return k==props::K_PAGE_DOTS || k==props::K_WEB || k==props::K_HYBRID_WEB || k==props::K_ICON_BUTTON || k==props::K_IMAGE || k==props::K_SPAN || k==symbol::K_SYMBOL;}
fn create(k: u32,n: *core::Node) -> rt::Object {
    if k==props::K_PAGE_DOTS {let v: ui::Canvas=native::must::[ui::Canvas](ui::Canvas::new());return v.object();}
    if k==props::K_WEB || k==props::K_HYBRID_WEB {let v: ui::WebView2=native::must::[ui::WebView2](ui::WebView2::new());return v.object();}
    if k==props::K_ICON_BUTTON {let p: *props::IconButtonProps=(*core::node_data(n)).props as *props::IconButtonProps;if (*p).toggles {let v=native::must::[ui::ToggleButton](ui::ToggleButton::new());return v.object();}let v: ui::Button=native::must::[ui::Button](ui::Button::new());return v.object();}
    if k==props::K_IMAGE || k==symbol::K_SYMBOL {let v: ui::Border=native::must::[ui::Border](ui::Border::new());return v.object();}
    let v: ui::TextBlock=native::must::[ui::TextBlock](ui::TextBlock::new());return v.object();
}
fn named(name: str) -> u32 {
    if name=="gearshape" {return icons::settings;}
    if name=="star" {return icons::star;}
    if name=="archivebox" {return icons::archive;}
    if name=="trash" {return icons::delete;}
    if name=="plus" {return icons::add;}
    if name=="magnifyingglass" {return icons::search;}
    if name=="house" || name=="house.fill" {return icons::home;}
    return icons::help;
}
fn icon(label: ui::ITextBlock,code: u32,size: f64,color: vocab::Color,font: str="") {
    let text: text::Text=typography::glyph(code);native::check(label.set_text(text.view()));
    native::check(label.set_font_family(typography::font(if font.count()>0 {font} else {"ms-appx:///MaterialSymbolsOutlined.ttf#Material Symbols Outlined"})));
    native::check(label.set_font_size(if size>0.0f64 {size} else {24.0f64}));
    native::check(label.set_foreground(style::brush(if color.is_set() {color} else {vocab::Color::ink()})));return;
}
fn uri(source: str) -> rt::Object {return imaging::uri(source);}
fn image_source(source: str) -> bool {
    let lower=text::from_str(source).lowercased();let name=lower.view();
    return name.has_prefix("https:") || name.has_prefix("http:") || name.has_prefix("file:") || name.has_prefix("ms-appx:") || name.has_suffix(".png") || name.has_suffix(".jpg") || name.has_suffix(".jpeg") || name.has_suffix(".gif") || name.has_suffix(".bmp") || name.has_suffix(".webp") || name.has_suffix(".ico");
}
fn stretch(fit: vocab::ImageFit) -> i32 {return if fit==vocab::ImageFit::Fill {ui::stretch_fill} else if fit==vocab::ImageFit::AspectFill {ui::stretch_uniform_to_fill} else if fit==vocab::ImageFit::Center {ui::stretch_none} else {ui::stretch_uniform};}
