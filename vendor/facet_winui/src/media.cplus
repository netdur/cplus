fn clicked(sender: rt::Object,args: rt::Object,context: *u8) -> rt::Status {
    if (*(context as *record::View)).applying {return rt::Status {code:0};}
    let r: *record::View=context as *record::View;let p: *props::IconButtonProps=(*core::node_data((*r).node)).props as *props::IconButtonProps;
    if (*p).toggles!=(*r).button_toggles {return rt::Status {code:0};}
    if (*p).toggles {(*p).on=choices::is_checked(sender);}let call: fn(*u8,*u8)=(*p).on_clicked;let ctx: *u8=(*p).on_clicked_ctx;
