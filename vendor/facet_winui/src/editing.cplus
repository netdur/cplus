import "stdlib/text" as text;
import "facet/facet" as core;
import "facet/props" as props;
import "facet/text_field" as field;
import "facet/text_area" as area;
import "facet/search_field" as search;
import "winui/winui" as ui;
import "winrt/runtime" as rt;
import "./record" as record;
import "./native" as native;
import "./style" as style;
static LIVE: i64=0;
fn subscriptions() -> i64 {return LIVE;}
fn supports(k: u32) -> bool {return k==props::K_TEXT_FIELD || k==props::K_TEXT_AREA || k==props::K_SEARCH_FIELD;}
fn input(n: *core::Node) -> *props::InputViewProps {
    let raw: *u8=(*core::node_data(n)).props;let k: u32=core::kind_of(n);
    if k==props::K_TEXT_FIELD {return #addr_of((*(raw as *props::TextFieldProps)).input_view);}
    if k==props::K_TEXT_AREA {return #addr_of((*(raw as *props::TextAreaProps)).input_view);}
    return #addr_of((*(raw as *props::SearchFieldProps)).input_view);
}
fn secure(n: *core::Node) -> bool {return core::kind_of(n)==props::K_TEXT_FIELD && (*((*core::node_data(n)).props as *props::TextFieldProps)).is_secure;}
fn create(n: *core::Node) -> rt::Object {
    if secure(n) {let v: ui::PasswordBox=native::must::[ui::PasswordBox](ui::PasswordBox::new());return v.object();}
    let v: ui::TextBox=native::must::[ui::TextBox](ui::TextBox::new());return v.object();
}
fn read(r: *record::View) -> text::Text {
    if secure((*r).node) {let edit: ui::IPasswordBox=native::must::[ui::IPasswordBox](ui::IPasswordBox::query((*r).object));return native::must::[text::Text](edit.password());}
    let edit: ui::ITextBox=native::must::[ui::ITextBox](ui::ITextBox::query((*r).object));return native::must::[text::Text](edit.text());
}
fn changed(sender: rt::Object,args: rt::Object,context: *u8) -> rt::Status {
    let r: *record::View=context as *record::View;if (*r).applying {return rt::Status {code:0};}
    let n: *core::Node=(*r).node;
    let bit: u64=if (*r).kind==props::K_TEXT_FIELD {field::P_TEXT} else if (*r).kind==props::K_TEXT_AREA {area::P_TEXT} else {search::P_TEXT};
    if (core::dirty_of(n)&bit)!=0 {return rt::Status {code:0};}
    let p: *props::InputViewProps=input(n);let value: text::Text=read(r);
    if value.view()==(*p).text.view() {return rt::Status {code:0};};
    (*p).text=value;
    if !secure(n) {let edit: ui::ITextBox=native::must::[ui::ITextBox](ui::ITextBox::query((*r).object));(*p).cursor_position=native::must::[i32](edit.selection_start()) as i64;(*p).selection_length=native::must::[i32](edit.selection_length()) as i64;}
    (*n).mark_content_changed();core::touch(n,0 as u64);
    let call: fn(*u8,*u8)=(*p).on_text_changed;let ctx: *u8=(*p).on_text_changed_ctx;
    if call!=props::no_handler {call(context,ctx);}return rt::Status {code:0};
}
fn apply(r: *record::View) {
    let n: *core::Node=(*r).node;let p: *props::InputViewProps=input(n);let d: *core::Data=core::node_data(n);(*r).applying=true;
    let limit: i64=(*p).max_length;let maximum: i32=if limit<0 {0} else if limit>2147483647 {2147483647} else {limit as i32};
    let current: text::Text=read(r);
    if secure(n) {
        let edit: ui::IPasswordBox=native::must::[ui::IPasswordBox](ui::IPasswordBox::query((*r).object));
        native::check(edit.set_max_length(maximum));native::check(edit.set_placeholder_text((*p).placeholder.view()));
        if current.view()!=(*p).text.view() {native::check(edit.set_password((*p).text.view()));}
    } else {
        let edit: ui::ITextBox=native::must::[ui::ITextBox](ui::ITextBox::query((*r).object));
        native::check(edit.set_placeholder_text((*p).placeholder.view()));native::check(edit.set_is_read_only((*p).is_read_only));native::check(edit.set_max_length(maximum));
        native::check(edit.set_is_spell_check_enabled((*p).checks_spelling));native::check(edit.set_is_text_prediction_enabled((*p).predicts_text));
        native::check(edit.set_accepts_return((*r).kind==props::K_TEXT_AREA));native::check(edit.set_text_wrapping(if (*r).kind==props::K_TEXT_AREA {ui::text_wrapping_wrap} else {ui::text_wrapping_no_wrap}));
        if current.view()!=(*p).text.view() {native::check(edit.set_text((*p).text.view()));}
    }
    (*p).text=read(r);let control: ui::IControl=native::must::[ui::IControl](ui::IControl::query((*r).object));
    native::check(control.set_is_enabled((*d).common.is_enabled && (!secure(n) || !(*p).is_read_only)));
    if (*p).font_size>0.0f64 {native::check(control.set_font_size((*p).font_size));}
    if (*p).text_color.is_set() {native::check(control.set_foreground(style::brush((*p).text_color)));}
    (*r).applying=false;(*n).mark_content_changed();return;
}
fn attach(r: *record::View) {
    if secure((*r).node) {
        let edit: ui::IPasswordBox=native::must::[ui::IPasswordBox](ui::IPasswordBox::query((*r).object));let callback: ui::RoutedEventHandler=native::must::[ui::RoutedEventHandler](ui::RoutedEventHandler::new(changed,r as *u8));(*r).token=native::must::[ui::EventRegistrationToken](edit.add_password_changed(callback.object()));
    } else {
        let edit: ui::ITextBox=native::must::[ui::ITextBox](ui::ITextBox::query((*r).object));let callback: ui::TextChangedEventHandler=native::must::[ui::TextChangedEventHandler](ui::TextChangedEventHandler::new(changed,r as *u8));(*r).token=native::must::[ui::EventRegistrationToken](edit.add_text_changed(callback.object()));
    }
    LIVE=LIVE+1;return;
}
fn release(r: *record::View) {
    if secure((*r).node) {let edit: ui::IPasswordBox=native::must::[ui::IPasswordBox](ui::IPasswordBox::query((*r).object));native::check(edit.remove_password_changed((*r).token));}
    else {let edit: ui::ITextBox=native::must::[ui::ITextBox](ui::ITextBox::query((*r).object));native::check(edit.remove_text_changed((*r).token));}
    LIVE=LIVE-1;return;
}
