fn date_time(date: vocab::Date) -> ui::DateTime {
    let calendar: ui::Calendar=native::must::[ui::Calendar](ui::Calendar::new());
    native::check(calendar.change_calendar_system("GregorianCalendar"));native::check(calendar.set_day(1));native::check(calendar.set_year(date.year as i32));native::check(calendar.set_month(date.month as i32));native::check(calendar.set_day(date.day as i32));
    return native::must::[ui::DateTime](calendar.get_date_time());
}
fn date(value: ui::DateTime) -> vocab::Date {
    let calendar: ui::Calendar=native::must::[ui::Calendar](ui::Calendar::new());native::check(calendar.change_calendar_system("GregorianCalendar"));native::check(calendar.set_date_time(value));
    return vocab::Date {year:native::must::[i32](calendar.year()) as i64,month:native::must::[i32](calendar.month()) as i64,day:native::must::[i32](calendar.day()) as i64};
}
// Common numeric patterns shared by applications; other strings use WinUI's
// DateTimeFormatter template/pattern grammar. This is not a general .NET/ICU parser.
fn date_pattern(value: str) -> str {
    if value=="yyyy-MM-dd" {return "{year.full}-{month.integer(2)}-{day.integer(2)}";}
    if value=="dd/MM/yyyy" {return "{day.integer(2)}/{month.integer(2)}/{year.full}";}
    if value=="MM/dd/yyyy" {return "{month.integer(2)}/{day.integer(2)}/{year.full}";}
    if value=="d/M/yyyy" {return "{day.integer}/{month.integer}/{year.full}";}
    if value=="M/d/yyyy" {return "{month.integer}/{day.integer}/{year.full}";}
    if value=="dd.MM.yyyy" {return "{day.integer(2)}.{month.integer(2)}.{year.full}";}
    if value=="yyyy/MM/dd" {return "{year.full}/{month.integer(2)}/{day.integer(2)}";}
    if value=="MM/dd/yy" {return "{month.integer(2)}/{day.integer(2)}/{year.abbreviated}";}
    return value;
}
// TimePicker controls hour cycle, not arbitrary text layout or seconds.
fn time_clock(value: str) -> str {
    if value=="HH:mm" || value=="H:mm" || value=="24HourClock" {return "24HourClock";}
    if value=="hh:mm tt" || value=="h:mm tt" || value=="hh:mm a" || value=="h:mm a" || value=="12HourClock" {return "12HourClock";}
    return "";
}
