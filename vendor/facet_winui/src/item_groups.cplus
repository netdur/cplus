// Group headers occupy visual slots but never consume a data index.
import "stdlib/vec" as vec;
import "stdlib/option" as option;
import "facet/facet" as core;
import "facet/props" as props;
import "./record" as record;
struct Slot {data: i64,column: usize}
struct Map {total: usize,slots: vec::Vec[Slot],header: fn(usize,*u8)->core::Node,opaque header_ctx: *u8}
fn empty() -> Map {return Map {total:0,slots:vec::new::[Slot](),header:props::no_group_header,header_ctx:0 as *u8};}
fn data(m: *Map,index: usize) -> i64 {return match (*m).slots.at(index) {option::Option::Some(v)=>v.data,option::Option::None=>index as i64};}
fn column(m: *Map,index: usize,columns: usize) -> usize {return match (*m).slots.at(index) {option::Option::Some(v)=>v.column,option::Option::None=>index%columns};}
fn visual(m: *Map,index: usize) -> usize {
    if (*m).slots.count()==0 {return index;}
    var i: usize=0;while i<(*m).slots.count() {if data(m,i)==index as i64 {return i;}i=i+1;}return (*m).slots.count();
}
fn build(r: *record::View,columns: usize) -> Map {
    var out=empty();let raw=(*core::node_data((*r).node)).props;
    var count: i64=0;var size: fn(usize,*u8)->usize=props::no_group_size;var ctx: *u8=0 as *u8;
    if (*r).kind==props::K_LIST {let p=raw as *props::ListProps;if (*p).is_grouped {count=(*p).group_count;}size=(*p).group_size;ctx=(*p).group_size_ctx;out.header=(*p).group_header;out.header_ctx=(*p).group_header_ctx;}
    if (*r).kind==props::K_COLLECTION {let p=raw as *props::CollectionProps;if (*p).groupable_items_view.is_grouped {count=(*p).group_count;}size=(*p).group_size;ctx=(*p).group_size_ctx;out.header=(*p).group_header;out.header_ctx=(*p).group_header_ctx;}
    if size==props::no_group_size {return out;}
    var group: i64=0;var flat: i64=0;
    while group<count {
        let header=out.slots.append(Slot {data:0i64-group-1,column:0});let length=size(group as usize,ctx);var i: usize=0;
        while i<length {let added=out.slots.append(Slot {data:flat,column:i%columns});flat=flat+1;i=i+1;}group=group+1;
    }
    out.total=flat as usize;return out;
}
