// Local hybrid assets are served through WebResourceRequested, so every asset
// participates in the application's resource callback. No HTTP server is used.
import "stdlib/text" as text;
import "stdlib/option" as option;
import "stdlib/result" as result;
import "winrt/runtime" as rt;
import "winui/winui" as ui;
import "./native" as native;
extern fn GetFullPathNameW(path: *u16,count: u32,buffer: *u16,part: **u16) -> u32;
extern fn WindowsGetStringRawBuffer(value: usize,length: *u32) -> *u16;
extern fn WindowsCreateString(source: *u16,length: u32,value: *usize) -> i32;
extern fn CreateRandomAccessStreamOnFile(path: *u16,mode: u32,iid: *rt::Guid,value: **u8) -> i32;
fn full_path(path: str) -> text::Text {
    if path.count()==0 {return text::new();}
    let input=native::must::[rt::HString](rt::HString::new(path));var length: u32=0;
    var buffer: [u16;32768]=#zero::[[u16;32768]]();
    let size=GetFullPathNameW(WindowsGetStringRawBuffer(input.raw(),#addr_of(length)),32768,#addr_of(buffer) as *u16,0 as **u16);
    if size==0 || size>=32768 {return text::new();}
    var raw: usize=0;native::check(rt::Status {code:WindowsCreateString(#addr_of(buffer) as *u16,size,#addr_of(raw))});let value=rt::HString::adopt(raw);return native::must::[text::Text](value.to_text());
}
fn relative(path: str) -> bool {
    if path.count()==0 || path.has_prefix("/") || path.has_suffix("/") {return false;}
    var start: usize=0;var i: usize=0;
    while i<=path.count() {
        let b=match path.byte_at(i) {option::Option::Some(v)=>v,option::Option::None=>0u8};
        if i<path.count() && (b==0u8 || b==92u8 || b==58u8 || b==63u8 || b==35u8) {return false;}
        if i==path.count() || b==47u8 {
            let part=match path.slice(from:start,to:i) {option::Option::Some(v)=>v,option::Option::None=>{return false;}};
            if part=="" || part=="." || part==".." || part.has_suffix(".") || part.has_suffix(" ") {return false;}start=i+1;
        }
        i=i+1;
    }
    return true;
}
fn mime(path: str) -> str {
    let lower=text::from_str(path).lowercased();let p=lower.view();
    if p.has_suffix(".html") || p.has_suffix(".htm") {return "text/html; charset=utf-8";}
    if p.has_suffix(".js") || p.has_suffix(".mjs") {return "text/javascript; charset=utf-8";}
    if p.has_suffix(".css") {return "text/css; charset=utf-8";}
    if p.has_suffix(".json") {return "application/json; charset=utf-8";}
    if p.has_suffix(".svg") {return "image/svg+xml";}if p.has_suffix(".png") {return "image/png";}
    if p.has_suffix(".jpg") || p.has_suffix(".jpeg") {return "image/jpeg";}if p.has_suffix(".webp") {return "image/webp";}
    if p.has_suffix(".gif") {return "image/gif";}if p.has_suffix(".ico") {return "image/x-icon";}
    if p.has_suffix(".woff2") {return "font/woff2";}if p.has_suffix(".woff") {return "font/woff";}
    if p.has_suffix(".wasm") {return "application/wasm";}if p.has_suffix(".txt") {return "text/plain; charset=utf-8";}
    return "application/octet-stream";
}
fn response(environment: rt::Object,root: str,address: str,origin: str,method: str) -> rt::Object {
    let env=native::must::[ui::ICoreWebView2Environment](ui::ICoreWebView2Environment::query(environment));
    var stream=rt::Object::empty();var code: i32=404;var content_type=text::from_str("text/plain; charset=utf-8");
    if address.has_prefix(origin) && root.count()>0 && (method=="GET" || method=="HEAD") {
        let factory=native::must::[ui::IUriRuntimeClassFactory](ui::Uri::i_uri_runtime_class_factory_factory());
        if let result::Result::Ok(object)=factory.create_uri(address) {
            let uri=native::must::[ui::IUriRuntimeClass](ui::IUriRuntimeClass::query(object));let escaped=native::must::[text::Text](uri.path());
            let decoder=native::must::[ui::IUriEscapeStatics](ui::Uri::i_uri_escape_statics_factory());
            if let result::Result::Ok(decoded)=decoder.unescape_component(escaped.view()) {
                if let option::Option::Some(path)=decoded.view().slice(from:1,to:decoded.count()) {
                    if relative(path) {
                        let full=full_path("${root}/${path}");let wide=native::must::[rt::HString](rt::HString::new(full.view()));var length: u32=0;var raw: *u8=0 as *u8;var iid=ui::i_random_access_stream_iid();
                        let status=CreateRandomAccessStreamOnFile(WindowsGetStringRawBuffer(wide.raw(),#addr_of(length)),0,#addr_of(iid),#addr_of(raw));
                        if status>=0 {stream=rt::Object::adopt(raw);code=200;content_type=text::from_str(mime(path));}
                    } else {code=403;}
                }
            }
        }
    }
    if method!="GET" && method!="HEAD" {code=405;}
    let headers="Content-Type: ${content_type}\r\nCache-Control: no-store\r\nX-Content-Type-Options: nosniff\r\n";
    return native::must::[rt::Object](env.create_web_resource_response(if method=="HEAD" {rt::Object::empty()} else {stream.clone()},code,if code==200 {"OK"} else if code==403 {"Forbidden"} else if code==405 {"Method Not Allowed"} else {"Not Found"},headers.view()));
}
