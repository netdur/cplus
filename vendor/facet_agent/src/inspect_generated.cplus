#[test]
fn every_label_property_reads_and_writes_back() {
    var n: core::Node = m_label::label("");
    let p: *core::Node = #addr_of(n);
    match get(p, "character_spacing") {
        option::Option[insp::Value]::Some(v) => { assert set(p, "character_spacing", v) == insp::Outcome::Ok; }
        option::Option[insp::Value]::None => { assert false; }
    }
    match get(p, "font_weight") {
        option::Option[insp::Value]::Some(v) => { assert set(p, "font_weight", v) == insp::Outcome::Ok; }
        option::Option[insp::Value]::None => { assert false; }
    }
    match get(p, "is_italic") {
        option::Option[insp::Value]::Some(v) => { assert set(p, "is_italic", v) == insp::Outcome::Ok; }
        option::Option[insp::Value]::None => { assert false; }
    }
    match get(p, "font_scales") {
        option::Option[insp::Value]::Some(v) => { assert set(p, "font_scales", v) == insp::Outcome::Ok; }
        option::Option[insp::Value]::None => { assert false; }
    }
    match get(p, "font_family") {
        option::Option[insp::Value]::Some(v) => { assert set(p, "font_family", v) == insp::Outcome::Ok; }
        option::Option[insp::Value]::None => { assert false; }
    }
    match get(p, "font_size") {
        option::Option[insp::Value]::Some(v) => { assert set(p, "font_size", v) == insp::Outcome::Ok; }
        option::Option[insp::Value]::None => { assert false; }
    }
    match get(p, "named_size") {
        option::Option[insp::Value]::Some(v) => { assert set(p, "named_size", v) == insp::Outcome::Ok; }
        option::Option[insp::Value]::None => { assert false; }
    }
    match get(p, "text_align") {
        option::Option[insp::Value]::Some(v) => { assert set(p, "text_align", v) == insp::Outcome::Ok; }
        option::Option[insp::Value]::None => { assert false; }
    }
    match get(p, "line_break") {
        option::Option[insp::Value]::Some(v) => { assert set(p, "line_break", v) == insp::Outcome::Ok; }
        option::Option[insp::Value]::None => { assert false; }
    }
    match get(p, "line_height") {
        option::Option[insp::Value]::Some(v) => { assert set(p, "line_height", v) == insp::Outcome::Ok; }
        option::Option[insp::Value]::None => { assert false; }
    }
    match get(p, "max_lines") {
        option::Option[insp::Value]::Some(v) => { assert set(p, "max_lines", v) == insp::Outcome::Ok; }
        option::Option[insp::Value]::None => { assert false; }
    }
    match get(p, "text") {
        option::Option[insp::Value]::Some(v) => { assert set(p, "text", v) == insp::Outcome::Ok; }
        option::Option[insp::Value]::None => { assert false; }
    }
    match get(p, "text_color") {
        option::Option[insp::Value]::Some(v) => { assert set(p, "text_color", v) == insp::Outcome::Ok; }
        option::Option[insp::Value]::None => { assert false; }
    }
    match get(p, "text_decoration") {
        option::Option[insp::Value]::Some(v) => { assert set(p, "text_decoration", v) == insp::Outcome::Ok; }
        option::Option[insp::Value]::None => { assert false; }
    }
    match get(p, "text_transform") {
        option::Option[insp::Value]::Some(v) => { assert set(p, "text_transform", v) == insp::Outcome::Ok; }
        option::Option[insp::Value]::None => { assert false; }
    }
    match get(p, "text_format") {
        option::Option[insp::Value]::Some(v) => { assert set(p, "text_format", v) == insp::Outcome::Ok; }
        option::Option[insp::Value]::None => { assert false; }
    }
    match get(p, "vertical_align") {
        option::Option[insp::Value]::Some(v) => { assert set(p, "vertical_align", v) == insp::Outcome::Ok; }
        option::Option[insp::Value]::None => { assert false; }
    }
    match get(p, "is_italic") {
        option::Option[insp::Value]::Some(insp::Value::Bool(b)) => {
            assert set(p, "is_italic", insp::Value::Bool(!b)) == insp::Outcome::Ok;
            match get(p, "is_italic") {
                option::Option[insp::Value]::Some(insp::Value::Bool(c)) => { assert c == !b; }
                _ => { assert false; }
            }
        }
        _ => { assert false; }
    }
    match get(p, "font_scales") {
        option::Option[insp::Value]::Some(insp::Value::Bool(b)) => {
            assert set(p, "font_scales", insp::Value::Bool(!b)) == insp::Outcome::Ok;
            match get(p, "font_scales") {
                option::Option[insp::Value]::Some(insp::Value::Bool(c)) => { assert c == !b; }
                _ => { assert false; }
            }
        }
        _ => { assert false; }
    }
    assert set(p, "no_such_property", insp::Value::Num(1.0f64)) == insp::Outcome::UnknownProperty;
    assert set(p, "is_italic", insp::Value::Str(text::from_str("x"))) == insp::Outcome::TypeMismatch;
}

