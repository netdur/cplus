    var n: core::Node = m_swipeable::swipeable();
    let p: *core::Node = #addr_of(n);
    match get(p, "reveal_threshold") {
        option::Option[insp::Value]::Some(v) => { assert set(p, "reveal_threshold", v) == insp::Outcome::Ok; }
        option::Option[insp::Value]::None => { assert false; }
    }
    assert set(p, "no_such_property", insp::Value::Num(1.0f64)) == insp::Outcome::UnknownProperty;
}

#[test]
fn every_swipe_item_property_reads_and_writes_back() {
    var n: core::Node = m_swipe_item::swipe_item();
    let p: *core::Node = #addr_of(n);
    match get(p, "icon") {
        option::Option[insp::Value]::Some(v) => { assert set(p, "icon", v) == insp::Outcome::Ok; }
        option::Option[insp::Value]::None => { assert false; }
    }
    match get(p, "is_destructive") {
        option::Option[insp::Value]::Some(v) => { assert set(p, "is_destructive", v) == insp::Outcome::Ok; }
        option::Option[insp::Value]::None => { assert false; }
    }
    match get(p, "text") {
        option::Option[insp::Value]::Some(v) => { assert set(p, "text", v) == insp::Outcome::Ok; }
        option::Option[insp::Value]::None => { assert false; }
    }
    match get(p, "is_destructive") {
        option::Option[insp::Value]::Some(insp::Value::Bool(b)) => {
            assert set(p, "is_destructive", insp::Value::Bool(!b)) == insp::Outcome::Ok;
            match get(p, "is_destructive") {
                option::Option[insp::Value]::Some(insp::Value::Bool(c)) => { assert c == !b; }
                _ => { assert false; }
            }
        }
        _ => { assert false; }
    }
    assert set(p, "no_such_property", insp::Value::Num(1.0f64)) == insp::Outcome::UnknownProperty;
    assert set(p, "is_destructive", insp::Value::Str(text::from_str("x"))) == insp::Outcome::TypeMismatch;
}

#[test]
fn every_carousel_property_reads_and_writes_back() {
