        match m_carousel::from(n) {
            option::Option[m_carousel::Carousel]::Some(c) => {
                if prop == "bounces" { return option::Option[insp::Value]::Some(insp::Value::Bool(c.bounces())); }
                if prop == "animates_scroll" { return option::Option[insp::Value]::Some(insp::Value::Bool(c.animates_scroll())); }
                if prop == "is_scrolling" { return option::Option[insp::Value]::Some(insp::Value::Bool(c.is_scrolling())); }
                if prop == "is_swipeable" { return option::Option[insp::Value]::Some(insp::Value::Bool(c.is_swipeable())); }
                if prop == "wraps" { return option::Option[insp::Value]::Some(insp::Value::Bool(c.wraps())); }
                if prop == "position" { return option::Option[insp::Value]::Some(insp::Value::Int(c.position())); }
                if prop == "horizontal_scroll_bars" { return option::Option[insp::Value]::Some(insp::Value::Enum(text::from_str(en_ScrollBars(c.horizontal_scroll_bars())))); }
                if prop == "scroll_anchor" { return option::Option[insp::Value]::Some(insp::Value::Enum(text::from_str(en_ScrollAnchor(c.scroll_anchor())))); }
                if prop == "remaining_threshold" { return option::Option[insp::Value]::Some(insp::Value::Int(c.remaining_threshold())); }
                if prop == "vertical_scroll_bars" { return option::Option[insp::Value]::Some(insp::Value::Enum(text::from_str(en_ScrollBars(c.vertical_scroll_bars())))); }
                if prop == "item_sizing" { return option::Option[insp::Value]::Some(insp::Value::Enum(text::from_str(en_ItemSizing(c.item_sizing())))); }
                if prop == "columns" { return option::Option[insp::Value]::Some(insp::Value::Int((c.columns()) as i64)); }
            }
            option::Option[m_carousel::Carousel]::None => { }
        }
        return option::Option[insp::Value]::None;
    }
    if kind == props::K_PAGE_DOTS {
        match m_page_dots::from(n) {
            option::Option[m_page_dots::PageDots]::Some(c) => {
                if prop == "count" { return option::Option[insp::Value]::Some(insp::Value::Int(c.count())); }
                if prop == "hides_single" { return option::Option[insp::Value]::Some(insp::Value::Bool(c.hides_single())); }
                if prop == "dot_color" { return option::Option[insp::Value]::Some(insp::Value::Color(to_color(c.dot_color()))); }
                if prop == "dot_size" { return option::Option[insp::Value]::Some(insp::Value::Num(c.dot_size())); }
                if prop == "dot_shape" { return option::Option[insp::Value]::Some(insp::Value::Enum(text::from_str(en_DotShape(c.dot_shape())))); }
                if prop == "max_dots" { return option::Option[insp::Value]::Some(insp::Value::Int(c.max_dots())); }
                if prop == "position" { return option::Option[insp::Value]::Some(insp::Value::Int(c.position())); }
                if prop == "selected_dot_color" { return option::Option[insp::Value]::Some(insp::Value::Color(to_color(c.selected_dot_color()))); }
            }
            option::Option[m_page_dots::PageDots]::None => { }
        }
        return option::Option[insp::Value]::None;
    }
    if kind == props::K_SPAN {
        match m_span::from(n) {
            option::Option[m_span::Span]::Some(c) => {
                if prop == "character_spacing" { return option::Option[insp::Value]::Some(insp::Value::Num(c.character_spacing())); }
                if prop == "font_weight" { return option::Option[insp::Value]::Some(insp::Value::Enum(text::from_str(en_FontWeight(c.font_weight())))); }
                if prop == "is_italic" { return option::Option[insp::Value]::Some(insp::Value::Bool(c.is_italic())); }
                if prop == "font_scales" { return option::Option[insp::Value]::Some(insp::Value::Bool(c.font_scales())); }
                if prop == "font_family" { return option::Option[insp::Value]::Some(insp::Value::Str(text::from_str(c.font_family()))); }
                if prop == "font_size" { return option::Option[insp::Value]::Some(insp::Value::Num(c.font_size())); }
                if prop == "named_size" { return option::Option[insp::Value]::Some(insp::Value::Enum(text::from_str(en_NamedSize(c.named_size())))); }
                if prop == "line_height" { return option::Option[insp::Value]::Some(insp::Value::Num(c.line_height())); }
                if prop == "text" { return option::Option[insp::Value]::Some(insp::Value::Str(text::from_str(c.text()))); }
                if prop == "text_color" { return option::Option[insp::Value]::Some(insp::Value::Color(to_color(c.text_color()))); }
                if prop == "text_decoration" { return option::Option[insp::Value]::Some(insp::Value::Enum(text::from_str(en_TextDecoration(c.text_decoration())))); }
                if prop == "text_transform" { return option::Option[insp::Value]::Some(insp::Value::Enum(text::from_str(en_TextTransform(c.text_transform())))); }
            }
            option::Option[m_span::Span]::None => { }
        }
        return option::Option[insp::Value]::None;
    }
    if kind == props::K_MENU_ITEM {
        match m_menu_item::from(n) {
            option::Option[m_menu_item::MenuItem]::Some(c) => {
                if prop == "icon" { return option::Option[insp::Value]::Some(insp::Value::Str(text::from_str(c.icon()))); }
                if prop == "is_destructive" { return option::Option[insp::Value]::Some(insp::Value::Bool(c.is_destructive())); }
                if prop == "text" { return option::Option[insp::Value]::Some(insp::Value::Str(text::from_str(c.text()))); }
            }
            option::Option[m_menu_item::MenuItem]::None => { }
        }
        return option::Option[insp::Value]::None;
    }
    if kind == props::K_MENU {
        match m_menu::from(n) {
            option::Option[m_menu::Menu]::Some(c) => {
                if prop == "priority" { return option::Option[insp::Value]::Some(insp::Value::Int(c.priority())); }
                if prop == "text" { return option::Option[insp::Value]::Some(insp::Value::Str(text::from_str(c.text()))); }
            }
            option::Option[m_menu::Menu]::None => { }
        }
        return option::Option[insp::Value]::None;
    }
    if kind == props::K_CONTEXT_MENU_ITEM {
        match m_context_menu_item::from(n) {
            option::Option[m_context_menu_item::ContextMenuItem]::Some(c) => {
                if prop == "icon" { return option::Option[insp::Value]::Some(insp::Value::Str(text::from_str(c.icon()))); }
                if prop == "is_destructive" { return option::Option[insp::Value]::Some(insp::Value::Bool(c.is_destructive())); }
                if prop == "text" { return option::Option[insp::Value]::Some(insp::Value::Str(text::from_str(c.text()))); }
            }
            option::Option[m_context_menu_item::ContextMenuItem]::None => { }
        }
        return option::Option[insp::Value]::None;
    }
    if kind == props::K_TOOLBAR_ITEM {
        match m_toolbar_item::from(n) {
            option::Option[m_toolbar_item::ToolbarItem]::Some(c) => {
                if prop == "placement" { return option::Option[insp::Value]::Some(insp::Value::Enum(text::from_str(en_ToolbarPlacement(c.placement())))); }
                if prop == "priority" { return option::Option[insp::Value]::Some(insp::Value::Int(c.priority())); }
                if prop == "icon" { return option::Option[insp::Value]::Some(insp::Value::Str(text::from_str(c.icon()))); }
                if prop == "is_destructive" { return option::Option[insp::Value]::Some(insp::Value::Bool(c.is_destructive())); }
                if prop == "text" { return option::Option[insp::Value]::Some(insp::Value::Str(text::from_str(c.text()))); }
            }
            option::Option[m_toolbar_item::ToolbarItem]::None => { }
        }
        return option::Option[insp::Value]::None;
    }
    return option::Option[insp::Value]::None;
}

// Write `prop` on `n` through its kind's cursor — the setter an application
// calls, so the same dirty bit and the same backend apply. UnknownProperty
// when the kind has no such property; TypeMismatch when `v` is the wrong kind
// of Value; a misspelled enum member is a TypeMismatch, not a silent default.
fn set(n: *core::Node, prop: str, v: insp::Value) -> insp::Outcome {
    let kind: u32 = core::kind_of(n);
    if kind == props::K_LABEL {
        match m_label::from(n) {
            option::Option[m_label::Label]::Some(c) => {
                if prop == "character_spacing" {
                    let x: option::Option[f64] = match v {
                        insp::Value::Num(x) => option::Option[f64]::Some(x),
                        insp::Value::Int(i) => option::Option[f64]::Some(i as f64),
                        _ => option::Option[f64]::None,
                    };
                    return match x {
                        option::Option[f64]::Some(a) => { let _c: m_label::Label = c.set_character_spacing(a); insp::Outcome::Ok },
                        option::Option[f64]::None => insp::Outcome::TypeMismatch,
                    };
                }
                if prop == "font_weight" {
                    return match spelling_of(v) {
                        option::Option[text::Text]::Some(t) => match ev_FontWeight(t.view()) {
                            option::Option[vocab::FontWeight]::Some(e) => { let _c: m_label::Label = c.set_font_weight(e); insp::Outcome::Ok },
                            option::Option[vocab::FontWeight]::None => insp::Outcome::TypeMismatch,
                        },
                        option::Option[text::Text]::None => insp::Outcome::TypeMismatch,
                    };
                }
                if prop == "is_italic" {
                    let x: option::Option[bool] = match v {
                        insp::Value::Bool(b) => option::Option[bool]::Some(b),
                        _ => option::Option[bool]::None,
                    };
                    return match x {
                        option::Option[bool]::Some(a) => { let _c: m_label::Label = c.set_italic(a); insp::Outcome::Ok },
                        option::Option[bool]::None => insp::Outcome::TypeMismatch,
                    };
                }
                if prop == "font_scales" {
                    let x: option::Option[bool] = match v {
                        insp::Value::Bool(b) => option::Option[bool]::Some(b),
                        _ => option::Option[bool]::None,
                    };
                    return match x {
                        option::Option[bool]::Some(a) => { let _c: m_label::Label = c.set_font_scales(a); insp::Outcome::Ok },
                        option::Option[bool]::None => insp::Outcome::TypeMismatch,
                    };
                }
                if prop == "font_family" {
                    return match v {
                        insp::Value::Str(t) => { let _c: m_label::Label = c.set_font_family(t.view()); insp::Outcome::Ok },
                        _ => insp::Outcome::TypeMismatch,
                    };
                }
                if prop == "font_size" {
                    let x: option::Option[f64] = match v {
                        insp::Value::Num(x) => option::Option[f64]::Some(x),
                        insp::Value::Int(i) => option::Option[f64]::Some(i as f64),
                        _ => option::Option[f64]::None,
                    };
                    return match x {
                        option::Option[f64]::Some(a) => { let _c: m_label::Label = c.set_font_size(a); insp::Outcome::Ok },
                        option::Option[f64]::None => insp::Outcome::TypeMismatch,
                    };
                }
                if prop == "named_size" {
                    return match spelling_of(v) {
                        option::Option[text::Text]::Some(t) => match ev_NamedSize(t.view()) {
                            option::Option[vocab::NamedSize]::Some(e) => { let _c: m_label::Label = c.set_named_size(e); insp::Outcome::Ok },
                            option::Option[vocab::NamedSize]::None => insp::Outcome::TypeMismatch,
                        },
                        option::Option[text::Text]::None => insp::Outcome::TypeMismatch,
                    };
                }
                if prop == "text_align" {
                    return match spelling_of(v) {
                        option::Option[text::Text]::Some(t) => match ev_TextAlign(t.view()) {
                            option::Option[vocab::TextAlign]::Some(e) => { let _c: m_label::Label = c.set_text_align(e); insp::Outcome::Ok },
                            option::Option[vocab::TextAlign]::None => insp::Outcome::TypeMismatch,
                        },
                        option::Option[text::Text]::None => insp::Outcome::TypeMismatch,
                    };
                }
                if prop == "line_break" {
                    return match spelling_of(v) {
                        option::Option[text::Text]::Some(t) => match ev_LineBreak(t.view()) {
                            option::Option[vocab::LineBreak]::Some(e) => { let _c: m_label::Label = c.set_line_break(e); insp::Outcome::Ok },
                            option::Option[vocab::LineBreak]::None => insp::Outcome::TypeMismatch,
                        },
                        option::Option[text::Text]::None => insp::Outcome::TypeMismatch,
                    };
                }
                if prop == "line_height" {
                    let x: option::Option[f64] = match v {
                        insp::Value::Num(x) => option::Option[f64]::Some(x),
                        insp::Value::Int(i) => option::Option[f64]::Some(i as f64),
                        _ => option::Option[f64]::None,
                    };
                    return match x {
                        option::Option[f64]::Some(a) => { let _c: m_label::Label = c.set_line_height(a); insp::Outcome::Ok },
                        option::Option[f64]::None => insp::Outcome::TypeMismatch,
                    };
                }
                if prop == "max_lines" {
                    let x: option::Option[i64] = match v {
                        insp::Value::Int(i) => option::Option[i64]::Some(i),
                        insp::Value::Num(x) => option::Option[i64]::Some(x as i64),
                        _ => option::Option[i64]::None,
                    };
                    return match x {
                        option::Option[i64]::Some(a) => { let _c: m_label::Label = c.set_max_lines(a); insp::Outcome::Ok },
                        option::Option[i64]::None => insp::Outcome::TypeMismatch,
                    };
                }
                if prop == "text" {
                    return match v {
                        insp::Value::Str(t) => { let _c: m_label::Label = c.set_text(t.view()); insp::Outcome::Ok },
                        _ => insp::Outcome::TypeMismatch,
                    };
                }
                if prop == "text_color" {
                    let x: option::Option[vocab::Color] = match v {
                        insp::Value::Color(c) => option::Option[vocab::Color]::Some(from_color(c)),
                        _ => option::Option[vocab::Color]::None,
                    };
                    return match x {
                        option::Option[vocab::Color]::Some(a) => { let _c: m_label::Label = c.set_text_color(a); insp::Outcome::Ok },
                        option::Option[vocab::Color]::None => insp::Outcome::TypeMismatch,
                    };
                }
                if prop == "text_decoration" {
                    return match spelling_of(v) {
                        option::Option[text::Text]::Some(t) => match ev_TextDecoration(t.view()) {
                            option::Option[vocab::TextDecoration]::Some(e) => { let _c: m_label::Label = c.set_text_decoration(e); insp::Outcome::Ok },
                            option::Option[vocab::TextDecoration]::None => insp::Outcome::TypeMismatch,
                        },
                        option::Option[text::Text]::None => insp::Outcome::TypeMismatch,
                    };
                }
                if prop == "text_transform" {
                    return match spelling_of(v) {
                        option::Option[text::Text]::Some(t) => match ev_TextTransform(t.view()) {
                            option::Option[vocab::TextTransform]::Some(e) => { let _c: m_label::Label = c.set_text_transform(e); insp::Outcome::Ok },
                            option::Option[vocab::TextTransform]::None => insp::Outcome::TypeMismatch,
                        },
                        option::Option[text::Text]::None => insp::Outcome::TypeMismatch,
                    };
                }
                if prop == "text_format" {
                    return match spelling_of(v) {
                        option::Option[text::Text]::Some(t) => match ev_TextFormat(t.view()) {
                            option::Option[vocab::TextFormat]::Some(e) => { let _c: m_label::Label = c.set_text_format(e); insp::Outcome::Ok },
                            option::Option[vocab::TextFormat]::None => insp::Outcome::TypeMismatch,
                        },
                        option::Option[text::Text]::None => insp::Outcome::TypeMismatch,
                    };
                }
                if prop == "vertical_align" {
                    return match spelling_of(v) {
                        option::Option[text::Text]::Some(t) => match ev_TextAlign(t.view()) {
                            option::Option[vocab::TextAlign]::Some(e) => { let _c: m_label::Label = c.set_vertical_align(e); insp::Outcome::Ok },
                            option::Option[vocab::TextAlign]::None => insp::Outcome::TypeMismatch,
                        },
                        option::Option[text::Text]::None => insp::Outcome::TypeMismatch,
                    };
                }
            }
            option::Option[m_label::Label]::None => { return insp::Outcome::Stale; }
        }
        return insp::Outcome::UnknownProperty;
    }
    if kind == props::K_BUTTON {
        match m_button::from(n) {
            option::Option[m_button::Button]::Some(c) => {
                if prop == "border_color" {
                    let x: option::Option[vocab::Color] = match v {
                        insp::Value::Color(c) => option::Option[vocab::Color]::Some(from_color(c)),
                        _ => option::Option[vocab::Color]::None,
                    };
                    return match x {
                        option::Option[vocab::Color]::Some(a) => { let _c: m_button::Button = c.set_border_color(a); insp::Outcome::Ok },
                        option::Option[vocab::Color]::None => insp::Outcome::TypeMismatch,
                    };
                }
                if prop == "border_width" {
                    let x: option::Option[f64] = match v {
                        insp::Value::Num(x) => option::Option[f64]::Some(x),
                        insp::Value::Int(i) => option::Option[f64]::Some(i as f64),
                        _ => option::Option[f64]::None,
                    };
                    return match x {
                        option::Option[f64]::Some(a) => { let _c: m_button::Button = c.set_border_width(a); insp::Outcome::Ok },
                        option::Option[f64]::None => insp::Outcome::TypeMismatch,
                    };
                }
                if prop == "character_spacing" {
                    let x: option::Option[f64] = match v {
                        insp::Value::Num(x) => option::Option[f64]::Some(x),
                        insp::Value::Int(i) => option::Option[f64]::Some(i as f64),
                        _ => option::Option[f64]::None,
                    };
                    return match x {
                        option::Option[f64]::Some(a) => { let _c: m_button::Button = c.set_character_spacing(a); insp::Outcome::Ok },
                        option::Option[f64]::None => insp::Outcome::TypeMismatch,
                    };
                }
                if prop == "content_layout" {
                    return match spelling_of(v) {
                        option::Option[text::Text]::Some(t) => match ev_ContentLayout(t.view()) {
                            option::Option[vocab::ContentLayout]::Some(e) => { let _c: m_button::Button = c.set_content_layout(e); insp::Outcome::Ok },
                            option::Option[vocab::ContentLayout]::None => insp::Outcome::TypeMismatch,
                        },
                        option::Option[text::Text]::None => insp::Outcome::TypeMismatch,
                    };
                }
                if prop == "font_weight" {
                    return match spelling_of(v) {
                        option::Option[text::Text]::Some(t) => match ev_FontWeight(t.view()) {
                            option::Option[vocab::FontWeight]::Some(e) => { let _c: m_button::Button = c.set_font_weight(e); insp::Outcome::Ok },
                            option::Option[vocab::FontWeight]::None => insp::Outcome::TypeMismatch,
                        },
                        option::Option[text::Text]::None => insp::Outcome::TypeMismatch,
                    };
                }
                if prop == "is_italic" {
                    let x: option::Option[bool] = match v {
                        insp::Value::Bool(b) => option::Option[bool]::Some(b),
                        _ => option::Option[bool]::None,
                    };
                    return match x {
                        option::Option[bool]::Some(a) => { let _c: m_button::Button = c.set_italic(a); insp::Outcome::Ok },
                        option::Option[bool]::None => insp::Outcome::TypeMismatch,
                    };
                }
                if prop == "font_scales" {
                    let x: option::Option[bool] = match v {
                        insp::Value::Bool(b) => option::Option[bool]::Some(b),
                        _ => option::Option[bool]::None,
                    };
                    return match x {
                        option::Option[bool]::Some(a) => { let _c: m_button::Button = c.set_font_scales(a); insp::Outcome::Ok },
                        option::Option[bool]::None => insp::Outcome::TypeMismatch,
                    };
                }
                if prop == "font_family" {
                    return match v {
                        insp::Value::Str(t) => { let _c: m_button::Button = c.set_font_family(t.view()); insp::Outcome::Ok },
                        _ => insp::Outcome::TypeMismatch,
                    };
                }
                if prop == "font_size" {
                    let x: option::Option[f64] = match v {
                        insp::Value::Num(x) => option::Option[f64]::Some(x),
                        insp::Value::Int(i) => option::Option[f64]::Some(i as f64),
                        _ => option::Option[f64]::None,
                    };
                    return match x {
                        option::Option[f64]::Some(a) => { let _c: m_button::Button = c.set_font_size(a); insp::Outcome::Ok },
                        option::Option[f64]::None => insp::Outcome::TypeMismatch,
                    };
                }
                if prop == "named_size" {
                    return match spelling_of(v) {
                        option::Option[text::Text]::Some(t) => match ev_NamedSize(t.view()) {
                            option::Option[vocab::NamedSize]::Some(e) => { let _c: m_button::Button = c.set_named_size(e); insp::Outcome::Ok },
                            option::Option[vocab::NamedSize]::None => insp::Outcome::TypeMismatch,
                        },
                        option::Option[text::Text]::None => insp::Outcome::TypeMismatch,
                    };
                }
                if prop == "image" {
                    return match v {
                        insp::Value::Str(t) => { let _c: m_button::Button = c.set_image(t.view()); insp::Outcome::Ok },
                        _ => insp::Outcome::TypeMismatch,
                    };
                }
                if prop == "line_break" {
                    return match spelling_of(v) {
                        option::Option[text::Text]::Some(t) => match ev_LineBreak(t.view()) {
                            option::Option[vocab::LineBreak]::Some(e) => { let _c: m_button::Button = c.set_line_break(e); insp::Outcome::Ok },
                            option::Option[vocab::LineBreak]::None => insp::Outcome::TypeMismatch,
                        },
                        option::Option[text::Text]::None => insp::Outcome::TypeMismatch,
                    };
                }
                if prop == "title" {
                    return match v {
                        insp::Value::Str(t) => { let _c: m_button::Button = c.set_title(t.view()); insp::Outcome::Ok },
                        _ => insp::Outcome::TypeMismatch,
                    };
                }
                if prop == "text_color" {
                    let x: option::Option[vocab::Color] = match v {
                        insp::Value::Color(c) => option::Option[vocab::Color]::Some(from_color(c)),
                        _ => option::Option[vocab::Color]::None,
                    };
                    return match x {
                        option::Option[vocab::Color]::Some(a) => { let _c: m_button::Button = c.set_text_color(a); insp::Outcome::Ok },
                        option::Option[vocab::Color]::None => insp::Outcome::TypeMismatch,
                    };
                }
                if prop == "text_transform" {
                    return match spelling_of(v) {
                        option::Option[text::Text]::Some(t) => match ev_TextTransform(t.view()) {
                            option::Option[vocab::TextTransform]::Some(e) => { let _c: m_button::Button = c.set_text_transform(e); insp::Outcome::Ok },
                            option::Option[vocab::TextTransform]::None => insp::Outcome::TypeMismatch,
                        },
                        option::Option[text::Text]::None => insp::Outcome::TypeMismatch,
                    };
                }
                if prop == "toggles" {
                    let x: option::Option[bool] = match v {
                        insp::Value::Bool(b) => option::Option[bool]::Some(b),
                        _ => option::Option[bool]::None,
                    };
                    return match x {
                        option::Option[bool]::Some(a) => { let _c: m_button::Button = c.set_toggles(a); insp::Outcome::Ok },
                        option::Option[bool]::None => insp::Outcome::TypeMismatch,
                    };
                }
                if prop == "on" {
                    let x: option::Option[bool] = match v {
                        insp::Value::Bool(b) => option::Option[bool]::Some(b),
                        _ => option::Option[bool]::None,
                    };
                    return match x {
