            assert set(p, "bounces", insp::Value::Bool(!b)) == insp::Outcome::Ok;
            match get(p, "bounces") {
                option::Option[insp::Value]::Some(insp::Value::Bool(c)) => { assert c == !b; }
                _ => { assert false; }
            }
        }
        _ => { assert false; }
    }
    match get(p, "animates_scroll") {
        option::Option[insp::Value]::Some(insp::Value::Bool(b)) => {
            assert set(p, "animates_scroll", insp::Value::Bool(!b)) == insp::Outcome::Ok;
            match get(p, "animates_scroll") {
