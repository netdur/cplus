#[test]
fn every_toggle_property_reads_and_writes_back() {
    var n: core::Node = m_toggle::toggle(false);
    let p: *core::Node = #addr_of(n);
    match get(p, "on") {
        option::Option[insp::Value]::Some(v) => { assert set(p, "on", v) == insp::Outcome::Ok; }
        option::Option[insp::Value]::None => { assert false; }
    }
    match get(p, "off_color") {
        option::Option[insp::Value]::Some(v) => { assert set(p, "off_color", v) == insp::Outcome::Ok; }
        option::Option[insp::Value]::None => { assert false; }
    }
    match get(p, "on_color") {
        option::Option[insp::Value]::Some(v) => { assert set(p, "on_color", v) == insp::Outcome::Ok; }
        option::Option[insp::Value]::None => { assert false; }
    }
    match get(p, "thumb_color") {
        option::Option[insp::Value]::Some(v) => { assert set(p, "thumb_color", v) == insp::Outcome::Ok; }
        option::Option[insp::Value]::None => { assert false; }
    }
    match get(p, "on") {
        option::Option[insp::Value]::Some(insp::Value::Bool(b)) => {
            assert set(p, "on", insp::Value::Bool(!b)) == insp::Outcome::Ok;
            match get(p, "on") {
                option::Option[insp::Value]::Some(insp::Value::Bool(c)) => { assert c == !b; }
                _ => { assert false; }
            }
        }
        _ => { assert false; }
    }
    assert set(p, "no_such_property", insp::Value::Num(1.0f64)) == insp::Outcome::UnknownProperty;
    assert set(p, "on", insp::Value::Str(text::from_str("x"))) == insp::Outcome::TypeMismatch;
}

