                    return match spelling_of(v) {
                        option::Option[text::Text]::Some(t) => match ev_TextTransform(t.view()) {
                            option::Option[vocab::TextTransform]::Some(e) => { let _c: m_span::Span = c.set_text_transform(e); insp::Outcome::Ok },
                            option::Option[vocab::TextTransform]::None => insp::Outcome::TypeMismatch,
                        },
                        option::Option[text::Text]::None => insp::Outcome::TypeMismatch,
                    };
                }
            }
            option::Option[m_span::Span]::None => { return insp::Outcome::Stale; }
        }
        return insp::Outcome::UnknownProperty;
    }
    if kind == props::K_MENU_ITEM {
        match m_menu_item::from(n) {
            option::Option[m_menu_item::MenuItem]::Some(c) => {
                if prop == "icon" {
                    return match v {
                        insp::Value::Str(t) => { let _c: m_menu_item::MenuItem = c.set_icon(t.view()); insp::Outcome::Ok },
                        _ => insp::Outcome::TypeMismatch,
                    };
                }
                if prop == "is_destructive" {
                    let x: option::Option[bool] = match v {
                        insp::Value::Bool(b) => option::Option[bool]::Some(b),
                        _ => option::Option[bool]::None,
                    };
                    return match x {
                        option::Option[bool]::Some(a) => { let _c: m_menu_item::MenuItem = c.set_destructive(a); insp::Outcome::Ok },
                        option::Option[bool]::None => insp::Outcome::TypeMismatch,
                    };
                }
                if prop == "text" {
                    return match v {
                        insp::Value::Str(t) => { let _c: m_menu_item::MenuItem = c.set_text(t.view()); insp::Outcome::Ok },
                        _ => insp::Outcome::TypeMismatch,
                    };
                }
            }
            option::Option[m_menu_item::MenuItem]::None => { return insp::Outcome::Stale; }
        }
        return insp::Outcome::UnknownProperty;
    }
    if kind == props::K_MENU {
        match m_menu::from(n) {
            option::Option[m_menu::Menu]::Some(c) => {
                if prop == "priority" {
                    let x: option::Option[i64] = match v {
                        insp::Value::Int(i) => option::Option[i64]::Some(i),
                        insp::Value::Num(x) => option::Option[i64]::Some(x as i64),
                        _ => option::Option[i64]::None,
                    };
                    return match x {
                        option::Option[i64]::Some(a) => { let _c: m_menu::Menu = c.set_priority(a); insp::Outcome::Ok },
                        option::Option[i64]::None => insp::Outcome::TypeMismatch,
                    };
                }
                if prop == "text" {
                    return match v {
                        insp::Value::Str(t) => { let _c: m_menu::Menu = c.set_text(t.view()); insp::Outcome::Ok },
                        _ => insp::Outcome::TypeMismatch,
                    };
                }
            }
            option::Option[m_menu::Menu]::None => { return insp::Outcome::Stale; }
        }
        return insp::Outcome::UnknownProperty;
    }
    if kind == props::K_CONTEXT_MENU_ITEM {
        match m_context_menu_item::from(n) {
            option::Option[m_context_menu_item::ContextMenuItem]::Some(c) => {
                if prop == "icon" {
                    return match v {
                        insp::Value::Str(t) => { let _c: m_context_menu_item::ContextMenuItem = c.set_icon(t.view()); insp::Outcome::Ok },
                        _ => insp::Outcome::TypeMismatch,
                    };
                }
                if prop == "is_destructive" {
                    let x: option::Option[bool] = match v {
                        insp::Value::Bool(b) => option::Option[bool]::Some(b),
                        _ => option::Option[bool]::None,
                    };
                    return match x {
                        option::Option[bool]::Some(a) => { let _c: m_context_menu_item::ContextMenuItem = c.set_destructive(a); insp::Outcome::Ok },
                        option::Option[bool]::None => insp::Outcome::TypeMismatch,
                    };
                }
                if prop == "text" {
                    return match v {
                        insp::Value::Str(t) => { let _c: m_context_menu_item::ContextMenuItem = c.set_text(t.view()); insp::Outcome::Ok },
                        _ => insp::Outcome::TypeMismatch,
                    };
                }
            }
            option::Option[m_context_menu_item::ContextMenuItem]::None => { return insp::Outcome::Stale; }
        }
        return insp::Outcome::UnknownProperty;
    }
    if kind == props::K_TOOLBAR_ITEM {
        match m_toolbar_item::from(n) {
            option::Option[m_toolbar_item::ToolbarItem]::Some(c) => {
                if prop == "placement" {
                    return match spelling_of(v) {
                        option::Option[text::Text]::Some(t) => match ev_ToolbarPlacement(t.view()) {
                            option::Option[vocab::ToolbarPlacement]::Some(e) => { let _c: m_toolbar_item::ToolbarItem = c.set_placement(e); insp::Outcome::Ok },
                            option::Option[vocab::ToolbarPlacement]::None => insp::Outcome::TypeMismatch,
                        },
                        option::Option[text::Text]::None => insp::Outcome::TypeMismatch,
                    };
                }
                if prop == "priority" {
                    let x: option::Option[i64] = match v {
                        insp::Value::Int(i) => option::Option[i64]::Some(i),
                        insp::Value::Num(x) => option::Option[i64]::Some(x as i64),
                        _ => option::Option[i64]::None,
                    };
                    return match x {
                        option::Option[i64]::Some(a) => { let _c: m_toolbar_item::ToolbarItem = c.set_priority(a); insp::Outcome::Ok },
                        option::Option[i64]::None => insp::Outcome::TypeMismatch,
                    };
                }
                if prop == "icon" {
                    return match v {
                        insp::Value::Str(t) => { let _c: m_toolbar_item::ToolbarItem = c.set_icon(t.view()); insp::Outcome::Ok },
                        _ => insp::Outcome::TypeMismatch,
                    };
                }
                if prop == "is_destructive" {
                    let x: option::Option[bool] = match v {
                        insp::Value::Bool(b) => option::Option[bool]::Some(b),
                        _ => option::Option[bool]::None,
                    };
                    return match x {
                        option::Option[bool]::Some(a) => { let _c: m_toolbar_item::ToolbarItem = c.set_destructive(a); insp::Outcome::Ok },
                        option::Option[bool]::None => insp::Outcome::TypeMismatch,
                    };
                }
                if prop == "text" {
                    return match v {
                        insp::Value::Str(t) => { let _c: m_toolbar_item::ToolbarItem = c.set_text(t.view()); insp::Outcome::Ok },
                        _ => insp::Outcome::TypeMismatch,
                    };
                }
            }
            option::Option[m_toolbar_item::ToolbarItem]::None => { return insp::Outcome::Stale; }
        }
        return insp::Outcome::UnknownProperty;
    }
    return insp::Outcome::UnknownProperty;
}

