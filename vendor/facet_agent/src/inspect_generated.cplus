// `prop` on `n`, read through its kind's cursor; None when the kind has no
// such property (or no Value carries its type).
fn get(n: *core::Node, prop: str) -> option::Option[insp::Value] {
    let kind: u32 = core::kind_of(n);
    if kind == props::K_LABEL {
        match m_label::from(n) {
            option::Option[m_label::Label]::Some(c) => {
                if prop == "character_spacing" { return option::Option[insp::Value]::Some(insp::Value::Num(c.character_spacing())); }
                if prop == "font_weight" { return option::Option[insp::Value]::Some(insp::Value::Enum(text::from_str(en_FontWeight(c.font_weight())))); }
                if prop == "is_italic" { return option::Option[insp::Value]::Some(insp::Value::Bool(c.is_italic())); }
                if prop == "font_scales" { return option::Option[insp::Value]::Some(insp::Value::Bool(c.font_scales())); }
                if prop == "font_family" { return option::Option[insp::Value]::Some(insp::Value::Str(text::from_str(c.font_family()))); }
                if prop == "font_size" { return option::Option[insp::Value]::Some(insp::Value::Num(c.font_size())); }
                if prop == "named_size" { return option::Option[insp::Value]::Some(insp::Value::Enum(text::from_str(en_NamedSize(c.named_size())))); }
                if prop == "text_align" { return option::Option[insp::Value]::Some(insp::Value::Enum(text::from_str(en_TextAlign(c.text_align())))); }
                if prop == "line_break" { return option::Option[insp::Value]::Some(insp::Value::Enum(text::from_str(en_LineBreak(c.line_break())))); }
                if prop == "line_height" { return option::Option[insp::Value]::Some(insp::Value::Num(c.line_height())); }
                if prop == "max_lines" { return option::Option[insp::Value]::Some(insp::Value::Int(c.max_lines())); }
                if prop == "text" { return option::Option[insp::Value]::Some(insp::Value::Str(text::from_str(c.text()))); }
                if prop == "text_color" { return option::Option[insp::Value]::Some(insp::Value::Color(to_color(c.text_color()))); }
                if prop == "text_decoration" { return option::Option[insp::Value]::Some(insp::Value::Enum(text::from_str(en_TextDecoration(c.text_decoration())))); }
                if prop == "text_transform" { return option::Option[insp::Value]::Some(insp::Value::Enum(text::from_str(en_TextTransform(c.text_transform())))); }
                if prop == "text_format" { return option::Option[insp::Value]::Some(insp::Value::Enum(text::from_str(en_TextFormat(c.text_format())))); }
                if prop == "vertical_align" { return option::Option[insp::Value]::Some(insp::Value::Enum(text::from_str(en_TextAlign(c.vertical_align())))); }
            }
            option::Option[m_label::Label]::None => { }
        }
        return option::Option[insp::Value]::None;
    }
    if kind == props::K_BUTTON {
        match m_button::from(n) {
            option::Option[m_button::Button]::Some(c) => {
                if prop == "border_color" { return option::Option[insp::Value]::Some(insp::Value::Color(to_color(c.border_color()))); }
                if prop == "border_width" { return option::Option[insp::Value]::Some(insp::Value::Num(c.border_width())); }
                if prop == "character_spacing" { return option::Option[insp::Value]::Some(insp::Value::Num(c.character_spacing())); }
                if prop == "content_layout" { return option::Option[insp::Value]::Some(insp::Value::Enum(text::from_str(en_ContentLayout(c.content_layout())))); }
                if prop == "font_weight" { return option::Option[insp::Value]::Some(insp::Value::Enum(text::from_str(en_FontWeight(c.font_weight())))); }
                if prop == "is_italic" { return option::Option[insp::Value]::Some(insp::Value::Bool(c.is_italic())); }
                if prop == "font_scales" { return option::Option[insp::Value]::Some(insp::Value::Bool(c.font_scales())); }
                if prop == "font_family" { return option::Option[insp::Value]::Some(insp::Value::Str(text::from_str(c.font_family()))); }
                if prop == "font_size" { return option::Option[insp::Value]::Some(insp::Value::Num(c.font_size())); }
                if prop == "named_size" { return option::Option[insp::Value]::Some(insp::Value::Enum(text::from_str(en_NamedSize(c.named_size())))); }
                if prop == "image" { return option::Option[insp::Value]::Some(insp::Value::Str(text::from_str(c.image()))); }
                if prop == "line_break" { return option::Option[insp::Value]::Some(insp::Value::Enum(text::from_str(en_LineBreak(c.line_break())))); }
                if prop == "title" { return option::Option[insp::Value]::Some(insp::Value::Str(text::from_str(c.title()))); }
                if prop == "text_color" { return option::Option[insp::Value]::Some(insp::Value::Color(to_color(c.text_color()))); }
                if prop == "text_transform" { return option::Option[insp::Value]::Some(insp::Value::Enum(text::from_str(en_TextTransform(c.text_transform())))); }
                if prop == "toggles" { return option::Option[insp::Value]::Some(insp::Value::Bool(c.toggles())); }
                if prop == "on" { return option::Option[insp::Value]::Some(insp::Value::Bool(c.is_on())); }
                if prop == "bordered" { return option::Option[insp::Value]::Some(insp::Value::Bool(c.is_bordered())); }
            }
            option::Option[m_button::Button]::None => { }
        }
        return option::Option[insp::Value]::None;
    }
    if kind == props::K_TEXT_FIELD {
        match m_text_field::from(n) {
            option::Option[m_text_field::TextField]::Some(c) => {
