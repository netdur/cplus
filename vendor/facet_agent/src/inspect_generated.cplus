        vocab::ToolbarPlacement::Default => "default",
        vocab::ToolbarPlacement::Primary => "primary",
        vocab::ToolbarPlacement::Secondary => "secondary",
        vocab::ToolbarPlacement::Sidebar => "sidebar",
    };
}

fn ev_ToolbarPlacement(s: str) -> option::Option[vocab::ToolbarPlacement] {
    if s == "default" { return option::Option[vocab::ToolbarPlacement]::Some(vocab::ToolbarPlacement::Default); }
    if s == "primary" { return option::Option[vocab::ToolbarPlacement]::Some(vocab::ToolbarPlacement::Primary); }
    if s == "secondary" { return option::Option[vocab::ToolbarPlacement]::Some(vocab::ToolbarPlacement::Secondary); }
    if s == "sidebar" { return option::Option[vocab::ToolbarPlacement]::Some(vocab::ToolbarPlacement::Sidebar); }
    return option::Option[vocab::ToolbarPlacement]::None;
}

// Every name below, once, in the order the controls declare them.
