                _ => { assert false; }
            }
        }
        _ => { assert false; }
    }
    match get(p, "is_scrolling") {
        option::Option[insp::Value]::Some(insp::Value::Bool(b)) => {
            assert set(p, "is_scrolling", insp::Value::Bool(!b)) == insp::Outcome::Ok;
            match get(p, "is_scrolling") {
                option::Option[insp::Value]::Some(insp::Value::Bool(c)) => { assert c == !b; }
                _ => { assert false; }
            }
        }
        _ => { assert false; }
    }
    match get(p, "is_swipeable") {
        option::Option[insp::Value]::Some(insp::Value::Bool(b)) => {
            assert set(p, "is_swipeable", insp::Value::Bool(!b)) == insp::Outcome::Ok;
            match get(p, "is_swipeable") {
                option::Option[insp::Value]::Some(insp::Value::Bool(c)) => { assert c == !b; }
                _ => { assert false; }
            }
        }
        _ => { assert false; }
    }
    match get(p, "wraps") {
        option::Option[insp::Value]::Some(insp::Value::Bool(b)) => {
            assert set(p, "wraps", insp::Value::Bool(!b)) == insp::Outcome::Ok;
            match get(p, "wraps") {
                option::Option[insp::Value]::Some(insp::Value::Bool(c)) => { assert c == !b; }
                _ => { assert false; }
            }
        }
        _ => { assert false; }
    }
    assert set(p, "no_such_property", insp::Value::Num(1.0f64)) == insp::Outcome::UnknownProperty;
    assert set(p, "bounces", insp::Value::Str(text::from_str("x"))) == insp::Outcome::TypeMismatch;
