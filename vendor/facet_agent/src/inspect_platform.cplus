// appkit — the one thing facet's own tree cannot answer.
//
// Everything else in this package is portable: the walker reads facet's
// mounted tree, and the setters go through facet's own verbs. What needs the
// platform is drawing a rectangle over a window without becoming part of the
// UI, plus reading back what the platform owns for the native panel.
//
// That asymmetry is the payoff for walking facet rather than NSView. The agent
// surface needed a whole backend per platform because it walks the native
// hierarchy; the inspector needs one walker plus this file.
//
// ---- the overlay is a layer, not a view --------------------------------------
//
// A highlight must not participate in layout, must not intercept a hit test,
// and must not appear in the tree it is drawn over. A CALayer satisfies all
// three by construction: layers are not views, they do not lay out, they are
// not hit-tested, and nothing that walks `subviews` or facet's tree will ever
// see one. A transparent overlay VIEW would have had to be excluded from three
// different walks and would still have been in the responder chain.
//
// It is attached to the window's CONTENT view rather than to the node's own
// view, so the inspected view is never modified — not its layer-backing, not
// its sublayers, not its rendering path. The rect is converted into the
// content view's space instead.

import "stdlib/vec" as vec;
import "stdlib/text" as text;
import "stdlib/io" as io;
import "stdlib/option" as option;
import "stdlib/status" as status;
import "flex_layout/flex_layout" as flex;
import "objc/runtime" as rt;
import "objc/bridge" as bridge;
import "appkit/appkit" as ak;
import "quartzcore/quartzcore" as qc;
import "stdlib/env" as env;
import "facet/facet" as core;
import "facet/application" as app;
import "facet/mount" as mount;
import "facet/services" as services;
import "facet/application" as runtime;
import "agent_core/inspect" as insp;
import "./inspect_tree" as tree;
import "agent_mcp/inspect" as mcp;

// ---- the hop to the UI thread --------------------------------------------------
//
// The second thing facet's tree cannot answer for itself, and it only comes up
// off-process: `mount::install` records the thread it ran on and `core::touch`
// asserts on it, so a write arriving from the socket server's thread ABORTS —
// deliberately, because a worker writing the tree is a data race that otherwise
// surfaces as a distant, unattributable crash.
//
// `dispatch_sync_f` is the right shape and libdispatch's plain-C one: a function
// pointer and a context, run on the main queue, RETURNING when the work is done.
// The synchronous half is not a detail — an RPC has to have the answer before it
// can write the response, and `facet_appkit`'s `run_on_main` is deliberately
// async for a different job.
//
// Already on the main thread, it calls straight through. `dispatch_sync` onto
// the main queue FROM the main queue deadlocks, and an in-process caller — a
// panel, a test — is exactly that case.
extern fn dlsym(handle: *u8, symbol: *u8) -> *u8;
extern fn dispatch_sync_f(queue: *u8, ctx: *u8, work: fn(*u8));

// `dispatch_get_main_queue()` is a macro over a libdispatch global, so there is
// no function to call — dlsym the symbol (RTLD_DEFAULT is -2 on Darwin).
fn main_queue() -> *u8 {
    let rtld_default: *u8 = { (0 -% 2) as *u8 };
    return { dlsym(rtld_default, #str_ptr("_dispatch_main_q\0")) };
}

fn on_main_thread() -> bool {
    let ns_thread: *u8 = rt::get_class(#str_ptr("NSThread\0"));
    if ns_thread.is_null() { return true; }
    return rt::msg_i8(ns_thread, rt::sel(#str_ptr("isMainThread\0"))) != 0;
}

fn run_on_main_sync(ctx: *u8, work: fn(*u8)) {
    if on_main_thread() { work(ctx); return; }
    let q: *u8 = main_queue();
    // No queue means no libdispatch to hop through. Running directly is wrong
    // on a worker, and it is the only thing left that is not "do nothing at
    // all" — which for an RPC would be an answer that is silently a lie.
    if q.is_null() { work(ctx); return; }
    { dispatch_sync_f(q, ctx, work) };
}

#[link_name = "CGColorCreateGenericRGB"]
extern fn cg_rgba(r: f64, g: f64, b: f64, a: f64) -> *u8;

#[link_name = "NSStringFromClass"]
extern fn ns_string_from_class(c: *u8) -> *u8;

// The overlay layer and its two colours, made once. A CGColor from
// `CGColorCreate*` arrives at +1; holding both for the life of the process is
// two allocations, against one per highlight if they were made per call.
// WHAT THE OVERLAY IS ON, so it can be put back after the tree moves under it.
//
// `highlight` PLACES the layer; it does not attach it (attaching would need the
// target layer-backed, and an inspector that changes how the app it inspects
// draws is not an inspector). So every edit that changes a frame leaves the
// outline behind — which is every edit worth making.
//
// SO IT IS PUT BACK EVERY TICK, and that is the whole mechanism.
//
// What came before was a list of causes — the panel re-placing after its own
// writes, an `observe_size` for resizes, `rehighlight_soon` armed by the walker
// after any write that can move a frame. Each list was incomplete. The one that
// broke in the field was a `top` edit arriving over a socket: the walker armed
// a re-place for one turn later on THIS process's loop, the layout had not run
// by then, and the outline sat at the old frame while the label moved. Reported
// from a screenshot, with the box left behind under the text.
//
// Asking on every tick has no list to be incomplete. `frames_settled` fires
// after the layout pass, so the answer to "where is the node now" is true
// whatever moved it — a local write, a remote one, the window resizing, a
// splitter drag, the app relaying itself out.
//
// THE COST IS A NULL CHECK when nothing is highlighted, which is every tick of
// every app that is not being inspected at that instant. Highlighting is a
// deliberate, transient act on ONE node, so the loaded cost is one `place` walk
// per tick for as long as a developer is looking at an outline.
//
// WHAT IT DOES NOT CATCH, deliberately: a layer moved without a layout — an
// animation, or Core Animation driving a transform. Catching that needs a
// per-frame hook in every app that links this, which is not a trade worth
// making for a debugging outline.
static HIGHLIGHTED: insp::Handle = #zero::[insp::Handle]();
// The frame the outline is currently drawn at, so a tick that finds it
// unchanged does nothing. A `place` walk is cheap; moving a layer is not, and
// most ticks do not move the highlighted node.
static AT_X: f64 = 0.0f64;
static AT_Y: f64 = 0.0f64;
static AT_W: f64 = 0.0f64;
static AT_H: f64 = 0.0f64;

static OVERLAY: *u8 = 0 as *u8;
static FILL: *u8 = 0 as *u8;
static STROKE: *u8 = 0 as *u8;

// CATransform3DIdentity is a C global, not a call, so it is spelled out.
fn identity_transform() -> qc::Transform3D {
    return qc::Transform3D {
        m11: 1.0f64, m12: 0.0f64, m13: 0.0f64, m14: 0.0f64,
        m21: 0.0f64, m22: 1.0f64, m23: 0.0f64, m24: 0.0f64,
        m31: 0.0f64, m32: 0.0f64, m33: 1.0f64, m34: 0.0f64,
        m41: 0.0f64, m42: 0.0f64, m43: 0.0f64, m44: 1.0f64,
    };
}

// The overlay's own m11, for the suite: the outline of a scaled node has to be
// scaled with it, and that is a number rather than a screenshot.
// Give `overlay` the node's own matrix, when the node is the thing that was
// placed. Split out so the suite can drive it on bare layers: a full check
// needs a mounted view in a window, and what is worth pinning is the DECISION
// — mirror when the placed view is the node's own, identity otherwise.
fn mirror_transform(overlay: qc::Layer, own: *u8, placed: *u8) {
    if own.is_null() { return; }
    // A VIEWLESS node was placed against an ANCESTOR's view, and that
    // ancestor's matrix is not this node's. A span inside a scaled label is
    // already drawn scaled by the label's own layer; mirroring it here would
    // apply the scale twice.
    if own != placed { return; }
    let nl: qc::Layer = ak::View::from_raw(own).layer();
    if nl.raw() == (0 as *u8) { return; }
    overlay.set_transform(nl.transform());
}

fn overlay_m11() -> f64 {
    if OVERLAY.is_null() { return 1.0f64; }
    return { qc::Layer::from_raw(OVERLAY).transform().m11 };
}

fn ensure_colours() {
    if FILL.is_null() {
        // A wash plus a solid edge. Two channels, not one: a fill alone
        // disappears over busy content and an edge alone is invisible on a
        // one-pixel control.
        FILL = cg_rgba(0.13, 0.47, 1.0, 0.22);
        STROKE = cg_rgba(0.13, 0.47, 1.0, 0.95);
    }
}

fn overlay_layer() -> qc::Layer {
    ensure_colours();
    if OVERLAY.is_null() {
        let l: qc::Layer = qc::Layer::new();
        l.set_background_color(FILL);
        l.set_border_color(STROKE);
        l.set_border_width(1.0);
        l.set_corner_radius(2.0);
        // Above whatever the application drew into the same layer tree.
        l.set_z_position(10000.0);
        OVERLAY = rt::retain(l.raw());
        return l;
    }
    return qc::Layer::from_raw(OVERLAY);
}

// ---- resolving a node to a rectangle -----------------------------------------

// Where a node is, in the coordinate space of the nearest ancestor that has a
// backing view.
//
// A node with its own view is its own answer. A VIEWLESS node is not a node
// without a place — it is a node whose place is inside someone else's view: a
// span is a run in its label's string, a menu item a row in its menu. Its flex
// frame is relative to its parent, so the offsets accumulate up the chain
// until a backed ancestor is reached, and the result is a rect in that view.
// `view` is BORROWED — the backend that mounted it owns it and releases it
// through the node's `view_release`. This struct is a short-lived answer, not
// a second owner, so it carries no destructor and says so.
struct Placed {
    opaque view: *u8,
    rect: rt::Rect,
    found: bool,
}

fn place(n: *core::Node) -> Placed {
    let none: Placed = Placed {
        view: 0 as *u8,
        rect: rt::Rect { x: 0.0, y: 0.0, w: 0.0, h: 0.0 },
        found: false,
    };
    if n.is_null() { return none; }

    let own: *u8 = core::view_of(n);
    if own.is_not_null() {
        let b: rt::Rect = { ak::View::from_raw(own).bounds() };
        return Placed { view: own, rect: b, found: true };
    }

    let f: flex::Frame = core::frame_of(n);
    var x: f64 = f.left;
    var y: f64 = f.top;
    let w: f64 = f.width;
    let h: f64 = f.height;

    var cur: *core::Node = n;
    // Bounded by the tree's own depth; a parent link always goes up.
    var steps: usize = 0;
    while steps < 256 {
        let p: *core::Node = match mount::parent_of(cur) {
            option::Option[*core::Node]::Some(q) => q,
            option::Option::None => 0 as *core::Node,
        };
        if p.is_null() { return none; }
        let pv: *u8 = core::view_of(p);
        if pv.is_not_null() {
            let host: ak::View = ak::View::from_raw(pv);
            var top: f64 = y;
            // facet's hosts are flipped, so flex's top-left origin is the
            // view's own. Asked at runtime rather than assumed, because a host
            // that is not flipped would put every highlight on the wrong side
            // of the window and look like a layout bug.
            if !host.is_flipped() {
                let hb: rt::Rect = host.bounds();
                top = hb.h - y - h;
            }
            return Placed {
                view: pv,
                rect: rt::Rect { x: x, y: top, w: w, h: h },
                found: true,
            };
        }
        let pf: flex::Frame = core::frame_of(p);
        x = x + pf.left;
        y = y + pf.top;
        cur = p;
        steps = steps +% 1;
    }
    return none;
}

// ---- highlight ---------------------------------------------------------------

fn clear_highlight(_s: *u8) {
    HIGHLIGHTED = insp::Handle::none();
    // FORGOTTEN TOO. Without this, selecting a node, clearing, and selecting
    // the same node again would find the remembered rect unchanged and skip
    // the re-place — an outline that never came back.
    AT_X = 0.0f64; AT_Y = 0.0f64; AT_W = 0.0f64; AT_H = 0.0f64;
    if OVERLAY.is_null() { return; }
    let l: qc::Layer = qc::Layer::from_raw(OVERLAY);
    l.remove_from_superlayer();
}

fn highlight(s: *u8, h: insp::Handle) {
    clear_highlight(s);
    if !h.is_live() { return; }
    HIGHLIGHTED = h;
    let p: Placed = place(tree::node_of(h));
    if !p.found { return; }

    let target: ak::View = ak::View::from_raw(p.view);
    let win: ak::Window = match target.window() {
        option::Option[ak::Window]::Some(w) => w,
        option::Option::None => { return; }
    };
    let content: ak::View = match win.content_view() {
        option::Option[ak::View]::Some(c) => c,
        option::Option::None => { return; }
    };

    // Into the content view's space, which is where the overlay lives. The
    // conversion carries flipped-ness across, so this is one call rather than
    // a coordinate argument this module has to get right twice.
    let r: rt::Rect = target.convert_rect_to_view(p.rect, content);

    content.set_wants_layer(true);
    let host: qc::Layer = content.layer();
    if host.raw() == (0 as *u8) { return; }

    let l: qc::Layer = overlay_layer();
    // IDENTITY FIRST. The layer is reused across highlights, so a transform
    // left from the last one would ride the next node.
    l.set_transform(identity_transform());
    l.set_frame(r);

    // THE NODE'S OWN TRANSFORM, MIRRORED — `scale`, `rotation` and
    // `translation` are a CATransform3D on the node's LAYER, not a layout
    // change, so its flex frame and its view's bounds are the UNSCALED ones.
    // `convertRect:toView:` is view geometry and does not see a layer matrix
    // either. So the outline of a node at `scale: 2` was the right rectangle
    // for a node drawing at twice the size — reported as a highlight that
    // trailed a scale write, and no amount of re-placing fixes it, because
    // re-placing computes the same rect.
    //
    // Read from the layer rather than recomputed from the props: whatever the
    // backend composed is what is on screen, and this cannot drift from it.
    // Both layers anchor at their own centre and the overlay's frame IS the
    // node's rect, so the same matrix about the same centre lands in the same
    // place.
    //
    // A VIEWLESS node has no layer and no transform — a span is a run inside
    // its label's string — so `p.view` being the parent's is the right answer
    // and there is nothing to mirror.
    mirror_transform(l, core::view_of(tree::node_of(h)), p.view);

    host.add_sublayer(l);
    // REMEMBER WHERE IT LANDED, so the tick can tell "still there" from "moved"
    // without doing this again.
    AT_X = p.rect.x; AT_Y = p.rect.y; AT_W = p.rect.w; AT_H = p.rect.h;
}

// ---- native rows -------------------------------------------------------------

// What the platform owns, for the third panel. Read-only by construction: a
// native class name is not something an inspector can set, and saying so with
// no editor is clearer than an editor that refuses.
fn native_props(n: *core::Node) -> vec::Vec[insp::Prop] {
    var out: vec::Vec[insp::Prop] = vec::new::[insp::Prop]();
    let v: *u8 = core::view_of(n);
    if v.is_null() {
        // Not an absence of information — a fact about the node, and the one
        // that explains why it has no frame of its own.
        let _a: status::Status = out.append(insp::Prop::read_only(
            "native_class", insp::Value::Str(text::from_str("(drawn by an ancestor)"))));
        return out;
    }

    let cls: *u8 = rt::msg_id(v, rt::sel(#str_ptr("class\0")));
    let name: text::Text = bridge::to_text(ns_string_from_class(cls));
    let _b: status::Status = out.append(insp::Prop::read_only(
        "native_class", insp::Value::Str(name)));

    let view: ak::View = ak::View::from_raw(v);
    let _c: status::Status = out.append(insp::Prop::read_only(
        "native_hidden", insp::Value::Bool(view.is_hidden())));

    let f: rt::Rect = view.frame();
    var geom: text::Text = text::from_str("");
    let _d: status::Status = geom.append({ (f.x as i64) }.to_text().view());
    let _e: status::Status = geom.append(", ");
    let _f2: status::Status = geom.append({ (f.y as i64) }.to_text().view());
    let _g: status::Status = geom.append(", ");
    let _h: status::Status = geom.append({ (f.w as i64) }.to_text().view());
    let _i: status::Status = geom.append(", ");
    let _j: status::Status = geom.append({ (f.h as i64) }.to_text().view());
    let _k: status::Status = out.append(insp::Prop::read_only(
        "native_frame", insp::Value::Str(geom)));

    match view.window() {
        option::Option[ak::Window]::Some(w) => {
            let fr: *u8 = rt::msg_id(w.raw(), rt::sel(#str_ptr("firstResponder\0")));
            let _l: status::Status = out.append(insp::Prop::read_only(
                "first_responder", insp::Value::Bool(fr == v)));
        }
        option::Option::None => { }
    }
    return out;
}

// ---- installation ------------------------------------------------------------

// Hand the portable side its platform. Until this is called the inspector
// still works — it just cannot highlight, and says so through the no-ops
// rather than by crashing.
// The general pasteboard, for the panel's Copy button.
//
// `NSPasteboardTypeString` is a global NSString the linker would have to
// resolve; its value is the UTI and writing it out is one string instead of an
// extern and a load. `clearContents` first is not optional — `setString:forType:`
// on a board that was not cleared is documented to fail.
fn pasteboard_write(s: str) -> bool {
    let cls: *u8 = rt::get_class(#str_ptr("NSPasteboard\0"));
    if cls == (0 as *u8) { return false; }
    let pb: *u8 = rt::msg_id(cls, rt::sel(#str_ptr("generalPasteboard\0")));
    if pb == (0 as *u8) { return false; }
    let _n: i64 = rt::msg_i64(pb, rt::sel(#str_ptr("clearContents\0")));
    let body: *u8 = bridge::nsstring(s);
    let ty: *u8 = bridge::nsstring("public.utf8-plain-text");
    let ok: i8 = rt::msg_i8_id_id(pb, rt::sel(#str_ptr("setString:forType:\0")), body, ty);
    return ok != (0 as i8);
}

// Put the outline back where the node now is. Called from the backend's tick,
// after layout — see `core::set_frames_settled_fn`.
//
// A NO-OP UNLESS THE FRAME MOVED. The outline is a layer, and setting its
// position every tick would be a commit every tick for a box that has not
// moved. So the last placement is remembered and compared; only a change
// reaches `highlight`.
fn replace_highlight_now() {
    let h: insp::Handle = HIGHLIGHTED;
    if h.is_none() { return; }
    if !h.is_live() {
        // The node went away under us — a remove, or a screen swapped out.
        // Leaving the outline over whatever took its place is the worst of the
        // three options.
        clear_highlight(0 as *u8);
        return;
    }
    let p: Placed = place(tree::node_of(h));
    if !p.found { return; }
    if p.rect.x == AT_X && p.rect.y == AT_Y && p.rect.w == AT_W && p.rect.h == AT_H { return; }
    highlight(0 as *u8, h);
}

fn install() {
    tree::install_platform(highlight, clear_highlight);
    // The outline follows its node from here on — see `replace_highlight_now`.
    core::set_frames_settled_fn(replace_highlight_now);
    tree::set_native_fn(native_props);
    tree::set_clipboard_fn(pasteboard_write);
    // Installed here and not in `mcp` so that module stays portable: the hop is
    // libdispatch, and a build with no platform shim keeps `mcp`'s direct call,
    // which is right for headless and for an in-process caller.
    mcp::set_marshal(run_on_main_sync);
}
