    if name == "auto" { return option::Option[flex::Align]::Some(flex::Align::Auto); }
    if name == "flex_start" { return option::Option[flex::Align]::Some(flex::Align::FlexStart); }
    if name == "center" { return option::Option[flex::Align]::Some(flex::Align::Center); }
    if name == "flex_end" { return option::Option[flex::Align]::Some(flex::Align::FlexEnd); }
    if name == "stretch" { return option::Option[flex::Align]::Some(flex::Align::Stretch); }
    if name == "baseline" { return option::Option[flex::Align]::Some(flex::Align::Baseline); }
    if name == "space_between" { return option::Option[flex::Align]::Some(flex::Align::SpaceBetween); }
    if name == "space_around" { return option::Option[flex::Align]::Some(flex::Align::SpaceAround); }
    if name == "space_evenly" { return option::Option[flex::Align]::Some(flex::Align::SpaceEvenly); }
