// facet agent facade for WINDOWS. `import "facet_agent/agent"` resolves HERE on
// a windows target, through the same filename override that picks
// `agent_linux.cplus` on Linux and `runtime_windows.cplus` in the runtime tier.
//
// THE READER IS WINUI's (netdu/cplus#20). facet_winui is the Windows backend,
// so the surface an agent reads is `agent_winui`'s: the XAML visual tree of
// every open window, each a `window` node under `app` named as the app
// registered it, with facet's keys pinned onto the native controls as they
// mount (facet_winui's agent hooks, filled here). This was the optional
// `facet_agent_winui` connector; it lives here now so that `enable()` - what
// every facet app already calls - serves WinUI, and `facet_agent_winui` is a
// thin compatibility door onto it.
//
// THE TRANSPORT IS A PORT, not a path: stdlib has no AF_UNIX on Windows, so the
// address is a loopback port derived from the pid (`agent_mcp::loopback_port`)
// and the application passes an ID, a name for this surface. The framing is
// HTTP, which an MCP client already speaks, bound to loopback only.
//
// THE UI THREAD OWNS THE SURFACE. agent_winui's backend is synchronous and
// UI-thread-only; `agent_winui_mcp` runs the socket on a worker and dispatches
// every request onto the window's DispatcherQueue, and stops before the
// surface is released.
//
// `policy_for` is shared rather than merely similar: it is facet's vocabulary
// translated into agent_core's, identical to the AppKit module's on purpose.
import "facet/application" as app;
import "facet/facet" as core;
import "facet/props" as props;
import "facet/vocabulary" as vocab;
import "facet/window" as fwindow;
import "agent_core/auth" as auth;
import "agent_core/identity" as identity;
import "agent_core/backend" as backend;
import "agent_inapp/agent_inapp" as inapp;
import "agent_mcp/agent_mcp" as mcp;
import "agent_mcp/inspect" as mcp_inspect;
import "agent_winui/agent_winui" as agent;
import "agent_winui_mcp/agent_winui_mcp" as http;
import "facet_winui/agent_hooks" as hooks;
import "facet_winui/record" as record;
import "facet_winui/facet_winui" as host;
import "winrt/runtime" as rt;
import "winui/winui" as ui;
import "./inspect_tree" as itree;
import "./inspect_platform" as iplatform;
import "./native_surface" as native_surface;
import "stdlib/vec" as vec;
import "stdlib/text" as text;
import "stdlib/io" as io;
import "stdlib/option" as option;
import "stdlib/result" as result;

static SURFACE: agent::Surface = #zero::[agent::Surface]();
static ACTIVE: bool = false;
static QUEUE: rt::Object = #zero::[rt::Object]();
// The id `serve_once` was asked to serve under before any window existed:
// served when the first one opens.
static SERVE_ID: text::Text = #zero::[text::Text]();

// Register the serving hooks. Call once, before `app.run`.
fn enable() {
    hooks::install(hooks::Hooks { opened: opened, closing: closing, apply: apply, alias: alias, release: released });
    app::install_agent(app::AgentHooks {
        attach_window: attach_window,
        serve_once: serve_once,
        pin_policy: pin_policy,
    });
    return;
}

// Back to the portable no-op: an app that stops serving has no surface, and
// the runtime's hooks answer nothing rather than reaching a dead one.
fn disable() {
    stop();
    hooks::install(#zero::[hooks::Hooks]());
    app::install_agent(app::AgentHooks {
        attach_window: 0 as fn(*u8),
        serve_once: 0 as fn(str),
        pin_policy: 0 as fn(*u8, vocab::Agent),
    });
    SERVE_ID = text::new();
    return;
}

// An assistant embedded in this process: the same backend vtable as the
// external bridge, with the same grant model, and no socket. UI thread only.
// The default is `operator()`: read and drive the app, and nothing from a node
// behind a tier - the developer bounding what model output can reach.
fn in_app() -> inapp::Session { return native_surface::in_app(auth::operator()); }

// A wider session for a task the user approved. A NEW session rather than a
// widened one, so the authority lives in a value the app drops.
fn in_app_with_grant(grant: auth::Grant) -> inapp::Session { return native_surface::in_app(grant); }

// THE ONE PLACE the two vocabularies meet. `Hidden` maps to EXCLUDE rather than
// to a tier: it takes the subtree out of the agent's world instead of gating
// its content.
fn policy_for(a: vocab::Agent) -> u32 {
    return match a {
        vocab::Agent::Open => identity::policy_none(),
        vocab::Agent::Protected => identity::policy_protected(),
        vocab::Agent::Private => identity::policy_private(),
        vocab::Agent::Hidden => identity::policy_exclude(),
    };
}

// The runtime's pin and attach doors. On WinUI a node's tier reaches the
// surface through the renderer's apply hook (`apply` below), which sees every
// node as it changes, so these have nothing left to do.
fn pin_policy(view: *u8, a: vocab::Agent) { return; }
fn attach_window(win: *u8) { return; }

// ---- the surface over every window --------------------------------------------------
// The first window opens it and starts serving if asked; later windows join it
// and leave as they close; the last closing stops the listener and closes the
// surface.
fn opened(window: rt::Object) {
    if ACTIVE { assert SURFACE.add_window(window).is_ok(); return; }
    match agent::open(window.clone()) { result::Result::Ok(s) => { SURFACE = s; }, result::Result::Err(_) => { assert false; return; } }
    let w: ui::IWindow = match ui::IWindow::query(window) { result::Result::Ok(v) => v, result::Result::Err(_) => { assert false; return; } };
    QUEUE = match w.dispatcher_queue() { result::Result::Ok(v) => v, result::Result::Err(_) => { assert false; return; } };
    agent::set_names_fn(window_name);
    ACTIVE = true;
    native_surface::install(#addr_of(SURFACE) as *u8, agent::mcp_backend(), serve_once);
    if !SERVE_ID.is_empty() { let id: text::Text = SERVE_ID.clone(); serve_now(id.view()); }
}
fn closing(window: rt::Object) {
    if !ACTIVE { return; }
    let gone: bool = SURFACE.remove_window(window);
    if SURFACE.window_count() > (0 as usize) { return; }
    stop();
}
fn stop() {
    if !ACTIVE { return; }
    http::stop();
    native_surface::uninstall();
    SURFACE.close();
    agent::set_names_fn(0 as fn(rt::Object) -> text::Text);
    QUEUE = rt::Object::empty();
    ACTIVE = false;
}
// A window's address, as agent_appkit gives it: the name the app registered it
// under when exactly one open window has it, else the instance's window key;
// nothing for a window facet did not open.
fn window_name(window: rt::Object) -> text::Text {
    let root: *core::Node = host::root_of_window(window);
    if root.is_null() { return text::new(); }
    let ws: vec::Vec[fwindow::Window] = fwindow::all();
    var name: str = ""; var same: usize = 0; var i: usize = 0;
    while i < ws.count() { if let option::Option::Some(w) = ws.at_ptr(i) { if (*w).root() == root { name = (*w).name(); } } i = i + 1; }
    if name != "" {
        i = 0;
        while i < ws.count() { if let option::Option::Some(w) = ws.at_ptr(i) { if (*w).name() == name { same = same + 1; } } i = i + 1; }
        if same == (1 as usize) { return text::from_str(name); }
    }
    return text::from_str(app::window_key_of(root));
}
// The renderer's hooks: a mounted control takes its node's key and tier; a
// window command carries every owner boundary with it, including live edits;
// an unkeyed container that carries a privacy boundary is pinned under a
// reserved process-local id and made observe-only.
fn apply(object: rt::Object, node: *core::Node) {
    if !ACTIVE { return; }
    let data: *core::Data = core::node_data(node);
    var policy: u32 = policy_for((*data).common.agent);
    let r = core::view_of(node) as *record::View;
    if r.is_not_null() && ((*r).kind == props::K_MENU || (*r).kind == props::K_TOOLBAR_ITEM) {
        var parent = (*r).parent as *record::View;
        while parent.is_not_null() { policy = policy | policy_for((*core::node_data((*parent).node)).common.agent); parent = (*parent).parent as *record::View; }
    }
    let key: str = (*node).key();
    if key == "" {
        let address: usize = object.raw() as usize;
        let id: text::Text = "facet:policy:${address}";
        assert SURFACE.update(object, id.view(), policy, true, false).is_ok();
        return;
    }
    assert SURFACE.update(object, key, policy).is_ok();
}
fn alias(object: rt::Object, node: *core::Node, key: str) {
    if !ACTIVE { return; }
    assert SURFACE.update(object, key, policy_for((*core::node_data(node)).common.agent)).is_ok();
}
fn released(object: rt::Object) { if ACTIVE { let removed: bool = SURFACE.unpin(object); } }

// ---- serving ---------------------------------------------------------------------------
// The default channel policy: both channels admitted as ORDINARY OPERATORS,
// plus `cap_edit_tree` for the inspector verbs serving publishes.
fn admit(req: auth::Request) -> auth::Grant { return auth::operator().with(auth::cap_edit_tree()); }

// THE APP'S OWN POLICY, if it has one. Set it before `enable()`.
static AGENT_POLICY: fn(auth::Request) -> auth::Grant = #zero::[fn(auth::Request) -> auth::Grant]();
fn set_policy(f: fn(auth::Request) -> auth::Grant) { AGENT_POLICY = f; return; }
fn effective_policy() -> fn(auth::Request) -> auth::Grant {
    if AGENT_POLICY == (0 as fn(auth::Request) -> auth::Grant) { return admit; }
    return AGENT_POLICY;
}

// Serve under `id`, once per process. Before the first window exists the id is
// remembered and served when it opens.
fn serve_once(id: str) {
    if http::running() { return; }
    if !mcp::valid_id(id) {
        let bad: text::Text = "facet: agent surface not served — \"${id}\" is not a valid id (a NAME, not a path)";
        io::eprintln(bad.view());
        return;
    }
    if !ACTIVE { SERVE_ID = text::from_str(id); return; }
    serve_now(id);
}
// The bound port, or a negative setup error.
fn serve(id: str) -> i32 {
    if !ACTIVE { return -12; }
    return http::start(#addr_of(SURFACE), QUEUE, id, effective_policy());
}
fn serve_now(id: str) {
    if http::running() { return; }
    // Clear out what dead processes left behind; a descriptor carries the pid.
    let _swept: usize = mcp::sweep_stale();
    // The inspector's verbs, published with the others: serving IS the opt-in.
    iplatform::install();
    mcp_inspect::publish();
    mcp_inspect::set_backend(itree::local_backend());
    mcp::set_server_name(id);
    let port: i32 = serve(id);
    if port < 0 { io::eprintln("facet: agent surface not served (setup error ${port})"); return; }
    io::eprintln("facet: agent surface on http://127.0.0.1:${port}/ — ${mcp::verb_summary()}");
}
fn surface_ptr() -> *u8 { assert ACTIVE; return #addr_of(SURFACE) as *u8; }
fn mcp_backend() -> backend::Backend { return agent::mcp_backend(); }

// ---- tests ------------------------------------------------------------------

#[test]
fn enable_fills_the_install_struct_and_disable_empties_it() {
    // The seam's own rule: zero fields keep the portable no-op, so a runtime
    // with no agent enabled must reach nothing rather than reach a null.
    disable();
    app::agent_attach(0 as *u8);      // inert, not a trap
    app::agent_serve_once("8787");
    enable();
    // Before any window: attaching is inert and serving waits for the first.
    app::agent_attach(0 as *u8);
    app::agent_serve_once("probe-app");
    assert SERVE_ID.view() == "probe-app";
    assert !ACTIVE;
    disable();
    assert SERVE_ID.is_empty();
    return;
}

#[test]
fn an_invalid_id_is_refused_and_remembered_nowhere() {
    // NEGATIVE: an id that is a path is refused, before and after windows.
    enable();
    serve_once("/tmp/app.sock");
    assert SERVE_ID.is_empty();
    disable();
    return;
}

#[test]
fn every_facet_tier_maps_to_the_policy_the_core_reads() {
    // A `Private` that mapped to `policy_none` is a CVC readable by every agent
    // that connects, and nothing downstream would notice.
    assert policy_for(vocab::Agent::Open) == identity::policy_none();
    assert policy_for(vocab::Agent::Protected) == identity::policy_protected();
    assert policy_for(vocab::Agent::Private) == identity::policy_private();
    assert policy_for(vocab::Agent::Hidden) == identity::policy_exclude();
    assert identity::policy_none() != identity::policy_protected();
    assert identity::policy_protected() != identity::policy_private();
    assert identity::policy_private() != identity::policy_exclude();
    return;
}
