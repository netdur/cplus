// facet_uikit paint — the shared band, on any view, whatever its kind.
//
// Colour, background, brush, shadow, clip, corner radius, transform, opacity,
// the animate verbs, semantics. A port of facet_appkit/paint.cplus; the Core
// Animation half is the same code on both platforms because it is the same
// framework, and the differences are all on the AppKit side of the port.
//
// ---- three things this file does NOT have to do -----------------------------
//
// 1. `setWantsLayer:`. An NSView has no layer until asked, which is why every
//    paint verb in the AppKit backend begins by asking and every clear checks
//    `wantsLayer` before touching one. A UIView is layer-backed from birth, so
//    `view.layer()` is always a layer and the whole dance is gone.
//
// 2. THE SHADOW FLIP. The AppKit backend negates `offset.y`, because its views
//    are flipped (y-down) and a CALayer's shadow offset there is not. On iOS
//    both are y-down, so the offset goes through as facet states it. This is
//    the one line where copying the AppKit code would have been silently wrong.
//
// 3. THE APPEARANCE DANCE. `NSColor` flattens against
//    `NSAppearance.currentAppearance`, which is not the view's, which cost that
//    backend a static-saved re-entrant `perform_as_current_drawing_appearance`
//    wrapper around every configure. A `UIColor` resolves against
//    `UITraitCollection.currentTraitCollection` at the moment it is asked for
//    components, and UIKit's semantic colours (`labelColor`,
//    `systemBackgroundColor`, ...) are dynamic objects that re-resolve
//    themselves when the trait collection changes. So facet's semantic roles
//    map onto colours that already follow dark mode, and only the LITERAL
//    adaptive pairs (token 254) need re-resolving on a flip — which is what the
//    repaint walk in facet_uikit.cplus is for.

import "stdlib/option" as option;
import "stdlib/text" as text;
import "facet/facet" as core;
import "facet/props" as props;
import "facet/vocabulary" as vocab;
import "facet/theme" as theme;
import "facet/application" as app;
import "objc/runtime" as rt;
import "objc/bridge" as bridge;
import "objc/synthesis" as synth;
import "quartzcore/quartzcore" as quartz;
import "uikit/uikit" as ui;

// "Configure this view whole" — every FACT, and no VERB. `create` passes it,
// and so does the reclass path; both mean re-read everything, neither means
// re-issue focus and blur. See `props::C_ALL_STATE` for why that distinction is
// not cosmetic.
fn all_bits() -> u64 { return props::C_ALL_STATE; }

// ---- colour ------------------------------------------------------------------

// Is this the dark side? `UITraitCollection.currentTraitCollection`'s
// `userInterfaceStyle`: 0 unspecified, 1 light, 2 dark.
fn is_dark_now() -> bool {
    let cls: *u8 = rt::get_class(#str_ptr("UITraitCollection\0"));
    let tc: *u8 = { rt::msg_id(cls, rt::sel(#str_ptr("currentTraitCollection\0"))) };
    if tc == (0 as *u8) { return false; }
    return { rt::msg_i64(tc, rt::sel(#str_ptr("userInterfaceStyle\0"))) } == (2 as i64);
}

// Guard against a role whose theme slot names another role.
static RESOLVE_DEPTH: i64 = 0 as i64;

fn ui_color(c: vocab::Color) -> ui::Color {
    if RESOLVE_DEPTH > (4 as i64) { return ui::Color::label_color(); }
    RESOLVE_DEPTH = RESOLVE_DEPTH + (1 as i64);
    let out: ui::Color = resolve_body(c);
    RESOLVE_DEPTH = RESOLVE_DEPTH - (1 as i64);
    return out;
}

// facet's colour tokens onto UIKit's palette.
//
// The semantic ones are UIKit's OWN semantic colours rather than literals, for
// the same reason the AppKit backend uses NSColor's: they are dynamic objects,
// so a node painted with one follows dark mode with no repaint at all.
//
// Four roles have no iOS twin and take the nearest honest stand-in; MANIFEST.md
// lists them rather than leaving the substitution to be discovered on screen.
fn resolve_body(c: vocab::Color) -> ui::Color {
    var cc: vocab::Color = c;
    // ink(a): remember the mark's alpha before the role substitutes away.
    var mark_alpha: f64 = -1.0f64;
    if { cc.token } == (104 as u32) && { c.a } < 1.0f64 { mark_alpha = { c.a }; }
    if cc.is_theme_role() {
        var slot: vocab::Color = theme::theme_slot({ cc.token });
        if slot.is_set() == false { slot = theme::theme_fallback({ cc.token }); }
        cc = slot;
    }
    var out: ui::Color = ui::Color::label_color();
    let t: u32 = { cc.token };
    if cc.is_derived_ink() {
        // Checked before the token table: 200..217 would otherwise fall through
        // to the literal branch and paint transparent black.
        out = ink_over(cc.derived_ink_base());
    }
    else if t == (254 as u32) {
        // Adaptive pair: the side for the CURRENT trait collection. The one
        // colour shape here that does not follow a live flip on its own, which
        // is why `theme_changed` walks the tree and re-applies the paint bits.
        if is_dark_now() {
            out = ui::Color::color_with_red({ cc.r2 }, { cc.g2 }, { cc.b2 }, { cc.a2 });
        } else {
            out = ui::Color::color_with_red({ cc.r }, { cc.g }, { cc.b }, { cc.a });
        }
    }
    else if t == (1 as u32) { out = ui::Color::label_color(); }
    else if t == (2 as u32) { out = ui::Color::secondary_label_color(); }
    // The accent. macOS has a user-chosen `controlAccentColor`; iOS has the
    // view's own `tintColor`, and the class-side `tintColor` is the app's.
    else if t == (3 as u32) { out = ui::Color::tint_color(); }
    else if t == (4 as u32) { out = ui::Color::system_red_color(); }
    else if t == (5 as u32) { out = ui::Color::system_green_color(); }
    else if t == (6 as u32) { out = ui::Color::system_blue_color(); }
    else if t == (7 as u32) { out = ui::Color::system_orange_color(); }
    else if t == (8 as u32) { out = ui::Color::system_gray_color(); }
    else if t == (9 as u32) { out = ui::Color::tertiary_label_color(); }
    else if t == (10 as u32) { out = ui::Color::separator_color(); }
    // The window/page/control trio. iOS's three-level background scale is the
    // closest thing, and it is a real scale rather than three unrelated names.
    else if t == (11 as u32) { out = ui::Color::system_background_color(); }
    else if t == (12 as u32) { out = ui::Color::system_grouped_background_color(); }
    else if t == (13 as u32) { out = ui::Color::secondary_system_background_color(); }
    else if t == (14 as u32) { out = ui::Color::system_fill_color(); }
    else if t == (15 as u32) { out = ui::Color::placeholder_text_color(); }
    else if t == (16 as u32) { out = ui::Color::link_color(); }
    // SUBSTITUTED, not equivalent: iOS has no selected-content or
    // selected-text background role — a table row's selection is drawn by the
    // cell and a text selection by the tint. `systemFill` is the honest
    // stand-in; MANIFEST.md records both.
    else if t == (17 as u32) { out = ui::Color::system_fill_color(); }
    else if t == (18 as u32) { out = ui::Color::secondary_system_fill_color(); }
    else if t == (19 as u32) { out = ui::Color::secondary_system_fill_color(); }
    else if t == (20 as u32) { out = ui::Color::system_yellow_color(); }
    else if t == (21 as u32) { out = ui::Color::system_purple_color(); }
    else if t == (22 as u32) { out = ui::Color::system_pink_color(); }
    else if t == (23 as u32) { out = ui::Color::system_teal_color(); }
    else if t == (24 as u32) { out = ui::Color::system_indigo_color(); }
    else { out = ui::Color::color_with_red({ cc.r }, { cc.g }, { cc.b }, { cc.a }); }
    if mark_alpha >= 0.0f64 { out = out.color_with_alpha_component(mark_alpha); }
    return out;
}

extern fn pow(x: f64, y: f64) -> f64;

fn pow_f64(x: f64, y: f64) -> f64 { return { pow(x, y) }; }

fn linearize(c: f64) -> f64 {
    if c <= 0.04045f64 { return c / 12.92f64; }
    return pow_f64((c + 0.055f64) / 1.055f64, 2.4f64);
}

// The colour's relative luminance, or -1 when it has none worth using —
// translucent, or not expressible in RGBA.
//
// `getRed:green:blue:alpha:` resolves the receiver against the current trait
// collection on its way, which is the whole of what the AppKit backend needed a
// saved-static appearance block for.
fn luminance_of(c: ui::Color) -> f64 {
    var r: f64 = 0.0f64;
    var g: f64 = 0.0f64;
    var b: f64 = 0.0f64;
    var a: f64 = 0.0f64;
    let ok: bool = c.get_red({ #addr_of(r) as *u8 }, { #addr_of(g) as *u8 },
                             { #addr_of(b) as *u8 }, { #addr_of(a) as *u8 });
    if !ok { return -1.0f64; }
    if a < 0.95f64 { return -1.0f64; }
    return 0.2126f64 * linearize(r) + 0.7152f64 * linearize(g) + 0.0722f64 * linearize(b);
}

fn contrast_ratio(l1: f64, l2: f64) -> f64 {
    if l1 > l2 { return (l1 + 0.05f64) / (l2 + 0.05f64); }
    return (l2 + 0.05f64) / (l1 + 0.05f64);
}

// `Color::on(role)`: the readable ink over whatever `base` resolved to. Black
// or white, whichever contrasts harder — the only rule that cannot pick the
// less readable of the two. When the base has no honest luminance, the
// platform's own adaptive ink is the answer, not a guess.
fn ink_over(base: vocab::Color) -> ui::Color {
    let bg: ui::Color = ui_color(base);
    let l: f64 = luminance_of(bg);
    if l < 0.0f64 { return ui::Color::label_color(); }
    if contrast_ratio(l, 0.0f64) >= contrast_ratio(l, 1.0f64) {
        return ui::Color::color_with_red(0.0f64, 0.0f64, 0.0f64, 1.0f64);
    }
    return ui::Color::color_with_red(1.0f64, 1.0f64, 1.0f64, 1.0f64);
}

// ---- fonts -------------------------------------------------------------------
// facet names a WEIGHT, not a face. UIKit's UIFontWeight scale is the same
// -0.8..0.8 range AppKit uses, with 0.0 regular, so the table is the same one.
// `Default` means "whatever the control already had", which is why it is
// answered by the caller rather than substituted here.

fn ui_weight(w: vocab::FontWeight) -> f64 {
    return match w {
        vocab::FontWeight::Default => 0.0f64,
        vocab::FontWeight::UltraLight => -0.8f64,
        vocab::FontWeight::Thin => -0.6f64,
        vocab::FontWeight::Light => -0.4f64,
        vocab::FontWeight::Regular => 0.0f64,
        vocab::FontWeight::Medium => 0.23f64,
        vocab::FontWeight::Semibold => 0.3f64,
        vocab::FontWeight::Bold => 0.4f64,
        vocab::FontWeight::Heavy => 0.56f64,
        vocab::FontWeight::Black => 0.62f64,
    };
}

fn is_default_weight(w: vocab::FontWeight) -> bool {
    return match w {
        vocab::FontWeight::Default => true,
        vocab::FontWeight::UltraLight => false,
        vocab::FontWeight::Thin => false,
        vocab::FontWeight::Light => false,
        vocab::FontWeight::Regular => false,
        vocab::FontWeight::Medium => false,
        vocab::FontWeight::Semibold => false,
        vocab::FontWeight::Bold => false,
        vocab::FontWeight::Heavy => false,
        vocab::FontWeight::Black => false,
    };
}

// The font a text-bearing control should use, or None for "leave it alone".
//
// `font_scales` is Dynamic Type, and it is the one place iOS is RICHER than
// macOS rather than poorer: `preferredFontForTextStyle:` gives a font that
// follows the user's content-size setting, which is the accessibility feature
// the flag exists to ask for. A named size overrides it, because a caller that
// states 18pt has said what it wants.
// The font a RECORDING names: a size, a weight and a family, and no Dynamic
// Type — a drawing states its own sizes and a canvas that re-scaled them would
// draw something other than what was recorded.
fn ui_font_plain(size: f64, weight: vocab::FontWeight, family: str)
    -> option::Option[ui::Font] {
    return ui_font(size, weight, family, false, false);
}

fn ui_font(size: f64, weight: vocab::FontWeight, family: str, italic: bool,
           scales: bool) -> option::Option[ui::Font] {
    var f: ui::Font = ui::Font::system_font_of_size(ui::Font::system_font_size());
    var have: bool = false;
    if scales && size <= 0.0f64 {
        // Dynamic Type, the body style — the scale a paragraph is set at.
        f = ui::Font::preferred_font_for_text_style("UICTFontTextStyleBody");
        have = true;
    }
    var pt: f64 = size;
    if pt <= 0.0f64 {
        if have { pt = f.point_size(); } else { pt = ui::Font::system_font_size(); }
    }
    if family != "" {
        match ui::Font::font_with_name(family, pt) {
            option::Option[ui::Font]::Some(named) => { return option::some(named); }
            option::Option[ui::Font]::None => { }
        }
    }
    if is_default_weight(weight) == false {
        return option::some(ui::Font::system_font_of_size_weight(pt, ui_weight(weight)));
    }
    if size > 0.0f64 || have {
        return option::some(ui::Font::system_font_of_size(pt));
    }
    // Nothing was asked for: keep whatever the control shipped with. Italic is
    // the one exception — it is a face change with no size opinion.
    if italic { return option::some(ui::Font::italic_system_font_of_size(pt)); }
    return option::Option[ui::Font]::None;
}

// ---- semantics ---------------------------------------------------------------
// The accessible facts, which are the agent's facts too. Every UIView answers
// the UIAccessibility informal protocol, so there is no subclass and no
// associated object — the view already has the storage.
//
// `accessibilityHint` is UIKit's own word for what AppKit calls Help, so this
// is one line shorter than the AppKit version rather than one approximation
// longer. The heading level has a real home too: `accessibilityTraits` carries
// `UIAccessibilityTraitHeader` (1 << 16), where AppKit has to fake a role.
fn apply_semantics(v: *u8, n: *core::Node) {
    let label: str = core::accessibility_label(n);
    if label != "" {
        { rt::msg_void_id(v, rt::sel(#str_ptr("setAccessibilityLabel:\0")),
                          bridge::nsstring(label)) };
    }
    let hint: str = core::accessibility_hint(n);
    if hint != "" {
        { rt::msg_void_id(v, rt::sel(#str_ptr("setAccessibilityHint:\0")),
                          bridge::nsstring(hint)) };
    }
    if core::heading_level(n) > (0 as i64) {
        let was: u64 = { rt::msg_u64(v, rt::sel(#str_ptr("accessibilityTraits\0"))) };
        { rt::msg_void_u64(v, rt::sel(#str_ptr("setAccessibilityTraits:\0")),
                           was | trait_header()) };
    }
    return;
}

// UIAccessibilityTraitHeader = 1 << 16. Built arithmetically: an integer
// literal wraps through i32 before `as`, so a big mask written as one number is
// a different number by the time it lands.
fn trait_header() -> u64 { return (1 as u64) * (65536 as u64); }

// ---- the shared band ---------------------------------------------------------

fn apply_common(v: *u8, n: *core::Node, dirty: u64) {
    let view: ui::View = ui::View::from_raw(v);
    if (dirty & props::C_SEMANTICS) != (0 as u64) { apply_semantics(v, n); }
    // WHAT AN AGENT MAY DO WITH THIS NODE'S CONTENT. Pinned on the view rather
    // than held in facet, because the agent surface walks the PLATFORM tree and
    // never sees a facet node. Inert unless the app called `agent::enable()`.
    if (dirty & props::C_AGENT) != (0 as u64) { app::agent_pin(v, core::agent(n)); }
    // `tooltip` has NO iOS answer and is not approximated. There is no pointer
    // to hover, and turning one into a long-press popover would invent an
    // interaction the app never asked for. MANIFEST.md records it.
    if (dirty & props::C_IS_VISIBLE) != (0 as u64) {
        view.set_hidden(core::is_hidden(n));
    }
    // Cancel first: abort in-flight CA actions, then snap model values (the end
    // state already sits on common). Freeze-at-presentation is not v1.
    if (dirty & props::C_CANCEL_ANIMATIONS) != (0 as u64) {
        cancel_view_animations(view);
        view.set_alpha(core::opacity(n));
        apply_transform(view, n);
        core::clear_animate_channels(n);
    }
    // Animate before snap: C_ANIMATE alone carries the channels; a `set_*` would
    // have raised C_OPACITY / C_TRANSFORM and cleared those channels.
    if (dirty & props::C_ANIMATE) != (0 as u64) {
        apply_animate(view, n);
    }
    if (dirty & props::C_OPACITY) != (0 as u64) {
        view.set_alpha(core::opacity(n));
    }
    if (dirty & props::C_BACKGROUND_COLOR) != (0 as u64) {
        apply_background(view, core::background_color(n));
    }
    if (dirty & props::C_BACKGROUND) != (0 as u64) {
        apply_brush(view, core::background(n));
    }
    // `is_enabled` on a kind that is NOT a UIControl. The control kinds answer
    // `setEnabled:` in their own bodies; everything else — a box, a label, an
    // image, a canvas, a scroll — would silently ignore a verb the shared band
    // declares on every node.
    //
    // Dimmed, and not taking input: the honest approximation, and the one a
    // person reads as disabled.
    if (dirty & props::C_IS_ENABLED) != (0 as u64) {
        if !responds_to_set_enabled(v) {
            let on: bool = core::is_enabled(n);
            view.set_user_interaction_enabled(on);
            if on {
                view.set_alpha(core::opacity(n));
            } else {
                view.set_alpha(core::opacity(n) * 0.4f64);
            }
        }
    }
    // `input_transparent`: drawn, but touches fall through. UIKit has the
    // property outright, where AppKit needs a hit-test override on a synthesized
    // subclass — so this is the whole implementation rather than a seam into one.
    if (dirty & props::C_INPUT_TRANSPARENT) != (0 as u64) {
        if core::input_transparent(n) {
            view.set_user_interaction_enabled(false);
        } else if core::is_enabled(n) {
            view.set_user_interaction_enabled(true);
        }
    }
    if (dirty & props::C_FLOW_DIRECTION) != (0 as u64) {
        apply_flow_direction(view, n);
    }
    if (dirty & props::C_SHADOW) != (0 as u64) {
        apply_shadow(view, core::shadow(n));
    }
    if (dirty & props::C_CLIP) != (0 as u64) {
        apply_clip(view, core::clip(n));
    }
    // AFTER the clip, deliberately: both write `masksToBounds`, and a rounded
    // node has to clip or the corners are paint over square content. The clip
    // shape is the richer verb, so it goes first and this corrects it.
    if (dirty & props::C_CORNER_RADIUS) != (0 as u64) {
        let sh: vocab::Shadow = core::shadow(n);
        apply_corner_radius(view, core::corner_radius(n),
                            { core::clip(n).kind } != (0 as i64),
                            sh.color.is_set() && sh.opacity > 0.0f64);
    }
    if (dirty & props::C_TRANSFORM) != (0 as u64) {
        apply_transform(view, n);
    }
    return;
}

fn responds_to_set_enabled(v: *u8) -> bool {
    return synth::class_responds(synth::object_class(v),
                                 rt::sel(#str_ptr("setEnabled:\0"))) != (0 as i8);
}

// RTL. Two halves, and the hard one was already built: flex resolves a
// direction per node and mirrors row layout, justification and edge resolution
// from it. The other half is the view's own `semanticContentAttribute` — UIKit
// mirrors a control's text alignment and image position from it.
//
// 0 unspecified, 3 forceLeftToRight, 4 forceRightToLeft.
fn apply_flow_direction(view: ui::View, n: *core::Node) {
    let d: vocab::FlowDirection = core::flow_direction(n);
    view.set_semantic_content_attribute(match d {
        vocab::FlowDirection::MatchParent => ui::SemanticContentAttribute::Unspecified,
        vocab::FlowDirection::LeftToRight => ui::SemanticContentAttribute::ForceLeftToRight,
        vocab::FlowDirection::RightToLeft => ui::SemanticContentAttribute::ForceRightToLeft,
    });
    return;
}

// ---- corner radius, background, brush, shadow, clip --------------------------

// Core Animation has ONE radius per layer and facet carries four, so the
// largest wins — the same reduction the per-control bodies make, made in one
// place for every other node.
// A SHADOW AND A CLIP CANNOT SHARE ONE LAYER, and a card wants both.
//
// `masksToBounds` clips everything outside the layer — including the shadow,
// which is drawn outside by definition. Measured on the simulator: not one card
// in the gallery had a shadow, and the Shadow page was three blank rows, because
// every one of them also had a corner radius.
//
// The radius alone is enough for the ordinary case: a CALayer draws its own
// `backgroundColor` and border rounded whether or not it masks, so a rounded
// card with a shadow gets both as long as nothing forces the mask on. What the
// mask buys is clipping the CHILDREN, and that is what a node asks for with
// `clip` — so a node that states a shadow keeps its shadow, and a node that
// states a clip keeps its clipping.
fn apply_corner_radius(view: ui::View, c: vocab::Corners, has_clip: bool, has_shadow: bool) {
    let l: quartz::Layer = view.layer();
    let r: f64 = largest_corner(c);
    if r > 0.0f64 {
        l.set_corner_radius(r);
        if has_shadow && !has_clip {
            l.set_masks_to_bounds(false);
        } else {
            l.set_masks_to_bounds(true);
        }
        return;
    }
    l.set_corner_radius(0.0f64);
    // Only give the clipping back if nothing ELSE asked for it: a node that
    // loses its radius but keeps a clip shape still clips.
    if has_clip == false { l.set_masks_to_bounds(false); }
    return;
}

fn largest_corner(c: vocab::Corners) -> f64 {
    var m: f64 = { c.top_leading };
    if { c.top_trailing } > m { m = { c.top_trailing }; }
    if { c.bottom_leading } > m { m = { c.bottom_leading }; }
    if { c.bottom_trailing } > m { m = { c.bottom_trailing }; }
    return m;
}

// The view's own `backgroundColor`, not the layer's.
//
// UIView has the property and keeps it in step with the trait collection: a
// semantic colour written here re-resolves itself on a dark-mode flip, where
// the same colour flattened to a CGColor on the layer would not. The AppKit
// backend has to use the layer because NSView has no such property, and it pays
// for that with a repaint walk on every appearance change.
// AND `opaque` IS PART OF THE BACKGROUND, not a separate verb.
//
// A UIView that claims to be opaque promises to fill every pixel of its
// bounds. With no background colour it fills them with nothing, and nothing is
// drawn as BLACK. It costs a plain container nothing — a view with no `drawRect:`
// draws no pixels either way — so the lie is invisible until a view that DOES
// draw inherits it.
//
// Measured in the simulator: every UILabel came up as a solid black bar with
// its text on top, and `isOpaque` read YES with `backgroundColor` nil and
// `layer.backgroundColor` NULL. Nothing had painted the black; the label had
// promised to and had nothing to paint with.
//
// So the flag tracks the colour. Cleared with the background, and left to UIKit
// when a colour IS set — it derives `opaque` from that colour's alpha, which is
// the answer facet cannot compute for a dynamic or semantic colour anyway.
fn apply_background(view: ui::View, c: vocab::Color) {
    if c.is_set() == false {
        { rt::msg_void_id(view.raw(), rt::sel(#str_ptr("setBackgroundColor:\0")), 0 as *u8) };
        { rt::msg_void_i8(view.raw(), rt::sel(#str_ptr("setOpaque:\0")), 0 as i8) };
        return;
    }
    { rt::msg_void_id(view.raw(), rt::sel(#str_ptr("setBackgroundColor:\0")),
                      ui_color(c).raw()) };
    return;
}

// The shared band's `background` — a Brush, which is a solid or a linear
// gradient. A solid is the view's background colour, the same as
// `background_color`; a gradient needs a layer of its own, because CALayer has
// no gradient and CAGradientLayer is one.
fn apply_brush(view: ui::View, b: vocab::Brush) {
    if b.is_gradient == false {
        // A solid brush that is not set says nothing; leaving it alone lets
        // `background_color` own the view, which is the older verb.
        if b.start.is_set() == false { remove_gradient(view); return; }
        remove_gradient(view);
        apply_background(view, b.start);
        return;
    }
    let host: quartz::Layer = view.layer();
    let g: quartz::GradientLayer = gradient_sublayer(host);
    if g.raw() == (0 as *u8) { return; }
    { rt::msg_void_id(g.raw(), rt::sel(#str_ptr("setColors:\0")),
                      two_colour_array(b.start, b.end)) };
    // The angle is degrees clockwise from "up" in facet's vocabulary, and
    // CAGradientLayer wants unit points in a top-left space. `startPoint` and
    // `endPoint` are the two ends of the axis through the centre.
    let rad: f64 = b.angle * 0.017453292519943295f64;
    let dx: f64 = sin_of(rad) / 2.0f64;
    let dy: f64 = cos_of(rad) / 2.0f64;
    set_layer_point(g.raw(), #str_ptr("setStartPoint:\0"), 0.5f64 - dx, 0.5f64 + dy);
    set_layer_point(g.raw(), #str_ptr("setEndPoint:\0"), 0.5f64 + dx, 0.5f64 - dy);
    { msg_void_rect(g.raw(), rt::sel(#str_ptr("setFrame:\0")), view.bounds()) };
    return;
}

fn gradient_key() -> *u8 { return 29060 as *u8; }

// A GRADIENT SUBLAYER DOES NOT FOLLOW ITS VIEW. `apply_brush` sizes it from
// `view.bounds()`, and at apply time those bounds are ZERO — the frame walk
// runs after the applies, so a gradient was laid out into a 0x0 layer and
// never seen again. A sublayer has no autoresizing that a view-backed layer
// honours, so the layout pass calls this for any node whose brush is a
// gradient (geometry.cplus), which is a struct read rather than a message for
// every other node.
fn resize_gradient(v: *u8) {
    if v == (0 as *u8) { return; }
    let view: ui::View = ui::View::from_raw(v);
    let existing: *u8 = { synth::get_associated(view.layer().raw(), gradient_key()) };
    if existing == (0 as *u8) { return; }
    { msg_void_rect(existing, rt::sel(#str_ptr("setFrame:\0")), view.bounds()) };
    return;
}

// One gradient sublayer per view, kept on an associated key so a re-apply
// updates it rather than stacking a second one under the first.
fn gradient_sublayer(host: quartz::Layer) -> quartz::GradientLayer {
    let existing: *u8 = { synth::get_associated(host.raw(), gradient_key()) };
    if existing != (0 as *u8) { return quartz::GradientLayer::from_raw(existing); }
    let g: *u8 = { rt::alloc_init(#str_ptr("CAGradientLayer\0")) };
    if g == (0 as *u8) { return quartz::GradientLayer::from_raw(0 as *u8); }
    // BELOW index 0: a background is behind whatever the control draws.
    { rt::msg_void_id_u64(host.raw(), rt::sel(#str_ptr("insertSublayer:atIndex:\0")), g, 0 as u64) };
    synth::set_associated(host.raw(), gradient_key(), g);
    rt::release(g);
    return quartz::GradientLayer::from_raw(g);
}

fn remove_gradient(view: ui::View) {
    let host: quartz::Layer = view.layer();
    let existing: *u8 = { synth::get_associated(host.raw(), gradient_key()) };
    if existing == (0 as *u8) { return; }
    { rt::msg_void(existing, rt::sel(#str_ptr("removeFromSuperlayer\0"))) };
    synth::set_associated(host.raw(), gradient_key(), 0 as *u8);
    return;
}

fn two_colour_array(a: vocab::Color, b: vocab::Color) -> *u8 {
    let arr: *u8 = { rt::msg_id(rt::get_class(#str_ptr("NSMutableArray\0")),
                                rt::sel(#str_ptr("array\0"))) };
    { rt::msg_void_id(arr, rt::sel(#str_ptr("addObject:\0")), ui_color(a).c_g_color()) };
    { rt::msg_void_id(arr, rt::sel(#str_ptr("addObject:\0")), ui_color(b).c_g_color()) };
    return arr;
}

// The shared band's `shadow`.
//
// THE OFFSET IS NOT NEGATED. facet_appkit flips `offset.y` because its views
// are flipped and a CALayer's shadow offset on macOS is not. On iOS the view
// and the layer are both y-down, so a positive y is down in both — which is
// what facet means by it.
fn apply_shadow(view: ui::View, s: vocab::Shadow) {
    let l: quartz::Layer = view.layer();
    if s.opacity <= 0.0f64 || s.color.is_set() == false {
        { rt::msg_void_f32(l.raw(), rt::sel(#str_ptr("setShadowOpacity:\0")), 0.0f32) };
        return;
    }
    { rt::msg_void_id(l.raw(), rt::sel(#str_ptr("setShadowColor:\0")),
                      ui_color(s.color).c_g_color()) };
    { rt::msg_void_f32(l.raw(), rt::sel(#str_ptr("setShadowOpacity:\0")), s.opacity as f32) };
    { rt::msg_void_f64(l.raw(), rt::sel(#str_ptr("setShadowRadius:\0")), s.radius) };
    set_layer_size(l.raw(), #str_ptr("setShadowOffset:\0"), s.offset.x, s.offset.y);
    return;
}

// The shared band's `clip`. A CAShapeLayer used as the layer's MASK, which is
// how Core Animation clips to anything that is not a rectangle.
// CLEARING A CLIP REMOVES THE MASK, AND NOTHING ELSE.
//
// This used to force `clipsToBounds = NO` as well — clearing something it never
// set. `clipsToBounds` is not facet's to own: a UIScrollView defaults it to YES
// because a scroll that does not clip is not a scroll, and every node gets this
// branch on create (an unstated `clip` is shape kind 0). So every scroll in the
// app was silently un-clipped, and its content drew outside its own box, over
// whatever sibling came before it — the gallery's picker, in the report that
// found this.
//
// The mask is the only thing the other branch installs, so removing the mask is
// the exact inverse. Rectangular clipping rides `masksToBounds` in
// `apply_corner_radius`, which is symmetric on its own.
fn apply_clip(view: ui::View, s: vocab::Shape) {
    let l: quartz::Layer = view.layer();
    if s.kind == (0 as i64) {
        { rt::msg_void_id(l.raw(), rt::sel(#str_ptr("setMask:\0")), 0 as *u8) };
        return;
    }
    let b: rt::Rect = view.bounds();
    // A clip is the shape ITSELF, not a stroke inset by half a line, so the
    // path is built here rather than borrowed from the control paths.
    let path: *u8 = clip_path(b, s);
    if path == (0 as *u8) { return; }
    let mask: *u8 = { rt::alloc_init(#str_ptr("CAShapeLayer\0")) };
    if mask == (0 as *u8) { { CGPathRelease(path) }; return; }
    { msg_void_rect(mask, rt::sel(#str_ptr("setFrame:\0")), b) };
    { rt::msg_void_id(mask, rt::sel(#str_ptr("setPath:\0")), path) };
    { rt::msg_void_id(l.raw(), rt::sel(#str_ptr("setMask:\0")), mask) };
    rt::release(mask);
    { CGPathRelease(path) };
    return;
}

// `kind` 0 none, 1 rect, 2 rounded, 3 ellipse — vocabulary.cplus's numbering.
fn clip_path(b: rt::Rect, s: vocab::Shape) -> *u8 {
    if { b.w } <= 0.0f64 || { b.h } <= 0.0f64 { return 0 as *u8; }
    if { s.kind } == (3 as i64) { return { CGPathCreateWithEllipseInRect(b, 0 as *u8) }; }
    if { s.kind } == (2 as i64) {
        let c: vocab::Corners = { s.corners };
        var r: f64 = { c.top_leading };
        if { c.top_trailing } > r { r = { c.top_trailing }; }
        if { c.bottom_leading } > r { r = { c.bottom_leading }; }
        if { c.bottom_trailing } > r { r = { c.bottom_trailing }; }
        return { CGPathCreateWithRoundedRect(b, r, r, 0 as *u8) };
    }
    return { CGPathCreateWithRect(b, 0 as *u8) };
}

// ---- transform ----------------------------------------------------------------

fn transform_identity() -> quartz::Transform3D {
    return quartz::Transform3D {
        m11: 1.0f64, m12: 0.0f64, m13: 0.0f64, m14: 0.0f64,
        m21: 0.0f64, m22: 1.0f64, m23: 0.0f64, m24: 0.0f64,
        m31: 0.0f64, m32: 0.0f64, m33: 1.0f64, m34: 0.0f64,
        m41: 0.0f64, m42: 0.0f64, m43: 0.0f64, m44: 1.0f64,
    };
}

// A CALayer places its ANCHOR POINT at `position`, so moving the anchor moves
// the layer unless `position` moves with it.
//
// UIKit's default anchor is already (0.5, 0.5) — the centre, which is facet's
// default too — where an NSView's backing layer starts at (0,0). So the
// compensation below is usually a no-op on iOS, and it is here for the case
// that is not: an app that states a corner anchor. The AppKit backend needs it
// on the first transform of EVERY view.
fn set_anchor_keeping_place(l: quartz::Layer, ax: f64, ay: f64) {
    let old: rt::Point = l.anchor_point();
    if old.x == ax && old.y == ay { return; }
    let b: rt::Rect = l.bounds();
    let p: rt::Point = l.position();
    l.set_anchor_point(rt::Point { x: ax, y: ay });
    l.set_position(rt::Point {
        x: p.x + ((ax - old.x) * b.w),
        y: p.y + ((ay - old.y) * b.h),
    });
    return;
}

// The nine transform numbers become one CATransform3D on the layer. facet gives
// them one dirty bit for exactly this reason: the backend rebuilds the whole
// transform anyway, so nine bits would buy it nothing.
fn apply_transform(view: ui::View, n: *core::Node) {
    let l: quartz::Layer = view.layer();
    // Identity is decided from the property VALUES, not from a rebuilt matrix:
    // create passes all-ones dirty, so this path runs for every view, and
    // calling CATransform3D* just to discover identity would be waste.
    if transform_is_identity_of(n) {
        l.set_transform(transform_identity());
        return;
    }
    set_anchor_keeping_place(l, core::anchor_x(n), core::anchor_y(n));
    l.set_transform(transform_of(n));
    return;
}

fn transform_is_identity_of(n: *core::Node) -> bool {
    let rot: f64 = core::rotation(n);
    let rx: f64 = core::rotation_x(n);
    let ry: f64 = core::rotation_y(n);
    let sx: f64 = core::scale(n) * core::scale_x(n);
    let sy: f64 = core::scale(n) * core::scale_y(n);
    let tx: f64 = core::translation_x(n);
    let ty: f64 = core::translation_y(n);
    return rot == 0.0f64 && rx == 0.0f64 && ry == 0.0f64
        && sx == 1.0f64 && sy == 1.0f64 && tx == 0.0f64 && ty == 0.0f64;
}

fn transform_of(n: *core::Node) -> quartz::Transform3D {
    let rot: f64 = core::rotation(n);
    let rx: f64 = core::rotation_x(n);
    let ry: f64 = core::rotation_y(n);
    let sx: f64 = core::scale(n) * core::scale_x(n);
    let sy: f64 = core::scale(n) * core::scale_y(n);
    let tx: f64 = core::translation_x(n);
    let ty: f64 = core::translation_y(n);
    var m: quartz::Transform3D = transform_identity();
    m = { CATransform3DTranslate(m, tx, ty, 0.0f64) };
    if rot != 0.0f64 { m = { CATransform3DRotate(m, radians(rot), 0.0f64, 0.0f64, 1.0f64) }; }
    if rx != 0.0f64 { m = { CATransform3DRotate(m, radians(rx), 1.0f64, 0.0f64, 0.0f64) }; }
    if ry != 0.0f64 { m = { CATransform3DRotate(m, radians(ry), 0.0f64, 1.0f64, 0.0f64) }; }
    m = { CATransform3DScale(m, sx, sy, 1.0f64) };
    return m;
}

fn radians(degrees: f64) -> f64 { return degrees * 3.14159265358979323846f64 / 180.0f64; }

// ---- animate_* ----------------------------------------------------------------
// Duration and easing come from common; channels say which end values to drive.
// End values are already on the model, so a cancel can snap without a second
// write.
//
// ONE MECHANISM, where AppKit needs two. `+[UIView animateWithDuration:...]`
// animates the view's own animatable properties — `alpha` among them — and it
// takes a block, which is the awkward half. The transform goes through the same
// explicit CABasicAnimation the AppKit backend uses, because a view-backed
// layer has implicit actions disabled on both platforms.
//
// So both channels are driven by explicit layer animations here, and the
// UIView block API is deliberately NOT used: it would need a block per animate
// call, and the layer path is already written, already correct, and the same
// code on both platforms.

fn apply_animate(view: ui::View, n: *core::Node) {
    // Masked to the CHANNELS: the same word's high bits are the pending-snap
    // record the model warns from, and interpolate nothing.
    let channels: u32 = core::animate_channels_of(n)
        & (props::ANIM_OPACITY | props::ANIM_TRANSFORM);
    if channels == (0u32) { return; }
    let secs: f64 = core::animate_duration_of(n).seconds;
    if secs <= 0.0f64 {
        if (channels & props::ANIM_OPACITY) != (0u32) { view.set_alpha(core::opacity(n)); }
        if (channels & props::ANIM_TRANSFORM) != (0u32) { apply_transform(view, n); }
        core::clear_animate_channels(n);
        return;
    }
    let easing: vocab::Easing = core::animate_easing_of(n);
    let l: quartz::Layer = view.layer();
    if (channels & props::ANIM_OPACITY) != (0u32) {
        // The layer's `opacity` is the same number as the view's `alpha`, and
        // the model write has to land too — an animation alone is presentation
        // only, and it would snap back when it finishes.
        let from: f32 = { rt::msg_f32(l.raw(), rt::sel(#str_ptr("opacity\0"))) };
        view.set_alpha(core::opacity(n));
        animate_layer_f32(l, "opacity", from, core::opacity(n) as f32, secs, easing);
    }
    if (channels & props::ANIM_TRANSFORM) != (0u32) {
        set_anchor_keeping_place(l, core::anchor_x(n), core::anchor_y(n));
        let from: quartz::Transform3D = l.transform();
        let to: quartz::Transform3D = transform_of(n);
        l.set_transform(to);
        animate_layer_transform(l, from, to, secs, easing);
    }
    core::clear_animate_channels(n);
    return;
}

// A CABasicAnimation with BOTH ends stated. `fromValue` is not optional here:
// the model value has already been written to the layer, so an animation
// without a start would interpolate from the value it is already at.
fn animate_layer_transform(l: quartz::Layer, from: quartz::Transform3D,
                           to: quartz::Transform3D, secs: f64, easing: vocab::Easing) {
    let a: *u8 = basic_animation("transform", secs, easing);
    if a == (0 as *u8) { return; }
    { rt::msg_void_id(a, rt::sel(#str_ptr("setFromValue:\0")), transform_value(from)) };
    { rt::msg_void_id(a, rt::sel(#str_ptr("setToValue:\0")), transform_value(to)) };
    { rt::msg_void_id_id(l.raw(), rt::sel(#str_ptr("addAnimation:forKey:\0")), a,
                         bridge::nsstring("facet.transform")) };
    rt::release(a);
    return;
}

fn animate_layer_f32(l: quartz::Layer, key: str, from: f32, to: f32, secs: f64,
                     easing: vocab::Easing) {
    let a: *u8 = basic_animation(key, secs, easing);
    if a == (0 as *u8) { return; }
    { rt::msg_void_id(a, rt::sel(#str_ptr("setFromValue:\0")), number_f64(from as f64)) };
    { rt::msg_void_id(a, rt::sel(#str_ptr("setToValue:\0")), number_f64(to as f64)) };
    { rt::msg_void_id_id(l.raw(), rt::sel(#str_ptr("addAnimation:forKey:\0")), a,
                         bridge::nsstring("facet.opacity")) };
    rt::release(a);
    return;
}

fn basic_animation(key_path: str, secs: f64, easing: vocab::Easing) -> *u8 {
    let cls: *u8 = rt::get_class(#str_ptr("CABasicAnimation\0"));
    if cls == (0 as *u8) { return 0 as *u8; }
    let a: *u8 = { rt::msg_id_id(cls, rt::sel(#str_ptr("animationWithKeyPath:\0")),
                                 bridge::nsstring(key_path)) };
    if a == (0 as *u8) { return 0 as *u8; }
    let kept: *u8 = { rt::retain(a) };
    { rt::msg_void_f64(kept, rt::sel(#str_ptr("setDuration:\0")), secs) };
    let tf: *u8 = timing_function_of(easing);
    if tf != (0 as *u8) {
        { rt::msg_void_id(kept, rt::sel(#str_ptr("setTimingFunction:\0")), tf) };
    }
    // Hold the end state: the model already carries it, so a fill of anything
    // else would flash back for one frame before the next apply.
    { rt::msg_void_id(kept, rt::sel(#str_ptr("setFillMode:\0")), bridge::nsstring("forwards")) };
    return kept;
}

fn number_f64(v: f64) -> *u8 {
    return { rt::msg_id_f64(rt::get_class(#str_ptr("NSNumber\0")),
                            rt::sel(#str_ptr("numberWithDouble:\0")), v) };
}

fn transform_value(t: quartz::Transform3D) -> *u8 {
    return { msg_id_transform(rt::get_class(#str_ptr("NSValue\0")),
                              rt::sel(#str_ptr("valueWithCATransform3D:\0")), t) };
}

// Abort in-flight motion. The model end values stay; the caller snaps
// presentation to them.
fn cancel_view_animations(view: ui::View) {
    { rt::msg_void(view.layer().raw(), rt::sel(#str_ptr("removeAllAnimations\0"))) };
    return;
}

// facet's eleven presets onto CAMediaTimingFunction's four names. Bounce and
// Spring ride the nearest media function rather than being real curves — the
// same gap the AppKit backend has, and MANIFEST.md records it here too.
fn timing_function_of(e: vocab::Easing) -> *u8 {
    let name: str = match e {
        vocab::Easing::Linear => "linear",
        vocab::Easing::SinIn => "easeIn",
        vocab::Easing::SinOut => "easeOut",
        vocab::Easing::SinInOut => "easeInEaseOut",
        vocab::Easing::CubicIn => "easeIn",
        vocab::Easing::CubicOut => "easeOut",
        vocab::Easing::CubicInOut => "easeInEaseOut",
        vocab::Easing::BounceIn => "easeIn",
        vocab::Easing::BounceOut => "easeOut",
        vocab::Easing::SpringIn => "easeIn",
        vocab::Easing::SpringOut => "easeOut",
    };
    let cls: *u8 = rt::get_class(#str_ptr("CAMediaTimingFunction\0"));
    if cls == (0 as *u8) { return 0 as *u8; }
    return { rt::msg_id_id(cls, rt::sel(#str_ptr("functionWithName:\0")),
                           bridge::nsstring(name)) };
}

// ---- the runtime edges this file needs ---------------------------------------

fn set_layer_point(l: *u8, sel_name: *u8, x: f64, y: f64) {
    { msg_void_point(l, rt::sel(sel_name), rt::Point { x: x, y: y }) };
    return;
}

fn set_layer_size(l: *u8, sel_name: *u8, w: f64, h: f64) {
    { msg_void_size(l, rt::sel(sel_name), rt::Size { w: w, h: h }) };
    return;
}

extern fn sin(x: f64) -> f64;
extern fn cos(x: f64) -> f64;

fn sin_of(x: f64) -> f64 { return { sin(x) }; }
fn cos_of(x: f64) -> f64 { return { cos(x) }; }

#[link_name = "objc_msgSend"]
extern fn msg_void_rect(recv: *u8, sel: *u8, r: rt::Rect);
#[link_name = "objc_msgSend"]
extern fn msg_void_point(recv: *u8, sel: *u8, p: rt::Point);
#[link_name = "objc_msgSend"]
extern fn msg_void_size(recv: *u8, sel: *u8, s: rt::Size);
#[link_name = "objc_msgSend"]
extern fn msg_id_transform(recv: *u8, sel: *u8, t: quartz::Transform3D) -> *u8;

extern fn CGPathRelease(p: *u8);
extern fn CGPathCreateWithRect(r: rt::Rect, t: *u8) -> *u8;
extern fn CGPathCreateWithEllipseInRect(r: rt::Rect, t: *u8) -> *u8;
extern fn CGPathCreateWithRoundedRect(r: rt::Rect, cw: f64, ch: f64, t: *u8) -> *u8;
extern fn CATransform3DTranslate(m: quartz::Transform3D, tx: f64, ty: f64, tz: f64) -> quartz::Transform3D;
extern fn CATransform3DRotate(m: quartz::Transform3D, angle: f64, x: f64, y: f64, z: f64) -> quartz::Transform3D;
extern fn CATransform3DScale(m: quartz::Transform3D, sx: f64, sy: f64, sz: f64) -> quartz::Transform3D;
