// facet_uikit selftest — the checks that need UIKit, and therefore a device.
//
// WHY THIS IS NOT `#[test]`. `cpc test` builds a host binary, and macOS has no
// UIKit to link it against — so this package has never had a test executed.
// Everything about it was verified by hand: a screenshot, a probe, a console
// line. That is how five bugs in this backend reached a person before they
// reached a check, and one of them I mismeasured and declared fixed twice.
//
// So the checks live here as ordinary functions and `run_all` calls them. The
// runner is `examples/facet_uikit_tests`, which links this into an iOS binary
// and runs it under `simctl`:
//
//     vendor/facet_uikit/tools/run_ios_tests.sh
//
// It exits non-zero when anything fails, which is the whole point: it can say
// no without me reading it.
//
// EVERY CHECK HERE IS A BUG THAT HAPPENED. They are not a survey of the
// package — they are the specific things that broke, written down so they
// cannot break again quietly.

import "stdlib/option" as option;
import "stdlib/text" as text;
import "stdlib/io" as io;
import "stdlib/status" as status;
import "flex_layout/flex_layout" as flex;
import "facet/facet" as core;
import "facet/props" as props;
import "facet/mount" as mount;
import "facet/application" as app;
import "facet/tree" as tree;
import "facet/vocabulary" as vocab;
import "facet/elements" as ui;
import "objc/runtime" as rt;
import "uikit/uikit" as uik;
import "./paint" as paint;
import "./controls" as controls;
import "./views" as views;
import "./recycler" as recycler;
import "./input" as input;
import "./keys" as keys;
import "./window" as window;
import "./device" as device;
import "facet/screen" as screen;
import "facet/window_chrome" as chrome;
import "./dialogs" as dialogs;
import "./swipe" as swipe;
import "facet/services" as services;
import "facet/gestures" as gestures;
import "objc/bridge" as bridge;
import "objc/synthesis" as synth;
import "stdlib/box" as box;
import "stdlib/vec" as vec;
import "agent_uikit/agent_uikit" as agent;
import "agent_core/identity" as identity;
import "agent_core/auth" as auth;
import "agent_core/backend" as mcpb;
import "agent_core/surface" as surf;

static FAILED: i32 = 0 as i32;
static RAN: i32 = 0 as i32;

fn check(name: str, ok: bool) {
    RAN = RAN + (1 as i32);
    if ok {
        io::eprintln(text::from_str("  ok   ${name}"));
        return;
    }
    FAILED = FAILED + (1 as i32);
    io::eprintln(text::from_str("  FAIL ${name}"));
    return;
}

// ---- the clipping bug ----------------------------------------------------------
// The paint band wrote `masksToBounds = false` for every node without a corner
// radius, which is right for a plain UIView and wrong for a UIScrollView —
// whose default is true and whose whole purpose is to be a window onto
// something bigger. Every scroll, list and table in the package stopped
// clipping, and their content drew over whatever was above them.

fn scroll_view_keeps_its_clipping() -> bool {
    let s: uik::ScrollView = uik::ScrollView::new_with_frame(
        rt::Rect { x: 0.0f64, y: 0.0f64, w: 100.0f64, h: 100.0f64 });
    let v: uik::View = s.as_view();
    // What `apply_common` does to a node with no radius, no clip, no shadow.
    paint::apply_corner_radius(v, vocab::Corners::none(), false, false);
    return { rt::msg_i8(v.raw(), rt::sel(#str_ptr("clipsToBounds\0"))) } != (0 as i8);
}

fn a_plain_view_does_not_start_clipping() -> bool {
    let v: uik::View = uik::View::new_with_frame(
        rt::Rect { x: 0.0f64, y: 0.0f64, w: 100.0f64, h: 100.0f64 });
    paint::apply_corner_radius(v, vocab::Corners::none(), false, false);
    return { rt::msg_i8(v.raw(), rt::sel(#str_ptr("clipsToBounds\0"))) } == (0 as i8);
}

fn a_radius_clips_whatever_the_view_is() -> bool {
    let v: uik::View = uik::View::new_with_frame(
        rt::Rect { x: 0.0f64, y: 0.0f64, w: 100.0f64, h: 100.0f64 });
    paint::apply_corner_radius(v, vocab::Corners::all(8.0f64), false, false);
    return { rt::msg_i8(v.raw(), rt::sel(#str_ptr("clipsToBounds\0"))) } != (0 as i8);
}

// ---- the empty-row bug ----------------------------------------------------------
// `mount::realise` answers the root's VIEW, and 0 is the ordinary answer for a
// row built as `ui::row(...)` — an unkeyed pure-layout node has no view of its
// own. Reading that as failure put nothing in the cell, and every recycled row
// in the package rendered as an empty cell with a separator under it.

fn an_unkeyed_row_has_no_view_of_its_own() -> bool {
    var n: core::Node = ui::row(flex::Builder::new());
    return views::wants_view(#addr_of(n)) == false;
}

fn a_realised_viewless_root_still_has_backed_children() -> bool {
    var b: flex::Builder = flex::Builder::new();
    b.add(ui::label("x", font_size: 12.0f64));
    var row: core::Node = ui::row(b);
    let p: *core::Node = #addr_of(row);
    // The row itself is viewless; its LABEL is what carries a view, and
    // `add_backed` is the path that finds it. If this is false the cell would
    // be empty however the gate above it was written.
    if views::wants_view(p) { return false; }
    return core::child_count_of(p) == (1 as usize);
}

// ---- the tree bugs --------------------------------------------------------------
// Two null checks against defaults that are REAL FUNCTIONS: `row` defaults to
// `tree::no_row` and `row_id` to `tree::no_row_id`, so `f == 0` was never true.
// The first rendered a column of empty rows; the second made `expand` a no-op,
// because expansion was keyed on `row_id` rather than on the node's own id.

fn a_tree_default_row_is_no_row_not_null() -> bool {
    var root: tree::TreeNode = tree::TreeNode::new("", id: "root", is_branch: true);
    var t: core::Node = ui::tree(root, key: "t");
    let p: *tree::TreeProps = recycler::props_of(#addr_of(t), tree::K_TREE) as *tree::TreeProps;
    if p == (0 as *tree::TreeProps) { return false; }
    let f: fn(*tree::TreeNode, *u8) -> flex::Node = { (*p).row };
    // The point: NOT null, so a null check would have skipped the fallback.
    if f == (0 as fn(*tree::TreeNode, *u8) -> flex::Node) { return false; }
    return f == tree::no_row;
}

fn expansion_is_keyed_on_the_nodes_own_id() -> bool {
    var root: tree::TreeNode = tree::TreeNode::new("", id: "root", is_branch: true);
    var sec: tree::TreeNode = tree::TreeNode::new("Section", id: "sec", is_branch: true);
    let _c: status::Status = sec.add_child(tree::TreeNode::new("Leaf", id: "leaf"));
    let _r: status::Status = root.add_child(sec);
    var t: core::Node = ui::tree(root, key: "t2");
    match tree::find("t2", within: #addr_of(t)) {
        option::Option[tree::Tree]::Some(h) => {
            let _e: tree::Tree = h.expand("sec");
            return h.is_expanded("sec");
        }
        option::Option[tree::Tree]::None => { return false; }
    }
}

// ---- the handler bug ------------------------------------------------------------
// `fire_primary` routed `K_BUTTON` and nothing else, and compared its handler
// against null — but `props::no_handler` is a real function, so the fall
// through to the gesture band was unreachable too. A text button and an icon
// button were armed, tapped, and called nothing.

fn no_handler_is_a_real_function_not_null() -> bool {
    let h: fn(*u8, *u8) = props::no_handler;
    return h != (0 as fn(*u8, *u8));
}

// ---- the window leak ------------------------------------------------------------
// `mount::mount` opens a WINDOW, and the recycler called it for every cell —
// so each row became a window, and the entry dangled when the cell was
// recycled. `realise` is the same walk minus the window.

// A RECYCLED CELL GIVES BACK EVERY VIEW IT TOOK, and it used not to.
//
// `add_backed` walks past every viewless node and adds each backed descendant as
// a SEPARATE sibling subview of the cell's content view, so a row of two labels
// puts TWO views there with nothing above them to remove. `clear_cell` removed
// only `core::view_of(root)` — which a viewless row answers 0 for — so it removed
// nothing at all. The nodes were dropped and their views released, but a UIView
// is owned by its SUPERVIEW, so the labels stayed and the next fill added a fresh
// set on top of them. Photographed on an iPad as "Row 29" and "Row 19" drawn over
// each other in one cell, worse on every reuse.
//
// IT GOES THROUGH `clear_cell`, NOT THROUGH `remove_backed`. The first version of
// this check called the helper directly and PASSED against the unfixed backend,
// because the defect was never in the helper — it was in which branch the caller
// took. A check that cannot fail on the bug it names is worse than no check.
//
// So the setup mirrors `fill_cell` exactly: a boxed root, realised, added with
// `add_backed`, and the association `clear_cell` reads to find it again. The box
// matters — `clear_cell` takes ownership back with `box::from_raw`, and handing
// it a stack address would free something it does not own.
fn a_cleared_cell_gives_back_every_view_it_took() -> bool {
    var b: flex::Builder = flex::Builder::new();
    b.add(ui::label("one", key: "rb:one", font_size: 12.0f64));
    b.add(ui::label("two", key: "rb:two", font_size: 12.0f64));
    var row: core::Node = ui::row(b);
    // The whole bug lives in this shape. If the row were backed, the check would
    // pass while exercising the other branch.
    if views::wants_view(#addr_of(row)) { return false; }
    let host: uik::View = uik::View::new_with_frame(
        rt::Rect { x: 0.0f64, y: 0.0f64, w: 100.0f64, h: 40.0f64 });
    match box::new::[core::Node](row) {
        option::Option[box::Box[core::Node]]::Some(bx) => {
            let root: *core::Node = bx.into_raw() as *core::Node;
            let rv: *u8 = mount::realise(root);
            // 0 IS THE ORDINARY ANSWER for a viewless root, and the branch under
            // test. Anything else means the row shape changed.
            if rv != (0 as *u8) { return false; }
            recycler::add_backed(host, root);
            // Asserting the add as well as the remove: a teardown that silently
            // found nothing would pass a remove-only check.
            if subview_count(host.raw()) != (2 as u64) { return false; }
            // `host` stands in for the cell. `clear_cell` only needs an object it
            // can carry the association on, and `remove_from_superview` needs no
            // parent, so one view serves as both cell and content view here.
            synth::set_associated(host.raw(), recycler::cell_root_key(), root as *u8);
            recycler::clear_cell(host.raw());
            return subview_count(host.raw()) == (0 as u64);
        }
        option::Option[box::Box[core::Node]]::None => { return false; }
    }
}

fn subview_count(v: *u8) -> u64 {
    let subs: *u8 = { rt::msg_id(v, rt::sel(#str_ptr("subviews\0"))) };
    if subs == (0 as *u8) { return 0 as u64; }
    return { rt::msg_u64(subs, rt::sel(#str_ptr("count\0"))) };
}

fn realising_a_subtree_opens_no_window() -> bool {
    let before: usize = app::window_count();
    var b: flex::Builder = flex::Builder::new();
    b.add(ui::label("x", font_size: 12.0f64));
    var row: core::Node = ui::row(b);
    let _v: *u8 = mount::realise(#addr_of(row));
    let after: usize = app::window_count();
    mount::unrealise(#addr_of(row));
    return before == after;
}

// ---- the bands that were recorded as unfillable --------------------------------
// Two seams were left empty on the grounds that iOS's shape was different. It
// is, and different is not absent — the same error as "iOS has no hover".

fn the_sender_readers_are_installed() -> bool {
    // `key_of` walks accessibilityIdentifier up the superview chain — the SAME
    // code the AppKit backend runs, because both properties are UIView's too.
    let v: uik::View = uik::View::new_with_frame(
        rt::Rect { x: 0.0f64, y: 0.0f64, w: 10.0f64, h: 10.0f64 });
    { rt::msg_void_id(v.raw(), rt::sel(#str_ptr("setAccessibilityIdentifier:\0")),
                      bridge::nsstring("row:7")) };
    return { input::key_of(v.raw()).view() } == "row:7";
}

fn key_of_walks_up_to_a_tagged_ancestor() -> bool {
    let parent: uik::View = uik::View::new_with_frame(
        rt::Rect { x: 0.0f64, y: 0.0f64, w: 10.0f64, h: 10.0f64 });
    let child: uik::View = uik::View::new_with_frame(
        rt::Rect { x: 0.0f64, y: 0.0f64, w: 5.0f64, h: 5.0f64 });
    { rt::msg_void_id(parent.raw(), rt::sel(#str_ptr("setAccessibilityIdentifier:\0")),
                      bridge::nsstring("outer")) };
    parent.add_subview(child);
    // A tap on an untagged icon inside a tagged row answers the ROW.
    return { input::key_of(child.raw()).view() } == "outer";
}

fn raise_brings_a_keyed_sibling_to_the_front() -> bool {
    let host: uik::View = uik::View::new_with_frame(
        rt::Rect { x: 0.0f64, y: 0.0f64, w: 10.0f64, h: 10.0f64 });
    let a: uik::View = uik::View::new_with_frame(
        rt::Rect { x: 0.0f64, y: 0.0f64, w: 5.0f64, h: 5.0f64 });
    let b: uik::View = uik::View::new_with_frame(
        rt::Rect { x: 0.0f64, y: 0.0f64, w: 5.0f64, h: 5.0f64 });
    { rt::msg_void_id(a.raw(), rt::sel(#str_ptr("setAccessibilityIdentifier:\0")),
                      bridge::nsstring("first")) };
    host.add_subview(a);
    host.add_subview(b);
    // `a` is behind `b`; raising it must put it last, which IS the front.
    input::raise(host.raw(), "first");
    let subs: *u8 = { rt::msg_id(host.raw(), rt::sel(#str_ptr("subviews\0"))) };
    let last: *u8 = { rt::msg_id_u64(subs, rt::sel(#str_ptr("objectAtIndex:\0")), 1 as u64) };
    return last == a.raw();
}

// The key band's mapping, which is a table and therefore exactly the kind of
// thing that is wrong silently. USB HID usage codes, not ASCII.
fn named_keys_map_from_hid_codes() -> bool {
    if keys::named_of_code(40 as i64) != gestures::key_return() { return false; }
    if keys::named_of_code(41 as i64) != gestures::key_escape() { return false; }
    if keys::named_of_code(42 as i64) != gestures::key_delete() { return false; }
    if keys::named_of_code(43 as i64) != gestures::key_tab() { return false; }
    if keys::named_of_code(79 as i64) != gestures::key_arrow_right() { return false; }
    if keys::named_of_code(82 as i64) != gestures::key_arrow_up() { return false; }
    // A printable key has no NAME — it comes through key_chars / key_code.
    return keys::named_of_code(4 as i64) == gestures::key_none();
}

fn modifier_flags_map_onto_facets_bits() -> bool {
    // UIKeyModifierShift is 1<<17, which is NOT facet's 1.
    if keys::modifiers_of_flags((1 as u64) * (131072 as u64)) != gestures::mod_shift() {
        return false;
    }
    if keys::modifiers_of_flags((1 as u64) * (1048576 as u64)) != gestures::mod_command() {
        return false;
    }
    return keys::modifiers_of_flags(0 as u64) == (0 as u64);
}

// ---- the agent surface -----------------------------------------------------------
// The reader walks a live UIView tree into agent_core's identity registry. It
// runs here rather than in agent_uikit's own suite for the reason everything
// else does: the walk needs UIKit, and only an iOS binary has it.

fn the_agent_walk_finds_a_tagged_view() -> bool {
    let root: uik::View = uik::View::new_with_frame(
        rt::Rect { x: 0.0f64, y: 0.0f64, w: 100.0f64, h: 100.0f64 });
    let btn: uik::Button = uik::Button::button_with_type(uik::ButtonType::System);
    btn.set_title("Save", 0 as u64);
    { rt::msg_void_id(btn.as_view().raw(),
                      rt::sel(#str_ptr("setAccessibilityIdentifier:\0")),
                      bridge::nsstring("save")) };
    root.add_subview(btn.as_view());
    // `open` takes a WINDOW and walks its subviews, so the root stands in for
    // one: the walk is the same either way.
    let s: agent::Surface = agent::open(root.raw());
    let nodes: vec::Vec[mcpb::UiNode] = { s.describe(auth::operator()) };
    var found: bool = false;
    var i: usize = 0 as usize;
    while i < nodes.count() {
        match nodes.at_ptr(i) {
            option::Option[*mcpb::UiNode]::Some(n) => {
                if { (*n).id.view() } == "save" { found = true; }
            }
            option::Option[*mcpb::UiNode]::None => { }
        }
        i = i +% (1 as usize);
    }
    return found;
}

fn a_button_classifies_as_a_button() -> bool {
    let btn: uik::Button = uik::Button::button_with_type(uik::ButtonType::System);
    return identity::role_eq(agent::classify(btn.as_view().raw()),
                             identity::Role::Button);
}

fn a_label_classifies_as_text_and_a_field_as_input() -> bool {
    let l: uik::Label = uik::Label::new_with_frame(
        rt::Rect { x: 0.0f64, y: 0.0f64, w: 10.0f64, h: 10.0f64 });
    if !identity::role_eq(agent::classify(l.as_view().raw()), identity::Role::Text) {
        return false;
    }
    let f: uik::TextField = uik::TextField::new_with_frame(
        rt::Rect { x: 0.0f64, y: 0.0f64, w: 10.0f64, h: 10.0f64 });
    return identity::role_eq(agent::classify(f.as_view().raw()), identity::Role::Input);
}

// THE GATE, which is the one thing here that must never regress: a secure field
// is sensitive whatever it declared, because an app that forgot to mark a
// password field must not leak it because it forgot.
fn a_secure_field_is_sensitive_by_class() -> bool {
    let f: uik::TextField = uik::TextField::new_with_frame(
        rt::Rect { x: 0.0f64, y: 0.0f64, w: 10.0f64, h: 10.0f64 });
    { rt::msg_void_i8(f.as_view().raw(), rt::sel(#str_ptr("setSecureTextEntry:\0")),
                      1 as i8) };
    return agent::effective_policy(f.as_view().raw()) == identity::tier_protected();
}

fn a_control_is_clickable_and_a_bare_view_is_not() -> bool {
    let btn: uik::Button = uik::Button::button_with_type(uik::ButtonType::System);
    if !agent::view_clickable(btn.as_view().raw()) { return false; }
    let v: uik::View = uik::View::new_with_frame(
        rt::Rect { x: 0.0f64, y: 0.0f64, w: 10.0f64, h: 10.0f64 });
    return agent::view_clickable(v.raw()) == false;
}

// ---- the caret and the runs ---------------------------------------------------
// Both were unsupported an hour ago and both are BYTE-indexed, which is the
// half that can be silently wrong: UIKit counts UTF-16 and facet counts bytes,
// and every non-ASCII character before the caret moves the two apart.

fn a_caret_lands_where_bytes_say_on_ascii() -> bool {
    let f: uik::TextField = uik::TextField::new_with_frame(
        rt::Rect { x: 0.0f64, y: 0.0f64, w: 100.0f64, h: 30.0f64 });
    { rt::msg_void_id(f.as_view().raw(), rt::sel(#str_ptr("setText:\0")),
                      bridge::nsstring("hello")) };
    if !agent::place_caret(f.as_view().raw(), 2 as u64, 0 as u64) { return false; }
    let r: *u8 = { rt::msg_id(f.as_view().raw(),
                              rt::sel(#str_ptr("selectedTextRange\0"))) };
    if r == (0 as *u8) { return false; }
    let begin: *u8 = { rt::msg_id(f.as_view().raw(),
                                  rt::sel(#str_ptr("beginningOfDocument\0"))) };
    let start: *u8 = { rt::msg_id(r, rt::sel(#str_ptr("start\0"))) };
    let off: i64 = { msg_i64_2id(f.as_view().raw(),
                                 rt::sel(#str_ptr("offsetFromPosition:toPosition:\0")),
                                 begin, start) };
    return off == (2 as i64);
}

// THE CONVERSION, which is where a byte index and a UTF-16 index part company.
// "é" is two bytes and one UTF-16 unit, so byte 2 is unit 1 — an off-by-one
// here puts the caret inside a character.
fn byte_offsets_convert_to_utf16_units() -> bool {
    if agent::utf16_of_byte("héllo", 0 as u64) != (0 as u64) { return false; }
    if agent::utf16_of_byte("héllo", 1 as u64) != (1 as u64) { return false; }
    if agent::utf16_of_byte("héllo", 3 as u64) != (2 as u64) { return false; }
    // And back the other way, so the pair is consistent.
    return agent::byte_offset_of("héllo", 2 as u64) == (3 as u64);
}

fn runs_are_read_from_a_labels_attributed_text() -> bool {
    let l: uik::Label = uik::Label::new_with_frame(
        rt::Rect { x: 0.0f64, y: 0.0f64, w: 100.0f64, h: 30.0f64 });
    let a: *u8 = { rt::msg_id_id(
        { rt::msg_id(rt::get_class(#str_ptr("NSAttributedString\0")),
                     rt::sel(#str_ptr("alloc\0"))) },
        rt::sel(#str_ptr("initWithString:\0")), bridge::nsstring("abc")) };
    if a == (0 as *u8) { return false; }
    { rt::msg_void_id(l.as_view().raw(), rt::sel(#str_ptr("setAttributedText:\0")), a) };
    let runs: vec::Vec[surf::TextRun] = agent::walk_runs(agent::attributed_of(l.as_view().raw()));
    { rt::release(a) };
    // One uniform run over three ASCII bytes.
    if runs.count() != (1 as usize) { return false; }
    return match runs.at_ptr(0 as usize) {
        option::Option[*surf::TextRun]::Some(r) => ({ (*r).length } == (3 as u64)),
        option::Option[*surf::TextRun]::None => false,
    };
}

// ---- the lifecycle band -----------------------------------------------------------
// Pure registry logic, so it runs with no app: register, fire, check it ran;
// cancel, fire again, check it did not. The five phases are separate lists in
// one vector and a fire must not cross them.

static FIRED: i32 = 0 as i32;
fn count_fire(ctx: *u8) { FIRED = FIRED + (1 as i32); return; }

fn a_lifecycle_observer_fires_for_its_own_phase() -> bool {
    FIRED = 0 as i32;
    var h: services::Cancellable = window::observe_lifecycle(
        window::PHASE_BACKGROUND, count_fire, 0 as *u8);
    window::fire_phase(window::PHASE_BACKGROUND);
    let after_own: i32 = FIRED;
    // A DIFFERENT phase must not reach it: five edges in one vector, and a
    // fire that crossed them would tell an app it was backgrounded when it
    // was merely resigning active.
    window::fire_phase(window::PHASE_ACTIVE);
    let after_other: i32 = FIRED;
    h.cancel();
    return after_own == (1 as i32) && after_other == (1 as i32);
}

fn a_cancelled_lifecycle_observer_stops_firing() -> bool {
    FIRED = 0 as i32;
    var h: services::Cancellable = window::observe_lifecycle(
        window::PHASE_TERMINATE, count_fire, 0 as *u8);
    window::fire_phase(window::PHASE_TERMINATE);
    h.cancel();
    window::fire_phase(window::PHASE_TERMINATE);
    return FIRED == (1 as i32);
}

// ---- the dialog tier ---------------------------------------------------------------
// The controller is real; only the PRESENTATION needs a window, so everything
// up to it is checkable here.

fn an_alert_carries_one_button_per_named_title() -> bool {
    let a: *u8 = dialogs::build("Title", "Message", false, "");
    if a == (0 as *u8) { return false; }
    dialogs::add_button(a, "OK", 0 as i32, false);
    dialogs::add_button(a, "Cancel", 1 as i32, true);
    let acts: *u8 = { rt::msg_id(a, rt::sel(#str_ptr("actions\0"))) };
    let n: u64 = { rt::msg_u64(acts, rt::sel(#str_ptr("count\0"))) };
    { rt::release(a) };
    return n == (2 as u64);
}

fn a_prompt_gets_exactly_one_text_field() -> bool {
    let a: *u8 = dialogs::build("T", "M", true, "type here");
    if a == (0 as *u8) { return false; }
    let fields: *u8 = { rt::msg_id(a, rt::sel(#str_ptr("textFields\0"))) };
    var n: u64 = 0 as u64;
    if fields != (0 as *u8) { n = { rt::msg_u64(fields, rt::sel(#str_ptr("count\0"))) }; }
    { rt::release(a) };
    return n == (1 as u64);
}

// An alert with no window to present on must clean up rather than leave the
// pending answer armed forever — the next question would inherit it.
fn a_dialog_with_nowhere_to_present_leaves_no_pending_answer() -> bool {
    dialogs::alert("T", "M", "OK", "", answer_noop, 0 as *u8);
    return dialogs::is_showing() == false;
}

fn answer_noop(index: i32, ctx: *u8) { return; }

// ---- the navigation stack ----------------------------------------------------------

fn the_stack_starts_empty_and_refuses_without_a_window() -> bool {
    if window::pushed_count() != (0 as usize) { return false; }
    // No window means no navigation controller, and a push must SAY so rather
    // than half-succeed.
    var n: core::Node = ui::column(flex::Builder::new());
    if window::push_screen(#addr_of(n), "Screen", 0 as *u8) { return false; }
    return window::pop_screen() == false;
}

// ---- a swipe's offset survives the run loop ----------------------------------
// THE CRASH ON A REAL IPAD. The offset was stored as an autoreleased NSNumber
// through an association that does not retain, so a drag wrote it on every
// Changed event and the read on Ended — one run-loop turn later — reached freed
// memory. It crashed on RELEASE, every time, and never during the drag.
//
// The value round-trips through the pointer now, which allocates nothing and
// cannot dangle. This checks the round trip, including the negative offsets a
// leftward swipe actually produces.

fn a_swipe_offset_round_trips_through_the_association() -> bool {
    let v: uik::View = uik::View::new_with_frame(
        rt::Rect { x: 0.0f64, y: 0.0f64, w: 100.0f64, h: 50.0f64 });
    let raw: *u8 = v.raw();
    if swipe::offset_of(raw) != 0.0f64 { return false; }
    swipe::set_offset(raw, 0.0f64 - 88.5f64);
    if swipe::offset_of(raw) != (0.0f64 - 88.5f64) { return false; }
    swipe::set_offset(raw, 0.0f64);
    return swipe::offset_of(raw) == 0.0f64;
}

// ---- the invisible-label report --------------------------------------------------
// Filed 2026-08-17: "every facet iOS app is textless in dark mode", on the
// reading that a CODE-created UILabel keeps an opaque-black `textColor` default
// while the root view takes the adaptive `systemBackgroundColor` — black on
// black. It does not reproduce: three apps (a probe with no theme, the same
// probe with the gallery's theme, and the gallery itself) render every label
// white on the dark appearance.
//
// The premise is what was wrong. `textColor` defaults to the ADAPTIVE label
// colour, so there is nothing to fix — and that is also why the reported fix
// ("set it to `labelColor`") changed nothing on screen: it assigned the colour
// the label already had. A null result that looked like "the patch never
// reached the binary" was really "the patch was a no-op".
//
// It is checked rather than argued because the failure it guards against is
// invisible to every other check in this file: a label with the right text, the
// right frame and the right font, that a user cannot see. And the repair that
// would BREAK it — "just set a text colour in `create_label`" — is the obvious
// thing for the next reader to do.

fn label_color_components(c: uik::Color, style: uik::UserInterfaceStyle) -> f64 {
    let tc: uik::TraitCollection =
        uik::TraitCollection::trait_collection_with_user_interface_style(style);
    let r: uik::Color = c.resolved_color_with_trait_collection(tc);
    var red: f64 = 0.0f64;
    var green: f64 = 0.0f64;
    var blue: f64 = 0.0f64;
    var alpha: f64 = 0.0f64;
    let ok: bool = r.get_red(#addr_of(red) as *u8, #addr_of(green) as *u8,
                             #addr_of(blue) as *u8, #addr_of(alpha) as *u8);
    if !ok { return 0.0f64 - 1.0f64; }
    // Unweighted mean is enough: the question is "light or dark", not which
    // shade, and a weighted luma would only make the number harder to read.
    return (red + green + blue) / 3.0f64;
}

// A label built the way `create_label` builds one must be LIGHT on the dark
// appearance. Asserted through the real function, not a hand-made UILabel, so a
// `setTextColor:` added there is what fails this.
fn a_created_label_is_readable_on_the_dark_appearance() -> bool {
    var n: core::Node = ui::label("x", key: "probe");
    let v: *u8 = controls::create_label(#addr_of(n));
    if v == (0 as *u8) { return false; }
    let l: uik::Label = uik::Label::from_raw(v);
    let dark: f64 = label_color_components(l.text_color(), uik::UserInterfaceStyle::Dark);
    // 0.5 is the midpoint between black and white; the adaptive label colour
    // resolves to ~1.0 in dark and ~0.0 in light, so nothing sits near it.
    return dark > 0.5f64;
}

// And DARK on the light one — the same bug with the appearances swapped, which
// a hard-coded white `textColor` would produce.
fn a_created_label_is_readable_on_the_light_appearance() -> bool {
    var n: core::Node = ui::label("x", key: "probe");
    let v: *u8 = controls::create_label(#addr_of(n));
    if v == (0 as *u8) { return false; }
    let l: uik::Label = uik::Label::from_raw(v);
    let light: f64 = label_color_components(l.text_color(), uik::UserInterfaceStyle::Light);
    return light >= 0.0f64 && light < 0.5f64;
}

// The property this rests on, stated once: the label colour ADAPTS. If a future
// iOS shipped a non-adaptive default, the two checks above would still pass in
// whichever appearance happened to match, and this is the one that would not.
fn the_default_label_colour_adapts_to_the_appearance() -> bool {
    var n: core::Node = ui::label("x", key: "probe");
    let v: *u8 = controls::create_label(#addr_of(n));
    if v == (0 as *u8) { return false; }
    let l: uik::Label = uik::Label::from_raw(v);
    let c: uik::Color = l.text_color();
    let dark: f64 = label_color_components(c, uik::UserInterfaceStyle::Dark);
    let light: f64 = label_color_components(c, uik::UserInterfaceStyle::Light);
    if dark < 0.0f64 || light < 0.0f64 { return false; }
    let gap: f64 = if dark > light { dark - light } else { light - dark };
    return gap > 0.5f64;
}

// ---- the device tier --------------------------------------------------------------
//
// EVERY IOS RUN OF THIS PROJECT BEFORE 2026-08-18 WAS A PHONE-WIDTH RUN. Neither
// Info.plist in the tree declared `UIDeviceFamily`, so iOS read both bundles as
// iPhone-only and ran them on an iPad in compatibility mode: a phone canvas
// scaled up, and `userInterfaceIdiom` answering Phone on iPad hardware. It
// presented as "the text is too big" and it silently invalidated every earlier
// measurement — including this suite's, which is why the runner's plist now
// declares the family and why these checks exist at all.
//
// They are cheap and they are the only automated thing that can tell an iPad run
// from a phone run.

fn the_idiom_is_a_real_read() -> bool {
    return match device::idiom() {
        uik::UserInterfaceIdiom::Unspecified => false,
        uik::UserInterfaceIdiom::Phone => true,
        uik::UserInterfaceIdiom::Pad => true,
        uik::UserInterfaceIdiom::TV => true,
        uik::UserInterfaceIdiom::CarPlay => true,
        uik::UserInterfaceIdiom::Mac => true,
        uik::UserInterfaceIdiom::Vision => true,
    };
}

// The cache does not leak its own sentinel. `idiom_raw` parks -2 for "not read
// yet", and a second call that answered -2 — or anything other than the first
// answer — would mean the sentinel escaped into a real read.
fn the_idiom_is_stable_across_reads() -> bool {
    let a: i64 = device::idiom_raw();
    let b: i64 = device::idiom_raw();
    if a != b { return false; }
    return a >= (-1 as i64);
}

// TWO INDEPENDENT APIS, ASKED THE SAME QUESTION. `UIDevice` and the process's
// current `UITraitCollection` both carry `userInterfaceIdiom`, and they are
// separate paths to the same fact — so a disagreement means the read or the
// cache is wrong, and neither would show up any other way.
fn the_idiom_agrees_with_the_trait_collection() -> bool {
    let cls: *u8 = rt::get_class(#str_ptr("UITraitCollection\0"));
    if cls == (0 as *u8) { return false; }
    let tc: *u8 = { rt::msg_id(cls, rt::sel(#str_ptr("currentTraitCollection\0"))) };
    if tc == (0 as *u8) { return false; }
    let from_traits: i64 = { rt::msg_i64(tc, rt::sel(#str_ptr("userInterfaceIdiom\0"))) };
    return from_traits == device::idiom_raw();
}

// The three predicates name three different machines and cannot both be true.
fn the_idiom_predicates_are_exclusive() -> bool {
    var n: i32 = 0 as i32;
    if device::is_phone() { n = n + (1 as i32); }
    if device::is_pad() { n = n + (1 as i32); }
    if device::is_mac() { n = n + (1 as i32); }
    return n <= (1 as i32);
}

// PURE POLICY, pinned. The split is the whole point of the tier: a machine whose
// screen IS the window has nothing to negotiate, and one that hands the app a
// window beside other apps' windows does.
fn windowing_expectation_splits_the_idioms() -> bool {
    if device::idiom_expects_windowing(uik::UserInterfaceIdiom::Phone) { return false; }
    if device::idiom_expects_windowing(uik::UserInterfaceIdiom::TV) { return false; }
    if device::idiom_expects_windowing(uik::UserInterfaceIdiom::CarPlay) { return false; }
    // Unspecified takes the conservative side: behaving as though the screen is
    // the window is the answer that cannot overlap anything.
    if device::idiom_expects_windowing(uik::UserInterfaceIdiom::Unspecified) { return false; }
    if !device::idiom_expects_windowing(uik::UserInterfaceIdiom::Pad) { return false; }
    if !device::idiom_expects_windowing(uik::UserInterfaceIdiom::Mac) { return false; }
    return device::idiom_expects_windowing(uik::UserInterfaceIdiom::Vision);
}

// A capability question with no scene to ask answers NO, and answers it without
// dereferencing anything. This is the phone path: `windowScene` is null there
// for every window this package builds, and it is also the path taken by every
// window before its scene connects.
fn a_null_scene_supports_nothing() -> bool {
    if device::scene_supports_resizing(0 as *u8) { return false; }
    if device::scene_supports_behaviors(0 as *u8) { return false; }
    if device::size_restrictions_of(0 as *u8) != (0 as *u8) { return false; }
    if device::windowing_behaviors_of(0 as *u8) != (0 as *u8) { return false; }
    return device::scene_of_window(0 as *u8) == (0 as *u8);
}

// ---- the windowing control style --------------------------------------------------
//
// facet's `Bar` decides the style, and this pins the mapping. It is pinned
// because it was WRONG first: the original went by the three header sentences —
// `Native` sounds like `automatic`, `Blended`'s wording is nearly `unified`'s —
// and photographed on an iPad it put the system's close/minimise/zoom pill on
// top of the app's own title. Only `minimal` moves the controls out of the safe
// area; the other two draw them over the app's top-left corner and tell it
// nothing. WINDOWING.md §9.
//
// So: `unified` ONLY where the app draws a bar with room in it, `minimal`
// everywhere else, and nothing maps to `automatic` — that is what UIKit uses
// when the method is not implemented at all.

fn the_bar_decides_the_control_style() -> bool {
    let native: window::ControlStyle = window::control_style_for(screen::Bar::Native);
    let blended: window::ControlStyle = window::control_style_for(screen::Bar::Blended);
    let hidden: window::ControlStyle = window::control_style_for(screen::Bar::Hidden);
    let custom: window::ControlStyle = window::control_style_for(screen::Bar::Custom);
    if !is_style(native, window::ControlStyle::Minimal) { return false; }
    if !is_style(hidden, window::ControlStyle::Minimal) { return false; }
    if !is_style(blended, window::ControlStyle::Unified) { return false; }
    return is_style(custom, window::ControlStyle::Unified);
}

// NO BAR VALUE ASKS FOR `automatic`, and that is load-bearing rather than
// incidental: `automatic` is what UIKit uses when the delegate does not
// implement the method, so choosing it would be a long way to say nothing —
// and it measured identical to `unified`, which is the overlapping one.
fn no_bar_asks_for_the_do_nothing_style() -> bool {
    if is_style(window::control_style_for(screen::Bar::Native),
                window::ControlStyle::Automatic) { return false; }
    if is_style(window::control_style_for(screen::Bar::Blended),
                window::ControlStyle::Automatic) { return false; }
    if is_style(window::control_style_for(screen::Bar::Hidden),
                window::ControlStyle::Automatic) { return false; }
    return is_style(window::control_style_for(screen::Bar::Custom),
                    window::ControlStyle::Automatic) == false;
}

fn style_index(s: window::ControlStyle) -> i32 {
    return match s {
        window::ControlStyle::Automatic => 0 as i32,
        window::ControlStyle::Unified => 1 as i32,
        window::ControlStyle::Minimal => 2 as i32,
    };
}

fn is_style(a: window::ControlStyle, b: window::ControlStyle) -> bool {
    return style_index(a) == style_index(b);
}

// ---- the window-buttons reservation ----------------------------------------------
//
// `window_buttons` was classified `decided_absent` on this backend — "an iOS
// window is the screen: there is nothing to close it into". iPadOS 26 gave a
// windowed app a real close/minimise/zoom pill, photographed at x 19.5-60pt,
// y 20.5-40pt from the window's corner, so the kind left both ledgers and now
// holds that corner open for an application's own bar.
//
// THE ZEROES ARE THE IMPORTANT PART. A phone has no window controls, and a 60pt
// hole in every toolbar to serve the iPad would make the common platform worse
// — so these checks are mostly about what is NOT reserved. They matter here
// rather than only in views.cplus's `#[test]` blocks because `cpc test` cannot
// link UIKit on macOS: those compile, and only this runs.

fn a_platform_without_windowing_reserves_nothing() -> bool {
    let u: window::Reservation =
        window::window_buttons_reservation(window::ControlStyle::Unified, false);
    if u.width != 0.0f64 || u.height != 0.0f64 { return false; }
    let m: window::Reservation =
        window::window_buttons_reservation(window::ControlStyle::Minimal, false);
    return m.width == 0.0f64 && m.height == 0.0f64;
}

// Only `unified` puts the controls into the app's own content. Under `minimal`
// they sit ABOVE the safe area — measured, WINDOWING.md §4 — so the app is
// already clear of them and reserving would open the same gap twice.
fn only_the_unified_style_reserves_the_corner() -> bool {
    let u: window::Reservation =
        window::window_buttons_reservation(window::ControlStyle::Unified, true);
    if !(u.width > 0.0f64) || !(u.height > 0.0f64) { return false; }
    let m: window::Reservation =
        window::window_buttons_reservation(window::ControlStyle::Minimal, true);
    if m.width != 0.0f64 || m.height != 0.0f64 { return false; }
    let a: window::Reservation =
        window::window_buttons_reservation(window::ControlStyle::Automatic, true);
    return a.width == 0.0f64 && a.height == 0.0f64;
}

// The live reservation, asked of the running process. In this runner there is no
// scene and no window at all, so the honest answer is zero — the same answer a
// phone gives, and the path every app takes before its scene connects.
fn the_live_reservation_is_zero_without_a_scene() -> bool {
    let r: window::Reservation = window::window_buttons_reservation_now();
    return r.width == 0.0f64 && r.height == 0.0f64;
}

// A FULL SCREEN WINDOW IS NOT WINDOWED, which is the check that stops a
// full-screen iPad drawing 60pt of empty toolbar. The first version of the
// reservation reserved on "the platform can window" alone and did exactly that.
fn a_full_screen_window_is_not_windowed() -> bool {
    // Exactly the screen: full screen.
    if window::is_windowed_size(1194.0f64, 834.0f64, 1194.0f64, 834.0f64) { return false; }
    // Off by less than a point is still full screen — these are floats, and a
    // rounding difference in the last bit is not a user placing a window.
    if window::is_windowed_size(1193.5f64, 834.0f64, 1194.0f64, 834.0f64) { return false; }
    // The real windowed reading from the iPad.
    if !window::is_windowed_size(400.0f64, 505.0f64, 1194.0f64, 834.0f64) { return false; }
    // Narrower but full height, and shorter but full width, both count.
    if !window::is_windowed_size(600.0f64, 834.0f64, 1194.0f64, 834.0f64) { return false; }
    return window::is_windowed_size(1194.0f64, 500.0f64, 1194.0f64, 834.0f64);
}

// Nonsense in, zero out — a window or screen that has not been sized yet must
// not read as windowed, because at launch both are briefly zero.
fn an_unsized_window_is_not_windowed() -> bool {
    if window::is_windowed_size(0.0f64, 0.0f64, 1194.0f64, 834.0f64) { return false; }
    return window::is_windowed_size(400.0f64, 505.0f64, 0.0f64, 0.0f64) == false;
}

// The kind is answered rather than parked: in NEITHER ledger, and with a body.
fn window_buttons_left_both_ledgers() -> bool {
    if controls::decided_absent(chrome::K_WINDOW_BUTTONS) { return false; }
    if controls::not_yet_built(chrome::K_WINDOW_BUTTONS) { return false; }
    return views::has_body(chrome::K_WINDOW_BUTTONS);
}

// ---- the appearance flip ---------------------------------------------------------
//
// UIKit has no application-level "the appearance changed" hook — a dark-mode
// flip arrives as a TRAIT CHANGE on views — so the signal is taken by an
// invisible sentinel subview, the same shape facet_appkit uses for
// `viewDidChangeEffectiveAppearance`.
//
// THE GAP THIS CLOSED was invisible for a specific reason: UIKit's semantic
// colours are dynamic objects that re-resolve themselves, so a screen painted
// from facet's semantic roles followed a flip with no help and looked fine. What
// did not follow was anything facet FLATTENED — an `adaptive` literal pair, and
// anything that reached a CGColor. Photographed: a row of
// `adaptive(light: red, dark: blue)` stayed RED through a flip to dark while the
// semantic row beside it went black on its own.
//
// The flip itself needs a real trait change and cannot run here. What CAN be
// checked is that the class exists and answers the selector — which is the part
// that fails silently, because a misspelled selector on a synthesized class
// compiles, links, runs and never fires.

fn the_appearance_sentinel_class_exists() -> bool {
    return window::appearance_sentinel_class() != (0 as *u8);
}

fn the_appearance_sentinel_answers_the_trait_hook() -> bool {
    let cls: *u8 = window::appearance_sentinel_class();
    if cls == (0 as *u8) { return false; }
    // `instancesRespondToSelector:` — the METHOD is on instances, so asking the
    // class object whether IT responds would answer no and prove nothing.
    let sel: *u8 = rt::sel(#str_ptr("traitCollectionDidChange:\0"));
    return { rt::msg_i8_id(cls, rt::sel(#str_ptr("instancesRespondToSelector:\0")), sel) }
        != (0 as i8);
}

// A synthesized class must still BE a UIView, or adding it to the content view
// would be an ObjC exception rather than a listener.
fn the_appearance_sentinel_is_a_view() -> bool {
    let cls: *u8 = window::appearance_sentinel_class();
    if cls == (0 as *u8) { return false; }
    let view_cls: *u8 = rt::get_class(#str_ptr("UIView\0"));
    if view_cls == (0 as *u8) { return false; }
    return { rt::msg_i8_id(cls, rt::sel(#str_ptr("isSubclassOfClass:\0")), view_cls) }
        != (0 as i8);
}

// THE SELECTORS ARE REAL ONES. A misspelled class-property name is the classic
// ObjC failure that compiles, links, runs and does nothing — and this one would
// do nothing visible until someone put a window into the windowed state on an
// iPad, which is the hardest state in this package to reach. Asking the class
// whether it responds costs nothing and closes that gap.
//
// Skipped where the class is absent: these are iOS 26 properties, and a run on
// an older simulator should not fail for not having them.
fn the_control_style_selectors_resolve() -> bool {
    if !device::windowing_controls_available() { return true; }
    let cls: *u8 = rt::get_class(#str_ptr("UISceneWindowingControlStyle\0"));
    if cls == (0 as *u8) { return false; }
    if !class_responds(cls, window::control_style_selector(window::ControlStyle::Automatic)) {
        return false;
    }
    if !class_responds(cls, window::control_style_selector(window::ControlStyle::Unified)) {
        return false;
    }
    return class_responds(cls, window::control_style_selector(window::ControlStyle::Minimal));
}

fn class_responds(cls: *u8, selector: *u8) -> bool {
    return { rt::msg_i8_id(cls, rt::sel(#str_ptr("respondsToSelector:\0")), selector) } != (0 as i8);
}

// ---- the run --------------------------------------------------------------------

fn run_all() -> i32 {
    FAILED = 0 as i32;
    RAN = 0 as i32;
    io::eprintln(text::from_str("facet_uikit selftest"));

    check("a created label is readable on the dark appearance",
          a_created_label_is_readable_on_the_dark_appearance());
    check("a created label is readable on the light appearance",
          a_created_label_is_readable_on_the_light_appearance());
    check("the default label colour adapts to the appearance",
          the_default_label_colour_adapts_to_the_appearance());
    check("a scroll view keeps its clipping", scroll_view_keeps_its_clipping());
    check("a plain view does not start clipping", a_plain_view_does_not_start_clipping());
    check("a radius clips whatever the view is", a_radius_clips_whatever_the_view_is());
    check("an unkeyed row has no view of its own", an_unkeyed_row_has_no_view_of_its_own());
    check("a cleared cell gives back every view it took",
          a_cleared_cell_gives_back_every_view_it_took());
    check("a viewless root still has backed children",
          a_realised_viewless_root_still_has_backed_children());
    check("a tree's default row is no_row, not null", a_tree_default_row_is_no_row_not_null());
    check("expansion is keyed on the node's own id", expansion_is_keyed_on_the_nodes_own_id());
    check("no_handler is a real function, not null", no_handler_is_a_real_function_not_null());
    check("realising a subtree opens no window", realising_a_subtree_opens_no_window());
    check("the sender readers are installed", the_sender_readers_are_installed());
    check("key_of walks up to a tagged ancestor", key_of_walks_up_to_a_tagged_ancestor());
    check("raise brings a keyed sibling to the front",
          raise_brings_a_keyed_sibling_to_the_front());
    check("named keys map from HID codes", named_keys_map_from_hid_codes());
    check("modifier flags map onto facet's bits", modifier_flags_map_onto_facets_bits());
    check("the agent walk finds a tagged view", the_agent_walk_finds_a_tagged_view());
    check("a button classifies as a button", a_button_classifies_as_a_button());
    check("a label is Text and a field is Input", a_label_classifies_as_text_and_a_field_as_input());
    check("a secure field is sensitive by class", a_secure_field_is_sensitive_by_class());
    check("a control is clickable, a bare view is not",
          a_control_is_clickable_and_a_bare_view_is_not());
    check("a lifecycle observer fires for its own phase",
          a_lifecycle_observer_fires_for_its_own_phase());
    check("a cancelled lifecycle observer stops firing",
          a_cancelled_lifecycle_observer_stops_firing());
    check("an alert carries one button per named title",
          an_alert_carries_one_button_per_named_title());
    check("a prompt gets exactly one text field", a_prompt_gets_exactly_one_text_field());
    check("a dialog with nowhere to present leaves no pending answer",
          a_dialog_with_nowhere_to_present_leaves_no_pending_answer());
    check("the stack starts empty and refuses without a window",
          the_stack_starts_empty_and_refuses_without_a_window());
    check("a caret lands where bytes say on ascii", a_caret_lands_where_bytes_say_on_ascii());
    check("byte offsets convert to utf16 units", byte_offsets_convert_to_utf16_units());
    check("runs are read from a label's attributed text",
          runs_are_read_from_a_labels_attributed_text());
    check("a swipe offset round-trips through the association",
          a_swipe_offset_round_trips_through_the_association());

    // PRINTED, not asserted. The suite cannot know which simulator it was
    // pointed at, so it says what it found and lets the reader see whether the
    // run was a phone run or an iPad run — the distinction that was invisible
    // for as long as neither plist declared a device family.
    let who: str = device::idiom_name(device::idiom());
    io::eprintln(text::from_str("  --   running as: ${who}"));
    check("the idiom is a real read", the_idiom_is_a_real_read());
    check("the idiom is stable across reads", the_idiom_is_stable_across_reads());
    check("the idiom agrees with the trait collection",
          the_idiom_agrees_with_the_trait_collection());
    check("phone, pad and mac are mutually exclusive",
          the_idiom_predicates_are_exclusive());
    check("windowing expectation splits the idioms",
          windowing_expectation_splits_the_idioms());
    check("a null scene supports nothing", a_null_scene_supports_nothing());
    check("the bar decides the control style", the_bar_decides_the_control_style());
    check("no bar asks for the do-nothing style", no_bar_asks_for_the_do_nothing_style());
    check("the control style selectors resolve", the_control_style_selectors_resolve());
    check("a platform without windowing reserves nothing",
          a_platform_without_windowing_reserves_nothing());
    check("only the unified style reserves the corner",
          only_the_unified_style_reserves_the_corner());
    check("the live reservation is zero without a scene",
          the_live_reservation_is_zero_without_a_scene());
    check("window_buttons left both ledgers", window_buttons_left_both_ledgers());
    check("a full screen window is not windowed", a_full_screen_window_is_not_windowed());
    check("an unsized window is not windowed", an_unsized_window_is_not_windowed());
    check("the appearance sentinel class exists", the_appearance_sentinel_class_exists());
    check("the appearance sentinel answers the trait hook",
          the_appearance_sentinel_answers_the_trait_hook());
    check("the appearance sentinel is a view", the_appearance_sentinel_is_a_view());

    let ran: i32 = RAN;
    let failed: i32 = FAILED;
    let passed: i32 = ran - failed;
    io::eprintln(text::from_str("selftest result: ${passed} passed; ${failed} failed"));
    return FAILED;
}

#[link_name = "objc_msgSend"]
extern fn msg_i64_2id(recv: *u8, sel: *u8, a: *u8, b: *u8) -> i64;
