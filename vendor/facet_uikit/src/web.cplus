// facet_uikit web — WKWebView, which is the SAME class on both platforms.
//
// That is the whole reason this file is short: `webkit` is one framework, so
// nothing here is a UIKit translation of an AppKit idea. What differs is only
// what a WKWebView is embedded IN, and facet already owns that.
//
// ---- the two halves ----------------------------------------------------------
//
// The PROPERTIES are ordinary: a source, a user agent. The rest of facet's web
// surface is COMMANDS — go back, go forward, reload, eval — which are verbs the
// backend performs and clears, exactly like `focus` and `blur` on the shared
// band. A command bit that is re-read as state would re-navigate on every
// unrelated write.
//
// The other half is the NAVIGATION DELEGATE, which is what makes `on_navigating`
// and `on_navigated` real, and what keeps `can_go_back` / `can_go_forward` true
// in facet's props rather than only in WebKit's. One synthesized class for the
// process, the node found from the view — the same shape input.cplus uses.

import "stdlib/option" as option;
import "stdlib/text" as text;
import "facet/facet" as core;
import "facet/props" as props;
import "facet/web" as web;
import "facet/hybrid_web" as hybrid_web;
import "stdlib/status" as status;
import "stdlib/fs" as fs;
import "stdlib/result" as result;
import "stdlib/vec" as vec;
import "objc/runtime" as rt;
import "objc/bridge" as bridge;
import "objc/synthesis" as synth;
import "uikit/uikit" as ui;
import "webkit/webkit" as wk;
import "./input" as input;

fn create_web(n: *core::Node) -> *u8 {
    let cfg: *u8 = { rt::alloc_init(#str_ptr("WKWebViewConfiguration\0")) };
    let cls: *u8 = rt::get_class(#str_ptr("WKWebView\0"));
    if cls == (0 as *u8) { return 0 as *u8; }
    let alloced: *u8 = { rt::msg_id(cls, rt::sel(#str_ptr("alloc\0"))) };
    if alloced == (0 as *u8) { return 0 as *u8; }
    let zero: rt::Rect = rt::Rect { x: 0.0f64, y: 0.0f64, w: 0.0f64, h: 0.0f64 };
    // BEFORE the view, both of them: a configuration is COPIED at init, so
    // anything registered afterwards is registered on a copy nobody reads.
    // That is why the scheme handler cannot be an `apply` and has to be here.
    install_message_channel(cfg);
    let scheme: *u8 = install_scheme(cfg, n);
    let v: *u8 = { msg_id_rect_id(alloced, rt::sel(#str_ptr("initWithFrame:configuration:\0")),
                                  zero, cfg) };
    if cfg != (0 as *u8) { { rt::release(cfg) }; }
    if v == (0 as *u8) { return 0 as *u8; }
    // The handler is retained by the configuration the view keeps, but the
    // ASSOCIATION back to the node is ours to hold: pin it on the view, which
    // outlives every task.
    if scheme != (0 as *u8) {
        synth::retain_associated(v, scheme_node_key(), scheme);
        { rt::release(scheme) };
    }
    arm_navigation(v, n);
    return v;
}

fn is_web_view(v: *u8) -> bool {
    if v == (0 as *u8) { return false; }
    return { rt::msg_i8_id(v, rt::sel(#str_ptr("isKindOfClass:\0")),
                           rt::get_class(#str_ptr("WKWebView\0"))) } != (0 as i8);
}

// A web view is cut loose from its node BEFORE its release, because releasing
// it does not necessarily deallocate it: WebKit retains a page that is still
// loading, and a navigation callback arriving afterwards would read a node that
// is gone. facet_appkit learned this the same way.
fn detach(v: *u8) {
    if v == (0 as *u8) { return; }
    { rt::msg_void_id(v, rt::sel(#str_ptr("setNavigationDelegate:\0")), 0 as *u8) };
    { rt::msg_void(v, rt::sel(#str_ptr("stopLoading\0"))) };
    input::bind_node(v, 0 as *core::Node);
    return;
}

fn apply_web(v: *u8, n: *core::Node, dirty: u64) {
    let p: *props::WebProps = props_of(n, props::K_WEB) as *props::WebProps;
    if p == (0 as *props::WebProps) { return; }
    apply_web_props(v, n, p, dirty);
    return;
}

fn props_of(n: *core::Node, kind: u32) -> *u8 {
    let d: *core::Data = core::node_data(n);
    if d == (0 as *core::Data) { return 0 as *u8; }
    if { (*d).kind } != kind { return 0 as *u8; }
    return { (*d).props };
}

fn apply_web_props(v: *u8, n: *core::Node, p: *props::WebProps, dirty: u64) {
    // The user agent goes on BEFORE the load, or the first request carries the
    // default one and the app's is only honoured from the second page.
    if (dirty & web::P_USER_AGENT) != (0 as u64) {
        let ua: str = { (*p).user_agent.view() };
        if ua != "" {
            { rt::msg_void_id(v, rt::sel(#str_ptr("setCustomUserAgent:\0")),
                              bridge::nsstring(ua)) };
        }
    }
    if (dirty & web::P_SOURCE) != (0 as u64) { load_source(v, { (*p).source.view() }); }

    // ---- the commands. Verbs the backend performs; facet clears the bits.
    if (dirty & web::P_GO_BACK) != (0 as u64) {
        { rt::msg_void(v, rt::sel(#str_ptr("goBack\0"))) };
    }
    if (dirty & web::P_GO_FORWARD) != (0 as u64) {
        { rt::msg_void(v, rt::sel(#str_ptr("goForward\0"))) };
    }
    if (dirty & web::P_RELOAD) != (0 as u64) {
        { rt::msg_void(v, rt::sel(#str_ptr("reload\0"))) };
    }
    if (dirty & web::P_EVAL) != (0 as u64) {
        let js: str = { (*p).eval_script.view() };
        if js != "" {
            // No completion handler: facet's `eval` is fire-and-forget, and a
            // handler would need a block whose result has nowhere to land.
            { rt::msg_void_id_id(v, rt::sel(#str_ptr("evaluateJavaScript:completionHandler:\0")),
                                 bridge::nsstring(js), 0 as *u8) };
        }
    }
    return;
}

// A source is a URL or a document. Both are ordinary WebKit loads; the split is
// whether the string names a scheme.
fn load_source(v: *u8, src: str) {
    if src == "" { return; }
    if looks_like_url(src) {
        let url: *u8 = { rt::msg_id_id(rt::get_class(#str_ptr("NSURL\0")),
                                       rt::sel(#str_ptr("URLWithString:\0")),
                                       bridge::nsstring(src)) };
        if url == (0 as *u8) { return; }
        let req: *u8 = { rt::msg_id_id(rt::get_class(#str_ptr("NSURLRequest\0")),
                                       rt::sel(#str_ptr("requestWithURL:\0")), url) };
        if req == (0 as *u8) { return; }
        { rt::msg_void_id(v, rt::sel(#str_ptr("loadRequest:\0")), req) };
        return;
    }
    // Not a URL: the string IS the document.
    { rt::msg_void_id_id(v, rt::sel(#str_ptr("loadHTMLString:baseURL:\0")),
                         bridge::nsstring(src), 0 as *u8) };
    return;
}

fn looks_like_url(s: str) -> bool {
    return { s.has_prefix("http://") } || { s.has_prefix("https://") }
        || { s.has_prefix("file://") } || { s.has_prefix("about:") };
}

// ---- the navigation delegate -----------------------------------------------------

static NAV_CLASS: *u8 = 0 as *u8;
static NAV_DELEGATE: *u8 = 0 as *u8;

// A navigation is STARTING. facet's `on_navigating` is the app's chance to know
// before the page changes.
fn imp_did_start(self_obj: *u8, cmd: *u8, wv: *u8, nav: *u8) {
    let n: *core::Node = input::node_of(wv);
    if n == (0 as *core::Node) { return; }
    let p: *props::WebProps = props_of(n, props::K_WEB) as *props::WebProps;
    if p == (0 as *props::WebProps) { return; }
    sync_history(wv, p);
    let h: fn(*u8, *u8) = { (*p).on_navigating };
    if h != (0 as fn(*u8, *u8)) { h(wv, { (*p).on_navigating_ctx }); }
    return;
}

fn imp_did_finish(self_obj: *u8, cmd: *u8, wv: *u8, nav: *u8) {
    let n: *core::Node = input::node_of(wv);
    if n == (0 as *core::Node) { return; }
    let p: *props::WebProps = props_of(n, props::K_WEB) as *props::WebProps;
    if p == (0 as *props::WebProps) { return; }
    sync_history(wv, p);
    let h: fn(*u8, *u8) = { (*p).on_navigated };
    if h != (0 as fn(*u8, *u8)) { h(wv, { (*p).on_navigated_ctx }); }
    return;
}

// The renderer died. An app that shows a blank page forever is the failure this
// callback exists to prevent.
fn imp_content_terminated(self_obj: *u8, cmd: *u8, wv: *u8) {
    let n: *core::Node = input::node_of(wv);
    if n == (0 as *core::Node) { return; }
    let p: *props::WebProps = props_of(n, props::K_WEB) as *props::WebProps;
    if p == (0 as *props::WebProps) { return; }
    let h: fn(*u8, *u8) = { (*p).on_process_terminated };
    if h != (0 as fn(*u8, *u8)) { h(wv, { (*p).on_process_terminated_ctx }); }
    return;
}

// `can_go_back` / `can_go_forward` are READS on facet's props, and WebKit owns
// the truth — so the props are refreshed at both edges of every navigation,
// which is exactly when the answer can change.
fn sync_history(wv: *u8, p: *props::WebProps) {
    { (*p).can_go_back = { rt::msg_i8(wv, rt::sel(#str_ptr("canGoBack\0"))) } != (0 as i8) };
    { (*p).can_go_forward = { rt::msg_i8(wv, rt::sel(#str_ptr("canGoForward\0"))) } != (0 as i8) };
    return;
}

fn nav_delegate() -> *u8 {
    if NAV_DELEGATE != (0 as *u8) { return NAV_DELEGATE; }
    if NAV_CLASS == (0 as *u8) {
        let existing: *u8 = rt::get_class(#str_ptr("FacetUIKitWebNav\0"));
        if existing != (0 as *u8) {
            NAV_CLASS = existing;
        } else {
            let base: *u8 = rt::get_class(#str_ptr("NSObject\0"));
            let cls: *u8 = { synth::allocate_class_pair(base, #str_ptr("FacetUIKitWebNav\0"),
                                                        0 as usize) };
            if cls == (0 as *u8) { return 0 as *u8; }
            let _a: i8 = synth::add_method_v_2id(cls,
                rt::sel(#str_ptr("webView:didStartProvisionalNavigation:\0")),
                imp_did_start, #str_ptr("v@:@@\0"));
            let _b: i8 = synth::add_method_v_2id(cls,
                rt::sel(#str_ptr("webView:didFinishNavigation:\0")),
                imp_did_finish, #str_ptr("v@:@@\0"));
            let _c: i8 = synth::add_method_v_1id(cls,
                rt::sel(#str_ptr("webViewWebContentProcessDidTerminate:\0")),
                imp_content_terminated, #str_ptr("v@:@\0"));
            // The page calling OUT. `WKScriptMessageHandler` is a second
            // protocol on the same object, which is what lets one delegate be
            // both — the same shape facet_appkit's is.
            let _d: i8 = synth::add_method_v_2id(cls,
                rt::sel(#str_ptr("userContentController:didReceiveScriptMessage:\0")),
                imp_did_receive_message, #str_ptr("v@:@@\0"));
            { synth::register_class_pair(cls) };
            NAV_CLASS = cls;
        }
    }
    NAV_DELEGATE = { synth::alloc_init_class(NAV_CLASS) };
    return NAV_DELEGATE;
}

// -[WKScriptMessageHandler userContentController:didReceiveScriptMessage:]
//
// THE BODY IS THE SENDER. facet's handler shape is `(sender, ctx)` and carries
// no payload slot, so the message body — stringified — is what `sender` is.
// That one reading is what lets a page send anything at all, and it is the
// convention facet_appkit already set.
//
// The node is found from the message's own webView rather than from the
// delegate: the delegate is a SINGLETON here (one per process, not one per
// view), so it cannot carry a node of its own.
fn imp_did_receive_message(self_obj: *u8, cmd: *u8, controller: *u8, message: *u8) {
    if message == (0 as *u8) { return; }
    let wv: *u8 = { rt::msg_id(message, rt::sel(#str_ptr("webView\0"))) };
    if wv == (0 as *u8) { return; }
    let n: *core::Node = input::node_of(wv);
    if n == (0 as *core::Node) { return; }
    let p: *props::HybridWebProps =
        props_of(n, props::K_HYBRID_WEB) as *props::HybridWebProps;
    if p == (0 as *props::HybridWebProps) { return; }
    let body: *u8 = { rt::msg_id(message, rt::sel(#str_ptr("body\0"))) };
    if body == (0 as *u8) { return; }
    let as_string: *u8 = { rt::msg_id(body, rt::sel(#str_ptr("description\0"))) };
    let h: fn(*u8, *u8) = { (*p).on_raw_message_received };
    if h != props::no_handler { h(as_string, { (*p).on_raw_message_received_ctx }); }
    return;
}

// The channel a page posts on: `window.webkit.messageHandlers.facet.postMessage(x)`.
// Installed on the configuration's content controller, which has to happen
// while the view is being built — a WKWebView's configuration is copied at
// init and cannot be reached afterwards.
fn install_message_channel(cfg: *u8) {
    if cfg == (0 as *u8) { return; }
    let d: *u8 = nav_delegate();
    if d == (0 as *u8) { return; }
    let controller: *u8 = { rt::msg_id(cfg, rt::sel(#str_ptr("userContentController\0"))) };
    if controller == (0 as *u8) { return; }
    { rt::msg_void_id_id(controller,
                         rt::sel(#str_ptr("addScriptMessageHandler:name:\0")),
                         d, bridge::nsstring("facet")) };
    return;
}

fn arm_navigation(v: *u8, n: *core::Node) {
    input::bind_node(v, n);
    let d: *u8 = nav_delegate();
    if d == (0 as *u8) { return; }
    { rt::msg_void_id(v, rt::sel(#str_ptr("setNavigationDelegate:\0")), d) };
    return;
}

// (helpers the scheme tier needs, shared with facet_appkit verbatim)

fn byte_of(s: str, i: usize) -> u8 {
    return match s.byte_at(i) {
        option::Option[u8]::Some(b) => b,
        option::Option[u8]::None => 0 as u8,
    };
}

fn scheme_node_key() -> *u8 { return { 29022 as *u8 }; }

#[link_name = "objc_msgSend"]
extern fn msg_id_id_u64_i64_id(recv: *u8, sel: *u8, a: *u8, b: *u8, c: i64, d: *u8) -> *u8;
#[link_name = "objc_msgSend"]
extern fn msg_id_bytes(recv: *u8, sel: *u8, p: *u8, n: usize) -> *u8;
#[link_name = "objc_msgSend"]
extern fn msg_void_id_scheme(recv: *u8, sel: *u8, a: *u8, b: *u8);

// A path is served only if it stays under the root. `..` anywhere is refused
// outright rather than normalised: a normaliser is a thing to get wrong, and a
// hybrid app has no reason to name one.
fn escapes_root(p: str) -> bool {
    let n: usize = p.count();
    if n < (2 as usize) { return false; }
    var i: usize = 0 as usize;
    while (i + (2 as usize)) <= n {
        if byte_of(p, i) == (46 as u8) && byte_of(p, i + (1 as usize)) == (46 as u8) {
            return true;
        }
        i = i + (1 as usize);
    }
    return false;
}

fn props_of_hybrid(n: *core::Node) -> *props::HybridWebProps {
    let d: *core::Data = core::node_data(n);
    if d == (0 as *core::Data) { return 0 as *props::HybridWebProps; }
    if { (*d).kind } != props::K_HYBRID_WEB { return 0 as *props::HybridWebProps; }
    return { (*d).props } as *props::HybridWebProps;
}

fn facet_scheme() -> str { return "facet"; }

fn fire(n: *core::Node, h: fn(*u8, *u8), ctx: *u8, sender: *u8) {
    if h == props::no_handler { return; }
    h(sender, ctx);
    return;
}

// ---- the local scheme --------------------------------------------------------
// `on_web_resource_requested`, which was the last handler in the package that
// nothing fired.
//
// A `WKURLSchemeHandler` registered on the CONFIGURATION — which is why it
// happens at creation and not in an apply: a WKWebView's scheme handlers
// cannot be added once it exists, and the configuration is copied at init.
//
// WebKit is the same framework on both platforms, so this is facet_appkit's
// tier with no substitutions at all: the same task protocol, the same
// NSURLResponse, the same NSData. What it is NOT is a second way to load a
// page — `hybrid_web` already serves its bundle through
// `loadFileURL:allowingReadAccessToURL:`, and this is the channel that lets an
// application SEE each request go past.
//
// THE HANDLER OBSERVES. A request is served whatever it does, because facet
// declares no way to answer one and inventing a return channel here would be a
// verb the contract does not have.


fn mime_for(path: str) -> str {
    if path.has_suffix(".html") { return "text/html"; }
    if path.has_suffix(".htm") { return "text/html"; }
    if path.has_suffix(".js") { return "text/javascript"; }
    if path.has_suffix(".mjs") { return "text/javascript"; }
    if path.has_suffix(".css") { return "text/css"; }
    if path.has_suffix(".json") { return "application/json"; }
    if path.has_suffix(".svg") { return "image/svg+xml"; }
    if path.has_suffix(".png") { return "image/png"; }
    if path.has_suffix(".jpg") { return "image/jpeg"; }
    if path.has_suffix(".jpeg") { return "image/jpeg"; }
    if path.has_suffix(".gif") { return "image/gif"; }
    if path.has_suffix(".woff2") { return "font/woff2"; }
    return "application/octet-stream";
}

fn task_path(task: *u8) -> text::Text {
    let req: *u8 = { rt::msg_id(task, rt::sel(#str_ptr("request\0"))) };
    if req == (0 as *u8) { return text::new(); }
    let url: *u8 = { rt::msg_id(req, rt::sel(#str_ptr("URL\0"))) };
    if url == (0 as *u8) { return text::new(); }
    return bridge::to_text({ rt::msg_id(url, rt::sel(#str_ptr("path\0"))) });
}

fn fail_task(task: *u8) {
    // THREE ARGUMENTS, not four. This shared four-slot extern also serves
    // `initWithURL:MIMEType:expectedContentLength:textEncodingName:`, and the
    // spare `0 as *u8` copied across with it — which shifted every argument
    // one place right: the domain landed as the domain, NULL as the code, and
    // `404` reached `userInfo` AS A DICTIONARY POINTER. NSError keeps it and
    // anything that later reads the error's userInfo dereferences 404.
    let err: *u8 = { msg_id_id_i64_id(rt::get_class(#str_ptr("NSError\0")),
        rt::sel(#str_ptr("errorWithDomain:code:userInfo:\0")),
        bridge::nsstring("FacetHybrid"), 404 as i64, 0 as *u8) };
    if err == (0 as *u8) { return; }
    { rt::msg_void_id(task, rt::sel(#str_ptr("didFailWithError:\0")), err) };
    return;
}

fn start_task_imp(self_obj: *u8, cmd: *u8, wv: *u8, task: *u8) {
    let n: *core::Node = { synth::get_associated(self_obj, scheme_node_key()) as *core::Node };
    if n == (0 as *core::Node) { fail_task(task); return; }
    let p: *props::HybridWebProps = props_of_hybrid(n);
    if p == (0 as *props::HybridWebProps) { fail_task(task); return; }
    // The handler runs FIRST and for every resource, which is the whole verb.
    // It observes: a request is served whatever it does, because facet declares
    // no way to answer one and inventing a return channel here would be a verb
    // the contract does not have.
    fire(n, { (*p).on_web_resource_requested }, { (*p).on_web_resource_requested_ctx }, task);

    let rel: text::Text = task_path(task);
    if escapes_root(rel.view()) { fail_task(task); return; }
    var full: text::Text = text::from_str({ (*p).hybrid_root.view() });
    let _a: status::Status = full.append(rel.view());
    match fs::open_read(full.view()) {
        result::Result[fs::File, result::IoError]::Ok(f) => {
            var file: fs::File = f;
            match file.read_to_end() {
                result::Result[vec::Vec[u8], result::IoError]::Ok(bytes) => {
                    respond(task, bytes, mime_for(rel.view()));
                }
                result::Result[vec::Vec[u8], result::IoError]::Err(_e) => { fail_task(task); }
            }
        }
        result::Result[fs::File, result::IoError]::Err(_e) => { fail_task(task); }
    }
    return;
}

fn respond(task: *u8, bytes: vec::Vec[u8], mime: str) {
    let req: *u8 = { rt::msg_id(task, rt::sel(#str_ptr("request\0"))) };
    if req == (0 as *u8) { return; }
    let url: *u8 = { rt::msg_id(req, rt::sel(#str_ptr("URL\0"))) };
    if url == (0 as *u8) { return; }
    let alloced: *u8 = { rt::msg_id(rt::get_class(#str_ptr("NSURLResponse\0")),
                                    rt::sel(#str_ptr("alloc\0"))) };
    let resp: *u8 = { msg_id_id_u64_i64_id(alloced,
        rt::sel(#str_ptr("initWithURL:MIMEType:expectedContentLength:textEncodingName:\0")),
        url, bridge::nsstring(mime), bytes.count() as i64,
        bridge::nsstring("utf-8")) };
    if resp == (0 as *u8) { return; }
    // `as_byte_view` is the borrowed window onto the Vec's own storage, which
    // is what NSData wants — and it is copied by `dataWithBytes:`, so the view
    // does not have to outlive this statement.
    let view: str = bytes.as_byte_view();
    let data: *u8 = { msg_id_bytes(rt::get_class(#str_ptr("NSData\0")),
        rt::sel(#str_ptr("dataWithBytes:length:\0")),
        { #str_ptr(view) }, bytes.count()) };
    { rt::msg_void_id(task, rt::sel(#str_ptr("didReceiveResponse:\0")), resp) };
    if data != (0 as *u8) {
        { rt::msg_void_id(task, rt::sel(#str_ptr("didReceiveData:\0")), data) };
    }
    { rt::msg_void(task, rt::sel(#str_ptr("didFinish\0"))) };
    rt::release(resp);
    return;
}

// Nothing to stop: every response is delivered inside `start`, so a task is
// finished before this could be called for it.
fn stop_task_imp(self_obj: *u8, cmd: *u8, wv: *u8, task: *u8) { return; }

fn scheme_handler_class() -> *u8 {
    let existing: *u8 = rt::get_class(#str_ptr("FacetSchemeHandler\0"));
    if existing != (0 as *u8) { return existing; }
    let cls: *u8 = synth::allocate_class_pair(rt::get_class(#str_ptr("NSObject\0")),
                                              #str_ptr("FacetSchemeHandler\0"), 0 as usize);
    synth::add_method_v_2id(cls, rt::sel(#str_ptr("webView:startURLSchemeTask:\0")),
                            start_task_imp, #str_ptr("v@:@@\0"));
    synth::add_method_v_2id(cls, rt::sel(#str_ptr("webView:stopURLSchemeTask:\0")),
                            stop_task_imp, #str_ptr("v@:@@\0"));
    synth::register_class_pair(cls);
    return cls;
}

// Registered on the CONFIGURATION, which is why it happens at creation: a
// WKWebView's scheme handlers cannot be added once it exists.
fn install_scheme(config: *u8, n: *core::Node) -> *u8 {
    let h: *u8 = synth::alloc_init_class(scheme_handler_class());
    if h == (0 as *u8) { return 0 as *u8; }
    synth::set_associated(h, scheme_node_key(), n as *u8);
    { msg_void_id_scheme(config, rt::sel(#str_ptr("setURLSchemeHandler:forURLScheme:\0")),
                         h, bridge::nsstring(facet_scheme())) };
    return h;
}

// ---- hybrid_web ------------------------------------------------------------------
// The same view with a message channel: script in the page calls out to the app.
// `hybrid_root` names the folder a local document is served from, and
// `send_message` is the app calling IN.

fn create_hybrid_web(n: *core::Node) -> *u8 {
    let v: *u8 = create_web(n);
    if v == (0 as *u8) { return v; }
    let p: *props::HybridWebProps =
        props_of(n, props::K_HYBRID_WEB) as *props::HybridWebProps;
    if p != (0 as *props::HybridWebProps) {
        // `on_web_view_initializing` fires BEFORE anything is loaded — it is the
        // app's one chance to touch the view before a page can see it — and
        // `on_web_view_initialized` right after. Both are edges of construction,
        // so they belong here rather than in an apply.
        let a: fn(*u8, *u8) = { (*p).on_web_view_initializing };
        if a != (0 as fn(*u8, *u8)) { a(v, { (*p).on_web_view_initializing_ctx }); }
        let b: fn(*u8, *u8) = { (*p).on_web_view_initialized };
        if b != (0 as fn(*u8, *u8)) { b(v, { (*p).on_web_view_initialized_ctx }); }
    }
    return v;
}

// A hybrid view serves a LOCAL BUNDLE: `hybrid_root` is the folder and
// `default_file` the page inside it. That is a different load from a URL —
// `loadFileURL:allowingReadAccessToURL:` is the only one that grants a page
// read access to its own folder, which is what makes relative script and style
// references resolve.
fn apply_hybrid_web(v: *u8, n: *core::Node, dirty: u64) {
    let p: *props::HybridWebProps =
        props_of(n, props::K_HYBRID_WEB) as *props::HybridWebProps;
    if p == (0 as *props::HybridWebProps) { return; }
    if (dirty & (hybrid_web::P_HYBRID_ROOT | hybrid_web::P_DEFAULT_FILE)) != (0 as u64) {
        load_local(v, { (*p).hybrid_root.view() }, { (*p).default_file.view() });
    }
    // The app calling INTO the page. A message is arbitrary text spliced into
    // source, so it is JSON-quoted first — an unescaped quote is an injection.
    if (dirty & hybrid_web::P_SEND_MESSAGE) != (0 as u64) {
        let m: str = { (*p).outgoing_message.view() };
        if m != "" {
            var js: text::Text = text::from_str("window.facet && window.facet.receive && window.facet.receive(");
            js = js.appending(json_quoted(m).view()).appending(")");
            { rt::msg_void_id_id(v, rt::sel(#str_ptr("evaluateJavaScript:completionHandler:\0")),
                                 bridge::nsstring(js.view()), 0 as *u8) };
        }
    }
    return;
}

// The bundle folder, and the page in it.
fn load_local(v: *u8, root: str, file: str) {
    if root == "" && file == "" { return; }
    var path: text::Text = text::from_str(root);
    if root != "" && file != "" { path = path.appending("/"); }
    path = path.appending(file);
    let url: *u8 = { rt::msg_id_id(rt::get_class(#str_ptr("NSURL\0")),
                                   rt::sel(#str_ptr("fileURLWithPath:\0")),
                                   bridge::nsstring(path.view())) };
    if url == (0 as *u8) { return; }
    var dir: *u8 = url;
    if root != "" {
        dir = { rt::msg_id_id(rt::get_class(#str_ptr("NSURL\0")),
                              rt::sel(#str_ptr("fileURLWithPath:\0")),
                              bridge::nsstring(root)) };
    }
    { rt::msg_void_id_id(v, rt::sel(#str_ptr("loadFileURL:allowingReadAccessToURL:\0")),
                         url, dir) };
    return;
}

// A JSON string literal. A message is arbitrary text and it is being spliced
// into source, so quoting is not cosmetic — an unescaped quote is an injection.
// The single byte at `i`, as a `str`. `Text::append` takes a string and there
// is no byte-wise append; a one-byte slice of the source is the same bytes.
fn one_byte(s: str, i: usize) -> str {
    return match { s.slice(i, i +% (1 as usize)) } {
        option::Option[str]::Some(b) => b,
        option::Option[str]::None => "",
    };
}

fn json_quoted(s: str) -> text::Text {
    var out: text::Text = text::from_str("\"");
    var i: usize = 0 as usize;
    let n: usize = { s.count() };
    while i < n {
        match { s.byte_at(i) } {
            option::Option[u8]::Some(b) => {
                if b == (34 as u8) { out = out.appending("\\\""); }
                else if b == (92 as u8) { out = out.appending("\\\\"); }
                else if b == (10 as u8) { out = out.appending("\\n"); }
                else if b == (13 as u8) { out = out.appending("\\r"); }
                else if b == (9 as u8) { out = out.appending("\\t"); }
                else {
                    // Not an escape: the byte passes through. `Text` appends
                    // strings, so the byte is handed over as the one-byte
                    // slice it already is inside `s`.
                    out = out.appending(one_byte(s, i));
                }
            }
            option::Option[u8]::None => { }
        }
        i = i +% (1 as usize);
    }
    return out.appending("\"");
}

#[link_name = "objc_msgSend"]
extern fn msg_id_rect_id(recv: *u8, sel: *u8, r: rt::Rect, a: *u8) -> *u8;

#[link_name = "objc_msgSend"]
extern fn msg_id_id_i64_id(recv: *u8, sel: *u8, a: *u8, b: i64, c: *u8) -> *u8;
