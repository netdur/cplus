// facet_uikit dialogs — alert, choose, prompt.
//
// `UIAlertController`, presented on the window's root view controller. The
// three verbs are one shape with different numbers of buttons and one optional
// text field, so they are one builder here.
//
// THEY ARE NOT BLOCKING, and cannot be. facet's macOS facade has an
// `alert_blocking` that spins a nested modal loop; iOS has no such loop and
// blocking the main one is how an app gets killed by the watchdog. So every
// verb here is present-and-return, and the answer arrives in a handler —
// which is exactly the shape facet's non-blocking `alert` / `choose` / `prompt`
// already have.
//
// THE ANSWER INDEX IS THE BUTTON'S POSITION, counting from 0 in the order the
// application named them. UIKit has no such number — an action's handler knows
// only itself — so the index rides on the action through its own context
// pointer, and the pending answer is held here until it fires.

import "stdlib/option" as option;
import "stdlib/text" as text;
import "stdlib/vec" as vec;
import "objc/runtime" as rt;
import "objc/bridge" as bridge;
import "uikit/uikit" as ui;
import "./window" as window;

// ---- the pending answer -------------------------------------------------------
// ONE AT A TIME, and that is not a simplification: a second alert presented
// over a first is a UIKit warning and a stack the user cannot see out of, so
// facet's contract is one question at a time and this holds one answer.
//
// The handler and its context are held rather than captured because a block's
// context is a pointer this module owns for exactly as long as the alert is up.

static ANSWER_FN: fn(i32, *u8) = 0 as fn(i32, *u8);
static ANSWER_CTX: *u8 = 0 as *u8;
static TYPED_FN: fn(str, *u8) = 0 as fn(str, *u8);
static TYPED_CTX: *u8 = 0 as *u8;
static ALERT: *u8 = 0 as *u8;

fn clear_pending() {
    ANSWER_FN = 0 as fn(i32, *u8);
    ANSWER_CTX = 0 as *u8;
    TYPED_FN = 0 as fn(str, *u8);
    TYPED_CTX = 0 as *u8;
    if ALERT != (0 as *u8) { { rt::release(ALERT) }; ALERT = 0 as *u8; }
    return;
}

// A button was tapped. `ctx` is the button's INDEX, carried as a pointer
// because that is the only payload an action's block has — the index is small
// and non-negative, so the round trip through a pointer is exact.
fn action_fired(sender: *u8, ctx: *u8) {
    let index: i32 = { (ctx as usize) as i32 };
    let answer: fn(i32, *u8) = ANSWER_FN;
    let actx: *u8 = ANSWER_CTX;
    let typed: fn(str, *u8) = TYPED_FN;
    let tctx: *u8 = TYPED_CTX;
    let a: *u8 = ALERT;
    // READ THE FIELD BEFORE THE STATE IS CLEARED and before the alert is let
    // go: its text fields belong to the controller, and the controller is
    // about to be released.
    var typed_text: text::Text = text::new();
    if typed != (0 as fn(str, *u8)) && a != (0 as *u8) {
        typed_text = first_field_text(a);
    }
    clear_pending();
    if typed != (0 as fn(str, *u8)) { typed({ typed_text.view() }, tctx); }
    if answer != (0 as fn(i32, *u8)) { answer(index, actx); }
    return;
}

fn first_field_text(alert: *u8) -> text::Text {
    let fields: *u8 = { rt::msg_id(alert, rt::sel(#str_ptr("textFields\0"))) };
    if fields == (0 as *u8) { return text::new(); }
    if { rt::msg_u64(fields, rt::sel(#str_ptr("count\0"))) } == (0 as u64) {
        return text::new();
    }
    let f: *u8 = { rt::msg_id_u64(fields, rt::sel(#str_ptr("objectAtIndex:\0")), 0 as u64) };
    if f == (0 as *u8) { return text::new(); }
    let s: *u8 = { rt::msg_id(f, rt::sel(#str_ptr("text\0"))) };
    if s == (0 as *u8) { return text::new(); }
    return bridge::to_text(s);
}

// The placeholder a prompt's field carries, held for the configuration block —
// which runs while the alert is being built, so this is live exactly then.
static INITIAL: text::Text = #zero::[text::Text]();
static PLACEHOLDER: text::Text = #zero::[text::Text]();

fn configure_field(field: *u8, ctx: *u8) {
    if field == (0 as *u8) { return; }
    { rt::msg_void_id(field, rt::sel(#str_ptr("setPlaceholder:\0")),
                      bridge::nsstring({ PLACEHOLDER.view() })) };
    // `initialValue` from the ledger row, which is NOT the placeholder: one is
    // the hint shown while the field is empty, the other is what the field
    // starts with and what a person then edits. A rename opens on the old name
    // because of this line.
    if { INITIAL.view() } != "" {
        { rt::msg_void_id(field, rt::sel(#str_ptr("setText:\0")),
                          bridge::nsstring({ INITIAL.view() })) };
    }
    return;
}

// ---- presenting ---------------------------------------------------------------

// The controller an alert is presented ON. The window's root, or whatever it
// has already presented — presenting on a controller that is itself covered is
// a UIKit warning and an alert nobody sees.
fn presenter() -> *u8 {
    let w: *u8 = window::window_native();
    if w == (0 as *u8) { return 0 as *u8; }
    var vc: *u8 = { rt::msg_id(w, rt::sel(#str_ptr("rootViewController\0"))) };
    if vc == (0 as *u8) { return 0 as *u8; }
    // A BOUNDED walk, not a `while true`: a presentation cycle would be a
    // UIKit bug rather than ours, and hanging the UI thread to prove it is not
    // worth it.
    var depth: i32 = 0 as i32;
    while depth < (8 as i32) {
        let top: *u8 = { rt::msg_id(vc, rt::sel(#str_ptr("presentedViewController\0"))) };
        if top == (0 as *u8) { return vc; }
        vc = top;
        depth = depth + (1 as i32);
    }
    return vc;
}

fn present(alert: *u8) -> bool {
    let vc: *u8 = presenter();
    if vc == (0 as *u8) { return false; }
    { msg_void_id_i8_id(vc, rt::sel(#str_ptr("presentViewController:animated:completion:\0")),
                        alert, 1 as i8, 0 as *u8) };
    return true;
}

// The shared build. `titles` are the buttons in order; the first is the
// preferred one, which is what `primary` means everywhere in facet's vocabulary.
fn build(title: str, message: str, want_field: bool, placeholder: str,
         initial: str = "") -> *u8 {
    let c: ui::AlertController = ui::AlertController::alert_controller_with_title(
        title, message, ui::AlertControllerStyle::Alert);
    let raw: *u8 = c.raw();
    if raw == (0 as *u8) { return 0 as *u8; }
    { rt::retain(raw) };
    if want_field {
        PLACEHOLDER = text::from_str(placeholder);
        INITIAL = text::from_str(initial);
        c.add_text_field_with_configuration_handler(configure_field, 0 as *u8);
    }
    return raw;
}

fn add_button(alert: *u8, title: str, index: i32, destructive: bool) {
    var style: ui::AlertActionStyle = ui::AlertActionStyle::Default;
    if destructive { style = ui::AlertActionStyle::Cancel; }
    let a: *u8 = ui::AlertAction::action_with_title(title, style, action_fired,
                                                   index as *u8);
    if a == (0 as *u8) { return; }
    { rt::msg_void_id(alert, rt::sel(#str_ptr("addAction:\0")), a) };
    return;
}

// ---- the three verbs ----------------------------------------------------------

fn alert(title: str, message: str, primary: str, secondary: str,
         on_answer: fn(i32, *u8), on_answer_ctx: *u8) {
    let a: *u8 = build(title, message, false, "");
    if a == (0 as *u8) { return; }
    ALERT = a;
    ANSWER_FN = on_answer;
    ANSWER_CTX = on_answer_ctx;
    add_button(a, primary, 0 as i32, false);
    // A second button only when one was named: an alert with an empty
    // secondary is a one-button alert, not a two-button alert with a blank.
    if secondary != "" { add_button(a, secondary, 1 as i32, true); }
    if !present(a) { clear_pending(); }
    return;
}

fn choose(title: str, message: str, options: *vec::Vec[text::Text],
          on_answer: fn(i32, *u8), on_answer_ctx: *u8) {
    let a: *u8 = build(title, message, false, "");
    if a == (0 as *u8) { return; }
    ALERT = a;
    ANSWER_FN = on_answer;
    ANSWER_CTX = on_answer_ctx;
    var i: usize = 0 as usize;
    let n: usize = { (*options).count() };
    while i < n {
        match { (*options).at_ptr(i) } {
            option::Option[*text::Text]::Some(t) => {
                add_button(a, { (*t).view() }, i as i32, false);
            }
            option::Option[*text::Text]::None => { }
        }
        i = i +% (1 as usize);
    }
    if !present(a) { clear_pending(); }
    return;
}

fn prompt(title: str, message: str, placeholder: str, primary: str, secondary: str,
          on_typed: fn(str, *u8), on_typed_ctx: *u8,
          on_answer: fn(i32, *u8), on_answer_ctx: *u8,
          initial: str = "") {
    let a: *u8 = build(title, message, true, placeholder, initial: initial);
    if a == (0 as *u8) { return; }
    ALERT = a;
    ANSWER_FN = on_answer;
    ANSWER_CTX = on_answer_ctx;
    TYPED_FN = on_typed;
    TYPED_CTX = on_typed_ctx;
    add_button(a, primary, 0 as i32, false);
    if secondary != "" { add_button(a, secondary, 1 as i32, true); }
    if !present(a) { clear_pending(); }
    return;
}

// Whether a question is on screen. The facade asks before presenting a second
// one, because UIKit's answer to that is a warning and a stack.
fn is_showing() -> bool { return ALERT != (0 as *u8); }

#[link_name = "objc_msgSend"]
extern fn msg_void_id_i8_id(recv: *u8, sel: *u8, a: *u8, b: i8, c: *u8);
