// facet_uikit recycler — list, table and tree over UITableView.
//
// THE POINT OF THIS TIER IS THAT ROWS ARE NOT VIEWS IN THE TREE. A list with
// ten thousand items has ten thousand NODES and about a dozen CELLS, and the
// cells are handed back and forth as the user scrolls. So a row is built on
// demand by the application's own `row(i)` callback, mounted into a cell that
// the table lends us, and unmounted when the table takes it back.
//
// ---- one data source for the process -------------------------------------------
//
// The same shape input.cplus and text_input.cplus use: one synthesized class,
// the node found from the table view. A data source per list would allocate an
// object per list and leak one per teardown, because `dataSource` is a WEAK
// reference with no hook that fires when it goes.
//
// ---- what a cell owns ------------------------------------------------------------
//
// A cell holds ONE facet subtree, boxed on the heap, and drops it when the cell
// is reused for another index. That is the whole of the lifetime rule: the tree
// belongs to the cell, not to the list, so a row that scrolls away is freed and
// a row that scrolls back is rebuilt from the app's callback — which is the
// contract `row(i)` already describes.

import "stdlib/option" as option;
import "stdlib/box" as box;
import "stdlib/text" as text;
import "stdlib/vec" as vec;
import "stdlib/status" as status;
import "flex_layout/flex_layout" as flex;
import "facet/facet" as core;
import "facet/props" as props;
import "facet/list" as list;
import "facet/table" as table;
import "facet/collection" as collection;
import "facet/carousel" as carousel;
import "facet/tree" as tree;
import "facet/label" as label;
import "facet/mount" as mount;
import "facet/vocabulary" as vocab;
import "objc/runtime" as rt;
import "objc/bridge" as bridge;
import "objc/synthesis" as synth;
import "uikit/uikit" as ui;
import "./input" as input;
import "./paint" as paint;
import "./geometry" as geometry;

// ---- the cell's subtree -----------------------------------------------------------
// A cell carries the boxed root of the row it currently shows, on an associated
// key. Associated rather than a subclass ivar because the cell class is UIKit's
// and this is the one thing we need to hang on it.

fn cell_root_key() -> *u8 { return 41010 as *u8; }

// WHICH ROW A CELL IS CURRENTLY SHOWING, stored as `row + 1` so that 0 keeps
// its meaning of "nothing filled". `didEndDisplaying` needs it — see there.
fn cell_row_key() -> *u8 { return 41016 as *u8; }

fn cell_row(cell: *u8) -> usize {
    return { synth::get_associated(cell, cell_row_key()) } as usize;
}

fn cell_root(cell: *u8) -> *core::Node {
    if cell == (0 as *u8) { return 0 as *core::Node; }
    return { synth::get_associated(cell, cell_root_key()) } as *core::Node;
}

// Drop whatever this cell was showing: unmount its views, then free the tree.
// Both halves matter — unmounting takes the native views out of the cell, and
// freeing releases the node's own storage and every view it retained.
// The exact inverse of `add_backed`, and it has to be, because a row's views do
// not hang off one root view.
//
// `add_backed` walks down past every VIEWLESS node and adds each backed
// descendant as a SEPARATE subview of the cell's content view — a row of three
// labels puts three subviews there, siblings, with nothing above them to remove.
// So taking `core::view_of(root)` away is not a teardown for that shape; it is a
// no-op, because a row built as `ui::row(...)` is unkeyed and viewless and
// answers 0. That is the ordinary case, not the exotic one.
//
// What that cost: the nodes were dropped and their views released, but a UIView
// is owned by its SUPERVIEW, so every label stayed in the content view and the
// next fill added a fresh set on top. Two rows' text drawn over each other,
// worse on every reuse — photographed on an iPad as "Row 29" and "Row 19" in one
// cell. facet_appkit never had it: that backend empties the cell by walking its
// `subviews`, which is why the same list is clean on macOS.
//
// Mirroring `add_backed` rather than emptying `subviews` wholesale removes
// exactly what was added and nothing UIKit put there itself.
fn remove_backed(n: *core::Node) {
    var i: usize = 0 as usize;
    let count: usize = core::child_count_of(n);
    while i < count {
        match core::child_of(n, i) {
            option::Option[*core::Node]::Some(c) => {
                let v: *u8 = core::view_of(c);
                if v != (0 as *u8) { ui::View::from_raw(v).remove_from_superview(); }
                else { remove_backed(c); }
            }
            option::Option[*core::Node]::None => { }
        }
        i = i +% (1 as usize);
    }
    return;
}

fn clear_cell(cell: *u8) {
    let old: *core::Node = cell_root(cell);
    if old == (0 as *core::Node) { return; }
    // THE SAME BRANCH `fill_cell` TOOK, in reverse. A backed root put one view
    // in the cell and a viewless one put its backed descendants there; undoing
    // the wrong half leaves the other half behind.
    let v: *u8 = core::view_of(old);
    if v != (0 as *u8) { ui::View::from_raw(v).remove_from_superview(); }
    else { remove_backed(old); }
    // THE MATCHING TEARDOWN. `realise` fired on_attach over this subtree; this
    // is what fires on_detach and clears the attach state. Dropping the box
    // without it would free nodes that facet still believes are attached.
    mount::unrealise(old);
    // `box::from_raw` takes ownership back, and the Box's drop runs the Node's,
    // which releases every view the mount walk created under it.
    let _b: box::Box[core::Node] = box::from_raw::[core::Node](old as *u8);
    synth::set_associated(cell, cell_root_key(), 0 as *u8);
    synth::set_associated(cell, cell_row_key(), 0 as *u8);
    return;
}

// Build row `i` through the application's callback, mount it, and put it in the
// cell's content view.
fn fill_cell(cell: *u8, n: *core::Node, i: usize) {
    clear_cell(cell);
    let p: *props::ListProps = props_of(n, props::K_LIST) as *props::ListProps;
    if p == (0 as *props::ListProps) { return; }
    let build: fn(usize, *u8) -> flex::Node = { (*p).row };
    if build == (0 as fn(usize, *u8) -> flex::Node) { return; }
    let content: *u8 = { rt::msg_id(cell, rt::sel(#str_ptr("contentView\0"))) };
    if content == (0 as *u8) { return; }
    match box::new::[core::Node](build(i, { (*p).row_ctx })) {
        option::Option[box::Box[core::Node]]::Some(b) => {
            let root: *core::Node = b.into_raw() as *core::Node;
            // `bind` is the app's second chance at a row: the callback that
            // fills a RECYCLED row rather than building a new one. facet
            // declares both, so both are called — build, then bind.
            let bind: fn(usize, *flex::Node, *u8) = { (*p).bind };
            // `bind` shares `row`'s context: facet gives the pair one, because they
            // are two halves of the same callback.
            if bind != (0 as fn(usize, *flex::Node, *u8)) { bind(i, root, { (*p).row_ctx }); }
            // `realise` ANSWERS THE ROOT'S VIEW, AND 0 IS NOT FAILURE.
            //
            // A row built as `ui::row(...)` is an unkeyed pure-layout node and
            // gets no view of its own — its children carry the views — so 0 is
            // the ORDINARY answer for a row, not an error. Reading it as a
            // success flag (`realise(root) != 0`) skipped both branches and put
            // nothing in the cell: every recycled row in the package rendered
            // as an empty cell with a separator under it.
            //
            // Which is what `add_backed` exists for, and it was already written.
            let rv: *u8 = mount::realise(root);
            if rv != (0 as *u8) {
                ui::View::from_raw(content).add_subview(ui::View::from_raw(rv));
            } else {
                add_backed(ui::View::from_raw(content), root);
            }
            synth::set_associated(cell, cell_root_key(), root as *u8);
            synth::set_associated(cell, cell_row_key(), (i +% (1 as usize)) as *u8);
            layout_cell(cell, root);
        }
        option::Option[box::Box[core::Node]]::None => { }
    }
    return;
}

fn add_backed(content: ui::View, n: *core::Node) {
    var i: usize = 0 as usize;
    let count: usize = core::child_count_of(n);
    while i < count {
        match core::child_of(n, i) {
            option::Option[*core::Node]::Some(c) => {
                let v: *u8 = core::view_of(c);
                if v != (0 as *u8) { content.add_subview(ui::View::from_raw(v)); }
                else { add_backed(content, c); }
            }
            option::Option[*core::Node]::None => { }
        }
        i = i +% (1 as usize);
    }
    return;
}

// A row is laid out at the CELL's size, which is the width the table gives it
// and the height the table asked us for. flex owns the inside.
fn layout_cell(cell: *u8, root: *core::Node) {
    let content: *u8 = { rt::msg_id(cell, rt::sel(#str_ptr("contentView\0"))) };
    if content == (0 as *u8) { return; }
    let b: rt::Rect = ui::View::from_raw(content).bounds();
    if b.w <= 0.0f64 { return; }
    geometry::relayout_root(root, b.w, b.h, geometry::screen_scale());
    let rv: *u8 = core::view_of(root);
    if rv != (0 as *u8) {
        geometry::set_view_frame(rv, rt::Rect { x: 0.0f64, y: 0.0f64, w: b.w, h: b.h });
    }
    return;
}

// ---- the data source ---------------------------------------------------------------

static DS_CLASS: *u8 = 0 as *u8;
static DS: *u8 = 0 as *u8;

fn props_of(n: *core::Node, kind: u32) -> *u8 {
    let d: *core::Data = core::node_data(n);
    if d == (0 as *core::Data) { return 0 as *u8; }
    if { (*d).kind } != kind { return 0 as *u8; }
    return { (*d).props };
}

fn list_props(tv: *u8) -> *props::ListProps {
    let n: *core::Node = input::node_of(tv);
    if n == (0 as *core::Node) { return 0 as *props::ListProps; }
    return props_of(n, props::K_LIST) as *props::ListProps;
}

// How many sections. facet's `group_count` is the same idea, and 1 is the
// answer for an ungrouped list.
fn imp_number_of_sections(self_obj: *u8, cmd: *u8, tv: *u8) -> i64 {
    let p: *props::ListProps = list_props(tv);
    if p == (0 as *props::ListProps) { return 1 as i64; }
    if { (*p).is_grouped } == false { return 1 as i64; }
    let g: i64 = { (*p).group_count };
    if g <= (0 as i64) { return 1 as i64; }
    return g;
}

fn imp_rows_in_section(self_obj: *u8, cmd: *u8, tv: *u8, section: i64) -> i64 {
    let p: *props::ListProps = list_props(tv);
    if p == (0 as *props::ListProps) { return 0 as i64; }
    if { (*p).is_grouped } {
        let gs: fn(usize, *u8) -> usize = { (*p).group_size };
        if gs != (0 as fn(usize, *u8) -> usize) {
            return gs(section as usize, { (*p).group_size_ctx }) as i64;
        }
    }
    return { (*p).count };
}

// The cell. `dequeueReusableCellWithIdentifier:` is the whole recycling
// mechanism — the identifier is facet's `row_kind`, so rows that look different
// are never handed each other's views.
fn imp_cell_for_row(self_obj: *u8, cmd: *u8, tv: *u8, index_path: *u8) -> *u8 {
    let n: *core::Node = input::node_of(tv);
    if n == (0 as *core::Node) { return 0 as *u8; }
    let p: *props::ListProps = list_props(tv);
    if p == (0 as *props::ListProps) { return 0 as *u8; }
    let row: usize = flat_index(p, index_path);
    var kind: usize = 0 as usize;
    let rk: fn(usize, *u8) -> usize = { (*p).row_kind };
    if rk != (0 as fn(usize, *u8) -> usize) { kind = rk(row, { (*p).row_kind_ctx }); }
    let ident: text::Text = text::from_str("facet.row.").appending(usize_text(kind).view());
    var cell: *u8 = { rt::msg_id_id(tv, rt::sel(#str_ptr("dequeueReusableCellWithIdentifier:\0")),
                                    bridge::nsstring(ident.view())) };
    if cell == (0 as *u8) {
        let cls: *u8 = rt::get_class(#str_ptr("UITableViewCell\0"));
        let alloced: *u8 = { rt::msg_id(cls, rt::sel(#str_ptr("alloc\0"))) };
        if alloced == (0 as *u8) { return 0 as *u8; }
        cell = { msg_id_i64_id(alloced, rt::sel(#str_ptr("initWithStyle:reuseIdentifier:\0")),
                               0 as i64, bridge::nsstring(ident.view())) };
        if cell == (0 as *u8) { return 0 as *u8; }
        // A facet row draws its own background; the cell's would sit under it
        // and win at the edges.
        { rt::msg_void_id(cell, rt::sel(#str_ptr("setBackgroundColor:\0")), 0 as *u8) };
        { rt::msg_void_i64(cell, rt::sel(#str_ptr("setSelectionStyle:\0")), 0 as i64) };
    }
    fill_cell(cell, n, row);
    // `on_item_appearing` — the row is about to be on screen, which is the
    // moment an app loads its image or its page.
    let ap: fn(*u8, *u8) = { (*p).on_item_appearing };
    if ap != (0 as fn(*u8, *u8)) { ap(cell, { (*p).on_item_appearing_ctx }); }
    return cell;
}

// A grouped list numbers its rows per section; facet's callbacks are FLAT, so
// the section's rows before this one are added back.
fn flat_index(p: *props::ListProps, index_path: *u8) -> usize {
    let row: i64 = { rt::msg_i64(index_path, rt::sel(#str_ptr("row\0"))) };
    if { (*p).is_grouped } == false { return row as usize; }
    let section: i64 = { rt::msg_i64(index_path, rt::sel(#str_ptr("section\0"))) };
    let gs: fn(usize, *u8) -> usize = { (*p).group_size };
    if gs == (0 as fn(usize, *u8) -> usize) { return row as usize; }
    var before: usize = 0 as usize;
    var s: i64 = 0 as i64;
    while s < section {
        before = before +% gs(s as usize, { (*p).group_size_ctx });
        s = s + (1 as i64);
    }
    return before +% (row as usize);
}

// The height. `row_height` is one number for every row and needs no callback;
// `has_uneven_rows` is the app saying it wants to be asked per row, which is
// what `row_height_of` answers.
fn imp_height_for_row(self_obj: *u8, cmd: *u8, tv: *u8, index_path: *u8) -> f64 {
    let p: *props::ListProps = list_props(tv);
    if p == (0 as *props::ListProps) { return 44.0f64; }
    if { (*p).has_uneven_rows } {
        let f: fn(usize, *u8) -> f64 = { (*p).row_height_of };
        if f != (0 as fn(usize, *u8) -> f64) {
            let h: f64 = f(flat_index(p, index_path), { (*p).row_height_of_ctx });
            if h > 0.0f64 { return h; }
        }
    }
    let h: i64 = { (*p).row_height };
    if h > (0 as i64) { return h as f64; }
    // The tap target, which is the floor a row should never go under.
    return 44.0f64;
}

// A section header, when the app builds one.
fn imp_title_for_header(self_obj: *u8, cmd: *u8, tv: *u8, section: i64) -> *u8 {
    return 0 as *u8;
}

fn imp_did_select(self_obj: *u8, cmd: *u8, tv: *u8, index_path: *u8) {
    let n: *core::Node = input::node_of(tv);
    if n == (0 as *core::Node) { return; }
    let p: *props::ListProps = list_props(tv);
    if p == (0 as *props::ListProps) { return; }
    let row: usize = flat_index(p, index_path);
    // The write-back, before the handlers — the same rule every control follows.
    { (*p).selected_index = row as i64 };
    let tap: fn(*u8, *u8) = { (*p).on_item_tapped };
    if tap != (0 as fn(*u8, *u8)) { tap(tv, { (*p).on_item_tapped_ctx }); }
    let sel: fn(*u8, *u8) = { (*p).on_item_selected };
    if sel != (0 as fn(*u8, *u8)) { sel(tv, { (*p).on_item_selected_ctx }); }
    // `SelectionMode::None` means the row may be tapped and never stays
    // selected, which is a deselect right after the tap.
    let keeps: bool = match { (*p).selection_mode } {
        vocab::SelectionMode::None => false,
        vocab::SelectionMode::Single => true,
        vocab::SelectionMode::Multiple => true,
    };
    if !keeps {
        { msg_void_id_i8(tv, rt::sel(#str_ptr("deselectRowAtIndexPath:animated:\0")),
                         index_path, 1 as i8) };
    }
    return;
}

// A cell left the screen. Its subtree is dropped here rather than waiting for
// the next `fill_cell`, so a list scrolled to the end is not holding every row
// it ever showed.
// THIS CALLBACK CAN ARRIVE AFTER THE CELL HAS ALREADY BEEN REFILLED.
//
// UIKit does not promise that `didEndDisplayingCell:forRowAtIndexPath:` is
// delivered before the same cell object is handed back out by
// `dequeueReusableCellWithIdentifier:`. While scrolling it routinely arrives
// after: the cell leaves the top, `cellForRowAtIndexPath:` dequeues it and
// `fill_cell` builds the new row into it, and only then does the delegate hear
// that the OLD index path stopped displaying. Clearing unconditionally there
// tore down the row that had just been built, and the cell rendered empty —
// "labels disappear while scrolling", intermittent because it depends on that
// ordering. facet_appkit never had it because NSTableView has no callback of
// this shape.
//
// The cell says which row it is showing, so the question is answerable: clear
// only when the cell is still the row that is going away. When it is not, the
// cell has already been re-filled and this teardown belongs to a row that no
// longer lives here — and `fill_cell` clears before every fill anyway, so
// nothing leaks by leaving it alone.
fn imp_did_end_displaying(self_obj: *u8, cmd: *u8, tv: *u8, cell: *u8, index_path: *u8) {
    let p: *props::ListProps = list_props(tv);
    if p != (0 as *props::ListProps) {
        let d: fn(*u8, *u8) = { (*p).on_item_disappearing };
        if d != (0 as fn(*u8, *u8)) { d(cell, { (*p).on_item_disappearing_ctx }); }
    }
    if !cell_holds_row(p, cell, index_path) { return; }
    clear_cell(cell);
    return;
}

// Is `cell` still showing the row `index_path` names? Unanswerable without the
// props (a flat index needs them), and an unanswerable question must not
// destroy a filled cell — so it answers false and the teardown waits for the
// next fill.
fn cell_holds_row(p: *props::ListProps, cell: *u8, index_path: *u8) -> bool {
    if p == (0 as *props::ListProps) { return false; }
    if index_path == (0 as *u8) { return false; }
    let held: usize = cell_row(cell);
    if held == (0 as usize) { return false; }
    return (held -% (1 as usize)) == flat_index(p, index_path);
}

fn imp_scrolled(self_obj: *u8, cmd: *u8, sv: *u8) {
    // A COLLECTION VIEW ARRIVES HERE TOO. Both sources point their scroll
    // delegate at this one imp, so the kind decides which question to ask:
    // a carousel wants its page, a list wants its scroll observer, and both
    // want the load-more threshold.
    let n: *core::Node = input::node_of(sv);
    if n == (0 as *core::Node) { return; }
    let kind: u32 = core::kind_of(n);
    if kind == props::K_CAROUSEL { carousel_scrolled(sv, n); return; }
    let p: *props::ListProps = list_props(sv);
    if p == (0 as *props::ListProps) { return; }
    let h: fn(*u8, *u8) = { (*p).observe_scrolled };
    if h != props::no_handler { h(sv, { (*p).observe_scrolled_ctx }); }
    return;
}

// ---- load more ---------------------------------------------------------------
// `RemainingItemsThreshold`, which is an ItemsView verb — so it belongs to
// `collection` and `carousel` and NOT to `list`, whose equivalent is the
// `on_item_appearing` the row vend already fires.
//
// When the items still past the last one on screen drop to this many, the
// application is told so it can fetch the next page.
//
// Fired from `willDisplayCell:`, which is the moment a row is about to be
// realised — the only moment that means "the user has scrolled this far" and
// costs nothing when they have not.
//
// ONCE PER CROSSING, not once per row. Held on the view, so a list scrolled
// back up and down again asks again — which is what an application refilling
// its page wants.
fn threshold_key() -> *u8 { return 41015 as *u8; }

fn note_row_shown(v: *u8, iv: *props::ItemsViewProps, row: i64, count: i64) {
    let bar: i64 = { (*iv).remaining_threshold };
    if bar <= (0 as i64) { return; }
    let remaining: i64 = count - (row + (1 as i64));
    let inside: bool = remaining <= bar;
    let was: bool = { synth::get_associated(v, threshold_key()) } != (0 as *u8);
    if inside == was { return; }
    var mark: *u8 = 0 as *u8;
    if inside { mark = 1 as *u8; }
    synth::set_associated(v, threshold_key(), mark);
    if !inside { return; }
    let h: fn(*u8, *u8) = { (*iv).on_remaining_items_threshold_reached };
    if h != props::no_handler {
        h(v, { (*iv).on_remaining_items_threshold_reached_ctx });
    }
    return;
}

// ---- a carousel's page -------------------------------------------------------
// A paging collection view has no "current page" of its own — UIPageControl
// has one and a UICollectionView does not — so the page IS the offset divided
// by the width, which is what paging makes true.
fn carousel_scrolled(cv: *u8, n: *core::Node) {
    let p: *props::CarouselProps =
        props_of(n, props::K_CAROUSEL) as *props::CarouselProps;
    if p == (0 as *props::CarouselProps) { return; }
    let b: rt::Rect = { rt::msg_rect(cv, rt::sel(#str_ptr("bounds\0"))) };
    if b.w <= 0.0f64 { return; }
    let off: rt::Point = { rt::msg_point(cv, rt::sel(#str_ptr("contentOffset\0"))) };
    var page: i64 = ((off.x + b.w / 2.0f64) / b.w) as i64;
    if page < (0 as i64) { page = 0 as i64; }
    if page == { (*p).position } { return; }
    // Written straight into the props, not through the verb: the verb would
    // raise the dirty bit and the next sync would scroll the carousel back to
    // the page it just produced. The same rule every write-back here follows.
    { (*p).position = page };
    let ph: fn(*u8, *u8) = { (*p).on_position_changed };
    if ph != props::no_handler { ph(cv, { (*p).on_position_changed_ctx }); }
    // `CurrentItemChanged` is the same moment named for the ITEM rather than
    // the index. facet gives them separate handlers and both are real, so both
    // are called — in the ledger's order.
    let ih: fn(*u8, *u8) = { (*p).on_current_item_changed };
    if ih != props::no_handler { ih(cv, { (*p).on_current_item_changed_ctx }); }
    return;
}

fn data_source() -> *u8 {
    if DS != (0 as *u8) { return DS; }
    if DS_CLASS == (0 as *u8) {
        let existing: *u8 = rt::get_class(#str_ptr("FacetUIKitTableSource\0"));
        if existing != (0 as *u8) {
            DS_CLASS = existing;
        } else {
            let base: *u8 = rt::get_class(#str_ptr("NSObject\0"));
            let cls: *u8 = { synth::allocate_class_pair(base,
                #str_ptr("FacetUIKitTableSource\0"), 0 as usize) };
            if cls == (0 as *u8) { return 0 as *u8; }
            let _a: i8 = synth::add_method_i64_1id(cls,
                rt::sel(#str_ptr("numberOfSectionsInTableView:\0")),
                imp_number_of_sections, #str_ptr("q@:@\0"));
            let _b: i8 = add_method_i64_id_i64(cls,
                rt::sel(#str_ptr("tableView:numberOfRowsInSection:\0")),
                imp_rows_in_section, #str_ptr("q@:@q\0"));
            let _c: i8 = synth::add_method_id_2id(cls,
                rt::sel(#str_ptr("tableView:cellForRowAtIndexPath:\0")),
                imp_cell_for_row, #str_ptr("@@:@@\0"));
            let _d: i8 = add_method_f64_2id(cls,
                rt::sel(#str_ptr("tableView:heightForRowAtIndexPath:\0")),
                imp_height_for_row, #str_ptr("d@:@@\0"));
            let _e: i8 = synth::add_method_v_2id(cls,
                rt::sel(#str_ptr("tableView:didSelectRowAtIndexPath:\0")),
                imp_did_select, #str_ptr("v@:@@\0"));
            let _f: i8 = synth::add_method_v_3id(cls,
                rt::sel(#str_ptr("tableView:didEndDisplayingCell:forRowAtIndexPath:\0")),
                imp_did_end_displaying, #str_ptr("v@:@@@\0"));
            let _g: i8 = synth::add_method_v_1id(cls,
                rt::sel(#str_ptr("scrollViewDidScroll:\0")),
                imp_scrolled, #str_ptr("v@:@\0"));
            { synth::register_class_pair(cls) };
            DS_CLASS = cls;
        }
    }
    DS = { synth::alloc_init_class(DS_CLASS) };
    return DS;
}

// ---- create / apply -----------------------------------------------------------------

fn create_recycling_list(n: *core::Node) -> *u8 {
    // Style 0 is Plain, 1 is Grouped — facet's `is_grouped` picks it, and it
    // cannot be changed after construction, which is why it is read here.
    var style: i64 = 0 as i64;
    let p: *props::ListProps = props_of(n, props::K_LIST) as *props::ListProps;
    if p != (0 as *props::ListProps) {
        if { (*p).is_grouped } { style = 1 as i64; }
    }
    return make_table_view(n, style);
}

// The construction both list and table share. `initWithFrame:style:` is the
// only place a style can be said, so the style is a PARAMETER rather than
// something read from props here — the two kinds pick it differently.
fn make_table_view(n: *core::Node, style: i64) -> *u8 {
    let cls: *u8 = rt::get_class(#str_ptr("UITableView\0"));
    if cls == (0 as *u8) { return 0 as *u8; }
    let alloced: *u8 = { rt::msg_id(cls, rt::sel(#str_ptr("alloc\0"))) };
    if alloced == (0 as *u8) { return 0 as *u8; }
    let zero: rt::Rect = rt::Rect { x: 0.0f64, y: 0.0f64, w: 0.0f64, h: 0.0f64 };
    let v: *u8 = { msg_id_rect_i64(alloced, rt::sel(#str_ptr("initWithFrame:style:\0")),
                                   zero, style) };
    if v == (0 as *u8) { return 0 as *u8; }
    input::bind_node(v, n);
    let ds: *u8 = data_source();
    if ds != (0 as *u8) {
        { rt::msg_void_id(v, rt::sel(#str_ptr("setDataSource:\0")), ds) };
        { rt::msg_void_id(v, rt::sel(#str_ptr("setDelegate:\0")), ds) };
    }
    return v;
}

fn apply_recycling_list(v: *u8, n: *core::Node, dirty: u64) {
    let p: *props::ListProps = props_of(n, props::K_LIST) as *props::ListProps;
    if p == (0 as *props::ListProps) { return; }
    let tv: ui::TableView = ui::TableView::from_raw(v);

    // A row height that is one number for every row is told to the table
    // outright; uneven rows are asked for per row by the delegate.
    if (dirty & (list::P_ROW_HEIGHT | list::P_HAS_UNEVEN_ROWS)) != (0 as u64) {
        if { (*p).has_uneven_rows } {
            // -1 is UITableViewAutomaticDimension's spelling.
            { rt::msg_void_f64(v, rt::sel(#str_ptr("setRowHeight:\0")), -1.0f64) };
        } else {
            let h: i64 = { (*p).row_height };
            if h > (0 as i64) {
                { rt::msg_void_f64(v, rt::sel(#str_ptr("setRowHeight:\0")), h as f64) };
            }
        }
    }
    if (dirty & (list::P_SEPARATOR | list::P_SEPARATOR_COLOR)) != (0 as u64) {
        let style: i64 = match { (*p).separator } {
            vocab::Separator::Default => 1 as i64,
            vocab::Separator::None => 0 as i64,
        };
        { rt::msg_void_i64(v, rt::sel(#str_ptr("setSeparatorStyle:\0")), style) };
        let c: vocab::Color = { (*p).separator_color };
        if c.is_set() {
            { rt::msg_void_id(v, rt::sel(#str_ptr("setSeparatorColor:\0")),
                              paint::ui_color(c).raw()) };
        }
    }
    if (dirty & list::P_SELECTION_MODE) != (0 as u64) {
        let allows: bool = match { (*p).selection_mode } {
            vocab::SelectionMode::None => false,
            vocab::SelectionMode::Single => true,
            vocab::SelectionMode::Multiple => true,
        };
        let many: bool = match { (*p).selection_mode } {
            vocab::SelectionMode::Multiple => true,
            vocab::SelectionMode::Single => false,
            vocab::SelectionMode::None => false,
        };
        { rt::msg_void_i8(v, rt::sel(#str_ptr("setAllowsSelection:\0")), bool_i8(allows)) };
        { rt::msg_void_i8(v, rt::sel(#str_ptr("setAllowsMultipleSelection:\0")), bool_i8(many)) };
    }
    if (dirty & (list::P_VERTICAL_SCROLL_BARS | list::P_HORIZONTAL_SCROLL_BARS)) != (0 as u64) {
        tv.as_scroll_view().set_shows_vertical_scroll_indicator(
            bars_shown({ (*p).vertical_scroll_bars }));
        tv.as_scroll_view().set_shows_horizontal_scroll_indicator(
            bars_shown({ (*p).horizontal_scroll_bars }));
    }

    // ---- pull to refresh, which a table owns rather than a wrapper
    if (dirty & (list::P_IS_REFRESHABLE | list::P_CAN_REFRESH)) != (0 as u64) {
        let on: bool = { (*p).is_refreshable } && { (*p).can_refresh };
        if on {
            if { rt::msg_id(v, rt::sel(#str_ptr("refreshControl\0"))) } == (0 as *u8) {
                let rc: *u8 = { rt::alloc_init(#str_ptr("UIRefreshControl\0")) };
                if rc != (0 as *u8) {
                    input::bind_node(rc, n);
                    input::arm_value(rc, n);
                    { rt::msg_void_id(v, rt::sel(#str_ptr("setRefreshControl:\0")), rc) };
                    { rt::release(rc) };
                }
            }
        } else {
            { rt::msg_void_id(v, rt::sel(#str_ptr("setRefreshControl:\0")), 0 as *u8) };
        }
    }
    if (dirty & (list::P_BEGIN_REFRESH | list::P_END_REFRESH | list::P_IS_REFRESHING)) != (0 as u64) {
        let rc: *u8 = { rt::msg_id(v, rt::sel(#str_ptr("refreshControl\0"))) };
        if rc != (0 as *u8) {
            if { (*p).is_refreshing } { { rt::msg_void(rc, rt::sel(#str_ptr("beginRefreshing\0"))) }; }
            else { { rt::msg_void(rc, rt::sel(#str_ptr("endRefreshing\0"))) }; }
        }
    }
    if (dirty & list::P_REFRESH_COLOR) != (0 as u64) {
        let rc: *u8 = { rt::msg_id(v, rt::sel(#str_ptr("refreshControl\0"))) };
        let c: vocab::Color = { (*p).refresh_color };
        if rc != (0 as *u8) && c.is_set() {
            { rt::msg_void_id(rc, rt::sel(#str_ptr("setTintColor:\0")),
                              paint::ui_color(c).raw()) };
        }
    }

    // ---- the commands. A table is told WHAT CHANGED, not just that something
    // did: reloading the whole thing on every write is what makes a list flash
    // and lose its scroll position.
    if (dirty & list::P_SPLICE_ROWS) != (0 as u64) {
        splice(v, { (*p).splice_at }, { (*p).splice_count });
    } else if (dirty & list::P_INVALIDATE_ROW) != (0 as u64) {
        invalidate_rows(v, { (*p).invalidate_lo }, { (*p).invalidate_hi });
    } else if (dirty & (list::P_COUNT | list::P_ROW | list::P_GROUP
                        | list::P_GROUP_COUNT | list::P_IS_GROUPED)) != (0 as u64) {
        { rt::msg_void(v, rt::sel(#str_ptr("reloadData\0"))) };
    }
    if (dirty & list::P_SCROLL_TO) != (0 as u64) {
        scroll_to(v, { (*p).scroll_to_index });
    }
    if (dirty & list::P_SELECTED_INDEX) != (0 as u64) {
        select_row(v, { (*p).selected_index });
    }
    return;
}

// An index path for a FLAT index, which is what facet's callbacks speak.
fn index_path(row: i64, section: i64) -> *u8 {
    return { msg_id_i64_i64(rt::get_class(#str_ptr("NSIndexPath\0")),
                            rt::sel(#str_ptr("indexPathForRow:inSection:\0")), row, section) };
}

fn one_path_array(row: i64) -> *u8 {
    let arr: *u8 = { rt::msg_id(rt::get_class(#str_ptr("NSMutableArray\0")),
                                rt::sel(#str_ptr("array\0"))) };
    let ip: *u8 = index_path(row, 0 as i64);
    if ip != (0 as *u8) {
        { rt::msg_void_id(arr, rt::sel(#str_ptr("addObject:\0")), ip) };
    }
    return arr;
}

// Rows added or removed at a point. A positive count inserts, a negative one
// deletes — which is how facet spells both in one verb.
fn splice(v: *u8, at: i64, count: i64) {
    if count == (0 as i64) { return; }
    let arr: *u8 = { rt::msg_id(rt::get_class(#str_ptr("NSMutableArray\0")),
                                rt::sel(#str_ptr("array\0"))) };
    var i: i64 = 0 as i64;
    var n: i64 = count;
    if n < (0 as i64) { n = 0 as i64 -% n; }
    while i < n {
        let ip: *u8 = index_path(at + i, 0 as i64);
        if ip != (0 as *u8) { { rt::msg_void_id(arr, rt::sel(#str_ptr("addObject:\0")), ip) }; }
        i = i + (1 as i64);
    }
    if count > (0 as i64) {
        { msg_void_id_i64(v, rt::sel(#str_ptr("insertRowsAtIndexPaths:withRowAnimation:\0")),
                          arr, 100 as i64) };
    } else {
        { msg_void_id_i64(v, rt::sel(#str_ptr("deleteRowsAtIndexPaths:withRowAnimation:\0")),
                          arr, 100 as i64) };
    }
    return;
}

// A range of rows whose CONTENT changed. Animation 5 is None — a row whose data
// changed should not slide.
fn invalidate_rows(v: *u8, lo: i64, hi: i64) {
    if hi < lo { return; }
    let arr: *u8 = { rt::msg_id(rt::get_class(#str_ptr("NSMutableArray\0")),
                                rt::sel(#str_ptr("array\0"))) };
    var i: i64 = lo;
    while i <= hi {
        let ip: *u8 = index_path(i, 0 as i64);
        if ip != (0 as *u8) { { rt::msg_void_id(arr, rt::sel(#str_ptr("addObject:\0")), ip) }; }
        i = i + (1 as i64);
    }
    { msg_void_id_i64(v, rt::sel(#str_ptr("reloadRowsAtIndexPaths:withRowAnimation:\0")),
                      arr, 5 as i64) };
    return;
}

fn scroll_to(v: *u8, row: i64) {
    if row < (0 as i64) { return; }
    let ip: *u8 = index_path(row, 0 as i64);
    if ip == (0 as *u8) { return; }
    // Position 0 is None — scroll the least that brings the row into view.
    { msg_void_id_i64_i8(v, rt::sel(#str_ptr("scrollToRowAtIndexPath:atScrollPosition:animated:\0")),
                         ip, 0 as i64, 1 as i8) };
    return;
}

fn select_row(v: *u8, row: i64) {
    if row < (0 as i64) {
        { msg_void_id_i8_i64(v, rt::sel(#str_ptr("selectRowAtIndexPath:animated:scrollPosition:\0")),
                             0 as *u8, 0 as i8, 0 as i64) };
        return;
    }
    let ip: *u8 = index_path(row, 0 as i64);
    if ip == (0 as *u8) { return; }
    { msg_void_id_i8_i64(v, rt::sel(#str_ptr("selectRowAtIndexPath:animated:scrollPosition:\0")),
                         ip, 0 as i8, 0 as i64) };
    return;
}

fn bars_shown(b: vocab::ScrollBars) -> bool {
    return match b {
        vocab::ScrollBars::Default => true,
        vocab::ScrollBars::Always => true,
        vocab::ScrollBars::Never => false,
    };
}

fn bool_i8(b: bool) -> i8 {
    if b { return 1 as i8; }
    return 0 as i8;
}

fn usize_text(v: usize) -> text::Text {
    if v == (0 as usize) { return text::from_str("0"); }
    var digits: [usize; 20] = #zero::[[usize; 20]]();
    var m: usize = v;
    var i: usize = 0 as usize;
    while m > (0 as usize) && i < (20 as usize) {
        digits[i] = m % (10 as usize);
        m = m / (10 as usize);
        i = i +% (1 as usize);
    }
    var out: text::Text = text::new();
    while i > (0 as usize) {
        i = i -% (1 as usize);
        let d: usize = digits[i];
        if d == (0 as usize) { out = out.appending("0"); }
        else if d == (1 as usize) { out = out.appending("1"); }
        else if d == (2 as usize) { out = out.appending("2"); }
        else if d == (3 as usize) { out = out.appending("3"); }
        else if d == (4 as usize) { out = out.appending("4"); }
        else if d == (5 as usize) { out = out.appending("5"); }
        else if d == (6 as usize) { out = out.appending("6"); }
        else if d == (7 as usize) { out = out.appending("7"); }
        else if d == (8 as usize) { out = out.appending("8"); }
        else { out = out.appending("9"); }
    }
    return out;
}

// ---- table ---------------------------------------------------------------------------
// facet's `table` is a list with a STYLE — grouped, inset — and the same rows.
// It shares every mechanism above; only the construction differs.

// A `table` is a list with three verbs of its own — the STYLE it is drawn in,
// its row height, and whether the rows size themselves. Everything else about
// it is a list, so the list's create and apply do the rest.
//
// UITableViewStyle is fixed at init, which is why the style is read here rather
// than written in `apply`: `initWithFrame:style:` is the only place it can be
// said, and a table that changed style after mounting would have to be a
// different view.
fn create_recycling_table(n: *core::Node) -> *u8 {
    let p: *props::TableProps = props_of(n, props::K_TABLE) as *props::TableProps;
    var style: i64 = table_style_of(vocab::TableStyle::Data);
    if p != (0 as *props::TableProps) { style = table_style_of({ (*p).style }); }
    return make_table_view(n, style);
}

// UITableViewStyle: Plain 0, Grouped 1, InsetGrouped 2. A `Data` table is the
// plain one — rows with nothing around them; the other three are the settings
// shapes iOS draws with an inset card per section, which is what `Form`,
// `Menu` and `Settings` describe.
fn table_style_of(s: vocab::TableStyle) -> i64 {
    return match s {
        vocab::TableStyle::Data => 0 as i64,
        vocab::TableStyle::Form => 2 as i64,
        vocab::TableStyle::Menu => 1 as i64,
        vocab::TableStyle::Settings => 2 as i64,
    };
}

fn apply_recycling_table(v: *u8, n: *core::Node, dirty: u64) {
    apply_recycling_list(v, n, dirty);
    let p: *props::TableProps = props_of(n, props::K_TABLE) as *props::TableProps;
    if p == (0 as *props::TableProps) { return; }
    // THE STYLE WAS SPENT AT CREATE. `initWithFrame:style:` is the only place
    // UITableViewStyle can be said and there is no setter, so a style CHANGED
    // after the table is mounted has nowhere to land — the view would have to
    // be replaced, and the view is mount's rather than this module's.
    //
    // Named rather than left silent: the bit arrives, and a reader following
    // `table::P_STYLE` should find the sentence instead of nothing.
    if (dirty & table::P_STYLE) != (0 as u64) && dirty != paint::all_bits() {
        // Nothing to do. See above; MANIFEST.md §3 records it.
    }
    // Uneven rows means "ask the delegate", which UIKit spells as the automatic
    // dimension — a negative sentinel, not a height. A fixed height is the
    // other answer, and the two are exclusive.
    if (dirty & (table::P_HAS_UNEVEN_ROWS | table::P_ROW_HEIGHT)) != (0 as u64) {
        if { (*p).has_uneven_rows } {
            { rt::msg_void_f64(v, rt::sel(#str_ptr("setRowHeight:\0")),
                               automatic_dimension()) };
        } else {
            let h: i64 = { (*p).row_height };
            if h > (0 as i64) {
                { rt::msg_void_f64(v, rt::sel(#str_ptr("setRowHeight:\0")), h as f64) };
            }
        }
    }
    return;
}

// UITableViewAutomaticDimension. A named constant in the SDK and a plain -1
// in the ABI, which is what a C+ binding can say.
fn automatic_dimension() -> f64 { return -1.0f64; }

#[link_name = "class_addMethod"]
extern fn add_method_i64_id_i64(cls: *u8, sel: *u8, imp: fn(*u8, *u8, *u8, i64) -> i64,
                                types: *u8) -> i8;
#[link_name = "class_addMethod"]
extern fn add_method_f64_2id(cls: *u8, sel: *u8, imp: fn(*u8, *u8, *u8, *u8) -> f64,
                             types: *u8) -> i8;
#[link_name = "objc_msgSend"]
extern fn msg_id_i64_id(recv: *u8, sel: *u8, a: i64, b: *u8) -> *u8;
#[link_name = "objc_msgSend"]
extern fn msg_id_rect_i64(recv: *u8, sel: *u8, r: rt::Rect, a: i64) -> *u8;
#[link_name = "objc_msgSend"]
extern fn msg_id_i64_i64(recv: *u8, sel: *u8, a: i64, b: i64) -> *u8;
#[link_name = "objc_msgSend"]
extern fn msg_void_id_i64(recv: *u8, sel: *u8, a: *u8, b: i64);
#[link_name = "objc_msgSend"]
extern fn msg_void_id_i8(recv: *u8, sel: *u8, a: *u8, b: i8);
#[link_name = "objc_msgSend"]
extern fn msg_void_id_i64_i8(recv: *u8, sel: *u8, a: *u8, b: i64, c: i8);
#[link_name = "objc_msgSend"]
extern fn msg_void_id_i8_i64(recv: *u8, sel: *u8, a: *u8, b: i8, c: i64);

// ---- tree ------------------------------------------------------------------------------
// A tree is a list of the OPEN rows. That is not a simplification — it is what a
// UITableView can show, and it is what facet_appkit does with an NSOutlineView
// underneath as well: the model is a tree, the presentation is the flattened
// sequence of everything currently expanded.
//
// The flattening is recomputed whenever the model or the expansion changes, and
// held so the data source can answer by index without walking the tree per row.

static TREE_FLAT: vec::Vec[*tree::TreeNode] = #zero::[vec::Vec[*tree::TreeNode]]();
static TREE_DEPTH: vec::Vec[i64] = #zero::[vec::Vec[i64]]();
static TREE_OWNER: *core::Node = 0 as *core::Node;

fn tree_props(tv: *u8) -> *tree::TreeProps {
    let n: *core::Node = input::node_of(tv);
    if n == (0 as *core::Node) { return 0 as *tree::TreeProps; }
    return props_of(n, tree::K_TREE) as *tree::TreeProps;
}

// Is this node expanded? facet carries the open set as a list of ids, which is
// what survives a rebuild of the model — an index would not.
// EXPANSION IS KEYED ON THE NODE'S OWN `id`, not on `row_id`.
//
// `row_id` is what a row is TAGGED with for an agent to find it by; a node's
// `id` is what it IS, and it is what `Tree::expand` was handed. Reading the
// wrong one meant nothing ever matched, so `expand` was a no-op and the
// gallery's catalog opened as seven collapsed sections with no way to open
// them. facet_appkit's `is_expanded` is this same three lines.
fn tree_is_expanded(p: *tree::TreeProps, node: *tree::TreeNode) -> bool {
    let id: str = { (*node).id.view() };
    if id == "" { return false; }
    let open: *vocab::TextList = { #addr_of((*p).expanded) };
    var i: usize = 0 as usize;
    let n: usize = { (*open).count() };
    while i < n {
        if { (*open).at(i) } == id { return true; }
        i = i +% (1 as usize);
    }
    return false;
}

fn flatten_tree(n: *core::Node) {
    let p: *tree::TreeProps = props_of(n, tree::K_TREE) as *tree::TreeProps;
    if p == (0 as *tree::TreeProps) { return; }
    TREE_FLAT = vec::new::[*tree::TreeNode]();
    TREE_DEPTH = vec::new::[i64]();
    TREE_OWNER = n;
    let root: *tree::TreeNode = { #addr_of((*p).root) };
    // The root itself is a holder, not a row — its children are the top level.
    flatten_children(p, root, 0 as i64);
    return;
}

fn flatten_children(p: *tree::TreeProps, node: *tree::TreeNode, depth: i64) {
    var i: usize = 0 as usize;
    let n: usize = { (*node).child_count() };
    while i < n {
        match { (*node).child_ptr(i) } {
            option::Option[*tree::TreeNode]::Some(c) => {
                let _a: status::Status = TREE_FLAT.append(c);
                let _b: status::Status = TREE_DEPTH.append(depth);
                if tree_is_expanded(p, c) { flatten_children(p, c, depth + (1 as i64)); }
            }
            option::Option[*tree::TreeNode]::None => { }
        }
        i = i +% (1 as usize);
    }
    return;
}

// A tree with no row builder still shows its shape: the node's own text. A
// tree that rendered blank rows would be indistinguishable from one whose model
// is empty, and the two are very different problems.
//
// STATED height, not the label's intrinsic one: a table asks for a row's height
// before that row is realised, and an unrealised label measures at zero.
fn plain_tree_row(node: *tree::TreeNode) -> core::Node {
    return label::label({ (*node).label.view() },
                        key: { (*node).id.view() },
                        max_lines: 1 as i64,
                        line_break: vocab::LineBreak::TailTruncation)
           .height(20.0f64);
}

fn create_recycling_tree(n: *core::Node) -> *u8 {
    let cls: *u8 = rt::get_class(#str_ptr("UITableView\0"));
    if cls == (0 as *u8) { return 0 as *u8; }
    let alloced: *u8 = { rt::msg_id(cls, rt::sel(#str_ptr("alloc\0"))) };
    if alloced == (0 as *u8) { return 0 as *u8; }
    let zero: rt::Rect = rt::Rect { x: 0.0f64, y: 0.0f64, w: 0.0f64, h: 0.0f64 };
    let v: *u8 = { msg_id_rect_i64(alloced, rt::sel(#str_ptr("initWithFrame:style:\0")),
                                   zero, 0 as i64) };
    if v == (0 as *u8) { return 0 as *u8; }
    input::bind_node(v, n);
    let ds: *u8 = tree_source();
    if ds != (0 as *u8) {
        { rt::msg_void_id(v, rt::sel(#str_ptr("setDataSource:\0")), ds) };
        { rt::msg_void_id(v, rt::sel(#str_ptr("setDelegate:\0")), ds) };
    }
    return v;
}

fn apply_recycling_tree(v: *u8, n: *core::Node, dirty: u64) {
    let p: *tree::TreeProps = props_of(n, tree::K_TREE) as *tree::TreeProps;
    if p == (0 as *tree::TreeProps) { return; }
    if (dirty & tree::P_ROW_HEIGHT) != (0 as u64) {
        let h: f64 = { (*p).row_height };
        if h > 0.0f64 { { rt::msg_void_f64(v, rt::sel(#str_ptr("setRowHeight:\0")), h) }; }
    }
    // The model or the open set changed: the flattening is what the table reads,
    // so it is rebuilt before the reload rather than lazily during it.
    if (dirty & (tree::P_ROOT | tree::P_EXPANDED | tree::P_ROW | tree::P_ROW_ID)) != (0 as u64) {
        flatten_tree(n);
        { rt::msg_void(v, rt::sel(#str_ptr("reloadData\0"))) };
    }
    // The selection is named by ID, not by index, and deliberately: the row a
    // tree selects has to survive the row above it opening. So it is looked up
    // in the flattening AFTER the reload — the ordering matters, because a
    // selection applied to rows that no longer exist selects nothing.
    if (dirty & (tree::P_SELECTED | tree::P_ROOT | tree::P_EXPANDED)) != (0 as u64) {
        select_tree_by_id(v, n, { (*p).selected.view() });
    }
    return;
}

// The flattened row whose `row_id` matches, selected; nothing selected when the
// id names no open row, which is the honest answer to "select something that is
// not currently on screen".
fn select_tree_by_id(v: *u8, n: *core::Node, id: str) {
    if TREE_OWNER != n { flatten_tree(n); }
    if id == "" {
        let sel: *u8 = { rt::msg_id(v, rt::sel(#str_ptr("indexPathForSelectedRow\0"))) };
        if sel != (0 as *u8) {
            { msg_void_id_i8(v, rt::sel(#str_ptr("deselectRowAtIndexPath:animated:\0")),
                             sel, 0 as i8) };
        }
        return;
    }
    let p: *tree::TreeProps = props_of(n, tree::K_TREE) as *tree::TreeProps;
    if p == (0 as *tree::TreeProps) { return; }
    let idf: fn(*tree::TreeNode, *u8) -> text::Text = { (*p).row_id };
    if idf == (0 as fn(*tree::TreeNode, *u8) -> text::Text) { return; }
    var i: usize = 0 as usize;
    let count: usize = TREE_FLAT.count();
    while i < count {
        match TREE_FLAT.at(i) {
            option::Option[*tree::TreeNode]::Some(node) => {
                let this_id: text::Text = idf(node, { (*p).row_ctx });
                if { this_id.view() } == id {
                    select_row(v, i as i64);
                    return;
                }
            }
            option::Option[*tree::TreeNode]::None => { }
        }
        i = i +% (1 as usize);
    }
    return;
}

// The tree's own data source. Separate from the list's because the row it
// builds takes a TreeNode, not an index — the same recycling, a different
// callback shape.
static TS_CLASS: *u8 = 0 as *u8;
static TS: *u8 = 0 as *u8;

fn imp_tree_rows(self_obj: *u8, cmd: *u8, tv: *u8, section: i64) -> i64 {
    let n: *core::Node = input::node_of(tv);
    if n == (0 as *core::Node) { return 0 as i64; }
    if TREE_OWNER != n { flatten_tree(n); }
    return TREE_FLAT.count() as i64;
}

// THE ROW'S NAME ON THE AGENT SURFACE, and the AppKit backend's `tag_tree_row`
// is the same function for the same reason — this one was simply never written.
//
// A tree row is the one control an application cannot key. The row it builds is
// CONTENT, mounted inside a cell THIS file makes and owns, so no application
// key ever lands on the cell — and the cell is the node an agent has to name,
// because selecting it is what fires `on_select`. Without this the gallery's
// catalog is a list an agent can see and cannot enter: `describe_ui` answers
// `g:catalog` and thirty anonymous groups under it, none of them addressable.
//
// The id is the accessibilityIdentifier, which is what a key already is
// everywhere else in this backend (`views::create`): one token for facet's
// address, the agent surface's id and the platform's a11y id. No dependency on
// the agent packages falls out of that, which is the point.
//
// SET ON EVERY PASS, including to empty. The cell pool is recycled, so a cell
// that kept the id of the row it used to hold would answer to a name that is
// now somewhere else on screen — the one failure that is worse than no id at
// all, because it looks like it worked.
fn tag_tree_row(p: *tree::TreeProps, node: *tree::TreeNode, cell: *u8) {
    if cell == (0 as *u8) { return; }
    if node == (0 as *tree::TreeNode) { return; }
    let f: fn(*tree::TreeNode, *u8) -> text::Text = { (*p).row_id };
    // Against `no_row_id` by NAME, like every other absent handler here.
    if f == tree::no_row_id { return; }
    let id: text::Text = f(node, { (*p).row_id_ctx });
    { rt::msg_void_id(cell, rt::sel(#str_ptr("setAccessibilityIdentifier:\0")),
                      bridge::nsstring({ id.view() })) };
    return;
}

fn imp_tree_cell(self_obj: *u8, cmd: *u8, tv: *u8, index_path: *u8) -> *u8 {
    let n: *core::Node = input::node_of(tv);
    if n == (0 as *core::Node) { return 0 as *u8; }
    let p: *tree::TreeProps = tree_props(tv);
    if p == (0 as *tree::TreeProps) { return 0 as *u8; }
    let row: i64 = { rt::msg_i64(index_path, rt::sel(#str_ptr("row\0"))) };
    if row < (0 as i64) || (row as usize) >= TREE_FLAT.count() { return 0 as *u8; }
    var cell: *u8 = { rt::msg_id_id(tv, rt::sel(#str_ptr("dequeueReusableCellWithIdentifier:\0")),
                                    bridge::nsstring("facet.tree.row")) };
    if cell == (0 as *u8) {
        let cls: *u8 = rt::get_class(#str_ptr("UITableViewCell\0"));
        let alloced: *u8 = { rt::msg_id(cls, rt::sel(#str_ptr("alloc\0"))) };
        if alloced == (0 as *u8) { return 0 as *u8; }
        cell = { msg_id_i64_id(alloced, rt::sel(#str_ptr("initWithStyle:reuseIdentifier:\0")),
                               0 as i64, bridge::nsstring("facet.tree.row")) };
        if cell == (0 as *u8) { return 0 as *u8; }
        { rt::msg_void_id(cell, rt::sel(#str_ptr("setBackgroundColor:\0")), 0 as *u8) };
    }
    clear_cell(cell);
    // COMPARED AGAINST `no_row`, NOT AGAINST NULL. The default is a real
    // function that answers an empty node, so a null check is never false and
    // the fallback never ran — a tree with no row builder rendered a column of
    // empty rows, which is exactly what the gallery's catalog showed. The
    // AppKit backend carries this comment too, and this backend earned its own
    // copy by making the same mistake.
    let build: fn(*tree::TreeNode, *u8) -> flex::Node = { (*p).row };
    match TREE_FLAT.at_ptr(row as usize) {
        option::Option[**tree::TreeNode]::Some(slot) => {
            let node: *tree::TreeNode = { (*slot) };
            tag_tree_row(p, node, cell);
            let content: *u8 = { rt::msg_id(cell, rt::sel(#str_ptr("contentView\0"))) };
            if content == (0 as *u8) { return cell; }
            var built: core::Node = plain_tree_row(node);
            if build != tree::no_row { built = build(node, { (*p).row_ctx }); }
            match box::new::[core::Node](built) {
                option::Option[box::Box[core::Node]]::Some(b) => {
                    let root: *core::Node = b.into_raw() as *core::Node;
                    let bind: fn(*tree::TreeNode, *u8, *flex::Node) = { (*p).bind };
                    if bind != (0 as fn(*tree::TreeNode, *u8, *flex::Node)) {
                        bind(node, { (*p).row_ctx }, root);
                    }
                    // 0 is a viewless root, not a failure — see `fill_cell`.
                    let rv: *u8 = mount::realise(root);
                    if rv != (0 as *u8) {
                        ui::View::from_raw(content).add_subview(ui::View::from_raw(rv));
                    } else {
                        add_backed(ui::View::from_raw(content), root);
                    }
                    synth::set_associated(cell, cell_root_key(), root as *u8);
                    // A BRANCH SAYS SO. With the rows flattened there is no
                    // triangle, so the section carries UITableViewCell's own
                    // disclosure accessory (1) and a leaf carries none (0) —
                    // which is what makes "tap me to open" visible rather than
                    // something a reader has to discover.
                    var accessory: i64 = 0 as i64;
                    if { (*node).is_branch } { accessory = 1 as i64; }
                    { rt::msg_void_i64(cell, rt::sel(#str_ptr("setAccessoryType:\0")),
                                       accessory) };
                    // THE INDENT is the tree's own geometry, and it is the one
                    // thing a flattened list has to carry that a list does not.
                    var depth: i64 = 0 as i64;
                    match TREE_DEPTH.at_ptr(row as usize) {
                        option::Option[*i64]::Some(d) => { depth = { (*d) }; }
                        option::Option[*i64]::None => { }
                    }
                    indent_cell(cell, root, depth);
                }
                option::Option[box::Box[core::Node]]::None => { }
            }
        }
        option::Option[**tree::TreeNode]::None => { }
    }
    return cell;
}

// A row at depth `d` starts `d` steps in. The step is the platform's own
// indentation width, so a facet tree looks like every other iOS tree.
fn indent_cell(cell: *u8, root: *core::Node, depth: i64) {
    let content: *u8 = { rt::msg_id(cell, rt::sel(#str_ptr("contentView\0"))) };
    if content == (0 as *u8) { return; }
    let b: rt::Rect = ui::View::from_raw(content).bounds();
    if b.w <= 0.0f64 { return; }
    let step: f64 = 16.0f64;
    let x: f64 = (depth as f64) * step;
    let w: f64 = b.w - x;
    if w <= 0.0f64 { return; }
    geometry::relayout_root(root, w, b.h, geometry::screen_scale());
    let rv: *u8 = core::view_of(root);
    if rv != (0 as *u8) {
        geometry::set_view_frame(rv, rt::Rect { x: x, y: 0.0f64, w: w, h: b.h });
    }
    return;
}

// Tapping a row selects it AND toggles its branch — which is what a tree row
// does everywhere, and why `on_select` and the open set move together.
fn imp_tree_select(self_obj: *u8, cmd: *u8, tv: *u8, index_path: *u8) {
    let n: *core::Node = input::node_of(tv);
    if n == (0 as *core::Node) { return; }
    let p: *tree::TreeProps = tree_props(tv);
    if p == (0 as *tree::TreeProps) { return; }
    let row: i64 = { rt::msg_i64(index_path, rt::sel(#str_ptr("row\0"))) };
    if row < (0 as i64) || (row as usize) >= TREE_FLAT.count() { return; }
    match TREE_FLAT.at_ptr(row as usize) {
        option::Option[**tree::TreeNode]::Some(slot) => {
            let node: *tree::TreeNode = { (*slot) };
            // A BRANCH TOGGLES. Selection is the only tap a leaf row has, but a
            // section already has one that means something else — and with the
            // rows flattened into a table there is no disclosure triangle to
            // hit instead, so the row IS the control. facet_appkit's outline
            // view reaches the same rule from the other direction.
            if { (*node).is_branch } {
                toggle_branch(tv, n, p, node);
                { msg_void_id_i8(tv, rt::sel(#str_ptr("deselectRowAtIndexPath:animated:\0")),
                                 index_path, 1 as i8) };
                return;
            }
            let idf: fn(*tree::TreeNode, *u8) -> text::Text = { (*p).row_id };
            if idf != tree::no_row_id {
                { (*p).selected = idf(node, { (*p).row_id_ctx }) };
            }
            let h: fn(*tree::TreeNode, *u8) = { (*p).on_select };
            if h != tree::no_select { h(node, { (*p).on_select_ctx }); }
        }
        option::Option[**tree::TreeNode]::None => { }
    }
    { msg_void_id_i8(tv, rt::sel(#str_ptr("deselectRowAtIndexPath:animated:\0")),
                     index_path, 1 as i8) };
    return;
}

// Open a closed section or close an open one, then rebuild what the table
// reads. The model is written through facet's own `Tree` handle rather than
// into the props directly, so the expansion an application observes is the one
// a tap produced.
fn toggle_branch(tv: *u8, owner: *core::Node, p: *tree::TreeProps,
                 node: *tree::TreeNode) {
    let id: str = { (*node).id.view() };
    if id == "" { return; }
    match tree::from(owner) {
        option::Option[tree::Tree]::Some(t) => {
            if tree_is_expanded(p, node) { let _c: tree::Tree = t.collapse(id); }
            else { let _e: tree::Tree = t.expand(id); }
        }
        option::Option[tree::Tree]::None => { return; }
    }
    flatten_tree(owner);
    { rt::msg_void(tv, rt::sel(#str_ptr("reloadData\0"))) };
    return;
}

fn tree_source() -> *u8 {
    if TS != (0 as *u8) { return TS; }
    if TS_CLASS == (0 as *u8) {
        let existing: *u8 = rt::get_class(#str_ptr("FacetUIKitTreeSource\0"));
        if existing != (0 as *u8) {
            TS_CLASS = existing;
        } else {
            let base: *u8 = rt::get_class(#str_ptr("NSObject\0"));
            let cls: *u8 = { synth::allocate_class_pair(base,
                #str_ptr("FacetUIKitTreeSource\0"), 0 as usize) };
            if cls == (0 as *u8) { return 0 as *u8; }
            let _a: i8 = add_method_i64_id_i64(cls,
                rt::sel(#str_ptr("tableView:numberOfRowsInSection:\0")),
                imp_tree_rows, #str_ptr("q@:@q\0"));
            let _b: i8 = synth::add_method_id_2id(cls,
                rt::sel(#str_ptr("tableView:cellForRowAtIndexPath:\0")),
                imp_tree_cell, #str_ptr("@@:@@\0"));
            let _c: i8 = synth::add_method_v_2id(cls,
                rt::sel(#str_ptr("tableView:didSelectRowAtIndexPath:\0")),
                imp_tree_select, #str_ptr("v@:@@\0"));
            let _d: i8 = synth::add_method_v_3id(cls,
                rt::sel(#str_ptr("tableView:didEndDisplayingCell:forRowAtIndexPath:\0")),
                imp_did_end_displaying, #str_ptr("v@:@@@\0"));
            { synth::register_class_pair(cls) };
            TS_CLASS = cls;
        }
    }
    TS = { synth::alloc_init_class(TS_CLASS) };
    return TS;
}

// ---- collection and carousel -----------------------------------------------------------
// A UICollectionView with a flow layout. The difference from a list is the
// LAYOUT, not the recycling: the same build-mount-drop rule per cell, the same
// one-source-per-process rule, and a flow layout that answers item sizes.
//
// A CAROUSEL is the same view, laid out horizontally with paging on. facet
// keeps them separate kinds because they mean different things to an app; the
// backend keeps one implementation because they are one control.

static CV_CLASS: *u8 = 0 as *u8;
static CV: *u8 = 0 as *u8;

fn collection_props(cv: *u8) -> *props::CollectionProps {
    let n: *core::Node = input::node_of(cv);
    if n == (0 as *core::Node) { return 0 as *props::CollectionProps; }
    return props_of(n, props::K_COLLECTION) as *props::CollectionProps;
}

fn carousel_props(cv: *u8) -> *props::CarouselProps {
    let n: *core::Node = input::node_of(cv);
    if n == (0 as *core::Node) { return 0 as *props::CarouselProps; }
    return props_of(n, props::K_CAROUSEL) as *props::CarouselProps;
}

// Both kinds answer "how many" and "build one", so the source asks the node
// rather than assuming which kind it is.
fn items_count(cv: *u8) -> i64 {
    let n: *core::Node = input::node_of(cv);
    if n == (0 as *core::Node) { return 0 as i64; }
    let k: u32 = core::kind_of(n);
    if k == props::K_COLLECTION {
        let p: *props::CollectionProps = collection_props(cv);
        if p == (0 as *props::CollectionProps) { return 0 as i64; }
        return { (*p).count };
    }
    // A carousel carries no count of its own: its pages are the CHILDREN facet
    // put under it, which is what its `structured_items_view` record describes.
    if k == props::K_CAROUSEL {
        return core::child_count_of(n) as i64;
    }
    return 0 as i64;
}

fn imp_cv_count(self_obj: *u8, cmd: *u8, cv: *u8, section: i64) -> i64 {
    return items_count(cv);
}

fn imp_cv_cell(self_obj: *u8, cmd: *u8, cv: *u8, index_path: *u8) -> *u8 {
    let n: *core::Node = input::node_of(cv);
    if n == (0 as *core::Node) { return 0 as *u8; }
    let row: i64 = { rt::msg_i64(index_path, rt::sel(#str_ptr("row\0"))) };
    // A collection view REQUIRES its cell class to be registered, and answers a
    // cell rather than nil — so there is no create-if-missing branch here; the
    // registration happens once at construction.
    let cell: *u8 = { msg_id_id_id(cv,
        rt::sel(#str_ptr("dequeueReusableCellWithReuseIdentifier:forIndexPath:\0")),
        bridge::nsstring("facet.item"), index_path) };
    if cell == (0 as *u8) { return 0 as *u8; }
    fill_item_cell(cell, n, row as usize);
    return cell;
}

// The same build-mount-drop as a table cell; the callback differs only in which
// props record it comes from.
fn fill_item_cell(cell: *u8, n: *core::Node, i: usize) {
    clear_cell(cell);
    let content: *u8 = { rt::msg_id(cell, rt::sel(#str_ptr("contentView\0"))) };
    if content == (0 as *u8) { return; }
    let k: u32 = core::kind_of(n);
    var build: fn(usize, *u8) -> flex::Node = 0 as fn(usize, *u8) -> flex::Node;
    var ctx: *u8 = 0 as *u8;
    if k == props::K_COLLECTION {
        let p: *props::CollectionProps = props_of(n, props::K_COLLECTION) as *props::CollectionProps;
        if p == (0 as *props::CollectionProps) { return; }
        build = { (*p).row };
        ctx = { (*p).row_ctx };
    } else if k == props::K_CAROUSEL {
        // A carousel's page is the node's own child, already built — it is
        // moved into the cell rather than rebuilt, because facet owns it.
        match core::child_of(n, i) {
            option::Option[*core::Node]::Some(c) => {
                let v: *u8 = core::view_of(c);
                if v != (0 as *u8) {
                    ui::View::from_raw(content).add_subview(ui::View::from_raw(v));
                }
            }
            option::Option[*core::Node]::None => { }
        }
        return;
    }
    if build == (0 as fn(usize, *u8) -> flex::Node) { return; }
    match box::new::[core::Node](build(i, ctx)) {
        option::Option[box::Box[core::Node]]::Some(b) => {
            let root: *core::Node = b.into_raw() as *core::Node;
            // `realise` ANSWERS THE ROOT'S VIEW, AND 0 IS NOT FAILURE.
            //
            // A row built as `ui::row(...)` is an unkeyed pure-layout node and
            // gets no view of its own — its children carry the views — so 0 is
            // the ORDINARY answer for a row, not an error. Reading it as a
            // success flag (`realise(root) != 0`) skipped both branches and put
            // nothing in the cell: every recycled row in the package rendered
            // as an empty cell with a separator under it.
            //
            // Which is what `add_backed` exists for, and it was already written.
            let rv: *u8 = mount::realise(root);
            if rv != (0 as *u8) {
                ui::View::from_raw(content).add_subview(ui::View::from_raw(rv));
            } else {
                add_backed(ui::View::from_raw(content), root);
            }
            synth::set_associated(cell, cell_root_key(), root as *u8);
            layout_cell(cell, root);
        }
        option::Option[box::Box[core::Node]]::None => { }
    }
    return;
}

fn imp_cv_will_display(self_obj: *u8, cmd: *u8, cv: *u8, cell: *u8, index_path: *u8) {
    let n: *core::Node = input::node_of(cv);
    if n == (0 as *core::Node) { return; }
    let row: i64 = { rt::msg_i64(index_path, rt::sel(#str_ptr("item\0"))) };
    let p: *props::CollectionProps =
        props_of(n, props::K_COLLECTION) as *props::CollectionProps;
    if p != (0 as *props::CollectionProps) {
        note_row_shown(cv, { #addr_of((*p).items_view) }, row, items_count(cv));
        return;
    }
    let c: *props::CarouselProps =
        props_of(n, props::K_CAROUSEL) as *props::CarouselProps;
    if c != (0 as *props::CarouselProps) {
        note_row_shown(cv, { #addr_of((*c).items_view) }, row, items_count(cv));
    }
    return;
}

fn imp_cv_did_end(self_obj: *u8, cmd: *u8, cv: *u8, cell: *u8, index_path: *u8) {
    clear_cell(cell);
    return;
}

fn imp_cv_select(self_obj: *u8, cmd: *u8, cv: *u8, index_path: *u8) {
    let n: *core::Node = input::node_of(cv);
    if n == (0 as *core::Node) { return; }
    let row: i64 = { rt::msg_i64(index_path, rt::sel(#str_ptr("row\0"))) };
    if core::kind_of(n) == props::K_COLLECTION {
        let p: *props::CollectionProps = collection_props(cv);
        if p == (0 as *props::CollectionProps) { return; }
        { (*p).selected_index = row };
        // Selection lives in the SELECTABLE record the collection embeds —
        // facet splits an items view into the traits it has rather than one
        // flat struct, and the handler is that record's.
        let sel: *props::SelectableItemsViewProps = { #addr_of((*p).selectable_items_view) };
        let h: fn(*u8, *u8) = { (*sel).on_selection_changed };
        if h != (0 as fn(*u8, *u8)) { h(cv, { (*sel).on_selection_changed_ctx }); }
    }
    return;
}

// ---- reordering --------------------------------------------------------------
// `CanReorderItems` is whether an item may be dragged at all; `CanMixGroups` is
// whether it may land in another one. UIKit asks both questions through the
// data source, so both are answered here rather than written onto the view.

fn imp_cv_can_move(self_obj: *u8, cmd: *u8, cv: *u8, index_path: *u8) -> i8 {
    let n: *core::Node = input::node_of(cv);
    if n == (0 as *core::Node) { return 0 as i8; }
    let p: *props::CollectionProps =
        props_of(n, props::K_COLLECTION) as *props::CollectionProps;
    if p == (0 as *props::CollectionProps) { return 0 as i8; }
    return bool_i8({ (*p).reorderable_items_view.can_reorder_items });
}

fn imp_cv_move(self_obj: *u8, cmd: *u8, cv: *u8, from: *u8, to: *u8) {
    let n: *core::Node = input::node_of(cv);
    if n == (0 as *core::Node) { return; }
    let p: *props::CollectionProps =
        props_of(n, props::K_COLLECTION) as *props::CollectionProps;
    if p == (0 as *props::CollectionProps) { return; }
    let a: i64 = { rt::msg_i64(from, rt::sel(#str_ptr("item\0"))) };
    let b: i64 = { rt::msg_i64(to, rt::sel(#str_ptr("item\0"))) };
    if a < (0 as i64) || b < (0 as i64) || a == b { return; }
    // Without `CanMixGroups` a row stays in the group it started in, which is
    // what makes a grouped sequence stay grouped. The sections are UIKit's own
    // here, so the comparison is between the paths rather than a walk.
    if !can_mix_groups(cv) {
        let sa: i64 = { rt::msg_i64(from, rt::sel(#str_ptr("section\0"))) };
        let sb: i64 = { rt::msg_i64(to, rt::sel(#str_ptr("section\0"))) };
        if sa != sb {
            { rt::msg_void(cv, rt::sel(#str_ptr("reloadData\0"))) };
            return;
        }
    }
    match mount::remove_child(n, a as usize) {
        option::Option[core::Node]::Some(moved) => {
            let _ok: bool = mount::insert_child(n, moved, b as usize);
        }
        option::Option[core::Node]::None => { return; }
    }
    { (*p).reorder_from = a };
    { (*p).reorder_to = b };
    let h: fn(*u8, *u8) = { (*p).reorderable_items_view.on_reorder_completed };
    if h != props::no_handler {
        h(cv, { (*p).reorderable_items_view.on_reorder_completed_ctx });
    }
    return;
}

// THE GESTURE, which UIKit does not install on a bare collection view.
// `UICollectionViewController` installs one for you and nothing else does — so
// a collection built from a plain view answers `canMoveItemAtIndexPath:` and
// then never moves anything, which is the shape this would have had.
fn imp_item_drag(self_obj: *u8, cmd: *u8, g: *u8) {
    let cv: *u8 = { rt::msg_id(g, rt::sel(#str_ptr("view\0"))) };
    if cv == (0 as *u8) { return; }
    let state: i64 = { rt::msg_i64(g, rt::sel(#str_ptr("state\0"))) };
    let pt: rt::Point = { msg_point_id(g, rt::sel(#str_ptr("locationInView:\0")), cv) };
    if state == (1 as i64) {
        let ip: *u8 = { msg_id_point(cv, rt::sel(#str_ptr("indexPathForItemAtPoint:\0")), pt) };
        if ip == (0 as *u8) { return; }
        { rt::msg_void_id(cv,
            rt::sel(#str_ptr("beginInteractiveMovementForItemAtIndexPath:\0")), ip) };
        return;
    }
    if state == (2 as i64) {
        { msg_void_point(cv,
            rt::sel(#str_ptr("updateInteractiveMovementTargetPosition:\0")), pt) };
        return;
    }
    if state == (3 as i64) {
        { rt::msg_void(cv, rt::sel(#str_ptr("endInteractiveMovement\0"))) };
        return;
    }
    { rt::msg_void(cv, rt::sel(#str_ptr("cancelInteractiveMovement\0"))) };
    return;
}

fn drag_gesture_key() -> *u8 { return 41014 as *u8; }

// Installed once and left in place; `canMoveItemAtIndexPath:` is what actually
// decides whether a press moves anything, so a collection that stops reordering
// stops moving without the recogniser having to come off.
fn install_drag_gesture(v: *u8) {
    if { synth::get_associated(v, drag_gesture_key()) } != (0 as *u8) { return; }
    let src: *u8 = collection_source();
    if src == (0 as *u8) { return; }
    let cls: *u8 = rt::get_class(#str_ptr("UILongPressGestureRecognizer\0"));
    if cls == (0 as *u8) { return; }
    let alloced: *u8 = { rt::msg_id(cls, rt::sel(#str_ptr("alloc\0"))) };
    if alloced == (0 as *u8) { return; }
    let g: *u8 = { msg_id_id_sel(alloced, rt::sel(#str_ptr("initWithTarget:action:\0")),
                                 src, rt::sel(#str_ptr("facetItemDrag:\0"))) };
    if g == (0 as *u8) { return; }
    { rt::msg_void_id(v, rt::sel(#str_ptr("addGestureRecognizer:\0")), g) };
    synth::set_associated(v, drag_gesture_key(), g);
    { rt::release(g) };
    return;
}

fn collection_source() -> *u8 {
    if CV != (0 as *u8) { return CV; }
    if CV_CLASS == (0 as *u8) {
        let existing: *u8 = rt::get_class(#str_ptr("FacetUIKitItemsSource\0"));
        if existing != (0 as *u8) {
            CV_CLASS = existing;
        } else {
            let base: *u8 = rt::get_class(#str_ptr("NSObject\0"));
            let cls: *u8 = { synth::allocate_class_pair(base,
                #str_ptr("FacetUIKitItemsSource\0"), 0 as usize) };
            if cls == (0 as *u8) { return 0 as *u8; }
            let _a: i8 = add_method_i64_id_i64(cls,
                rt::sel(#str_ptr("collectionView:numberOfItemsInSection:\0")),
                imp_cv_count, #str_ptr("q@:@q\0"));
            let _b: i8 = synth::add_method_id_2id(cls,
                rt::sel(#str_ptr("collectionView:cellForItemAtIndexPath:\0")),
                imp_cv_cell, #str_ptr("@@:@@\0"));
            let _c: i8 = synth::add_method_v_3id(cls,
                rt::sel(#str_ptr("collectionView:didEndDisplayingCell:forItemAtIndexPath:\0")),
                imp_cv_did_end, #str_ptr("v@:@@@\0"));
            let _d: i8 = synth::add_method_v_2id(cls,
                rt::sel(#str_ptr("collectionView:didSelectItemAtIndexPath:\0")),
                imp_cv_select, #str_ptr("v@:@@\0"));
            let _e: i8 = add_method_i8_2id(cls,
                rt::sel(#str_ptr("collectionView:canMoveItemAtIndexPath:\0")),
                imp_cv_can_move, #str_ptr("c@:@@\0"));
            let _f: i8 = synth::add_method_v_3id(cls,
                rt::sel(#str_ptr("collectionView:moveItemAtIndexPath:toIndexPath:\0")),
                imp_cv_move, #str_ptr("v@:@@@\0"));
            let _g: i8 = synth::add_method_v_1id(cls,
                rt::sel(#str_ptr("facetItemDrag:\0")),
                imp_item_drag, #str_ptr("v@:@\0"));
            let _h: i8 = synth::add_method_v_1id(cls,
                rt::sel(#str_ptr("scrollViewDidScroll:\0")),
                imp_scrolled, #str_ptr("v@:@\0"));
            let _i: i8 = synth::add_method_v_3id(cls,
                rt::sel(#str_ptr("collectionView:willDisplayCell:forItemAtIndexPath:\0")),
                imp_cv_will_display, #str_ptr("v@:@@@\0"));
            { synth::register_class_pair(cls) };
            CV_CLASS = cls;
        }
    }
    CV = { synth::alloc_init_class(CV_CLASS) };
    return CV;
}

// The flow layout, which is where a collection and a carousel differ.
fn make_flow(horizontal: bool) -> *u8 {
    let layout: *u8 = { rt::alloc_init(#str_ptr("UICollectionViewFlowLayout\0")) };
    if layout == (0 as *u8) { return 0 as *u8; }
    // 0 vertical, 1 horizontal.
    var dir: i64 = 0 as i64;
    if horizontal { dir = 1 as i64; }
    { rt::msg_void_i64(layout, rt::sel(#str_ptr("setScrollDirection:\0")), dir) };
    return layout;
}

fn make_items_view(n: *core::Node, horizontal: bool) -> *u8 {
    let layout: *u8 = make_flow(horizontal);
    if layout == (0 as *u8) { return 0 as *u8; }
    let cls: *u8 = rt::get_class(#str_ptr("UICollectionView\0"));
    if cls == (0 as *u8) { return 0 as *u8; }
    let alloced: *u8 = { rt::msg_id(cls, rt::sel(#str_ptr("alloc\0"))) };
    if alloced == (0 as *u8) { { rt::release(layout) }; return 0 as *u8; }
    let zero: rt::Rect = rt::Rect { x: 0.0f64, y: 0.0f64, w: 0.0f64, h: 0.0f64 };
    let v: *u8 = { msg_id_rect_id(alloced,
        rt::sel(#str_ptr("initWithFrame:collectionViewLayout:\0")), zero, layout) };
    { rt::release(layout) };
    if v == (0 as *u8) { return 0 as *u8; }
    // The registration a collection view requires before it will dequeue.
    { msg_void_id_id(v, rt::sel(#str_ptr("registerClass:forCellWithReuseIdentifier:\0")),
                     rt::get_class(#str_ptr("UICollectionViewCell\0")),
                     bridge::nsstring("facet.item")) };
    { rt::msg_void_id(v, rt::sel(#str_ptr("setBackgroundColor:\0")), 0 as *u8) };
    input::bind_node(v, n);
    let ds: *u8 = collection_source();
    if ds != (0 as *u8) {
        { rt::msg_void_id(v, rt::sel(#str_ptr("setDataSource:\0")), ds) };
        { rt::msg_void_id(v, rt::sel(#str_ptr("setDelegate:\0")), ds) };
    }
    return v;
}

fn create_collection(n: *core::Node) -> *u8 { return make_items_view(n, false); }

fn create_carousel(n: *core::Node) -> *u8 {
    let v: *u8 = make_items_view(n, true);
    if v == (0 as *u8) { return v; }
    // A carousel pages by default — that is the difference an app means by the
    // word, and it is one property on the same view.
    { rt::msg_void_i8(v, rt::sel(#str_ptr("setPagingEnabled:\0")), 1 as i8) };
    return v;
}

// The item size a flow layout uses. `columns` divides the width; `item_sizing`
// says whether every item is that size or measures itself.
fn apply_item_size(v: *u8, columns: i64, horizontal: bool) {
    let layout: *u8 = { rt::msg_id(v, rt::sel(#str_ptr("collectionViewLayout\0"))) };
    if layout == (0 as *u8) { return; }
    let b: rt::Rect = ui::View::from_raw(v).bounds();
    if b.w <= 0.0f64 || b.h <= 0.0f64 { return; }
    var cols: f64 = columns as f64;
    if cols < 1.0f64 { cols = 1.0f64; }
    var w: f64 = b.w / cols;
    var h: f64 = b.h;
    if !horizontal { h = w; }
    { msg_void_size(layout, rt::sel(#str_ptr("setItemSize:\0")), rt::Size { w: w, h: h }) };
    return;
}

fn apply_collection(v: *u8, n: *core::Node, dirty: u64) {
    let p: *props::CollectionProps =
        props_of(n, props::K_COLLECTION) as *props::CollectionProps;
    if p == (0 as *props::CollectionProps) { return; }
    if (dirty & (collection::P_COLUMNS | collection::P_ITEM_SIZING)) != (0 as u64) {
        apply_item_size(v, { (*p).structured_items_view.columns } as i64, false);
    }
    if (dirty & collection::P_SELECTION_MODE) != (0 as u64) {
        let sel: *props::SelectableItemsViewProps = { #addr_of((*p).selectable_items_view) };
        let many: bool = match { (*sel).selection_mode } {
            vocab::SelectionMode::Multiple => true,
            vocab::SelectionMode::Single => false,
            vocab::SelectionMode::None => false,
        };
        let any: bool = match { (*sel).selection_mode } {
            vocab::SelectionMode::None => false,
            vocab::SelectionMode::Single => true,
            vocab::SelectionMode::Multiple => true,
        };
        { rt::msg_void_i8(v, rt::sel(#str_ptr("setAllowsSelection:\0")), bool_i8(any)) };
        { rt::msg_void_i8(v, rt::sel(#str_ptr("setAllowsMultipleSelection:\0")), bool_i8(many)) };
    }
    // Reordering, and whether a dragged item may cross a group boundary. UIKit
    // has one switch for the first — the interactive-movement gesture — and the
    // second is a RULE the data source answers rather than a property, so it is
    // held where `canMoveItemAtIndexPath:` can read it.
    if (dirty & (collection::P_CAN_REORDER_ITEMS
                 | collection::P_CAN_MIX_GROUPS)) != (0 as u64) {
        { rt::msg_void_i8(v, rt::sel(#str_ptr("setUserInteractionEnabled:\0")), 1 as i8) };
        let ro: *props::ReorderableItemsViewProps = { #addr_of((*p).reorderable_items_view) };
        synth::set_associated(v, mix_groups_key(),
                              flag_object({ (*ro).can_mix_groups }));
        if { (*ro).can_reorder_items } { install_drag_gesture(v); }
    }
    if (dirty & (collection::P_VERTICAL_SCROLL_BARS
                 | collection::P_HORIZONTAL_SCROLL_BARS)) != (0 as u64) {
        let sv: ui::ScrollView = ui::ScrollView::from_raw(v);
        sv.set_shows_vertical_scroll_indicator(
            bars_shown({ (*p).items_view.vertical_scroll_bars }));
        sv.set_shows_horizontal_scroll_indicator(
            bars_shown({ (*p).items_view.horizontal_scroll_bars }));
    }
    // WHICH item is selected. Written after any reload in the same pass, for the
    // reason the tree's is: a selection applied to items that have not been
    // built selects nothing.
    if (dirty & (collection::P_SELECTED_INDEX | collection::P_COUNT
                 | collection::P_ROW)) != (0 as u64) {
        cv_select(v, { (*p).selected_index });
    }
    if (dirty & collection::P_SPLICE_ROWS) != (0 as u64) {
        { rt::msg_void(v, rt::sel(#str_ptr("reloadData\0"))) };
    } else if (dirty & (collection::P_COUNT | collection::P_ROW | collection::P_GROUP
                        | collection::P_GROUP_COUNT | collection::P_IS_GROUPED
                        | collection::P_INVALIDATE_ROW)) != (0 as u64) {
        { rt::msg_void(v, rt::sel(#str_ptr("reloadData\0"))) };
    }
    if (dirty & collection::P_SCROLL_TO) != (0 as u64) {
        cv_scroll_to(v, { (*p).items_view.scroll_to_index });
    }
    return;
}

fn apply_carousel(v: *u8, n: *core::Node, dirty: u64) {
    let p: *props::CarouselProps = props_of(n, props::K_CAROUSEL) as *props::CarouselProps;
    if p == (0 as *props::CarouselProps) { return; }
    if (dirty & (carousel::P_COLUMNS | carousel::P_ITEM_SIZING
                 | carousel::P_PEEK_INSETS)) != (0 as u64) {
        apply_item_size(v, { (*p).structured_items_view.columns } as i64, true);
    }
    if (dirty & carousel::P_BOUNCES) != (0 as u64) {
        ui::ScrollView::from_raw(v).set_bounces({ (*p).bounces });
    }
    if (dirty & carousel::P_IS_SWIPEABLE) != (0 as u64) {
        ui::ScrollView::from_raw(v).set_scroll_enabled({ (*p).is_swipeable });
    }
    if (dirty & (carousel::P_VERTICAL_SCROLL_BARS
                 | carousel::P_HORIZONTAL_SCROLL_BARS)) != (0 as u64) {
        let sv: ui::ScrollView = ui::ScrollView::from_raw(v);
        sv.set_shows_vertical_scroll_indicator(
            bars_shown({ (*p).items_view.vertical_scroll_bars }));
        sv.set_shows_horizontal_scroll_indicator(
            bars_shown({ (*p).items_view.horizontal_scroll_bars }));
    }
    // A carousel's items live in the STRUCTURED record it embeds, not in props
    // of its own — so a change to the page it shows is what this kind reloads
    // for, and the item list is reloaded through the same `scroll_anchor` and
    // `columns` writes above.
    if (dirty & carousel::P_WRAPS) != (0 as u64) {
        { rt::msg_void(v, rt::sel(#str_ptr("reloadData\0"))) };
    }
    if (dirty & (carousel::P_SCROLL_TO | carousel::P_POSITION)) != (0 as u64) {
        cv_scroll_to(v, { (*p).position });
    }
    return;
}

fn cv_scroll_to(v: *u8, index: i64) {
    if index < (0 as i64) { return; }
    let ip: *u8 = index_path(index, 0 as i64);
    if ip == (0 as *u8) { return; }
    { msg_void_id_i64_i8(v,
        rt::sel(#str_ptr("scrollToItemAtIndexPath:atScrollPosition:animated:\0")),
        ip, 0 as i64, 1 as i8) };
    return;
}

// The selected item, or none. -1 is facet's "nothing", and UIKit's spelling of
// that is a nil index path — the same call, with the argument left out.
fn cv_select(v: *u8, index: i64) {
    if index < (0 as i64) {
        { msg_void_id_i8_i64(v,
            rt::sel(#str_ptr("selectItemAtIndexPath:animated:scrollPosition:\0")),
            0 as *u8, 0 as i8, 0 as i64) };
        return;
    }
    let ip: *u8 = index_path(index, 0 as i64);
    if ip == (0 as *u8) { return; }
    { msg_void_id_i8_i64(v,
        rt::sel(#str_ptr("selectItemAtIndexPath:animated:scrollPosition:\0")),
        ip, 0 as i8, 0 as i64) };
    return;
}

// Whether a dragged item may land in another group. Held on the collection view
// rather than read from props at drop time, because the data source that
// answers `canMoveItemAtIndexPath:` has the view and not the node.
fn mix_groups_key() -> *u8 { return 41013 as *u8; }

// A FLAG IN THE POINTER, not an NSNumber. `numberWithLongLong:` answers an
// AUTORELEASED object and `set_associated` does not retain — so the association
// would dangle the moment the pool drained, and the next drop would read freed
// memory. The same bug the swipe's offset had; a bool needs no object at all.
fn flag_object(b: bool) -> *u8 {
    if b { return 1 as *u8; }
    return 0 as *u8;
}

fn can_mix_groups(v: *u8) -> bool {
    return { synth::get_associated(v, mix_groups_key()) } != (0 as *u8);
}

