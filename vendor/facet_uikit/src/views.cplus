// facet_uikit views — the Renderer's five verbs.
//
// This is the whole of what facet calls: `create`, `apply`, `insert`, `remove`
// and the `view_release` that pairs with a created view. The per-kind work is
// controls.cplus, the kind-independent work is paint.cplus, and neither is
// visible to facet — facet never grows a verb table.
//
// `create` builds a FULLY CONFIGURED view for a node, or returns 0 for a node
// that needs no backing view. `apply` re-reads a node whose dirty word is
// non-zero and applies only what the bits name. They share the per-kind bodies:
// `create` calls the same `apply_<kind>` with an all-ones dirty word, so a
// control cannot be correct on mount and wrong on its first update.

import "stdlib/option" as option;
import "stdlib/text" as text;
import "stdlib/vec" as vec;
import "stdlib/io" as io;
import "flex_layout/flex_layout" as flex;
import "facet/facet" as core;
import "facet/props" as props;
import "facet/gestures" as gestures;
import "facet/vocabulary" as vocab;
import "facet/symbol" as symbol;
import "facet/text_button" as text_button;
import "facet/split" as split;
import "facet/tree" as tree;
import "facet/window_chrome" as chrome;
import "objc/runtime" as rt;
import "objc/bridge" as bridge;
import "uikit/uikit" as ui;
import "./paint" as paint;
import "./controls" as controls;

type Node = flex::Node;

// ---- does this node get a view? ----------------------------------------------
// A control always does. A plain container does when it carries a KEY, because a
// key is an address: `find("body")` must reach something, the agent surface tags
// it, and set_content needs a host whose native slots it can count. An unkeyed
// pure-layout container gets nothing and passes its children through to the
// nearest host — which is how a column inside a scroll view costs no view.
//
// The fake renderer in facet's own suite uses exactly this rule, so the headless
// conformance tests and this backend agree on the shape of the native tree. It
// is facet's rule, not UIKit's: a difference here is drift, not a platform.
fn wants_view(n: *core::Node) -> bool {
    let kind: u32 = core::kind_of(n);
    if non_view_kind(kind) { return false; }
    if kind != core::K_NODE { return true; }
    // A bare container with GESTURES needs one too: input arrives on a view, so
    // an unkeyed `column(b).on_click(...)` would otherwise describe a handler
    // nothing could ever deliver to.
    if gestures::has_gestures(n) { return true; }
    // And a bare container that asks for PIXELS. Same claim, other tier.
    if wants_painting(n) { return true; }
    return { (*n).key() } != "";
}

// Is this node asking for something only a view can express?
//
// A background colour, a gradient, rounded corners, a clip, a shadow, a partial
// opacity and a transform are all claims on pixels, and pixels need a view — the
// same claim `has_gestures` makes about wanting events.
//
// The test is deliberately the WHOLE painted band rather than the three props
// someone needed on the day: an incomplete rule here fails silently, one prop
// later.
fn wants_painting(n: *core::Node) -> bool {
    if core::background_color(n).is_set() { return true; }
    let b: vocab::Brush = core::background(n);
    if b.start.is_set() { return true; }
    if b.end.is_set() { return true; }
    if core::background_image(n) != "" { return true; }
    let r: vocab::Corners = core::corner_radius(n);
    if r.top_leading != 0.0f64 { return true; }
    if r.top_trailing != 0.0f64 { return true; }
    if r.bottom_leading != 0.0f64 { return true; }
    if r.bottom_trailing != 0.0f64 { return true; }
    if core::clip(n).kind != (0 as i64) { return true; }
    // A shadow needs BOTH a colour and an opacity to draw anything, which is
    // what `Shadow::none()` is — asking for either alone is not a request for a
    // rectangle.
    let sh: vocab::Shadow = core::shadow(n);
    if sh.color.is_set() && sh.opacity != 0.0f64 { return true; }
    if core::opacity(n) != 1.0f64 { return true; }
    // `is_visible` is the hide that KEEPS the node's space (flex's display:none
    // is the other one). With no view of its own there is nothing to hide, and
    // every child would go on drawing.
    if !core::is_visible(n) { return true; }
    // The transforms are a layer property; a container without a layer rotates
    // and scales nothing at all.
    if core::rotation(n) != 0.0f64 { return true; }
    if core::scale(n) != 1.0f64 { return true; }
    if core::scale_x(n) != 1.0f64 { return true; }
    if core::scale_y(n) != 1.0f64 { return true; }
    if core::translation_x(n) != 0.0f64 { return true; }
    if core::translation_y(n) != 0.0f64 { return true; }
    return false;
}

// The kinds that are not rectangles: read as NODES when their parent's view is
// built, never laid out. A keyless container is NOT one of these, which is the
// whole distinction — it has no view but it is still a row or a column.
fn non_view_kind(kind: u32) -> bool {
    return controls::menu_kind(kind) || controls::menu_bar_kind(kind)
        || controls::span_kind(kind) || controls::swipe_kind(kind);
}

// ---- create ------------------------------------------------------------------

fn create(ctx: *u8, n: *core::Node) -> *u8 {
    if n == (0 as *core::Node) { return 0 as *u8; }
    if !wants_view(n) {
        // Two DIFFERENT reasons a node gets no view, and only one of them is
        // still a box in the layout.
        //
        // A keyless pure-layout container passes its children through to the
        // nearest host and stays in flow. A NON-VIEW KIND is not a rectangle at
        // all: a `span` is a run inside its label's attributed string, a
        // `menu_item` is a row in a UIMenu. As ordinary flex children they would
        // each contribute a zero-size box that still consumed a `gap` and still
        // counted as an item under `justify: SpaceBetween`.
        //
        // Worse, a label with `span` children would stop measuring itself at
        // all: flex uses a node's measure callback only when it has NO children.
        //
        // `Display::None` is flex's own word for "not in this layout", and it
        // does not remove the node from the TREE — the label still reads its
        // spans and the menu builders still walk their items.
        if non_view_kind(core::kind_of(n)) { { (*n).set_display(flex::Display::None) }; }
        return 0 as *u8;
    }
    let kind: u32 = core::kind_of(n);
    let v: *u8 = create_for_kind(kind, n);
    if v == (0 as *u8) { return 0 as *u8; }
    // The key IS the accessibilityIdentifier. One token, three jobs: facet's
    // address, the agent surface's id, and the platform's a11y id.
    let k: str = { (*n).key() };
    if k != "" {
        { rt::msg_void_id(v, rt::sel(#str_ptr("setAccessibilityIdentifier:\0")),
                          bridge::nsstring(k)) };
    }
    // Configure it WHOLE: the shared band, then the kind's own body with every
    // bit set. One code path with apply, so the two cannot drift.
    configure(v, n, paint::all_bits());
    // Intrinsic size: the node measures itself through its view from here on.
    // `context` is flex's spare slot — facet's Data rides the ATTACHMENT, so
    // nothing else wants it.
    if has_intrinsic_size(kind) {
        { (*n).set_context(v) };
        { (*n).set_measure(measure_view) };
    }
    return v;
}

// The one door for "write these props onto this view". `create` uses it with
// every bit set, `apply` with the dirty word, so the two cannot drift.
//
// It is one function here and a saved-static appearance dance in facet_appkit,
// for the reason paint.cplus opens with: a UIColor resolves against the current
// trait collection when it is asked for components, so there is no "wrong
// appearance is current" window to close.
fn configure(v: *u8, n: *core::Node, d: u64) {
    paint::apply_common(v, n, d);
    apply_for_kind(core::kind_of(n), v, n, d);
    return;
}

// ---- intrinsic size ----------------------------------------------------------
// flex sizes a LEAF from its measure callback. Without one every control that
// was not given an explicit width and height measures 0x0 — a `label("Save")` in
// a column is laid out as a zero-height strip and simply does not appear.
//
// It goes on the kinds whose size is genuinely INTRINSIC, named one by one
// rather than "everything with a view". A scroll view or a web view has a
// fitting size too, and it means something else entirely: a surface is sized by
// its container, and asking WKWebView how big it would like to be is not a
// question with a useful answer.
fn has_intrinsic_size(kind: u32) -> bool {
    return kind == props::K_LABEL || kind == props::K_BUTTON
        || kind == props::K_TEXT_FIELD || kind == props::K_SEARCH_FIELD
        || kind == props::K_CHECKBOX || kind == props::K_RADIO
        || kind == props::K_TOGGLE || kind == props::K_SLIDER
        || kind == props::K_PROGRESS || kind == props::K_SPINNER
        || kind == props::K_STEPPER || kind == props::K_POPUP
        || kind == props::K_DATE_PICKER || kind == props::K_TIME_PICKER
        || kind == props::K_IMAGE || kind == props::K_ICON_BUTTON
        || kind == props::K_PAGE_DOTS || kind == props::K_TABS
        || kind == symbol::K_SYMBOL
        || kind == text_button::K_TEXT_BUTTON;
}

#[link_name = "objc_msgSend"]
extern fn msg_size_size(recv: *u8, sel: *u8, s: rt::Size) -> rt::Size;

// The measure flex calls. `ctx` is the backing view, put there by `create`.
//
// `sizeThatFits:` IS the bounded question, which is the difference that matters
// against AppKit: there, `fittingSize` takes no argument and a wrapping label
// has to be told its width through `preferredMaxLayoutWidth` first, off to the
// side, before an unbounded question can answer a bounded one. UIKit asks it
// directly — the available width goes in the call.
//
// An unbounded axis is passed as a very large number rather than NaN or zero:
// zero means "as small as possible" to most UIKit controls, and that is a
// different question with a plausible-looking wrong answer.
fn measure_view(ctx: *u8, avail_w: f64, wm: flex::MeasureMode,
                avail_h: f64, hm: flex::MeasureMode) -> flex::Size {
    if ctx == (0 as *u8) { return flex::Size { width: 0.0f64, height: 0.0f64 }; }
    let ask: rt::Size = rt::Size {
        w: bounded_or_large(avail_w),
        h: bounded_or_large(avail_h),
    };
    let s: rt::Size = { msg_size_size(ctx, rt::sel(#str_ptr("sizeThatFits:\0")), ask) };
    // A ZERO answer is not a measurement, it is UIKit declining to give one —
    // a UISlider and a UIProgressView have no intrinsic width because they are
    // meant to take what they are given. flex trusts the number, so a zero means
    // the control is laid out at zero and disappears: in a COLUMN nothing shows
    // because `align_items` defaults to Stretch and the cross axis is filled
    // anyway; in a ROW the control is a sliver.
    //
    // So a zero is floored rather than believed. The floor is the available
    // space when there is a bounded one — which IS what "I take what I am given"
    // asks for — and a modest default when the parent is unbounded.
    var w: f64 = s.w;
    var h: f64 = s.h;
    if (w > 0.0f64) == false { w = fallback_extent(avail_w, 100.0f64); }
    if (h > 0.0f64) == false { h = fallback_extent(avail_h, 20.0f64); }
    return flex::Size { width: w, height: h };
}

// flex states an unbounded axis as NaN or a non-positive number.
fn bounded_or_large(avail: f64) -> f64 {
    if avail == avail && avail > 0.0f64 { return avail; }
    return 100000.0f64;
}

fn fallback_extent(avail: f64, dflt: f64) -> f64 {
    if avail == avail && avail > 0.0f64 { return avail; }
    return dflt;
}

// A plain backing view.
//
// No flipped subclass, and no subclass at all: a UIView is top-left origin
// natively, which is the single largest simplification UIKit makes over the
// AppKit backend. Returned at +1 — mount pairs it with `view_release`.
fn backing_view() -> *u8 {
    let v: ui::View = ui::View::new_with_frame(rt::Rect { x: 0.0f64, y: 0.0f64, w: 0.0f64, h: 0.0f64 });
    return rt::retain(v.raw());
}

fn create_for_kind(kind: u32, n: *core::Node) -> *u8 {
    if kind == core::K_NODE { return backing_view(); }
    if kind == props::K_LABEL { return controls::create_label(n); }
    if kind == props::K_BUTTON { return controls::create_button(n); }
    if kind == text_button::K_TEXT_BUTTON { return controls::create_text_button(n); }
    if kind == props::K_ICON_BUTTON { return controls::create_icon_button(n); }
    if kind == props::K_TEXT_FIELD { return controls::create_text_field(n); }
    if kind == props::K_SEARCH_FIELD { return controls::create_search_field(n); }
    if kind == props::K_TEXT_AREA { return controls::create_text_area(n); }
    if kind == props::K_IMAGE { return controls::create_image(n); }
    if kind == symbol::K_SYMBOL { return controls::create_symbol(n); }
    if kind == props::K_SCROLL { return controls::create_scroll(n); }
    if kind == props::K_BOX { return controls::create_box(n); }
    if kind == props::K_BORDERED { return controls::create_bordered(n); }
    if kind == props::K_TOGGLE { return controls::create_toggle(n); }
    if kind == props::K_CHECKBOX { return controls::create_checkbox(n); }
    if kind == props::K_RADIO { return controls::create_radio(n); }
    if kind == props::K_SLIDER { return controls::create_slider(n); }
    if kind == props::K_PROGRESS { return controls::create_progress(n); }
    if kind == props::K_SPINNER { return controls::create_spinner(n); }
    if kind == props::K_STEPPER { return controls::create_stepper(n); }
    if kind == props::K_PAGE_DOTS { return controls::create_page_dots(n); }
    if kind == props::K_POPUP { return controls::create_popup(n); }
    if kind == props::K_TABS { return controls::create_tabs(n); }
    if kind == props::K_DATE_PICKER { return controls::create_date_picker(n); }
    if kind == props::K_TIME_PICKER { return controls::create_time_picker(n); }
    if kind == props::K_REFRESHABLE { return controls::create_refreshable(n); }
    // Decided, not missing: MANIFEST.md records why these have no iOS
    // equivalent and what to use instead. They get a plain backing view so
    // their content still renders — and SILENTLY, because a warning for
    // something already answered would train a reader to ignore the warnings
    // that mean something.
    if controls::decided_absent(kind) { return backing_view(); }
    // NOT YET BUILT, and audibly so. Each of these has a real UIKit answer that
    // this pass did not reach; the warning names the kind once and MANIFEST.md
    // lists them under "not yet" rather than under "cannot".
    if controls::not_yet_built(kind) {
        unimplemented_kind(kind, n);
        return controls::create_passthrough(n);
    }
    unimplemented_kind(kind, n);
    return backing_view();
}

// ---- apply -------------------------------------------------------------------

fn apply(ctx: *u8, n: *core::Node) {
    if n == (0 as *core::Node) { return; }
    let v: *u8 = core::view_of(n);
    if v == (0 as *u8) { return; }
    let d: u64 = core::dirty_of(n);
    if d == (0 as u64) { return; }
    configure(v, n, d);
    let kind: u32 = core::kind_of(n);
    // A node that measures ITSELF has just been written to, so the measurement
    // is stale — and nothing else in the pipeline knows that. flex's incremental
    // cache prunes a subtree whose STYLE is unchanged, and `set_text` changes no
    // style: it changes what the view would answer if asked again. Without this
    // the label keeps the box it was given for its OLD string.
    if has_intrinsic_size(kind) { { (*n).mark_content_changed() }; }
    return;
}

fn apply_for_kind(kind: u32, v: *u8, n: *core::Node, dirty: u64) {
    if kind == props::K_LABEL { controls::apply_label(v, n, dirty); return; }
    if kind == props::K_BUTTON { controls::apply_button(v, n, dirty); return; }
    if kind == text_button::K_TEXT_BUTTON { controls::apply_text_button(v, n, dirty); return; }
    if kind == props::K_ICON_BUTTON { controls::apply_icon_button(v, n, dirty); return; }
    if kind == props::K_TEXT_FIELD { controls::apply_text_field(v, n, dirty); return; }
    if kind == props::K_SEARCH_FIELD { controls::apply_search_field(v, n, dirty); return; }
    if kind == props::K_TEXT_AREA { controls::apply_text_area(v, n, dirty); return; }
    if kind == props::K_IMAGE { controls::apply_image(v, n, dirty); return; }
    if kind == symbol::K_SYMBOL { controls::apply_symbol(v, n, dirty); return; }
    if kind == props::K_SCROLL { controls::apply_scroll(v, n, dirty); return; }
    if kind == props::K_BOX { controls::apply_box(v, n, dirty); return; }
    if kind == props::K_BORDERED { controls::apply_bordered(v, n, dirty); return; }
    if kind == props::K_TOGGLE { controls::apply_toggle(v, n, dirty); return; }
    if kind == props::K_CHECKBOX { controls::apply_checkbox(v, n, dirty); return; }
    if kind == props::K_RADIO { controls::apply_radio(v, n, dirty); return; }
    if kind == props::K_SLIDER { controls::apply_slider(v, n, dirty); return; }
    if kind == props::K_PROGRESS { controls::apply_progress(v, n, dirty); return; }
    if kind == props::K_SPINNER { controls::apply_spinner(v, n, dirty); return; }
    if kind == props::K_STEPPER { controls::apply_stepper(v, n, dirty); return; }
    if kind == props::K_PAGE_DOTS { controls::apply_page_dots(v, n, dirty); return; }
    if kind == props::K_POPUP { controls::apply_popup(v, n, dirty); return; }
    if kind == props::K_TABS { controls::apply_tabs(v, n, dirty); return; }
    if kind == props::K_DATE_PICKER { controls::apply_date_picker(v, n, dirty); return; }
    if kind == props::K_TIME_PICKER { controls::apply_time_picker(v, n, dirty); return; }
    if kind == props::K_REFRESHABLE { controls::apply_refreshable(v, n, dirty); return; }
    return;
}

// Does this kind have an answer — a body, a decided-absent pass-through, a
// not-yet-built pass-through, or a non-view builder? The sweep's own guard: a
// kind that reaches neither is a gap, and a test asserts there are none.
fn has_body(kind: u32) -> bool {
    if kind == core::K_NODE { return true; }
    if non_view_kind(kind) { return true; }
    if controls::decided_absent(kind) { return true; }
    if controls::not_yet_built(kind) { return true; }
    return kind == props::K_LABEL || kind == props::K_BUTTON
        || kind == text_button::K_TEXT_BUTTON || kind == props::K_ICON_BUTTON
        || kind == props::K_TEXT_FIELD || kind == props::K_SEARCH_FIELD
        || kind == props::K_TEXT_AREA || kind == props::K_IMAGE
        || kind == symbol::K_SYMBOL || kind == props::K_SCROLL
        || kind == props::K_BOX || kind == props::K_BORDERED
        || kind == props::K_TOGGLE || kind == props::K_CHECKBOX
        || kind == props::K_RADIO || kind == props::K_SLIDER
        || kind == props::K_PROGRESS || kind == props::K_SPINNER
        || kind == props::K_STEPPER || kind == props::K_PAGE_DOTS
        || kind == props::K_POPUP || kind == props::K_TABS
        || kind == props::K_DATE_PICKER || kind == props::K_TIME_PICKER
        || kind == props::K_REFRESHABLE;
}

// ---- the unbuilt kinds -------------------------------------------------------
// Say so, once per kind, on stderr. A control that renders as an empty rectangle
// with no word said is the failure this package exists to avoid. MANIFEST.md
// lists which are not-yet-reached versus which UIKit genuinely cannot do — the
// two are never allowed to blur together.

static WARNED: [bool; 1100] = #zero::[[bool; 1100]]();

fn unimplemented_kind(kind: u32, n: *core::Node) {
    let idx: usize = kind as usize;
    if idx >= (1100 as usize) { return; }
    if WARNED[idx] { return; }
    WARNED[idx] = true;
    io::eprintln(text::from_str("facet_uikit: kind ")
        .appending(u32_text(kind).view())
        .appending(" has no UIKit body yet — its content renders, its own behaviour does not. key: \"")
        .appending({ (*n).key() })
        .appending("\"").view());
    return;
}

fn digit_str(d: u32) -> str {
    if d == (0 as u32) { return "0"; }
    if d == (1 as u32) { return "1"; }
    if d == (2 as u32) { return "2"; }
    if d == (3 as u32) { return "3"; }
    if d == (4 as u32) { return "4"; }
    if d == (5 as u32) { return "5"; }
    if d == (6 as u32) { return "6"; }
    if d == (7 as u32) { return "7"; }
    if d == (8 as u32) { return "8"; }
    return "9";
}

// stdlib's Text has no integer formatter, and a diagnostic is not a reason to
// add one to a package this does not own.
fn u32_text(v: u32) -> text::Text {
    if v == (0 as u32) { return text::from_str("0"); }
    var digits: [u32; 12] = #zero::[[u32; 12]]();
    var m: u32 = v;
    var i: usize = 0 as usize;
    while m > (0 as u32) && i < (12 as usize) {
        digits[i] = m % (10 as u32);
        m = m / (10 as u32);
        i = i +% (1 as usize);
    }
    var out: text::Text = text::new();
    while i > (0 as usize) {
        i = i -% (1 as usize);
        out = out.appending(digit_str(digits[i]));
    }
    return out;
}

// ---- insert / remove ---------------------------------------------------------
// Native children under a host view, in facet's child order. `slot` is the index
// among the views facet has put in this host — the mount walk computes it, and
// `mount::insert_child` computes it for a live edit.
//
// TWO THINGS UIKIT MAKES SHORTER. There is an `insertSubview:atIndex:`, so the
// slot goes in directly where AppKit needs `positioned:below relativeTo:` the
// view currently occupying it. And a UIScrollView hosts its children itself, so
// there is no document-view translation: the AppKit backend has a `host_for`
// that redirects into the document view, and this one does not need the concept.

fn insert(ctx: *u8, host: *u8, child: *u8, slot: usize) {
    if host == (0 as *u8) { return; }
    if child == (0 as *u8) { return; }
    let h: ui::View = ui::View::from_raw(host);
    let c: ui::View = ui::View::from_raw(child);
    let subs: vec::Vec[ui::View] = h.subviews();
    if slot >= subs.count() {
        h.add_subview(c);
        return;
    }
    h.insert_subview(c, slot as i64);
    return;
}

fn remove(ctx: *u8, host: *u8, child: *u8) {
    if child == (0 as *u8) { return; }
    ui::View::from_raw(child).remove_from_superview();
    return;
}

// M1: the release mount pairs with every view `create` returned. Node teardown
// fires it, so a dropped tree cannot leak its views.
fn view_release(v: *u8) {
    if v == (0 as *u8) { return; }
    { rt::release(v) };
    return;
}

// ==============================================================================
// Tests
// ==============================================================================
// STRUCTURAL ONLY, AND THAT IS NOT A CHOICE. Every test here asserts something
// about facet's side of the seam — which kinds have bodies, what the backing
// rule decides, which kinds measure themselves — because the other side needs a
// device or a simulator to exist at all: `UIView::new_with_frame` on this host
// is a message to a class that is not in the process.
//
// They live in this file rather than in a test root, and that is deliberate: a
// `[[bin]]` test target is not built for an external-builder target, so tests
// in one would be the only code in the package the iOS build never compiled.
// Here they are compiled by `cpc build --target ios-arm64` along with
// everything else.
//
// facet_appkit's suite is the shape this one should grow into once there is a
// simulator harness: 11k lines that create real views and read real frames
// back. Until then the honest position is that this package COMPILES for iOS
// and its runtime behaviour is unvalidated — README.md says so in those words,
// and no test here implies otherwise.

// Worth more than the rest put together: every kind facet declares has an
// ANSWER — a body, a decided-absent pass-through, a not-yet-built pass-through,
// or a non-view builder. A kind that reaches none of those renders as an empty
// rectangle, and this is what stops one being added to facet without this
// package noticing.
#[test]
fn every_kind_has_an_answer() {
    var k: u32 = 1 as u32;
    while k <= (38 as u32) {
        assert has_body(k);
        k = k +% (1 as u32);
    }
    assert has_body(symbol::K_SYMBOL);
    assert has_body(tree::K_TREE);
    assert has_body(split::K_SPLIT);
    assert has_body(chrome::K_WINDOW_BUTTONS);
    assert has_body(core::K_NODE);
    return;
}

// facet's rule, not UIKit's — the headless conformance suite in facet asserts
// the same shape — so a divergence here is this backend drifting, not a
// platform difference.
#[test]
fn a_keyed_container_is_backed_and_an_unkeyed_one_is_not() {
    var keyed: core::Node = core::column(core::Builder::new(), key: "body");
    assert wants_view(#addr_of(keyed));
    var bare: core::Node = core::column(core::Builder::new());
    assert wants_view(#addr_of(bare)) == false;
    // A control is always backed, key or no key.
    var leaf: core::Node = core::node_with("", props::K_BUTTON, 0 as *u8, core::no_release);
    assert wants_view(#addr_of(leaf));
    return;
}

// A background is a claim on PIXELS, and pixels need a view — the same claim
// gestures make about wanting events. The whole painted band is the test, not
// the three props someone needed on the day: an incomplete rule here fails the
// same silent way, one prop later.
#[test]
fn a_container_that_asks_for_pixels_is_backed() {
    var n: core::Node = core::column(core::Builder::new());
    assert wants_view(#addr_of(n)) == false;
    core::set_background_color(#addr_of(n), vocab::Color::system_red());
    assert wants_view(#addr_of(n));

    var r: core::Node = core::column(core::Builder::new());
    core::set_corner_radius(#addr_of(r), vocab::Corners::all(8.0f64));
    assert wants_view(#addr_of(r));

    var o: core::Node = core::column(core::Builder::new());
    core::set_opacity(#addr_of(o), 0.5f64);
    assert wants_view(#addr_of(o));

    // A transform is a layer property; a container without a layer rotates
    // nothing at all.
    var t: core::Node = core::column(core::Builder::new());
    core::set_rotation(#addr_of(t), 15.0f64);
    assert wants_view(#addr_of(t));
    return;
}

// The kinds that are not rectangles at all: read as NODES when their parent's
// view is built, never laid out. A keyless container is NOT one of these, which
// is the whole distinction — it has no view but it is still a row.
#[test]
fn the_non_view_kinds_are_not_rectangles() {
    assert non_view_kind(props::K_SPAN);
    assert non_view_kind(props::K_MENU_ITEM);
    assert non_view_kind(props::K_CONTEXT_MENU);
    assert non_view_kind(props::K_SWIPE_ITEM);
    assert non_view_kind(props::K_TOOLBAR_ITEM);
    assert non_view_kind(core::K_NODE) == false;
    assert non_view_kind(props::K_LABEL) == false;
    return;
}

#[test]
fn an_unbacked_node_creates_nothing() {
    var bare: core::Node = core::column(core::Builder::new());
    assert create(0 as *u8, #addr_of(bare)) == (0 as *u8);
    assert create(0 as *u8, 0 as *core::Node) == (0 as *u8);
    return;
}

#[test]
fn the_measured_kinds_are_the_ones_uikit_can_size() {
    assert has_intrinsic_size(props::K_LABEL);
    assert has_intrinsic_size(props::K_BUTTON);
    assert has_intrinsic_size(props::K_TOGGLE);
    assert has_intrinsic_size(props::K_SLIDER);
    assert has_intrinsic_size(symbol::K_SYMBOL);
    // A scroll view has a fitting size too and it means something else
    // entirely: a surface is sized by its container, not by what it contains.
    assert has_intrinsic_size(props::K_SCROLL) == false;
    assert has_intrinsic_size(props::K_WEB) == false;
    assert has_intrinsic_size(core::K_NODE) == false;
    return;
}

// flex states an unbounded axis as NaN or a non-positive number, and
// `sizeThatFits:` has no spelling for "unbounded" — a zero there means "as
// small as possible", which is a different question with a plausible-looking
// wrong answer.
#[test]
fn an_unbounded_axis_asks_for_a_large_extent_not_zero() {
    assert bounded_or_large(320.0f64) == 320.0f64;
    assert bounded_or_large(0.0f64) > 1000.0f64;
    assert bounded_or_large(-1.0f64) > 1000.0f64;
    return;
}

// ---- the ledger ---------------------------------------------------------------
// `decided_absent` is the list of kinds with no iOS equivalent, and it is
// deliberately a WHITELIST: a kind is in it because MANIFEST.md says why, not
// because nobody got to it.

#[test]
fn the_desktop_window_tier_is_decided_absent_not_unbuilt() {
    // An iOS window has no close / minimise / zoom buttons, and no menu bar.
    assert controls::decided_absent(chrome::K_WINDOW_BUTTONS);
    assert controls::decided_absent(props::K_MENU);
    // A draggable split divider is a pointer idiom.
    assert controls::decided_absent(split::K_SPLIT);
    return;
}

// The two lists must never blur together. A kind that is merely UNBUILT has to
// be in `not_yet_built` — which warns on stderr when it is mounted — rather
// than in `decided_absent`, which is silent because it is finished.
#[test]
fn an_unbuilt_kind_is_audible_and_a_decided_one_is_silent() {
    assert controls::not_yet_built(props::K_LIST);
    assert controls::not_yet_built(props::K_WEB);
    assert controls::not_yet_built(props::K_CANVAS);
    assert controls::decided_absent(props::K_LIST) == false;
    assert controls::decided_absent(props::K_WEB) == false;
    assert controls::not_yet_built(chrome::K_WINDOW_BUTTONS) == false;
    assert controls::not_yet_built(split::K_SPLIT) == false;
    return;
}

// Nothing that HAS a UIKit body may hide in either ledger — that is how an
// unfinished kind would be parked to make the sweep pass.
#[test]
fn the_ordinary_controls_are_in_neither_ledger() {
    assert controls::decided_absent(props::K_LABEL) == false;
    assert controls::not_yet_built(props::K_LABEL) == false;
    assert controls::decided_absent(props::K_BUTTON) == false;
    assert controls::not_yet_built(props::K_BUTTON) == false;
    assert controls::decided_absent(props::K_TOGGLE) == false;
    assert controls::not_yet_built(props::K_SLIDER) == false;
    assert controls::decided_absent(props::K_TEXT_FIELD) == false;
    assert controls::not_yet_built(props::K_SCROLL) == false;
    assert controls::decided_absent(core::K_NODE) == false;
    return;
}
