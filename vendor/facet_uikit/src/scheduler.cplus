// facet_uikit scheduler — the platform's scheduling primitives, and the sync
// tick that drives the whole seam.
//
// ---- the tick ----------------------------------------------------------------
//
// M5: `core::touch` requests a sync through the hook `mount::install`
// registers; the BACKEND coalesces those requests on its run loop and calls
// `mount::sync()`. facet has no loop of its own, so "coalesce" has to mean
// something the platform already does.
//
// It is a CFRunLoopObserver at kCFRunLoopBeforeWaiting: the moment the loop has
// finished everything it had and is about to sleep. That is the flush point
// Core Animation itself commits on, so a batch of writes from one event lands
// as one visual update, and a hundred writes in a loop cost one tick rather
// than a hundred.
//
// AND THE TICK MUST RUN BEFORE THAT COMMIT. Core Animation's own observer sits
// at order 2,000,000 on both platforms, and what it commits is what this frame
// SHOWS. An observer ordered after it is correct in memory and drawn one frame
// late. facet_appkit learned that the expensive way during a live drag; the
// order is copied from there deliberately rather than rediscovered.
//
// CoreFoundation is the same framework on iOS, so this file is the one part of
// the backend that is a near-verbatim port — which is the point of writing it
// against CF rather than against AppKit's own loop.
//
// ---- what the tick does, in order --------------------------------------------
//
//   1. mount::sync()      per-node applies — the dirty word says what changed
//   2. the layout pass    per window: calculate_layout at the root view's size,
//                         then the frame walk (geometry.cplus)
//
// That order matters: an apply can change what a node MEASURES (a label's new
// text), and the layout pass right after it is what re-flows to fit.

import "stdlib/option" as option;
import "stdlib/vec" as vec;
import "stdlib/text" as text;
import "stdlib/status" as status;
import "objc/synthesis" as synth;
import "flex_layout/flex_layout" as flex;
import "facet/facet" as core;
import "facet/mount" as mount;
import "facet/services" as services;
import "facet/application" as app;
import "facet/vocabulary" as vocab;
import "objc/runtime" as rt;
import "uikit/uikit" as ui;
import "./geometry" as geometry;

// ---- CoreFoundation run loop -------------------------------------------------

extern fn CFRunLoopGetMain() -> *u8;
extern fn CFRunLoopWakeUp(rl: *u8);
extern fn CFRunLoopAddObserver(rl: *u8, observer: *u8, mode: *u8);
extern fn CFRunLoopObserverCreate(
    allocator: *u8,
    activities: u64,
    repeats: i8,
    order: i64,
    callout: fn(*u8, u64, *u8),
    context: *u8,
) -> *u8;

// The loop is about to sleep: everything queued has been handled.
fn cf_before_waiting() -> u64 { return 32 as u64; }

// kCFRunLoopCommonModes, the REAL constant, read through dlsym — an equal
// CFString is not the same pointer, and the run loop compares by identity for
// the common-modes set.
extern fn dlsym(handle: *u8, symbol: *u8) -> *u8;

// RTLD_DEFAULT is -2 on Darwin, built through usize so the literal
// does not wrap through i32 on the way.
fn rtld_default() -> *u8 { return { ((0 as usize) -% (2 as usize)) as *u8 }; }

fn common_modes() -> *u8 {
    let p: *u8 = { dlsym(rtld_default(), #str_ptr("kCFRunLoopCommonModes\0")) };
    if p == (0 as *u8) { return 0 as *u8; }
    return { (*(p as **u8)) };
}

// Below Core Animation's own observer (2,000,000), so a tick's writes are in
// the transaction this frame commits.
fn tick_order() -> i64 { return 1999000 as i64; }

static OBSERVER_INSTALLED: bool = false;
static SYNC_PENDING: bool = false;
static TICKS: u64 = 0 as u64;

fn install_sync_tick() {
    if OBSERVER_INSTALLED { return; }
    let rl: *u8 = { CFRunLoopGetMain() };
    if rl == (0 as *u8) { return; }
    let obs: *u8 = { CFRunLoopObserverCreate(0 as *u8, cf_before_waiting(), 1 as i8,
                                             tick_order(), before_waiting, 0 as *u8) };
    if obs == (0 as *u8) { return; }
    let modes: *u8 = common_modes();
    if modes == (0 as *u8) { return; }
    { CFRunLoopAddObserver(rl, obs, modes) };
    OBSERVER_INSTALLED = true;
    return;
}

// `schedule` does almost nothing: raise a flag, nudge the loop. The observer
// does the work.
fn schedule(ctx: *u8) {
    SYNC_PENDING = true;
    if OBSERVER_INSTALLED {
        let rl: *u8 = { CFRunLoopGetMain() };
        if rl != (0 as *u8) { { CFRunLoopWakeUp(rl) }; }
    }
    return;
}

fn before_waiting(observer: *u8, activity: u64, info: *u8) {
    tick();
    return;
}

// The tick itself, factored out so a suite can drive it without a run loop.
fn tick() {
    if !SYNC_PENDING { return; }
    SYNC_PENDING = false;
    TICKS = TICKS +% (1 as u64);
    mount::sync();
    layout_all_windows();
    return;
}

fn ticks() -> u64 { return TICKS; }

// Force a tick NOW, outside the observer. The window host needs one at launch:
// UIKit lays out on the next turn of the loop, and the tree would otherwise sit
// at its mount-time size — zero — for the first frame the user sees.
fn tick_now() {
    SYNC_PENDING = true;
    tick();
    return;
}

// ---- the layout pass ----------------------------------------------------------

fn layout_all_windows() {
    var i: usize = 0 as usize;
    let n: usize = app::window_count();
    while i < n {
        let root: *core::Node = app::window_root(i);
        if root != (0 as *core::Node) { layout_window(root); }
        i = i +% (1 as usize);
    }
    return;
}

// A window's content view is its root view controller's view.
//
// THE SAFE AREA IS A PROPERTY HERE, not a computation. `safeAreaInsets` is on
// UIView itself and is the notch, the home indicator and the status bar all
// answered together — where the AppKit backend has to work out what a titlebar
// is doing. It is also the band that MATTERS on this platform: a phone screen
// with content under the notch is broken in a way a Mac window is not.
fn layout_window(root: *core::Node) {
    let win: *u8 = app::window_native(root);
    if win == (0 as *u8) { return; }
    let content: *u8 = content_view_of(win);
    if content == (0 as *u8) { return; }
    let cv: ui::View = ui::View::from_raw(content);
    let f: rt::Rect = cv.bounds();
    let ins: ui::EdgeInsets = safe_insets(cv, root);
    let w: f64 = f.w - ins.left - ins.right;
    let h: f64 = f.h - ins.top - ins.bottom;
    geometry::relayout_root(root, w, h, geometry::screen_scale());
    // The root's own view fills the safe box: mount inserted it nowhere (the
    // facade did), so the frame walk never sizes it.
    let rv: *u8 = core::view_of(root);
    if rv != (0 as *u8) {
        geometry::set_view_frame(rv, rt::Rect { x: ins.left, y: ins.top, w: w, h: h });
        return;
    }
    // A pass-through root has no view of its own, so the facade put its topmost
    // BACKED descendants in the window instead — and those are the views the
    // inset has to move, or a DSL-authored screen ignores the safe area that a
    // keyed one honours.
    if ins.left != 0.0f64 || ins.top != 0.0f64 {
        offset_root_views(root, ins.left, ins.top);
    }
    return;
}

fn content_view_of(win: *u8) -> *u8 {
    let vc: *u8 = { rt::msg_id(win, rt::sel(#str_ptr("rootViewController\0"))) };
    if vc == (0 as *u8) { return 0 as *u8; }
    return { rt::msg_id(vc, rt::sel(#str_ptr("view\0"))) };
}

// `SafeArea::None` is the only answer that opts out, and it is the one that
// gets the whole screen — a full-bleed photo, which is a real thing to ask for.
// `honours_safe_area` is facet's own reduction of the five-way enum to that one
// question, so this backend and facet_appkit cannot disagree about what
// `Container` means.
fn safe_insets(cv: ui::View, root: *core::Node) -> ui::EdgeInsets {
    if !core::honours_safe_area(root) {
        return ui::EdgeInsets { top: 0.0f64, left: 0.0f64, bottom: 0.0f64, right: 0.0f64 };
    }
    return cv.safe_area_insets();
}

// The topmost backed descendants of a viewless root, nudged by the inset.
fn offset_root_views(n: *core::Node, dx: f64, dy: f64) {
    var i: usize = 0 as usize;
    let count: usize = core::child_count_of(n);
    while i < count {
        match core::child_of(n, i) {
            option::Option[*core::Node]::Some(c) => {
                let v: *u8 = core::view_of(c);
                if v != (0 as *u8) {
                    let f: rt::Rect = ui::View::from_raw(v).frame();
                    geometry::set_view_frame(v, rt::Rect { x: f.x + dx, y: f.y + dy,
                                                           w: f.w, h: f.h });
                } else {
                    offset_root_views(c, dx, dy);
                }
            }
            option::Option[*core::Node]::None => { }
        }
        i = i +% (1 as usize);
    }
    return;
}

// ---- the scheduler seam --------------------------------------------------------

extern fn dispatch_async_f(queue: *u8, ctx: *u8, work: fn(*u8));
extern fn dispatch_after_f(when: u64, queue: *u8, ctx: *u8, work: fn(*u8));
extern fn dispatch_time(base: u64, delta: i64) -> u64;

// `dispatch_get_main_queue()` is a macro over a libdispatch global, so there is
// no function to call — the queue is read out of the symbol.
fn main_dispatch_queue() -> *u8 {
    return { dlsym(rtld_default(), #str_ptr("_dispatch_main_q\0")) };
}

fn run_on_main(work: fn(*u8), ctx: *u8) {
    { dispatch_async_f(main_dispatch_queue(), ctx, work) };
    return;
}

// ---- after / cancel_after -------------------------------------------------------
//
// `dispatch_after` cannot be recalled once armed, so a cancel has to be a flag
// the trampoline reads when it fires. The slot table is that flag, and the
// handle facet holds is an index into it — which is also why a handle is
// index+1: zero is the "no handle" value the seam already uses for a failure.
//
// A fixed table rather than a growing vector: a timer slot is reused as soon as
// its timer has fired, so the table's size is the number of timers IN FLIGHT,
// and a UI with more than 256 of those has a different problem.

struct Slot {
    used: bool,
    cancelled: bool,
    work: fn(*u8),
    opaque ctx: *u8,
}

static SLOTS: [Slot; 256] = #zero::[[Slot; 256]]();

fn slot_alloc(work: fn(*u8), ctx: *u8) -> u64 {
    var i: usize = 0 as usize;
    while i < (256 as usize) {
        if SLOTS[i].used == false {
            SLOTS[i].used = true;
            SLOTS[i].cancelled = false;
            SLOTS[i].work = work;
            SLOTS[i].ctx = ctx;
            return (i as u64) +% (1 as u64);
        }
        i = i +% (1 as usize);
    }
    return 0 as u64;
}

fn slot_fire(ctx: *u8) {
    let id: u64 = ctx as u64;
    if id == (0 as u64) { return; }
    let i: usize = (id -% (1 as u64)) as usize;
    if i >= (256 as usize) { return; }
    if SLOTS[i].used == false { return; }
    let cancelled: bool = SLOTS[i].cancelled;
    let work: fn(*u8) = SLOTS[i].work;
    let arg: *u8 = SLOTS[i].ctx;
    // Free the slot BEFORE the callback: a callback that re-arms (a debounce
    // does) must be able to take this slot back, and a cancel arriving during
    // the callback must find nothing to cancel.
    SLOTS[i].used = false;
    SLOTS[i].cancelled = false;
    if cancelled { return; }
    if work != (0 as fn(*u8)) { work(arg); }
    return;
}

fn after(secs: f64, work: fn(*u8), ctx: *u8) -> u64 {
    let id: u64 = slot_alloc(work, ctx);
    if id == (0 as u64) { return 0 as u64; }
    let nanos: i64 = (secs * 1000000000.0f64) as i64;
    let when: u64 = { dispatch_time(0 as u64, nanos) };
    { dispatch_after_f(when, main_dispatch_queue(), id as *u8, slot_fire) };
    return id;
}

fn cancel_after(id: u64) {
    if id == (0 as u64) { return; }
    let i: usize = (id -% (1 as u64)) as usize;
    if i >= (256 as usize) { return; }
    if SLOTS[i].used == false { return; }
    SLOTS[i].cancelled = true;
    return;
}

// NOT BUILT. AppKit posts `NSViewFrameDidChangeNotification` and the AppKit
// backend rides it; UIKit has no such notification — a view learns it was
// resized in `layoutSubviews`, which means a synthesized subclass overriding it
// and calling back. That is real work and it is not in this pass, so the seam
// answers "no handle" rather than a handle that never fires: a caller can tell
// the difference, and a silently dead observer is the failure this whole
// package is written to avoid.
// ---- observe_size ------------------------------------------------------------
// "A view learns it was resized in `layoutSubviews`" was the reason this seam
// was left empty, and it is the whole implementation rather than the obstacle.
//
// AppKit posts `NSViewFrameDidChangeNotification` and `facet_appkit` rides it.
// UIKit posts nothing — a view is TOLD, by having a method called on it — so
// the observer is a method added to the observed view's own class, which is a
// class this backend synthesizes per observed view.
//
// PER VIEW, not per class: `object_setClass` moves one view into a subclass of
// whatever it already was, so a UIScrollView stays a scroll view and a
// UITableView stays a table. One shared class could not do that — the base
// differs — and reclassing every view up front would pay for observers nobody
// asked for.

// Every pointer here is BORROWED: the view is UIKit's, the context is the
// caller's, and this record frees neither.
struct SizeWatch {
    opaque view: *u8,
    cb: fn(*u8),
    opaque ctx: *u8,
    live: bool,
}

static WATCHES: vec::Vec[SizeWatch] = #zero::[vec::Vec[SizeWatch]]();
static WATCH_SEQ: u64 = 0 as u64;

// `layoutSubviews` on a watched view: super first, because the subviews have to
// be where the layout put them before anyone is told the size changed.
fn imp_layout_subviews(self_obj: *u8, cmd: *u8) {
    let cls: *u8 = { rt::msg_id(self_obj, rt::sel(#str_ptr("class\0"))) };
    let base: *u8 = { class_get_superclass(cls) };
    if base != (0 as *u8) {
        var sup: ObjcSuper = ObjcSuper { receiver: self_obj, class_: base };
        { msg_super_void(#addr_of(sup), rt::sel(#str_ptr("layoutSubviews\0"))) };
    }
    var i: usize = 0 as usize;
    let n: usize = WATCHES.count();
    while i < n {
        match WATCHES.at_ptr(i) {
            option::Option[*SizeWatch]::Some(w) => {
                if { (*w).live } && { (*w).view } == self_obj {
                    let f: fn(*u8) = { (*w).cb };
                    if f != (0 as fn(*u8)) { f({ (*w).ctx }); }
                }
            }
            option::Option[*SizeWatch]::None => { }
        }
        i = i +% (1 as usize);
    }
    return;
}

// The observing subclass of whatever `v` already is.
//
// ONE CLASS PER OBSERVED VIEW, named by a counter. Naming it after the base
// would let two observers share a class, which is fine — but the base is
// whatever the view happens to be (a scroll view, a table, a plain view), and
// deriving a unique name from it costs a round trip through NSString for no
// gain. Observers are rare; classes are cheap.
fn watch_class_for(v: *u8) -> *u8 {
    let base: *u8 = { rt::msg_id(v, rt::sel(#str_ptr("class\0"))) };
    if base == (0 as *u8) { return 0 as *u8; }
    var name: text::Text = text::from_str("FacetUIKitSized_${WATCH_SEQ}");
    let cls: *u8 = { synth::allocate_class_pair(base, #str_ptr(name.view()),
                                                0 as usize) };
    if cls == (0 as *u8) { return 0 as *u8; }
    let _m: i8 = add_method_v_0(cls, rt::sel(#str_ptr("layoutSubviews\0")),
                                imp_layout_subviews, #str_ptr("v@:\0"));
    { synth::register_class_pair(cls) };
    return cls;
}

fn observe_size(n: *core::Node, cb: fn(*u8), ctx: *u8) -> u64 {
    if n == (0 as *core::Node) { return 0 as u64; }
    var v: *u8 = core::view_of(n);
    // A node with no view of its own is not a node with no SIZE: a keyless
    // pure-layout container is laid out with the nearest backed ancestor, so
    // that ancestor's frame is the one to watch. facet_appkit reaches the same
    // rule; a screen root is exactly such a node.
    if v == (0 as *u8) { v = nearest_backed_view(n); }
    if v == (0 as *u8) { return 0 as u64; }
    WATCH_SEQ = WATCH_SEQ +% (1 as u64);
    let cls: *u8 = watch_class_for(v);
    if cls == (0 as *u8) { return 0 as u64; }
    { object_set_class(v, cls) };
    let _s: status::Status = WATCHES.append(SizeWatch {
        view: v, cb: cb, ctx: ctx, live: true,
    });
    return WATCH_SEQ;
}

// Cancelled by INDEX, and the entry stays: the view keeps its subclass (moving
// it back would race a layout in flight), and a dead entry simply stops being
// called. The list is one per observer, not one per frame.
fn cancel_observe_size(id: u64) {
    if id == (0 as u64) { return; }
    let at: usize = (id -% (1 as u64)) as usize;
    match WATCHES.at_ptr(at) {
        option::Option[*SizeWatch]::Some(w) => { { (*w).live = false }; }
        option::Option[*SizeWatch]::None => { }
    }
    return;
}

// A node has no parent pointer, so the ancestor is found by searching DOWN from
// each open window's root and carrying the last backed node seen. Once per
// observer, not per frame.
fn nearest_backed_view(target: *core::Node) -> *u8 {
    var i: usize = 0 as usize;
    let n: usize = app::window_count();
    while i < n {
        let root: *core::Node = app::window_root(i);
        if root != (0 as *core::Node) {
            let hit: *u8 = backed_ancestor_walk(root, target, 0 as *u8);
            if hit != (0 as *u8) { return hit; }
        }
        i = i +% (1 as usize);
    }
    return 0 as *u8;
}

fn backed_ancestor_walk(node: *core::Node, target: *core::Node, carried: *u8) -> *u8 {
    var here: *u8 = carried;
    let v: *u8 = core::view_of(node);
    if v != (0 as *u8) { here = v; }
    if node == target { return here; }
    var i: usize = 0 as usize;
    let count: usize = core::child_count_of(node);
    while i < count {
        match core::child_of(node, i) {
            option::Option[*core::Node]::Some(c) => {
                let hit: *u8 = backed_ancestor_walk(c, target, here);
                if hit != (0 as *u8) { return hit; }
            }
            option::Option[*core::Node]::None => { }
        }
        i = i +% (1 as usize);
    }
    return 0 as *u8;
}

// The two words `objc_msgSendSuper` reads. Both borrowed.
#[repr(C)]
struct ObjcSuper { opaque receiver: *u8, opaque class_: *u8 }

#[link_name = "objc_msgSendSuper"]
extern fn msg_super_void(sup: *ObjcSuper, sel: *u8);
// The runtime's own names, not this module's. An extern's identifier is
// module-scoped in C+, so the bare linker symbol has to be said outright.
#[link_name = "class_getSuperclass"]
extern fn class_get_superclass(cls: *u8) -> *u8;
#[link_name = "object_setClass"]
extern fn object_set_class(obj: *u8, cls: *u8) -> *u8;
#[link_name = "class_addMethod"]
extern fn add_method_v_0(cls: *u8, sel: *u8, imp: fn(*u8, *u8), types: *u8) -> i8;

fn scheduler() -> services::Scheduler {
    return services::Scheduler {
        run_on_main: run_on_main,
        after: after,
        cancel_after: cancel_after,
        observe_size: observe_size,
        cancel_observe_size: cancel_observe_size,
    };
}
