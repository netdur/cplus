// facet_uikit input — how a touch reaches a facet handler.
//
// ONE SYNTHESIZED CLASS, not one per kind. facet_appkit subclasses each view it
// creates, because AppKit delivers input by overriding `mouseDown:` on the view
// itself — there is nowhere else for it to land. UIKit delivers it by
// target/action and by gesture recognizers, both of which take a SEPARATE
// target object, so one shared singleton can serve every control in the process
// and no view has its class moved.
//
// That difference is worth stating because it removes a whole family of
// problems the AppKit backend has to manage: no reclassing, no "arm after the
// kind body because arming moves the class", no per-kind subclass registry.
//
// THE NODE IS FOUND FROM THE SENDER, through an associated object on the view.
// The alternative — a target per node — would allocate an object per control
// and leak one per teardown, since target/action does not retain and there is
// no hook that fires when it lets go.

import "facet/facet" as core;
import "facet/props" as props;
import "facet/gestures" as gestures;
import "facet/vocabulary" as vocab;
import "objc/bridge" as bridge;
import "stdlib/text" as text;
import "facet/component" as component;
import "objc/runtime" as rt;
import "objc/synthesis" as synth;
import "uikit/uikit" as ui;
import "facet/radio" as radio;
import "facet/text_button" as text_button;
import "facet/application" as app;
import "stdlib/option" as option;
import "./dates" as dates;

// The associated-object key the node pointer rides on. A plain address, unique
// by being this module's own.
fn node_key() -> *u8 { return 41001 as *u8; }

// Bind a node to its view, so an action can find its way back. Refreshed on
// every arm: a re-attached node has a new address.
fn bind_node(v: *u8, n: *core::Node) {
    if v == (0 as *u8) { return; }
    synth::set_associated(v, node_key(), n as *u8);
    return;
}

fn node_of(v: *u8) -> *core::Node {
    if v == (0 as *u8) { return 0 as *core::Node; }
    return { synth::get_associated(v, node_key()) } as *core::Node;
}

// ---- the shared target -------------------------------------------------------

static TARGET_CLASS: *u8 = 0 as *u8;
static TARGET: *u8 = 0 as *u8;

// UIControlEvents, built arithmetically. An integer literal wraps through i32
// before `as`, so a mask written as one big number is a different number by the
// time it lands — the standing rule in this language, and these are the sort of
// constants it was written for.
fn event_touch_down() -> u64 { return 1 as u64; }                             // 1 << 0
fn event_touch_up_inside() -> u64 { return (1 as u64) * (64 as u64); }        // 1 << 6
fn event_touch_up_outside() -> u64 { return (1 as u64) * (128 as u64); }      // 1 << 7
fn event_value_changed() -> u64 { return (1 as u64) * (4096 as u64); }        // 1 << 12
// `EditingChanged` IS 1 << 17, and this said 1 << 16.
//
// 1 << 16 is `UIControlEventEditingDidBegin` — checked against
// UIKit.framework/Headers/UIControl.h rather than remembered. So the
// text-changed handler was armed for the event that fires when a field GAINS
// FOCUS, and never for the one that fires per keystroke: `on_text_changed` went
// off once when you tapped in, once when you tapped out, and not while you
// typed. The `text()` prop was stale for the whole of an editing session.
fn event_editing_did_begin() -> u64 { return (1 as u64) * (65536 as u64); }   // 1 << 16
fn event_editing_changed() -> u64 { return (1 as u64) * (131072 as u64); }    // 1 << 17
fn event_editing_did_end() -> u64 { return (1 as u64) * (262144 as u64); }    // 1 << 18
fn event_editing_did_end_on_exit() -> u64 { return (1 as u64) * (524288 as u64); } // 1 << 19

// The three actions, one per thing that can happen to a control. They are
// separate selectors rather than one with a switch, because the sender does not
// say WHICH event brought it — `addTarget:action:forControlEvents:` is where
// that was decided, and re-deriving it from the control's state afterwards is a
// guess.
fn imp_primary(self_obj: *u8, cmd: *u8, sender: *u8) {
    let n: *core::Node = node_of(sender);
    if n == (0 as *core::Node) { return; }
    fire_primary(n, sender);
    return;
}

fn imp_value_changed(self_obj: *u8, cmd: *u8, sender: *u8) {
    let n: *core::Node = node_of(sender);
    if n == (0 as *core::Node) { return; }
    read_back(n, sender);
    fire_value_changed(n, sender);
    return;
}

fn imp_editing_changed(self_obj: *u8, cmd: *u8, sender: *u8) {
    let n: *core::Node = node_of(sender);
    if n == (0 as *core::Node) { return; }
    read_back(n, sender);
    // `read_back` answers for every control that carries a VALUE and for no
    // text control — see `text_input::write_back_field`, which is the half that
    // was missing. Kept separate rather than folded into `read_back` because a
    // field's write-back also enforces `max_length` and fires a handler, which
    // no other read-back does.
    write_back_field(n, sender);
    return;
}

// The tap recogniser's action. `sender` is the RECOGNISER, not the view, so the
// node is found through the view it is attached to.
fn imp_tap(self_obj: *u8, cmd: *u8, recogniser: *u8) {
    if recogniser == (0 as *u8) { return; }
    let v: *u8 = { rt::msg_id(recogniser, rt::sel(#str_ptr("view\0"))) };
    let n: *core::Node = node_of(v);
    if n == (0 as *core::Node) { return; }
    let _fired: bool = gestures::fire_click(n);
    return;
}

// The shared band's `on_focus` / `on_blur`, which nothing on this backend fired.
//
// facet declares them on the SHARED band, so any node may carry them, and
// facet_appkit reports them from two places — `becomeFirstResponder` on its armed
// class for buttons and containers, and the field editor's begin/end editing for
// text controls. This backend reported them from NEITHER, so an application's
// focus callbacks were silent on iOS. Found by diffing the two backends' handler
// wiring, not by anyone hitting it.
//
// EDGE-TRIGGERED against `is_focused`, the same rule appkit keeps: one
// user-visible focus change calls the application once, whichever route reported
// it. A UITextField sends `EditingDidBegin` and `EditingDidEnd`; a UITextView is
// not a UIControl and reports the same two through its delegate, in
// text_input.cplus.
fn note_focus(n: *core::Node, focused: bool) {
    if n == (0 as *core::Node) { return; }
    if core::is_focused(n) == focused { return; }
    core::set_focused(n, focused);
    if focused { core::fire_focus_handler(n); } else { core::fire_blur_handler(n); }
    return;
}

fn imp_editing_did_begin(self_obj: *u8, cmd: *u8, sender: *u8) {
    note_focus(node_of(sender), true);
    return;
}

fn imp_editing_did_end(self_obj: *u8, cmd: *u8, sender: *u8) {
    note_focus(node_of(sender), false);
    return;
}

fn target_class() -> *u8 {
    if TARGET_CLASS != (0 as *u8) { return TARGET_CLASS; }
    let existing: *u8 = rt::get_class(#str_ptr("FacetUIKitTarget\0"));
    if existing != (0 as *u8) {
        TARGET_CLASS = existing;
        return TARGET_CLASS;
    }
    let base: *u8 = rt::get_class(#str_ptr("NSObject\0"));
    let cls: *u8 = { synth::allocate_class_pair(base, #str_ptr("FacetUIKitTarget\0"), 0 as usize) };
    if cls == (0 as *u8) { return 0 as *u8; }
    let _a: i8 = synth::add_method_v_1id(cls, rt::sel(#str_ptr("facetPrimary:\0")),
                                         imp_primary, #str_ptr("v@:@\0"));
    let _b: i8 = synth::add_method_v_1id(cls, rt::sel(#str_ptr("facetValueChanged:\0")),
                                         imp_value_changed, #str_ptr("v@:@\0"));
    let _c: i8 = synth::add_method_v_1id(cls, rt::sel(#str_ptr("facetEditingChanged:\0")),
                                         imp_editing_changed, #str_ptr("v@:@\0"));
    let _d: i8 = synth::add_method_v_1id(cls, rt::sel(#str_ptr("facetTap:\0")),
                                         imp_tap, #str_ptr("v@:@\0"));
    let _e: i8 = synth::add_method_v_1id(cls, rt::sel(#str_ptr("facetPressed:\0")),
                                         imp_pressed, #str_ptr("v@:@\0"));
    let _f: i8 = synth::add_method_v_1id(cls, rt::sel(#str_ptr("facetReleased:\0")),
                                         imp_released, #str_ptr("v@:@\0"));
    let _g: i8 = synth::add_method_v_1id(cls, rt::sel(#str_ptr("facetEditingDidBegin:\0")),
                                         imp_editing_did_begin, #str_ptr("v@:@\0"));
    let _h: i8 = synth::add_method_v_1id(cls, rt::sel(#str_ptr("facetEditingDidEnd:\0")),
                                         imp_editing_did_end, #str_ptr("v@:@\0"));
    { synth::register_class_pair(cls) };
    TARGET_CLASS = cls;
    return TARGET_CLASS;
}

// The one instance every control points at. Never released: it lives as long as
// the process, and target/action holds it unretained — so an owner that could
// drop it would be a dangling target on every control at once.
fn target() -> *u8 {
    if TARGET != (0 as *u8) { return TARGET; }
    let cls: *u8 = target_class();
    if cls == (0 as *u8) { return 0 as *u8; }
    TARGET = { synth::alloc_init_class(cls) };
    return TARGET;
}

// ---- arming ------------------------------------------------------------------

fn add_target(v: *u8, sel_name: *u8, events: u64) {
    let t: *u8 = target();
    if t == (0 as *u8) { return; }
    { msg_void_id_sel_u64(v, rt::sel(#str_ptr("addTarget:action:forControlEvents:\0")),
                          t, rt::sel(sel_name), events) };
    return;
}

// A control whose PRIMARY action is a tap: a button, an icon button.
fn arm_primary(v: *u8, n: *core::Node) {
    bind_node(v, n);
    add_target(v, #str_ptr("facetPrimary:\0"), event_touch_up_inside());
    // A release is a release wherever the finger lifts — dragging off the
    // button and letting go is still the end of a press, and an app holding
    // something down needs to be told.
    add_target(v, #str_ptr("facetPressed:\0"), event_touch_down());
    add_target(v, #str_ptr("facetReleased:\0"),
               event_touch_up_inside() | event_touch_up_outside());
    return;
}

// A control that carries a VALUE: a switch, a slider, a stepper, a segmented
// control, a page control, a date picker.
fn arm_value(v: *u8, n: *core::Node) {
    bind_node(v, n);
    add_target(v, #str_ptr("facetValueChanged:\0"), event_value_changed());
    return;
}

// A control whose DRAG has a start and an end worth reporting — which is the
// slider, and only the slider.
//
// This was folded into `arm_value` on the grounds that the extra events are
// free and `fire_press` answers only for the kinds that carry the verbs. They
// are not free. A UIRefreshControl armed for touchDown rendered its table's
// cells EMPTY — separators in the right places and no content in any of them —
// and the same list with the arming removed rendered normally. Measured both
// ways; the mechanism inside UIKit is not visible from here, and the fix is to
// ask for what the kind actually has rather than for everything.
fn arm_drag(v: *u8, n: *core::Node) {
    bind_node(v, n);
    add_target(v, #str_ptr("facetPressed:\0"), event_touch_down());
    add_target(v, #str_ptr("facetReleased:\0"),
               event_touch_up_inside() | event_touch_up_outside());
    return;
}

// A text field. Three events, because a field has three different moments an
// app cares about and UIKit names all three: every keystroke, the return key,
// and the end of editing.
fn arm_text_field(v: *u8, n: *core::Node) {
    bind_node(v, n);
    add_target(v, #str_ptr("facetEditingChanged:\0"), event_editing_changed());
    add_target(v, #str_ptr("facetPrimary:\0"), event_editing_did_end_on_exit());
    // Still on DidEnd as well as on Changed: the last value is worth syncing even
    // if a keystroke was somehow missed, and the handler is idempotent.
    add_target(v, #str_ptr("facetEditingChanged:\0"), event_editing_did_end());
    add_target(v, #str_ptr("facetEditingDidBegin:\0"), event_editing_did_begin());
    add_target(v, #str_ptr("facetEditingDidEnd:\0"), event_editing_did_end());
    return;
}

// A plain view that wants clicks. UIKit has no "mouseDown on any view", so the
// tap is a recogniser — which is also why an unkeyed container with a handler
// has to get a view at all (`views::wants_view` says so).
fn arm_tap(v: *u8, n: *core::Node) {
    if v == (0 as *u8) { return; }
    bind_node(v, n);
    if !gestures::has_gestures(n) { return; }
    // Idempotent: `apply` re-arms on every C_GESTURES write, and a second
    // recogniser would fire the handler twice per tap.
    if { synth::get_associated(v, tap_key()) } != (0 as *u8) { return; }
    let t: *u8 = target();
    if t == (0 as *u8) { return; }
    let cls: *u8 = rt::get_class(#str_ptr("UITapGestureRecognizer\0"));
    if cls == (0 as *u8) { return; }
    let alloced: *u8 = { rt::msg_id(cls, rt::sel(#str_ptr("alloc\0"))) };
    if alloced == (0 as *u8) { return; }
    let g: *u8 = { msg_id_id_sel(alloced, rt::sel(#str_ptr("initWithTarget:action:\0")),
                                 t, rt::sel(#str_ptr("facetTap:\0"))) };
    if g == (0 as *u8) { return; }
    ui::View::from_raw(v).set_user_interaction_enabled(true);
    { rt::msg_void_id(v, rt::sel(#str_ptr("addGestureRecognizer:\0")), g) };
    synth::set_associated(v, tap_key(), g);
    { rt::release(g) };
    return;
}

fn tap_key() -> *u8 { return 41002 as *u8; }

// ---- firing back into facet --------------------------------------------------

// A button's own `on_click` when it has one, and the gesture band's otherwise.
// A control kind carries its handler in its PROPS — the shared gesture band is
// what a plain view uses — so both are asked, in that order.
// THREE KINDS CARRY A CLICK HANDLER OF THEIR OWN, not one.
//
// `button`, `text_button` and `icon_button` are all a UIButton here, so they
// all arrive through this one action — and each keeps its handler in ITS OWN
// props. Routing only the first meant a text button and an icon button were
// armed, tapped, and did nothing at all: the gallery's Back button is a
// `text_button`, which is how this was found.
//
// COMPARED AGAINST `props::no_handler`, NOT AGAINST NULL. The default is a
// real function, so a null check is never false — which is why the fall
// through to the gesture band below was unreachable, and a `button` carrying
// only a `.gesture(on_click:)` was as dead as the text button.
fn fire_primary(n: *core::Node, sender: *u8) {
    let kind: u32 = core::kind_of(n);
    let d: *core::Data = core::node_data(n);
    if d == (0 as *core::Data) { return; }
    let p: *u8 = { (*d).props };
    if p != (0 as *u8) {
        if kind == props::K_BUTTON {
            let bp: *props::ButtonProps = p as *props::ButtonProps;
            let h: fn(*u8, *u8) = { (*bp).on_click };
            if h != props::no_handler { h(sender, { (*bp).on_click_ctx }); return; }
        }
        if kind == text_button::K_TEXT_BUTTON {
            let tp: *text_button::TextButtonProps = p as *text_button::TextButtonProps;
            let h: fn(*u8, *u8) = { (*tp).on_click };
            if h != props::no_handler { h(sender, { (*tp).on_click_ctx }); return; }
        }
        if kind == props::K_ICON_BUTTON {
            let ip: *props::IconButtonProps = p as *props::IconButtonProps;
            let h: fn(*u8, *u8) = { (*ip).on_clicked };
            if h != props::no_handler { h(sender, { (*ip).on_clicked_ctx }); return; }
        }
        // A radio arrives here rather than through `read_back` because a
        // UIButton has no value to hand back — pressing it is the whole event,
        // and what it MEANS (this member on, its group off) is the radio body's
        // to decide.
        if kind == props::K_RADIO { radio_pressed(n); return; }
        // THE RETURN KEY. `arm_text_field` points editingDidEndOnExit at this
        // same action, so a field's Done/Go/Search arrives here — and
        // `on_submit` is the owning control's own verb rather than the shared
        // band's, so it is read per kind. Without this the return key dismissed
        // the keyboard and told the application nothing.
        let sub: fn(*u8, *u8) = submit_handler(n);
        if sub != props::no_handler { sub(sender, submit_ctx(n)); return; }
    }
    let _fired: bool = gestures::fire_click(n);
    return;
}

// `on_submit` lives on the three kinds that can be completed. A node that is
// not one of them answers `no_handler`, which the caller treats as nothing to
// do.
fn submit_handler(n: *core::Node) -> fn(*u8, *u8) {
    let d: *core::Data = core::node_data(n);
    if d == (0 as *core::Data) { return props::no_handler; }
    let raw: *u8 = { (*d).props };
    if raw == (0 as *u8) { return props::no_handler; }
    let kind: u32 = { (*d).kind };
    if kind == props::K_TEXT_FIELD { return { (*(raw as *props::TextFieldProps)).on_submit }; }
    if kind == props::K_TEXT_AREA { return { (*(raw as *props::TextAreaProps)).on_submit }; }
    if kind == props::K_SEARCH_FIELD { return { (*(raw as *props::SearchFieldProps)).on_submit }; }
    return props::no_handler;
}

fn submit_ctx(n: *core::Node) -> *u8 {
    let d: *core::Data = core::node_data(n);
    if d == (0 as *core::Data) { return 0 as *u8; }
    let raw: *u8 = { (*d).props };
    if raw == (0 as *u8) { return 0 as *u8; }
    let kind: u32 = { (*d).kind };
    if kind == props::K_TEXT_FIELD { return { (*(raw as *props::TextFieldProps)).on_submit_ctx }; }
    if kind == props::K_TEXT_AREA { return { (*(raw as *props::TextAreaProps)).on_submit_ctx }; }
    if kind == props::K_SEARCH_FIELD { return { (*(raw as *props::SearchFieldProps)).on_submit_ctx }; }
    return 0 as *u8;
}

// ---- press and release -------------------------------------------------------
// The two moments a click is made of. `on_click` fires when the finger lifts
// INSIDE; these fire when it goes down, and when it lifts wherever it lifts —
// which is what a press-and-hold affordance needs and a click cannot express.

fn imp_pressed(self_obj: *u8, cmd: *u8, sender: *u8) {
    let n: *core::Node = node_of(sender);
    if n == (0 as *core::Node) { return; }
    fire_press(n, sender, true);
    return;
}

fn imp_released(self_obj: *u8, cmd: *u8, sender: *u8) {
    let n: *core::Node = node_of(sender);
    if n == (0 as *core::Node) { return; }
    fire_press(n, sender, false);
    return;
}

fn fire_press(n: *core::Node, sender: *u8, down: bool) {
    let kind: u32 = core::kind_of(n);
    let d: *core::Data = core::node_data(n);
    if d == (0 as *core::Data) { return; }
    let p: *u8 = { (*d).props };
    if p == (0 as *u8) { return; }
    if kind == props::K_BUTTON {
        let bp: *props::ButtonProps = p as *props::ButtonProps;
        if down {
            let h: fn(*u8, *u8) = { (*bp).on_pressed };
            if h != props::no_handler { h(sender, { (*bp).on_pressed_ctx }); }
        } else {
            let h: fn(*u8, *u8) = { (*bp).on_released };
            if h != props::no_handler { h(sender, { (*bp).on_released_ctx }); }
        }
        return;
    }
    if kind == props::K_ICON_BUTTON {
        let ip: *props::IconButtonProps = p as *props::IconButtonProps;
        if down {
            let h: fn(*u8, *u8) = { (*ip).on_pressed };
            if h != props::no_handler { h(sender, { (*ip).on_pressed_ctx }); }
        } else {
            let h: fn(*u8, *u8) = { (*ip).on_released };
            if h != props::no_handler { h(sender, { (*ip).on_released_ctx }); }
        }
        return;
    }
    // A SLIDER'S DRAG is the same two moments under a different pair of names.
    // The distinction matters to anything expensive: `on_value_changed` fires
    // continuously, and an application that only wants the number the user
    // settled on wants `on_drag_completed`.
    if kind == props::K_SLIDER {
        let sp: *props::SliderProps = p as *props::SliderProps;
        if down {
            let h: fn(*u8, *u8) = { (*sp).on_drag_started };
            if h != props::no_handler { h(sender, { (*sp).on_drag_started_ctx }); }
        } else {
            let h: fn(*u8, *u8) = { (*sp).on_drag_completed };
            if h != props::no_handler { h(sender, { (*sp).on_drag_completed_ctx }); }
        }
        return;
    }
    return;
}

fn fire_value_changed(n: *core::Node, sender: *u8) {
    let kind: u32 = core::kind_of(n);
    let d: *core::Data = core::node_data(n);
    if d == (0 as *core::Data) { return; }
    let p: *u8 = { (*d).props };
    if p == (0 as *u8) { return; }
    if kind == props::K_TOGGLE {
        let tp: *props::ToggleProps = p as *props::ToggleProps;
        let h: fn(*u8, *u8) = { (*tp).on_toggled };
        if h != (0 as fn(*u8, *u8)) { h(sender, { (*tp).on_toggled_ctx }); }
        return;
    }
    if kind == props::K_SLIDER {
        let sp: *props::SliderProps = p as *props::SliderProps;
        let h: fn(*u8, *u8) = { (*sp).on_value_changed };
        if h != (0 as fn(*u8, *u8)) { h(sender, { (*sp).on_value_changed_ctx }); }
        return;
    }
    if kind == props::K_STEPPER {
        let sp: *props::StepperProps = p as *props::StepperProps;
        let h: fn(*u8, *u8) = { (*sp).on_value_changed };
        if h != (0 as fn(*u8, *u8)) { h(sender, { (*sp).on_value_changed_ctx }); }
        return;
    }
    // The segmented-control family. Both kinds are a UISegmentedControl here
    // (MANIFEST.md §3 says why), so both arrive through the same event and are
    // told apart by their kind rather than by the sender's class.
    if kind == props::K_POPUP {
        let pp: *props::PopupProps = p as *props::PopupProps;
        let h: fn(*u8, *u8) = { (*pp).on_selected_index_changed };
        if h != (0 as fn(*u8, *u8)) { h(sender, { (*pp).on_selected_index_changed_ctx }); }
        return;
    }
    if kind == props::K_TABS {
        let tp: *props::TabsProps = p as *props::TabsProps;
        let h: fn(*u8, *u8) = { (*tp).on_tab_changed };
        if h != (0 as fn(*u8, *u8)) { h(sender, { (*tp).on_tab_changed_ctx }); }
        return;
    }
    // PULL TO REFRESH. The UIRefreshControl is armed with the LIST's node, so
    // its valueChanged arrives here wearing the list's kind — which is what
    // lets one action serve both. Without this the spinner appeared, span, and
    // the application was never told to load anything.
    if kind == props::K_LIST {
        let lp: *props::ListProps = p as *props::ListProps;
        let h: fn(*u8, *u8) = { (*lp).on_refreshing };
        if h != props::no_handler { h(sender, { (*lp).on_refreshing_ctx }); }
        return;
    }
    if kind == props::K_REFRESHABLE {
        let rp: *props::RefreshableProps = p as *props::RefreshableProps;
        let h: fn(*u8, *u8) = { (*rp).on_refreshing };
        if h != props::no_handler { h(sender, { (*rp).on_refreshing_ctx }); }
        return;
    }
    if kind == props::K_DATE_PICKER {
        let dp: *props::DatePickerProps = p as *props::DatePickerProps;
        let h: fn(*u8, *u8) = { (*dp).on_date_selected };
        if h != (0 as fn(*u8, *u8)) { h(sender, { (*dp).on_date_selected_ctx }); }
        return;
    }
    if kind == props::K_TIME_PICKER {
        let tp: *props::TimePickerProps = p as *props::TimePickerProps;
        let h: fn(*u8, *u8) = { (*tp).on_time_selected };
        if h != (0 as fn(*u8, *u8)) { h(sender, { (*tp).on_time_selected_ctx }); }
        return;
    }
    return;
}

// THE WRITE-BACK. A control the user moved holds the truth, and facet's props
// hold what the app last said — so the value has to travel back before any
// handler runs, or the handler reads the OLD number and the app's model and its
// screen disagree from the first interaction onwards.
//
// Written straight into the props rather than through the `set_*` verb, and
// deliberately: the verb would raise the control's dirty bit and the next sync
// would write the value back onto the control that just produced it. The AppKit
// backend has the same rule, for the same reason.
fn read_back(n: *core::Node, sender: *u8) {
    let kind: u32 = core::kind_of(n);
    let d: *core::Data = core::node_data(n);
    if d == (0 as *core::Data) { return; }
    let p: *u8 = { (*d).props };
    if p == (0 as *u8) { return; }
    if kind == props::K_TOGGLE {
        let tp: *props::ToggleProps = p as *props::ToggleProps;
        { (*tp).on = ui::Switch::from_raw(sender).is_on() };
        return;
    }
    if kind == props::K_SLIDER {
        let sp: *props::SliderProps = p as *props::SliderProps;
        { (*sp).value = ui::Slider::from_raw(sender).value() as f64 };
        return;
    }
    if kind == props::K_STEPPER {
        let sp: *props::StepperProps = p as *props::StepperProps;
        { (*sp).value = ui::Stepper::from_raw(sender).value() };
        return;
    }
    if kind == props::K_POPUP {
        let pp: *props::PopupProps = p as *props::PopupProps;
        { (*pp).selected_index = ui::SegmentedControl::from_raw(sender).selected_segment_index() };
        return;
    }
    if kind == props::K_TABS {
        let tp: *props::TabsProps = p as *props::TabsProps;
        { (*tp).selected_index = ui::SegmentedControl::from_raw(sender).selected_segment_index() };
        return;
    }
    if kind == props::K_PAGE_DOTS {
        let dp: *props::PageDotsProps = p as *props::PageDotsProps;
        { (*dp).position = ui::PageControl::from_raw(sender).current_page() };
        return;
    }
    // The wheels. A UIDatePicker carries an NSDate whichever mode it is in, so
    // the read is the same call and only the reduction differs: a date picker
    // wants y/m/d, a time picker wants seconds since midnight.
    if kind == props::K_DATE_PICKER {
        let dp: *props::DatePickerProps = p as *props::DatePickerProps;
        { (*dp).date = dates::date_of_nsdate({ rt::msg_id(sender, rt::sel(#str_ptr("date\0"))) }) };
        return;
    }
    if kind == props::K_TIME_PICKER {
        let tp: *props::TimePickerProps = p as *props::TimePickerProps;
        { (*tp).time = dates::time_of_nsdate({ rt::msg_id(sender, rt::sel(#str_ptr("date\0"))) }) };
        return;
    }
    return;
}

// THE SAME WRITE-BACK FOR A FIELD, and its absence was the bug.
//
// `imp_editing_changed` in input.cplus routes every text control's keystroke
// into `read_back`, and `read_back` answers for a switch, a slider, a stepper,
// a popup, tabs, page dots and both pickers — and for no text control at all.
// So on this backend a UITextField's typing reached nothing: `text()` answered
// whatever the app had last SET, and `on_text_changed` was never called. Only
// the text AREA worked, because a UITextView is not a UIControl and its
// keystrokes arrive through the delegate above instead, which does this.
//
// Found through the agent surface: `set_text` over MCP put "hello from mcp"
// into the gallery's field, on screen, and the echo label under it — written by
// the app's own `on_text_changed` — still said "(nothing typed)". A finger
// types down the identical path.
//
// A UISearchBar is the same shape (`input_view` embedded, its own props) and
// gets the same treatment, so the two fields cannot drift apart.
fn write_back_field(n: *core::Node, v: *u8) {
    let d: *core::Data = core::node_data(n);
    if d == (0 as *core::Data) { return; }
    let raw: *u8 = { (*d).props };
    if raw == (0 as *u8) { return; }
    let kind: u32 = { (*d).kind };
    var iv: *props::InputViewProps = 0 as *props::InputViewProps;
    if kind == props::K_TEXT_FIELD {
        iv = { #addr_of((*(raw as *props::TextFieldProps)).input_view) };
    } else if kind == props::K_SEARCH_FIELD {
        iv = { #addr_of((*(raw as *props::SearchFieldProps)).input_view) };
    } else {
        return;
    }
    // A UISearchBar holds its string on the bar itself (`text` is the search
    // bar's own property), so the same getter serves both.
    let s: *u8 = { rt::msg_id(v, rt::sel(#str_ptr("text\0"))) };
    var typed: text::Text = bridge::to_text(s);
    let max: i64 = { (*iv).max_length };
    if max > (0 as i64) && { typed.view().char_count() } > (max as usize) {
        typed = prefix_chars(typed.view(), max as usize);
        { rt::msg_void_id(v, rt::sel(#str_ptr("setText:\0")), bridge::nsstring(typed.view())) };
    }
    { (*iv).text = typed };
    let h: fn(*u8, *u8) = { (*iv).on_text_changed };
    if h != (0 as fn(*u8, *u8)) { h(v, { (*iv).on_text_changed_ctx }); }
    return;
}

// A continuation byte is 0b10xxxxxx; every other byte starts a character.
fn prefix_chars(s: str, n: usize) -> text::Text {
    var out: text::Text = text::from_str(s);
    let cut: usize = byte_offset_of_char(s, n);
    out.truncate(cut);
    return out;
}

// The BYTE offset at which character `n` begins. A continuation byte is
// 0b10xxxxxx; every other byte starts a character.
fn byte_offset_of_char(s: str, n: usize) -> usize {
    var chars: usize = 0 as usize;
    var i: usize = 0 as usize;
    let bytes: usize = { s.count() };
    while i < bytes {
        // `byte_at` answers an Option — an index past the end is not a byte,
        // and the type says so rather than handing back a zero.
        match { s.byte_at(i) } {
            option::Option[u8]::Some(b) => {
                if (b & (192 as u8)) != (128 as u8) {
                    if chars == n { return i; }
                    chars = chars +% (1 as usize);
                }
            }
            option::Option[u8]::None => { return bytes; }
        }
        i = i +% (1 as usize);
    }
    return bytes;
}

// ---- the radio group --------------------------------------------------------
// Lives here rather than beside the radio's drawing because it is what a PRESS
// means, and because `controls` already imports this module — the other
// direction would be a cycle.

// A radio's tap is EXCLUSION, not a toggle: tapping the selected member of a
// group leaves it selected, and tapping another moves the selection. That is
// why the write happens here rather than in the generic read-back — a radio has
// no value UIKit could hand back, only the fact that it was pressed.
fn radio_pressed(n: *core::Node) {
    let p: *props::RadioProps = props_of(n, props::K_RADIO) as *props::RadioProps;
    if p == (0 as *props::RadioProps) { return; }
    if { (*p).on } { return; }
    { (*p).on = true };
    core::touch(n, radio::P_ON);
    turn_off_group_siblings(n, { (*p).group.view() });
    let h: fn(*u8, *u8) = { (*p).on_checked_changed };
    if h != (0 as fn(*u8, *u8)) { h(0 as *u8, { (*p).on_checked_changed_ctx }); }
    return;
}

// Every other radio in the same group, off. Walks from each open window's root
// because a node has no parent pointer — the same walk `theme_changed` makes,
// and for the same reason.
fn turn_off_group_siblings(me: *core::Node, group: str) {
    if group == "" { return; }
    var i: usize = 0 as usize;
    let n: usize = app::window_count();
    while i < n {
        let r: *core::Node = app::window_root(i);
        if r != (0 as *core::Node) { group_walk(r, me, group); }
        i = i +% (1 as usize);
    }
    return;
}

fn group_walk(node: *core::Node, me: *core::Node, group: str) {
    if node != me && core::kind_of(node) == props::K_RADIO {
        let rp: *props::RadioProps = props_of(node, props::K_RADIO) as *props::RadioProps;
        if rp != (0 as *props::RadioProps) {
            if { (*rp).group.view() } == group && { (*rp).on } {
                { (*rp).on = false };
                core::touch(node, radio::P_ON);
            }
        }
    }
    var i: usize = 0 as usize;
    let count: usize = core::child_count_of(node);
    while i < count {
        match core::child_of(node, i) {
            option::Option[*core::Node]::Some(c) => { group_walk(c, me, group); }
            option::Option[*core::Node]::None => { }
        }
        i = i +% (1 as usize);
    }
    return;
}


// A node's props, unchecked past the kind the caller already knows.
fn props_of(n: *core::Node, kind: u32) -> *u8 {
    if core::kind_of(n) != kind { return 0 as *u8; }
    let d: *core::Data = core::node_data(n);
    if d == (0 as *core::Data) { return 0 as *u8; }
    return { (*d).props };
}

// ---- the sender readers ---------------------------------------------------------
// What a handler can recover from its opaque `sender`. facet declares six; four
// of them are the SAME CODE the AppKit backend runs, because they are written
// against `accessibilityIdentifier` and `superview` — both of which are UIView.
//
// That is worth saying out loud: this band was recorded as unfilled on the
// assumption it was AppKit work, and most of it was never AppKit-specific at
// all. Only the drag trio genuinely differs, and it is left empty on purpose —
// see below.

// A tap arrives with the CONTROL as sender; a gesture arrives with the
// RECOGNISER, which carries the view it is attached to. One reader for both.
fn sender_view(sender: *u8) -> *u8 {
    if sender == (0 as *u8) { return 0 as *u8; }
    if synth::class_responds(synth::object_class(sender),
                             rt::sel(#str_ptr("view\0"))) != (0 as i8) {
        let v: *u8 = { rt::msg_id(sender, rt::sel(#str_ptr("view\0"))) };
        if v != (0 as *u8) { return v; }
    }
    return sender;
}

// The key IS the accessibilityIdentifier (one token, three jobs), and the walk
// goes UP: a tap on an untagged icon inside a tagged row answers the row.
fn key_of(sender: *u8) -> text::Text {
    var v: *u8 = sender_view(sender);
    while v != (0 as *u8) {
        let ns: *u8 = { rt::msg_id(v, rt::sel(#str_ptr("accessibilityIdentifier\0"))) };
        if ns != (0 as *u8) {
            let len: u64 = { rt::msg_u64_u64(ns, rt::sel(#str_ptr("lengthOfBytesUsingEncoding:\0")),
                                             bridge::ns_utf8()) };
            if len > (0 as u64) { return bridge::to_text(ns); }
        }
        v = { rt::msg_id(v, rt::sel(#str_ptr("superview\0"))) };
    }
    return text::new();
}

// The app pointer a node carries, found by the same walk, so `item` and `key`
// always resolve off the same view.
fn item_key() -> *u8 { return 41040 as *u8; }

fn item_of(sender: *u8) -> *u8 {
    var v: *u8 = sender_view(sender);
    while v != (0 as *u8) {
        let it: *u8 = { synth::get_associated(v, item_key()) };
        if it != (0 as *u8) { return it; }
        v = { rt::msg_id(v, rt::sel(#str_ptr("superview\0"))) };
    }
    return 0 as *u8;
}

// Bring the keyed element to the front of its siblings, in place — the
// no-rebuild z-order change. facet is not reactive, so the element is addressed
// rather than re-described.
//
// `bringSubviewToFront:` is UIKit's own verb for it. AppKit has no such call
// and removes-and-re-adds to get the same ordering, which is the one place
// this reader is SHORTER than its AppKit twin rather than identical.
fn raise(sender: *u8, key: str) {
    let sv: *u8 = sender_view(sender);
    if sv == (0 as *u8) { return; }
    // THE WINDOW WHEN THERE IS ONE, THE TOPMOST ANCESTOR OTHERWISE.
    //
    // The AppKit backend searches from the window's content view, which is
    // right for a screen and wrong for everything this backend realises
    // OUTSIDE one: a recycled row's subtree is live and mounted before its
    // cell is on screen, so `window` is nil and the search would find nothing.
    // Falling back to the highest ancestor reachable makes the same call work
    // in both places, and a view IN a window still searches the whole window
    // because that is where the walk ends up.
    var root: *u8 = { rt::msg_id(sv, rt::sel(#str_ptr("window\0"))) };
    if root == (0 as *u8) { root = topmost(sv); }
    if root == (0 as *u8) { return; }
    let target: *u8 = find_by_key(root, key);
    if target == (0 as *u8) { return; }
    let sup: *u8 = { rt::msg_id(target, rt::sel(#str_ptr("superview\0"))) };
    if sup == (0 as *u8) { return; }
    { rt::msg_void_id(sup, rt::sel(#str_ptr("bringSubviewToFront:\0")), target) };
    return;
}

fn topmost(v: *u8) -> *u8 {
    var cur: *u8 = v;
    var depth: i32 = 0 as i32;
    while depth < (64 as i32) {
        let sup: *u8 = { rt::msg_id(cur, rt::sel(#str_ptr("superview\0"))) };
        if sup == (0 as *u8) { return cur; }
        cur = sup;
        depth = depth + (1 as i32);
    }
    return cur;
}

fn find_by_key(root: *u8, key: str) -> *u8 {
    if root == (0 as *u8) { return 0 as *u8; }
    let ns: *u8 = { rt::msg_id(root, rt::sel(#str_ptr("accessibilityIdentifier\0"))) };
    if ns != (0 as *u8) {
        if { bridge::to_text(ns).view() } == key { return root; }
    }
    let subs: *u8 = { rt::msg_id(root, rt::sel(#str_ptr("subviews\0"))) };
    if subs == (0 as *u8) { return 0 as *u8; }
    let count: u64 = { rt::msg_u64(subs, rt::sel(#str_ptr("count\0"))) };
    var i: u64 = 0 as u64;
    while i < count {
        let child: *u8 = { rt::msg_id_u64(subs, rt::sel(#str_ptr("objectAtIndex:\0")), i) };
        let hit: *u8 = find_by_key(child, key);
        if hit != (0 as *u8) { return hit; }
        i = i +% (1 as u64);
    }
    return 0 as *u8;
}

// THE DRAG TRIO IS LEFT EMPTY, and deliberately rather than for want of time.
//
// On macOS these read an `NSDraggingInfo` the view was handed. iOS has the same
// three questions and a different answer — `UIDropInteraction` — and nothing in
// facet asks them on this platform yet: facet declares no drag verbs at all (an
// agent has no hands, and a phone's drag-and-drop is BETWEEN apps rather than
// within one). Filling them would be inventing a caller.
//
// Zero fields keep facet's portable defaults — empty text, no position, not
// targeted — which is the seam working as designed rather than a hole.
fn sender_readers() -> component::SenderReaders {
    return component::SenderReaders {
        raise: raise,
        key_of: key_of,
        item_of: item_of,
        dropped_text: 0 as fn(*u8) -> text::Text,
        drop_position: 0 as fn(*u8) -> option::Option[vocab::Point],
        drag_targeted: 0 as fn(*u8) -> bool,
    };
}

#[link_name = "objc_msgSend"]
extern fn msg_void_id_sel_u64(recv: *u8, sel: *u8, target: *u8, action: *u8, events: u64);
#[link_name = "objc_msgSend"]
extern fn msg_id_id_sel(recv: *u8, sel: *u8, target: *u8, action: *u8) -> *u8;
