// facet_uikit dates — facet's calendar vocabulary, and UIKit's NSDate.
//
// A LEAF MODULE ON PURPOSE. Both `controls` (writing a picker) and `input`
// (reading one back) need this bridge, and `input` cannot import `text_input`
// because `text_input` imports `input` — so the bridge lives where neither has
// to reach through the other.
//
// facet carries a date as three integers and a time as seconds-since-midnight;
// UIKit works in NSDate. The bridge is NSDateComponents and the CURRENT
// CALENDAR, which is also what makes the round trip honest: a date is a
// calendar fact, not an instant, and turning y/m/d into an instant without one
// is where timezone bugs come from.

import "facet/vocabulary" as vocab;
import "objc/runtime" as rt;

fn calendar() -> *u8 {
    return { rt::msg_id(rt::get_class(#str_ptr("NSCalendar\0")),
                        rt::sel(#str_ptr("currentCalendar\0"))) };
}

// An NSDate for midnight on `d`, or null when the date is unset (all zero).
fn nsdate_of(d: vocab::Date) -> *u8 {
    if { d.year } == (0 as i64) { return 0 as *u8; }
    let comps: *u8 = { rt::alloc_init(#str_ptr("NSDateComponents\0")) };
    if comps == (0 as *u8) { return 0 as *u8; }
    { rt::msg_void_i64(comps, rt::sel(#str_ptr("setYear:\0")), { d.year }) };
    { rt::msg_void_i64(comps, rt::sel(#str_ptr("setMonth:\0")), { d.month }) };
    { rt::msg_void_i64(comps, rt::sel(#str_ptr("setDay:\0")), { d.day }) };
    let cal: *u8 = calendar();
    if cal == (0 as *u8) { { rt::release(comps) }; return 0 as *u8; }
    let date: *u8 = { rt::msg_id_id(cal, rt::sel(#str_ptr("dateFromComponents:\0")), comps) };
    { rt::release(comps) };
    return date;
}

// The inverse, for the write-back.
fn date_of_nsdate(date: *u8) -> vocab::Date {
    if date == (0 as *u8) { return vocab::Date::zero(); }
    let cal: *u8 = calendar();
    if cal == (0 as *u8) { return vocab::Date::zero(); }
    // NSCalendarUnit: year 4, month 8, day 16.
    let comps: *u8 = { msg_id_u64_id(cal, rt::sel(#str_ptr("components:fromDate:\0")),
                                     28 as u64, date) };
    if comps == (0 as *u8) { return vocab::Date::zero(); }
    return vocab::Date {
        year: { rt::msg_i64(comps, rt::sel(#str_ptr("year\0"))) },
        month: { rt::msg_i64(comps, rt::sel(#str_ptr("month\0"))) },
        day: { rt::msg_i64(comps, rt::sel(#str_ptr("day\0"))) },
    };
}

// A time is seconds since midnight, so its NSDate is today's midnight plus
// that offset — which is what a UIDatePicker in Time mode reads and writes.
fn nsdate_of_time(t: vocab::Duration) -> *u8 {
    let cal: *u8 = calendar();
    if cal == (0 as *u8) { return 0 as *u8; }
    let now: *u8 = { rt::msg_id(rt::get_class(#str_ptr("NSDate\0")),
                                rt::sel(#str_ptr("date\0"))) };
    if now == (0 as *u8) { return 0 as *u8; }
    let midnight: *u8 = { rt::msg_id_id(cal, rt::sel(#str_ptr("startOfDayForDate:\0")), now) };
    if midnight == (0 as *u8) { return 0 as *u8; }
    return { msg_id_f64_id(rt::get_class(#str_ptr("NSDate\0")),
                           rt::sel(#str_ptr("dateWithTimeInterval:sinceDate:\0")),
                           { t.seconds }, midnight) };
}

fn time_of_nsdate(date: *u8) -> vocab::Duration {
    if date == (0 as *u8) { return vocab::Duration::zero(); }
    let cal: *u8 = calendar();
    if cal == (0 as *u8) { return vocab::Duration::zero(); }
    let midnight: *u8 = { rt::msg_id_id(cal, rt::sel(#str_ptr("startOfDayForDate:\0")), date) };
    if midnight == (0 as *u8) { return vocab::Duration::zero(); }
    let secs: f64 = { msg_f64_id(date, rt::sel(#str_ptr("timeIntervalSinceDate:\0")), midnight) };
    return vocab::Duration { seconds: secs };
}

#[link_name = "objc_msgSend"]
extern fn msg_id_u64_id(recv: *u8, sel: *u8, a: u64, b: *u8) -> *u8;
#[link_name = "objc_msgSend"]
extern fn msg_id_f64_id(recv: *u8, sel: *u8, a: f64, b: *u8) -> *u8;
#[link_name = "objc_msgSend"]
extern fn msg_f64_id(recv: *u8, sel: *u8, a: *u8) -> f64;
