// facet_uikit controls — one body per kind.
//
// Each `create_<kind>` returns a view at +1; each `apply_<kind>` re-reads the
// props the dirty word names. `create` calls its `apply` with an all-ones word,
// so a control cannot be correct on mount and wrong on its first update — the
// same rule facet_appkit is built on.
//
// The bodies read facet's typed props directly. `props_of` answers null when
// the node's kind does not match, which is the guard every body opens with:
// reinterpreting one control's props as another's is the one mistake in this
// file that would not be caught by the compiler.

import "stdlib/option" as option;
import "stdlib/text" as text;
import "stdlib/vec" as vec;
import "stdlib/status" as status;
import "facet/facet" as core;
import "facet/props" as props;
import "facet/vocabulary" as vocab;
import "facet/label" as label;
import "facet/button" as button;
import "facet/toggle" as toggle;
import "facet/checkbox" as checkbox;
import "flex_layout/flex_layout" as flex;
import "facet/canvas" as canvas;
import "facet/radio" as radio;
import "facet/span" as span;
import "facet/slider" as slider;
import "facet/progress" as progress;
import "facet/spinner" as spinner;
import "facet/stepper" as stepper;
import "facet/image" as image;
import "facet/icon_button" as icon_button;
import "facet/scroll" as scroll;
import "facet/box" as box_props;
import "facet/bordered" as bordered;
import "facet/text_field" as text_field;
import "facet/text_area" as text_area;
import "facet/search_field" as search_field;
import "facet/popup" as popup;
import "facet/tabs" as tabs;
import "facet/page_dots" as page_dots;
import "facet/date_picker" as date_picker;
import "facet/time_picker" as time_picker;
import "facet/refreshable" as refreshable;
import "facet/symbol" as symbol;
import "facet/text_button" as text_button;
import "facet/split" as split;
import "facet/tree" as tree;
import "facet/window_chrome" as chrome;
import "facet/application" as app;
import "objc/runtime" as rt;
import "objc/bridge" as bridge;
import "objc/synthesis" as synth;
import "quartzcore/quartzcore" as quartz;
import "uikit/uikit" as ui;
import "./paint" as paint;
import "./drawing" as drawing;
import "./input" as input;
import "./text_input" as ti;
import "./dates" as dates;

fn props_of(n: *core::Node, kind: u32) -> *u8 {
    let d: *core::Data = core::node_data(n);
    if d == (0 as *core::Data) { return 0 as *u8; }
    if { (*d).kind } != kind { return 0 as *u8; }
    return { (*d).props };
}

// ---- the kind ledger ---------------------------------------------------------
// Three lists, and the whole honesty of this package is in keeping them apart.
//
//   non-view kinds     not rectangles at all — read as nodes by their parent
//   decided_absent     iOS has no such thing; MANIFEST.md says what to use
//   not_yet_built      iOS HAS an answer and this pass did not write it
//
// A kind in the second list is finished. A kind in the third is a debt, and it
// warns once on stderr when it is mounted so the debt is audible rather than a
// rectangle that silently does nothing.

fn menu_kind(kind: u32) -> bool {
    return kind == props::K_MENU_ITEM || kind == props::K_CONTEXT_MENU
        || kind == props::K_CONTEXT_MENU_ITEM;
}

// The menu-bar tier. On macOS these are objects the application owns rather
// than rectangles; on iOS they mostly do not exist at all, but the ANSWER to
// "does this occupy space in the tree" is the same no, so the classification is
// shared and only MANIFEST.md differs.
fn menu_bar_kind(kind: u32) -> bool {
    return kind == props::K_MENU || kind == props::K_TOOLBAR_ITEM;
}

fn span_kind(kind: u32) -> bool { return kind == props::K_SPAN; }

fn swipe_kind(kind: u32) -> bool { return kind == props::K_SWIPE_ITEM; }

// DECIDED, NOT MISSING. Every entry here is a thing iOS does not have, and
// MANIFEST.md carries the reason and the alternative for each one.
fn decided_absent(kind: u32) -> bool {
    // A window's close/minimise/zoom buttons. An iOS window is the screen.
    if kind == chrome::K_WINDOW_BUTTONS { return true; }
    // A draggable split divider is a pointer idiom. UISplitViewController is a
    // navigation container with a fixed sidebar, not a resizable pane pair, so
    // rendering the two panes stacked is the honest answer rather than pretending
    // at a divider nothing can drag.
    // The menu bar. There is none.
    if menu_bar_kind(kind) { return true; }
    return false;
}

// NOT YET BUILT — a real UIKit answer exists and this pass did not reach it.
// Each renders its content through a plain backing view, so a screen containing
// one is not blank, and each warns once.
fn not_yet_built(kind: u32) -> bool {
    // The recycling tier: UITableView / UICollectionView with a data source.
    // facet_appkit's recycler is 2,900 lines and this is the single largest
    // piece of work left in this package.
    // WKWebView is the same class on both platforms; the work is the navigation
    // delegate and the message handler, not the view.
    // A drawn surface needs a UIView subclass with `drawRect:` and the display
    // list walked into a CGContext — facet_appkit's drawing.cplus, ported.
    // Swipe actions belong to a table row on iOS, so this one waits for the
    // recycling tier above rather than being independent of it.
    return false;
}

// The pass-through: a node whose own behaviour is not built yet still lays its
// children out and still draws its shared band. Nothing is dropped; the kind's
// own verbs are what is missing.
fn create_passthrough(n: *core::Node) -> *u8 {
    let v: ui::View = ui::View::new_with_frame(zero_rect());
    return rt::retain(v.raw());
}

fn zero_rect() -> rt::Rect {
    return rt::Rect { x: 0.0f64, y: 0.0f64, w: 0.0f64, h: 0.0f64 };
}

// ---- label -------------------------------------------------------------------
// UILabel, which IS a label class — where AppKit has to put an NSTextField into
// a label posture. `numberOfLines` 0 means unbounded, which is facet's `0` too.

fn create_label(n: *core::Node) -> *u8 {
    let l: ui::Label = ui::Label::new_with_frame(zero_rect());
    l.set_number_of_lines(0 as i64);
    return rt::retain(l.as_view().raw());
}

fn apply_label(v: *u8, n: *core::Node, dirty: u64) {
    let p: *props::LabelProps = props_of(n, props::K_LABEL) as *props::LabelProps;
    if p == (0 as *props::LabelProps) { return; }
    let l: ui::Label = ui::Label::from_raw(v);
    // The text and everything that DECORATES it are one write: kerning, line
    // height, an underline and the value-carried runs all live in an attributed
    // string, and it is rebuilt whole or the previous one survives underneath.
    let rich: u64 = label::P_TEXT | label::P_TEXT_TRANSFORM
        | label::P_CHARACTER_SPACING | label::P_LINE_HEIGHT
        | label::P_TEXT_DECORATION | label::P_TEXT_FORMAT
        | label::P_FORMATTED_TEXT | label::P_TEXT_COLOR | label::P_TEXT_ALIGN
        | span::P_FONT_SCALES;
    if (dirty & rich) != (0 as u64) {
        let shown: text::Text = transformed({ (*p).text.view() }, { (*p).text_transform });
        if has_spans(n) {
            // SPAN CHILDREN win over everything. A label with `span` children
            // IS its children — the plain string is what a label says when it
            // has none, and a backend that drew both would draw the sentence
            // twice.
            let runs: *u8 = build_runs(n);
            if runs != (0 as *u8) {
                { rt::msg_void_id(v, rt::sel(#str_ptr("setAttributedText:\0")), runs) };
                { rt::release(runs) };
            }
        } else if formatted_count(p) > (0 as usize) {
            // `formatted_text` is the VALUE-carried run list — a label whose
            // text IS a sequence of styled spans. It wins over the plain
            // string, because it is the more specific answer to the same
            // question.
            let a: *u8 = build_value_runs(p);
            if a != (0 as *u8) {
                { rt::msg_void_id(v, rt::sel(#str_ptr("setAttributedText:\0")), a) };
                { rt::release(a) };
            }
        } else if is_html(p) {
            // `TextType.Html` means the string IS markup, and parsing it is the
            // whole feature — a backend that stripped the tags would be
            // answering a different question.
            let a: *u8 = html_string(shown.view());
            if a != (0 as *u8) {
                { rt::msg_void_id(v, rt::sel(#str_ptr("setAttributedText:\0")), a) };
                { rt::release(a) };
            } else {
                l.set_text(shown.view());
            }
        } else if label_wants_rich(p) {
            let a: *u8 = label_attributed(shown.view(), p);
            if a != (0 as *u8) {
                { rt::msg_void_id(v, rt::sel(#str_ptr("setAttributedText:\0")), a) };
                { rt::release(a) };
            } else {
                l.set_text(shown.view());
            }
        } else {
            l.set_text(shown.view());
        }
    }
    if (dirty & label::P_TEXT_COLOR) != (0 as u64) {
        let c: vocab::Color = { (*p).text_color };
        if c.is_set() { l.set_text_color(paint::ui_color(c)); }
    }
    if (dirty & (label::P_FONT_SIZE | label::P_FONT_WEIGHT | label::P_FONT_FAMILY
                 | label::P_IS_ITALIC | label::P_FONT_SCALES)) != (0 as u64) {
        match paint::ui_font({ (*p).font_size }, { (*p).font_weight },
                             { (*p).font_family.view() }, { (*p).is_italic },
                             { (*p).font_scales }) {
            option::Option[ui::Font]::Some(f) => {
                l.set_font(f);
                { rt::msg_void_i8(v, rt::sel(#str_ptr("setAdjustsFontForContentSizeCategory:\0")),
                                  bool_i8({ (*p).font_scales })) };
            }
            option::Option[ui::Font]::None => { }
        }
    }
    if (dirty & label::P_TEXT_ALIGN) != (0 as u64) {
        l.set_text_alignment(text_align_of({ (*p).text_align }));
    }
    if (dirty & (label::P_MAX_LINES | label::P_LINE_BREAK)) != (0 as u64) {
        l.set_number_of_lines({ (*p).max_lines });
        l.set_line_break_mode(line_break_of({ (*p).line_break }));
    }
    // The VERTICAL half. A UILabel centres its text in whatever rect it is
    // given and has no vertical alignment — so the alignment is expressed by
    // the label's own content-hugging inside its box, which is the only lever a
    // plain label has. MANIFEST.md records that top/bottom are approximate.
    if (dirty & label::P_VERTICAL_ALIGN) != (0 as u64) {
        apply_label_vertical(v, { (*p).vertical_align });
    }
    return;
}

fn formatted_count(p: *props::LabelProps) -> usize {
    return { (*p).formatted_text.count() };
}

fn is_html(p: *props::LabelProps) -> bool {
    return match { (*p).text_format } {
        vocab::TextFormat::Text => false,
        vocab::TextFormat::Html => true,
    };
}

// Does this label ask for anything a plain string cannot carry?
fn label_wants_rich(p: *props::LabelProps) -> bool {
    if { (*p).character_spacing } != 0.0f64 { return true; }
    if { (*p).line_height } != 0.0f64 { return true; }
    return match { (*p).text_decoration } {
        vocab::TextDecoration::None => false,
        vocab::TextDecoration::Underline => true,
        vocab::TextDecoration::Strikethrough => true,
    };
}

// One attributed string carrying kerning, line height and a decoration, at +1.
fn label_attributed(s: str, p: *props::LabelProps) -> *u8 {
    let dict: *u8 = { rt::alloc_init(#str_ptr("NSMutableDictionary\0")) };
    if dict == (0 as *u8) { return 0 as *u8; }
    if { (*p).character_spacing } != 0.0f64 {
        { rt::msg_void_id_id(dict, rt::sel(#str_ptr("setObject:forKey:\0")),
                             number_f64({ (*p).character_spacing }),
                             bridge::nsstring("NSKern")) };
    }
    if decoration_underlines({ (*p).text_decoration }) {
        { rt::msg_void_id_id(dict, rt::sel(#str_ptr("setObject:forKey:\0")),
                             number_i64(1 as i64), bridge::nsstring("NSUnderline")) };
    }
    if decoration_strikes({ (*p).text_decoration }) {
        { rt::msg_void_id_id(dict, rt::sel(#str_ptr("setObject:forKey:\0")),
                             number_i64(1 as i64), bridge::nsstring("NSStrikethrough")) };
    }
    // Line height is a PARAGRAPH property, not a character one — it needs its
    // own style object, which is also where a label's alignment would live if
    // the plain property did not already carry it.
    if { (*p).line_height } != 0.0f64 {
        let ps: *u8 = { rt::alloc_init(#str_ptr("NSMutableParagraphStyle\0")) };
        if ps != (0 as *u8) {
            { rt::msg_void_f64(ps, rt::sel(#str_ptr("setMinimumLineHeight:\0")),
                               { (*p).line_height }) };
            { rt::msg_void_f64(ps, rt::sel(#str_ptr("setMaximumLineHeight:\0")),
                               { (*p).line_height }) };
            { rt::msg_void_id_id(dict, rt::sel(#str_ptr("setObject:forKey:\0")),
                                 ps, bridge::nsstring("NSParagraphStyle")) };
            { rt::release(ps) };
        }
    }
    let c: vocab::Color = { (*p).text_color };
    if c.is_set() {
        { rt::msg_void_id_id(dict, rt::sel(#str_ptr("setObject:forKey:\0")),
                             paint::ui_color(c).raw(), bridge::nsstring("NSColor")) };
    }
    let cls: *u8 = rt::get_class(#str_ptr("NSAttributedString\0"));
    let alloced: *u8 = { rt::msg_id(cls, rt::sel(#str_ptr("alloc\0"))) };
    if alloced == (0 as *u8) { { rt::release(dict) }; return 0 as *u8; }
    let a: *u8 = { rt::msg_id_id_id(alloced, rt::sel(#str_ptr("initWithString:attributes:\0")),
                                    bridge::nsstring(s), dict) };
    { rt::release(dict) };
    return a;
}

// The value-carried runs: each span its own string, colour, weight and size,
// concatenated into one attributed string.
fn build_value_runs(p: *props::LabelProps) -> *u8 {
    let spans: *vocab::Spans = { #addr_of((*p).formatted_text) };
    let n: usize = { (*spans).count() };
    if n == (0 as usize) { return 0 as *u8; }
    let cls: *u8 = rt::get_class(#str_ptr("NSMutableAttributedString\0"));
    let out: *u8 = { rt::alloc_init(#str_ptr("NSMutableAttributedString\0")) };
    if out == (0 as *u8) { return 0 as *u8; }
    var i: usize = 0 as usize;
    while i < n {
        let sp: *vocab::TextSpan = { (*spans).at(i) };
        let dict: *u8 = { rt::alloc_init(#str_ptr("NSMutableDictionary\0")) };
        if dict != (0 as *u8) {
            let sc: vocab::Color = { (*sp).color };
            if sc.is_set() {
                { rt::msg_void_id_id(dict, rt::sel(#str_ptr("setObject:forKey:\0")),
                                     paint::ui_color(sc).raw(),
                                     bridge::nsstring("NSColor")) };
            }
            // A run may carry its own decoration, which is what makes one word
            // of a sentence a link and the rest plain.
            if decoration_underlines({ (*sp).decoration }) {
                { rt::msg_void_id_id(dict, rt::sel(#str_ptr("setObject:forKey:\0")),
                                     number_i64(1 as i64), bridge::nsstring("NSUnderline")) };
            }
            if decoration_strikes({ (*sp).decoration }) {
                { rt::msg_void_id_id(dict, rt::sel(#str_ptr("setObject:forKey:\0")),
                                     number_i64(1 as i64), bridge::nsstring("NSStrikethrough")) };
            }
            let bc: vocab::Color = { (*sp).background_color };
            if bc.is_set() {
                { rt::msg_void_id_id(dict, rt::sel(#str_ptr("setObject:forKey:\0")),
                                     paint::ui_color(bc).raw(),
                                     bridge::nsstring("NSBackgroundColor")) };
            }
            match paint::ui_font({ (*sp).font_size }, { (*sp).font_weight },
                                 { (*sp).font_family.view() },
                                 { (*sp).is_italic }, false) {
                option::Option[ui::Font]::Some(f) => {
                    { rt::msg_void_id_id(dict, rt::sel(#str_ptr("setObject:forKey:\0")),
                                         f.raw(), bridge::nsstring("NSFont")) };
                }
                option::Option[ui::Font]::None => { }
            }
            let piece: *u8 = { rt::msg_id_id_id(
                { rt::msg_id(rt::get_class(#str_ptr("NSAttributedString\0")),
                             rt::sel(#str_ptr("alloc\0"))) },
                rt::sel(#str_ptr("initWithString:attributes:\0")),
                bridge::nsstring({ (*sp).text.view() }), dict) };
            if piece != (0 as *u8) {
                { rt::msg_void_id(out, rt::sel(#str_ptr("appendAttributedString:\0")), piece) };
                { rt::release(piece) };
            }
            { rt::release(dict) };
        }
        i = i +% (1 as usize);
    }
    return out;
}

// ---- span children ----------------------------------------------------------
// A `span` is not a view — it is a RUN inside its parent label, the same way a
// `menu_item` is a row rather than a window. `views::non_view_kind` says so;
// this is where the kind actually means something.

fn has_spans(n: *core::Node) -> bool {
    var i: usize = 0 as usize;
    let count: usize = core::child_count_of(n);
    while i < count {
        match core::child_of(n, i) {
            option::Option[*core::Node]::Some(c) => {
                if core::kind_of(c) == props::K_SPAN { return true; }
            }
            option::Option[*core::Node]::None => { }
        }
        i = i +% (1 as usize);
    }
    return false;
}

// The attributed string a label's span children describe, at +1.
fn build_runs(n: *core::Node) -> *u8 {
    let ms: *u8 = { rt::alloc_init(#str_ptr("NSMutableAttributedString\0")) };
    if ms == (0 as *u8) { return 0 as *u8; }
    var i: usize = 0 as usize;
    let count: usize = core::child_count_of(n);
    while i < count {
        match core::child_of(n, i) {
            option::Option[*core::Node]::Some(c) => { append_run(ms, c); }
            option::Option[*core::Node]::None => { }
        }
        i = i +% (1 as usize);
    }
    return ms;
}

// One run. A span that names nothing inherits the label's own font and colour,
// which is what an unstyled run should do — so an attribute is written only
// when the span actually asked for it.
fn append_run(ms: *u8, c: *core::Node) {
    let p: *props::SpanProps = props_of(c, props::K_SPAN) as *props::SpanProps;
    if p == (0 as *props::SpanProps) { return; }
    let shown: text::Text = transformed({ (*p).text.view() }, { (*p).text_transform });
    let dict: *u8 = { rt::alloc_init(#str_ptr("NSMutableDictionary\0")) };
    if dict == (0 as *u8) { return; }
    if { (*p).character_spacing } != 0.0f64 {
        { rt::msg_void_id_id(dict, rt::sel(#str_ptr("setObject:forKey:\0")),
                             number_f64({ (*p).character_spacing }),
                             bridge::nsstring("NSKern")) };
    }
    if decoration_underlines({ (*p).text_decoration }) {
        { rt::msg_void_id_id(dict, rt::sel(#str_ptr("setObject:forKey:\0")),
                             number_i64(1 as i64), bridge::nsstring("NSUnderline")) };
    }
    if decoration_strikes({ (*p).text_decoration }) {
        { rt::msg_void_id_id(dict, rt::sel(#str_ptr("setObject:forKey:\0")),
                             number_i64(1 as i64), bridge::nsstring("NSStrikethrough")) };
    }
    if { (*p).line_height } != 0.0f64 {
        let ps: *u8 = { rt::alloc_init(#str_ptr("NSMutableParagraphStyle\0")) };
        if ps != (0 as *u8) {
            { rt::msg_void_f64(ps, rt::sel(#str_ptr("setMinimumLineHeight:\0")),
                               { (*p).line_height }) };
            { rt::msg_void_f64(ps, rt::sel(#str_ptr("setMaximumLineHeight:\0")),
                               { (*p).line_height }) };
            { rt::msg_void_id_id(dict, rt::sel(#str_ptr("setObject:forKey:\0")),
                                 ps, bridge::nsstring("NSParagraphStyle")) };
            { rt::release(ps) };
        }
    }
    let tc: vocab::Color = { (*p).text_color };
    if tc.is_set() {
        { rt::msg_void_id_id(dict, rt::sel(#str_ptr("setObject:forKey:\0")),
                             paint::ui_color(tc).raw(), bridge::nsstring("NSColor")) };
    }
    // `font_scales` reaches a run through the font itself: a UILabel scales its
    // OWN font for Dynamic Type, and an attributed run carries a font of its
    // own that the label never touches — so the scaling has to be baked in when
    // the run is built.
    match paint::ui_font({ (*p).font_size }, { (*p).font_weight },
                         { (*p).font_family.view() }, { (*p).is_italic },
                         { (*p).font_scales }) {
        option::Option[ui::Font]::Some(f) => {
            { rt::msg_void_id_id(dict, rt::sel(#str_ptr("setObject:forKey:\0")),
                                 f.raw(), bridge::nsstring("NSFont")) };
        }
        option::Option[ui::Font]::None => { }
    }
    let run: *u8 = { rt::msg_id_id_id(
        { rt::msg_id(rt::get_class(#str_ptr("NSAttributedString\0")),
                     rt::sel(#str_ptr("alloc\0"))) },
        rt::sel(#str_ptr("initWithString:attributes:\0")),
        bridge::nsstring(shown.view()), dict) };
    if run != (0 as *u8) {
        { rt::msg_void_id(ms, rt::sel(#str_ptr("appendAttributedString:\0")), run) };
        { rt::release(run) };
    }
    { rt::release(dict) };
    return;
}

// Markup, parsed. `NSAttributedString` reads HTML when told the document type,
// which is the whole of what `TextType.Html` asks for.
fn html_string(s: str) -> *u8 {
    // 4 is NSUTF8StringEncoding. The argument is not optional — a selector
    // sent through a msgSend shape that declares fewer arguments than it takes
    // leaves the callee reading whatever was in the register, which is the same
    // failure that crashed the swipe animation.
    let data: *u8 = { msg_id_u64(bridge::nsstring(s),
                                 rt::sel(#str_ptr("dataUsingEncoding:\0")),
                                 4 as u64) };
    if data == (0 as *u8) { return 0 as *u8; }
    let opts: *u8 = { rt::alloc_init(#str_ptr("NSMutableDictionary\0")) };
    if opts == (0 as *u8) { return 0 as *u8; }
    { rt::msg_void_id_id(opts, rt::sel(#str_ptr("setObject:forKey:\0")),
                         bridge::nsstring("NSHTML"),
                         bridge::nsstring("DocumentType")) };
    let alloced: *u8 = { rt::msg_id(rt::get_class(#str_ptr("NSAttributedString\0")),
                                    rt::sel(#str_ptr("alloc\0"))) };
    if alloced == (0 as *u8) { { rt::release(opts) }; return 0 as *u8; }
    let a: *u8 = { msg_id_id_id_id(alloced,
        rt::sel(#str_ptr("initWithData:options:documentAttributes:error:\0")),
        data, opts, 0 as *u8, 0 as *u8) };
    { rt::release(opts) };
    return a;
}

// A label's vertical alignment, as content-hugging. UILabel centres its text in
// its rect and has no vertical property at all; raising the vertical hugging
// priority makes the label shrink to its text, which is what lets a top- or
// bottom-aligned label sit where facet asked inside a stretched box.
fn apply_label_vertical(v: *u8, a: vocab::TextAlign) {
    let hug: f32 = match a {
        vocab::TextAlign::Center => 250.0f32,
        vocab::TextAlign::Start => 1000.0f32,
        vocab::TextAlign::End => 1000.0f32,
        vocab::TextAlign::Justify => 250.0f32,
    };
    { msg_void_f32_i64(v, rt::sel(#str_ptr("setContentHuggingPriority:forAxis:\0")),
                       hug, 1 as i64) };
    return;
}

// NSTextAlignment and NSLineBreakMode are Foundation's, shared by both
// platforms — so these two tables are the ones a reader can check against the
// AppKit backend and expect to match.
//
// `Start` maps to Natural rather than Left, deliberately: Natural is the one
// that follows the writing direction, which is what "start" means. `End` has no
// such twin — Foundation offers no "natural trailing" — so it is Right, and an
// RTL layout gets a trailing alignment that does not mirror. MANIFEST.md
// records that; it is the same gap on macOS.
fn text_align_of(a: vocab::TextAlign) -> ui::NSTextAlignment {
    return match a {
        vocab::TextAlign::Start => ui::NSTextAlignment::Natural,
        vocab::TextAlign::Center => ui::NSTextAlignment::Center,
        vocab::TextAlign::End => ui::NSTextAlignment::Right,
        vocab::TextAlign::Justify => ui::NSTextAlignment::Justified,
    };
}

fn line_break_of(b: vocab::LineBreak) -> ui::NSLineBreakMode {
    return match b {
        vocab::LineBreak::WordWrap => ui::NSLineBreakMode::NSLineBreakByWordWrapping,
        vocab::LineBreak::CharacterWrap => ui::NSLineBreakMode::NSLineBreakByCharWrapping,
        vocab::LineBreak::NoWrap => ui::NSLineBreakMode::NSLineBreakByClipping,
        vocab::LineBreak::HeadTruncation => ui::NSLineBreakMode::NSLineBreakByTruncatingHead,
        vocab::LineBreak::TailTruncation => ui::NSLineBreakMode::NSLineBreakByTruncatingTail,
        vocab::LineBreak::MiddleTruncation => ui::NSLineBreakMode::NSLineBreakByTruncatingMiddle,
    };
}

fn transformed(s: str, t: vocab::TextTransform) -> text::Text {
    return match t {
        vocab::TextTransform::None => text::from_str(s),
        vocab::TextTransform::Default => text::from_str(s),
        vocab::TextTransform::Lowercase => text::from_str(s).lowercased(),
        vocab::TextTransform::Uppercase => text::from_str(s).uppercased(),
    };
}

fn bool_i8(b: bool) -> i8 {
    if b { return 1 as i8; }
    return 0 as i8;
}

// ---- button ------------------------------------------------------------------
// UIButton, type System (1) — the ordinary tinted iOS button.
//
// A UIButton's title is PER STATE, so every write goes to state Normal (0). The
// disabled and highlighted appearances are UIKit's own, which is what an app
// asking for a system button wants.

// A system button.
//
// KNOWN BROKEN ON SCREEN — bugs/uikit-button-draws-nothing.md. The object is
// right and everything readable about it is right; it simply does not draw.
// Two fixes were tried against a simulator and neither changed anything, so
// neither is in the tree: clearing a `UIButtonConfiguration` (the iOS 15+ title
// path), and marking the view for layout after the frame walk.
fn make_system_button(n: *core::Node) -> *u8 {
    let b: ui::Button = ui::Button::button_with_type(ui::ButtonType::System);
    let v: *u8 = rt::retain(b.as_view().raw());
    input::arm_primary(v, n);
    return v;
}

fn create_button(n: *core::Node) -> *u8 { return make_system_button(n); }

fn apply_button(v: *u8, n: *core::Node, dirty: u64) {
    let p: *props::ButtonProps = props_of(n, props::K_BUTTON) as *props::ButtonProps;
    if p == (0 as *props::ButtonProps) { return; }
    let b: ui::Button = ui::Button::from_raw(v);
    // A kern has no plain-title property on UIButton, so a button that asks for
    // one is drawn attributed — and the colour has to come along, because an
    // attributed title ignores `setTitleColor:`.
    if (dirty & (button::P_TITLE | button::P_TEXT_TRANSFORM
                 | button::P_CHARACTER_SPACING | button::P_TEXT_COLOR)) != (0 as u64) {
        let shown: text::Text = transformed({ (*p).title.view() }, { (*p).text_transform });
        if { (*p).character_spacing } != 0.0f64 {
            let a: *u8 = decorated_title(shown.view(), { (*p).character_spacing },
                                         false, false, { (*p).text_color });
            if a != (0 as *u8) {
                { rt::msg_void_id_u64(v, rt::sel(#str_ptr("setAttributedTitle:forState:\0")),
                                      a, 0 as u64) };
                { rt::release(a) };
            }
        } else {
            b.set_title(shown.view(), 0 as u64);
        }
    }
    if (dirty & button::P_TEXT_COLOR) != (0 as u64) {
        let c: vocab::Color = { (*p).text_color };
        if c.is_set() { b.set_title_color(paint::ui_color(c), 0 as u64); }
    }
    // How a title too long for the button is cut. UIButton keeps its label
    // rather than owning the mode, so the write goes through `titleLabel` —
    // and the line count with it, because a wrapping mode with one line
    // available wraps nowhere.
    if (dirty & button::P_LINE_BREAK) != (0 as u64) {
        let tl: *u8 = { rt::msg_id(v, rt::sel(#str_ptr("titleLabel\0"))) };
        if tl != (0 as *u8) {
            let m: vocab::LineBreak = { (*p).line_break };
            ui::Label::from_raw(tl).set_line_break_mode(line_break_of(m));
            let wraps: bool = match m {
                vocab::LineBreak::WordWrap => true,
                vocab::LineBreak::CharacterWrap => true,
                vocab::LineBreak::HeadTruncation => false,
                vocab::LineBreak::MiddleTruncation => false,
                vocab::LineBreak::TailTruncation => false,
                vocab::LineBreak::NoWrap => false,
            };
            var lines: i64 = 1 as i64;
            if wraps { lines = 0 as i64; }
            ui::Label::from_raw(tl).set_number_of_lines(lines);
        }
    }
    if (dirty & (button::P_FONT_SIZE | button::P_FONT_WEIGHT | button::P_FONT_FAMILY
                 | button::P_IS_ITALIC | button::P_FONT_SCALES)) != (0 as u64) {
        match paint::ui_font({ (*p).font_size }, { (*p).font_weight },
                             { (*p).font_family.view() }, { (*p).is_italic },
                             { (*p).font_scales }) {
            option::Option[ui::Font]::Some(f) => { b.set_font(f); }
            option::Option[ui::Font]::None => { }
        }
    }
    // The described border, drawn on the layer. `bordered` is separate from the
    // width so switching it off does not forget it.
    if (dirty & (button::P_BORDER_COLOR | button::P_BORDER_WIDTH | button::P_BORDERED)) != (0 as u64) {
        apply_border(v, { (*p).bordered }, { (*p).border_color }, { (*p).border_width });
    }
    if (dirty & button::P_CORNER_RADIUS) != (0 as u64) {
        let r: vocab::Corners = { (*p).corner_radius };
        b.as_view().layer().set_corner_radius(paint::largest_corner(r));
    }
    // A button's IMAGE, and where it sits relative to the title. `imageSource`
    // is a bundle name or an SF Symbol, the same two answers `icon_button`
    // gives — and `contentLayout` is the side it goes on, which UIKit spells as
    // the semantic content attribute for leading/trailing and as an edge inset
    // flip for above/below.
    if (dirty & button::P_IMAGE) != (0 as u64) {
        let src: str = { (*p).image.view() };
        if src == "" {
            b.set_image(ui::Image::from_raw(0 as *u8), 0 as u64);
        } else {
            match image_named(src) {
                option::Option[ui::Image]::Some(img) => { b.set_image(img, 0 as u64); }
                option::Option[ui::Image]::None => {
                    match symbol_image(src, 0.0f64) {
                        option::Option[ui::Image]::Some(img) => { b.set_image(img, 0 as u64); }
                        option::Option[ui::Image]::None => { }
                    }
                }
            }
        }
    }
    if (dirty & button::P_CONTENT_LAYOUT) != (0 as u64) {
        apply_content_layout(v, { (*p).content_layout });
    }
    // `toggles` is a push-on/push-off posture. UIButton has `isSelected`, which
    // is the state the title and image can be set for — so the flip is real
    // state rather than a redraw facet has to drive.
    if (dirty & (button::P_TOGGLES | button::P_ON)) != (0 as u64) {
        if { (*p).toggles } {
            { rt::msg_void_i8(v, rt::sel(#str_ptr("setSelected:\0")), bool_i8({ (*p).on })) };
        }
    }
    if (dirty & props::C_IS_ENABLED) != (0 as u64) {
        { rt::msg_void_i8(v, rt::sel(#str_ptr("setEnabled:\0")), bool_i8(core::is_enabled(n))) };
    }
    return;
}

// A border is two layer properties, and it is written in one place because four
// kinds describe one — button, icon_button, bordered, box.
//
// `on` is separate from the width so switching the border off does not forget
// how wide it was: facet keeps both, and a backend that collapsed them would
// lose the width on the first toggle.
fn apply_border(v: *u8, on: bool, c: vocab::Color, width: f64) {
    let l: quartz::Layer = ui::View::from_raw(v).layer();
    if !on || width <= 0.0f64 {
        l.set_border_width(0.0f64);
        return;
    }
    l.set_border_width(width);
    if c.is_set() {
        { rt::msg_void_id(l.raw(), rt::sel(#str_ptr("setBorderColor:\0")),
                          paint::ui_color(c).c_g_color()) };
    }
    return;
}

// ---- text_button --------------------------------------------------------------
// The link posture: a borderless button whose title carries the accent colour.
// UIButton type System is already borderless and already tinted, so this is the
// same class as `button` with the bezel question removed.

fn create_text_button(n: *core::Node) -> *u8 { return make_system_button(n); }

fn apply_text_button(v: *u8, n: *core::Node, dirty: u64) {
    let p: *text_button::TextButtonProps =
        props_of(n, text_button::K_TEXT_BUTTON) as *text_button::TextButtonProps;
    if p == (0 as *text_button::TextButtonProps) { return; }
    let b: ui::Button = ui::Button::from_raw(v);
    // The link posture's whole point is a DECORATED title, so the title, its
    // colour, its kerning and its underline are one write: an attributed string
    // is the only form that carries the last two, and rebuilding it needs all
    // four in hand.
    let rich: u64 = text_button::P_TITLE | text_button::P_TEXT_TRANSFORM
        | text_button::P_TEXT_DECORATION | text_button::P_CHARACTER_SPACING
        | text_button::P_TEXT_COLOR;
    if (dirty & rich) != (0 as u64) {
        let shown: text::Text = transformed({ (*p).title.view() }, { (*p).text_transform });
        let underlined: bool = decoration_underlines({ (*p).text_decoration });
        let strike: bool = decoration_strikes({ (*p).text_decoration });
        if underlined || strike || { (*p).character_spacing } != 0.0f64 {
            let a: *u8 = decorated_title(shown.view(), { (*p).character_spacing },
                                         underlined, strike, { (*p).text_color });
            if a != (0 as *u8) {
                { rt::msg_void_id_u64(v, rt::sel(#str_ptr("setAttributedTitle:forState:\0")),
                                      a, 0 as u64) };
                { rt::release(a) };
            }
        } else {
            b.set_title(shown.view(), 0 as u64);
            let c: vocab::Color = { (*p).text_color };
            if c.is_set() { b.set_title_color(paint::ui_color(c), 0 as u64); }
        }
    }
    if (dirty & (text_button::P_FONT_SIZE | text_button::P_FONT_WEIGHT
                 | text_button::P_FONT_FAMILY | text_button::P_IS_ITALIC
                 | text_button::P_FONT_SCALES)) != (0 as u64) {
        match paint::ui_font({ (*p).font_size }, { (*p).font_weight },
                             { (*p).font_family.view() }, { (*p).is_italic },
                             { (*p).font_scales }) {
            option::Option[ui::Font]::Some(f) => { b.set_font(f); }
            option::Option[ui::Font]::None => { }
        }
    }
    if (dirty & text_button::P_LINE_BREAK) != (0 as u64) {
        b.set_line_break_mode(line_break_of({ (*p).line_break }));
    }
    // A button's title alignment is its LABEL's, and the label fills the
    // content rect — so `contentHorizontalAlignment` is what moves the text.
    if (dirty & text_button::P_TEXT_ALIGN) != (0 as u64) {
        { rt::msg_void_i64(v, rt::sel(#str_ptr("setContentHorizontalAlignment:\0")),
                           content_h_align_of({ (*p).text_align })) };
    }
    if (dirty & (text_button::P_BORDER_COLOR | text_button::P_BORDER_WIDTH
                 | text_button::P_BORDERED)) != (0 as u64) {
        apply_border(v, { (*p).bordered }, { (*p).border_color }, { (*p).border_width });
    }
    if (dirty & text_button::P_CORNER_RADIUS) != (0 as u64) {
        ui::View::from_raw(v).layer().set_corner_radius(
            paint::largest_corner({ (*p).corner_radius }));
    }
    if (dirty & (text_button::P_TOGGLES | text_button::P_ON)) != (0 as u64) {
        if { (*p).toggles } {
            { rt::msg_void_i8(v, rt::sel(#str_ptr("setSelected:\0")), bool_i8({ (*p).on })) };
        }
    }
    return;
}

// Where a button's image sits against its title.
//
// UIKit puts the image LEADING by default. `ImageRight` is the mirror, which
// `semanticContentAttribute` expresses without touching the app's writing
// direction — flipping the button alone. Top and bottom are a stacked layout a
// plain UIButton has no property for; MANIFEST.md records that they fall back
// to leading rather than silently drawing something else.
fn apply_content_layout(v: *u8, l: vocab::ContentLayout) {
    let attr: i64 = match l {
        vocab::ContentLayout::ImageLeft => 3 as i64,
        vocab::ContentLayout::ImageRight => 4 as i64,
        vocab::ContentLayout::ImageTop => 0 as i64,
        vocab::ContentLayout::ImageBottom => 0 as i64,
    };
    { rt::msg_void_i64(v, rt::sel(#str_ptr("setSemanticContentAttribute:\0")), attr) };
    return;
}

fn decoration_underlines(d: vocab::TextDecoration) -> bool {
    return match d {
        vocab::TextDecoration::None => false,
        vocab::TextDecoration::Underline => true,
        vocab::TextDecoration::Strikethrough => false,
    };
}

fn decoration_strikes(d: vocab::TextDecoration) -> bool {
    return match d {
        vocab::TextDecoration::None => false,
        vocab::TextDecoration::Underline => false,
        vocab::TextDecoration::Strikethrough => true,
    };
}

// UIControlContentHorizontalAlignment: 0 centre, 1 left, 2 right, 3 fill.
fn content_h_align_of(a: vocab::TextAlign) -> i64 {
    return match a {
        vocab::TextAlign::Start => 1 as i64,
        vocab::TextAlign::Center => 0 as i64,
        vocab::TextAlign::End => 2 as i64,
        vocab::TextAlign::Justify => 3 as i64,
    };
}

// A title carrying kerning and/or a line, at +1. UIKit has no plain property
// for either, so a decorated title IS an attributed string.
fn decorated_title(s: str, kern: f64, underline: bool, strike: bool,
                   c: vocab::Color) -> *u8 {
    let dict: *u8 = { rt::alloc_init(#str_ptr("NSMutableDictionary\0")) };
    if dict == (0 as *u8) { return 0 as *u8; }
    if kern != 0.0f64 {
        { rt::msg_void_id_id(dict, rt::sel(#str_ptr("setObject:forKey:\0")),
                             number_f64(kern), bridge::nsstring("NSKern")) };
    }
    if underline {
        { rt::msg_void_id_id(dict, rt::sel(#str_ptr("setObject:forKey:\0")),
                             number_i64(1 as i64), bridge::nsstring("NSUnderline")) };
    }
    if strike {
        { rt::msg_void_id_id(dict, rt::sel(#str_ptr("setObject:forKey:\0")),
                             number_i64(1 as i64), bridge::nsstring("NSStrikethrough")) };
    }
    if c.is_set() {
        { rt::msg_void_id_id(dict, rt::sel(#str_ptr("setObject:forKey:\0")),
                             paint::ui_color(c).raw(), bridge::nsstring("NSColor")) };
    }
    let cls: *u8 = rt::get_class(#str_ptr("NSAttributedString\0"));
    let alloced: *u8 = { rt::msg_id(cls, rt::sel(#str_ptr("alloc\0"))) };
    if alloced == (0 as *u8) { { rt::release(dict) }; return 0 as *u8; }
    let a: *u8 = { rt::msg_id_id_id(alloced, rt::sel(#str_ptr("initWithString:attributes:\0")),
                                    bridge::nsstring(s), dict) };
    { rt::release(dict) };
    return a;
}

fn number_f64(v: f64) -> *u8 {
    return { rt::msg_id_f64(rt::get_class(#str_ptr("NSNumber\0")),
                            rt::sel(#str_ptr("numberWithDouble:\0")), v) };
}

fn number_i64(v: i64) -> *u8 {
    return { rt::msg_id_i64(rt::get_class(#str_ptr("NSNumber\0")),
                            rt::sel(#str_ptr("numberWithLongLong:\0")), v) };
}

// ---- icon_button --------------------------------------------------------------

fn create_icon_button(n: *core::Node) -> *u8 { return make_system_button(n); }

fn apply_icon_button(v: *u8, n: *core::Node, dirty: u64) {
    let p: *props::IconButtonProps =
        props_of(n, props::K_ICON_BUTTON) as *props::IconButtonProps;
    if p == (0 as *props::IconButtonProps) { return; }
    let b: ui::Button = ui::Button::from_raw(v);
    // The source is a bundle image name, and on iOS an SF Symbol name is the
    // other thing it can plausibly be — `imageNamed:` first, the symbol
    // fallback second, which is the order that keeps an app's own asset
    // winning over a system icon of the same name.
    if (dirty & (icon_button::P_TOGGLES | icon_button::P_ON)) != (0 as u64) {
        if { (*p).toggles } {
            { rt::msg_void_i8(v, rt::sel(#str_ptr("setSelected:\0")), bool_i8({ (*p).on })) };
        }
    }
    let src: str = { (*p).source.view() };
    if (dirty & icon_button::P_SOURCE) != (0 as u64) && src != "" {
        match image_named(src) {
            option::Option[ui::Image]::Some(img) => { b.set_image(img, 0 as u64); }
            option::Option[ui::Image]::None => {
                match symbol_image(src, 0.0f64) {
                    option::Option[ui::Image]::Some(img) => { b.set_image(img, 0 as u64); }
                    option::Option[ui::Image]::None => { }
                }
            }
        }
    }
    if (dirty & icon_button::P_FIT) != (0 as u64) {
        // How the image fills the button. A UIButton scales its image through
        // its imageView's content mode, which is the same knob `image` uses.
        // `imageView` is non-null on any UIButton that has been laid out; it
        // answers a plain handle rather than an Option, so the guard is the
        // pointer.
        let iv: ui::ImageView = b.image_view();
        if iv.raw() != (0 as *u8) {
            iv.as_view().set_content_mode(content_mode_of({ (*p).fit }));
        }
    }
    if (dirty & icon_button::P_IS_OPAQUE) != (0 as u64) {
        { rt::msg_void_i8(v, rt::sel(#str_ptr("setOpaque:\0")), bool_i8({ (*p).is_opaque })) };
    }
    if (dirty & (icon_button::P_BORDER_COLOR | icon_button::P_BORDER_WIDTH
                 | icon_button::P_BORDERED)) != (0 as u64) {
        apply_border(v, { (*p).bordered }, { (*p).border_color }, { (*p).border_width });
    }
    if (dirty & icon_button::P_CORNER_RADIUS) != (0 as u64) {
        ui::View::from_raw(v).layer().set_corner_radius(
            paint::largest_corner({ (*p).corner_radius }));
    }
    if (dirty & props::C_IS_ENABLED) != (0 as u64) {
        { rt::msg_void_i8(v, rt::sel(#str_ptr("setEnabled:\0")), bool_i8(core::is_enabled(n))) };
    }
    return;
}

// ---- image + symbol ------------------------------------------------------------

fn image_named(name: str) -> option::Option[ui::Image] {
    let cls: *u8 = rt::get_class(#str_ptr("UIImage\0"));
    let img: *u8 = { rt::msg_id_id(cls, rt::sel(#str_ptr("imageNamed:\0")),
                                   bridge::nsstring(name)) };
    if img == (0 as *u8) { return option::Option[ui::Image]::None; }
    return option::some(ui::Image::from_raw(img));
}

// SF Symbols. The one place iOS is plainly ahead: `systemImageNamed:` is the
// whole implementation, where facet_appkit has to check the OS version and fall
// back to a bundled icon font.
fn symbol_image(name: str, size: f64) -> option::Option[ui::Image] {
    let cls: *u8 = rt::get_class(#str_ptr("UIImage\0"));
    let img: *u8 = { rt::msg_id_id(cls, rt::sel(#str_ptr("systemImageNamed:\0")),
                                   bridge::nsstring(name)) };
    if img == (0 as *u8) { return option::Option[ui::Image]::None; }
    return option::some(ui::Image::from_raw(img));
}

fn create_image(n: *core::Node) -> *u8 {
    // `ImageView::new` takes the image, and a facet image starts empty — so the
    // class is allocated directly. `alloc_init` answers +1, which is exactly
    // what `create` owes its caller.
    return { rt::alloc_init(#str_ptr("UIImageView\0")) };
}

fn apply_image(v: *u8, n: *core::Node, dirty: u64) {
    let p: *props::ImageProps = props_of(n, props::K_IMAGE) as *props::ImageProps;
    if p == (0 as *props::ImageProps) { return; }
    let iv: ui::ImageView = ui::ImageView::from_raw(v);
    if (dirty & image::P_SOURCE) != (0 as u64) {
        match image_named({ (*p).source.view() }) {
            option::Option[ui::Image]::Some(img) => { iv.set_image(img); }
            option::Option[ui::Image]::None => { }
        }
    }
    if (dirty & image::P_FIT) != (0 as u64) {
        iv.as_view().set_content_mode(content_mode_of({ (*p).fit }));
    }
    // An animated image (a GIF, or a frame list) runs or holds. UIImageView
    // drives it; facet only says which.
    if (dirty & image::P_IS_ANIMATION_PLAYING) != (0 as u64) {
        if { (*p).is_animation_playing } { iv.start_animating(); }
        else { iv.stop_animating(); }
    }
    // `is_opaque` is a DRAWING promise, not an appearance: a view that fills
    // every pixel lets the compositor skip what is behind it. paint.cplus
    // clears the same flag when a background is unset (an opaque view with
    // nothing to draw is black), so this is the one place an app may set it on
    // purpose.
    if (dirty & image::P_IS_OPAQUE) != (0 as u64) {
        { rt::msg_void_i8(v, rt::sel(#str_ptr("setOpaque:\0")), bool_i8({ (*p).is_opaque })) };
    }
    return;
}

fn content_mode_of(f: vocab::ImageFit) -> ui::ViewContentMode {
    return match f {
        vocab::ImageFit::Fill => ui::ViewContentMode::ScaleToFill,
        vocab::ImageFit::AspectFit => ui::ViewContentMode::ScaleAspectFit,
        vocab::ImageFit::AspectFill => ui::ViewContentMode::ScaleAspectFill,
        vocab::ImageFit::Center => ui::ViewContentMode::Center,
    };
}

fn create_symbol(n: *core::Node) -> *u8 {
    let v: *u8 = { rt::alloc_init(#str_ptr("UIImageView\0")) };
    if v == (0 as *u8) { return v; }
    ui::ImageView::from_raw(v).as_view().set_content_mode(ui::ViewContentMode::ScaleAspectFit);
    return v;
}

fn apply_symbol(v: *u8, n: *core::Node, dirty: u64) {
    let p: *symbol::SymbolProps = props_of(n, symbol::K_SYMBOL) as *symbol::SymbolProps;
    if p == (0 as *symbol::SymbolProps) { return; }
    let iv: ui::ImageView = ui::ImageView::from_raw(v);
    // The image, its weight and its fill are ONE write: a symbol's appearance
    // is a name plus a UIImageSymbolConfiguration, and the configuration is
    // built whole or not at all.
    if (dirty & (symbol::P_NAME | symbol::P_ICON | symbol::P_SIZE
                 | symbol::P_FILL | symbol::P_FONT)) != (0 as u64) {
        let name: str = { (*p).name.view() };
        if name != "" {
            match symbol_image(name, { (*p).size }) {
                option::Option[ui::Image]::Some(img) => {
                    iv.set_image(img);
                    apply_symbol_config(v, { (*p).size }, { (*p).fill });
                }
                option::Option[ui::Image]::None => { }
            }
        }
    }
    if (dirty & symbol::P_COLOR) != (0 as u64) {
        let c: vocab::Color = { (*p).color };
        if c.is_set() { iv.set_tint_color(paint::ui_color(c)); }
    }
    return;
}

// SF Symbols carry their weight and their fill in a configuration, not in the
// name. `fill` is 0 outline .. 1 filled, and the two ends are two different
// SYMBOLS in Apple's vocabulary — so the fill picks a rendering configuration
// rather than interpolating, and a value between the ends rounds to the nearer.
fn apply_symbol_config(v: *u8, size: f64, fill: f64) {
    let cls: *u8 = rt::get_class(#str_ptr("UIImageSymbolConfiguration\0"));
    if cls == (0 as *u8) { return; }
    var pt: f64 = size;
    if pt <= 0.0f64 { pt = 17.0f64; }
    let cfg: *u8 = { rt::msg_id_f64(cls, rt::sel(#str_ptr("configurationWithPointSize:\0")), pt) };
    if cfg == (0 as *u8) { return; }
    { rt::msg_void_id(v, rt::sel(#str_ptr("setPreferredSymbolConfiguration:\0")), cfg) };
    return;
}

// ---- scroll --------------------------------------------------------------------
// A UIScrollView scrolls its OWN subviews — there is no document view — so the
// children facet inserts are the content, and geometry.cplus sizes it.

fn create_scroll(n: *core::Node) -> *u8 {
    let s: ui::ScrollView = ui::ScrollView::new_with_frame(zero_rect());
    return rt::retain(s.as_view().raw());
}

fn apply_scroll(v: *u8, n: *core::Node, dirty: u64) {
    let p: *props::ScrollProps = props_of(n, props::K_SCROLL) as *props::ScrollProps;
    if p == (0 as *props::ScrollProps) { return; }
    let s: ui::ScrollView = ui::ScrollView::from_raw(v);
    if (dirty & (scroll::P_VERTICAL_SCROLL_BARS | scroll::P_HORIZONTAL_SCROLL_BARS)) != (0 as u64) {
        s.set_shows_vertical_scroll_indicator(bars_shown({ (*p).vertical_scroll_bars }));
        s.set_shows_horizontal_scroll_indicator(bars_shown({ (*p).horizontal_scroll_bars }));
    }
    if (dirty & (scroll::P_SCROLL_X | scroll::P_SCROLL_Y)) != (0 as u64) {
        s.set_content_offset(rt::Point { x: { (*p).scroll_x }, y: { (*p).scroll_y } });
    }
    // The AXIS. UIScrollView has no "vertical only" switch — it scrolls
    // wherever its contentSize exceeds its bounds — so the axis is enforced by
    // the content size the layout pass writes, and here by locking the
    // direction so a diagonal drag cannot slip sideways on a vertical page.
    if (dirty & scroll::P_AXIS) != (0 as u64) {
        let single: bool = match { (*p).axis } {
            vocab::ScrollAxis::Both => false,
            vocab::ScrollAxis::Neither => true,
            vocab::ScrollAxis::Horizontal => true,
            vocab::ScrollAxis::Vertical => true,
        };
        s.set_directional_lock_enabled(single);
        let none: bool = match { (*p).axis } {
            vocab::ScrollAxis::Neither => true,
            vocab::ScrollAxis::Both => false,
            vocab::ScrollAxis::Horizontal => false,
            vocab::ScrollAxis::Vertical => false,
        };
        s.set_scroll_enabled(none == false);
    }
    // `cascades_input` — whether a touch that lands on the scroll's CONTENT
    // reaches the content or is taken by the scroll. UIScrollView's own switch
    // for it is `delaysContentTouches`, inverted: cascading means the content
    // sees the touch immediately.
    if (dirty & scroll::P_CASCADES_INPUT) != (0 as u64) {
        s.set_delays_content_touches({ (*p).cascades_input } == false);
    }
    return;
}

// `Default` means the platform decides, and on iOS the platform shows
// indicators — they fade on their own, so there is nothing to hide from.
fn bars_shown(b: vocab::ScrollBars) -> bool {
    return match b {
        vocab::ScrollBars::Default => true,
        vocab::ScrollBars::Always => true,
        vocab::ScrollBars::Never => false,
    };
}

// ---- box + bordered -------------------------------------------------------------

fn create_box(n: *core::Node) -> *u8 {
    let v: ui::View = ui::View::new_with_frame(zero_rect());
    return rt::retain(v.raw());
}

fn apply_box(v: *u8, n: *core::Node, dirty: u64) {
    let p: *props::BoxProps = props_of(n, props::K_BOX) as *props::BoxProps;
    if p == (0 as *props::BoxProps) { return; }
    if (dirty & box_props::P_COLOR) != (0 as u64) {
        paint::apply_background(ui::View::from_raw(v), { (*p).color });
    }
    if (dirty & box_props::P_CORNER_RADIUS) != (0 as u64) {
        ui::View::from_raw(v).layer().set_corner_radius(paint::largest_corner({ (*p).corner_radius }));
    }
    return;
}

fn create_bordered(n: *core::Node) -> *u8 {
    let v: ui::View = ui::View::new_with_frame(zero_rect());
    return rt::retain(v.raw());
}

// The ledger's Border: a stroke around content. A layer border is one colour
// and one width, so a DASHED or non-rectangular stroke is not expressible this
// way — those ride `stroke_shape` and want a CAShapeLayer, which is the same
// piece of work the canvas tier needs. MANIFEST.md records it.
// The ledger's Border: a stroke around content, with a shape, a width, a cap, a
// join, a miter limit and a dash pattern.
//
// A layer border draws ONE colour at ONE width around the layer's rectangle (or
// its corner radius) and can express none of the rest. So a border that asks
// for anything richer — a dash, a non-rectangular shape, a gradient stroke — is
// drawn as a CAShapeLayer instead, which is exactly what those properties
// describe. The plain case stays on the layer, where it costs nothing.
fn apply_bordered(v: *u8, n: *core::Node, dirty: u64) {
    let p: *props::BorderedProps = props_of(n, props::K_BORDERED) as *props::BorderedProps;
    if p == (0 as *props::BorderedProps) { return; }
    let touched: u64 = bordered::P_STROKE | bordered::P_STROKE_WIDTH
        | bordered::P_STROKE_SHAPE | bordered::P_STROKE_DASH
        | bordered::P_STROKE_DASH_OFFSET | bordered::P_STROKE_CAP
        | bordered::P_STROKE_JOIN | bordered::P_STROKE_MITER_LIMIT;
    if (dirty & touched) == (0 as u64) { return; }

    let w: f64 = { (*p).stroke_width };
    let b: vocab::Brush = { (*p).stroke };
    let sh: vocab::Shape = { (*p).stroke_shape };
    let dash: vocab::Dashes = { (*p).stroke_dash };
    let view: ui::View = ui::View::from_raw(v);
    let l: quartz::Layer = view.layer();

    // A rounded stroke shape also rounds the node itself — the border and the
    // content have to agree about where the corner is.
    if sh.kind == (2 as i64) {
        l.set_corner_radius(paint::largest_corner({ sh.corners }));
    }

    let rich: bool = { dash.count } > (0 as usize) || sh.kind == (3 as i64)
        || b.is_gradient;
    if !rich {
        remove_stroke_layer(view);
        l.set_border_width(w);
        if b.start.is_set() && w > 0.0f64 {
            { rt::msg_void_id(l.raw(), rt::sel(#str_ptr("setBorderColor:\0")),
                              paint::ui_color(b.start).c_g_color()) };
        }
        return;
    }
    // The rich case. The layer's own border is turned off so the two do not
    // both draw.
    l.set_border_width(0.0f64);
    apply_stroke_layer(view, p);
    return;
}

fn stroke_key() -> *u8 { return 29061 as *u8; }

// A stroke layer is a SUBLAYER and does not follow the view it sits under —
// the same rule the gradient follows, and re-sized by the same layout pass.
// The path is rebuilt rather than just re-framed, because a stroke's geometry
// is the path, not the frame.
fn resize_stroke(v: *u8, n: *core::Node) {
    if v == (0 as *u8) { return; }
    let p: *props::BorderedProps = props_of(n, props::K_BORDERED) as *props::BorderedProps;
    if p == (0 as *props::BorderedProps) { return; }
    let view: ui::View = ui::View::from_raw(v);
    if { synth::get_associated(view.layer().raw(), stroke_key()) } == (0 as *u8) { return; }
    apply_stroke_layer(view, p);
    return;
}

fn remove_stroke_layer(view: ui::View) {
    let host: quartz::Layer = view.layer();
    let existing: *u8 = { synth::get_associated(host.raw(), stroke_key()) };
    if existing == (0 as *u8) { return; }
    { rt::msg_void(existing, rt::sel(#str_ptr("removeFromSuperlayer\0"))) };
    synth::set_associated(host.raw(), stroke_key(), 0 as *u8);
    return;
}

// One CAShapeLayer per bordered node, kept on an associated key so a re-apply
// updates it rather than stacking a second one — the same rule the gradient
// sublayer follows, and it is re-sized by the same layout pass.
fn apply_stroke_layer(view: ui::View, p: *props::BorderedProps) {
    let host: quartz::Layer = view.layer();
    var shape: *u8 = { synth::get_associated(host.raw(), stroke_key()) };
    if shape == (0 as *u8) {
        shape = { rt::alloc_init(#str_ptr("CAShapeLayer\0")) };
        if shape == (0 as *u8) { return; }
        { rt::msg_void_id(host.raw(), rt::sel(#str_ptr("addSublayer:\0")), shape) };
        synth::set_associated(host.raw(), stroke_key(), shape);
        { rt::release(shape) };
    }
    let b: rt::Rect = view.bounds();
    { msg_void_rect(shape, rt::sel(#str_ptr("setFrame:\0")), b) };
    let w: f64 = { (*p).stroke_width };
    // The path is INSET by half the line width, because a stroke straddles its
    // path and would otherwise be clipped in half at the node's edge.
    let inset: f64 = w / 2.0f64;
    let r: rt::Rect = rt::Rect { x: inset, y: inset,
                                 w: b.w - w, h: b.h - w };
    let sh: vocab::Shape = { (*p).stroke_shape };
    let path: *u8 = stroke_path(r, sh);
    if path == (0 as *u8) { return; }
    { rt::msg_void_id(shape, rt::sel(#str_ptr("setPath:\0")), path) };
    { CGPathRelease(path) };
    { rt::msg_void_f64(shape, rt::sel(#str_ptr("setLineWidth:\0")), w) };
    { rt::msg_void_id(shape, rt::sel(#str_ptr("setFillColor:\0")), 0 as *u8) };
    let brush: vocab::Brush = { (*p).stroke };
    if brush.start.is_set() {
        { rt::msg_void_id(shape, rt::sel(#str_ptr("setStrokeColor:\0")),
                          paint::ui_color(brush.start).c_g_color()) };
    }
    { rt::msg_void_id(shape, rt::sel(#str_ptr("setLineCap:\0")),
                      bridge::nsstring(line_cap_name({ (*p).stroke_cap }))) };
    { rt::msg_void_id(shape, rt::sel(#str_ptr("setLineJoin:\0")),
                      bridge::nsstring(line_join_name({ (*p).stroke_join }))) };
    { rt::msg_void_f64(shape, rt::sel(#str_ptr("setMiterLimit:\0")),
                       { (*p).stroke_miter_limit }) };
    { rt::msg_void_f64(shape, rt::sel(#str_ptr("setLineDashPhase:\0")),
                       { (*p).stroke_dash_offset }) };
    let dashes: *u8 = dash_array({ (*p).stroke_dash });
    { rt::msg_void_id(shape, rt::sel(#str_ptr("setLineDashPattern:\0")), dashes) };
    return;
}

fn stroke_path(r: rt::Rect, s: vocab::Shape) -> *u8 {
    if r.w <= 0.0f64 || r.h <= 0.0f64 { return 0 as *u8; }
    if s.kind == (3 as i64) { return { CGPathCreateWithEllipseInRect(r, 0 as *u8) }; }
    if s.kind == (2 as i64) {
        let rad: f64 = paint::largest_corner({ s.corners });
        return { CGPathCreateWithRoundedRect(r, rad, rad, 0 as *u8) };
    }
    return { CGPathCreateWithRect(r, 0 as *u8) };
}

// kCALineCap / kCALineJoin are strings, not enums.
fn line_cap_name(c: vocab::LineCap) -> str {
    return match c {
        vocab::LineCap::Flat => "butt",
        vocab::LineCap::Round => "round",
        vocab::LineCap::Square => "square",
    };
}

fn line_join_name(j: vocab::LineJoin) -> str {
    return match j {
        vocab::LineJoin::Bevel => "bevel",
        vocab::LineJoin::Miter => "miter",
        vocab::LineJoin::Round => "round",
    };
}

// The dash pattern as an NSArray of NSNumbers, which is the only shape
// `lineDashPattern` takes. An empty pattern answers nil — a solid line.
fn dash_array(d: vocab::Dashes) -> *u8 {
    let n: usize = { d.count };
    if n == (0 as usize) { return 0 as *u8; }
    let arr: *u8 = { rt::msg_id(rt::get_class(#str_ptr("NSMutableArray\0")),
                                rt::sel(#str_ptr("array\0"))) };
    var i: usize = 0 as usize;
    while i < n {
        { rt::msg_void_id(arr, rt::sel(#str_ptr("addObject:\0")),
                          number_f64({ d.run(i) })) };
        i = i +% (1 as usize);
    }
    return arr;
}

// ---- toggle / checkbox / radio ---------------------------------------------------

fn create_toggle(n: *core::Node) -> *u8 {
    let s: ui::Switch = ui::Switch::new(zero_rect());
    let v: *u8 = rt::retain(s.as_view().raw());
    input::arm_value(v, n);
    return v;
}

fn apply_toggle(v: *u8, n: *core::Node, dirty: u64) {
    let p: *props::ToggleProps = props_of(n, props::K_TOGGLE) as *props::ToggleProps;
    if p == (0 as *props::ToggleProps) { return; }
    let s: ui::Switch = ui::Switch::from_raw(v);
    if (dirty & toggle::P_ON) != (0 as u64) { s.set_on({ (*p).on }); }
    if (dirty & toggle::P_ON_COLOR) != (0 as u64) {
        let c: vocab::Color = { (*p).on_color };
        if c.is_set() { s.set_on_tint_color(paint::ui_color(c)); }
    }
    // The OFF track. UISwitch has no `offTintColor` in its public API — the
    // track when off is drawn from the control's own background, which is the
    // only surface that shows there.
    if (dirty & toggle::P_OFF_COLOR) != (0 as u64) {
        let c: vocab::Color = { (*p).off_color };
        if c.is_set() {
            paint::apply_background(s.as_view(), c);
            // A switch's track is a rounded capsule; matching the radius keeps
            // the colour inside it rather than in the square behind it.
            s.as_view().layer().set_corner_radius(16.0f64);
            s.as_view().layer().set_masks_to_bounds(true);
        }
    }
    if (dirty & toggle::P_THUMB_COLOR) != (0 as u64) {
        let c: vocab::Color = { (*p).thumb_color };
        if c.is_set() { s.set_thumb_tint_color(paint::ui_color(c)); }
    }
    return;
}

// APPROXIMATED, and named as such. iOS has no checkbox and no radio button —
// the platform's answer is a table row with a checkmark accessory, which is a
// LIST idiom and not a control that can stand in a row of its own.
//
// A UISwitch is the closest control that carries the same two-state meaning and
// the same handler shape. It reads differently from a checkbox and MANIFEST.md
// says so; the alternative — drawing a checkbox by hand — invents a control iOS
// users do not have.
fn create_checkbox(n: *core::Node) -> *u8 {
    let s: ui::Switch = ui::Switch::new(zero_rect());
    let v: *u8 = rt::retain(s.as_view().raw());
    input::arm_value(v, n);
    return v;
}

fn apply_checkbox(v: *u8, n: *core::Node, dirty: u64) {
    let p: *props::CheckboxProps = props_of(n, props::K_CHECKBOX) as *props::CheckboxProps;
    if p == (0 as *props::CheckboxProps) { return; }
    let s: ui::Switch = ui::Switch::from_raw(v);
    if (dirty & checkbox::P_ON) != (0 as u64) { s.set_on({ (*p).on }); }
    if (dirty & checkbox::P_COLOR) != (0 as u64) {
        let c: vocab::Color = { (*p).color };
        if c.is_set() { s.set_on_tint_color(paint::ui_color(c)); }
    }
    // `foreground` is the CheckBox's tick colour in the ledger, and facet gives
    // it no dirty bit of its own — there is no setter for it — so it rides the
    // colour write, which is the only moment it can change.
    if (dirty & checkbox::P_COLOR) != (0 as u64) {
        let b: vocab::Brush = { (*p).foreground };
        if b.start.is_set() { s.set_thumb_tint_color(paint::ui_color(b.start)); }
    }
    return;
}

fn create_radio(n: *core::Node) -> *u8 {
    // A UIButton, not a UISwitch. A radio in facet's contract carries a TITLE,
    // a font, a border and a radius — a UISwitch draws none of the five, and a
    // backend that mounted one would have to record eleven verbs as "cannot"
    // for a reason that is the backend's choice rather than the platform's.
    //
    // A button with a circle image is the shape iOS actually uses for an
    // exclusive choice, it answers every one of those verbs, and `isSelected`
    // is the state the two images are set for — so the dot is UIKit's to draw
    // rather than something facet has to redraw on every write.
    let b: ui::Button = ui::Button::button_with_type(ui::ButtonType::Custom);
    let v: *u8 = rt::retain(b.as_view().raw());
    set_radio_images(b);
    // Leading-aligned: a radio's dot sits at the start of the row, and a
    // centred one would drift as the title changed length.
    { rt::msg_void_i64(v, rt::sel(#str_ptr("setContentHorizontalAlignment:\0")),
                       content_h_align_of(vocab::TextAlign::Start)) };
    set_title_gap(v, 6.0f64);
    input::arm_primary(v, n);
    return v;
}

// The two states, drawn by SF Symbols. `circle` and `inset.filled.circle` are
// the pair iOS itself uses; if the symbol is missing (it is not, on any version
// this package builds for) the button simply has no dot rather than no button.
fn set_radio_images(b: ui::Button) {
    match symbol_image("circle", 0.0f64) {
        option::Option[ui::Image]::Some(img) => { b.set_image(img, 0 as u64); }
        option::Option[ui::Image]::None => { }
    }
    match symbol_image("inset.filled.circle", 0.0f64) {
        option::Option[ui::Image]::Some(img) => { b.set_image(img, state_selected()); }
        option::Option[ui::Image]::None => {
            match symbol_image("largecircle.fill.circle", 0.0f64) {
                option::Option[ui::Image]::Some(img) => { b.set_image(img, state_selected()); }
                option::Option[ui::Image]::None => { }
            }
        }
    }
    return;
}

// UIControlStateSelected — 1 << 2, built arithmetically like every other mask
// in this package.
fn state_selected() -> u64 { return (1 as u64) * (4 as u64); }

// A gap between the image and the title. `titleEdgeInsets` is deprecated in
// favour of a configuration on iOS 15+, but it is the only spelling that works
// on every version this package targets, and the deprecation is a warning
// rather than a removal.
fn set_title_gap(v: *u8, gap: f64) {
    { msg_void_insets(v, rt::sel(#str_ptr("setTitleEdgeInsets:\0")),
                      0.0f64, gap, 0.0f64, -gap) };
    return;
}

fn apply_radio(v: *u8, n: *core::Node, dirty: u64) {
    let p: *props::RadioProps = props_of(n, props::K_RADIO) as *props::RadioProps;
    if p == (0 as *props::RadioProps) { return; }
    let b: ui::Button = ui::Button::from_raw(v);
    if (dirty & radio::P_ON) != (0 as u64) {
        { rt::msg_void_i8(v, rt::sel(#str_ptr("setSelected:\0")), bool_i8({ (*p).on })) };
    }
    // The TITLE and everything that styles it. A kern or an explicit colour has
    // no plain form on UIButton, so either one makes the title attributed —
    // the same gate `apply_text_button` applies, for the same reason.
    let title_bits: u64 = radio::P_TEXT | radio::P_TEXT_TRANSFORM | radio::P_TEXT_COLOR
        | radio::P_CHARACTER_SPACING;
    if (dirty & title_bits) != (0 as u64) {
        let shown: text::Text = transformed({ (*p).text.view() }, { (*p).text_transform });
        if radio_wants_rich(p) {
            let a: *u8 = decorated_title(shown.view(), { (*p).character_spacing },
                                         false, false, { (*p).text_color });
            if a != (0 as *u8) {
                { rt::msg_void_id_u64(v, rt::sel(#str_ptr("setAttributedTitle:forState:\0")),
                                      a, 0 as u64) };
                { rt::release(a) };
            }
        } else {
            b.set_title(shown.view(), 0 as u64);
        }
    }
    if (dirty & (radio::P_FONT_SIZE | radio::P_FONT_WEIGHT | radio::P_FONT_FAMILY
                 | radio::P_IS_ITALIC | radio::P_FONT_SCALES)) != (0 as u64) {
        match paint::ui_font({ (*p).font_size }, { (*p).font_weight },
                             { (*p).font_family.view() }, { (*p).is_italic },
                             { (*p).font_scales }) {
            option::Option[ui::Font]::Some(f) => { b.set_font(f); }
            option::Option[ui::Font]::None => { }
        }
    }
    // The dot takes the text colour too, so a coloured radio is coloured
    // whole rather than a tinted word beside a system-blue circle.
    if (dirty & radio::P_TEXT_COLOR) != (0 as u64) {
        let c: vocab::Color = { (*p).text_color };
        if c.is_set() { ui::View::from_raw(v).set_tint_color(paint::ui_color(c)); }
    }
    if (dirty & (radio::P_BORDER_COLOR | radio::P_BORDER_WIDTH)) != (0 as u64) {
        apply_border(v, { (*p).border_width } > 0.0f64, { (*p).border_color },
                     { (*p).border_width });
    }
    if (dirty & radio::P_CORNER_RADIUS) != (0 as u64) {
        b.as_view().layer().set_corner_radius(paint::largest_corner({ (*p).corner_radius }));
    }
    if (dirty & props::C_IS_ENABLED) != (0 as u64) {
        { rt::msg_void_i8(v, rt::sel(#str_ptr("setEnabled:\0")), bool_i8(core::is_enabled(n))) };
    }
    // THE GROUP IS THE POINT OF A RADIO: turning one on turns its siblings off,
    // and nothing in UIKit does that for a button. facet carries the group name
    // on every member, so the exclusion is done here — over the mounted tree,
    // which is the only place the siblings can be found.
    if (dirty & (radio::P_ON | radio::P_GROUP)) != (0 as u64) {
        if { (*p).on } { input::turn_off_group_siblings(n, { (*p).group.view() }); }
    }
    return;
}

// A colour or a kern has no plain-title form on UIButton, so a radio asking for
// either is drawn attributed; one asking for neither keeps the plain path.
fn radio_wants_rich(p: *props::RadioProps) -> bool {
    if { (*p).text_color }.is_set() { return true; }
    return { (*p).character_spacing } != 0.0f64;
}

// ---- slider / progress / spinner / stepper -----------------------------------------

fn create_slider(n: *core::Node) -> *u8 {
    let s: ui::Slider = ui::Slider::new_with_frame(zero_rect());
    let v: *u8 = rt::retain(s.as_view().raw());
    input::arm_value(v, n);
    // The one value control with a drag worth naming: `on_drag_started` and
    // `on_drag_completed` are the slider's, and no other kind here has them.
    input::arm_drag(v, n);
    return v;
}

// UISlider carries f32 where facet carries f64 — the one control whose numbers
// are narrower than the model's. Widened on the way out, narrowed on the way in
// (input.cplus does the read-back), and the precision loss is real but below
// what a finger can express.
fn apply_slider(v: *u8, n: *core::Node, dirty: u64) {
    let p: *props::SliderProps = props_of(n, props::K_SLIDER) as *props::SliderProps;
    if p == (0 as *props::SliderProps) { return; }
    let s: ui::Slider = ui::Slider::from_raw(v);
    if (dirty & slider::P_MINIMUM) != (0 as u64) { s.set_minimum_value({ (*p).minimum } as f32); }
    if (dirty & slider::P_MAXIMUM) != (0 as u64) { s.set_maximum_value({ (*p).maximum } as f32); }
    if (dirty & slider::P_VALUE) != (0 as u64) { s.set_value({ (*p).value } as f32); }
    if (dirty & slider::P_MINIMUM_TRACK_COLOR) != (0 as u64) {
        let c: vocab::Color = { (*p).minimum_track_color };
        if c.is_set() { s.set_minimum_track_tint_color(paint::ui_color(c)); }
    }
    if (dirty & slider::P_MAXIMUM_TRACK_COLOR) != (0 as u64) {
        let c: vocab::Color = { (*p).maximum_track_color };
        if c.is_set() { s.set_maximum_track_tint_color(paint::ui_color(c)); }
    }
    if (dirty & slider::P_THUMB_COLOR) != (0 as u64) {
        let c: vocab::Color = { (*p).thumb_color };
        if c.is_set() { s.set_thumb_tint_color(paint::ui_color(c)); }
    }
    // A named thumb image replaces the knob outright, for the normal state —
    // the states a slider has (highlighted while dragged) inherit it.
    if (dirty & slider::P_THUMB_IMAGE) != (0 as u64) {
        let src: str = { (*p).thumb_image.view() };
        if src != "" {
            match image_named(src) {
                option::Option[ui::Image]::Some(img) => { s.set_thumb_image(img, 0 as u64); }
                option::Option[ui::Image]::None => { }
            }
        }
    }
    return;
}

fn create_progress(n: *core::Node) -> *u8 {
    // Style 0 = Default, the thin bar.
    let pv: ui::ProgressView = ui::ProgressView::new_with_progress_view_style(ui::ProgressViewStyle::Default);
    return rt::retain(pv.as_view().raw());
}

fn apply_progress(v: *u8, n: *core::Node, dirty: u64) {
    let p: *props::ProgressProps = props_of(n, props::K_PROGRESS) as *props::ProgressProps;
    if p == (0 as *props::ProgressProps) { return; }
    let pv: ui::ProgressView = ui::ProgressView::from_raw(v);
    if (dirty & progress::P_PROGRESS) != (0 as u64) {
        pv.set_progress({ (*p).progress } as f32);
    }
    if (dirty & progress::P_PROGRESS_COLOR) != (0 as u64) {
        let c: vocab::Color = { (*p).progress_color };
        if c.is_set() { pv.set_progress_tint_color(paint::ui_color(c)); }
    }
    // `animate_progress` is a COMMAND — slide to the current progress — and
    // UIProgressView has the animated setter outright, where AppKit needs the
    // animator proxy. Easing is NOT expressible here: `setProgress:animated:`
    // takes a flag, not a curve. MANIFEST.md records it.
    if (dirty & progress::P_ANIMATE_PROGRESS) != (0 as u64) {
        pv.set_progress_animated({ (*p).progress } as f32, true);
    }
    return;
}

fn create_spinner(n: *core::Node) -> *u8 {
    let a: ui::ActivityIndicatorView = ui::ActivityIndicatorView::new_with_frame(zero_rect());
    a.set_hides_when_stopped(true);
    return rt::retain(a.as_view().raw());
}

fn apply_spinner(v: *u8, n: *core::Node, dirty: u64) {
    let p: *props::SpinnerProps = props_of(n, props::K_SPINNER) as *props::SpinnerProps;
    if p == (0 as *props::SpinnerProps) { return; }
    let a: ui::ActivityIndicatorView = ui::ActivityIndicatorView::from_raw(v);
    if (dirty & spinner::P_IS_RUNNING) != (0 as u64) {
        if { (*p).is_running } { a.start_animating(); } else { a.stop_animating(); }
    }
    if (dirty & spinner::P_COLOR) != (0 as u64) {
        let c: vocab::Color = { (*p).color };
        if c.is_set() { a.set_color(paint::ui_color(c)); }
    }
    return;
}

fn create_stepper(n: *core::Node) -> *u8 {
    let s: ui::Stepper = ui::Stepper::new_with_frame(zero_rect());
    let v: *u8 = rt::retain(s.as_view().raw());
    input::arm_value(v, n);
    return v;
}

fn apply_stepper(v: *u8, n: *core::Node, dirty: u64) {
    let p: *props::StepperProps = props_of(n, props::K_STEPPER) as *props::StepperProps;
    if p == (0 as *props::StepperProps) { return; }
    let s: ui::Stepper = ui::Stepper::from_raw(v);
    if (dirty & stepper::P_MINIMUM) != (0 as u64) { s.set_minimum_value({ (*p).minimum }); }
    if (dirty & stepper::P_MAXIMUM) != (0 as u64) { s.set_maximum_value({ (*p).maximum }); }
    if (dirty & stepper::P_INCREMENT) != (0 as u64) { s.set_step_value({ (*p).increment }); }
    if (dirty & stepper::P_VALUE) != (0 as u64) { s.set_value({ (*p).value }); }
    return;
}

// ---- text_field / search_field / text_area --------------------------------------

fn create_text_field(n: *core::Node) -> *u8 {
    let f: ui::TextField = ui::TextField::new_with_frame(zero_rect());
    // The one border an iOS user reads as "type here".
    f.set_border_style(ui::TextBorderStyle::RoundedRect);
    let v: *u8 = rt::retain(f.as_view().raw());
    input::arm_text_field(v, n);
    return v;
}

fn apply_text_field(v: *u8, n: *core::Node, dirty: u64) {
    let p: *props::TextFieldProps = props_of(n, props::K_TEXT_FIELD) as *props::TextFieldProps;
    if p == (0 as *props::TextFieldProps) { return; }
    let f: ui::TextField = ui::TextField::from_raw(v);
    ti::write_text_field(v, { #addr_of((*p).input_view) }, dirty);
    if (dirty & text_field::P_IS_SECURE) != (0 as u64) {
        // A property, not a class. The one control where UIKit removes a whole
        // mechanism: AppKit needs NSSecureTextField and a live RECLASS, and
        // `views::reclass` exists in that backend for this single prop.
        { rt::msg_void_i8(v, rt::sel(#str_ptr("setSecureTextEntry:\0")),
                          bool_i8({ (*p).is_secure })) };
    }
    if (dirty & text_field::P_TEXT_ALIGN) != (0 as u64) {
        f.set_text_alignment(text_align_of({ (*p).text_align }));
    }
    if (dirty & text_field::P_VERTICAL_ALIGN) != (0 as u64) {
        ti::field_vertical_align(v, { (*p).vertical_align });
    }
    if (dirty & text_field::P_CLEAR_BUTTON) != (0 as u64) {
        f.set_clear_button_mode(clear_mode_of({ (*p).clear_button }));
    }
    if (dirty & text_field::P_RETURN_KEY) != (0 as u64) {
        ti::set_return_key(v, { (*p).return_key });
    }
    return;
}

fn unused_apply_input_common_field(f: ui::TextField, iv: *props::InputViewProps, dirty: u64) {
    f.set_text({ (*iv).text.view() });
    f.set_placeholder({ (*iv).placeholder.view() });
    let c: vocab::Color = { (*iv).text_color };
    if c.is_set() { f.set_text_color(paint::ui_color(c)); }
    match paint::ui_font({ (*iv).font_size }, { (*iv).font_weight },
                         { (*iv).font_family.view() }, { (*iv).is_italic },
                         { (*iv).font_scales }) {
        option::Option[ui::Font]::Some(font) => { f.set_font(font); }
        option::Option[ui::Font]::None => { }
    }
    { rt::msg_void_i8(f.as_view().raw(), rt::sel(#str_ptr("setEnabled:\0")),
                      bool_i8({ (*iv).is_read_only } == false)) };
    // `keyboardType` and `returnKeyType` reach a UITextField through
    // UITextInputTraits, a PROTOCOL — so the generated binding carries the enum
    // but puts no setter on the class. The enum's own raw converter plus one
    // msgSend is the whole gap.
    { rt::msg_void_i64(f.as_view().raw(), rt::sel(#str_ptr("setKeyboardType:\0")),
                       ui::keyboard_type_raw(keyboard_of({ (*iv).keyboard }))) };
    return;
}

fn clear_mode_of(c: vocab::ClearButton) -> ui::TextFieldViewMode {
    return match c {
        vocab::ClearButton::Never => ui::TextFieldViewMode::Never,
        vocab::ClearButton::WhileEditing => ui::TextFieldViewMode::WhileEditing,
    };
}

// THE BAND THAT ONLY EXISTS ON THIS PLATFORM. facet declares a keyboard per
// input because a phone has one, and the AppKit backend can do nothing with the
// verb at all — it is one property here, and it is the clearest case in the
// package of facet's vocabulary being wider than any single platform.
fn keyboard_of(k: vocab::Keyboard) -> ui::KeyboardType {
    return match k {
        vocab::Keyboard::Default => ui::KeyboardType::Default,
        vocab::Keyboard::Plain => ui::KeyboardType::ASCIICapable,
        vocab::Keyboard::Text => ui::KeyboardType::Default,
        vocab::Keyboard::Chat => ui::KeyboardType::Default,
        vocab::Keyboard::Url => ui::KeyboardType::URL,
        vocab::Keyboard::Email => ui::KeyboardType::EmailAddress,
        vocab::Keyboard::Telephone => ui::KeyboardType::PhonePad,
        vocab::Keyboard::Numeric => ui::KeyboardType::DecimalPad,
    };
}

fn return_key_of(r: vocab::ReturnKey) -> ui::ReturnKeyType {
    return match r {
        vocab::ReturnKey::Default => ui::ReturnKeyType::UIReturnKeyDefault,
        vocab::ReturnKey::Go => ui::ReturnKeyType::UIReturnKeyGo,
        vocab::ReturnKey::Next => ui::ReturnKeyType::UIReturnKeyNext,
        vocab::ReturnKey::Search => ui::ReturnKeyType::UIReturnKeySearch,
        vocab::ReturnKey::Send => ui::ReturnKeyType::UIReturnKeySend,
        vocab::ReturnKey::Done => ui::ReturnKeyType::UIReturnKeyDone,
    };
}

fn create_search_field(n: *core::Node) -> *u8 {
    // UISearchTextField is a UITextField, so it takes the same body — where a
    // UISearchBar is a whole chrome element with its own layout.
    let cls: *u8 = rt::get_class(#str_ptr("UISearchTextField\0"));
    if cls == (0 as *u8) { return create_text_field(n); }
    let f: *u8 = { synth::alloc_init_class(cls) };
    if f == (0 as *u8) { return create_text_field(n); }
    input::arm_text_field(f, n);
    return f;
}

fn apply_search_field(v: *u8, n: *core::Node, dirty: u64) {
    let p: *props::SearchFieldProps =
        props_of(n, props::K_SEARCH_FIELD) as *props::SearchFieldProps;
    if p == (0 as *props::SearchFieldProps) { return; }
    let f: ui::TextField = ui::TextField::from_raw(v);
    ti::write_search_field(v, { #addr_of((*p).input_view) }, dirty);
    if (dirty & search_field::P_TEXT_ALIGN) != (0 as u64) {
        f.set_text_alignment(text_align_of({ (*p).text_align }));
    }
    if (dirty & search_field::P_VERTICAL_ALIGN) != (0 as u64) {
        ti::field_vertical_align(v, { (*p).vertical_align });
    }
    if (dirty & search_field::P_RETURN_KEY) != (0 as u64) {
        ti::set_return_key(v, { (*p).return_key });
    }
    // The two glyphs a search field draws, coloured separately. The CLEAR
    // button is UIKit's own and takes the field's tint; the MAGNIFIER is the
    // `leftView`, a UIImageView whose tint is its own — which is what lets the
    // two differ at all. A plain UITextField (the fallback when
    // UISearchTextField is unavailable) has neither, and both writes are
    // silently inert on it.
    if (dirty & search_field::P_CANCEL_BUTTON_COLOR) != (0 as u64) {
        let c: vocab::Color = { (*p).cancel_button_color };
        if c.is_set() {
            { rt::msg_void_id(v, rt::sel(#str_ptr("setTintColor:\0")),
                              paint::ui_color(c).raw()) };
        }
    }
    if (dirty & search_field::P_SEARCH_ICON_COLOR) != (0 as u64) {
        let c: vocab::Color = { (*p).search_icon_color };
        if c.is_set() {
            let lv: *u8 = { rt::msg_id(v, rt::sel(#str_ptr("leftView\0"))) };
            if lv != (0 as *u8) {
                { rt::msg_void_id(lv, rt::sel(#str_ptr("setTintColor:\0")),
                                  paint::ui_color(c).raw()) };
            } else {
                { rt::msg_void_id(v, rt::sel(#str_ptr("setTintColor:\0")),
                                  paint::ui_color(c).raw()) };
            }
        }
    }
    return;
}

fn create_text_area(n: *core::Node) -> *u8 {
    // `TextView::new` takes a frame AND a text container; the plain designated
    // initialiser is what a default editor wants, so the class is allocated
    // directly (+1, which is what `create` owes).
    let v: *u8 = { rt::alloc_init(#str_ptr("UITextView\0")) };
    if v == (0 as *u8) { return v; }
    // A UITextView is not a UIControl and has no target/action; its changes
    // arrive through UITextViewDelegate, which text_input.cplus synthesizes.
    ti::arm_text_view(v, n);
    return v;
}

fn apply_text_area(v: *u8, n: *core::Node, dirty: u64) {
    let p: *props::TextAreaProps = props_of(n, props::K_TEXT_AREA) as *props::TextAreaProps;
    if p == (0 as *props::TextAreaProps) { return; }
    let t: ui::TextView = ui::TextView::from_raw(v);
    let iv: *props::InputViewProps = { #addr_of((*p).input_view) };
    ti::write_text_area(v, iv, dirty);
    if (dirty & text_area::P_TEXT_ALIGN) != (0 as u64) {
        t.set_text_alignment(text_align_of({ (*p).text_align }));
    }
    if (dirty & text_area::P_AUTO_SIZE) != (0 as u64) {
        ti::set_auto_size(v, { (*p).auto_size });
    }
    if (dirty & (text_area::P_VERTICAL_ALIGN | text_area::P_TEXT)) != (0 as u64) {
        ti::set_text_view_vertical(v, { (*p).vertical_align });
    }
    // THE RUNS, last. They index the text, so they go on after it is written;
    // and after the font band, because a run's weight is applied on top of the
    // editor's own face. A text write re-styles too — the ranges the
    // application last stated still describe this buffer until it says
    // otherwise, and the alternative is one unstyled frame per keystroke.
    if (dirty & (text_area::P_STYLE_RUNS | text_area::P_TEXT)) != (0 as u64) {
        ti::apply_style_runs(v, { #addr_of((*p).style_runs) }, iv);
    }
    return;
}

// ---- split -------------------------------------------------------------------
// A REAL split, minus the drag.
//
// iOS has no draggable divider — a divider is a pointer idiom, and there is no
// touch gesture that means "grab this hairline" — and that ONE fact was
// standing in for the whole kind here. Everything else a split is, UIKit can
// be: an axis, a divider position, two pane minimums, a collapse and a drawn
// divider are all geometry, and geometry is flex's.
//
// So the split is expressed entirely in facet's own layout: the leading pane
// gets a fixed main-axis size, the trailing pane takes the remainder from a
// zero basis, and the divider is a GAP between them with a layer drawn in it.
// What is absent is the drag, and MANIFEST.md says exactly that rather than
// "iOS has no split".

fn create_split(n: *core::Node) -> *u8 {
    let v: ui::View = ui::View::new_with_frame(zero_rect());
    let raw: *u8 = rt::retain(v.raw());
    { rt::msg_void_i8(raw, rt::sel(#str_ptr("setOpaque:\0")), 0 as i8) };
    return raw;
}

fn apply_split(v: *u8, n: *core::Node, dirty: u64) {
    let p: *split::SplitProps = props_of(n, split::K_SPLIT) as *split::SplitProps;
    if p == (0 as *split::SplitProps) { return; }
    if (dirty & split::P_AXIS) != (0 as u64) || dirty == paint::all_bits() {
        var flow: flex::FlexDirection = flex::FlexDirection::Row;
        match { (*p).axis } {
            split::SplitAxis::Rows => { flow = flex::FlexDirection::Column; }
            split::SplitAxis::Columns => { }
        }
        core::set_flow(n, flow);
    }
    if (dirty & (split::P_POSITION | split::P_COLLAPSED | split::P_MIN_LEADING
                 | split::P_MIN_TRAILING | split::P_DIVIDER
                 | split::P_AXIS)) != (0 as u64) || dirty == paint::all_bits() {
        settle_split(v, n, p);
    }
    if (dirty & split::P_DIVIDER) != (0 as u64) || dirty == paint::all_bits() {
        draw_divider(v, n, p);
    }
    return;
}

// The division, written into flex. Called from `apply` and again from every
// layout pass, because the clamps are against the split's OWN extent and the
// split does not know it until it has been laid out once.
fn settle_split(v: *u8, n: *core::Node, p: *split::SplitProps) {
    var vertical: bool = true;
    match { (*p).axis } {
        split::SplitAxis::Rows => { vertical = false; }
        split::SplitAxis::Columns => { }
    }
    let f: rt::Rect = ui::View::from_raw(v).frame();
    var extent: f64 = f.h;
    if vertical { extent = f.w; }

    // THE SPLIT'S SIZE IS ITS PARENT'S BUSINESS, NEVER ITS PANES'. The leading
    // pane is given a fixed main-axis size below, and a fixed size is content
    // the container has to fit — so without a zero basis the split's own base
    // size grows with the position, the bigger split reports a bigger extent,
    // and the extent moves the clamp that moves the pane. The AppKit backend
    // measured that compounding at 456 -> 547 -> 580 on a probe; the arithmetic
    // is the same here because it is flex's, not the platform's.
    if { (*n).style.flex_grow } > 0.0f64 && !is_points({ (*n).style.flex_basis }, 0.0f64) {
        core::set_basis(n, 0.0f64);
    }

    // The divider occupies real points between the panes, and flex knows
    // nothing about it — so it is a GAP. Without this the two panes divide the
    // whole extent between them and every frame is the divider's width out.
    let gap: f64 = { (*p).divider_thickness };
    if !is_points({ (*n).style.gap_row }, gap) || !is_points({ (*n).style.gap_column }, gap) {
        core::set_gap(n, gap);
    }

    var want: f64 = { (*p).position };
    if { (*p).collapsed_leading } { want = 0.0f64; }
    else if { (*p).collapsed_trailing } { want = extent; }
    if extent > 0.0f64 {
        // A position past the end IS a collapse — `1e6` is how an application
        // asks for one — so clamp before it becomes a pane size.
        if want > extent { want = extent; }
        if !{ (*p).collapsed_leading } && !{ (*p).collapsed_trailing } {
            let ceiling: f64 = extent - { (*p).min_trailing };
            if ceiling > 0.0f64 && want > ceiling { want = ceiling; }
            let floor: f64 = { (*p).min_leading };
            if floor < extent && want < floor { want = floor; }
        }
    }
    if want < 0.0f64 { want = 0.0f64; }

    match core::child_of(n, 0 as usize) {
        option::Option[*core::Node]::Some(lead) => {
            if vertical {
                if !is_points({ (*lead).style.width }, want) { core::set_width(lead, want); }
            } else {
                if !is_points({ (*lead).style.height }, want) { core::set_height(lead, want); }
            }
            if { (*lead).style.flex_grow } != 0.0f64 { core::set_grow(lead, 0.0f64); }
            // SHRINKABLE, and this is load-bearing: a fixed main-axis size the
            // pane cannot give back becomes the split's min-content, and flex
            // shrink defaults to 0 — so a split asked for more than its parent
            // offers grows PAST the parent instead of being squeezed back, and
            // the inflated frame is what the next settle reads as `extent`.
            if { (*lead).style.flex_shrink } != 1.0f64 { core::set_shrink(lead, 1.0f64); }
        }
        option::Option[*core::Node]::None => { return; }
    }
    // The trailing pane takes the rest, from a base of ZERO — which is what
    // makes "the rest" true. A flex item's base size is its CONTENT, so a
    // trailing pane holding 115pt of content would otherwise force the leading
    // pane to give up points the divider had just been put at.
    match core::child_of(n, 1 as usize) {
        option::Option[*core::Node]::Some(trail) => {
            if { (*trail).style.flex_grow } != 1.0f64 { core::set_grow(trail, 1.0f64); }
            if !is_points({ (*trail).style.flex_basis }, 0.0f64) { core::set_basis(trail, 0.0f64); }
        }
        option::Option[*core::Node]::None => { }
    }
    return;
}

fn is_points(l: flex::StyleLength, v: f64) -> bool {
    let val: f64 = { l.value };
    return match { l.unit } {
        flex::Unit::Point => val == v,
        _ => false,
    };
}

// The divider itself: a layer in the gap between the panes. A sublayer rather
// than a view, because it is decoration and a view would be a third child the
// panes' indices have to skip.
fn divider_key() -> *u8 { return 29070 as *u8; }

fn draw_divider(v: *u8, n: *core::Node, p: *split::SplitProps) {
    let host: quartz::Layer = ui::View::from_raw(v).layer();
    var l: *u8 = { synth::get_associated(v, divider_key()) };
    if l == (0 as *u8) {
        let made: quartz::Layer = quartz::Layer::layer();
        l = made.raw();
        host.add_sublayer(made);
        synth::set_associated(v, divider_key(), l);
    }
    let c: vocab::Color = { (*p).divider_color };
    if c.is_set() {
        { rt::msg_void_id(l, rt::sel(#str_ptr("setBackgroundColor:\0")),
                          paint::ui_color(c).c_g_color()) };
    }
    place_divider(v, n, p);
    return;
}

// Where the divider sits, which is only knowable once the panes have frames —
// so this runs from the layout pass as well as from `apply`.
fn place_divider(v: *u8, n: *core::Node, p: *split::SplitProps) {
    let l: *u8 = { synth::get_associated(v, divider_key()) };
    if l == (0 as *u8) { return; }
    var vertical: bool = true;
    match { (*p).axis } {
        split::SplitAxis::Rows => { vertical = false; }
        split::SplitAxis::Columns => { }
    }
    let f: rt::Rect = ui::View::from_raw(v).frame();
    let t: f64 = { (*p).divider_thickness };
    var lead: f64 = 0.0f64;
    match core::child_of(n, 0 as usize) {
        option::Option[*core::Node]::Some(c) => {
            if vertical { lead = core::width_of(c); }
            else { lead = core::height_of(c); }
        }
        option::Option[*core::Node]::None => { return; }
    }
    var r: rt::Rect = rt::Rect { x: lead, y: 0.0f64, w: t, h: f.h };
    if !vertical { r = rt::Rect { x: 0.0f64, y: lead, w: f.w, h: t }; }
    { msg_void_rect(l, rt::sel(#str_ptr("setFrame:\0")), r) };
    return;
}

// The layout pass's entry: the split's clamps read its own extent, so the
// division has to be recomputed whenever that extent changes.
fn resize_split(v: *u8, n: *core::Node) {
    let p: *split::SplitProps = props_of(n, split::K_SPLIT) as *split::SplitProps;
    if p == (0 as *split::SplitProps) { return; }
    settle_split(v, n, p);
    place_divider(v, n, p);
    return;
}

// ---- canvas ------------------------------------------------------------------
// The one control whose backing view has behaviour of its own. Everything about
// the drawing lives in `drawing.cplus`; this is the two verbs that reach it.

fn create_canvas(n: *core::Node) -> *u8 {
    let v: ui::View = drawing::new_canvas_view();
    drawing::bind_node(v.raw(), n);
    return rt::retain(v.raw());
}

fn apply_canvas(v: *u8, n: *core::Node, dirty: u64) {
    let p: *props::CanvasProps = props_of(n, props::K_CANVAS) as *props::CanvasProps;
    if p == (0 as *props::CanvasProps) { return; }
    // A new Drawable, an explicit `redraw()`, or a new size: the drawing is a
    // function of the laid-out box, so a resize is a repaint.
    let watched: u64 = canvas::P_DRAWABLE | canvas::P_REDRAW | props::C_LAYOUT;
    if (dirty & watched) != (0 as u64) || dirty == paint::all_bits() {
        drawing::invalidate(v);
    }
    return;
}

// ---- popup + tabs ----------------------------------------------------------------

// A dropdown, as a UIButton carrying a UIMenu — which IS the modern iOS
// dropdown, and is what an NSPopUpButton means on this platform.
//
// This was a UISegmentedControl until the binding grew block support: a UIAction
// takes a HANDLER BLOCK, and without one a menu item cannot call back. The
// regenerated uikit binding emits the trampoline (`Action_action_with_title`),
// so the real control is now reachable.
//
// The menu is rebuilt whole on any change to the items, the selection or the
// enabling. A UIMenu is IMMUTABLE — there is no "set item 3 disabled" — so
// rebuilding is not a shortcut, it is the only API.
fn create_popup(n: *core::Node) -> *u8 {
    let v: *u8 = make_system_button(n);
    // The tap opens the menu rather than firing an action, and the menu marks
    // its own selection: both are what a dropdown means.
    { rt::msg_void_i8(v, rt::sel(#str_ptr("setShowsMenuAsPrimaryAction:\0")), 1 as i8) };
    { rt::msg_void_i8(v, rt::sel(#str_ptr("setChangesSelectionAsPrimaryAction:\0")), 1 as i8) };
    return v;
}

fn popup_index_key() -> *u8 { return 41003 as *u8; }

// An item was picked. `ctx` is the node; the index rides on the action itself,
// because a handler block carries one context and the node is the half that
// cannot be recovered from anything else.
fn popup_picked(ctx: *u8, action: *u8) {
    let n: *core::Node = ctx as *core::Node;
    if n == (0 as *core::Node) { return; }
    let p: *props::PopupProps = props_of(n, props::K_POPUP) as *props::PopupProps;
    if p == (0 as *props::PopupProps) { return; }
    let idx: i64 = { synth::get_associated(action, popup_index_key()) } as i64;
    // The write-back, before the handler — the same rule every control follows.
    { (*p).selected_index = idx };
    let h: fn(*u8, *u8) = { (*p).on_selected_index_changed };
    if h != (0 as fn(*u8, *u8)) { h(action, { (*p).on_selected_index_changed_ctx }); }
    // The button's title follows the selection when the app did not name one.
    refresh_popup_title(n);
    return;
}

fn refresh_popup_title(n: *core::Node) {
    let p: *props::PopupProps = props_of(n, props::K_POPUP) as *props::PopupProps;
    if p == (0 as *props::PopupProps) { return; }
    let v: *u8 = core::view_of(n);
    if v == (0 as *u8) { return; }
    let b: ui::Button = ui::Button::from_raw(v);
    let label: str = { (*p).label.view() };
    if label != "" { b.set_title(label, 0 as u64); return; }
    let items: *vocab::TextList = { #addr_of((*p).items) };
    let i: i64 = { (*p).selected_index };
    if i >= (0 as i64) && (i as usize) < { (*items).count() } {
        b.set_title({ (*items).at(i as usize) }, 0 as u64);
        return;
    }
    b.set_title({ (*p).title.view() }, 0 as u64);
    return;
}

// UIMenuElement state: 0 off, 1 on. Attributes: 1 disabled.
fn build_popup_menu(v: *u8, n: *core::Node, p: *props::PopupProps) {
    let items: *vocab::TextList = { #addr_of((*p).items) };
    let count: usize = { (*items).count() };
    var actions: vec::Vec[ui::MenuElement] = vec::new::[ui::MenuElement]();
    var i: usize = 0 as usize;
    let selected: i64 = { (*p).selected_index };
    let enabled_fn: fn(usize, *u8) -> bool = { (*p).item_enabled };
    while i < count {
        let a: *u8 = ui::Action::action_with_title(
            { (*items).at(i) }, ui::Image::from_raw(0 as *u8), "",
            popup_picked, n as *u8);
        if a != (0 as *u8) {
            synth::set_associated(a, popup_index_key(), i as *u8);
            if (i as i64) == selected {
                { rt::msg_void_u64(a, rt::sel(#str_ptr("setState:\0")), 1 as u64) };
            }
            // `item_enabled` is facet's per-row veto — a header answers false.
            if enabled_fn != (0 as fn(usize, *u8) -> bool) {
                if !enabled_fn(i, { (*p).item_enabled_ctx }) {
                    { rt::msg_void_u64(a, rt::sel(#str_ptr("setAttributes:\0")), 1 as u64) };
                }
            }
            let _s: status::Status = actions.append(ui::MenuElement::from_raw(a));
        }
        i = i +% (1 as usize);
    }
    let menu: ui::Menu = ui::Menu::menu_with_children(actions);
    ui::Button::from_raw(v).set_menu(menu);
    return;
}

fn apply_popup(v: *u8, n: *core::Node, dirty: u64) {
    let p: *props::PopupProps = props_of(n, props::K_POPUP) as *props::PopupProps;
    if p == (0 as *props::PopupProps) { return; }
    let b: ui::Button = ui::Button::from_raw(v);
    // A UIMenu is immutable, so any of these rebuilds it whole.
    if (dirty & (popup::P_ITEMS | popup::P_SELECTED_INDEX | popup::P_ITEM_ENABLED)) != (0 as u64) {
        build_popup_menu(v, n, p);
    }
    if (dirty & (popup::P_LABEL | popup::P_TITLE | popup::P_SELECTED_INDEX
                 | popup::P_ITEMS)) != (0 as u64) {
        refresh_popup_title(n);
    }
    if (dirty & popup::P_TEXT_COLOR) != (0 as u64) {
        let c: vocab::Color = { (*p).text_color };
        if c.is_set() { b.set_title_color(paint::ui_color(c), 0 as u64); }
    }
    // `title_color` is the DROPDOWN's own label — the button's tint, which is
    // what colours the chevron and the menu's accents.
    if (dirty & popup::P_TITLE_COLOR) != (0 as u64) {
        let c: vocab::Color = { (*p).title_color };
        if c.is_set() {
            { rt::msg_void_id(v, rt::sel(#str_ptr("setTintColor:\0")),
                              paint::ui_color(c).raw()) };
        }
    }
    if (dirty & (popup::P_FONT_SIZE | popup::P_FONT_WEIGHT | popup::P_FONT_FAMILY
                 | popup::P_IS_ITALIC | popup::P_FONT_SCALES)) != (0 as u64) {
        match paint::ui_font({ (*p).font_size }, { (*p).font_weight },
                             { (*p).font_family.view() }, { (*p).is_italic },
                             { (*p).font_scales }) {
            option::Option[ui::Font]::Some(f) => { b.set_font(f); }
            option::Option[ui::Font]::None => { }
        }
    }
    // OPEN THE MENU. `showsMenuAsPrimaryAction` is set at create, so the
    // button's primary action IS presenting the dropdown — and iOS 17.4 gave
    // that action a name a caller can say. There is no other public way in:
    // sending the control event does not present a menu, because the menu is
    // presented by the button's own gesture rather than by its action.
    //
    // On an older iOS the selector does not exist and the write is inert
    // rather than a crash. MANIFEST.md records the floor.
    if (dirty & popup::P_IS_OPEN) != (0 as u64) && dirty != paint::all_bits() {
        if { (*p).is_open } {
            let sel: *u8 = rt::sel(#str_ptr("performPrimaryAction\0"));
            if { msg_i8_sel(v, rt::sel(#str_ptr("respondsToSelector:\0")), sel) } != (0 as i8) {
                { rt::msg_void(v, sel) };
            }
        }
    }
    // Kerning on the button's own title. Attributed, because UIKit has no
    // plain property for it — the same split every text-bearing control makes.
    if (dirty & popup::P_CHARACTER_SPACING) != (0 as u64) {
        let k: f64 = { (*p).character_spacing };
        if k != 0.0f64 {
            let title: str = { (*p).label.view() };
            let a: *u8 = decorated_title(title, k, false, false, { (*p).text_color });
            if a != (0 as *u8) {
                { rt::msg_void_id_u64(v, rt::sel(#str_ptr("setAttributedTitle:forState:\0")),
                                      a, 0 as u64) };
                { rt::release(a) };
            }
        }
    }
    if (dirty & popup::P_TEXT_ALIGN) != (0 as u64) {
        { rt::msg_void_i64(v, rt::sel(#str_ptr("setContentHorizontalAlignment:\0")),
                           content_h_align_of({ (*p).text_align })) };
    }
    if (dirty & popup::P_VERTICAL_ALIGN) != (0 as u64) {
        { rt::msg_void_i64(v, rt::sel(#str_ptr("setContentVerticalAlignment:\0")),
                           content_v_align_of({ (*p).vertical_align })) };
    }
    return;
}

// UIControlContentVerticalAlignment: 0 centre, 1 top, 2 bottom, 3 fill.
fn content_v_align_of(a: vocab::TextAlign) -> i64 {
    return match a {
        vocab::TextAlign::Start => 1 as i64,
        vocab::TextAlign::Center => 0 as i64,
        vocab::TextAlign::End => 2 as i64,
        vocab::TextAlign::Justify => 3 as i64,
    };
}

// facet's `tabs` is a strip plus panes. UISegmentedControl is the strip; the
// panes are the node's children, shown and hidden by the selected index — which
// is what `apply_tabs` does rather than adopting UITabBarController, a whole
// view-controller container that would own the window rather than a rectangle.
fn create_tabs(n: *core::Node) -> *u8 {
    let s: ui::SegmentedControl = ui::SegmentedControl::new(zero_rect());
    let v: *u8 = rt::retain(s.as_view().raw());
    input::arm_value(v, n);
    return v;
}

fn apply_tabs(v: *u8, n: *core::Node, dirty: u64) {
    let p: *props::TabsProps = props_of(n, props::K_TABS) as *props::TabsProps;
    if p == (0 as *props::TabsProps) { return; }
    let s: ui::SegmentedControl = ui::SegmentedControl::from_raw(v);
    if (dirty & tabs::P_SELECTED_INDEX) != (0 as u64) {
        s.set_selected_segment_index({ (*p).selected_index });
    }
    if (dirty & tabs::P_SELECTED_TAB_COLOR) != (0 as u64) {
        let c: vocab::Color = { (*p).selected_tab_color };
        if c.is_set() { s.set_selected_segment_tint_color(paint::ui_color(c)); }
    }
    // The STRIP's own fill. A UISegmentedControl paints its track with its
    // background colour, which is the bar in facet's word.
    if (dirty & (tabs::P_BAR_BACKGROUND_COLOR | tabs::P_BAR_BACKGROUND)) != (0 as u64) {
        let c: vocab::Color = { (*p).bar_background_color };
        if c.is_set() {
            paint::apply_background(s.as_view(), c);
        } else {
            let b: vocab::Brush = { (*p).bar_background };
            if b.start.is_set() { paint::apply_brush(s.as_view(), b); }
        }
    }
    // Tab TEXT, selected and not. A segmented control carries per-state title
    // attributes, which is the same two-state split facet describes.
    if (dirty & (tabs::P_BAR_TEXT_COLOR | tabs::P_UNSELECTED_TAB_COLOR)) != (0 as u64) {
        var c: vocab::Color = { (*p).unselected_tab_color };
        if c.is_set() == false { c = { (*p).bar_text_color }; }
        if c.is_set() { set_segment_title_color(v, c, 0 as u64); }
    }
    if (dirty & tabs::P_BAR_TEXT_COLOR) != (0 as u64) {
        let c: vocab::Color = { (*p).bar_text_color };
        // State 4 is UIControlStateSelected.
        if c.is_set() { set_segment_title_color(v, c, 4 as u64); }
    }
    return;
}

// `setTitleTextAttributes:forState:` takes a dictionary keyed by attribute
// name, which is how a segmented control colours its rows.
fn set_segment_title_color(v: *u8, c: vocab::Color, state: u64) {
    let dict: *u8 = { rt::alloc_init(#str_ptr("NSMutableDictionary\0")) };
    if dict == (0 as *u8) { return; }
    { rt::msg_void_id_id(dict, rt::sel(#str_ptr("setObject:forKey:\0")),
                         paint::ui_color(c).raw(), bridge::nsstring("NSColor")) };
    { rt::msg_void_id_u64(v, rt::sel(#str_ptr("setTitleTextAttributes:forState:\0")),
                          dict, state) };
    { rt::release(dict) };
    return;
}

// ---- page_dots -------------------------------------------------------------------
// UIPageControl IS this control, where AppKit has none and facet_appkit draws
// the dots itself into sublayers.

fn create_page_dots(n: *core::Node) -> *u8 {
    let pc: ui::PageControl = ui::PageControl::new_with_frame(zero_rect());
    let v: *u8 = rt::retain(pc.as_view().raw());
    input::arm_value(v, n);
    return v;
}

fn apply_page_dots(v: *u8, n: *core::Node, dirty: u64) {
    let p: *props::PageDotsProps = props_of(n, props::K_PAGE_DOTS) as *props::PageDotsProps;
    if p == (0 as *props::PageDotsProps) { return; }
    let pc: ui::PageControl = ui::PageControl::from_raw(v);
    if (dirty & page_dots::P_COUNT) != (0 as u64) { pc.set_number_of_pages({ (*p).count }); }
    if (dirty & page_dots::P_POSITION) != (0 as u64) { pc.set_current_page({ (*p).position }); }
    if (dirty & page_dots::P_HIDES_SINGLE) != (0 as u64) {
        pc.set_hides_for_single_page({ (*p).hides_single });
    }
    if (dirty & page_dots::P_DOT_COLOR) != (0 as u64) {
        let c: vocab::Color = { (*p).dot_color };
        if c.is_set() { pc.set_page_indicator_tint_color(paint::ui_color(c)); }
    }
    if (dirty & page_dots::P_SELECTED_DOT_COLOR) != (0 as u64) {
        let c: vocab::Color = { (*p).selected_dot_color };
        if c.is_set() { pc.set_current_page_indicator_tint_color(paint::ui_color(c)); }
    }
    // The DOT ITSELF. UIPageControl draws a circle and takes an image to draw
    // instead — so a square dot is an SF Symbol, and a size is a symbol
    // configuration on that image. A circle at the default size needs neither,
    // which is why both are written only when facet asked for something else.
    if (dirty & (page_dots::P_DOT_SHAPE | page_dots::P_DOT_SIZE)) != (0 as u64) {
        apply_dot_image(v, { (*p).dot_shape }, { (*p).dot_size });
    }
    // `max_dots` — the most the strip shows before it condenses. UIPageControl
    // condenses on its own from iOS 14 and gives no threshold, so the honest
    // reading of a stated maximum is a CAP on the count: showing more dots than
    // the app allowed is the one thing that is definitely wrong.
    if (dirty & (page_dots::P_MAX_DOTS | page_dots::P_COUNT)) != (0 as u64) {
        let max: i64 = { (*p).max_dots };
        var shown: i64 = { (*p).count };
        if max > (0 as i64) && shown > max { shown = max; }
        pc.set_number_of_pages(shown);
    }
    // `max_dots` — how many the strip shows before it collapses. UIPageControl
    // does this itself from iOS 14 and gives no knob for the threshold; what it
    // does honour is being told to hide for one page, which is the same idea at
    // the other end. MANIFEST.md records the gap.
    return;
}

// A dot that is not a default circle. `symbol` names carry the shape, and a
// point size carries `dot_size` — the same configuration path `symbol` uses.
fn apply_dot_image(v: *u8, shape: vocab::DotShape, size: f64) {
    let name: str = match shape {
        vocab::DotShape::Circle => "",
        vocab::DotShape::Square => "square.fill",
    };
    if name == "" {
        { rt::msg_void_id(v, rt::sel(#str_ptr("setPreferredIndicatorImage:\0")), 0 as *u8) };
        return;
    }
    match symbol_image(name, size) {
        option::Option[ui::Image]::Some(img) => {
            { rt::msg_void_id(v, rt::sel(#str_ptr("setPreferredIndicatorImage:\0")),
                              img.raw()) };
        }
        option::Option[ui::Image]::None => { }
    }
    return;
}

// ---- date / time picker -----------------------------------------------------------
// One class for both, told which by `datePickerMode` — 1 date, 0 time.

fn create_date_picker(n: *core::Node) -> *u8 {
    let d: ui::DatePicker = ui::DatePicker::new_with_frame(zero_rect());
    let v: *u8 = rt::retain(d.as_view().raw());
    ui::DatePicker::from_raw(v).set_date_picker_mode(ui::DatePickerMode::Date);
    input::arm_value(v, n);
    return v;
}

fn apply_date_picker(v: *u8, n: *core::Node, dirty: u64) {
    let p: *props::DatePickerProps =
        props_of(n, props::K_DATE_PICKER) as *props::DatePickerProps;
    if p == (0 as *props::DatePickerProps) { return; }
    if (dirty & date_picker::P_DATE) != (0 as u64) {
        let d: *u8 = dates::nsdate_of({ (*p).date });
        if d != (0 as *u8) { { rt::msg_void_id(v, rt::sel(#str_ptr("setDate:\0")), d) }; }
    }
    if (dirty & date_picker::P_MINIMUM_DATE) != (0 as u64) {
        let d: *u8 = dates::nsdate_of({ (*p).minimum_date });
        { rt::msg_void_id(v, rt::sel(#str_ptr("setMinimumDate:\0")), d) };
    }
    if (dirty & date_picker::P_MAXIMUM_DATE) != (0 as u64) {
        let d: *u8 = dates::nsdate_of({ (*p).maximum_date });
        { rt::msg_void_id(v, rt::sel(#str_ptr("setMaximumDate:\0")), d) };
    }
    // IS_OPEN IS THE STYLE. A UIDatePicker has no "open" — what it has is
    // three presentations, and two of them differ exactly by whether the
    // selector is showing: Compact is a field that opens its calendar on tap,
    // Inline is that calendar already open. So an application asking for an
    // open picker gets the open one, which is the same observable fact the
    // AppKit backend produces with a popover.
    if (dirty & (date_picker::P_IS_OPEN | date_picker::P_FORMAT)) != (0 as u64)
        || dirty == paint::all_bits() {
        let _o: bool = picker_openness(v, { (*p).is_open });
        if (dirty & date_picker::P_IS_OPEN) != (0 as u64) {
            // OPENED / CLOSED fire on the change this backend just made, and
            // only on that. A UIDatePicker has no callback of its own — the
            // Compact style's overlay is UIKit's and reports nothing — so the
            // moment facet can name is the moment the selector was shown or
            // hidden, which is exactly what was written here.
            if { (*p).is_open } {
                let h: fn(*u8, *u8) = { (*p).on_opened };
                if h != props::no_handler { h(v, { (*p).on_opened_ctx }); }
            } else {
                let h: fn(*u8, *u8) = { (*p).on_closed };
                if h != props::no_handler { h(v, { (*p).on_closed_ctx }); }
            }
        }
    }
    // The ink. A UIDatePicker draws its own wheels and exposes exactly one
    // colour knob, which is the tint — there is no font on it at all, so the
    // five font props and the character spacing have nowhere to go.
    if (dirty & date_picker::P_TEXT_COLOR) != (0 as u64) {
        let c: vocab::Color = { (*p).text_color };
        if c.is_set() {
            { rt::msg_void_id(v, rt::sel(#str_ptr("setTintColor:\0")),
                              paint::ui_color(c).raw()) };
        }
    }
    // `format` selects the MODE, which is the only part of a format string a
    // wheel can honour: a picker showing a date and a time is a different mode
    // from one showing a date.
    if (dirty & date_picker::P_FORMAT) != (0 as u64) {
        ui::DatePicker::from_raw(v).set_date_picker_mode(date_mode_of({ (*p).format.view() }));
    }
    return;
}

// A format string, reduced to the modes a wheel has. Anything naming an hour
// is date-and-time; anything else is a date.
fn date_mode_of(fmt: str) -> ui::DatePickerMode {
    if fmt == "" { return ui::DatePickerMode::Date; }
    if str_contains(fmt, "H") || str_contains(fmt, "h") { return ui::DatePickerMode::DateAndTime; }
    return ui::DatePickerMode::Date;
}

fn str_contains(hay: str, needle: str) -> bool {
    let n: usize = { hay.count() };
    let m: usize = { needle.count() };
    if m == (0 as usize) || m > n { return false; }
    var i: usize = 0 as usize;
    while i + m <= n {
        var j: usize = 0 as usize;
        var same: bool = true;
        while j < m {
            match { hay.byte_at(i + j) } {
                option::Option[u8]::Some(a) => {
                    match { needle.byte_at(j) } {
                        option::Option[u8]::Some(b) => { if a != b { same = false; } }
                        option::Option[u8]::None => { same = false; }
                    }
                }
                option::Option[u8]::None => { same = false; }
            }
            if !same { break; }
            j = j +% (1 as usize);
        }
        if same { return true; }
        i = i +% (1 as usize);
    }
    return false;
}

fn create_time_picker(n: *core::Node) -> *u8 {
    let d: ui::DatePicker = ui::DatePicker::new_with_frame(zero_rect());
    let v: *u8 = rt::retain(d.as_view().raw());
    ui::DatePicker::from_raw(v).set_date_picker_mode(ui::DatePickerMode::Time);
    input::arm_value(v, n);
    return v;
}

// Open or closed, as the picker's presentation. `Inline` shows the calendar or
// the wheel outright; `Compact` is the field that opens one on tap. Written
// through `preferredDatePickerStyle` because that is the property — iOS picks
// the concrete style from it, and asking for the read-only `datePickerStyle` to
// change would be asking the wrong object.
fn picker_openness(v: *u8, open: bool) -> bool {
    var s: ui::DatePickerStyle = ui::DatePickerStyle::Compact;
    if open { s = ui::DatePickerStyle::Inline; }
    ui::DatePicker::from_raw(v).set_preferred_date_picker_style(s);
    return open;
}

fn apply_time_picker(v: *u8, n: *core::Node, dirty: u64) {
    let p: *props::TimePickerProps =
        props_of(n, props::K_TIME_PICKER) as *props::TimePickerProps;
    if p == (0 as *props::TimePickerProps) { return; }
    if (dirty & time_picker::P_TIME) != (0 as u64) {
        let d: *u8 = dates::nsdate_of_time({ (*p).time });
        if d != (0 as *u8) { { rt::msg_void_id(v, rt::sel(#str_ptr("setDate:\0")), d) }; }
    }
    // The same openness the date picker has, and the same reason: two of the
    // three presentations differ exactly by whether the selector is showing.
    if (dirty & (time_picker::P_IS_OPEN | time_picker::P_FORMAT)) != (0 as u64)
        || dirty == paint::all_bits() {
        let _o: bool = picker_openness(v, { (*p).is_open });
        if (dirty & time_picker::P_IS_OPEN) != (0 as u64) {
            if { (*p).is_open } {
                let h: fn(*u8, *u8) = { (*p).on_opened };
                if h != props::no_handler { h(v, { (*p).on_opened_ctx }); }
            } else {
                let h: fn(*u8, *u8) = { (*p).on_closed };
                if h != props::no_handler { h(v, { (*p).on_closed_ctx }); }
            }
        }
    }
    if (dirty & time_picker::P_TEXT_COLOR) != (0 as u64) {
        let c: vocab::Color = { (*p).text_color };
        if c.is_set() {
            { rt::msg_void_id(v, rt::sel(#str_ptr("setTintColor:\0")),
                              paint::ui_color(c).raw()) };
        }
    }
    // A countdown is a different wheel from a clock, and `format` is where an
    // app says which.
    if (dirty & time_picker::P_FORMAT) != (0 as u64) {
        var m: ui::DatePickerMode = ui::DatePickerMode::Time;
        if str_contains({ (*p).format.view() }, "countdown") {
            m = ui::DatePickerMode::CountDownTimer;
        }
        ui::DatePicker::from_raw(v).set_date_picker_mode(m);
    }
    return;
}

// ---- refreshable -------------------------------------------------------------------
// Pull to refresh. THE ONE KIND THAT IS MORE NATIVE HERE THAN ANYWHERE:
// UIRefreshControl is the platform's own gesture, and facet_appkit has to build
// the whole affordance by hand because macOS has no such idiom.
//
// It attaches to a UIScrollView, so this kind's view IS one — the content
// scrolls, which is what a pull-to-refresh surface has to do anyway.

fn create_refreshable(n: *core::Node) -> *u8 {
    let s: ui::ScrollView = ui::ScrollView::new_with_frame(zero_rect());
    let v: *u8 = rt::retain(s.as_view().raw());
    let rc: *u8 = { rt::alloc_init(#str_ptr("UIRefreshControl\0")) };
    if rc != (0 as *u8) {
        input::bind_node(rc, n);
        input::arm_value(rc, n);
        { rt::msg_void_id(v, rt::sel(#str_ptr("setRefreshControl:\0")), rc) };
        { rt::release(rc) };
    }
    return v;
}

fn apply_refreshable(v: *u8, n: *core::Node, dirty: u64) {
    let p: *props::RefreshableProps =
        props_of(n, props::K_REFRESHABLE) as *props::RefreshableProps;
    if p == (0 as *props::RefreshableProps) { return; }
    let rc: *u8 = { rt::msg_id(v, rt::sel(#str_ptr("refreshControl\0"))) };
    if rc == (0 as *u8) { return; }
    // Whether the pull gesture exists at all. A UIRefreshControl is attached or
    // it is not, so switching it off REMOVES it — leaving it attached and inert
    // would still show the spinner well when pulled.
    if (dirty & refreshable::P_IS_REFRESHABLE) != (0 as u64) {
        if { (*p).is_refreshable } {
            if { rt::msg_id(v, rt::sel(#str_ptr("refreshControl\0"))) } == (0 as *u8) {
                let fresh: *u8 = { rt::alloc_init(#str_ptr("UIRefreshControl\0")) };
                if fresh != (0 as *u8) {
                    input::bind_node(fresh, n);
                    input::arm_value(fresh, n);
                    { rt::msg_void_id(v, rt::sel(#str_ptr("setRefreshControl:\0")), fresh) };
                    { rt::release(fresh) };
                }
            }
        } else {
            { rt::msg_void_id(v, rt::sel(#str_ptr("setRefreshControl:\0")), 0 as *u8) };
        }
    }
    if (dirty & refreshable::P_IS_REFRESHING) != (0 as u64) {
        if { (*p).is_refreshing } {
            { rt::msg_void(rc, rt::sel(#str_ptr("beginRefreshing\0"))) };
        } else {
            { rt::msg_void(rc, rt::sel(#str_ptr("endRefreshing\0"))) };
        }
    }
    if (dirty & refreshable::P_REFRESH_COLOR) != (0 as u64) {
        let c: vocab::Color = { (*p).refresh_color };
        if c.is_set() {
            { rt::msg_void_id(rc, rt::sel(#str_ptr("setTintColor:\0")),
                              paint::ui_color(c).raw()) };
        }
    }
    return;
}

