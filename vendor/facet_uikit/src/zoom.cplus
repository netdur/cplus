// facet_uikit zoom — content magnification by pinch, owned by UIScrollView.
//
// `Chrome::new(zoomable: true)` lets the end user pinch to magnify a screen's
// content — read small text — the way Safari's pinch scales a page: the picture
// scales up AS LAID OUT (no reflow, no rewrap) and the point under the fingers
// stays put.
//
// ---- why the platform owns the geometry here ------------------------------------
//
// facet_appkit magnifies by SHRINKING the host's bounds: an NSView's frame and
// bounds are independent, so a smaller bounds over the same frame shows less
// content in the same space, and a pan is nothing but moving the bounds origin.
// UIKit's frame and bounds are NOT independent — `frame.size` IS `bounds.size`
// modulo the transform (measured: setting bounds to 100x50 on a 200x100 view
// moved the FRAME to 100x50 too) — so the bounds trick does not port.
//
// The first port scaled the layer TRANSFORM instead and kept the focal point by
// moving the layer's anchor under the fingers. On a device that DRIFTED during
// the pinch, could not pan once magnified, and left a margin on the way out —
// three symptoms of the one substitution: an anchor that follows the fingers is
// per-frame state, and geometry that depends on the path taken cannot return to
// where it started. Three fixes each made a different corner worse
// (bugs/facet-uikit-zoom-drifts-cannot-pan-and-leaves-a-margin.md has the whole
// story).
//
// `UIScrollView` is iOS's own version of what AppKit's bounds trick is:
// `minimumZoomScale`/`maximumZoomScale` plus `viewForZoomingInScrollView:` give
// the pinch, the focal point, the pan, the edge clamping and the momentum,
// written by people who could see the screen. The relationship is the same one
// facet_appkit has with NSView's independent bounds — let the platform own the
// geometry.
//
// ---- the shape ------------------------------------------------------------------
//
//     host (the window's content view)
//       └── FacetUIKitZoomHost          a UIScrollView subclass, fills the host
//             └── canvas (UIView)       what the tree MOUNTS ON — see below
//
// The tree mounts on the CANVAS, not the host: the scroll view can only zoom a
// view it owns, so `window.cplus` installs this BEFORE it adds the root views
// and asks `mount_host_of` where they go. The canvas is the host's size at 1x,
// which keeps `scheduler::layout_window`'s space unchanged — it reads the
// content view's bounds, and the canvas agrees with them by construction.
//
// The scroll view's own `layoutSubviews` keeps that agreement across a rotation
// or an iPad window resize: facet's layout pass only runs on a tick, and a
// resize is UIKit's news first.
//
// SAFE AREA: `contentInsetAdjustmentBehavior` is Never, deliberately. facet
// applies the safe-area insets itself inside the layout pass, so the scroll
// view adding them again would inset the same notch twice — and at 1x an
// adjusted inset would make an unzoomed screen scrollable by the inset amount.

import "stdlib/option" as option;
import "stdlib/box" as box;
import "objc/runtime" as rt;
import "objc/synthesis" as synth;
import "uikit/uikit" as ui;

// A zoomable host. Both pointers are BORROWED — the scroll view is the host's
// subview and the canvas is the scroll view's, so the hierarchy owns their
// lifetimes and an entry outlives nothing.
struct HostZoom {
    opaque scroll: *u8,
    opaque canvas: *u8,
}

// THE ENTRY LIVES ON THE HOST, not in a global list keyed by its address — a
// freed view's address gets reused by the next allocation, and the old Vec
// registry handed a brand-new view a zoom nobody installed on it. An associated
// object cannot outlive its host, so "does this view have a zoom" answers
// itself. The box is never freed: one per zoomable host, and a host is a
// window's content view.
fn zoom_key() -> *u8 { return 41011 as *u8; }

// The canvas, keyed on the SCROLL VIEW: `viewForZoomingInScrollView:` is asked
// with the scroll view and nothing else, so the answer has to hang off it.
fn canvas_key() -> *u8 { return 41012 as *u8; }

static DELEGATE: *u8 = 0 as *u8;
static DELEGATE_CLASS: *u8 = 0 as *u8;
static HOST_CLASS: *u8 = 0 as *u8;

fn entry_of(host: *u8) -> option::Option[*HostZoom] {
    if host == (0 as *u8) { return option::Option[*HostZoom]::None; }
    let p: *HostZoom = { synth::get_associated(host, zoom_key()) } as *HostZoom;
    if p == (0 as *HostZoom) { return option::Option[*HostZoom]::None; }
    return option::Option[*HostZoom]::Some(p);
}

// ---- the range ------------------------------------------------------------------
// A degenerate range is HEALED rather than rejected: min floors at 1, and a max
// below min locks the zoom there. An application that says `max_zoom: 0` gets a
// screen that does not zoom, not one that inverts. Written as failed `>` so a
// NaN collapses to the floor instead of falling through as "in range".

fn heal_min(v: f64) -> f64 {
    if (v > 0.0f64) == false { return 1.0f64; }
    return v;
}

fn heal_max(lo: f64, hi: f64) -> f64 {
    if (hi >= lo) == false { return lo; }
    return hi;
}

// ---- the delegate ---------------------------------------------------------------
// One stateless singleton, the `scrolling.cplus` shape: the canvas is recovered
// from the scroll view itself, so one object serves every zoomable host. It
// lives in a static because a UIScrollView's `delegate` is an UNRETAINED
// reference — an autoreleased delegate would be a dangling pointer on the next
// pinch.

fn imp_view_for_zooming(self_obj: *u8, cmd: *u8, sv: *u8) -> *u8 {
    if sv == (0 as *u8) { return 0 as *u8; }
    return { synth::get_associated(sv, canvas_key()) };
}

fn delegate_class() -> *u8 {
    if DELEGATE_CLASS != (0 as *u8) { return DELEGATE_CLASS; }
    let existing: *u8 = rt::get_class(#str_ptr("FacetUIKitZoomDelegate\0"));
    if existing != (0 as *u8) { DELEGATE_CLASS = existing; return DELEGATE_CLASS; }
    let base: *u8 = rt::get_class(#str_ptr("NSObject\0"));
    if base == (0 as *u8) { return 0 as *u8; }
    let cls: *u8 = { synth::allocate_class_pair(base,
        #str_ptr("FacetUIKitZoomDelegate\0"), 0 as usize) };
    if cls == (0 as *u8) { return 0 as *u8; }
    let _a: i8 = synth::add_method_id_1id(cls,
        rt::sel(#str_ptr("viewForZoomingInScrollView:\0")),
        imp_view_for_zooming, #str_ptr("@@:@\0"));
    { synth::register_class_pair(cls) };
    DELEGATE_CLASS = cls;
    return DELEGATE_CLASS;
}

fn shared_delegate() -> *u8 {
    if DELEGATE != (0 as *u8) { return DELEGATE; }
    let cls: *u8 = delegate_class();
    if cls == (0 as *u8) { return 0 as *u8; }
    DELEGATE = { synth::alloc_init_class(cls) };
    return DELEGATE;
}

// ---- the scroll view subclass ---------------------------------------------------
// `layoutSubviews` is where a UIKit view learns it was resized, and it is the
// only place that hears a rotation BETWEEN facet ticks. Super first — the
// scroll view's own layout must run — then the canvas is re-fitted to the new
// viewport. The guard makes the everyday calls free: UIScrollView lays out on
// every scrolled frame (a scroll is a bounds-origin change), and on those the
// sizes already agree.

struct ObjcSuper { opaque receiver: *u8, opaque class_: *u8 }

#[link_name = "objc_msgSendSuper"]
extern fn msg_super_void(sup: *ObjcSuper, sel: *u8);

// ONE HOP UP IS NOT OUR SUPERCLASS. `scheduler` and `zoom` BOTH override
// `layoutSubviews`, with different IMPs, on views that can be the same view: a
// zoom canvas that is also size-watched wears two layers, and whichever
// `object_setClass` ran second is the object's runtime class. One hop up from
// that lands the first layer's IMP on itself — it calls itself until the stack
// guard. `super_class_below` walks to the class that DEFINES the running IMP,
// which is correct for any number of layers in any order and keeps our two
// layers over this one selector chained through each other.
fn imp_layout_subviews(self_obj: *u8, cmd: *u8) {
    let f_self: fn(*u8, *u8) = imp_layout_subviews;
    let base: *u8 = synth::super_class_below(self_obj, cmd, { f_self as *u8 });
    if base != (0 as *u8) {
        var sup: ObjcSuper = ObjcSuper { receiver: self_obj, class_: base };
        { msg_super_void(#addr_of(sup), rt::sel(#str_ptr("layoutSubviews\0"))) };
    }
    sync_canvas(self_obj);
    return;
}

// Re-fit the canvas to the scroll view's viewport, keeping the current zoom.
// The canvas BOUNDS are the layout space and must equal the viewport at 1x; the
// zoom lives in the transform UIScrollView manages, so the frame-space numbers
// (centre, content size) carry the factor.
fn sync_canvas(sv_raw: *u8) {
    if sv_raw == (0 as *u8) { return; }
    let canvas: *u8 = { synth::get_associated(sv_raw, canvas_key()) };
    if canvas == (0 as *u8) { return; }
    let sv: ui::ScrollView = ui::ScrollView::from_raw(sv_raw);
    let vb: rt::Rect = sv.as_view().bounds();
    let cv: ui::View = ui::View::from_raw(canvas);
    let cb: rt::Rect = cv.bounds();
    if { cb.w } == { vb.w } && { cb.h } == { vb.h } { return; }
    let z: f64 = sv.zoom_scale();
    cv.set_bounds(rt::Rect { x: 0.0f64, y: 0.0f64, w: vb.w, h: vb.h });
    // The centre in the SUPERVIEW's (content) space places the scaled frame's
    // origin at zero — where UIScrollView itself keeps a zoomed view.
    cv.set_center(rt::Point { x: (vb.w * z) / 2.0f64, y: (vb.h * z) / 2.0f64 });
    sv.set_content_size(rt::Size { w: vb.w * z, h: vb.h * z });
    // A shrink can strand the offset past the new edge; clamp it back. Floors
    // at zero so a viewport LARGER than the content cannot go negative.
    let off: rt::Point = sv.content_offset();
    var maxx: f64 = (vb.w * z) - { vb.w };
    var maxy: f64 = (vb.h * z) - { vb.h };
    if (maxx > 0.0f64) == false { maxx = 0.0f64; }
    if (maxy > 0.0f64) == false { maxy = 0.0f64; }
    var nx: f64 = off.x;
    var ny: f64 = off.y;
    if (nx > 0.0f64) == false { nx = 0.0f64; }
    if (ny > 0.0f64) == false { ny = 0.0f64; }
    if nx > maxx { nx = maxx; }
    if ny > maxy { ny = maxy; }
    if nx != { off.x } || ny != { off.y } {
        sv.set_content_offset(rt::Point { x: nx, y: ny });
    }
    return;
}

fn host_scroll_class() -> *u8 {
    if HOST_CLASS != (0 as *u8) { return HOST_CLASS; }
    let existing: *u8 = rt::get_class(#str_ptr("FacetUIKitZoomHost\0"));
    if existing != (0 as *u8) { HOST_CLASS = existing; return HOST_CLASS; }
    let base: *u8 = rt::get_class(#str_ptr("UIScrollView\0"));
    if base == (0 as *u8) { return 0 as *u8; }
    let cls: *u8 = { synth::allocate_class_pair(base,
        #str_ptr("FacetUIKitZoomHost\0"), 0 as usize) };
    if cls == (0 as *u8) { return 0 as *u8; }
    let _a: i8 = synth::add_method_v_0id(cls, rt::sel(#str_ptr("layoutSubviews\0")),
                                         imp_layout_subviews, #str_ptr("v@:\0"));
    { synth::register_class_pair(cls) };
    HOST_CLASS = cls;
    return HOST_CLASS;
}

// ---- the surface ----------------------------------------------------------------

// Install pinch-to-zoom on a host. Idempotent, because `open_window` runs again
// when a running app replaces what its one window shows: a second call updates
// the RANGE — and re-clamps the applied factor into it — without building a
// second scroll view over the first.
//
// MUST RUN BEFORE THE ROOT VIEWS ARE ADDED: `mount_host_of` below is where the
// facade asks what to mount on, and the answer is only the canvas once this has
// built it. `window.cplus` orders the two calls.
fn install(host: *u8, min_zoom: f64 = 1.0f64, max_zoom: f64 = 4.0f64) {
    if host == (0 as *u8) { return; }
    let lo: f64 = heal_min(min_zoom);
    let hi: f64 = heal_max(lo, max_zoom);
    match entry_of(host) {
        option::Option[*HostZoom]::Some(zp) => {
            let sv: ui::ScrollView = ui::ScrollView::from_raw({ (*zp).scroll });
            sv.set_minimum_zoom_scale(lo);
            sv.set_maximum_zoom_scale(hi);
            let z: f64 = sv.zoom_scale();
            if z > hi { sv.set_zoom_scale(hi); }
            if z < lo { sv.set_zoom_scale(lo); }
            return;
        }
        option::Option[*HostZoom]::None => { }
    }
    let cls: *u8 = host_scroll_class();
    if cls == (0 as *u8) { return; }
    let hb: rt::Rect = ui::View::from_raw(host).bounds();
    let fit: rt::Rect = rt::Rect { x: 0.0f64, y: 0.0f64, w: hb.w, h: hb.h };
    let alloced: *u8 = { rt::msg_id(cls, rt::sel(#str_ptr("alloc\0"))) };
    if alloced == (0 as *u8) { return; }
    let sv_raw: *u8 = { rt::msg_id_rect(alloced, rt::sel(#str_ptr("initWithFrame:\0")), fit) };
    if sv_raw == (0 as *u8) { return; }
    let sv: ui::ScrollView = ui::ScrollView::from_raw(sv_raw);
    // The scroll view tracks the host between facet ticks; `layoutSubviews`
    // above carries the canvas along with it.
    sv.as_view().set_autoresizing_mask(
        ui::view_autoresizing_flexible_width | ui::view_autoresizing_flexible_height);
    // See the header: facet applies the safe area itself.
    sv.set_content_inset_adjustment_behavior(
        ui::ScrollViewContentInsetAdjustmentBehavior::UIScrollViewContentInsetAdjustmentNever);
    // A magnifier, not a document — no bars. facet_appkit's version shows none
    // either.
    sv.set_shows_vertical_scroll_indicator(false);
    sv.set_shows_horizontal_scroll_indicator(false);
    sv.set_minimum_zoom_scale(lo);
    sv.set_maximum_zoom_scale(hi);
    let canvas: ui::View = ui::View::new_with_frame(fit);
    if canvas.raw() == (0 as *u8) { { rt::release(sv_raw) }; return; }
    sv.as_view().add_subview(canvas);
    sv.set_content_size(rt::Size { w: hb.w, h: hb.h });
    // Plain (unretained) association: the canvas is the scroll view's subview,
    // so it cannot outlive the key it hangs on.
    synth::set_associated(sv_raw, canvas_key(), canvas.raw());
    let d: *u8 = shared_delegate();
    if d != (0 as *u8) { sv.set_delegate(d); }
    ui::View::from_raw(host).add_subview(sv.as_view());
    // alloc/init handed back +1 and `addSubview:` took its own; the host owns
    // the scroll view from here.
    { rt::release(sv_raw) };
    match box::new::[HostZoom](HostZoom { scroll: sv_raw, canvas: canvas.raw() }) {
        option::Option[box::Box[HostZoom]]::Some(b) => {
            synth::set_associated(host, zoom_key(), b.into_raw() as *u8);
        }
        option::Option[box::Box[HostZoom]]::None => { }
    }
    return;
}

// Where the root views mount: the canvas for a zoomable host, the host itself
// for every other. The facade asks this instead of assuming, which is what lets
// a screen that never said `zoomable` cost nothing.
fn mount_host_of(host: *u8) -> *u8 {
    match entry_of(host) {
        option::Option[*HostZoom]::Some(zp) => { return { (*zp).canvas }; }
        option::Option[*HostZoom]::None => { return host; }
    }
}

// The programmatic path — a menu item, a shortcut, a test, an AGENT. It drives
// exactly what the gesture drives.
//
// This is the standing rule in one function: an agent has no hands, so a
// pinch-only feature would be a feature no agent could reach. Answers the
// factor actually applied (1.0 where no zoom is installed). The clamp is
// written here rather than delegated to `setZoomScale:` so a NaN collapses to
// the floor instead of reaching UIKit.
fn set_zoom(host: *u8, zoom: f64) -> f64 {
    match entry_of(host) {
        option::Option[*HostZoom]::Some(zp) => {
            let sv: ui::ScrollView = ui::ScrollView::from_raw({ (*zp).scroll });
            let lo: f64 = sv.minimum_zoom_scale();
            let hi: f64 = sv.maximum_zoom_scale();
            var target: f64 = zoom;
            if (target > lo) == false { target = lo; }
            if target > hi { target = hi; }
            sv.set_zoom_scale(target);
            return sv.zoom_scale();
        }
        option::Option[*HostZoom]::None => { return 1.0f64; }
    }
}

// The zoom currently applied to a host. 1.0 when none was ever installed, so a
// caller never has to ask whether there is one first.
fn zoom_of(host: *u8) -> f64 {
    match entry_of(host) {
        option::Option[*HostZoom]::Some(zp) => {
            return ui::ScrollView::from_raw({ (*zp).scroll }).zoom_scale();
        }
        option::Option[*HostZoom]::None => { return 1.0f64; }
    }
}

fn is_zoomable(host: *u8) -> bool {
    match entry_of(host) {
        option::Option[*HostZoom]::Some(zp) => { return true; }
        option::Option[*HostZoom]::None => { return false; }
    }
}
