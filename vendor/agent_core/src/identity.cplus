// vendor/agent_core/src/identity.cplus
//
// The agent-surface identity / registry layer (plan.agent-core.md §2, §3).
//
// This is the framework-agnostic core: no AppKit, no MCP. It owns the one
// structure every other capability reuses — the agent-id tree — and the rule
// that turns a node into a stable, addressable handle:
//
//   - the developer sets the id; it is auto-generated only when absent (§3);
//   - a fixed-position node's auto-id is `parent/role#index` (stable because the
//     position is stable);
//   - a list item's auto-id is `parent/key`, where the key is the item's data
//     identity, not its position (the React-`key` rule: position shifts on
//     insert, data identity does not);
//   - the root is `app`; windows and dialogs are ordinary children of it.
//
// All auto-ids are derived purely from (parent id, role, sibling index, key) —
// no clock, no randomness — so the same tree yields identical ids across runs
// (the build-time-stable decision in plan.agent.md). `test_deterministic_rebuild`
// guards this.
//
// Storage layout. NodeId is a `usize` index into parallel arrays:
//
//   ids    : Vec[string]  — owns each resolved-id buffer.
//   roles  : Vec[Role]    — Copy per-node role.
//   parents: Vec[Option[usize]] — Copy per-node parent.
//   index  : id bytes -> NodeId (reverse lookup). Keys are `str` views into the
//            `ids` buffers; the map never owns the bytes, so it does not free
//            them on drop. The buffers stay valid for the registry's lifetime
//            because a Vec grow copies the string fat-pointers, not the heap
//            bytes they point at.
//
// The load-bearing ordering rule (learned the hard way): take a `str` view of an
// id only AFTER the owning `string` has been moved into `ids`. Taking the view
// first and then moving the string makes the move-checker still drop the
// original binding, double-freeing the buffer the Vec now owns. So `push_node`
// pushes, then reads the stored copy back via `id_view` (which uses
// `Vec::at(i) -> Option[*string]`, a bounds-checked pointer into live storage);
// the returned `str` aliases the live Vec buffer with no extra free.
//
// `Vec::at` is bounds-checked, but every NodeId accessor still asserts
// `is_valid(node)` first so an out-of-range handle aborts at the API boundary
// with a clear cause rather than surfacing as a `None`.

import "stdlib/vec" as vec;
import "stdlib/option" as option;
import "stdlib/result" as result;
import "stdlib/hash_map" as hash_map;
import "stdlib/text" as text;
import "./auth" as auth;

extern fn snprintf(s: *u8, size: usize, format: *u8, ...) -> i32;

// The curated role vocabulary (plan.agent-core.md §9). Tiny and fixed; grows
// deliberately as real widgets land.
enum Role {
    Button,
    Text,
    Input,
    List,
    Group,
    Window,
}

// The stable tag a role contributes to an auto-id path segment.
fn role_tag(r: Role) -> str {
    return match r {
        Role::Button => "button",
        Role::Text => "text",
        Role::Input => "input",
        Role::List => "list",
        Role::Group => "group",
        Role::Window => "window",
    };
}

fn role_index(r: Role) -> i32 {
    return match r {
        Role::Button => 0,
        Role::Text => 1,
        Role::Input => 2,
        Role::List => 3,
        Role::Group => 4,
        Role::Window => 5,
    };
}

fn role_eq(a: Role, b: Role) -> bool {
    return role_index(a) == role_index(b);
}

// Inverse of `role_index` — used when a backend records a role as a u32 on a
// native handle (facet's set_identity) and a walk later recovers it. Unknown
// indices fall back to Group (structural).
fn role_from_index(i: u32) -> Role {
    if i == (0 as u32) { return Role::Button; }
    if i == (1 as u32) { return Role::Text; }
    if i == (2 as u32) { return Role::Input; }
    if i == (3 as u32) { return Role::List; }
    if i == (4 as u32) { return Role::Group; }
    if i == (5 as u32) { return Role::Window; }
    return Role::Group;
}

// ---- declared affordance (role + drive-method) ------------------------------
//
// Facet's `set_identity` (and any hand-built widget that wants the same
// contract) pins a packed (role, drive) on the native handle so agent backends
// do not re-derive the role by guessing native types. The agent walk reads the
// declaration when present and falls back to native classify only for
// un-annotated widgets (e.g. an NSOutlineView file tree built outside facet).
//
// Drive method: how the agent should act once authorization passes.
//   none  — observe / structural (labels, groups, windows)
//   click — activate (performClick: / gtk_widget_activate / BM_CLICK)
//   text  — set/read string content
//
// Storage encoding is platform-neutral: a non-null "pointer" integer that
// AppKit stashes via associated-object ASSIGN and GTK/Win32 via g_object_set_data
// / a side map. Layout (low bit always set so the value is never null):
//   bit 0       = marker (1)
//   bits 1..8   = role index (0..255)
//   bits 9..16  = drive method (0..255)

fn drive_none() -> u32 { return 0 as u32; }
fn drive_click() -> u32 { return 1 as u32; }
fn drive_text() -> u32 { return 2 as u32; }

// Default drive method for a role — the mapping facet uses when recording.
fn drive_for_role(r: Role) -> u32 {
    return match r {
        Role::Button => drive_click(),
        Role::Input => drive_text(),
        Role::Text => drive_none(),
        Role::List => drive_none(),
        Role::Group => drive_none(),
        Role::Window => drive_none(),
    };
}

// ---- the sensitivity tier (layer 1b) ----------------------------------------
//
// EXPOSURE IS NOT THE ONLY QUESTION. It answers "may the agent see this node",
// and until now that was the only thing an application could say — with the
// consequence that a payment form had exactly two settings: invisible to the
// assistant, or its card number in the assistant's context window. Both are
// wrong. An assistant that cannot see the field cannot say "the card number is
// still empty"; an assistant that can see it has read the number.
//
// So a node's EXISTENCE and its CONTENT are separate questions, and the answer
// to the second one is a tier the app declares, checked against the
// capabilities the agent's grant carries (`auth::Grant`):
//
//   Open       the node is whatever exposure says. `read` / `act`.
//   Protected  visible, named, and its value needs `read_protected` /
//              `act_protected`. The card number: there IS a grant that opens
//              it, and an app that wants autofill mints one.
//   Private    visible, named, and its value needs `read_private` /
//              `act_private` — bits an application is expected to declare and
//              NEVER MINT. The CVC. "Never" is a policy held in one place
//              where grants are built, not a wall welded into the language.
//   Excluded   not in the agent's world at all (`set_excluded`). The
//              assistant's own panel — which is not the app's content.
//
// Both tiers are VISIBLE. That is the half that makes this worth having over
// "leave the field out": an assistant can say "the card number is still blank"
// because it knows the field is there, what it is called, and that it is not
// its own to fill. It just cannot have the digits.
//
// Strictest wins, and the tier INHERITS DOWNWARD: marking the payment box
// covers every field, label and summary line inside it without enumerating
// them. Inheritance is the whole point — a secret leaks through the node
// nobody remembered to name, and the "Card ending 4242" label beside the field
// is exactly that node.
//
// The affordance ceiling (`set_observe_only`) deliberately does NOT inherit:
// every container is a drive_none Group, so an inheriting ceiling would make
// each button inside one unclickable. Sensitivity is the opposite case — a
// secret's container is a secret — which is why this is its own axis rather
// than another value of that one.
fn tier_open() -> u32 { return 0 as u32; }
fn tier_protected() -> u32 { return 1 as u32; }
fn tier_private() -> u32 { return 2 as u32; }

// The strictness order, used to resolve a node's tier against its ancestors'.
fn stricter_tier(a: u32, b: u32) -> u32 {
    if a > b { return a; }
    return b;
}

// THE MAPPING FROM A TIER TO WHAT IT COSTS. One place, so a verb can never
// invent its own answer to "which bits does this node need".
//
// Every read needs `read` and every action needs `act`, whatever the tier — so
// there is no grant that opens a protected field while being unable to open an
// ordinary one, and a mis-built grant fails closed rather than sideways.
fn read_caps_for_tier(t: u32) -> u32 {
    if t == tier_protected() { return auth::cap_read() | auth::cap_read_protected(); }
    if t == tier_private() { return auth::cap_read() | auth::cap_read_private(); }
    return auth::cap_read();
}

fn act_caps_for_tier(t: u32) -> u32 {
    if t == tier_protected() { return auth::cap_act() | auth::cap_act_protected(); }
    if t == tier_private() { return auth::cap_act() | auth::cap_act_private(); }
    return auth::cap_act();
}

// The pinned-policy vocabulary a backend reads off a native widget. The tiers
// plus exclusion, which is not a tier (it removes the node rather than gating
// its content) but travels on the same wire.
fn policy_none() -> u32 { return 0 as u32; }
fn policy_protected() -> u32 { return 1 as u32; }
fn policy_private() -> u32 { return 2 as u32; }
fn policy_exclude() -> u32 { return 3 as u32; }

// Stable key used as the associated-object / set_data key across backends.
// Integer cast (not a static address) so every package agrees without sharing
// a single-object symbol. Distinct from facet_appkit's tree pin keys (28692+).
fn affordance_key() -> *u8 { return { 28701 as *u8 }; }

// The declared sensitivity, pinned on a native widget the same way the
// affordance is. Its OWN key rather than spare bits in the affordance word:
// the two are written by different parties (a framework declares affordance
// when it builds a control; an application declares sensitivity about its own
// data), and a read-modify-write shared word means whichever writes second
// erases the other. A missing key reads as `policy_none`.
fn policy_key() -> *u8 { return { 28702 as *u8 }; }

// NUL-terminated string key for GObject `g_object_set_data` (GTK).
fn policy_gobject_key() -> *u8 { return { #str_ptr("cplus-agent-policy\0") }; }

// Same non-null-integer trick as the affordance: bit 0 is the marker so the
// stored value is never null, bits 1..8 carry the policy.
fn pack_policy(p: u32) -> *u8 {
    let v: usize = (1 as usize) | (((p as usize) & (0xFF as usize)) << 1);
    return v as *u8;
}

fn unpack_policy(packed: *u8) -> u32 {
    if packed == (0 as *u8) { return policy_none(); }
    if ((packed as usize) & (1 as usize)) != (1 as usize) { return policy_none(); }
    return (((packed as usize) >> 1) & (0xFF as usize)) as u32;
}

// NUL-terminated string key for GObject `g_object_set_data` (GTK). Same
// semantic slot as `affordance_key`; GObject keys are C strings, not addresses.
fn affordance_gobject_key() -> *u8 { return { #str_ptr("cplus-agent-affordance\0") }; }

fn pack_affordance(role: u32, drive: u32) -> *u8 {
    let r: usize = (role as usize) & (0xFF as usize);
    let d: usize = (drive as usize) & (0xFF as usize);
    let v: usize = (1 as usize) | (r << 1) | (d << 9);
    return v as *u8;
}

fn unpack_role(packed: *u8) -> u32 {
    let v: usize = packed as usize;
    return ((v >> 1) & (0xFF as usize)) as u32;
}

fn unpack_drive(packed: *u8) -> u32 {
    let v: usize = packed as usize;
    return ((v >> 9) & (0xFF as usize)) as u32;
}

// True when `p` looks like a pack_affordance result (marker bit set, non-null).
fn is_packed_affordance(p: *u8) -> bool {
    if p == (0 as *u8) { return false; }
    return ((p as usize) & (1 as usize)) == (1 as usize);
}

// One node as surfaced by `describe` (plan.agent-core.md §4): the curated view
// the agent consumes. `parent` is the NodeId of the parent (None for the root),
// so the flat list reconstructs the tree. `actionable` is the resolved affordance
// ceiling (enabled AND not observe-only), i.e. whether the agent may act on it.
struct NodeView {
    id: text::Text,
    role: Role,
    name: text::Text,
    description: text::Text,
    parent: option::Option[usize],
    enabled: bool,
    actionable: bool,
    // WHAT THE APP DECLARED about this node's content: `tier_open`,
    // `tier_protected`, `tier_private`. A property of the UI, the same for
    // every agent.
    tier: u32,
    // WHAT THIS GRANT MAY DO with it. `readable` is false on a node whose tier
    // outranks the grant — and then a backend leaves `text` empty. Both on the
    // wire, because they answer different questions: an agent that sees
    // `tier: protected, readable: false` knows to ASK for elevation, while one
    // that sees `tier: private` knows not to bother. `text: ""` alone says
    // neither — it reads as "this field is empty, go and fill it in", which is
    // a lie in the shape of a fact and a model acts on it.
    readable: bool,
}

// `parent/tag#index` as an owned string. snprintf truncates rather than
// overflowing the fixed buffer, so a pathologically deep tree degrades to a
// shorter id rather than corrupting memory.
fn make_path_id(parent: str, tag: str, index: usize) -> text::Text {
    var buf: [u8; 256] = [0u8; 256];
    let n: i32 = {
        snprintf(#addr_of(buf) as *u8, 256 as usize,
        #str_ptr("%.*s/%.*s#%llu\0"),
        #str_len(parent) as i32, #str_ptr(parent),
        #str_len(tag) as i32, #str_ptr(tag),
        index as u64)
    };
    let view: str = { #str_from_raw_parts(#addr_of(buf) as *u8, n as usize) };
    return text::from_str(view);
}

// `parent/key` as an owned string (the list-item form).
fn make_key_id(parent: str, key: u64) -> text::Text {
    var buf: [u8; 256] = [0u8; 256];
    let n: i32 = {
        snprintf(#addr_of(buf) as *u8, 256 as usize,
        #str_ptr("%.*s/%llu\0"),
        #str_len(parent) as i32, #str_ptr(parent), key)
    };
    let view: str = { #str_from_raw_parts(#addr_of(buf) as *u8, n as usize) };
    return text::from_str(view);
}

// Per-node fields beyond identity (plan.agent-core.md §4): the accessible
// `name` (label) and the `state` the agent reads. `enabled` mirrors the widget's
// own enabled/disabled; `actionable` is the affordance ceiling — false means the
// agent may see the node but never act on it (observe-only). Both default true
// and are narrowed via setters. Defaults: name "" (no label yet).
struct Registry {
    ids: vec::Vec[text::Text],
    roles: vec::Vec[Role],
    parents: vec::Vec[option::Option[usize]],
    names: vec::Vec[text::Text],
    descriptions: vec::Vec[text::Text],
    enabled: vec::Vec[bool],
    actionable: vec::Vec[bool],
    exposed: vec::Vec[bool],
    // Subtrees the application has declared none of the agent's business —
    // the embedded assistant's OWN panel, above all. Marked on the root and
    // inherited downward, because exposure is per-node and hiding only the
    // panel would leave its keyed buttons in the tree, re-parented to whatever
    // exposed ancestor sat above. The assistant would see its own Send button
    // and be able to press it.
    //
    // On the SURFACE and not on a consumer, so both adapters answer the same
    // thing. A subtree that is not the application's content is not content for
    // an external agent either.
    excluded: vec::Vec[bool],
    // Per-node declared tier (`tier_open` / `tier_protected` / `tier_private`).
    // The node's EFFECTIVE tier is the strictest along its ancestor chain, so
    // marking the payment box covers the card field, the CVC and the "ending
    // 4242" label without naming any of them. The leak is never the field you
    // remembered.
    tiers: vec::Vec[u32],
    index: hash_map::HashMap[str, usize],
    sibling_counts: hash_map::HashMap[usize, usize],
}

// A fresh registry already contains the application root: NodeId 0, id "app",
// role Group. Windows and dialogs attach to it via `add_child`.
fn new() -> Registry {
    var r: Registry = Registry {
        ids: vec::new::[text::Text](),
        roles: vec::new::[Role](),
        parents: vec::new::[option::Option[usize]](),
        names: vec::new::[text::Text](),
        descriptions: vec::new::[text::Text](),
        enabled: vec::new::[bool](),
        actionable: vec::new::[bool](),
        exposed: vec::new::[bool](),
        excluded: vec::new::[bool](),
        tiers: vec::new::[u32](),
        index: hash_map::new::[str, usize](),
        sibling_counts: hash_map::new::[usize, usize](),
    };
    // The app root is always exposed: it is the agent-visible tree's root.
    r.push_node(text::from_str("app"), Role::Group, option::Option[usize]::None, true);
    return r;
}

impl Registry {
    // The application root (always NodeId 0).
    fn root(this) -> usize {
        return 0 as usize;
    }

    fn count(this) -> usize {
        return this.ids.count();
    }

    fn is_valid(this, node: usize) -> bool {
        return node < this.ids.count();
    }

    // Add a child under `parent`. With a dev-set id, that id is used verbatim;
    // without one, the auto-id is `parent/role#index` at the parent's next
    // sibling slot.
    fn add_child(ref this, parent: usize, dev_id: option::Option[str], role: Role) -> usize {
        assert this.is_valid(parent);
        let idx: usize = this.next_sibling_index(parent);
        // A dev-set id is the developer tagging this node into the agent view
        // (exposure, plan.agent-core.md §3/§6). An auto-id'd node is tracked for
        // tree completeness but not exposed; override with `set_exposed`.
        let tagged: bool = match dev_id {
            option::Option[str]::Some(_) => true,
            option::Option[str]::None => false,
        };
        // The id expression is passed inline, not via `let id = ...; push_node(id)`:
        // moving a named local `string` into a method call double-frees it on a
        // current cpc build, while an inline temporary is consumed correctly.
        return this.push_node(
            match dev_id {
                option::Option[str]::Some(d) => text::from_str(d),
                option::Option[str]::None => {
                    let pid: str = this.id_view(parent);
                    make_path_id(pid, role_tag(role), idx)
                }
            },
            role, option::Option[usize]::Some(parent), tagged);
    }

    // Add a list item under `parent`, keyed by its data identity. Without a
    // dev-set id the auto-id is `parent/key`, stable across reorder/insert
    // because `key` is the data id, not the position.
    fn add_item(ref this, parent: usize, dev_id: option::Option[str], role: Role, key: u64) -> usize {
        assert this.is_valid(parent);
        // Consume a sibling slot so a later non-keyed sibling does not collide
        // with an item's implicit position.
        let _idx: usize = this.next_sibling_index(parent);
        let tagged: bool = match dev_id {
            option::Option[str]::Some(_) => true,
            option::Option[str]::None => false,
        };
        // Inline id expression (no `let id = ...`): see add_child for why.
        return this.push_node(
            match dev_id {
                option::Option[str]::Some(d) => text::from_str(d),
                option::Option[str]::None => {
                    let pid: str = this.id_view(parent);
                    make_key_id(pid, key)
                }
            },
            role, option::Option[usize]::Some(parent), tagged);
    }

    // The resolved agent-id of a node, as a view into registry-owned storage.
    fn resolved_id(this, node: usize) -> str {
        assert this.is_valid(node);
        return this.id_view(node);
    }

    fn role_of(this, node: usize) -> Role {
        assert this.is_valid(node);
        return match this.roles.at_ptr(node) {
            option::Option[*Role]::Some(p) => { *p },
            option::Option[*Role]::None => Role::Group,
        };
    }

    fn parent_of(this, node: usize) -> option::Option[usize] {
        assert this.is_valid(node);
        return match this.parents.at_ptr(node) {
            option::Option[*option::Option[usize]]::Some(p) => { *p },
            option::Option[*option::Option[usize]]::None => option::Option[usize]::None,
        };
    }

    // --- node state (plan.agent-core.md §4) -----------------------------

    // Set the accessible name (label) the agent reads for this node.
    fn set_name(ref this, node: usize, name: str) {
        assert this.is_valid(node);
        this.names.set(text::from_str(name), node);
        return;
    }

    // Set the name from the WIDGET'S OWN CONTENT — a button's title, a field's
    // string value — which every backend walk falls back to when the developer
    // wrote no accessibility label. Refused on a redacted node.
    //
    // A separate door from `set_name` because the two names have different
    // provenance and only one of them is a secret: "Card number" is a label
    // the developer wrote, "4242424242424242" is the user's data wearing the
    // label's slot. A single setter cannot tell them apart, and this leak —
    // the field's value arriving in the model's context as the node's NAME —
    // is exactly what the one-setter version shipped.
    //
    // Call `set_policy`/`set_redacted` BEFORE this during a walk; the guard
    // reads the flag that is already there.
    fn set_content_name(ref this, node: usize, name: str) {
        assert this.is_valid(node);
        // Whatever the tier, and regardless of any grant: a registry is built
        // once and then answers every agent that connects. A sensitive value
        // stored as a NAME would be handed to the next grant that has `read`,
        // because names are identity, not content. A grant-holder gets the
        // value through the live `text` read, which is checked per request.
        if this.is_sensitive(node) { return; }
        this.names.set(text::from_str(name), node);
        return;
    }

    // The accessible name, as a view into registry-owned storage ("" if unset).
    fn name_of(this, node: usize) -> str {
        assert this.is_valid(node);
        return match this.names.at_ptr(node) {
            option::Option[*text::Text]::Some(p) => (*p).view(),
            option::Option[*text::Text]::None => "",
        };
    }

    // Set the agent-facing intent description for this node ("opens the New
    // Project wizard"). Dev-authored — it has no widget source; with the name
    // it is the node's tool schema in the exposed describe.
    fn set_description(ref this, node: usize, d: str) {
        assert this.is_valid(node);
        this.descriptions.set(text::from_str(d), node);
        return;
    }

    // The intent description ("" if unset), a view into registry-owned storage.
    fn description_of(this, node: usize) -> str {
        assert this.is_valid(node);
        return match this.descriptions.at_ptr(node) {
            option::Option[*text::Text]::Some(p) => (*p).view(),
            option::Option[*text::Text]::None => "",
        };
    }

    fn set_enabled(ref this, node: usize, on: bool) {
        assert this.is_valid(node);
        this.enabled.set(on, node);
        return;
    }

    fn is_enabled(this, node: usize) -> bool {
        assert this.is_valid(node);
        return match this.enabled.at_ptr(node) {
            option::Option[*bool]::Some(p) => { *p },
            option::Option[*bool]::None => false,
        };
    }

    // Narrow the affordance ceiling: the agent may see this node but never act
    // on it. The widget stays interactive for the user; only the agent is barred.
    fn set_observe_only(ref this, node: usize) {
        assert this.is_valid(node);
        this.actionable.set(false, node);
        return;
    }

    // Whether the agent may act on this node AS FAR AS THE WIDGET IS CONCERNED
    // (the affordance ceiling): enabled, and not observe-only. Deliberately
    // grant-free — this is a property of the UI, the same for every agent, and
    // the registry is built once and then answers many grants. What a
    // particular agent may do is `can_act` below, which is this AND the tier.
    fn is_agent_actionable(this, node: usize) -> bool {
        assert this.is_valid(node);
        let ceiling: bool = match this.actionable.at_ptr(node) {
            option::Option[*bool]::Some(p) => { *p },
            option::Option[*bool]::None => false,
        };
        return ceiling && this.is_enabled(node);
    }

    // --- sensitivity (layer 1b) ------------------------------------------

    // Declare this node's tier. Inherited by everything under it.
    fn set_tier(ref this, node: usize, tier: u32) {
        assert this.is_valid(node);
        this.tiers.set(tier, node);
        return;
    }

    // The node's own declared tier, ignoring its ancestors.
    fn declared_tier(this, node: usize) -> u32 {
        assert this.is_valid(node);
        return match this.tiers.at_ptr(node) {
            option::Option[*u32]::Some(p) => { *p },
            option::Option[*u32]::None => tier_open(),
        };
    }

    // The tier that ACTUALLY applies: the strictest along the ancestor chain.
    // Walks up, so marking a payment box covers every field in it — including
    // the label that quotes the last four digits, which is the node a developer
    // enumerating fields by hand always forgets.
    fn tier_of(this, node: usize) -> u32 {
        var worst: u32 = tier_open();
        var cur: option::Option[usize] = option::Option[usize]::Some(node);
        loop {
            match cur {
                option::Option[usize]::Some(i) => {
                    worst = stricter_tier(worst, this.declared_tier(i));
                    cur = this.parent_of(i);
                }
                option::Option[usize]::None => { return worst; }
            }
        }
    }

    // Is this node's content gated at all — i.e. does reading it need more than
    // the ordinary `read` capability?
    fn is_sensitive(this, node: usize) -> bool {
        return this.tier_of(node) != tier_open();
    }

    // Apply a declared policy (`policy_none` / `policy_protected` /
    // `policy_private` / `policy_exclude`) — the form a backend reads off a
    // native widget. One door, so a backend never has to know which of the two
    // mechanisms (tier vs exclusion) a policy value means.
    fn set_policy(ref this, node: usize, policy: u32) {
        assert this.is_valid(node);
        if policy == policy_protected() { this.set_tier(node, tier_protected()); return; }
        if policy == policy_private() { this.set_tier(node, tier_private()); return; }
        if policy == policy_exclude() { this.set_excluded(node, true); return; }
        return;
    }

    // --- what a PARTICULAR grant may do -----------------------------------
    //
    // The two questions every verb asks. Both fold exposure, the tier and the
    // grant into one answer, so no caller can consult a part and get a
    // different story — the reason exclusion folds into `is_exposed`.

    // May this grant read this node's CONTENT?
    fn can_read_value(this, grant: auth::Grant, node: usize) -> bool {
        assert this.is_valid(node);
        if !this.is_exposed(node) { return false; }
        return grant.has(read_caps_for_tier(this.tier_of(node)));
    }

    // May this grant ACT on this node — the widget's ceiling and the tier?
    fn can_act(this, grant: auth::Grant, node: usize) -> bool {
        assert this.is_valid(node);
        if !this.is_exposed(node) { return false; }
        if !this.is_agent_actionable(node) { return false; }
        return grant.has(act_caps_for_tier(this.tier_of(node)));
    }

    // --- exposure (plan.agent-core.md §6, layer 1) ----------------------

    // Whether this node is in the agent-visible tree. Default: dev-tagged nodes
    // are exposed, auto-id'd nodes are not (the root is always exposed).
    fn is_exposed(this, node: usize) -> bool {
        assert this.is_valid(node);
        // An excluded subtree is not exposed, whatever its own tag says. Folded
        // in HERE rather than at the describe loop because `is_exposed` is also
        // what the action path authorizes against — so one answer covers both
        // what the agent can see and what it can touch, and no future caller
        // can consult the tag alone and get a different story.
        if this.in_excluded_subtree(node) { return false; }
        return match this.exposed.at_ptr(node) {
            option::Option[*bool]::Some(p) => { *p },
            option::Option[*bool]::None => false,
        };
    }

    // Override exposure: opt an auto-id'd node in (e.g. list rows), or hide a
    // tagged one. Omission is still the strongest sensitivity control.
    // Declare a subtree out of the agent's world, root included.
    fn set_excluded(ref this, node: usize, on: bool) {
        assert this.is_valid(node);
        this.excluded.set(on, node);
        return;
    }

    // Is this node inside an excluded subtree? Walks up, so marking the root is
    // enough and every descendant follows without being enumerated.
    fn in_excluded_subtree(this, node: usize) -> bool {
        var cur: option::Option[usize] = option::Option[usize]::Some(node);
        loop {
            match cur {
                option::Option[usize]::Some(i) => {
                    let hit: bool = match this.excluded.at_ptr(i) {
                        option::Option[*bool]::Some(p) => { *p },
                        option::Option[*bool]::None => false,
                    };
                    if hit { return true; }
                    cur = this.parent_of(i);
                }
                option::Option[usize]::None => { return false; }
            }
        }
    }

    fn set_exposed(ref this, node: usize, on: bool) {
        assert this.is_valid(node);
        this.exposed.set(on, node);
        return;
    }

    // The curated UI description (plan.agent-core.md §4, §5.1): the agent-visible
    // tree. Only exposed nodes appear; each node's `parent` is its nearest
    // exposed ancestor, so unexposed intermediates collapse and the tree stays
    // connected. NodeId order means parents precede children.
    fn describe(this, grant: auth::Grant) -> vec::Vec[NodeView] {
        var out: vec::Vec[NodeView] = vec::new::[NodeView]();
        let n: usize = this.ids.count();
        var i: usize = 0 as usize;
        while i < n {
            if this.is_exposed(i) && grant.has(auth::cap_read()) {
                out.append(NodeView {
                    id: text::from_str(this.id_view(i)),
                    role: this.role_of(i),
                    name: text::from_str(this.name_of(i)),
                    description: text::from_str(this.description_of(i)),
                    parent: this.nearest_exposed_ancestor(i),
                    enabled: this.is_enabled(i),
                    // `actionable` is what THIS grant may do, not what the
                    // widget could take. A model uses it as its tool list, so
                    // reporting the ceiling alone would advertise a write into
                    // a card field that every attempt then refuses.
                    actionable: this.can_act(grant, i),
                    tier: this.tier_of(i),
                    readable: this.can_read_value(grant, i),
                });
            }
            i = i +% (1 as usize);
        }
        return out;
    }

    // Resolve an agent-id to its NodeId, or None if no node carries it.
    fn lookup(this, id: str) -> option::Option[usize] {
        return match this.index.get(id) {
            option::Option[usize]::Some(n) => option::Option[usize]::Some(n),
            option::Option[usize]::None => option::Option[usize]::None,
        };
    }

    fn contains(this, id: str) -> bool {
        return this.index.contains_key(id);
    }

    // --- internal -------------------------------------------------------

    // View node's resolved id as a `str` into registry-owned storage. Reads the
    // non-Copy `string` element through `at` (a bounds-checked pointer); the
    // deref is safe because callers `assert is_valid`/just pushed, and the
    // returned view aliases the live buffer the Vec still owns.
    fn id_view(this, node: usize) -> str {
        return match this.ids.at_ptr(node) {
            option::Option[*text::Text]::Some(p) => (*p).view(),
            option::Option[*text::Text]::None => "",
        };
    }

    // Append a node, registering its id in the reverse index. Move the owning
    // string into `ids` FIRST, then take the index key as a view of the stored
    // copy (`id_view`). Taking the view before the move would double-free on
    // drop (see the ordering rule at the top of this file).
    fn push_node(ref this, take id: text::Text, role: Role, parent: option::Option[usize], exposed: bool) -> usize {
        let node_id: usize = this.ids.count();
        this.ids.append(id);
        this.index.insert(this.id_view(node_id), node_id);
        this.roles.append(role);
        this.parents.append(parent);
        this.names.append(text::from_str(""));
        this.descriptions.append(text::from_str(""));
        this.enabled.append(true);
        this.actionable.append(true);
        this.exposed.append(exposed);
        this.excluded.append(false);
        this.tiers.append(tier_open());
        return node_id;
    }

    // Walk up to the nearest exposed ancestor (the agent-visible parent). Returns
    // None only for the root. The root is always exposed, so this terminates.
    fn nearest_exposed_ancestor(this, node: usize) -> option::Option[usize] {
        var cur: option::Option[usize] = this.parent_of(node);
        loop {
            match cur {
                option::Option[usize]::Some(p) => {
                    if this.is_exposed(p) {
                        return option::Option[usize]::Some(p);
                    }
                    cur = this.parent_of(p);
                }
                option::Option[usize]::None => {
                    return option::Option[usize]::None;
                }
            }
        }
        return option::Option[usize]::None;
    }

    fn next_sibling_index(ref this, parent: usize) -> usize {
        let cur: usize = match this.sibling_counts.get(parent) {
            option::Option[usize]::Some(x) => x,
            option::Option[usize]::None => 0 as usize,
        };
        this.sibling_counts.insert(parent, cur +% (1 as usize));
        return cur;
    }
}

// ====================================================================
// Tests
// ====================================================================

fn none_str() -> option::Option[str] {
    return option::Option[str]::None;
}

#[test]
fn test_root_exists() {
    let r: Registry = new();
    assert r.count() == (1 as usize);
    assert r.root() == (0 as usize);
    assert r.contains("app");
    assert r.resolved_id(r.root()) == "app";
    assert role_eq(r.role_of(r.root()), Role::Group);
}

#[test]
fn test_dev_id_wins() {
    var r: Registry = new();
    let root: usize = r.root();
    let btn: usize = r.add_child(root, option::Option[str]::Some("btn_login"), Role::Button);
    assert r.resolved_id(btn) == "btn_login";
    assert r.contains("btn_login");
    let found: usize = match r.lookup("btn_login") {
        option::Option[usize]::Some(n) => n,
        option::Option[usize]::None => 999 as usize,
    };
    assert found == btn;
}

#[test]
fn test_auto_id_fixed_position() {
    var r: Registry = new();
    let root: usize = r.root();
    let b0: usize = r.add_child(root, none_str(), Role::Button);
    let b1: usize = r.add_child(root, none_str(), Role::Button);
    assert r.resolved_id(b0) == "app/button#0";
    assert r.resolved_id(b1) == "app/button#1";
}

#[test]
fn test_auto_id_distinct_roles() {
    var r: Registry = new();
    let root: usize = r.root();
    let b: usize = r.add_child(root, none_str(), Role::Button);
    let t: usize = r.add_child(root, none_str(), Role::Text);
    // The role tag keeps siblings distinct even off a shared index counter.
    assert (r.resolved_id(b) == r.resolved_id(t)) == false;
    assert r.resolved_id(b) == "app/button#0";
    assert r.resolved_id(t) == "app/text#1";
}

#[test]
fn test_nested_path() {
    var r: Registry = new();
    let root: usize = r.root();
    let g: usize = r.add_child(root, none_str(), Role::Group);
    let b: usize = r.add_child(g, none_str(), Role::Button);
    assert r.resolved_id(g) == "app/group#0";
    assert r.resolved_id(b) == "app/group#0/button#0";
}

#[test]
fn test_keyed_item_id() {
    var r: Registry = new();
    let root: usize = r.root();
    let list: usize = r.add_child(root, option::Option[str]::Some("todo_list"), Role::List);
    let item: usize = r.add_item(list, none_str(), Role::Group, 42 as u64);
    assert r.resolved_id(list) == "todo_list";
    assert r.resolved_id(item) == "todo_list/42";
    assert r.contains("todo_list/42");
}

#[test]
fn test_keyed_items_distinct_and_addressable() {
    var r: Registry = new();
    let root: usize = r.root();
    let list: usize = r.add_child(root, option::Option[str]::Some("list"), Role::List);
    let a: usize = r.add_item(list, none_str(), Role::Group, 1 as u64);
    let b: usize = r.add_item(list, none_str(), Role::Group, 2 as u64);
    assert r.resolved_id(a) == "list/1";
    assert r.resolved_id(b) == "list/2";
    let fa: usize = match r.lookup("list/1") {
        option::Option[usize]::Some(n) => n, option::Option[usize]::None => 999 as usize,
    };
    let fb: usize = match r.lookup("list/2") {
        option::Option[usize]::Some(n) => n, option::Option[usize]::None => 999 as usize,
    };
    assert fa == a;
    assert fb == b;
}

#[test]
fn test_role_and_parent_recorded() {
    var r: Registry = new();
    let root: usize = r.root();
    let b: usize = r.add_child(root, none_str(), Role::Button);
    assert role_eq(r.role_of(b), Role::Button);
    let p: usize = match r.parent_of(b) {
        option::Option[usize]::Some(n) => n, option::Option[usize]::None => 999 as usize,
    };
    assert p == root;
    // The root has no parent.
    let root_has_parent: bool = match r.parent_of(root) {
        option::Option[usize]::Some(_) => true, option::Option[usize]::None => false,
    };
    assert root_has_parent == false;
}

// Negative coverage: a miss yields None, not a wrong node, not a crash.
#[test]
fn test_lookup_miss_returns_none() {
    let r: Registry = new();
    assert (r.contains("nope")) == false;
    let missed: bool = match r.lookup("does/not/exist") {
        option::Option[usize]::Some(_) => false,
        option::Option[usize]::None => true,
    };
    assert missed;
}

// Negative coverage: is_valid rejects an out-of-range handle, so callers can
// pre-check before hitting an accessor's bounds assert.
#[test]
fn test_is_valid_rejects_out_of_range() {
    let r: Registry = new();
    assert r.is_valid(0 as usize);
    assert (r.is_valid(1 as usize)) == false;
    assert (r.is_valid(9999 as usize)) == false;
}

// Build-time stability: the same tree, built twice, yields identical ids. This
// is the load-bearing guarantee that lets an agent's saved handles survive a
// restart.
#[test]
fn test_deterministic_rebuild() {
    var r1: Registry = new();
    let root1: usize = r1.root();
    let g1: usize = r1.add_child(root1, none_str(), Role::Group);
    let _b1: usize = r1.add_child(g1, none_str(), Role::Button);
    let l1: usize = r1.add_child(root1, option::Option[str]::Some("items"), Role::List);
    let i1: usize = r1.add_item(l1, none_str(), Role::Group, 7 as u64);

    var r2: Registry = new();
    let root2: usize = r2.root();
    let g2: usize = r2.add_child(root2, none_str(), Role::Group);
    let _b2: usize = r2.add_child(g2, none_str(), Role::Button);
    let l2: usize = r2.add_child(root2, option::Option[str]::Some("items"), Role::List);
    let i2: usize = r2.add_item(l2, none_str(), Role::Group, 7 as u64);

    assert r1.resolved_id(g1) == r2.resolved_id(g2);
    assert r1.resolved_id(l1) == r2.resolved_id(l2);
    assert r1.resolved_id(i1) == r2.resolved_id(i2);
    assert r1.count() == r2.count();
}

// Memory safety: a populated registry drops cleanly (Vec[string] frees each id
// once; views and the reverse index hold non-owning copies). ASan in `cpc test`
// catches a double free or leak here.
#[test]
fn test_drop_no_double_free() {
    var r: Registry = new();
    let root: usize = r.root();
    var i: usize = 0 as usize;
    while i < (32 as usize) {
        let _c: usize = r.add_child(root, none_str(), Role::Button);
        i = i +% (1 as usize);
    }
    assert r.count() == (33 as usize);
    // r drops at scope exit.
}

// --- node state + describe (slice 2) ---------------------------------

#[test]
fn test_name_defaults_empty_and_sets() {
    var r: Registry = new();
    let root: usize = r.root();
    let b: usize = r.add_child(root, option::Option[str]::Some("btn"), Role::Button);
    assert #str_len(r.name_of(b)) == (0 as usize);
    r.set_name(b, "Log In");
    assert r.name_of(b) == "Log In";
    // overwrite frees the old name buffer (ASan would catch a leak/double free).
    r.set_name(b, "Sign In");
    assert r.name_of(b) == "Sign In";
}

#[test]
fn test_state_defaults_and_ceiling() {
    var r: Registry = new();
    let root: usize = r.root();
    let b: usize = r.add_child(root, option::Option[str]::Some("btn"), Role::Button);
    // Defaults: enabled and agent-actionable.
    assert r.is_enabled(b);
    assert r.is_agent_actionable(b);
    // observe-only narrows the ceiling but leaves the widget enabled.
    r.set_observe_only(b);
    assert r.is_enabled(b);
    assert (r.is_agent_actionable(b)) == false;
}

#[test]
fn test_disabled_is_not_actionable() {
    var r: Registry = new();
    let root: usize = r.root();
    let b: usize = r.add_child(root, option::Option[str]::Some("btn"), Role::Button);
    r.set_enabled(b, false);
    assert (r.is_enabled(b)) == false;
    // A disabled node is never agent-actionable, even though not observe-only.
    assert (r.is_agent_actionable(b)) == false;
}

#[test]
fn test_describe_lists_every_node_with_fields() {
    var r: Registry = new();
    let root: usize = r.root();
    let btn: usize = r.add_child(root, option::Option[str]::Some("btn_login"), Role::Button);
    r.set_name(btn, "Log In");
    let v: vec::Vec[NodeView] = r.describe(auth::operator());
    assert v.count() == r.count();
    // NodeId order: index 0 = app root, index `btn` = the button.
    match v.at_ptr(btn) {
        option::Option[*NodeView]::Some(p) => {
            assert (*p).id.equals("btn_login");
            assert role_eq({ (*p).role }, Role::Button);
            assert (*p).name.equals("Log In");
            assert { (*p).actionable };
            let parent: usize = match { (*p).parent } {
                option::Option[usize]::Some(x) => x,
                option::Option[usize]::None => 999 as usize,
            };
            assert parent == root;
        }
        option::Option[*NodeView]::None => { assert false; }
    }
    return;
}

#[test]
fn test_describe_reflects_ceiling() {
    var r: Registry = new();
    let root: usize = r.root();
    let b: usize = r.add_child(root, option::Option[str]::Some("danger"), Role::Button);
    r.set_observe_only(b);
    let v: vec::Vec[NodeView] = r.describe(auth::operator());
    match v.at_ptr(b) {
        option::Option[*NodeView]::Some(p) => {
            assert { (*p).enabled };
            assert ({ (*p).actionable }) == false;
        }
        option::Option[*NodeView]::None => { assert false; }
    }
    return;
}

// Memory safety: describe() returns a Vec[NodeView] that owns two strings per
// node; it must drop each exactly once.
#[test]
fn test_describe_drop_no_double_free() {
    var r: Registry = new();
    let root: usize = r.root();
    var i: usize = 0 as usize;
    while i < (16 as usize) {
        let c: usize = r.add_child(root, none_str(), Role::Text);
        r.set_name(c, "row");
        r.set_exposed(c, true);
        i = i +% (1 as usize);
    }
    let v: vec::Vec[NodeView] = r.describe(auth::operator());
    assert v.count() == (17 as usize);
    // v and r both drop at scope exit; no buffer freed twice.
}

// --- exposure / curation (auth layer 1) ------------------------------

#[test]
fn test_tagged_exposed_auto_hidden() {
    var r: Registry = new();
    let root: usize = r.root();
    let tagged: usize = r.add_child(root, option::Option[str]::Some("btn"), Role::Button);
    let auto: usize = r.add_child(root, none_str(), Role::Group);
    assert r.is_exposed(root);
    assert r.is_exposed(tagged);
    assert (r.is_exposed(auto)) == false;
}

#[test]
fn test_describe_prunes_unexposed_and_reparents() {
    var r: Registry = new();
    let root: usize = r.root();
    // root -> group (auto, hidden) -> btn (tagged, exposed)
    let group: usize = r.add_child(root, none_str(), Role::Group);
    let btn: usize = r.add_child(group, option::Option[str]::Some("btn"), Role::Button);
    let v: vec::Vec[NodeView] = r.describe(auth::operator());
    // Only root + btn are visible; the auto group is pruned.
    assert v.count() == (2 as usize);
    // btn re-parents to the nearest exposed ancestor (root), not the hidden group.
    var found_btn: bool = false;
    var i: usize = 0 as usize;
    while i < v.count() {
        match v.at_ptr(i) {
            option::Option[*NodeView]::Some(p) => {
                if (*p).id.equals("btn") {
                    found_btn = true;
                    let parent: usize = match { (*p).parent } {
                        option::Option[usize]::Some(x) => x,
                        option::Option[usize]::None => 999 as usize,
                    };
                    assert parent == root;
                }
            }
            option::Option[*NodeView]::None => { assert false; }
        }
        i = i +% (1 as usize);
    }
    assert found_btn;
}

#[test]
fn test_set_exposed_opts_auto_node_in() {
    var r: Registry = new();
    let root: usize = r.root();
    let list: usize = r.add_child(root, option::Option[str]::Some("list"), Role::List);
    let row: usize = r.add_item(list, none_str(), Role::Group, 7 as u64);
    assert (r.is_exposed(row)) == false;
    r.set_exposed(row, true);
    assert r.is_exposed(row);
    // describe now includes root + list + row.
    let v: vec::Vec[NodeView] = r.describe(auth::operator());
    assert v.count() == (3 as usize);
}

#[test]
fn test_set_exposed_can_hide_tagged_node() {
    var r: Registry = new();
    let root: usize = r.root();
    let secret: usize = r.add_child(root, option::Option[str]::Some("secret"), Role::Text);
    assert r.is_exposed(secret);
    r.set_exposed(secret, false);
    let v: vec::Vec[NodeView] = r.describe(auth::operator());
    // Only the root remains visible.
    assert v.count() == (1 as usize);
}

// --- declared affordance packing (Phase 2) ---------------------------------

#[test]
fn test_role_from_index_roundtrips() {
    assert role_eq(role_from_index(0 as u32), Role::Button);
    assert role_eq(role_from_index(1 as u32), Role::Text);
    assert role_eq(role_from_index(2 as u32), Role::Input);
    assert role_eq(role_from_index(3 as u32), Role::List);
    assert role_eq(role_from_index(4 as u32), Role::Group);
    assert role_eq(role_from_index(5 as u32), Role::Window);
    assert role_eq(role_from_index(99 as u32), Role::Group);
}

#[test]
fn test_drive_for_role_defaults() {
    assert drive_for_role(Role::Button) == drive_click();
    assert drive_for_role(Role::Input) == drive_text();
    assert drive_for_role(Role::Text) == drive_none();
    assert drive_for_role(Role::Group) == drive_none();
}

#[test]
fn test_pack_affordance_roundtrips_and_is_non_null() {
    let p: *u8 = pack_affordance(role_index(Role::Button) as u32, drive_click());
    assert is_packed_affordance(p);
    assert unpack_role(p) == (role_index(Role::Button) as u32);
    assert unpack_drive(p) == drive_click();

    let q: *u8 = pack_affordance(role_index(Role::Input) as u32, drive_text());
    assert unpack_role(q) == (role_index(Role::Input) as u32);
    assert unpack_drive(q) == drive_text();

    // Marker bit keeps every pack non-null (safe as associated-object ASSIGN).
    assert pack_affordance(0 as u32, 0 as u32) != (0 as *u8);
    assert is_packed_affordance(0 as *u8) == false;
}

#[test]
fn describe_carries_name_and_description() {
    var r: Registry = new();
    let n: usize = r.add_child(r.root(), option::Option[str]::Some("launcher:new"), Role::Button);
    r.set_name(n, "New Project");
    r.set_description(n, "opens the New Project wizard");
    let views: vec::Vec[NodeView] = r.describe(auth::operator());
    // root + the exposed button
    assert views.count() == (2 as usize);
    let ok: bool = match views.at_ptr(1 as usize) {
        option::Option[*NodeView]::Some(v) => {
            let nm: str = { (*v).name.view() };
            let dsc: str = { (*v).description.view() };
            nm == "New Project" && dsc == "opens the New Project wizard"
        }
        option::Option[*NodeView]::None => false,
    };
    assert ok;
    // Unset stays empty, never traps.
    let m: usize = r.add_child(r.root(), option::Option[str]::Some("bare"), Role::Button);
    assert r.name_of(m) == "";
    assert r.description_of(m) == "";
}

#[test]
fn an_excluded_subtree_hides_its_keyed_children_too() {
    // The design doc said an assistant could stay out of its own tree by
    // leaving its panel unkeyed. It cannot: exposure is PER NODE, and
    // `describe` re-parents an exposed node to its nearest exposed ancestor —
    // so the panel vanishes and every keyed control inside it stays, hanging
    // off whatever was above. The assistant would read its own Send button and
    // `is_agent_actionable` would let it press it.
    var r: Registry = new();
    let panel: usize = r.add_child(r.root(), option::Option[str]::Some("assistant:panel"), Role::Group);
    let send: usize = r.add_child(panel, option::Option[str]::Some("assistant:send"), Role::Button);
    let app_btn: usize = r.add_child(r.root(), option::Option[str]::Some("app:save"), Role::Button);

    // Both keyed, so both are exposed to begin with.
    assert r.is_exposed(send);

    r.set_excluded(panel, true);

    // The root of the excluded subtree AND its children go, without either
    // being enumerated — marking the root is the whole declaration.
    assert r.is_exposed(panel) == false;
    assert r.is_exposed(send) == false;
    // The ACTION path refuses too, which is the half that matters: hiding a
    // control from `describe` while `click` still took it would be worse than
    // not hiding it at all. `surface::authorize_action` gates on `is_exposed`,
    // which is exactly why the exclusion was folded in there rather than into
    // the describe loop — `is_agent_actionable` is only the ceiling and never
    // consulted exposure on its own.
    assert r.is_exposed(app_btn);

    // And it is not in the described tree.
    let views: vec::Vec[NodeView] = r.describe(auth::operator());
    var saw_send: bool = false;
    var saw_app: bool = false;
    var i: usize = 0 as usize;
    while i < views.count() {
        match views.at_ptr(i) {
            option::Option[*NodeView]::Some(v) => {
                if { (*v).id.view() } == "assistant:send" { saw_send = true; }
                if { (*v).id.view() } == "app:save" { saw_app = true; }
            }
            option::Option[*NodeView]::None => { }
        }
        i = i +% (1 as usize);
    }
    assert saw_send == false;
    assert saw_app;
    return;
}

#[test]
fn a_protected_node_is_still_described_with_its_label() {
    // The half that is easy to get wrong by being too strict: hiding the node
    // is what we ALREADY had, and it is what makes an assistant useless. The
    // node stays in the curated tree with id, role and dev-authored name; the
    // tier and `readable` are what tell the model why it has no value and
    // whether asking would help.
    var r: Registry = new();
    let box_n: usize = r.add_child(r.root(), option::Option[str]::Some("payment"), Role::Group);
    let card: usize = r.add_child(box_n, option::Option[str]::Some("payment:card"), Role::Input);
    r.set_name(card, "Card number");
    r.set_tier(box_n, tier_protected());

    let views: vec::Vec[NodeView] = r.describe(auth::operator());
    var seen: bool = false;
    var i: usize = 0 as usize;
    while i < views.count() {
        match views.at_ptr(i) {
            option::Option[*NodeView]::Some(n) => {
                if { (*n).id.view() } == "payment:card" {
                    seen = true;
                    assert { (*n).tier } == tier_protected();   // inherited from the box
                    assert !{ (*n).readable };
                    assert !{ (*n).actionable };
                    assert { (*n).name.view() } == "Card number";   // the LABEL survives
                }
            }
            option::Option[*NodeView]::None => { }
        }
        i = i +% (1 as usize);
    }
    assert seen;
    return;
}

#[test]
fn the_same_tree_answers_two_grants_differently() {
    // One registry, built once, serving two agents. `actionable`/`readable`
    // are per-grant answers and must not be baked in at walk time — an agent's
    // tool list is exactly this, and a shared cached answer would hand one
    // agent the other's permissions.
    var r: Registry = new();
    let card: usize = r.add_child(r.root(), option::Option[str]::Some("card"), Role::Input);
    r.set_tier(card, tier_protected());

    let plain: vec::Vec[NodeView] = r.describe(auth::operator());
    let approved: vec::Vec[NodeView] = r.describe(auth::protected_operator());
    match plain.at_ptr(1 as usize) {
        option::Option[*NodeView]::Some(n) => {
            assert !{ (*n).readable };
            assert !{ (*n).actionable };
        }
        option::Option[*NodeView]::None => { assert false; }
    };
    match approved.at_ptr(1 as usize) {
        option::Option[*NodeView]::Some(n) => {
            assert { (*n).readable };
            assert { (*n).actionable };
            assert { (*n).tier } == tier_protected();   // the DECLARATION is unchanged
        }
        option::Option[*NodeView]::None => { assert false; }
    };
    return;
}

#[test]
fn a_content_name_never_lands_on_a_sensitive_node() {
    // The leak that shipped: a walk with no accessibility label falls back to
    // the widget's own string, and a card field's own string is the number.
    // `set_content_name` is the door that fallback goes through, and it is shut
    // for BOTH tiers — a registry is built once and answers every grant, so a
    // value stored as a name would reach the next agent with plain `read`.
    var r: Registry = new();
    let card: usize = r.add_child(r.root(), option::Option[str]::Some("card"), Role::Input);
    let cvc: usize = r.add_child(r.root(), option::Option[str]::Some("cvc"), Role::Input);
    r.set_tier(card, tier_protected());
    r.set_tier(cvc, tier_private());
    r.set_content_name(card, "4242424242424242");
    r.set_content_name(cvc, "311");
    assert r.name_of(card) == "";
    assert r.name_of(cvc) == "";
    // The dev-authored label is a different door and stays open.
    r.set_name(card, "Card number");
    assert r.name_of(card) == "Card number";
    return;
}

#[test]
fn policy_values_round_trip_through_a_pinned_word() {
    // The backends pin this on a native widget as a non-null integer.
    assert unpack_policy(pack_policy(policy_none())) == policy_none();
    assert unpack_policy(pack_policy(policy_protected())) == policy_protected();
    assert unpack_policy(pack_policy(policy_private())) == policy_private();
    assert unpack_policy(pack_policy(policy_exclude())) == policy_exclude();
    assert pack_policy(policy_none()) != (0 as *u8);
    // An unpinned widget (null) and a foreign pointer both read as "no policy",
    // never as a tier that silently blinds the agent — nor as one that opens a
    // field the app meant to close.
    assert unpack_policy(0 as *u8) == policy_none();
    assert unpack_policy(8 as *u8) == policy_none();
    return;
}

#[test]
fn set_policy_routes_to_the_right_mechanism() {
    var r: Registry = new();
    let a: usize = r.add_child(r.root(), option::Option[str]::Some("a"), Role::Input);
    let b: usize = r.add_child(r.root(), option::Option[str]::Some("b"), Role::Input);
    let c: usize = r.add_child(r.root(), option::Option[str]::Some("c"), Role::Input);
    let d: usize = r.add_child(r.root(), option::Option[str]::Some("d"), Role::Input);
    r.set_policy(a, policy_protected());
    r.set_policy(b, policy_private());
    r.set_policy(c, policy_exclude());
    r.set_policy(d, policy_none());
    assert r.tier_of(a) == tier_protected();
    assert r.is_exposed(a);        // a tier does NOT hide
    assert r.tier_of(b) == tier_private();
    assert r.is_exposed(b);
    assert !r.is_exposed(c);       // exclusion does
    assert r.tier_of(d) == tier_open();
    return;
}

#[test]
fn tier_capabilities_are_distinct_per_tier() {
    // The mapping every verb shares. Protected costs the protected bits and
    // private costs the private ones; neither is a superset of the other, so
    // an autofill approval cannot become CVC access by implication.
    assert read_caps_for_tier(tier_open()) == auth::cap_read();
    assert read_caps_for_tier(tier_protected()) == (auth::cap_read() | auth::cap_read_protected());
    assert read_caps_for_tier(tier_private()) == (auth::cap_read() | auth::cap_read_private());
    assert act_caps_for_tier(tier_open()) == auth::cap_act();
    assert act_caps_for_tier(tier_protected()) == (auth::cap_act() | auth::cap_act_protected());
    assert act_caps_for_tier(tier_private()) == (auth::cap_act() | auth::cap_act_private());
    assert stricter_tier(tier_open(), tier_private()) == tier_private();
    assert stricter_tier(tier_private(), tier_protected()) == tier_private();
    return;
}
