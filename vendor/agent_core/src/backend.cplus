// vendor/agent_core/src/backend.cplus
//
// The backend-neutral surface contract for the MCP bridge (and any other
// framework-agnostic consumer of a live UI surface). agent_mcp drives a
// concrete backend `Surface` (agent_appkit / agent_win32 / agent_gtk)
// through this, so the bridge itself names no backend.
//
// Why a fn-pointer vtable rather than an interface-bound generic? C+ has no
// method dispatch on a generic type-param for user types (only the
// compiler-blessed Hash/Eq/Ord/Copy/Drop/Clone), and no `dyn`/trait objects.
// The C idiom — a struct of fn-pointers plus a type-erased `*u8` receiver
// each implementor casts back — is the portable way to get runtime
// polymorphism here. Each backend supplies a `Backend` whose fns cast the
// erased pointer to its own `Surface` and call the real methods.

import "stdlib/vec" as vec;
import "stdlib/text" as text;
import "stdlib/option" as option;
import "./identity" as identity;
import "./surface" as surface;

// Neutral geometry. f64 absorbs every backend's frame losslessly: AppKit's
// `rt::Rect` is already f64, Win32's integer rect widens, GTK's f32 widens.
struct Rect {
    x: f64,
    y: f64,
    w: f64,
    h: f64,
}

// One backend-agnostic describe_ui node. Identical fields to each backend's
// own `UiNode`, but with the neutral `Rect` frame, so the MCP serializer can
// read it without knowing which backend produced it.
struct UiNode {
    id: text::Text,
    role: identity::Role,
    class_name: text::Text,
    frame: Rect,
    is_hidden: bool,
    text: text::Text,
    // Agent-facing intent ("opens the New Project wizard"), dev-authored.
    // Carried by the curated exposed view; "" elsewhere.
    description: text::Text,
    actionable: bool,
    parent: option::Option[usize],
}

// The backend vtable. Every fn takes the type-erased surface pointer as its
// first argument (the implementor casts `*u8` back to its `Surface`). The
// four operations the MCP protocol needs:
//   describe  -> the live snapshot (read path)
//   click     -> authorized activation
//   set_text  -> authorized, optimistic-concurrency text edit (mutating)
//   navigate  -> bring a node into view (AppKit scrolls; Win32/GTK focus)
// `Backend` is Copy (all fields are fn-pointers), so it passes by value
// freely through the dispatch/serve call chain.
struct Backend {
    describe: fn(*u8) -> vec::Vec[UiNode],
    // The CURATED snapshot: only developer-exposed nodes, lean fields (id,
    // role, name-as-text, actionable, parent re-parented to the nearest
    // exposed ancestor) — identity::Registry.describe() over the wire. The
    // MCP client picks per request (describe_ui mode param); "exposed" is
    // the default view, `describe` above is the opt-in full tree.
    describe_exposed: fn(*u8) -> vec::Vec[UiNode],
    click: fn(*u8, str) -> surface::Outcome,
    set_text: fn(*u8, str, str, u64) -> surface::Outcome,
    navigate: fn(*u8, str) -> surface::Outcome,
    // Is this node what a pointer at its own centre would reach, or is
    // something on top of it? An INSPECTION, not a gesture — it synthesizes no
    // event and cannot act. Backends that cannot hit-test report
    // `supported: false` rather than a plausible answer.
    //
    // TWO RULES FOR ANY POINTER VERB ADDED BESIDE THIS ONE (press, drag, hover):
    //
    // 1. ADDRESS BY ID, NEVER BY POINT. Every verb here authorizes a NODE —
    //    exposure, and for actions the affordance ceiling. A verb taking
    //    coordinates authorizes nothing, and would let an agent reach unexposed
    //    UI by pixel. That is a hole in the consent model, not a convenience.
    //
    // 2. THEY VERIFY THE HUMAN PATH; THEY DO NOT EXCUSE UI THAT NEEDS ONE.
    //    This surface has no `key` verb and no `drag` verb on purpose: an app
    //    driven by both a person and an agent must not require a gesture only
    //    one of them can make, so Enter-to-commit gets a button beside it and
    //    drag-to-move gets a click path. Those constraints made the UI better.
    //    A `drag` verb makes drag-only affordances shippable again — so if one
    //    is ever added, it is for REGRESSION-TESTING a gesture that already has
    //    a click path, never for driving one that does not.
    hit_test: fn(*u8, str) -> surface::HitTest,
    // Move a drag source's payload onto a drop destination, both by id. FIRES
    // the drop rather than performing a gesture — the source's own mouseDown:
    // starts a modal drag-tracking loop that can never return to a caller
    // waiting on a socket, so a remote driver could not use it. Verifies the
    // app's drop handler and the payload it receives; whether a person could
    // complete the gesture is `hit_test`'s question.
    drag: fn(*u8, str, str) -> surface::Outcome,
}
