// vendor/agent_core/src/backend.cplus
//
// The backend-neutral surface contract for agent consumers. agent_mcp and
// agent_inapp drive a
// concrete backend `Surface` (agent_appkit / agent_win32 / agent_gtk)
// through this, so the bridge itself names no backend.
//
// Why a fn-pointer vtable rather than an interface-bound generic? C+ has no
// method dispatch on a generic type-param for user types (only the
// compiler-blessed Hash/Eq/Ord/Copy/Drop/Clone), and no `dyn`/trait objects.
// The C idiom — a struct of fn-pointers plus a type-erased `*u8` receiver
// each implementor casts back — is the portable way to get runtime
// polymorphism here. Each backend supplies a `Backend` whose fns cast the
// erased pointer to its own `Surface` and call the real methods.

import "stdlib/vec" as vec;
import "stdlib/text" as text;
import "stdlib/option" as option;
import "./identity" as identity;
import "./surface" as surface;
import "./auth" as auth;

// Neutral geometry. f64 absorbs every backend's frame losslessly: AppKit's
// `rt::Rect` is already f64, Win32's integer rect widens, GTK's f32 widens.
struct Rect {
    x: f64,
    y: f64,
    w: f64,
    h: f64,
}

// One backend-agnostic describe_ui node. Identical fields to each backend's
// own `UiNode`, but with the neutral `Rect` frame, so consumers can read it
// without knowing which backend produced it.
struct UiNode {
    id: text::Text,
    role: identity::Role,
    class_name: text::Text,
    frame: Rect,
    is_hidden: bool,
    text: text::Text,
    // The agent-facing NAME: the accessibility label the developer set
    // (facet `.accessibility_label`), else the widget's own title. It is the
    // only thing an icon-only control says about itself — a glyph is not a
    // name — and a node with no text child (a drop target, a card that carries
    // its title in a grandchild) says nothing without it. "" when neither
    // channel has anything.
    name: text::Text,
    // Agent-facing intent ("opens the New Project wizard"), dev-authored.
    // Carried by the curated exposed view; "" elsewhere.
    description: text::Text,
    // PERMISSION: may the agent act on this node (exposed + enabled + not
    // observe-only)?
    actionable: bool,
    // CAPABILITY: would a `click` on this node be DELIVERED? The two are
    // independent and neither implies the other. A keyed layout container is
    // permitted and cannot be clicked; a disabled button could be clicked and
    // is not permitted. Reporting only the permission made every keyed group
    // advertise a press that does not exist, and an agent — which has no eyes,
    // and for which this flag is the whole of what it knows — had to spend a
    // click on each to find out. See `actionable` above for the other half.
    clickable: bool,
    // DELIVERY: would that click reach a HANDLER? The third question, and the
    // one nothing was asking.
    //
    // `actionable` is permission and `clickable` is capability, and a control
    // can pass both and still be dead: an NSButton written with a gesture band
    // instead of its own `on_click` consumes its own mouse event through
    // target/action, so the gesture never fires. iris shipped one. Every signal
    // on this wire read identically to a working button — same role, same
    // actionable, same clickable, same hit_test, same AppKit action — and a
    // 23-assertion sweep stayed green, including the assertion about that
    // button, because `click` invokes the handler directly and answers
    // `Allowed` for a control no person can operate.
    //
    // `None` means THIS BACKEND CANNOT ANSWER, and is not a soft "no". The same
    // posture `hit_test` takes with `supported: false`: a plausible answer here
    // is worse than an absent one, because an agent has no eyes and this flag is
    // the whole of what it knows.
    wired: option::Option[bool],
    // SENSITIVITY, in two fields because they answer two questions.
    //
    // `tier` is what the APPLICATION declared (open / protected / private) and
    // is the same for every agent. `readable` is what THIS GRANT may do with
    // it; when it is false a backend leaves `text` empty.
    //
    // Both on the wire. `text: ""` on its own reads as "this field is empty,
    // go and fill it in" — a lie in the shape of a fact, and a model acts on
    // it. With the pair, an agent seeing protected+unreadable knows to ask the
    // user for permission, and one seeing private knows not to bother.
    tier: u32,
    readable: bool,
    // The parent's INDEX IN THE ARRAY THIS NODE ARRIVED IN — not a NodeId, and
    // not an index into any other snapshot. Both describe paths prune (the full
    // one drops the synthetic app root, the exposed one drops every unexposed
    // node), so a backend that forwards its registry's numbering here is
    // pointing every consumer at a different node than it means. Nothing about
    // a wrong index looks wrong on arrival: it resolves, it just resolves to
    // the wrong node, and a consumer walking the chain to a root can walk
    // forever (demo_11/bugs/001). Rebase when you build the array.
    parent: option::Option[usize],
}

// The backend vtable. Every fn takes the type-erased surface pointer as its
// first argument (the implementor casts `*u8` back to its `Surface`) and the
// caller's `auth::Grant` as its second.
//
// THE GRANT IS A PARAMETER, NOT STATE. It is a Copy bitset passed down every
// call rather than stashed on the surface, so there is no ambient "current
// permissions" for a later call to inherit, no window between a connection
// dropping and its authority being cleared, and no way for two agents sharing
// one surface to pick up each other's authority. The cost is a wider signature
// on nine functions; the alternative costs a class of bug that does not
// announce itself. The
// operations every agent consumer needs:
//   describe  -> the live snapshot (read path)
//   click     -> authorized activation
//   set_text  -> authorized, optimistic-concurrency text edit (mutating)
//   navigate  -> bring a node into view (AppKit scrolls; Win32/GTK focus)
// `Backend` is Copy (all fields are fn-pointers), so it passes by value
// freely through the dispatch/serve call chain.
struct Backend {
    describe: fn(*u8, auth::Grant) -> vec::Vec[UiNode],
    // The CURATED snapshot: only developer-exposed nodes, lean fields (id,
    // role, name-as-text, actionable, parent re-parented to the nearest
    // exposed ancestor AND renumbered into this array — identity::Registry
    // .describe() over the wire, forwarded verbatim. The
    // MCP client picks per request (describe_ui mode param); "exposed" is
    // the default view, `describe` above is the opt-in full tree.
    describe_exposed: fn(*u8, auth::Grant) -> vec::Vec[UiNode],
    click: fn(*u8, auth::Grant, str) -> surface::Outcome,
    set_text: fn(*u8, auth::Grant, str, str, u64) -> surface::Outcome,
    navigate: fn(*u8, auth::Grant, str) -> surface::Outcome,
    // Is this node what a pointer at its own centre would reach, or is
    // something on top of it? An INSPECTION, not a gesture — it synthesizes no
    // event and cannot act. Backends that cannot hit-test report
    // `supported: false` rather than a plausible answer.
    //
    // NO GESTURE VERBS HERE. EVER. An agent driving this surface has no hands:
    // it cannot drag, cannot pinch to zoom, cannot swipe, and no amount of
    // plumbing changes that. So the answer to "the agent needs to move a card
    // between lanes" is never a `drag` verb — it is a click path in the UI,
    // which the app owes its users anyway. Same for Enter-to-commit: a button
    // beside the field. Every one of those constraints has made the UI better
    // for people too; a visible button beats a hidden keystroke, and a click
    // beats a drag for anyone who cannot drag precisely.
    //
    // A `drag(from, to)` verb WAS written and reverted (2026-07-29). It did not
    // synthesize a gesture — it fired the destination's drop handler directly,
    // the way a browser test dispatches `drop` at an element — and it still had
    // to go, because the objection is not "that is not a real gesture". It is
    // that shipping the verb at all makes drag-only affordances viable again,
    // and the app stops owing anyone a click path. Do not rebuild it.
    //
    // `hit_test` below is not an exception to that rule: it CANNOT ACT. It
    // takes no gesture, sends no event, and changes nothing — it only reports
    // what is at a node's own centre. Inspection is allowed; actuation is what
    // is not.
    //
    // ---- and whatever is added here, it pays for what it takes --------------
    //
    // Three rules, in the same register as the one above, because each of them
    // was learned from something that had already shipped:
    //
    //   A verb that reads a node's CONTENT goes through
    //   `surface::authorize_value_read`. Not `authorize_read` — that one
    //   answers "may this agent know the node exists", which every gated node
    //   still answers yes to. `read_runs` shipped on the wrong one, and a
    //   redacted field that reports "one run, sixteen characters" has told an
    //   agent the length of a card number.
    //
    //   A verb that changes the UI's STRUCTURE goes through
    //   `surface::authorize_tree_edit`. Not `authorize_action`: `act` does what
    //   a person could do through the interface as built, and rebuilding the
    //   interface is a different kind of power that nothing else implies.
    //
    //   A verb that returns PIXELS — a screenshot, a thumbnail, a rendered
    //   snapshot — blacks out every non-Open node's frame, or it does not land.
    //   There is no such verb today. When there is, it will be the first one
    //   that can leak a card number without ever reading a string, and no
    //   authorization check in this file would see it happen.
    //
    // And ADDRESS BY ID, NEVER BY POINT. Every verb
    // authorizes a NODE — exposure, and for actions the affordance ceiling. A
    // verb taking coordinates authorizes nothing, and would let an agent reach
    // unexposed UI by pixel: a hole in the consent model, not a convenience.
    hit_test: fn(*u8, auth::Grant, str) -> surface::HitTest,
    // ---- the three that turn "I believe" into "I checked" -------------------
    // Every one of these is a verb the surface could not reach, and every one
    // of them is exactly where unverified work had to be handed over.
    //
    // PLACE THE CARET. `set_text` writes a whole value; a symbol command, a
    // go-to-line, an insertion at a point — none of them could be AIMED, so
    // every editor command that acts at the caret rested on a caret nothing
    // here could put anywhere. Offsets are BYTES of the control's own text.
    set_caret: fn(*u8, auth::Grant, str, u64, u64) -> surface::Outcome,
    // READ BACK WHAT IS DRAWN. `text` says what the control holds and nothing
    // said how it is drawn, so "did the syntax colour land" needed a probe
    // compiled into the app four separate times.
    read_runs: fn(*u8, auth::Grant, str) -> surface::Runs,
    // INVOKE A MENU ITEM, addressed as `Menu/Item` — the titles as built, which
    // is what a user reads and what the application wrote. Every key equivalent
    // (⌘F, ⌘G and five Go/Edit commands) rested on the menu click reaching
    // `events::emit`, the one link nothing here could drive.
    //
    // This is not a gesture verb and not an exception to the rule above it: a
    // menu item is an ACTION with a name, the same thing `click` fires on a
    // button, and it is addressed by that name rather than by a point. What it
    // will not do is open menus for exploration — the item either exists and is
    // enabled, or the answer is NotFound / NotActionable.
    invoke_menu: fn(*u8, auth::Grant, str) -> surface::Outcome,
}
