// vendor/agent_core/src/surface.cplus
//
// The agent-surface action + text-op layer (plan.agent-core.md §5.2, §5.3).
//
// This is the framework-agnostic ENFORCEMENT brain, not the widget I/O. The
// core decides whether an operation is permitted — addressing (the node exists),
// exposure (layer 1), the affordance ceiling (layer 2), and, for text edits,
// optimistic-concurrency via a version stamp — and returns an `Outcome`. The
// actual read/write/click on a real widget is GUI-coupled and belongs to the
// backend (the AppKit slice), which performs the operation only when the core
// returns `Allowed`.
//
// Why not a dispatched `UiBackend` interface + a fake here? Not for want of the
// language: interface-bound generics work — both `fn op[B: UiBackend](...)` and
// `Surface[B: UiBackend]` compile and dispatch (verified 2026-07-26; the claim
// that they did not was stale). C+ still has no capturing closures, so a port
// would have to be an interface or an fn pointer, but that is a shape
// constraint, not a blocker.
//
// The real reason is the boundary itself: keeping the core to pure
// authorization + version state is the cleaner framework-agnostic split — the
// backend is dumb execution, the core is the policy. That argument stood on its
// own even when the language was the stated cause.
//
// Consumer flow:
//   click(id)            -> authorize_action; if Allowed, backend.activate(node)
//   input(id, text)      -> authorize_action; if Allowed, backend.set_value(...)
//   scroll_to(id)        -> authorize_read;   if Allowed, backend.scroll_to(node)
//   get_text(id)         -> authorize_read;   if Allowed, read widget + version_of(node)
//   replace_range(...)   -> authorize_text_write(base_version); if Allowed,
//                           backend.set_text(...) then versions.bump(node)

import "stdlib/option" as option;
import "stdlib/result" as result;
import "stdlib/hash_map" as hash_map;
import "stdlib/text" as text;
import "stdlib/vec" as vec;
import "./identity" as identity;
import "./auth" as auth;

// The result of an authorization check.
enum Outcome {
    Allowed,
    NotFound,       // no node with that id / invalid handle
    NotExposed,     // node exists but is not in the agent-visible tree (layer 1)
    NotActionable,  // observe-only or disabled (layer 2 ceiling)
    VersionConflict, // text edit raced a change; the agent must re-read
    Stale,          // the node's backing widget left the live UI (e.g. a
                    // re-render replaced it); the agent must re-open the surface
    NeedsGrant,     // the node is Protected and this grant lacks the bit. A
                    // REACHABLE state: there is a grant that opens it, so the
                    // right move for an agent is to ask the user for the
                    // permission and try again. This is the autofill flow.
    NoHandler,      // the click was permitted and would have landed, and there
                    // is nothing on the other end of it. Distinct from
                    // `NotActionable`, which is a refusal: this one ACTIVATED
                    // the control and the control did nothing, because its
                    // handler slot is empty. Reported instead of `Allowed`
                    // because `Allowed` on a dead control is what let a
                    // 23-assertion sweep pass with a button nobody could
                    // operate — an outcome that cannot distinguish "it worked"
                    // from "it went nowhere" makes every click assertion in a
                    // suite weaker than it reads.
    Forbidden,      // the node is Private and this grant lacks the bit. The
                    // bits exist, and an application is expected never to mint
                    // them — so from an agent's side this is final. Distinct
                    // from NeedsGrant on purpose: one says ask, the other says
                    // stop, and an agent told the wrong one either gives up on
                    // work it could have done or nags for a permission that is
                    // never coming.
}

fn outcome_index(o: Outcome) -> i32 {
    return match o {
        Outcome::Allowed => 0,
        Outcome::NotFound => 1,
        Outcome::NotExposed => 2,
        Outcome::NotActionable => 3,
        Outcome::VersionConflict => 4,
        Outcome::Stale => 5,
        Outcome::NeedsGrant => 6,
        Outcome::Forbidden => 7,
        Outcome::NoHandler => 8,
    };
}

fn outcome_eq(a: Outcome, b: Outcome) -> bool {
    return outcome_index(a) == outcome_index(b);
}

// The word a refusal gets when a grant is short of a node's tier. Protected
// means "ask"; Private means "stop". Getting this backwards is not cosmetic —
// it decides whether an agent nags a user for a permission that is never
// coming, or silently abandons work a single approval would have unblocked.
fn refusal_for_tier(t: u32) -> Outcome {
    if t == identity::tier_private() { return Outcome::Forbidden; }
    return Outcome::NeedsGrant;
}

// Authorize a mutating/activating action (click, input). The node must exist,
// be exposed, be within the affordance ceiling, and the grant must carry the
// action bits its tier costs.
//
// The tier is checked AFTER the ceiling: a disabled protected field is
// `NotActionable`, which is true and useful, rather than sending an agent off
// to request a permission that would not have helped.
fn authorize_action(reg: identity::Registry, grant: auth::Grant, node: usize) -> Outcome {
    if !reg.is_valid(node) {
        return Outcome::NotFound;
    }
    if !reg.is_exposed(node) {
        return Outcome::NotExposed;
    }
    if !reg.is_agent_actionable(node) {
        return Outcome::NotActionable;
    }
    if !grant.has(identity::act_caps_for_tier(reg.tier_of(node))) {
        return refusal_for_tier(reg.tier_of(node));
    }
    return Outcome::Allowed;
}

// Authorize reading a node's CONTENT — its text, its attribute runs, anything
// derived from what the user put in it.
//
// Separate from `authorize_read` because the two questions genuinely differ: a
// protected field may still be scrolled to, described, and reported as present
// and enabled. What it may not do without the bits is say what is in it. A
// backend that reads a value without passing through here is the leak this
// whole layer exists to stop, so there is exactly one door and it is this one.
fn authorize_value_read(reg: identity::Registry, grant: auth::Grant, node: usize) -> Outcome {
    let r: Outcome = authorize_read(reg, grant, node);
    if !outcome_eq(r, Outcome::Allowed) {
        return r;
    }
    if !grant.has(identity::read_caps_for_tier(reg.tier_of(node))) {
        return refusal_for_tier(reg.tier_of(node));
    }
    return Outcome::Allowed;
}

// Authorize a STRUCTURAL edit — insert, remove, reparent, set an arbitrary
// property. Not addressed to a node, because the power is not about one: it is
// the ability to rebuild the interface, which is a different kind of thing from
// `act`. `act` does what a person could do through the UI as built; this
// changes what the UI IS, and no amount of it is implied by any other bit.
fn authorize_tree_edit(grant: auth::Grant) -> Outcome {
    if !grant.has(auth::cap_edit_tree()) {
        return Outcome::Forbidden;
    }
    return Outcome::Allowed;
}

// Authorize a read / navigation (get_text, scroll_to). Requires the node to
// exist and be exposed; the ceiling does not apply (reading/scrolling-to an
// observe-only node is fine — you just cannot act on it).
fn authorize_read(reg: identity::Registry, grant: auth::Grant, node: usize) -> Outcome {
    if !reg.is_valid(node) {
        return Outcome::NotFound;
    }
    // `NeedsGrant`, not `Forbidden`: a missing BASE capability is a thing a
    // wider grant fixes, so an agent handed a read-only credential by mistake
    // is told to ask rather than to give up. `Forbidden` is reserved for the
    // tier an application declares and never mints — see `refusal_for_tier`.
    if !grant.has(auth::cap_read()) {
        return Outcome::NeedsGrant;
    }
    if !reg.is_exposed(node) {
        return Outcome::NotExposed;
    }
    return Outcome::Allowed;
}

// The answer to "could a person actually click this?" — the one question the
// action verbs cannot ask. `click` resolves an id and sends the action straight
// to the backing widget: deterministic, it names what it acted on, and it
// cannot miss. That is right for DRIVING an app and it is exactly why it
// verifies nothing about the human path — no hit-test, no event, no tracking.
// So a control with something on top of it is indistinguishable, through the
// agent surface, from one a person can reach.
//
// This verb answers that WITHOUT being able to click anything: it asks the view
// tree what is at the node's own centre point and reports whether that is the
// node. No event synthesis, so it cannot press, drag, or reach anything by
// coordinate.
//
// Addressed by ID like every other verb, which is what keeps the consent model
// intact: a POINT-addressed verb would let an agent reach unexposed UI by
// coordinate, which is a hole, not a feature. For the same reason `covered_by`
// names the obstruction only when that node is itself exposed — otherwise the
// verb would leak the identity of UI the app deliberately did not expose, while
// `covered` still reports the fact truthfully.
struct HitTest {
    outcome: Outcome,          // authorization, the same gate as any read verb
    supported: bool,           // false where the backend cannot hit-test at all
    reachable: bool,           // the node (or its own subtree) is what is there
    covered: bool,             // something else is on top
    covered_by: text::Text,    // that node's id — only when IT is exposed; "" otherwise
}

// A hit test that never ran: authorization failed, or the backend has no
// hit-testing. Reports nothing about reachability rather than guessing.
fn hit_test_refused(o: Outcome, supported: bool) -> HitTest {
    return HitTest { outcome: o, supported: supported, reachable: false, covered: false, covered_by: text::new() };
}

// ---- reading back what a text control is actually DRAWING ---------------------
// "Did the syntax colour land" needed a probe compiled into the app four
// separate times, because every read verb answers `text` and none of them
// answered how it is drawn. One run per stretch of uniform attributes — the
// same shape `attributesAtIndex:effectiveRange:` walks, and the same shape the
// contract's `set_style_runs` states.
//
// OFFSETS ARE BYTES of the control's own text, like every other offset facet
// puts on the wire; a backend that indexes in UTF-16 converts on the way out.
// The colour is `#rrggbb` (or "" where the run has no colour of its own),
// because an agent compares strings and cannot dereference an NSColor.
struct TextRun {
    start: u64,
    length: u64,
    color: text::Text,
    is_bold: bool,
    is_italic: bool,
    is_underlined: bool,
}

struct Runs {
    outcome: Outcome,
    supported: bool,       // false where the backend cannot read attributes
    runs: vec::Vec[TextRun],
}

// Runs that were never read: authorization failed, the node is not a text
// control, or the backend has no attribute model. Empty, never a guess.
fn runs_refused(o: Outcome, supported: bool) -> Runs {
    return Runs { outcome: o, supported: supported, runs: vec::new::[TextRun]() };
}

// Core-side per-node text version (plan.agent-core.md §5.2). Maintained here, not
// by the backend: `get_text` returns the current version, and `replace_range`
// supplies the version it read so a racing edit is rejected (optimistic
// concurrency) rather than silently clobbering.
struct TextVersions {
    v: hash_map::HashMap[usize, u64],
}

fn new_text_versions() -> TextVersions {
    return TextVersions { v: hash_map::new::[usize, u64]() };
}

impl TextVersions {
    // A node's current text version (0 until its first edit).
    fn version_of(this, node: usize) -> u64 {
        return match this.v.get(node) {
            option::Option[u64]::Some(x) => x,
            option::Option::None => 0,
        };
    }

    // Bump after a committed write. The consumer calls this once the backend has
    // actually applied the edit.
    fn bump(ref this, node: usize) {
        let cur: u64 = this.version_of(node);
        this.v.insert(node, cur +% 1);
    }
}

// Authorize a text edit: the node must pass the action checks AND the caller's
// `base_version` must match the current version (else a concurrent change won
// the race). On `Allowed` the consumer applies the edit, then calls
// `versions.bump(node)`.
fn authorize_text_write(reg: identity::Registry, grant: auth::Grant, versions: TextVersions, node: usize, base_version: u64) -> Outcome {
    let act: Outcome = authorize_action(reg, grant, node);
    if !outcome_eq(act, Outcome::Allowed) {
        return act;
    }
    if base_version != versions.version_of(node) {
        return Outcome::VersionConflict;
    }
    return Outcome::Allowed;
}

// ====================================================================
// Tests
// ====================================================================

// app(0) -> [ btn(1, Button, tagged), field(2, Input, tagged) ]
fn fixture() -> identity::Registry {
    var r: identity::Registry = identity::new();
    let root: usize = r.root();
    let _btn: usize = r.add_child(root, option::Option[str]::Some("btn"), identity::Role::Button);
    let _field: usize = r.add_child(root, option::Option[str]::Some("field"), identity::Role::Input);
    return r;
}

// The ordinary assistant: read and act on ordinary nodes.
fn ops() -> auth::Grant { return auth::operator(); }

#[test]
fn test_action_allowed_on_exposed_actionable() {
    let r: identity::Registry = fixture();
    assert outcome_eq(authorize_action(r, ops(), 1), Outcome::Allowed);
}

#[test]
fn test_action_not_found_for_bad_handle() {
    let r: identity::Registry = fixture();
    assert outcome_eq(authorize_action(r, ops(), 999), Outcome::NotFound);
}

#[test]
fn test_action_blocked_when_unexposed() {
    var r: identity::Registry = fixture();
    r.set_exposed(1, false);
    assert outcome_eq(authorize_action(r, ops(), 1), Outcome::NotExposed);
}

#[test]
fn test_action_blocked_inside_an_excluded_subtree() {
    // The assistant's own panel. Marking its ROOT is the whole declaration —
    // a keyed control inside it is refused without being named, which is what
    // "the panel is ignored during query" has to mean if it is to be worth
    // anything. Read and act are one answer: `authorize_action` gates on
    // `is_exposed`, and exclusion folds in there.
    var r: identity::Registry = fixture();
    let inner: usize = r.add_child(1, option::Option[str]::Some("assistant:send"),
                                   identity::Role::Button);
    assert outcome_eq(authorize_action(r, ops(), inner), Outcome::Allowed);
    r.set_excluded(1, true);
    assert outcome_eq(authorize_action(r, ops(), inner), Outcome::NotExposed);
}

#[test]
fn test_action_blocked_by_observe_only_ceiling() {
    var r: identity::Registry = fixture();
    r.set_observe_only(1);
    assert outcome_eq(authorize_action(r, ops(), 1), Outcome::NotActionable);
}

#[test]
fn test_action_blocked_when_disabled() {
    var r: identity::Registry = fixture();
    r.set_enabled(1, false);
    assert outcome_eq(authorize_action(r, ops(), 1), Outcome::NotActionable);
}

#[test]
fn test_read_allows_observe_only_but_not_unexposed() {
    var r: identity::Registry = fixture();
    r.set_observe_only(1);
    // observe-only is still readable / scroll-to-able.
    assert outcome_eq(authorize_read(r, ops(), 1), Outcome::Allowed);
    r.set_exposed(2, false);
    assert outcome_eq(authorize_read(r, ops(), 2), Outcome::NotExposed);
}

#[test]
fn test_text_version_starts_zero_and_bumps() {
    var tv: TextVersions = new_text_versions();
    assert tv.version_of(2) == 0;
    tv.bump(2);
    assert tv.version_of(2) == 1;
    tv.bump(2);
    assert tv.version_of(2) == 2;
}

#[test]
fn test_text_write_optimistic_concurrency() {
    let r: identity::Registry = fixture();
    var tv: TextVersions = new_text_versions();
    assert outcome_eq(authorize_text_write(r, ops(), tv, 2, 0), Outcome::Allowed);
    tv.bump(2);
    assert outcome_eq(authorize_text_write(r, ops(), tv, 2, 0), Outcome::VersionConflict);
    assert outcome_eq(authorize_text_write(r, ops(), tv, 2, 1), Outcome::Allowed);
}

#[test]
fn test_text_write_gated_by_exposure_before_version() {
    var r: identity::Registry = fixture();
    let tv: TextVersions = new_text_versions();
    r.set_exposed(2, false);
    assert outcome_eq(authorize_text_write(r, ops(), tv, 2, 0), Outcome::NotExposed);
}

// ---- the tiers ---------------------------------------------------------------

#[test]
fn a_protected_node_is_visible_navigable_and_shut() {
    // The shape of the whole feature. An ordinary operator grant sees the card
    // field, can scroll to it, and gets nothing out of it.
    var r: identity::Registry = fixture();
    r.set_tier(2, identity::tier_protected());
    assert outcome_eq(authorize_read(r, ops(), 2), Outcome::Allowed);
    assert outcome_eq(authorize_value_read(r, ops(), 2), Outcome::NeedsGrant);
    assert outcome_eq(authorize_action(r, ops(), 2), Outcome::NeedsGrant);
    assert !r.can_read_value(ops(), 2);
    assert !r.can_act(ops(), 2);
}

#[test]
fn the_grant_the_app_mints_after_the_user_approves_opens_it() {
    // The autofill flow, end to end at the policy layer: the agent is refused
    // with `NeedsGrant`, the app asks the user, mints the wider grant, and the
    // same call now passes.
    var r: identity::Registry = fixture();
    r.set_tier(2, identity::tier_protected());
    let approved: auth::Grant = auth::protected_operator();
    assert outcome_eq(authorize_value_read(r, approved, 2), Outcome::Allowed);
    assert outcome_eq(authorize_action(r, approved, 2), Outcome::Allowed);
    // Read-only approval opens the read and not the write: the app said the
    // agent may SEE the card number, not change one.
    let look_only: auth::Grant = auth::protected_reader();
    assert outcome_eq(authorize_value_read(r, look_only, 2), Outcome::Allowed);
    assert outcome_eq(authorize_action(r, look_only, 2), Outcome::NeedsGrant);
}

#[test]
fn a_private_node_refuses_every_grant_an_app_would_ever_mint() {
    // The CVC. The developer sets the tier and then never mints the bit —
    // so every grant this file hands out as a bundle bounces off it, and the
    // refusal says `Forbidden`: stop, do not ask.
    var r: identity::Registry = fixture();
    r.set_tier(2, identity::tier_private());
    assert outcome_eq(authorize_value_read(r, auth::reader(), 2), Outcome::Forbidden);
    assert outcome_eq(authorize_value_read(r, auth::operator(), 2), Outcome::Forbidden);
    assert outcome_eq(authorize_value_read(r, auth::protected_reader(), 2), Outcome::Forbidden);
    assert outcome_eq(authorize_value_read(r, auth::protected_operator(), 2), Outcome::Forbidden);
    assert outcome_eq(authorize_action(r, auth::protected_operator(), 2), Outcome::Forbidden);
    // Still visible, still navigable — the assistant can tell the user the CVC
    // is the field it cannot fill.
    assert outcome_eq(authorize_read(r, auth::operator(), 2), Outcome::Allowed);
    // And the bit does work, for the app that deliberately types it.
    let deliberate: auth::Grant = auth::protected_operator().with(auth::cap_read_private());
    assert outcome_eq(authorize_value_read(r, deliberate, 2), Outcome::Allowed);
}

#[test]
fn protected_bits_do_not_reach_private_nodes() {
    // The tiers are not a single ladder where the top bit opens everything
    // below it: `act_protected` is about protected nodes and says nothing
    // about private ones. A card-autofill approval must not quietly become CVC
    // access.
    var r: identity::Registry = fixture();
    r.set_tier(1, identity::tier_protected());
    r.set_tier(2, identity::tier_private());
    let approved: auth::Grant = auth::protected_operator();
    assert outcome_eq(authorize_action(r, approved, 1), Outcome::Allowed);
    assert outcome_eq(authorize_action(r, approved, 2), Outcome::Forbidden);
}

#[test]
fn every_read_needs_the_ordinary_read_bit_too() {
    // Monotone within a tier: there is no grant that opens a protected field
    // while being unable to open an ordinary one. A mis-built grant fails
    // closed rather than sideways.
    var r: identity::Registry = fixture();
    r.set_tier(2, identity::tier_protected());
    let lopsided: auth::Grant = auth::nothing().with(auth::cap_read_protected());
    assert outcome_eq(authorize_value_read(r, lopsided, 2), Outcome::NeedsGrant);
    assert outcome_eq(authorize_read(r, lopsided, 1), Outcome::NeedsGrant);
}

#[test]
fn the_tier_inherits_and_the_strictest_wins() {
    // One declaration on the payment box. The CVC inside it is declared
    // Private on its own and stays Private even though the box says Protected
    // — strictest wins, in both directions.
    var r: identity::Registry = identity::new();
    let box_n: usize = r.add_child(r.root(), option::Option[str]::Some("payment"),
                                   identity::Role::Group);
    let card: usize = r.add_child(box_n, option::Option[str]::Some("card"), identity::Role::Input);
    let cvc: usize = r.add_child(box_n, option::Option[str]::Some("cvc"), identity::Role::Input);
    r.set_tier(box_n, identity::tier_protected());
    r.set_tier(cvc, identity::tier_private());
    assert r.tier_of(card) == identity::tier_protected();   // inherited
    assert r.tier_of(cvc) == identity::tier_private();      // its own, stricter
    let approved: auth::Grant = auth::protected_operator();
    assert outcome_eq(authorize_value_read(r, approved, card), Outcome::Allowed);
    assert outcome_eq(authorize_value_read(r, approved, cvc), Outcome::Forbidden);
}

#[test]
fn a_grant_with_no_read_bit_sees_nothing_at_all() {
    let r: identity::Registry = fixture();
    let blind: auth::Grant = auth::nothing();
    assert outcome_eq(authorize_read(r, blind, 1), Outcome::NeedsGrant);
    assert r.describe(blind).count() == 0;
}

#[test]
fn editing_the_tree_is_its_own_capability() {
    // Not implied by anything else. An agent that may click every button and
    // read every field still may not rebuild the interface.
    assert outcome_eq(authorize_tree_edit(auth::protected_operator()), Outcome::Forbidden);
    assert outcome_eq(authorize_tree_edit(auth::operator()), Outcome::Forbidden);
    let builder: auth::Grant = auth::operator().with(auth::cap_edit_tree());
    assert outcome_eq(authorize_tree_edit(builder), Outcome::Allowed);
}

#[test]
fn ask_and_stop_are_different_words() {
    // `NeedsGrant` and `Forbidden` must never compare equal to each other or
    // to anything an agent retries — the whole point is that a model can tell
    // "ask the user" from "give up" without being told in prose.
    assert !outcome_eq(Outcome::NeedsGrant, Outcome::Forbidden);
    assert !outcome_eq(Outcome::NeedsGrant, Outcome::NotActionable);
    assert !outcome_eq(Outcome::NeedsGrant, Outcome::VersionConflict);
    assert !outcome_eq(Outcome::Forbidden, Outcome::NotExposed);
    assert outcome_eq(Outcome::NeedsGrant, Outcome::NeedsGrant);
    assert outcome_eq(Outcome::Forbidden, Outcome::Forbidden);
}

#[test]
fn test_stale_is_its_own_outcome() {
    assert outcome_eq(Outcome::Stale, Outcome::Stale);
    assert !outcome_eq(Outcome::Stale, Outcome::Allowed);
    assert !outcome_eq(Outcome::Stale, Outcome::NotFound);
    assert !outcome_eq(Outcome::Stale, Outcome::VersionConflict);
}
