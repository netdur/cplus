// Linux filesystem-watch primitives — the inotify half of `backend.cplus`.
//
// Picked by C+'s platform override for `import "./backend"` on a Linux target,
// the way `backend.cplus` is on Darwin. Read that file first: it declares the
// seam and this one answers the same five verbs.
//
// ---- inotify is not kqueue, and only one difference reaches the seam ---------
//
// The engine above this file is a SNAPSHOT DIFFER: `poll_one` only has to
// answer "did anything happen, and did we lose events", and `Watcher::poll`
// then rescans the tree and emits the diff. That is what makes inotify a fit
// despite carrying entirely different information — the per-event path, cookie
// and mask it reports are all discarded, and nothing here has to reconstruct a
// rename from two halves.
//
// THE ONE REAL DIFFERENCE IS WHAT A WATCH IS. A kqueue watch is a file
// DESCRIPTOR per path, and closing it removes it; an inotify watch is a
// descriptor-scoped WATCH HANDLE — a small integer that means nothing without
// the instance it came from, and removing it is `inotify_rm_watch(instance,
// wd)`. So the seam grew `unwatch(queue, handle)`, which on Darwin is the
// `close` it always was and here is the two-argument call. `fd_close` stays
// what it says: it closes the QUEUE, which on both platforms is a real fd.
//
// A second difference does NOT reach the seam and is worth naming so nobody
// goes looking for it: inotify is not recursive. Neither is kqueue — the engine
// already registers one watch per directory it scanned and reconciles the set
// after every poll, which is the same work both platforms need.

import "stdlib/option" as option;
import "stdlib/text" as text;
import "stdlib/vec" as vec;
import "stdlib/status" as status;

extern fn lstat(path: *u8, buf: *u8) -> i32;
extern fn close(fd: i32) -> i32;
extern fn read(fd: i32, buf: *u8, count: usize) -> isize;
extern fn inotify_init1(flags: i32) -> i32;
extern fn inotify_add_watch(fd: i32, path: *u8, mask: u32) -> i32;
extern fn inotify_rm_watch(fd: i32, wd: i32) -> i32;
// Darwin publishes errno's address as `__error`; glibc as `__errno_location`.
// Same value, different symbol, and getting it wrong is a link error rather
// than a wrong answer — which is the failure mode to want.
extern fn __errno_location() -> *i32;

enum NodeKind {
    File,
    Directory,
    Symlink,
    Other,
}

struct Metadata {
    kind: NodeKind,
    inode: u64,
    size: i64,
    mtime_sec: i64,
    mtime_nsec: i64,
    mode: u16,
}

enum MetadataResult {
    Found(Metadata),
    Missing,
    PermissionDenied,
    InvalidPath,
    Failed,
}

fn errno_value() -> i32 {
    let p: *i32 = { __errno_location() };
    return { *p };
}

// lstat rather than stat: recursive scans never follow symlinks implicitly.
fn metadata(path: str) -> MetadataResult {
    let owned: text::Text = text::from_str(path);
    match owned.c_str() {
        option::Option[text::CString]::Some(cp) => {
            // x86-64 Linux `struct stat` is 144 bytes — the same SIZE as
            // Darwin's and a completely different LAYOUT. The offsets are the
            // ones `stdlib/fs_sys_linux` already pins against a real header:
            // st_ino at 8, st_mode at 24, st_size at 48, st_mtim at 88.
            //
            // `lstat` is a real exported glibc symbol from 2.33 on; older
            // libraries published only `__lxstat`, and this file would fail to
            // LINK there rather than read the wrong bytes.
            var raw: [u8; 144] = [0 as u8; 144];
            let rc: i32 = { lstat(cp.as_ptr(), #addr_of(raw) as *u8) };
            if rc != (0 as i32) {
                let e: i32 = errno_value();
                if e == (2 as i32) { return MetadataResult::Missing; }            // ENOENT
                if e == (13 as i32) { return MetadataResult::PermissionDenied; }  // EACCES
                return MetadataResult::Failed;
            }
            let base: *u8 = { #addr_of(raw) as *u8 };
            // Linux `mode_t` is a 32-bit unsigned; the file-type bits live in
            // the low half, so the seam's `u16` reads them unchanged on a
            // little-endian target — which x86-64 and aarch64 Linux both are.
            let mode: u16 = { *((base + (24 as usize)) as *u16) };
            let file_type: u16 = mode & (0xF000 as u16);
            var kind: NodeKind = NodeKind::Other;
            if file_type == (0x8000 as u16) { kind = NodeKind::File; }
            if file_type == (0x4000 as u16) { kind = NodeKind::Directory; }
            if file_type == (0xA000 as u16) { kind = NodeKind::Symlink; }
            return MetadataResult::Found(Metadata {
                kind: kind,
                inode: { *((base + (8 as usize)) as *u64) },
                mtime_sec: { *((base + (88 as usize)) as *i64) },
                mtime_nsec: { *((base + (96 as usize)) as *i64) },
                size: { *((base + (48 as usize)) as *i64) },
                mode: mode,
            });
        }
        option::Option[text::CString]::None => { return MetadataResult::InvalidPath; }
    }
}

// IN_NONBLOCK, so `poll_one` can drain to empty without ever blocking the
// owner thread. It is O_NONBLOCK's value and the same bit `stdlib/netsys_linux`
// names for a socket.
fn in_nonblock() -> i32 { return 0x800 as i32; }

fn queue_open() -> i32 {
    return { inotify_init1(in_nonblock()) };
}

fn fd_close(fd: i32) {
    if fd >= (0 as i32) { let _rc: i32 = { close(fd) }; }
    return;
}

// The bits that mean "this path changed", chosen to mirror the kqueue half's
// fflags rather than to be exhaustive: write, metadata, the two halves of a
// rename, creation and removal inside a watched directory, and the two that
// report the watched node ITSELF going away.
//
// IN_DONT_FOLLOW is the mask's counterpart to `lstat` above: a symlink is
// watched as a symlink, not as whatever it points at.
fn watch_mask() -> u32 {
    let events: u32 = (0x2 as u32)    // IN_MODIFY
                    | (0x4 as u32)    // IN_ATTRIB
                    | (0x40 as u32)   // IN_MOVED_FROM
                    | (0x80 as u32)   // IN_MOVED_TO
                    | (0x100 as u32)  // IN_CREATE
                    | (0x200 as u32)  // IN_DELETE
                    | (0x400 as u32)  // IN_DELETE_SELF
                    | (0x800 as u32); // IN_MOVE_SELF
    return events | (0x02000000 as u32);  // IN_DONT_FOLLOW
}

// Register the path with the instance. Answers the WATCH DESCRIPTOR, or -1 —
// the same contract the Darwin half states for its fd, and the reason `unwatch`
// exists: this number is meaningless without `queue`.
fn watch_path(queue: i32, path: str) -> i32 {
    if queue < (0 as i32) { return (0 as i32) -% (1 as i32); }
    let owned: text::Text = text::from_str(path);
    match owned.c_str() {
        option::Option[text::CString]::Some(cp) => {
            let wd: i32 = { inotify_add_watch(queue, cp.as_ptr(), watch_mask()) };
            if wd < (0 as i32) { return (0 as i32) -% (1 as i32); }
            return wd;
        }
        option::Option[text::CString]::None => { return (0 as i32) -% (1 as i32); }
    }
}

// Drop one registration. The Darwin half closes the fd; here the handle is
// scoped to the instance and closing anything would close the wrong thing.
//
// A watch whose file was deleted is removed by the KERNEL — it sends
// IN_IGNORED and forgets the descriptor — so `EINVAL` here is the ordinary
// outcome of unwatching something already gone, not an error worth reporting.
fn unwatch(queue: i32, handle: i32) {
    if queue < (0 as i32) { return; }
    if handle < (0 as i32) { return; }
    let _rc: i32 = { inotify_rm_watch(queue, handle) };
    return;
}

// ---- draining ----------------------------------------------------------------
//
// One `read` per call, and it returns a BATCH: inotify packs as many events as
// fit, each a 16-byte header (`int wd; uint32 mask, cookie, len;`) followed by
// `len` bytes of name. The caller loops until this answers 0, so draining a
// batch per call is the same shape as kqueue's one-event-per-call — it simply
// gets there in fewer trips.
//
// THE BUFFER MUST HOLD ONE WHOLE EVENT or `read` fails with EINVAL and no
// progress is ever made. A name is bounded by NAME_MAX (255), so 4096 clears
// the largest single event by an order of magnitude and holds a few hundred
// ordinary ones.
//
// EVERY EVENT'S WATCH DESCRIPTOR IS APPENDED to `handles` — the number
// `watch_path` handed back, which the engine maps to a path through its own
// table. `backend.cplus` says what that is for and why it is not bookkeeping:
// on a filesystem whose mtime comes from a coarse clock (ext4 here, measured
// at ~1ms), a same-length rewrite inside one granule is INVISIBLE to `stat` —
// same size, same inode, same mtime — and the kernel's event is then the only
// evidence that anything happened.
//
// The whole batch is scanned for IN_Q_OVERFLOW rather than only its first
// event: the kernel appends that record when it had to drop notifications, and
// missing it is exactly the case the engine's rescan-everything answer exists
// for. IN_IGNORED (a watch the kernel dropped because its file went away) is
// carried through like any other event — the rescan sees the removal and
// `reconcile_handles` forgets the registration.
fn poll_events(queue: i32, ref handles: vec::Vec[i32]) -> i32 {
    if queue < (0 as i32) { return (0 as i32) -% (1 as i32); }
    var buf: [u8; 4096] = [0 as u8; 4096];
    let base: *u8 = { #addr_of(buf) as *u8 };
    let n: isize = { read(queue, base, 4096 as usize) };
    if n < (0 as isize) {
        let e: i32 = errno_value();
        // EAGAIN / EWOULDBLOCK — the queue is empty, which is the answer and
        // not a failure. They are the same value (11) on Linux.
        if e == (11 as i32) { return 0 as i32; }
        // EINTR: a signal arrived before any event did. Also empty as far as
        // this call is concerned; the caller polls again on its own interval.
        if e == (4 as i32) { return 0 as i32; }
        return (0 as i32) -% (1 as i32);
    }
    if n == (0 as isize) { return 0 as i32; }

    var off: usize = 0 as usize;
    let total: usize = n as usize;
    var overflow: bool = false;
    // Bounded by the buffer, and every step advances by at least the header —
    // a `len` the kernel never sets to something that would loop.
    while (off +% (16 as usize)) <= total {
        let wd: i32 = { *((base + off) as *i32) };
        let mask: u32 = { *((base + off + (4 as usize)) as *u32) };
        let len: u32 = { *((base + off + (12 as usize)) as *u32) };
        if (mask & (0x4000 as u32)) != (0 as u32) {
            overflow = true;                                        // IN_Q_OVERFLOW
        } else {
            // An overflow record carries wd -1 and names no watch; everything
            // else names the registration the engine can look up.
            let _added: status::Status = handles.append(wd);
        }
        off = off +% (16 as usize) +% (len as usize);
    }
    if overflow { return (0 as i32) -% (2 as i32); }
    return 1 as i32;
}
