// HAND-WRITTEN. Survives `tools/regen.sh`, which only rewrites widgets.cplus.
//
// Same split as vendor/appkit: `appkit.cplus` is generated by cpc-bindgen and
// `appkit_ext.cplus` holds what a generator cannot know. See the repo CLAUDE.md
// — a fix written into a generated file survives exactly until the next regen,
// and that has already cost this project real behaviour once.
//
// What belongs here: anything that needs a JVM-side helper class, a convention,
// or a decision. Plain method wrappers do NOT — regenerate those.

import "jni/jni" as jni;
import "./runtime" as rt;

// Wire a click handler through a JVM-side adapter class.
//
// Not generatable, and this is the reason: Java interfaces cannot be
// implemented from native code, so `setOnClickListener` needs an OBJECT of a
// class that implements `View.OnClickListener` — and no amount of reading
// `android.jar` produces one. The adapter is a decision about how the app is
// packaged, not a fact about the SDK.
//
// Two ways to supply it, both live:
//   * `./listener` ships one INSIDE this package as a precompiled DEX and needs
//     no host Java at all (API 26+).
//   * this function takes the class name, for an app that would rather ship its
//     own next to MainActivity (any API level).
//
// `adapter_class` is the JNI '/'-form name, as a `\0` literal.
fn set_on_click_raw(env: rt::Env, view: jni::jobject, adapter_class: *u8, token: i64) {
    let listener: jni::jobject = env.new_object_1(
        adapter_class,
        #str_ptr("(J)V\0"),
        rt::arg_long(token),
    );
    env.call_void_1(
        view,
        #str_ptr("android/view/View\0"),
        #str_ptr("setOnClickListener\0"),
        #str_ptr("(Landroid/view/View$OnClickListener;)V\0"),
        rt::arg_object(listener),
    );
    env.delete_local_ref(listener);
    return;
}
