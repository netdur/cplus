// android_view runtime: small JNI helpers used by the typed View wrappers.
//
// Native Android entrypoints receive `JNIEnv *` — a pointer to the
// thread-local JNI function-table pointer. JNI functions must be called
// with that same double pointer (ART recovers the thread from it), so
// `Env` stores it as-is and dereferences twice to reach the table.
//
// Naming guideline notes:
//   - the raw `JNIEnv *` handle is hidden behind `_env`; reach it through
//     `raw()` for the rare table call this module does not yet wrap.
//   - JNI class/method descriptors stay raw `*u8` on this surface: JNI's
//     FindClass/GetMethodID/NewStringUTF take NUL-terminated modified UTF-8,
//     and the `#str_ptr("...\0")` literal is the idiom callers already use.
//     A `str`/`Text` overload (with runtime NUL-termination) is deferred so
//     the JNI interop is not redesigned in this slice.

import "jni/jni" as jni;

type Context = jni::jobject;
type Activity = jni::jobject;
type JavaObject = jni::jobject;

struct Env {
    // The JVM/ART owns the env; `Env` only borrows the handle. `opaque`
    // marks it as not-owned so no drop-glue is required.
    opaque _env: *jni::JNIEnv,
}

fn from_native(envp: *jni::JNIEnv) -> Env {
    return Env { _env: envp };
}

// ---- the resolve cache -------------------------------------------------
// MEASURED (plan.android.md rung 1): resolving a class and a method on every
// call cost a clean 2x on a 400-node mount — 21.8 ms against 10.4 ms for the
// same JNI calls with ids held. `method()` is the single door every wrapper in
// this package goes through, so caching here fixes all of them at once and
// changes no call site.
//
// The keys are POINTER IDENTITY on the descriptor strings, not their contents.
// Every call site passes a `#str_ptr("...\0")` literal, which lives in .rodata
// at one fixed address, so the same site always hashes to the same slot and two
// different sites that happen to spell the same class simply get two entries.
// Comparing bytes would be correct too, and slower for no gain.
//
// Never evicted: the set of call sites in a program is finite and small. A full
// table falls back to the old uncached path rather than thrashing.
//
// UI-THREAD ONLY, like everything else here. A JNIEnv is per-thread and
// `FindClass` resolves against the calling thread's classloader; this table
// has no lock and wants none.

const CLS_SLOTS: usize = 64;
const MID_SLOTS: usize = 256;

struct ClassCache { key: [usize; 64], val: [usize; 64] }
struct MethodCache { ka: [usize; 256], kb: [usize; 256], kc: [usize; 256], val: [usize; 256] }

static CLASSES: ClassCache = #zero::[ClassCache]();
static METHODS: MethodCache = #zero::[MethodCache]();
// The static half. Separate table, because GetMethodID and GetStaticMethodID
// search different ones and a class may declare both with the same signature.
static STATIC_METHODS: MethodCache = #zero::[MethodCache]();

fn mix3(a: usize, b: usize, c: usize) -> usize {
    var h: usize = a >> (4 as usize);
    h = h ^ (b >> (3 as usize));
    h = h ^ (c >> (5 as usize));
    h = h ^ (h >> (11 as usize));
    return h & (MID_SLOTS -% (1 as usize));
}

impl Env {
    fn raw(this) -> *jni::JNIEnv {
        return this._env;
    }

    fn version(this) -> jni::jint {
        return { (*(*this._env)).GetVersion(this._env) };
    }

    fn find_class(this, name: *u8) -> jni::jclass {
        return { (*(*this._env)).FindClass(this._env, name) };
    }

    fn method_id(this, cls: jni::jclass, name: *u8, sig: *u8) -> jni::jmethodID {
        return { (*(*this._env)).GetMethodID(this._env, cls, name, sig) };
    }

    // The static counterpart. Unreachable before the interface table's static
    // block was typed (plan.android.md rung 0).
    fn method_id_static(this, cls: jni::jclass, name: *u8, sig: *u8) -> jni::jmethodID {
        return { (*(*this._env)).GetStaticMethodID(this._env, cls, name, sig) };
    }

    fn field_id(this, cls: jni::jclass, name: *u8, sig: *u8) -> jni::jfieldID {
        return { (*(*this._env)).GetFieldID(this._env, cls, name, sig) };
    }

    fn static_field_id(this, cls: jni::jclass, name: *u8, sig: *u8) -> jni::jfieldID {
        return { (*(*this._env)).GetStaticFieldID(this._env, cls, name, sig) };
    }

    fn pending_exception(this) -> jni::jthrowable {
        return { (*(*this._env)).ExceptionOccurred(this._env) };
    }

    fn clear_exception(this) {
        { (*(*this._env)).ExceptionClear(this._env); };
    }

    fn new_global_ref(this, obj: jni::jobject) -> jni::jobject {
        return { (*(*this._env)).NewGlobalRef(this._env, obj) };
    }

    fn delete_global_ref(this, obj: jni::jobject) {
        { (*(*this._env)).DeleteGlobalRef(this._env, obj); };
    }

    fn delete_local_ref(this, obj: jni::jobject) {
        { (*(*this._env)).DeleteLocalRef(this._env, obj); };
    }

    // `utf8` must be NUL-terminated modified UTF-8, matching JNI's
    // NewStringUTF contract. String-literal call sites should include `\0`.
    fn new_string_utf(this, utf8: *u8) -> jni::jstring {
        return { (*(*this._env)).NewStringUTF(this._env, utf8) };
    }

    // Copy a Java String into a caller's buffer as NUL-terminated UTF-8.
    //
    // `GetStringUTFChars` hands back a pointer the JVM owns and may have
    // allocated, so it MUST be released — which is why this takes a buffer and
    // copies rather than returning the pointer and trusting a caller to.
    //
    // The length is asked for FIRST and a string that does not fit is refused
    // outright, the same posture as `paint::cstr`: half a string is a wrong
    // answer that looks like a right one, and a cut in the middle of a
    // codepoint is not even valid UTF-8. `GetStringUTFLength` counts BYTES of
    // modified UTF-8, which is exactly what lands in the buffer.
    fn string_utf_into(this, s: jni::jstring, buf: *u8, cap: usize) -> bool {
        { (*buf) = 0 as u8 };
        if s == { 0 as jni::jstring } { return true; }
        let n: usize = { (*(*this._env)).GetStringUTFLength(this._env, s) } as usize;
        if (n +% (1 as usize)) > cap { return false; }
        let chars: *u8 = { (*(*this._env)).GetStringUTFChars(this._env, s, 0 as *jni::jboolean) };
        if chars == (0 as *u8) { return false; }
        var i: usize = 0 as usize;
        while i < n {
            let d: *u8 = { ({ #addr(buf) } +% i) as *u8 };
            let p: *u8 = { ({ #addr(chars) } +% i) as *u8 };
            { (*d) = (*p) };
            i = i +% (1 as usize);
        }
        { (*(*this._env)).ReleaseStringUTFChars(this._env, s, chars) };
        let term: *u8 = { ({ #addr(buf) } +% n) as *u8 };
        { (*term) = 0 as u8 };
        return true;
    }

    // A class, resolved once and held as a GLOBAL ref — which is also what
    // keeps every jmethodID derived from it valid, since a method id dies with
    // its class.
    fn class_cached(this, class_name: *u8) -> jni::jclass {
        let k: usize = { #addr(class_name) };
        var i: usize = (k >> (4 as usize)) & (CLS_SLOTS -% (1 as usize));
        var probes: usize = 0 as usize;
        while probes < CLS_SLOTS {
            let key: usize = CLASSES.key[i];
            if key == k { return { CLASSES.val[i] as *u8 }; }
            if key == (0 as usize) {
                let local: jni::jclass = this.find_class(class_name);
                let g: jni::jobject = this.retain_local_as_global(local);
                CLASSES.key[i] = k;
                CLASSES.val[i] = { #addr(g) };
                return g;
            }
            i = (i +% (1 as usize)) & (CLS_SLOTS -% (1 as usize));
            probes = probes +% (1 as usize);
        }
        return this.find_class(class_name);
    }

    fn method(this, class_name: *u8, name: *u8, sig: *u8) -> jni::jmethodID {
        let ka: usize = { #addr(class_name) };
        let kb: usize = { #addr(name) };
        let kc: usize = { #addr(sig) };
        var i: usize = mix3(ka, kb, kc);
        var probes: usize = 0 as usize;
        while probes < MID_SLOTS {
            if METHODS.ka[i] == ka {
                if METHODS.kb[i] == kb {
                    if METHODS.kc[i] == kc { return { METHODS.val[i] as *u8 }; }
                }
            }
            if METHODS.ka[i] == (0 as usize) {
                let cls: jni::jclass = this.class_cached(class_name);
                let mid: jni::jmethodID = this.method_id(cls, name, sig);
                METHODS.ka[i] = ka;
                METHODS.kb[i] = kb;
                METHODS.kc[i] = kc;
                METHODS.val[i] = { #addr(mid) };
                return mid;
            }
            i = (i +% (1 as usize)) & (MID_SLOTS -% (1 as usize));
            probes = probes +% (1 as usize);
        }
        // Table full — the old uncached path, still correct.
        let cls2: jni::jclass = this.find_class(class_name);
        let mid2: jni::jmethodID = this.method_id(cls2, name, sig);
        this.delete_local_ref(cls2);
        return mid2;
    }

    // The STATIC half of the cache above, and it must be a separate table.
    //
    // `GetMethodID` and `GetStaticMethodID` search different tables: asking the
    // instance one for a static answers NoSuchMethodError, "no non-static
    // method ...". Worse, that exception stays PENDING — JNI raises rather than
    // returning — so the abort surfaces at whatever JNI call comes next, with a
    // stack pointing at an innocent function. Every generated binding for a
    // static routes here.
    //
    // Sharing one table keyed only on the three strings would be wrong for the
    // same reason a shared lookup is: a class may declare a static and an
    // instance method with the SAME name and descriptor, and the two ids are
    // different.
    fn method_static(this, class_name: *u8, name: *u8, sig: *u8) -> jni::jmethodID {
        let ka: usize = { #addr(class_name) };
        let kb: usize = { #addr(name) };
        let kc: usize = { #addr(sig) };
        var i: usize = mix3(ka, kb, kc);
        var probes: usize = 0 as usize;
        while probes < MID_SLOTS {
            if STATIC_METHODS.ka[i] == ka {
                if STATIC_METHODS.kb[i] == kb {
                    if STATIC_METHODS.kc[i] == kc { return { STATIC_METHODS.val[i] as *u8 }; }
                }
            }
            if STATIC_METHODS.ka[i] == (0 as usize) {
                let cls: jni::jclass = this.class_cached(class_name);
                let mid: jni::jmethodID = this.method_id_static(cls, name, sig);
                STATIC_METHODS.ka[i] = ka;
                STATIC_METHODS.kb[i] = kb;
                STATIC_METHODS.kc[i] = kc;
                STATIC_METHODS.val[i] = { #addr(mid) };
                return mid;
            }
            i = (i +% (1 as usize)) & (MID_SLOTS -% (1 as usize));
            probes = probes +% (1 as usize);
        }
        let cls2: jni::jclass = this.find_class(class_name);
        let mid2: jni::jmethodID = this.method_id_static(cls2, name, sig);
        this.delete_local_ref(cls2);
        return mid2;
    }

    fn new_object_0(this, class_name: *u8, ctor_sig: *u8) -> jni::jobject {
        let cls: jni::jclass = this.class_cached(class_name);
        let ctor: jni::jmethodID = this.method(class_name, #str_ptr("<init>\0"), ctor_sig);
        return {
            (*(*this._env)).NewObjectA(this._env, cls, ctor, 0 as *jni::JValue)
        };
    }

    fn new_object_1(this, class_name: *u8, ctor_sig: *u8, arg0: jni::JValue) -> jni::jobject {
        let cls: jni::jclass = this.class_cached(class_name);
        let ctor: jni::jmethodID = this.method(class_name, #str_ptr("<init>\0"), ctor_sig);
        var args: [jni::JValue; 1] = [arg0];
        return {
            (*(*this._env)).NewObjectA(this._env, cls, ctor, #addr_of(args[0]))
        };
    }

    fn call_void_0(this, obj: jni::jobject, class_name: *u8, name: *u8, sig: *u8) {
        let mid: jni::jmethodID = this.method(class_name, name, sig);
        { (*(*this._env)).CallVoidMethodA(this._env, obj, mid, 0 as *jni::JValue); };
    }

    fn call_void_1(this, obj: jni::jobject, class_name: *u8, name: *u8, sig: *u8, arg0: jni::JValue) {
        let mid: jni::jmethodID = this.method(class_name, name, sig);
        var args: [jni::JValue; 1] = [arg0];
        { (*(*this._env)).CallVoidMethodA(this._env, obj, mid, #addr_of(args[0])); };
    }

    fn call_void_2(
        this,
        obj: jni::jobject,
        class_name: *u8,
        name: *u8,
        sig: *u8,
        arg0: jni::JValue,
        arg1: jni::JValue,
    ) {
        let mid: jni::jmethodID = this.method(class_name, name, sig);
        var args: [jni::JValue; 2] = [arg0, arg1];
        { (*(*this._env)).CallVoidMethodA(this._env, obj, mid, #addr_of(args[0])); };
    }

    fn call_object_0(this, obj: jni::jobject, class_name: *u8, name: *u8, sig: *u8) -> jni::jobject {
        let mid: jni::jmethodID = this.method(class_name, name, sig);
        return { (*(*this._env)).CallObjectMethodA(this._env, obj, mid, 0 as *jni::JValue) };
    }

    fn call_object_1(this, obj: jni::jobject, class_name: *u8, name: *u8, sig: *u8, arg0: jni::JValue) -> jni::jobject {
        let mid: jni::jmethodID = this.method(class_name, name, sig);
        var args: [jni::JValue; 1] = [arg0];
        return {
            (*(*this._env)).CallObjectMethodA(this._env, obj, mid, #addr_of(args[0]))
        };
    }

    // A pending JVM exception reads as an assertion, not a raw 0/1 sentinel.
    fn has_pending_exception(this) -> bool {
        return { (*(*this._env)).ExceptionCheck(this._env) } as i8 != 0;
    }

    fn retain_local_as_global(this, local: jni::jobject) -> jni::jobject {
        let global: jni::jobject = this.new_global_ref(local);
        this.delete_local_ref(local);
        return global;
    }
}

fn arg_object(obj: jni::jobject) -> jni::JValue {
    return jni::arg_object(obj);
}

fn arg_int(v: i32) -> jni::JValue {
    return jni::arg_int(v as jni::jint);
}

// Booleans on the public surface read as `true`/`false`; the JNI `jboolean`
// (u8) encoding is applied here at the boundary.
fn arg_bool(v: bool) -> jni::JValue {
    var bits: jni::jboolean = 0 as jni::jboolean;
    if v {
        bits = 1 as jni::jboolean;
    }
    return jni::arg_bool(bits);
}

fn arg_long(v: i64) -> jni::JValue {
    return jni::arg_long(v as jni::jlong);
}

// The cache's index maths is pure and testable without a JVM; the lookup
// itself needs one and is proved on-device by the rung-1 bench.

#[test]
fn mix3_stays_inside_the_table() {
    // Every index must land in [0, MID_SLOTS) or the probe loop walks off the
    // arrays. Includes the degenerate all-zero key and a high-bit address.
    assert mix3(0 as usize, 0 as usize, 0 as usize) < MID_SLOTS;
    assert mix3(1 as usize, 2 as usize, 3 as usize) < MID_SLOTS;
    let high: usize = { 18446744073709551615u64 as usize };
    assert mix3(high, high, high) < MID_SLOTS;
    return;
}

#[test]
fn mix3_is_deterministic() {
    // The same call site must hash to the same slot every time, or the cache
    // would miss forever and silently do nothing but cost memory.
    let a: usize = 140737488355328 as usize;
    let b: usize = 140737488355360 as usize;
    let c: usize = 140737488355400 as usize;
    assert mix3(a, b, c) == mix3(a, b, c);
    return;
}

#[test]
fn mix3_separates_sites_that_share_two_keys() {
    // Negative case: two methods of the SAME class differing only in name must
    // not collapse to one index, or `setText` would return `setTextSize`'s id.
    // (A collision would still be CORRECT — the probe compares all three keys —
    // but it would cost a probe on every lookup.)
    let cls: usize = 140737488355328 as usize;
    let sig: usize = 140737488355600 as usize;
    let n1: usize = 140737488355360 as usize;
    let n2: usize = 140737488355392 as usize;
    assert mix3(cls, n1, sig) != mix3(cls, n2, sig);
    return;
}

// Host-runnable tests for the pure arg-encoding boundary (no JVM needed):
// these exercise the `bool`/i32/i64 -> JValue word conversions only.

#[test]
fn arg_bool_true_sets_low_byte_one() {
    assert arg_bool(true).bits() == 1 as jni::jlong;
    return;
}

#[test]
fn arg_bool_false_is_zero_word() {
    assert arg_bool(false).bits() == 0 as jni::jlong;
    return;
}

#[test]
fn arg_int_sign_extends_into_word() {
    assert arg_int(-1 as i32).bits() == -1 as jni::jlong;
    assert arg_int(42 as i32).bits() == 42 as jni::jlong;
    return;
}

#[test]
fn arg_long_round_trips() {
    assert arg_long(9223372036854775807 as i64).bits() == 9223372036854775807 as jni::jlong;
    return;
}
