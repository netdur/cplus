// Umbrella module for the Android View bindings.
//
//   runtime.cplus            hand-written: Env, the JNI helpers, the resolve cache
//   widgets.cplus            GENERATED by tools/regen.sh — do not edit
//   android_view_ext.cplus   hand-written: what a generator cannot know
//   activity.cplus           hand-written: the Activity handoff
//   listener.cplus           hand-written: the package-shipped DEX click adapter
//
// The generated half carries the whole declared surface of each class it names;
// this file re-exports the types so a consumer can `import "android_view/android_view"`
// and reach them by their short names.

import "jni/jni" as jni;
import "./runtime" as runtime;
import "./activity" as activity;
import "./widgets" as widgets;
import "./android_view_ext" as ext;

type Env = runtime::Env;
type Context = runtime::Context;
type Activity = activity::Activity;

type View = widgets::View;
type ViewGroup = widgets::ViewGroup;
type TextView = widgets::TextView;
type Button = widgets::Button;
type EditText = widgets::EditText;
type ImageView = widgets::ImageView;
type ProgressBar = widgets::ProgressBar;

fn from_native(envp: *jni::JNIEnv) -> runtime::Env {
    return runtime::from_native(envp);
}

fn set_on_click_raw(env: runtime::Env, v: jni::jobject, adapter_class: *u8, token: i64) {
    ext::set_on_click_raw(env, v, adapter_class, token);
    return;
}

fn arg_object(obj: jni::jobject) -> jni::JValue { return runtime::arg_object(obj); }
fn arg_int(v: i32) -> jni::JValue { return runtime::arg_int(v); }
fn arg_long(v: i64) -> jni::JValue { return runtime::arg_long(v); }
