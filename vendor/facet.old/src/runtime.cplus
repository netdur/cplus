// facet runtime facade — the NEUTRAL base.
//
// Each supported platform shadows this file through the resolver's platform
// override (`runtime_<platform>.cplus` next to this one): macOS resolves to
// runtime_macos.cplus over facet_appkit, Linux to runtime_linux.cplus over
// facet_gtk. A target with no override lands HERE, which means one thing: no
// facet backend exists for that platform yet.
//
// The base keeps the facade's full surface so app code type-checks on every
// target, and every entry point FAILS LOUDLY — an eprintln plus an error
// status — instead of resolving silently to some other platform's toolkit and
// breaking somewhere downstream. (This base used to BE the macOS runtime, so
// a Windows build got AppKit imports and failed mid-compile with no hint the
// real problem was "no backend for windows".)
//
// Porting facet to a new platform starts by copying runtime_linux.cplus, not
// this file: the shape of a real facade is one import line away from its
// backend package.

import "./facet" as core;
import "stdlib/option" as option;
import "stdlib/text" as text;
import "stdlib/vec" as vec;
import "stdlib/status" as status;
import "stdlib/io" as io;

type Node = core::Node;
type Builder = core::Builder;
type AppMenu = core::AppMenu;
type MenuItem = core::MenuItem;
type Chrome = core::Chrome;
type ScreenBox = core::ScreenBox;

// One loud line per entry point that would otherwise render something.
fn no_backend(entry: str) {
    io::eprintln(text::from_str("facet: no backend for this target platform — ").appending(entry).appending(" is a no-op. Add a runtime_<platform>.cplus facade over a facet_<toolkit> backend (see runtime_linux.cplus for the shape).").view());
    return;
}

interface Window {
    fn root(ref this) -> Node;
    fn title(this) -> str;
    fn width(this) -> f64;
    fn height(this) -> f64;
    fn wants_clean_titlebar(this) -> bool;
    fn wants_close_button_only(this) -> bool;
    fn wants_unified_toolbar(this) -> bool;
    fn wants_hidden_title(this) -> bool;
    fn wants_custom_chrome(this) -> bool;
    fn wants_native_buttons(this) -> bool;
    fn min_width(this) -> f64;
    fn min_height(this) -> f64;
    fn wants_pinch_zoom(this) -> bool;
    fn min_zoom(this) -> f64;
    fn max_zoom(this) -> f64;
    fn has_app_menu(this) -> bool;
    fn app_menu(ref this) -> AppMenu;
    fn should_close(this) -> bool;
    fn will_close(this);
    fn should_close_callback(this) -> fn(*u8) -> bool;
    fn will_close_callback(this) -> fn(*u8);
    fn lifecycle_context(this) -> *u8;
    fn component_context(this) -> *u8;
}

fn label(s: str, size: f64 = 0.0f64, bold: bool = false, secondary: bool = false) -> Node {
    return core::label(s, size: size, bold: bold, secondary: secondary);
}

fn app_menu(title: str) -> AppMenu { return core::app_menu(title); }
fn menu_action_none() -> u32 { return core::menu_action_none(); }
fn menu_action_quit() -> u32 { return core::menu_action_quit(); }
fn menu_action_close_window() -> u32 { return core::menu_action_close_window(); }
fn menu_action_undo() -> u32 { return core::menu_action_undo(); }
fn menu_action_redo() -> u32 { return core::menu_action_redo(); }
fn menu_action_cut() -> u32 { return core::menu_action_cut(); }
fn menu_action_copy() -> u32 { return core::menu_action_copy(); }
fn menu_action_paste() -> u32 { return core::menu_action_paste(); }
fn menu_action_select_all() -> u32 { return core::menu_action_select_all(); }
fn menu_action_find() -> u32 { return core::menu_action_find(); }
fn menu_action_find_next() -> u32 { return core::menu_action_find_next(); }
fn menu_action_find_previous() -> u32 { return core::menu_action_find_previous(); }
fn menu_action_find_replace() -> u32 { return core::menu_action_find_replace(); }
fn null_fn() -> fn(*u8, *u8) { return core::null_fn(); }
fn null_enabled_fn() -> fn(*u8) -> bool { return core::null_enabled_fn(); }
fn null_title_fn() -> fn(*u8) -> text::Text { return core::null_title_fn(); }

fn run[W: Window](take window: W) {
    var owned_window: W = window;
    no_backend("run");
    return;
}

fn run_component[C: core::Component + core::Lifecycle](
    take component: C,
    title: str = "facet",
    width: f64 = 480.0f64,
    height: f64 = 360.0f64,
    take menu: AppMenu = core::empty_app_menu(),
) -> C {
    var owned: C = component;
    no_backend("run_component");
    return owned;
}

fn run_screen[S: core::Component + core::Lifecycle + core::Screen](
    take screen: S,
    take menu: AppMenu = core::empty_app_menu(),
) -> S {
    var owned: S = screen;
    no_backend("run_screen");
    return owned;
}

fn alert(title: str, message: str, primary: str, secondary: str = "") -> i32 {
    no_backend("alert");
    return -1;
}

fn choose_directory() -> option::Option[text::Text] {
    no_backend("choose_directory");
    return option::Option[text::Text]::None;
}

fn choose_file() -> option::Option[text::Text] {
    no_backend("choose_file");
    return option::Option[text::Text]::None;
}

fn present_window(take root: Node, title: str, width: f64, height: f64) {
    no_backend("present_window");
    return;
}

fn window_close(sender: *u8) { return; }
fn window_minimize(sender: *u8) { return; }
fn window_zoom(sender: *u8) { return; }

// Window focus/blur (parity with the macOS facade): inert handles here.
fn observe_window_active(cb: fn(*u8), ctx: *u8 = 0 as *u8) -> core::Cancellable {
    return core::Cancellable::none();
}
fn observe_window_inactive(cb: fn(*u8), ctx: *u8 = 0 as *u8) -> core::Cancellable {
    return core::Cancellable::none();
}

// Window geometry: nothing is up, so reads are zero and writes are no-ops.
fn window_frame() -> core::Rect {
    return core::Rect { x: 0.0f64, y: 0.0f64, width: 0.0f64, height: 0.0f64 };
}
fn set_window_frame(frame: core::Rect) { return; }

// ---- App (parity surface; run() refuses loudly) -----------------------------

struct AppRoute {
    name: text::Text,
    factory: fn() -> core::ScreenBox,
}

fn app_hook_noop(ctx: *u8) { return; }

struct App {
    name_text: text::Text,
    menu_fn: fn() -> AppMenu,
    on_launch_fn: fn(*u8),
    on_quit_fn: fn(*u8),
    opaque hook_ctx: *u8,
    agent_path: text::Text,
    routes: vec::Vec[AppRoute],
}

impl App {
    fn new(name: str = "facet") -> App {
        return App {
            name_text: text::from_str(name),
            menu_fn: 0 as fn() -> AppMenu,
            on_launch_fn: app_hook_noop,
            on_quit_fn: app_hook_noop,
            hook_ctx: 0 as *u8,
            agent_path: text::new(),
            routes: vec::new::[AppRoute](),
        };
    }

    fn name(this) -> str { return this.name_text.view(); }

    fn menu(ref this, build: fn() -> AppMenu) {
        this.menu_fn = build;
        return;
    }

    fn screen(ref this, name: str, factory: fn() -> core::ScreenBox) {
        this.routes.append(AppRoute { name: text::from_str(name), factory: factory });
        return;
    }

    fn agent_mcp(ref this, path: str) {
        this.agent_path = text::from_str(path);
        return;
    }

    fn on_launch(ref this, f: fn(*u8), ctx: *u8 = 0 as *u8) {
        this.on_launch_fn = f;
        this.hook_ctx = ctx;
        return;
    }

    fn on_quit(ref this, f: fn(*u8)) {
        this.on_quit_fn = f;
        return;
    }

    fn route_factory(this, route: str) -> fn() -> core::ScreenBox {
        var i: usize = 0 as usize;
        let n: usize = this.routes.count();
        while i < n {
            match this.routes.at_ptr(i) {
                option::Option[*AppRoute]::Some(rp) => {
                    if { (*rp).name.view() } == route {
                        return { (*rp).factory };
                    }
                }
                option::Option[*AppRoute]::None => { }
            }
            i = i +% (1 as usize);
        }
        return 0 as fn() -> core::ScreenBox;
    }

    // No backend: nothing can be shown. Says so and returns the error instead
    // of degrading to an invisible app.
    fn run(ref this, initial: str, arg: str = "") -> status::Status {
        no_backend("App::run");
        return status::Status::InvalidInput;
    }
}

// ---- app context (parity with the real facades) -----------------------------

static RUNNING_APP: *u8 = #zero::[*u8]();

fn app_running() -> bool { return RUNNING_APP != (0 as *u8); }

fn app_name() -> str {
    if RUNNING_APP == (0 as *u8) { return ""; }
    let ap: *App = RUNNING_APP as *App;
    return { (*ap).name() };
}

fn has_screen(route: str) -> bool {
    if RUNNING_APP == (0 as *u8) { return false; }
    let ap: *App = RUNNING_APP as *App;
    let f: fn() -> core::ScreenBox = { (*ap).route_factory(route) };
    return f != (0 as fn() -> core::ScreenBox);
}

fn register_screen(route: str, factory: fn() -> core::ScreenBox) -> bool {
    if RUNNING_APP == (0 as *u8) { return false; }
    if has_screen(route) { return false; }
    let ap: *App = RUNNING_APP as *App;
    { (*ap).screen(route, factory) };
    return true;
}

// ---- agent hookup (parity: registered by facet/agent, fired by nothing) -----

static AGENT_ATTACH_FN: fn(*u8) = #zero::[fn(*u8)]();
static AGENT_SERVE_FN: fn(str) = #zero::[fn(str)]();

fn set_agent_attach_fn(f: fn(*u8)) { AGENT_ATTACH_FN = f; return; }
fn set_agent_serve_fn(f: fn(str)) { AGENT_SERVE_FN = f; return; }

fn agent_attach_window(win: *u8) {
    let f: fn(*u8) = AGENT_ATTACH_FN;
    if f != (0 as fn(*u8)) { f(win); }
    return;
}

fn agent_serve_once(path: str) {
    let f: fn(str) = AGENT_SERVE_FN;
    if f != (0 as fn(str)) { f(path); }
    return;
}
