// async_compute — chained `async fn` + `await`, driven from an
// `async fn main`.
//
// v0.0.3 Phase 5 Slice 5E reference recipe. Demonstrates the
// async/await surface end to end:
//   - `async fn` declares a coroutine returning `T`; the call-site
//     type is `Future[T]`.
//   - `await EXPR` drives an inner future to completion and yields
//     the inner T.
//   - `async fn main` (v0.0.31): the compiler drives the entry with
//     the same loop `Future::wait` is — resume until done, then
//     read the value. `f.wait()` is that loop for driving a future from
//     other synchronous code (a handler, a worker); not needed here.
//
// No I/O in this recipe — every `await` completes without a real
// suspension. `async_fetch` is the one that parks on the reactor, and
// `async_yield_demo` the one that interleaves tasks.
//
// Use this recipe as the syntactic and type-system reference for
// async/await.

import "stdlib/future" as future;

// Innermost coroutine: just produces a value.
async fn step_one() -> i64 {
    return 100 as i64;
}

// Awaits step_one, adds to its own constant.
async fn step_two() -> i64 {
    let x: i64 = await step_one();
    return x +% (200 as i64);
}

// Three-level chain — exercises chained await propagation.
async fn step_three() -> i64 {
    let y: i64 = await step_two();
    return y +% (300 as i64);
}

async fn main() -> i32 {
    let total: i64 = await step_three();
    // 100 + 200 + 300 = 600
    let expected: i64 = 600 as i64;
    if total != expected { return 1; }
    return 0;
}
