/target
**/target/
a.out

# Prebuilt package slices — the WHOLE lib/ directory is build output
# (2026-08-17): `lib/<triple>/lib<name>.a` + fingerprint AND the generated
# `lib/include/` headers are all recreated by the prebuild pass whenever the
# fingerprint (source + triple + mode + compiler version) mismatches. A
# missing lib/ just means the package compiles from source; a fresh clone
# needs nothing here. Author-SHIPPED binaries (`[link].bundled`) would be
# tracked deliberately via `git add -f` — no package does this today.
/vendor/*/lib/

/proves

# Local backup of vendored sources (not tracked)
/vendor_backup/

# Per-user Claude Code local state
/.claude/
.DS_Store

# Scratch planning notes (local, untracked)
/plans/
/bugs/
/tasks.md
/refac.txt
/mem.md

# Local clippy scratch output
/cplus-core/clippy.json
/cplus-core/clippy_output.txt

# Local probe apps (UI feel, repros). Not committed.
playground

# Local build wiring: a package's `vendor/` symlink into the repo's own
# vendor tree, so `cpc build` resolves imports without a copy. Machine-local.
/examples/*/vendor
/examples/**/ios/build
# NOTE deliberately removed (2026-08-17): /vendor/stdlib/stdlib — the broken
# self-symlink was deleted, and hiding the path meant a recreated one never
# showed in `git status`. If it reappears, something recreates it: find out.


# Python bytecode from tools/ scripts (gen_contract.py, parity.py, ...). A
# .pyc was committed on the facet_gtk branch (2026-08-25); the interpreter
# writes these beside any script you run in-tree.
__pycache__/
*.pyc

# The Android build's staging directory: unpacked APK, dex, .so, signed output.
# `build.sh` recreates it from scratch on every run.
/examples/*/out/
