// Reference: tree
//   var root = TreeNode::new("", "root", is_branch: true);
//   root.add_child(TreeNode::new("Leaf", id: "a"));
//   ui::tree(root, key: "t", on_select: this.on_select, row_height: 26.0)

import "facet/facet" as core;
import "facet/elements" as ui;
import "facet/component" as component;
import "facet/tree" as tree;
import "facet/label" as label;
import "facet/vocabulary" as vocab;
import "stdlib/option" as option;
import "stdlib/status" as status;
import "../shell" as shell;

struct Trees {
    n: i32,
}

impl Trees {
    fn new() -> Trees { return Trees { n: 0 }; }

    fn on_select(ref this, node: *tree::TreeNode) {
        if node == (0 as *tree::TreeNode) { return; }
        let id: str = { (*node).id_of() };
        let name: str = { (*node).label_of() };
        match label::find("tr:status") {
            option::Option[label::Label]::Some(l) => {
                let _l: label::Label = l.set_text("selected: ${name}  (id=${id})");
            }
            option::Option[label::Label]::None => { }
        }
        return;
    }
}

fn sample_tree() -> tree::TreeNode {
    var root: tree::TreeNode = tree::TreeNode::new("", id: "root", is_branch: true);

    var animals: tree::TreeNode = tree::TreeNode::new("Animals", id: "animals", is_branch: true);
    let _a1: status::Status = animals.add_child(tree::TreeNode::new("Cat", id: "cat"));
    let _a2: status::Status = animals.add_child(tree::TreeNode::new("Dog", id: "dog"));
    let _a3: status::Status = animals.add_child(tree::TreeNode::new("Bird", id: "bird"));
    let _ar: status::Status = root.add_child(animals);

    var colors: tree::TreeNode = tree::TreeNode::new("Colors", id: "colors", is_branch: true);
    let _c1: status::Status = colors.add_child(tree::TreeNode::new("Red", id: "red"));
    let _c2: status::Status = colors.add_child(tree::TreeNode::new("Green", id: "green"));
    let _c3: status::Status = colors.add_child(tree::TreeNode::new("Blue", id: "blue"));
    let _cr: status::Status = root.add_child(colors);

    return root;
}

impl Trees: component::Component {
    fn build(ref this) -> core::Node {
        var body: core::Builder = core::Builder::new();
        body.add(shell::caption("tree  ·  hierarchical outline"));
        body.add(ui::label(
            "Ids must be stable content keys (never row indices). Branches may be empty for lazy load. The gallery sidebar is this control.",
            key: "tr:note",
            font_size: 13.0f64,
            text_color: vocab::Color::ink(0.65f64),
            max_lines: 4 as i64,
            line_break: vocab::LineBreak::WordWrap,
        ));
        body.add(ui::tree(
            sample_tree(),
            key: "tr:demo",
            on_select: this.on_select,
            row_height: 26.0f64,
        ).height(220.0f64).grow(1.0f64));
        body.add(ui::label("selected: (none)", key: "tr:status",
            font_size: 13.0f64, text_color: vocab::Color::ink(0.7f64)));

        return shell::panel(
            "Tree",
            "Outline with expand/collapse, selection, and stable identities. Default row draws TreeNode.label.",
            core::column(body).gap(12.0f64),
            howto: "var root = TreeNode::new(\"\", \"root\", is_branch: true);\nroot.add_child(TreeNode::new(\"Leaf\", id: \"a\"));\nui::tree(root, key: \"t\", on_select: this.on_select)\n// later: tree::find(\"t\").expand(\"branch\").select(\"a\")",
        );
    }
}

impl Trees: component::Lifecycle {
    fn on_attach(ref this) {
        match tree::find("tr:demo") {
            option::Option[tree::Tree]::Some(t) => {
                let _a: tree::Tree = t.expand("animals");
                let _b: tree::Tree = t.expand("colors");
            }
            option::Option[tree::Tree]::None => { }
        }
        return;
    }
    fn on_detach(ref this) { return; }
}
