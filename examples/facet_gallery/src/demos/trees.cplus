// Reference: tree
//   var root = TreeNode::new("", "root", is_branch: true);
//   root.add_child(TreeNode::new("Leaf", id: "a"));
//   ui::tree(root, key: "t", on_select: this.on_select, row_height: 26)

import "facet/facet" as core;
import "facet/elements" as ui;
import "facet/component" as component;
import "facet/tree" as tree;
import "facet/label" as label;
import "facet/props" as props;
import "stdlib/text" as text;
import "facet/vocabulary" as vocab;
import "stdlib/option" as option;
import "stdlib/status" as status;
import "../shell" as shell;

struct Trees {
    n: i32, custom: bool, generation: i32,
}

// The legacy tree binder takes its context before the retained row.
fn bind_row(model: *tree::TreeNode,ctx: *u8,row: *core::Node) {
    let owner=ctx as *Trees;
    if let option::Option::Some(child)=core::child_of(row,0) {
        let p=(*core::node_data(child)).props as *props::LabelProps;
        (*p).text=text::from_str("${(*model).label} · ${(*owner).generation}");core::touch(child,label::P_TEXT);
    }
}
impl Trees {
    fn new() -> Trees { return Trees { n: 0, custom: false, generation: 0 }; }

    fn toggle_rows(ref this,sender: *u8) {
        this.custom=!this.custom;this.n=if this.custom {1} else {0};
        if let option::Option::Some(l)=label::find("tr:rows") {if this.custom {let updated=l.set_text("Rows: 44 DIP");} else {let updated=l.set_text("Rows: 26 DIP");}}
        if let option::Option::Some(t)=tree::find("tr:demo") {
            if this.custom {let updated=t.set_row(this.row).set_row_bind(bind_row,ctx:#addr_of(this) as *u8).set_row_height(44);}
            else {let updated=t.set_row(tree::no_row).set_row_height(26);}
        }
    }
    fn rebind(ref this,sender: *u8) {
        this.generation=this.generation+1;
        if let option::Option::Some(t)=tree::find("tr:demo") {let updated=t.set_row_bind(bind_row,ctx:#addr_of(this) as *u8);}
    }
    fn row_id(ref this,model: *tree::TreeNode) -> text::Text {return text::from_str("tr:item:${(*model).id}");}
    fn row(ref this,model: *tree::TreeNode) -> core::Node {
        let id=(*model).id.view();
        return @ui {row {label("",key:"tr:label:${id}").width(150.0f64) text_field("Draft",key:"tr:edit:${id}").width(160.0f64) button("Use",key:"tr:use:${id}",on_click:this.use_row)}.gap(8.0f64)};
    }
    fn use_row(ref this,sender: *u8) {
        let model=component::item_of(sender) as *tree::TreeNode;if model.is_null() {return;}
        if let option::Option::Some(l)=label::find("tr:status") {let updated=l.set_text("used: ${(*model).label}  (id=${(*model).id})");}
    }

    fn resize_rows(ref this, sender: *u8) {
        this.n=(this.n+1)%3;let height: i64=if this.n==1 {44i64} else if this.n==2 {0i64} else {26i64};
        if let option::Option::Some(t)=tree::find("tr:demo") {let updated=t.set_row_height(height);}
        if let option::Option::Some(l)=label::find("tr:rows") {if height==0 {let updated=l.set_text("Rows: native default");} else {let updated=l.set_text("Rows: ${height} DIP");}}
    }

    fn on_select(ref this, node: *tree::TreeNode) {
        if node.is_null() { return; }
        let id: str = { (*node).id_of() };
        let name: str = { (*node).label_of() };
        match label::find("tr:status") {
            option::Option[label::Label]::Some(l) => {
                let _l: label::Label = l.set_text("selected: ${name}  (id=${id})");
            }
            option::Option::None => { }
        }
    }
}

fn sample_tree() -> tree::TreeNode {
    var root: tree::TreeNode = tree::TreeNode::new("", id: "root", is_branch: true);

    var animals: tree::TreeNode = tree::TreeNode::new("Animals", id: "animals", is_branch: true);
    let _a1: status::Status = animals.add_child(tree::TreeNode::new("Cat", id: "cat"));
    let _a2: status::Status = animals.add_child(tree::TreeNode::new("Dog", id: "dog"));
    let _a3: status::Status = animals.add_child(tree::TreeNode::new("Bird", id: "bird"));
    let _ar: status::Status = root.add_child(animals);

    var colors: tree::TreeNode = tree::TreeNode::new("Colors", id: "colors", is_branch: true);
    let _c1: status::Status = colors.add_child(tree::TreeNode::new("Red", id: "red"));
    let _c2: status::Status = colors.add_child(tree::TreeNode::new("Green", id: "green"));
    let _c3: status::Status = colors.add_child(tree::TreeNode::new("Blue", id: "blue"));
    let _cr: status::Status = root.add_child(colors);

    return root;
}

impl Trees: component::Component {
    fn build(ref this) -> core::Node {
        this.n=0;this.custom=false;this.generation=0;
        var body: core::Builder = core::Builder::new();
        body.add(shell::caption("tree  ·  hierarchical outline"));
        body.add(ui::label(
            "Ids must be stable content keys (never row indices). Branches may be empty for lazy load. The gallery sidebar is this control.",
            key: "tr:note",
            font_size: 13.0,
            text_color: vocab::Color::ink(0.65),
            max_lines: 4,
            line_break: vocab::LineBreak::WordWrap,
        ));
        body.add(ui::tree(
            sample_tree(),
            key: "tr:demo",
            on_select: this.on_select,
            row_id: this.row_id,
            row_height: 26,
        ).height(220.0).grow(1.0));
        body.add(@ui {row {button("Change row height",key:"tr:resize",on_click:this.resize_rows) label("Rows: 26 DIP",key:"tr:rows")}.gap(12.0f64)});
        body.add(@ui {row {button("Toggle custom rows",key:"tr:custom",on_click:this.toggle_rows) button("Rebind labels",key:"tr:rebind",on_click:this.rebind)}.gap(12.0f64)});
        body.add(ui::label("selected: (none)", key: "tr:status",
            font_size: 13.0, text_color: vocab::Color::ink(0.7)));

        return shell::panel(
            "Tree",
            "Outline with expand/collapse, selection, and stable identities. Default row draws TreeNode.label.",
            core::column(body).gap(12.0),
            howto: "var root = TreeNode::new(\"\", \"root\", is_branch: true);\nroot.add_child(TreeNode::new(\"Leaf\", id: \"a\"));\nui::tree(root, key: \"t\", on_select: this.on_select)\n// later: tree::find(\"t\").expand(\"branch\").select(\"a\")",
        );
    }
}

impl Trees: component::Lifecycle {
    fn on_attach(ref this, why: component::Attach) {
        if why != component::Attach::Mount { return; }
        match tree::find("tr:demo") {
            option::Option[tree::Tree]::Some(t) => {
                let _a: tree::Tree = t.expand("animals");
                let _b: tree::Tree = t.expand("colors");
            }
            option::Option::None => { }
        }
    }
    fn on_detach(ref this, why: component::Detach) {
        if why != component::Detach::Unmount { return; } return; }
}
