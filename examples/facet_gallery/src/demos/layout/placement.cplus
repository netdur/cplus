// Reference: taking a node OUT of the flow, and bounding it inside it
//   core::set_absolute(n, true)                — out of flow, positioned on its parent
//   core::set_left/top/right/bottom(n, pt)     — and the _percent forms
//   core::set_aspect_ratio(n, 16.0 / 9.0)      — height from width
//   core::set_min_width / max_width / min_height / max_height
//   core::set_box_sizing(n, flex::BoxSizing::BorderBox)
//   core::set_overflow(n, flex::Overflow::Hidden)

import "facet/facet" as core;
import "facet/elements" as ui;
import "facet/component" as component;
import "facet/mount" as mount;
import "facet/vocabulary" as vocab;
import "flex_layout/flex_layout" as flex;
import "../../shell" as shell;

const BADGE: str = "pl:badge";
const BOUNDED: str = "pl:bounded";

struct Placement {
    corner: i32,
    wide: bool,
}

impl Placement {
    fn new() -> Placement { return Placement { corner: 0, wide: false }; }

    // An absolute child is positioned against its PARENT's box, and the edges
    // it names decide which corner it hangs from. Naming both edges of an axis
    // stretches it instead.
    fn on_corner(ref this, sender: *u8) {
        this.corner = (this.corner +% 1) % 4;
        let n: *core::Node = mount::node(BADGE);
        if n.is_null() { return; }
        // Both edges of an axis are always named here, so the badge hangs from
        // a corner rather than stretching: an edge left unset is not the same
        // as an edge set to zero, and there is no "unset" to write.
        core::set_left(n, if this.corner == 0 || this.corner == 3 { 8.0 } else { 236.0 });
        core::set_top(n, if this.corner == 0 || this.corner == 1 { 8.0 } else { 68.0 });
        core::relayout(mount::node("pl:host"));
    }

    // min/max clamp whatever the flow would otherwise hand out.
    fn on_bounds(ref this, sender: *u8) {
        this.wide = !this.wide;
        let n: *core::Node = mount::node(BOUNDED);
        core::set_max_width(n, if this.wide { 420.0 } else { 160.0 });
        core::relayout(n);
    }
}

impl Placement: component::Component {
    fn build(ref this) -> core::Node {
        var body: core::Builder = core::Builder::new();

        body.add(shell::caption("absolute  ·  out of flow, positioned on the parent"));
        body.add(ui::button("Move to next corner", key: "pl:corner", on_click: this.on_corner));

        var badge_b: core::Builder = core::Builder::new();
        badge_b.add(ui::label(
            "badge",
            key: "",
            font_size: 11.0,
            font_weight: vocab::FontWeight::Bold,
            text_color: vocab::Color::rgba(1.0, 1.0, 1.0, 1.0),
        ));
        var badge: core::Node = core::column(badge_b, key: BADGE).padding(6.0);
        badge.set_background_color(vocab::Color::rgba(0.90, 0.20, 0.35, 1.0));
        badge.set_corner_radius(vocab::Corners::all(6.0));
        core::set_absolute(#addr_of(badge), true);
        core::set_left(#addr_of(badge), 8.0);
        core::set_top(#addr_of(badge), 8.0);

        var host_b: core::Builder = core::Builder::new();
        host_b.add(ui::label(
            "in-flow content",
            key: "",
            font_size: 12.0,
            text_color: vocab::Color::ink(0.7),
        ));
        host_b.add(badge);
        var host: core::Node = core::column(host_b, key: "pl:host")
            .padding(16.0).width(300.0).height(110.0);
        host.set_background_color(vocab::Color::sunken());
        host.set_corner_radius(vocab::Corners::all(10.0));
        body.add(host);

        body.add(shell::caption("aspect ratio  ·  height derived from width"));
        var ar_b: core::Builder = core::Builder::new();
        var ar: core::Node = core::column(ar_b).width(240.0);
        core::set_aspect_ratio(#addr_of(ar), 16.0 / 9.0);
        ar.set_background_color(vocab::Color::primary());
        ar.set_corner_radius(vocab::Corners::all(8.0));
        body.add(ar);

        body.add(shell::caption("min / max  ·  clamping what the flow hands out"));
        body.add(ui::button("Toggle max width", key: "pl:bounds", on_click: this.on_bounds));
        var bo_b: core::Builder = core::Builder::new();
        bo_b.add(ui::label(
            "grow(1) with a max width — the clamp wins",
            key: "",
            font_size: 12.0,
            text_color: vocab::Color::rgba(1.0, 1.0, 1.0, 1.0),
            max_lines: 2,
            line_break: vocab::LineBreak::WordWrap,
        ));
        var bounded: core::Node = core::column(bo_b, key: BOUNDED)
            .padding(10.0).grow(1.0);
        core::set_max_width(#addr_of(bounded), 160.0);
        bounded.set_background_color(vocab::Color::rgba(0.20, 0.70, 0.55, 1.0));
        bounded.set_corner_radius(vocab::Corners::all(8.0));
        var brow: core::Builder = core::Builder::new();
        brow.add(bounded);
        body.add(core::row(brow).width(460.0));

        body.add(ui::label(
            "An absolute node leaves the flow: its siblings lay out as if it were not there, and it hangs off whichever edges it names. Name both edges of one axis and it stretches between them instead. aspect_ratio derives the other dimension; min/max clamp whatever grow or the content asked for.",
            key: "pl:note",
            font_size: 12.0,
            text_color: vocab::Color::ink(0.6),
            max_lines: 6,
            line_break: vocab::LineBreak::WordWrap,
        ));

        return shell::panel(
            "Placement",
            "Absolute positioning, aspect ratio and the min/max clamps.",
            core::column(body).gap(12.0),
            howto: "core::set_absolute(n, true);\ncore::set_left(n, 8.0); core::set_top(n, 8.0);\ncore::set_aspect_ratio(n, 16.0 / 9.0);\ncore::set_max_width(n, 160.0);",
        );
    }
}

impl Placement: component::Lifecycle {
    fn on_attach(ref this) { return; }
    fn on_detach(ref this) { return; }
}
