// Reference: split
//   ui::split(panes, key: "…", axis: SplitAxis::Columns, position: 180.0)

import "facet/facet" as core;
import "facet/elements" as ui;
import "facet/component" as component;
import "facet/split" as split;
import "facet/vocabulary" as vocab;
import "facet/label" as label;
import "stdlib/option" as option;
import "../../shell" as shell;

struct Splits {
    n: i32,
}

impl Splits {
    fn new() -> Splits { return Splits { n: 0 }; }
    fn roles(ref this,sender: *u8) {
        this.n=(this.n+1)%3;
        if let option::Option::Some(v)=split::find("sp:demo") {let changed=v.set_role(split::Pane::Leading,if this.n==0 {split::PaneRole::Sidebar} else {split::PaneRole::Content}).set_role(split::Pane::Trailing,if this.n==1 {split::PaneRole::Sidebar} else {split::PaneRole::Content});}
        if let option::Option::Some(v)=label::find("sp:roles") {let changed=v.set_text(if this.n==0 {"Sidebar: leading"} else if this.n==1 {"Sidebar: trailing"} else {"Both panes: content"});}
    }
}

fn pane(title: str, color: vocab::Color) -> core::Node {
    var b: core::Builder = core::Builder::new();
    b.add(ui::label(title, key: "", font_size: 14.0,
        font_weight: vocab::FontWeight::Semibold, text_color: vocab::Color::ink()));
    b.add(ui::label("Drag the divider.", key: "", font_size: 12.0,
        text_color: vocab::Color::ink(0.55)));
    var n: core::Node = core::column(b).padding(16.0).gap(6.0).grow(1.0);
    n.set_background_color(color);
    return n;
}

impl Splits: component::Component {
    fn build(ref this) -> core::Node {
        this.n=0;
        var body: core::Builder = core::Builder::new();
        body.add(shell::caption("split  ·  two children: leading, trailing"));
        body.add(ui::label(
            "position is the divider offset; min_leading / min_trailing clamp it. This window's shell is the same control.",
            key: "sp:note",
            font_size: 13.0,
            text_color: vocab::Color::ink(0.65),
            max_lines: 3,
            line_break: vocab::LineBreak::WordWrap,
        ));

        var panes: core::Builder = core::Builder::new();
        var leading=pane("Leading", vocab::Color::clear());
        assert leading.add_child(ui::text_field("Retained edit",key:"sp:edit")).is_ok();
        panes.add(leading);
        panes.add(pane("Trailing", vocab::Color::clear()));
        body.add(ui::split(
            panes,
            key: "sp:demo",
            axis: split::SplitAxis::Columns,
            position: 160.0,
            min_leading: 100.0,
            min_trailing: 100.0,
            role_leading: split::PaneRole::Sidebar,
        ).height(200.0));
        body.add(ui::button("Switch pane roles",key:"sp:switch",on_click:this.roles));
        body.add(ui::label("Sidebar: leading",key:"sp:roles"));

        return shell::panel(
            "Split",
            "Draggable divider between two panes. Axis names the RESULT (Columns | Rows).",
            core::column(body).gap(12.0),
            howto: "var b = Builder::new();\nb.add(leading); b.add(trailing);\nui::split(b, key: \"s\", position: 180.0, min_leading: 120.0)",
        );
    }
}

impl Splits: component::Lifecycle {
    fn on_attach(ref this, why: component::Attach) {
        if why != component::Attach::Mount { return; } return; }
    fn on_detach(ref this, why: component::Detach) {
        if why != component::Detach::Unmount { return; } return; }
}
