// Reference: grid layout
//   n.set_display(flex::Display::Grid)
//   n.add_grid_column(flex::GridTrack::fr(1.0))   // .points(n) / .fr(n) / .auto()
//   n.add_grid_row(flex::GridTrack::points(60.0))
//   core::set_grid_column_span(child, 2)   / set_grid_row_span
//   core::set_grid_column_start(child, 2)  / set_grid_row_start   (1-based lines)
//   core::set_grid_dense(n, true)          — backfill holes left by spans
//
// facet's tree IS flex's tree, so the track verbs are flex's own on the same
// node. A grid container flows its children into cells; a child that names a
// start line or a span opts out of the flow for that axis.

import "facet/facet" as core;
import "facet/elements" as ui;
import "facet/component" as component;
import "facet/mount" as mount;
import "facet/vocabulary" as vocab;
import "flex_layout/flex_layout" as flex;
import "../../shell" as shell;

const GRID: str = "gr:grid";

struct Grids {
    dense: bool,
    wide: bool,
}

impl Grids {
    fn new() -> Grids { return Grids { dense: false, wide: false }; }

    // Dense backfills the gaps a span leaves behind; sparse never goes back.
    fn on_dense(ref this, sender: *u8) {
        this.dense = !this.dense;
        core::set_grid_dense(mount::node(GRID), this.dense);
        core::relayout(mount::node(GRID));
    }

    // The wide cell is the one that leaves a hole — with dense off, the cells
    // after it flow past the gap rather than into it.
    fn on_wide(ref this, sender: *u8) {
        this.wide = !this.wide;
        core::set_grid_column_span(mount::node("gr:c2"), if this.wide { 2 } else { 1 });
        core::relayout(mount::node(GRID));
    }
}

fn cell(key: str, text: str, c: vocab::Color) -> core::Node {
    var b: core::Builder = core::Builder::new();
    b.add(ui::label(
        text,
        key: "",
        font_size: 12.0,
        font_weight: vocab::FontWeight::Semibold,
        text_color: vocab::Color::rgba(1.0, 1.0, 1.0, 1.0),
    ));
    var n: core::Node = core::column(b, key: key).padding(10.0).height(48.0);
    n.set_background_color(c);
    n.set_corner_radius(vocab::Corners::all(8.0));
    return n;
}

impl Grids: component::Component {
    fn build(ref this) -> core::Node {
        var body: core::Builder = core::Builder::new();

        var ctl: core::Builder = core::Builder::new();
        ctl.add(ui::button("Span cell 2 across", key: "gr:wide", on_click: this.on_wide));
        ctl.add(ui::button("Toggle dense", key: "gr:dense", on_click: this.on_dense));
        body.add(core::row(ctl).gap(8.0));

        body.add(shell::caption("3 columns: 80pt · 1fr · 1fr"));

        var cells: core::Builder = core::Builder::new();
        cells.add(cell("gr:c1", "1", vocab::Color::primary()));
        cells.add(cell("gr:c2", "2", vocab::Color::rgba(0.75, 0.30, 0.85, 1.0)));
        cells.add(cell("gr:c3", "3", vocab::Color::primary()));
        cells.add(cell("gr:c4", "4", vocab::Color::primary()));
        cells.add(cell("gr:c5", "5", vocab::Color::rgba(0.20, 0.70, 0.55, 1.0)));
        cells.add(cell("gr:c6", "6", vocab::Color::primary()));

        var grid: core::Node = core::column(cells, key: GRID).gap(8.0);
        // The tracks are flex's, on the same node facet writes its band to.
        grid.set_display(flex::Display::Grid);
        grid.add_grid_column(flex::GridTrack::points(80.0));
        grid.add_grid_column(flex::GridTrack::fr(1.0));
        grid.add_grid_column(flex::GridTrack::fr(1.0));
        body.add(grid);

        body.add(ui::label(
            "A fixed track is points, a share of what is left is fr, and auto is the content's own size. Children flow into the cells in order; give one a span and it takes two tracks, which can leave a hole. Dense backfills those holes with later children, sparse never looks back — that is the whole difference and it is visible above.",
            key: "gr:note",
            font_size: 12.0,
            text_color: vocab::Color::ink(0.6),
            max_lines: 6,
            line_break: vocab::LineBreak::WordWrap,
        ));

        return shell::panel(
            "Grid",
            "Track-based layout: fixed, fractional and auto columns, spans, and the dense packing rule.",
            core::column(body).gap(12.0),
            howto: "var g = core::column(cells, key: \"grid\");\ng.set_display(flex::Display::Grid);\ng.add_grid_column(flex::GridTrack::points(80.0));\ng.add_grid_column(flex::GridTrack::fr(1.0));\ncore::set_grid_column_span(child, 2);",
        );
    }
}

impl Grids: component::Lifecycle {
    fn on_attach(ref this) { return; }
    fn on_detach(ref this) { return; }
}
