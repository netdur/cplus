// Reference: image
//   ui::image(source, key: "…", fit: ImageFit::AspectFit)

import "facet/facet" as core;
import "facet/elements" as ui;
import "facet/component" as component;
import "facet/vocabulary" as vocab;
import "../shell" as shell;

struct Images {
    n: i32,
}

impl Images {
    fn new() -> Images { return Images { n: 0 }; }
}

// The tree's own sample image. One place, because four hosts show it and a
// path repeated four times is a path that gets fixed three times.
fn hat() -> str { return "../../assets/hat.png"; }

impl Images: component::Component {
    fn build(ref this) -> core::Node {
        var body: core::Builder = core::Builder::new();

        body.add(shell::caption("image  ·  source is a path, or a platform icon name"));
        body.add(ui::label(
            "Fit modes: AspectFit, AspectFill, Center, Fill. Size the host with layout verbs.",
            key: "img:note",
            font_size: 13.0,
            text_color: vocab::Color::ink(0.65),
            max_lines: 3,
            line_break: vocab::LineBreak::WordWrap,
        ));

        // A REAL FILE, because that is the portable half of `source`. This
        // demo used to name `photo` and `star.fill` — SF Symbols, which exist
        // on AppKit and nowhere else, so every fit mode rendered nothing on
        // Linux and the demo looked like a broken control rather than a
        // missing icon set. `star.fill` was the worse of the two: it has a dot
        // in it, so a backend reading the source as "a path has a separator or
        // an extension" treats it as a FILE NAME and looks for one.
        //
        // The path is relative to where the example is RUN from, which for
        // `cpc run` is the example's own directory.
        var row: core::Builder = core::Builder::new();
        row.add(ui::image(hat(), key: "img:fit",
            fit: vocab::ImageFit::AspectFit)
            .width(96.0).height(72.0));
        row.add(ui::image(hat(), key: "img:fill",
            fit: vocab::ImageFit::AspectFill)
            .width(96.0).height(72.0));
        row.add(ui::image(hat(), key: "img:center",
            fit: vocab::ImageFit::Center)
            .width(72.0).height(72.0));
        row.add(ui::image(hat(), key: "img:stretch",
            fit: vocab::ImageFit::Fill)
            .width(72.0).height(72.0));
        body.add(core::row(row).gap(12.0));

        var labels: core::Builder = core::Builder::new();
        labels.add(ui::label("AspectFit", key: "", font_size: 11.0,
            text_color: vocab::Color::ink(0.5)).width(96.0));
        labels.add(ui::label("AspectFill", key: "", font_size: 11.0,
            text_color: vocab::Color::ink(0.5)).width(96.0));
        labels.add(ui::label("Center", key: "", font_size: 11.0,
            text_color: vocab::Color::ink(0.5)).width(72.0));
        labels.add(ui::label("Fill", key: "", font_size: 11.0,
            text_color: vocab::Color::ink(0.5)).width(72.0));
        body.add(core::row(labels).gap(12.0));

        return shell::panel(
            "Image",
            "Raster or symbol image host. Layout owns size; fit owns how the content maps into it.",
            core::column(body).gap(12.0),
            howto: "ui::image(\"assets/hat.png\", key: \"img\", fit: ImageFit::AspectFit)\n    .width(96.0).height(72.0)",
        );
    }
}

impl Images: component::Lifecycle {
    fn on_attach(ref this) { return; }
    fn on_detach(ref this) { return; }
}
