// Reference: image
//   ui::image(source, key: "…", fit: ImageFit::AspectFit)

import "facet/facet" as core;
import "facet/elements" as ui;
import "facet/component" as component;
import "facet/vocabulary" as vocab;
import "../shell" as shell;

struct Images {
    n: i32,
}

impl Images {
    fn new() -> Images { return Images { n: 0 }; }
}

impl Images: component::Component {
    fn build(ref this) -> core::Node {
        var body: core::Builder = core::Builder::new();

        body.add(shell::caption("image  ·  source is a path or SF Symbol name"));
        body.add(ui::label(
            "Fit modes: AspectFit, AspectFill, Center, Fill. Size the host with layout verbs.",
            key: "img:note",
            font_size: 13.0f64,
            text_color: vocab::Color::ink(0.65f64),
            max_lines: 3 as i64,
            line_break: vocab::LineBreak::WordWrap,
        ));

        var row: core::Builder = core::Builder::new();
        row.add(ui::image("photo", key: "img:fit",
            fit: vocab::ImageFit::AspectFit)
            .width(96.0f64).height(72.0f64));
        row.add(ui::image("photo", key: "img:fill",
            fit: vocab::ImageFit::AspectFill)
            .width(96.0f64).height(72.0f64));
        row.add(ui::image("star.fill", key: "img:star",
            fit: vocab::ImageFit::Center)
            .width(72.0f64).height(72.0f64));
        body.add(core::row(row).gap(12.0f64));

        var labels: core::Builder = core::Builder::new();
        labels.add(ui::label("AspectFit", key: "", font_size: 11.0f64,
            text_color: vocab::Color::ink(0.5f64)).width(96.0f64));
        labels.add(ui::label("AspectFill", key: "", font_size: 11.0f64,
            text_color: vocab::Color::ink(0.5f64)).width(96.0f64));
        labels.add(ui::label("Center", key: "", font_size: 11.0f64,
            text_color: vocab::Color::ink(0.5f64)).width(72.0f64));
        body.add(core::row(labels).gap(12.0f64));

        return shell::panel(
            "Image",
            "Raster or symbol image host. Layout owns size; fit owns how the content maps into it.",
            core::column(body).gap(12.0f64),
            howto: "ui::image(\"photo\", key: \"img\", fit: ImageFit::AspectFit)\n    .width(96.0).height(72.0)",
        );
    }
}

impl Images: component::Lifecycle {
    fn on_attach(ref this) { return; }
    fn on_detach(ref this) { return; }
}
