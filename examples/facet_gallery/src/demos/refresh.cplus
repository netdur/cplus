// Reference: refreshable content host
//   ui::refreshable(key: "r", refreshable: true, on_refreshing: this.on_refresh)
//   refreshable::find("r").set_refreshing(false) after the load

import "facet/facet" as core;
import "facet/elements" as ui;
import "facet/component" as component;
import "facet/list" as list;
import "facet/refreshable" as refreshable;
import "facet/services" as services;
import "facet/label" as label;
import "facet/vocabulary" as vocab;
import "stdlib/option" as option;
import "../shell" as shell;

struct Refresh {
    times: i32,
    pending: bool,
    timer: services::Cancellable,
}

fn refresh_row(index: usize, ctx: *u8) -> core::Node {
    let n: i32 = (index as i32) +% 1;
    var b: core::Builder = core::Builder::new();
    b.add(ui::label(
        "Item ${n}",
        key: "rf:t",
        font_size: 14.0,
        text_color: vocab::Color::ink(),
    ));
    return core::column(b).padding(10.0);
}

impl Refresh {
    fn new() -> Refresh { return Refresh { times: 0, pending: false, timer: #zero::[services::Cancellable]() }; }

    fn on_refresh(ref this, sender: *u8) {
        if this.pending { return; }
        this.pending = true;
        this.times = this.times +% 1;
        match label::find("rf:status") {
            option::Option[label::Label]::Some(l) => {
                let _l: label::Label = l.set_text("refreshed ${this.times} time(s)");
            }
            option::Option::None => { }
        }
        // Simulate asynchronous loading so the native indicator is visible.
        this.timer = services::after(0.75f64, this.finish_refresh);
    }

    fn finish_refresh(ref this) {
        this.pending = false;
        match refreshable::find("rf:host") {
            option::Option::Some(r) => { let updated = r.set_refreshing(false); }
            option::Option::None => { }
        }
    }

    fn force_refresh(ref this, sender: *u8) {
        if this.pending { return; }
        match refreshable::find("rf:host") {
            option::Option::Some(r) => { let updated = r.set_refreshing(true); }
            option::Option::None => { }
        }
        // State setters do not dispatch an action on every backend. The pending
        // guard also handles backends that report the native refresh request.
        this.on_refresh(sender);
    }
}

impl Refresh: component::Component {
    fn build(ref this) -> core::Node {
        var body: core::Builder = core::Builder::new();
        body.add(shell::caption("refreshable  ·  list content"));
        body.add(ui::label(
            "Pull to refresh where supported, or press Refresh. The indicator remains active while the simulated load completes.",
            key: "rf:note",
            font_size: 13.0,
            text_color: vocab::Color::ink(0.65),
            max_lines: 4,
            line_break: vocab::LineBreak::WordWrap,
        ));
        body.add(ui::button("Refresh", key: "rf:btn", on_click: this.force_refresh));

        var host: core::Node = ui::list(
            key: "rf:list",
            row_height: 40,
        ).height(220.0).grow(1.0);
        match list::find("rf:list", within: #addr_of(host)) {
            option::Option[list::List]::Some(l) => {
                let _c: list::List = l.set_count(12);
                let _r: list::List = l.set_row(refresh_row);
            }
            option::Option::None => { }
        }
        var refresh_host = ui::refreshable(key: "rf:host", refreshable: true,
            on_refreshing: this.on_refresh).height(220.0).grow(1.0);
        let attached = refresh_host.add_child(host);
        body.add(refresh_host);
        body.add(ui::label(
            "refreshed 0 time(s)",
            key: "rf:status",
            font_size: 13.0,
            text_color: vocab::Color::ink(0.7),
        ));

        return shell::panel(
            "Refresh",
            "A refreshable host keeps its indicator active until the load finishes.",
            core::column(body).gap(12.0),
            howto: "ui::refreshable(key: \"r\", refreshable: true,\n    on_refreshing: this.on_refresh)\n// add scrollable content; after loading:\nrefreshable::find(\"r\").set_refreshing(false)",
        );
    }
}

impl Refresh: component::Lifecycle {
    fn on_attach(ref this, why: component::Attach) {
        if why != component::Attach::Mount { return; } return; }
    fn on_detach(ref this, why: component::Detach) {
        if why != component::Detach::Unmount { return; } this.timer.cancel(); return; }
}
