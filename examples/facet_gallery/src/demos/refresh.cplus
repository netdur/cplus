// Reference: list pull-to-refresh
//   ui::list(key: "l", refreshable: true, on_refreshing: this.on_refresh)
//   list::find("l").begin_refresh() / .end_refresh()

import "facet/facet" as core;
import "facet/elements" as ui;
import "facet/component" as component;
import "facet/list" as list;
import "facet/label" as label;
import "facet/vocabulary" as vocab;
import "stdlib/option" as option;
import "../shell" as shell;

struct Refresh {
    times: i32,
}

fn refresh_row(index: usize, ctx: *u8) -> core::Node {
    let n: i32 = (index as i32) +% 1;
    var b: core::Builder = core::Builder::new();
    b.add(ui::label(
        "Item ${n}",
        key: "rf:t",
        font_size: 14.0f64,
        text_color: vocab::Color::ink(),
    ));
    return core::column(b).padding(10.0f64);
}

impl Refresh {
    fn new() -> Refresh { return Refresh { times: 0 }; }

    fn on_refresh(ref this, sender: *u8) {
        this.times = this.times +% 1;
        match label::find("rf:status") {
            option::Option[label::Label]::Some(l) => {
                let _l: label::Label = l.set_text("refreshed ${this.times} time(s)");
            }
            option::Option[label::Label]::None => { }
        }
        // End the spinner — a real app would do this after the load finishes.
        match list::find("rf:list") {
            option::Option[list::List]::Some(l) => {
                let _e: list::List = l.end_refresh();
            }
            option::Option[list::List]::None => { }
        }
        return;
    }

    fn force_refresh(ref this, sender: *u8) {
        match list::find("rf:list") {
            option::Option[list::List]::Some(l) => {
                let _b: list::List = l.begin_refresh();
            }
            option::Option[list::List]::None => { }
        }
        this.on_refresh(sender);
        return;
    }
}

impl Refresh: component::Component {
    fn build(ref this) -> core::Node {
        var body: core::Builder = core::Builder::new();
        body.add(shell::caption("list  ·  refreshable"));
        body.add(ui::label(
            "On touch: pull to refresh. On AppKit the control is present; use begin_refresh / end_refresh from a button to simulate the cycle.",
            key: "rf:note",
            font_size: 13.0f64,
            text_color: vocab::Color::ink(0.65f64),
            max_lines: 4 as i64,
            line_break: vocab::LineBreak::WordWrap,
        ));
        body.add(ui::button("Simulate refresh", key: "rf:btn", on_click: this.force_refresh));

        var host: core::Node = ui::list(
            key: "rf:list",
            refreshable: true,
            row_height: 40 as i64,
            on_refreshing: this.on_refresh,
        ).height(220.0f64).grow(1.0f64);
        match list::find("rf:list", within: #addr_of(host)) {
            option::Option[list::List]::Some(l) => {
                let _c: list::List = l.set_count(12 as usize);
                let _r: list::List = l.set_row(refresh_row);
            }
            option::Option[list::List]::None => { }
        }
        body.add(host);
        body.add(ui::label(
            "refreshed 0 time(s)",
            key: "rf:status",
            font_size: 13.0f64,
            text_color: vocab::Color::ink(0.7f64),
        ));

        return shell::panel(
            "Refresh",
            "Pull-to-refresh on a list. Handlers call begin_refresh / end_refresh around the load.",
            core::column(body).gap(12.0f64),
            howto: "ui::list(key: \"l\", refreshable: true,\n    on_refreshing: this.on_refresh)\n// in handler after load:\nlist::find(\"l\").end_refresh()",
        );
    }
}

impl Refresh: component::Lifecycle {
    fn on_attach(ref this) { return; }
    fn on_detach(ref this) { return; }
}
