import "facet/facet" as core;
import "facet/elements" as ui;
import "facet/component" as component;
import "facet/tabs" as tabs;
import "facet/label" as label;
import "facet/vocabulary" as vocab;
import "stdlib/option" as option;
import "../shell" as shell;
struct TabsDemo {custom: bool}
impl TabsDemo {
    fn new() -> TabsDemo {return TabsDemo {custom:false};}
    fn changed(ref this,sender: *u8) {
        match tabs::find("tabs:host") {option::Option::Some(t)=>{let index=t.selected_index();match label::find("tabs:status") {option::Option::Some(l)=>{let updated=l.set_text("Selected tab: ${index}");},option::Option::None=>{}}},option::Option::None=>{}}
    }
    fn recolor(ref this,sender: *u8) {
        this.custom=!this.custom;match tabs::find("tabs:host") {option::Option::Some(t)=>{
            let updated=t.set_bar_background_color(if this.custom {vocab::Color::rgba(0.12f64,0.1f64,0.22f64,1.0f64)} else {vocab::Color::clear()}).set_selected_tab_color(if this.custom {vocab::Color::rgba(0.4f64,0.2f64,0.65f64,1.0f64)} else {vocab::Color::clear()}).set_unselected_tab_color(if this.custom {vocab::Color::rgba(0.2f64,0.16f64,0.3f64,1.0f64)} else {vocab::Color::clear()}).set_bar_text_color(if this.custom {vocab::Color::rgba(1.0f64,0.9f64,0.7f64,1.0f64)} else {vocab::Color::clear()});
        },option::Option::None=>{}}
    }
}
impl TabsDemo: component::Component {
    fn build(ref this) -> core::Node {
        this.custom=false;
        var host=ui::tabs(key:"tabs:host",on_tab_changed:this.changed).height(200.0f64);
        assert host.add_child(@ui {column(key:"Welcome") {label("Welcome pane",key:"tabs:welcome") label("Select a tab with the mouse or keyboard.")}.padding(16.0f64).gap(10.0f64)}).is_ok();
        assert host.add_child(@ui {column(key:"Settings") {label("Settings pane",key:"tabs:settings") checkbox(false,key:"tabs:check") label("Keep my settings")}.padding(16.0f64).gap(10.0f64)}).is_ok();
        assert host.add_child(@ui {column(key:"About") {label("About pane",key:"tabs:about") label("Each tab keeps its content while another pane is visible.")}.padding(16.0f64).gap(10.0f64)}).is_ok();
        return shell::panel("Tabs","Switch between persistent panes with native tab headers.",@ui {column {host label("Selected tab: 0",key:"tabs:status") button("Toggle tab colors",key:"tabs:colors",on_click:this.recolor)}.gap(12.0f64)},howto:"ui::tabs(key: \"tabs\", on_tab_changed: this.changed)\ntabs::find(\"tabs\").set_selected_index(1)");
    }
}
impl TabsDemo: component::Lifecycle {
    fn on_attach(ref this,why: component::Attach) {return;}
    fn on_detach(ref this,why: component::Detach) {return;}
}
