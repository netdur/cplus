// Reference: table
//   var t = ui::table(key: "t", row_height: 32);
//   table::find("t").set_content(column_of_rows);

import "facet/facet" as core;
import "facet/elements" as ui;
import "facet/component" as component;
import "facet/table" as table;
import "facet/vocabulary" as vocab;
import "stdlib/option" as option;
import "../shell" as shell;

struct Tables {
    n: i32,
}

fn data_row(a: str, b: str, c: str) -> core::Node {
    var r: core::Builder = core::Builder::new();
    r.add(ui::label(a, key: "", font_size: 13.0f64, text_color: vocab::Color::ink()).grow(1.0f64));
    r.add(ui::label(b, key: "", font_size: 13.0f64, text_color: vocab::Color::ink(0.7f64)).grow(1.0f64));
    r.add(ui::label(c, key: "", font_size: 13.0f64, text_color: vocab::Color::ink(0.7f64)).grow(1.0f64));
    return core::row(r).padding(8.0f64).gap(8.0f64);
}

impl Tables {
    fn new() -> Tables { return Tables { n: 0 }; }
}

impl Tables: component::Component {
    fn build(ref this) -> core::Node {
        var body: core::Builder = core::Builder::new();
        body.add(shell::caption("table  ·  set_content hosts the document"));
        body.add(ui::label(
            "TableView is a host: put a column of rows (or a custom grid) into @content. Style and row_height configure chrome.",
            key: "tb:note",
            font_size: 13.0f64,
            text_color: vocab::Color::ink(0.65f64),
            max_lines: 4 as i64,
            line_break: vocab::LineBreak::WordWrap,
        ));

        var header: core::Builder = core::Builder::new();
        header.add(ui::label("Name", key: "", font_size: 12.0f64,
            font_weight: vocab::FontWeight::Semibold, text_color: vocab::Color::ink(0.55f64)).grow(1.0f64));
        header.add(ui::label("Role", key: "", font_size: 12.0f64,
            font_weight: vocab::FontWeight::Semibold, text_color: vocab::Color::ink(0.55f64)).grow(1.0f64));
        header.add(ui::label("Status", key: "", font_size: 12.0f64,
            font_weight: vocab::FontWeight::Semibold, text_color: vocab::Color::ink(0.55f64)).grow(1.0f64));

        var doc: core::Builder = core::Builder::new();
        doc.add(core::row(header).padding(8.0f64).gap(8.0f64));
        doc.add(data_row("Ada", "Engineer", "Active"));
        doc.add(data_row("Grace", "Architect", "Active"));
        doc.add(data_row("Alan", "Research", "Away"));
        doc.add(data_row("Edsger", "Reviewer", "Active"));
        var content: core::Node = core::column(doc).gap(0.0f64);

        var host: core::Node = ui::table(
            key: "tb:host",
            row_height: 36 as i64,
            style: vocab::TableStyle::Data,
        ).height(220.0f64).grow(1.0f64);
        match table::find("tb:host", within: #addr_of(host)) {
            option::Option[table::Table]::Some(t) => {
                let _c: table::Table = t.set_content(content);
            }
            option::Option[table::Table]::None => { }
        }
        body.add(host);

        return shell::panel(
            "Table",
            "Host for tabular content. Fill via set_content; list/collection cover recycled data grids.",
            core::column(body).gap(12.0f64),
            howto: "var h = ui::table(key: \"t\", row_height: 36);\nmatch table::find(\"t\", within: #addr_of(h)) {\n  Some(t) => { t.set_content(rows); }\n  None => {}\n}",
        );
    }
}

impl Tables: component::Lifecycle {
    fn on_attach(ref this) { return; }
    fn on_detach(ref this) { return; }
}
