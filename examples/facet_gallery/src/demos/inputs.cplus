import "facet/facet" as core;
import "facet/elements" as ui;
import "facet/component" as component;
import "facet/label" as label;
import "facet/text_field" as text_field;
import "facet/search_field" as search_field;
import "facet/text_area" as text_area;
import "facet/vocabulary" as vocab;
import "stdlib/option" as option;
import "../shell" as shell;

struct Inputs {
    n: i32,
    clear: bool,
    revealed: bool,
}

impl Inputs {
    fn new() -> Inputs { return Inputs { n: 0,clear:false,revealed:false }; }
    fn reveal(ref this,sender: *u8) {
        this.revealed=!this.revealed;
        if let option::Option::Some(v)=text_field::find("in:secret") {let updated=v.set_secure(!this.revealed);}
    }
    fn clearing(ref this,sender: *u8) {
        this.clear=!this.clear;
        if let option::Option::Some(v)=text_field::find("in:name") {let updated=v.set_clear_button(if this.clear {vocab::ClearButton::WhileEditing} else {vocab::ClearButton::Never});}
        if let option::Option::Some(v)=label::find("in:clear-label") {let updated=v.set_text(if this.clear {"Clear: while editing"} else {"Clear: never"});}
    }

    fn casing(ref this,sender: *u8) {
        this.n=(this.n+1)%3;let mode=if this.n==1 {vocab::TextTransform::Uppercase} else if this.n==2 {vocab::TextTransform::Lowercase} else {vocab::TextTransform::Default};
        if let option::Option::Some(v)=text_field::find("in:name") {let updated=v.set_text_transform(mode);}
        if let option::Option::Some(v)=search_field::find("in:search") {let updated=v.set_text_transform(mode);}
        if let option::Option::Some(v)=text_area::find("in:area") {let updated=v.set_text_transform(mode);}
        if let option::Option::Some(v)=label::find("in:case-label") {if this.n==1 {let updated=v.set_text("Uppercase");} else if this.n==2 {let updated=v.set_text("Lowercase");} else {let updated=v.set_text("Default casing");}}
    }

    fn on_name(ref this, sender: *u8) {
        match text_field::find("in:name") {
            option::Option[text_field::TextField]::Some(f) => {
                let t: str = f.text();
                match label::find("in:name_echo") {
                    option::Option[label::Label]::Some(l) => {
                        if t.count() == 0 {
                            let _l: label::Label = l.set_text("Hello, stranger");
                        } else {
                            let _l: label::Label = l.set_text("Hello, ${t}");
                        }
                    }
                    option::Option::None => { }
                }
            }
            option::Option::None => { }
        }
    }

    fn on_search(ref this, sender: *u8) {
        match search_field::find("in:search") {
            option::Option[search_field::SearchField]::Some(f) => {
                let t: str = f.text();
                match label::find("in:search_echo") {
                    option::Option[label::Label]::Some(l) => {
                        if t.count() == 0 {
                            let _l: label::Label = l.set_text("Query: (empty)");
                        } else {
                            let _l: label::Label = l.set_text("Query: ${t}");
                        }
                    }
                    option::Option::None => { }
                }
            }
            option::Option::None => { }
        }
    }
}

impl Inputs: component::Component {
    fn build(ref this) -> core::Node {
        this.n=0;this.clear=false;this.revealed=false;
        var body: core::Builder = core::Builder::new();

        body.add(@ui {row {button("Change casing",key:"in:case",on_click:this.casing) label("Default casing",key:"in:case-label") button("Toggle clear button",key:"in:clear",on_click:this.clearing) label("Clear: never",key:"in:clear-label")}.gap(12.0f64)});
        body.add(ui::text_field("", key: "in:name", placeholder: "Your name",
            on_text_changed: this.on_name));
        body.add(ui::label("Hello, stranger", key: "in:name_echo",
            font_size: 14.0, text_color: vocab::Color::ink(0.7)));

        body.add(@ui {row {label("Secure field") button("Show / hide",key:"in:reveal",on_click:this.reveal)}.gap(12.0f64)});
        body.add(ui::text_field("", key: "in:secret", placeholder: "Password", secure: true));

        body.add(shell::caption("Search field"));
        body.add(ui::search_field("", key: "in:search", placeholder: "Search the catalog…",
            on_text_changed: this.on_search));
        body.add(ui::label("Query: (empty)", key: "in:search_echo",
            font_size: 14.0, text_color: vocab::Color::ink(0.7)));

        body.add(shell::caption("Text area"));
        body.add(ui::text_area("Write a few lines…\nSecond line.", key: "in:area")
            .height(120.0));

        return shell::panel(
            "Inputs",
            "Single-line, secure, search, and multi-line text entry.",
            core::column(body).gap(10.0),
            howto: "ui::text_field(\"\", key: \"n\", placeholder: \"Name\",\n    on_text_changed: this.on_name)\nui::search_field(\"\", placeholder: \"Search…\")\nui::text_area(\"…\", key: \"a\").height(120.0)",
        );
    }
}

impl Inputs: component::Lifecycle {
    fn on_attach(ref this, why: component::Attach) {
        if why != component::Attach::Mount { return; } return; }
    fn on_detach(ref this, why: component::Detach) {
        if why != component::Detach::Unmount { return; } return; }
}
