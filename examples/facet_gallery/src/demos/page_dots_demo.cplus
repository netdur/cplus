// Reference: page_dots
//   ui::page_dots(5, key: "d", position: 0)
//   page_dots::find("d").set_position(2)

import "facet/facet" as core;
import "facet/elements" as ui;
import "facet/component" as component;
import "facet/page_dots" as page_dots;
import "facet/label" as label;
import "facet/vocabulary" as vocab;
import "stdlib/option" as option;
import "../shell" as shell;

struct PageDotsDemo {
    pos: i64,
}

impl PageDotsDemo {
    fn new() -> PageDotsDemo { return PageDotsDemo { pos: 0 as i64 }; }

    fn paint(ref this) {
        match page_dots::find("pd:dots") {
            option::Option[page_dots::PageDots]::Some(d) => {
                let _d: page_dots::PageDots = d.set_position(this.pos);
            }
            option::Option[page_dots::PageDots]::None => { }
        }
        match label::find("pd:status") {
            option::Option[label::Label]::Some(l) => {
                let p: i32 = this.pos as i32;
                let _l: label::Label = l.set_text("position: ${p} / 4");
            }
            option::Option[label::Label]::None => { }
        }
        return;
    }

    fn go_prev(ref this, sender: *u8) {
        if this.pos > (0 as i64) { this.pos = this.pos -% (1 as i64); }
        this.paint();
        return;
    }

    fn go_next(ref this, sender: *u8) {
        if this.pos < (4 as i64) { this.pos = this.pos +% (1 as i64); }
        this.paint();
        return;
    }
}

impl PageDotsDemo: component::Component {
    fn build(ref this) -> core::Node {
        var body: core::Builder = core::Builder::new();
        body.add(shell::caption("page_dots  ·  page indicator"));
        body.add(ui::page_dots(
            5 as i64,
            key: "pd:dots",
            position: 0 as i64,
            selected_dot_color: vocab::Color::primary(),
        ));
        var row: core::Builder = core::Builder::new();
        row.add(ui::button("Previous", key: "pd:prev", on_click: this.go_prev));
        row.add(ui::button("Next", key: "pd:next", on_click: this.go_next));
        body.add(core::row(row).gap(8.0f64));
        body.add(ui::label("position: 0 / 4", key: "pd:status",
            font_size: 13.0f64, text_color: vocab::Color::ink(0.7f64)));

        return shell::panel(
            "Page dots",
            "Indicator for a paged surface (carousel, onboarding). Drive position from the host.",
            core::column(body).gap(12.0f64),
            howto: "ui::page_dots(5, key: \"d\", position: 0)\npage_dots::find(\"d\").set_position(2)",
        );
    }
}

impl PageDotsDemo: component::Lifecycle {
    fn on_attach(ref this) { return; }
    fn on_detach(ref this) { return; }
}
