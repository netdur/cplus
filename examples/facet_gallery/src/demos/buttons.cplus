import "facet/facet" as core;
import "facet/elements" as ui;
import "facet/component" as component;
import "facet/label" as label;
import "facet/button" as button;
import "facet/icon_button" as icon_button;
import "facet/text_button" as text_button;
import "facet/vocabulary" as vocab;
import "stdlib/option" as option;
import "../shell" as shell;

struct Buttons {
    clicks: i32,
    live_mode: bool,
    break_mode: i32,
    wide: bool,
}

impl Buttons {
    fn new() -> Buttons { return Buttons { clicks: 0, live_mode: false,break_mode:0,wide:false }; }
    fn switch_break(ref this,sender: *u8) {
        this.break_mode=(this.break_mode+1)%6;
        let modes=[vocab::LineBreak::HeadTruncation,vocab::LineBreak::MiddleTruncation,vocab::LineBreak::TailTruncation,vocab::LineBreak::CharacterWrap,vocab::LineBreak::WordWrap,vocab::LineBreak::NoWrap];
        let names=["Head truncation","Middle truncation","Tail truncation","Character wrap","Word wrap","No wrap"];
        if let option::Option::Some(v)=button::find("btn:break-button") {let changed=v.set_line_break(modes[this.break_mode as usize]);}
        if let option::Option::Some(v)=text_button::find("btn:break-text") {let changed=v.set_line_break(modes[this.break_mode as usize]);}
        if let option::Option::Some(v)=label::find("btn:break-status") {let changed=v.set_text(names[this.break_mode as usize]);}
    }
    fn switch_width(ref this,sender: *u8) {
        this.wide=!this.wide;let width=if this.wide {320.0f64} else {160.0f64};
        if let option::Option::Some(v)=button::find("btn:break-button") {let changed=v.set_width(width);}
        if let option::Option::Some(v)=text_button::find("btn:break-text") {let changed=v.set_width(width);}
    }
    fn switch_mode(ref this,sender: *u8) {
        this.live_mode=!this.live_mode;
        match button::find("btn:mode-button") {option::Option::Some(v)=>{let set=v.set_toggles(this.live_mode);},option::Option::None=>{}}
        match icon_button::find("btn:mode-icon") {option::Option::Some(v)=>{let set=v.set_toggles(this.live_mode);},option::Option::None=>{}}
        match text_button::find("btn:mode-text") {option::Option::Some(v)=>{let set=v.set_toggles(this.live_mode);},option::Option::None=>{}}
        match label::find("btn:mode-status") {option::Option::Some(v)=>{let set=v.set_text(if this.live_mode {"Mode: toggle"} else {"Mode: ordinary"});},option::Option::None=>{}}
    }

    fn on_click(ref this, sender: *u8) {
        this.clicks = this.clicks +% 1;
        match label::find("btn:count") {
            option::Option[label::Label]::Some(l) => {
                let _l: label::Label = l.set_text("Clicked ${this.clicks} time(s)");
            }
            option::Option::None => { }
        }
    }

    fn on_reset(ref this, sender: *u8) {
        this.clicks = 0;
        match label::find("btn:count") {
            option::Option[label::Label]::Some(l) => {
                let _l: label::Label = l.set_text("Clicked 0 time(s)");
            }
            option::Option::None => { }
        }
    }
}

impl Buttons: component::Component {
    fn build(ref this) -> core::Node {
        this.break_mode=0;this.wide=false;
        var body: core::Builder = core::Builder::new();

        body.add(shell::caption("Button  ·  on_click"));
        var row: core::Builder = core::Builder::new();
        row.add(ui::button("Click me", key: "btn:click", on_click: this.on_click));
        row.add(ui::button("Reset", key: "btn:reset", on_click: this.on_reset));
        body.add(core::row(row).gap(8.0));
        body.add(ui::label(
            "Clicked 0 time(s)",
            key: "btn:count",
            font_size: 15.0,
            text_color: vocab::Color::ink(),
        ));

        body.add(shell::caption("Disabled"));
        var off: core::Node = ui::button("Unavailable", key: "btn:off");
        off.set_enabled(false);
        body.add(off);

        body.add(shell::caption("Toggle button  ·  sticky on/off"));
        body.add(ui::button("Pinned", key: "btn:toggle", toggles: true, on: true));

        body.add(shell::caption("Text button  ·  borderless"));
        body.add(ui::text_button(
            "Text action",
            key: "btn:text",
            text_color: vocab::Color::primary(),
            font_size: 15.0,
            font_weight: vocab::FontWeight::Semibold,
        ));

        body.add(shell::caption("Live button mode"));
        var modes: core::Builder=core::Builder::new();
        modes.add(ui::button("Switch mode",key:"btn:switch-mode",on_click:this.switch_mode));
        modes.add(ui::button("Action",key:"btn:mode-button",on_click:this.on_click));
        modes.add(ui::icon_button("star",key:"btn:mode-icon",on_clicked:this.on_click));
        modes.add(ui::text_button("Text action",key:"btn:mode-text",on_click:this.on_click));
        modes.add(ui::label("Mode: ordinary",key:"btn:mode-status"));
        body.add(core::row(modes).gap(8.0));

        body.add(shell::caption("Caption fitting"));
        body.add(@ui {row {button("Next line-break mode",key:"btn:break-next",on_click:this.switch_break) button("Narrow / wide",key:"btn:break-width",on_click:this.switch_width) label("Head truncation",key:"btn:break-status")}.gap(12.0f64)});
        body.add(@ui {row {
            button("Beginning — a long caption — ending",key:"btn:break-button",line_break:vocab::LineBreak::HeadTruncation,on_click:this.on_click).width(160.0f64)
            text_button("Beginning — a long caption — ending",key:"btn:break-text",line_break:vocab::LineBreak::HeadTruncation,on_click:this.on_click).width(160.0f64)
        }.gap(16.0f64)});

        return shell::panel(
            "Button",
            "Primary actions, disabled state, toggle-style, and borderless text buttons.",
            core::column(body).gap(10.0),
            howto: "ui::button(\"Save\", key: \"save\", on_click: this.on_click)\nui::text_button(\"Link\", text_color: Color::primary())\nlabel::find(\"count\").set_text(\"…\")",
        );
    }
}

impl Buttons: component::Lifecycle {
    fn on_attach(ref this, why: component::Attach) {
        if why != component::Attach::Mount { return; } return; }
    fn on_detach(ref this, why: component::Detach) {
        if why != component::Detach::Unmount { return; } return; }
}
