import "facet/facet" as core;
import "flex_layout/flex_layout" as flex;
import "facet/elements" as ui;
import "facet/component" as component;
import "facet/label" as label;
import "facet/toggle" as toggle;
import "facet/checkbox" as checkbox;
import "facet/radio" as radio;
import "facet/vocabulary" as vocab;
import "stdlib/option" as option;
import "../shell" as shell;

struct Controls {
    n: i32,
}

impl Controls {
    fn new() -> Controls { return Controls { n: 0 }; }

    fn style_choices(ref this, sender: *u8) {
        this.n = 1 - this.n;
        let accent = if this.n == 1 { vocab::Color::rgba(0.55f64, 0.18f64, 0.75f64, 1.0f64) } else { vocab::Color::clear() };
        let thumb = if this.n == 1 { vocab::Color::rgba(1.0f64, 1.0f64, 1.0f64, 1.0f64) } else { vocab::Color::clear() };
        if let option::Option::Some(t) = toggle::find("ctl:toggle") { let updated = t.set_off_color(accent).set_on_color(accent).set_thumb_color(thumb); }
        if let option::Option::Some(c) = checkbox::find("ctl:check") { let updated = c.set_color(accent); }
        let width = if this.n == 1 { 3.0f64 } else { 0.0f64 };
        if let option::Option::Some(r) = radio::find("ctl:radio_a") { let updated = r.set_border_color(accent).set_border_width(width); }
        if let option::Option::Some(r) = radio::find("ctl:radio_b") { let updated = r.set_border_color(accent).set_border_width(width); }
        if let option::Option::Some(r) = radio::find("ctl:radio_c") { let updated = r.set_border_color(accent).set_border_width(width); }
        if let option::Option::Some(l) = label::find("ctl:style_status") { let updated = l.set_text(if this.n == 1 {"Custom purple colors"} else {"Default theme colors"}); }
    }

    fn on_toggled(ref this, sender: *u8) {
        var on: bool = false;
        match toggle::find("ctl:toggle") {
            option::Option[toggle::Toggle]::Some(t) => { on = t.on(); }
            option::Option::None => { }
        }
        match label::find("ctl:toggle_status") {
            option::Option[label::Label]::Some(l) => {
                if on {
                    let _l: label::Label = l.set_text("Toggle is ON");
                } else {
                    let _l: label::Label = l.set_text("Toggle is OFF");
                }
            }
            option::Option::None => { }
        }
    }

    fn on_checked(ref this, sender: *u8) {
        var on: bool = false;
        match checkbox::find("ctl:check") {
            option::Option[checkbox::Checkbox]::Some(c) => { on = c.on(); }
            option::Option::None => { }
        }
        match label::find("ctl:check_status") {
            option::Option[label::Label]::Some(l) => {
                if on {
                    let _l: label::Label = l.set_text("Checkbox is checked");
                } else {
                    let _l: label::Label = l.set_text("Checkbox is unchecked");
                }
            }
            option::Option::None => { }
        }
    }

    fn on_radio(ref this, sender: *u8) {
        var choice: str = "none";
        match radio::find("ctl:radio_a") {
            option::Option[radio::Radio]::Some(r) => { if r.on() { choice = "Alpha"; } }
            option::Option::None => { }
        }
        match radio::find("ctl:radio_b") {
            option::Option[radio::Radio]::Some(r) => { if r.on() { choice = "Beta"; } }
            option::Option::None => { }
        }
        match radio::find("ctl:radio_c") {
            option::Option[radio::Radio]::Some(r) => { if r.on() { choice = "Gamma"; } }
            option::Option::None => { }
        }
        match label::find("ctl:radio_status") {
            option::Option[label::Label]::Some(l) => {
                let _l: label::Label = l.set_text("Selected: ${choice}");
            }
            option::Option::None => { }
        }
    }
}

impl Controls: component::Component {
    fn build(ref this) -> core::Node {
        var body: core::Builder = core::Builder::new();

        body.add(ui::button("Switch custom / theme colors", key: "ctl:style", on_click: this.style_choices));
        body.add(ui::label("Default theme colors", key: "ctl:style_status"));

        body.add(shell::caption("Toggle  ·  Switch"));
        var trow: core::Builder = core::Builder::new();
        trow.add(ui::toggle(false, key: "ctl:toggle", on_toggled: this.on_toggled));
        trow.add(ui::label("Toggle is OFF", key: "ctl:toggle_status",
            font_size: 14.0, text_color: vocab::Color::ink()));
        body.add(core::row(trow).gap(12.0));

        body.add(shell::caption("Checkbox"));
        var crow: core::Builder = core::Builder::new();
        crow.add(ui::checkbox(false, key: "ctl:check", on_checked_changed: this.on_checked));
        crow.add(ui::label("Checkbox is unchecked", key: "ctl:check_status",
            font_size: 14.0, text_color: vocab::Color::ink()));
        body.add(core::row(crow).gap(12.0).align(flex::Align::Center));

        body.add(shell::caption("Radio group  ·  group \"plan\""));
        body.add(ui::radio(true, key: "ctl:radio_a", text: "Alpha", group: "plan",
            on_checked_changed: this.on_radio));
        body.add(ui::radio(false, key: "ctl:radio_b", text: "Beta", group: "plan",
            on_checked_changed: this.on_radio));
        body.add(ui::radio(false, key: "ctl:radio_c", text: "Gamma", group: "plan",
            on_checked_changed: this.on_radio));
        body.add(ui::label("Selected: Alpha", key: "ctl:radio_status",
            font_size: 14.0, text_color: vocab::Color::ink()));

        return shell::panel(
            "Controls",
            "Boolean inputs: switch, checkbox, and mutually exclusive radios.",
            core::column(body).gap(10.0),
            howto: "ui::toggle(false, key: \"t\", on_toggled: this.on_toggled)\nui::checkbox(false, key: \"c\", on_checked_changed: this.on_checked)\nui::radio(true, text: \"A\", group: \"g\", on_checked_changed: this.on_radio)",
        );
    }
}

impl Controls: component::Lifecycle {
    fn on_attach(ref this, why: component::Attach) {
        if why != component::Attach::Mount { return; } return; }
    fn on_detach(ref this, why: component::Detach) {
        if why != component::Detach::Unmount { return; } return; }
}
