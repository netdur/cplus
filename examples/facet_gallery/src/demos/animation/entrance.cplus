// Reference: the entrance pattern — build in the hidden state, animate on attach.
//
// THE RULE THIS DEMO EXISTS FOR: there is one field per property and one apply
// per tick, so the start value has to reach the VIEW before the animation is
// armed. `set_opacity(0)` and `animate_opacity(1)` in the same tick are not a
// fade-in — both write `opacity`, the second wins, and the backend interpolates
// from what the view already shows to a value it is already at. Nothing moves.
//
// Building the card at `opacity: 0` gives the zero its own apply (the mount
// walk), and `on_attach` runs after that walk — so the animation starts from 0
// and the entrance is real. Replay hops through `services::run_on_main` for the
// same reason: it is the cheapest way to say "next turn of the run loop".

import "facet/facet" as core;
import "facet/elements" as ui;
import "facet/component" as component;
import "facet/mount" as mount;
import "facet/services" as services;
import "facet/vocabulary" as vocab;
import "../../shell" as shell;

const COUNT: i64 = 5 as i64;
const RISE: f64 = 16.0f64;

struct Entrance {
    // The replay timer's handle. It has to be KEPT: dropping a `Cancellable`
    // cancels the timer it stands for, so a bare `let _t = after(...)` would
    // cancel itself at the end of the statement.
    pending: services::Cancellable,
}

fn card_key(i: i64) -> str {
    if i == (1 as i64) { return "en:1"; }
    if i == (2 as i64) { return "en:2"; }
    if i == (3 as i64) { return "en:3"; }
    if i == (4 as i64) { return "en:4"; }
    return "en:0";
}

fn card_text(i: i64) -> str {
    if i == (1 as i64) { return "Two"; }
    if i == (2 as i64) { return "Three"; }
    if i == (3 as i64) { return "Four"; }
    if i == (4 as i64) { return "Five"; }
    return "One";
}

// The cascade comes from the DURATION, not from five timers: every card starts
// together and lands a beat apart. A true stagger would be
// `services::after(delay, ...)` — and would mean keeping each `Cancellable`
// alive, since dropping one cancels its timer.
fn seconds_for(i: i64) -> f64 {
    return 0.55f64 + ((i as f64) * 0.16f64);
}

fn play_in() {
    var i: i64 = 0 as i64;
    while i < COUNT {
        let n: *core::Node = mount::node(card_key(i));
        let d: vocab::Duration = vocab::Duration::of_seconds(seconds_for(i));
        core::animate_opacity(n, 1.0f64, d, vocab::Easing::SinOut);
        core::animate_translation(n, 0.0f64, 0.0f64, d, vocab::Easing::SinOut);
        i = i +% (1 as i64);
    }
    return;
}

// The other half of the hop: this runs on the next turn of the run loop, by
// which time the snap below has been applied and the cards really are hidden.
fn replay_step(ctx: *u8) {
    play_in();
    return;
}

impl Entrance {
    fn new() -> Entrance {
        return Entrance { pending: #zero::[services::Cancellable]() };
    }

    fn on_replay(ref this, sender: *u8) {
        // Tick 1: snap back to the hidden state. A `set_*` also cancels any
        // animation still in flight on the same band, so a fast double-click
        // cannot leave a card half-faded.
        var i: i64 = 0 as i64;
        while i < COUNT {
            let n: *core::Node = mount::node(card_key(i));
            core::set_opacity(n, 0.0f64);
            core::set_translation_y(n, RISE);
            i = i +% (1 as i64);
        }
        // Tick 2: animate. Written as `set` then `animate` in ONE handler this
        // would do nothing at all, and facet would say so on stderr.
        // A TIMER, not `services::run_on_main`. The main-queue hop lands in the
        // same run-loop turn as the click that scheduled it — before the sync
        // observer that applies dirty nodes — so the snap above and the animate
        // below collapsed into ONE apply and the cards never showed the hidden
        // state. A timer fires on a later turn, after that sync has committed.
        this.pending = services::after(0.05f64, replay_step, 0 as *u8);
        return;
    }
}

fn card(i: i64) -> core::Node {
    var inner: core::Builder = core::Builder::new();
    inner.add(ui::label(
        card_text(i),
        key: "",
        font_size: 14.0f64,
        font_weight: vocab::FontWeight::Semibold,
        text_color: vocab::Color::ink(),
    ));
    inner.add(ui::label(
        "faded in over ${seconds_for(i)}s",
        key: "",
        font_size: 11.0f64,
        text_color: vocab::Color::ink(0.55f64),
    ));
    var n: core::Node = core::column(inner, key: card_key(i))
        .padding(12.0f64)
        .gap(2.0f64)
        .width(260.0f64);
    n.set_background_color(vocab::Color::raised());
    n.set_corner_radius(vocab::Corners::all(10.0f64));
    // The hidden state, applied by the MOUNT walk — which is what makes the
    // animation in `on_attach` start from somewhere.
    n.set_opacity(0.0f64);
    n.set_translation_y(RISE);
    return n;
}

impl Entrance: component::Component {
    fn build(ref this) -> core::Node {
        var body: core::Builder = core::Builder::new();
        body.add(ui::button("Replay", key: "en:replay", on_click: this.on_replay));

        var cards: core::Builder = core::Builder::new();
        var i: i64 = 0 as i64;
        while i < COUNT {
            cards.add(card(i));
            i = i +% (1 as i64);
        }
        body.add(core::column(cards).gap(8.0f64));

        body.add(ui::label(
            "Built at opacity 0 with a 16pt drop, animated to 1 and 0 from on_attach. The mount walk applies the hidden state; on_attach runs after it, so the animation has somewhere to start. Replay snaps back and hops through services::run_on_main, because the snap needs its own apply too.",
            key: "en:note",
            font_size: 12.0f64,
            text_color: vocab::Color::ink(0.6f64),
            max_lines: 5 as i64,
            line_break: vocab::LineBreak::WordWrap,
        ));

        return shell::panel(
            "Entrance",
            "Fade-and-rise on attach — and the tick discipline that makes it work.",
            core::column(body).gap(12.0f64),
            howto: "// build\nvar n = core::column(b, key: \"card\");\nn.set_opacity(0.0);          // applied by the mount walk\n\n// on_attach — a later tick\ncore::animate_opacity(mount::node(\"card\"), 1.0, d, Easing::SinOut);",
        );
    }
}

impl Entrance: component::Lifecycle {
    fn on_attach(ref this) { play_in(); return; }
    fn on_detach(ref this) { return; }
}
