// Reference: the two rules that are not visible in the signatures.
//
// Both are demonstrated live, side by side with the spelling that works,
// because both fail SILENTLY — the app compiles, the verb returns, and nothing
// moves. That is the shape that costs an afternoon.

import "facet/facet" as core;
import "facet/elements" as ui;
import "facet/component" as component;
import "facet/mount" as mount;
import "facet/services" as services;
import "facet/vocabulary" as vocab;
import "../../shell" as shell;

const A: str = "ru:a";
const B: str = "ru:b";
const C: str = "ru:c";

struct AnimRules {
    // Kept, not discarded: dropping a `Cancellable` cancels its timer.
    pending: services::Cancellable,
}

fn slow() -> vocab::Duration { return vocab::Duration::of_seconds(0.8); }

// The second half of the two-tick fade: by the time the timer calls this, the
// zero written below has been through a sync and card B really is invisible.
fn fade_b_in(ctx: *u8) {
    core::animate_opacity(mount::node(B), 1.0, slow(), vocab::Easing::SinOut);
}

impl AnimRules {
    fn new() -> AnimRules {
        return AnimRules { pending: #zero::[services::Cancellable]() };
    }

    // WRONG, on purpose. Both lines write `opacity`; the animate wins, and the
    // backend is asked to travel from what the view already shows to a value it
    // is already at. Watch the stderr the app was launched from: facet names
    // this pair rather than leaving it silent.
    fn on_same_tick(ref this, sender: *u8) {
        let n: *core::Node = mount::node(A);
        core::set_opacity(n, 0.0);
        core::animate_opacity(n, 1.0, slow(), vocab::Easing::SinOut);
    }

    // RIGHT. The zero gets its own apply, then the animation starts from it.
    //
    // A TIMER and not `services::run_on_main`: the main-queue hop runs in the
    // same run-loop turn as the click, ahead of the sync that applies dirty
    // nodes, so the snap and the animate would still collapse into one apply.
    // "A later turn" is the requirement, and a timer is what states it.
    fn on_two_ticks(ref this, sender: *u8) {
        core::set_opacity(mount::node(B), 0.0);
        this.pending = services::after(0.05, fade_b_in, 0 as *u8);
    }

    // The transform is ONE matrix, so two verbs in a tick are one animation
    // over the composed result — the card grows and turns together.
    //
    // 180 rather than a full turn, and that is a third rule worth knowing: the
    // animation interpolates between two MATRICES, and 360° produces the same
    // matrix as 0°. A whole revolution has nothing to travel through and does
    // not play at all.
    fn on_compose(ref this, sender: *u8) {
        let n: *core::Node = mount::node(C);
        core::animate_scale(n, 1.4, slow(), vocab::Easing::CubicInOut);
        core::animate_rotation(n, 180.0, slow(), vocab::Easing::CubicInOut);
    }

    // ...and because it is one matrix, a snap to ANY part of it cancels the
    // whole pending animation rather than leaving a half-interpolated frame.
    // The turn below never plays: the scale write lands on the same channel.
    fn on_snap_cancels(ref this, sender: *u8) {
        let n: *core::Node = mount::node(C);
        core::animate_rotation(n, 180.0, slow(), vocab::Easing::CubicInOut);
        core::set_scale(n, 1.4);
    }

    fn on_reset(ref this, sender: *u8) {
        let a: *core::Node = mount::node(A);
        let b: *core::Node = mount::node(B);
        let c: *core::Node = mount::node(C);
        core::cancel_animations(a);
        core::cancel_animations(b);
        core::cancel_animations(c);
        core::set_opacity(a, 1.0);
        core::set_opacity(b, 1.0);
        core::set_scale(c, 1.0);
        core::set_rotation(c, 0.0);
    }
}

fn tile(key: str, caption: str) -> core::Node {
    var inner: core::Builder = core::Builder::new();
    inner.add(ui::label(
        caption,
        key: "",
        font_size: 13.0,
        font_weight: vocab::FontWeight::Semibold,
        text_color: vocab::Color::rgba(1.0, 1.0, 1.0, 1.0),
    ));
    var n: core::Node = core::column(inner, key: key)
        .padding(16.0)
        .width(150.0)
        .height(64.0);
    n.set_background_color(vocab::Color::primary());
    n.set_corner_radius(vocab::Corners::all(10.0));
    return n;
}

fn stage(take content: core::Node) -> core::Node {
    var b: core::Builder = core::Builder::new();
    b.add(content);
    var s: core::Node = core::column(b).padding(20.0).height(120.0);
    s.set_background_color(vocab::Color::sunken());
    s.set_corner_radius(vocab::Corners::all(10.0));
    return s;
}

impl AnimRules: component::Component {
    fn build(ref this) -> core::Node {
        var body: core::Builder = core::Builder::new();

        body.add(shell::caption("Rule 1  ·  the start value needs its own apply"));
        var r1: core::Builder = core::Builder::new();
        r1.add(ui::button("Same tick (nothing happens)", key: "ru:same", on_click: this.on_same_tick));
        r1.add(ui::button("Two ticks (real fade)", key: "ru:two", on_click: this.on_two_ticks));
        body.add(core::row(r1).gap(8.0));

        var pair: core::Builder = core::Builder::new();
        pair.add(tile(A, "same tick"));
        pair.add(tile(B, "two ticks"));
        body.add(stage(core::row(pair).gap(16.0)));

        body.add(ui::label(
            "One field per property, one apply per tick. set_opacity(0) then animate_opacity(1) in one handler leaves 1 in the field and never shows the 0 — so there is nothing to animate from. facet prints a line naming the pair, because otherwise the only symptom is a card that does not move.",
            key: "ru:n1",
            font_size: 12.0,
            text_color: vocab::Color::ink(0.6),
            max_lines: 5,
            line_break: vocab::LineBreak::WordWrap,
        ));

        body.add(shell::caption("Rule 2  ·  the transform animates as a unit"));
        var r2: core::Builder = core::Builder::new();
        r2.add(ui::button("Compose (scale + turn)", key: "ru:comp", on_click: this.on_compose));
        r2.add(ui::button("Snap cancels the turn", key: "ru:snap", on_click: this.on_snap_cancels));
        r2.add(ui::button("Reset", key: "ru:reset", on_click: this.on_reset));
        body.add(core::row(r2).gap(8.0));
        body.add(stage(tile(C, "transform")));

        body.add(ui::label(
            "Scale, rotation and translation are nine numbers in one matrix, and a backend rebuilds all of it at once — so it cannot interpolate the rotation while snapping the scale. Two animate_* verbs in a tick compose into one animation; a set_* on any of the nine cancels a pending one outright.",
            key: "ru:n2",
            font_size: 12.0,
            text_color: vocab::Color::ink(0.6),
            max_lines: 5,
            line_break: vocab::LineBreak::WordWrap,
        ));

        return shell::panel(
            "Rules",
            "The two things about animate_* that the signatures do not show — both failing silently, both shown next to the spelling that works.",
            core::column(body).gap(12.0),
            howto: "// wrong — one tick, one field\nn.set_opacity(0.0); n.animate_opacity(to: 1.0);\n\n// right — the zero gets its own apply\nn.set_opacity(0.0);\nservices::run_on_main(fade_in, 0 as *u8);",
        );
    }
}

impl AnimRules: component::Lifecycle {
    fn on_attach(ref this) { return; }
    fn on_detach(ref this) { return; }
}
