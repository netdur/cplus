import "facet/facet" as core;
import "facet/elements" as ui;
import "facet/component" as component;
import "facet/vocabulary" as vocab;
import "stdlib/status" as status;
import "facet/icons" as icons;
import "facet/bordered" as bordered;
import "facet/label" as label;
import "stdlib/option" as option;
import "../shell" as shell;

// A recorded drawing: what a `canvas` replays. The backend hands us a `Canvas`
// and the size it was given; we append commands and return. Exercises the
// gradient fill, stroked and filled shapes, a built path, and text.
fn canvas_demo(cv: *vocab::Canvas, bounds: vocab::Rect, ctx: *u8) {
    let w: f64 = bounds.width;
    let h: f64 = bounds.height;

    // A gradient ground, rounded.
    let ground: vocab::Rect = vocab::Rect::of(0.0, 0.0, w, h);
    let g: vocab::Brush = vocab::Brush {
        start: vocab::Color::rgba(0.16, 0.20, 0.34, 1.0),
        end: vocab::Color::rgba(0.32, 0.16, 0.42, 1.0),
        angle: 90.0, is_gradient: true,
    };
    let _b1: status::Status = { (*cv).set_fill_brush(g, ground) };
    let _b2: status::Status = { (*cv).fill_rounded_rect(ground, 14.0) };

    // A filled circle and a stroked ring beside it.
    let _f1: status::Status = { (*cv).set_fill(vocab::Color::rgba(0.36, 0.78, 0.98, 1.0)) };
    let _f2: status::Status = { (*cv).fill_ellipse(vocab::Rect::of(28.0, 40.0, 84.0, 84.0)) };
    let _s1: status::Status = { (*cv).set_stroke(vocab::Color::rgba(1.0, 0.72, 0.30, 1.0)) };
    let _s2: status::Status = { (*cv).set_stroke_width(5.0) };
    let _s3: status::Status = { (*cv).draw_ellipse(vocab::Rect::of(132.0, 40.0, 84.0, 84.0)) };

    // A line.
    let _l1: status::Status = { (*cv).set_stroke(vocab::Color::rgba(0.55, 0.90, 0.60, 1.0)) };
    let _l2: status::Status = { (*cv).set_stroke_width(3.0) };
    let _l3: status::Status = { (*cv).draw_line(vocab::Point::of(240.0, 120.0), vocab::Point::of(340.0, 44.0)) };

    // A filled triangle, built as a path.
    var tri: vocab::Path = vocab::Path::new();
    let _p1: status::Status = tri.move_to(vocab::Point::of(300.0, 118.0));
    let _p2: status::Status = tri.line_to(vocab::Point::of(360.0, 118.0));
    let _p3: status::Status = tri.line_to(vocab::Point::of(330.0, 60.0));
    let _p4: status::Status = tri.close();
    let _f3: status::Status = { (*cv).set_fill(vocab::Color::rgba(0.95, 0.40, 0.55, 1.0)) };
    let _f4: status::Status = { (*cv).fill_path(#addr_of(tri), vocab::Winding::NonZero) };

    // Text.
    let _t1: status::Status = { (*cv).set_text_color(vocab::Color::rgba(1.0, 1.0, 1.0, 0.95)) };
    let _t2: status::Status = { (*cv).set_font("Segoe UI", 20.0, vocab::FontWeight::Bold, false) };
    let _t3: status::Status = { (*cv).draw_text_block("Canvas", vocab::Rect::of(0.0, 12.0, w, 30.0),
        vocab::TextAlign::Center, vocab::VerticalAlign::Top, vocab::TextFlow::Clip, 0.0) };
    return;
}

struct Graphics {
    n: i32,
}

impl Graphics {
    fn new() -> Graphics { return Graphics { n: 0 }; }
    fn cycle_border(ref this, sender: *u8) {
        this.n=(this.n+1)%3;
        if let option::Option::Some(b)=bordered::find("g:border") {
            let shape=if this.n==1 {vocab::Shape::rounded(16.0f64)} else if this.n==2 {vocab::Shape {kind:3,corners:vocab::Corners::none()}} else {vocab::Shape::none()};
            let dash=if this.n==1 {vocab::Dashes::of(12.0f64,6.0f64)} else if this.n==2 {vocab::Dashes::of(2.0f64,6.0f64)} else {vocab::Dashes::none()};
            let updated=b.set_stroke_shape(shape).set_stroke_dash(dash).set_stroke_width(2.0f64).set_stroke_dash_offset(if this.n==1 {3.0f64} else {0.0f64}).set_stroke_cap(if this.n==2 {vocab::LineCap::Round} else {vocab::LineCap::Flat});
        }
        if let option::Option::Some(l)=label::find("g:border_note") {let updated=l.set_text(if this.n==1 {"Rounded dashed outline"} else if this.n==2 {"Ellipse dotted outline"} else {"Solid rectangular outline"});}
    }
}

impl Graphics: component::Component {
    fn build(ref this) -> core::Node {
        var body: core::Builder = core::Builder::new();

        body.add(shell::caption("Symbol  ·  Material Symbols"));
        var icons_row: core::Builder = core::Builder::new();
        icons_row.add(ui::symbol(icons::home, key: "g:home", size: 28.0,
            color: vocab::Color::ink()));
        icons_row.add(ui::symbol(icons::settings, key: "g:settings", size: 28.0,
            color: vocab::Color::primary()));
        icons_row.add(ui::symbol(icons::favorite, key: "g:fav", size: 28.0, fill: 1.0,
            color: vocab::Color::rgba(0.9, 0.2, 0.3, 1.0)));
        icons_row.add(ui::symbol(icons::search, key: "g:search", size: 28.0,
            color: vocab::Color::ink(0.7)));
        icons_row.add(ui::symbol(icons::add, key: "g:add", size: 28.0,
            color: vocab::Color::ink()));
        body.add(core::row(icons_row).gap(16.0));

        body.add(shell::caption("Box  ·  solid colour block"));
        var boxes: core::Builder = core::Builder::new();
        boxes.add(ui::box(vocab::Color::primary(), key: "g:box1",
            corner_radius: vocab::Corners::all(8.0)).width(64.0).height(64.0));
        boxes.add(ui::box(vocab::Color::raised(), key: "g:box2",
            corner_radius: vocab::Corners::all(8.0)).width(64.0).height(64.0));
        boxes.add(ui::box(vocab::Color::sunken(), key: "g:box3",
            corner_radius: vocab::Corners::all(8.0)).width(64.0).height(64.0));
        body.add(core::row(boxes).gap(12.0));

        body.add(shell::caption("Bordered  ·  stroked frame"));
        var border: core::Node = ui::bordered(key:"g:border",stroke_width:2.0f64,
            stroke:vocab::Brush::solid(vocab::Color::primary())).padding(12.0f64);
        assert border.add_child(ui::text_button("Cycle border style",key:"g:border_cycle",on_click:this.cycle_border)).is_ok();
        body.add(border.height(72.0f64));
        body.add(ui::label("Solid rectangular outline",key:"g:border_note",font_size:12.0f64,text_color:vocab::Color::ink(0.55f64)));

        body.add(shell::caption("Canvas"));
        body.add(ui::canvas(key: "g:canvas", drawable: vocab::Drawable::of(canvas_demo))
            .height(180.0).width_percent(100.0));
        body.add(ui::label(
            "Canvas hosts a Drawable — a recorded list of drawing commands the backend replays. This one draws a gradient, shapes, a path and text.",
            key: "g:canvas_note",
            font_size: 12.0,
            text_color: vocab::Color::ink(0.55),
        ));

        return shell::panel(
            "Graphics",
            "Symbols, colour boxes, borders, and the freeform canvas host.",
            core::column(body).gap(12.0),
            howto: "ui::symbol(icons::home, size: 28.0, color: Color::ink())\nui::box(Color::primary(), corner_radius: Corners::all(8.0))\nui::bordered(key: \"b\", stroke_width: 1.0,\n    stroke: Brush::solid(Color::outline()))\nui::canvas(key: \"c\").height(120.0)",
        );
    }
}

impl Graphics: component::Lifecycle {
    fn on_attach(ref this, why: component::Attach) {
        if why != component::Attach::Mount { return; } return; }
    fn on_detach(ref this, why: component::Detach) {
        if why != component::Detach::Unmount { return; } return; }
}
