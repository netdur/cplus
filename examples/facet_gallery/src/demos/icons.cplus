// Reference: icon_button, symbol, button(symbol:)
//   import "facet/elements" as ui;
//   import "facet/icons" as icons;
//   ui::icon_button("gearshape", key: "…", on_clicked: …)
//   ui::icon_button(symbol: icons::settings, key: "…", on_clicked: …)
//   ui::button("Delete", key: "…", symbol: icons::delete, on_click: …)
//   ui::symbol(icons::home, size: 20.0, color: …)

import "flex_layout/flex_layout" as flex;
import "facet/facet" as core;
import "facet/elements" as ui;
import "facet/component" as component;
import "facet/label" as label;
import "facet/vocabulary" as vocab;
import "facet/icons" as icons;
import "facet/symbol" as symbol;
import "stdlib/option" as option;
import "../shell" as shell;

struct Icons {
    clicks: i32,
    bundled: bool,
}

impl Icons {
    fn new() -> Icons { return Icons { clicks: 0,bundled:false }; }

    fn switch_symbol(ref this,sender: *u8) {
        this.bundled=!this.bundled;
        if let option::Option::Some(v)=symbol::find("ico:system") {
            if this.bundled {let changed=v.set_icon(icons::home).set_size(32.0f64).set_color(vocab::Color::primary());}
            else {let changed=v.set_name("Print").set_size(48.0f64).set_color(vocab::Color::ink());}
        }
        if let option::Option::Some(v)=label::find("ico:system-status") {let changed=v.set_text(if this.bundled {"Bundled: home (32 pt)"} else {"Windows: Print (48 pt)"});}
    }

    fn on_icon(ref this, sender: *u8) {
        this.clicks = this.clicks +% 1;
        match label::find("ico:status") {
            option::Option[label::Label]::Some(l) => {
                let _l: label::Label = l.set_text("icon_button clicks: ${this.clicks}");
            }
            option::Option::None => { }
        }
    }
}

impl Icons: component::Component {
    fn build(ref this) -> core::Node {
        var body: core::Builder = core::Builder::new();

        body.add(shell::caption("icon_button  ·  SF Symbol name as source"));
        var row: core::Builder = core::Builder::new();
        row.add(ui::icon_button("gearshape", key: "ico:gear",
            bordered: false, on_clicked: this.on_icon).width(36.0).height(28.0));
        row.add(ui::icon_button("star", key: "ico:star",
            bordered: false, on_clicked: this.on_icon).width(36.0).height(28.0));
        row.add(ui::icon_button("trash", key: "ico:trash",
            bordered: false, on_clicked: this.on_icon).width(36.0).height(28.0));
        row.add(ui::icon_button("plus", key: "ico:plus",
            bordered: true, on_clicked: this.on_icon).width(36.0).height(28.0));
        body.add(core::row(row).gap(8.0));
        body.add(ui::label("icon_button clicks: 0", key: "ico:status",
            font_size: 13.0, text_color: vocab::Color::ink(0.7)));

        body.add(shell::caption("button / icon_button  ·  symbol: a bundled glyph (facet/icons)"));
        var sbtn: core::Builder = core::Builder::new();
        sbtn.add(ui::button("Delete", key: "ico:b_del", symbol: icons::delete,
            on_click: this.on_icon));
        sbtn.add(ui::button("Next", key: "ico:b_next", symbol: icons::arrow_forward,
            content_layout: vocab::ContentLayout::ImageRight, on_click: this.on_icon));
        sbtn.add(ui::button("Download", key: "ico:b_dl", symbol: icons::download,
            text_color: vocab::Color::primary(), on_click: this.on_icon));
        sbtn.add(ui::icon_button(symbol: icons::settings, key: "ico:ib_set",
            on_clicked: this.on_icon));
        sbtn.add(ui::icon_button(symbol: icons::favorite, key: "ico:ib_fav",
            bordered: false, on_clicked: this.on_icon).width(36.0).height(28.0));
        body.add(core::row(sbtn).gap(8.0).align(flex::Align::Center));

        body.add(shell::caption("symbol  ·  Material Symbols codepoints (facet/icons)"));
        var syms: core::Builder = core::Builder::new();
        syms.add(ui::symbol(icons::home, key: "ico:s_home", size: 24.0,
            color: vocab::Color::ink()));
        syms.add(ui::symbol(icons::search, key: "ico:s_search", size: 24.0,
            color: vocab::Color::ink(0.7)));
        syms.add(ui::symbol(icons::settings, key: "ico:s_set", size: 24.0,
            color: vocab::Color::primary()));
        syms.add(ui::symbol(icons::favorite, key: "ico:s_fav", size: 24.0, fill: 1.0,
            color: vocab::Color::rgba(0.9, 0.25, 0.3, 1.0)));
        syms.add(ui::symbol(icons::add, key: "ico:s_add", size: 24.0,
            color: vocab::Color::ink()));
        body.add(core::row(syms).gap(16.0));

        body.add(shell::caption("Windows system symbols · native platform names"));
        body.add(@ui {row {
            symbol::system_symbol("Print",key:"ico:system",size:48.0f64)
            symbol::system_symbol("Accept",key:"ico:accept",size:32.0f64,color:vocab::Color::primary())
            symbol::system_symbol("BackToWindow",key:"ico:restore",size:32.0f64)
            button("Switch system / bundled",key:"ico:switch",on_click:this.switch_symbol)
        }.gap(16.0).align(flex::Align::Center)});
        body.add(ui::label("Windows: Print (48 pt)",key:"ico:system-status"));

        return shell::panel(
            "Icons",
            "Bundled Material symbols work across platforms. System symbol names select the platform's own icons.",
            core::column(body).gap(12.0),
            howto: "ui::icon_button(\"gearshape\", key: \"k\", on_clicked: this.on_icon)\nui::symbol(icons::home, size: 24.0, color: Color::ink())",
        );
    }
}

impl Icons: component::Lifecycle {
    fn on_attach(ref this, why: component::Attach) {
        if why != component::Attach::Mount { return; } return; }
    fn on_detach(ref this, why: component::Detach) {
        if why != component::Detach::Unmount { return; } return; }
}
