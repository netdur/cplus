// Shared page helpers for demo panels shown in the main column.
// Each demo is both a showcase and a minimal implementation reference.

import "facet/facet" as core;
import "facet/elements" as ui;
import "facet/vocabulary" as vocab;
import "facet/scroll" as scroll;
import "stdlib/option" as option;

fn heading(title: str) -> core::Node {
    return ui::label(
        title,
        key: "",
        font_size: 24.0,
        font_weight: vocab::FontWeight::Bold,
        text_color: vocab::Color::ink(),
    );
}

fn blurb(text: str) -> core::Node {
    return ui::label(
        text,
        key: "",
        font_size: 13.0,
        text_color: vocab::Color::ink(0.55),
        max_lines: 6,
        line_break: vocab::LineBreak::WordWrap,
    );
}

fn caption(text: str) -> core::Node {
    return ui::label(
        text,
        key: "",
        font_size: 12.0,
        font_weight: vocab::FontWeight::Semibold,
        text_color: vocab::Color::ink(0.6),
    );
}

// Implementation hint — import path + constructor shape.
fn reference(text: str) -> core::Node {
    var n: core::Node = ui::label(
        text,
        key: "",
        font_size: 11.0,
        font_family: "Menlo",
        text_color: vocab::Color::ink(0.7),
        max_lines: 8,
        line_break: vocab::LineBreak::WordWrap,
    ).padding(10.0);
    n.set_background_color(vocab::Color::sunken());
    n.set_corner_radius(vocab::Corners::all(6.0));
    return n;
}

// Scrollable demo body with standard padding on the surface.
fn panel(
    title: str,
    description: str,
    take body: core::Node,
    howto: str = "",
) -> core::Node {
    var col: core::Builder = core::Builder::new();
    col.add(heading(title));
    col.add(blurb(description));
    if howto != "" {
        col.add(reference(howto));
    }
    col.add(body);

    var page: core::Node = core::column(col)
        .padding(24.0)
        .gap(14.0)
        .grow(1.0);
    page.set_background_color(vocab::Color::surface());

    var root: core::Node = ui::scroll(key: "demo:scroll", axis: vocab::ScrollAxis::Vertical).grow(1.0);
    match scroll::find("demo:scroll", within: #addr_of(root)) {
        option::Option[scroll::Scroll]::Some(s) => {
            let _s: scroll::Scroll = s.set_content(page);
        }
        option::Option::None => { }
    }
    return root;
}
