fn demo_id_for(nav_id: str) -> i32 {
    if nav_id == NAV_OVERVIEW { return ID_OVERVIEW; }
    if nav_id == NAV_BUTTON { return ID_BUTTON; }
    if nav_id == NAV_LABEL { return ID_LABEL; }
    if nav_id == NAV_CONTROLS { return ID_CONTROLS; }
    if nav_id == NAV_VALUES { return ID_VALUES; }
    if nav_id == NAV_INPUTS { return ID_INPUTS; }
    if nav_id == NAV_PICKERS { return ID_PICKERS; }
    if nav_id == NAV_ICONS { return ID_ICONS; }
    if nav_id == NAV_IMAGES { return ID_IMAGES; }
    if nav_id == NAV_SPANS { return ID_SPANS; }
    if nav_id == NAV_GRAPHICS { return ID_GRAPHICS; }
    if nav_id == NAV_WEB { return ID_WEB; }
    if nav_id == NAV_LAYOUT { return ID_LAYOUT; }
    if nav_id == NAV_SCROLL { return ID_SCROLL; }
    if nav_id == NAV_SPLIT { return ID_SPLIT; }
    if nav_id == NAV_ZSTACK { return ID_ZSTACK; }
    if nav_id == NAV_RESPONSIVE { return ID_RESPONSIVE; }
    if nav_id == NAV_LIST { return ID_LIST; }
    if nav_id == NAV_COLLECTION { return ID_COLLECTION; }
    if nav_id == NAV_TREE { return ID_TREE; }
    if nav_id == NAV_PAGE_DOTS { return ID_PAGE_DOTS; }
    if nav_id == NAV_TABLE { return ID_TABLE; }
    if nav_id == NAV_REFRESH { return ID_REFRESH; }
    if nav_id == NAV_SWIPE { return ID_SWIPE; }
    if nav_id == NAV_CAROUSEL { return ID_CAROUSEL; }
    if nav_id == NAV_ANIM_BASICS { return ID_ANIM_BASICS; }
    if nav_id == NAV_ANIM_EASING { return ID_ANIM_EASING; }
    if nav_id == NAV_ANIM_ENTRANCE { return ID_ANIM_ENTRANCE; }
    if nav_id == NAV_ANIM_RULES { return ID_ANIM_RULES; }
    if nav_id == NAV_SHADOW { return ID_SHADOW; }
    if nav_id == NAV_BRUSH { return ID_BRUSH; }
    if nav_id == NAV_CLIP { return ID_CLIP; }
    if nav_id == NAV_GRID { return ID_GRID; }
    if nav_id == NAV_PLACEMENT { return ID_PLACEMENT; }
    if nav_id == NAV_A11Y { return ID_A11Y; }
    return 0 -% 1;
}

fn leaf(label: str, id: str) -> tree::TreeNode {
    return tree::TreeNode::new(label, id: id, is_branch: false);
}

fn section(label: str, id: str) -> tree::TreeNode {
    return tree::TreeNode::new(label, id: id, is_branch: true);
}

fn catalog_model() -> tree::TreeNode {
    var root: tree::TreeNode = tree::TreeNode::new("", id: "root", is_branch: true);

    // Overview sits at the root — not nested under a Start folder.
    let _o: status::Status = root.add_child(leaf("Overview", NAV_OVERVIEW));

    var views: tree::TreeNode = section("Views", SEC_VIEWS);
    let _b: status::Status = views.add_child(leaf("Button", NAV_BUTTON));
    let _l: status::Status = views.add_child(leaf("Label", NAV_LABEL));
    let _c: status::Status = views.add_child(leaf("Controls", NAV_CONTROLS));
    let _v: status::Status = views.add_child(leaf("Values", NAV_VALUES));
    let _i: status::Status = views.add_child(leaf("Inputs", NAV_INPUTS));
    let _p: status::Status = views.add_child(leaf("Pickers", NAV_PICKERS));
    let _ic: status::Status = views.add_child(leaf("Icons", NAV_ICONS));
    let _im: status::Status = views.add_child(leaf("Image", NAV_IMAGES));
    let _sp: status::Status = views.add_child(leaf("Spans", NAV_SPANS));
    let _g: status::Status = views.add_child(leaf("Graphics", NAV_GRAPHICS));
    let _w: status::Status = views.add_child(leaf("Web", NAV_WEB));
    let _vs: status::Status = root.add_child(views);

    var lay: tree::TreeNode = section("Layout", SEC_LAYOUT);
    let _ly: status::Status = lay.add_child(leaf("Basics", NAV_LAYOUT));
    let _sc: status::Status = lay.add_child(leaf("Scroll", NAV_SCROLL));
    let _sl: status::Status = lay.add_child(leaf("Split", NAV_SPLIT));
    let _zs: status::Status = lay.add_child(leaf("ZStack", NAV_ZSTACK));
    let _rp: status::Status = lay.add_child(leaf("Responsive", NAV_RESPONSIVE));
    let _gd: status::Status = lay.add_child(leaf("Grid", NAV_GRID));
    let _pm: status::Status = lay.add_child(leaf("Placement", NAV_PLACEMENT));
    let _ls: status::Status = root.add_child(lay);

    var cols: tree::TreeNode = section("Collections", SEC_COLLECTIONS);
    let _li: status::Status = cols.add_child(leaf("List", NAV_LIST));
    let _co: status::Status = cols.add_child(leaf("Collection", NAV_COLLECTION));
    let _tr: status::Status = cols.add_child(leaf("Tree", NAV_TREE));
    let _pd: status::Status = cols.add_child(leaf("Page dots", NAV_PAGE_DOTS));
    let _tb: status::Status = cols.add_child(leaf("Table", NAV_TABLE));
    let _cr: status::Status = cols.add_child(leaf("Carousel", NAV_CAROUSEL));
    let _cs: status::Status = root.add_child(cols);

    var dec: tree::TreeNode = section("Decoration", SEC_DECORATION);
    let _ds: status::Status = dec.add_child(leaf("Shadow", NAV_SHADOW));
    let _db: status::Status = dec.add_child(leaf("Brush", NAV_BRUSH));
    let _dc: status::Status = dec.add_child(leaf("Clip & order", NAV_CLIP));
    let _dr: status::Status = root.add_child(dec);

    var an: tree::TreeNode = section("Animation", SEC_ANIMATION);
    let _ab: status::Status = an.add_child(leaf("Basics", NAV_ANIM_BASICS));
    let _ae: status::Status = an.add_child(leaf("Easing", NAV_ANIM_EASING));
    let _an: status::Status = an.add_child(leaf("Entrance", NAV_ANIM_ENTRANCE));
    let _ar: status::Status = an.add_child(leaf("Rules", NAV_ANIM_RULES));
    let _as: status::Status = root.add_child(an);

    var ix: tree::TreeNode = section("Interaction", SEC_INTERACTION);
    let _rf: status::Status = ix.add_child(leaf("Refresh", NAV_REFRESH));
    let _sw: status::Status = ix.add_child(leaf("Swipe", NAV_SWIPE));
    let _ix: status::Status = root.add_child(ix);

    let _ax: status::Status = root.add_child(leaf("Accessibility", NAV_A11Y));

    return root;
}

impl Gallery {
    fn new() -> Gallery {
        return Gallery {
            selected: ID_OVERVIEW,
            overview: overview::Overview::new(),
            buttons: buttons::Buttons::new(),
            text: text::TextDemo::new(),
            controls: controls::Controls::new(),
            values: values::Values::new(),
            inputs: inputs::Inputs::new(),
            pickers: pickers::Pickers::new(),
            icons: icons::Icons::new(),
            images: images::Images::new(),
            spans: spans::SpansDemo::new(),
            graphics: graphics::Graphics::new(),
            web: web_demo::WebDemo::new(),
            layout: layout::LayoutDemo::new(),
            scrolls: scrolls::Scrolls::new(),
            splits: splits::Splits::new(),
            zstacks: zstacks::ZStacks::new(),
            responsive: responsive::Responsive::new(),
            lists: lists::Lists::new(),
            collections: collections::Collections::new(),
            trees: trees::Trees::new(),
            page_dots: page_dots_demo::PageDotsDemo::new(),
            tables: tables::Tables::new(),
            refresh: refresh::Refresh::new(),
            swipe: swipe::Swipe::new(),
            carousel: carousel_demo::CarouselDemo::new(),
            anim_basics: anim_basics::AnimBasics::new(),
            anim_easings: anim_easings::Easings::new(),
            anim_entrance: anim_entrance::Entrance::new(),
            anim_rules: anim_rules::AnimRules::new(),
            shadows: dec_shadows::Shadows::new(),
            brushes: dec_brushes::Brushes::new(),
            clipping: dec_clipping::Clipping::new(),
            grids: grids::Grids::new(),
            placement: placement::Placement::new(),
            a11y: a11y::Accessibility::new(),
        };
    }

    fn show_demo(ref this, id: i32) {
        this.selected = id;
        match mount::find("gallery:main") {
            option::Option[*core::Node]::Some(out) => {
                if id == ID_OVERVIEW {
                    let _ok: bool = mount::set_content(out, this.overview);
                } else if id == ID_BUTTON {
                    let _ok: bool = mount::set_content(out, this.buttons);
                } else if id == ID_LABEL {
                    let _ok: bool = mount::set_content(out, this.text);
                } else if id == ID_CONTROLS {
                    let _ok: bool = mount::set_content(out, this.controls);
                } else if id == ID_VALUES {
                    let _ok: bool = mount::set_content(out, this.values);
                } else if id == ID_INPUTS {
                    let _ok: bool = mount::set_content(out, this.inputs);
                } else if id == ID_PICKERS {
                    let _ok: bool = mount::set_content(out, this.pickers);
                } else if id == ID_ICONS {
                    let _ok: bool = mount::set_content(out, this.icons);
                } else if id == ID_IMAGES {
                    let _ok: bool = mount::set_content(out, this.images);
                } else if id == ID_SPANS {
                    let _ok: bool = mount::set_content(out, this.spans);
                } else if id == ID_GRAPHICS {
                    let _ok: bool = mount::set_content(out, this.graphics);
                } else if id == ID_WEB {
                    let _ok: bool = mount::set_content(out, this.web);
                } else if id == ID_LAYOUT {
                    let _ok: bool = mount::set_content(out, this.layout);
                } else if id == ID_SCROLL {
                    let _ok: bool = mount::set_content(out, this.scrolls);
                } else if id == ID_SPLIT {
                    let _ok: bool = mount::set_content(out, this.splits);
                } else if id == ID_ZSTACK {
                    let _ok: bool = mount::set_content(out, this.zstacks);
                } else if id == ID_RESPONSIVE {
                    let _ok: bool = mount::set_content(out, this.responsive);
                } else if id == ID_LIST {
                    let _ok: bool = mount::set_content(out, this.lists);
                } else if id == ID_COLLECTION {
                    let _ok: bool = mount::set_content(out, this.collections);
                } else if id == ID_TREE {
                    let _ok: bool = mount::set_content(out, this.trees);
                } else if id == ID_PAGE_DOTS {
                    let _ok: bool = mount::set_content(out, this.page_dots);
                } else if id == ID_TABLE {
                    let _ok: bool = mount::set_content(out, this.tables);
                } else if id == ID_REFRESH {
                    let _ok: bool = mount::set_content(out, this.refresh);
                } else if id == ID_SWIPE {
                    let _ok: bool = mount::set_content(out, this.swipe);
                } else if id == ID_CAROUSEL {
                    let _ok: bool = mount::set_content(out, this.carousel);
                } else if id == ID_ANIM_BASICS {
                    let _ok: bool = mount::set_content(out, this.anim_basics);
                } else if id == ID_ANIM_EASING {
                    let _ok: bool = mount::set_content(out, this.anim_easings);
                } else if id == ID_ANIM_ENTRANCE {
                    let _ok: bool = mount::set_content(out, this.anim_entrance);
                } else if id == ID_ANIM_RULES {
                    let _ok: bool = mount::set_content(out, this.anim_rules);
                } else if id == ID_SHADOW {
                    let _ok: bool = mount::set_content(out, this.shadows);
                } else if id == ID_BRUSH {
                    let _ok: bool = mount::set_content(out, this.brushes);
                } else if id == ID_CLIP {
                    let _ok: bool = mount::set_content(out, this.clipping);
                } else if id == ID_GRID {
                    let _ok: bool = mount::set_content(out, this.grids);
                } else if id == ID_PLACEMENT {
                    let _ok: bool = mount::set_content(out, this.placement);
                } else if id == ID_A11Y {
                    let _ok: bool = mount::set_content(out, this.a11y);
                }
            }
            option::Option::None => { }
        }
    }

    fn on_nav_select(ref this, node: *tree::TreeNode) {
        if node.is_null() { return; }
        if { (*node).is_branch } { return; }
        let id: i32 = demo_id_for({ (*node).id_of() });
        if id < 0 { return; }
        this.show_demo(id);
    }
}

impl Gallery: component::Component {
    fn build(ref this) -> core::Node {
        var head: core::Builder = core::Builder::new();
        head.add(ui::label(
            "Facet Gallery",
            key: "nav:title",
            font_size: 16.0,
            font_weight: vocab::FontWeight::Bold,
            text_color: vocab::Color::ink(),
        ));
        head.add(ui::label(
            "Widget reference",
            key: "nav:sub",
            font_size: 11.0,
            text_color: vocab::Color::ink(0.5),
        ));

        var side: core::Builder = core::Builder::new();
        side.add(core::column(head).padding(14.0).gap(2.0));
        side.add(ui::tree(
            catalog_model(),
            key: "gallery:nav",
            on_select: this.on_nav_select,
            row_height: 28.0,
        ).grow(1.0));

        var sidebar: core::Node = core::column(side).grow(1.0);
        sidebar.set_background_color(vocab::Color::raised());

        var main: core::Node = core::column(core::Builder::new(), key: "gallery:main")
            .grow(1.0);
        main.set_background_color(vocab::Color::surface());

        var panes: core::Builder = core::Builder::new();
        panes.add(sidebar);
        panes.add(main);
        return ui::split(
            panes,
            key: "gallery:split",
            axis: split::SplitAxis::Columns,
            position: 240.0,
            min_leading: 180.0,
            min_trailing: 360.0,
        ).grow(1.0);
    }
}

impl Gallery: component::Lifecycle {
    fn on_attach(ref this) {
        match tree::find("gallery:nav") {
            option::Option[tree::Tree]::Some(t) => {
                let _b: tree::Tree = t.expand(SEC_VIEWS);
                let _c: tree::Tree = t.expand(SEC_LAYOUT);
                let _d: tree::Tree = t.expand(SEC_COLLECTIONS);
                let _a: tree::Tree = t.expand(SEC_ANIMATION);
                let _dx: tree::Tree = t.expand(SEC_DECORATION);
                let _e: tree::Tree = t.expand(SEC_INTERACTION);
                let _f: tree::Tree = t.select(NAV_OVERVIEW);
            }
            option::Option::None => { }
        }
        this.show_demo(ID_OVERVIEW);
        // FACET_GALLERY_WALK=1 — visit every demo, one a tick, then quit.
        //
        // The gallery is the CONFORMANCE TARGET, and until now the only way to
        // exercise all thirty-five screens was thirty-five clicks. A build
        // walks them instead, which is what makes "does any demo warn, or
        // crash, or lay out to nothing" a question with an answer rather than
        // an afternoon. An agent has no hands; this is the part of the probe
        // problem that does not need any.
        //
        // Off unless the variable is set, so a person's run is untouched.
        if env::has_var("FACET_GALLERY_WALK") {
            WALK_SELF = #addr_of(this);
            start_walk();
        }
    }
    fn on_detach(ref this) { return; }
}

impl Gallery: screen::Screen {
    fn chrome(this) -> screen::Chrome {
        return screen::Chrome::new(
            title: "Facet Gallery",
            width: 1000.0,
            height: 680.0,
            min_width: 720.0,
            min_height: 480.0,
            // Pinch to magnify — the same flag the iOS gallery sets. Zoom is a
            // SCALE on the content view, never a relayout: the tree keeps its
            // sizes and the magnification rides on top, so a zoomed gallery is
            // the same tree bigger, not a reflowed one.
            zoomable: true,
            min_zoom: 1.0,
            max_zoom: 3.0,
        );
    }
    fn menu_items(this) -> vec::Vec[screen::MenuItem] {
        return vec::new::[screen::MenuItem]();
    }
}

fn screen_box() -> screen::ScreenBox {
    return screen::screen_box(Gallery::new());
}

// ---- the self-drive -----------------------------------------------------------
//
// One demo per tick, in id order, then quit. Slow enough that each screen gets
// a real layout pass and a paint — a walk that raced through would prove only
// that `build` does not crash, which is the cheap half.
static WALK_AT: i32 = 0;
// The screen itself, so the walk can drive `show_demo` — which is the whole
// point: building a demo is half the test, and MOUNTING it is the other half.
static WALK_SELF: *Gallery = #zero::[*Gallery]();

const WALK_INTERVAL: f64 = 0.22;

// `services::after`, not `g_timeout_add`. The walk was written against GLib
// directly, which links on Linux and leaves the gallery UNLINKABLE on macOS
// — an undefined `_g_timeout_add` at the very end of a full build. facet's
// scheduler is the portable seam and every backend fills it.
//
// The handle has to be KEPT: dropping a `Cancellable` cancels the timer it
// stands for, so a bare `let` would cancel itself at the end of the statement.
static WALK_TIMER: services::Cancellable = #zero::[services::Cancellable]();

fn start_walk() {
    WALK_TIMER = services::after(WALK_INTERVAL, walk_step, 0 as *u8);
}

fn walk_step(user: *u8) {
    if WALK_AT > ID_A11Y {
        io::println("gallery walk: visited ${WALK_AT} demos, no crash");
        // The walk ends by NOT re-arming, and the app is left running — a walk
        // that quit would take the exit code with it and hide anything printed
        // after.
        return;
    }
    let at: i32 = WALK_AT;
    WALK_AT = WALK_AT +% 1;
    if WALK_SELF.is_null() { return; }
    io::println("gallery walk: demo ${at}");
    { (*WALK_SELF).show_demo(at) };
    // `after` is ONE-SHOT, so each step arms the next. The backends allow it:
    // a fired slot is dead before the callback runs, precisely so the callback
    // can schedule another.
    WALK_TIMER = services::after(WALK_INTERVAL, walk_step, 0 as *u8);
}
