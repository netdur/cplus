import "facet/screen" as screen;
// Facet Gallery — single window, sidebar + main pane.

import "facet/theme" as theme;
import "facet/vocabulary" as vocab;
import "facet_runtime/runtime" as runtime;
import "stdlib/status" as status;
import "stdlib/env" as env;
import "facet_agent/agent" as agent;

import "./gallery" as gallery;

fn main() -> i32 {


    var app: runtime::App = runtime::App::new("Facet Gallery");
    app.on_launch(configure_theme);
    app.window("gallery", gallery::screen_box, chrome: screen::Chrome::new(
            title: "Facet Gallery",
            width: 1000.0,
            height: 680.0,
            min_width: 720.0,
            min_height: 480.0,
            // Pinch to magnify — the same flag the iOS gallery sets. Zoom is a
            // SCALE on the content view, never a relayout: the tree keeps its
            // sizes and the magnification rides on top, so a zoomed gallery is
            // the same tree bigger, not a reflowed one.
            zoomable: true,
            min_zoom: 1.0,
            max_zoom: 3.0,
        ));

    // FACET_GALLERY_AGENT=1 — serve the agent surface on a Unix socket.
    //
    // Two lines is the whole opt-in, which is the point of the tier: an app
    // that does not call these links none of the agent stack. It is behind a
    // variable here because the gallery is a REFERENCE, and a reference that
    // opens a socket by default would teach the wrong default.
    if env::has_var("FACET_GALLERY_AGENT") {
        agent::enable();
        // An ID, not a path: the platform derives the address from it
        // (`/tmp/mcp-<id>-<pid>.socket` here, a loopback port on mobile). This
        // said "/tmp/facet-gallery.sock" until 2026-08-30 and had therefore
        // been refused at startup — "is not a valid id (a NAME, not a path)" —
        // since the address stopped being configured. It still built, which is
        // the whole trap with examples.
        app.agent_mcp("facet_gallery");
    }

    match app.run("gallery") {
        status::Status::Ok => { return 0; }
        _other => { return 1; }
    }
}

fn configure_theme(ctx: *u8) {
    theme::set_theme(theme::Theme::new(
        primary: vocab::Color::rgba(0.35, 0.42, 0.95, 1.0),
        surface: vocab::Color::adaptive(
            light: vocab::Color::rgba(0.94, 0.94, 0.96, 1.0),
            dark: vocab::Color::rgba(0.09, 0.09, 0.11, 1.0),
        ),
    ));
}
