// sidebar_demo — a window with the platform's own sidebar.
//
// WHAT MAKES IT A SIDEBAR, and it is all of it:
//
//   1. the leading pane of a `split` declares `role_leading: PaneRole::Sidebar`
//   2. the window asks for `Bar::Blended`
//
// (1) is portable vocabulary: every backend reads the role and honours what it
// can, so this tree runs anywhere. (2) lets content run under the title bar,
// which is what lets the sidebar reach the top of the window and the window
// buttons sit inside it.
//
// TO SEE ALL FOUR COMBINATIONS WITHOUT EDITING, this demo reads the two
// switches from the environment. In your own app you write the value you want
// — `role_leading: split::PaneRole::Sidebar` and `bar: screen::Bar::Blended`
// — and there is nothing to configure.
//
//   ./sidebar_demo                             sidebar + blended (Finder's)
//   SIDEBAR_DEMO_NATIVE_BAR=1 ./sidebar_demo   sidebar + ordinary title bar
//   SIDEBAR_DEMO_NO_ROLE=1 ./sidebar_demo      facet's own split, blended bar
//   SIDEBAR_DEMO_NO_ROLE=1 SIDEBAR_DEMO_NATIVE_BAR=1 ./sidebar_demo   ordinary
//
// The role and the bar are INDEPENDENT: the role decides whether the pane is
// the platform's sidebar (its glass, its item), the bar decides the window's
// chrome. All four are legal.
//
// TO GET AN ORDINARY WINDOW, take either one away:
//
//   * drop the `role_leading` argument and the split is facet's own — same
//     panes, same divider, same `position` / `min` / `max` / `on_move`;
//   * keep the role but pass `Bar::Native` and the pane still gets the
//     platform's sidebar treatment, with the title bar left as a strip above.
//
// Nothing else in this file changes between those spellings, which is the
// point: a role is a hint, not a different tree.

import "stdlib/option" as option;
import "stdlib/env" as env;
import "stdlib/text" as text;
import "facet/facet" as core;
import "facet/elements" as ui;
import "facet/component" as component;
import "facet/split" as split;
import "facet/list" as list;
import "facet/label" as label;
import "facet/screen" as screen;
import "facet/vocabulary" as vocab;
import "facet_runtime/runtime" as runtime;
import "flex_layout/flex_layout" as flex;

const NAV: str = "nav";
const TITLE: str = "title";
const BODY: str = "body";

// ---- the content, keyed by row ------------------------------------------------

fn section_name(i: usize) -> str {
    if i == (0 as usize) { return "Overview"; }
    if i == (1 as usize) { return "Recents"; }
    if i == (2 as usize) { return "Documents"; }
    if i == (3 as usize) { return "Downloads"; }
    return "Workspace";
}

fn section_body(i: usize) -> str {
    if i == (0 as usize) {
        return "The pane on the left is PaneRole::Sidebar. AppKit realises it as an NSSplitViewItem with the sidebar behaviour, and supplies the glass itself.";
    }
    if i == (1 as usize) {
        return "Selecting a row does not rebuild the tree. The handler finds the two keyed labels and writes them — facet has no re-render.";
    }
    if i == (2 as usize) {
        return "Drag the divider. The panes resize and this text reflows with them, because the backend hears the move and asks for a layout pass.";
    }
    if i == (3 as usize) {
        return "The sidebar keeps its own minimum. Try dragging the divider all the way left: it stops where min_leading says.";
    }
    return "Take the role_leading argument out of build() and this is an ordinary split in an ordinary window, with everything else unchanged.";
}

fn write_label(key: str, v: str) {
    match label::find(key) {
        option::Option[label::Label]::Some(l) => { let _l: label::Label = l.set_text(v); }
        option::Option::None => { }
    }
}

fn on_nav_selected(sender: *u8, ctx: *u8) {
    match list::find(NAV) {
        option::Option[list::List]::Some(l) => {
            let i: i64 = l.selected_index();
            if i < (0 as i64) { return; }
            write_label(TITLE, section_name(i as usize));
            write_label(BODY, section_body(i as usize));
        }
        option::Option::None => { }
    }
    return;
}

// ---- the two panes ------------------------------------------------------------

fn section_icon(i: usize) -> str {
    if i == (0 as usize) { return "square.grid.2x2"; }
    if i == (1 as usize) { return "clock"; }
    if i == (2 as usize) { return "doc"; }
    if i == (3 as usize) { return "arrow.down.circle"; }
    return "folder";
}

// A sidebar row: an SF Symbol, a gap, then the name — the shape Finder's rows
// have. Built WITHOUT an `@ui` block on purpose: a block finishes as a
// grouping, and the list places the node it is handed, so a row must BE the
// row rather than a wrapper around one.
//
// NOTHING here paints a background. The glass is behind the pane, and an
// opaque row would sit on top of it and hide it — the same way the list's own
// scroll view did until `create_recycling_list` stopped drawing one.
fn nav_row(i: usize, ctx: *u8) -> core::Node {
    var b: core::Builder = core::Builder::new();
    b.add(ui::image(section_icon(i))
          .width(17.0f64)
          .height(17.0f64));
    b.add(ui::label(section_name(i), font_size: 13.0f64)
          .grow(1.0f64));
    return ui::row(b)
        .align(flex::Align::Center)
        .gap(8.0f64)
        .padding(7.0f64);
}

fn sidebar() -> core::Node {
    // `row_height` is answered WITHOUT building the row, so the list can size
    // ten thousand of them without making one. 32pt is the system's own
    // sidebar row: enough for a 17pt symbol with room to breathe.
    var l: core::Node = ui::list(key: NAV,
                                 row_height: 32 as i64,
                                 selection_mode: vocab::SelectionMode::Single,
                                 separator: vocab::Separator::None,
                                 on_item_selected: on_nav_selected);
    match list::from(#addr_of(l) as *core::Node) {
        option::Option[list::List]::Some(h) => {
            let a: list::List = h.set_count(5 as usize);
            let b: list::List = a.set_row(nav_row);
            let _c: list::List = b.set_selected_index(0 as i64);
        }
        option::Option::None => { }
    }
    // The list inset from the glass edge, the way a sidebar's content is.
    var w: core::Builder = core::Builder::new();
    w.add(l.grow(1.0f64).shrink(1.0f64));
    return ui::column(w, key: "sidebar").padding(8.0f64);
}

fn content() -> core::Node {
    var b: core::Builder = core::Builder::new();
    b.add(ui::label(section_name(0 as usize), key: TITLE, font_size: 22.0f64)
          .padding(4.0f64));
    b.add(ui::label(section_body(0 as usize), key: BODY, font_size: 13.0f64)
          .padding(4.0f64));
    return ui::column(b, key: "content").padding(24.0f64);
}

// ---- the sidebar's own button -------------------------------------------------
// A `toolbar_item` placed `Sidebar` sits in the band OVER the sidebar rather
// than over the content — top-left is where the window buttons already are, so
// this lands top-right of the panel, which is where the system's own apps put
// a "new" button. `icon` is an SF Symbol name.

fn on_new_clicked(sender: *u8, ctx: *u8) {
    write_label(TITLE, "New");
    write_label(BODY, "The compose button at the top of the sidebar is a toolbar_item with placement: ToolbarPlacement::Sidebar. AppKit draws it over the sidebar because a tracking separator marks where the sidebar's half of the title band ends.");
    return;
}

// ---- the two switches ---------------------------------------------------------
// Read from the environment ONLY so one binary can show all four combinations.
// An app writes the value it wants, inline, where these are called.

fn pane_role() -> split::PaneRole {
    if env::has_var("SIDEBAR_DEMO_NO_ROLE") { return split::PaneRole::Content; }
    return split::PaneRole::Sidebar;
}

fn window_bar() -> screen::Bar {
    if env::has_var("SIDEBAR_DEMO_NATIVE_BAR") { return screen::Bar::Native; }
    return screen::Bar::Blended;
}

fn window_title() -> str {
    if env::has_var("SIDEBAR_DEMO_NO_ROLE") {
        if env::has_var("SIDEBAR_DEMO_NATIVE_BAR") { return "No role + Bar::Native"; }
        return "No role + Bar::Blended";
    }
    if env::has_var("SIDEBAR_DEMO_NATIVE_BAR") { return "Sidebar + Bar::Native"; }
    return "Sidebar + Bar::Blended";
}

// ---- the component ------------------------------------------------------------

struct Demo { _x: i32 }

impl Demo {
    fn new() -> Demo { return Demo { _x: 0 }; }
}

impl Demo: component::Component {
    fn build(ref this) -> core::Node {
        return @ui {
            toolbar_item("New",
                         key: "new",
                         placement: vocab::ToolbarPlacement::Sidebar,
                         // COMPOSE, not add. "New" makes a new thing — the
                         // system spells that `square.and.pencil`, the way
                         // Notes and Mail do. `plus` means add-to-this-list.
                         icon: "square.and.pencil",
                         on_clicked: on_new_clicked)
            split(key: "main",
                  position: 220.0f64,
                  min_leading: 180.0f64,
                  max_leading: 320.0f64,
                  // (1) THE ROLE. Write `split::PaneRole::Sidebar` here; this
                  // demo defers to the environment so one binary shows both.
                  role_leading: pane_role()) {
                sidebar()
                content()
            }
        };
    }
}

impl Demo: component::Lifecycle {
    fn on_attach(ref this, why: component::Attach) { return; }
    fn on_detach(ref this, why: component::Detach) { return; }
}

fn main() -> i32 {
    // (2) THE BAR. Write `screen::Bar::Blended` here; `Bar::Native` gives the
    // same tree an ordinary title bar, with the sidebar pane still native and
    // still glass. The title names the combination so a screenshot says which.
    runtime::run_component(Demo::new(), title: window_title(),
                           width: 820.0f64, height: 520.0f64,
                           bar: window_bar());
    return 0;
}
