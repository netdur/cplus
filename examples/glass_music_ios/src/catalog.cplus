import "facet/vocabulary" as vocab;
import "stdlib/option" as option;

import "./helpers" as helpers;

const NEW_RELEASES: str = "New Releases";
const TOP_PICKS: str = "Top Picks";
const TODAYS_HITS: str = "Today's Hits";

struct Album {
    key: str,
    title: str,
    artist: str,
    shelf: str,
    from: vocab::Color,
    to: vocab::Color,
}

fn album(key: str, title: str, artist: str, shelf: str,
         from: vocab::Color, to: vocab::Color) -> Album {
    return Album { key: key, title: title, artist: artist, shelf: shelf, from: from, to: to };
}

fn albums() -> [Album; 9] {
    return [
        album("cloud-9", "Cloud 9", "Megan Moroney", NEW_RELEASES, helpers::pink(), helpers::rose()),
        album("fidelity", "Fidelity", "Yaya Bey", NEW_RELEASES, helpers::sky(), helpers::ink()),
        album("desire", "Desire", "Kehlani", NEW_RELEASES, helpers::crimson(), helpers::rose()),
        album("golden-hour", "Golden Hour", "Kacey Musgraves", TOP_PICKS, helpers::amber(), helpers::rose()),
        album("night-drive", "Night Drive", "Chromatics", TOP_PICKS, helpers::violet(), helpers::ink()),
        album("tidal", "Tidal", "Fiona Apple", TOP_PICKS, helpers::teal(), helpers::sky()),
        album("with-me", "With Me", "John Summit & Julia Wolf", TODAYS_HITS, helpers::sky(), helpers::pink()),
        album("red-room", "Red Room", "Rina Sawayama", TODAYS_HITS, helpers::red(), helpers::crimson()),
        album("lavender", "Lavender", "Clairo", TODAYS_HITS, helpers::violet(), helpers::pink()),
    ];
}

fn find(key: str) -> option::Option[Album] {
    let all: [Album; 9] = albums();
    for i in 0..9 {
        let a: Album = all[i as usize];
        if a.key == key { return option::Option[Album]::Some(a); }
    }
    return option::Option[Album]::None;
}
