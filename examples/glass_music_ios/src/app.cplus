import "facet/screen" as screen;
import "facet_runtime/runtime" as runtime;
import "facet_agent/agent" as agent;
import "stdlib/status" as status;

import "./shell" as shell;
import "./screens/home" as home;
import "./screens/new_music" as new_music;
import "./screens/radio" as radio;
import "./screens/library" as library;
import "./screens/search" as search;
import "./screens/album" as album;
import "./screens/now_playing" as now_playing;

fn run() -> i32 {
    agent::enable();

    let app: runtime::App = runtime::App::new("glass_music_ios");
    let music = app.window("music", shell::Shell::boxed,
                           chrome: screen::Chrome::new(title: "Music", width: 1100.0, height: 760.0));
    music.route("home", home::Home::boxed);
    music.route("new", new_music::NewMusic::boxed);
    music.route("radio", radio::Radio::boxed);
    music.route("library", library::Library::boxed);
    music.route("search", search::Search::boxed);
    music.route("album", album::AlbumPage::boxed);
    music.route("now_playing", now_playing::NowPlaying::boxed);

    app.agent_mcp();
    if app.run("music") == status::Status::Ok { return 0; }
    return 1;
}
