import "facet/facet" as core;
import "facet/elements" as ui;
import "facet/component" as component;
import "facet/screen" as screen;
import "facet/icons" as icons;

import "./helpers" as helpers;

struct Shell { }

impl Shell {
    fn boxed() -> screen::ScreenBox {
        return screen::screen_box::[Shell](Shell { });
    }
}

impl Shell: component::Component {
    fn build(ref this) -> core::Node {
        return @ui {
            tabs(key: "tabs", selected_index: 1, selected_tab_color: helpers::red()) {
                slot(name: "home", route: "home") { }
                    .set_tab_title("Home")
                    .set_tab_symbol(icons::home)
                slot(name: "new", route: "new") { }
                    .set_tab_title("New")
                    .set_tab_symbol(icons::grid_view)
                slot(name: "radio", route: "radio") { }
                    .set_tab_title("Radio")
                    .set_tab_symbol(icons::podcasts)
                slot(name: "library", route: "library") { }
                    .set_tab_title("Library")
                    .set_tab_symbol(icons::library_music)
                slot(name: "search", route: "search") { }
                    .set_tab_title("Search")
                    .set_tab_symbol(icons::search)
            }
                .grow(1.0)
        };
    }
}

impl Shell: component::Lifecycle { }
impl Shell: screen::Screen { }
