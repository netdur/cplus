import "facet/facet" as core;
import "facet/component" as component;
import "facet/screen" as screen;

import "../helpers" as helpers;

struct Radio { }

impl Radio {
    fn boxed() -> screen::ScreenBox {
        return screen::screen_box::[Radio](Radio { });
    }
}

impl Radio: component::Component {
    fn build(ref this) -> core::Node {
        return helpers::placeholder_page("Radio");
    }
}

impl Radio: component::Lifecycle { }
impl Radio: screen::Screen { }
