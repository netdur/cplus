import "flex_layout/flex_layout" as flex;
import "facet/facet" as core;
import "facet/elements" as ui;
import "facet/component" as component;
import "facet/screen" as screen;
import "facet/nav" as nav;
import "facet/vocabulary" as vocab;
import "facet/icons" as icons;
import "facet/gestures" as gestures;
import "stdlib/option" as option;
import "stdlib/vec" as vec;

import "../helpers" as helpers;
import "../catalog" as catalog;

struct AlbumPage {
    context: nav::Context,
}

impl AlbumPage {
    fn boxed() -> screen::ScreenBox {
        return screen::screen_box::[AlbumPage](AlbumPage { context: nav::Context::none() });
    }

    fn on_back_click(ref this, sender: *u8) -> bool {
        let _popped: bool = this.context.navigator().pop();
        return true;
    }
}

impl AlbumPage: component::Component {
    fn build(ref this) -> core::Node {
        var album: catalog::Album = catalog::album("", "Unknown album", "",
                                                   helpers::ink(), helpers::ink());
        match catalog::find(this.context.arg()) {
            option::Option[catalog::Album]::Some(a) => { album = a; }
            option::Option[catalog::Album]::None => { }
        }
        let art: core::Node = helpers::artwork(album.from, album.to, 320.0);
        return @ui {
            scroll(key: "album:page", axis: vocab::ScrollAxis::Vertical) {
                column {
                    hstack(key: "album:back") {
                        symbol(icons::chevron_left, size: 28.0, color: helpers::red())
                        label("Back", named_size: vocab::NamedSize::Body,
                              text_color: helpers::red())
                    }
                        .gesture(on_click: this.on_back_click)
                    column {
                        art
                        label(album.title, named_size: vocab::NamedSize::Title,
                              font_weight: vocab::FontWeight::Bold)
                        label(album.artist, named_size: vocab::NamedSize::Large,
                              text_color: helpers::red())
                    }
                        .gap(8.0)
                        .align(flex::Align::Center)
                }
                    .gap(20.0)
                    .padding_edge(flex::Edge::Horizontal, 20.0)
                    .padding_edge(flex::Edge::Vertical, 12.0)
            }
        };
    }
}

impl AlbumPage: component::Lifecycle {
    fn on_attach(ref this, why: component::Attach) { }
    fn on_detach(ref this, why: component::Detach) { }
}

impl AlbumPage: screen::Screen {
    fn on_context(ref this, context: nav::Context) { this.context = context; }
    fn menu_items(this) -> vec::Vec[screen::MenuItem] { return vec::new::[screen::MenuItem](); }
}
