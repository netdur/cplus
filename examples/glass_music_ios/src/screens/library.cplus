import "facet/facet" as core;
import "facet/component" as component;
import "facet/screen" as screen;

import "../helpers" as helpers;

struct Library { }

impl Library {
    fn boxed() -> screen::ScreenBox {
        return screen::screen_box::[Library](Library { });
    }
}

impl Library: component::Component {
    fn build(ref this) -> core::Node {
        return helpers::placeholder_page("Library");
    }
}

impl Library: component::Lifecycle { }
impl Library: screen::Screen { }
