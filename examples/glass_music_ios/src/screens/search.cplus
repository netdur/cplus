import "facet/facet" as core;
import "facet/component" as component;
import "facet/screen" as screen;

import "../helpers" as helpers;

struct Search { }

impl Search {
    fn boxed() -> screen::ScreenBox {
        return screen::screen_box::[Search](Search { });
    }
}

impl Search: component::Component {
    fn build(ref this) -> core::Node {
        return helpers::placeholder_page("Search");
    }
}

impl Search: component::Lifecycle { }
impl Search: screen::Screen { }
