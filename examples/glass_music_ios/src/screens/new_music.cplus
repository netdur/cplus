import "flex_layout/flex_layout" as flex;
import "facet/facet" as core;
import "facet/elements" as ui;
import "facet/component" as component;
import "facet/screen" as screen;
import "facet/nav" as nav;
import "facet/vocabulary" as vocab;
import "stdlib/option" as option;
import "stdlib/text" as text;
import "stdlib/vec" as vec;

import "../helpers" as helpers;
import "../catalog" as catalog;

struct NewMusic {
    context: nav::Context,
}

impl NewMusic {
    fn boxed() -> screen::ScreenBox {
        return screen::screen_box::[NewMusic](NewMusic { context: nav::Context::none() });
    }

    fn on_album_click(ref this, sender: *u8) -> bool {
        let key: text::Text = component::key_of(sender);
        let _pushed: bool = this.context.navigator().push("album", arg: key.view(), into: "new");
        return true;
    }

    fn cards(ref this, albums: vec::Vec[catalog::Album]) -> core::Builder {
        var b: core::Builder = core::Builder::new();
        var i: usize = 0 as usize;
        while i < albums.count() {
            match albums.at_ptr(i) {
                option::Option[*catalog::Album]::Some(a) => {
                    b.add(helpers::album_card({ (*a).key }, { (*a).title }, { (*a).artist },
                                              { (*a).from }, { (*a).to },
                                              on_open: this.on_album_click));
                }
                option::Option[*catalog::Album]::None => { }
            }
            i = i +% (1 as usize);
        }
        return b;
    }
}

impl NewMusic: component::Component {
    fn build(ref this) -> core::Node {
        let title: core::Node = helpers::page_title("New");
        let releases: core::Node = helpers::shelf("releases", "New Releases",
                                                  this.cards(catalog::new_releases()));
        let picks: core::Node = helpers::shelf("picks", "Top Picks",
                                               this.cards(catalog::top_picks()));
        let hits: core::Node = helpers::shelf("hits", "Today's Hits",
                                              this.cards(catalog::todays_hits()));
        return @ui {
            scroll(key: "new:page", axis: vocab::ScrollAxis::Vertical) {
                column {
                    title
                    releases
                    picks
                    hits
                }
                    .gap(28.0)
                    .padding_edge(flex::Edge::Vertical, 12.0)
            }
        };
    }
}

impl NewMusic: component::Lifecycle {
    fn on_attach(ref this, why: component::Attach) { }
    fn on_detach(ref this, why: component::Detach) { }
}

impl NewMusic: screen::Screen {
    fn on_context(ref this, context: nav::Context) { this.context = context; }
    fn menu_items(this) -> vec::Vec[screen::MenuItem] { return vec::new::[screen::MenuItem](); }
}
