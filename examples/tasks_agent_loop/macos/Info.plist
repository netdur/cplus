    <key>NSMicrophoneUsageDescription</key>
    <string>Tasks_agent_loop uses the microphone to …</string>
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>Tasks_agent_loop uses your location to …</string>
    <key>NSPhotoLibraryUsageDescription</key>
    <string>Tasks_agent_loop reads your photo library to …</string>
    -->
</dict>
</plist>
