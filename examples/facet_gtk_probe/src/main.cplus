// facet_gtk probe — one window, one control of each kind the GTK backend has a
// body for, and a status label every handler writes into.
//
// WHY THIS IS AN APP AND NOT A TEST. `cpc test` can pin a state machine; it
// cannot tell you that the switch reported its change, that the slider fired
// while it was being dragged, or that a field kept its caret when the
// application wrote text back into it. An agent has no hands. So this is the
// thing to RUN after touching the backend:
//
//     cd examples/facet_gtk_probe && ../../target/release/cpc run
//
// Every line the status label shows is a handler that fired. A control that
// visibly does something while the label stays still is a broken read half for
// that kind — which is the failure this probe exists to make obvious, because
// it is invisible from the write side.

import "stdlib/option" as option;
import "stdlib/status" as status;
import "stdlib/text" as text;
import "flex_layout/flex_layout" as flex;
import "facet/facet" as core;
import "facet/elements" as ui;
import "facet/label" as label;
import "facet/button" as button;
import "facet/toggle" as toggle;
import "facet/checkbox" as checkbox;
import "facet/slider" as slider;
import "facet/stepper" as stepper;
import "facet/text_field" as text_field;
import "facet/component" as component;
import "facet/mount" as mount;
import "facet/gestures" as gestures;
import "facet/scroll" as scroll;
import "facet/canvas" as canvas;
import "facet/span" as span;
import "facet/text_area" as text_area;
import "facet/progress" as progress;
import "facet/image" as image;
import "facet/icons" as icons;
import "facet/list" as flist;
import "facet/vocabulary" as vocab;
import "facet_gtk/facet_gtk" as backend;
import "glib/glib" as glib;

const STATUS: str = "probe:status";

// The one thing every handler does: say what it just heard. Reading the
// control's own value back proves the READ half, not only that the signal
// arrived — a handler that fires with a stale value is its own bug.
fn say(msg: str) {
    match label::find(STATUS) {
        option::Option[label::Label]::Some(l) => { let _l: label::Label = l.set_text(msg); }
        option::Option::None => { }
    }
}

fn on_click(sender: *u8, ctx: *u8) {
    say("button: clicked");
}

fn on_toggle_click(sender: *u8, ctx: *u8) {
    match button::find("probe:toggling") {
        option::Option[button::Button]::Some(b) => {
            if b.is_on() { say("toggling button: ON"); } else { say("toggling button: off"); }
        }
        option::Option::None => { say("toggling button: no cursor"); }
    }
}

fn on_switch(sender: *u8, ctx: *u8) {
    match toggle::find("probe:switch") {
        option::Option[toggle::Toggle]::Some(t) => {
            if t.on() { say("toggle: on"); } else { say("toggle: off"); }
        }
        option::Option::None => { say("toggle: no cursor"); }
    }
}

fn on_check(sender: *u8, ctx: *u8) {
    match checkbox::find("probe:check") {
        option::Option[checkbox::Checkbox]::Some(c) => {
            if c.on() { say("checkbox: checked"); } else { say("checkbox: unchecked"); }
        }
        option::Option::None => { say("checkbox: no cursor"); }
    }
}

fn on_slide(sender: *u8, ctx: *u8) {
    match slider::find("probe:slider") {
        option::Option[slider::Slider]::Some(s) => {
            let pct: i32 = (s.value() * 100.0) as i32;
            say_owned("slider: ${pct}%");
        }
        option::Option::None => { say("slider: no cursor"); }
    }
}

fn on_step(sender: *u8, ctx: *u8) {
    match stepper::find("probe:stepper") {
        option::Option[stepper::Stepper]::Some(s) => {
            let v: i32 = s.value() as i32;
            say_owned("stepper: ${v}");
        }
        option::Option::None => { say("stepper: no cursor"); }
    }
}

fn on_typed(sender: *u8, ctx: *u8) {
    match text_field::find("probe:field") {
        option::Option[text_field::TextField]::Some(f) => {
            let t: str = f.text();
            say_owned("text_field: \"${t}\"");
        }
        option::Option::None => { say("text_field: no cursor"); }
    }
}

fn on_submit(sender: *u8, ctx: *u8) {
    say("text_field: submitted (Return)");
}

fn on_radio(sender: *u8, ctx: *u8) {
    // The sender's KEY is what tells the two rows apart with one handler —
    // `component::key_of` through the backend's sender readers.
    let k: text::Text = component::key_of(sender);
    say_owned("radio: ${k}");
}

// ---- drag and drop -------------------------------------------------------
//
// The payload facet drags is the SOURCE NODE'S KEY, so a drop handler asking
// `component::dropped_text(sender)` learns which card arrived — and
// `drop_position` says where in the zone it landed, which is the difference
// between "append it" and "put it before the one you aimed at".

fn on_drag_start(sender: *u8, ctx: *u8) -> bool {
    let k: text::Text = component::key_of(sender);
    say_owned("drag: started from ${k}");
    return true;
}

fn on_drag_over(sender: *u8, ctx: *u8) -> bool {
    say("drop zone: a drag is over it");
    return true;
}

fn on_drag_leave(sender: *u8, ctx: *u8) -> bool {
    say("drop zone: the drag left");
    return true;
}

fn on_drop(sender: *u8, ctx: *u8) -> bool {
    let what: text::Text = component::dropped_text(sender);
    match component::drop_position(sender) {
        option::Option[vocab::Point]::Some(p) => {
            let x: i32 = p.x as i32;
            let y: i32 = p.y as i32;
            say_owned("drop: \"${what}\" at ${x},${y}");
        }
        option::Option::None => {
            // A position-less drop is the reader saying it was not told, which
            // is a different thing from a drop at the origin.
            say_owned("drop: \"${what}\" — NO POSITION (reader is not wired)");
        }
    }
    return true;
}

fn on_drop_completed(sender: *u8, ctx: *u8) -> bool {
    say("drag: finished");
    return true;
}

// A coloured box with a label on it, dragged by its key.
fn card(key: str, title: str, hue: f64) -> core::Node {
    var b: core::Builder = core::Builder::new();
    b.add(ui::label(title, font_size: 13.0));
    var n: core::Node = core::column(b, key: key);
    n.set_background_color(vocab::Color::rgba(hue, 0.75, 0.95, 1.0));
    n.set_corner_radius(vocab::Corners::all(6.0));
    n.set_padding(flex::Edge::All, flex::StyleLength::points(8.0));
    return n.gesture(can_drag: true, on_drag_start: on_drag_start,
                     on_drop_completed: on_drop_completed);
}

fn say_owned(t: text::Text) {
    say(t.view());
}

fn on_scrolled(sender: *u8, ctx: *u8) {
    match scroll::find("probe:scroll") {
        option::Option[scroll::Scroll]::Some(s) => {
            let y: i32 = s.scroll_y() as i32;
            say_owned("scroll: y = ${y}");
        }
        option::Option::None => { say("scroll: no cursor"); }
    }
}

// ---- the canvas ----------------------------------------------------------
//
// The one part of facet a test cannot reach at all: a `Drawable` RECORDS
// commands and the backend replays them, so what is on screen is the only
// evidence the replay is right. Every shape below is one command family —
// if a rectangle is square and an ellipse is round and the arc opens the way
// the label says, the replay is working.
//
// A MIRRORED ARC is the failure to look for. cairo's y grows downward, so its
// `arc` sweeps clockwise on screen while its name reads mathematically; taking
// the name at face value draws the arc the other way and nothing else looks
// wrong.

fn draw_probe(into: *vocab::Canvas, dirty: vocab::Rect, ctx: *u8) {
    let c: *vocab::Canvas = into;

    // A stroked rectangle and a filled one.
    let _s1: status::Status = { (*c).set_stroke(vocab::Color::rgba(0.2, 0.2, 0.2, 1.0)) };
    let _s2: status::Status = { (*c).set_stroke_width(2.0) };
    let _s3: status::Status = { (*c).draw_rect(vocab::Rect::of(8.0, 8.0, 60.0, 40.0)) };
    let _s4: status::Status = { (*c).set_fill(vocab::Color::rgba(0.9, 0.3, 0.3, 1.0)) };
    let _s5: status::Status = { (*c).fill_rect(vocab::Rect::of(78.0, 8.0, 60.0, 40.0)) };

    // Rounded, and an ellipse — the two shapes cairo has no call for.
    let _s6: status::Status = { (*c).set_fill(vocab::Color::rgba(0.3, 0.6, 0.9, 1.0)) };
    let _s7: status::Status = { (*c).fill_rounded_rect(vocab::Rect::of(148.0, 8.0, 60.0, 40.0), 12.0) };
    let _s8: status::Status = { (*c).set_fill(vocab::Color::rgba(0.4, 0.8, 0.4, 1.0)) };
    let _s9: status::Status = { (*c).fill_ellipse(vocab::Rect::of(218.0, 8.0, 60.0, 40.0)) };

    // A QUARTER ARC from 0 to 90 degrees, clockwise. On screen that runs from
    // the RIGHT of the box downward — if it runs upward the sweep is mirrored.
    let _sa: status::Status = { (*c).set_stroke(vocab::Color::rgba(0.6, 0.2, 0.7, 1.0)) };
    let _sb: status::Status = { (*c).set_stroke_width(3.0) };
    let _sc: status::Status = { (*c).draw_arc(vocab::Rect::of(8.0, 58.0, 60.0, 60.0),
                                              0.0, 90.0, true, false) };

    // A dashed line, which is the dash array and the cap together.
    let _sd: status::Status = { (*c).set_stroke_dash(vocab::Dashes::of(6.0, 4.0), 0.0) };
    let _se: status::Status = { (*c).set_stroke_cap(vocab::LineCap::Round) };
    let _sf: status::Status = { (*c).draw_line(vocab::Point::of(78.0, 88.0),
                                               vocab::Point::of(278.0, 88.0)) };
    let _sg: status::Status = { (*c).set_stroke_dash(vocab::Dashes::none(), 0.0) };

    // A path: a triangle, closed and filled — `move_to`, two lines, `close`.
    var tri: vocab::Path = vocab::Path::new();
    let _m: status::Status = tri.move_to(vocab::Point::of(88.0, 158.0));
    let _l1: status::Status = tri.line_to(vocab::Point::of(138.0, 158.0));
    let _l2: status::Status = tri.line_to(vocab::Point::of(113.0, 118.0));
    let _cl: status::Status = tri.close();
    let _sh: status::Status = { (*c).set_fill(vocab::Color::rgba(0.95, 0.7, 0.2, 1.0)) };
    let _si: status::Status = { (*c).fill_path(#addr_of(tri), vocab::Winding::NonZero) };

    // A GRADIENT fill — the one thing that is a cairo pattern rather than a
    // colour, and the axis runs at the brush's angle.
    let band: vocab::Rect = vocab::Rect::of(158.0, 108.0, 120.0, 50.0);
    let _sj: status::Status = { (*c).set_fill_brush(vocab::Brush {
        start: vocab::Color::rgba(0.1, 0.4, 0.9, 1.0),
        end: vocab::Color::rgba(0.9, 0.2, 0.5, 1.0),
        angle: 0.0, is_gradient: true }, band) };
    let _sk: status::Status = { (*c).fill_rect(band) };
    let _sl: status::Status = { (*c).set_fill(vocab::Color::rgba(0.0, 0.0, 0.0, 1.0)) };

    // Text at a BASELINE. Pango draws a layout from its top-left, so the
    // baseline is subtracted on the way in — if this line sits a line lower
    // than the shapes beside it, that subtraction is missing.
    let _sm: status::Status = { (*c).set_text_color(vocab::Color::rgba(0.15, 0.15, 0.15, 1.0)) };
    let _sn: status::Status = { (*c).set_font("", 13.0, vocab::FontWeight::Bold, false) };
    let _so: status::Status = { (*c).draw_text("canvas", vocab::Point::of(8.0, 178.0)) };

    // A TEXT BLOCK: wrapped and centred inside a box it must not leave. If it
    // draws as one line running off the right edge, the width never reached
    // Pango.
    let _sp: status::Status = { (*c).set_font("", 11.0, vocab::FontWeight::Regular, false) };
    let _sq: status::Status = { (*c).draw_text_block(
        "this paragraph is wrapped and centred inside a box, and it is clipped with an ellipsis if it will not fit",
        vocab::Rect::of(78.0, 190.0, 200.0, 46.0),
        vocab::TextAlign::Center, vocab::VerticalAlign::Top,
        vocab::TextFlow::Clip) };

    // A SPAN RUN: three runs, one styled per run. An ampersand is in there on
    // purpose — Pango's markup is XML, and an unescaped one ends the layout.
    var runs: vocab::Spans = vocab::Spans::new();
    let _r1: status::Status = runs.add(vocab::TextSpan::of("bold & ",
        font_size: 12.0, font_weight: vocab::FontWeight::Bold,
        color: vocab::Color::rgba(0.1, 0.1, 0.1, 1.0)));
    let _r2: status::Status = runs.add(vocab::TextSpan::of("italic ",
        font_size: 12.0, italic: true,
        color: vocab::Color::rgba(0.7, 0.2, 0.2, 1.0)));
    let _r3: status::Status = runs.add(vocab::TextSpan::of("underlined",
        font_size: 12.0, color: vocab::Color::rgba(0.1, 0.4, 0.8, 1.0),
        decoration: vocab::TextDecoration::Underline));
    let _sr: status::Status = { (*c).draw_spans(#addr_of(runs),
        vocab::Rect::of(8.0, 196.0, 60.0, 40.0)) };
}

// ---- the three things that move, and the editor -------------------------------
//
// `animate_progress` is the one verb in facet that asks a backend for a
// TWEEN. GTK has no property animation at all, so the bar is driven from a
// timeout; press the button and watch it — a jump to the target means the
// tween did not run, and a stop short of it means the last eased step was not
// landed exactly.

fn on_animate(sender: *u8, ctx: *u8) {
    match progress::find("probe:progress") {
        option::Option[progress::Progress]::Some(bar) => {
            // Toggle between the two ends so the button can be pressed twice.
            let to: f64 = if bar.progress() > 0.5 { 0.1 } else { 0.95 };
            let _b: progress::Progress = bar.animate_progress(
                to, duration: vocab::Duration::of_seconds(0.9),
                easing: vocab::Easing::BounceOut);
            say("progress: animating to ${to} with a bounce");
        }
        option::Option::None => { say("progress: not found"); }
    }
}

// A GIF, played by GdkPixbufAnimation because GtkPicture cannot. If the dot
// travels round the ring, the frame driver is running; if it sits still, the
// animation decoded and nothing is advancing it.
fn on_play_pause(sender: *u8, ctx: *u8) {
    match image::find("probe:gif") {
        option::Option[image::Image]::Some(img) => {
            let now: bool = !img.is_animation_playing();
            let _i: image::Image = img.set_animation_playing(now);
            say(if now { "image: playing" } else { "image: paused" });
        }
        option::Option::None => { say("image: not found"); }
    }
}

// STYLE RUNS on an editor: ranges of text that is already there, coloured and
// weighted without touching the string. Press the button and the first word
// turns red and bold, the second is struck through — if the whole paragraph
// changes instead, the ranges were applied to the wrong offsets.
fn on_style_runs(sender: *u8, ctx: *u8) {
    match text_area::find("probe:editor") {
        option::Option[text_area::TextArea]::Some(ed) => {
            var runs: vocab::StyleRuns = vocab::StyleRuns::new();
            let _a: status::Status = runs.add(vocab::StyleRun::of(
                0, 5,
                color: vocab::Color::rgba(0.8, 0.1, 0.1, 1.0),
                font_weight: vocab::FontWeight::Bold));
            let _b: status::Status = runs.add(vocab::StyleRun::of(
                6, 4,
                decoration: vocab::TextDecoration::Strikethrough));
            let _c: status::Status = runs.add(vocab::StyleRun::of(
                11, 4,
                background_color: vocab::Color::rgba(1.0, 0.95, 0.4, 1.0),
                italic: true));
            let _e: text_area::TextArea = ed.set_style_runs(runs);
            say("editor: three style runs applied");
        }
        option::Option::None => { say("editor: not found"); }
    }
}

fn on_editor_typed(sender: *u8, ctx: *u8) {
    say("editor: text changed — the box should grow with it");
}

// ---- the recycler ---------------------------------------------------------------
//
// FIVE THOUSAND ROWS. The point of this section is a number: every row this
// list has ever built increments `ROWS_BUILT`, and the button reports it. If it
// reads a few dozen after the window opens, the recycler is doing its job — GTK
// pooled a screenful of cells and facet built a subtree for each. If it reads
// 5000, every row was materialised and nothing is being recycled.
//
// Scroll it and press the button again: the number should climb by a handful
// per screen, not by a screenful.

static ROWS_BUILT: i64 = 0;

fn big_row(index: usize, ctx: *u8) -> flex::Node {
    ROWS_BUILT = ROWS_BUILT +% 1;
    var r: core::Node = ui::label("row ${index}", font_size: 13.0);
    r.set_height(flex::StyleLength::points(24.0));
    return r;
}

// The fine-grained verbs. Appending three rows says INSERT rather than "the
// count is now 5003" — the difference is whether the list rebinds three cells
// or every one it is showing. Press it while scrolled into the middle: the rows
// under the pointer must not move, and the counter must climb by about three.
fn on_append(sender: *u8, ctx: *u8) {
    match flist::find("probe:big") {
        option::Option[flist::List]::Some(l) => {
            let before: i64 = ROWS_BUILT;
            let _i: flist::List = l.insert_rows(l.count(), 3);
            say("appended 3 rows — built ${before} before, count is now ${l.count()}");
        }
        option::Option::None => { say("append: list not found"); }
    }
}

fn on_count_rows(sender: *u8, ctx: *u8) {
    say("rows BUILT so far: ${ROWS_BUILT} of 5000");
}

fn big_list() -> core::Node {
    var l: core::Node = ui::list(key: "probe:big", separator: vocab::Separator::Default);
    l.set_height(flex::StyleLength::points(160.0));
    match flist::from(#addr_of(l)) {
        option::Option[flist::List]::Some(h) => {
            let a: flist::List = h.set_count(5000);
            let _b: flist::List = a.set_row(big_row);
        }
        option::Option::None => { }
    }
    return l;
}

// ---- the window's own furniture ----------------------------------------------
//
// A `toolbar_item` has no frame: it is packed into the window's header bar,
// which the backend builds for its sake even though this probe asked for a
// plain window. If the three buttons are not in the title bar, the collection
// walk never ran; if they are in the WRONG order, the sort did not.

fn on_toolbar_new(sender: *u8, ctx: *u8) {
    say("toolbar: New (primary, leading)");
}

fn on_toolbar_share(sender: *u8, ctx: *u8) {
    say("toolbar: Share (default, trailing)");
}

fn on_toolbar_delete(sender: *u8, ctx: *u8) {
    say("toolbar: Delete (secondary, and it should be RED)");
}

// ---- swipe to reveal ----------------------------------------------------------
//
// GTK has no swipeable row, so this one is assembled: drag the row LEFT with
// the pointer and the two actions appear behind it. Past halfway it stays open
// when you let go, short of halfway it snaps back — that landing is the whole
// of `reveal_threshold` and it is the one thing a test cannot assert.

fn on_swipe_started(sender: *u8, ctx: *u8) {
    say("swipe: started");
}

fn on_swipe_changing(sender: *u8, ctx: *u8) {
    say("swipe: moving");
}

fn on_swipe_opened(sender: *u8, ctx: *u8) {
    say("swipe: open (past the threshold)");
}

fn on_swipe_closed(sender: *u8, ctx: *u8) {
    say("swipe: closed (short of the threshold)");
}

fn on_archive(sender: *u8, ctx: *u8) {
    say("swipe action: Archive invoked");
}

fn on_delete_row(sender: *u8, ctx: *u8) {
    say("swipe action: Delete invoked");
}

fn swipe_row() -> core::Node {
    var row: core::Node = ui::swipeable(key: "probe:swipe",
                                        reveal_threshold: 60.0,
                                        on_swipe_started: on_swipe_started,
                                        observe_swipe_changing: on_swipe_changing,
                                        on_open_requested: on_swipe_opened,
                                        on_close_requested: on_swipe_closed);
    row.set_height(flex::StyleLength::points(44.0));
    var content: core::Builder = core::Builder::new();
    content.add(ui::label("swipe me left", font_size: 13.0));
    var face: core::Node = core::column(content, key: "probe:swipe-face");
    face.set_background_color(vocab::Color::rgba(0.92, 0.92, 0.94, 1.0));
    face.set_padding(flex::Edge::All, flex::StyleLength::points(12.0));
    face.set_width(flex::StyleLength::percent(100.0));
    face.set_height(flex::StyleLength::percent(100.0));
    let _c: status::Status = row.add_child(face);
    let _a: status::Status = row.add_child(
        ui::swipe_item(key: "probe:swipe-archive", text: "Archive",
                       on_invoked: on_archive));
    let _d: status::Status = row.add_child(
        ui::swipe_item(key: "probe:swipe-delete", text: "Delete", destructive: true,
                       on_invoked: on_delete_row));
    return row;
}

fn tree() -> core::Node {
    var b: core::Builder = core::Builder::new();

    b.add(ui::label("facet_gtk probe — every line below is a handler firing",
                    key: "probe:title", font_size: 15.0,
                    font_weight: vocab::FontWeight::Bold));
    b.add(ui::label("(nothing yet)", key: STATUS, font_size: 13.0,
                    text_color: vocab::Color::rgba(0.2, 0.5, 0.9, 1.0)));

    b.add(ui::button("Click me", key: "probe:button", on_click: on_click));
    b.add(ui::button("Toggling button", key: "probe:toggling",
                     toggles: true, on_click: on_toggle_click));
    b.add(ui::toggle(false, key: "probe:switch", on_toggled: on_switch));
    b.add(ui::checkbox(false, key: "probe:check", on_checked_changed: on_check));
    b.add(ui::radio(true, key: "probe:radio-a", text: "First", group: "probe",
                    on_checked_changed: on_radio));
    b.add(ui::radio(false, key: "probe:radio-b", text: "Second", group: "probe",
                    on_checked_changed: on_radio));
    b.add(ui::slider(0.5, key: "probe:slider", minimum: 0.0, maximum: 1.0,
                     on_value_changed: on_slide));
    b.add(ui::stepper(3.0, key: "probe:stepper", increment: 1.0,
                      minimum: 0.0, maximum: 10.0, on_value_changed: on_step));
    b.add(ui::text_field("", key: "probe:field", placeholder: "type here",
                         on_text_changed: on_typed, on_submit: on_submit));
    b.add(ui::progress(0.35, key: "probe:progress"));
    b.add(ui::button("Animate the bar", key: "probe:animate", on_click: on_animate));

    // AUTO SIZE: the editor measures ITSELF from its text, so typing a second
    // line makes the box taller. Empty, it shows its placeholder — which a
    // GtkTextView does not have and this package supplies.
    b.add(ui::label("editor — auto-sizing, with a placeholder and style runs",
                    font_size: 12.0));
    b.add(ui::text_area("Alpha bravo charlie delta", key: "probe:editor",
                        auto_size: vocab::AutoSize::TextChanges,
                        placeholder: "clear me to see the placeholder",
                        on_text_changed: on_editor_typed));
    b.add(ui::button("Apply style runs", key: "probe:runs-btn",
                     on_click: on_style_runs));

    // The FILL axis of the bundled icon font, which is a font variation and not
    // two glyphs. Left is the outline, right is filled; identical glyphs mean
    // the variable font's axis was not reached.
    b.add(ui::label("symbol — the same glyph at fill 0 and fill 1",
                    font_size: 12.0));
    var glyphs: core::Builder = core::Builder::new();
    glyphs.add(ui::symbol(icons::favorite, key: "probe:sym-outline",
                          size: 28.0, fill: 0.0));
    glyphs.add(ui::symbol(icons::favorite, key: "probe:sym-filled",
                          size: 28.0, fill: 1.0));
    var glyph_row: core::Node = core::row(glyphs, key: "probe:symbols");
    glyph_row.set_gap(flex::Gutter::All, flex::StyleLength::points(12.0));
    b.add(glyph_row);

    // An ANIMATED image. GdkPixbufAnimation decodes the frames and this package
    // drives them; GtkPicture would show frame one forever on its own.
    b.add(ui::label("image — an animated GIF, played frame by frame",
                    font_size: 12.0));
    var gif: core::Node = ui::image("spinner.gif", key: "probe:gif",
                                    animation_playing: true);
    gif.set_width(flex::StyleLength::points(48.0));
    gif.set_height(flex::StyleLength::points(48.0));
    b.add(gif);
    b.add(ui::button("Play / pause the GIF", key: "probe:gif-btn",
                     on_click: on_play_pause));

    // THE TOOLBAR IS NOT HERE. These three nodes have no frame — they are read
    // out of the tree when the window opens and packed into its header bar —
    // so the space they take in this column is zero, which is itself the thing
    // to check: if a blank strip appears below the progress bar, `Display::None`
    // did not reach them.
    b.add(ui::toolbar_item("New", key: "probe:tb-new",
                           placement: vocab::ToolbarPlacement::Primary,
                           icon: "document-new-symbolic",
                           on_clicked: on_toolbar_new));
    b.add(ui::toolbar_item("Share", key: "probe:tb-share",
                           icon: "emblem-shared-symbolic",
                           on_clicked: on_toolbar_share));
    b.add(ui::toolbar_item("Delete", key: "probe:tb-del",
                           placement: vocab::ToolbarPlacement::Secondary,
                           destructive: true,
                           on_clicked: on_toolbar_delete));

    b.add(ui::label("list — 5000 rows, and the button says how many were BUILT",
                    font_size: 12.0));
    b.add(big_list());
    b.add(ui::button("How many rows were built?", key: "probe:rowcount",
                     on_click: on_count_rows));
    b.add(ui::button("Append 3 rows (a splice, not a reload)", key: "probe:append",
                     on_click: on_append));

    b.add(ui::label("swipe — drag the row left to reveal its actions",
                    font_size: 12.0));
    b.add(swipe_row());

    // The close / minimise / maximise group, which an application draws itself
    // under `Bar::Custom`. This window is decorated, so these are a SECOND set
    // beside the real ones — deliberately, because the point is that they act
    // on the real window: minimise here and the window minimises.
    b.add(ui::label("window controls — the group an app draws itself",
                    font_size: 12.0));
    b.add(ui::window_buttons(key: "probe:wbuttons"));

    // Drag either card onto the zone. The zone reports WHICH key arrived and
    // WHERE — both of which come back through the sender readers, not through
    // anything the handler was passed.
    b.add(ui::label("drag a card into the zone below", font_size: 12.0));
    var cards: core::Builder = core::Builder::new();
    cards.add(card("probe:card-a", "Card A", 0.85));
    cards.add(card("probe:card-b", "Card B", 0.45));
    var row: core::Node = core::row(cards, key: "probe:cards");
    row.set_gap(flex::Gutter::All, flex::StyleLength::points(8.0));
    b.add(row);

    var zb: core::Builder = core::Builder::new();
    zb.add(ui::label("drop zone", font_size: 12.0));
    var zone: core::Node = core::column(zb, key: "probe:zone");
    zone.set_background_color(vocab::Color::rgba(0.9, 0.9, 0.9, 1.0));
    zone.set_corner_radius(vocab::Corners::all(6.0));
    zone.set_padding(flex::Edge::All, flex::StyleLength::points(16.0));
    b.add(zone.gesture(allow_drop: true, on_drag_over: on_drag_over,
                       on_drag_leave: on_drag_leave, on_drop: on_drop));
    b.add(ui::spinner(vocab::Color::clear(), key: "probe:spinner", running: true));

    // The canvas. Nothing here reports to the status label — a drawing is
    // either right on screen or it is not, and that is the whole point of it
    // being in the probe.
    // A FORMATTED LABEL: span CHILDREN, which a label shows instead of its own
    // text. If the word "IGNORED" appears, the runs were not read; if the
    // ampersand ends the line, the markup was not escaped.
    var formatted: core::Node = ui::label("IGNORED", key: "probe:runs",
                                          font_size: 13.0);
    let _q1: bool = mount::add_child(#addr_of(formatted),
        ui::span("bold", font_weight: vocab::FontWeight::Bold));
    let _q2: bool = mount::add_child(#addr_of(formatted),
        ui::span(" · red & italic ", italic: true,
                 text_color: vocab::Color::rgba(0.8, 0.2, 0.2, 1.0)));
    let _q3: bool = mount::add_child(#addr_of(formatted),
        ui::span("underlined", text_decoration: vocab::TextDecoration::Underline));
    b.add(formatted);

    b.add(ui::label("canvas — shapes, a path, a gradient, and three kinds of text", font_size: 12.0));
    var art: core::Node = ui::canvas(key: "probe:canvas",
                                     drawable: vocab::Drawable::of(draw_probe));
    art.set_height(flex::StyleLength::points(250.0));
    b.add(art);

    // A WEB VIEW, whose engine is opened at RUNTIME rather than linked. On a
    // machine with WebKitGTK this renders the page; on one without, it is an
    // empty box and the process printed one line saying which library it
    // looked for — which is the designed behaviour and not a failure.
    b.add(ui::label("web — a runtime-loaded WebKitGTK view", font_size: 12.0));
    var page: core::Node = ui::web(
        "data:text/html,<body style='font:13px sans-serif;margin:8px'><b>web</b> — this page came from a data: URL</body>",
        key: "probe:web");
    page.set_height(flex::StyleLength::points(80.0));
    b.add(page);

    // THE ROOT IS A SCROLL, which is the awkward case on purpose: a scroll's
    // children go into its document rather than into its own widget, and a
    // scroll ROOT is the one node the frame walk is never called for. If the
    // content below is clipped instead of scrolling, that is the path that
    // broke.
    var s: core::Node = ui::scroll(key: "probe:scroll",
                                   axis: vocab::ScrollAxis::Vertical,
                                   observe_scrolled: on_scrolled);
    s.add_child(core::column(b, key: "probe:root"));
    return s;
}

// The tree has to OUTLIVE `main`'s frame: facet mounts it and keeps pointing at
// it for the life of the window, so a local would be gone before the first
// click.
static ROOT: core::Node = #zero::[core::Node]();


fn main() -> i32 {
    ROOT = tree();
    if !backend::open_window(#addr_of(ROOT), "facet_gtk probe", 520.0, 640.0) {
        return 1;
    }
    // facet's scheduler runs on the GLib main loop (see facet_gtk/scheduler),
    // so this is both the event pump and the sync pump.
    let loop_: glib::MainLoop = glib::MainLoop::new(glib::main_context_default(), false);
    loop_.run();
    return 0;
}
