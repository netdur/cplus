// Facet Gallery on Android.
//
// THERE IS NO JAVA IN THIS APP. The manifest names `cplus.facet.FacetActivity`,
// which ships inside facet_android as a precompiled dex and is merged into this
// APK's classes.dex by `build.sh`. What is left is the export below — five
// lines of C+ — and everything above it is the same facet vocabulary the macOS
// and iOS galleries use.
//
// The boxing, the leak-for-the-process and the re-attach on a recreated
// Activity all live in `entry::start`, because every app needs them and getting
// them wrong looks like a rotation bug rather than a lifetime one.

import "jni/jni" as jni;
import "facet/facet" as core;
import "facet_android/entry" as entry;
import "./gallery" as gallery;

fn build() -> core::Node {
    let n: core::Node = gallery::build();
    return n;
}

export extern fn Java_cplus_facet_FacetActivity_nativeCreateView(
    envp: *jni::JNIEnv,
    cls: jni::jobject,
    activity: jni::jobject,
) -> jni::jobject {
    let host: jni::jobject = entry::start(envp, activity, build);
    // The first screen cannot be chosen until the tree is mounted, and
    // `entry::start` is what mounts it.
    if !gallery::shown() { gallery::show_home(); }
    return host;
}
