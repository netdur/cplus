// Buttons — the three kinds facet declares, and what each reports.

import "stdlib/option" as option;
import "facet/facet" as core;
import "facet/elements" as ui;
import "facet/label" as label;
import "facet/vocabulary" as vocab;
import "facet/component" as component;
import "stdlib/text" as text;
import "../shell" as shell;

static PRESSES: i32 = 0;

fn note(s: str) {
    match label::find("buttons:echo") {
        option::Option[label::Label]::Some(l) => { let _l: label::Label = l.set_text(s); }
        option::Option::None => { }
    }
}

fn on_plain(sender: *u8, ctx: *u8) {
    PRESSES = PRESSES +% 1;
    note("button pressed ${PRESSES}x");
}

fn on_text(sender: *u8, ctx: *u8) { note("text button"); return; }

// ONE HANDLER, SEVERAL KEYED CONTROLS — the idiom the SKILL teaches, and the
// one that was silently dead on this backend until the sender band was
// installed: `component::key_of(sender)` answered "" for every control in
// every Android app, which reads exactly like a handler that does nothing.
//
// Three buttons share this. Whichever is pressed, the echo names it.
fn on_which(sender: *u8, ctx: *u8) {
    let key: text::Text = component::key_of(sender);
    if key.view() == "" { note("key_of answered NOTHING — the sender band is not reading"); return; }
    note("pressed ${key.view()}");
    return;
}
fn on_icon(sender: *u8, ctx: *u8) { note("icon button"); return; }

fn build() -> core::Node {
    var b: core::Builder = core::Builder::new();
    b.add(shell::title("Buttons"));
    b.add(shell::body("Three kinds, one handler each. The line at the bottom is written by the handler, so a button that looks pressed and leaves it alone has a dead read half."));

    b.add(shell::heading("button"));
    b.add(ui::button("Press me", key: "buttons:plain", on_click: on_plain));

    b.add(shell::heading("text_button"));
    b.add(shell::body("A borderless Button on Android."));
    b.add(ui::text_button("A text button", key: "buttons:text", on_click: on_text));

    b.add(shell::heading("icon_button"));
    b.add(shell::body("An ImageButton. Its source is a filesystem path — an image inside the APK needs an AssetManager, which MANIFEST section 2 still owes."));
    b.add(ui::icon_button("", key: "buttons:icon", on_clicked: on_icon));

    b.add(shell::heading("one handler, three keys"));
    b.add(shell::body("All three call the same function. It asks the sender which key it was — `component::key_of(sender)`. If the echo names the button you pressed, the sender band is reading; if it says NOTHING, it is not."));
    b.add(ui::button("Up", key: "buttons:step:up", on_click: on_which));
    b.add(ui::button("Down", key: "buttons:step:down", on_click: on_which));
    b.add(ui::button("Reset", key: "buttons:step:reset", on_click: on_which));

    b.add(ui::label("(nothing pressed yet)", key: "buttons:echo", font_size: 15.0,
                    text_color: vocab::Color::rgba(0.35, 0.35, 0.40)));
    return shell::page(b, "demo:buttons");
}
