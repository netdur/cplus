// Layout — rows, columns, gaps, padding and grow, which are flex's and not the
// backend's. Nothing on this screen calls a single Android layout container:
// every rect here was computed by flex and pushed with View.layout().

import "facet/facet" as core;
import "facet/elements" as ui;
import "facet/vocabulary" as vocab;
import "../shell" as shell;

fn swatch(text: str, grow: f64) -> core::Node {
    var b: core::Builder = core::Builder::new();
    b.add(ui::label(text, key: "", font_size: 15.0f64));
    return core::column(b).padding(10.0f64).grow(grow);
}

fn build() -> core::Node {
    var b: core::Builder = core::Builder::new();
    b.add(shell::title("Layout"));
    b.add(shell::body("FacetHost's onLayout is EMPTY on purpose. Android's layout pass is got out of the way rather than negotiated with, so every child keeps the rect C+ gave it."));

    b.add(shell::heading("row"));
    var r1: core::Builder = core::Builder::new();
    r1.add(swatch("one", 1.0f64));
    r1.add(swatch("two", 1.0f64));
    r1.add(swatch("three", 1.0f64));
    b.add(core::row(r1).gap(8.0f64));

    b.add(shell::heading("grow"));
    b.add(shell::body("1 : 2 : 1"));
    var r2: core::Builder = core::Builder::new();
    r2.add(swatch("1", 1.0f64));
    r2.add(swatch("2", 2.0f64));
    r2.add(swatch("1", 1.0f64));
    b.add(core::row(r2).gap(8.0f64));

    b.add(shell::heading("nesting"));
    var inner: core::Builder = core::Builder::new();
    inner.add(ui::label("a column", key: "", font_size: 15.0f64));
    inner.add(ui::button("inside a row", key: "layout:btn"));
    var r3: core::Builder = core::Builder::new();
    r3.add(swatch("left", 1.0f64));
    r3.add(core::column(inner).gap(6.0f64).grow(2.0f64));
    b.add(core::row(r3).gap(8.0f64));

    b.add(shell::heading("a tall page"));
    b.add(shell::body("Everything below exists so this screen overflows and the scroll has something to do."));
    var i: i64 = 0 as i64;
    while i < (12 as i64) {
        b.add(ui::label("row ${i}", key: "", font_size: 15.0f64));
        i = i + (1 as i64);
    }
    b.add(ui::label("the end", key: "", font_size: 20.0f64,
                    font_weight: vocab::FontWeight::Semibold));
    return shell::page(b, "demo:layout");
}
