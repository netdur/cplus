// notifications_demo — schedule one, see it arrive.
//
// WHAT TO WATCH, because the interesting parts are the ones that look like bugs:
//
//   1. The permission row. Until it says Granted, every Schedule button answers
//      NotPermitted and posts nothing — which is this package refusing to do
//      what both platforms do silently, and the reason it depends on
//      `permissions` at all. Press Ask first.
//   2. "In 5 seconds", then leave the app in front. The banner still appears —
//      because the package installs a `UNUserNotificationCenterDelegate` that
//      says to present it. WITHOUT that delegate nothing would show while the
//      app is foregrounded, and the code would be perfectly correct. That is
//      the single most common "notifications don't work" report there is.
//   3. Schedule the same id twice. One notification, updated in place, because
//      both platforms key replacement on the id.
//   4. "In 30 seconds", then Cancel before it fires. Nothing arrives.
//   5. Pending lists what this package believes is scheduled — its own record,
//      not the platform's, because Android has no listing API and an answer
//      that only worked on one platform would not be an answer.

import "stdlib/option" as option;
import "stdlib/text" as text;
import "stdlib/status" as status;
import "stdlib/vec" as vec;
import "facet/facet" as core;
import "facet/elements" as ui;
import "facet/component" as component;
import "facet/label" as label;
import "facet/theme" as theme;
import "facet/vocabulary" as vocab;
import "facet_runtime/runtime" as runtime;
import "permissions/permissions" as permissions;
import "notifications/notifications" as notifications;

const STATUS_KEY: str = "status";
const PERM_KEY: str = "perm";
const PENDING_KEY: str = "pending";

// One id reused on purpose: pressing Schedule twice must produce ONE
// notification, updated, rather than two. The demo would hide that with unique
// ids.
const DEMO_ID: str = "demo:reminder";

fn word(o: notifications::Outcome) -> str {
    return match o {
        notifications::Outcome::Ok => "Ok",
        notifications::Outcome::InvalidInput => "InvalidInput",
        notifications::Outcome::NotPermitted => "NotPermitted — press Ask",
        notifications::Outcome::Unsupported => "Unsupported — not a bundle?",
        notifications::Outcome::Failed => "Failed",
    };
}

fn perm_word(s: permissions::State) -> str {
    return match s {
        permissions::State::Unknown => "Unknown",
        permissions::State::Granted => "Granted",
        permissions::State::Limited => "Limited",
        permissions::State::Denied => "Denied",
        permissions::State::Blocked => "Blocked",
        permissions::State::Unsupported => "Unsupported",
    };
}

fn set_label(key: str, v: str) {
    match label::find(key) {
        option::Option[label::Label]::Some(l) => { let _l: label::Label = l.set_text(v); }
        option::Option::None => { }
    }
    return;
}

fn refresh() {
    set_label(PERM_KEY, perm_word(permissions::state(of: permissions::NOTIFICATIONS)));
    var ids: vec::Vec[str] = vec::new::[str]();
    let _p: notifications::Outcome = notifications::pending({ #addr_of(ids) as *vec::Vec[str] });
    let n: usize = ids.count();
    set_label(PENDING_KEY, text::from_str("pending: ${n}").view());
    return;
}

fn answered(name: str, s: permissions::State, ctx: *u8) { refresh(); return; }

fn ask(sender: *u8, ctx: *u8) {
    let _s: status::Status = permissions::request(permissions::NOTIFICATIONS,
                                                  on_answer: answered);
    refresh();
    return;
}

fn post(when: notifications::When, body: str) {
    let o: notifications::Outcome = notifications::schedule(
        notifications::Notification::new(DEMO_ID, "C+ notifications",
                                         body: body, when: when,
                                         payload: "demo:tapped"));
    set_label(STATUS_KEY, word(o));
    refresh();
    return;
}

fn now(sender: *u8, ctx: *u8) { post(notifications::When::Now, "Posted immediately."); return; }

fn in_five(sender: *u8, ctx: *u8) {
    // Leave the app in front and watch: it still appears, because of the
    // presentation delegate. That is the point of this button.
    post(notifications::When::After(5.0f64), "Scheduled five seconds ago.");
    return;
}

fn in_thirty(sender: *u8, ctx: *u8) {
    post(notifications::When::After(30.0f64), "Scheduled thirty seconds ago.");
    return;
}

fn cancel_one(sender: *u8, ctx: *u8) {
    set_label(STATUS_KEY, word(notifications::cancel(DEMO_ID)));
    refresh();
    return;
}

fn clear(sender: *u8, ctx: *u8) {
    let _a: notifications::Outcome = notifications::cancel_all();
    set_label(STATUS_KEY, word(notifications::clear_shown()));
    refresh();
    return;
}

struct Demo { }

impl Demo {
    fn new() -> Demo { return Demo { }; }
}

impl Demo: component::Component {
    fn build(ref this) -> core::Node {
        var b: core::Builder = core::Builder::new();
        b.add(ui::label("Notifications", font_size: 20.0,
                        font_weight: vocab::FontWeight::Bold).padding(4.0));

        var perm: core::Builder = core::Builder::new();
        perm.add(ui::label("permission:", font_size: 13.0).width(90.0));
        perm.add(ui::label("...", key: PERM_KEY, font_size: 13.0,
                           font_weight: vocab::FontWeight::Semibold).width(120.0));
        perm.add(ui::text_button("Ask", on_click: ask));
        b.add(core::row(perm).gap(8.0).padding(4.0));

        var acts: core::Builder = core::Builder::new();
        acts.add(ui::text_button("Now", on_click: now));
        acts.add(ui::text_button("In 5 seconds", on_click: in_five));
        acts.add(ui::text_button("In 30 seconds", on_click: in_thirty));
        b.add(core::row(acts).gap(10.0).padding(4.0));

        var acts2: core::Builder = core::Builder::new();
        acts2.add(ui::text_button("Cancel", on_click: cancel_one));
        acts2.add(ui::text_button("Clear all", on_click: clear));
        b.add(core::row(acts2).gap(10.0).padding(4.0));

        b.add(ui::label("...", key: STATUS_KEY, font_size: 13.0).padding(4.0));
        b.add(ui::label("...", key: PENDING_KEY, font_size: 13.0).padding(4.0));
        b.add(ui::label("Every button reuses one id, so scheduling twice updates in place rather than stacking.",
                        font_size: 11.0).padding(4.0));
        return core::column(b).padding(16.0);
    }
}

impl Demo: component::Lifecycle {
    fn on_attach(ref this) { refresh(); return; }
    fn on_detach(ref this) { return; }
}

fn main() -> i32 {
    theme::set_theme(theme::Theme::new(
        primary: vocab::Color::rgba(0.35, 0.42, 0.95, 1.0),
    ));
    runtime::run_component(Demo::new(), title: "Notifications",
                           width: 520.0, height: 380.0);
    return 0;
}
