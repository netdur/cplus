// The gallery shell: a catalog, a demo, and a way back.
//
// MASTER THEN DETAIL, not a sidebar. The desktop gallery puts its catalog tree
// beside the demo in a `split`, because a Mac window is wide; a phone has one
// column, so the catalog IS the first screen and a demo replaces it. That is
// the same idea in the shape the platform has.
//
// NOT `tabs`, and not `App::run` with routes. Both would work on paper and
// neither is the thing to lean a test app on:
//
//   * `tabs` hosts its panes as children and the iOS body shows and hides
//     them, which is a second mechanism stacked under the first.
//   * `App::run`'s route swap is the newest code in the facade — it is the one
//     path that rebuilds a screen INTO a live window — so a bug there would
//     take the whole app down rather than one demo.
//
// So the shell is `mount::set_content` into a keyed outlet, which is the same
// mechanism the desktop gallery uses and the one with the most miles on it.

import "facet/facet" as core;
import "facet/elements" as ui;
import "facet/component" as component;
import "facet/mount" as mount;
import "facet/nav" as nav;
import "facet/tree" as tree;
import "facet/label" as label;
import "facet/vocabulary" as vocab;
import "flex_layout/flex_layout" as flex;
import "stdlib/option" as option;
import "stdlib/text" as text;
import "./catalog" as catalog;
import "./demos/widgets" as widgets;
import "./demos/typography" as typography;
import "./demos/decoration" as decoration;
import "./demos/motion" as motion;
import "./demos/interaction" as interaction;
import "./demos/collections" as collections;
import "./demos/notes" as notes;
import "./demos/responsive" as responsive;

struct Gallery {
    // The demo on screen, or DEMO_NONE when the catalog is.
    shown: i64,

    button: widgets::Buttons,
    values: widgets::Values,
    switches: widgets::Switches,
    indicators: widgets::Indicators,
    type_: typography::Type,
    fields: typography::Fields,
    keyboards: typography::Keyboards,
    radius: decoration::Radius,
    brush: decoration::Brush,
    shadow: decoration::Shadow,
    clip: decoration::Clip,
    transform: decoration::Transform,
    fade: motion::Fade,
    spin: motion::Spin,
    pop: motion::Pop,
    entrance: motion::Entrance,
    dead: motion::DeadSnap,
    canvas: interaction::Canvas,
    swipe: interaction::Swipe,
    radio: interaction::Radio,
    split: interaction::Split,
    list: collections::ListDemo,
    cannot: notes::Cannot,
    refresh: collections::Refresh,
    responsive: responsive::Responsive,
}

impl Gallery {
    fn new() -> Gallery {
        return Gallery {
            shown: catalog::DEMO_NONE,
            button: widgets::Buttons::new(),
            values: widgets::Values::new(),
            switches: widgets::Switches::new(),
            indicators: widgets::Indicators::new(),
            type_: typography::Type::new(),
            fields: typography::Fields::new(),
            keyboards: typography::Keyboards::new(),
            radius: decoration::Radius::new(),
            brush: decoration::Brush::new(),
            shadow: decoration::Shadow::new(),
            clip: decoration::Clip::new(),
            transform: decoration::Transform::new(),
            fade: motion::Fade::new(),
            spin: motion::Spin::new(),
            pop: motion::Pop::new(),
            entrance: motion::Entrance::new(),
            dead: motion::DeadSnap::new(),
            canvas: interaction::Canvas::new(),
            swipe: interaction::Swipe::new(),
            radio: interaction::Radio::new(),
            split: interaction::Split::new(),
            list: collections::ListDemo::new(),
            cannot: notes::Cannot::new(),
            refresh: collections::Refresh::new(),
            responsive: responsive::Responsive::new(),
        };
    }

    // A row was tapped. A BRANCH is not a demo — tapping a section expands it,
    // which the tree does itself — so only a leaf whose id names something gets
    // this far.
    fn on_pick(ref this, node: *tree::TreeNode) {
        if node.is_null() { return; }
        if { (*node).is_branch } { return; }
        let id: i64 = catalog::demo_for({ (*node).id_of() });
        if id == catalog::DEMO_NONE { return; }
        this.shown = id;
        this.show();
    }

    fn on_back(ref this, sender: *u8) {
        this.shown = catalog::DEMO_NONE;
        this.show();
    }

    // The one swap. Written as a chain rather than a table because a component
    // is a VALUE here — `set_content` takes it by reference and each arm names
    // a different type, so there is nothing to put in a table.
    fn show(ref this) {
        this.set_chrome();
        // At the root there is nothing to swap IN — the outlet is hidden and
        // keeps whatever it last held, which is what makes going back and
        // forth cheap. A demo that must not keep its state between visits
        // would need a rebuild, and none of them do: the entrance demo WANTS
        // to replay, and it does, because `set_content` rebuilds on repeat.
        if this.shown == catalog::DEMO_NONE { return; }
        match mount::find("g:outlet") {
            option::Option[*core::Node]::Some(out) => {
                let d: i64 = this.shown;
                if d == catalog::DEMO_BUTTON { let _o: bool = mount::set_content(out, this.button); }
                else if d == catalog::DEMO_VALUES { let _o: bool = mount::set_content(out, this.values); }
                else if d == catalog::DEMO_SWITCHES { let _o: bool = mount::set_content(out, this.switches); }
                else if d == catalog::DEMO_INDICATORS { let _o: bool = mount::set_content(out, this.indicators); }
                else if d == catalog::DEMO_TYPE { let _o: bool = mount::set_content(out, this.type_); }
                else if d == catalog::DEMO_FIELDS { let _o: bool = mount::set_content(out, this.fields); }
                else if d == catalog::DEMO_KEYBOARDS { let _o: bool = mount::set_content(out, this.keyboards); }
                else if d == catalog::DEMO_RADIUS { let _o: bool = mount::set_content(out, this.radius); }
                else if d == catalog::DEMO_BRUSH { let _o: bool = mount::set_content(out, this.brush); }
                else if d == catalog::DEMO_SHADOW { let _o: bool = mount::set_content(out, this.shadow); }
                else if d == catalog::DEMO_CLIP { let _o: bool = mount::set_content(out, this.clip); }
                else if d == catalog::DEMO_TRANSFORM { let _o: bool = mount::set_content(out, this.transform); }
                else if d == catalog::DEMO_FADE { let _o: bool = mount::set_content(out, this.fade); }
                else if d == catalog::DEMO_SPIN { let _o: bool = mount::set_content(out, this.spin); }
                else if d == catalog::DEMO_POP { let _o: bool = mount::set_content(out, this.pop); }
                else if d == catalog::DEMO_ENTRANCE { let _o: bool = mount::set_content(out, this.entrance); }
                else if d == catalog::DEMO_DEAD { let _o: bool = mount::set_content(out, this.dead); }
                else if d == catalog::DEMO_CANVAS { let _o: bool = mount::set_content(out, this.canvas); }
                else if d == catalog::DEMO_SWIPE { let _o: bool = mount::set_content(out, this.swipe); }
                else if d == catalog::DEMO_RADIO { let _o: bool = mount::set_content(out, this.radio); }
                else if d == catalog::DEMO_SPLIT { let _o: bool = mount::set_content(out, this.split); }
                else if d == catalog::DEMO_LIST { let _o: bool = mount::set_content(out, this.list); }
                else if d == catalog::DEMO_CANNOT { let _o: bool = mount::set_content(out, this.cannot); }
                else if d == catalog::DEMO_REFRESH { let _o: bool = mount::set_content(out, this.refresh); }
                else if d == catalog::DEMO_RESPONSIVE { let _o: bool = mount::set_content(out, this.responsive); }
            }
            option::Option::None => { }
        }
    }

    // The bar: a Back button that is only there when there is somewhere to go
    // back to, and a title that says where you are. Both are written rather
    // than rebuilt — the bar is one row that outlives every swap under it.
    fn set_chrome(ref this) {
        let at_root: bool = this.shown == catalog::DEMO_NONE;
        // `Display::None` rather than `set_visible`: an invisible Back button
        // would still hold its 80 points and push the title off centre. The
        // outlet gets the same treatment, so a hidden demo occupies no rows.
        show_node("g:back", !at_root);
        show_node("g:catalog", at_root);
        show_node("g:outlet", !at_root);
        match label::find("g:title") {
            option::Option[label::Label]::Some(l) => {
                if at_root {
                    let _t: label::Label = l.set_text(backend_name());
                } else {
                    let _t: label::Label = l.set_text("Gallery");
                }
            }
            option::Option::None => { }
        }
    }
}

// WHICH BACKEND IS DRAWING THIS. The same source runs on UIKit and on Android,
// so the name is asked for rather than written down — `#platform()` is a
// value-level intrinsic, which is why this is a function and not a constant.
// THE RUNNING GALLERY, so the system's back gesture can reach it.
//
// `nav::set_pop_fn` takes a plain `fn() -> bool` with no context channel — the
// navigation tier is app-scoped and assumes one app — so the component has to
// be findable from a free function. Written at attach, which is the moment the
// instance exists and is live.
static GALLERY: *Gallery = 0 as *Gallery;

// The system back, for a gallery that navigates by swapping an outlet rather
// than pushing screens. FALSE at the catalog on purpose: back from the first
// screen should leave the app.
fn gallery_pop() -> bool {
    let g: *Gallery = GALLERY;
    if g.is_null() { return false; }
    if { (*g).shown } == catalog::DEMO_NONE { return false; }
    { (*g).shown = catalog::DEMO_NONE };
    { (*g).show() };
    return true;
}

fn backend_name() -> str {
    if #platform() == "android" { return "facet_android"; }
    return "facet_uikit";
}

fn show_node(key: str, on: bool) {
    match mount::find(key) {
        option::Option[*core::Node]::Some(n) => {
            if on { core::set_display(n, flex::Display::Flex); }
            else { core::set_display(n, flex::Display::None); }
        }
        option::Option::None => { }
    }
}

impl Gallery: component::Component {
    fn build(ref this) -> core::Node {
        var root: flex::Builder = flex::Builder::new();

        // ---- the bar ---------------------------------------------------------
        var bar: flex::Builder = flex::Builder::new();
        bar.add(ui::text_button("‹ Back", key: "g:back", on_click: this.on_back)
                .width(80.0).height(44.0));
        bar.add(ui::label(backend_name(), key: "g:title", font_size: 17.0,
                          font_weight: vocab::FontWeight::Semibold));
        bar.add(ui::column(flex::Builder::new()).grow(1.0));
        root.add(ui::row(bar).gap(8.0).padding(8.0)
                 .align(flex::Align::Center).height(52.0));

        // ---- the catalog -----------------------------------------------------
        // A real `ui::tree`, so browsing the gallery exercises the recycling
        // tier before anything has been tapped.
        root.add(ui::tree(catalog::model(), key: "g:catalog",
                          on_select: this.on_pick,
                          // Every row gets a name an agent can click. See
                          // catalog::row_key — without it the catalog is the
                          // one screen MCP can read and cannot drive.
                          row_id: catalog::row_key,
                          row_height: 44.0)
                 .grow(1.0)
                 .shrink(1.0));

        // ---- the demo --------------------------------------------------------
        // The outlet: an empty keyed column `set_content` fills. Keyed, because
        // a key is an address and `mount::find` has to reach it.
        // `.shrink(1)` HERE TOO, and it has to be on every ancestor between the
        // window and a demo's scroll. flex's default `flex_shrink` is 0, so any
        // container in the chain that omits it lays out at its content's height
        // and pins everything below it — the scroll included, which is then as
        // tall as its own content and has nothing to scroll.
        root.add(ui::column(flex::Builder::new(), key: "g:outlet")
                 .grow(1.0)
                 .shrink(1.0));

        var page: core::Node = ui::column(root).grow(1.0);
        page.set_background_color(vocab::Color::window_background());
        return page;
    }
}

impl Gallery: component::Lifecycle {
    // AFTER the mount: `set_content` needs a live tree to find its outlet in,
    // and the tree needs to be realised before its sections can be expanded.
    // Both are exactly what on_attach is the seam for.
    fn on_attach(ref this, why: component::Attach) {
        if why != component::Attach::Mount { return; }
        match tree::find("g:catalog") {
            option::Option[tree::Tree]::Some(t) => { catalog::expand_all(t); }
            option::Option::None => { }
        }
        // WHAT BACK MEANS HERE. This gallery does not use facet's App tier — it
        // swaps one outlet — but `nav::pop` is the door a platform's own back
        // gesture knocks on, so the same swap is registered behind it. Answering
        // FALSE at the catalog is deliberate: back from the first screen should
        // leave the app, which is what an Android user expects and what the
        // backend does when nothing is pushed.
        GALLERY = #addr_of(this);
        nav::set_pop_fn(gallery_pop);
        this.show();
    }
    fn on_detach(ref this, why: component::Detach) {
        if why != component::Detach::Unmount { return; } return; }
}
