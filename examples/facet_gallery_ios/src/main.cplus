// facet_gallery_ios — the entry point Xcode calls.
//
// `export extern fn` gives the symbol a stable, unmangled C name and puts it in
// the generated header, which is how an app bundle's `main.m` reaches C+ code.
// A `fn main` would not do: an iOS target produces a STATICLIB, and a library
// has no entry the system knows to call.
//
// `run_component` does not return on iOS — `UIApplicationMain` takes the
// process — so the `return 0` below is unreachable in a running app. It is
// there because the signature is the same one the desktop gallery's `main` has,
// and a reader comparing the two should see the same shape.

import "facet_runtime/runtime" as runtime;
import "facet_agent/agent" as agent;
import "facet/application" as application;
import "facet/theme" as theme;
import "facet/vocabulary" as vocab;
import "./app" as app;

export extern fn facet_gallery_ios_main() -> i32 {
    // The same two tokens the desktop gallery sets, so the two apps are the
    // same palette on both platforms — which is the point of a theme being
    // facet's rather than a backend's.
    theme::set_theme(theme::Theme::new(
        primary: vocab::Color::rgba(0.35, 0.42, 0.95, 1.0),
        surface: vocab::Color::adaptive(
            light: vocab::Color::rgba(1.0, 1.0, 1.0, 1.0),
            dark: vocab::Color::rgba(0.11, 0.11, 0.13, 1.0),
        ),
    ));

    // The agent surface, served over MCP. Two lines, and they are ordered:
    // `enable` installs the hooks facet calls, and the window attach happens
    // inside facet_uikit's `attach_root` — which `run_component` reaches below
    // — so the hooks have to be in place BEFORE the tree is built, or the
    // first screen would never be walked into the surface.
    //
    // The argument is a PORT, not a path. A Unix socket lives inside the app
    // sandbox, where nothing on the development machine can reach it, and to a
    // real device there is no shared filesystem at all — so this backend binds
    // TCP on loopback and the Mac reaches it over usbmux. See DEPLOYING.md.
    agent::enable();
    application::agent_serve_once("8787");

    // Width and height describe nothing on a phone — the screen is the window
    // — but the parameters are the facade's shape on both platforms and the
    // backend drops them. See facet_uikit/MANIFEST.md §6.
    runtime::run_component(
        app::Gallery::new(),
        title: "facet gallery",
        width: 390.0,
        height: 844.0,
        // Pinch to magnify, which this backend recorded as absent until it was
        // pointed out that a pinch belongs to a touch screen more than to a
        // trackpad. The desktop gallery can turn the same flag on.
        zoomable: true,
        max_zoom: 3.0,
    );
    return 0;
}
