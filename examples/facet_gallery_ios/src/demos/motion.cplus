// Motion — the animate_* band, and the two rules that are not visible in the
// signatures.
//
// The desktop gallery has the same two rules on its Animation → Rules page, and
// they are platform-independent because they are facet's, not Core Animation's:
// there is one field per property and one apply per tick, and the transform is
// one matrix. If either behaves differently here, it is a backend bug.

import "facet/facet" as core;
import "facet/elements" as ui;
import "facet/component" as component;
import "facet/vocabulary" as vocab;
import "facet/services" as services;
import "facet/mount" as mount;
import "flex_layout/flex_layout" as flex;
import "stdlib/option" as option;
import "../shell" as shell;

fn dot(fill: vocab::Color, key: str) -> core::Node {
    return shell::painted(
        ui::column(flex::Builder::new(), key: key).width(56.0).height(56.0),
        fill, 28.0);
}

// A dot built ALREADY HIDDEN — the entrance pattern's first half. The zero
// reaches the view in the mount walk's apply, which is what leaves the
// animation something to travel from.
fn hidden_dot(fill: vocab::Color, key: str) -> core::Node {
    var n: core::Node = dot(fill, key);
    n.set_opacity(0.0);
    return n;
}

// A SHAPE THAT SHOWS WHICH WAY IT IS FACING.
//
// The rotation demo used a circle, and a rotated circle is the same circle —
// the demo claimed something it could not show. Nor would a square do it: this
// steps by 180°, and a square at 180° is a square. So the target carries a bar
// at its top, which ends up at the bottom, which is the whole point.
fn pointer(fill: vocab::Color, key: str) -> core::Node {
    var inner: flex::Builder = flex::Builder::new();
    // A LITERAL, not `Color::on(fill)`. `on()` answers a derived ink for a
    // THEME ROLE — primary, secondary, surface — and `Color::none()` for
    // anything else, and a system colour is anything else. An unset colour
    // paints nothing, which is what this bar did on its first run.
    inner.add(shell::painted(
        ui::column(flex::Builder::new()).width(22.0).height(8.0),
        vocab::Color::rgba(1.0, 1.0, 1.0, 1.0), 4.0));
    var n: core::Node = ui::column(inner, key: key)
        .width(56.0)
        .height(56.0)
        .padding(8.0)
        .align(flex::Align::Center);
    n.set_background_color(fill);
    n.set_corner_radius(vocab::Corners::all(12.0));
    return n;
}

fn stage(take control: core::Node, take target: core::Node) -> core::Node {
    var row: flex::Builder = flex::Builder::new();
    row.add(target);
    row.add(control);
    return ui::row(row).gap(16.0).align(flex::Align::Center);
}

// ---- opacity -----------------------------------------------------------------

struct Fade { faded: bool }
impl Fade {
    fn new() -> Fade { return Fade { faded: false }; }

    fn go(ref this, sender: *u8) {
        match mount::find("m:fader") {
            option::Option[*core::Node]::Some(n) => {
                if this.faded {
                    core::animate_opacity(n, 1.0, vocab::Duration::of_seconds(0.35),
                                          vocab::Easing::SinOut);
                } else {
                    core::animate_opacity(n, 0.15, vocab::Duration::of_seconds(0.35),
                                          vocab::Easing::SinOut);
                }
                this.faded = !this.faded;
            }
            option::Option::None => { }
        }
    }
}

impl Fade: component::Component {
    fn build(ref this) -> core::Node {
        var body: flex::Builder = flex::Builder::new();
        var f: flex::Builder = flex::Builder::new();
        f.add(stage(ui::button("Fade", on_click: this.go).height(44.0),
                    dot(vocab::Color::system_blue(), "m:fader")));
        f.add(shell::caption("`animate_opacity` drives the layer's own opacity through an explicit CABasicAnimation rather than through UIView's block API — the same call the AppKit backend makes."));
        body.add(shell::card("OPACITY", f));
        return shell::page("Fade",
            "The simplest of the animate_* verbs: one layer property, from where it is to where it was asked for.",
            body, "demo:fade");
    }
}
impl Fade: component::Lifecycle {
    fn on_attach(ref this, why: component::Attach) {
        if why != component::Attach::Mount { return; } return; }
    fn on_detach(ref this, why: component::Detach) {
        if why != component::Detach::Unmount { return; } return; }
}

// ---- rotation ----------------------------------------------------------------

struct Spin { spun: f64 }
impl Spin {
    fn new() -> Spin { return Spin { spun: 0.0 }; }

    // A HALF turn, not a whole one. The matrix for 360° is the matrix for 0°,
    // so a full revolution has no path between its ends and plays nothing —
    // the same on both platforms, and the reason this steps by 180.
    fn go(ref this, sender: *u8) {
        match mount::find("m:spinner") {
            option::Option[*core::Node]::Some(n) => {
                this.spun = this.spun + 180.0;
                core::animate_rotation(n, this.spun, vocab::Duration::of_seconds(0.5),
                                       vocab::Easing::CubicInOut);
            }
            option::Option::None => { }
        }
    }
}

impl Spin: component::Component {
    fn build(ref this) -> core::Node {
        var body: flex::Builder = flex::Builder::new();
        var s: flex::Builder = flex::Builder::new();
        s.add(stage(ui::button("Half turn", on_click: this.go).height(44.0),
                    pointer(vocab::Color::system_orange(), "m:spinner")));
        s.add(shell::caption("Half a turn, not a whole one: the matrix for 360° IS the matrix for 0°, so a full revolution has no path between its ends and plays nothing."));
        s.add(shell::caption("The bar is there so the turn can be SEEN. This demo used a circle, and a rotated circle is the same circle — a square would have been no better, because a square at 180° is a square."));
        body.add(shell::card("ROTATION", s));
        return shell::page("Rotate",
            "Why a full turn animates nothing, and what to do instead. Tap: the bar goes from top to bottom and back.",
            body, "demo:spin");
    }
}
impl Spin: component::Lifecycle {
    fn on_attach(ref this, why: component::Attach) {
        if why != component::Attach::Mount { return; } return; }
    fn on_detach(ref this, why: component::Detach) {
        if why != component::Detach::Unmount { return; } return; }
}

// ---- scale -------------------------------------------------------------------

struct Pop {
    // THE TIMER HANDLE HAS TO BE HELD. `services::Cancellable` cancels on DROP
    // — that is the API's whole point, an observation must not outlive its
    // owner — so a `let` inside the handler cancels the timer on the way out
    // and the second half of the pop never runs. Found by running: the dot
    // grew and stayed grown.
    pop_timer: services::Cancellable,
}

impl Pop {
    fn new() -> Pop { return Pop { pop_timer: services::Cancellable::none() }; }

    fn go(ref this, sender: *u8) {
        match mount::find("m:popper") {
            option::Option[*core::Node]::Some(n) => {
                core::animate_scale(n, 1.4, vocab::Duration::of_seconds(0.16),
                                    vocab::Easing::SinOut);
                this.pop_timer = services::after(0.16, unpop, n as *u8);
            }
            option::Option::None => { }
        }
    }
}

// The scale-back half of the pop, a tick later — a timer, not a main-queue hop:
// a hop is drained in the same run-loop turn as the tap, ahead of the sync, so
// the two writes would still collapse into one apply.
fn unpop(ctx: *u8) {
    let n: *core::Node = ctx as *core::Node;
    if n.is_null() { return; }
    core::animate_scale(n, 1.0, vocab::Duration::of_seconds(0.22),
                        vocab::Easing::SinInOut);
}

impl Pop: component::Component {
    fn build(ref this) -> core::Node {
        var body: flex::Builder = flex::Builder::new();
        var p: flex::Builder = flex::Builder::new();
        p.add(stage(ui::button("Pop", on_click: this.go).height(44.0),
                    dot(vocab::Color::system_green(), "m:popper")));
        p.add(shell::caption("Up, then back on a TIMER. A main-queue hop would be drained in the same run-loop turn as the tap, ahead of the sync, and the two writes would collapse into one apply."));
        body.add(shell::card("SCALE", p));
        return shell::page("Pop",
            "Two animations in sequence, and why the second one needs a timer rather than a queue hop.",
            body, "demo:pop");
    }
}
impl Pop: component::Lifecycle {
    fn on_attach(ref this, why: component::Attach) {
        if why != component::Attach::Mount { return; } return; }
    fn on_detach(ref this, why: component::Detach) {
        if why != component::Detach::Unmount { return; } return; }
}

// ---- entrance ----------------------------------------------------------------

struct Entrance { _unused: i32 }
impl Entrance { fn new() -> Entrance { return Entrance { _unused: 0 }; } }

// The entrance pattern: built hidden, animated from `on_attach`. The start
// value reaches the view in the mount walk's apply, and the animation is armed
// on the NEXT tick — which is what makes it a fade-in rather than a no-op.
fn fade_in(n: *core::Node) {
    core::animate_opacity(n, 1.0, vocab::Duration::of_seconds(0.5),
                          vocab::Easing::SinOut);
}

impl Entrance: component::Component {
    fn build(ref this) -> core::Node {
        var body: flex::Builder = flex::Builder::new();
        var e: flex::Builder = flex::Builder::new();
        var erow: flex::Builder = flex::Builder::new();
        erow.add(hidden_dot(vocab::Color::system_purple(), "m:entrance"));
        e.add(ui::row(erow).gap(16.0).align(flex::Align::Center));
        e.add(shell::caption("Built at opacity 0 and animated from on_attach. The start value gets its own apply in the mount walk, which is the whole of why this works. Leave the demo and come back to see it again."));
        body.add(shell::card("ENTRANCE", e));
        return shell::page("Entrance",
            "A node that fades in as it arrives. Built hidden, animated from on_attach — the two halves have to land in different applies.",
            body, "demo:entrance");
    }
}
impl Entrance: component::Lifecycle {
    fn on_attach(ref this, why: component::Attach) {
        if why != component::Attach::Mount { return; }
        match mount::find("m:entrance") {
            option::Option[*core::Node]::Some(n) => { fade_in(n); }
            option::Option::None => { }
        }
    }
    fn on_detach(ref this, why: component::Detach) {
        if why != component::Detach::Unmount { return; } return; }
}

// ---- the silent failure ------------------------------------------------------

struct DeadSnap { _unused: i32 }
impl DeadSnap {
    fn new() -> DeadSnap { return DeadSnap { _unused: 0 }; }

    // THE DEAD SNAP, on purpose. Both writes land in `opacity`, the second
    // wins, and the animation travels from what the view already shows to a
    // value it is already at. facet prints a line to stderr when it sees the
    // pair — this button is here so that line can be seen happening.
    fn go(ref this, sender: *u8) {
        match mount::find("m:dead") {
            option::Option[*core::Node]::Some(n) => {
                core::set_opacity(n, 0.0);
                core::animate_opacity(n, 1.0, vocab::Duration::of_seconds(0.6),
                                      vocab::Easing::SinInOut);
            }
            option::Option::None => { }
        }
    }
}

impl DeadSnap: component::Component {
    fn build(ref this) -> core::Node {
        var body: flex::Builder = flex::Builder::new();
        var d: flex::Builder = flex::Builder::new();
        d.add(stage(ui::button("Dead snap", on_click: this.go).height(44.0),
                    dot(vocab::Color::system_red(), "m:dead")));
        d.add(shell::caption("Deliberately wrong: set_opacity(0) and animate_opacity(1) in ONE handler. There is one field per property and one apply per tick, so the second write wins and the animation travels from where the view already is to where it already is. Nothing moves, and facet says why on stderr."));
        body.add(shell::card("THE FAILURE THAT IS SILENT", d));
        return shell::page("Dead snap",
            "The mistake the signatures do not warn about, on purpose. Watch the Xcode console.",
            body, "demo:dead");
    }
}
impl DeadSnap: component::Lifecycle {
    fn on_attach(ref this, why: component::Attach) {
        if why != component::Attach::Mount { return; } return; }
    fn on_detach(ref this, why: component::Detach) {
        if why != component::Detach::Unmount { return; } return; }
}
