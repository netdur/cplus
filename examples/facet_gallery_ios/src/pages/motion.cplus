// Motion — the animate_* band, and the two rules that are not visible in the
// signatures.
//
// The desktop gallery has the same two rules on its Animation → Rules page, and
// they are platform-independent because they are facet's, not Core Animation's:
// there is one field per property and one apply per tick, and the transform is
// one matrix. If either behaves differently here, it is a backend bug.

import "facet/facet" as core;
import "facet/elements" as ui;
import "facet/component" as component;
import "facet/vocabulary" as vocab;
import "facet/services" as services;
import "facet/mount" as mount;
import "flex_layout/flex_layout" as flex;
import "stdlib/option" as option;
import "../shell" as shell;

struct Motion {
    faded: bool,
    spun: f64,
    // THE TIMER HANDLE HAS TO BE HELD. `services::Cancellable` cancels on DROP
    // — that is the API's whole point, an observation must not outlive its
    // owner — so a `let` inside the handler cancels the timer on the way out
    // and the second half of the pop never runs. Found by running: the dot
    // grew and stayed grown.
    pop_timer: services::Cancellable,
}

impl Motion {
    fn new() -> Motion {
        return Motion { faded: false, spun: 0.0f64, pop_timer: services::Cancellable::none() };
    }

    fn fade(ref this, sender: *u8) {
        match mount::find("m:fader") {
            option::Option[*core::Node]::Some(n) => {
                if this.faded {
                    core::animate_opacity(n, 1.0f64, vocab::Duration::of_seconds(0.35f64),
                                          vocab::Easing::SinOut);
                } else {
                    core::animate_opacity(n, 0.15f64, vocab::Duration::of_seconds(0.35f64),
                                          vocab::Easing::SinOut);
                }
                this.faded = !this.faded;
            }
            option::Option[*core::Node]::None => { }
        }
        return;
    }

    // A HALF turn, not a whole one. The matrix for 360° is the matrix for 0°,
    // so a full revolution has no path between its ends and plays nothing —
    // the same on both platforms, and the reason this steps by 180.
    fn spin(ref this, sender: *u8) {
        match mount::find("m:spinner") {
            option::Option[*core::Node]::Some(n) => {
                this.spun = this.spun + 180.0f64;
                core::animate_rotation(n, this.spun, vocab::Duration::of_seconds(0.5f64),
                                       vocab::Easing::CubicInOut);
            }
            option::Option[*core::Node]::None => { }
        }
        return;
    }

    fn pop(ref this, sender: *u8) {
        match mount::find("m:popper") {
            option::Option[*core::Node]::Some(n) => {
                core::animate_scale(n, 1.4f64, vocab::Duration::of_seconds(0.16f64),
                                    vocab::Easing::SinOut);
                this.pop_timer = services::after(0.16f64, unpop, n as *u8);
            }
            option::Option[*core::Node]::None => { }
        }
        return;
    }

    // THE DEAD SNAP, on purpose. Both writes land in `opacity`, the second
    // wins, and the animation travels from what the view already shows to a
    // value it is already at. facet prints a line to stderr when it sees the
    // pair — this button is here so that line can be seen happening.
    fn dead(ref this, sender: *u8) {
        match mount::find("m:dead") {
            option::Option[*core::Node]::Some(n) => {
                core::set_opacity(n, 0.0f64);
                core::animate_opacity(n, 1.0f64, vocab::Duration::of_seconds(0.6f64),
                                      vocab::Easing::SinInOut);
            }
            option::Option[*core::Node]::None => { }
        }
        return;
    }
}

// The scale-back half of the pop, a tick later — a timer, not a main-queue hop:
// a hop is drained in the same run-loop turn as the tap, ahead of the sync, so
// the two writes would still collapse into one apply.
fn unpop(ctx: *u8) {
    let n: *core::Node = ctx as *core::Node;
    if n == (0 as *core::Node) { return; }
    core::animate_scale(n, 1.0f64, vocab::Duration::of_seconds(0.22f64),
                        vocab::Easing::SinInOut);
    return;
}

// The entrance pattern: built hidden, animated from `on_attach`. The start
// value reaches the view in the mount walk's apply, and the animation is armed
// on the NEXT tick — which is what makes it a fade-in rather than a no-op.
fn fade_in(n: *core::Node) {
    core::animate_opacity(n, 1.0f64, vocab::Duration::of_seconds(0.5f64),
                          vocab::Easing::SinOut);
    return;
}

fn dot(fill: vocab::Color, key: str) -> core::Node {
    return shell::painted(
        ui::column(flex::Builder::new(), key: key).width(56.0f64).height(56.0f64),
        fill, 28.0f64);
}

// A dot built ALREADY HIDDEN — the entrance pattern's first half. The zero
// reaches the view in the mount walk's apply, which is what leaves the
// animation something to travel from.
fn hidden_dot(fill: vocab::Color, key: str) -> core::Node {
    var n: core::Node = dot(fill, key);
    n.set_opacity(0.0f64);
    return n;
}

impl Motion: component::Component {
    fn build(ref this) -> core::Node {
        var body: flex::Builder = flex::Builder::new();

        var f: flex::Builder = flex::Builder::new();
        var frow: flex::Builder = flex::Builder::new();
        frow.add(dot(vocab::Color::system_blue(), "m:fader"));
        frow.add(ui::button("Fade", on_click: this.fade).height(44.0f64));
        f.add(ui::row(frow).gap(16.0f64).align(flex::Align::Center));
        body.add(shell::card("OPACITY", f));

        var s: flex::Builder = flex::Builder::new();
        var srow: flex::Builder = flex::Builder::new();
        srow.add(dot(vocab::Color::system_orange(), "m:spinner"));
        srow.add(ui::button("Half turn", on_click: this.spin).height(44.0f64));
        s.add(ui::row(srow).gap(16.0f64).align(flex::Align::Center));
        s.add(shell::caption("Half a turn, not a whole one: the matrix for 360° IS the matrix for 0°, so a full revolution has no path between its ends and plays nothing."));
        body.add(shell::card("ROTATION", s));

        var p: flex::Builder = flex::Builder::new();
        var prow: flex::Builder = flex::Builder::new();
        prow.add(dot(vocab::Color::system_green(), "m:popper"));
        prow.add(ui::button("Pop", on_click: this.pop).height(44.0f64));
        p.add(ui::row(prow).gap(16.0f64).align(flex::Align::Center));
        p.add(shell::caption("Up, then back on a TIMER. A main-queue hop would be drained in the same run-loop turn as the tap, ahead of the sync, and the two writes would collapse into one apply."));
        body.add(shell::card("SCALE", p));

        var e: flex::Builder = flex::Builder::new();
        var erow: flex::Builder = flex::Builder::new();
        erow.add(hidden_dot(vocab::Color::system_purple(), "m:entrance"));
        e.add(ui::row(erow).gap(16.0f64).align(flex::Align::Center));
        e.add(shell::caption("Built at opacity 0 and animated from on_attach. The start value gets its own apply in the mount walk, which is the whole of why this works."));
        body.add(shell::card("ENTRANCE", e));

        var d: flex::Builder = flex::Builder::new();
        var drow: flex::Builder = flex::Builder::new();
        drow.add(dot(vocab::Color::system_red(), "m:dead"));
        drow.add(ui::button("Dead snap", on_click: this.dead).height(44.0f64));
        d.add(ui::row(drow).gap(16.0f64).align(flex::Align::Center));
        d.add(shell::caption("Deliberately wrong: set_opacity(0) and animate_opacity(1) in one handler. Nothing moves, and facet says why on stderr. Watch the Xcode console."));
        body.add(shell::card("THE FAILURE THAT IS SILENT", d));

        return shell::page("Motion",
            "animate_* on the shared band, and the two rules the signatures do not show.",
            body, "page:motion");
    }
}

impl Motion: component::Lifecycle {
    fn on_attach(ref this) {
        match mount::find("m:entrance") {
            option::Option[*core::Node]::Some(n) => { fade_in(n); }
            option::Option[*core::Node]::None => { }
        }
        return;
    }
    fn on_detach(ref this) { return; }
}
