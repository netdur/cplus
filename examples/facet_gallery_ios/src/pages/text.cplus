// Text — labels, fields, and THE BAND THAT ONLY EXISTS ON THIS PLATFORM.
//
// `keyboard:` is declared on every facet input because a phone has one. The
// AppKit backend can do nothing with it at all; here it is one property, and
// this page is the place to see that facet's vocabulary is wider than any one
// platform rather than being macOS's with iOS bolted on.

import "facet/facet" as core;
import "facet/elements" as ui;
import "facet/component" as component;
import "facet/label" as label;
import "facet/text_field" as text_field;
import "facet/vocabulary" as vocab;
import "flex_layout/flex_layout" as flex;
import "stdlib/option" as option;
import "../shell" as shell;

struct Text {
    edits: i32,
}

impl Text {
    fn new() -> Text { return Text { edits: 0 }; }

    // Fires on every keystroke — `editingChanged`, which the backend arms
    // alongside the return key and the end of editing.
    fn on_typed(ref this, sender: *u8) {
        this.edits = this.edits + 1;
        match text_field::find("t:name") {
            option::Option[text_field::TextField]::Some(f) => {
                let typed: str = f.text();
                match label::find("t:echo") {
                    option::Option[label::Label]::Some(l) => {
                        if typed == "" {
                            let _l: label::Label = l.set_text("(nothing typed)");
                        } else {
                            let _l: label::Label = l.set_text(typed);
                        }
                    }
                    option::Option[label::Label]::None => { }
                }
            }
            option::Option[text_field::TextField]::None => { }
        }
        return;
    }
}

impl Text: component::Component {
    fn build(ref this) -> core::Node {
        var body: flex::Builder = flex::Builder::new();

        var type_: flex::Builder = flex::Builder::new();
        type_.add(ui::label("Display", font_size: 34.0f64,
                            font_weight: vocab::FontWeight::Bold));
        type_.add(ui::label("Title", font_size: 22.0f64,
                            font_weight: vocab::FontWeight::Semibold));
        type_.add(ui::label("Body — the size a paragraph is set at, and the one Dynamic Type scales when the reader has asked for larger text.",
                            font_size: 17.0f64, max_lines: 0 as i64,
                            line_break: vocab::LineBreak::WordWrap));
        type_.add(ui::label("Caption", font_size: 13.0f64,
                            text_color: vocab::Color::ink(0.5f64)));
        body.add(shell::card("TYPE", type_));

        var align: flex::Builder = flex::Builder::new();
        align.add(ui::label("Start — follows the writing direction",
                            font_size: 15.0f64, text_align: vocab::TextAlign::Start));
        align.add(ui::label("Center", font_size: 15.0f64,
                            text_align: vocab::TextAlign::Center));
        align.add(ui::label("End", font_size: 15.0f64,
                            text_align: vocab::TextAlign::End));
        align.add(shell::caption("`Start` is NSTextAlignment.Natural, which mirrors under RTL. `End` is Right and does not — Foundation has no natural-trailing, on either platform."));
        body.add(shell::card("ALIGNMENT", align));

        var fields: flex::Builder = flex::Builder::new();
        fields.add(ui::text_field("", key: "t:name", placeholder: "Your name",
                                  clear_button: vocab::ClearButton::WhileEditing,
                                  return_key: vocab::ReturnKey::Done,
                                  on_text_changed: this.on_typed)
                   .height(44.0f64));
        fields.add(ui::label("(nothing typed)", key: "t:echo", font_size: 15.0f64,
                             text_color: vocab::Color::ink(0.6f64)));
        fields.add(ui::text_field("", key: "t:secure", placeholder: "Password",
                                  secure: true, return_key: vocab::ReturnKey::Go)
                   .height(44.0f64));
        fields.add(shell::caption("`secure` is a PROPERTY on iOS. On macOS it names a different class, and the AppKit backend carries a whole live-reclass path for that one prop."));
        body.add(shell::card("FIELDS", fields));

        // The keyboard band. Tap each and watch the keyboard change — this is
        // the page's reason to exist.
        var keys: flex::Builder = flex::Builder::new();
        keys.add(ui::text_field("", key: "t:email", placeholder: "Email",
                                keyboard: vocab::Keyboard::Email,
                                return_key: vocab::ReturnKey::Next).height(44.0f64));
        keys.add(ui::text_field("", key: "t:phone", placeholder: "Phone",
                                keyboard: vocab::Keyboard::Telephone).height(44.0f64));
        keys.add(ui::text_field("", key: "t:num", placeholder: "Amount",
                                keyboard: vocab::Keyboard::Numeric).height(44.0f64));
        keys.add(ui::text_field("", key: "t:url", placeholder: "Website",
                                keyboard: vocab::Keyboard::Url,
                                return_key: vocab::ReturnKey::Search).height(44.0f64));
        keys.add(shell::caption("facet declares `keyboard:` on every input because a phone has one. AppKit can do nothing with the verb; here it is one property. Tap each field to see a different keyboard."));
        body.add(shell::card("KEYBOARDS — iOS ONLY", keys));

        return shell::page("Text",
            "Type, alignment, fields — and the one band macOS cannot answer at all.",
            body, "page:text");
    }
}

impl Text: component::Lifecycle {
    fn on_attach(ref this) { return; }
    fn on_detach(ref this) { return; }
}
