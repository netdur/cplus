// Tiers — the four kinds this backend gained last, on one screen.
//
// A canvas, a swipeable, a radio group and a split. They are here together
// because they are the four whose iOS answer is DIFFERENT from the AppKit one
// rather than a translation of it, and seeing them side by side is the fastest
// way to check that each of them is the thing it claims:
//
//   canvas    — the same recorded display list, replayed against the same Core
//               Graphics. No flip: a UIView is already top-left.
//   swipeable — a real swipe, driven by a pan. macOS reads the same items as a
//               context menu, because macOS has no finger.
//   radio     — a labelled circle button, not a switch. A switch has nowhere to
//               put a title, a border or a radius, and a radio has all three.
//   split     — every verb a split has except dragging the divider, which is a
//               pointer idiom with no touch equivalent.

import "facet/facet" as core;
import "facet/elements" as ui;
import "facet/component" as component;
import "facet/vocabulary" as vocab;
import "facet/label" as label;
import "facet/split" as m_split;
import "flex_layout/flex_layout" as flex;
import "stdlib/option" as option;
import "stdlib/status" as status;
import "stdlib/text" as text;
import "../shell" as shell;

struct Tiers {
    _unused: i32,
}

impl Tiers {
    fn new() -> Tiers { return Tiers { _unused: 0 }; }

    fn on_archive(ref this, sender: *u8) { say("Archive"); return; }
    fn on_delete(ref this, sender: *u8) { say("Delete"); return; }
}

fn say(what: str) {
    match label::find("t:status") {
        option::Option[label::Label]::Some(l) => {
            let _l: label::Label = l.set_text("last action: ${what}");
        }
        option::Option[label::Label]::None => { }
    }
    return;
}

// The drawing. It RECORDS — it is handed a Canvas and appends to it, and
// nothing in it knows what platform will replay it. That is why the same
// function would draw the same picture in the desktop gallery.
fn draw_badge(into: *vocab::Canvas, dirty: vocab::Rect, ctx: *u8) {
    let w: f64 = { (*into).size().width };
    let h: f64 = { (*into).size().height };

    { (*into).set_fill(vocab::Color::system_indigo()) };
    let _bg: status::Status = { (*into).fill_rounded_rect(
        vocab::Rect::of(0.0f64, 0.0f64, w, h), 12.0f64) };

    // A circle and a wedge out of it, to show the fill rules and the arc
    // convention agree with the AppKit replay's.
    { (*into).set_fill(vocab::Color::system_teal()) };
    let _c: status::Status = { (*into).fill_ellipse(
        vocab::Rect::of(14.0f64, 14.0f64, h - 28.0f64, h - 28.0f64)) };

    { (*into).set_stroke(vocab::Color::on(vocab::Color::system_indigo())) };
    { (*into).set_stroke_width(3.0f64) };
    let _l1: status::Status = { (*into).draw_line(
        from: vocab::Point::of(w - 70.0f64, 22.0f64),
        to: vocab::Point::of(w - 22.0f64, 22.0f64)) };
    let _l2: status::Status = { (*into).draw_line(
        from: vocab::Point::of(w - 70.0f64, h / 2.0f64),
        to: vocab::Point::of(w - 34.0f64, h / 2.0f64)) };
    let _l3: status::Status = { (*into).draw_line(
        from: vocab::Point::of(w - 70.0f64, h - 22.0f64),
        to: vocab::Point::of(w - 46.0f64, h - 22.0f64)) };

    { (*into).set_text_color(vocab::Color::on(vocab::Color::system_indigo())) };
    let _f: status::Status = { (*into).set_font(size: 15.0f64,
                                                weight: vocab::FontWeight::Medium) };
    let _t: status::Status = { (*into).draw_text("Core Graphics",
        at: vocab::Point::of(20.0f64, h - 26.0f64)) };
    return;
}

impl Tiers: component::Component {
    fn build(ref this) -> core::Node {
        var body: flex::Builder = flex::Builder::new();

        // ---- canvas ----------------------------------------------------------
        var cv: flex::Builder = flex::Builder::new();
        cv.add(shell::blurb("Every shape below was RECORDED by a function that names no platform, then replayed against Core Graphics — the same framework, the same replay loop and the same arc convention the AppKit backend uses."));
        cv.add(ui::canvas(key: "t:canvas", drawable: vocab::Drawable::of(draw_badge))
                   .height(120.0f64));
        body.add(shell::card("CANVAS", cv));

        // ---- swipeable -------------------------------------------------------
        var sw: flex::Builder = flex::Builder::new();
        sw.add(shell::blurb("Drag the row left. It follows your finger, and where it lands when you let go is `reveal_threshold`'s decision — which is the verb UISwipeActionsConfiguration cannot honour, and the reason this is a pan."));
        var row_body: flex::Builder = flex::Builder::new();
        row_body.add(ui::label("Meeting notes", key: "t:title", font_size: 15.0f64,
                               font_weight: vocab::FontWeight::Medium));
        row_body.add(ui::label("Swipe left for actions", key: "t:sub",
                               font_size: 12.0f64,
                               text_color: vocab::Color::ink(0.55f64)));
        var content: core::Node = ui::column(row_body).padding(12.0f64).gap(2.0f64);
        content.set_background_color(vocab::Color::fill());
        content.set_corner_radius(vocab::Corners::all(8.0f64));

        var row: core::Node = ui::swipeable(key: "t:row", reveal_threshold: 60.0f64)
            .height(64.0f64);
        let _c: status::Status = row.add_child(content);
        let _a: status::Status = row.add_child(ui::swipe_item(
            key: "t:archive", text: "Archive", on_clicked: this.on_archive));
        let _d: status::Status = row.add_child(ui::swipe_item(
            key: "t:delete", text: "Delete", destructive: true,
            on_clicked: this.on_delete));
        sw.add(row);
        sw.add(ui::label("last action: (none)", key: "t:status", font_size: 13.0f64,
                         text_color: vocab::Color::ink(0.7f64)));
        body.add(shell::card("SWIPEABLE", sw));

        // ---- radio -----------------------------------------------------------
        var rd: flex::Builder = flex::Builder::new();
        rd.add(shell::blurb("Three members of one group. Tapping one turns the others off — nothing in UIKit does that, so facet's group name is walked over the mounted tree, which is the only place the siblings can be found."));
        rd.add(ui::radio(true, key: "t:r1", text: "Every hour", group: "when",
                         font_size: 16.0f64));
        rd.add(ui::radio(false, key: "t:r2", text: "Every day", group: "when",
                         font_size: 16.0f64));
        rd.add(ui::radio(false, key: "t:r3", text: "Never", group: "when",
                         font_size: 16.0f64, text_color: vocab::Color::danger()));
        body.add(shell::card("RADIO", rd));

        // ---- split -----------------------------------------------------------
        var sp: flex::Builder = flex::Builder::new();
        sp.add(shell::blurb("The divider sits at `position`, clamped by both minimums, with the hairline drawn in the gap between the panes. What is absent is dragging it."));
        var panes: flex::Builder = flex::Builder::new();
        panes.add(shell::painted(ui::column(flex::Builder::new()),
                                 vocab::Color::system_teal(), 8.0f64));
        panes.add(shell::painted(ui::column(flex::Builder::new()),
                                 vocab::Color::system_indigo(), 8.0f64));
        sp.add(ui::split(panes, key: "t:split", axis: m_split::SplitAxis::Rows,
                         position: 44.0f64, min_leading: 20.0f64,
                         min_trailing: 20.0f64,
                         divider_thickness: 2.0f64).height(120.0f64));
        body.add(shell::card("SPLIT", sp));

        return shell::page("Tiers",
            "The four kinds whose iOS answer is different from the AppKit one rather than a translation of it.",
            body, "page:tiers");
    }
}

impl Tiers: component::Lifecycle {
    fn on_attach(ref this) { return; }
    fn on_detach(ref this) { return; }
}
