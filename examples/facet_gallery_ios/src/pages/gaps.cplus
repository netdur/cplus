// Gaps — the page that shows what is NOT built, on purpose.
//
// A gallery that only showed the finished parts would be the most misleading
// document in the repo. facet_uikit keeps two lists strictly apart —
// `decided_absent` (iOS has no such thing; silent) and `not_yet_built` (iOS has
// an answer nobody wrote yet; warns once on stderr) — and this page mounts one
// of each so both behaviours can be observed rather than read about.
//
// THE SECOND LIST IS NOW EMPTY, and that is the news. Every kind this page used
// to name as unbuilt — list, table, tree, collection, carousel, swipeable, web,
// hybrid_web, canvas, split — has a body. What is left is three verbs UIKit has
// no answer for, and they are shown here rather than described, because a
// "cannot" that is only ever read is one nobody checks.

import "facet/facet" as core;
import "facet/elements" as ui;
import "facet/component" as component;
import "facet/vocabulary" as vocab;
import "flex_layout/flex_layout" as flex;
import "facet/list" as list;
import "facet/split" as m_split;
import "stdlib/option" as option;
import "../shell" as shell;

struct Gaps {
    _unused: i32,
}

impl Gaps {
    fn new() -> Gaps { return Gaps { _unused: 0 }; }
}

// The row builder the list calls. It is called for the rows on screen and for
// no others, which is the whole point of the tier.
fn gap_row(i: usize, ctx: *u8) -> core::Node {
    var b: flex::Builder = flex::Builder::new();
    b.add(ui::label("Row ${i}", font_size: 16.0f64));
    b.add(ui::column(flex::Builder::new()).grow(1.0f64));
    b.add(ui::label("recycled", font_size: 13.0f64,
                    text_color: vocab::Color::ink(0.45f64)));
    return ui::row(b).padding(12.0f64).gap(8.0f64).align(flex::Align::Center);
}

impl Gaps: component::Component {
    fn build(ref this) -> core::Node {
        var body: flex::Builder = flex::Builder::new();

        // ---- what UIKit cannot do -------------------------------------------
        // A date picker whose font verbs are written and do nothing. This is the
        // whole of the remaining gap: UIDatePicker draws its own calendar and
        // exposes no font at all — not a family, not a size, not a weight — so
        // the six verbs land on a control with nowhere to put them.
        var cannot: flex::Builder = flex::Builder::new();
        cannot.add(shell::blurb("The picker below asks for a 28pt bold serif face. It is drawn in the system font, because UIDatePicker has no font property of any kind — the class has twenty-odd methods and every one of them is about dates."));
        cannot.add(shell::painted(
            ui::date_picker(vocab::Date { year: 2026 as i64, month: 8 as i64, day: 16 as i64 },
                            key: "g:date", font_size: 28.0f64,
                            font_family: "Georgia",
                            font_weight: vocab::FontWeight::Bold)
                .height(44.0f64),
            vocab::Color::fill(), 10.0f64));
        cannot.add(shell::caption("The other two: a `table`'s style is fixed by initWithFrame:style: and cannot move after the table is mounted, and `window_chrome` names close/minimise/zoom buttons an iOS window does not have. Three verbs, all recorded in MANIFEST.md §3."));
        body.add(shell::card("UIKIT CANNOT — SILENT", cannot));

        // ---- the recycling tier ---------------------------------------------
        var recycling: flex::Builder = flex::Builder::new();
        recycling.add(shell::blurb("Forty rows over a real UITableView with a real data source. The row callback runs for the rows on screen and for no others — forty nodes, about a dozen cells, and the cells come back as you scroll."));
        var host: core::Node = ui::list(key: "g:list", row_height: 48 as i64)
            .height(200.0f64);
        match list::find("g:list", within: #addr_of(host)) {
            option::Option[list::List]::Some(l) => {
                let _c: list::List = l.set_count(40 as usize);
                let _r: list::List = l.set_row(gap_row);
            }
            option::Option[list::List]::None => { }
        }
        recycling.add(shell::painted(host, vocab::Color::fill(), 10.0f64));
        recycling.add(shell::caption("`table`, `tree`, `collection` and `carousel` sit on the same tier — the first two on UITableView, the last two on UICollectionView."));
        body.add(shell::card("RECYCLING — BUILT", recycling));

        // ---- the split -------------------------------------------------------
        // It used to be on the "decided absent" list, whole. One fact about it
        // is absent; the rest is geometry, and geometry is flex's.
        var sp: flex::Builder = flex::Builder::new();
        sp.add(shell::blurb("A real split: the divider sits where `position` says, the panes honour their minimums, and the hairline between them is the split's own. What iOS has no answer for is DRAGGING it — a divider is a pointer idiom — so the position is the application's to set and nobody else's."));
        var panes: flex::Builder = flex::Builder::new();
        panes.add(shell::painted(ui::column(flex::Builder::new()),
                                 vocab::Color::system_teal(), 8.0f64));
        panes.add(shell::painted(ui::column(flex::Builder::new()),
                                 vocab::Color::system_indigo(), 8.0f64));
        sp.add(ui::split(panes, key: "g:split", axis: m_split::SplitAxis::Rows,
                         position: 40.0f64, min_leading: 20.0f64,
                         min_trailing: 20.0f64,
                         divider_thickness: 2.0f64).height(110.0f64));
        body.add(shell::card("SPLIT — BUILT, MINUS THE DRAG", sp));

        return shell::page("Gaps",
            "What this backend does not do, shown rather than described. The unbuilt list is empty; what is left is three verbs UIKit has no answer for.",
            body, "page:gaps");
    }
}

impl Gaps: component::Lifecycle {
    fn on_attach(ref this) { return; }
    fn on_detach(ref this) { return; }
}
