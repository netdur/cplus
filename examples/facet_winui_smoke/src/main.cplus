import "facet/elements" as ui;
import "facet/facet" as core;
import "facet/label" as label;
import "facet/component" as component;
import "facet/mount" as mount;
import "facet_winui/facet_winui" as host;
import "stdlib/option" as option;
import "stdlib/box" as box;
import "stdlib/text" as text;
import "stdlib/io" as io;
import "winrt/runtime" as rt;
extern fn fflush(stream: *u8) -> i32;

struct Counter { clicks: i32 }
impl Counter {
    fn increment(ref this) -> core::Node {
        return @ui { button("Increment",key:"increment",on_click:this.clicked).width(300.0f64).height(52.0f64) };
    }
    fn clicked(ref this, sender: *u8) {
        let key: text::Text=component::key_of(sender); assert key.view()=="increment";
        this.clicks=this.clicks+1; let count: i32=this.clicks;
        match label::find("count") {
            option::Option::Some(value)=>{let updated: label::Label=value.set_text("Facet clicked ${count} times");},
            option::Option::None=>{assert false;}
        }
        // Exercise removal while its native event callback is on the stack.
        // This replaces one test control, not the screen's retained tree.
        match mount::find("root") {
            option::Option::Some(root)=>{
                match mount::replace_child(root,3 as usize,this.increment()) {
                    option::Option::Some(old)=>{}, option::Option::None=>{assert false;}
                }
            },option::Option::None=>{assert false;}
        }
        assert host::live_views()==5; assert host::live_subscriptions()==1;
        io::println("CLICK ${count}: Facet handler updated retained label"); let _f: i32=fflush(0 as *u8);
        return;
    }
    fn build(ref this) -> core::Node {
        return @ui {
            column(key:"root") {
                label("Facet, rendered by WinUI",key:"heading",font_size:30.0f64).height(52.0f64)
                label("A retained Facet tree using generated native bindings.",key:"description",font_size:16.0f64)
                label("Facet clicked 0 times",key:"count",font_size:24.0f64)
                this.increment()
            }.padding(36.0f64).gap(16.0f64)
        };
    }
}
fn main() -> i32 {
    let owner: box::Box[Counter]=match box::new::[Counter](Counter {clicks:0}) {
        option::Option::Some(v)=>{v},option::Option::None=>{return 1;}
    };
    let counter: *Counter=owner.ptr();
    let result: rt::Status=host::run((*counter).build(),"Facet / generated WinUI");
    let clicks: i32=(*counter).clicks; let remaining: i64=host::live_views();
    let subscriptions: i64=host::live_subscriptions();
    io::println("CLEAN EXIT; clicks=${clicks}; live views=${remaining}; subscriptions=${subscriptions}"); let _f: i32=fflush(0 as *u8);
    return if result.is_ok() {0} else {1};
}
