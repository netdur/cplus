import "stdlib/box" as box;
import "stdlib/option" as option;
import "stdlib/env" as env;
import "facet/facet" as core;
import "facet/elements" as ui;
import "facet/props" as props;
import "facet/text_button" as text_button;
import "facet/tree" as tree;
import "facet/services" as services;
import "facet_winui/facet_winui" as host;
import "facet_winui/choices" as choices;
import "facet_winui/record" as record;
import "facet_winui/items" as items;
import "facet_winui/outline" as outline;
import "winui/winui" as native;
import "winrt/runtime" as rt;
import "./parity" as check;
fn key(i: usize) -> str {return if i==0 {"normal"} else if i==1 {"icon"} else if i==2 {"text"} else if i==3 {"row"} else if i==4 {"page"} else {"tree_button"};}
fn node(i: usize) -> *core::Node {
    if i==3 {let s=items::state(core::view_of(check::node("list")) as *record::View);return match (*s).rows.at_ptr(0) {option::Option::Some(row)=>(*row).node.ptr(),option::Option::None=>{assert false;0 as *core::Node}};}
    if i==5 {let r=core::view_of(check::node("tree")) as *record::View;let s=(*r).extra as *outline::State;return match (*s).entries.at_ptr(0) {option::Option::Some(entry)=>#addr_of((*(*entry).row).node),option::Option::None=>{assert false;0 as *core::Node}};}
    return check::node(key(i));
}
fn object(i: usize) -> rt::Object {return (*(core::view_of(node(i)) as *record::View)).object.clone();}
fn mode(i: usize,value: bool) {
    let n=node(i);let raw=(*core::node_data(n)).props;
    if i==1 {let p=raw as *props::IconButtonProps;(*p).toggles=value;}
    else if i==2 {let p=raw as *text_button::TextButtonProps;(*p).toggles=value;}
    else {let p=raw as *props::ButtonProps;(*p).toggles=value;}
    core::touch(n,18446744073709551615u64);
}
fn model_on(i: usize) -> bool {
    let raw=(*core::node_data(node(i))).props;
    if i==1 {return (*(raw as *props::IconButtonProps)).on;}
    if i==2 {return (*(raw as *text_button::TextButtonProps)).on;}
    return (*(raw as *props::ButtonProps)).on;
}
fn identity(value: rt::Object) -> rt::Object {return check::must::[rt::Object](value.query(rt::unknown_iid()));}
fn peer(value: rt::Object,pattern: i32) -> rt::Object {
    let factory=check::must::[native::IFrameworkElementAutomationPeerStatics](native::FrameworkElementAutomationPeer::i_framework_element_automation_peer_statics_factory());let p=check::must::[native::IAutomationPeer](native::IAutomationPeer::query(check::must::[rt::Object](factory.create_peer_for_element(value))));return check::must::[rt::Object](p.get_pattern(pattern));
}
struct Probe {count: usize,calls: usize,phase: usize,passed: bool,old: [rt::Object;6],records: [usize;6],timer: services::Cancellable}
impl Probe {
    fn clicked(ref this,sender: *u8) {this.calls=this.calls+1;}
    fn row(ref this,index: usize) -> core::Node {return ui::button("List row",key:"row",on_click:this.clicked);}
    fn tree_row(ref this,item: *tree::TreeNode) -> core::Node {return ui::button("Tree row",key:"tree_button",on_click:this.clicked);}
    fn build(ref this) -> core::Node {
        if this.count==1 {return ui::button("Root button",key:"normal",on_click:this.clicked);}
        var pager=ui::carousel(key:"carousel").height(65.0f64);assert pager.add_child(ui::button("Page",key:"page",on_click:this.clicked)).is_ok();
        var model=tree::TreeNode::new("Root","root",true);let added=model.add_child(tree::TreeNode::new("Child","child",false));
        return @ui {column {
            button("Ordinary",key:"normal",on_click:this.clicked)
            icon_button("star",key:"icon",on_clicked:this.clicked)
            text_button("Text",key:"text",on_click:this.clicked)
            list(key:"list",count:1,row:this.row,row_height:40).height(55.0f64)
            pager
            tree(model,key:"tree",row:this.tree_row).height(70.0f64)
        }.padding(20.0f64).gap(4.0f64)};
    }
    fn ready(ref this) {this.timer=services::after(0.3f64,this.start);}
    fn start(ref this) {
        check::log("BUTTON MODES: begin");let visual=check::must::[native::IUIElement](native::IUIElement::query(object(0)));assert check::must::[bool](visual.focus(native::focus_state_programmatic));
        var i: usize=0;while i<this.count {this.old[i]=object(i);this.records[i]=core::view_of(node(i)) as usize;mode(i,true);i=i+1;}
        this.timer=services::after(0.2f64,this.toggled);
    }
    fn toggled(ref this) {
        check::log("BUTTON MODES: toggle state");let focused=check::must::[native::IUIElement](native::IUIElement::query(object(0)));assert check::must::[i32](focused.focus_state())!=native::focus_state_unfocused;
        assert this.calls==this.phase*this.count*2;
        var i: usize=0;while i<this.count {
            let value=object(i);assert identity(value).raw()!=identity(this.old[i]).raw();assert core::view_of(node(i)) as usize==this.records[i];
            let element=check::must::[native::IFrameworkElement](native::IFrameworkElement::query(value));assert check::must::[f64](element.actual_width())>0.0f64;assert check::must::[f64](element.actual_height())>0.0f64;
            assert !choices::is_checked(value);let provider=check::must::[native::IToggleProvider](native::IToggleProvider::query(peer(value,native::pattern_interface_toggle)));assert provider.toggle().is_ok();
            this.old[i]=value.clone();mode(i,false);
            // A native state event from the old mode cannot overwrite the pending mode.
            let old=check::must::[native::IToggleButton](native::IToggleButton::query(value));assert old.set_is_checked(choices::boxed(false)).is_ok();
            i=i+1;
        }
        assert this.calls==(this.phase*2+1)*this.count;
        if this.phase==1 && env::has_var("CPLUS_BUTTON_CLOSE_TOGGLE") {var i: usize=0;while i<this.count {this.old[i]=rt::Object::empty();i=i+1;}this.passed=true;assert host::close().is_ok();return;}
        this.timer=services::after(0.2f64,this.ordinary);
    }
    fn ordinary(ref this) {
        check::log("BUTTON MODES: ordinary state");var checked: usize=0;while checked<this.count {assert model_on(checked);checked=checked+1;}
        assert this.calls==(this.phase*2+1)*this.count;
        var i: usize=0;while i<this.count {
            let value=object(i);assert identity(value).raw()!=identity(this.old[i]).raw();assert core::view_of(node(i)) as usize==this.records[i];
            let provider=check::must::[native::IInvokeProvider](native::IInvokeProvider::query(peer(value,native::pattern_interface_invoke)));assert provider.invoke().is_ok();
            // Retained old native objects have no delegates after replacement.
            let old=check::must::[native::IToggleButton](native::IToggleButton::query(this.old[i]));assert old.set_is_checked(choices::boxed(true)).is_ok();
            i=i+1;
        }
        this.timer=services::after(0.2f64,this.again);
    }
    fn again(ref this) {
        assert this.calls==(this.phase+1)*this.count*2;this.phase=this.phase+1;
        if this.phase==2 {
            var i: usize=0;while i<this.count {mode(i,true);this.old[i]=rt::Object::empty();i=i+1;}
            // Close before synchronization: teardown must use the subscribed class.
            this.passed=true;assert host::close().is_ok();return;
        }
        // Reset the model's checked state before the next round.
        var i: usize=0;while i<this.count {let r=core::view_of(node(i)) as *record::View;let raw=(*core::node_data((*r).node)).props;if i==1 {(*(raw as *props::IconButtonProps)).on=false;}else if i==2 {(*(raw as *text_button::TextButtonProps)).on=false;}else {(*(raw as *props::ButtonProps)).on=false;}i=i+1;}
        this.start();
    }
}
fn run() -> i32 {let owner=match box::new::[Probe](#zero::[Probe]()) {option::Option::Some(v)=>v,option::Option::None=>{return 1;}};let p=owner.ptr();(*p).count=if env::has_var("CPLUS_BUTTON_ROOT") {1 as usize} else {6 as usize};assert host::run((*p).build(),"Facet WinUI button modes",on_ready:(*p).ready).is_ok();assert (*p).passed;assert host::live_views()==0;assert host::live_subscriptions()==0;check::log("PASS: live button classes, stable records, native callbacks, stale-event suppression, parent slots and pending-mode teardown");return 0;}
