        let p: *props::ListProps=(*core::node_data(check::node("separators"))).props as *props::ListProps;(*p).separator=vocab::Separator::None;core::touch(check::node("separators"),0xffffffffffffffffu64);this.timer=services::after(0.2f64,this.separator_off);
