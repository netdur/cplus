        this.height_scale=1.0f64;match list::find("separators") {option::Option::Some(v)=>{let changed=v.set_count(20).set_uneven_rows(true).set_row_height_of(this.row_height);},option::Option::None=>{assert false;}}
        this.timer=services::after(0.2f64,this.uneven_ready);
