}
fn run() -> i32 {
    let owner: box::Box[Probe]=match box::new::[Probe](#zero::[Probe]()) {option::Option::Some(v)=>v,option::Option::None=>{return 1;}};
    let p: *Probe=owner.ptr();assert host::run((*p).build(),"Facet WinUI styles",on_ready:(*p).ready).is_ok();
    assert (*p).passed;assert host::live_views()==0;assert host::live_subscriptions()==0;check::log("PASS: style/event teardown");return 0;
}
