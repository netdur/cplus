            (*p).font_family=text::from_str("Consolas");(*p).text_color=vocab::Color::rgba(1.0f64,0.0f64,0.0f64,1.0f64);
            core::touch(check::node("radio"),0xffffffffffffffffu64);
        }
        {let p: *text_button::TextButtonProps=(*core::node_data(check::node("text_button"))).props as *text_button::TextButtonProps;
            (*p).font_size=20.0f64;(*p).character_spacing=2.0f64;
            (*p).font_weight=vocab::FontWeight::Bold;(*p).is_italic=true;(*p).font_scales=false;
            (*p).font_family=text::from_str("Consolas");(*p).text_color=vocab::Color::rgba(1.0f64,0.0f64,0.0f64,1.0f64);
            (*p).bordered=true;(*p).border_width=3.0f64;(*p).border_color=vocab::Color::rgba(1.0f64,0.0f64,0.0f64,1.0f64);
            (*p).corner_radius=vocab::Corners::all(8.0f64);(*p).text_decoration=vocab::TextDecoration::Underline;(*p).text_align=vocab::TextAlign::End;
