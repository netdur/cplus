        match list::find("separators") {option::Option::Some(v)=>{let changed=v.set_uneven_rows(false);},option::Option::None=>{assert false;}}this.timer=services::after(0.2f64,this.uneven_reset);
    }
    fn uneven_reset(ref this) {
