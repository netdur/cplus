            core::touch(check::node("time"),0xffffffffffffffffu64);
        }
        let p: *props::LabelProps=(*core::node_data(check::node("label"))).props as *props::LabelProps;
        (*p).font_size=20.0f64;(*p).font_family=text::from_str("Consolas");(*p).character_spacing=2.0f64;(*p).font_scales=false;
        (*p).text_align=vocab::TextAlign::Center;(*p).text_decoration=vocab::TextDecoration::Underline;
        core::touch(check::node("label"),0xffffffffffffffffu64);
        {let p: *props::TextFieldProps=(*core::node_data(check::node("input"))).props as *props::TextFieldProps;
            (*p).input_view.font_size=20.0f64;(*p).input_view.character_spacing=2.0f64;
            (*p).input_view.font_weight=vocab::FontWeight::Bold;(*p).input_view.is_italic=true;(*p).input_view.font_scales=false;
            (*p).input_view.font_family=text::from_str("Consolas");(*p).input_view.text_color=vocab::Color::rgba(1.0f64,0.0f64,0.0f64,1.0f64);
            (*p).text_align=vocab::TextAlign::End;(*p).vertical_align=vocab::TextAlign::End;
            (*p).input_view.keyboard=vocab::Keyboard::Numeric;
            core::touch(check::node("input"),0xffffffffffffffffu64);
        }
        {let p: *props::SearchFieldProps=(*core::node_data(check::node("search"))).props as *props::SearchFieldProps;
            (*p).input_view.font_size=20.0f64;(*p).input_view.character_spacing=2.0f64;
            (*p).input_view.font_weight=vocab::FontWeight::Bold;(*p).input_view.is_italic=true;(*p).input_view.font_scales=false;
            (*p).input_view.font_family=text::from_str("Consolas");(*p).input_view.text_color=vocab::Color::rgba(1.0f64,0.0f64,0.0f64,1.0f64);
            (*p).text_align=vocab::TextAlign::End;(*p).vertical_align=vocab::TextAlign::End;
            (*p).input_view.keyboard=vocab::Keyboard::Email;
            core::touch(check::node("search"),0xffffffffffffffffu64);
