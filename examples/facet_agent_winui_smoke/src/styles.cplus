        check::log("PASS: variable list heights, cached measurements, scroll-to and uniform reset");
        let p=#addr_of((*core::node_data(check::node("label"))).common);
        (*p).accessibility_label=text::from_str("Accessible heading");(*p).accessibility_hint=text::from_str("Additional help");(*p).heading_level=3;(*p).tooltip=text::from_str("Tip — 世界");core::touch(check::node("label"),0xffffffffffffffffu64);
