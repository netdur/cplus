        let scroll=check::must::[native::IScrollViewer](native::IScrollViewer::query(check::object("scroll")));assert !check::must::[bool](scroll.is_horizontal_scroll_chaining_enabled());assert !check::must::[bool](scroll.is_vertical_scroll_chaining_enabled());
        let sp: *props::ScrollProps=(*core::node_data(check::node("scroll"))).props as *props::ScrollProps;(*sp).cascades_input=true;core::touch(check::node("scroll"),0xffffffffffffffffu64);
