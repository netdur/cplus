        let tips=check::must::[native::IToolTipServiceStatics](native::ToolTipService::i_tool_tip_service_statics_factory());assert check::must::[rt::Object](tips.get_tool_tip(check::object("label"))).raw()==this.tooltip_object.raw();
        let p=#addr_of((*core::node_data(check::node("label"))).common);(*p).accessibility_label=text::from_str("Updated heading");(*p).heading_level=9;(*p).tooltip=text::from_str("Updated tip");core::touch(check::node("label"),0xffffffffffffffffu64);this.timer=services::after(0.2f64,this.accessible_clear);
    }
    fn accessible_clear(ref this) {
        let a=check::must::[native::IAutomationPropertiesStatics](native::AutomationProperties::i_automation_properties_statics_factory());let view=check::object("label");assert check::must(a.get_name(view)).view()=="Updated heading";assert check::must::[i32](a.get_heading_level(view))==9;
        let tips=check::must::[native::IToolTipServiceStatics](native::ToolTipService::i_tool_tip_service_statics_factory());let boxed=check::must::[native::IPropertyValue](native::IPropertyValue::query(check::must::[rt::Object](tips.get_tool_tip(view))));assert check::must(boxed.get_string()).view()=="Updated tip";
        let p=#addr_of((*core::node_data(check::node("label"))).common);(*p).accessibility_label=text::new();(*p).accessibility_hint=text::new();(*p).heading_level=99;(*p).tooltip=text::new();core::touch(check::node("label"),0xffffffffffffffffu64);this.timer=services::after(0.2f64,this.accessible_reset);
