            assert family(check::must::[rt::Object](c.font_family()))==this.families[i];assert check::must::[i32](c.character_spacing())==0;
            assert check::must::[i32](c.font_style())==native::font_style_normal;assert check::must::[bool](c.is_text_scale_factor_enabled());i=i+1;}
        let button=control(7);assert check::must::[native::Thickness](button.border_thickness()).left==0.0f64;
        assert check::must::[native::CornerRadius](button.corner_radius()).top_left==0.0f64;
