            core::touch(check::node("date"),0xffffffffffffffffu64);
        }
        {let p: *props::TimePickerProps=(*core::node_data(check::node("time"))).props as *props::TimePickerProps;
            (*p).font_size=20.0f64;(*p).character_spacing=2.0f64;
