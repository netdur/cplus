import "facet_winui/facet_winui" as host;
import "winui/winui" as native;
import "winrt/runtime" as rt;
import "./parity" as check;
fn key(index: usize) -> str {return if index==0 {"popup"} else if index==1 {"date"} else if index==2 {"time"} else if index==3 {"input"} else if index==4 {"search"} else if index==5 {"area"} else if index==6 {"radio"} else {"text_button"};}
fn control(index: usize) -> native::IControl {return check::must::[native::IControl](native::IControl::query(check::object(key(index))));}
fn family(value: rt::Object) -> text::Text {let f=check::must::[native::IFontFamily](native::IFontFamily::query(value));return check::must::[text::Text](f.source());}
fn scope_value(value: rt::Object) -> i32 {
    let scope=check::must::[native::IInputScope](native::IInputScope::query(value));let names=check::must::[native::IVector_Microsoft_UI_Xaml_Input_InputScopeName](native::IVector_Microsoft_UI_Xaml_Input_InputScopeName::query(check::must::[rt::Object](scope.names())));
    let entry=check::must::[native::IInputScopeName](native::IInputScopeName::query(check::must::[rt::Object](names.get_at(0))));return check::must::[i32](entry.name_value());
}
fn tree_props() -> *tree::TreeProps {return (*core::node_data(check::node("tree"))).props as *tree::TreeProps;}
fn selected_nodes() -> native::IVector_Microsoft_UI_Xaml_Controls_TreeViewNode {let c=check::must::[native::ITreeView](native::ITreeView::query(check::object("tree")));return check::must::[native::IVector_Microsoft_UI_Xaml_Controls_TreeViewNode](native::IVector_Microsoft_UI_Xaml_Controls_TreeViewNode::query(check::must::[rt::Object](c.selected_nodes())));}
struct Probe {height_scale: f64,height_calls: usize,tree_events: i32,allow_second: bool,sizes: [f64;8],families: [text::Text;8],label_size: f64,label_family: text::Text,opens: i32,closes: i32,passed: bool,tooltip_object: rt::Object,timer: services::Cancellable}
impl Probe {
    fn row_height(ref this,index: usize) -> f64 {this.height_calls=this.height_calls+1;return (if index%2==0 {24.0f64} else {48.0f64})*this.height_scale;}
    fn separator_row(ref this,index: usize) -> core::Node {return ui::label("Row ${index}",key:"separator_row_${index}");}
    fn tree_selected(ref this,item: *tree::TreeNode) {this.tree_events=this.tree_events+1;assert (*item).id.view()=="a" || (*item).id.view()=="b";}
    fn item_enabled(ref this,index: usize) -> bool {return index==0 || this.allow_second;}
    fn check_enabled(ref this,expected: bool) {
        let host=check::must::[native::IItemsControl](native::IItemsControl::query(check::object("popup")));let items=check::must::[native::IVector_Object](native::IVector_Object::query(check::must::[rt::Object](host.items())));
        let item=check::must::[native::IControl](native::IControl::query(check::must::[rt::Object](items.get_at(1))));assert check::must::[bool](item.is_enabled())==expected;
    }
    fn opened(ref this,sender: *u8) {this.opens=this.opens+1;let name=component::key_of(sender);check::log("OPEN ${name}");}
    fn closed(ref this,sender: *u8) {this.closes=this.closes+1;let name=component::key_of(sender);check::log("CLOSE ${name}");}
    fn remove_popup(ref this,sender: *u8) {let old=mount::replace("ephemeral",ui::label("Replaced",key:"ephemeral"));check::log("PASS: popup removed safely from its opened callback");}
    fn build(ref this) -> core::Node {
        var values: vocab::TextList=vocab::TextList::new();let added=values.add("One");let more=values.add("Two");
        var root=tree::TreeNode::new("Root","root",true);let a=root.add_child(tree::TreeNode::new("Alpha","a"));let b=root.add_child(tree::TreeNode::new("Beta","b"));
        return @ui {column {
            list(key:"separators",count:3,row:this.separator_row,row_height:28).height(64.0f64)
            tree(root,key:"tree",on_select:this.tree_selected).height(80.0f64)
            label("Style probe",key:"label").height(40.0f64)
            popup("Choose",key:"popup",items:values,on_opened:this.opened,on_closed:this.closed).height(48.0f64)
            date_picker(vocab::Date {year:2026,month:9,day:30},key:"date",on_opened:this.opened,on_closed:this.closed).height(48.0f64)
            time_picker(vocab::Duration {seconds:3600.0f64},key:"time").height(48.0f64)
            text_field("Field",key:"input").height(40.0f64)
            search_field("Search",key:"search").height(40.0f64)
            text_area("Area",key:"area").height(48.0f64)
            radio(false,text:"Radio",key:"radio").height(40.0f64)
            text_button("Text button",key:"text_button").height(40.0f64)
            text_field("1234",key:"password",secure:true,keyboard:vocab::Keyboard::Numeric).height(32.0f64)
            scroll(key:"scroll").height(32.0f64)
            popup("Remove on open",key:"ephemeral",on_opened:this.remove_popup).height(48.0f64)
        }.padding(20.0f64).gap(12.0f64)};
    }
    fn ready(ref this) {
        match popup::find("popup") {option::Option::Some(v)=>{let updated=v.set_item_enabled(this.item_enabled);},option::Option::None=>{assert false;}}
        this.timer=services::after(0.1f64,this.style_ready);
    }
    fn style_ready(ref this) {
        let scroll: *props::ScrollProps=(*core::node_data(check::node("scroll"))).props as *props::ScrollProps;(*scroll).cascades_input=false;core::touch(check::node("scroll"),0xffffffffffffffffu64);
        this.check_enabled(false);this.allow_second=true;
        var i: usize=0;while i<8 {let c=control(i);this.sizes[i]=check::must::[f64](c.font_size());this.families[i]=family(check::must::[rt::Object](c.font_family()));i=i+1;}
        let label=check::must::[native::ITextBlock](native::ITextBlock::query(check::object("label")));
        this.label_size=check::must::[f64](label.font_size());this.label_family=family(check::must::[rt::Object](label.font_family()));
        {let p: *props::PopupProps=(*core::node_data(check::node("popup"))).props as *props::PopupProps;
            (*p).font_size=20.0f64;(*p).character_spacing=2.0f64;
            (*p).font_weight=vocab::FontWeight::Bold;(*p).is_italic=true;(*p).font_scales=false;
            (*p).font_family=text::from_str("Consolas");(*p).text_color=vocab::Color::rgba(1.0f64,0.0f64,0.0f64,1.0f64);
            core::touch(check::node("popup"),0xffffffffffffffffu64);
        }
        {let p: *props::RadioProps=(*core::node_data(check::node("radio"))).props as *props::RadioProps;
            (*p).font_size=20.0f64;(*p).character_spacing=2.0f64;
