    fn reset(ref this) {
        var n: usize=3;while n<6 {let edit=check::must::[native::ITextBox](native::ITextBox::query(check::object(key(n))));let expected=if n==4 {native::input_scope_name_value_search} else {native::input_scope_name_value_default_value};assert scope_value(check::must::[rt::Object](edit.input_scope()))==expected;n=n+1;}
        let pw=check::must::[native::IPasswordBox](native::IPasswordBox::query(check::object("password")));assert scope_value(check::must::[rt::Object](pw.input_scope()))==native::input_scope_name_value_password;
        let scroll=check::must::[native::IScrollViewer](native::IScrollViewer::query(check::object("scroll")));assert check::must::[bool](scroll.is_horizontal_scroll_chaining_enabled());assert check::must::[bool](scroll.is_vertical_scroll_chaining_enabled());
