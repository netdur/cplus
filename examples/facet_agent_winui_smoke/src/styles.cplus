        assert check::must(a.get_name(view)).view()=="Accessible heading";assert check::must(a.get_help_text(view)).view()=="Additional help";assert check::must::[i32](a.get_heading_level(view))==3;
        let tips=check::must::[native::IToolTipServiceStatics](native::ToolTipService::i_tool_tip_service_statics_factory());this.tooltip_object=check::must::[rt::Object](tips.get_tool_tip(view));let boxed=check::must::[native::IPropertyValue](native::IPropertyValue::query(this.tooltip_object));assert check::must(boxed.get_string()).view()=="Tip — 世界";
        core::touch(check::node("label"),0xffffffffffffffffu64);this.timer=services::after(0.2f64,this.accessible_update);
