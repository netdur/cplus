        assert check::must::[f64](check::must::[native::IFrameworkElement](native::IFrameworkElement::query(this.separator_border().object())).height())==24.0f64;
        match list::find("separators") {option::Option::Some(v)=>{let changed=v.scroll_to(10);},option::Option::None=>{assert false;}}this.timer=services::after(0.2f64,this.uneven_scrolled);
    }
    fn uneven_scrolled(ref this) {
        let scroll=check::must::[native::IScrollViewer](native::IScrollViewer::query(check::object("separators")));assert check::must::[f64](scroll.vertical_offset())==360.0f64;assert this.height_calls==20;
        this.height_scale=2.0f64;match list::find("separators") {option::Option::Some(v)=>{let changed=v.set_row_height_of(this.row_height);},option::Option::None=>{assert false;}}this.timer=services::after(0.2f64,this.uneven_changed);
