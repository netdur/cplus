        this.remove_host=true;assert control().set_selected_index(1).is_ok();assert this.positions==2 && this.items==(if this.remove_current {2i64} else {1i64});
        this.timer=services::after(0.2f64,this.close);
    }
    fn close(ref this) {this.passed=true;assert host::close().is_ok();}
}
fn run() -> i32 {let owner=match box::new::[Probe](#zero::[Probe]()) {option::Option::Some(v)=>v,option::Option::None=>{return 1;}};let p=owner.ptr();assert host::run((*p).build(),"Facet WinUI carousel",on_ready:(*p).ready).is_ok();assert (*p).passed;assert host::live_views()==0;assert host::live_subscriptions()==0;check::log("PASS: carousel teardown");return 0;}
