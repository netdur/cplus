import "stdlib/box" as box;
import "stdlib/option" as option;
import "facet/elements" as ui;
import "facet/facet" as core;
import "facet/props" as props;
import "facet/list" as list;
import "facet_winui/record" as record;
import "facet_winui/items" as items;
import "stdlib/text" as text;
import "facet/mount" as mount;
import "facet/component" as component;
import "facet/services" as services;
import "facet/vocabulary" as vocab;
import "facet_winui/facet_winui" as host;
import "facet_winui/refresh_retirement" as retirement;
import "winui/winui" as native;
import "winrt/runtime" as rt;
import "./parity" as check;
fn handle() -> list::List {return match list::find("refresh") {option::Option::Some(v)=>v,option::Option::None=>{assert false;#zero::[list::List]()}};}
fn container() -> native::IRefreshContainer {return check::must::[native::IRefreshContainer](native::IRefreshContainer::query(record::visual(core::view_of(check::node("refresh")) as *record::View)));}
fn visual() -> rt::Object {return check::must::[rt::Object](container().visualizer());}
fn refreshing() -> bool {let v=check::must::[native::IRefreshVisualizer](native::IRefreshVisualizer::query(visual()));let state=check::must::[i32](v.state());return state==native::refresh_visualizer_state_refreshing;}
fn foreground() -> rt::Object {let c=check::must::[native::IControl](native::IControl::query(visual()));return check::must::[rt::Object](c.foreground());}
fn menu_item() -> rt::Object {let root=check::must::[native::IUIElement](native::IUIElement::query(record::visual(core::view_of(check::node("refresh")) as *record::View)));let menu=check::must::[native::IMenuFlyout](native::IMenuFlyout::query(check::must::[rt::Object](root.context_flyout())));let items=check::must::[native::IVector_Microsoft_UI_Xaml_Controls_MenuFlyoutItemBase](native::IVector_Microsoft_UI_Xaml_Controls_MenuFlyoutItemBase::query(check::must::[rt::Object](menu.items())));return check::must::[rt::Object](items.get_at(0));}
fn menu_enabled() -> bool {let control=check::must::[native::IControl](native::IControl::query(menu_item()));return check::must::[bool](control.is_enabled());}
fn invoke_menu() {let factory=check::must::[native::IFrameworkElementAutomationPeerStatics](native::FrameworkElementAutomationPeer::i_framework_element_automation_peer_statics_factory());let peer=check::must::[native::IAutomationPeer](native::IAutomationPeer::query(check::must::[rt::Object](factory.create_peer_for_element(menu_item()))));let invoke=check::must::[native::IInvokeProvider](native::IInvokeProvider::query(check::must::[rt::Object](peer.get_pattern(native::pattern_interface_invoke))));assert invoke.invoke().is_ok();}
fn first_editor() -> native::ITextBox {
    let r=core::view_of(check::node("refresh")) as *record::View;let s=items::state(r);
    let row=match (*s).rows.at_ptr(0) {option::Option::Some(v)=>v,option::Option::None=>{assert false;return #zero::[native::ITextBox]();}};
    let child=core::view_of((*row).node.ptr()) as *record::View;return check::must::[native::ITextBox](native::ITextBox::query((*child).object));
}
struct Probe {events: i32,mode: i32,default_brush: rt::Object,passed: bool,timer: services::Cancellable}
impl Probe {
    fn requested(ref this,sender: *u8) {
        assert component::key_of(sender)=="refresh";assert handle().is_refreshing();this.events=this.events+1;
        if this.mode==1 {let updated=handle().end_refresh();}
        if this.mode==2 {let old=mount::replace("refresh",ui::label("Removed",key:"refresh"));}
    }
    fn row(ref this,index: usize) -> core::Node {return ui::text_field("Draft ${index}",key:"draft:${index}");}
    fn make_host(ref this,initial: bool=false) -> core::Node {
        return ui::list(key:"refresh",refreshable:true,refreshing:initial,on_refreshing:this.requested,count:20,row:this.row,row_height:48).height(160.0f64);
    }
    fn build(ref this) -> core::Node {return @ui {column {this.make_host()}.padding(20.0f64)};}
    fn ready(ref this) {this.timer=services::after(0.2f64,this.start);}
    fn start(ref this) {
        assert !refreshing();assert this.events==0;assert first_editor().set_text("Retained draft").is_ok();this.default_brush=foreground();let updated=handle().set_refresh_color(vocab::Color::rgba(1.0f64,0.0f64,0.0f64,1.0f64)).begin_refresh();this.timer=services::after(0.2f64,this.running);
    }
    fn running(ref this) {
        assert this.events==1;assert refreshing();assert check::must::[text::Text](first_editor().text()).view()=="Retained draft";assert !menu_enabled();assert handle().is_refreshing();let color=check::must::[native::ISolidColorBrush](native::ISolidColorBrush::query(foreground()));assert check::must::[native::Color](color.color()).r==255;
        let updated=handle().begin_refresh();this.timer=services::after(0.2f64,this.still_running);
    }
    fn still_running(ref this) {assert this.events==1;assert refreshing();let updated=handle().end_refresh().set_refresh_color(vocab::Color::clear());this.timer=services::after(0.2f64,this.ended);}
    fn ended(ref this) {
        assert !refreshing();assert !handle().is_refreshing();assert check::must::[text::Text](first_editor().text()).view()=="Retained draft";assert foreground().raw()==this.default_brush.raw();check::log("PASS: refresh deferral, repeat suppression, color and default reset");
        assert menu_enabled();invoke_menu();this.timer=services::after(0.2f64,this.native_request);
    }
    fn native_request(ref this) {assert this.events==2;assert refreshing();assert !menu_enabled();assert handle().is_refreshing();let updated=handle().end_refresh().set_refresh(false);this.timer=services::after(0.2f64,this.disabled);}
    fn disabled(ref this) {
        assert !refreshing();assert !menu_enabled();let child=check::must::[native::IControl](native::IControl::query(check::object("refresh")));assert check::must::[bool](child.is_enabled());
        assert container().request_refresh().is_ok();this.timer=services::after(0.2f64,this.blocked);
    }
    fn blocked(ref this) {
        assert this.events==2;assert !handle().is_refreshing();assert !refreshing();check::log("PASS: can-refresh blocks native requests without disabling list content");
        let updated=handle().set_refresh(true).set_refreshable(false);assert container().request_refresh().is_ok();this.timer=services::after(0.2f64,this.disabled_refreshable);
    }
    fn disabled_refreshable(ref this) {
        assert this.events==2;assert !handle().is_refreshing();assert !refreshing();assert !menu_enabled();
        this.mode=1;let updated=handle().begin_refresh();this.timer=services::after(0.2f64,this.immediate_end);
    }
    fn immediate_end(ref this) {
        assert this.events==3;assert !refreshing();assert !handle().is_refreshing();check::log("PASS: refresh can finish in its deferred application callback");
        this.mode=2;let updated=handle().set_refreshable(true).begin_refresh();this.timer=services::after(0.2f64,this.removed);
    }
    fn removed(ref this) {
        assert this.events==4;check::log("PASS: refresh host removed safely from its callback");this.mode=0;let old=mount::replace("refresh",this.make_host(true));this.timer=services::after(0.3f64,this.initial_refresh);
    }
    fn initial_refresh(ref this) {
        assert this.events==5;assert refreshing();check::log("PASS: initial refreshing waits for native load");let updated=handle().end_refresh();this.timer=services::after(0.2f64,this.cancel_pending);
    }
    fn cancel_pending(ref this) {assert !refreshing();assert container().request_refresh().is_ok();let old=mount::replace("refresh",ui::label("Cancelled",key:"refresh"));this.timer=services::after(0.8f64,this.finish);}
    fn finish(ref this) {assert this.events==5;check::log("PASS: removing host cancels queued refresh delivery");assert retirement::subscriptions()==0;let old=mount::replace("refresh",this.make_host(true));this.timer=services::after(0.2f64,this.close_active);}
    fn close_active(ref this) {assert this.events==6;assert refreshing();this.passed=true;assert host::close().is_ok();}
}
fn run() -> i32 {let owner=match box::new::[Probe](#zero::[Probe]()) {option::Option::Some(v)=>v,option::Option::None=>{return 1;}};let p=owner.ptr();assert host::run((*p).build(),"Facet WinUI list refresh",on_ready:(*p).ready).is_ok();assert (*p).passed;assert host::live_views()==0;assert host::live_subscriptions()==0;check::log("PASS: list refresh teardown");return 0;}
