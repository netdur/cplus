        var options=vocab::TextList::new();let option_added=options.add("Selected item");
        return @ui {column {
            date_picker(vocab::Date {year:2026,month:10,day:1},key:"date_reset",on_date_selected:this.date_changed).height(32.0f64)
            popup("Choose an item",key:"popup_color",selected_index:-1,items:options).height(32.0f64)
            slider(0.5f64,key:"slider",minimum:0.0f64,maximum:1.0f64).height(32.0f64)
            button("École Ω 🚀",key:"button").width(360.0f64).height(100.0f64)
            label("École Ω 🚀",key:"label").height(60.0f64)
            span("École Ω 🚀",key:"span").height(60.0f64)
            progress(0.5f64,key:"progress").height(12.0f64)
            page_dots(3,key:"dots").height(12.0f64)
            label("",key:"rich",formatted_text:spans).height(50.0f64)
            text_button("École Ω 🚀",key:"text",text_transform:vocab::TextTransform::Uppercase).height(50.0f64)
            icon_button(key:"image",symbol:0xe5d2u32,bordered:true).width(64.0f64).height(64.0f64)
            image("",key:"animated").width(32.0f64).height(32.0f64)
