import "./parity" as check;
fn native_label(key: str) -> native::ITextBlock {return check::must::[native::ITextBlock](native::ITextBlock::query(check::object(key)));}
fn native_button() -> native::IControl {return check::must::[native::IControl](native::IControl::query(check::object("button")));}
fn content(key: str="button") -> rt::Object {let b=check::must::[native::IContentControl](native::IContentControl::query(check::object(key)));return check::must::[rt::Object](b.content());}
fn button_props() -> *props::ButtonProps {return (*core::node_data(check::node("button"))).props as *props::ButtonProps;}
fn animated_source() -> native::IBitmapImage {let host=check::must::[native::IBorder](native::IBorder::query(check::object("animated")));let brush=check::must::[native::IImageBrush](native::IImageBrush::query(check::must::[rt::Object](host.background())));return check::must::[native::IBitmapImage](native::IBitmapImage::query(check::must::[rt::Object](brush.image_source())));}
fn animation_props() -> *props::ImageProps {return (*core::node_data(check::node("animated"))).props as *props::ImageProps;}
fn dirty(key: str) {core::touch(check::node(key),0xffffffffffffffffu64);}
fn named_part(value: rt::Object,name: str) -> rt::Object {
    match native::IFrameworkElement::query(value) {result::Result::Ok(v)=>{if check::must::[text::Text](v.name())==name {return value.clone();}},result::Result::Err(e)=>{assert e.code==rt::no_interface();}}
    let tree=check::must::[native::IVisualTreeHelperStatics](native::VisualTreeHelper::i_visual_tree_helper_statics_factory());let count=check::must::[i32](tree.get_children_count(value));var i: i32=0;
    while i<count {let found=named_part(check::must::[rt::Object](tree.get_child(value,i)),name);if !found.is_null() {return found;}i=i+1;}return rt::Object::empty();
}
fn track_brush(name: str) -> rt::Object {let shape=check::must::[native::IShape](native::IShape::query(named_part(check::object("slider"),name)));return check::must::[rt::Object](shape.fill());}
fn brush_color(value: rt::Object) -> native::Color {let brush=check::must::[native::ISolidColorBrush](native::ISolidColorBrush::query(value));return check::must::[native::Color](brush.color());}
fn thumb_brush() -> rt::Object {let thumb=check::must::[native::IControl](native::IControl::query(named_part(check::object("slider"),"HorizontalThumb")));return check::must::[rt::Object](thumb.background());}
fn slider_props() -> *props::SliderProps {return (*core::node_data(check::node("slider"))).props as *props::SliderProps;}
struct Probe {date_events: i32,min_date: i64,max_date: i64,min_track: native::Color,max_track: native::Color,thumb_color: native::Color,slider_tip: rt::Object,bitmap: rt::Object,button_size: f64,span_size: f64,button_border: f64,phase: u32,passed: bool,timer: services::Cancellable}
