        let p=button_props();(*p).font_size=20.0f64;(*p).font_weight=vocab::FontWeight::Bold;(*p).is_italic=true;(*p).font_scales=false;(*p).font_family=text::from_str("Consolas");(*p).character_spacing=2.0f64;
        (*p).border_width=3.0f64;(*p).border_color=vocab::Color::rgba(1.0f64,0.0f64,0.0f64,1.0f64);(*p).corner_radius=vocab::Corners::all(8.0f64);(*p).text_transform=vocab::TextTransform::Uppercase;dirty("button");
